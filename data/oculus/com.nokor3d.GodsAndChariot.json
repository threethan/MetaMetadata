/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVb1ypTvypMQ7kNvwEAmWGj&_nc_oc=AdocWMl5IQkAmNa7gKF27cGeWehkrOtn4UNXxETVEswhcCT1_3vM5lVz1JV3zSb3Nrk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3qf-K8CTYBxeX2eXkj1C8EREZb5bvd5O_wz9CQhOHZg&oe=6A5657F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKTaDUB9I8YQ7kNvwHrv60b&_nc_oc=Adpwa77I2xn39wdj-EXrJwWuHvfC6C7mbv0JbVbvPPtAGMD3dKRpIDs7hT_-RUJDbLo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACLFvcDz5RBuSidPpj5iOiyL_ETTyQBdjKUZlnfbIFGg&oe=6A564021"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u8NUwOou7IQ7kNvwEJYf70&_nc_oc=AdrPCNeU8OGW19QX_TEJjQ5GbAXjM5NamlirgxdF-lnSubv7S-H7bChcvi40LTFwYfA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgqVojU6ye4zbniH8eh8wHQK_0FbK_7voNur1vhtwvEA&oe=6A56349E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T20FPW8sisQ7kNvwEkclJR&_nc_oc=AdoJxKXydn-xrDj1x_I_fj2rmA5-j7bYoiTav3LI-Xbu5l2LA3MZUBlYd6taDgSKKtQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJxEyecesG6HRn9oyLK-SupP9pasgQScHvy4a4OR_PQA&oe=6A564A9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ4TdWjHJJkQ7kNvwGVvjuz&_nc_oc=Adrh8cgGf7fal54H5vBAiISGIz3adEa9xW56F5Os6vNTTkUTcKXJXIJw7VqjfJq9csg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSaGmw9vL4EE5n1ZaSiGlmQqbD9sxJ6ZkSXqHHGJA-0Q&oe=6A564918"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
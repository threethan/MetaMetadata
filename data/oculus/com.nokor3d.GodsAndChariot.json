/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTNtXBH9lmYQ7kNvwEmGmAw&_nc_oc=AdpEmQvF9ja8d8RXN46a4clrmEmDUNsxbVbKwymTTZn8fuU6eqRbYNg8uvynB32WH_c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c_wmFMhGBU7c5gK3nxvA0rQljgiyvt6AmRkk3QxAwpQ&oe=6A170FF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xTUKWLUL_4Q7kNvwHCToLx&_nc_oc=AdrZ4B5OQEoWQAwmZtW6WFWEdvc2tbP0FOx2c_2vXu0UY9GaGUz3UvCU4Jnp83T5Q_I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XaBnysSTIPmwZhpcU3ifffcclOCpxRPw16ffnPlfGSA&oe=6A16F821"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwO6wGuNDAQQ7kNvwFXkAiX&_nc_oc=AdpQnx1XKiacnWQahGfPopbok4AVUebsse4k_BdoZyKMy4gx86bkBK0R-PuSdCqUyeQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-D1VmqQsnZ6GpwDcejcL9hlbZ6R-n7NNN9mJTimde1w&oe=6A16EC9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GxuMdbe3igQ7kNvwETjakf&_nc_oc=AdrE6cOcwpNg9hmcCd1c3h3y1yJfaLeAyBsPtUFXJLVC3sRE_TV_MUCeDlD0zYoVCj0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FM3lGqXnQBKufxQET-6Dn6WkQ_Aftw-ZAWILJYlDhxA&oe=6A17029F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6dcjc4wlVEQ7kNvwHHWLfu&_nc_oc=Adp8u7aCSua-E7J9g-nda0YdeDqN8eXfvHEQap2Jt-SsLlfkWz_Q-alY9x_ra5lKSSc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vHVJunLY6ixLdR7drEPcm3Rp8T5dgA3viqtSkUkZPFg&oe=6A170118"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
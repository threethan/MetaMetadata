/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3kdCMZGq6MQ7kNvwEO3riN&_nc_oc=Ado0aOUy4O3e9RVWClhf8bOS1J9wg4wQ79TllBLCsvNkg_ZeNibXf6JOMraHchOyG48&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FoYB5YOTleOSMSIl38bSkVhZar8rYVvo1k9gXqTcn1A&oe=6A0C83F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQr9ijG6RVcQ7kNvwGynUbD&_nc_oc=AdrejT_lhouvffvmP2WEkxMtlZDsXIlfoNHdORLFd8BpVBuObJLUx75Kh9xvwcFR6JQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BW8JX_4ze--XDrlk3MOm0IhytBpStbzV2UI83yfZ6Ig&oe=6A0C6C21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU2UtBCti7cQ7kNvwGndP4D&_nc_oc=Ado0hNxnaPA269h5-GnORgDJkj_AxRtth4pRFWhu3OISxDzfgkJIRZCDHU4Q1lHxQbA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w0iKZOIm1AJUWf44aQCkZDz5B6nDkyPZHK9TeZ44CLg&oe=6A0C609E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR1h3MZj7fUQ7kNvwF0nTMF&_nc_oc=Adq018T99TAF_EKLYnG2mPYuyPZe7EQ6k75TljD_htTnO-9rY6fr1XfVjw_mRo3zaYc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NU47W7m8c0IAyC36NwJKH0f2nBc5JWtyjnDiKCeP8gA&oe=6A0C769F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzMtOY7mepIQ7kNvwHUeqJw&_nc_oc=AdonZ42ReckvZNNioPXk_MH5WVdkVmbO5ie-rvw8PaBBDIlhBiw2ipJTKFRfpGZZysU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lGHp-Qn6MO4rhPs_4yIoCxIOKf4P3QmlCq_IoaTf1rw&oe=6A0C7518"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
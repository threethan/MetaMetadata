/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejg2xHKbqo4Q7kNvwFD537Z&_nc_oc=Adoa16-0OSg5BBJR3Ek1chiR69cjLPCglIBmoHl1SWkwUaCnzZ-joi7jyLTPYsdKCT8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9C463D3axAr4cK8iAc8_2M4TIjHRVk7DMLrz64e-8qA&oe=69C7BDB5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWT03j6lI98Q7kNvwFQPs-R&_nc_oc=AdrmmbPMNnPK0XwtA5s7GHVk8XTamR_ZzUBoqIoYOMOqNVaY-Ab4bBuN9MY1yQSfQPU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEBUbfcX2GIbfCW5HRtrTUcQG-edI2i1T-l4zGO2XmPA&oe=69C7DE21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhRwkPonh4UQ7kNvwFT4ri0&_nc_oc=AdpCmY3EyJuI9c16G45U61MgLNiU8f4tG_Wm7Ppk7T0nyDm4MabO2I0QhyRFMWdDj4s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlQKszZu8u05DGQOSw3OkRzIfkQOF2rNoCOYZtsJA5cg&oe=69C7D29E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_7iDL4BCWUQ7kNvwHZuLOs&_nc_oc=Ado19X9FSKC2jTIcufxsQCgOyhVBKN5Kk0Trj3kHrqjKgbb2a7Li47lRzq3P0grq1Co&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5pvD3KQtZHqVbj_H4QLNKlTjx-oiXE1yZCeMCG5jNRQ&oe=69C7B05F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgXtFdCestYQ7kNvwEnjJd3&_nc_oc=AdpXMibO2aD4yMwsTpT56kgfVKsT-2rb9Gq8ZkUsLwmVO0-JlkEk-DdGSHAc_RAbYZo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy80wnlw1vTteOElCstIs5UNaw_9G6D01fKUYcbWHmLEQ&oe=69C7E718"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
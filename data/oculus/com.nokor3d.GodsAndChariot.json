/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH9lYKLLfwoQ7kNvwErf4le&_nc_oc=AdozWOr8HHtzNctHPROGalTUrrJpnbs8VSyIF5AAMKhL8l8bKxNmdRV50LdHMNbBwxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9BeQRhuN2bVKDuCFzhtl3MPNOvZAV7OOMth8eCBvQxg&oe=6AC515F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAhpd67JKywQ7kNvwHrTGu2&_nc_oc=Adr77E9NsrC45Pb3UJJb3tGkpDGBya_zS_IcrHcHLBH3N1aDPjPla33onF30Wm0u1u4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPIFIx15jNRFRtvQ9O_J48jRewX1w3CC6kpRw24nZ8vg&oe=6AC4FE21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cErNNQicokQ7kNvwEo9asK&_nc_oc=Adou_3jRwrHdvuADuiq7dyD3CEcz1begHb6-VSz8HJDLUOLMnC092BNMr8f6DEIw0Ss&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwHlJ6wd_fTILtQr9rDGxedBRpZI8ufH1yVrmHHF-b8w&oe=6AC4F29E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEETOJw9f4IQ7kNvwE3wZ3-&_nc_oc=AdoLUpw7McffC2K2vEkjhbdi8IOogSarOELogQgJ5dvZgfaJH6u6FGb8VLtiQ24RTJA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDEW3KWHhyz2qdC6nrai7flYEl4b4FurvEZrrbe1mhIA&oe=6AC5089F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpMZud9ixxMQ7kNvwGPun2l&_nc_oc=AdpSEWuWsSNH8YKYkyzgPD3O3yYk6SluU14GILwt0aN_Vd8s84snKXHzAmZz7loiA6c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM05NciJYAim0iuCB2GctkaRgrlKUBaSZKeY6WGpqWqw&oe=6AC50718"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
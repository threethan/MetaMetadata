/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0X2jT3y74Q7kNvwGuXwLr&_nc_oc=Adr6qJm67qYb_CPOHWWXakDtZP-KwAVDInuN_YC12NPuJL-Sko7iEkUBmUjespNAfjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6X2pUb_cvzW0h1Wqt3CuIDVBb_Liiqy9eY_h9rfgFdw&oe=6A5B65B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt5zyle931AQ7kNvwHJf9iS&_nc_oc=AdoANAJEw8N69eIHXvXPlTJ6Yb8GigHX9tBudUPznjYXSDpF9woMNulAEOnFfV4pEpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd1pjIWLgjXo5vTymsXHw64UKv6yrMP2V4nfM3eHT6CQ&oe=6A5B8621"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBjgr2JW_yIQ7kNvwHF_9Uw&_nc_oc=AdonlXYZCzGk08BwVY3QlwdaOy5fArJZ6onrVol_WHD37h5xS05Ya0D0RMLulhQKucA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9dG5pTm1P501o5eclj9rBICv01a_mnDosLdK50KaeOQ&oe=6A5B7A9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8f4_A-8S7SoQ7kNvwH5zS3m&_nc_oc=Adr5b-6Q4jaR9mWvmGy1XSgxe41LPy4lem0jpwg2Ioczb5L12EXC2l_z266S9qZ6Oq8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbdKeBUmGUHmNE6XyOr9nXyf2yF9Dm8-a4hvKWXmj4Sw&oe=6A5B909F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr0Q9AxUrSsQ7kNvwEF0J7Y&_nc_oc=AdoDZRxTVEzo7udlNuZ0-fyeJFHqb4fOl3xlc-cSCemB0931tN8h8FRqA_shYKcc8-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMcsBvuigqe9YxbsM7e_uSb1WONhLeC79AYtUaNHS3dA&oe=6A5B8F18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
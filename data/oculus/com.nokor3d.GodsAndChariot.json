/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw7aetRL-IQQ7kNvwFt9jGP&_nc_oc=AdohuymYP4u_kz4jxUSGwOmyyXNE5ahDR0QuHRA4A76FCiJ585sBNgr-onAW5Kb8E3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I37gA6PHptaxpy4t24HfhSuRc0zPqfA3nrD-yfocIfA&oe=69DB8435"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_WEefrQc8gQ7kNvwEEltre&_nc_oc=AdrNIEd5mdn08qqEc0V12fCNB8wWOvLnqRuHHWOgWs-KW38b2_UdZEa3OCZLmg1r7Tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ApM7ITQRB1gH6V1vDscp7GbVfCACw7jYCAwbjY1p9sg&oe=69DBA4A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JFphiSfToAQ7kNvwHZ2y6P&_nc_oc=AdqUkdxwS-R8OVEH468R-xuEiwO5H4hK2t-4a32YeUnFx72Sof_hErmVqd0bd4lsKBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SquOCZyBqP9YTmXhjuyFNLj_HBwbSwRRt7WPMMivgQA&oe=69DB991E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZzdZGBkMwcQ7kNvwF1OgVk&_nc_oc=AdqjOg8WF3Gq4t9vIu7gPmUdh_89wrR364NmQpesR9kxpOqukkOra4e0DkI_thtYqdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NextYJk9PX8G-Y5_iKXA7YDeKriiHvQ8GaX-L0YAcqg&oe=69DBAF1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj3-cHmNxLcQ7kNvwET-vWr&_nc_oc=AdoWCvpa-5_0fhvupRpjqY-VOTbGTyudEH8Hl6UBg031SnnFuszj9rrLgA-uKhIXBJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D7EdjxWcRedgGzAm-JugmFnrfzbTqYNyun4FG8AWiTQ&oe=69DBAD98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
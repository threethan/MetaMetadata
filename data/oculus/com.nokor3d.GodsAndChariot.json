/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op9JyyxNNgsQ7kNvwH_-sOE&_nc_oc=Adre_ghB730PIzEFIa_PeEz0QsOlzkmIWvUKZ49e-lpdIzNr1YLK8ehlnyX0NilT8tU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCL-hgD5rOqh7DLq8TBZblrKw-8jZRPeZdq0IpNJOnfg&oe=6A4E6EF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI1WTO__nawQ7kNvwFxtI9D&_nc_oc=AdqfSV9-SwMBeZyXKosueIaFNtVTSMqqXSDYyr11DMRonP3laPp8k21YsfXROzCAYYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWoliMyXe6CpwIxd55XH8ZyT-yf7HhqKEGa8N7-aWnwg&oe=6A4E5721"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32SgPW7qKowQ7kNvwHjJHFB&_nc_oc=AdpNK3NdOEMJMVdjkmFlYjyRasPTK6MsVn-JSEO7GVFz03Mi43BoutBj99auahVasYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSdJwX0WJZ8H33GKIOfYua6D_8Y20W31DxulvGSA9x-Q&oe=6A4E4B9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nEbVSw0f-kQ7kNvwGb7Tun&_nc_oc=AdpgmhHoAeIPSl51vgzK7jfePKcpiqUxF3HNbyKOTqwnG5sJNyDW4WmAV_AUfAJ_ZiQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6bRl1mYfjIde7i9nmt758AS0EsACdGK48SsJtsH9x-g&oe=6A4E619F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVVw7hjUf60Q7kNvwEj4sH-&_nc_oc=Adoxsw8k6cb0l0uWZFunggjs2bZE6m8M5Qo3npdTMB0DcFkRC9T2p4X6jzSUXm0DQNc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_0PwxDdlmATn61J5bYc2WLEehqvkWA_y1MDAC6Yrj6A&oe=6A4E6018"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNa4Z_W2-EgQ7kNvwHxrG17&_nc_oc=AdrilO5Nbv_RbiPwFtrJ4N5dkz1Pe2d_YXGua4BdHyMNT5pUkP3F-cdEfc1g9zJGEqk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbufcE3SuCVUVyK-i4vViNMfTQfOKE-ExU9VJYvx71og&oe=6AECA2F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr-36GTN940Q7kNvwHnJ06m&_nc_oc=AdrUJ-n_LkB3umJ5xbywwOXHsYlZyXGiCneGpqDh4uTLJoVKxxhC8hcTKVL1K0trX5A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi5ybzHAwCCK1NoqSbEZokSjXETTonaR0andPJMRRk-A&oe=6AEC8B21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD9X-uIWlDoQ7kNvwEo8WJ4&_nc_oc=AdoPNkDtI7mExh4VFCOLgpAwtGYqP7WkZo6NkscsvJN0QQRL0mxPV_yTTpAcGAYwoc0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs_3Ol3mt_h1cpG0zGPrNe6-uDzmTTbPtxHW9L49nLrA&oe=6AECB7DE"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyoeRNxJM9cQ7kNvwF6g1me&_nc_oc=AdpikJKhK0LJwZKNR_JyBcTQuIAFC6A6f3kh9_BbnghCLBEQyfSMcU_ga6lvZPsR2nE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1IREJohB_aiPIv4gOpsdGPpsdW3K4fmuw-4CSXDFSeA&oe=6AEC959F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a0ToO1PrpgQ7kNvwFbFU18&_nc_oc=Adpe02O1lcy0AUiNmYh4CDFC3QJRTIuIp7ZsHLrpwQpCWe3LlDTdg8hSMISsyB62VzI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAInkC2b-0IVcPwII_FFB5CxTCy7yG_5SdH3R_GOEOKg&oe=6AEC9418"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
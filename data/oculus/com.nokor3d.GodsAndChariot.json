/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwyZCF-YeqcQ7kNvwESceFF&_nc_oc=AdrUBo1K7YF1uVIbTkG6Jg6E03rDCnOzmGkezZWnthGfI3UDdCyOw8ES7tphvbtb45M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsWTGHHaE73H9-k-juAEREQdNUbZm2J-4vd4-oq9JLDw&oe=6AF09775"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbjSyXogh-sQ7kNvwGIoel2&_nc_oc=AdoZiAJPeOdvyRMtyjh4RYWCiSJXWYcoehJU-Bzh2v4UfnsbYiSR6JbCZV1AugGMpiM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpCf8lyLrAytPamE0TcIriWs338nsYcBUasHWYAY4wsg&oe=6AF07FA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrS0zObxa6IQ7kNvwFxgoBB&_nc_oc=AdqXm9AJwWeedeZ_N_TGXD8hQ9y-0dhXiUKyaXzNjrxyANTHcuDVo5-gzq0gC8l_kcw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7wchqA4oKWHA--O5EbpifxVR-KmksqJWFvwcV-wrGbA&oe=6AF0AC5E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju6KgnvUAMMQ7kNvwHG4wtK&_nc_oc=AdphScgNA4ilhuasReysG1nMOTg-aooiyVTG5Sd0vNXsKrJPXNSULtUMlvUS3sS9o_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaQQOdXdwBdgG_7E1xQuhV_uvSP2FE0xYuYDB8PII7JA&oe=6AF08A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S4ab2yJiD0Q7kNvwH9UkQN&_nc_oc=Adqqpw_zQGBKjH1r6uL3zIbu9hTRb1TXpvZ0IJACtGFiFw1CS4FKcA6I9e3r-0HcSDs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGbNBF95pGFRgXHA9qp5Igj8XDrk0m26UpSMZFcm1GxA&oe=6AF08898"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
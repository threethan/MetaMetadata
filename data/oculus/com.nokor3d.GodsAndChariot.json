/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tUre-RfOScQ7kNvwEef9pK&_nc_oc=AdoHxjBNGcDtt5Nigdw-T4sQAKcE7B3lMJfxc6l8Iw63Issp0C6DlueYlynE1LVAf6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3GX7Rf_7Go3CCOiheR51_mB33mIqTdZSI4SSAEO-_Xw&oe=6AE0C575"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEPdKjzRbIkQ7kNvwHPSt8s&_nc_oc=AdpyUPGmNPJKB1uK7hDdw5Zy9biPza6CqhpHFqBFXSdZ5ABWHuM32tt_2wDDTzVZ7tk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl7r6mt0iZ2B6zQACXrTTWE5bFiby_0BkBqXDIuyJa8Q&oe=6AE0ADA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILb5t0hDQBgQ7kNvwHAkCSj&_nc_oc=AdrISoAPtqd7hT8hFyKY54mUrJZBPnPmF6kmKD6sF0LZ63A8On9ZtFP-nTxrDYzoMI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwBIOPOmFx3pdIiumc7gV2PeGpaBxG14iet9uxKzPD9g&oe=6AE0A21E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5rRE-zSlBIQ7kNvwE4Ypl6&_nc_oc=Adp_OYqAMFOq4rx9coVBnNPolFADZXABk5hhtqSDkO2IYGbClGEOWZyU8aJ-AdlaKf0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6XJ1JtYy7ZuptdRhTEOUUkr7VHGORuBGn9zzaXh5yQw&oe=6AE0B81F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r9bR7dxrwsQ7kNvwGSbn87&_nc_oc=AdrcCG3Tw_rMGpmscjOtVFEECkNdHLgCRxDBx-cWGmFykWLkbHMfjfZCtb17-oyoebM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMivsiCFxEEnNPGIYAuYPvBmFWMfyFJSurF_7Ao9wpHIg&oe=6AE0B698"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ydD-TYUQWQQ7kNvwFHBsyA&_nc_oc=AdrnCiaIfr7A9fO0S66f4t1k-eI0KlMz8ehwSkp0GPooUAXj4Ynrk_gMQC1VUo5VZAg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw7FjgvE2V5iZS7jkEZAvUgr2kykv2Im-tgjtpKJqH0g&oe=6AC90A75"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CknQeeUiwUwQ7kNvwH2i-TI&_nc_oc=AdppZo8Z6S-kt4bQSK0l4DKedf5aC9EaMX7irfBoH0WfcueJAcKF8JyQ3moJcywMX9w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEhHHyusDvHJeiiF2UrKPyuw-ab4XzNxodHx89Eu89zg&oe=6AC8F2A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUILjIOAUsgQ7kNvwHvbmFz&_nc_oc=AdrlT2CwRsndPnlhW2X4BcQQlMynYxScaNfh878sKOHevrSDkkTnwVYdUEOMX7GvF44&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqiEUTJGyVuBjEjWa4HAW_mdXlMVz0Fh3Et6a_hc1xRw&oe=6AC8E71E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9cvCLO5qXQQ7kNvwGH68lE&_nc_oc=AdrGkZwvv4zGa3UUZQCqwhAbWPQJbNiJ9XGMCxRlaedCr0eCMgZaRjIoF_YJkqQyxjU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_3n73VegYxAjUz0duj4QONN1xaF2vEsPhZT2dhjwTBw&oe=6AC8FD1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaTU2cUCS9YQ7kNvwFGpyJ2&_nc_oc=AdqxhzXAs2Skunt0CYme_AfFm8prarfDRb0daZzyYLcvaW3kgCdkHxRAusKlC4ixM9M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1zfM8zaUY1aPEbry90Bads2VGgRbQ3pSoLmgEJ5QyMg&oe=6AC8FB98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
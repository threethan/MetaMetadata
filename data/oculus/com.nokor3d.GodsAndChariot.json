/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WimiTN2SexAQ7kNvwFOEos0&_nc_oc=AdpZq0JR2htYhkhs_-hVLdyUkvAZqngdJGliBww5eRnbTOL2HlqshpZlt4zOcEFteDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_ro5NdPoszDYaHERarq9qOAmSIHW28qPZOh23cusG-Q&oe=6A0462B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk-s9G5hWlwQ7kNvwEWn4d3&_nc_oc=Ado58O1KD1wPfW6YQlCRq8bO787m4nUTCXpyL2WRfSqS-vZnp6tjvgQUoXt3LB_F1cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OMVFE0spXqhJ9e7nbKbp3VhU-JbIfV7BJsOwhuN9r9g&oe=6A048321"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBSU_U7XPV8Q7kNvwHDQu1d&_nc_oc=AdrL_0Qaaa-TFXZGDJazXHbMEQkvo4LmFpW94JNlDirk-nnhqgafRAxHellLL-3Vbc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hNNMwyloShTHXuvn0kNwrMVpm0kwigpadB1swKRhBGg&oe=6A04779E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDmIvRGb4GwQ7kNvwEmZH1N&_nc_oc=Adoz8pni6XVrgDTHrYQwq5uHxM-vWtsTFBU2i5hdnVgbrt0gg_Gl5s73PIaWFlpX7x0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PfI7iwO_PLFUqQK0ePxHpW6Xu4KxFrCiIJXhXazUjrw&oe=6A048D9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lubpPDTiAtIQ7kNvwEqjmDo&_nc_oc=Ado8b1_r96CbbFeWRPaKTTeoLZwyRCbMOTjYL8LlbpN_slwMR7jCVFB9qFDwht6aNbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ngEKX6istNvmuXHz8xZ_5uEKZxEg4s7uawPqlliG47g&oe=6A048C18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEPRwwFKl84Q7kNvwHLOtX8&_nc_oc=AdqYfxR0Kw7bbD9BolMN1x4yeohNfDK_O_bPol-ndOwpFDOueAZjZhEglo3hzPBhKmg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7deUvaOEV8p7SyhZ1hdmGjtF1fCDy8gm_f_bPRaTUaEg&oe=6A107875"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xOqMmga914Q7kNvwEF0vJx&_nc_oc=Adp9bMH9UTX7VdNWTnsbIUEHLopafUYivGIA6jcsjkeKHKUSsapP8iEJfmtYNqhrh7U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TvI89V3JLRineQG-8EyMIuey39CGGC4f8fbH7bcEJNg&oe=6A1060A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4cmwV6ubusQ7kNvwHa6pVE&_nc_oc=AdqT9iT1cmO5h8IqlzvK_YEKJaF21L1tDK_wnRSm-SVTPniqWanCxCh9ifag3u__2-Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Tls_5IH-UP2dnqsvzi1SLu2YyfxHoSxpvUMFU-A-REQ&oe=6A10551E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sOxLdcNu-QQ7kNvwFM7DBf&_nc_oc=Adr6PHuUtHY10Hr7vSLe3aF6EkaqyH1AUE1avSjVezdGZI5Ee6GJwzaRNn4-01lhIlQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rYMdYIgk9_I3QTUKZtagiEIqwZmq9TgXKhF-kjLyW6g&oe=6A106B1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTesff4BgikQ7kNvwEqwh8j&_nc_oc=AdqmZaHRNdto_R0mA9tyvc58xfFg-CLjMvyyxoXIYWeQ3y7Yfk6jAz_uyKzrbnhZQXM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ghUw-fEJ0mgY5Hs9bK58AND0vYHDwk2VJF121q_qkTQ&oe=6A106998"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
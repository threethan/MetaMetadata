/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5a03QxjikMQ7kNvwEdrA2b&_nc_oc=Adru2QGDodYo4Kz67LUACEWgXfDFBeRAuy1fOeGSBHkmM_L0MBNYnr4V7-Z8bCIaoDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tJBf6dO_EH68Qsjw0OuL_9pnQvWLIE6r8QQ4R6xb7tw&oe=6A47D775"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiAbhXP0LoYQ7kNvwHnbJDE&_nc_oc=AdoubeBc2gktgc0vOiq7-xWgP1SIk-SYvbXKydrJ37l8Jh9EWuo1ysdvx6r41pjMTSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H4oXFfkckscV_NagbjOsvBOqW5bDqvJs70scDwV5GtQ&oe=6A47BFA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRLUcn8tF1IQ7kNvwGZmVp-&_nc_oc=Adq0ydcL8ejDiwhjyYKlqGO2lFY-O4mLiSliCPZM4uKbuWYo2iW0Ixt8cQscOerFUUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ViLCQlgRbGltIFMGlO9-b31z4p68YtLf4nTk0EpRsRg&oe=6A47B41E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbnXiV75MW8Q7kNvwGAWHB3&_nc_oc=AdqFvRVRtLHNlxKUy9j0CiPesmYzPOEzigLuLNH1pmDf-WDPQo3Jd5lfAlm3uS4Z0h0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fTJwlI9KtUqEeYoAjNFeovEBbWAd5N9q327hwuoF8gQ&oe=6A47CA1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXpBPibDbqQQ7kNvwF8zOtV&_nc_oc=Ado1PCnzHAgzzYqJWRTAH3vdx58cfm_bsmmxWMgOw1vsuHBGZadsFAGEVyiZILRKNKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HbqS3DJ9iQI2p5MFpgQBdv-B4i2NwvlcFBQysT_YyBQ&oe=6A47C898"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
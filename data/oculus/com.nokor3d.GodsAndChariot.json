/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C0v4zqlBawQ7kNvwHedmji&_nc_oc=AdqTPxDE19tmaut-eaoNx9ZBgXo1lP_rNYzYf-Aslp3hB6JY1LRSt7gYFmkG4lj2EMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pC1Anad-7zievjUrajXigpM_J1Mroq__P4Ux71dCV6Q&oe=69D63E35"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kZ1Hs7C80AQ7kNvwFa_Lrh&_nc_oc=Adp7wsaRWFcMYSkyj5pH2WaKqjEfJBqT8u0GuldiSCeZ56pkTNHpchxhjHv6QSJ42Mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JRGIrKePTThj811XEM4CAIdE123Emisr8PmOn-jI6gg&oe=69D65EA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRa45RFTKA8Q7kNvwGMuoNZ&_nc_oc=Ado5KN_9Ry8kZZBTaLzIBJq4PiVYL254ViKE59Qb9RwGqf-gbG63ImyZTs-Mpln-gWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ArDOZu-N3Iq67aAUSossHysZEE7SCVc_ZZoves7UaAA&oe=69D6531E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOM-YfBHAWcQ7kNvwGSMIWq&_nc_oc=AdqNrt0ui4lXlWnYhFbAupYP9_fzVLOxiM2lDYZLOGQEEGfo7EKdKGx7ow_67_WgWDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05mcXxQIU_2u6xT5fsSBnrY5Ax2mXNEGWQ-jmMuJBdMA&oe=69D6691F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whb4Z0vo4vcQ7kNvwH4alkW&_nc_oc=AdoxUWxNB_RfOdTgmKxcWad2r9yOFOKF3zitKXAD-okaTpDKHkD7S6FDYrU1pmi8QvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-MgGEFcxPE7vBFDwSQ82C-9EUOySy0ytwvIi8z_Qb9A&oe=69D66798"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ADybcQptw0Q7kNvwE9OOWA&_nc_oc=AdoWXAsg7AziwMCMx0vIy4Gyz_eLqKCGKPavRp79etfs6rxVC8bmKQRtDPaohMVFH8s&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnKh9_HgqtqIQH3cVcfkwBNEyiId-DY7Gkvrx5F9EI5A&oe=6A917335"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MPipYr6w84Q7kNvwH6hZwE&_nc_oc=AdoPXBbhCQDC8bel4WRzYOM7xjN9pwrbZ5E8ZrBLgmcTqNFo9oVUmXf9zcxuQW3ZlPU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESL60LbMMAnguDBU4-FZLBW841Ae25A0odGUVP1LJG-A&oe=6A915B61"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKWutGcfPCAQ7kNvwE0PA_h&_nc_oc=AdpWA2cTJznnhPvyiGR1STTBUmGZRWISgNWlzvZj0KV71E5F4UYugwqvdG4LeA7ApTk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ4WPV2eZxT8ZpS36z351sQhp34VdrZOYf9BZobnNffg&oe=6A91881E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQhyBEEbwFMQ7kNvwEd9F2W&_nc_oc=AdoZeuzsHvJYx-rwVpQFEbDN1FUi-W1aRqHvrBH-x62rX_05cGJz4Eqknxr4QLUmV6E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHpTeZJNMhHNQ9w-xcKHuj_cZLJJSXchSdzDwnPD5iSQ&oe=6A9165DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wo7ddEDTYQQ7kNvwEp1qKc&_nc_oc=Adr0VoUtC-ZVDr7ezABjOsIHHUkmbvHTYTviE8Shxv6O1Uz4zkPAaCBKO5BM2Vux6Ak&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnFwY5HXQkKcMsFzIfgsfn_rKtEyWS7At4lvWPUOtwhg&oe=6A916458"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
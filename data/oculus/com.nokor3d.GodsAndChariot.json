/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xi2q-sNtsUQ7kNvwGL-p08&_nc_oc=AdoxHpM3WiPno7Q_GsJCrZz0RnQpnZMv56mMtBrl2fUIc52zyylFsdo8T6JPCxY7N6g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWuesRJTMIZ2fLmzjADkV0fdyFZzuefUA0jfqoSiWJKA&oe=6AE8AE75"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzwxvhiwb3EQ7kNvwGlTaLh&_nc_oc=AdpJ2IR2JZcHWNSG_7V1ACHqsa9_PS_-IVRCHx5NW3Kr0mzLAazJ8KYXE-4jahHlHLU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNhu83fw80E-8GI1VqU1CIe7MYL7Bm7c3QZkY25Y4d3Q&oe=6AE896A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13uw_tt895IQ7kNvwElqjtf&_nc_oc=Adq9lucOEWTJpW5iB90XIYA-MhFe0cshOiLi6BFpK-nmOdJ_8OD3KG3Q-g4FMjH4-CI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5AXFXYS3yU16FJKFdZD_FagRegxCikCjz7iGvrxagnA&oe=6AE8C35E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MdFZfpAuVMQ7kNvwFRrRGT&_nc_oc=Adr3lxzqAIwUikadajhqAFXvMEisdjUfIIJ1DTh9b3PuidE4ZvtlNrzMWenhbCptEQw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-5QrknDGNZa14PWzTb9BBx-GZ36VAl_0vYzvuzy8Hyw&oe=6AE8A11F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzhqO-SCPFsQ7kNvwG67Gt6&_nc_oc=Adpo5SHJfOYus3yjha0q9qjQL78U3nWldCGbR_Ad7JwDiuhIcWJ-x2thOb_M2hTLQAE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnKI1WFdjStce8zufH-QS2z9isLPvmA_PRmK66hmqp8g&oe=6AE89F98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
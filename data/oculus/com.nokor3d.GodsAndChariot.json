/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtuY5fbQMKUQ7kNvwHUOxWh&_nc_oc=AdrClqUXSEbjevGGSPDr4w64ZwJdMQZe4HLE3GsnpGDs9r4CAA9F61lGAEEGIvfxJfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEzSyfltigBnFRZnH9tUz7QjkK4bCnJ3EDGhUqE6WRkA&oe=6ABFCFF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFNuLcCD5e8Q7kNvwHr-S4P&_nc_oc=Adrl1ei1E3qjvEsFgF98l3MgNsXi2o86sj_30ibCuiRoNpX0i9xaycNa9PsgLq1MKSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqnebF-Bv46yTidqI4n6Spn58YWztCv6DSj5HmzR5DJw&oe=6ABFB821"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouwPwejx-AwQ7kNvwFqHdsu&_nc_oc=AdqbCKU3J9huOrGN8l7bmemT96NanW6YaMhlbHnhWLrZSksfMlMGNCrGwC8eGgitObo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM4sdzYmqb--EANIi2pHhNCpP1A5uSwHEb724gfJLiSg&oe=6ABFAC9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL6WmrAxmeUQ7kNvwECcQrC&_nc_oc=Adrj94Zeu_yjLildBZezLoUu151TzGsX9xrDm6xyHdsc5bO-8EHg1Ax3Jea5MiQMXPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkMLeqk1MEP8zDb_K4YhO3Ee2JzOfPRY4Mahl5aqUvcQ&oe=6ABFC29F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nK3kdiXM5QQ7kNvwFND9qW&_nc_oc=AdrmlD4RNVwEACJgfj5jmMz_q8IW7ecHN_bNdhVaACrpFpE9yxNcOmxtupbx4ujti9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUpiJoIdW0KNsw2FZ9_0NUWSWHpmR6OkTkyACaa4h0OQ&oe=6ABFC118"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
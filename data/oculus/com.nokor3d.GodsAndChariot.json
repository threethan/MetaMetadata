/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX4T6RVadz4Q7kNvwFGST0n&_nc_oc=AdqKqAO-086B-6iQBHxZno4yhQEXGkSK7-NAmfk0vx47t_qFVfRt1GtGKJZeqvpBu7s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFHjlNCTS2pWOCSsvDQTzu9bPhDBrDWSiH9kt0eKctuA&oe=6A941635"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3T9HQKjID4Q7kNvwHzFJzl&_nc_oc=AdoNaLtUGOkNtnuviGyKWzjYyw3U5LXUMbb9YJ-N_db4OPfUIqvWB31NYIPd6HoFzMk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6Ag6p1j3ibOb_h_gkMAOXEVdssf86VJmGUN3g_ZeitA&oe=6A93FE61"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKWutGcfPCAQ7kNvwEEN1Rx&_nc_oc=AdrI11ePeVn4-0U6ypjb9ZxVCdTvVxZEpQkQs7jEzw_CGdO_Mn1rWxhR9sNjO3dOp5k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY9u6YrUTzSXRdskuznhOp7ZudVdU_KPup_LSDuMrO-g&oe=6A942B1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NKEfTml9lQQ7kNvwEyoqxO&_nc_oc=AdrJ3i9B0jvOjUROIV3vE0-tgNE2FyLjNgwo1MB_i65qy3oN4HEmwHUend5tGU07yb0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLPRSGXzFjE4FKAkiYocA0REW6pI0RM4jE2RnFqSplGw&oe=6A9408DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wo7ddEDTYQQ7kNvwFP14L-&_nc_oc=AdqDKRw9Qy-YYEFhu2i3TxF4O-IU1sOSeRwDujpXfYnZwO_vp6sqs2YhF_KxqWwrnWY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwW8XIaB4qch0cc9oU_RrwTh6Z3fWf8k5K5NWRyzqi7A&oe=6A940758"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReKO8vR8niIQ7kNvwF2IdON&_nc_oc=Adq__vDn6ypXr4W5CWOCMfm7qORCSFr000bEVIslNV1OmxG_J7Xdw-85uitlw8WiWpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbR2FujBsHwoBiqw4OsyllEOQR-9-ZPg3rkv6CQw4i1A&oe=6A8C2D35"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMtxxtnVqvAQ7kNvwEGQnzM&_nc_oc=AdqyKCJhyZFuijfdRN62xTuH6OhlRK2Uxh1TVoipyiFgTrfTipekZxdlf5v6r9PJYcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEfCLm8m-Rs4JEYK2YyYTIXyckj0iT8wR0uCD_9c60CA&oe=6A8C1561"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-mkaNzDQA8Q7kNvwHjze6t&_nc_oc=AdpKV2zainMi7gLoBUuQibc41WZNhkB6FWstRFD9ZfEvB1d-C6fVM3m1mbb8JY292nQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHpuUpHr267j-oq8tp4LbKe24xIppreOJo1d4UcsQXAg&oe=6A8C421E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2haZq9cBvKwQ7kNvwGbIIbY&_nc_oc=Adp0o2o-T34pnuJuzz4R3YUFOkDm7PbaYpz_tZxhDEZyHcODTtdISbdGk362TH3Kqtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV545xoVN7ppsYUZfy7PJklsSJxvrJXkJQSOvzvtJBPA&oe=6A8C1FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WauZs1MqFwoQ7kNvwHHQ007&_nc_oc=Adq1ixtrhM2Mq4Qb9RkmuL72CyPDGTMdfNZgS6mdKAO_DJ4uGgp4u6ofF9xVGuDEexM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtKnKbTlU00LjFyGkqLsdGueW2Isp45EtdoGiO3Y16rQ&oe=6A8C1E58"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
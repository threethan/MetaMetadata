/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcdmiLtR8v0Q7kNvwErL0rr&_nc_oc=AdqFgaFLqUUPfnWfN3WARlTzWTkVhO3VQnze2AV_Q0LQe7IbfFQXtn8xYbv3DOJDSK8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ny0YEgR5ceAseriP5Qaz1HuQA_xdEretGHX0dOzhl0Q&oe=6A09E0F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQr9ijG6RVcQ7kNvwGmQA_6&_nc_oc=Adp_6GMUkABuZfw49MytZ0XfYGRd8sMNV_aUXfgsHZDmKmr7FlX5nJN6cp0BYfVlfeA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IwfDFcZDouNohj8Lb04I2jCKpp4n57yMTFwaDDv7Ogg&oe=6A09C921"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TTYROSrMvoQ7kNvwHMm9Hd&_nc_oc=AdrIi0HrOdlazXjoibpv7Eic3Tlp-mlosMlweenH5vGTZSZEtaP05K3nE9cOCZ3FYmE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b1efJbk0kSlR_9kTK8igMVaxiE35iEUmRcqPrx79g7A&oe=6A09BD9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrgDLGg4MU4Q7kNvwFlw_9t&_nc_oc=AdpnNGEQrPaBR1E47RKo_MsznT9Cxynvpaf06W3hHm--EPb-O3FviMCUVB04gWQ7hfY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kVof8q7kiLhzc4D5eSGwzM2aakG6nY_ROkp0pptDHSg&oe=6A09D39F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlG1sfYXqkgQ7kNvwHD6nQZ&_nc_oc=AdoAS1VasqqQfFpJA5bCdzdTY_UcVKyxIG3FnT2p99YBDQtzVjP5LWvMS1wto2z7G7Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BCvttXgOE69uMNDuOUiy7P9T727EIZdwlH52Y1Q-hUQ&oe=6A09D218"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
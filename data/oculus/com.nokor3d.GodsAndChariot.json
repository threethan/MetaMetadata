/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op9JyyxNNgsQ7kNvwE4RHEc&_nc_oc=AdoXAC9AGEQSlqSCoE5nSJfuiiDFk7PcKJMAbcUOxXf-G6us97MwHselQpASL2oqKd0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXxIjE2NsU-NRSu8ifBHRfy0SJqNiQrKITq2JbiYiQ0Q&oe=6A5111F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cd8YR6NLU4Q7kNvwF1kLhL&_nc_oc=Adoh_xv8et6GwcStcoWYAWDFP30VxQt0VYlteXPwnhTJE1aV_wlchCn83B7vA9hvjVc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8TR8rVmR0M8F14J8PsxjXAazNHlPi787GDQo6an0JcQ&oe=6A50FA21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32SgPW7qKowQ7kNvwGJ9rSi&_nc_oc=Adrm-P8c542knGvn7tnO_G42VXYfwascnwIkUGQ6MhvEykc_uuiQZtGPovZ2T4NroFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiw8ZCtZSfOPqD07lzqriCrF38TaqooaauDpIzrj7cLA&oe=6A50EE9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9fiktjQhEcQ7kNvwEBwGxO&_nc_oc=AdrCSxGXC_KEFuMz1OcjZODk7T9QANBhnQbEUCv3drwm3Fhvug15EiAL8wbqS3z4dCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX7dEiEn6UABTC11JIpktrV4JKedhapVzE9y883ekW8Q&oe=6A51049F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVVw7hjUf60Q7kNvwGLnxpF&_nc_oc=AdrzisyIUjjUn3dmNT-xLjMKdH6UHhu6Bk-LzS0mRDtXPlJ4ucdeLplhsWT_5zCUldU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB20ATfvLsEgNTgAbl_QU3447qQvjunOHxAZtPKOy-NZQ&oe=6A510318"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
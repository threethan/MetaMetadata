/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfc6zCAizSsQ7kNvwFOP0kK&_nc_oc=AdrvjF6W6XKYeuNzHuenw9B8HkNPpnorTARBRmeYn0zvSO6fg9EbOB5-t_H_aQ_eYBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbE1KybP9NkiIZCJgWaFD-6V5JQSlR2uAHzwe-dITlAA&oe=6A999475"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j70LtIEM--4Q7kNvwE-rJ09&_nc_oc=AdqqmV_dkHo4amFeNDF5PHFZNYdTE8mtuzHzDvvuSBLBWmlyyp9cQ_c8gbTiLKCPcWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYKpJiM0sDItNrBqGbviQS7z4Klvt-wmaZOmJKtwM2xw&oe=6A997CA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xfi-TdWS0sQ7kNvwFXW8ja&_nc_oc=AdqWUNWPVE1zIZO_oOfnTMQUJbo18yGPJkVjIU5wQP28OcfyJpi1E94QZvKSXFRfDmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMIHAwnQ4_gYpxdC-PlnsQpUlAWdcT6Se9xRpuXsI3vg&oe=6A99711E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7OtBpxMqxwQ7kNvwHLogcZ&_nc_oc=Adozy4_gDqUsiWgqcRNNMH7zOui-CI8jWt5n89l9uDGzFLt1FboNRmB9ZaZlg5BeBZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZdFZYaXxxVqoNXKz9iUt2y4phlvc8sarFQIje_QIkdA&oe=6A99871F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlHWktlYRtcQ7kNvwEHNdQh&_nc_oc=Adr9pGTmWcuXykrY7PHt_qOCmcK-YUUqw5MWkohsO4uUXwhOdDxi81jVeHEa8LnkIRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIymw2_8X5RdPhjiIeE2Kd90BVyzhft6zgb07jAyjlAJQ&oe=6A998598"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
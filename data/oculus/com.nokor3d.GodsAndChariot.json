/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiObJoTa2PcQ7kNvwE7Fpwe&_nc_oc=AdrCBoegCF9EDCKxdZIkTcoCEqPWMXpKYeSqOzeud7iD24Q7tKzoydnl1W3PRa6joPM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pOLMOjetuUP2Np5dtqoIusXzMRo2PYoq_-c8ZzTs3Gg&oe=6A3D4B75"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHb5LS0I9XgQ7kNvwEVjxqU&_nc_oc=Adq8kQtL7uC6_lzosp1LakBxFeLH4o47dqXVNGbpwKft9RcNkDvgd7dAXlbG1rDJock&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x_79w0Cokcl1o-e34HYRL7KQWhFkHCyS-IkgRIoua9w&oe=6A3D33A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbHCF4peNjEQ7kNvwH5Co4c&_nc_oc=AdovuL0zdpT4Olwgi76cRTeyfr_2enRQPPc1wDq911V7vH2keplAexzlHZC-e9vk6_I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L-PPzynqENHYbrGKdrO3_aRkWI59FEPhEyk8gP9avSQ&oe=6A3D281E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzfO8Z3jFTsQ7kNvwHWyvHV&_nc_oc=Ado3KFe4w2mkvNRl1ouxn9Ac7LT2INA6GsBvbL9X5LBgl6x9Vh8z6rmrAr4F-uv2Zug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nyFMvdTzR_QXhfg7h7SHIHdyUgCRF5yjIxA4yGbP8yw&oe=6A3D3E1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFR2Ov0xiwMQ7kNvwGuhZDe&_nc_oc=AdoGTEwtFH2e2UFasc1dfclyDijWefLCcrRQvEFRkXLnLVpU7Z0jU4LEIvIejsNzGOU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lLkyd8gH4o8FwjmrzSwr4OY9q94G4i_tAf-QTLiRKcw&oe=6A3D3C98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
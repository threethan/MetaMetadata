/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73ZV3jeWtGUQ7kNvwFxfC0h&_nc_oc=AdoAO5rc7rKXQpQTPf_jHIU41PiMaZUdnfQDcsSvLmB3rtNyptzpIY50Fb3heOqBEak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBHKo2bsIoj2ttHn19BiD0f9Kw-NVOhHlBtPLJ1u_xyQ&oe=6A6B6FF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmkNQ-_dHFEQ7kNvwEh5MUy&_nc_oc=Adr8pIBPokadtXXVs1utjNU76u6qdU86hHJAKK7U5UVAkC26eaaX0XFafQa4Ja9pHRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdNCSXg_V74-cPFvPLW6L3uPHciE1Q2nXDSD-bOSAqIA&oe=6A6B5821"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDFVDo-ZEa8Q7kNvwEP6w3V&_nc_oc=Adr7GkAHsDerrxAzOKAXMazi9Z0alrzYcCPdmJYnlMCeC8kQYUYAwRatxHL9WqENmgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUKi7Kd6UERfmxeZuJ2eFST2r5AnRH2PSt7Hp4Z68lHg&oe=6A6B4C9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VU9PVX2bAVYQ7kNvwHeWG3H&_nc_oc=AdqfaItVR8KzqWwyfsClJD7ShKCipDe-1kEy1bMXrXFhbocqDLSLYF-ivW32iepbQBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiuCj1QoGf4f1d1bwCqVVZkuKeHS5tSl9FRCX864Msfg&oe=6A6B629F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSP0sBNbrV0Q7kNvwEmfp1m&_nc_oc=Adp5NRxZ_i20TQF9Oxi305Oj-TemhwExVEINSCXgYBJwno6xKWbjseu0bc56UbKO2r0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3DWTeMbpiVhGWxCKqD86ydADYvFPVXMs03oOkNGCQuA&oe=6A6B6118"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
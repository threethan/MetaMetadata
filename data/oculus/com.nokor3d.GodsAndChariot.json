/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsx0dbuEUl0Q7kNvwGg9fcm&_nc_oc=AdrzzHPGEZ7GHJKwtuhNFCnf36T7ItSTPsJ1AyZSG5ZFhmd4bYcK8UTc5qdSwhYvzAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Rr_EUWtnEuzZ_n6A1OvUisUU_v7GuRRyLzeNKhsNzqA&oe=6A1DA775"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAsobd7feF0Q7kNvwGoXIvH&_nc_oc=Adp-EiUfs9shSr6-vMyPosYnAgiCk1vZAeDVz_lTUbd32vWEjbUcdP7aRqMs2Ej9ipg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49dlzMnQ9p-LHQio4CqvMaQEB8sBj6tvI4WsQmu-AmFw&oe=6A1D8FA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0qLV2dVdGwQ7kNvwGxAjdc&_nc_oc=AdokFPzYKElRmTGWuAOx71-GVuYnnZKh7MhA7RoIZQK3QnJKEMaaKeGKVtq4SLj3BhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af680IAfnM4botidw10WpoY_OFPhuLUdXzMjBFDQZBvnAw&oe=6A1D841E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6GTpCE4eDgQ7kNvwGMkLcg&_nc_oc=Adp62EVlCJSu1aJ6lUeW_iv9u3cxQB08GfOdf2e78xJGnEf105hQduRYCvE8QnIpbpQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6utlVuVonUaFQtCBsHVFg_W_SRKTt4GieYvVWck43GhA&oe=6A1D9A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ckDtlfhZ3EQ7kNvwFvYBAM&_nc_oc=Ado0FombBF4u9D2zZ208BgWQpXBZ-gZZsIbCMttoC_grpMbg9X5gWUIiRNUKY_CTAKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bw3FueqLV8hB0C4lHpxF91KHuQweSAwn8J3g9bPFMLg&oe=6A1D9898"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
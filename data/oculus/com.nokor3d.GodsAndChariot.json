67221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAW-re02TssQ7kNvwHsYYZX&_nc_oc=AdmEWtG5jYpgE79Wlm5XMNbch4cFDVgYeHsXmS-CGfjkJ0JTOWSpEHP3xYj5SLPkXUM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjYb0yeQqJJlCl-BYcym2scDzskn8pHvYSiNTi9ylrGQ&oe=69AABCB5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izL-1Ry9-PwQ7kNvwESnJ9D&_nc_oc=Adnd_jKSrKLe1E-6rqFH5_hOep6R-5e0EoDgohtC1eC-DFvZnCUoF0shDXmLk42U0iE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9H3SfNlkuX26Nh1Rri8m4FDIxj_zCxJvgK-Leh3UtPA&oe=69AADD21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db4fodSSAQgQ7kNvwEArxTP&_nc_oc=Adklo7tdIu4BnsZpMSvHSMLyJP_VWUOXKdxHY8b3BKlO46tFAABeN7hX2dZwnbia7WY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7Hom-x5ctpMfuHcuEiH1QuidnGa8ogEkEC2-fc10rog&oe=69AAD19E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVjdy6uls2kQ7kNvwF32k5S&_nc_oc=Adl-saNFMXkneyVmsR2jI4Z4v-DxoTgZnO2ELCDUWWYN5g1i5NkyHVQmR8QZvwLilGE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPI1EXoR3ap446h7VHQxoQ7lxtAmSk_86qarJG_mOfbA&oe=69AAAF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtwiNWQjn0MQ7kNvwGdGxDc&_nc_oc=Adm2wCt-sazeLVxI841FxEePjkq2BOi2SfD4Y1id60YzmD0iHeqqOmgV2Q_Bot2Le4o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ7IT9wBrRDZSp72h0QTrEj2eEwmFZap_xjX8_U27eag&oe=69AAE618"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
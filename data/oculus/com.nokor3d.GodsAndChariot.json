/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxyPTUFUJYkQ7kNvwEekS8f&_nc_oc=AdoasF5HbR3bAw0YLigmhmv7RRA2gqMNZ5P-70t_Cpobp86V0aV5TvJV6c9ygTG5Zzk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXZ4c7SaxqZxtxC67gzt50RJ6NFM7ndXEGJ4Qmxmbkkw&oe=6A8838B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o66-SdaW9NMQ7kNvwHbIr-h&_nc_oc=AdoELxsA1-W4hztPk9BOC71G-t7ci1zGOgzp_uwA1-EF31GMRDmXqrOw2R4GxD94cJ4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERShJojZbOUNxl2Q8wQbElmgRpS3YQNRtw6b6Z420qGQ&oe=6A8820E1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fy-rTVLFpLoQ7kNvwHDAsQ3&_nc_oc=Adqq9zp1R98K7bBrFVITWVYnIl4ZuR7760dZsXsqw9kTNgUiHCG2A8FrF8v65zRvoSY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqxHwWtfsGKeTDNQCG_UcmrOnAVg07Ck0PTNCfUzoozw&oe=6A884D9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZETL0sh-xgQ7kNvwENb-VB&_nc_oc=AdrQZ8rFLU13C4iHK3OYPMxcq4u14fUwVo6_zwFrF9n0in1j_SIk89LW-BHmjgp93j4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG33gfEO0JxLpFEK1rkV4zvxIDN3xlzZAWNxplJPa3BRQ&oe=6A882B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plsbfC35a4MQ7kNvwE2Td8M&_nc_oc=Adoisy2FZTY9FA9XH-NN7fl_HjNKyOhJJNNBx6KqVebV1zX_aXLQT3W09-iElY1AWMc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExi_rPPECSDosAXNCZ2OU0npJq0PAlouDRjIIXFyvAhg&oe=6A8829D8"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
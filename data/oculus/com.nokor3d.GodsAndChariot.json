1-25/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xP_ihJYuwWkQ7kNvwHh1UF_&_nc_oc=Adr2XBsQfGB9oww1ia1Ucu3VL9h-0l86YoEIlZ_8nMOgWCMN1S8A1dZm19R-62kpNsY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mJbUiKmKfLoN8m1XyixwBzeAZkHRkaAbpIF6MmEwKmg&oe=6A22ED75"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63lbavR5cMIQ7kNvwGoCtgK&_nc_oc=Adoy0KwbVEhPXhvPsMorhwIBh-E5mMkWCgI4j59G4c1kQPVaLlpSHpix1GuJpj8VukI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af892p_jFzdvtieaAwrcaOnBPP5UEKTIDggNslvlSrQVZw&oe=6A22D5A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds7ilN04-AkQ7kNvwHvQXSJ&_nc_oc=Adrsw_Pm4oLss3wkhmfZMYLSEJwBGlNlkqk9awRCCzooqIk5dMzO5QDSXpqnesv_Li4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-98qVYkozvYIWu5ltJS1mwf6LyELA88vrZPgPNiIEaCg&oe=6A22CA1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9DVzYrNjG4Q7kNvwF6Djtj&_nc_oc=AdppPI9vcLE7rMv95EfIcMaklhWYjcmnSqRw9YSphcsTNKMgoeJ1LlOJQqtaq6XUOY8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BP1LRyC3c5o1JQiu4veIw9kR9oem1g2KZQ_NG5soJRg&oe=6A22E01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMf0wQ1OuUYQ7kNvwGBPW5t&_nc_oc=Ado0iD0s0ZpGvK2bAhiaM17_iHSjWlhgwfE6zRAnxJPkqqzDqrdgEn1ObdqwI7YzMbM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h--4KBRqZwzxLfTw3wLGxpFzh8o86u5Kl4FIe73Mkzg&oe=6A22DE98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C0v4zqlBawQ7kNvwFqb0Uo&_nc_oc=AdrkxcHKv0gI8FSVLXXsdJD72-yI9vzCajmTNNjx__8K1gmiKMbQgPwaWPX21H8eG3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JYC1Y2ZaI-LuTRNBF_z2gKCbRVDVOpbnHB2C5nTzyQQ&oe=69D4ECB5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgr61aSxMjsQ7kNvwGzolos&_nc_oc=AdpU_vqgtttZqH_N-nsvY65TguUjVeD0qlDx3kUht6saJLoJD0zInVi3n1c8lr504u8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CtvgQTikLBWv2ZnY_lGFwCLQKUKs3EMv4lh3moMW9wA&oe=69D50D21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRa45RFTKA8Q7kNvwFNrQD2&_nc_oc=AdpDPd9iK8QgcNxGMHtzdKEMKwnKHDfXts8MWuw_u4MRFdBpMDZ877D3CBODNGUwOgo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ByayC_h3tc8xSocUT79ds3TDIIjUoEkZxxQxS5rpwSQ&oe=69D5019E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOM-YfBHAWcQ7kNvwEZCCU8&_nc_oc=Adp_DIen5-nrZa2J2dwEBKJyFv8aiDs4D1dl8Dd0A-3YsPVWHGdK_lVLUQ5RdSgqC0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NtaNpPAHoR5KacEPcWjtyUa7-j9JJMkj9-7dSJkXonQ&oe=69D5179F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whb4Z0vo4vcQ7kNvwFqkaXi&_nc_oc=AdqLUbaxFEP109O-qwswWIwKWOP3t13UX3dPt0OleA1LpbDd_mn3SPOht5YXnuWwhR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GDaP8bmZUoiY_rWgQ-Rcp3N9WBYYj4X6daxqHdATnVw&oe=69D51618"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
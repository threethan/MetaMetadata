lwQ7kNvwHGc8Ae&_nc_oc=AdnZf3ERHI16J2Pyob1T6nNmb_D4vKLtYH4OMRvQc54cKpfgETyaPhVbXOX-6Vz-xIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft1Jmyg120UW5fLMTHn3J50F0hvL_Y0I68y1ICgCDbQUQ&oe=69A42535"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDN3RaWDEVoQ7kNvwG52kWE&_nc_oc=AdmAkUZ3ZcWV4LpKdcLnbmhxMFp8GiF2uLDBVBuQ_7rhNJxhbrMUMab5_c86E44QB_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvaRXGHKEFm6NZU27aX_YPSdcTDMz145QfryFdZohV1RA&oe=69A445A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r-S_4RXdtkQ7kNvwHiMl6k&_nc_oc=AdnQSN48Tl5curS77gbbeWPODqb9OWbvXtlUMfW40wkpQ007TjIIx3sAKh1hxD9jXVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfssB-zXzZ73chMO0_KG04ZSzuexutl1_IW1ncgOdUptXg&oe=69A43A1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6JrpgCbliQQ7kNvwGDCtRd&_nc_oc=AdnvYw-irY1Qk1O_h8bEfHYZq4HNLpLqjng4vL7XbY2si56VS25PBxRJum1J-nxC-Bs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuwzu2DC6OWPnc0eO2tR519bQIFFAfnNQgLDt1U_dcQKA&oe=69A4501F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAo5D0sL0aMQ7kNvwGDmxqa&_nc_oc=AdkNjiH5g5sVzTDKmrLXaxxYbGpATd05-n6iaG1xua1hp31WKFzHrJt4UQbrXT4IByc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuCX2SL2_Bq1xp7OYwnCvx_WgmidisqMxZsXKMJeIuXGQ&oe=69A44E98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_m
30Q7kNvwEmH65N&_nc_oc=AdoMkqdsZdCxf0HEjg72VSVFkI5YAOLR6zzXZBNR1bUgricMNKCafSM648qM225SAEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ahvs91c6-R25hrCSHaVuqb7vix1iYoQsOR4kWf7QMmA&oe=69F09C35"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JJtiKN-5M4Q7kNvwFjYroS&_nc_oc=Adoa85cMvrJELJb1oifU3T4W5IHF__P8KpvXmQXIp5neorOO0ZcXw5BLstxbnGYOzvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0SPke_NxAJdX8f7mJRtiq9YzXSag5I3cNgdeQ9sKsXFQ&oe=69F0BCA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFI2E_yI0wEQ7kNvwE9r3mI&_nc_oc=AdqU0jVkEM_wNqEL9vs0RKnzIvL-vjrtw5_HRfzrVNxxxwm73ZmwjmJkJBqGvgDjC7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0RA9AeRfFRpDs2sDh_nmUCnePCm-WXkrA66PK0tM9smg&oe=69F0B11E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2IrgyuOStQQ7kNvwGgEUhh&_nc_oc=AdqWOsArZER9kG8Eb5m5jGczmyx_CX4e3kGnU6o9ObQoNlJaZne2-Q12vpexi_r9yvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af21lCz0L1w_ZEqnFCMdCoZAXtbV6a1iQggIZxOUle7c2g&oe=69F0C71F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDzQtfA3abEQ7kNvwFUsezX&_nc_oc=AdpAKUSo2IS-9wOM7R6hDMAhgPbwvfOJFwXQAtWDuT9CculI0vzGb3huBtIeLdJNe5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0ocSVkgGWM-TKkgAOo-STqkInVU8e8dmQuuhUTMtr0Gw&oe=69F0C598"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_m
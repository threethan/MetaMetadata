/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGcP3JN1yxoQ7kNvwHUXSQf&_nc_oc=Adp8D8tPoDkMRWWdeOijZw44pGOqYBdLaidZnj7Q9HNdyp1hXPFR4LjCX49hrJBb86U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuSQsP5GixsI4gZYA3OlM8TkjqqFkKVCEojWUTx0adxg&oe=69C90F35"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWT03j6lI98Q7kNvwE_k_hc&_nc_oc=AdqGRbyGc2DN4hBMAUXyGg15Pijfw7s7cNanpexMmEWUHC-b2g5-ZSK_ZGX9s7jZUy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw72Ubcb8Aq8D3ND8HMe1CVtD2jbh9vubvAvWjZMauqgg&oe=69C92FA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhRwkPonh4UQ7kNvwG9Z5Fe&_nc_oc=Adp7cOLAOSgBV6l8J6GN18BJFgShYl_cILYDILT1JaHMSGqYsSgacb2bDn0LwfI__pY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIYZw1BxV2OpieAixaHgjdPMc1kDebjZdO_7Rba-xZ7Q&oe=69C9241E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsCzrKaDIqwQ7kNvwEavaYI&_nc_oc=AdrfOi7sG-_Y0MNwm3GmLcLX8cezTibF85PrH3dxzMXv6Or3vygzUTG9QoZbNyOJvIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq-pWpR-w5hWi1SlI41o2R4E7EkjoDAPYG1Ir5oOAR8A&oe=69C93A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgXtFdCestYQ7kNvwHOkMiY&_nc_oc=AdrlZ3GioFkNF4RoaGKAzQaGANh4J5EW_zZcFoeJFkM6y5W5heNZu68W9lw1WTS3Eis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwA6Ze05xq3RWLPWy37OdBP_QpiVTvRWdF7cnWCr3Q8cQ&oe=69C93898"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
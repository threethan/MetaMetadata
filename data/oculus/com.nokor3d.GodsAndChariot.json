pIQ7kNvwFGKnPz&_nc_oc=Adn9zUa0atHDKV9DPgEpa_VY2JhG5IUCnMTxaYlZHqFjc_TEhvq6TN1Hn1Z6yi2a-dw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftUjRuiOQwdDI-ic-x3AWFUEL0cCmxOzNjb3Hgx9QF0gg&oe=69999935"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuWU9xWSx7MQ7kNvwGM2bTo&_nc_oc=Adl2yv0E8Lcp8gkQiMzOOjosljgmixAEplTBBfmVaDi1lIlU3uWICot21MYQVfoRVK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuKnTNV71r5Z-3oLIsO9NC6AaTzrMtjkss7WIThquLiHg&oe=6999B9A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYuMpamlNE8Q7kNvwGUFkni&_nc_oc=Adm9VKLsNEGNNWESLeAqpXNlQkXKf0tT-6k2pm5GFzrSCK8ScS3Oke_DscpH-Zj2cEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNPQ4EScz4ZKpafHcXo0xQduAYbcnn_4ZYdfOCwnMJrQ&oe=6999AE1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=548AIK1vNrsQ7kNvwHqJjkZ&_nc_oc=Adk91OMoIbEkfEUJ61zgxa6HupH4dRUsfs1mDkQB2IaK0Zz73sz3WYT44SHxS_eQRUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsw3phgHjzQJdWu-FvJ0Qh5TDB82ZwegfDLllK78XF9wA&oe=6999C41F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fC9nysOSDgQ7kNvwE04tcv&_nc_oc=AdmlTOCzBlBv6qnOLaCsb2yC6MlaK5JDTz2tbTpl3s28LhvY0K1F5yuRL6uSGZduQmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs2Eh7S5DBHm-8iDZTD2YXO-XB71T0Z3v6kfShI7oxp5Q&oe=6999C298"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_m
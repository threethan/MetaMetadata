XwQ7kNvwEDJyLd&_nc_oc=AdkPZMDwNV_04mu0rLoBHOUj2YOuxz6xPc3eEIjDxf9AL7wv0aISfDxboMYueEvGaQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNeIZrDfEcu56fo5vrXA_KuELoYOdywC-2unRi8AR5hg&oe=69A6C835"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsmZr6ME4rkQ7kNvwG0dg1Q&_nc_oc=AdnWEkYhbhFfBaJSZ1Ulb5LbJnG9Tdtk1q0F_dFRBKfL193OPKwfYpW88mgFIAlz3sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaIkTxQbyagxrpWVyUuq6vpkXD0lZEiUerbQAyc_HvwA&oe=69A6E8A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r-S_4RXdtkQ7kNvwGgxsCU&_nc_oc=AdmuY_mUD33rUBiK14fspXPI80aaKPfRm2HP0z2NVHhhrRelhshBX9t8f2zJzqUoc2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWrgWDmVeUdAGG1bLyuCrMj6uv0BPXvltAWMZ1Yp73pA&oe=69A6DD1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr8vUlrQ_wUQ7kNvwE1WQkk&_nc_oc=AdkTIje3o6jkwe5kekmm_Ce6S77yHhCG3koqqGjfVLLqbgk872PYI5cFA-s8t3Q4v9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsi3foytGzSnPSHgxVA-dostbUuFCO5nahYipOQyLE5_g&oe=69A6F31F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAo5D0sL0aMQ7kNvwGxXffW&_nc_oc=Adnuymz9_G2h8hJH4u_KiNDu6EWZQICz-pG3E8IKnE84eMrHqA3h8kUl5Iky3q7yCro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4BbBm1wt7mxqA-0lCgxKtgOuwE5PX7kUVaXeoG9dQZA&oe=69A6F198"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_m
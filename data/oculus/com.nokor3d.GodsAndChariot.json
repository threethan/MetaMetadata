/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMcEAxp6mKsQ7kNvwH6TdUw&_nc_oc=AdpBbqPFj459KDGFki3KCUlvF1lfTAM1TAAsCAVkgC7FPycK0YpYkvXyoOtSGe8WpWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92dV_6Igv-C-nBgLJ45Knfoy3f0oKwxIrwRBw8sMO3UQ&oe=6A219BF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63lbavR5cMIQ7kNvwF6N1gA&_nc_oc=AdosXWFl1DeK01xDXyg85Gf25LUXcLWQSaxaYk0Bf7wHzZ-08DJ80niQU1MfAHg9cz8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_55IZqrhZLSphyDkBd191JTdUDcQSBE46KgQRh20ZkwA&oe=6A218421"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNcR2lE10zgQ7kNvwEqSn9i&_nc_oc=AdrqkcKGh25huCE5vsGQ3sij2XzUVXFVnA_Z9jYlp0ENXDYs3wCG0rgvCW50qfMThU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ve4JdORQafQjxcNuGna-YBkSeYWVolR9Oe60hH3UM3g&oe=6A21789E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9DVzYrNjG4Q7kNvwHYrd7-&_nc_oc=Adr9jaVlUfooWpCEY6TwYu3xIudmQJFc7bjY0LrB948uyz-HzL6UIN36aUM6-OD3D64&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ui895RadBgJB8mT_j_fOPFEMiOaRerUDpVdnJBsEqbQ&oe=6A218E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KCERwoxFo8Q7kNvwGigeoK&_nc_oc=AdrV-5CZ7ellVpS2YSYx-S-o5mbbG1Efb9DgIZtFMGRkRDysaLJPSuktppz-3BvOODg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qkwZoSPS2uaJ2S9ZpYa4enZiOtyzaH7DxtpBsrg82Uw&oe=6A218D18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
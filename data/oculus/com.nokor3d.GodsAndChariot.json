lwQ7kNvwGszZN_&_nc_oc=AdntIn8-3rL9TKmeOxkG39ZYHeYe4Vj-lTwe6hfNhUXlqKa1oYl2H6Dp0UDCvhc3ICs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afuw2bP7aD4CEO6eXZHy3HwPY4wQPipg2GsTEn6RVRH-UQ&oe=69A18235"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSzxECwMKCYQ7kNvwHXHFsy&_nc_oc=AdnzCs4cXuhQYy9Lma9sl3gFHJrDmBrym13C0HkSTx30QsEasUVCEwrqDpzm-A32E_4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvmP9P4qm6U0nVD9wWQUjXONhO5Z37hsh-w2ShFjENieA&oe=69A1A2A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h28ycQmzngYQ7kNvwHI2qtL&_nc_oc=Adl0qqdo7BI7Ym2ydwFl1AZHiN_r2dMWrsXOlzEvftK3tE1-j84VW0nLBkIlLMtUJ3k&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftZoY9wqGh4w9N8uycmWX-XtmJbo_2kNVxtXTv67I_P6A&oe=69A1971E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6JrpgCbliQQ7kNvwHTLNHR&_nc_oc=Adn-QBwPCHHKlxe_yjqG88D-cU1_Psf_F5Xu_vjeHsjtIVvdNpi6M5NE6Om-62-kzok&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvGVbcyezfdpBuLbHKG4-qyuqnlnd2d-rXkAQzwdOUboQ&oe=69A174DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqH6qBNKn3wQ7kNvwF0Wfrp&_nc_oc=AdkJKUHFLqi9hslLYZ98f8AG10PlkuKc9pnhPex2kWjzFpbrU8sKHn_MqZJV4lyXYPE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuUzaUqlv5a2sCATySNvsxksC64qQ5n71heg7Z_yKr47Q&oe=69A1AB98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_m
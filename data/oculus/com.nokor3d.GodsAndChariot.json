/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON5YaoF79pIQ7kNvwHDOY2u&_nc_oc=AdpDHYAX7Sfi9QTgJDMcU-4ALNXSrLsC7E-Hea7x2IWadatQgOr4_GAyq4ytiSuwTAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVsnIX4_9eYVJO_xi4bCxkIJzAIbsa7GoDQAZvbjAh9w&oe=6A747235"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1KCGQY-zrwQ7kNvwHbXh1v&_nc_oc=Adr1pNNI7QWKbtLNDq4r0SoJZIgvJ5Bb-OddLvBSTE1wN21Qlh0Di2Z5IBHmC7ChgRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOKmQvGr4gQVsNxTB5OPFMlhi_ploiQfHqG7liXlb4ZA&oe=6A7492A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bXemEU1cGgQ7kNvwHWb1X4&_nc_oc=AdrDd-viKYKFqcrwS0Gfr2EJRAU8YFGWGHi7-_fFlpLn1_JvcVINYGyvxbwoqgOaK8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD1KB7esjHO5PQQMyCqO6i66VIW-295pslcJCl26qq0A&oe=6A74871E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpfFMh4qSgsQ7kNvwE_fXqq&_nc_oc=AdrybWfYWsBM8pcUqa6TtlUEqw0-7pb0V5xnDT4nX29RqxzArpJVYm8bEg2BybbkldQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9Uxpl3ro0dqGyWK_Z8GHi43aqjXm5QDHPzo0dulyEhQ&oe=6A749D1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy3Rd9oNlQ8Q7kNvwEBNc3W&_nc_oc=AdrQJ179qPMCelsc1HgdqFxyA5y_bU7-Qetw55myx736mA8zxLhlbe-NHN75_hLXl6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIpu-WdWzeq9o-Lg6mjTkJUHgFq8thoHUDsQKQjL9RaQ&oe=6A749B98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
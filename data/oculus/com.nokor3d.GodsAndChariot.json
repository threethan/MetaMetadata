/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE83QYYXunQQ7kNvwEHPnx6&_nc_oc=AdomgWLECyF-3iwyN7lJrfBWTeXnwV3VdmgkLDIaqw58Ll0o9_YFKn-N2u55gSpd1S4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GksxXdurEz-_JnxPgc3yV_ei5Z2AkA0FsmSOtZYu5Tw&oe=6A131B75"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZjca7YkzCwQ7kNvwFCH8Fy&_nc_oc=Adqa2VCOIoPOsMv0iosvTF3POpaqhODHm3ht17SYkLuy82i6Y93BNSJ7CEP6A4n21Uo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eDo-kOnkzrZqJKOlwjwSIQLO2wMK3KgSyg9-HczbqqA&oe=6A1303A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpVmBWRSJLMQ7kNvwGIxrm5&_nc_oc=Adqmg98pJukYRSwSWGYNn4bNSJ8JAPg9JSt-ljv7Csa6Wk3HRRwjb9bKegGf0jrnTmE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fm7q7xrfxQYvHA2oOg-PxDkaVNtFX9t6t4VHPiXwg6A&oe=6A12F81E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sOxLdcNu-QQ7kNvwHGC2vx&_nc_oc=AdqfnhsC4stwHUxkYBRn1tU-TvilaWC363vdLsmicqy4xFMYRavKqBQ_Zl5fJrqb3PU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h2XOZbSkg89zL8al1MBfQslN9ZGbUncopyaOZa3Psrw&oe=6A130E1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRLpXMIChKoQ7kNvwGs9lnu&_nc_oc=AdrebfA15Av_H2nL5CXGmsA-tVHUSmSR_dp9vrG_OhH-u7Q0uI_XKrHgXxBmB6l0qVU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5izNepZma-wgxs5ukjzClovuqLOWgyDw7ODoKXYL0tjw&oe=6A130C98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
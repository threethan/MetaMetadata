/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZYvTq7THagQ7kNvwFTnz5U&_nc_oc=Ado3zklcoMIqPkI41AFSA-tvLSlMJiEbDWiA4Ppy4YyX8TyeIwatXZ9dQkQZmjGtcmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28BLQuJ0TUhRoZWB86BKM1bXPFLExJwJZBJ5Ze_QFe9w&oe=69EDF935"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JJtiKN-5M4Q7kNvwG_AByS&_nc_oc=AdokK5MAtipaOSHq830k0Q-gRnzDAJI_SxDFEkPG3bBl6aRe0Ncu4k1GKO5c2U3RlNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_7qw4MczXNtKX39TYl3j319gEK7iMzhv3o_D7-sYZMQ&oe=69EE19A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYOoMptWU4wQ7kNvwFy8X4p&_nc_oc=AdraMqVBj6v4s68sED8tSCUdx1EvXypK6W0UITIPy5mpJYNl-_3Ek9tdnNYujg2rAXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mEC6_5ewcVzbmzpoSUFWO1vdnPPmpDT6itLp7Y4hUYQ&oe=69EE0E1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5LXTP4NEwoQ7kNvwFHQ1es&_nc_oc=Adq1aQOZyLDTyt1hjYsDeG0kVAwxYdVTfEgReSrnhLz7IcQvBaPj17R9OfxatSAa3Xo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-rWc06j7AIiNFUzXseZONDy_UW9gpRr2Uq_Lppigdpg&oe=69EE241F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqipP0YNjXAQ7kNvwF_m-Ul&_nc_oc=AdqV2XNS1ZUWv-R_EiIsVHKZtotdzaKW85v2t0B_1IPC7lmr2YuuE6JY2LmExvzc15A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I6jp-Alv00jvUcM4-lsehATuG_mc3RKTpK5wvJJBpMw&oe=69EE2298"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8pFw9GNM9IQ7kNvwExkdiU&_nc_oc=AdqOLs6GyhbbIGKzWVvaC6m7n3VjNBqB-o2_mkvcnywYPBSpfU-rhSIxHPLHV0gmZp8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hn6gUQlRtlUTUnOECMAHnrw-YJTHqITFncZuIHqzr-w&oe=69F4C8F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE8T50EStOoQ7kNvwGoXEgg&_nc_oc=AdqF6y-CMnWTfiXQvNTy98jsy4pkv8ffQkVneO9uHRoBc7l4C71U-47HEVKv30wQUUg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19U_fd_ONR_GzSVbRTphW2bxZqlRp96iJS5jD640p9Mw&oe=69F4B121"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hin76zXkLBQQ7kNvwHXLGM_&_nc_oc=Adqw6SxNBqBFbdsjcWKFPblRW9lOyeNSRh4c_3k4eHupl61aZA8xV64WAOhBr75uRSw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X1tTDpdhsqVj-7wdYHGomGQfjLaqyTrtbhvZB4Xjzog&oe=69F4A59E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0ff8zkUP0IQ7kNvwGjfQzr&_nc_oc=AdrplhGJbuN33KAkyZKjVRNtfWwDqdPCyOvgPNmZzw31kfu63ETYmxxwzlp-Nsh1OvI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mpQ1Rwpch-qX6Vqnh8Xfo-k6u4NFO6WawpnmxPZ0_yw&oe=69F4BB9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Oaf7kCNrf8Q7kNvwEhQ5AL&_nc_oc=AdpGRroVcOLMy94aUMAd1knxUO-RMbaEAR9ewXXMESq_MF64Q69bq0Bs7X4NeMycicw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pmK2xbFdD1vbjUAKJCKumeOUuflq9XZlq5GH6iUaNtw&oe=69F4BA18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
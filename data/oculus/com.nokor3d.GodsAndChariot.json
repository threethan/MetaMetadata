/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73ZV3jeWtGUQ7kNvwHB4Y1o&_nc_oc=Adpf6SgkVQ-KGjj3gS4XVbSAuDVIxEtTj1fYCN_VGD5J81bIzb2Nx7LJYOaM8wgaoWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV7xuo2lnDD7ZAYCAYSnld5pIDuOYH4uGI29OoVEBKhg&oe=6A6CC175"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5gmWDt68SUQ7kNvwEqfzGW&_nc_oc=AdqhqogCTmQuxbqxhEI__CRXbue3A2ptEbnbcbH2Cs69RP00DtiUX5XcmI-9lNzHYe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnKbLFLknUu3GaY8D-QJB24AtnocRZpORs7nDZ7MWtKA&oe=6A6CA9A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDFVDo-ZEa8Q7kNvwFxbH0Q&_nc_oc=Ado3MT2HNVzTyZjd0DfnH56_9pWGCHp6poA47Rnc2JCRLOgPPZzEkRzE2rqptjJYTxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD23AL0NW6h8EbBCIDXXy9vbN8bMLep_zFRo13spKNl6g&oe=6A6C9E1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VU9PVX2bAVYQ7kNvwGyUdb-&_nc_oc=Adp_GsulTIPDMJm61Qrgnn6aiUEhH5pY-f-T_fQmXKkNeE6ufTkn96LxUltbOwX4f1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ64Aw_LumyPpLyWfjhydXpaBWCl6s4mWfHyaPv5AXaw&oe=6A6CB41F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSP0sBNbrV0Q7kNvwGUHPDQ&_nc_oc=Adrx-c9S3fAxKiEFAUUlvSdnj1zMJBKglhfNjicX6fltRessLaRhry3QPi_3CHZhT8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgXiDIWAsKoygYfUFjaMIVohWldljelb0SMhDpYsa3Zg&oe=6A6CB298"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
220409_4271574803231637803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VM1BzxBpfYQ7kNvwEnnQr5&_nc_oc=AdpEPVBz3B9bW4IkP6wLfRIW1ds6XcEo3iXfb2JqmQm-4e6cgiF7H9-TnQ2368OTOUA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqYKPbnbhkYrDWviMiuskzm95LEO-YJQMCre6XlhoxhQ&oe=6AD0F0B8"}, "display_name": "Wordomi", "keywords": [], "long_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 60 levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\nFeatures:\n- 4 game modes: classic, themes, subgrams and zen!\n- 100+ engaging puzzles across multiple chapters\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 60 levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://wordomi.carrd.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_mod
e=699D8B77"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKXQWl8tntAQ7kNvwHXX3tm&_nc_oc=AdmUmJmTWreBY3EZwj5QYOZDzqpjAjIwAfszi5G5rIUaVKewQvwYzM5ae90r6KHdQkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYi7rsRoaVk_0pOtn9H_gPZSHezquBRo5iZawC3KRkug&oe=699DA105"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFwq_H_EBtQQ7kNvwFXwcQ9&_nc_oc=AdlSvNCPzUy1waW349GvN6XpMqCWXF-u5ehbnYlj3zYtayTeuyk3eNDaUUIb29zaWsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu608VGHsKVMY8kjmZNAzwvKkPCXrPznQAxUUktQESfyQ&oe=699DAD49"}, {"file_name": "screen2.png", "id": "3664879603642755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820983_3664879606976088_8243000513474509925_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cfIgMYxy1oQ7kNvwE8SY3I&_nc_oc=AdnItaUwqrxAqbPzmeH26iHjiJv67_7p4TS5CvPRExhr8aK0vukGmWMXKBwty7h9YlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGpbA0KOfcvFCZDHlMCDxZosobJnTJwcr4X8XVm75yTA&oe=699DAE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "921066163825853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_921066167159186_2550957517103838150_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPMCampz3aIQ7kNvwHC5Vjg&_nc_oc=Adnc5bAknlrHDvpfDJUrYUFosMT68xsHQeGTq8v7kFU--OgkjbjEUBT3OSDr1iaVjEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsz_ojQfTlped8rGZbi7hr8qUMD5pk18G675eWyKe0CVw&oe=699DA2A2"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272
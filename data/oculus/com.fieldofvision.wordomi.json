.com&_nc_ss=8&oh=00_AfxsdmqGlV5VfUFCWUabFRfOa11-tNF7Bf5AoWBIyVkKgA&oe=69C146A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W87VObShZJwQ7kNvwHvNgI7&_nc_oc=AdqZ5BSMLbjXnZNYirSogPwqpa4xfjJy_l86EBWX-e_fB4ib3V1LDU7PWeA_UdYC-Ro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzREUUnn7ze9fds3ftKDCb_byt5XJigjmbPSq8KO_lFow&oe=69C13985"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxnsNP9_DiQQ7kNvwFyAt7j&_nc_oc=AdrfdXyBjrG9Uy9PjlUVS1kpWv6aAspS0pIzvIR5tUqP1YOgMj4TS7c1jw_eII2PuqE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZiI3gUfWslATNn1WCFPbqbqqf2bplaRZ8iCHN8DiBIg&oe=69C145C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATn7jpRUc48Q7kNvwHhfJKO&_nc_oc=AdqCtCGlsDV6DYKZK_pyov_Hv6L14-KpNQP_YsmJPAJhrTajUH9jT0-BaMl8LP-jwGc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUu9CAmEhDCYnRZTAwTzzSbM2_k-D11REeTlH69KSsdw&oe=69C14902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwIKa779YdIQ7kNvwGsFMZR&_nc_oc=AdpWbHydkDZZYeDb3DbCzt35ntukJYZyl0gH8jdllnze_Dbgr5QZgzR3CYSgl8uulf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyuylZq2AsD6oXzRO1s1F8MwToqbsL2VnmfxFDEcjjDiA&oe=69C13318"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
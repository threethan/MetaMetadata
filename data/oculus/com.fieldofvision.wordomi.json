_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af795-8w7u3854wuAXoG9f_UsmxWbKy_e831q14rQm6c6g&oe=69F9F725"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLRXesJ1n0YQ7kNvwE3UkVm&_nc_oc=AdpBOYRKkM4mHz-h1K6RW34Fc3UHiRVyQnk2KuSfNXTmoAtmYNTeNAmX26RmCPOcoA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49hbf2-nH89_3SvLh7jJ2ZUObWAIEqTgIOcQHIfQWHww&oe=69F9EA05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvMmS-mRveMQ7kNvwG9BxIc&_nc_oc=Adr8PTnSdh3T_UBBlW6J8w0clcXRNnPZBmx8rai69At1M6xk1VzagT3b00uQ9nxkNK4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L5f9EubFQjtbXLWmHQMb5IreyBcYIHZ_wzeMBLJ2_Tw&oe=69F9F649"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaruCODkBOsQ7kNvwH1-Juo&_nc_oc=Ado3GxERg49--M4llj9tFIJY8rTIbVWPDitu8GJgk-lDro-cvs8KebVU0cpEMjCFZBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_8sX0SUg7kVD_NxiyO7Kp5e1_7fdgdpeKCpiJJebn0g&oe=69F9F982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHugl3kh4UsQ7kNvwHLo2qD&_nc_oc=AdqLOudPWn83KV77_o7Qbs7nkhKkIGJDoanKcqPxbGV6Q1uewrV2eV1QgfdAm5NJVlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lxfHlS9SzvjNTfJptaSl6_qHRPjD9Ft9lFgYds2biTA&oe=69F9E398"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ7MDGqgYCPNqHwSpYgnEPUnScA1z1Xbda8TYDEGWgbg&oe=69C29825"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W87VObShZJwQ7kNvwHfNPgj&_nc_oc=AdrZzbXALbNWvac9qrkUPsIFqPqV01YWR7oocB-t8O6vLBKiebAMx4HyPWcuehLdd0c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyboI6fArvEkDeDH4fuk0p_nGPPBnLstHrEqD21pnd8ZA&oe=69C28B05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxnsNP9_DiQQ7kNvwEmgXl5&_nc_oc=Adp7CaIadL81WS4QPN3eEsjooMgsuLj_YVinGesAeUx0eFqQ3q8fJ3QNry0oiTamH-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0jFw56omUqjJCIIkFzb1ooDCixr27Ls8LajFPOhpguw&oe=69C29749"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATn7jpRUc48Q7kNvwGQIili&_nc_oc=Adpu87w-l9v_y_oPZOmeJAfNxwVWXMrkb21Hgyef9K14A4qxFQ0PqK4ij0QDlhWG_cY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlAF7kl9K-NVpSxxra8DaioVAbkP-Kx9IbYDRzvXhviA&oe=69C29A82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dDI1wi7LTYQ7kNvwHsYTvB&_nc_oc=Adrgcog_wO2BJIbfTWtEPc99epTP_vLPzSUTH6UU8oA_I8lEcAtzlkrWSXCItik5hGQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXm0yvBhKSH6ZLW_8XiPLLpwD9GpR-zSt1MXyImiwd0w&oe=69C28498"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
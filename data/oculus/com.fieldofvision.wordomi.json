4.5771-25/499625088_1069155728960997_339046014512350847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm6nx4puNjIQ7kNvwHv5Dk-&_nc_oc=AdoPfegkQIGGEeK4bEdUmwJq2JeOE_mee03HSjcgpv5I0IIo7L2UQF_YOf7IgxHVEDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcT6Kh6tMPCA1Ul1ZRWugKrDUlSKhnjM9Ayw9gG1pM9A&oe=6AE4A014"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNt6a1PxEU0Q7kNvwFmksqe&_nc_oc=Adqc65E1C96_Sn9URGtD_JD4brKs5Zk-5VTePftx8h3GRkzPmX7y678nYNXZb9o1qAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwcOtWL65IAFfr1xWqJnXQh2JhjnApYdVcr4Ltzstgsg&oe=6AE4A482"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qruld622x3EQ7kNvwFkG4Vc&_nc_oc=AdouY43Y2N4BN4ufB5gyo2OJ2D7HWvuP4E91F2DjVdQqN-98QoxrVCZ4JBYFEV5x_9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkJSng1eLFnZVClZagwaJYRGzdj6oUXmfEGIEKNUme6Q&oe=6AE4A149"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "1622088409560801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628050_1622088412894134_8306953703184101436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxOq5_0bPUYQ7kNvwHMMTl-&_nc_oc=Adr8lw2UUGLb_vBKY-4HegHL_YuzNUI93YEniAtxxUxQoB-zVi-c0m7b6RXi7Zy8ASw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz5MeqWTCC1lTkgMQZlcSCPCD1M1tcQnyzdwBogfqd8A&oe=6AE4B446"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                                                           \n{1244238498769603}\n\n# PLAY TOGETHER IN MIXED REALITY\n\nTeam up or compete in online and co-located multiplayer. Share the same physical space, see the same puzzle and solve words together, or race each other for the win.\n\n{1704142544150911}\n\n# WATCH WORDS COME TO LIFE\n\nCompleting words now unlocks matching 3D objects. Discover more than 80 items, grab them with your hands and place them around your real environment.\n\n{568815945784852}\n\n# A WORD GAME BUILT FOR MIXED REALITY\n\nWordomi combines the instant satisfaction of modern word games with the depth of crossword-style puzzles. Reach out, manipulate letters directly and solve each challenge using your own hands.\n\n{569458915781045}\n\n# MULTIPLE WAYS TO PLAY\n\nProgress through increasingly difficult puzzles in Classic mode, create words from shared letter sets in Subgram mode, tackle themed challenges in Theme mode or slow things down in Zen mode.\n\nReturn each day for a fresh Word of the Day.\n\n{932362641761393}\n\n# ALWAYS SOMETHING NEW TO SOLVE\n\nExplore more than 100 levels across multiple difficulties, with randomized word sequences that make repeat playthroughs feel different every time.\n\n{370575866112854}\n\n# MADE FOR QUICK, COMFORTABLE SESSIONS\n\nSit down, use your hands and start spelling. Wordomi is easy to jump into whether you have a few minutes, a coffee break or time for a longer session.\n\n# FEATURES\n\n* Online and co-located multiplayer\n* Cooperative and competitive play\n* More than 80 unlockable 3D objects (more to come!)\n* More than 100 word-puzzle levels\n* Classic, Subgram, Theme and Zen modes\n* Daily Word of the Day\n* Full hand tracking support", "short_description": "Challenge your mind alone or with others in Wordomi, a mixed-reality word puzzle combining the best of Wordle and crosswords. Solve 100+ levels, play online or in co-located multiplayer, and unlock physical 3D objects that come to life in your real space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "29003956079240115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626728_2202661997027800_2464473830082602478_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18pMuwxrQssQ7kNvwGOZFBx&_nc_oc=AdrEP3Ya69HuG5hDbiy367onzzygff-z8wQ_ZSMCYdLczPMKJby2t2V5nMzpeD7W3_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeFu45_bNPAH0ZjLfkqDXDb7ADLN5LK-LbV2y3aQyU-A&oe=6AE4BCC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wordomi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1706896800, "lastRevision": {"nodes": [{"id": "7368881933174175", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7368881886507513", "i
c_sid=6e7a0a&_nc_ohc=YGPlo2fOryIQ7kNvwGQMHGM&_nc_oc=AdogQA2cxlaj7sV8TQGh6v75E9Irn_yMYSGAH_Hzx_-Jgex1LBqEHQmleB-XxDvsf1Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R-jSmajbwmTILZzZSJbTLEzl7gFwC4axAotvgTycNRg&oe=6A22D5A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZVy0eWbh5MQ7kNvwH2shAl&_nc_oc=AdoHN5n5D0WeI8INa-w4GHK5w1NxVUPmUEEHx2yXH_kfonFSssVko0UaJMxy0zGhhUo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sHM6jW61PaYUUCWfNsXc47iqi0KhGaIEjXBM-NleXFQ&oe=6A2300C5"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YJqb6Rgbk4Q7kNvwHJVAid&_nc_oc=Adq2LZVX_SbLIBjvlbLuDdsB3WFZlW4urlAMiIkErEzXzBHpZ8-5_iNJbArdwLekRNA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1VfYMEYfNsTHUGL9dv5bax-YkTKnMNunuiuR9--nkdw&oe=6A22D4C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTRqTdE8UjAQ7kNvwFgdyi1&_nc_oc=AdrnrpiWbMBDXzUCrNppe5DHU2ykF3mLTl0pI1ZJZONz3yqHlOiSYn_gK-bh2QhmmbA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uimWpwy4GYeGPdJfXKS-WipLbH6OWsxVtE10OfMZ_FA&oe=6A22D802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bcJlkTkciwQ7kNvwEOQJn-&_nc_oc=AdqpdUCCZ9bBu-vATI1OIR_4TzQ_y1zyaEFzvgY-JPp_TvyglRpVMYTXiSJmhTEgWD4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m9nbYZ-5xpO_jDVE74cMAIDlCRWTNtpDGJRWF5rjYhQ&oe=6A22FA58"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_ur
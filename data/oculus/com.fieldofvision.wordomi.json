ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCT_SsJE0gcQPN_4oKKfEzhrIcN-MUpmM7aBVNXbl6Rw&oe=69D118A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34YiREOrA2wQ7kNvwFkrywv&_nc_oc=AdrHS6Tc6gAq51czXk63f9u5c0myVrSe1nFEtP5CZ-b2LWy7eYVK_uFkoBhpol8HDOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyThPMKyDBhud2g-wRF-xhxGpCwtjM3OYLwGL0SzijL0A&oe=69D10B85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmiUxsnIQj0Q7kNvwGBh6kq&_nc_oc=AdoLJqTsNFbjJqvMTutswDa7QjB4GH8OcuOmn1QygIbMAETr8lFVA9gOTlzoccky7Tk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAcVZEca-rNvwzJC9s22oRoQYkfkgohOS-Rzb0yBGepA&oe=69D117C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6okwBfDr__gQ7kNvwED1Fmr&_nc_oc=Adq2mxD44mizH9XfFuMyhUJRYrUpO31_Pq2R4se3_b_rJHGRQINJlJo8rvN6MO4Rw70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5GhazN6hBlQ4K8jHgJhJd-ctpQpRnBH6-H62FLSPBKw&oe=69D11B02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n-W1FTpcr8Q7kNvwGUzoje&_nc_oc=AdpNhrbqdaiAp54KxKT_BLQ0qxusn3mTprsrP4jT0yr5JnJKV_u3IaMmYtzmDMvQyjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4yf7qPJ33eJ9JzVU4Z_91unqaGVtmYxrP1d8a6eDhgA&oe=69D10518"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
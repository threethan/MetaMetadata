n.com&_nc_ss=8&oh=00_Afz_b9qlponZJWmlpUGfy3xXcg7txvf510rigYr9U3gR8g&oe=69B174A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgjSaCYC9TwQ7kNvwFule1S&_nc_oc=Adlt8N-hjU72roBzdn6vyee0aMizPHUJXep2F2howCiOThi0JiMIxx_sTZISVS7rFwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUZr1hDdZ6Q-iKQ5pv-AnNwqZBFoiC19auCwfN9HEFMw&oe=69B16785"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb-kw4vcCJ0Q7kNvwF4p8K_&_nc_oc=AdkP5T1IXYLpD-7UyMBX_xFUikSUAyYIi5ATLYlaj_mAkTLhcbt0ZjH47x9RgjLiwF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWw6Ms5nEWsv7FJkJd6ynJu7nrKr9vp3k2dwjdlmFn_g&oe=69B173C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tRZUxWEig8Q7kNvwH3ZXL1&_nc_oc=AdkrXtOMwQ2OVF2k2j9VXlntEchQlMQErOW0YadLw24EHtPA2pqto-vyVSIeAcqVsAY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzho9J3Fw5S_Hc_vc8SL8vrc306FJsMysBf9EYakUgXoA&oe=69B17702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qIuHRkG3ZkQ7kNvwG82_QF&_nc_oc=AdlJM5pse2lUwngCbWR2KdBMxRY0hBzcvWsYMDajTYveMpeTcMwj8qLa5f1FHYIA28w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxE8TbBfWcoKIBjlkJyoebG5zM6HStcCjuo33LB3_VXGA&oe=69B16118"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603
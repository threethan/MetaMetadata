n.com&_nc_ss=8&oh=00_AfzBXYH2bgvLGpRKUOdQ4Yhe-4qdamNfdsg0oDoTvGlTIg&oe=69AED1A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAn5tR09ocYQ7kNvwFJdl2u&_nc_oc=Adlsul8gSNgo1BwHeezQf-UQbo-IPuGVNNOzhCdFle3J53IKQyuZXgH1SKU92C8gPnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw33OwsoW_T3DiOTDiV1m3YslElLkXeBQegntG5SEU5Hw&oe=69AEC485"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7nWI_enZcsQ7kNvwEB3OBT&_nc_oc=AdkGH-1FQGPSo12hiYiNgQ0QClxkbW_Q54mWBjATKF8opeLgm9Ql8tHOlroeIcBLns8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwabC2NAxsD7nMmqx6CSXQF_pwxthbzrHEFL2mDCYZH7A&oe=69AED0C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTOAFo3ThbAQ7kNvwHSfKim&_nc_oc=AdnAHj7EGpvVodLRPBaGXF02CRhtxG1VgXZJrQmXTJuBqjAq4KRIHqk8vQ9nyq3Jf3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsbAMO15kJfLXmCrvEtbUXrCQ20kiGD9G3JuFShaPiZA&oe=69AED402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qIuHRkG3ZkQ7kNvwFvdYcC&_nc_oc=Adl59P3ghCDJtoRt7NW3HZs1ODx-FevXy4AzY54nINMU71EDOG_uh8HtioeV_bu6sYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRAW-ResWeUsuoAV9TkKfxKgsdg-bV7xlYsC-qKovglA&oe=69AEBE18"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603
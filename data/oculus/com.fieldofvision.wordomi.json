_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xkSzQNEwSEYjhHABKpu0qvA8A20jEP7q2jESDRSMarg&oe=69FB48A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrPLe3o9q2cQ7kNvwGyPeqg&_nc_oc=AdokbrXqDbE_ajgw54_OnIP8B9FDzOOYtjeeKqPaownwZcYmzqQi5jcogJH3Qs_JkXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qq2Ems0p3R-coYz1U1f14kIkgK_daQ8y0HjdmsCdEBw&oe=69FB3B85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvMmS-mRveMQ7kNvwECv4of&_nc_oc=Adrgi2EgR91_pfpMQlhrm4PHjPNzSRTYL9fIZKrDgo8ejoEcOHPUuP7RMS766Dk8p9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sfhup6_h94DxlgV2D2TcFipFplZiv6EMoRnN2z0wMwA&oe=69FB47C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaruCODkBOsQ7kNvwG4qHBv&_nc_oc=Ado5jjnx61rnqoMIHyd2kSEt4vWnAO-q3KwoIQikCoh70Pd1W6eA3mzrNSFOTmw6Tow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MHe_rOnkzVmdl1R1GGZHYcvFR5A2DJtODml-Q6QEjVw&oe=69FB4B02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHugl3kh4UsQ7kNvwHMTOud&_nc_oc=Adr-ph7sJgO250sVoIL2Y2FuEqlli9RgPKT1bUD-mIkcJioCtTGJxjPoXcGd-0S6loI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O3ITFsUFm1fuRYRjLTMtaAwg2ZijUILhRFIjwkdnYgQ&oe=69FB3518"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
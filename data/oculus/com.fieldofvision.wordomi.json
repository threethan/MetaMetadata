WThPE6Bx8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7p5hTDNqqrxOkKNEUgXZpWKxjXMw2wD2UXICtcEVLyw&oe=6AF47682"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTp0Jozli0gQ7kNvwF967nc&_nc_oc=Ado2ZkilpGeQOQvBn18Uwhg6aWhr7KbhKEc4x9hJCrKTFUk-jCVEbUE2mTozZEIL_9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCViaif4umPfuof4zOLjGzDcnqHWgFUe9zEcMc7Xm-fQ&oe=6AF47349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "1477704947613653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620599_1477704950946986_2254980149306166408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ui174MBIPcQ7kNvwEoRdfq&_nc_oc=Adoq5NMG8NWE67i6N_bNZ52JATS0qq62i4wFUEfPHZmXlG9Qm4CYKjqPfmmqkfDUvC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrCO_Rt2klgQJMqOXLo5HQA-lD0ubgp1l2ptOLXBj-rg&oe=6AF47574"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                                                           \n{1244238498769603}\n\n# PLAY TOGETHER IN MIXED REALITY\n\nTeam up or compete in online and co-located multiplayer. Share the same physical space, see the same puzzle and solve words together, or race each other for the win.\n\n{1704142544150911}\n\n# WATCH WORDS COME TO LIFE\n\nCompleting words now unlocks matching 3D objects. Discover more than 80 items, grab them with your hands and place them around your real environment.\n\n{568815945784852}\n\n# A WORD GAME BUILT FOR MIXED REALITY\n\nWordomi combines the instant satisfaction of modern word games with the depth of crossword-style puzzles. Reach out, manipulate letters directly and solve each challenge using your own hands.\n\n{569458915781045}\n\n# MULTIPLE WAYS TO PLAY\n\nProgress through increasingly difficult puzzles in Classic mode, create words from shared letter sets in Subgram mode, tackle themed challenges in Theme mode or slow things down in Zen mode.\n\nReturn each day for a fresh Word of the Day.\n\n{932362641761393}\n\n# ALWAYS SOMETHING NEW TO SOLVE\n\nExplore more than 100 levels across multiple difficulties, with randomized word sequences that make repeat playthroughs feel different every time.\n\n{370575866112854}\n\n# MADE FOR QUICK, COMFORTABLE SESSIONS\n\nSit down, use your hands and start spelling. Wordomi is easy to jump into whether you have a few minutes, a coffee break or time for a longer session.\n\n# FEATURES\n\n* Online and co-located multiplayer\n* Cooperative and competitive play\n* More than 80 unlockable 3D objects (more to come!)\n* More than 100 word-puzzle levels\n* Classic, Subgram, Theme and Zen modes\n* Daily Word of the Day\n* Full hand tracking support", "short_description": "Challenge your mind alone or with others in Wordomi, a mixed-reality word puzzle combining the best of Wordle and crosswords. Solve 100+ levels, play online or in co-located multiplayer, and unlock physical 3D objects that come to life in your real space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "29396743453294707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620341_2175673690490845_5599483482677607817_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPOQYuy5178Q7kNvwHXA0mA&_nc_oc=AdpgNlT3jboabe_6yvSvJupjm8FzP0xUAkAS3jf3UkozGtMrnhtvxh4wu028PfsiaKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBjGOZf1Rv8huCX05u21PGbikHpMuhWcR40nysHrxdKQ&oe=6AF48793"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wordomi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1706896800, "lastRevision": {"nodes": [{"id": "7368881933174175", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7368881886507513", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "378121321572353"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "HERO_3000x900.png", "id": "1529719164490748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_1529719167824081_4040807319186681798_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIGTbSRZXHEQ7kNvwFUWQhW&_nc_oc=AdpaBDPOLdYbWrJpUXktjeQJMZ1aJKXu6MLgsrNirDXzh-LZGZONGDmJhIBKxvOzfEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&o
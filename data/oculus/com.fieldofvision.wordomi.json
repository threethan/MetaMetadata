E8Q7kNvwESWV-l&_nc_oc=AdqVaIXJBL4X-n2qvWaSoyeYAMvdCcQvqROajVukPwqRbxZdwj4NSoe2n84cnzOnejA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-4998masB59LWwuVxZuo51GBx9L3sM6TYcr9hYkN-Fw&oe=6B0870D4"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7XaZ0VZ3T8Q7kNvwGgwwl3&_nc_oc=Adpwcm8Fkv_pXL7uH3VcnLAwEdDN_ztvaDA4Rdtuj2fiPdaBOICUwwkvePRFLCMvgp4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThLaCg_RjWA_ygzW8FY1srY0u2mnFCxvA6AMgkhD0Nuw&oe=6B083D02"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID90jid0xzYQ7kNvwFgsTHE&_nc_oc=AdqONvf0S6vK4CEHKHUR2NzRBuZZ11bV35IgIR_i6dVxZRko1-ANhL31OpULlfzEjEs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdNk0T4Lrugjqc4ZSOwnu5_o0JGq1sNaNtKr7uM7uHwA&oe=6B087209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "1477704947613653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620599_1477704950946986_2254980149306166408_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBHyhorhaIoQ7kNvwF2JKuF&_nc_oc=Adq5cxsT07X-5BiUODcirYZcMgYHKVdODcWXTRyz4MPPNm8hFJvTz9_j4SZpL33kexM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwW_VQW7hhyWlfo0ow1ETKm51MRF0BCvFtUqrlY2HHIQ&oe=6B083BF4"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                                                           \n{1244238498769603}\n\n# PLAY TOGETHER IN MIXED REALITY\n\nTeam up or compete in online and co-located multiplayer. Share the same physical space, see the same puzzle and solve words together, or race each other for the win.\n\n{1704142544150911}\n\n# WATCH WORDS COME TO LIFE\n\nCompleting words now unlocks matching 3D objects. Discover more than 80 items, grab them with your hands and place them around your real environment.\n\n{568815945784852}\n\n# A WORD GAME BUILT FOR MIXED REALITY\n\nWordomi combines the instant satisfaction of modern word games with the depth of crossword-style puzzles. Reach out, manipulate letters directly and solve each challenge using your own hands.\n\n{569458915781045}\n\n# MULTIPLE WAYS TO PLAY\n\nProgress through increasingly difficult puzzles in Classic mode, create words from shared letter sets in Subgram mode, tackle themed challenges in Theme mode or slow things down in Zen mode.\n\nReturn each day for a fresh Word of the Day.\n\n{932362641761393}\n\n# ALWAYS SOMETHING NEW TO SOLVE\n\nExplore more than 100 levels across multiple difficulties, with randomized word sequences that make repeat playthroughs feel different every time.\n\n{370575866112854}\n\n# MADE FOR QUICK, COMFORTABLE SESSIONS\n\nSit down, use your hands and start spelling. Wordomi is easy to jump into whether you have a few minutes, a coffee break or time for a longer session.\n\n# FEATURES\n\n* Online and co-located multiplayer\n* Cooperative and competitive play\n* More than 80 unlockable 3D objects (more to come!)\n* More than 100 word-puzzle levels\n* Classic, Subgram, Theme and Zen modes\n* Daily Word of the Day\n* Full hand tracking support", "short_description": "Challenge your mind alone or with others in Wordomi, a mixed-reality word puzzle combining the best of Wordle and crosswords. Solve 100+ levels, play online or in co-located multiplayer, and unlock physical 3D objects that come to life in your real space."}]}, "developer_name": null,
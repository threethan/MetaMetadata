c_sid=6e7a0a&_nc_ohc=vaQF4i3BSJwQ7kNvwHVUudw&_nc_oc=AdrYD136nX4WDx04LTU49hmY0D8oypFG4dulBmCKHs-hTMjy1ubrqgbkdXxibfLt9Bo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ITyepJ-KDD4BfTqqUb6iSArXr9hf9FCydlb197qDUdg&oe=6A11B225"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XX5_PwO3S8Q7kNvwFytxoF&_nc_oc=AdpcuGTlRkNyWmgopG2ZrsrsqWMpm1i29Rg7E9US-leYzzecIWNHmAeB6d6yHI1VusI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56y-YFrQq6vL_KhpB30dlk4EGtYPFJZ_TlEs1khFEBkA&oe=6A11A505"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPuDLh3lnKIQ7kNvwE6ytoX&_nc_oc=Adr3UuRkkKghViXnNuRaG3SBsCjHUkaSYaf4uxUtomotXKqjMXfK4-3KH5NpDHMnDME&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WiTww1kFmw0yYHhY7wLx-F2Zb4LMXApk1b6dlFaYmtQ&oe=6A11B149"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8SyjQyH6AYQ7kNvwElVTP8&_nc_oc=AdpRsZgBrTKgWYrb6YedTVulHvaj91vlavi9dZ3W6QakUeCO2jLA9onkuT9-JDPzEW4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jEiOt3jT-dIg2KOZOv2jlMCBNMGAXO0A6VvZ0GFe1zQ&oe=6A11B482"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NGvP8RWhpwQ7kNvwEMD5Aw&_nc_oc=Adqwlu8tMgwPhs8aqz2Vq_al3hEEzHY6dA7oJndUcotgoqobnuHHgUzkjMSZsl5hyxo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vg6b62QE5qEhbJVaVEkxN8tlzW_e-VsxFmeSeCzOptQ&oe=6A119E98"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_ur
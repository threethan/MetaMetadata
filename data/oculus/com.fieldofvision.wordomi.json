.com&_nc_ss=8&oh=00_AfwMQWPxZvMG83eHV0WBNBRidXIQWazgugQsyg83uvzJUw&oe=69B80C25"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5MHuJJElfkQ7kNvwE05Puv&_nc_oc=Adn0wPtOoQgHLX-ku6GrdSOAnvGKDhK11HWvCpPMPqYaNorQujhSpyU8Yy0Nzh7HdgI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBcrvoVUV23Cy9-LB5TeDF1HnVUsG4o5ziR12eB0vu9A&oe=69B7FF05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvoTmjDGUyAQ7kNvwGV_vVv&_nc_oc=AdkJYWPtoNnkdiR2lGajAI3F8_Oa1JARRlgodD5r_U0O3yp5o4I3-BP8MjK_geD6IUk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyPMIkIONZFPgK3_hOuqJrLn0RnF6ChnFyqbE_KQeBsA&oe=69B80B49"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEn4taXPkk0Q7kNvwGAWPz9&_nc_oc=AdlMScT9crlRy4Mv0hsPbH5vmLZBz7UPaQcKvixYDG2HQZiDETWRKDsXGpRFukm7B-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwgFLxubiBMcXi4AIYS9M_Q5KulzEogInKm2OEy3JkTag&oe=69B80E82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agnSbKOaxNQQ7kNvwFhdooz&_nc_oc=AdkRq6Z4kI3tyMw-teX3y8pUl3nuhgCUKpbpJ5xvShncVMr6Bu2mL68D5l3MGwn1bAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzm7tBA9Q_DPysehXBA77JRv1d8e-ipSDFZYRcK7ErgPg&oe=69B7F898"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
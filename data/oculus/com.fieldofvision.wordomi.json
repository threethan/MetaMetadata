ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh1e-Z8_0UihsXPQNEPGnc00Er0SCDmBz_maUVtRXJhw&oe=69CE75A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMuLQYJJuSoQ7kNvwEyr36-&_nc_oc=AdqIu9ROg11D6dj6Xjiuzn8Wkv29hOkHWWW2dImOmyX7JB3wg601gASEI0CIY1GkOtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCLBgqm0-C2lUIBUHNusLjFziJlxpPpf1ngRQJ9ejQ3w&oe=69CE6885"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r-d8-q-7YgQ7kNvwH-34Ew&_nc_oc=AdrMzQ-mq25BWG6eXmX9Qzx6EYuD5EBkyP5ZXD4ZWXEj2WCmGAjPxXaplpa8we04GTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiJAL4dZ1CRFlm2jzG15rlWQ3oiZAKosByT--XeYBmFQ&oe=69CE74C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-WmeDEv22gQ7kNvwF6SSMm&_nc_oc=AdqFBcop7QuyVnwc6PfM6tLdmPJPyazH7t56PZdkTg4WP_yO8pHkORDnZudg66H_UlE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwknHrE0J68ZgJEA0AGzdV_UJdEJG2uJEYZ-9vlSvaicg&oe=69CE7802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n-W1FTpcr8Q7kNvwGMaAvN&_nc_oc=Adqymcj1fpOp5oJ_4RtZuso49WJoYqEcBKO_el4Hs_331O7Fv-GwkkTtL-8czxE0_Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4EcHWmQK7amagHL9hvKE5aLutlo6dZ7Mpb0tJpfaI2A&oe=69CE6218"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
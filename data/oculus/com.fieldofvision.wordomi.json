ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj-6kSfdPebveE4isxBO0xd7qjJcRK_7bHIXWYUBpjHA&oe=69C3E9A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRicYYs2YI0Q7kNvwFeoOTA&_nc_oc=AdoQFnFYHC38MnPBWUtJ3vaJtqxVerw6ndkiJKS60iUimKXw9Su9BAei138GVIHo2fY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOThjxmIJKASYvLqX-zjEEoYww9inyvPNNrpgbqtkUuQ&oe=69C3DC85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxnsNP9_DiQQ7kNvwG71N69&_nc_oc=Adr6NaFg0FovC2duizGd03SoK5XYiQ2eib7JeBA2oc4WXciMeLdCn6fwZaiEpA6qc7I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRG8ub44TWAGDCutyS5MX2LfMLjSUN8m4D-SePkdgeGg&oe=69C3E8C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATn7jpRUc48Q7kNvwGLzF_4&_nc_oc=AdqZfqkJdYWh2tNUBdFe6cZx2c2aLvCmQ2kOonxFOEiejFIRK-r7sBjiqGf2oF1onYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0sBTFpMoYsAfsfp8S075qJUT4_Tqet0w_2WOaWACxfA&oe=69C3EC02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dDI1wi7LTYQ7kNvwEqyAb5&_nc_oc=AdpcK2o8uQVTFO5OPlErS2nAkAc3wf56i16X529dthMHv3ByqTFi8yuWmYOUdRe93-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbOIRJ5SvqjmE12AM1kZytgJ0fnLqvPGDEAHGNCRgTcA&oe=69C3D618"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
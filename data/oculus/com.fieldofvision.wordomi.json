ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzcz0gNdHGL9COAgkn-Us5EmCLjvYUk4naz2ELa47IzEw&oe=69CA8125"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L8WIbG8p0IQ7kNvwGU4wxZ&_nc_oc=AdpJcrlZWZq2P5VP7PVZuLGEFbOXrkacmbLM7h4YFnwQoDk8eley_Di6kW4YqF8rzOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6S6MudKEuIdf_5yWVYRcFqrmmNJUfF1Q8ewzwIjef0g&oe=69CA7405"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg4Upqux99IQ7kNvwGagnRr&_nc_oc=AdpvIU3rxZ8vq8G3A_owV4fCWkM81L1W9-IEbQiLXVWF6acubEAfXWB6Nr1JaQAnjg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVm8aZvdnOglOosRUkRAvZ5VYYsIzXv6Hlr2IXGaVCDg&oe=69CA8049"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=029xjmhEGAgQ7kNvwHlaBQ0&_nc_oc=Adp6UY84F0jtLpPYTVHIlOBZ4jQbiPp52jV82e1g6HSzmgO8aYTx3ss1QwXNj6tSx9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe78je91GRzUZORJve7f9x0OoWux0SBwyEcVd2-ln4XQ&oe=69CA8382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvYLuKjV6XwQ7kNvwFNNk3U&_nc_oc=AdrMVY8_RekNEgFEL1ohCrWiU1b0-jCZ8pJvF1QsUzx7sjR5Ugz6xSjotDuixH6bMY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnLGMwi_x01UOs4U63U7C17Zel7XZkcip_7bG3uJpX1A&oe=69CA6D98"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Phvef7avy3NkH79OVyYVQoaB4AnGYfEl-pUx7zIzj1Q&oe=69D7B025"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dyht6DBPeOsQ7kNvwGxxti8&_nc_oc=AdpqiOW-r8rCY7DTBjjRMotDUfSy4qkRWEhTfXm_txlX62nm9aABakgrkmAu-in3I1A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DUEsoT8eFa1GSA9OZPFPxZhcQjch1Wije2FFsjTwNdQ&oe=69D7A305"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hGWgNCZAokQ7kNvwF3xnea&_nc_oc=AdqdL6HvFT5A9eAV-sy36TLWm8RpLY15xYpFLikiP4q_PH4rOT8HkQ_Z_romobVT2OU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aAR77EOwYi-dDHF6V0aG3xcbym3WO_oPEDjVqoTkmGw&oe=69D7AF49"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KpzC1nh4BoQ7kNvwHclq1k&_nc_oc=AdrsdLxpzlnJVNXjWChPVZKcc5qNtKNxH2I4CjoTtPyyf4rZS8YmUaEwjKfpBTqBBXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hlGePwWpxPpWy19zMvC2Jm_EtJE1vxOEmeI4we5oZrg&oe=69D7B282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15YIxP5UlHYQ7kNvwFS-HAU&_nc_oc=Adqs1EpvUVXoIzMLG0Qv3rJkpVwa5cFExVdM_ajc8MNVPkvdpMzQer7BjEFpwvKFNVU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18-TJ7pRP7JnhejEItWZzhJ5sQjXTltssVAhKgJLlx3A&oe=69D79C98"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
e7a0a&_nc_ohc=slZAIbb_2yEQ7kNvwGEivtq&_nc_oc=AdrGKfysEbh7CTQqJctfvZGoVIINIBCg0K3627swQHlxWGUGUbowb1j0cq3gCsvTY9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TLytVmLNwlLdUY6ynQfRqt1NkHLW06C17SbrEXnSgAw&oe=69EE19A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wFLfU_ZttkQ7kNvwFzahw7&_nc_oc=Adopk8KE1cLQcmKKZ9npmfqhc2vVDnzXhdfov6UmP3aaoIcD3sJLG3FriWlu-HJ0G-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l-idfAdMCLkCrEPd4Q4VaGcNM3V0e_NOGJAinfKT66g&oe=69EE0C85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjdvYv068koQ7kNvwGIw7eD&_nc_oc=AdoZjY5lyEdn_pdjcFulvqn9HNZ27MROoIWvICG4HTTyPzPlQEhLWYQGB73HluWvfxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JyoEKsiS4V3c6U6ca2CVzOzhEpF2cGG-m8QQJ8uCHBQ&oe=69EE18C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL7bt-oMcqsQ7kNvwHb1pJf&_nc_oc=AdquNXx7sqmETqSt0T22oecdcgDnrJmj_gZr_bmQ-3iz5vI954e1hnMv8mUFT2TjzhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af034OEAc-edXuyjYR-DMY4fzgXGn1iiBaJnEfP7AiL2Xg&oe=69EE1C02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGaABiyIf_4Q7kNvwGlvho4&_nc_oc=Ado14ipyzISGGGKVEGdqkq1z83ay5GR4oMXVqaBDojcogoet4CRHQW2pPcS0pJ5-wjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kYucga_kbOg1Ih-9nn4v2zLope77xou6oS-WR0kg-yQ&oe=69EE0618"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null,
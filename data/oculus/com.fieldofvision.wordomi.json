.com&_nc_ss=8&oh=00_AfwdxOsJ8C_-fZiSNgyDXlDg9TLh1lOR2uER4ZFbISBMRQ&oe=69B95DA5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5MHuJJElfkQ7kNvwGc_Pet&_nc_oc=AdnLg51HGyxgIhPHhVvhhZjOqOqSBsk0aE2KnRjw4iFCX1pXF95frv0x524cutv1OL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyjOLyxPUfQIGynGS_tDzBhwfDPP5CER7zIhCSK0QB-XA&oe=69B95085"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC5J6Z8phokQ7kNvwH74Ouc&_nc_oc=AdlCNb5V4Yic-jt_xVFg0LP6q_xJErlybDKyEfWquVOqApeCEZyG3n1s4descrzYQ2I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1NqJUGxH3aE7c-gYc4trpjKxXh9RH11N-EpLW-WY2Pw&oe=69B95CC9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClaUuouoi9EQ7kNvwHNg16c&_nc_oc=AdmliHNYK5JIlwle3V4RnUVA8l7JLs2osGsY_gnSCi6wzmkGXC6qRiHrdR2i9JTlMms&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7Y-5NZJqu3-l2A_e6jHJ7E7oQfzXUmIngm3voNfYhJw&oe=69B96002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agnSbKOaxNQQ7kNvwEUlfDa&_nc_oc=AdkEAadpXcOrN3C3Y9IeDMwXjN3HP5uVxHXHY4Az0lWV26BIxydGy6QF2msz7bfs7Qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMLJkzQgp3ws1YxbTt0-QRBSHU99KF93XNqdnALC6AoQ&oe=69B94A18"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
e=699EDCF7"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKXQWl8tntAQ7kNvwEhfZhq&_nc_oc=AdleLukd_RHe5NbUsXpAYlQuq9rydcQaYWIsmv4C18fxEZGfvB-NiKnz9rbFfx-D4gY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfssuF-T09BlVkagnYDO2SsWRO6DEmKjlNIicmHqihgxrw&oe=699EF285"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFwq_H_EBtQQ7kNvwHtB01N&_nc_oc=AdkdVqM0NoJB5N8Pg168io9W9n0552AoiIIM2snVfRNnjKfGoFPOm3ECzJxm0sSMoNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftM73bMwT8G1Pt9sKX6OPh7J1jzb5GqOBT7izAWfgRoeg&oe=699EFEC9"}, {"file_name": "screen2.png", "id": "3664879603642755", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_3664879606976088_8243000513474509925_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcRqDPOL6igQ7kNvwFT5Spm&_nc_oc=AdlgWh3pssDB8vNKvytF2XI2Cmqknkju4LdmwNac0et-C7T-2Ll_QpgogJxRORUUwWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvMehJY8RgP9PBahk1-_8afKXoW4POBc9Xex39iYpwA1w&oe=699EFFA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "921066163825853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_921066167159186_2550957517103838150_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPMCampz3aIQ7kNvwGzBiGc&_nc_oc=AdksXrULkp_zP-IIYUtnB-AokVpfqTXPAnMpZR7QZra_wYTjZH1nuwYw0Smf9HyZzNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs4xeYq3uGMkmLyBakG7dfHpveWPE5MNXsCN1t-kcFpmg&oe=699EF422"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272
0MoPuRmXGvO_-ssOPaY1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0AxE7OHEwgWAFG5w7KrbV1QLbkJ9e_gFRSbrajh4ChnQ&oe=69F0BCA5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPD5S3mFJnsQ7kNvwEYuG8j&_nc_oc=AdrbmHXi5Vp4vKfd-x2RqlZdoKxsI7bw7tv0nPBsS_DgmMi5fMwPkoNid8FfFavYRIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0fQfdLLw2Nb7oMexCcglD1_cm1SkxIzBM7pQ6BR0haEg&oe=69F0AF85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JUfjMX2Qt8Q7kNvwFs7oJx&_nc_oc=Adp7V5UkebPE7fGDH220uYet4fzBH32HOkVlhakvNbSZBkIPl8lGQh2_GalcudH6BVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0VmjLnPHHkr0wGeg7twFPkzp0JFYJHRFYBerfKcq79Hw&oe=69F0BBC9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDj5E-bn2d8Q7kNvwHD2Glb&_nc_oc=AdpJxB06XcWoOuucuQkDt62xY3GUIWOVhELwHKRXEiYkiXYo0FzW2Rdoba1tQf85C_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2NbsiikpiL64zzHo-GycmqsQBjbgYNc14WCbavfS6opg&oe=69F0BF02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGaABiyIf_4Q7kNvwHRMeLA&_nc_oc=AdoZi6cVzmq5fbxaD_t_P17YEtauIesmXY_3eQU4q-35GbKdcoGlJolGrxkDd-1p0fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3fIkgCGLYmsANavsnmtcRvpeW2bou0KjSZWFcgfnsyVw&oe=69F0A918"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332
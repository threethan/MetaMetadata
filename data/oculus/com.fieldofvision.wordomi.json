c_sid=6e7a0a&_nc_ohc=LUM8lxb8aTwQ7kNvwHve46F&_nc_oc=AdoB07rGqLmt81hAsvRLQK5vxgohpoG9cQzYPaA0BCfZzRVRaqPq2xm8S218brKCFBY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EzjnpEm4WTkdS3jzyHiVpDK2Nu0MM4UggOm_xVwA5Ww&oe=6A369C25"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrJuIQtBa-gQ7kNvwF0Ojn9&_nc_oc=Adq6TfJ0CCtxNmMwn3MjOrezJscgBJl8-JLiuK2_nB0B9OWnlzQ-hZzSq1LIt6OqK0U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81GPhZpfTbxXWg-pfNaab5co7BgPPbyF3fCzXcD_6Z4g&oe=6A368F05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeOIEdPIA_sQ7kNvwF3sb-9&_nc_oc=AdowaSzE2N_6rBFymiwIcmKR-7EMftqo-oBXpMLzNRFcapgFr2aPEKj-fPkmgie4eso&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-alHGfJFnShFZUutQN7j6zzYxVKsyl6mDipUWZWfxiAA&oe=6A369B49"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lozku_yXxQUQ7kNvwHWg0Bb&_nc_oc=AdoMd77Uj8Yraa7sKsQ8L6E-5zFr6T24nwUyY3VMcsfYBtq4eiL27Pr1wkWteBpZYWw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82uykwfF8qCEUX2KzRVx_r1H2lJn93rypmPQGimhmZSg&oe=6A369E82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJmZ8eIzsYkQ7kNvwGW5qT1&_nc_oc=Adok4jZLknbt3Sts8TebvMo3VYmGHXVpHQZT_vLppg_KKkLvU96bj8V42L12-Q7Qn4E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f8u94Yx2Qkh9RBFvWrHMTLYOAPgQ2mg9Gw-RoibNNZg&oe=6A36C0D8"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_ur
ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jq5IRtV6Uh6Nahj5QuCij-LiT_KNpj8JPfYFhBYKcBw&oe=69DF9925"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhcAPEPPeQ0Q7kNvwFnIR6x&_nc_oc=Adr4XalC27UQoYimugarwO0gOH0m_LddRug9rh_i9ENsu5ZH77bz-pYGPjbO25fVUAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kwsImhYjbVOShnqBcTOhKYHzbiOWHiidvdPvGGcW6hA&oe=69DF8C05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZunT-p7ywwcQ7kNvwGoH0fz&_nc_oc=AdqkH3F5Mz3BT3XHtRSY0-UEFQWbguXiGC-FzsK6eugO39mhPzLg2ZWVGokceKYFDDw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Pm-n87vngsT0AEoia2B48-8JUHmZAxqpKdcBH5EzWAg&oe=69DF9849"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwaXKJUYV0sQ7kNvwF0nqTH&_nc_oc=AdrdOQoehhaGbPMRr4YaXkWVsfEc3Z4yg4lvZi0DRAFcUmk2oXbfIPtrbH0tEFtx1lI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LV8a3hf5jQuBcvB6y2KNdsqhetJcy0t2Y8-gIM3gbvw&oe=69DF9B82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuWUMRGSQTwQ7kNvwH01HVh&_nc_oc=AdplvhGc_SOtRzg4gh7Vjv364D2BliRk1hqP98VBg55pzb6dtL0YV4_-lLAkQQl1A4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M-VSH-fOr-zksMcjldkf1hh3CPlOFxeK7lgKUfmsvpw&oe=69DF8598"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
08Q7kNvwH27SbC&_nc_oc=Adp4_0FoV7_aha3C9Eu-54lqJSHJfmJgZKoYtJiZ7pACz-mYtzPLpMjZJiYjyTIPVlg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzV170AqnQtzlSaUqTr7yf5R1tJOpds8y3vLM7QWGezQ&oe=6B1059D4"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpeh8aetNdoQ7kNvwExcruG&_nc_oc=Adq5DL3ea7J5hp62isva8jMXqo_2HJ63xyskxBxJLVBebReVsV-QNYtk5StgP64az-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZ7RWc3U0Fe6saOUS6VUBlQxJmvENf7mrEtoEOcIIsyw&oe=6B105E42"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bsqF0ts2pEQ7kNvwEY2PJn&_nc_oc=AdrXHAsFRDRYDnqquckG5mytSf6bSje6SgqhOUQJehgqUQuZObD73d9HOzh0jVrcOPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjAj2ss7tbHmDmx4CxzP2_TMDv3WkOQ3GaGX3XlEuXjQ&oe=6B105B09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "1477704947613653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620599_1477704950946986_2254980149306166408_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3rrfMBXiBwQ7kNvwFRzLoq&_nc_oc=Adox-ObTNgQBbsQ51PO2gWN0w48_pJ3E6_xi-_JLOidbghMhcVngFOl3wP_64Ic2VHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtpk3BuXhBtE0a2UqPbic9EZu_Pl4PohMULCfe9jpByA&oe=6B105D34"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                                                           \n{1244238498769603}\n\n# PLAY TOGETHER IN MIXED REALITY\n\nTeam up or compete in online and co-located multiplayer. Share the same physical space, see the same puzzle and solve words together, or race each other for the win.\n\n{1704142544150911}\n\n# WATCH WORDS COME TO LIFE\n\nCompleting words now unlocks matching 3D objects. Discover more than 80 items, grab them with your hands and place them around your real environment.\n\n{568815945784852}\n\n# A WORD GAME BUILT FOR MIXED REALITY\n\nWordomi combines the instant satisfaction of modern word games with the depth of crossword-style puzzles. Reach out, manipulate letters directly and solve each challenge using your own hands.\n\n{569458915781045}\n\n# MULTIPLE WAYS TO PLAY\n\nProgress through increasingly difficult puzzles in Classic mode, create words from shared letter sets in Subgram mode, tackle themed challenges in Theme mode or slow things down in Zen mode.\n\nReturn each day for a fresh Word of the Day.\n\n{932362641761393}\n\n# ALWAYS SOMETHING NEW TO SOLVE\n\nExplore more than 100 levels across multiple difficulties, with randomized word sequences that make repeat playthroughs feel different every time.\n\n{370575866112854}\n\n# MADE FOR QUICK, COMFORTABLE SESSIONS\n\nSit down, use your hands and start spelling. Wordomi is easy to jump into whether you have a few minutes, a coffee break or time for a longer session.\n\n# FEATURES\n\n* Online and co-located multiplayer\n* Cooperative and competitive play\n* More than 80 unlockable 3D objects (more to come!)\n* More than 100 word-puzzle levels\n* Classic, Subgram, Theme and Zen modes\n* Daily Word of the Day\n* Full hand tracking support", "short_description": "Challenge your mind alone or with others in Wordomi, a mixed-reality word puzzle combining the best of Wordle and crosswords. Solve 100+ levels, play online or in co-located multiplayer, and unlock physical 3D objects that come to life in your real space."}]}, "developer_name": null,
n.com&_nc_ss=8&oh=00_Aftzr4GYhIwOMthZc3TrwZDZDXHTMVJL7QyDvfql7AZ95Q&oe=69A83A25"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCQ11vW5cVkQ7kNvwGTJQMj&_nc_oc=AdldLmNyUjbEkj35nUvWJ1qBhv10bZe8X8J0NyYRgn8YVtAYW6esJyAM6VMzzluAn5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfviBuxLv_oA151H6MXVYhCntSanXSsZHOJkcyAEjeoKYw&oe=69A82D05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfC6Txhl-oQQ7kNvwFSVv_M&_nc_oc=AdmkcIK843TX4NEQ6NaKKD6eMYC0db3kfkXi4ao1gQQeFUHHIOtomzK5GR9ybV4NSMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfukBleOQMCYbU5c46q0t0CVpptDGjHNJsRZmmh9H_Mg0A&oe=69A83949"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQR9H5YCYhUQ7kNvwGkaqQw&_nc_oc=AdmzuTzTuvOJRApgK4gTWx1DyAbp3ZWr7Suky-NhhWy2JB1y8R_Cihi6z_6vVvZZrq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsJ_ET5fp9kSFw-pd8eg6DMVbOglrV1BT5siWvmEavtUA&oe=69A83C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE8fz22MAkkQ7kNvwHQ0QgZ&_nc_oc=AdnrUm8xMpr6mJZV7hh6nu8v-0KiTpZqCxN-cVkYE_UC-X0HGfv7Rp7IyxNQz2ytgTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_00ObRYw-b0AKMTFiT3YaeT2u4Nr69hV49EzGWM6Fpg&oe=69A82698"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603
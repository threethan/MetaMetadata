4.5771-25/499625088_1069155728960997_339046014512350847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpcWTXGelfkQ7kNvwFTruzg&_nc_oc=AdoXThpYXU3pVyDmCaAGRF7i0t-OqjtLLngEV3Y6g6NnbHMKlZ99aEjZwyDNvdmiib8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS_HLrDnkp7ruSU4KcE5WOfp-vulXuu3v4GEFhbyvDcw&oe=6ACF8814"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onCMQzy2WAUQ7kNvwHz2z26&_nc_oc=AdrqMqIpG0SFWdsILAMEN36SNlVBRpt-Awow2BdrKsYi3RRgyjZmVE4uh0bT1y18P8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfTTnetsk4qwya6u5RLhlFdBeecG7MGHV4EwC-hrnuQw&oe=6ACF8C82"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gA3sG68xjwQ7kNvwGNLNKg&_nc_oc=Adreqkq_GN1dgIaQOj8703_Hd2zeR7z_rw0hRWXX42ByBvvGGC9n3PbHxrxrg83yvmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnb7Yh-ZIRAqbpIaNmfZgeYzMGISbH7DjMcfEm-BsEAQ&oe=6ACF8949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "1622088409560801", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628050_1622088412894134_8306953703184101436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCh3nnYTgkcQ7kNvwENWcSS&_nc_oc=AdoWqakRDT7iUcKkhfeQwA7x2G-6x8jWDpoqYv5KjAVOsD8AihX3JlSN6boF6G9GHXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFP2L65sjk7Mhe9Bu-iRFtDYo3IDlWT3lZ8VcZUguscg&oe=6ACF9C46"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                                                           \n{1244238498769603}\n\n# PLAY TOGETHER IN MIXED REALITY\n\nTeam up or compete in online and co-located multiplayer. Share the same physical space, see the same puzzle and solve words together, or race each other for the win.\n\n{1704142544150911}\n\n# WATCH WORDS COME TO LIFE\n\nCompleting words now unlocks matching 3D objects. Discover more than 80 items, grab them with your hands and place them around your real environment.\n\n{568815945784852}\n\n# A WORD GAME BUILT FOR MIXED REALITY\n\nWordomi combines the instant satisfaction of modern word games with the depth of crossword-style puzzles. Reach out, manipulate letters directly and solve each challenge using your own hands.\n\n{569458915781045}\n\n# MULTIPLE WAYS TO PLAY\n\nProgress through increasingly difficult puzzles in Classic mode, create words from shared letter sets in Subgram mode, tackle themed challenges in Theme mode or slow things down in Zen mode.\n\nReturn each day for a fresh Word of the Day.\n\n{932362641761393}\n\n# ALWAYS SOMETHING NEW TO SOLVE\n\nExplore more than 100 levels across multiple difficulties, with randomized word sequences that make repeat playthroughs feel different every time.\n\n{370575866112854}\n\n# MADE FOR QUICK, COMFORTABLE SESSIONS\n\nSit down, use your hands and start spelling. Wordomi is easy to jump into whether you have a few minutes, a coffee break or time for a longer session.\n\n# FEATURES\n\n* Online and co-located multiplayer\n* Cooperative and competitive play\n* More than 80 unlockable 3D objects (more to come!)\n* More than 100 word-puzzle levels\n* Classic, Subgram, Theme and Zen modes\n* Daily Word of the Day\n* Full hand tracking support", "short_description": "Challenge your mind alone or with others in Wordomi, a mixed-reality word puzzle combining the best of Wordle and crosswords. Solve 100+ levels, play online or in co-located multiplayer, and unlock physical 3D objects that come to life in your real space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "29003956079240115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626728_2202661997027800_2464473830082602478_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cq_jDKu6vEQ7kNvwHIpAzK&_nc_oc=AdoUqRs57oCpS9h7zMCpfgYaU4d0j1ZElHSiRpzJgVs9qf2yd_bJL-zEqX_9NBvggYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8ViqAM_JxJLCmiLOUULj4HLGFvq8ibMah3s7ZYlpxBg&oe=6ACFA4C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wordomi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1706896800, "lastRevision": {"nodes": [{"id": "7368881933174175", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7368881886507513", "i
e7a0a&_nc_ohc=eqFChDQ1MvwQ7kNvwHSSz9C&_nc_oc=AdorSwsUQmw4bjIfwzuDbve0wEKflQpGx9sd9B5pU2kuG207jue93BIFIV8SycZWurs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CVU1Vr2mQNtFYhkDaGjjpJXVlL81mHwW6vVnL0DANmg&oe=69ECC825"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wFLfU_ZttkQ7kNvwFAq53b&_nc_oc=AdoZDZ2uqJpDESUvooqJTvt8-UbPJlxC6SPu2-gnhlMzGsbjjM0VotD20XmmQpyQbiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ja0nuou7on8R8IPiPXWX4jyxkBmdgty-18k13QNzYcA&oe=69ECBB05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjdvYv068koQ7kNvwGVs-EQ&_nc_oc=AdpPF5FZgjX9L_D582CeFL_y94ORicp63gBSTNr0rPTcvb2IB6hz7UDpQi5LAtV7O7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VdqxfWss2HdtfuEJCjt_YTIG2BAVTGp_TemHZi2nakQ&oe=69ECC749"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL7bt-oMcqsQ7kNvwHTNodj&_nc_oc=AdqyiLErtQXj1SZ5tolucblFuv0Qyox7W3vMrpwr--XhV2ciuegC1cbSpuS6A2iyjY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aJIrL5nm9m_WJDTyn-0czu0-w2hiawQVAeLXrw2s4Yg&oe=69ECCA82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA0qOx9AvigQ7kNvwEeXTe4&_nc_oc=AdreujypanAjT5KqziPvJYyQSsGxSZjVd4YH10CSmIuJscAvY6Fqh-q-Nqh6ibRA9lI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32QkZ6MntryxQRF2T9LexT5SE3CgMDPoqyZg4sHMSu8w&oe=69ECB498"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null,
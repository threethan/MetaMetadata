n.com&_nc_ss=8&oh=00_AfyGqG3OSRMPW1QOO4N7DknDP61ks9346skrTItUqVUGcw&oe=69AC2EA5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAn5tR09ocYQ7kNvwEhDKKo&_nc_oc=AdnaZYFoUU6A_k6-r3JhPzEHIsB1mdzAEWml8ZyIvxo_VrQnXKZqK1q73rB6Bt-TakA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtBd_qyFuHnrRtkqY8LfdxyIht4fFLxbyj2aGCoXefUw&oe=69AC2185"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkCTtFItpIkQ7kNvwHwy6-3&_nc_oc=AdluJEL8rX4qRWoPTOZ37oIJ7_Q54LJxlLDA_IWKiAY0j_n2U8geW5agrPdI4RkmUJA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZ38yxnYn3scqozqLs-1htO5zTp1bZ19Izk46F2xuDuQ&oe=69AC2DC9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBeNxrxktTIQ7kNvwGyQFIE&_nc_oc=Admo3jNsjWleS5kmx7egmOI3ALBypmHE_fVHuApDMPE6fzsP9fUS7aeArq4AiSHK_G8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyuogp82fZHyY-78HlUr3tNAevPCwp4n3GDNGa693fOOw&oe=69AC3102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaN2CwPAtw4Q7kNvwEWseeP&_nc_oc=Adlr_vOhLSHfJXjsUBKaLp5riFoPyEsnk0SDhFgD0F9P5P75cOdfR2ib0iI3hV5HRME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxO5BpH-qoWqGbdnTEJLitzsY8aUVKILmI2Y3K-yYqi9Q&oe=69AC1B18"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603
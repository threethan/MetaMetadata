ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRgGlxGzhyJ_j2T1FbfmuiWbSbkjsBTdhCOunolmHB4A&oe=69CFC725"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34YiREOrA2wQ7kNvwFdaPf8&_nc_oc=AdqS-wWCoOKo-g0_IuyD0a5pFlBjB7FJVuAX6AMN5VN1s7iJ69oZPGwSKNIdGq2Sy5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1ydDigi-ldLSzMQkxxO3As5KMkLGK3ChgAaW7RTw7iw&oe=69CFBA05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r-d8-q-7YgQ7kNvwEBl-2o&_nc_oc=AdpRfftSI8ZqrgT7bOevE6zLyUYuWW5O5GNZdZMEqG4ESr-NT2AHR56Ac6ECCuFVsUQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziHrLJUTinIUpzzEmD9nRwNpF8fs3LGLT42grzPR2OWw&oe=69CFC649"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-WmeDEv22gQ7kNvwER0whA&_nc_oc=Adq186PzuU64l8epnZ34j5IW7GPWpN6uehUSUciymsANIuQreicvwwoaSKq0Z0KC5aE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9XKn-Uztzm4bRtkQCTxTgCxfwruI3YqqTnVjjY3CAUw&oe=69CFC982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n-W1FTpcr8Q7kNvwEFhzLW&_nc_oc=AdrmSXfYH8LZJMDvkZ1YihiFzv28ximKYpw8zGvKQiztbBhEml6Utq6yUZLDH28HSu8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTrXTYHFdEll7XNyno1NVU43eN4DvFcSPp6526_qzvAQ&oe=69CFB398"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
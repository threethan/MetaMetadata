ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MiAKWncafnEihuKbYfBU6zgXW1Rv2yL9l0hLVFdnUjg&oe=69E23C25"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhcAPEPPeQ0Q7kNvwFbRD-v&_nc_oc=AdrYRw4ubGSDxLO3MvN7wh4DxV89JwqmT571SLDpzwM7z-c8Df62W72cidvtHK9-6kk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0peC9P-pFUEi7IihoFT4tjvz7RjJVGmFW3GRoC1jPEWQ&oe=69E22F05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIyi5Cq6-f4Q7kNvwFXoBaD&_nc_oc=AdqWYIZeIFFK3EqLbIDI9d8Whtv-V62JN_WjxWl3qRgSuEb1e9kH-4a4nLCW_XJI6hM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RB_huyKDVLzaiSIIgMDLw57D_pXwpVAV0bc4FPncxZg&oe=69E23B49"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwRgulQBYmoQ7kNvwFCE7RA&_nc_oc=Adq6CLKvBf4dV_PO_eYkEw0dhsiKMUQ2h3mEFX5hGQ9RGNEuDgUdvpemPz1vMVqy1pA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UkKHoCi3y-V8tood4_DpNpyTLd84-mIX0jNfVQqcF9w&oe=69E23E82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6RYMh7wIBoQ7kNvwFSIyDv&_nc_oc=AdqQgNoRudr3lpzx16PrgLWsbN3-5Y9BWpjziW436Hnnvmo74Fq9sJf3u5BTPK_kvME&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KfjNlZWXLf-7h7I3cn2O8es3pO9od4xYWv_30EYGHQA&oe=69E22898"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
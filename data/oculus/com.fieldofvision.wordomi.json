9A445A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNjSYqPZ2KYQ7kNvwGcVOlP&_nc_oc=AdlCF52kTYpFrBW6-mgdyC_1uASOGzzSNHqqNObU-ySsUqPqMeagPkezI-9PFxBwaJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvZiQve1ZdAsDuMKCVn-Y0CPM9ggRgE3JWIdv3D_C9uLA&oe=69A43885"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_n-H1OeVXEQ7kNvwFbrcDc&_nc_oc=AdlFtvxEBKLTtu121L7gxQgshWdLe21FpZxAJ1BvUi4uwW5f7fKOZWMjdM6v6Bn5P5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvYop6iaFvfsrW9lIrQTTEz66jiSYggwJ2cERXH2_Q9aQ&oe=69A444C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLNLZrm6IBIQ7kNvwExC3hp&_nc_oc=Adnm1D2besGA7HzzrAb3DPW6u0g_GjhSpxl2cibfZrtCqRU7uX1kSbVAlvSbPvGiB-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvoZXm7_RuhbHmwNiRbUtTEhweVB4izfszVz2WkcF38dw&oe=69A44802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux48MtV4RfMQ7kNvwG7LTWA&_nc_oc=AdlnnWWGgh6aiy8I0Wx8PHz1nmlbLhu8JtVnRklkvTg9IyOoBWqJZWD_BpPXQ7qUdJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsTqylpKSv4WlHhmttxrqPEC4HXYfYGYCYwZaExxwjHJA&oe=69A43218"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "3779783902724
.com&_nc_ss=8&oh=00_AfzZjPEe3Cy-6iGqhSj5YXF7OUj9sReiw30yFm8A3FN6xQ&oe=69BAAF25"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5MHuJJElfkQ7kNvwETaE_l&_nc_oc=Adkf8jtf5xw6xu-TOxiwsIVbJYHpxu2zgicW2Cg8eo6udLDiEP-cCGb7734ykCDyKqw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6ARN38zsq3mXdTwmZBHDAMURlzgVdKz38xtYmPwRJog&oe=69BAA205"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC5J6Z8phokQ7kNvwHy5Wtu&_nc_oc=Adk02GPSDXYbA7oJ4TUriZ1x5_qGnOIQdJ_9W8wZ8BgDHTDRzEKlYUSaSreDpjxyng4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwY30aiGLqRyjcukDHgDrDiDaLg_MX0jM0YQu23XflUvg&oe=69BAAE49"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClaUuouoi9EQ7kNvwH8fXgx&_nc_oc=AdmFAbwmABgHjFE5b6_h3YeQyfoNUVw9p1IBMsg5DnsPROdmwxp37mkALIpXfB2XiLU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGNgA7SoA68HMRvgP8uv_WBzknqJy0OvdAUDSa2mMQow&oe=69BAB182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0RgMf1pJ4oQ7kNvwFJ6Qrq&_nc_oc=AdmYeq-57zAghiMHTNbHwqY53wlObnt_79HRfn88t2FQJh71adsFkTH67PI59r3M62E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzzli2M8yWOmndwOhe1XNMzToid3UU8p_vKSae_2N5VIA&oe=69BA9B98"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
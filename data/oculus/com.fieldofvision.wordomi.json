ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwvXfouVoU5bin3rxGlzw3OQayFibykkz4RzKsIXFOsQ&oe=69C53B25"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRicYYs2YI0Q7kNvwHWzk4f&_nc_oc=AdpuQNF4wcY8GRSJcYthnASsrqYvxL2dWjYGr-QlrAmoi_Qprali3vgrIZ8kvLHR4jQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbVEx-BftXtt48WXZDYGe64yc-DGX7Vn8mXAoA1-Xlzg&oe=69C52E05"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM6wwSVkN9gQ7kNvwH2hI29&_nc_oc=AdqRGlAE75jpFIgRSF_abMFC-0msymKFH3wayNOZVKfqAMqQJDvbHYjWnCewl2ocic4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwI6E85FslLZibFLab7V9In69Eelzn3lobW-bfl-BNo9g&oe=69C53A49"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f29H4riHxOQQ7kNvwGAWXkJ&_nc_oc=AdrU0B_tK5SA-xGvK1pO4SfqXu1wfUmspxRy1khDpYxiHFA5oF3kHv4qK2PIXycTCWY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfxOAA7S1Z4N_gOJj4-RW_TSae6vdGuHwcFXvTTbfQqw&oe=69C53D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dDI1wi7LTYQ7kNvwG8rIKd&_nc_oc=AdqdT1K_QuarA3h5naloC1wifcAmIISri2UxCxFZhJEG3kEN1exIJYnO_GR84ecUwO8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3ekHmtJYyjJJYXLtgq3zh65o29buGoW1oZLqZwIYs4Q&oe=69C52798"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
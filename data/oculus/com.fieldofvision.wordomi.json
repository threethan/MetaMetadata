.com&_nc_ss=8&oh=00_AfxJcTDxOgwg_JD9ByC0CIWMDQvHQQYDNj8X_XikrdLMlw&oe=69BEA3A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfpnEt6XWswQ7kNvwHC9pRj&_nc_oc=AdkuHNzWFSrCpixg64o1gajRNe-qX3-kvoWI2At10rJY6mqdrJMJyq1ofo7P66V2zpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtaFSwtfcO8Z3Q8xUfg7CU5Tp6gfKEGQm8N0yc4h8nxg&oe=69BE9685"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o-DVxz8Q-QQ7kNvwFTMLYn&_nc_oc=Adk2P7OOmqGlyC1bNnxCJeV_x6LFW1BKUwG_SQzYKy6unNIEh-fthd2S_rVBra7JrZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuUQdcZgyhQjvlkmfLfM9CSMnroN05E67kzSJHF6WI0g&oe=69BEA2C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35tiAH5FydQQ7kNvwETfR8C&_nc_oc=AdlScMHnPZWhUNpB3cmQDkYF3l7DYjOi0M4k53L2YkkyiNRAKYXlisHinmZx8uuYveE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnfdUwkCrU2jU4d5pmIjdxxw_-vFPcBJERyp8D3AX2aw&oe=69BEA602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwIKa779YdIQ7kNvwG0uzGr&_nc_oc=AdmYs4Py1S4VLs9Dq_L1NE30iptwX7KhDse5MzRTSkVEcwePWNqYCRBwknN7I6SyFbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVaRMhGiIbSe9mTz1tFZlxbscIn8Z9bJPXMncvdjR44w&oe=69BE9018"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
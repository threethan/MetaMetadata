.com&_nc_ss=8&oh=00_AfxL9mRzEvrKvnVgcNDdLI5QuqSTWXIgnCrh069ExPrBJw&oe=69BD5225"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfpnEt6XWswQ7kNvwEj9ibs&_nc_oc=AdksJmCCJfk_ao7ek-eDNRC9p-CJC5KjnRQYKJ_reRRj7RilhkhFJ7hccgQ4lyWn7vU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGyEMrhlRGGAPUE0pC5VCECTDTMdqqIRWGfuJ3HhjgKg&oe=69BD4505"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o-DVxz8Q-QQ7kNvwFwG5oJ&_nc_oc=AdmExnKPX_kGJy504zoc0xmV63D2gfy2JkQ0jxHDFpwde1VwNa9TnadamuQjRzT7g-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkfqXVxiFAgxq4l11-39BMdAjx_MTgxanMu71YIQMnyw&oe=69BD5149"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35tiAH5FydQQ7kNvwFwAdCp&_nc_oc=AdlTU-_2OYFuTWXbPFy02q-RX8GqnLkqihipsvLDqGmS1sR5Jgqx5b8WKjU7n-Q_0Lg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUtjf8RpXLpjOGUi8Rk9Hyjxnprzhe_xE9nUjK8ytsPw&oe=69BD5482"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0RgMf1pJ4oQ7kNvwFuqqCJ&_nc_oc=Adl2SpYSbVJd0N8MqVklCmiBBtQDEOVW0bbDQ7xguk_Ff96j5pFjYrcOcJBVHBzr9PE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz24dVfuVK0I5_-QeITmQgzOXU-USjn8FzVzHOLLUKVNw&oe=69BD3E98"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
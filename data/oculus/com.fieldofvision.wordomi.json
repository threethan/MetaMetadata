9A6E8A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNjSYqPZ2KYQ7kNvwHc4pt4&_nc_oc=Adl2MPBc6Q3ZcME6y_-ZDzW2311btxJdLJgbNJBMysK6XDnfIMV-Qi29V6tSApF1xrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhcHfnjgv35zkhv53AWnuKzo2otSfmLbjDUYhimDOVgw&oe=69A6DB85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfC6Txhl-oQQ7kNvwESfP8q&_nc_oc=AdmSEkRFOfu84Ku7Kscjv2eajrh1FTIgV5KVR80Q01d6EY4viVPRA626XTcQYpqDI4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurCAxLXxA9LvKRuFCHAhdW9bjfEmhNbboX-jWxjgRUGw&oe=69A6E7C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQR9H5YCYhUQ7kNvwFXQAGL&_nc_oc=AdnL46fxA1KzwDbY3K2RaTlhKV0h0Er1Z4jP0C_9MZvcf12RRCVZOp1DZq3grt4m8rE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfscPjtusT5e5FrQpyq_CnfUGWPBq0YVBqFPZ6YIMFOg_g&oe=69A6EB02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE8fz22MAkkQ7kNvwFawmmR&_nc_oc=Adnmp2GyJurYlCNSeGiH7OChS59nTLDLgz9Xtknut6STXR3N4tAlblGlT47vIKI4L3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afufz0WHiCusFB_PCi7rFAoWoa_lLpbnVMclCAXdvNY4ng&oe=69A6D518"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "3779
uluscdn.com&_nc_ss=8&oh=00_AfxJzRikrTAw39f9kfIS3RHocYeC5-GwmbraFKNwdt9r_g&oe=69AADD25"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCQ11vW5cVkQ7kNvwFuC1It&_nc_oc=AdnJ2xRTjKQXZkhFfvlxQHOp28n7H4xkD4Mp3cVJcIhNgWYMsDZpOUS4-LUfwuj3Zy4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhor8bm_W-Lc4EVf2u_xj8FyPXPj6B-JlgkUTzMwQX_w&oe=69AAD005"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkCTtFItpIkQ7kNvwGw14Wy&_nc_oc=AdmEvG-Rg3uugXjnSRK4xF-5o1P3hu_CojChnGLk6i06zIIafxeZUJdP72LFCSZ-nz4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfylUE46rX78aUFGQxdOp3vI4rzaREDfCGwbeX1FFXNGHw&oe=69AADC49"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBeNxrxktTIQ7kNvwH8nZz9&_nc_oc=AdmjALT7bGcP_7cooXX3vkhm3x2iQWAo4pU_csneMCm0vq04VYcogqRZNehTD6ol7qQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDZqNu9pzoG4Cvo7TGmTvfpuODesJtWU0MGdxZjZXvVQ&oe=69AADF82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaN2CwPAtw4Q7kNvwHkny9H&_nc_oc=Adlh_0TMMQCA0Ajval8a-eyKl8uCjSuUCiUDVWD4H_d_WLnivh7SAw7wBH5-Ocsdpuw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1zWL3IUKi6B_k9j5qi_y9AKz7Lg-Pwn4Is_VFoF1Qhg&oe=69AAC998"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2
ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VfZskpxfaVDV2g1P8hL3X6YAExDRIH3drS6uXTMjfZg&oe=69DE47A5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBL1-e0tTs8Q7kNvwHB8QOz&_nc_oc=AdqYxi_InMjogTHsHn2YJMRpfCkSm2qYF7bt_4ZfMpPmA_7RjR_xZ8V7W3Fdro6qe9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rJAeDAK3OdjOyxHmB12s8XC5Uw7LBzBW-or9so6CWUw&oe=69DE3A85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZunT-p7ywwcQ7kNvwFl_Zwp&_nc_oc=AdqavCl3MP-f81RQU89XApMfjUkd5FA2fjrIUDcp7DGfOtlc_1akO92os_gEhI1dTkg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-FiwsGigUw0B7y296ZkKP37rP-oIkcnEsdF_O7p1XXg&oe=69DE46C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwaXKJUYV0sQ7kNvwEIcus9&_nc_oc=AdpOW2DRRUBXEHQyqoDkrB-YQpYkTHh8DtAreHay6UoZVDFmECqdft-pgt65bUnkDDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03A0YMIusSOMDTMipMlA_S_91Y9dayPps3rRAzXRr9NA&oe=69DE4A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuWUMRGSQTwQ7kNvwGAAmva&_nc_oc=Ado9VyKQrOWEwRm_xxhpBXvz6zORXEc72iwaVR4RLklX6duZI-ph7CgF6F04pJDrnEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wFxmjyd-wGSWQQ0hJqHQMrIh5QrbjQmnFkpNNWPhyaw&oe=69DE3418"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
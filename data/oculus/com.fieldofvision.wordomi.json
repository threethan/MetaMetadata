n.com&_nc_ss=8&oh=00_Aftb6f7AshBZGpvYrOAUdy9eK0Hx1OSHYCJKviZYzyflKQ&oe=69A98BA5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCQ11vW5cVkQ7kNvwFQItzi&_nc_oc=AdnbfgLzDToO8GLGnmVU_1FaX_LBdi23C-gIjesGMqigGpSgCj6G1QDoeRgcOLVDZ-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsqQ69sPmV2vYXjFDkUHXRXn4UDs0DbgwvCyuT7575E3g&oe=69A97E85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkCTtFItpIkQ7kNvwEy2bxy&_nc_oc=AdnLQMHWgvQoPyoyEFQTdzjWjLOwYp00xxZvKQIkVpg7piGAUzTr26CnBJFeIou7wIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCP0Rurz3cqV2mmQz05Zt0iiKZxv_WYmofXAqybTBFpQ&oe=69A98AC9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBeNxrxktTIQ7kNvwHZE8yF&_nc_oc=AdnjCHIRbPxxyH7bGrim-rpesnWov8KYZqfuw1CpaIxQtl4OwfLi5RWcMVaJb_BOCBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs979CrX4W6peK41U1JBwI6otqq5w4_H4toSQ_l0uoMQQ&oe=69A98E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE8fz22MAkkQ7kNvwGBviWj&_nc_oc=AdlC-MtFRutSZCSb8KW3RSGNioxpaZyQOBavc-KxpdeBjtIRxwpmqu3Cw_v25vMMbUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuT7OooNS0pmC4PO83c-_u5lswddX1XC75uJif3ukPlbQ&oe=69A97818"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603
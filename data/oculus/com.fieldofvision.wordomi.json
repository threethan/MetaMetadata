.com&_nc_ss=8&oh=00_AfzVDBjyNscsczqFg75-b90sV0fNRedMHkMWM7H8ggzjpA&oe=69B6BAA5"}, {"file_name": "screen3.png", "id": "3776899969272601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314643_3776899972605934_3686210512472387539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaUlQegyiB0Q7kNvwFeJ4kW&_nc_oc=AdmFbmMNMfA42rPXQ_eiz33qeOQYiz4yIWt5p3jeAuQjNaqMTzrxARqg9d1g9U_b9Do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd8DAASWy5vpd-ZJ3YAq8rq5NQgqqCmb2vERtlfs9Cug&oe=69B6AD85"}, {"file_name": "screen3.png", "id": "610319191874849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391938_610319195208182_3301042811962012912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvoTmjDGUyAQ7kNvwF_Pc_Z&_nc_oc=AdmGDpHQptRXVCfCGCe9Vn_wOeSZinIJKmnQyMtRNiu4QaqbzNllmd3aMMILyasCglc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnFoo9L-8cEyyZTWbOA0lUGBGRd3f2PdZkfC1BJQJeYQ&oe=69B6B9C9"}, {"file_name": "screen1.png", "id": "1821169598497289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821755_1821169601830622_4144004292685200567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEn4taXPkk0Q7kNvwFkrMRK&_nc_oc=Adnc0ihq6cYHPzELQekdwSlTRwNUm5L6iRRQIknRsLFCk69XHx5bWtJciBSCgwPecDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9ssEmWw3tC24hbYugWHgXr52t6HPdMRjQrlS2puRQvQ&oe=69B6BD02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "3138715022997680", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_3138715029664346_6705168744484671334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agnSbKOaxNQQ7kNvwFk_OwX&_nc_oc=Adkv0ZfHTx2avIIdEnyq1wmKxD0KXM4NJAZz9Uaw4Y_ZcqOmVux_3wrVeQDAW-eRiCs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNsRs7KM9vi5KKBihmwtjILTbg0MHdZQVV6ylyUxMggw&oe=69B6A718"}, "display_name": "Wordomi", "keywords": ["Puzzle", "word", "anagram", "crossword", "letter"], "long_description": "                                                                                                                                                                                                       \n{569458915781045}\n# -\n# LEXICON EXPANDED is here! A bigger word library, sharper clues, clearer definitions, subgram challenges and smoother hand tracking await.\n\n# -\nChallenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.\n\n# ENDLESS GAMEPLAY \n100+ engaging word puzzles across multiple difficulties using randomly generated word sequences. Repeating levels will never be the same!\n{568815945784852}\n\n# A VARIETY OF EXCITING GAME MODES\nTry Classic mode for increasing difficulty, Subgram mode to form words from the same letters, or Theme mode for themed challenges. Don't forget to come back daily for the Word of the Day!\n{932362641761393}\n\n#  PLAY WHERE AND WHEN YOU WANT\nThere's no place you cannot go to sit down and spell. Literally.\n{370575866112854}\n\nAnd more:\n- Zen mode for those who like to take it slow.\n- Mixed Reality support (Color passthrough on Meta Quest 3 & Meta Quest Pro)\n- Full hand tracking support\n- 120Hz support for smooth gameplay", "short_description": "Challenge your mind with Wordomi, an innovative puzzle game combining the essence of Wordle and crossword puzzles. Navigate through 100+ levels, each designed to test your vocabulary and problem-solving skills in a mixed reality environment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://wordomi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
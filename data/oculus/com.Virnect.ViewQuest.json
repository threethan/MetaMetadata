_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvlS4qchkVMQ7kNvwG664cm&_nc_oc=AdrYPJRyQr40XaeKUaeTiV_l1qheYvvS746f0bYNo2tlS-UcbmoC4Itbyo2O95X9ZxQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw7l-OeDCt846V7mhmVq6Z4pJI6cvxKH3FKbAJ8Tef9A&oe=6AA164DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KHh1SwnuuoQ7kNvwGJrx9Y&_nc_oc=Ado8kdPn5TLS3-RI8oXnXlyztL3kXoRz5nmKKyhJvoIRtAgPZQB0i_OW74AktCgNTQA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_j8bTVXRi7sOCGknYcfBpiY3R4vJ4dU3YRD-zicO1gQ&oe=6AA172ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4ZSaZWOCMQQ7kNvwFM45qs&_nc_oc=AdoTIWxRIHDMTZbnKvXbp4kTS69fJUj0u5q_IhC6T50TI-S15b93gR8FuyEFdagLimE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITNeNhs299sR_Jih9VLCtm5Yp7y_LeeEdN1m9QY86-cg&oe=6AA152EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSyz7xyDqd8Q7kNvwE_GorQ&_nc_oc=Adr7OJcmIEqpAve8nXtuFV5VXDe-M06OVHZpuzuyIbxbbGUiUeQzFr-zedKBWrbSlY0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi-olWF2feVHhk381XTmJygYmXQk2MuORXlnHjjsoWBg&oe=6AA15AB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMEXWBpv2mkQ7kNvwFVOeEq&_nc_oc=Ado0uuuGYxnvC2wq4BCa7MI9Qi94ztAkXJO2BGzioje_fTQSRdFV_VHlsIO1rNGf2PA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzK9SjyY8OTeL6tahbgn2bnxc76ppT0OYgE7YGT2_lyg&oe=6AA14AB8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlVQEqxiZd8Q7kNvwH55H8n&_nc_oc=AdqtRf5JpCYP7E3q5jtdmd0xAbNBg-AywfzmR6SKcXm13FOWRQNqok-IlDITevmE3CI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xKiXMOhJF9tUnJU1OHT77R9Sm3MZ_0kcBlJUEO_27eg&oe=6A2577DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlSbbovoFf8Q7kNvwFPiac9&_nc_oc=AdpC7NaZ78SjcrnNQ-A1Z433cqetfYf1Gv9__9sO5OG3OObGjkHKm79atwfbu-ARydc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AMjvMCZgelnUcviL9Zvuc-gaiTFtdh-g40X4eG09c6A&oe=6A2585ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaM_3VRnuf0Q7kNvwFWWM96&_nc_oc=Adp29X9RHPZhmNL9cBj920rKtG4-WpT9xTJQGPF7DcjdbP0yQvwiZJr5X6EJK3hObmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R-3f9zLakwzY4G126_HEDLQf0ciq59sbNkQaVlk4jEQ&oe=6A259E2C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOPRdUtKFiAQ7kNvwHBDY-p&_nc_oc=AdrZI0sKLAGbBwQeZrB920n-0Dki4G6JWkSQyY_EgLZE9lBPJONABDtdpJKK8g0StOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NCiqZeuSG1yh-ZcoVfSVl0MqzjC9jHm_rbMNY2PYyig&oe=6A256DB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsCXV6wo0IYQ7kNvwFIit58&_nc_oc=AdrGYpLqyk38qIG8lxoBci4AsAtE-QjX6hijn3frL5fJIgOEn5oRwH9dSSfD5zEp0bU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dxPMoMeS_ZPMouulVCMKPAU5hQLYlgba5stqzeIMBcQ&oe=6A2595F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
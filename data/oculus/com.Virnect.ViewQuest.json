_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHqMadtqi8EQ7kNvwEAufV9&_nc_oc=AdpLaATc4Q5EUPZj_tftnEHEv-A88MpXt42afkF77o5M6coedP9aOEWUtqml4p3FP6A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCGV2mvgMGh46-df0Hkf8zbFIp9pKd6hHAuugWhvcRCw&oe=6AC8F1DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhDtVTIzplMQ7kNvwG9FyfT&_nc_oc=AdqXFI23kE86-zDWwfE1d1hzspwGF9lqJesR2bCycWZeoBiA1U-8crVg2C0QPdZanRo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQk1ykVUfSbgiPX-AkBSalzcu0iptbgXgnzW3UTUHqjg&oe=6AC8FFED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE-rj305vGIQ7kNvwEi0aOk&_nc_oc=Adr_vlDKDTibSyQb4AOtyw20Qe3sdaPI7KmJJGgfU-gwLQ4KRhihtpipLnFPyGGuj98&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNYDNU0s1vQPGAeDJTdG8Fm6oCidOmDtwwkfhV21uKUw&oe=6AC9182C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3JLAt7W_mcQ7kNvwFwFcg0&_nc_oc=Adp1qcn7-fS4bNwbqVg91mwXOsHvH_xp2CtjQdhgZkkgJ1CSMVQFEyhgCtKn2cc2MEY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxkz5_6UfT_Gx_GfY2G1p2_RLBKBFr-EWGh0pJamHnQQ&oe=6AC8E7B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juNC1b_Tk-wQ7kNvwGfYbt-&_nc_oc=AdoYVt39Z0ixEmxSIG-A8V3_Stz-dQmhYiVRJRMiPK6jYDon4LGj6J2SLDEcu_IItfk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7ghzf0_JaUe6aXmaz0eiLrroG5pv4DFhJi8B0uBV_Bw&oe=6AC90FF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ3giD82NKwQ7kNvwFwG8m9&_nc_oc=Adrjz-gcQ0e2Fi_nxviRE5jBDOsycrq_EoashQ7oibMp7uYKj5bb6oCPKMyqRGtXtxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb2P470VyT63qJZ_D1f7L94-vttgKSHS5WRwBNawgbQw&oe=6A90091E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsexJa_XRfcQ7kNvwFGy2Bx&_nc_oc=AdoyoPVLMHCucksS6OAXBgzvOC-UqtnJq2WM8gvdTF6nf7D9MKY5KXluaeOY44VYtbE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5azIMzhJeUAgygDq4MtsuB12XryYGyyjhp-aYGGZlSw&oe=6A90172D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOQfl0yjq6IQ7kNvwFjeuuy&_nc_oc=AdoFvjrq3p4gj9Zo_WZV3cKWAdbd2p-RC-PPtnrmjrYRsxbGFzt6m4o6Ty89ls1LgRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1f5osq-NWOOLaJbo67eUBEPwypgCOqr_DG7-7K0SKzg&oe=6A902F6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk8LwmxkQtcQ7kNvwFeQYlC&_nc_oc=Adpf__lQ8OclemabE1riKOHPcDGmmYhaeYoOhpUa3tlRbCTpewPwDULwXgLF56lNUT8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhBgz_Fr1StPzVHkYx7gd-9dk-IRWVfhhFnnFSudc46g&oe=6A903734"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dJYkFffqE4Q7kNvwFhXwLz&_nc_oc=AdorXynlMhlWxlQw6YuSQ2tyieOwFg1LGS5xVZmv9v-p8xiectOcnRYPIPtlkY8hGXg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQpO9Y1_ikErcRJVomlMNwLVAZrwFK8ORwTUJ9B4GfKQ&oe=6A902738"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
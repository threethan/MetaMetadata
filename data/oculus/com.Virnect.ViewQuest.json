hvdhAObtb166SlPCdAsjOk48AU2sY4IaWhfKdFdqsxEVHLMCyDcEA6y8WNg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kk07rKF-H5tArM4CcXbFWpoPTsc-L9swKP8kJERoY3w&oe=69EF6A5E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmRPmqVHEBAQ7kNvwFJdhkA&_nc_oc=AdriPRMD-j9dz0YtaBC6JdyFa-uiL9n4Dgz3g1Z0rM74wwBkr-gd3WSs4FbVk-PC0bM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Nj-KAzBUCusP1YNvrU3S8ZxGbgDpmk5T6ZposBR1bbw&oe=69EF786D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYESwVl_DEQQ7kNvwEYJCQA&_nc_oc=AdpxqOSDLWryP1GW38z2WdmaY6r_nTeZZr7I4xOlT97ABi7_cs3UqtOkySeTl7ZTMi8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3daHpNxDEYohj1DH8SU45xh5O36_JtHYr8WOSMkPyIDQ&oe=69EF586C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nftQ-vjFs2wQ7kNvwEo_WlV&_nc_oc=AdrUii51cabB9UvEygCYFv5VUtymNJdSDfxHTyb51lCvdv3z_EiaebPataX7K6t5UQA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tDhfo1ihbjGYe3KQ79fnge3tv3ZbuPQLehE9EER-NZA&oe=69EF6034"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVvh5DL5AoIQ7kNvwEYhlXY&_nc_oc=AdpmoIv8LgwKKHFrOQMaX1hywCFNECnqoTLCW5Rtwm7Mh7wof2EaPsV1n_HeXk8Ibz4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09gmKrdgQRM2KW7kcCVWdTBnBu9JayIzD_E184gN8XeA&oe=69EF5038"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
Fh2TmU5op7aRhaHfEfeePY27tMvt7EqQMjSjaytMN3KJcybf5fPr1LICCXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vNnA1ukV1CsevNzKvxsj0i7_L3HuCrwEXLLjgBcjdIg&oe=69E0E9DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5E7nXQPBzkQ7kNvwHCEKS8&_nc_oc=AdoMKFUr17Q38UyAOc-YhhU4UJv8IPSKxSKb_OfC4Duc2MplgePmZYzCWhBZTwUGAMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bfhBtOzckyc1L16u42_nnOK_8hlbVGfDdiH-xbTE3gw&oe=69E0F7ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9AdcZEOIz8Q7kNvwHDnRc0&_nc_oc=Adp3t7lTRVIwi74p4ebi_xQNQKgMTkGFuDdhUqVpfzmlyLP5hH_-ZQFweJ866Vp67HY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11qUWSQfuFBjDs0VtW__9yvSwZnaZkBG-vVwG-btMBGA&oe=69E0D7EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHwtChvE-Q4Q7kNvwH42BrO&_nc_oc=Adpz4c89rF5v-8giTwPCXM1G6pwquMYl2nOtFNwhDOrsVJSfQtyhyVatKBpTiQdiGqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LlbECDeVZZJ8_cBVUNEp5txKnd-cJaa_wF_0qsUntGA&oe=69E0DFB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQjaZSBFMw4Q7kNvwHEz0H6&_nc_oc=AdqlAOX9VhwJ70EG6bUvmWuTMmuprJLt9N-zU3Gz0D9osIyA4YAWiCpg7osDULRK-cU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gg3ktnQGHEdDWo0y_k6cX669QufEQXSqhqrSjutVI0w&oe=69E0CFB8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
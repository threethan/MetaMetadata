_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epib7GDgmUgQ7kNvwHWk5FJ&_nc_oc=AdpN_AlkJMy9yrM5TIQn17wVnwNLpLabMmN5NPAKSCPJcTgsCRMderXiYtS71uOgL8A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFx81edsDfyetmzdYaO4aO-5uT24XrXo0P1KYhbi_sZg&oe=6AE895DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZuJZ9SHZsIQ7kNvwHgEQr6&_nc_oc=AdolC6Ax6ubsMGZ9vspeOalVSwJMHZInRt955jxL-CPpfTBeeVqnYlKk7RqWJEeJdvw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5rshEbKFMUyBg6yFbN_zzRJXEG9ip340z42LjbAmeaA&oe=6AE8A3ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly6CZJtdfdwQ7kNvwENHTqs&_nc_oc=AdpAvTKUUytyQazQN2I8Nbczi0x6Z-H7vDwTxweb3LV-rDWYV24weRRAOzz7rqBC8sE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-NIJeNYIL1BMjmdktQhv7tmuF843PLZFX0kWJ0qQSIA&oe=6AE8BC2C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os6l9yXk7ZoQ7kNvwGJ-gH-&_nc_oc=AdpDSNS9WQPi5hN9MSU884aZe9fPeo0qJXr9iuvH0Ls0By8FovJSTyATXbq68By6g-4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG3W7dBN4Uf0rWg8-woObkcMw4pSL_-wKPGVeWUxT17w&oe=6AE88BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJcH2bZ2fLAQ7kNvwHLll72&_nc_oc=AdpRjyBU_BYVohstNIpL2xKKpoS-xz5p27AiB3WIyMCigIKdLvlLRcbRtdv4OUAnugY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXzWt6Lq7-hIOADG2Ih66Zcixk4atc-eJKGJHH9OllTQ&oe=6AE8B3F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
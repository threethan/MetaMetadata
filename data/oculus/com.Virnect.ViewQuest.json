_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg8djcy8MgoQ7kNvwFLuQWz&_nc_oc=AdoDDF2rGWr5nKEARrZwuLCHANec3eCaoevxvRLKBQmzyZukoEDX44m-DwxyMfwVy1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoRry1AjnQpTgSDuoXLVE6Y1JNDqKzTPgHjn47ZYjHBQ&oe=6ACB94DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2hSDvbrel0Q7kNvwHqNLjs&_nc_oc=Adq7rqy4GcAf99GWLOrVb-SPUo55jYgs8uZj9_k3t3ugt-2IZjBilkBZq5-CvJs8yGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN63MpBVEXlEh0ZhXsBWyFioVfQqUErv0KWVGMu3lsTUw&oe=6ACBA2ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRdpnkq3RPwQ7kNvwGelF0z&_nc_oc=AdqcFRBsMYLMZclY8jOiEenhWSFnail11FOrbG1TYYKF6xtfi6zJVKwOQ58xcsNkuPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnJNJtG2jGuySmA8a-GJQkkkx6Ej4IDxXK7OtRX6taBw&oe=6ACBBB2C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3JLAt7W_mcQ7kNvwHSwaSD&_nc_oc=Adr1G4YLAQx55L-ULvp20IC-IsvZQV_6XDzmM4VqjL10yBtgg-gSEfkPa83NtF3ZeIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNboujD6nm9QRvWfBpqXEpC4e0_-OokNeH-xqx0XGWEXQ&oe=6ACBC2F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt9J3vnUZCIQ7kNvwG6nfFd&_nc_oc=AdoGznkDcC6DvdiZkMEkKpt_xYuYI7AHvXQVaG55HTboNZC2V3sADdVeiUOAqzMerqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNMbQQ7ONYgo0wgA0W8wijG7f-pj71aXULr6FmKqSfpA&oe=6ACBB2F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
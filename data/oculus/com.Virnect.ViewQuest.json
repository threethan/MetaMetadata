_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHqMadtqi8EQ7kNvwHT68qD&_nc_oc=AdqM4Ybc5j34ypvKOkX-RgOOghsxh7h7wAAShtaiHI4I6xJi-GJ6ppuBLN74pUyWn-8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGbJiyr99enJUDGH7sW7q4slmpMC9eKPzNDCoY2H_1aA&oe=6AC7A05E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhDtVTIzplMQ7kNvwHcI3pY&_nc_oc=AdoK_c33Btre_jqB8QW2XKscFiGdPMusV7NI6_9vykn0f0VTXzbIiFTXdYbFP6qjpnM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSEmHAZMtnmUInHqka0h4WUcf8aCgXye-hPz8mLlxc-g&oe=6AC7AE6D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE-rj305vGIQ7kNvwGAAeAN&_nc_oc=AdqTprHkusKVPsuyF1hp--0vAUFVUUiMrLZlxOd5tkXcsfgcnpfvFQVYuRmWUSLgYPU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSfIYAxrrOu1P0lbtq8o8GpTIP7rUEWjbMi0Ix9KJYgA&oe=6AC7C6AC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvcC348jMbMQ7kNvwGtkyWW&_nc_oc=AdpQMTR9aVTjXxBRw7Pf4YK5UTeGh5Av2m5uV7IOEVfGzn2V0p4g1F-s3wRpSJ8pjs8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTGsJ23wEzr2k0JHMYAu9JCWbptnWTkh2v8VcC5MkTFA&oe=6AC7CE74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juNC1b_Tk-wQ7kNvwFpi30H&_nc_oc=AdptTAtg4U6ndjDqnOJVT1aCcSffs_cpuohxuAa9tyPqMnGSzuejzlNxjOmU6l4-_BM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4sv69H9VHDJRipoUjp8VB8V510PUKgns3UpighE6yYQ&oe=6AC7BE78"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
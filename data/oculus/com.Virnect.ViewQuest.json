_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MKXCMcHSJMQ7kNvwGinkSK&_nc_oc=AdoIzH2TQkySU_tu1P2hVclRsEBuA2J0BFPJASs2VBJplpKYipdr_CBE_njft3S3wF8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E4zHsHY1wBHnnkOgnoHPhMuAnnK6h3nRAvPOtsFjF6g&oe=6A33F85E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_ZmxU8KA2oQ7kNvwHYFzqZ&_nc_oc=AdqmMXSCmivGZhQcLK2L8nCWfC3GOTSNSn4AIOyNLIgzGD_sNrj15RueMKZ3mAV5DvE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e44-YDD4Jw_eqZPu14I0aHCSSUcR1DzljPTkz2E7P9g&oe=6A34066D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1raXM0JKb3gQ7kNvwEp1OiB&_nc_oc=AdqXfGPUnTjnRBU8D8JE1NN4-kQHNqEXQ7YcB4oJohpmQUw60XB99EIyfg547HVNKbE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nqzbWkyBDuDs5MSbi_ouR6TGyGuAL-QOIA79JqtVcOQ&oe=6A341EAC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqa9lhmQshsQ7kNvwHr6pJ3&_nc_oc=AdoMD1FBeMZTrp3MloEct9ECfj3QJ0GS6rYP19ygSsNaO-33ErbyYknU65DAI8UObXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nPReV6cw_uCTkpMktAPTAbvbKptZhs7itqjFGnhX-ag&oe=6A33EE34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI3BSXnM4d0Q7kNvwFnFrz0&_nc_oc=AdoRSvqOv9xorGRfZovvsTyXaMf3ITXDyR8XUs5KwnbauIek6XcywU8z7ellwuAtGcs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wh7yF5m5dge7edNLmaMW-HnSW5NkPD8JFVYDvUZuTsQ&oe=6A341678"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
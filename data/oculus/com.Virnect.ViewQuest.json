v/t64.5771-25/39036703_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8YaSiaMZYYQ7kNvwGvYlcs&_nc_oc=AdpzfRb_hO0w7GQdRKhE10yGY_PKq_bWk1hXuIxPVHuLp9QJeSKaB5WVjTKzDB8nJxo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD44ey3SrENAW3ZsMhbr16EBEuSNT87v1U85pfGy79ug&oe=6A8D661E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC6yuZov4k0Q7kNvwESqRCS&_nc_oc=AdryeFAUE9Zf7eOfDXeTs0YKf61TPkAfJu_EJrZ5lx-Fvf-Nm1YmqAY0flgjLLVNkeU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpBzDb9PaJnBiAbWxGyAYZ50tMjLloC1K9t_G2J1Hkvw&oe=6A8D742D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vODd1uYy9vEQ7kNvwGJPGKe&_nc_oc=AdpUthkaX_urUy2uQpirkb3MVPUmHhkzrHRnUmkQkYC7Js8lfA_S5t_1KDTsXqKHVqk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdJDRv95IFG41C8jFNQUoj_gwKXad5K2qPozW9rCszMA&oe=6A8D8C6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk8LwmxkQtcQ7kNvwFLhOQI&_nc_oc=AdqfWhlQBHnNLlBBv8O7sAfJQXBxjWOe3x7gfdoKTjrzWejjXRhf-8kEIfmWyYBVuyo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEipP0Z4ZuGGXbJokm0L2cWCfeq_GC7n1OQ3gIKRxMYuw&oe=6A8D9434"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QosUmGqqRKYQ7kNvwFu9VLd&_nc_oc=Adp5_48pWIvn7SizMXGv1Typ89f4DcLirMitOxGT2LYW9yml_W1gtxbJs4geB4LVNZE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDmZwYwj31x_Nyplthe1TT0POYtX3nAG7vtcIX73Lq-w&oe=6A8D8438"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "h
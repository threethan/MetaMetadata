E4LYGtRzvDsrmY8jWJ2mhVF0tPZ2_8cHP2rcGZhfuTnHWh88fQtjrGHznl4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36QumQ20UNQghdcIDCSweZJrMA80nSkoTI4GayeYiwlw&oe=69EA245E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgjzyJp8wBUQ7kNvwFTJzJY&_nc_oc=Adp4JtZI3FctjC3_SgFMi1ZEStm5KcsaFM4uDD0LBDGnAoEyCG48T55Uib3yjbYOY8M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TuR-NaGOhN-KN-L4EFVfVWXtY1VwGmAwoY9cZUKUuYw&oe=69EA326D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHoWruQbZaQQ7kNvwH4DOwy&_nc_oc=AdpXSSRHIUqJ0drRDspJ8EHcx36wrusj8wzl0ywaubBdwMfYUKz3Frynhh2WPW5hJpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B_7x2A2G7CVR4oQ3z_jnfLcBQSdUvpBoZJICO1ZHVsw&oe=69EA126C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHuqSZ7Mi2kQ7kNvwEfEhXt&_nc_oc=Adq7i_E6bKKyApwRSAk8fjPeFEK2meUnl7XfyE1xq0lcS-EbFe72j_U5cGRClHrrMlU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-93VGIKM_GaI0c-jIInkTlQvxnj0v59hARY1BRVPJtw&oe=69EA1A34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lzqkcLdj2UQ7kNvwHK42f9&_nc_oc=AdoWYbBG2X7dCoaon8y2KW6o5OyX7_-GZbSjOCJtZ0oH34FTl2Rh9HWIV1viTFQawrQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21Om74XpHWZSPnOwl7r4RzEHMw2p2_GJukiy7EMwu9qg&oe=69EA0A38"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
m9mzFtWpJoWrnfA9898NBl0cf-iupajK6IPhS7jc8Ljz-CMwmRWjeEt04W0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LKm1YY6zi5Xt97Cc0WeCrLDJwa8THpvdubn4XMViSTg&oe=69F9F65E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1geJQuVVmp0Q7kNvwGTo2RL&_nc_oc=AdoUPl5c_zW2p4DkYSt8mIsFxj_zm16NlmCm5yVAiSrelqJG3fkoLCC3pNO8qyL10N0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eH7mjB4Pf-_4n2a7U4s_nOF67EWj1wZwG_48UPAM3tg&oe=69FA046D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM_7F32Ob84Q7kNvwEWDz41&_nc_oc=AdpY-1x1XjjHAA3ts2_40evpU-wGoQbkXNxWhlLw95D2T1JEfd0gvxc7735I47sa4L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76CLUPC9ho7fTAM8J4bUpzSV271Nrey6xpYs6rKNgMTA&oe=69F9E46C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4spsklwOb8Q7kNvwGPrBg6&_nc_oc=Adpc_5GYbOk_HtY7nHJKQi5aEYboAlT7TxIx3GDVoDOnLjy1AUMavpSlUGVHuQrdRME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72S9-J3QT_ir4H9ePCUBLsMPbJvh59ScydI--Gmfk5KQ&oe=69F9EC34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc3RsHSMrMkQ7kNvwGBeRk1&_nc_oc=AdrBsluDwA2pt4MnB9Vi9NjMzHW_UuIjZc3PGW23FxGbXk42egMg9k9X3Ofi-5TkKTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SATE2PqWde9V5ozHDTQiJZDjRO4yNx16Qwi7V1_cABA&oe=69FA1478"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
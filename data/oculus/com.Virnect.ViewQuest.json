uluscdn.com/v/t64.5771-25/38974877_370602678820807_3612081096605602126_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U7V6iansVEQ7kNvwHs4HHu&_nc_oc=AdnuQQcnJcES15hqy7uMJnRJCxnf2tPm8ex8-IgBrWaLy2-JX4z1E2Afnb4vtrObaWw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLNyZdBXmGdInoTFKLmdaQyVzygEhapciiPth614z-VQ&oe=69BAAE6A"}, {"file_name": "002.png", "id": "454762527203178", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982544_454762530536511_5216769577991405005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHs13fMQazAQ7kNvwEHtSYx&_nc_oc=AdncluxwnUTh6DwRcZ3ZT55D-ZVIDFYhZoOePRVMj3g8C73UjxEpGA9Pee2_dOPzM3g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxe95zvEz0P1B2Lskvv1kwi57PxBqdD1SToPCZIsd_3Rw&oe=69BAA481"}, {"file_name": "001.png", "id": "458667193480281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75443246_458667196813614_5665118081351308517_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5HG5l0QRpIQ7kNvwGFT0Z8&_nc_oc=Adl-IBCfwlUkYRFX6J0cgR6B0sXt3mBYWb7kqwCMu2_cjhNU_AEMLLVa3Cb41TjppMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJrUFQDxg69BncZ7VT6c06eE-pRyQV3fMnvX8SE4guGQ&oe=69BAACD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "752706017074132", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404378_752706020407465_7765183363426454573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPiX7Qj62PoQ7kNvwEgl-UR&_nc_oc=AdkdS7YG-LvF5FQMoOcw2Px791S_85L2-ND-MyMC-NIn38T9sgcFmvjKQtIFqKQ6_pI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPdk34GqtwXOd3Ubuu9k8uNAvOzphbPrQEVEXJ3eILyA&oe=69BA9139"}, "display_name": "Virnect View", "keywords": ["\ubc84\ub125\ud2b8", "\ubdf0", "\ubc84\ub125\ud2b8\ubdf0", "\uc0b0\uc5c5", "ar"], "long_description": "[\uc571 \uc18c\uac1c] VIRNECT View (\ubc84\ub125\ud2b8 \ubdf0)\ub97c \ud65c\uc6a9\ud558\uc5ec \uc5c5\ubb34 \ud6a8\uc728\uc744 \uadf9\ub300\ud654 \ud558\uc138\uc694.\n\n\uc2e4\uc81c \uc7a5\ube44 \uc704\uc5d0 \ub9e4\ub274\uc5bc\uc744 \uc99d\uac15\ud558\uc5ec \uc190\uc27d\uac8c \uc7a5\ube44 \uc0ac\uc6a9\ubc95\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud604\uc7a5\uc5d0\uc11c \uc2e4\uc2dc\uac04 \ub370\uc774\ud130 \uc815\ubcf4\ub97c \ubd88\ub7ec\uc640 \ud6a8\uc728\uc801\uc778 \uacf5\uc815 \uc6b4\uc601\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc2e4\uac10\uae30\ubc18 \uad50\uc721 \ucf58\ud150\uce20\ub97c \ud65c\uc6a9\ud558\uc5ec \uc2e0\uc785\uc778\uc6d0\uc758 \ud6c8\ub828 \uad50\uc721\uc2dc\uac04\uc744 \ub2e8\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n[\uc8fc\uc694 \uae30\ub2a5]\n\n\uacf5\uac04\uc744 \uc778\uc2dd\ud574 \uc6d0\ud558\ub294 \ucf58\ud150\uce20\ub97c \ubc30\uce58\n\ucf58\ud150\uce20\ub97c \uc6d0\ud558\ub294 \uacf5\uac04\uc5d0 \ubc30\uce58\ud574 \uc5b8\uc81c \uc5b4\ub514\uc11c\ub4e0 \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc624\ud504\ub77c\uc778 \ud658\uacbd \uc9c0\uc6d0\nAR \ucf58\ud150\uce20\ub97c \ubbf8\ub9ac \ub2e4\uc6b4\ubc1b\uc73c\uba74 \uc624\ud504\ub77c\uc778 \ud658\uacbd\uc5d0\uc11c\ub3c4 AR \ucf58\ud150\uce20\ub97c \ubd88\ub7ec\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc628\ub77c\uc778, \uc624\ud504\ub77c\uc778 \uc5b4\ub5a4 \ud658\uacbd\uc5d0\uc11c\ub3c4 AR\uc744 \ubcf4\uace0 \uc815\ud655\ud558\uac8c \uc791\uc5c5\uc744 \uc218\ud589\ud558\uc138\uc694.\n\n\uc2e4\uc2dc\uac04 \ub370\uc774\ud130 \ubaa8\ub2c8\ud130\ub9c1\n\ub370\uc774\ud130 \uc5f0\uacc4 \uae30\ub2a5\uc744 \ud1b5\ud574 \uc124\ube44 \ubc0f \uacf5\uc815\uc758 \uc2e4\uc2dc\uac04 \ubaa8\ub2c8\ud130\ub9c1 \uc815\ubcf4\ub97c \ud604\uc7a5\uc5d0\uc11c \uc9c1\uc811 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub208\uc5d0 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uc815\ubcf4\ub3c4 \ud568\uaed8 \uc2dc\uac01\ud654\ud558\uc5ec \ub354\uc6b1 \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \uc6b4\uc601\ud558\uc138\uc694.\n\n\uc791\uc5c5\uacb0\uacfc \ubcf4\uace0\uc11c \uc791\uc131\nAR \ucf58\ud150\uce20\ub97c \ubcf4\uba70 \uc791\uc5c5\uc744 \uc218\ud589\ud558\ub294 \ub3d9\uc2dc\uc5d0 \ubcf4\uace0\uc11c\ub97c \uc791\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud14d\uc2a4\ud2b8 \uc785\ub825, \uc0ac\uc9c4 \ucd2c\uc601, \uccb4\ud06c\ubc15\uc2a4 \uc120\ud0dd \ub4f1 \uc791\uc5c5 \uc218\ud589\uacfc \ub3d9\uc2dc\uc5d0 \uc791\uc5c5 \uacb0\uacfc\ub97c \ubcf4\uace0\ud558\uc138\uc694.\n\n\ucf58\ud150\uce20 \ub3c4\uad6c\ub97c \ud65c\uc6a9\ud55c \ucf58\ud150\uce20 \ud3b8\uc9d1\n\uc0ac\uc6a9\uc790\uac00 \uc6d0\ud558\ub294 \uc704\uce58, \ud06c\uae30\ub85c \ucf58\ud150\uce20\ub97c \uc9c1\uc811 \ud3b8\uc9d1, \ub354 \ud6a8\uacfc\uc801\uc778 \uc5c5\ubb34\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n\n\uc560\ub2c8\uba54\uc774\uc158, \uc778\ud130\ub799\uc158\uc744 \ud65c\uc6a9\ud55c \uc2e4\uac10\ud615 \ucf58\ud150\uce20\n\ub2e4\uc591\ud55c \uc560\ub2c8\uba54\uc774\uc158, \uc778\ud130\ub799\uc158 \uae30\ub2a5\uc744 \ud1b5\ud574 \ub354 \ubab0\uc785\uac10 \uc788\ub294 \ucf58\ud150\uce20 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n[\uc624\ud508\uc18c\uc2a4 \ub77c\uc774\uc120\uc2a4 \uace0\uc9c0]\n\n\uc571 \ub0b4 \uc815\ubcf4 \uace0\uc9c0\n\n[\uc6f9\uc0ac\uc774\ud2b8]\n\nhttps://virnect.com\n\n[\uace0\uac1d\uc13c\ud130]\n\nhttps://virnect.com/support/inquiry\n\nB2B \uc804\uc6a9 \uc5b4\ud50c\ub9ac\ucf00\uc774\uc158\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ub77c\uc774\uc120\uc2a4 \uad6c\ub9e4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.", "short_description": "[\uc571 \uc18c\uac1c]\nVIRNECT View (\ubc84\ub125\ud2b8 \ubdf0)\ub97c \ud65c\uc6a9\ud558\uc5ec \uc5c5\ubb34 \ud6a8\uc728\uc744 \uadf9\ub300\ud654 \ud558\uc138\uc694.\n\n\uc2e4\uc81c \uc7a5\ube44 \uc704\uc5d0 \ub9e4\ub274\uc5bc\uc744 \uc99d\uac15\ud558\uc5ec \uc190\uc27d\uac8c \uc7a5\ube44 \uc0ac\uc6a9\ubc95\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud604\uc7a5\uc5d0\uc11c \uc2e4\uc2dc\uac04 \ub370\uc774\ud130 \uc815\ubcf4\ub97c \ubd88\ub7ec\uc640 \ud6a8\uc728\uc801\uc778 \uacf5\uc815 \uc6b4\uc601\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc2e4\uac10\uae30\ubc18 \uad50\uc721 \ucf58\ud150\uce20\ub97c \ud65c\uc6a9\ud558\uc5ec \uc2e0\uc785\uc778\uc6d0\uc758 \ud6c8\ub828 \uad50\uc721\uc2dc\uac04\uc744 \ub2e8\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "Icon_StoreAsset_Transparent_en.png", "id": "3284738788487665", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75361357_3284738791820998_8415991709959512893_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuLQAl9IT0cQ7kNvwFrpXEt&_nc_oc=AdkBpfXNqAoK7FLGoFTIlCImH5IkDSuv5Zg-SDsNKaXoJpal8UmXrgMR5-qOwpVueac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkISP2rHaAav2cz7fOgsOWo_-OMjotXHiPVekiA-eZSg&oe=69BA8369"}, {"file_name": "CoverSquare_StoreAsset.png", "id": "1553611768681535", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974723_1553611772014868_5929781507689364850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYdGm5JeJTIQ7kNvwEkb6tb&_nc_oc=AdmaU3ApdDpUukzWXdKOA9O4RgwF4Pop8XaxM5Fi4MAlcSA_c4UUY32iG4sEkRx02pI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyn0-7y3HYDg6bdRdG0kd9_R_CcmO3uhCvLRnItw06qJQ&oe=69BA8B12"}, {"file_name": "HeroCover_StoreAsset_en.png", "id": "1516065405789560", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035412_1516065409122893_7724172160591120335_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP8aD7QHJi8Q7kNvwHBgL7L&_nc_oc=AdlnX2iNLkpsJVH3vXXjpa18EihoHo5VBSUVDdZ7yZddfv2u44lVsHdtLulARvo_aGE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx42CGVWuEDKE76d2uhiQ4IU1kRrGTkJielMYLlJOFheA&oe=69BAAB1E"}, {"file_name": "CoverPortrait_StoreAsset.png", "id": "602390615482297", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982440_602390618815630_6850482379670233169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK5qYHDa0mwQ7kNvw
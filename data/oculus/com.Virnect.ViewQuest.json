_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruJN_7mr-fMQ7kNvwEr9k6O&_nc_oc=AdpA3Dkcbou9xIo9mdDlqDVV3yPE7Z5os5tYvYBC5ZHht0qf6DZD97xq1wRRve6cHKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P-rnNryLsp1fRi87ZZ9phXzpnq5fcjrmVClAx7TyT1A&oe=6A199A5E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K-Lm4n-Mv0Q7kNvwF_heKz&_nc_oc=Ado_YjOJ6J8vRYSsiEU8LHYxLgI3v3xrATesWLrKV0966eg7m6zFTzz1BIqljm2_2dA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g7WnP3EhFksyAyzupLnrxvZM46IARgdYoRQnagMzfJA&oe=6A19A86D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkVPeolsIkoQ7kNvwEGkJf_&_nc_oc=AdpcJGFDLvYdcSq4mFbB4VA30dIziWllkwfp_0idX5gmUs5eedyk0dz-5w2Gy07yy-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L2Q_5tnWZzXq4mrTcjQrDwXIsF-9ub0-84OSrMMGD1w&oe=6A19886C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdbnNgZ1OlQQ7kNvwHVjlkN&_nc_oc=Adr_Ws67Ds6Mg-CNnxZPh1Utrt1KELI9rNWfq_mkmM3IEMGM6mlFWaWK6nmH64CBQuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70olJALB_jwNB0eEJFWCUc7A8hjX_Ywtf6LQoNZdVPwQ&oe=6A199034"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px8RlSiLtpEQ7kNvwFeYBcI&_nc_oc=Adqr00hzsYCgMDsHMPdyHpDnB1RdUyte5Vl7CKeXtshoOy7M_01UHRtlZ0HVG0q3HdM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gygrnBlHj-Jv9XENko6CffGzfdNWcM3176y_YP3i8qg&oe=6A19B878"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
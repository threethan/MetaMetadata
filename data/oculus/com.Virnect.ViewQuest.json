_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faK0gTI-DrAQ7kNvwGRvr2x&_nc_oc=AdqXaINTg5e8_yJpuyx8H1Z1pVzGa_hT8gOgp68GExcfZlTs6YZXLABJ12EvuL_Lp-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi8y0xlS0ctQnPRBn8v_yUYgffV9XiiIBczy3RHihFEw&oe=6AB3D9DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=618GdkaTgLgQ7kNvwEpOcfX&_nc_oc=Adq_yWhWbeXlovcF6_Az8POdt1ROR2tJ9vumbwJZtaSKaBy241LIY1ykc64YsFk5Idw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQG4tnabYRG9Z9WNe7bqiBechd5TzrRyztHe3ncCPU8A&oe=6AB3E7ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKfmCPqmjuUQ7kNvwGx0NKG&_nc_oc=AdrlUi8vBjXi53-GwSX3g1USjuF2bfF0I4LRymLD0fy7jMjY81KUou_BCOMMduYas-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-Ht2yjTXjhe3S71SVJsGo3RsWa3POHGGZVA0dgMyA_A&oe=6AB3C7EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gVxPrQEVmcQ7kNvwFeGvKX&_nc_oc=AdrIIct-dJaH2fSkhW7Is7C_oPvF_ZNGZMFtoHfHZ3bGT2KTXSRske8mZyWFaNXWWVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6pugmn8enjj-bLPHqPSNwbECj9Hq5OCS4OQXHsg7Mmw&oe=6AB3CFB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzb8OLfDI-YQ7kNvwEUIaNf&_nc_oc=AdpU0z1sfz7ahr6nhFmEZP2wlYiADP_I1cqGWNXTz4WRPmBTQGjnZrij6BYWzowrQ08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv6tvj4XqIK-7WoWtPsJmwcSbhU7aAq8raiyNfkET0mQ&oe=6AB3F7F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
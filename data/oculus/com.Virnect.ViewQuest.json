ZAK4VnpsN3VcGM1vH7tmKR4kdZPWGKbpKy2vZScxWjiFijo4PwUuxxuhEWY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwazjtAcHdfHT8fH2CTOPVHmQB81g2mJPyX9ABgfYpGAg&oe=69C7DD5E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St1ktPWUwtkQ7kNvwEXGF33&_nc_oc=AdpiclrTV8M0iizB0efLNcY5GWAC1GbzFso7dNTAMIcZ2YoA4yX-stRLJL185Gw9wDM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJYw9G6oux0ZTHN7FBjiveYTtIvTqr-iaJaFTgjOn1cQ&oe=69C7B32D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4s2BMlmHA8Q7kNvwEQBAJ3&_nc_oc=AdosGVJap5lNn07QMkhL-F89eN2tuQNi6mNGqlCUkJEMeLc1swvrYbEwlDX5bG6YugY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2KmMu0nyhgsXvQKcA1PKS7IqC4w3VwgH-U0g_M1O_rg&oe=69C7CB6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJn0Pn29Q9IQ7kNvwFpuMj2&_nc_oc=AdqfvAqgAInow3-JQr7tvTQHKKyEP0ipucZWijrmveEUZmotjj4AKlmrRCEikjksqCw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeoIWnV75hEZzDe-aJ3NvCQeIr2q6rHTn3pbY5kEBYew&oe=69C7D334"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUAJtAyaR60Q7kNvwG4GVKu&_nc_oc=AdpIzRov7VQFTuOvdUhx-7K0cHE4M9lWgQDp82hGVcWJeJVLOJYnTSUtacHJvEM1KC0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvtGpyibebR5S_NVgdyhxna13QSZmrmWaBiCv8F2_qKQ&oe=69C7C338"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
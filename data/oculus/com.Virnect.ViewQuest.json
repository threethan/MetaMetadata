7a30f&oh=00_Af2_-ZpVoFALmayCLbNA3tkBsfZxpyz7_k7k_rpXXuWMpA&oe=69D3A8EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKopXN0bj-kQ7kNvwGcfp8w&_nc_oc=Adoit0CzNmrwLAZjv9z0T_vs3GCMhfRTEyusV4r_ZmJnMyGtTH_U314Rwk5YmMnZwvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s78yAdXwf7DPJ8WI7i6AT4p4njhLm4bW8L72bwIHlzg&oe=69D3B0B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o59Tm0sIn30Q7kNvwFEFp2y&_nc_oc=AdoxdtpKRnM9qkJ9-FB7KASl9m37nqNZM_RFgtowDevsGnqArrMvzSPvPOXvRS-1bq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15BgyEZ5EK12PxDhgvUxHNzDHpFY0qcHBzlebCP-_dfg&oe=69D3A0B8"}, "display_name": "Virnect View", "keywords": [], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://store.virnect.com/page/index?tpl=etc%2Fcontact.html\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27751734134472239"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1507141503523409"}]}, "baseline_offer": {"id": "1507141503523409"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734565800, "status": "PUBLISHED", "id": "1507141503523409"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32276892148623059", "version": "2.10.1.8"}, "id": "1611489713038493", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25420440614268281", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32276892148623059"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1611489713038493"}]}, "change_log": "- \ucf58\ud150\uce20 \uc99d\uac15 \ubc29\ubc95 \uc911 \u201cVR\ub85c \ubcf4\uae30\u201d \uac00 \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n- \ucf58\ud150\uce20 \ubc30\uce58 \uc911 \ud68c\uc804 \ubc29\uc2dd \ubcc0\uacbd\n    - \uae30\uc988\ubaa8\ub97c \uc774\uc6a9\ud558\uc5ec \ud68c\uc804\ub418\ub3c4\ub85d \uc218\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\"View in VR\" has been added to the content augmentation methods.\nChanged rotation method in content placement\n\nModified to rotate using gizmo.", "created_date": 1763365878, "id": "32276892148623059", "version": "2.10.1.8", "version_code": 21001008, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25420440614268281", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32276892148623059"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1611489713038493"}]}, "change_log": "\ucf58\ud150\uce20 \uce90\uc2f1\uc73c\ub85c \ub3d9\uc77c \ucf58\ud150\uce20\ub97c \ub354 \ube60\ub974\uac8c \ubd88\ub7ec\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uac1d\uccb4\uac00 \ud654\uba74 \ubc16\uc5d0 \uc788\uc744 \uacbd\uc6b0 \ud654\uc0b4\ud45c\ub85c \uc704\uce58\ub97c \uc548\ub0b4\ud569\ub2c8\ub2e4.\n\uc0ac\uc6a9\uc790\uac00 \uac1d\uccb4\ub97c \uc6c0\uc9c1\uc774\uac70\ub098  \uc774\ubca4\ud2b8\ub97c \ubc1c\uc0dd\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ud14d\uc2a4\ud2b8 \uc624\ube0c\uc81d\ud2b8\uc758 \uc74c\uc131 \uc77d\uae30(TTS) \uae30\ub2a5\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n\uc9c0\uc6d0 \uc5b8\uc5b4\uc5d0 \ub3c5\uc77c\uc5b4\uc640 \ud78c\ub514\uc5b4\uac00 \ucd94\uac00\ub418\uc5b4 \ucd1d 4\uac1c \uc5b8\uc5b4\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n\uc571 \uc2dc\uc791 \uc2dc \ud328\uc2a4\uc2a4\ub8e8 \ubcc0\uacbd \ub85c\ub529\ucc3d \ucd94\uac00\n\nContent caching allows faster loading of previously viewed content.\nWhen objects are out of view, arrows indicate their location.\nUsers can move objects or trigger events by interacting with them.\nTTS (text-to-speech) for text objects.\nGerman and Hindi have been added, bringing the total supported languages to four.", "created_date": 1754553816, "id": "30576136612031963", "version": "2.10.0.10", "version_code": 21000010, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25420440614268281", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32276892148623059"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1611489713038493"}]}, "change_log": "Updated license policy has been applied.\n\nA license is assigned when augmenting content online. (This includes storage, tasks, curriculum, and collaboration.)\nIf there are no available licenses to assign, you cannot augment content.\nIf you switch to offline mode while playing content with an assigned license, the license will be reclaimed, but the content will not be terminated.\nAfter the license is reclaimed, it will attempt to reassign a license when you reconnect online.\n\nEven if the license assignment fails at this point, the content will not be terminated.\n\n\nIf you are in a state without an assigned license, you cannot submit task reports or curriculum quizzes.", "created_date": 1745371235, "id": "29093998613579111", "version": "2.9.2.6", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25420440614268281", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32276892148623059"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1611489713038493"}]}, "change_log": "Added Hand Ray Deactivation Feature", "created_date": 1737017310, "id": "28035466062765710", "version": "2.9.1.5", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25420440614268281", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32276892148623059"}, "release_status": "RELEASED"}, "binary_rel
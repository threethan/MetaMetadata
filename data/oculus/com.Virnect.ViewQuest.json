wdj_s6MzffZQn3k_MWXXwHs7nqNnLm1O1C8Z8LrHhZPRwM10sIWAkHVCL9E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21zrE18x2xPItMZ0tx8ZHDN8tFqSb7NzzXy_lvnUHUsA&oe=69E62FDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNHsBlAks8IQ7kNvwE8Tcmy&_nc_oc=AdoddEAU5G_KVStThzWRiVSWwqqCLqcjPwE7rGl7KcJyYu1p_vTV29cjYENxO_FaXXo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LRdnVIgy6oBQ4uSHk1Le4xw3TnhWEMUry4_JOpjN4EQ&oe=69E63DED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obxtVptDk0IQ7kNvwFVFCaf&_nc_oc=AdqAKZGRfjeqIHHnrSBUVGyiycsZ_aW_3u4wNsaf1NbzI3WbH7mSOiz8uhy_AELtL6o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MUdGB4XVavZr3VL0RbpE7VAk9JTUhBgt0Gmyd5QVwvA&oe=69E61DEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvTVkaJMyYYQ7kNvwGdu5TZ&_nc_oc=AdphzmUpNE2xIMFM_3mspx4jh4OaPVUMMlbwJXGviBooDMNlG_CaGM3Fkc-r_7l_WHI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af160dpGEn6ERnEX8FY2a6Pq5LFsIzIf49MyI8KVenh7vw&oe=69E625B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBO9AbIEF84Q7kNvwHlVz4a&_nc_oc=AdrGZQUfQ0b8ziatP0Cyuhb7a0RxJOAKumvpbusOFwALEsP2zbsgym4GAKfs5PSFg5s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20-1Uqkh0j_21lPVCp0G5YFYoR8dLuJ_JYJSQAyKEd4w&oe=69E615B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
Vk3_pqwK9DCWierGuTLRhbA7NwSDjOVbZEWIP9HLnala6iJS7enNlFOIC64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fU6Y2Innpo5hidvVsorbHmlmrIU3J5N3EYjeUU_WF8w&oe=69D65DDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rgh1SWf730Q7kNvwGcZSoj&_nc_oc=AdoKG7ZGCHexVPyRjNS7T-dYp5i4lxRP1GeNsLJc-SalHOB3yQ3JyFEPakIohUicqrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SbXafU06deKyFk6L8RZPyowqdp3Ph_oKqcKbuMuixQw&oe=69D633AD"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07B3qTKFSz0Q7kNvwHScdV4&_nc_oc=Adrcb-7uFjjsm49sKnT_Lu7scy0mQngqqYb20N9Dg1tIPHfBsFxgxZixII9jBK4-PWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iar2JTRSDOjLgOOQTxrnBZmGGd8hKdeCA5PgK9nXRZg&oe=69D64BEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKopXN0bj-kQ7kNvwEVaXkp&_nc_oc=AdrgCut5yTIHTKcoMwycKivVfFS0LiYlE2yIN3J8LY4qzR38uAtqkGLqpFHhO8oVd0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V_KpvKW28990V6kOAJ9W-UZnnoeej1fEWUHaQW9-cng&oe=69D653B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5u8ofuOl5EQ7kNvwH6K54E&_nc_oc=AdrAoYjjhC1swx7zNxSyj1ft_dJD-aOoqx5DJ4I8G-jdlLXy3LMAeFzRK1iXG-TW6NI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pp3e28vbz8KInxjGXZ_gqlbNSzlRPSZcKxZc-Ba6Bfg&oe=69D643B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
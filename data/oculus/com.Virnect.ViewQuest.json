_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QadC2c2UMaIQ7kNvwFi7rt_&_nc_oc=AdoWawYwJAeJ_-3zQzn8lgB7uYHfVc9qR7CU45Ai_zT9Acv5TwVgfgGSR3U3pQ1iH0U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5stACVaM2IjYE4mF8FuPFETk--_Q83eTZTmQPCRRL4eA&oe=6A1302DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBxJE7D1skoQ7kNvwH8jcoS&_nc_oc=Adr5gSyKsBL4oemhF5zdNqFMrFdbf6W0PtgA157ZN2vgl8jSStiZ81A6VCWP_02fG3w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53gzwi7Y4WmCiOS-nuj8LKxBv992Ys6PdnulrtpwBi7w&oe=6A1310ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIe8wn8mb_cQ7kNvwH2vNe0&_nc_oc=AdqIZsa2EAK490nNiOpP9Gh2X-GcrcUBudSQ-cl6C94f3D2huZlsM_trqW6tw7c4MWE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hL4JsnHSuukg3awpUnIocEdSBK4hY_uQhT-I1ML_JOA&oe=6A12F0EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGW8-2-rPQ0Q7kNvwHyDiaJ&_nc_oc=Adq8Y2naV2HGIwNoPyToUnexxWD6EdtfMyzQZDd0LiXIodT3mVx95OhJSNmmya3Vpn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZhKupiY8oasTuvBr2p_xsLuGI283VXvfn1HQ-bqGNNA&oe=6A12F8B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bKYJ5-sh6IQ7kNvwFUdNFb&_nc_oc=AdroyMxtLSDgH7VgSaV7PwQeX0bhryYHtWdrt5IgordCPAJGC5ihwIXr604h2pZsRWs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tbGcFsCPx39E6jvlekj2j6SWxViaBar-5QWVnUfFu3w&oe=6A1320F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
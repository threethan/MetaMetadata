eYrxCuRWiWnvQ5wjOzlvoBPUokU5JcydWty4WegLMjWA9M7Ldpx21LIwjOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o-xgTFqqmNVfzcf_qEc7QUGOM7NsUnNWdYEGsCoJ6HA&oe=69FDEADE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkz2mIIh6MwQ7kNvwF1pLTX&_nc_oc=AdooGXrJyVWOTqZ9yIbXn4apRltzVRcXPBDcQe0x7joKU7ZBs2Tz4-dj2aYehMNK9Qs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fRiSlL7nxvqjdudKN43omTpzce07P0Ndd-FQPhxth3g&oe=69FDF8ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysHzOURw5tYQ7kNvwEYBLYR&_nc_oc=Adr65841Q7194Q-X6GaCWASIxH7VG77zyfSN4pQM84Ck-yw7xgU9EH8UTg-r3xMZGfA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KqqjCGHtBgDwuetdzANuNbg10fn_K7HhWLfRCzJjErQ&oe=69FDD8EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y727nRxDHLoQ7kNvwGVSy4Q&_nc_oc=Ado9s-R7WCEddfMJo9nyrs4weO0HSMuDQV2L-oP9x5aCaEqYy5wJ5Dpf_5B-6Rwq-KU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XdP0JKXMSCHMPahIqF7q2OdkulxRwnUkYv-GntDS6ng&oe=69FDE0B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y4IF6dUeGUQ7kNvwF-z2ti&_nc_oc=AdqXFHlTvp5S4UGhTBhyX5QYjnXgAl-WFWNbLDiVik4zQyrHXMbhSd9RdQOhBCJLGRc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GIciW-kdh_2Vs1GJntJMWcjvwQ7dBYsEtjewWUvV98w&oe=69FDD0B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
Binary", "id": "32276892148623059"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1611489713038493"}]}, "change_log": "\ucf58\ud150\uce20 \uce90\uc2f1\uc73c\ub85c \ub3d9\uc77c \ucf58\ud150\uce20\ub97c \ub354 \ube60\ub974\uac8c \ubd88\ub7ec\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uac1d\uccb4\uac00 \ud654\uba74 \ubc16\uc5d0 \uc788\uc744 \uacbd\uc6b0 \ud654\uc0b4\ud45c\ub85c \uc704\uce58\ub97c \uc548\ub0b4\ud569\ub2c8\ub2e4.\n\uc0ac\uc6a9\uc790\uac00 \uac1d\uccb4\ub97c \uc6c0\uc9c1\uc774\uac70\ub098  \uc774\ubca4\ud2b8\ub97c \ubc1c\uc0dd\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ud14d\uc2a4\ud2b8 \uc624\ube0c\uc81d\ud2b8\uc758 \uc74c\uc131 \uc77d\uae30(TTS) \uae30\ub2a5\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n\uc9c0\uc6d0 \uc5b8\uc5b4\uc5d0 \ub3c5\uc77c\uc5b4\uc640 \ud78c\ub514\uc5b4\uac00 \ucd94\uac00\ub418\uc5b4 \ucd1d 4\uac1c \uc5b8\uc5b4\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n\uc571 \uc2dc\uc791 \uc2dc \ud328\uc2a4\uc2a4\ub8e8 \ubcc0\uacbd \ub85c\ub529\ucc3d \ucd94\uac00\n\nContent caching allows faster loading of previously viewed content.\nWhen objects are out of view, arrows indicate their location.\nUsers can move objects or trigger events by interacting with them.\nTTS (text-to-speech) for text objects.\nGerman and Hindi have been added, bringing the total supported languages to four.", "created_date": 1754553816, "id": "30576136612031963", "version": "2.10.0.10", "version_code": 21000010, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25420440614268281", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32276892148623059"}, "release_status": "RELEASED"}, "binary_release_cha
scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyPEcoq0O6IldrR8jazLCJ6aI_dHRHLBzOZwM4VyZkfw&oe=69BFF45E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRIvUc-Bt_EQ7kNvwGzKt3j&_nc_oc=Adlu1ARKklciqfo7l5WEd-4u2NfTU7kTU1BIu49V9ZeU6Pz-5BsQPz4tZkIrJUWZc_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7ovZApIu5rZEXBvnNBcS2NmH0C2ib3R84O5x5OBzG3g&oe=69BFCA2D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3xVUPykhvkQ7kNvwFXadv4&_nc_oc=AdkHtODsExLpfOndDE71t5RxCoEm1-zO_g2aoXrV7TjuH8hRFdJZ5oqF9zR6KaEDC9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9HH3zTlMsYvVEn9eQ9-JIYmiKjBtAwdW0kTBUjqfKJQ&oe=69BFE26C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyH_o5AO0B8Q7kNvwFYBvSj&_nc_oc=Admv_N49WmA6mFkArm8LKApSzxCqGDgBNcKa_bTQ6qckWN0NG0xcpIwLu3JU_aVWfC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO32sn4nLDNWoN8CqVDjti2spMkLpHQZvcLdrWCX4LSg&oe=69BFEA34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwAIZGe5nfIQ7kNvwF5am8Z&_nc_oc=Adm8AGq07dYb2p5uCMTMqHi3wlofztOBW_AhM7zRKLjI69r0v-YMNolg_ruW-Jn2wFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfypkvK2yZKNXF911CYzNULQ92_KxcqM9oXYMSVLCAe-7g&oe=69BFDA38"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMF
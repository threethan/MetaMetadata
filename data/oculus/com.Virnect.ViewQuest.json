_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QadC2c2UMaIQ7kNvwE7Vd3f&_nc_oc=AdpmwbFg1IeNiqajYGR1fRsT0C2vV5h9Bl3uyMGH6hp9-uDrT_CCBoEGDneGGfHnHnY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65KN1Zox2e-Am9Rvk9_0jT5ggWksa1aSdkG11SQ74eGg&oe=6A105FDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28-La0nGppAQ7kNvwF7r-F6&_nc_oc=Adqlq0He6DCDMyupduQJrjEkVoxVtY5OHXUA8DfqZ18TKEteXdXmrP-eD5kI6TpbL-k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TeivlW1irCeXf3XvbC_lxP2whZnFHKBMyqA0cRlrQqA&oe=6A106DED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klY17RZPv_kQ7kNvwFNVwQ3&_nc_oc=Adp-UBUrwgV9JP1S_5oFXF3bLFsgYCmvoUlx38K0etSDUwX52HwtCeHVWiyxNOyMYhA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F9HiHA4sRlY4ONxFl8vBW76zCrrMnoGon3ezcDmxWwg&oe=6A104DEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFq3CFoBbSAQ7kNvwE4ZcEO&_nc_oc=AdpXf4bd0vQHaCYx0y9ZoLuq7B1ZW0C-wzcp_RsP8kl9NOxXHSxpoYpsh3KYjGuvwZY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xRM_uASOk_FVXjEesYCsX-Y64lzELSXOMJbVl0jL4Nw&oe=6A1055B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bKYJ5-sh6IQ7kNvwFWMVEE&_nc_oc=AdqvZTuGqnMaZ7SMBPT5Hsk0jWsUoVZOw9o0iC-s9RZlUYWDWUvMNH5rJjPUP23-Ocg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d8vNJg8r76RF_Q-pvbfy7Io8G9fv8w4tFpWAw0oOD3A&oe=6A107DF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
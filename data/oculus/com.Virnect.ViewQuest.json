_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZY53khpuS4Q7kNvwHk0eQk&_nc_oc=AdrQrzqNI_I3G_kiA6OSz_RyAOA8LT4_4_VaNGOlf4XIkD19-WEe85fdJo0Ht6vrf8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChV5z8p_HXvAXxa2NmIVgrDFLeUrVfiTPCJBpPsSGYUg&oe=6A4BB35E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyqAY4oEnv4Q7kNvwGLcvfv&_nc_oc=Ado4EP7-8qntzW_Xjt7W06LXMxGg3Ox8s80N6cGagWCHkYW45D7d6qblv_imYrnlu1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUd7MQBfKJrlZiCiGWWMwV5_TqtMPGVY-ev728ZF1dHw&oe=6A4BC16D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKZf6aJHgRUQ7kNvwG81NxC&_nc_oc=AdrTDXVBF-MClWPLfoa9_hAOcRlMkteVAj774SqnDohmCphiEFHIazh8_hgehCXbp8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3_GoZZnFOa71N07WJTdZ62Z5Jp8XwwGcyF_dunXdT7Q&oe=6A4BA16C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YvmoLqdnb0Q7kNvwFvlKv7&_nc_oc=Adre2dJqouvWxOCvEoi7yBNbWfqHf9bfAKgvL7oyJ8OugqWh1JHE4qmisxCgtf19Z6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQP9NuMvI8KQah2OBv7AQx_0tc5lSWtnSO90sxSEKIIg&oe=6A4BA934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07QB6wFuvrIQ7kNvwHL3DsK&_nc_oc=AdrrIfETOnFZ8Vb67DUdVdJ-hF9iuWK9j5Bpou8vUc26a6PRyp1CzHfTRb35UnRrmGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMoFfEsHvN7hftHBi3YXKIkxq2AVemvX0iCa_GBGUDaw&oe=6A4BD178"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
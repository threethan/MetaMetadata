_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5RLy9t2LjQQ7kNvwHy5RJx&_nc_oc=AdpKmUEONgZNlztJGfgbBGs2m2MiWZ3N_uCyQRiEoyLlE5n4brTcGUTz5BNjw0wqkc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEsR3qlLAZwnX4EmGQomhV6x8Quc71eod1I24I0b5snA&oe=6A6762DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wans-xp-oZ8Q7kNvwEK31d-&_nc_oc=AdratmYagZ-EB1S4AEpOpg9lSqq0EEnOqIXj2WSU8QYsoIIEyRFuOLT6WSC3NFgtGHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHszPrVtkpD0eTvcGv1EIBhaVlFBM6qXRjXA5LnhQ1_Q&oe=6A6770ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI85RpEzUI8Q7kNvwFGgKh5&_nc_oc=Adr_MrwkTarFrUNPSzpt2E1FCisfLqV2SWkjwjEz_5k_J5lTyB2-efQRJffsDmq1ajQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApoQZ8DCvYiBqoXFhHG03vm7t6iZIN55_e87_qFB8FTQ&oe=6A6750EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbvVmP38YvsQ7kNvwGBOVXw&_nc_oc=AdqMA2D3BWUyf15jePaDes1jW5yi597lE_EbhiDTiAekYNBbckRizXdDu0qyfPZWBFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoHCcn0MLp1PaeBeKZ8Qr9foemf7TiFgjxjJIvMEtqJQ&oe=6A6758B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2QXwPfd4rYQ7kNvwEEr7ts&_nc_oc=AdrnHKyzy2Y48b5WmsZO0GJ8A6geKF5ZQQHrqaYG4622WSxZyFgFITAQNr5wv6Z7270&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr9uyFrflUABx3zxrZ0lvKuk0vXTu6qFFun5EY9DOl2w&oe=6A6748B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
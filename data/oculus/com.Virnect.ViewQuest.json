nt-ams2-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VABFbVWo8AQ7kNvwFp-7ef&_nc_oc=AdnKhaMc30IE5IYPA0P_kEQB9LH0FqRpsjOL1L7EBs-O2SHDzcAyxS107CaLjPHTzPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNGUga76bwGJT3gj0PEG9EdlKmxjOWw-98NkucEQoRCg&oe=699ED4AD"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ4vfaQoB3YQ7kNvwG8qC1j&_nc_oc=AdnfjIQ0AiswxNmG5VI99YZtgbogathZpshAePabk2zPhML09-nul64XH7l8WPWdXHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfteWRrtbrd7SMPRh2b5s1SdbAhRztEAlphZ6EbyryD7WQ&oe=699EECEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y91fwbtqQAQ7kNvwHX8pWH&_nc_oc=Adn4Om7GbnZY7ry5Y5SdLbkP5hE6HPFp4OhmDphpsofjchG3tHA_2r4Dqr8vyUMPRpA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftTNmWXePhOxJ6lAVRDLaU0jCEuTbfbfcz_ciISXn_LDQ&oe=699EF4B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvT3CGPd_Y8Q7kNvwH9DHFf&_nc_oc=AdkxyR_wXLWz9Q9O4grrZNnYxcrHsDNzwvFgIhJ1eYOULzCW840FBSRAVyc0_UpzW2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftchH2kXEzng-X8PnFY-DPPsBm4K8lXy8zydDTDrvj_aw&oe=699EE4B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}],
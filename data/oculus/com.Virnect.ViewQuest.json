_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgl8zXx5Jk0Q7kNvwFO1f2M&_nc_oc=Adrpt1P8uCMFCJOGBXhLynSD2dr81VI0p2DRrFTO2TrQTbJZxZeWhoajVirTb7S5Rtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZlWl6xqyoWc2Jr3qMTVMhShTO1AGD7-OeWSZJQa7ktA&oe=6ACE37DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2hSDvbrel0Q7kNvwHEmR6J&_nc_oc=AdqQc_CPC48lhiOFjyJXw7chPhaLCfgRrT9RkrzGSCpeWl7dbI1rwQmkFpBjOjHx8Zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN31TtKK-zyH0BM5BDCtFrOJ-YxMSOjpdE7lLep0YicBA&oe=6ACE45ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRdpnkq3RPwQ7kNvwEhXabn&_nc_oc=AdouykR3i31BT25pLUD6PVsjdPgmPbFVFfPLmIEvsT5zqRVYSDicV6Qa0mKkhUX6TQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIcdWgEKh79PHSuixkw-nciHD-e-yKUnUoT5or9yjStA&oe=6ACE5E2C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQJSJc8huToQ7kNvwEb8mzo&_nc_oc=Adpn-hT4352jii0PV0eZU6NRhjcYik9qKjSx9gVpn1-aMwgpYxZxM_SwUHQqcegAdeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwTjmbM1DXT_pl8XYLeVSVN_eNwMr-FZWYuXSEuGGw_A&oe=6ACE65F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0ORyqtE7PkQ7kNvwHv2HDg&_nc_oc=Adpxem4W0yytUcNd-jW-Htc0DiNEkkuvUDj7Vsa2U8EnomHZ_o9hiGBclI8UghE3x28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaOFflIxJJNqSJ6EETtqbg6b0tGVwkHTwvfnYud9W9mw&oe=6ACE55F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
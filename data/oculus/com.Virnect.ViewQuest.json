_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ecr6Jh5s-0Q7kNvwGEJDa1&_nc_oc=AdoBeqhNbbnlzbVtLraCxeOYzv88zcH38U8VD2ugS6CM9LMlgEmAJ5Kzpq5flwQVpuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDwFVMXvRdbn6hF1xay6OHxPFt9mhLLE9Z9qeT7uhVxA&oe=6A89719E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6shDQP_y2EkQ7kNvwEmvWLt&_nc_oc=AdrkmtTsOEFqHECiZ9G_zi_jnmltObbwK8LzlbHnjE8dM4XMuNLbfFgxZOb4rxlRZ2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-d3ZckXDO8MwBEIGo316YTy7QiWG1s0Ea9z2SHkbOeA&oe=6A897FAD"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mjmFa0agKEQ7kNvwEzx1zj&_nc_oc=Ado8E8wSQe2NYBLaA6KdyxFi99XcRhbH-clikUNqKV51nkoWWab0RtZ9Lc3DfZPiyrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4zz9dn32y8uifqUfxE6jnR6fk-m66QhS0vsYqKyYVLg&oe=6A8997EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO6c9FNjUhsQ7kNvwHOx2tC&_nc_oc=AdqJyFN34rNw4Lb9czHtG3DWXtYrC9pVlMBT_zoa_xBX65Qix5T2EaoTrLEsZOt40qA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Xk66DfJj0wD4dGiG77S857W_ZzeZdDf_eDgUUCSRTQ&oe=6A899FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyoEbAFINbUQ7kNvwFX5WUZ&_nc_oc=AdrnpPSoDpkDp6KanWzW9OQ_tYLUxpF0U3qXlDQRKU3FKQLOV7z5vAO8OXl_YAar_2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHqfSNFeNxDSCiN-fe8i0vbfmW87SOIkegnVZOGet3Xw&oe=6A898FB8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jq1HW1zeE4Q7kNvwFBu8RG&_nc_oc=AdpkUwjc5ipR12DOUikLHkZD7P4FOhfczrTj9RSRx3MB96nzC3Dwj8aWP2kA5m-Ki1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgnr9SmxZE8odYvUuMs6sy_kY-rOnfdhJVKGCPplvtNA&oe=6AB91FDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1LT74NR_9oQ7kNvwE3hugs&_nc_oc=Adqr0lyC__pfdvadm3GGw96ECOnS7S6zXHWIQ3zSfGgil5YWFs_x-KamuEnRnfYqYuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdFNRlsYmIZVqzx6kq-z7CwS-q5M0Kda9dI37UaHwjNw&oe=6AB92DED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh4i6YalYcEQ7kNvwFCEG10&_nc_oc=Adpu3E2iwgBRc5i1TW9ipQbUNWWNykkszCl32Xb98rA0153ogaehwbSDBSyDMRgT9D8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFsMuWheKleiaYa5ByyAJSENGzk0YSGS3jiQCCschjaA&oe=6AB90DEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_xwD9UaVVwQ7kNvwGsXL61&_nc_oc=AdryWC1wX8Hsia67KypBNQCh1ezASkZU-uDtfxQGw3hLDlILlCz801EeGUnRgQhBmRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzYmxjjAKLAbazXyJIBre5mEYb9TfaGMQruOZ5-Dtwsw&oe=6AB915B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTjTITjYL70Q7kNvwEIgCSm&_nc_oc=Ado4Lula-XOskiswRHslI8vpsxev7Ufm1L2U6RFtBE2ZPb3dtS8Pz_X5vR5dAG78FOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpJm18uG2LpkMyzK4fODVk8XAn6EfXxIxjmvGfBMIf5g&oe=6AB93DF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
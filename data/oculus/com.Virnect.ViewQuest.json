_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqoih5xAFpMQ7kNvwFceHkm&_nc_oc=AdrnOVJUboDZ33va1Anli9CVP4Kivat8e1a_WTcD5_Eoe-FEPb6HUn7s83nnUTl3Fcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbyGYtyqtcy3KngUOHzGt6EcmtNOhv7sC4THet4HeUmw&oe=6AA6AADE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoKsxm8zrj8Q7kNvwHyFOf4&_nc_oc=Adok3lhEsnt2KZe5Hj-GDCmXjvcuhstfbMDWFHYXvg1EPnTp_ApTuRYLuDRe4Q8Xml0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd797MwNb8LmNe3knkDUl-zersS2VXTethP5Ckq8Im3w&oe=6AA6B8ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5uYcqfWl6YQ7kNvwGFTDue&_nc_oc=AdqpVng7wxcBqiT52cuVGy6Qqz73Zml5GIfSW92GZ_a_H7-_IK2ytbmTIjhHHNxEJKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9dFApK0CrD9vC4Utq-YwjJMoy5EHXThxO0WV7BoGH5Q&oe=6AA698EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oalIADPrbrAQ7kNvwFYr3a8&_nc_oc=AdqlGhHmDK4oybi3SeanFo7_zTqHzaAJXexsQv9FVC0KvZ5tF2MQEellw12s-veKCGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsJCIeYiYfivbiSygZIT47WbhISsrKOZ160oUe5C-sQg&oe=6AA6A0B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXDw7G0fGtwQ7kNvwFX02h9&_nc_oc=AdpLIXr5k7t3ekTs6GNSJNuQ8qJnjZcyeDSeQMaD5vqd6ZmoGlTNIkXbidXHgbGQwec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgfMLi4YIjT91eCo61OnbOMWejeNCQsF0FAK26L1z0VA&oe=6AA6C8F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
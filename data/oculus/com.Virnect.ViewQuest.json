_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MIcgyEKv9sQ7kNvwHgNq6p&_nc_oc=Adq-M2PkipFTUF_oRhBMf74Hp0pIejCImJk1o1DmOVTvZ3sx4EJvqOfXIu7Treq3Dus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_iUsmXUt-VVSNenLyZuiFye1Xdwvb96OKA78JCxCmlQ&oe=6AE9E75E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZuJZ9SHZsIQ7kNvwEOmYIC&_nc_oc=AdpzCMLSPn8SvB2hx-31w03vhfuacenwoZVCoRsUp2tq7M3cM87EY5SxAPX_57uZKwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcOI7fv-2Be7wMvGjcTHbeCJ5ySNRwQhQ6PFGDRCe2Nw&oe=6AE9F56D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly6CZJtdfdwQ7kNvwFIxS_k&_nc_oc=AdpKfs69BsCh-u-p_vChlAJneeDKBr9S7GeakfxJdEx_k8AqTc46Um-NDR7pUwqZXQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyUE7onarlfwSC47VpFS-wUu_Z_FfJ8rscFX6hEJfTsA&oe=6AEA0DAC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os6l9yXk7ZoQ7kNvwHydnwx&_nc_oc=AdoSX4LzIKA00wygCfhxBDxtFsvVlodJfdngwzmW-AAOQcVIl6Mdzp2k3mGdZnJmqTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9xT_1Uc2apjffpjmwf6a_SPugdARstrCGEPjUxGCtCg&oe=6AEA1574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xEcyHxhseIQ7kNvwH8H89Z&_nc_oc=Adpi8VNWxQtbSHSvnbQ2UHQytv2g_oZ-F_kNSfytY2fg26DATlRn-9rpdPF-piVxG4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT782sqvNCqpd7uroIaHamcMOlvSeruSLLvsytO6WOTjg&oe=6AEA0578"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmcdjnXgoGYQ7kNvwEuPzXR&_nc_oc=Adotxmg9Hyhq6jxWRXMAIWi97upqLjQNz6qtHkHV8KKeggrvT_5nc9qIUFeIik6bb8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPFXBkg7LwPxKgS3K684zrO_zWV_4wLxhyPYNURc0OKg&oe=6AE1FE5E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcLH2SN23UEQ7kNvwGwGrHg&_nc_oc=Adrg3wnDoi_tZ7wQNjv9C0i-pBIcIstvX-rvLTPIPpGo7Q3pkHi6T560vfDWrfANtJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb-w_LVVZQmrXvZC1IGX9xnZjug184LgUbP-vdxZtPQg&oe=6AE20C6D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCQnEXucIZoQ7kNvwHVTmAt&_nc_oc=AdrMJMxY9xRk0xdr5Rj9pWpsvo7S5bUMF1SkXoqaj5AY0UidwiljYl6wy0qoIHES8FE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIbjAhbEFqSDpBvLB4VcEsLcqNxK_QP-jTLlrSVoS3zw&oe=6AE1EC6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk-6vjDpfJ4Q7kNvwFl8QpQ&_nc_oc=AdoSHdrucn6otGBSRVxqCT-IwuWToAcMUq_bZSk0JiDI0Gx_NyBfKC6J-qDdemO3ZZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXamft7DceIRW4i71ly_xVEbOnh9L4oS1weYcyV271ig&oe=6AE1F434"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSHCqVCArPMQ7kNvwFMgtBT&_nc_oc=AdrdXUwJfXD_ZCEhYrbxo9rdX2Igjx9UdGzI8Yh2DReWIfu8eMUpAzCGgKwErfGJGv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6bOKjOwUGO5vqVdIP39498ZmxHgEGVFoLGjxPpsgu7w&oe=6AE21C78"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
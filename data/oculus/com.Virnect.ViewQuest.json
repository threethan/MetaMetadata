_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faK0gTI-DrAQ7kNvwGn31i2&_nc_oc=AdohDdusb_GoM_nheu_IXW_kuC8d0653wDP0fkfNw_VLGoSf47mPj2sLd10zDiMMNig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLF6i71a-1n4ux7a_vgHo3PG-CvEPiZ0-6uHgXcuXvHw&oe=6AB2885E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD54M6mCHDYQ7kNvwHoaqHg&_nc_oc=AdrlNZJw7EfmOQqgpnXiDTS4TDEvUbjBSAAlwtM0wyWEJmEmkUAkCqL7AzPWjU1F3_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrOBNfGLvfqrU1TyejgYiyHT-hL49ydIYuB8pc9k3Prw&oe=6AB2966D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn_xZjphWJkQ7kNvwEoUFY6&_nc_oc=AdpjH84pnIvd_2AJFzI-P4Sm7ie67vbYca18NDYRbLhAZjTWr4SmjTgUDQbkvieVjLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0jGCP7OJooR2od0CkBmn-wYzQwJnZJeLiQIemUakklw&oe=6AB2766C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gVxPrQEVmcQ7kNvwEFlIT3&_nc_oc=AdrDWUt8cYv14aMHPtIPu4On0WJphxTWRx7tcnQPw6_esYoicVkMV9FmKaLfBHWBwKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSND6e5LkaRBTd7bi-MltDCJYPXhuDvK-1Gx2QUHM7Nw&oe=6AB27E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzb8OLfDI-YQ7kNvwHo4s6H&_nc_oc=Ado14R9f0gSsvm9CiQF7UamO7K3MD5fBnifZUBlydyLBkSgswi68J06namz54i8ufpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcDBHPyd07r8cDdzxkkEC6dHPhnHC0Dg-Ki26JnvMBAg&oe=6AB2A678"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
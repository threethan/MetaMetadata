_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqZiwH9nhh0Q7kNvwHTSpd5&_nc_oc=AdoAL5RWKYNr6IVnVxMsaVqlpF7Z7Ats5qcwWUfF21MSO2z320A_pyXeYjvzUeQjGKI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaEbJzuxZT9aha3WKsc62tJjXojroQrfgJ92nUyNu_rw&oe=6A73405E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dty1IxuFSs0Q7kNvwEKkfwz&_nc_oc=AdqjS4n3HtUywz5XodqySuHtte1smfkE4k0w5vgVo28sdLjU5GaC4KZfcotmtqaXMy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE87G5dgnfFTOEAnIeO40lsXFOxu3zKwsfbtAe9in1ug&oe=6A734E6D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieXIfxnxUXIQ7kNvwF4obaT&_nc_oc=AdrDFBeaxGMdTCNGTzbmFb1IXI8bIRyRKkHsOHlPzoFHQ4u_z59fuKYk9Nu8fYOvH_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFZ87134cTA8jsXaY25Wy7s_UA7JcLlbfGpI946raB4Q&oe=6A732E6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cw3VS8vn1N0Q7kNvwHrpqMq&_nc_oc=AdpE_e_dJ6TMmKeJFTXQvusyuqqg4UiM2sY-juWHvQl7hwPz0cme1JNYjhU_a0PEcu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5ob92NaFnsAQp21wsnUcUD8ssq5NMg4cBOZsDSuaHrw&oe=6A733634"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMbwjQ0dGnwQ7kNvwG55Old&_nc_oc=Adr40z0KtacVnqT5DNiEs-FTZh4GDmwwWPgMdQOACUM1JeBu1DnzdjZcXbYVcWxDwVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYzgkfu6mUEn0cVECzBbYHD8EMljxCmWMKwJ0S7xc5fw&oe=6A732638"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
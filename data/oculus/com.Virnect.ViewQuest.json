yM_pHkUHcdFnWwEnScGYx_7Z03ddu2PGQvoA6YN12L8Vp-bg99kFFEza1EA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vkx1WpIJMbN3nSDhmVfCvVzFsrX6VYF3xVZiqf6JbYA&oe=6A0B19DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJjR794vF70Q7kNvwFBUYGd&_nc_oc=Adq6YSI1CGYqx3OkLdKrND1-vqysO4J0IOHx_vS69WFbt3hsOiJcVkiM94uZJ6OeNp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T38TgK58dlerIskP3DHtLGjBLjEKhLoWgXjhfTd1C2w&oe=6A0B27ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNkeEeOLOmIQ7kNvwEE6vPz&_nc_oc=AdoOZS1MZk8sCAOJVp0-OL5gilLRWdOXahxHxGe7diBKsT8xN2BL6bKk5jHGL0DBU-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dNwrTQJFlOvIPwtDQwWsF0hPps9a3QvPeZys5XrO1fQ&oe=6A0B07EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dapMG2zEC1kQ7kNvwERMGAM&_nc_oc=AdqnSsri9XhfNvD0sVJ76i7eoyaMyUPFsgZdXJ2SwF-W6SMOQa1RGaEXPQWZC1ELQoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V9a8hpS0t_WZ4pwjbyRkPERoSI9AC1pMOWTbfEYj45A&oe=6A0B0FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMoa7ZOez9sQ7kNvwE2kdvj&_nc_oc=AdqmncBca5TxNtovGo_vthAE43EU09Geq9yQiZ2ZpKZ9hwtOfeFJd_YVc27mL1BzfCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-GYn95Yw99lNwONIqsi6_cBu11P6O4vV7dTCBGRuOjg&oe=6A0AFFB8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcbPrndpGkEQ7kNvwEVD30f&_nc_oc=AdrpjV2yBnGbR-p3FYjmST5loy86K6J99gDbxH1e18JPcdchrYT9CRzsTqeXKW0NWvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0_8O6gk1S2V2Bx0w1SrW4xcfoHp0A3CGcswNwm9cQcg&oe=6A37ECDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgNZ75tJLyQQ7kNvwH8AQhy&_nc_oc=AdoYHquVG4KL8y7qTQX0sluLxa7nfvzEnCg1bY30wRTkgD8E_rU68AfoFNrD4PJSqLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90-fFuVTLe66QOsYuq3CFCE_iLX2XWtPJ79vtNT4DGIw&oe=6A37FAED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOofWMDoh3kQ7kNvwE212c0&_nc_oc=Adr_tY8SyX1EG46fkOk6L5xW6DcKJCbdaoUgrjnf7Bw2QFE8FDm35WHbR_H4gmJcDFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M5XU4ZSEcGkCe2HPapaNtGN5Q67Wudv5pXa3FJInzrw&oe=6A38132C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGlnpJL6hKYQ7kNvwEjcq5T&_nc_oc=Adq9mwZoR1xbnLKxiCFxITA2ST1550hpHZtckOQZHXKB8nQByGPfv9HQMssZOGkTL54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vCbjtPStE-ZidDxErEVL6f-W-9h1prLUCWa1GbE4PQQ&oe=6A37E2B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrC85yfJ3wMQ7kNvwFa6kON&_nc_oc=AdrMhKs-LJwsdxBGaIEe8XYYd8e1LUzZGcBZ3s9fR9bZIgxriTLYdVbKkiWyim6BSsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zO2_XMTotwvxvkhrwzn89iR9SqW15kEpE_aW3m3kPfw&oe=6A380AF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
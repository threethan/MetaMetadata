_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L23XelKXZSQQ7kNvwH0YAS2&_nc_oc=AdrLFFPx0d7NRUY7fsDj9RNPyTp_UTim1htwIjuGpuQoP4JptvU3iBl5_6H0zIKPzqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nCcIHfIvgrDiNG6IrCH-6z8bsXMbiZD4_BsnV6-o1_w&oe=6A14545E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBxJE7D1skoQ7kNvwGs0eGS&_nc_oc=AdqzJHXwDomRJ_MP_daB1iJhOADUOXk2gKNuS_hitsLEB1w7-ldtsoEjSJ_6Gtd_YOU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RiweoN90asxIkd6W8KatTiihqJf_JEfKbcXh3we5MYw&oe=6A14626D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIe8wn8mb_cQ7kNvwG29pg1&_nc_oc=Ado1Yb9d-RT2lLEvg9iSpV27YTn2Jlxm6dec9AblqPII1Zd93ekdZzE3mdRBTIbjfIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pDHAhvE5ubRlxcgLlr_fUisomxdXCOkLj9Xi4mXLb_g&oe=6A14426C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGW8-2-rPQ0Q7kNvwEsK7XX&_nc_oc=AdqHCCFjDX0uxj3Qph6WHReg7l0ROhr57WJ7uNCl-RT9SqalItklAPsYbFF_X-fam6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wQ_7xXLZnbzYHTKpZj_eHyAonzvR-WeG0h_BY4eWr0Q&oe=6A144A34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2r0wx-GiUAQ7kNvwEfyf89&_nc_oc=AdrZ_AoOjncnSeD2kaMxmGBNt2gRpcy1lQYBnuxq6vAeuSiX0-o9SlEDuzODh7c-NIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SDWe0Vmdri_sSAz2YyHsN4jFjg6KFqMcVefCEE8V1QA&oe=6A147278"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
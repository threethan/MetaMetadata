1GK79ZrqbIy9uMylSNJYt7rfwNSALwduYVVCQ93X1MXGWV54hS7uwsiIsbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1nq6F7CtmiAke2DwA_P-ecSnvCZ5MwUHh6JzcR_lUIA&oe=69CD235E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGM78xXHpn4Q7kNvwGgJyly&_nc_oc=AdpRyq_IiI1jeC5cGaPLNUnd86uzMU0h0UcrCQPwibW0dOh8c2jW9MCY06QhFL5UoMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1jYW811R6OymxF06E9TppPu2KqYJiXipYM0l6FoQF3Q&oe=69CCF92D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CI1Lt3JQYsQ7kNvwHMAlUv&_nc_oc=AdoeYdA3H7jhG3PeBQEzqrXRB2PBzvxVxdxRlxC8cx2vlY1p0pIBHW7UuoT5jrAXMMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4_4xCxnnijt0aJLYniiXuMgjctUXNYvoIhugYbafalA&oe=69CD116C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4Fs-AH9FpsQ7kNvwEZAucK&_nc_oc=Adp7C6w-hl1sH0lILwoVzT7gR3mekqnnTYzkqi48uQT5OU3pIrMo8JTCETTQa4wOxDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOsyZ2ELAwCmDqVvLrCfNO7R2Q4xL-Q9FKQIRcToKVjA&oe=69CD1934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2cg7g-L3KoQ7kNvwHptPoL&_nc_oc=AdpXaeSvPyW1TjqBEEaQLy9rwEPBuSMIVoihfzOvnbywrR82OTCLbX8IwgfbMMqHcU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVurk70J7cPU4qJ7497fhkYNz-wvDK4lNNtaHj105ToA&oe=69CD0938"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
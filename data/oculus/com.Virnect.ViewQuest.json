scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9eqxHdiEbS8vSx6RrI24J_ZLcnaJnIAKvjjNKZBQpSw&oe=69C145DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRIvUc-Bt_EQ7kNvwEAIkA2&_nc_oc=Adp50GIZe2FpJuQTjCoWyIMAEBcrnYd-csr68PICBDhmaw_VTwVOv3iP_j-A42kC8oE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyEgPZy3L7IUxMH6Ar8hjl19QuRyPs7LWKXk5JGtka_w&oe=69C11BAD"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3xVUPykhvkQ7kNvwH4fqkV&_nc_oc=AdpOoANYyTxXjHrRdM753nPrMPFmkgwdJ8Pg7VdxM4LbBLc8sapQveQ2eM-vApbi7zM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5G_lyAyH9odNMJNq0Wck_hcyQrnosoGLxJJUSfjOgfg&oe=69C133EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyH_o5AO0B8Q7kNvwFEYSGm&_nc_oc=AdpN-3uGzPN6seSd-MR7JWieZmKE7YraJowT6bwQ8glGXkvMnSDuVExuMlQ7cr8YDG8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyo_PCjk4wDF4HCqR6_FsXGvkdEqtMsZ3zZhkyUJ1SwXg&oe=69C13BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cESYZzBCewAQ7kNvwELmP3J&_nc_oc=AdpQdJooiU5UZCXAUfvhHONmqCQ8v0g2BFUgpuVkIQMhxiKSN4raPZYsPEc5OqMZ7Xc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9CWrtSxQbm56Tkj5IIZ4wQRPJudEaVD0BAESqVPKo1Q&oe=69C12BB8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMF
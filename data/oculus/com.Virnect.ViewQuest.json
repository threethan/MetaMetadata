_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkszJ14ZCLwQ7kNvwGLNR7I&_nc_oc=AdqtrZRIzgB92raVTDgC9BliglWFxUQeu4BMIJx3cXJd7cNz-cSs84cGDctZ0nkf-vA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHNLvyuSqkxTuFQaL2BUsW4PWUrqBiUeXKVPEpC6B6sA&oe=6AC3ABDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e4Hw4x9N6gQ7kNvwHUj20c&_nc_oc=AdqxsfL7AFHTa3VC-ZuSVFgZ8s239nGLfSs-1FdGc0k3kcLj4_0eFAxpo6UkAIq1-Cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9_Kd_l8xUwgmPi3bwQ4WfyCTwui91jPSvhL2RlY2n8g&oe=6AC3B9ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D32UIX9XMx0Q7kNvwEiuxil&_nc_oc=AdqrruqsRLcuVHNQrFBsH5jiIGZ_0z5jMJQHro-xzjyFzitiwf-rQaoaexHe19jvHmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPArgRZTEVM-vF3RfbLfhreC49LohK4B9za00ilmfKLw&oe=6AC3D22C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-zNuMsepNwQ7kNvwEDsjCo&_nc_oc=AdrQN7G2Ksf4n2ttXcuQgldK4ddFG9mJKTtl12HSL_G56hyQOw7USRdMdNaPAocnTzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyH8vHiDXmKroZelTyUWPZjHKbt00ZTmLlmcXsxNrvzA&oe=6AC3D9F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwJrA9a46A8Q7kNvwE5I-eA&_nc_oc=Adr_iMv3Jx3DxrA7Cj81E7wTyYe7WUTEkfbjX5j4vNnwu-h9d_BSFeVpq2gzGEoz6hM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOETVJa6w4JjaoMx4O-nBkMZNBEiaZD5UiB1AgxmyaxUQ&oe=6AC3C9F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
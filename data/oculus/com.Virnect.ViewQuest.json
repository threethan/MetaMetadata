I4l0hG6T7JNYNwkq67k7bkGjZheKOgUZ4SGPjYeGOuuelw05TOL3N3_X0Bw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1axsK01GJ9p6A6kOc0IW4m2TcQVorvkv5ZQrRCR378yw&oe=69E8D2DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNHsBlAks8IQ7kNvwFft8Bf&_nc_oc=AdqWs2JedMNZhf3P6Ccrvv_OQ1j90MEjFH-GjiRKK7-AN-dNaBspVKIlcnmLG3N94Xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27T0-fZ9lp2pAv7IxgoqrbtZY3fuvKS_tyILdhb2m50g&oe=69E8E0ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obxtVptDk0IQ7kNvwGsZ8V7&_nc_oc=AdoNFn7ut1OJvio9ppQPyQ3d5aRr39S39zr3lgIvqVfNzyMMKXxi7Sp5UjQSdz-Euw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sgaawFZpsT4Ni_uAdKLr6rErDEGFoQTXeuPv-e0Jz2Q&oe=69E8C0EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHuqSZ7Mi2kQ7kNvwHTNhuj&_nc_oc=AdqZNRpNtdz7Uie143rl9dBi_wCmOlIDFaZ7EASj1zMNQYCQyZOLOQiYSkEJYZN3PV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BldPtq61VCKG-4aZmr58bjKP0zKLP-IUK478Oo1dRog&oe=69E8C8B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lzqkcLdj2UQ7kNvwFbjJKo&_nc_oc=Adof0DEKOstopfHP0iJID3nykg72NgHn_PIhfcFyr_VetQRzH-6q3Wufa4bwSfxetXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01ZArhDGcQAmuF-Kz8zDgknk5R3mt8OunTyTuiCNOIyg&oe=69E8B8B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
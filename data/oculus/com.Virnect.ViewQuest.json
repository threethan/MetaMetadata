3q4ErsHsF-NYn9URKgw0cqoCdR5pF5nhxG_kFUpdYhXf2A8Uv79yco4uExE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCuvXC26AfzcBnJJ61ww79nNnuJzqxXwkEsnWwOlvSkg&oe=69C68BDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St1ktPWUwtkQ7kNvwE2qQ0W&_nc_oc=Adob7G2VF1MUt7YuFlEaAnuoezZNTSBhyJfULc1i90Zwwufv9VYvnN452gmuXYCBOzU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRHnxQQw9F4L04rOubX8rX-921jH0KvJTJ3c3QIZ1Z5g&oe=69C661AD"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4s2BMlmHA8Q7kNvwGEkTc0&_nc_oc=AdoUn0XmnNBXLYyaETjrU-GIcR74w7_61IAvA0QhTOZxwCRPwchHsPNZ6D2ulGYXyQs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxj7xm1NsvnwAtxW7KNSzIhMdl2N-h8uhd0sWUCsQ5pQA&oe=69C679EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SZVR-jV-5wQ7kNvwHSY9R1&_nc_oc=AdroId7sxgGSA9tp3YttInOO_K5l7Nld-a_tY2gGVRQmYM_mYI41AiuMGFjeAgmvESE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxh8CjbQ6rUTPN_Tx1XH5cUMeMWQTViGvO8dedMHog9eQ&oe=69C681B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUAJtAyaR60Q7kNvwFU8l7O&_nc_oc=AdoB9bA77Sl0j2YAcmZyDxXv_uNrHiZspkYK0E7qZr1o_6qaeC5Y0d3oFZ-dz4bkrqs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_mST5rA7OCy1hLppQsBdA_S9klYnGawyFbrSXouA_rA&oe=69C671B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
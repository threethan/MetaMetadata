mn3RF4iwBz805crPMg1rsnoEnw4o7cgKtA2MK05y1CVLClBxfQ4vhPvYg7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03lalxF8TADkLhT0gELR90Ac_1r4Q2WJpCiHvVum0Slg&oe=69DBA3DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDSNTdKfRfYQ7kNvwFfQHDD&_nc_oc=AdpoS7QZM1OSE4OQyJMqTv-dTfsGIffzZK0M5G_dwKvrq1deJe-Xd2f0aAY2a8QOgAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uKwNSDuycs4x1Y9Fh2QqDKOG9QCKoCmRrhn8y_xeONQ&oe=69DB79AD"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0RpX5QRkRoQ7kNvwHQlx4d&_nc_oc=AdonJDGU8eHIVkUwr-HfILfZYsJnSkqPmqBnz-4IaXg94TlJTaTksF0LfEFj6k8DVoc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ht2QOoV3WeVxnjdupLR1uNsj_sULt3X8tjjxPpsVy1w&oe=69DB91EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsUnAzV2JCAQ7kNvwE2-Phk&_nc_oc=AdqoHN6OEtd6GkhtwXqkMWqAjcxZGpkNR6KeBH3ICYJICUSZ9b3fJMZITobbmrLUvUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cIzPy-dNO2WEWslcb3hMmEET273N_pG77j5FdzPNCNA&oe=69DB99B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVdopePAivQQ7kNvwHRQA9d&_nc_oc=Adq4QGE30qZwtqkyLca0Ql2oq8DgVtA04ZO4eS06nz75Exz1OO3QBaUTVm20oxWakik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AMUvFsaxHNr4jiWjLAEdJZ9gNP5-bhXmM8cIR4PAqQg&oe=69DB89B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
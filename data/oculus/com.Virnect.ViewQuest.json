_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEig367KOyIQ7kNvwFDLeA-&_nc_oc=AdoOzS4uMl6Dfe8_aouQ9uLJaagajtl4GsysTHiaoopPviN8FcMOFQz_2xRDS6r52YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ug2x7aNISUmTl4yqyukKw1rs7SaMjLej5ddGwYXr_tw&oe=6A2D60DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzOIyz6jJ5kQ7kNvwH07sit&_nc_oc=AdpwgqB_XSlQI_tmIftIMnt6PzYMOegPWZHlfBcFyGPHCRLt3baa3ISbEU2Zb3Nx05k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jMzeaCrSLhS5W6htbm2kaDBFKWPLOXVrhPfJgFbzUXg&oe=6A2D6EED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFP4GgmqfUYQ7kNvwFehTKN&_nc_oc=Adoyfxw9AoDFRgXWbLUQOWrjshfO4M4L2ld_Rf8CEa4SjuiiNZGQShMwg9SaUtcFoKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QPvJHfk429D9spq1q9OLJV9dgMO45FiDzVuhmBYbN-w&oe=6A2D4EEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIBTwJjma9YQ7kNvwEadzV9&_nc_oc=AdrzWoXamn7blyRHfKK9JfdTmHqtFpIhEESzCnsR-e1_vYM6aVNMnd6tRQ7Kom61ohk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gnDJ9TxGmb2yxhHOk0FEl5XLOIvaUjhUoNWfDnR5cpA&oe=6A2D56B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfy5jWoKDOkQ7kNvwFQUCt5&_nc_oc=AdrLTyJFf_RbYiIZqFmYhJ-tbbsGvBaQg1PXR3C-y1M7th8-xhE-gSQ9UoXuzywMiLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JW6NkHf5km-NcES5KePFUywAiCeMf3ERE0086tJsSWA&oe=6A2D7EF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
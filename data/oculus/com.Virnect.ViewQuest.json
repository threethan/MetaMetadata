_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILMQzJXK3lMQ7kNvwEfYlyN&_nc_oc=AdrCTwseV_97Y06Xuj1r0jUsL7daDW-R1lDm3dEsR4fFdOyXJTViS8zsjYewSzLI6J8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ3-iqQj-5Y3sl5iyRgO6JYOQs5PwZ1gRScPoonXCwdA&oe=6ABBC2DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTiapM2jWjEQ7kNvwGJ3GB8&_nc_oc=AdoH7DFRRMLNjsbBuWR59BSg2azKs4QiB4BamArvOJ7EphPa4FVcj2d5zKLxHq3VWgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ45nnfLI7RtR7YHucz-fN0txxD9lfaqE_-P0eQ4LUM6A&oe=6ABBD0ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfA7eY1YC6cQ7kNvwHDYMZD&_nc_oc=AdreLABU9C8kalCGYKZUOZH-C5GX-xwrTZym6jRvgBXwXyT19AQkZZelLIJVfUcFENY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEmO2WNEalrgGlFXv7vqtZG-iRMG0J1vi4a735JC02Ig&oe=6ABBB0EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_xwD9UaVVwQ7kNvwF479kS&_nc_oc=Adr0AfZEFT-0XAdlKItPGqGqZ4fOSu7QYT-_cTj7SDRFUeJvNK-iU9rSu35Lvm9I95c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4A33n1cJIVInrdh7zGWkS0goW5uWBqbssZdiylSUOpg&oe=6ABBB8B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0ZRrrxo1h0Q7kNvwHaF-wf&_nc_oc=AdrWvP-SVIudKXRAcXUwHrehNYvy8qdGzu8adgY3p99Sk4SSkUCqdYAQqvoFB-zeldw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbYgw5v4IPAOm3zT-eDIdppcg7AbeK9LRgh2VcaPpgvw&oe=6ABBE0F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
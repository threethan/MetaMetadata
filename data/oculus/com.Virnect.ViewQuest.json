3gRnrgVjP73SdaeYX7sh8KGXXnehBZvpXCQzPti9_oOEQZlDjWngCTtj-hE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q1SSYrISwZRbJmdmEbiiENykd3UdPTHTYABD9cxZsbg&oe=69E7815E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNHsBlAks8IQ7kNvwHLM4S7&_nc_oc=AdpWQ2mCCS9wH3p-g5ydX6QjU-m0gesIZFwY0IdXdhcnmidYITRrxKOtWtM8Wob2bEk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HijKd5co-T9v7kZEurUqxnuOLxS00HaTtdFoDKpE4bQ&oe=69E78F6D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obxtVptDk0IQ7kNvwHwH0oN&_nc_oc=AdrSTS_s8yq0wH2wXJq8ALF7gAPJftuCDYr6FFdmqwARyqwY4m2Dv800DQGjRsXEHUI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OcRVwdIX3dR4RbYAmDZGO7fEJ3Dxn_AaCv5DeZKi6Sw&oe=69E76F6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHuqSZ7Mi2kQ7kNvwEGnSzV&_nc_oc=AdqKgd079O-UWyBpyXG08cKH98jXO8Vhqirp6JuSHTliVpLazXPEalNcn_rTcOG-yUk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qd6VhMiivKvg7xRbJ8tYFz13BgzwRyrqycQ6DfZ5QlA&oe=69E77734"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBO9AbIEF84Q7kNvwFO2-oR&_nc_oc=AdpRrN0F-cKGQGri7KV-ypBfdw0sT5bvG4JkwxWVmv8Bu34GphhOIM4GMl0rWSDbRJI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dknvzUJOxOwKGWtyf-rr5ALwUCh3shkmpgfdWU1PNsA&oe=69E76738"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
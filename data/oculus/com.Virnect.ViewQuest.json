_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILMQzJXK3lMQ7kNvwFla_Ea&_nc_oc=Adpf970dsC163yYwB71V5qCDG5DjzMihyEYLFM8l485rb1t4evPTAHDltX3IaHP-aDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcX9lOZf2nsJTjVCj7s6kSg1y4Sd2ybHL0OBuNNw6JbQ&oe=6ABA715E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1LT74NR_9oQ7kNvwE9tMiF&_nc_oc=AdpQ-GfOzwqOK8M9rxdJ87pdojoqwVKceoEuTEGhoUSryPwhWXW093jcIesDXpSgX9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8hwSdcwo1VT3zvld9acLGyNoTReEgHD2-CCTEO_YpYA&oe=6ABA7F6D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh4i6YalYcEQ7kNvwE8XoZ4&_nc_oc=Adoz3RTPLtUUFrHWaJBqQwQd0FqTPBHhWCKKcb_Lj59DLhK3rSVIaYeRWlxhlxxByfs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSjZQvBWgQ8VQIZ9O_-stIxbFSRhV8ny1weahwFfxYiQ&oe=6ABA5F6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_xwD9UaVVwQ7kNvwGjZy1f&_nc_oc=Adp5qXGjyMms-yclA8j3U_jubvqG3Boh9_D6rcNDdU1G8BCCdyZJ1pLplihSUmG6SDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaKjlRrEQNVH6MMCmKN_ttAFUYOUDH12QvMW90SqM74g&oe=6ABA6734"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0ZRrrxo1h0Q7kNvwHNzNwV&_nc_oc=AdoB1svvpLUxmcRI1xrKcABNbRXVDRFXS6Esi_D4uGtaMH8fjdezCA4MMCCA4pp9bHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF4GhU9Ouwrt5NMrgf_dkAKzzdZ6qf7gteELpC37_BBQ&oe=6ABA8F78"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
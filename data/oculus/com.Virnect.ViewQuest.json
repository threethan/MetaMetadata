_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqlVlFfdHGQQ7kNvwH9rcu6&_nc_oc=AdqXQ2fnAZD9lD15tUIWeGlw29DEPbkNoCoA4ntsInOEeHnopYmsJelETmGC5U04l58&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H_5erzlYYB5rBQVwdo5G4fKzMgaC6OuVWov3vpqkU1A&oe=6A3003DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzOIyz6jJ5kQ7kNvwHu8eb0&_nc_oc=AdpiKIoG7tAejP9vwhXjksaoBq1NfW8BTZ_4ECgTeZ3liXLBQGk90vLnSq5RqUPKKLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ayr-4gYLuasck169iCCCIDCo8lM4fvbbHTll5vlY7HQ&oe=6A3011ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFP4GgmqfUYQ7kNvwEuh4UI&_nc_oc=Adr19j-xZgoJ-0iuOJD0JFWAisHs9jArGl3ji1TIVEIanlZEe-7Fjj-o2igOIDui_NU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-feifq3LQwULypBOKWKM9kpFZY0d3WNNsnWI7l6zMWSQ&oe=6A2FF1EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPUZGVi18QMQ7kNvwEd5T9p&_nc_oc=AdqaPVZWl61fYfIqtnjxXtga3y-Yd6_3fuUgPUpWprYg-CDw9U5ZZAsPo5hbuP1dlkA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c_YDmZ9pqU0psSp7iSH7-i4TW3y5SAaD0zBf0oyCA1Q&oe=6A2FF9B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpFgjuheXy4Q7kNvwH-0msr&_nc_oc=AdpTx0XCrzUcDSllVk6tZ_SgE8hvQoZlOUYK0STEZrn4IVOEzb2oTQWm57Xd9VM1YZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fDGs31uqyPB2m9P6P6xZkrtEJH4wrgPgQ3eI9HhuMlg&oe=6A3021F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
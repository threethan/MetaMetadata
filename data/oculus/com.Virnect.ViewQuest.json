_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZVoWaNl-AkQ7kNvwHl15Xw&_nc_oc=Adqx_-_mLuM8OQv4smSVKGXZhemQ973uEFHHsbYL9hZwTi7S6iDv49N3aGbjdiSIdzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1W2Y1pNWskQUd_BaxtYpbPY26E4wXllyhoX7b1c1HNg&oe=6A54EDDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gMeijjiktcQ7kNvwHhs_E0&_nc_oc=AdqZ06JGFSELLiAOu2qb-kT-CLf0SEt-bBK05f4PhGgc7PEpNieW60oKTcfvjVf7HIM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA64go2tCbnIlp3V50yMyWl8-H1tWe92ySe5NlFNi_2OQ&oe=6A54FBED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDrMeKnpenYQ7kNvwEEUk4X&_nc_oc=AdpbAv1PSSOW3bteVqa3sdLKX6tsyzlVMCZTCCaRtVXZOJPr_gvSlZ3_GnY4BfKMvtM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC01X4Yxw_7o9Fc5C8M9RkpHJLyDZma5EumgYUaKf8vYg&oe=6A54DBEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSEXLmf07yUQ7kNvwEb8Okp&_nc_oc=Adq6CEgMvduSBk_XTgZzGdRaQrQLkQ1jkNZorpc8HyuomNVQ8ztWBwTZD21NGSgjE_U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeeZ8e5zmTdzRNA4mfPHA6bZsxZgzqt-Vi7IGfWrkaFA&oe=6A54E3B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5RLtkTJGLUQ7kNvwFw8ykI&_nc_oc=AdrTjZmE9zNrbOkx--G7RAjz7HXmYCv6eQi0P6NTmQjlXgzKjNUqdwryaCIaoenLwDY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATmIiyEe5X8IrwbOCZVOMaLOUmBSy9Q3yQtS7JSlh3FA&oe=6A54D3B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
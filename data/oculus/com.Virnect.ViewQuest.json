_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWoG8DvWN7sQ7kNvwGW1Z2R&_nc_oc=Adq0QMpz9zUwMDGP_SZuY8FdPNL46QhywlmMr7vdGsw0Dc-03E-Wl35JO9kf8wo9sVk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPtq8ssyAZEJJIRtxSESJDmE_76uR5_g8avybo_XZUCA&oe=6A71EEDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dty1IxuFSs0Q7kNvwF1EOEB&_nc_oc=Adp7CGF_dUZIn3Wno8xZhaU8XIYM1jEbgZDlH0kX9i3AMbYbJNkSj9OQ7cAoTncCjm4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyEwUwBt8h7uDpsDzT_nxntn0Gm_LOPEsn5QI69ASJYA&oe=6A71FCED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieXIfxnxUXIQ7kNvwHxfFmB&_nc_oc=AdrzoLXLngweFbGcCP1W1Hutk89qF-em5r4R3xjFaIgqXmx5VcmLTJeAla7f8F2HIRM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6n0-l9SpY6Ucogu-LxrcqhDvkbcqE5mHpvGJxVCSf1w&oe=6A71DCEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cw3VS8vn1N0Q7kNvwHtz83W&_nc_oc=AdpTf8-0aUrkwPmkxu0fBxctsMAA7lMjobi_frUVl88w1OS5rnCCCLeXNsBHU-Ik-us&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJmm8I99DUUy-Ap0aymtQ5DXSWs1opbq8aBfe-4S_d0w&oe=6A71E4B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb6JCWbL0PMQ7kNvwHYL8yn&_nc_oc=AdrCixJCyScnKuiFNFM0Dm_SF5SiYza4Plc6uw2F3ic04U5TYWKHDNaYKaJnOkk1IXE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCuxAFBkMnPKGgmQCYQZN0eQhDls93sYcmqEKxSDMRyA&oe=6A71D4B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
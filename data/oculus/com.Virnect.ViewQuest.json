_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FASEJsKlcg4Q7kNvwH4Dx4p&_nc_oc=Adr2ABy5l3Xqbd8uOX-OYJjpqUJ256WwToxteIGV3BYOvZk5Q9jQdgDpzP5Yk4_HmP8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApyFM8yBv5pvuLzoZiogNJG6HhAZw4GrG5uyFGhG3iuA&oe=6A524ADE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3aNUeo9uoQQ7kNvwHW2znp&_nc_oc=Adp65M3CIw8iUBL49K88AFxnKnRAaVD12rRXR3U3vqRH5GKlXx8upC7ogehoFxG8_gU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgwR6xnc8NIao57LxkMbEH_xWg9e1_YIgDsi__Hb9qnQ&oe=6A5258ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SmzExvO1QsQ7kNvwFF4EUF&_nc_oc=AdrF0zvVDODwgFyKJ0miUv1AGUNR8c30xtWQjnJsNA7YaVLeU6IqoT0YopicexG2y6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOALM93M-LP2HggQwMhT5OEnktvrN0fXnByrujoQUJHQ&oe=6A5238EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSEXLmf07yUQ7kNvwEmQNp6&_nc_oc=AdrF0Y7883hFGWfQ6a8jUM4j5RlEPVGMWWteimb-SqGx9mLUXJpC8vqdHFXGE7IVrPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPCnniMCu5xaTWdbPGxxpcJry8VJWShhgnxzQT_KWBkA&oe=6A5240B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTlgbA7BTawQ7kNvwGIDDhx&_nc_oc=AdqeObQaMBPBTJtyo08GjsFVHY_uUfLIp2C1rJ72w0vRfA_tI-x-PAeGfARCs8Ot8R0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ4i47G9Ub9kuUI3X6g7KS8idcFkl9NJZZR03gKvf9nw&oe=6A5268F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
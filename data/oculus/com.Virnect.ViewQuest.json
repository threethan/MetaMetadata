_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruJN_7mr-fMQ7kNvwEdrwcw&_nc_oc=AdotFdUbCOVr9eE0b4Awhk3G7BO83rYszhIhNUyZUTPePkULfXhXswxbMMpD_oUOS_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61r-gePN3J_4wTZ-bfcTXxuzdmDkbRtpHEoTNYnlPehQ&oe=6A1848DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp8j-Suqd5wQ7kNvwGRURPN&_nc_oc=AdpeSmE8FpCcS9LCMcZEBIarzS82T4q0EQD9nGth-S4qFUSe3yRs7qpCSDMJi-i6024&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AzPhJYac8RysOozByGjERJ3wNpvNLnovsfpJToEWzYA&oe=6A1856ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mW0WJ478FB4Q7kNvwE72w19&_nc_oc=AdrceGJCdFk9mXYBRU09r3VxYYL86K8K4jGnqoWP8U5ZGQuHtWiDvfQGpfggb3jynjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ED3NejWIttVARzZREF0vv5M9Sm6Mo_5X0EVW9wNrtmA&oe=6A1836EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdbnNgZ1OlQQ7kNvwER7wwC&_nc_oc=AdqFvOluga5VnCVEQzmVN_q1TWY2c7iUdBNWae0f9Gqmi4iDblerBmw7D3Ilzvsqq0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t_pnIX-aBohjI7OmJAwcFh-wBolz5hHei9JaJdo05ZQ&oe=6A183EB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px8RlSiLtpEQ7kNvwFHuklC&_nc_oc=AdrAy1x8MpuBPGDK6KiSP0bKKKC2x-upyrZbAvCc6lPIRl2UfCF08fTN46MaK9RM8Gg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kn2T96E55LhiJ09ZhhqNFeremh6yBmk-mwzAU2O1p7g&oe=6A1866F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
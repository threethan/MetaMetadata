_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRRh7_zBXg0Q7kNvwEeQxzv&_nc_oc=AdqdmXnCT2xWNz7PSFMYBzmn1lioFodKwHoFI24R__9l3l98glERfffTvdcIOfn5Tio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RvACE209hgffjCmDatXELeciOGDBp4fbNhvPLEZsb6A&oe=6A43CA5E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgJHFAKlsdEQ7kNvwF0iynV&_nc_oc=AdrpRczk0fbtNLjFm4TAz0FTw23r2fDhRzKUVuJM4fvC_DVN5Nd7NYEHO8VVdDEJoCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U-yIeWOuuuyZAQr_e3rtVidHI3LAb4he8QtyXL87xjg&oe=6A43D86D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JWGI6V9yOIQ7kNvwHXsOAC&_nc_oc=AdqFdS3k3RaOE5CL8iLyt-shXi0tfLSnCUiefBMWDJA-8XjBr_TzzrGh2KMCDPPPY9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LuDDwjIN9SyEGFak390b4pRif6jEjrcvtmSRIns4A7Q&oe=6A43B86C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlRuLvhiZP0Q7kNvwEb63-V&_nc_oc=AdqJxVdQ7xRPg4nzjWWQsdwHfPhYKN9ImtcekBgniYQlqUeUTW2ESoyKJVkwoi2ADK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h-5DRQfC0jgxwl8Y7zgkalYw0eHLJrdEqhxFHgNPOTg&oe=6A43C034"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nle-uPfRiGQQ7kNvwG_fih9&_nc_oc=AdpSm5pjcEe6qldjPOrvOCb481Z9oIKjLhOsUK14Y88QeFLf5jCJN8izGBQyIpqytks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KtkC_9pUpcWbH8AZNAtWGaAtiaSjYK8r6oZniFXkOhQ&oe=6A43E878"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
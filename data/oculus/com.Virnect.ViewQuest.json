_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epib7GDgmUgQ7kNvwGennL1&_nc_oc=Adr5LsRSpwonptWX4unAMskKGUDAXb33ebUqytlIAeD5c_UeB_IO5Q_d-SJzoXzxFdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFJsKtAHDtR-ji0vin-Bq10ZU2wlGU37bVMohCHVgt2w&oe=6AE5F2DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWcawaVGpQgQ7kNvwFNgKH3&_nc_oc=AdqXk3KdWSDZyBgFPCrU5FL2ZUvMF0t8IzT3lppEkMMGpP_rs2Bxw_amqzQfxQxVA-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvCEPO7A1L8Hl6gw1-hcRFiCDZUCZ2tqIc4WN1mkGBSA&oe=6AE600ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86wXDZnPTfsQ7kNvwEwocU3&_nc_oc=AdraEHcSpt0njkjicO91DXGqVi2p-NbgI2-kUBfDe86dWS8Z5qHwwJDrbIJp8EXJE8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMayOgjBEU_cniSP3p13D7mnyCGJs7MdZsmcGw8H5WSGQ&oe=6AE5E0EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QP1M_m9DtXUQ7kNvwECLlTl&_nc_oc=Adoq53liMCeoA38sa-h1M-1E19OdAzHavngEO4mnUUal4DOIcmRbSqrD-BJzVLFSKzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOkQIB2KcWqw_E2eP4jt3nyCkWUpU5-mFd4mDoq_3q3A&oe=6AE5E8B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJcH2bZ2fLAQ7kNvwHgtMOg&_nc_oc=Ado9C8vTZzyZ_Kqxamtt7DJT60WJIOE_MC-Bk-4SYEGMNecCB-Fhv1QI2XRlV5CWmsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNJZuiSkCUBNe-9bSpxkkLIURj5jYGVdhqktoFVGUApw&oe=6AE610F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftJLNk8-9bmP8oaLSfeJhUwp6dApqQXmTfCj-I9LRZ-Yg&oe=69A8395E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz5i9L5gPCUQ7kNvwFz8TgA&_nc_oc=AdkLO2W1LQmJjvVXi9unX2sF3yzXND_i-Vw5U7BYGt4ash9rMZfkrFyJ8FpMIS6kfJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs8RjwaZOAEktHpzlpq8OrYGQ_JDmildd6xOt9qNVuwsw&oe=69A80F2D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqB-aaREw5gQ7kNvwFMvWHD&_nc_oc=Adm3kusFT86k_RVB8HVKVJnzC3-JE_ysRdEJd7SVQCiJFlOCse7TgRzZzDQ0GoUlXhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuAv2CKyb7lX8QLB77ZIz4ff5hnGKsao7r2NfMiY30Nxg&oe=69A8276C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQNZUY77e7QQ7kNvwG7w3kL&_nc_oc=AdlSq1p_65TzLBlbA36O1RBkCHEDeKoYM2CaiXQMbxsVoGM5Z5Qj-HZq7F3p-ZU3vac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftk4kGfbjTEBR863dqxuEh3fSAG6BC9d79-LsA0mrN3_w&oe=69A82F34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yopLIUMVozQQ7kNvwFXhVwo&_nc_oc=AdmPHBs2LX3SJDygNnDeGmi0dvdRRL0BaIKBCKVUWc7Yij08wQC_9Nx_o-eQ62HS1Eo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvLHLkINLTXrBbkUHUs2nem_RdyDn70iSDE_5PxWayA_Q&oe=69A81F38"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMF
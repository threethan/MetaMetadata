_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XA4ms5Cj7sMQ7kNvwFv-DP-&_nc_oc=Adp9-VY4CRwN-tfWuCU40PBsmIl1f9g2hinqJoP8xK4PWNNFkIXZNt_DW_O7nFSUNIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBAHup5I3kusdyc-dnTIt7TzbIX84wDMH72XK-iVwv0g&oe=6A6B575E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o7WkJ2S8yUQ7kNvwGdxyvF&_nc_oc=AdqHKhs-i-OtywlxgXfPFq7eNnUIcoO5uVmSCoSAl6GVcRNidrk18StZcpsyyI2wJbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHzjpWbflXtcwUerZl40ahvm_eZAJNhOHFc4FKPdpuag&oe=6A6B656D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad8zdV7HZ60Q7kNvwGo2Cjf&_nc_oc=AdrJjJbIMGz4UsW-ea8YpI8cGa26c887WAQgOpoYnj5tc0uDKmhpjFso_-g0r5AQwnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKm6AJVSQxeeu3qQfKFpKMOoQRKx_pCpeL33Mv1yRXKA&oe=6A6B456C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ozXkrAzG2MQ7kNvwEJom-B&_nc_oc=Adqah0vGw87bKGXGGL0sAgNdgpPyep65n-9R6ay-JOTiHsWigNNBCvI-vomIYszWKxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQpc86f5JZfoRsB3GaLYMR0pAyCNbggeC54AR1kKAuIA&oe=6A6B4D34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIuWOw3KwEsQ7kNvwEJF5Wm&_nc_oc=AdoZody3SX8eiPjq9TuRTTFysOVPbKB8ejYzVnwiBdlj9XR2jxgJ2iVESNLPrI1AgcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFOG8F95P0YxjMDWRA9HQVNNBj_hPSv9S9nEfO29xYig&oe=6A6B3D38"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSNSX-u_YoUQ7kNvwHqMMFv&_nc_oc=AdqyiJqshdNHO7Uo_NTSranBdPt6_isfNey88EUm4_St4yyim1lyGapsV7Hu-xl6uNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-44ZaXXDH8GwnIoZIRfpBhMsmwcW_azOg6AwQSS462g&oe=6A281ADE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlSbbovoFf8Q7kNvwHs5TwW&_nc_oc=Adr3_PdGphTxja077eIBHhDT8yrKKT4NK5y4YeKit10j00T-r5yXyPhaBfWXg_PTJIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v6uOLTiYWwnPmVU7k_hhSwI5eJdswnWtfN15evX6qZQ&oe=6A2828ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaM_3VRnuf0Q7kNvwGWPrzf&_nc_oc=AdrnAj8aiybGPkouHZIAhzxhICYqF_6k9O0k6vqZdT-I2ro6TUx2lDgA3--cXIBMf_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wkRJbk3dtAXhGydejB-l8f2hw42NftVR7RAtJNBxA-Q&oe=6A2808EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tuk5fs3MKAgQ7kNvwE7t1cu&_nc_oc=AdoQBHULUYAgTlHCjB5ZBiCKopTeEO7TOzQa8lo614P_gBL_KycgGqTjaf-RH56Hy_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KAI2Nn_pABa4-gCRaOtGuyKSJmRIXoctR9nJVvRzMAQ&oe=6A2810B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqoKUfwDB68Q7kNvwGC0r8j&_nc_oc=AdrR6NkdOSdcvXvexhCidwNWsBpiWFlLrplwtssHx3oWZZhup-D7TDyZFtnmiHGEUhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l83qhqtfRZuJbwKFSiwhDiGlPO9mpcAp8LP9a7m-TtQ&oe=6A2838F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akYVLh3_Je0Q7kNvwFrfebR&_nc_oc=AdodaUAZpp6wVe4Lfg9O04eMS9fMT4zfin4k0Fx6DXPNvRn3PXOqe13H57D0RgOQfaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44Ioc6FpQZpZ0-AgkYpMqR10YPPruW6R-sO1JOqMeifQ&oe=6A2031DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OV71ErS1WcQ7kNvwEZNYJv&_nc_oc=AdqZA7EpuUIVL8LN1IPDjnHIliMcx10ItN1LyBxeVEHR14DesEIj_2SANqSXbUBtQuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XYb0aFwDCQw8QkKetFbryDzwHWkS9mEwNhoS8NkAhMA&oe=6A203FED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkrHeqZK-pIQ7kNvwGOFM3w&_nc_oc=AdpsFGjMGKXAT3eYZbBJVALoUVpZIPcKSeY4xG79jHYyGRVrCeT97nUSCrUDUqOKVqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af766vO4G0X4eQOJbDjMZEpfAxPDWAiVv7AE3RbWfcUOxA&oe=6A201FEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uHR5e2e0YYQ7kNvwHDJOwV&_nc_oc=AdrpmsxnjhSMbFr2WMQF3Qw4OW_rgSzICvLpkTwRYoY8FoLCXaKMygksN5nrkY21naY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qpfcbHO014hrwMwQDsUBKXH2zhIG_kI5BjYxEGsjFNw&oe=6A2027B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32KnYqGIFNwQ7kNvwHRJh63&_nc_oc=AdpZ7BKyZnxK8HYJTNN_ZA-yYNjyn0lbKnpbtD2SCUzCz7X-gKU4c_a_PVn4wAtO0Vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jh-bFVXq9Zs083X23t2zxfEEOwl0OXW5KBktp3rbfVA&oe=6A204FF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
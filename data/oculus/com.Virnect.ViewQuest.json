_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jq1HW1zeE4Q7kNvwGWIIoU&_nc_oc=AdoRxshN-xC1gQtzD_ZY8uiXlWbbDfG2B053aVqYwWd7Qg2uZxQxiulAk9HJjkH3sgQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcBv1wFBFIRMUuDfXH6c7nrwsGeET32tO217vqL71Zkg&oe=6AB67CDE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=618GdkaTgLgQ7kNvwFVK9yM&_nc_oc=Adrb25cmcRE4BgeCPftaDCEsSuHegvEw0yvq5AKgtiUf7gcCqRz0RI7UcA1Q4WN-YcQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjTGHm9mJFoZQ5OJEs_Bz4dMLtHclEY0_WKTKu9XzLGg&oe=6AB68AED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKfmCPqmjuUQ7kNvwGKtltX&_nc_oc=Adp6ezZNvixTRQxx984S0sx_ur198I2YaLl8gX-AfDYwvdvY-YGV4rsjcHhMPDHSvEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM-LNeBZFR174cnC9hF3HXsMwFgDqEqfQqQi9Ch5DACA&oe=6AB66AEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vvExeF0PLIQ7kNvwF_eqqm&_nc_oc=AdrHxjkBen6bvlBEbWd7-zM7S1nEk4PFeDS7iXOFnN5E66humYhF9-VqmC5JUGdj0GY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3rlgyWzQf2rvJIHYB_SgW3KzUxcTDYp5hvkrRDf0Omg&oe=6AB672B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTjTITjYL70Q7kNvwGZKzSS&_nc_oc=AdqhSZmKVCWjFtIkrgJxAzdAxyMbEMvK_bdFmYLO5pLVDfhBHyqhuMg1ost7J9vZsEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfYJJDfQevMd182xygAnsi7FrgAmFoMujJv-ZU3ZfSTw&oe=6AB69AF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
S9-6KpBXDt6jNlJeRfKM3Y8dnA3zRltzyLjauyCTUDIjyyDlenMr7Ufng_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDhfrqI9LZbwX8BCEAZheCgL1S-J1nKXadw1vwS0R__w&oe=69CE74DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tGVCel2KXkQ7kNvwHAEoOe&_nc_oc=AdozONk7yv4ZlqJm7mutR_cOaoPGrdeJVPqoaK4lPfP0hV02bdh3qCdvjUPywn_0A4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdaZWi3MNsxBX7x7EBwyaioNbnqL4bBOhRQ1g6gHdHeg&oe=69CE82ED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bLO0LD6elgQ7kNvwGMG8r1&_nc_oc=Ado_5Stfuzk9mAo0A0vTSSfzRZbiUd2EP7TZy8edEjkjzWbP_XQEon41vIE1OFHUx9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybOemPCc7mp450_JtFXKPSIz2qb_j4Ho3gnMOMKZHn8Q&oe=69CE62EC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4Fs-AH9FpsQ7kNvwE9s-lB&_nc_oc=AdpBdzY3D3sV5bTEQOLpWGFlVPvCPA20qN61bUfo-NBGB_4uD0I5wKBHlzq2qXHpvQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeVOXIMbXkuQ_Wg7i52FHwzG074G-V02Co4sBf_qFbIw&oe=69CE6AB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2cg7g-L3KoQ7kNvwFkVZxK&_nc_oc=AdqeP8FFk8G5XzZD23-ZVj61REAKjowNS94NoCvhxJeI1ojDKgfQl5BYexd0aCOpdf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMldtazgjURfm4qgKqdIymPj50-ZeNQ5CPM_EHZTwnkg&oe=69CE5AB8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2
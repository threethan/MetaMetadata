_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTm8FzSP6L4Q7kNvwGgDcIx&_nc_oc=AdriN-CpSAPcbyFX6lWcfKPOAz7--SE8ixiGQTVIBnJklEK-O6Ycdh76mbZZhTgSco0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUJzcTnJ2XNYgrEI63oW5VThIB1_OqkXNiEU5Cd8x7tw&oe=6AABF0DE"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wIsTYv6kgEQ7kNvwEgCtTs&_nc_oc=AdoCMCVlbb5nHv3F4cHc2F7AmOx7gY8mh7HxEsBvIH2cO0sXwYgf_12HBPniMQqSRWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR6JZW-LpR5nvE87nPOZMRAp7SyPSPsd1RKRkyzLeMPw&oe=6AABFEED"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WISZIHCYV0AQ7kNvwHZTJR0&_nc_oc=Adoj9RL02gqmaduinZ4wga9C9q20EGeNvTMu7jDLoiuiTZzflhk6XO70rVFyB0eUfvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJchdinnFdfaTpiMFM_RhMu9wPnTDr36OvyVTrQY677SA&oe=6AABDEEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w30gVzaJ5pcQ7kNvwFIwBXM&_nc_oc=AdrHg0U6ticySPiqGuRE0V9rmI_HHdzerSQxjFpRmk-Ah_roXQ_SLoexQVyGIYMuY2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdOQtswUnrjusIXB2cwLpRh1fLiVtGw4wHLtbUbSXWmw&oe=6AABE6B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_JWzSyT9dgQ7kNvwFiiLS-&_nc_oc=AdqqYSBaGZ6g0WbOkpqYLGBD42KRw41UB5X21R9c-Hmt-l27g3pOXm6xAdxbdcdDKgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXV12Nc1WEwxJ0mb3jr0rukRGxj-L5zmIUM6EWK871tQ&oe=6AAC0EF8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
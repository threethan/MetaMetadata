_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA6xGrGHw-8Q7kNvwHxVxmv&_nc_oc=AdrP0788oMPNVbu7JymLdu3Ggh_e12IZKyfWy_JC6cXhSuxjp30hdCUEygwir8rTcT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNthArij3Z2GMhI_k-Oxc-4QX5YDqnO23P7keO63mYf8g&oe=6ADCB85E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znC_utZ9H8kQ7kNvwE2kzlv&_nc_oc=AdrW5EEKTX9O-y8KWagw8R86KccOhrN0L8KZ6UsPFjTCl7NOPXz9M3SHR-de5OitIx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUV46MtgmJmKfOJLbsDo75avY21k5LgXRffqJctx0vwg&oe=6ADCC66D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqcINyoJzqcQ7kNvwGgssLY&_nc_oc=AdqGTv1Vlp0Iy_QqAf6KyVuyU5FRyfcpV26MvdBQjZQOGaiZyrelQsdID_Kb1QIM8qM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCyEWBacyEQumW96mmI_-T7Kq1na43SHD4RptMgJ2FHQ&oe=6ADCA66C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmYI3FBrjKwQ7kNvwGdbrT-&_nc_oc=Adpkvc2zrLi9GtCw9mDoiNfn4TYvgDsjJ8-lLeLh4yEgpYD2XAj--KpHCx6-T_PG324&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUmm9VMsz4tccwvGIFdP3FAOzW_DXeZuw7IdHNRv6eug&oe=6ADCAE34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtNUDeBLDmMQ7kNvwGtzTom&_nc_oc=AdrwdeLXEHpxg1zhogtURvB6TuTopix-2srJ-wVvVnswFd2LYCQLxbMO9keNfrwlR2E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsdDx9m2HDPGMJJI6jp0LWLYjLb_xSM-297gkTJcx4kA&oe=6ADCD678"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
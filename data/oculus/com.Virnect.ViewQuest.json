nt-hkg4-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VABFbVWo8AQ7kNvwHd3HXK&_nc_oc=Adlvz0bbPPt-0MzKoA42moim0kSxyCHDnMBt14EoYFEdB5HHLzf8ecrHnFIjx20Fo5w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftsz3U2TK7Xly7ExlO97LX1WvGRQaJEAc77m6c2YsgKeA&oe=69A177AD"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ4vfaQoB3YQ7kNvwHAWP3o&_nc_oc=AdnFUEvsRWpGGgFqLqIydhnZXH_2-2FB-YYyL_AWMQBLGqmYUQvDuPSDytNLWmg_nXc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvXKNjWZnct6m5iN0jrL1qTHluzJ0TTu6rE8hzK73hZCg&oe=69A18FEC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSG42YlP0NwQ7kNvwEmR71H&_nc_oc=Adn2Axnft0IF1GP-9OLFOWyUWyGcHTrstXgqdP7D0I-5yQ2ghPAcLO8K6jkFkxK65DI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvQvDd5OLp1JF1VQEfKRskDYwhg5QucJOBhnp_Pe8ltiQ&oe=69A197B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJcY_g_U13cQ7kNvwGLNWrH&_nc_oc=Adnwzh0DQV5WayzRr0vzTYCr5P7kKqskgl-snCdKRxCFT9gqUIfmVptezw--c3YrUsI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuibK3hajIi-JIskq5j1FN5waXBIiQ-YpAWb_QNKC6BDg&oe=69A187B8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}],
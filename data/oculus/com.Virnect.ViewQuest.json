_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkszJ14ZCLwQ7kNvwE6W9j2&_nc_oc=Ado_SZPTMd9qzbm4kLqQQTkn2bOYaBg58-E2DJP-br_pvXim0H7-L6Ato1LBI7anJtI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUEYxu2MnhGQi_YBgrxlBdYfizN4GGz6awSevRAwKq3A&oe=6AC4FD5E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e4Hw4x9N6gQ7kNvwHMbi3D&_nc_oc=Adr2OpIyqTHZODtVdcZ4pJYDdt4ANPA0upOAoTppBWkTkCiizJhiu7ZP6KbuEvx82pE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuBNM102D7VP-EVtMUsBATw2gxqEO0j8TBoY_yo9ZBNg&oe=6AC50B6D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D32UIX9XMx0Q7kNvwFl44de&_nc_oc=Ado4auVgmF3tYdQAZso6fSFtB2ozLCFKrfzDyJPPclmWhJKUJhqu9lij0-4jqTql2_c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPckEBMky1zvpokQPFEdw2VRZjHC20-JoevT4keLL5E7w&oe=6AC523AC"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvcC348jMbMQ7kNvwFsCYoC&_nc_oc=AdrAoH51BGSia9y-n8KEnYKzGMJWAqbbeBIpEBExe8juBh1CvIMb13lbLJm54j2s6tI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4a_7tJz51sNY5cJvzWO94jizCPONAx6Mxpbpa5IbMug&oe=6AC4F334"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwJrA9a46A8Q7kNvwGRvyMq&_nc_oc=AdoLCASAJ7a8pyCVrH2u_bw9wsCU2qCUMrtIbEKB0iS9zg3GKe9Sne6U13ueTzG8wtI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9cv44AvETQ87CKVta5HteEgDudmOJ2EskC10f4z87Tg&oe=6AC51B78"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
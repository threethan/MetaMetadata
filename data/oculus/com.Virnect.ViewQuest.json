scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2VNXrItFk5P0_7rep4RX57nWDPja6pNfdTJ6BXM0D6w&oe=69BAAE5E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozXZnPmZIRsQ7kNvwFHGYj2&_nc_oc=AdlzGn4RPx4MDzRWnjtphDKKDaCBPRbLHPKvnU-A9c9rsYDGjKa4qh_gdfvqhn1quGA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPnaaNJbVHBxMu-BRSA5PXo8eV_CS4PZTZSvBjV3ZHvg&oe=69BA842D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMuOMDdBJ3gQ7kNvwF_kbC1&_nc_oc=AdnplBm2JErFkmbGg4nTTTuieV9Zv2V4GkkD7zj_2s5fqfGtTxOBNevIZwhjdsUKKpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6nrsIgJ9P4IUpmk6JytDkG2Kdez1sqMrWVNyesMWXng&oe=69BA9C6C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoML2qve5gQQ7kNvwF9Dz2R&_nc_oc=Adl0k2Y2KbAeZK1DEej2ZGaeMNo6UywwTb3S-l4gz-pNtgU6USVs66UOlYCVLyP0lA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwWr07k4DPbiVMre7G6t0xXp3GlaSKQu6Itfs0S5TLHA&oe=69BAA434"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKQ8UuFpeD0Q7kNvwHoWaD2&_nc_oc=Adk7dH8hOC1eCl-WE3RheMotWZQXHbMOjQMryCo1gPMyqdutL3pyjGHEDAvDqhIuEZc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSfqmZEWzEtrhkawlW2i-caLchqo4lf0YF17pLmoc54Q&oe=69BA9438"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMF
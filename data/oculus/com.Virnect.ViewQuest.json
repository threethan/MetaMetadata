C&_nc_oc=AdoYics7v7yADLR_hXLyPhdtMX5x-AngMl6Ta1XHX78VaY_LwSsVJjuEwqeuTi5C_tA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO9tH-P0WKas6JzJicy9agesFe1x55cO-buZM7Cx67fw&oe=6B0321F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0CYd7EOVPEQ7kNvwEPet0x&_nc_oc=Adr52Z_pLlqyHRuRV0fWnEawRjLlhsjYpihCYC1zgB2MmvRbFjordKsxUvH5DD5s85s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjzF_BnrlgToDqy_I8jFqiIzasuEBW2xfmB56WvXuGIw&oe=6B0311F8"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": "https://store.virnect.com/page/index?tpl=etc%2Fcontact.html", "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32276992618613012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974723_1553611772014868_5929781507689364850_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhjPWRXT8moQ7kNvwFdewIm&_nc_oc=AdoXgsc_kWngv5i101-vCXSCncGNK_SosK9hL99MT8vP4RtcMgLXFTyfI5G2tZ1e1VA&_nc_zt=3&_nc_ht=scontent-sjc6-
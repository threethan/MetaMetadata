_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6heXalzBzcsQ7kNvwFZ9oOl&_nc_oc=AdqIER7P2pVfxiMfR_l9ea3TmjQzO8LF-TCTIIsjfmlHS5QBCYjnpKayAcQ3InkWn0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPWqW72x_a7gCHPet4Gt5ztCGzDo4wKmKZV33-e1IEtg&oe=6A83125E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrCWEI8Qk8wQ7kNvwHFDkhg&_nc_oc=AdrmlnCtrn7xozkoSv3R9JVxRI8oEGd4PZznKgotsh7Q_YTgU1uSkMJwcm6tLnrvI-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGiYrNDfVZ7AFJoVz9wJxD0gMs6JIQd9B985TIpDgsmw&oe=6A82E82D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mtdWvCmAbUQ7kNvwEjjjMo&_nc_oc=AdqkAkWK9A2kjQmkJtCxf1wtwuwKqnlDgQT40M5OUnR86S_mxatKrOFoToVJg53ZFDg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE67GnSjGUQUcZC4MZ8JwFpCjz8-m8LkiS6Otle4J3OJg&oe=6A83006C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRu_dNqlOPAQ7kNvwHUC_qC&_nc_oc=AdqLotkUeh8rOt6fTkpZuXShglVX2KR4V4Bj5t9AOQguopHvqUpUbqT2SVfG9W42Vw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRhrFYihos4LWhghZKfoENUE_7K9fLee09-rMhDPvoug&oe=6A830834"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elWqZv1kC5cQ7kNvwFJ22dP&_nc_oc=AdocZgszwxNn4jYUeiTDnqzR0UMtUJaCnfPGs8-hNzdMkDtIoeHQek7zTuzdoRsIxAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo0FYYoMRSohMU-ThHLjh9bO0eZmveqD3zU6_ZCTvxUA&oe=6A82F838"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
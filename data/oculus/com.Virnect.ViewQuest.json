_2710374385793731_4335129908217143921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDZeIkPIKfwQ7kNvwFodh6y&_nc_oc=AdpkYOOzy9AC2FbwCXiXSZI81Kc-PU4yx--9j4f4p5gjdYSjnMfOR45nrEJ_Z2kUf0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeDeAw3p7Fm7wzKMp-dznMw_CQRXf6LieNFikTtIoe5w&oe=6A5E285E"}, {"file_name": "004.png", "id": "1819549741885168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984474_1819549745218501_878499352484891744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v1wQOw3WS8Q7kNvwFpZv7S&_nc_oc=AdrwZM6XbGRSehDiZIqlhUNXfTc-7LmnUqDINoSDQiG8hlD-5w7DGTDMkY1c-aUX37o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM6vFN2k_jJD96HRfz8loWruikrWzKlhhlhn-2n0Nk-Q&oe=6A5E366D"}, {"file_name": "002.png", "id": "790364216531353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_790364219864686_8155488325575676486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKLcBp2ClWUQ7kNvwHT03Jz&_nc_oc=Adr_TalxY0Ap4pMugv-EyagQ1p67RedS4Q_slJ8qIPjKeexJBZ9QihR0kI4hMAlpRuQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDzIbugjXMxeZh_me9UUEEtYt7qZ1mW__E_oaoju00Ug&oe=6A5E166C"}, {"file_name": "001.png", "id": "1205543714149528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269591_1205543717482861_1636873667456873713_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzMIqy6j9PcQ7kNvwGlIwyF&_nc_oc=AdrAICAy65rM5M-Qu9AaaFu51CVO4t7vmyfj_xA6kvIX2XZxOvUXnyyWWhV-KSOIKDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY53g1GqlSgX-hkdQmFjkH_LBO3naZ5pJz-VNWqpx1Dw&oe=6A5E1E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "004.png", "id": "476707408073775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294244_476707411407108_5418331704720470775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EkXLdJOmasQ7kNvwGMUna7&_nc_oc=AdoSOGI4UOqmW16Djy8vUYb87B7fh0Hm8BxMLb01G9SWA-RT6XdSyVVLLofp-U2je6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDysObXPuGoJgJh-k4eRF_JV8Zyk9mHUIp4TrSOMavtjA&oe=6A5E0E38"}, "display_name": "Virnect View", "keywords": ["virnect", "view", "ar", "industry", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nWork Result Report Writing\nCreate reports while viewing AR content.\n(Supports text input, photo capture, and checklist-style work reporting)\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/l
oKUs8IQfrrdBAOu-Fi6NYc-NbmVaaE13ByzFF536_KoxymhvPpabD9Q0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNQBp96uNmBAj42nZhT84h2F0vSEanCzcsPGpgoYm9aw&oe=6A71DEB3"}, {"file_name": "Cover landscape-4.png", "id": "659301826593271", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392127_659301829926604_1978143495615830426_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBbiAh0rCtEQ7kNvwEW2vEJ&_nc_oc=AdoigDctDCjX4ppxp-motk4LTPir-Fok-zwc9MpjaCEo4sNeL2WEjLdxQeG6i641FIU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeslQGHUCja3iXomUtMiPv-R_iA_xjKfU7BfIqsm4wSQ&oe=6A71D0E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KinderQuest - Animal Detection", "keywords": ["education", "edutainment", "animals", "game"], "long_description": "\"KinderQuest - Animal Detection\" is a virtual reality game designed to engage and educate kids as they explore a vibrant, nature-inspired world. In this interactive adventure, players embark on a journey to discover various animals, using a unique photoshoot mechanic. To capture animals, players must focus their view on the creature, and by aiming at teleport points, they can jump to new areas of the virtual environment. As they progress, kids not only collect animals but also learn about them, enhancing their knowledge of wildlife in an entertaining and immersive way. Perfect for young explorers, \"KinderQuest\" combines fun, learning, and adventure in one unforgettable experience.", "short_description": "\"KinderQuest - Animal Detection\" is an exciting virtual reality game for kids where they explore a nature-like environment, photographing animals through a fun photoshoot mechanic. Focus on animals and teleport to new areas to discover more creatures and learn about them along the way. It's a captivating adventure full of learning and discovery!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "develop
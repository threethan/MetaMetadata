ile_name": "Cover landscape-2.png", "id": "1193909966072096", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391946_1193909969405429_1068796832251278914_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GzrwxMhYAEQ7kNvwES4XKi&_nc_oc=AdrQZqjUdUs3ho6ywlZIRZj70tXsFjgY7mjWmduJsMm53h_XUgySFIEQ0VncS6pkKpU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHR3H1ZgtRE0aRIICTPWampukVtcBv82xjxW_K6Z-PNw&oe=6AFB32F3"}, {"file_name": "Cover landscape-4.png", "id": "659301826593271", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392127_659301829926604_1978143495615830426_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FuH3PaA_AkQ7kNvwHd2hpl&_nc_oc=AdrU167YhB56mNLYQVKLhJmrGMsOttT059ov2tesywjzXrURQCAKhjbPI9GblKQTkJM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpcpwyNdyHZk2dW3TvXC2JhjDp1JSYrZgM2mS79GKp5w&oe=6AFB2522"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KinderQuest - Animal Detection", "keywords": ["education", "edutainment", "animals", "game"], "long_description": "\"KinderQuest - Animal Detection\" is a virtual reality game designed to engage and educate kids as they explore a vibrant, nature-inspired world. In this interactive adventure, players embark on a journey to discover various animals, using a unique photoshoot mechanic. To capture animals, players must focus their view on the creature, and by aiming at teleport points, they can jump to new areas of the virtual environment. As they progress, kids not only collect animals but also learn about them, enhancing their knowledge of wildlife in an entertaining and immersive way. Perfect for young explorers, \"KinderQuest\" combines fun, learning, and adventure in one unforgettable experience.", "short_description": "\"KinderQuest - Animal Detection\" is an exciting virtual reality game for kids where they explore a nature-like environment, photographing animals through a fun photoshoot mechanic. Focus on animals and teleport to new areas to discover more creatures and learn about them along the way. It's a captivating adventure full of learning and discovery!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven reality", "support_website_url": "https://provenreality.com/contact-us/", "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27280163084963427"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393737_514798671250651_1350938301357457226_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2D5MvC1s0sQ7kNvwEpnYUL&_nc_oc=AdqQ2OzYRix99vjkgCgi0-fJamG7txWasMFnZ3aupY04TWPPaBxyJr7xnH3lrHQKJHY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL8QdkIMHcIdA-TzaKGun0HzRmZXFsZk-fH0OS_06Asg&oe=6AFB3395"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "KinderQuest - Animal Detection", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name
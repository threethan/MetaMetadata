20f&oh=00_Af9g-SJlawV9y7fWvzwNT6t-JWk6x8nsZWsKsJ877q2mPw&oe=6A22D854"}, {"file_name": "Cover landscape-1.png", "id": "648134071508865", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393469_648134074842198_7965903344636321657_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfOn2f3VjRcQ7kNvwHiRnRP&_nc_oc=AdoH-oTIuH-nySWpxZhHA9_I-aUpCtz0F0nC_WpIaXfSJbqdldTCREANc-b_gdDQnSs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vxrb9iSKvmmZl-ljQBrp0F4QB27LksnKKhhTPepWGXQ&oe=6A22E7A9"}, {"file_name": "Cover landscape-3.png", "id": "1018067390212101", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392046_1018067393545434_3137675062540478565_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxOxiLKDPaAQ7kNvwGMfb1n&_nc_oc=AdoRsLTMLlQtVQPNKVRjS-B3XVM41rIRmjdPIyiKNjk82hNbj6lA-0QVNqjd_Rmx3kk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UAnyVM3HCt2_CiA-CFbag66UMIuy6OWWXtAy3WGyZqw&oe=6A22EEE5"}, {"file_name": "Cover landscape-2.png", "id": "1193909966072096", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391946_1193909969405429_1068796832251278914_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3M9DxnihP8Q7kNvwGqWg_i&_nc_oc=Adr1G2AT0uThpVbeDBnP44A7W_H8yCLjV0SYBP-rztHTjVL1UGsh9-FMsB0cTxwGqEo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rbkZEG3Ybi6--Zg26ZtV73nH8VXq5jTJmZdb9NF61sw&oe=6A22FCF3"}, {"file_name": "Cover landscape-4.png", "id": "659301826593271", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392127_659301829926604_1978143495615830426_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqJPk76nwvwQ7kNvwGhoKdo&_nc_oc=AdocKJgvHIk6TAwDd82YBopORb4fmRD1KLLhlGOBzEYSPaOZcgJbJ0Tc477D9y4Y1SQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sZPF4EzyI_STzzhWdBzvNwEaMrNaa6fmAOWxQuXp6mw&oe=6A22EF22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KinderQuest - Animal Detection", "keywords": ["education", "edutainment", "animals", "game"], "long_description": "\"KinderQuest - Animal Detection\" is a virtual reality game designed to engage and educate kids as they explore a vibrant, nature-inspired world. In this interactive adventure, players embark on a journey to discover various animals, using a unique photoshoot mechanic. To capture animals, players must focus their view on the creature, and by aiming at teleport points, they can jump to new areas of the virtual environment. As they progress, kids not only collect animals but also learn about them, enhancing their knowledge of wildlife in an entertaining and immersive way. Perfect for young explorers, \"KinderQuest\" combines fun, learning, and adventure in one unforgettable experience.", "short_description": "\"KinderQuest - Animal Detection\" is an exciting virtual reality game for kids where they explore a nature-like environment, photographing animals through a fun photoshoot mechanic. Focus on animals and teleport to new areas to discover more creatures and learn about them along the way. It's a captivating adventure full of learning and discovery!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven reality", "support_website_url": "https://provenreality.com/contact-us/", "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
p-aLf4vsoB91eC2-HNA9yM0qxVf6MOzQTozWopIlXx5ZHRRqFbW2IEjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs5dnhVQGuWHSlymQLJpdCzYYAwS4SrTr-oM5klkK6GA&oe=6A733033"}, {"file_name": "Cover landscape-4.png", "id": "659301826593271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392127_659301829926604_1978143495615830426_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBbiAh0rCtEQ7kNvwFTQbPl&_nc_oc=Adr6nzU7clHQX9MVUVc20IBm9fbX4OTMtqfvruQ4Ke1y67uxCJwbeKp7HSlgSDrzciA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiMn5lWpyX8U6A_2s7L1_K3tGhNp3apRxw2WbjOmxAbA&oe=6A732262"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KinderQuest - Animal Detection", "keywords": ["education", "edutainment", "animals", "game"], "long_description": "\"KinderQuest - Animal Detection\" is a virtual reality game designed to engage and educate kids as they explore a vibrant, nature-inspired world. In this interactive adventure, players embark on a journey to discover various animals, using a unique photoshoot mechanic. To capture animals, players must focus their view on the creature, and by aiming at teleport points, they can jump to new areas of the virtual environment. As they progress, kids not only collect animals but also learn about them, enhancing their knowledge of wildlife in an entertaining and immersive way. Perfect for young explorers, \"KinderQuest\" combines fun, learning, and adventure in one unforgettable experience.", "short_description": "\"KinderQuest - Animal Detection\" is an exciting virtual reality game for kids where they explore a nature-like environment, photographing animals through a fun photoshoot mechanic. Focus on animals and teleport to new areas to discover more creatures and learn about them along the way. It's a captivating adventure full of learning and discovery!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "develop
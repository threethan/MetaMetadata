out the game world.\nThese installations can take the form of intricate patterns.", "short_description": "Quest Tag, A Gorilla Tag inspried game using their locomotion"}]}, "developer_name": "BT", "developer_privacy_policy_url": "https://docs.google.com/document/d/1DklQCYkt1ELGatMgH1RnUWeoAXMjy-c27BeLfoA18RI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Asteroid Inc.", "support_website_url": null, "website_url": "https://html.cafe/x9243ff41", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28635417862768375"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391958_1781622462623082_1944391374075905063_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5rWXEXm18QQ7kNvwG9Ep0k&_nc_oc=Adqe0vXwFlk1sf6nazoi9ADzBVTen-xn5zwYCPCzJjrQ6xhJQEbsIm3-IZ3TInc9mkg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEczLM0FrXIXTK2zS7hxV5bAYjEP1j3omfWeiTAxceH4Q&oe=6A859397"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Quest Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Ha
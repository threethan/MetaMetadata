/v/t64.5771-25/499622315_1550831623088488_5473515242924439434_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIvbeKKW_2IQ7kNvwGNVh3h&_nc_oc=AdoI929BWxmTg2zwZiq63FLymVjRYB21hgRWQYZAXicJuTSFZdvAOtOr__nl6emzvgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtNC9v8OgTp_w0al28nh15gxMgpYQN0As9RafOBGV7OQ&oe=6B0F2382"}, {"file_name": "CNTR_SCreenShot (5).png", "id": "2256189041804529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619450_2256189045137862_1058388512810994987_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLItDC6YmGgQ7kNvwECubRF&_nc_oc=Adp_dC6_lP6SSkllmLwEixSyaWgFQuaK5VKjY8JPpp7R_svXwgktwryV95Y8KCGuDn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_lzja-ukGS6ymVQ6CMaVzXn4J6byRZzanmKCMhbpOTw&oe=6B0F2377"}, {"file_name": "CNTR_SCreenShot (6).png", "id": "2625691587888719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_2625691594555385_7105094618478170625_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsctUX5VPTIQ7kNvwGlQQK6&_nc_oc=AdpVdQP2CmiQqF8Gw1edOfZqbsjPjsU9TnI4Cm4eVpUoQcibnrK0wZvC8rnY6ON-Ts4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4-fFqLaZSUMl6oMO6zI9WT5AcrCaacYbG1mQJ15SMHw&oe=6B0F16AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CNTR_CoverImageSafeAreaTemplateLandscape_07_ZK2.png", "id": "1879864066720564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620530_1879864070053897_5414403541846181928_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5xG-Fwf9F0Q7kNvwFJEXvV&_nc_oc=AdoqGnZo-umNhLn0EmunAKxAah32ucmu5MifXrW21ujTH59z-Hfi971SHvkgQKiz3YU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7RJPF0ynSr8b1zeC4u-TFO1q-u4nUtFCaFJRp3V-2ew&oe=6B0EF777"}, "display_name": "Cyber Ninja: Tokyo Rumble", "keywords": ["Cyberpunk", "Action", "Sword", "Japan", "Ninja"], "long_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas.\n\n# Dynamic Japanese Battlefields\n{1796858867959335}\nFight across Japanese sandbox stages inspired by different eras, from Sengoku castles to modern city streets. Explore freely to discover weapons and skill orbs that give you an edge in battle.\n\n# Skill-Based Combat and Weapon Variety\n{2720757318293504}\nMaster skill-based combat with precise parries that create openings for fast counterattacks. Ignite your weapons to unleash devastating strikes using swords, axes, rapiers, and more.\n\n# Devastating Energy Techniques\n{959824406676423}\nUse intuitive finger movements to form hand seals and activate powerful techniques, from lightning strikes to plasma blasts and sweeping energy waves that overwhelm groups of enemies.\n\n# Customizable Combat Style\n{3616084398568362}\nEquip weapons and energy abilities to match your strategy. Adapt your loadout to counter enemy types and refine your unique ninja fighting style.\n\nSharpen your skills, adapt your strategy, and rise as the ultimate cyber ninja. The battle awaits.", "short_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968
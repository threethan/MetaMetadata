/v/t64.5771-25/499622315_1550831623088488_5473515242924439434_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqApyGOlwPIQ7kNvwGMhDmm&_nc_oc=AdorVYgklUwMWG72yToKu8NtNhzz16czMoJMi0cc6CnKla4I79h_Lbpb5l_a-F6TPAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkLu1-BLiX5Ta2B9inYKrzIHpq3qYcx3QpfmQgvJbaVQ&oe=6B045F42"}, {"file_name": "CNTR_SCreenShot (5).png", "id": "2256189041804529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619450_2256189045137862_1058388512810994987_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBk6M92b1uwQ7kNvwH_qu01&_nc_oc=AdrMrdqDlOWy-VOmYphOTDQat9YVsUQnNeJHfw6O4tYiCX_a56HJtJGX7p2NNvDG_HI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDjEzwHzyFRwSYRJRGiu1330AoTlqjAuNnqxmd76bBwA&oe=6B045F37"}, {"file_name": "CNTR_SCreenShot (6).png", "id": "2625691587888719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_2625691594555385_7105094618478170625_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucFPqaevVe8Q7kNvwFxHpLC&_nc_oc=AdowXJzyokHXPyD8_UjUMbyKwG1wPGE7YG8eTZ0-9n2wMrkOdSW8IfnHMKLDt8M9xz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa6Ihcg2j5ULybIJeRnsuheZXlge6kdkwNNQCkaorQTg&oe=6B048AAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CNTR_CoverImageSafeAreaTemplateLandscape_07_ZK2.png", "id": "1879864066720564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620530_1879864070053897_5414403541846181928_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZZICqkPbFwQ7kNvwH5k-lE&_nc_oc=AdovbnkO8Yh827Vy5lh317qEMv-3SO5RC-G-WBQ4P4FWQAzwthbRu-ag58eCRMVpMRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK-KRq8eCTSHmhJBl2obR7wjXaysnjWhzSUG3Jt7UaiQ&oe=6B046B77"}, "display_name": "Cyber Ninja: Tokyo Rumble", "keywords": ["Cyberpunk", "Action", "Sword", "Japan", "Ninja"], "long_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas.\n\n# Dynamic Japanese Battlefields\n{1796858867959335}\nFight across Japanese sandbox stages inspired by different eras, from Sengoku castles to modern city streets. Explore freely to discover weapons and skill orbs that give you an edge in battle.\n\n# Skill-Based Combat and Weapon Variety\n{2720757318293504}\nMaster skill-based combat with precise parries that create openings for fast counterattacks. Ignite your weapons to unleash devastating strikes using swords, axes, rapiers, and more.\n\n# Devastating Energy Techniques\n{959824406676423}\nUse intuitive finger movements to form hand seals and activate powerful techniques, from lightning strikes to plasma blasts and sweeping energy waves that overwhelm groups of enemies.\n\n# Customizable Combat Style\n{3616084398568362}\nEquip weapons and energy abilities to match your strategy. Adapt your loadout to counter enemy types and refine your unique ninja fighting style.\n\nSharpen your skills, adapt your strategy, and rise as the ultimate cyber ninja. The battle awaits.", "short_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968
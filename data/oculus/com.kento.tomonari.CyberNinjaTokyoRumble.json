SEdjdAijIn4sTqnyrrGtIw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRAMNGXCOzg2jb4Z9X66NL4RZmGiDEpKmynMJCUef1TQ&oe=6AFC92D3"}, {"file_name": "Cyber Ninja Tokyo Rumble (4).png", "id": "964543799537482", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620860_964543802870815_5867953642352276684_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SogNqXss1NoQ7kNvwGj0cvi&_nc_oc=AdoBs9PjumD1P2oGuBB3t6IKZcmUYQVS7yJWGdi6wZn4DCmnjAEfVN4sbeLk5m7malk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUTw5uusklJbA_e8ixUgRrbWnKp3T_wvILUdWsGNeQoQ&oe=6AFC5E5D"}, {"file_name": "Cyber Ninja Tokyo Rumble (5).png", "id": "2279485779250658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623601_2279485782583991_7278517350061230800_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfrz8IbjYqwQ7kNvwFMT45r&_nc_oc=Adra9rILHMQhRz-PurRmwFEbouu36ZyU3u-BXM3kEqT6xppAUdVM-0o-FuhjeJRckQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvOxz-zgRSLHrABkc9yi7-FmC3URL2qS6xro8I_zzdXg&oe=6AFC857B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CNTR_CoverImageSafeAreaTemplateLandscape2.png", "id": "956840394014170", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620940_956840397347503_6698956323470587749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRtEDk_7t4sQ7kNvwHZz6O_&_nc_oc=Ado0Mgyzd2YVWbxHDPmpURt1oTwQnV04C0-WVQu4gDanY814_tL2MozG58Ojf3mW3bk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq45d-5as074j1PQHpCcJQFJeag7PW7IGDYOn5Nr2Evw&oe=6AFC89F1"}, "display_name": "Cyber Ninja: Tokyo Rumble", "keywords": ["Cyberpunk", "Action", "Sword", "Japan", "Ninja"], "long_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas.\n\n# Dynamic Japanese Battlefields\n{1796858867959335}\nFight across Japanese sandbox stages inspired by different eras, from Sengoku castles to modern city streets. Explore freely to discover weapons and skill orbs that give you an edge in battle.\n\n# Skill-Based Combat and Weapon Variety\n{2720757318293504}\nMaster skill-based combat with precise parries that create openings for fast counterattacks. Ignite your weapons to unleash devastating strikes using swords, axes, rapiers, and more.\n\n# Devastating Energy Techniques\n{959824406676423}\nUse intuitive finger movements to form hand seals and activate powerful techniques, from lightning strikes to plasma blasts and sweeping energy waves that overwhelm groups of enemies.\n\n# Customizable Combat Style\n{1990968715144614}\nEquip weapons and energy abilities to match your strategy. Adapt your loadout to counter enemy types and refine your unique ninja fighting style.\n\nSharpen your skills, adapt your strategy, and rise as the ultimate cyber ninja. The battle awaits.", "short_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
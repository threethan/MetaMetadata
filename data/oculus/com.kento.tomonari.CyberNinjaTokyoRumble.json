cxoKfxYKnpfB3IRwTquqv7ToIqAUoJ6w3dg&oe=6AF9D342"}, {"file_name": "CNTR_SCreenShot (5).png", "id": "2256189041804529", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619450_2256189045137862_1058388512810994987_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_JfoPIELq0Q7kNvwEghXG3&_nc_oc=AdrtA8_e5nbZkiS-BcOEqfGC_xPi7pFhgeIdY34fIwYWcR5ikbwUkqW7ZrWhIIJQGPk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnkKuPyaciawGBRFyqHdroomt2b9TnVPdtGk9RHKp2Bw&oe=6AF9D337"}, {"file_name": "CNTR_SCreenShot (6).png", "id": "2625691587888719", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622211_2625691594555385_7105094618478170625_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3oMLrh58lUQ7kNvwEIBiWp&_nc_oc=AdqDRKxHWVyKYx0t46jyBdPBMep1tKp_xh8Ip5bPC_fqwtaRWZZo8GHy-gSmXGpG3k0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsduGCxkdvhmADM9f5h8bZwf14DHcVXW-CMsdnUL86Lg&oe=6AF9C66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CNTR_CoverImageSafeAreaTemplateLandscape_07_ZK2.png", "id": "1879864066720564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620530_1879864070053897_5414403541846181928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYNKARntwSIQ7kNvwEfqwQ9&_nc_oc=AdrYNx4mra64b0cTE0FcNGWB3HbMqSR75Gg7MN60AygAti9I8cKanItFW8ZA1foS_Z0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThvNJvW6PAeYLQtkVBKgKTeVR1HJ70djnuH4wqTyheaw&oe=6AF9DF77"}, "display_name": "Cyber Ninja: Tokyo Rumble", "keywords": ["Cyberpunk", "Action", "Sword", "Japan", "Ninja"], "long_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas.\n\n# Dynamic Japanese Battlefields\n{1796858867959335}\nFight across Japanese sandbox stages inspired by different eras, from Sengoku castles to modern city streets. Explore freely to discover weapons and skill orbs that give you an edge in battle.\n\n# Skill-Based Combat and Weapon Variety\n{2720757318293504}\nMaster skill-based combat with precise parries that create openings for fast counterattacks. Ignite your weapons to unleash devastating strikes using swords, axes, rapiers, and more.\n\n# Devastating Energy Techniques\n{959824406676423}\nUse intuitive finger movements to form hand seals and activate powerful techniques, from lightning strikes to plasma blasts and sweeping energy waves that overwhelm groups of enemies.\n\n# Customizable Combat Style\n{3616084398568362}\nEquip weapons and energy abilities to match your strategy. Adapt your loadout to counter enemy types and refine your unique ninja fighting style.\n\nSharpen your skills, adapt your strategy, and rise as the ultimate cyber ninja. The battle awaits.", "short_description": "Cyber Ninja: Tokyo Rumble is a high-speed VR ninja action game set across multiple eras of Japan. Wield blades, unleash devastating energy techniques, and battle robotic armies in immersive arenas."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/cyber-ninja-tokyo-rumble/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
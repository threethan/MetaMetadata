rI8Q7kNvwG0LI-Q&_nc_oc=AdpkkHA9Pcdf-jDGhE4ON7QoKWUk-Cq4dhCMkSzP5-0oKcdjwMk_ggEX9M_NHfyJR9A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxPW8ST4kGNoXNgaBWiQIQr0XGwpgTU3Olg9WoY4hpSg&oe=6AFB3E1D"}, {"file_name": "migrated_image.png", "id": "621510495360016", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue76hdPANsoQ7kNvwH54qhi&_nc_oc=AdqzpT9VwlVv_JLAnBPnAlyX-dS3r9odP5eqQO9HyNq-gAfLg_4x0ZMpw7XNcOoo_YA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnECS6IbNIxphS8dBtu-HdCquDZEiLy3Z-n-7QyT9XiA&oe=6AFB3497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video.png", "id": "1731194897189193", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162703_1731194900522526_3329691091489259520_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E9duD_afTcQ7kNvwFch1sL&_nc_oc=Adqwo-IQIqT4Bq6NZxbmZmzbq_Lg9f_XkIDucuJ6di2pDTDKEcj0lOySL35Q9g1Q52s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIQfQlVs9WOOxdl3gNomey7jokZhMySPTL4FLI7ZY7LA&oe=6AFB24B4"}, "display_name": "ECHO MINI GAMES PARTY", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "CASUAL", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "357204546247986"}}]}, "scheduled_offers": {"count": 24, "nodes": [{"status": "PUBLISHED", "id": "131476361040316"}, {"status": "PUBLISHED", "id": "772077319660515"}, {"status": "PUBLISHED", "id": "197361378234955"}, {"status": "PUBLISHED", "id": "2333006997018293"}, {"status": "PUBLISHED", "id": "545543956199096"}, {"status": "PUBLISHED", "id": "326047471676541"}, {"status": "PUBLISHED", "id": "1873505152768438"}, {"status": "PUBLISHED", "id": "2214027495538936"}, {"status": "PUBLISHED", "id": "1365774316888395"}, {"status": "PUBLISHED", "id": "378609746313073"}, {"status": "PUBLISHED", "id": "760779834125747"}, {"status": "PUBLISHED", "id": "757106694474421"}, {"status": "PUBLISHED", "i
a&_nc_ohc=Y1fu6_5z2voQ7kNvwHW4nap&_nc_oc=AdlE9b5CnyAbCCpYwvle8S_13KpPDLxdR1ZZsikycUFXIKllsPiAwayBOfjiKf64fCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKT3P62vLW0aAM13Lz8K7eCgJEfgJEoMeuokeg8mG3qg&oe=69B55A85"}, {"file_name": "migrated_image.png", "id": "209986626885514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_1458329190919257_8428949816062509056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAZ1uv7Jmz8Q7kNvwFCUgGy&_nc_oc=AdmstxR9a7dUWW1zuXWcAeP-ojPkT9fVRKf3pWskpuIuRei0fMzk6Exf5Td9top_fW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk5YnPXd9Sqeile7NdI_OFkAOfZd-B_G_VW3JUoTqnRg&oe=69B5635D"}, {"file_name": "migrated_image.png", "id": "237553817376313", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTIp9VHnUHQQ7kNvwEaSexM&_nc_oc=Admk3acFRBfxigDLs7sNQgOBOJbVZuv3z15G7_M_pVLXHmURqWNzkSWrwB-rC4dbQH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp4MprqTzENU9D85omMiu04mtWzfwSVHkeejnw78OwtQ&oe=69B559D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Mini Games Party", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330303455699553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139007_1487591181367892_7238696215200661504_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXWEQ7emnU0Q7kNvwGEPydn&_nc_oc=AdkWURqtCgd32idKT7gk5ZUSrmhrp9qFibVhXHlmTKhXZej_YsZ9O1ElH1WzNO9O1L8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0idKao5bQM3oE-wMtq4Re1LopbPic8Iu7w4_BoPYjjQ&oe=69B54F8C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Echo Mini Games Party", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513792800, "lastRevision": {"nodes": [{"id": "732296410305221", "release_type"
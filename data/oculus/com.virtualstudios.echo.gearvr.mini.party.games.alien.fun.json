=00_AQQF1HygPfrz2bzeuvgHt8xqfgLDO7V3D_BagS8GoUXq_g&oe=6B046B23"}, {"file_name": "migrated_image.png", "id": "212879443129901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_248329572359190_2544952097804124160_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSX8BdKihFcQ7kNvwF0psJi&_nc_oc=Adrpld9bCUkeY80qoJfP4Hota8L90vXsoVxT8rWIV2o6d9f6H-g-DOkbdaNFlcw8IN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUxLZkIsRRWVkVBg2jZZU9VGgqmaPKcsDEU6RaGm-Qcw&oe=6B046FC5"}, {"file_name": "migrated_image.png", "id": "209986626885514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1458329190919257_8428949816062509056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ9_nUs7WOsQ7kNvwFcWfsu&_nc_oc=Adpl__iontAamt6-Q5qHyccbQcxHW7GU0YiFIXScnrpTu08ccHXjbVMvbGCvw14jvDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3wJ5zkqRCFcEL6KUEzN7cXxCklaeD2aGUpBsM1QTJ8w&oe=6B04789D"}, {"file_name": "migrated_image.png", "id": "237553817376313", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28AZaWWX0QUQ7kNvwEPxBA5&_nc_oc=AdrcEsx_rQxd8H4O0Tf3ymr7_nsKgCP-EHr_W1WsKV-N_TTAu8XTk49Up1OStLa5y5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg6CTYRvS1bD7YQ0G55_vpKolPwuHHmpo_n50PcYD4kw&oe=6B046F17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Mini Games Party", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330303455699553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139007_1487591181367892_7238696215200661504_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpM3BCRXA30Q7kNvwHhbI4P&_nc_oc=Adq8Fhe18cCE7gXbOLiuceonA2S5ztXyssVUilZ723tpR0Lpwbwe4IQfY6IwGk0jV00&_nc_zt=3&_nc_
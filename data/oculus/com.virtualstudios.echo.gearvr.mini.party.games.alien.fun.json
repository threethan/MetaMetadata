png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8fQ5JqDFJMQ7kNvwHl_RV7&_nc_oc=AdrhaZd4-AkL_s9n2w2QXxTZAr3OgYKtTfdb8qLnsKEmsnBbP8FrweoThrBVOlHIXsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1hjB5uMUnboPdX-s_B4Pl583_UojHw7fyEGySQW686A&oe=6A5CC905"}, {"file_name": "migrated_image.png", "id": "209986626885514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1458329190919257_8428949816062509056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4jJoWfS1W4Q7kNvwEEfPy4&_nc_oc=Adr1_moUiYkjm7d6fg4ANRJrX4_tW-FStFwT92SAx7tP-xXIeIPE8CLc_4tvoRFRFmM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDumVQoFza-gmzNxzRdKzoqs0nTuzGGO-D4dDdWAgYXKg&oe=6A5CD1DD"}, {"file_name": "migrated_image.png", "id": "237553817376313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCFCFxURerwQ7kNvwFmYOFJ&_nc_oc=AdoPqGcd3gsViLWoTPftgHq8_pdl5zU7IQJBLjOpvfddfaV-kmDpzN07_bPGImHTqMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT_YG4E8cp0qOShiixWWDxdfERZX9SXWuFBckRVc_HTQ&oe=6A5CC857"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Mini Games Party", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330303455699553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139007_1487591181367892_7238696215200661504_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0ypAzEiXgQQ7kNvwGcqaie&_nc_oc=AdpNYl7DTvk1dnvn8DGQwsuUdYR8bkIybJvSEmhQ3CZR4_GV7Ne07TutLSiGHk5gbqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYp6bAwDRPtkrjGMKIkwP07QZgr0TvNSBMgwmlR7Lu8Q&oe=6A5CBE0C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Echo Mini Games Party", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513792800, "lastRevision"
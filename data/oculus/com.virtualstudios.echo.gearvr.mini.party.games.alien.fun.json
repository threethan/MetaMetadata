png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztNpOTZSZjQQ7kNvwGRz5xL&_nc_oc=AdrYN3-stkHJxqHJwJGQ8I8n8xM40Am8fRMwJDDDAQZ3qUlBt8obxgZa0i3AqE7LYEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qd1LkkxVFLcnuHeMSwIn9dNsta0p8Y-Glu3xcyOmfvQ&oe=6A086905"}, {"file_name": "migrated_image.png", "id": "209986626885514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_1458329190919257_8428949816062509056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iO7X06zAxEQ7kNvwHg2DS5&_nc_oc=AdoxSFMMSuJYsKsEnr3e64iJd15E3aU-tkPLqfZO3Kvw56jC8zQIVbpa7cSttj_6WBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sk7Dof79v8LtLjECppJBhFL3Cl9iq3eQ7ARUD1IoLeg&oe=6A0871DD"}, {"file_name": "migrated_image.png", "id": "237553817376313", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0ZLQhTFe1cQ7kNvwGqx9k4&_nc_oc=AdoVTCe4PW9vBjmOnAvA7n0_HzyF9Z9G6GOIT1H_SRlXhHmm41TRLj5tv2Z5jE4KR6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jTl2gGCdMVFmLMSjm1_AhwI-rZgeKHFtOVS30JsuLaA&oe=6A086857"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Mini Games Party", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330303455699553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139007_1487591181367892_7238696215200661504_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHDTEeUN0B4Q7kNvwEVNN2C&_nc_oc=AdqWFz0pD3QfOgcP_OTRqxWQ7pnT0eHPt03EXK24IF5Yd4ytcOtF_C0dLjPy3OrZrvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af594xyHkmigm9eP4NEklNzySAAtsacfJxt-Iw81_noxlw&oe=6A08964C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Echo Mini Games Party", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513792800, "lastRevision"
J-3s0O1Z6dSRoPC1JkVBwq1pOlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIphy-lEeH2OwYkE4scSLj2EwO2dcKh6lWjbOz0J7CAg&oe=69A04285"}, {"file_name": "migrated_image.png", "id": "209986626885514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_1458329190919257_8428949816062509056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQsS9rqPqQ8Q7kNvwFc7I7H&_nc_oc=AdlhLDzbqWSj8hrFoquDO1f0D1_sX9BI_Vs4AcLRrPGIDVckmNFyQvoaRU85dt7CShg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHnhx1Da1MWYNKFFczyfLkCAQ6FDd2jpurKl5oxQQaqQ&oe=69A04B5D"}, {"file_name": "migrated_image.png", "id": "237553817376313", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bqd5NhzJDcQ7kNvwHSkq45&_nc_oc=Adn09m7y7bOZYOBqlgveX9aXvLpQLhXHDXiUjkKw9iQz1RkW7PE1TJYXaYBRJFHUsSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFZ4H1yhiFDO5UjdWEoH-Wzt5pcHR8ymSZuDtlIuZDpw&oe=69A041D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Mini Games Party", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330303455699553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139007_1487591181367892_7238696215200661504_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCaI3x7BGPIQ7kNvwHq4YF3&_nc_oc=AdkszyrAXIuOjtdSr1tSkt7s8fpYkDSDxP-SEq3iDzESike0Rv939AbL_A_7DTpc_LE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvcng5YtQKDwIE6lrLZrUZDUSEKaplxh24F7HxzOiT_UQ&oe=69A0378C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Echo Mini Games Party", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513792800, "lastRevision": {"nodes": [{"id": "732296410305221", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id":
=00_AQUuEH6DEMsMaO7Wz8HZ6WfRHR2UH8x4fDA5tazBD2mHWg&oe=6B1048A3"}, {"file_name": "migrated_image.png", "id": "212879443129901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_248329572359190_2544952097804124160_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywOR7g6HP84Q7kNvwEBlujA&_nc_oc=AdrhnMVklEmVUOBOx3wx4pHEwhJL50XmaIDCtFjwMSgzlfl_mkfrPUk-J_7Dzo_J0v8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXr4Xl2-lSGRBp8MxMdvhYPxhsCMRSsQ-2pfH7cGs2Y4w&oe=6B104D45"}, {"file_name": "migrated_image.png", "id": "209986626885514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1458329190919257_8428949816062509056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d7YeNRXDzAQ7kNvwHoFnkD&_nc_oc=Adp7fArFx9EGUfQyCC0j1NvJT5bRC_QOjwQw5qmNaYvlIaHYmgJyTPHam8_RHwKN8dA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_t9UI8YwSzDwRihPoblZa2ZO-kx_UxDA1udhvinC4Sw&oe=6B10561D"}, {"file_name": "migrated_image.png", "id": "237553817376313", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilWDYc2E0cYQ7kNvwGAqd5F&_nc_oc=Adq0MI77MKl7_SOkHOiQ3MxldH1TQ7NXRNLyaxQ-VJf7ZrhJvZGyjJdTVWNOqhfUUFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWajuEswhHc-aPFk6-fbMjnGaSuvTuaO5jvCXg_AdVBeQ&oe=6B104C97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Mini Games Party", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330303455699553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139007_1487591181367892_7238696215200661504_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjAlmDyAuTkQ7kNvwFVzVHU&_nc_oc=AdrqcWvu3LET-rMmn6Z4hhBqXwWo2HS-meEigciRp1_UEtA1nBuiIcHSqXeg-Ew8xHE&_nc_zt=3&_nc_
=00_AQQqdfslNRgcST7PWKHgRTwjflCIjRzg6Z9_RyUM9AtZXw&oe=6B070E23"}, {"file_name": "migrated_image.png", "id": "212879443129901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_248329572359190_2544952097804124160_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkDKiE_L3m0Q7kNvwG2qHl6&_nc_oc=AdoyOYvm1bGHifBVJw4s6rFrkp_pmKT3RL-Z2QnMdOwM9z_9TyojUzJZscR-kB9_AGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYAIC4jM3WY6ZY5y7sh1x5F7mRCIV9yzjL7FDD2cQnPQ&oe=6B0712C5"}, {"file_name": "migrated_image.png", "id": "209986626885514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1458329190919257_8428949816062509056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ9_nUs7WOsQ7kNvwEspwjd&_nc_oc=Adq3qtR4QqSMsptCVr7qGv2LEJKqVBi3wkKkF_yuwKj33EiP5YMwDyysh61pGob7Q9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-TjH5ZbxzB7iI-8fRi2LhX1Q9F0CqKrqGAtOMVP_UGw&oe=6B071B9D"}, {"file_name": "migrated_image.png", "id": "237553817376313", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_121103851897667_3828102985125199872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XppdqZMNAv0Q7kNvwEW17Mh&_nc_oc=AdrpxMlj2Gq0_cbWLueUyPCpgMHR9E53jZZyCX5J3uU0vYfxy4gjFy69YlPPnaRkjMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1nNd1huYh0LaQTQnFg6m1YsSTeXT5JJ-qCwfYMF3-sw&oe=6B071217"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Mini Games Party", "keywords": ["mini", "games", "quiz", "puzzle", "challenge"], "long_description": "ECHO is a funky alien.\nECHO likes playing games with you.\nBut ECHO doesn't like losers.\nNever lose against him... Otherwise he will kill you!\nTry to survive the challenges that ECHO is preparing for you!\n\nGame List :\n- SHIFUMI : The classical game where you have to choose between Rock, Paper and Scissors !\n- LIGHT GAME :  Try to reproduce the lighting sequence !\n- TIME BOMB : Play with a bomb, but when will it explode ?\n- TIME BOMB 2 : Play with a bomb, but when will it explode ? Your score grows up as long as you have the bomb.\n- LAST ONE : Don't be the last to keep the ball !\n- FIND ME : Try to find ECHO before time's up !\n- HIDDEN BOMB : 20 balls, one of them is a bomb !\n- MEMORY : Try to remember where are the correct balls !\n- BONTO : 3 Boxes, one ball, try to find it !\n- SPEED TOUCH : Be faster than ECHO to touch the speed button !\n\nMany more games are coming on the next updates !\n\nFrom creators of Beasts of Legend VR!", "short_description": "10 games in 1! Try to survive to ECHO's challenge! Have fun with your new friend!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://echovr.virtual-studios.fr/", "developer_terms_of_service_url": "http://echovr.virtual-studios.fr/", "publisher_name": "Virtual Studios", "support_website_url": null, "website_url": "http://echovr.virtual-studios.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330303455699553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139007_1487591181367892_7238696215200661504_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpM3BCRXA30Q7kNvwHKYGX7&_nc_oc=Ado2UrrYwwJs1AoLI4jquU9kfIEGOTJljBhLSHyFvloX0jeSAhypJvpTJu7vTguJKiI&_nc_zt=3&_nc_
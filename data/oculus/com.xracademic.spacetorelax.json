ow rides that are perfect for any busy professional or student looking to quickly unwind in a 5-10 minute break period. Enjoy three unique classical pieces included with each scene, or choose your own tracks from your phone's files.", "short_description": "Sit back, relax, and watch stations twirl and spaceships going about their business while you meander around scenes above the Earth, the Moon, Mars, or Jupiter with included classical music or music from own your selections."}]}, "developer_name": null, "developer_privacy_policy_url": "http://xracademic.com/MPP.html", "developer_terms_of_service_url": "http://xracademic.com/EULA.html", "publisher_name": "XRAcademic", "support_website_url": null, "website_url": "http://xracademic.com/spacetorelax.html", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2571360373007523"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_106519463458396_3729042789963399168_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HJFOf7rFxUQ7kNvwExHkh4&_nc_oc=AdmjUKa7UWCfIvO2xwN0ne6DTfGXnD-Vl_mxQnOpnxtGS-NZ9UbqotSdluxXseseSGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyI-ndlQRQNInOgMTcY6Sw2n9_sUZB2VcplZPdO0LJttQ&oe=69B95481"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SPACE to relax", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1516
.\n\nPvP Battles: Challenge players worldwide in intense player-versus-player fights to prove who\u2019s the strongest gorilla.\n\nFight Mode: Take on powerful opponents in solo or team combat scenarios packed with action and strategy.\n\nMod Menus: gameplay experience with mod menus that allow you to tweak and enhance your gorilla\u2019s abilities and environment.", "short_description": "RTX Gorilla\nExperience fast-paced gorilla action with stunning RTX-enhanced graphics! Swing through lush jungles, battle fierce opponents, and unleash your primal power in this visually immersive adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-fun-vr/home/rtx-gorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GrahamVr", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-fun-vr/home/rtx-gorilla", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9968740243174751"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "858275073988605"}, {"status": "PUBLISHED", "id": "774175498614029"}]}, "baseline_offer": {"id": "774175498614029"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "858275073988605"}]}, "liveChannel":
649188_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MmgFkZQuYIQ7kNvwGFJ62V&_nc_oc=AdqPXHqCCMqp2JTQXbz6Zrf92kIAAEZqHmwngAfG_AQMBgfOlD9wvawLEwNyaoXkvWI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_M1HnRtB4KlWVUKCSMrBm62ufIum14u3PjCXV0LgzLQ&oe=6AFB4BB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RTX Gorilla", "keywords": [], "long_description": "-RTX Gorilla -      \nMultiple Exciting Game Modes:\n\nSandbox Mode: Explore the jungle freely, test your skills, and unleash your creativity without limits.\n\nTag Mode: Engage in thrilling games of tag with friends  where quick reflexes and strategy win the day.\n\nPvP Battles: Challenge players worldwide in intense player-versus-player fights to prove who\u2019s the strongest gorilla.\n\nFight Mode: Take on powerful opponents in solo or team combat scenarios packed with action and strategy.\n\nMod Menus: gameplay experience with mod menus that allow you to tweak and enhance your gorilla\u2019s abilities and environment.", "short_description": "RTX Gorilla\nExperience fast-paced gorilla action with stunning RTX-enhanced graphics! Swing through lush jungles, battle fierce opponents, and unleash your primal power in this visually immersive adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-fun-vr/home/rtx-gorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GrahamVr", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-fun-vr/home/rtx-gorilla", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQ
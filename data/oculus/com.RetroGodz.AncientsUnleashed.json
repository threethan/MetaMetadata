BL&_nc_oc=AdpBCE07EUGxCuDqDAwQ2ZtNHiPBB8--eLOVUa2gsTBqZDXkrVD_l-sZDxFlV7IkNGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKcAUFvcUdskRhcSzG1G7hjECDT5EdgwzG25IZWQw9PQ&oe=6B0482DC"}, {"file_name": "Screenshot 1.png", "id": "3764282367140241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75608443_3764282370473574_1005041458116167541_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8RHNh15XrcQ7kNvwGfrwpX&_nc_oc=AdpIg9W3ibftHrPkz9XptYyprSSWVS5o-kfzTNW8amMNJubh2Kv6PPmX39N0WUqn0OA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSP0FxLcK4J4NPp6uGJbXmOIYq1VedaLHft2DzIz_Rtw&oe=6B046F3F"}, {"file_name": "Screenshot 3.png", "id": "1075269113692064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_1075269117025397_6447006048606872967_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i38pz-LXpHAQ7kNvwFi7fyq&_nc_oc=AdrW3e-wxkpWdOsEtFBN0tDJ44sg-wQPi1YcZPiVxSq4DGIvWkjgv5xyJaNZmNxWweA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU7PNtUkVURZYGbSFYUdF7ZZRK95gHP2zrvixdmscb-A&oe=6B045491"}, {"file_name": "Screenshot 5.png", "id": "401946459048030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974744_401946462381363_835392156508568465_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B49RvpyK-Z0Q7kNvwEpYzrS&_nc_oc=AdqkUFh6sNAdrxEXQt3m2EsblBopiMt7RZlPle53qvGsAEUVLjb3aDVp2SHLnTpM2ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ02dVXTZay8qKLKt112uP5fHOGsgxUdwW5uTuy6H9KhA&oe=6B0467E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AU Text  2560x1440 Format.png", "id": "706845304976591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036616_706845308309924_8280624660867497005_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xs5SEofnNywQ7kNvwFRty5O&_nc_oc=AdqMTQpHg8qq35rryynGBinm-P_cANAEc0VEILYYO_MGqSfSYwV4avC2Kjk87Cy6FmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW5bVuczca8FEXjq0AcoFyItAHuYi_jqUedKanZ4qJ6Q&oe=6B04825A"}, "display_name": "Ancients Unleashed", "keywords": [], "long_description": "You\u2019ve been slighted for the last time.\n\nMinor demi-god or not, why should the fools on Olympus get all the praise, all the glory...and all the gold and virgins?\n \nCenturies ago, it is said Zeus stripped the divine essence from all of the gods, consolidating the Pantheon\u2019s power under his grasp.\n\nSince then, the balance of the universe has been lost with no one to challenge the Great God\u2019s will or temper his petty whims. It\u2019s time for that to change. \n\nBut to overthrow the godhead, you must amass your own power. Topple the great Titans, \ndestroy the vile demi-gods and slaughter mass hordes to challenge Olympus. For the sake of mortals and gods alike.\n\nWill you fulfill your destiny?", "short_description": "Immerse yourself in a relentless battleground of mythical hordes, divine chaos and epic landscapes. Challenge heroes to gain skills, hone divine powers and take your seat as a god.  Will you rise to the occasion, chosen one? Your odyssey has only just begun."}]}, "developer_name": "Avrio Analytics", "developer_privacy_policy_url": "https://retrogodz.com/privacy-policy", "developer_terms_of_service_url": "https://retrogodz.com/user-license-agreement", "publisher_name": "RetroGodz", "support_website_url": null, "website_url": "https://www.retrogodz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
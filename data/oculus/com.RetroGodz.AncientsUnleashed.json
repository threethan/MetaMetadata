/t64.5771-25/75608443_3764282370473574_1005041458116167541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1c4dE7TRmUQ7kNvwFTci5d&_nc_oc=AdpfM9z93KZp7yX6VeQ4oEMSJ_-UzeaCQZLu_1ZHPcoE4q-J97TOI_sY0ag0zXCkI3I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af10tsSCEyzmDzERsgoxnLAg78IYZ6vbOiGZnw1ThwyVLg&oe=69F1FEFF"}, {"file_name": "Screenshot 3.png", "id": "1075269113692064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_1075269117025397_6447006048606872967_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ERxBbhPHnIQ7kNvwHJFGAM&_nc_oc=AdpZ0GvSoIYCXp3il1SiCi5F9emyQfe7KNEAzNGHWnURl2UotSjF_meWzzX3vNsrGnc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dkZdqBz26QGO6yASl50pDHk6R_hR0CNlDhlcKcyCGtA&oe=69F1E451"}, {"file_name": "Screenshot 5.png", "id": "401946459048030", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974744_401946462381363_835392156508568465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_BFkr42rzsQ7kNvwGKhLPO&_nc_oc=AdrlvQvaqmEWVczX8I_X5LTrIQhYgoDu5xmWsk4froX9eA0m0UuLpaSYpM1UwB8P4Q8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mJTwMeufVp6j_GxrAMpLzU-5nIA9ACmEcVrXRULepWA&oe=69F1F7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AU Text  2560x1440 Format.png", "id": "706845304976591", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036616_706845308309924_8280624660867497005_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc0Q7BELo40Q7kNvwEgiDDf&_nc_oc=Ado3OiyTUgZ9sremRj1p7QCYeM6Ysp92qtlAFZRs_ZxogMtUipa3v97VYAC30PCRhVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af243TFQmenD8ZPgnZyAb0inT4CceTp9c83jBuWXE7ttVQ&oe=69F2121A"}, "display_name": "Ancients Unleashed", "keywords": [], "long_description": "You\u2019ve been slighted for the last time.\n\nMinor demi-god or not, why should the fools on Olympus get all the praise, all the glory...and all the gold and virgins?\n \nCenturies ago, it is said Zeus stripped the divine essence from all of the gods, consolidating the Pantheon\u2019s power under his grasp.\n\nSince then, the balance of the universe has been lost with no one to challenge the Great God\u2019s will or temper his petty whims. It\u2019s time for that to change. \n\nBut to overthrow the godhead, you must amass your own power. Topple the great Titans, \ndestroy the vile demi-gods and slaughter mass hordes to challenge Olympus. For the sake of mortals and gods alike.\n\nWill you fulfill your destiny?", "short_description": "Immerse yourself in a relentless battleground of mythical hordes, divine chaos and epic landscapes. Challenge heroes to gain skills, hone divine powers and take your seat as a god.  Will you rise to the occasion, chosen one? Your odyssey has only just begun."}]}, "developer_name": "Avrio Analytics", "developer_privacy_policy_url": "https://retrogodz.com/privacy-policy", "developer_terms_of_service_url": "https://retrogodz.com/user-license-agreement", "publisher_name": "RetroGodz", "support_website_url": null, "website_url": "https://www.retrogodz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9062052053846508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443235_911369684027974_213786881953061535_n.png?stp=dst-png_s360x360&_nc_cat=107&cc
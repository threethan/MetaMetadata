te&_nc_oc=AdouL8mKwa2NtbMyQqOGI0956HEfgz-yonOt-GUYixuHfHX5_p7XJ2csBnrFSjxoQWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXMnx609W6EMNdN9bmZq_qzocZF8IyYmS3cjtjlfhy8bA&oe=6B0F0EDC"}, {"file_name": "Screenshot 1.png", "id": "3764282367140241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75608443_3764282370473574_1005041458116167541_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDsyQvk-Po4Q7kNvwGL4MYI&_nc_oc=AdrORxKQ1SNIqxSxaMItlVCoSQhjXsj_V4oxIxW1ZOgL7m9eQindnMuV-rCfjgvh8F0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAdRB6nQcq23B8YA2a82vAgv3peY6X_XV1BUHuRKu9ZA&oe=6B0EFB3F"}, {"file_name": "Screenshot 3.png", "id": "1075269113692064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_1075269117025397_6447006048606872967_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBlrWcO50bYQ7kNvwF2Im6d&_nc_oc=Adp-4D8I-n-d1LjsRen0GGnKEBjy4SaZS0Ourdm9wG51WxXdsR_MxT36zKvjIzRVyNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW__mu1iKc8FDUvXvN0UqFAk2kqdwL66RyxtiiLv-Kniw&oe=6B0F18D1"}, {"file_name": "Screenshot 5.png", "id": "401946459048030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974744_401946462381363_835392156508568465_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekzYkU33PjYQ7kNvwHgmQui&_nc_oc=Adr-1LXL7q-eZ-a2zmjlr9aBNbDxZ1P_g1Y49ZR8ZB5_6TThHIjgoFNTtdp4S1iKYRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1WuTas0Mm8aTyV0_VtrWAu8oTBx-0lAcst0hHMp_S7A&oe=6B0EF3E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AU Text  2560x1440 Format.png", "id": "706845304976591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036616_706845308309924_8280624660867497005_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRG9tSJ4Vv8Q7kNvwFWWCQI&_nc_oc=AdrqcwYk3cSSv4KDAyMgUBw89Z1I6ONJnY0G0xzaSJaK_6YVcxI-xPqh8d7cAm-0jzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUR2a64cGOVVmH1IBGhqoNtYkqJcm1yZXioaD0THrCcPA&oe=6B0F0E5A"}, "display_name": "Ancients Unleashed", "keywords": [], "long_description": "You\u2019ve been slighted for the last time.\n\nMinor demi-god or not, why should the fools on Olympus get all the praise, all the glory...and all the gold and virgins?\n \nCenturies ago, it is said Zeus stripped the divine essence from all of the gods, consolidating the Pantheon\u2019s power under his grasp.\n\nSince then, the balance of the universe has been lost with no one to challenge the Great God\u2019s will or temper his petty whims. It\u2019s time for that to change. \n\nBut to overthrow the godhead, you must amass your own power. Topple the great Titans, \ndestroy the vile demi-gods and slaughter mass hordes to challenge Olympus. For the sake of mortals and gods alike.\n\nWill you fulfill your destiny?", "short_description": "Immerse yourself in a relentless battleground of mythical hordes, divine chaos and epic landscapes. Challenge heroes to gain skills, hone divine powers and take your seat as a god.  Will you rise to the occasion, chosen one? Your odyssey has only just begun."}]}, "developer_name": "Avrio Analytics", "developer_privacy_policy_url": "https://retrogodz.com/privacy-policy", "developer_terms_of_service_url": "https://retrogodz.com/user-license-agreement", "publisher_name": "RetroGodz", "support_website_url": null, "website_url": "https://www.retrogodz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
6l&_nc_oc=AdqdyjGnKseYLn6ooOW5sk9zvB4IZWlheAq68G7Kie3jg2bChDgWtr4VVE09K95VGk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF4rmvDzfumnHQA71gOyaM1ywsrvkcBr2LWaADrcyt_Q&oe=6B03315C"}, {"file_name": "Screenshot 1.png", "id": "3764282367140241", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75608443_3764282370473574_1005041458116167541_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8RHNh15XrcQ7kNvwH5tkze&_nc_oc=Adrxmx-YB9OxVtPqAmz5G479XDfmR2vmbXeK0nEd34HihzROoZblFq-9GEpQU9Txt_w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrYy2OW3Y74EhBr14Nt7kbzhP13oDtYz8HXL3vEziJ2w&oe=6B031DBF"}, {"file_name": "Screenshot 3.png", "id": "1075269113692064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_1075269117025397_6447006048606872967_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i38pz-LXpHAQ7kNvwFRQwhY&_nc_oc=AdqOi57_pOGoFd3o89_95bXUvRSwKLDg1SSFJSeoysiScP4jUpWjfEtLrO9LaYHKUIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_KVQ7C2RnnL78BU5sSNjl4j2x0iuSuS5aWPQXRoBYpg&oe=6B030311"}, {"file_name": "Screenshot 5.png", "id": "401946459048030", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974744_401946462381363_835392156508568465_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlBMPX5s654Q7kNvwFHqLDc&_nc_oc=AdqXMYU-nz32ILv3vwZjtQOYXiW9eizquLkL07tv_HJ1EQBI71c60ZF7_aBZKBGgZRQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmsjwMA0UHVapcaSlQ5gRKrki9IKQuaS6aSxsrhYgpYA&oe=6B031669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AU Text  2560x1440 Format.png", "id": "706845304976591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036616_706845308309924_8280624660867497005_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xs5SEofnNywQ7kNvwE2ohUN&_nc_oc=AdqckZ-Cahs5emDCjCDnK-Hmn-yfktmRCEoHkCt-pr5ahlPUyr0BaNoBaPC1gPX62r8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLyHXLjwrWDGXaZS3IENw2-fyUX59a_uw2lUEF-6YCVg&oe=6B0330DA"}, "display_name": "Ancients Unleashed", "keywords": [], "long_description": "You\u2019ve been slighted for the last time.\n\nMinor demi-god or not, why should the fools on Olympus get all the praise, all the glory...and all the gold and virgins?\n \nCenturies ago, it is said Zeus stripped the divine essence from all of the gods, consolidating the Pantheon\u2019s power under his grasp.\n\nSince then, the balance of the universe has been lost with no one to challenge the Great God\u2019s will or temper his petty whims. It\u2019s time for that to change. \n\nBut to overthrow the godhead, you must amass your own power. Topple the great Titans, \ndestroy the vile demi-gods and slaughter mass hordes to challenge Olympus. For the sake of mortals and gods alike.\n\nWill you fulfill your destiny?", "short_description": "Immerse yourself in a relentless battleground of mythical hordes, divine chaos and epic landscapes. Challenge heroes to gain skills, hone divine powers and take your seat as a god.  Will you rise to the occasion, chosen one? Your odyssey has only just begun."}]}, "developer_name": "Avrio Analytics", "developer_privacy_policy_url": "https://retrogodz.com/privacy-policy", "developer_terms_of_service_url": "https://retrogodz.com/user-license-agreement", "publisher_name": "RetroGodz", "support_website_url": null, "website_url": "https://www.retrogodz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
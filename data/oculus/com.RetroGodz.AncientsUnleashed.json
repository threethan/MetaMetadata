 1.png", "id": "3764282367140241", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75608443_3764282370473574_1005041458116167541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC8Ii0Cj3BQQ7kNvwEn5kEF&_nc_oc=Adq93CcpgvELR2CUGN9Ok2iIbndIZMhKk0tmVWFBJzgv0eLh_YCdFb_qNIfYt9yTCCA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_DPDoEs6PPxsuAcQxoIbRhUrf3lDHvVnVHP6ipQc__A&oe=6A22FEBF"}, {"file_name": "Screenshot 3.png", "id": "1075269113692064", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982530_1075269117025397_6447006048606872967_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJzUnbbdXl0Q7kNvwFbVy7J&_nc_oc=AdqDLA3f9O8hjZbNA69Bm8X-pHOxUWBJGTJuqBcgjkzkxbEuykdzyOF3_KgdfT49NLc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h_IyKa_UoU_vszAnRedIGMVwNjnkiT1zJE8MnAXGAMQ&oe=6A22E411"}, {"file_name": "Screenshot 5.png", "id": "401946459048030", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974744_401946462381363_835392156508568465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiTezvMGbMAQ7kNvwF86EuY&_nc_oc=AdqlaFbBwcYLq-lGyg3DctRkP0GkI_Gw1UqrC9a8y8mZ1jfivZ9fRimnweAlMQbAmxI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-AwdShISjqXU9w9yRJpt0c1Np2ggNrJ1AYuBTt5TaqA&oe=6A22F769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AU Text  2560x1440 Format.png", "id": "706845304976591", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036616_706845308309924_8280624660867497005_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM_ViUTXoS8Q7kNvwGUuckd&_nc_oc=Adqv6FHTbcB7xJSKcIE09LBSzECpnHuQeH_Tt0tP71pK81Hwx43v43xBS2qjXt46acg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_quo1O9mdjHNsNperxEEpckB15bjMZDlw9YW-IuUwrBA&oe=6A22D99A"}, "display_name": "Ancients Unleashed", "keywords": [], "long_description": "You\u2019ve been slighted for the last time.\n\nMinor demi-god or not, why should the fools on Olympus get all the praise, all the glory...and all the gold and virgins?\n \nCenturies ago, it is said Zeus stripped the divine essence from all of the gods, consolidating the Pantheon\u2019s power under his grasp.\n\nSince then, the balance of the universe has been lost with no one to challenge the Great God\u2019s will or temper his petty whims. It\u2019s time for that to change. \n\nBut to overthrow the godhead, you must amass your own power. Topple the great Titans, \ndestroy the vile demi-gods and slaughter mass hordes to challenge Olympus. For the sake of mortals and gods alike.\n\nWill you fulfill your destiny?", "short_description": "Immerse yourself in a relentless battleground of mythical hordes, divine chaos and epic landscapes. Challenge heroes to gain skills, hone divine powers and take your seat as a god.  Will you rise to the occasion, chosen one? Your odyssey has only just begun."}]}, "developer_name": "Avrio Analytics", "developer_privacy_policy_url": "https://retrogodz.com/privacy-policy", "developer_terms_of_service_url": "https://retrogodz.com/user-license-agreement", "publisher_name": "RetroGodz", "support_website_url": null, "website_url": "https://www.retrogodz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9062052053846508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/
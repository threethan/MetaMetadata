ct0CSz9TR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxDnG25flHMXzA2808_oA4WCtQhioLDMpzFoeFy96Pxg&oe=69A6BED1"}, {"file_name": "Screenshot 5.png", "id": "401946459048030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974744_401946462381363_835392156508568465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjeF6q3ayp4Q7kNvwG3ytKg&_nc_oc=AdmTstc-mCIK1lRZKOscnhwncrIPu7R8qQfpaA7R_snuSb3ePTEk5HG--w9IZtjCf_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvx0umnDnZasFM6YLspq-0PQLhqwfB3cQvI9JDFwLySVg&oe=69A6D229"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AU Text  2560x1440 Format.png", "id": "706845304976591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036616_706845308309924_8280624660867497005_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_EJIs5gb7oQ7kNvwGQLyNo&_nc_oc=AdmH4YV8hV52_kwSY36RbUWq-v9CtxyjmHcsGI5DcKrXBb-fqlOFeuVUQ08tJLmipN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuubLDFY78Dyfpw080-DiLTNMlLhhaG5B6kLR_66RliIQ&oe=69A6EC9A"}, "display_name": "Ancients Unleashed", "keywords": [], "long_description": "You\u2019ve been slighted for the last time.\n\nMinor demi-god or not, why should the fools on Olympus get all the praise, all the glory...and all the gold and virgins?\n \nCenturies ago, it is said Zeus stripped the divine essence from all of the gods, consolidating the Pantheon\u2019s power under his grasp.\n\nSince then, the balance of the universe has been lost with no one to challenge the Great God\u2019s will or temper his petty whims. It\u2019s time for that to change. \n\nBut to overthrow the godhead, you must amass your own power. Topple the great Titans, \ndestroy the vile demi-gods and slaughter mass hordes to challenge Olympus. For the sake of mortals and gods alike.\n\nWill you fulfill your destiny?", "short_description": "Immerse yourself in a relentless battleground of mythical hordes, divine chaos and epic landscapes. Challenge heroes to gain skills, hone divine powers and take your seat as a god.  Will you rise to the occasion, chosen one? Your odyssey has only just begun."}]}, "developer_name": "Avrio Analytics", "developer_privacy_policy_url": "https://retrogodz.com/privacy-policy", "developer_terms_of_service_url": "https://retrogodz.com/user-license-agreement", "publisher_name": "RetroGodz", "support_website_url": null, "website_url": "https://www.retrogodz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7562835923768136"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2733781486779203"}, {"status": "PUBLISHED", "id": "1136868027681886"}]}, "baseline_offer": {"id": "2733781486779203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712785380, "status": "PUBLISHED", "id": "2733781486779203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7662377040480690", "version": "0.9.14"}, "id": "1787229248436412", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7426304294087967", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7662377040480690
": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFQAB3WBb5oQ7kNvwFMg4Jt&_nc_oc=Adrql6q5KuuF2JXyur9wuMboVburfuf-3AUckz2xGb0QT-uFY-AGWROViDS3SS0rdI8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QR4ZzTiTxubBhU45gfgHnHW2vDBBX2WdImhOF_RCWHg&oe=69D79EE5"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69hKAjsuHEYQ7kNvwEXzlLE&_nc_oc=AdohKOSd7yzlRiWHFYZEDUtwHma4ijhbJ_goVXWOqThKeGGDo-bvf0vkBCyx9n1Rl0k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YNOIiSxz-zFCVcyiDiZqjix_jD5CF26VOd-AegC7cbw&oe=69D795E3"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GSuoTVJ30MQ7kNvwFrQeeS&_nc_oc=AdpQy09Kz0IcHNHyFOdPjAtMZ4X2rnUIzXbFLslN9Nmep59u57pWUerhhMJXSIWfPBk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OXJ1_a3mdYb8EqsJIr0lKcOrtgSmFKgjsi8J_MhRkfw&oe=69D7AEB0"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch3x3MH6ejUQ7kNvwFkzQlq&_nc_oc=AdpdV6lcA9NVFz8R7wiZqbCQA0UKY-nQUoY8OrgfSLt3IIXDagnQXBVeQSdhq8tGxuw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OYrrcJETDOZSq6W67NE7K7TWH0whDE4abFRk7EoB7vg&oe=69D790EC"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CecQLkfQdEQ7kNvwFszCrj&_nc_oc=AdpW6FFpGF_1WMKM0LyYF7P7kxvcsxDVyUsfXiqq4r4M04HdQIQA7BBSRFaXBjcTJds&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J-OzRQN8_0iinsTBjVxT8UVW1qK4QXI7bXoTWZwY-fA&oe=69D79DAB"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp2TYST_C7QQ7kNvwFJLdOs&_nc_oc=Adqla6J-u1m0Hy5puZAtY6zo8Nolu_vtKieGUD42BmjkBaOIwU66zClS-7ZoArWO8ck&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Fph60SYF4wS6ueDaOgP5rEZ3Bfn6-dGCA7kzNAJFn0w&oe=69D79EEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CEUekZyKWQQ7kNvwFNWxm7&_nc_oc=Adrc2--0M_BgCKSx46d26yE23oFJM3g3i7xpUVEVwyXSweVrmDfLW37xivoRvXb9rDQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03VrdIDc2G_RVH6G_BguevHuQ5xmGjAVoJaHsi9mTomA&oe=69D7ACD5"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJloRm6zeXYQ7kNvwFvx6d5&_nc_oc=AdqN4uwA_t8mPED2zaGJ_fC87itH-VKNST9cpbAethohfovpAvW1xGRD9KNXJrN_cGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5ORcvhVjkoi6dw5TomQewqSL6Dd1yUph5zqQBXrS2CQ&oe=6A3814A5"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npkfO4ozpysQ7kNvwFTGqUY&_nc_oc=Adq3YhPo6i91BcCjNIruYww7guEmxIqQ8D80sGHL3WNXdRkggBeXzvunZ4CvK8t_wSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6hmofR2BXHl2nVo3BuaiK-k1mLlMonZvROPiCAllAjg&oe=6A380BA3"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqshNI-ngVoQ7kNvwFOSf4v&_nc_oc=AdpGyEB-MO_2xO9H3xzyLjemB30UrvHC_7oJ6jtjaYNvIGce9kQxLPj6pzvDv0-f11I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aGDpM1FynoYH7W7qQn9TmeFOQK823GBm8tkRV91T0Ug&oe=6A37EC30"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJO4AOKtk4cQ7kNvwF0MlHM&_nc_oc=Adpw-8wp2NeKNta-lYPhnqB_1F5dFVmW8pc63RbgKvRFQPWWSZGZU6dE9hDTyMc5A-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LAl7VeT9ZUvmQ5_z-d62o1xgF8U3jTKEnMpikH946XQ&oe=6A3806AC"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmJfIz8Zr6AQ7kNvwHg3amO&_nc_oc=AdoDaH6yoT2VowPD_yDgSJ4dVPsxQIFc1WH1xxtn35uVJZe9iTNgSC3RKYYFvXWK97M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9quZJhLuKscggseHErT8Rahs8QD0x-EyRrevzngn2JbQ&oe=6A38136B"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G33XnI8YxEMQ7kNvwGDcB-w&_nc_oc=Adp7pw01YZ_E0IBxiOIkt1AsHm0VjY7vZ8Fur26vexOBfMZgau5SR9TTfnJIqELr0Es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dIv58CLKbSrUzoj5nFRo-DPxdQHeQNOC3l8t8NRkd5g&oe=6A3814AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLboeXczdUIQ7kNvwG948LU&_nc_oc=AdrLQNS8ABEYpgae1fdon1O0lhumHlEtNodvm0g8-EjIFPJuRLvRqVycMNAKNgEDpaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CNDXcepE5RAKQLnBww-sWpon0BPwN8oLQbYuCJf0s0A&oe=6A37EA55"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMLdjnTk8EcQ7kNvwFhW0Lt&_nc_oc=Adp2EBNLQtammcW2lllFEVdnhxB8Ck-4ZxDvw1pBZDD9UDPrKBmx2hWW6nbxsD48ZCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P0xZF3xwqCGCU0SlAeDi-ohj_AvXJvOagsMXC5eqDXA&oe=69FB3765"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE-5UG7QTxoQ7kNvwHVUwCl&_nc_oc=AdrqpdRn97AXOLjhoSUQkLSVu0Te6o66EOTuRjzPCeuYdWhD4uDMxRXk5n4WhY2Nui8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gT-gJ-UB43CctLzNZWtYi39Fv4RkD4HIvB1D1ctjxug&oe=69FB2E63"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOvlbg8Id54Q7kNvwEfROT-&_nc_oc=AdrprC5GVnLrvKMbe2bm9Aj61CAb7oz8i0L7FFyxzFp6Vlj7gJpkb2jZYLsysJ7SB5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tSKtYf1yeq4e-UPMn-zuc_7PPalLIfgw3ED4C1mtH9A&oe=69FB4730"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGOUQWMIQBsQ7kNvwHvRza1&_nc_oc=AdpPxJdZFRuP4mrb7R9fRGlrRwMDOtzVSCX6ARen9h90XNEIeQQ7CK9eqPNmJUxogDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fj8yU8YWqFWv7INTLpyByxp09JeCU5_sgZnuQRXTcMw&oe=69FB296C"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kczBJSP6ekQ7kNvwEKI3hS&_nc_oc=AdpNrpcTBkVLDqDO-UZ9RkkMyM1BEb6XaCP_zbHeazHY-BAe5J83ishwgZ2pOUxXrbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CpDvWB7abzAwAq0heBtBcHT6YU2QkBiNsa9qtwNCoJg&oe=69FB362B"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uATeaeBndFQQ7kNvwHE2pB9&_nc_oc=AdpRB4bf99aqPrLPSuWHSWgQlyQrfTX6-NGmtnfpGkztagE7Y1DV2328dD0XD9GCMtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73QDXAKfherRvOvejMr8jUJJmcvZtc-SN7erLD141jfQ&oe=69FB376E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bheAaH89iUQ7kNvwErSNIv&_nc_oc=AdpTISGwV5LR2Db3G8XrdHICT3xa8OHbWr9528I2jyLf4cmUcst8WED4lGihUj-h-zY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PZGnmNDMFdkFVdXJMz5kAOHi8o7Yy3KbFyC2mHwLqFg&oe=69FB4555"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9TctwUnts0Q7kNvwH2B_np&_nc_oc=AdpqLzy4U2FO_fqUIO0U6nyJD4pPqPs0qftrhYIX1d-yIPQ-_rUROHcm9k4vbpyjPMU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBHPn6YZ9KKiks_nahMeInTUQWgczehhvPcYq5osh3XA&oe=6A4A5165"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlbG99_Aks8Q7kNvwGnbUfT&_nc_oc=AdqubVBHp8HCQ9TMlgDSfF8TObKQHJ9grUR1Y1fD_Hs4EpEnrfbJlOb4Eg1uIoRcsUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvIsnRmyLDTsDGGpC0AGjqtkZzIZUGgMV90dwt7xM97Q&oe=6A4A80A3"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3PfV5U0xi8Q7kNvwHusEru&_nc_oc=Ado6VWJrpmgOVwVADYahWTuq8v2va3mc_Q6MC6da-7QMiLb6QfLJuSoRMoZ3j6xVWc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoWcRqjFBolc8IeRT46XzXcbyJ3UYveN7kMivX_b-GRw&oe=6A4A6130"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTAKIli0L6wQ7kNvwF82w9d&_nc_oc=AdrqnAKmx3uRXixS4SKg1rUnBY7P1UwkAEMN5OfUIpMAQAI5RyJLA76cqonAzaYjCw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXQao7dzXgQH_gP8c2RLZC34EkrORb_a74qCZ5gcnoZg&oe=6A4A7BAC"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d1CHOct2tEQ7kNvwF4W0ju&_nc_oc=Adqw2vo4IbOkSKzoAr5hR8K3JY3jiS-Z5NHgonOk_Uim_1b9SBXwrxwAChW_YMt0E5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO3y98lxhW35C8a-Q5ZhQRIbnBm3Uk0mKA1PSxFw-M1g&oe=6A4A502B"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XsyG-NDFwIQ7kNvwF9LyMQ&_nc_oc=Adpbqjjwq4wgRz7gqE8QX1lly69_Ib3WFy9mnED_yagDtpVVWIp4Z9rOUd50or0yIe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKDracEUD-F5rqVezF-BYVucny3G50l-jf5aUNq9tagg&oe=6A4A516E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKaaO9HpAikQ7kNvwHL5e_O&_nc_oc=Adp0zwaXVgahJOj6o7HCmTkG33DTJrJapKPmiisfyyvL6PzjMy-RT5q_bDJDZZQo2NA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ3JCEKX1nYwfgWLq6k1Tt1c8MtQtkkN_RDRdjj1j-_g&oe=6A4A5F55"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
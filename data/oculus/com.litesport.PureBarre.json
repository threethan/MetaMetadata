prC47t8XyQpdD9U4hs5PCNdlxb3Mds2GlVxDfW4M38zTvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyxx5S43Eik4xeEmzHzcQKf93cMrYpVVaR_7NhfShm8Tg&oe=69BBEE2B"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOK53_u7gaMQ7kNvwE8Tsuy&_nc_oc=AdkK68sfC0msIDMi0PpJBUwxIfUm7lUdME7RPNIpo71r9ICIGgRbuxJD1zY179a01Po&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxVKWz5Ccf7R-J_vkxVyFmHnFu0I32ZyI01jX1ZXmdRQQ&oe=69BBEF6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1qkApEssUkQ7kNvwFWg04l&_nc_oc=AdnYDjGcO657ICCnXf3mqb-OcPg8C8QGGbkC2ORBWAMVtn8Aa0dPmWKQ8nE5cEOHomI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwajeutUgyvFJqyexz7UtkbhRqVtFcQzDoFChS7p75yMQ&oe=69BBFD55"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8IfBKeRCgsQ7kNvwFQvj6i&_nc_oc=Ado0DT2EU0o_q-IVXHj4WxrgkmQEz-zeixEhfLTBr_BJb-TYFDKDzaVrsDk3YjG-a9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-uyq9XD7BpyBiaSRTzewQESModsATEBJf_TseLV9e_A&oe=6A50E8E5"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3571mNeVo7QQ7kNvwHyp__V&_nc_oc=AdpCo9mf0nHV9NptUxYf-8stJSilT6Qi38Pe_OHg6BehcP6UIX9L_HwBU44TwLlx3i8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrHDEXCXcYQ9YsDF1AkUXHQuEAaqKyngXmFNbd2eWSRQ&oe=6A511823"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKU2VR4fTS8Q7kNvwGcPy0X&_nc_oc=AdqegR-eMTGHQobIkk5G6GMQG3ZPdAUW6h7Bm-6ws7V7kobqFjFft32-f-VteM2z5PY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1K0U2AYQO_2CP4ie35vMnA5QNe7wUnmeiUVxXLq6aJw&oe=6A50F8B0"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfy_Q5zrRA4Q7kNvwER7lLm&_nc_oc=Adpzn8VLFnWgjuGOW_RO1dTHDzajB5xztgPEhpBdlMpEGMqfMp3E5so4vp2VFpRJRxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlUhK_M0JGjluYPZBXYHsX7m4EwLOo4yhMeCjtjup35g&oe=6A51132C"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5kFhBrdod8Q7kNvwF4u0ID&_nc_oc=Adpd4tfhdDmFU09CGUL6ZlA-GVaHufFSoSdsJoBqmUSoNMeSi8QAXYJBbPIPI6RcMho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnNMwjDSudz-QluM1nHAITlEw1-Um-0BPY_-HOHNmRiQ&oe=6A50E7AB"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtqzQuEj1ZYQ7kNvwG5ewCc&_nc_oc=AdpIWPK08gj5e1xB-p7IZBsiZEK6JBf7oXqBZ6c2_-81I-2rGKnt74FZgnYSqRvlQdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx0wkCVcaA2TrkTh3-D95Pwz40ZjrkegJyieAq5AbNag&oe=6A50E8EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLrh6s5VgCEQ7kNvwHqEFxI&_nc_oc=AdpNiX-tOo6i4xH56txXvcf7-dNYlEgBVGCywERGCrntdLxrbvd9QdVxjWuToUL_cHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7vceGhux1Iis8HidX-wIRxMFhu07YHdeUMFkfZboQjw&oe=6A50F6D5"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
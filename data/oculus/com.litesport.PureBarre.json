": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC3jD5u4JIQQ7kNvwFTTl65&_nc_oc=Adq8uFpqaRR2QTIScSw-zSS0uspJn6PXPFKEDDJgcE-BYBv5O77T26X4uCHmOTarnB4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bWhGkh-HSesgxRQxH4morHsLLcDp71Hf8PnkQcD3kvw&oe=6A3D5AA5"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noScCHA6caoQ7kNvwE8fluO&_nc_oc=AdpRl4Ji6Nk-lEiMIo_oLV5Cdm9caYVWKHo5ANAfLm8OHatEfyhDkTFjze3JKQEbKoo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2sDHRIqFXq5s9JjKyGRRhZGL0KulecKecyNetovXZzw&oe=6A3D51A3"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSu9RR1EUcYQ7kNvwGHRAgk&_nc_oc=Adr2hQI7SnM8rnKfAj4Z5xxC7ozpKFcNjdAjQc_ICEmnTXkLuHIcexTuyPx0WizQxmM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jT648PqLffWPCJdkzofFSVsdFKjr1SqVSbfvRHKGm0A&oe=6A3D3230"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bxFRlIpWjgQ7kNvwFPDSMn&_nc_oc=Adol8rMznYrK8o3OCWiysPLIK_r-crJjzNQMNTjJPKp3H6CpwTBTu5uHxepYICKJ8-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XNoW_1sNlJrdzJ0OzCrQ8-JzWTTPVS0eV81CVXRrQhQ&oe=6A3D4CAC"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHK7GTWn2p0Q7kNvwEKRI0A&_nc_oc=AdqKHsq-TsBGsLfmkEfhSZV-pPgEALxjz0TBMk6_koem7wK1c0g9q1p4KS_XUZs-UtQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JvXR3nLcdeAHLwiSdqVr4ROH0qMvnG6Hd8dkIyaJihQ&oe=6A3D596B"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSBcNL8a4IEQ7kNvwFcGCm2&_nc_oc=AdoZce5oSdTfi_CNWVV_UUmX8oeIcwwXoBobLX4Zh8dXTeY5Y9RzGdu_irJKCgUoMV4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o06YRAusWsn2g8TTF4ahp2W9ZXeXzIQLSupmZrxOIKQ&oe=6A3D5AAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E9UJv2YilYQ7kNvwGu6o5N&_nc_oc=Adqs8Uq3TatzpqX1hnWvU_MXjCmE1rX-XtmKtko4uFmvxg5UPZMqUeopzxMVZwlWmxk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kwjJ3UGlYzrS4OKEmXANXSAuUjEFFjcfP5uarU07-vw&oe=6A3D3055"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykFyyjNQBjQQ7kNvwFgmnmG&_nc_oc=AdoPiXV3-K4t4mMVircSGwOcHq4n4wSo5LQQLGznRGeXf8ypxz0sh4mY4XIDNSRlACc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jjWiA1Zh6sVF_gMXgd35XbWSVfq14_EIuHmWvccWD-Q&oe=6A0B0965"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnAN7wPO7r4Q7kNvwHgx4ko&_nc_oc=AdpbZ41PXVPnXaZgurb3lfkBdOlLaFYpqDV99SCbHDfHlkLYpmtdxRxXhp2DwkQ88lo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67koccVrO5UpD2BtlUutqU6iEJ86E46D5hlc5tn-_wKQ&oe=6A0B0063"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmro5MNHlKQQ7kNvwGxUv50&_nc_oc=AdrNOXMTQduw4uk2-iWfJ6uetRZcW7TM_6DoBA6w7ynXKspaVd35WNWo_noRW-jHkKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fNBCwDLlvl6HG7pGYqkkGayYCv61Lp6ctXbrVV3aGlQ&oe=6A0B1930"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=418E0hhjn_0Q7kNvwFT7h-p&_nc_oc=AdrAveue9HH54AB-Blm_TfxZYniIQp0hafGpbNV0-5G5j1YbnFRTIxbl4zr2OQfVF9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GYrMi9XO_CCVpSlSHhvu0Uy6ww2eWhI9Mr06MX0-jBw&oe=6A0B33AC"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xETJV8z8x58Q7kNvwF5gF49&_nc_oc=AdoBn4dWmNSQp4P-50SJZR4nl8Nd8FiyWJCVCcE8XHEtucRh-MrXJ-cpdzeYWxyXgLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G8_P6F7_u3WNmEABuxue6Z31-3dHJtzj3hOfvcKAOZQ&oe=6A0B082B"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF1We4uUrM4Q7kNvwESgt1X&_nc_oc=AdrKLJHfH8wWI1D8GAygVJzxGLUg0XvaUefMeSp9ykWzsWddTuLfbBQiePHaWFW8C_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mnqnpCPR6NruulqJJRR8P7eYtAePqtgAcCCCGLgRQdA&oe=6A0B096E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHydRfE9L3IQ7kNvwEmjE5X&_nc_oc=AdrRt3-_h18_Sm0q-R4yGlZrKhuJL_e3To-f-BtdHGsn2o-R422PP_UX9Bvx1xqZ1ZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C5Tjj0jObbCiC4LOUXjc_yE9qrYt7y6DE54tdvE4vXQ&oe=6A0B1755"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974750_383538117754069_1436277136849857073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDU2ZG7nzvUQ7kNvwH80npW&_nc_oc=AdoOAMsIiN9bnhG2mwu0aPDZouAibtE2PmnsW_My3t_affeWRCHglNiunkEUz8JQMNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy61A4CuoTduPhwnGix2nXSwGtPHfS8IS3DK1EJH-pyg&oe=6A69F565"}]}, "id": "1024216399064578", "locale": "en_US", "screenshots": [{"file_name": "PureBarre-Marketing.png", "id": "392409210217777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227942960_392409213551110_1547717567785072045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hinb9c9Fe10Q7kNvwHeX7BZ&_nc_oc=AdomMoMFk4tvK6HUnKSCAmeH-qq1hkmvyibtwx3qNIfSdDaYXFBfspkVayXYePNZe6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfxxq1rL68QKBWg7Y0xdH8I42PM4-Z_qJm2GqUaQJIKQ&oe=6A69EC63"}, {"file_name": "PureBarre-Home.png", "id": "3824034121198452", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974848_3824034124531785_6497811911322848072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CkuIYcCpIQQ7kNvwHSGqVs&_nc_oc=AdoYBBTz-neV4DTDmFxOa-sTsOHL6mwgQNYAhBng6ZvuUx6gmzFIKkravehV6jk7Piw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSpUd1ybYSe8tZiW9LwFkcv5jLxKUN5UKBOA93HQtyug&oe=6A6A0530"}, {"file_name": "PB Screenshot 2.png", "id": "527418639643056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195911_527418642976389_539573700919776432_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv_UDiTyfzgQ7kNvwHNO6OK&_nc_oc=Adoyj7C2ch-F27z1IjOXH6SxQhk0oikiMSxPnsTWJRMfK1oT0H4q1AwkdcB9AXFiY14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8LZHtC-d1Awmt1Q1g4iEMr0LS8-pKZ6KHl_n-HuGQZw&oe=6A69E76C"}, {"file_name": "PureBarre-Home.png", "id": "961500085750865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569430_961500089084198_6982331674072896946_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWAsxpHAawQQ7kNvwEgu3YY&_nc_oc=AdoLPCC-44NCxpjwWi32zSDkhBlFeuqRBizbcxwRj-csICMe8K8iesEj52AuzWzSvIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgl7_deHNMohKzkLZbcyn8eC-QcwmcUMu031ewDUN0pA&oe=6A69F42B"}, {"file_name": "596_16Xplus_Meta-X+ Commercial_D8.00_00_16_12.Still001.png", "id": "2258889751125256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035389_2258889754458589_362096951315801856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmZBgSCvXigQ7kNvwGBzSFS&_nc_oc=Ado9Bc8VERY_nBIjEgaZNvGXoGSPfbtGP9bjNpp-W--I7jQhIYH6rR7CrvTMdVkqMWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB83YVv3eprlKkgs4Vm-ytYYHpOeC95n8zDLe__6hTK-g&oe=6A69F56E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PB - Cover - Landscape.png", "id": "3913307348906590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974649_3913307352239923_5359563645525342923_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlRjjcaX1vsQ7kNvwFcjm-0&_nc_oc=AdrnyjPlVJT6pqP--dTFqBuxfr4ujXu73NDO1djGaucn5oW7yr8sVh3GAv5X50MkPpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPpbU9mgGqLcD3kCtBx0m56ToiTi-yqKnfY16iAVsWlA&oe=6A6A0355"}, "display_name": "Pure Barre", "keywords": ["fitness", "health", "barre", "Pilates", "stretch"], "long_description": "Elevate your workout with Pure Barre on Meta Quest, the ultimate VR workout from the largest barre brand in the U.S. Discover a transformative fitness journey where strength, flexibility, and balance converge in a series of expertly designed classes. Whether you're a barre enthusiast or exploring the world of VR fitness, Pure Barre offers an immersive and personalized approach to achieving your fitness goals.\n\n**Key Features:**\n\n- **Immersive VR Workouts:** Step into a virtual studio that brings the energy and precision of barre workouts to life, providing an engaging and dynamic exercise experience.\n\n- **Expert-Led Classes:** Benefit from the guidance of top instructors who lead you through every movement with clear instructions and motivating energy.\n\n- **Variety of Workouts:** Choose from a range of classes that cater to different fitness levels, including full-body workouts, targeted strength training, and flexibility-enhancing sessions.\n\n- **Innovative Techniques:** Experience the unique blend of isometric exercises, low-impact movements, and stretching that Pure Barre is renowned for, all enhanced through virtual reality.\n\nRediscover your potential with Pure Barre on Meta Quest. Engage your body, challenge your limits, and experience the art of barre like never before. Transform your fitness routine with the power of virtual reality and achieve a balanced, toned physique with Pure Barre. Your fitness evolution begins now!\n{510069398366471}", "short_description": "Pure Barre on Meta Quest! A fusion of Pilates, yoga, and ballet - Pure Barre workouts blend strength, flexibility, and balance. Perfect for fitness enthusiasts and VR lovers alike, our app offers expertly crafted classes led by top instructors. Sculpt, tone, and energize your body with Pure Barre\u2019s innovative virtual reality experience. Step into a new realm of fitness and elevate your routine today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
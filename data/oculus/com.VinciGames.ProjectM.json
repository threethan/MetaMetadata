AD0"}, {"file_name": "boss2_Screenshot_2560x1440.png", "id": "1094846936738745", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593863731_1094846940072078_8681272250617337643_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzl-P29pdDwQ7kNvwEk334N&_nc_oc=Adr89v-F9B0Bxgn7fpv3PsvB2lahCmEDOrLuFCnOhRhtzV-mK1uzy6ORzwlS3GqT7BQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxv9-ycpSMthtuLuFxyMFYSHrpg_zYnAw0LGVkZPaxjw&oe=6ADE1DD8"}, {"file_name": "party_Screenshot_color_2560x1440.png", "id": "1671415931275068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623115_1671415934608401_8471457847645386312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uHQ2QD-txwQ7kNvwHrVbfo&_nc_oc=AdpR9W4KC2svh5YFib5OswizPknUR7axMxUk8jfidYO6kJe7Zr7KyHOupQMw3gd0YS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-pDf509RvAc8xYbDAg4OfFOQu0U1OPmK1w-grgntN-w&oe=6ADE0FFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ruffnauts-Trailer-Cover-V02-2560x1440.png", "id": "1831047824744612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620666_1831047828077945_7527482535603601439_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koQkLtZ55ooQ7kNvwFPvemr&_nc_oc=AdpWEljAQE4qajgjl2R69pZ0qnXcFIHnyEo43KpRsV-juiLcuQT2_7zTsdMLPmidoPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUeR5vI5-0gCE8-Cm4nMc5gu-9b71VZwSdC2U5XGw3pw&oe=6ADE0490"}, "display_name": "Ruffnauts: New Frontiers", "keywords": ["multiplayer", "pets", "sandbox", "monsters", "gadgets"], "long_description": "# **Ruffnauts: New Frontiers Open Beta is Here!**\n\n**HATCH. RIDE. GO WILD.**\n\nRufnauts is a FREE multiplayer creature collection game where you explore wild planets, discover crazy creatures, and battle giant bosses with your friends. Can you hatch them all?\n\nCollect pets from capybaras to dragons, feed them tacos, and evolve them into companions you can ride! Gear up, bring your friends aboard, and explore new worlds in this creature-collecting VR adventure. \n\n# **\ud83d\udc3e Hatch, Feed, & Evolve**\n\nDiscover **150+ unique pets and variants**, from adorable capybaras to mighty dragons. Battle wild pets to collect eggs, care for your babies, and evolve them to ride.\n\n{1475602874483020}\n\n# **\u26a1 Your Pets Are Your Ride**\n\nSaddle up and feel the speed! Choose from **Speedsters, Tanks, and Gliders**, each with a different riding style to master. Tear across the ground or take your adventure to the sky.\n\n{2149838805676080}\n\n# **\ud83d\udd27 Upgrade Your Pet**\nUpgrade your pets with **weapons, attachments, and passenger saddles**. Equip them for battle or make room for friends to ride along.\n\n{1091282476939829}\n\n# **\ud83e\udd1d Bring Your Crew**\nJoin **10 player lobbies** to battle huge bosses, collect eggs, and explore new wild worlds with your crew! Don't forget to style your cosmetics for a unique look!\n\n{2235609537301470}\n\n# **\ud83c\udf00 Weekly Updates**\nThe adventure keeps growing with **weekly updates**. Jump into the Open Beta and shape what comes next.\n\n**Your pet. Your crew. Your next frontier.**\n\nPlay Ruffnauts: New Frontiers today! Save all the pets in the galaxy from the evil Catos!\n\nJoin our Discord for updates, sneak peeks, and a your own crew:\ndiscord.gg/ruffnautsvr", "short_description": "Get ready to defend the galaxy in Ruffnauts: New Frontiers, the ultimate pet collecting, loot-grabbing, high-octane VR sandbox game. Explore new worlds, ride exciting new pets, build and train your squad for battle, and upgrade to become stronger with your friends!\n\nPlay solo or with your crew in constantly evolving biomes. With weekly updates, there's always something wild (and probably explosive) around the corner.\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ruffnauts.com/blog/privacy-policy", "developer_terms_of_service_url": "https://ruffnauts.com/blog/terms-of-service", "publisher_name": "Vinci Games", "support_website_url": "https://discord.gg/YJp6ZJBW64", "website_url": "https://ruffnauts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29033459969572916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619382_1426798045525319_2999068052418006096_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtmACfklpcgQ7kNvwE1O9Tv&_nc_oc=AdrYvVenCT3-RRk-h8vW45rB7Izbn5hUqOqC0EgN1vOPvVi3QzoDn7lt_GjYzmSrilg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlDHsnHrE4xIcTfezZk0xIhbVDTftjXxOhrBPhRIHQPQ&oe=6ADDFB8B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ruffnauts: New Frontiers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1755348720, "lastRevision": {"nodes": [{"id": "8369407023071513", "release_type": "SCHEDULED", "administration_status": "AP
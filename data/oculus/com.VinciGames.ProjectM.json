_nc_sid=6e7a0a&_nc_ohc=SexzZ38IowAQ7kNvwFVfE_Z&_nc_oc=AdoLzJD_cpnmfKuvpwvAsGw7Brcmh7PYLtIygntpesqGxYOyXTb0s4u86WuC5JQ6g9A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYvx248GE96_j0xW5edyOQpF18G1CnldwPDOv3MriDHg&oe=6ADE05B2"}, {"file_name": "3-2560x1440.png", "id": "1452286782482190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822952_1452286785815523_2248867214660324652_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK0DLbpQz9oQ7kNvwHKgfZN&_nc_oc=Ado3avodV5kP815Uz6hes5P--1zbtyd0fjeqlTRCAnWQaPQeyGsmuS9bPtLfPDU5rZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0HyQOPXFGW6DZphfPUmUTE-2p0Rr9vkLFXjprOYBq3A&oe=6ADE19E4"}, {"file_name": "4-2560x1440.png", "id": "601972589407469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830893_601972592740802_3928018504908468438_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2-RkdOMzoMQ7kNvwGForxl&_nc_oc=AdpHsB7AnLR2_tdTrcro9xcqBPSFrdl6HGzhv-Jdsr_66lPIiYWt_MAQXZEoF1V84dE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYLC37gPKfckncbVT-3odX4weGOd3YyQFXzfFh9wdJGA&oe=6ADE10CE"}, {"file_name": "5-2560x1440.png", "id": "1434798557774184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820586_1434798561107517_8149500130372861293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPxPlUe1exIQ7kNvwF0JP7J&_nc_oc=AdryZYFas8b5BDi3Ms1vwl790L1CLAEGwRfYAXzsAdA0-y9trKixwk25Y678Mg07Dwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKBkZqQCfp-leN-gn2sloFUG097lKfMToC0771OwW74g&oe=6ADE16CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ruffnauts-alpha-key-art-v1_landscape.png", "id": "1051998653813079", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1051998657146412_8501418819412210895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S65UyoxEPVMQ7kNvwGsS_am&_nc_oc=Ado3s98y46hnZb6s2HiQbb7D8CIBjUWAJj1ria-hADWdN5A8U5SDLtz6VUIPV6YeUZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb65E4-bu8IJCo3zIimfBdEZzzC2aOADqwUnJoAw0_0A&oe=6ADE1987"}, "display_name": "Ruffnauts: Planet Pals", "keywords": ["multiplayer", "pets", "sandbox", "monsters", "gadgets"], "long_description": "Get ready to catch chaos in Ruffnauts: Planet Pals \u2014 the ultimate pet collecting, loot-grabbing, gadget-blasting VR sandbox game. Explore strange planets, blast enemies with ridiculous gadgets, and battle bizarre monsters alongside your pet squad. \n\nPlay solo or with friends in constantly evolving biomes. With weekly updates, there's always something wild (and probably explosive) around the corner.\n\nWhy Players Love Ruffnauts:\n\ud83d\udc3e Catch & Evolve Chaos-Creatures\nToss your capture cube and tame 60+ wild pets \u2014 from robots to flying dragons. Feed them tacos, grow them into beasts, and ride them into ridiculous encounters.\n\n\ud83d\udd2b Gadgets That Break the Rules\nLaunch yourself with a Power Fist, pull friends off cliffs with a Grapple Gun, or drop portals into lava. Every tool is made to mess with physics and your friends.\n\n\ud83c\udf0d Planets = Playgrounds\nClimb trees, bounce on sheep, glide between floating islands \u2014 each spherical planet is a new biome full of loot, traps, and surprises.\n\n\ud83c\udfae Sandbox Mayhem with Friends\nJoin 10 player lobbies and battle, explore, or build chaos your way \u2014 with creatures, gadgets, or pure creative nonsense.\n\n\ud83c\udf00 Weekly Drops\nNew creatures. New gadgets. New chaos. Every week.", "short_description": "Get ready to catch chaos in Ruffnauts: Planet Pals \u2014 the ultimate pet collecting, loot-grabbing, gadget-blasting VR sandbox game. Explore strange planets, blast enemies with ridiculous gadgets, and battle bizarre monsters alongside your pet squad. \n\nPlay solo or with friends in constantly evolving biomes. With weekly updates, there's always something wild (and probably explosive) around the corner.\n\n\n"}]}, "developer_name": null, "developer_priva
nt-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32O78-tAuw6LfHX3sP7JmBBp3uIZx1hFNHbOXyw4dRYA&oe=69EA209B"}, {"file_name": "screenshot4.png", "id": "1866272400751260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_1866272404084593_7440083517766921022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOzkhTJCI9UQ7kNvwE_V-k1&_nc_oc=Adq206GaXxknyP5OFAEsLaI6mWYEb26QSuU27MPmmW6KEsMi7c8wDpgqDvgmXWDL_Q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rceGHZTu8phg650owb7LlvClPQIsyZKVzm1_LthSTYA&oe=69EA1383"}, {"file_name": "screenshot5.png", "id": "4262625110716383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293690_4262625114049716_4700580957018348055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yUvN8dBukUQ7kNvwElGRkE&_nc_oc=Adr5qPcuex2CIitmc87jIhvR2xp_YUA9BLYcpYbMeUaeQguc5Nx1v5dO52sVyYToGkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_LUgoMvVPDA3--Z844CgEMnMRusfFqGZjZ8jIhjW-pA&oe=69EA0892"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PROJECT FLICK", "keywords": ["fun", "tag", "tags", "landscape"], "long_description": "PROJECT FLICK is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "PROJECT FLICK is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": "TFOE", "developer_privacy_policy_url": "https://sites.google.com/view/projectflick/home", "developer_terms_of_service_url": null, "publisher_name": "TFOE", "support_website_url": null, "website_url": "https://sites.google.com/view/project-flick/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "26061261366907954"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "941469442191671"}]}, "baseline_offer": {"id": "941469442191671"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776111780, "status": "PUBLISHED", "id": "941469442191671"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26070786412622116", "version": "1.2"}, "id": "1670552107416351", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26061261350241289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBina
yRnhYFEQ7kNvwERqCn2&_nc_oc=AdpS4ChOc-ddgUN_iUSRvIXsQmtSF8q5dTfiDI6gEqDlH1Mjl2ubg4u-G8SN9a0Kvos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGnIC1kIcVboISRoLns9XwFaKBv4Yn4bcULyJshjKbCg&oe=6AB5279B"}, {"file_name": "screenshot4.png", "id": "1866272400751260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830599_1866272404084593_7440083517766921022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4z1aczvqgfIQ7kNvwEly14v&_nc_oc=AdqANmXQ7YpOIjBgIDLwvjP5jMKiiAnrdAeq2yzEXYursu6uFBBcnyydL8mTE6B0p80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhXYAckm4wkiiwJN3WSGz8QCnjYgrFdO6foOL_reNl-Q&oe=6AB51A83"}, {"file_name": "screenshot5.png", "id": "4262625110716383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293690_4262625114049716_4700580957018348055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1LrpeNoPmwQ7kNvwGrsR6i&_nc_oc=AdoWJGOh2q5VEkvRt5LxB_G0dHu0Yr50T0AZKIDTfWsVoAZxZy_Fl5FNbfI3syxesfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz7aJ0FYCIJM4njHq29HBolUIVtEelYqMKhVcO5gUlhA&oe=6AB547D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PROJECT FLICK", "keywords": ["fun", "tag", "tags", "landscape"], "long_description": "PROJECT FLICK is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "PROJECT FLICK is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": "TFOE", "developer_privacy_policy_url": "https://sites.google.com/view/projectflick/home", "developer_terms_of_service_url": null, "publisher_name": "TFOE", "support_website_url": null, "website_url": "https://sites.google.com/view/project-flick/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "26061261366907954"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_1492797615676486_1258245768410092359_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bQpn32SxmQQ7kNvwEfyr7Z&_nc_oc=AdolbHJ6D97suq05mtNuYpyWRM_AUFDBlFwI4BRA5p49LPWik2EisRuWIOz2S-fboCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCJh5dg598mYFqUJUeE9ZYWBRCO0T2fuqjDBUjACZaSQ&oe=6AB51A0D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PROJECT FLICK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
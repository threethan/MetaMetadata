iption": "Devil's Roulette -The Pit- is a thrilling VR party game for 1 to 8 players, featuring a variety of high-stakes game modes including the new mode 'Devil's Spoons', where the player who collects four matching cards gets to pull the trigger Russian Roulette, Spin the Bottle, card-based bluffing, and more. Ready to go feral?\n"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29454023600859773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628447_1142587684972284_4219350813279719225_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlbBxw35GbMQ7kNvwGyxaMs&_nc_oc=AdrXZU7hjHk4spnxhszxr5Jy8vuHAc5OSi2sUZvf73mT9MD_HwnVawPjIsp2CDUCPtU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGWTyhdfA-Hf9OgU3dMlzI59VueDYT2s0ZEy8vGeBC_w&oe=6AFF3142"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Devil's Roulette  -The Pit-", "platfo
-7&_nc_sid=6e7a0a&_nc_ohc=sh8mnFNIjPoQ7kNvwHjvQY0&_nc_oc=Adlrr7tWycO4E4MFhWumuDKL-i23tkv_XS4WLoQIny1ojCSa94b2_jAXWtYGp1kH0Lw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvaE_JZQi64Bxsb95cxh9d1rhcMWY_aOspuuXC72cpjeg&oe=69A18D2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1307055871442792", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499617762_1307055874776125_6094282458212710047_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZomWvfgeTKYQ7kNvwG1naVj&_nc_oc=Adlb0n59ISw5VsxMsOu08jI8h-y3o3e7znVufeEskVhyKcrLNdWoI6AH7IK-1lzDvoY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuPME7YR34MzPx4inyMf7adRS6SunoZ1Oq_EIIlsiX_EQ&oe=69A19BF8"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "\ud83e\ude77The Potion or Poison Update is HERE!!\ud83d\udc80\nWe've added a brand-new gadget to the game: the POTION!\n\nDrinking the potion can be delicious, causing your head to shrink and making you harder to hit!\n\nOr, it could be bitter, making your head grow bigger and creating a massive target for your enemies!\nYou'll never know which effect you\u2019ll get until you take a sip!\n\nPlus, we have the new Harrowed Heartshot Exclusive Mega Bundle! It\u2019s packed with new Valentine's Day-themed items, including the \"Heart Piercer\" Crossbow Gun and a \"Cupid's Cake\" you can actually throw at your friends for hilarious effects!\n\nCheck out the new POTION gadget and the other Valentine's Day items now!\n\n## \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?\n\n## \ud83c\udccfChange Your Fate with Powerful Items \ud83c\udccf\nTurn the tables using unique gadgets distributed each round! Enhance your reflexes with a bullet-dodging energy drink, stun your opponents with a modified taser, and much more. Outwit your friends to survive another turn!\n\n## \ud83d\ude08Face the Ultimate Test of Courage\ud83d\ude08\nLaugh, scream, and sweat through this intense game of chance. Are you brave enough to pull the trigger, or will fate catch up to you? Gather your friends and experience the ultimate blend of suspense and hilarity in Devil\u2019s Roulette!", "short_description": "The Potion or Poison Update is HERE!\nTry the new POTION gadget! Drink it to find out if it will shrink your head (harder to hit) or make it grow (massive target)!\nPlus, the Harrowed Heartshot Exclusive Mega Bundle is out now!\n\n\ud83c\udfb2Test Your Luck, Risk It All\ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "use
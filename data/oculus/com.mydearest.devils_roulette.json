9\u6b62\u753b001.png", "id": "1306186211382373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1306186214715706_6363926784507361278_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cORqjagFSM0Q7kNvwHHwKz_&_nc_oc=AdrqXtFFc8BdcSdoZfBlD1XF_JAS52h6vnzqT3ZQlkDCV7xie80DDxfGM5TX25jwVI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ux_xR8KUYJAc_801QxUpsXAdp4InjHSQqAyELM9r5rg&oe=69E37472"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_37_10.\u9759\u6b62\u753b002.png", "id": "1268209198618182", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_1268209205284848_175870726079160182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWlxZsbxWiMQ7kNvwFPOtFX&_nc_oc=Adq2DQQZYXmH0FIp7h8PrRXrRzCckm0bMq6UcG5mG8L11DiUEhupHXIzU-jxewVMSgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DqKrg4yKfGcdxyu1KOfOUYKPyirRJsUYsfx17bZW89g&oe=69E38917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "3333738726804794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_3333738730138127_177565721304066749_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBu_bJR3w7EQ7kNvwG9-nEr&_nc_oc=AdpnqB7ZD3hJOp_V0peUHFJQGTRFgCw2wZhvQCE0QgkpH6JTo2ZABN4xrnnWJy2ziPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_h1irNe9vy6uKlRe1wZFhwM8MiWztfJ6ZzR57oJXb5Q&oe=69E397C7"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "# \u2694\ufe0fDuel Mode Update\u2694\ufe0f\nThe new game mode, \"Duel Mode,\" is officially live!\n\nEngage in an intense 1v1 showdown! Keep winning to rack up a streak and claim exclusive rewards!\n\nIn addition to the base stage, the new Japanese-style room stage \"Imperial Court\" has been added, where tranquility and razor-sharp tension coexist!\n\nPrepare for serious battles that set themselves apart from the usual chaotic game modes!\n# \ud83e\udd77New Shinobi Bundles and gold items have arrived\ud83e\udd77\nFeaturing three unique Ninja skins, cursed katanas, and plenty of Ninjutsu emotes!\n{1252426590309718}\n\n# \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds.\n{776884285280763}\n\n# \ud83c\udccf Change Your Fate with Powerful Gadgets\ud83c\udccf\nTurn the tables with unique gadgets!\n\nHow you use them is up to you!\n{1281296827275240}\n\n# \ud83c\udf81 Freely Customize Skins and Trinkets\ud83c\udf81\nCustomize everything from luxurious skins to various guns and trinkets!\n{1498700681601524}\n\n# \ud83e\uddf1A Multitude of Madness-Filled Stages\ud83e\uddf1\nPlay across numerous stunning stages!\n\nSome feature unique gimmicks, and there are even stages exclusive to limited game modes!\n{1234423705440375}\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/DevilsRoulette-BazookaDiscord\n{1265613525112501}", "short_description": "\u2694\ufe0fDuel Mode Update\u2694\ufe0f\n1v1 \"Duel Mode\" is officially live! Win and claim your rewards!\nPlus, the new Japanese-style room stage \"Imperial Court\" has been added!\nNew bundles and gold items featuring Ninja skins and cursed katanas are also here!\n\n\ud83c\udfb2Test Your Luck, Risk It All\ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestv
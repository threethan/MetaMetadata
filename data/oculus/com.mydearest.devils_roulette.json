6b62\u753b002.png", "id": "1268209198618182", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618103_1268209205284848_175870726079160182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVIlE5VyREAQ7kNvwFzoi2t&_nc_oc=Adr7wrQwC6YoH-xdHPIyB1HFGSMOVb3sqJXHfELYqY_6N8sOMIHPr4mcoAYSt-1W_dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z5tAU54K2GFlaX7ryDnERdoudp5ZgdjLGfML-88Ibdg&oe=6A072197"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_10_22.\u9759\u6b62\u753b001.png", "id": "927800316701800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620965_927800320035133_1939254377053725840_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0bWG5inz2cQ7kNvwE17Bmk&_nc_oc=AdoaHH4xjRDy-u2u4vHLMpOHXjDJa31tODLsr3Y7XnWvm7P6kU40imEG3pqgm3hgPKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71kAckvfqC_xIYQ3OL_OLEkDiKjzumCfafQbyxXSrdTw&oe=6A07331B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "946166168213641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_946166171546974_1657149301340511660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_3fX4NynOsQ7kNvwFhiPGf&_nc_oc=AdrdXFmV3THgoYt51a6aUzel5g40n8l2k1RLg6_mhcxDtDi2kf8IE9iHm6shOMjavnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gd6tTFg4l1E9kM3kOHapnTz5j-HlyL43_5-U9z04q9Q&oe=6A0736C9"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "# Devil's Roulette Renewal \nWhere devils congregate, and where guns, luck, mind games, and chaos reign supreme, hell's most wanted social club, \"Devil's Roulette,\" has been reborn.\n\nPull up a chair \u2014 if you've got the nerve.\n{1517005079785838}\n# \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil's Roulette -The Pit- is a thrilling VR party game for 1 to 4 players, featuring a variety of high-stakes game modes including Russian Roulette, Spin the Bottle, card-based bluffing, and more. Ready to go feral?\n{1956211188619923}\n\n# \ud83c\udf81 Freely Customize Skins and Trinkets\ud83c\udf81\nCustomize to your heart's content, from luxurious skins to an arsenal of guns and trinkets!\n{1498700681601524}\n\n# \ud83e\uddf1A Multitude of Madness-Filled Stages\ud83e\uddf1\nBattle across numerous stunning stages with unique gimmicks, including some exclusive to specific game modes!\n{1234423705440375}\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/DevilsRoulette-BazookaDiscord\n{1265613525112501}", "short_description": "Devil's Roulette -The Pit- is a thrilling VR party game for 1 to 4 players, featuring a variety of high-stakes game modes including Russian Roulette, Spin the Bottle, card-based bluffing, and more. Ready to go feral?\n"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27019940037601487
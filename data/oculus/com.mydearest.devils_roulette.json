.com/v/t64.5771-25/499618102_1601387780865776_7607607580382019117_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg9JLl2kndsQ7kNvwFtIp2s&_nc_oc=Adn-pXsymBJqbaJ8pnojqYuvVEMDQTUlxhXwvaemFYbhVUv4AMjzY2sfZwLhiliX150&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJM2l9NRXJxd821tfyGRNqQs74J8epuAGOTujHwGlZ1w&oe=69B941B8"}, {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.00_24_27_13.\u9759\u6b62\u753b020.png", "id": "741326425571848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304952_741326428905181_5630928057903513600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujNkQgEWx8kQ7kNvwHo1_g3&_nc_oc=Admw85K0w1Etm5xFKcxxtZz5qCr05HdDcn-2cxCdzVl-JokRRFV4aEVCs8xZ6gN1nww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQZB5ZCoWWWBoHSpH-icknRcw7TFOcVl882IOdzySPKg&oe=69B949CD"}, {"file_name": "491823423_550999874316041_1310341557468112608_n.png", "id": "882148854989889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_882148858323222_863781742134078798_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEV0tFAl-SwQ7kNvwE9E2iJ&_nc_oc=Adks_PflZq_s2V59_867SOHGkwsOajq2Nwc60RRPCGss3SENB-66chXqmJXteFleyDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0zy2Qes-i8x3LnQ_Or8uN2tm7TpUVqUuauDNXFwgR_g&oe=69B9512F"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_09_58.\u9759\u6b62\u753b003 (1).png", "id": "1355697072949774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303788_1355697076283107_5271650503218036953_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCzsNWEt-mQQ7kNvwF9TZ85&_nc_oc=AdlZXP-WFLWhZ9Bq1qUMAUfl_KsFy3TaVcisrdQ7dXz1MCnnpnhm8CYnTVxZtVNpHxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVU41Tf5Q2ISUk06qSt-bl1-Hw9Kghe25mn-HWw5BTCA&oe=69B93417"}, {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.00_05_40_13.\u9759\u6b62\u753b004.png", "id": "1131832842275351", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299789_1131832845608684_8165321215486578341_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHLNuqbDDbIQ7kNvwF9I6C7&_nc_oc=Adn1yBlqIOhnBdIsayhChsQxT0ssmKliCSmPwwGXrpyfneffa5xStTrHPZUe17sOwDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwztTGqO9NeStRyZQtoSjmq402SlK9epAmhCg9M7iBnBA&oe=69B9482A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KV.png", "id": "26191991047129687", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_26191991053796353_8243499891296228702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCViesCKjmMQ7kNvwGQlIGP&_nc_oc=AdmkYciReipabom7noXviMSePfsniTmB0fPan7wNEIJwb_DFCys4WgPs72VdVK_Oeyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzsvk1Laf_dNKRwEEDFBWKQ5_mSqgbXo0W3QCKMza7Szw&oe=69B9329F"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "\ud83e\udd5a\ud83d\udc07Welcome to the Demons EGGspress!\ud83d\udc07\ud83e\udd5a\nA brand new stage has landed in Devil's Roulette!\nWelcome to Wonderland! Take a seat in the gazebo, watch the passing trains, and test your luck! \n\nWatch out for exploding eggs!!! Shooting the eggs loaded onto the train can trigger massive explosions and deal damage to nearby players!\n\nDon't forget to grab the new Mad As A Hare EGGsclusive Mega Bundle! This mega bundle has gotten a major upgrade. Not one, but THREE skins that each come with a reaction animation! Not one, but TWO gun skins! Not one, but TWO Emotes! And more! These are the first bundle skins with animations so don't miss out!\n\n## \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?\n\n## \ud83c\udccfChange Your Fate with Powerful Items \ud83c\udccf\nTurn the tables using unique gadgets distributed each round! Enhance your reflexes with a bullet-dodging energy drink, stun your opponents with a modified taser, and much more. Outwit your friends to survive another turn!\n\n## \ud83d\ude08Face the Ultimate Test of Courage\ud83d\ude08\nLaugh, scream, and sweat through this intense game of chance. Are you brave enough to pull the trigger, or will fate catch up to you? Gather your friends and experience the ultimate blend of suspense and hilarity in Devil\u2019s Roulette!", "short_description": "Welcome to the Demon EGGspress!\nA brand new stage has landed in Devil's Roulette!\nWelcome to Wonderland! Take a seat and test your luck! Watch out for exploding eggs!!! Don't forget to grab the new Mad As A Hare EGGsclusive Mega Bundle!\n\n\ud83c\udfb2Test Your Luck, Risk It All\ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": 
9759\u6b62\u753b001.png", "id": "1306186211382373", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619668_1306186214715706_6363926784507361278_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4tGPEkEcugQ7kNvwGhCUoz&_nc_oc=Adpz6J2dTJSq-1i9CiH8G00goFTtgzOU7nhNaIsZFUZRSJU3F21P9LNq-J2w4qCAd6g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2QCoRy42XGuayKctPRoIWVXZNSsrg-g5fgXYuf4KeoFg&oe=69F34672"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_37_10.\u9759\u6b62\u753b002.png", "id": "1268209198618182", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618103_1268209205284848_175870726079160182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXwwox21YN4Q7kNvwEZfsS8&_nc_oc=AdpH9kF3deYDMHvnLF_tfBqegwkPzCm8ftgf5yjAUiuD1aa6fOsRW1nyPw5_vzvGpck&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24ZYDdGBubtOptruKmA72-Z_4VePHAFKz4S2J4Sy_HYA&oe=69F35B17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "2108656746647981", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619450_2108656749981314_3140783798298710580_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB2skLWEb3MQ7kNvwGHB0B9&_nc_oc=AdqhcI5-E_iYYJBntCjZt6dr-O3GH0bkgQBRSTdzQsDbXkUclH1Xlb1QnNNTBNjcpjI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qG49QfQyfKWFdKcMGirpqMboKzbPWlIpxZY-12Dlg7g&oe=69F34211"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "# \u2694\ufe0fDuel Mode\u2694\ufe0f\nThe new game mode, \"Duel Mode,\" is officially live!\n\nEngage in an intense 1v1 showdown! Keep winning to rack up a streak and claim exclusive rewards!\n\nIn addition to the base stage, the new Japanese-style room stage \"Imperial Court\" has been added, where tranquility and razor-sharp tension coexist!\n\nPrepare for serious battles that set themselves apart from the usual chaotic game modes!\n# \ud83e\udd77New Shinobi Bundles and gold items have arrived\ud83e\udd77\nFeaturing three unique Ninja skins, cursed katanas, and plenty of Ninjutsu emotes!\n{1252426590309718}\n\n# \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds.\n{776884285280763}\n\n# \ud83c\udccf Change Your Fate with Powerful Gadgets\ud83c\udccf\nTurn the tables with unique gadgets!\n\nHow you use them is up to you!\n{1281296827275240}\n\n# \ud83c\udf81 Freely Customize Skins and Trinkets\ud83c\udf81\nCustomize everything from luxurious skins to various guns and trinkets!\n{1498700681601524}\n\n# \ud83e\uddf1A Multitude of Madness-Filled Stages\ud83e\uddf1\nPlay across numerous stunning stages!\n\nSome feature unique gimmicks, and there are even stages exclusive to limited game modes!\n{1234423705440375}\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/DevilsRoulette-BazookaDiscord\n{1265613525112501}", "short_description": "\u2694\ufe0fDuel Mode Update\u2694\ufe0f\n1v1 \"Duel Mode\" is officially live! Win and claim your rewards!\nPlus, the new Japanese-style room stage \"Imperial Court\" has been added!\nNew bundles and gold items featuring Ninja skins and cursed katanas are also here!\n\n\ud83c\udfb2Test Your Luck, Risk It All\ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.c
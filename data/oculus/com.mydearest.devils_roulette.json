n.com&_nc_ss=7f20f&oh=00_AQNy5u9_K7s2lu0KpI5zuvnPx_UWQLLRggqsgy_eP5z49Q&oe=6AC7AA92"}, {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.00_04_00_23.\u9759\u6b62\u753b021.png", "id": "548836344575764", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393656_548836347909097_458018449487991569_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75cnOKagSIMQ7kNvwFO6zuo&_nc_oc=AdqlEZq3U2PCGRrpeC-HeiWxRjL7pytAhL0iMLzGS0by3vRtpCgON-HamEZM8Cp68_o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPETmerl0_mUr2HedNsFiUjaSAHFN5G_tyIzD1SbgCObA&oe=6AC7A30F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "648698288002482", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393704_648698291335815_313826250243317708_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AX5dnb8oJsQ7kNvwGM0FfR&_nc_oc=AdoealAyA_wavEoxqx-U22u76LYSI3doR_Dycgn_jCJa10anfgNiDc1LrCr6JURvJ2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5bKbO4ALggkFA2Zy1T4SSLSoikSfn3tm7bnNGUPxKCg&oe=6AC79F49"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "Free for a limited time only!\n\n\ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?\n\n\ud83c\udccfChange Your Fate with Powerful Items \ud83c\udccf\n Turn the tables using unique gadgets distributed each round! Enhance your reflexes with a bullet-dodging energy drink, stun your opponents with a modified taser, and much more. Outwit your friends to survive another turn!\n\n\ud83d\ude08Face the Ultimate Test of Courage\ud83d\ude08\n Laugh, scream, and sweat through this intense game of chance. Are you brave enough to pull the trigger, or will fate catch up to you?\nGather y
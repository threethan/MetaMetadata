uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299789_1131832845608684_8165321215486578341_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnJ1ABemE2kQ7kNvwGqC5yd&_nc_oc=Ado_ZsJAsrwOVeRRqR7_aqt9eLLUVFaIZnT7JMYOXS00tz_DOVE1E6nhFYlAZpw4Fpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ArlVc4T3W1UG4HztCuGW3SZwlvj5sWbX2OAZoYBDpsA&oe=69D4F7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1422491785757141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619145_1422491789090474_6348550772393873155_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBMmIy06EU0Q7kNvwEiUC12&_nc_oc=AdpCSeK5xtCPkCzh6866er6PKU_fhDZsuIZMbChOfYdoyTRlOCfyBMIMAaWaEjOVnm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XAQR2ogXDp6mBCazvgbf9tPv6OCFoGtVZK_4737LoTw&oe=69D51004"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "# \ud83c\udf40The Lucky Charms Update\ud83c\udf40\nThe luckiest update yet!\nA brand new type of item has arrived in Devil's Roulette! **GUN CHARMS!!** Now you can show of your personality and style with your choice of 14 charms! \n\nNew rare drops in the Reels Of Fortune!\nTry your luck at grabbing these new rare skins, emotes, and items, including two new **GUITAR TRINKETS**!!!\n\n# \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?\n\n# \ud83c\udccfChange Your Fate with Powerful Items \ud83c\udccf\nTurn the tables using unique gadgets distributed each round! Enhance your reflexes with a bullet-dodging energy drink, stun your opponents with a modified taser, and much more. Outwit your friends to survive another turn!\n\n# \ud83d\ude08Face the Ultimate Test of Courage\ud83d\ude08\nLaugh, scream, and sweat through this intense game of chance. Are you brave enough to pull the trigger, or will fate catch up to you? Gather your friends and experience the ultimate blend of suspense and hilarity in Devil\u2019s Roulette!", "short_description": "The luckiest update yet!\nA brand new type of item has arrived in Devil's Roulette! GUN CHARMS!! Now you can show of your personality and style with your choice of 14 charms! And to top it off there's new rare drops in the Reels Of Fortune!\n\n\ud83c\udfb2Test Your Luck, Risk It All\ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26651071431155018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.c
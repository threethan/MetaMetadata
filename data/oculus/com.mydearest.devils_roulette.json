u9759\u6b62\u753b001.png", "id": "1306186211382373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619668_1306186214715706_6363926784507361278_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSwqUZ-_qOkQ7kNvwEXpVRm&_nc_oc=AdoWgMWnjfG1b73XNorVQ-oxDrnzRt_f7EWPvKuRI1D9MTq0Ys1ksIA146uGNEbk-Nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mujuQcT0WCOXtYFfqHSYSLwHu6l-0Q6ErQXBhsp7OZw&oe=69DE2E72"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_37_10.\u9759\u6b62\u753b002.png", "id": "1268209198618182", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_1268209205284848_175870726079160182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tcBs1ZhyPAQ7kNvwErxPb7&_nc_oc=AdrtF7I49gqT-RQNCcu5uXb062CvnwNBiWVgyqokRWCi2LRDbbvo-_Oxv_0RiNsu1D8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uX-5-OMM3u8YKhuH9rwgrJKlGxbS5hiK_PBgV0sO71g&oe=69DE4317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "3333738726804794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618093_3333738730138127_177565721304066749_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF7C8FjRex4Q7kNvwHVMpOl&_nc_oc=AdrvJSiDqxrZUgnQoin22_1M3BIKn2oTIj2rtQ22IxD3VtDXwAqt2Fb4WZ7oeeqcoCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mleSR43wVcuJQYLmV0Me1elxcdua8n5rF0LxVRMq2gw&oe=69DE51C7"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "# \u2694\ufe0fDuel Mode Update\u2694\ufe0f\nThe new game mode, \"Duel Mode,\" is officially live!\n\nEngage in an intense 1v1 showdown! Keep winning to rack up a streak and claim exclusive rewards!\n\nIn addition to the base stage, the new Japanese-style room stage \"Imperial Court\" has been added, where tranquility and razor-sharp tension coexist!\n\nPrepare for serious battles that set themselves apart from the usual chaotic game modes!\n# \ud83e\udd77New Shinobi Bundles and gold items have arrived\ud83e\udd77\nFeaturing three unique Ninja skins, cursed katanas, and plenty of Ninjutsu emotes!\n{1252426590309718}\n\n# \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds.\n{776884285280763}\n\n# \ud83c\udccf Change Your Fate with Powerful Gadgets\ud83c\udccf\nTurn the tables with unique gadgets!\n\nHow you use them is up to you!\n{1281296827275240}\n\n# \ud83c\udf81 Freely Customize Skins and Trinkets\ud83c\udf81\nCustomize everything from luxurious skins to various guns and trinkets!\n{1498700681601524}\n\n# \ud83e\uddf1A Multitude of Madness-Filled Stages\ud83e\uddf1\nPlay across numerous stunning stages!\n\nSome feature unique gimmicks, and there are even stages exclusive to limited game modes!\n{1234423705440375}\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/DevilsRoulette-BazookaDiscord\n{1265613525112501}", "short_description": "\u2694\ufe0fDuel Mode Update\u2694\ufe0f\n1v1 \"Duel Mode\" is officially live! Win and claim your rewards!\nPlus, the new Japanese-style room stage \"Imperial Court\" has been added!\nNew bundles and gold items featuring Ninja skins and cursed katanas are also here!\n\n\ud83c\udfb2Test Your Luck, Risk It All\ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26742022252059935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_949817507911557_5140056915825755603_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-drlmuzJhIQ7kNvwGwpSc1&_nc_oc=AdpiTE92jcfOGYsL5zVffgUrTZBIY5YX_R8YuvM6Y6URwI6uWlsLEt8-s74ioob8PBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1781dh1y4m4Wi8ybiKwWk3bmlMpVC8QKEHFbEQSOXBrg&oe=69DE2A68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Devil's Roulette", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1746723600, "lastRevision": {"nodes": [{"id": "9731954456826647", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9731954420159984", "is_first_party": false, "enables_in_app_ads": false,
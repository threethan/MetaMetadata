le_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.00_04_00_23.\u9759\u6b62\u753b021.png", "id": "548836344575764", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393656_548836347909097_458018449487991569_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LvvsVmjHOYQ7kNvwH71MEn&_nc_oc=AdqQBQ3NzGF6heEULDV1PEIXeVkTe4xgv90Q6UUm4A9E7Vr6WEU4EW0mj2yvlue8RVA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxcBYSP3qo37MUc9o9c6HuJm3l9vbiWDUheD0nRX_oVA&oe=6A8D68CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "648698288002482", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393704_648698291335815_313826250243317708_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHUVeZjZQAMQ7kNvwFDCDZe&_nc_oc=Adp32TIcJgShYhwq85UMvaZkJFQq7nMrPo6lJOMbu6DAxZq4qobDrvilmkNePjquzCY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa0kk8wC-XKFlnF5xUd408sx_lhGtcaZ1p374Tq4Be8Q&oe=6A8D9D49"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "Free for a limited time only!\n\n\ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?\n\n\ud83c\udccfChange Your Fate with Powerful Items \ud83c\udccf\n Turn the tables using unique gadgets distributed each round! Enhance your reflexes with a bullet-dodging energy drink, stun your opponents with a modified taser, and much more. Outwit your friends to survive another turn!\n\n\ud83d\ude08Face the Ultimate Test of Courage\ud83d\ude08\n Laugh, scream, and sweat through this intense game of chance. Are you brave enough to pull the trigger, or will fate catch up to you?\nGather your friends and experience the ultimate blend of suspense and hilarity in Devil\u2019s Roulette!", "short_description": "\ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1676485315806614"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "10015511155137641"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "981630864176853"}]}, "baseline_offer": {"id": "981630864176853"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746723600, "status": "PUBLISHED", "id": "981630864176853"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28326275136967964", "version": "1.39.0"}, "id": "521997510646068", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Androi
scdn.com/v/t64.5771-25/499618102_1601387780865776_7607607580382019117_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koAVpcBC3DgQ7kNvwHOb_zz&_nc_oc=AdlBTUsrW61MIvOvCoF7JtNsFTTMaLA2gB-_JYRtID2ZwrXuGpaqis4AJyfdY3rAI7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvqh-cE-4icvBrmi3_Pvde0NW5bA6SsBkgEudmukfhUDA&oe=699D9238"}, {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.00_24_27_13.\u9759\u6b62\u753b020.png", "id": "741326425571848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304952_741326428905181_5630928057903513600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D9NUQA-Qt0Q7kNvwEWOnq2&_nc_oc=AdnHHuzDmv8yoI24ikKLneblE6nKFl24WHKx24M8FjWbt7jGOSgeXor0oAssjwc8mHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftRFz3rGIPTzPE7h8SOcNvL21qfSTh6KtutyIGYSSA_9w&oe=699D9A4D"}, {"file_name": "491823423_550999874316041_1310341557468112608_n.png", "id": "882148854989889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_882148858323222_863781742134078798_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvXO-aWkKmQQ7kNvwH0IRPU&_nc_oc=AdlGyYYbLSdqkDqQiLr78NiyYX8qTKs8xH5Z7h1oOfuqoq6ewIsepDa6DS-4umUkM1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlkTMMWGvmKElAQyeiRXqnZTPg7uKu5b2xkAPefo5ldA&oe=699DA1AF"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_09_58.\u9759\u6b62\u753b003 (1).png", "id": "1355697072949774", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303788_1355697076283107_5271650503218036953_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_XGUEptVyoQ7kNvwGkAkuI&_nc_oc=AdneXBLoqiiTQSyaWGx9pg-9zi9pgw48u377U-ZtS2lKd_2YzoiUODM-ZR46V0sCNVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuI3fbMvCJXPanYRioefyzf8IP2xvpg2ceWhWaFtIx5pw&oe=699D8497"}, {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.00_05_40_13.\u9759\u6b62\u753b004.png", "id": "1131832842275351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299789_1131832845608684_8165321215486578341_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i10jgGJzv0EQ7kNvwE4e6pz&_nc_oc=Admgi7e4Qh5fqrzg3gcjPkIul6k3Ut1USRVEESUzWHnD6UrJco-mdxrY4MAtb9XIefQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftnLj6ypdM2vP5xRbD2-l35aB3rMDgR17CNo1dhvKLEAw&oe=699D98AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1307055871442792", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_1307055874776125_6094282458212710047_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKjbteztqgQQ7kNvwFZ2081&_nc_oc=Adk0wY6orz7iHK1xUyRbutjR0KKb-m3kuFLDK3p0Qacyafc91P97Q-kUTxoRkhA2lBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvhy7VfR_zLV0_bHZeCytbhK2ZW28eErsbWvW6vWlu1EQ&oe=699DA778"}, "display_name": "Devil's Roulette", "keywords": [], "long_description": "\ud83e\ude77The Potion or Poison Update is HERE!!\ud83d\udc80\nWe've added a brand-new gadget to the game: the POTION!\n\nDrinking the potion can be delicious, causing your head to shrink and making you harder to hit!\n\nOr, it could be bitter, making your head grow bigger and creating a massive target for your enemies!\nYou'll never know which effect you\u2019ll get until you take a sip!\n\nPlus, we have the new Harrowed Heartshot Exclusive Mega Bundle! It\u2019s packed with new Valentine's Day-themed items, including the \"Heart Piercer\" Crossbow Gun and a \"Cupid's Cake\" you can actually throw at your friends for hilarious effects!\n\nCheck out the new POTION gadget and the other Valentine's Day items now!\n\n## \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?\n\n## \ud83c\udccfChange Your Fate with Powerful Items \ud83c\udccf\nTurn the tables using unique gadgets distributed each round! Enhance your reflexes with a bullet-dodging energy drink, stun your opponents with a modified taser, and much more. Outwit your friends to survive another turn!\n\n## \ud83d\ude08Face the Ultimate Test of Courage\ud83d\ude08\nLaugh, scream, and sweat through this intense game of chance. Are you brave enough to pull the trigger, or will fate catch up to you? Gather your friends and experience the ultimate blend of suspense and hilarity in Devil\u2019s Roulette!", "short_description": "The Potion or Poison Update is HERE!\nTry the new POTION gadget! Drink it to find out if it will shrink your head (harder to hit) or make it grow (massive target)!\nPlus, the Harrowed Heartshot Exclusive Mega Bundle is out now!\n\n\ud83c\udfb2Test Your Luck, Risk It All\ud83c\udfb2\n Devil\u2019s Roulette is a thrilling VR party game for 1-4 players, where you'll bravely pull the trigger of a pistol loaded with random live rounds. Every turn is a nerve-wracking gamble\u2014will it fire, or will luck smile upon you?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
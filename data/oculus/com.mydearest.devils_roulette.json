759\u6b62\u753b002.png", "id": "1268209198618182", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618103_1268209205284848_175870726079160182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hys_FDg21rQQ7kNvwEoBkfs&_nc_oc=AdoqxVqAOgGFPx8bSYrMrc23G2xqCDw4n7vUbuV0KjVsoWpNzlmt_17wVxHg0wV900s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vqzBcKh1mACyTEkvlkk2PyedXy3GiUx1IiTVcWTURVQ&oe=6A0C6797"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_10_22.\u9759\u6b62\u753b001.png", "id": "927800316701800", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620965_927800320035133_1939254377053725840_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M1pkaDFYPkQ7kNvwHAEwSS&_nc_oc=AdoMt3XmrJ3aKoRuC4rSPKhpMrZNDxsMY0QotaYWFijV3qB8Fa3PzfOzAILIUf6rh_s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RSaEHqUyy34My-co__bfc1-IVm82L7ZWxY4tibdJouQ&oe=6A0C791B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "946166168213641", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617831_946166171546974_1657149301340511660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIb4wmjuKA4Q7kNvwFBQZtF&_nc_oc=AdrtvVJoFsaUQNjE5cUW-qsBFyOrXaVNsIbVRDqrcYhdEX4kwh1Ujwo_iC46YNKBi3Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DNz_dKXOzmc1ACG0qaIO2BXE5GkPNbX4nNCE2DCFzpw&oe=6A0C7CC9"}, "display_name": "Devil's Roulette  -The Pit-", "keywords": [], "long_description": "# Devil's Roulette Renewal \nWhere devils congregate, and where guns, luck, mind games, and chaos reign supreme, hell's most wanted social club, \"Devil's Roulette,\" has been reborn.\n\nPull up a chair \u2014 if you've got the nerve.\n{1517005079785838}\n# \ud83c\udfb2Test Your Luck, Risk It All \ud83c\udfb2\nDevil's Roulette -The Pit- is a thrilling VR party game for 1 to 4 players, featuring a variety of high-stakes game modes including Russian Roulette, Spin the Bottle, card-based bluffing, and more. Ready to go feral?\n{1956211188619923}\n\n# \ud83c\udf81 Freely Customize Skins and Trinkets\ud83c\udf81\nCustomize to your heart's content, from luxurious skins to an arsenal of guns and trinkets!\n{1498700681601524}\n\n# \ud83e\uddf1A Multitude of Madness-Filled Stages\ud83e\uddf1\nBattle across numerous stunning stages with unique gimmicks, including some exclusive to specific game modes!\n{1234423705440375}\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/DevilsRoulette-BazookaDiscord\n{1265613525112501}", "short_description": "Devil's Roulette -The Pit- is a thrilling VR party game for 1 to 4 players, featuring a variety of high-stakes game modes including Russian Roulette, Spin the Bottle, card-based bluffing, and more. Ready to go feral?\n"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/devilsroulette.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2
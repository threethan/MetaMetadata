KBGDa8H-g&oe=69E0D7A5"}, {"file_name": "57568672_247341596456942_8807644349635493888_n.png", "id": "372222774610173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230047_372222777943506_3225783519573656997_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_VUw2mo14MQ7kNvwFtDva9&_nc_oc=AdogM4Wx8FhMVdYAPojvbWfIOs6Cq8X0oudZ0tlcPS1STZR9qavOd8EL2AgKv6Ve1F4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V-fjozm2TtT16WlCIvitQW1T_qblpVWAyW01IiEvC_A&oe=69E0D733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "2163812713760600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65229464_2163812717093933_4927926012484141391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL8MnMTrGyYQ7kNvwEQ1h1v&_nc_oc=AdrQAdlippHi9trLZPE-ozRokfutL90EGwOIewdjWOr_Ijw-cdT0j5OWsGPC-nC7-Vk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X4ZjwWnsuf2-O2iplfq1RH0XfsDxCA18t-4-BQeEzGA&oe=69E0E10F"}, "display_name": "Prospect by IrisVR - App Lab", "keywords": [], "long_description": "Prospect is the leading VR platform for BIM & VDC teams and design firms to collaborate and perform model coordination. \n\nWith one click, you and your team can instantly walk through 3D models from Revit, Navisworks, SketchUp, Rhino, and more in your Oculus Quest to perform QA/QC, design review, trade coordination, and more.\n\nProspect by IrisVR helps top ENR firms around the world instantly resolve model issues and catch errors that would have remained hidden using only 2D and traditional 3D methods, cutting down on rework costs and project delays. \n\nOur Quest app allows you to: \n- Sync models between your Prospect Desktop Library and the cloud with one click\n- Inspect individual elements to view BIM in VR\n- Measure, make markups, and capture Screenshots \n- Compile PDF Reports to capture feedback from VR meetings and track issues", "short_description": "Prospect is the leading VR platform for BIM & VDC teams and design firms to collaborate and perform model coordination.\n\nWith one click, you and your team can instantly walk through 3D models from Revit, Navisworks, SketchUp, Rhino, and more in your Oculus Quest to perform QA/QC, design review, trade coordination, and more."}]}, "developer_name": "IrisVR, part of The Wild", "developer_privacy_policy_url": "https://irisvr.com/privacy", "developer_terms_of_service_url": "https://irisvr.com/terms", "publisher_name": "IrisVR, part of The Wild", "support_website_url": "https://help.irisvr.com/hc/en-us", "website_url": "https://www.irisvr.com/prospect", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "UTILITY", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "228836962792332"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "9383811931652821"}, {"status": "PUBLISHED", "id": "589700638732710"}]}, "baseline_offer": {"id": "9383811931652821"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736960940, "status": "PUBLISHED", "id": "9383811931652821"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25180007721611339", "version": "1.0.4861"}, "id": "388738389561920", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [
305093131841_3216885253386082176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6YBJGJuo34Q7kNvwFcVSaa&_nc_oc=AdkzT947xXq7yrHDIUV9Em7ttrv3jE6XuY-R2kpB03sR4lppCrmVrsYHt8x7roOQucY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUWbhqbmKjMPZ_wm616QUYXgCVjJB7UI5CuZdC_KIkcQ&oe=69BBFAE7"}, {"file_name": "6.png", "id": "2970772379912742", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982586_2970772383246075_8475068566624943312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvMMhrMSnQQQ7kNvwEGWYOq&_nc_oc=AdnHp2fnutmBWI1-f7rsUZGfbBNVec7hmDJsvHw-4yDktgvDN_ZT4jDbPv-1xee6D5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2sFHfi4Xd61VZ5f67_kr2j6SNKBrZVkPW95kdWO4-jQ&oe=69BC03D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "2556780137962724", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_2556780141296057_7036247434121901971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtnF2uNgGIEQ7kNvwFEb2Uy&_nc_oc=AdneZLVvV8cQlnk5b4rWexJL1wGHC1afX8FnFEmrL01o5cYNqrmekn3YY4G5f9Hmejk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzziAF57LZmWAMAiSo-sOT4TTf-xmHI7GKHAnbpkUX4-g&oe=69BC089D"}, "display_name": "Stack Defense", "keywords": [], "long_description": "Play this VR game with friends and others via crossplay.\n\nCubes are spawning to your right, grab them and place them on your Table.\nProtect your stack from getting shot down by other players.\nWhile you can shoot their stack.\n\nWin the game by having the biggest stack at the end of the round.\nRoundtime can be set between choosen by the creator of the room.\n\nCreate you own room and coose your prefered gametype and playercount (2-4).\n\nYou can also customize your avatar.\n\nSearch for games or host your own.\nFull Crossplay support! Play on PCVR against Quest 1/2 Players.\n\nHappy Stacking!\n\n\n** Upcoming: Experience und Levelsystem\n** Soon: Use the ingame voicechat for communication.\n", "short_description": "Play this VR game with friends and others.\nProtect your stack and destroy the blocks of your opponents.\nWin the game by having the biggest stack at the end of the round.\nSearch for games or host your own.\nFull Crossplay support! Play on Quest 1 or 2 versus PCVR Players.\n"}]}, "developer_name": "Area 1 GmbH", "developer_privacy_policy_url": "https://stackdefense.area1.one/stackdefense/privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Area 1 GmbH", "support_website_url": null, "website_url": "https://www.area1.one/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "619005295850681"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4791367364210775"}]}, "baseline_offer": {"id": "4791367364210775"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1627417980, "status": "PUBLISHED", "id": "4791367364210775"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4152766918107111", "version": "0.9.5"}, "id": "1221299208327914", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__type
b=1-7&_nc_sid=6e7a0a&_nc_ohc=AisNm7tiIpoQ7kNvwGqJ6SC&_nc_oc=AdrlcJ7FoJT23aXxLsT65ojaBxb4Ho2xssVYZOEiohH0BELVl2tKRqRAKqJyriYw4Ts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRswRk5WDmkkeYKMzrHmPaYa28hQ90X3nqe86wsnoRwog&oe=6B0DC0DD"}, "display_name": "Stack Defense", "keywords": [], "long_description": "Play this VR game with friends and others via crossplay.\n\nCubes are spawning to your right, grab them and place them on your Table.\nProtect your stack from getting shot down by other players.\nWhile you can shoot their stack.\n\nWin the game by having the biggest stack at the end of the round.\nRoundtime can be set between choosen by the creator of the room.\n\nCreate you own room and coose your prefered gametype and playercount (2-4).\n\nYou can also customize your avatar.\n\nSearch for games or host your own.\nFull Crossplay support! Play on PCVR against Quest 1/2 Players.\n\nHappy Stacking!\n\n\n** Upcoming: Experience und Levelsystem\n** Soon: Use the ingame voicechat for communication.\n", "short_description": "Play this VR game with friends and others.\nProtect your stack and destroy the blocks of your opponents.\nWin the game by having the biggest stack at the end of the round.\nSearch for games or host your own.\nFull Crossplay support! Play on Quest 1 or 2 versus PCVR Players.\n"}]}, "developer_name": "Area 1 GmbH", "developer_privacy_policy_url": "https://stackdefense.area1.one/stackdefense/privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Area 1 GmbH", "support_website_url": null, "website_url": "https://www.area1.one/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED
qvjKV4H4LZnRGAm_zzOZmUtjJXsGdlyzfwxeMlf3u1ETIas2mlTTl65r9A8qMDgIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmHDe5Uq4_lgPeoUwokQwrdvwgywSj7V_t_NfKowbquQ&oe=6AE74AEA"}, {"file_name": "com.ngua.vrbase-20260213-135406.png", "id": "1422000019544005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1422000022877338_4934907452008701958_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWSTYxDbGHsQ7kNvwFLhz4C&_nc_oc=AdpBXPARNlYjJsBeTxFo4_yyOz7GcQJ3iFKSlXJOSMzmsu9cfwU6yWkGPdpDKBVfPXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi2GXAc30PU7sq8ue5si0sxjzgWYIs_LIbYwnRr2KH8w&oe=6AE760DA"}, {"file_name": "com.ngua.vrbase-20260213-135444.png", "id": "1311751187378587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620860_1311751190711920_6734640459296736948_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CwlTAo1s9sQ7kNvwFBFCTl&_nc_oc=AdrtSPwTCl8m8gPSyG4s75RLYJ5uI3DM1c8hNeAgu1mnBqfU_spmP3dMmaM6HYD0fuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3aUlZKDI0EN19BAw6kZ0WDz-dgth8LJNJcl5IWJaPZQ&oe=6AE75BA5"}, {"file_name": "com.ngua.vrbase-20260213-135519.png", "id": "1174740887833336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620429_1174740891166669_5595007207827676095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1eUiQDNDfgQ7kNvwGxc930&_nc_oc=Adr3ZKCJ1DvSOnsUazBwWY8nTO0SyOTE2LCkIUhxd28eCJ93I5pANehSqusQjB2Nnl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThNfZZBR6vOKadfOEXlNyaZD6DC_jfyeQV5FsRpiuvPw&oe=6AE74DB5"}, {"file_name": "com.ngua.vrbase-20260213-135322.png", "id": "1224827645925130", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622334_1224827649258463_6492821264806372627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-CF0t0h3BIQ7kNvwGVgvi0&_nc_oc=AdrquVojW69mrXEIi-Y0-aJmoC4ePhvEJqtf1BsZjOANIPDqJdhEKfn6R49JHHeoZmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2H1ZNz-8TRslF9i5pqh5I03Pu_RJJxExWnet5FYU0Mg&oe=6AE74406"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ball Blitz VR", "keywords": [], "long_description": "Welcome to Ball Blitz VR - the ultimate virtual reality bowling experience!\n\n\ud83c\udfb3 GAMEPLAY\nStep into a stunning VR bowling alley and experience the thrill of the perfect strike. Use intuitive hand-tracking controls to pick up, aim, and roll your ball with precision. Feel the satisfying impact as pins scatter across the lane!\n\n\ud83c\udfc6 FEATURES\n\u2022 10 Unique Levels - Progress through increasingly challenging stages\n\u2022 Star Rating System - Earn 1-3 stars based on your performance\n\u2022 Level Unlock - Master each level to unlock the next challenge\n\u2022 Ball Skins - Customize your ball with unlockable designs\n\u2022 Power-ups - Grab Multi-Ball, Explosive, and Slow-Time boosts\n\u2022 Global Leaderboard - Compete with players worldwide\n\u2022 Stats Tracking - Monitor your progress and high scores\n\u2022 Immersive Sound Effects - Realistic bowling sounds\n\n\ud83c\udfae CONTROLS\nDesigned for Meta Quest hand-tracking. Simply reach out, grab the ball, and throw naturally!\n\n\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67\u200d\ud83d\udc66 FOR EVERYONE\nEasy to learn, challenging to master. Perfect for VR beginners and bowling enthusiasts alike.\n\nDownload now and become the Ball Blitz champion!", "short_description": "Roll, aim, and knock down pins in this immersive VR bowling adventure! Master 10 challenging levels, unlock stylish ball skins, grab powerful power-ups, and climb the global leaderboard. With intuitive hand-tracking controls and stunning visuals, Ball Blitz VR delivers arcade fun in virtual reality. Perfect for players of all skill levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ball-blitz-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": "https://ball-blitz-vr.p
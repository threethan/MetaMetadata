ooter", "mage", "wizard"], "long_description": "In Wave Magic: Battle you fight off the horde of homonculi created from mages long past. Master the four elements to defeat enemies and reach farther heights in your battles. As you play you will level up to learn new spells and abilities allowing you to make more progress. Aim your spells with the Gear VR controller and take the fight to the wastelands.", "short_description": "Battle hordes of homonculi with your magic prowess. Cast spells with the Gear VR controller to defeat enemies. Level up to earn new spells and abilities along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.wixstatic.com/ugd/1d7aa3_35b55c38da6a49d4a4e2f90df92338d9.pdf", "developer_terms_of_service_url": "https://docs.wixstatic.com/ugd/1d7aa3_20c97a5f39f64db098e1a7ad7d8b6712.pdf", "publisher_name": "Overrun Games LLC", "support_website_url": null, "website_url": "https://www.wavemagicvr.net/wave-magic-battle", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "248964157422945"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162708_228339634326604_663888144508125184_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjUUiFDV1iAQ7kNvwF5Y4fi&_nc_oc=AdlOMXBV79LeuouaEDR9b-bx2xhph_jGyHhXPoCDjxkXZ3qObO_oXNaWy50kPPMnYLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-oALEyk6VSyMKSJYIKkGvBikP
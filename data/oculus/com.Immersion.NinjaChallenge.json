Jq16PmWIKc0lDZhT1NgE2swB1pDRjJOPJuKNdctzz2Uwcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZj0gkrMS8a1uGRMqWylJ1vyZIAVYptg46ZlIRzwIYcQ&oe=6B0C4F8B"}, {"file_name": "DN_LWay.png", "id": "1512181229167476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1512181232500809_4799425392250328001_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doT19K5S33gQ7kNvwGlXxHJ&_nc_oc=AdqK056Leqq7kdA6-ipiuS0usxRFWlDUGBe1jwUSVx7hgQxC6rkH6-UV7zu1eESYkJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvh4wBKm_Eq7LPAB1SOU_htsTBFL2aU4H_ItFUXEd3SA&oe=6B0C5B0E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFyoj0saOpkQ7kNvwHVer7j&_nc_oc=Adrd2-n3DXVkFO2QB2oKSw_PIQ3rePprkh4CtvXk-gzPihdpF9rRxGwe_ISdaIBa1WE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJcsfa0_7R65FyXzrjIEhFeYp_kyli-ZGFmZ6nasqGdw&oe=6B0C853A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vjj3Jn10BsQ7kNvwGKdoI-&_nc_oc=AdplDFdFDofg6cWf7rLlGVJzX5v43X57OvfKSOmMHXUqdakPKeAlIDAo385DONO6PH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgXjaaari9-J68gXgHt7khTP8gBENnRDOz84akYKRynA&oe=6B0C4EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSvtW7DE99EQ7kNvwHIVbvv&_nc_oc=AdqvVZ5CuWQcXolH2yVWoA9KyzCV3j6PZ448Y3MBqMVZYfSFnYPmCvqF5DZVYYut7i0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSSafBxTAFbdJkLCCvcoJKLucG-8qB7n_sR92A1owXMw&oe=6B0C73C2"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
jh8LQkQ7kNvwFZ1FWq&_nc_oc=AdlBGepsMQFj8-_jgP2-TbFec7Q4Vvw6dSbIhG6o1n1URL4qBjADVtbRuTQwy-uVl7c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1rjuAm91dASxtwoH83cgiNnty0qXjO86l3EXtN9WuIA&oe=69A4394E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Y3ISisyTwcQ7kNvwFlkUMn&_nc_oc=AdnftK5YxcAImTBPxzc9dJXPzIZpeqb194JMvqdZ0GynsNO98ZASQFlE6A7oDeZ25Z8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsx8SjuWHnAvzBg93z4PK0Yn8kacBELIcZJgGnpzIKvmg&oe=69A42B3A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZr87UftkCAQ7kNvwGwt7Fp&_nc_oc=AdmyNTUPTYUWdBS888boKMuciS5EtKYNsEKCKOvLUuNmGLtj9jaGF1Hdd--S8NZ_Yf8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftX43jioVzVfJro7BI4K3j_X_U4yVHpWcUrwuZevp_Hkw&oe=69A42D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByMxCKXLsRwQ7kNvwHBHoa_&_nc_oc=AdkZWvpcgl5dhOK6-z9uKqQ4MhRJjhRDHk6sieXtxwOugzNP6YpmoPFv-2yfR69o82M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftPaQmiTQWlPLoLmKW2PRByrgdR1NZxnG1s8yfGwV7oZQ&oe=69A419C2"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
D9UstQQ7kNvwE8vsl-&_nc_oc=Adkz6imdhMW2XWaaKZLsGIM2EZXS_EFr8HcHQk6Um2FJUBF2drrSjUyajYJ-hhxqAvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWXAEuxUeZVvj730-XJs-OFrl2VM1JcJYRFtiIqNz8DQ&oe=699DA1CE"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Brc2qNBiZDMQ7kNvwHylo8s&_nc_oc=AdkZu6-3o3hBKXX0uqONX03TtUPFevKPourt6Mltb-nsW_4ndHZz7xhZKre76gKp9rg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWcZDMGy-l97sxFVLdqUX88GedTTae9lplU-S0TQM-KQ&oe=699D93BA"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zVHikJoAKcQ7kNvwFOEqY6&_nc_oc=AdmMqW5d1BiS3geGdNdaj-pot108Pjy5JjM6a2oLcfcMYK0ulwyLv03OBXyzoorJTIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBVmHOxcgM1RINqoWAxuhZha7t6FvlcGD6Qw_DlM5__w&oe=699D95B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af6Xzl1uJF0Q7kNvwFGGfr1&_nc_oc=AdmJGgg9Zq7AIXx3LPQkBfVfbQS_IZsd7RuzJWiakvzITnxhw61oeK0TEWsdPiiSAeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfshIntWYWBVc47sCxWBvuxNhbV0xOgPJrJe1yq7t1sAFQ&oe=699D8242"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
Lu7SysQ7kNvwFixxaw&_nc_oc=AdkdB5YDqIc_tCcjw_4fzNDVbg3EGD4hcH3dZRoZiWVexNXRJFgGeo4dOYsQbNCgVbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftfm5yaVV2d5y0A5h-EzxOyjfg5adF-Y5a0gGWqFecVag&oe=69A2E7CE"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gx1oX60PmEQ7kNvwF24L1_&_nc_oc=AdmgXpreJ0mL7W2doAd08GrM9Oj8ZRvVuLt0E8KIt8yuv5kNyOCv5KGA_hzpDBhor_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJ2W3OgarslZIbJJiaUSHiDd4p1RhmnsOIiic-prM7_w&oe=69A2D9BA"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZr87UftkCAQ7kNvwGP2uFq&_nc_oc=AdmYn8W-I1j41Of2KokmR1Xbc3E6NUUKGPbBffyHux3UteezgKP1Ucq2TmmJNLJEqdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyXC2Dd7iAW8t89kgam0R4mVUq3ymBHUlSuam-bLcHAg&oe=69A2DBB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByMxCKXLsRwQ7kNvwHbi_4G&_nc_oc=AdlY9IogCvKyy95n-L4IrDRek8JAfwdsjfitf5SUW-dsI2IhJz6knsHOO3gk9c0MeFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuoloph2-IgmxKw4KM_z0t_F-42aB1PsyKdcGmg3rLtfQ&oe=69A2C842"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
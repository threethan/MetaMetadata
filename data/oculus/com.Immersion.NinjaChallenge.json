eg7pWKWUwShdrOpSLYtSTbjzVQva2lsw4MNS46h6vvG6-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyV-sDJdaX_OrlJ4W0Xpw83FD4g52lNscizcwgGWsz9Q&oe=6B0DA10B"}, {"file_name": "DN_LWay.png", "id": "1512181229167476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982625_1512181232500809_4799425392250328001_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doT19K5S33gQ7kNvwFcL70A&_nc_oc=AdpdwktXFAArC4NB9hX-KkgxKGIe6-rOH1HRakIFMLrnOc3py9iELA3azBewc1EyrGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSiXX4jDWwxrEjfkxkNW-RRw1QClzhYQ8GmUypjNhRkiA&oe=6B0DAC8E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFyoj0saOpkQ7kNvwHPjUDF&_nc_oc=AdrvPTThN0bRGPKuNbrMrLpujRJe8jq1L4cIFM73C2z2HKZQWtECunzgMsmksxJFsQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvjJaTCzlgos9MZsQ0Y_0dsVIopWDhVubwOO_iVhdigA&oe=6B0D9E7A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ygqz8A9tCcQ7kNvwFybVAB&_nc_oc=AdpXGYS_QBF87NgQog3InU0aHN9kwlohcGVxsdTHw0dSSt8rKWGITsScMIUs38wp4DI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwAVVRmIGeeOasSITo2X6gap6j0jpnkXtgjWledq0n0Q&oe=6B0DA073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSvtW7DE99EQ7kNvwFJ9oCK&_nc_oc=Adqu5NsGnA-d5jcgCMcasVGZXyi2116i4oq08lVB9xt9Mj5jWcempnYivpNOKQuKpBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8mokL1SXydbuUHifwZePKSOEg9rfI0odkJMDANdZmoQ&oe=6B0DC542"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
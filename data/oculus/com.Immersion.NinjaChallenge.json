3.oculuscdn.com/v/t64.5771-25/38982625_1512181232500809_4799425392250328001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHFjbmo01GMQ7kNvwFMnu0H&_nc_oc=Adra3tTYvV1XQxqWxyyf8psHDStM_U2mI9TmuuwJXEN68oFEbcV-qDF5Uoc5W8sZJeo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0HHbHHCo60DHJNDh1zWMv8I2jJiK5oHSwz0-Eanq00Q&oe=69CBC64E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-N_aLMIkg0Q7kNvwGH1sKb&_nc_oc=Adrhdfk8dAUzZNH7Cfay8lIP_9iT2geRO1_gylff_zlAk_3pwtopiIK1Kr9l1l_DXt8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_K37L9_88GEGg96lFKRkA14NhVuPkw8QqBIKLruA-bw&oe=69CBB83A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3uYy-laE7oQ7kNvwHa7E0C&_nc_oc=AdrIbByWS3e7lPoMNARpFAKQ-QDh2Y8Vy-9Ew_woA9ik_VQ-UeMYIVB_BFhvzYI6uFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0yKhx8F_g7sy1QKbnJoQ_4y6r2J2oBOXsSM6yHj8YSQ&oe=69CBBA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PM5mokdLW0Q7kNvwGo9cbC&_nc_oc=AdoTz5OZvhKyDfDPmOzPMy6Fs8l4xJsRnDp6kQU1mH2MPxrkx4Lly5cU1vA6r-tAwLw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIi9JADDiPG5OklmQA6yySCwU0WIKJ2ZruYzx61KhqHg&oe=69CBDF02"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": n
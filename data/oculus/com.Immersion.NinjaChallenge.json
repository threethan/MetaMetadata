TJC5UDu44okSGQCJtt_UX61uU2RgB8vwe5hEt-owkp-7wE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt0n7sAXoHwXvTvAfV3Xv8bYLaUCIUVGtH5KTxd4-pYQ&oe=6AFDCF0B"}, {"file_name": "DN_LWay.png", "id": "1512181229167476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982625_1512181232500809_4799425392250328001_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAXbaOOFscgQ7kNvwESHR-1&_nc_oc=Adohl3OB-rQf3Q3FyLovnDKOIQL_hjeVmkBuZpyfSgj_87YC2XYPGSXZoOBjGclPJfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqHA3wZBsTavAWG8BykxGdYsUVgayFnjSK95rCzOawDQ&oe=6AFDDA8E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npVSCUZGP2UQ7kNvwGT_WNA&_nc_oc=AdonPL2Yg_nkBlXx9Gj7DSTTtQD9_k2NX8my4IAEXOEh9d6e6wgXbANvjWQZIj6s2fw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-6dDsG4D3AMlFuo3NqrgofxYXquWfRmytcoa9ezea9Q&oe=6AFDCC7A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLHihHqbPMQQ7kNvwEXzgzo&_nc_oc=AdocwQtK4fHO_RCNP0Ik9W222Zha2HUjs1eY9360fgZCRCMikGAj8opQNB8fePLYXFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSPyJ6AwyjctIkj9twmMcbfUnZQrZEhF9wsDJ75DayLw&oe=6AFDCE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdCJZvAvkU8Q7kNvwEW2e4J&_nc_oc=AdpAOyYnv1-Z0BVi_YIvuVQi-rL6YdgFsNDnqHFyuH4zmsozlfcgeK0MzvMlFdp69TU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOfxqAQftTkgwFD4jSTkz0GQKTIDSga0sqNuX4pfinWg&oe=6AFDBB02"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
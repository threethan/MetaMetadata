512181232500809_4799425392250328001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bOZZ5XytfQQ7kNvwHM7WYM&_nc_oc=Ado5BJVF9120pgqOHLfyRgMOoSYsugk966j-abXuqjlNbhgjdRq4fLjaCdspZwaZSTo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDayT_NYQNJKp7Kt1a7RopUARZ9g2_JSkfkB56KtchRA&oe=69C13A4E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeIj93_IYngQ7kNvwEM62B-&_nc_oc=AdpJVwq7Raun31GM_LhXrDvOHrRBLaDgNE-o-gjnWA6lT4abBGnXik34Gd9lqpacwsE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSQaouJX0X7IZXa5LOhUEm-sN5qhP4XY8OkK5ETjf8lQ&oe=69C12C3A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoO9_lRd4uUQ7kNvwG8xpkl&_nc_oc=AdpJDAYRE6IRHjG7tb5cAngZSjdANFCf3RlPevoT1p1ngWcQgU-i6D3xQ0vpPB7tOKE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxVl8_D9EXOn3SVeGwX6K7gHmdYrw15Jk5GW2XW0vVkg&oe=69C12E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWRE-ZG0aD0Q7kNvwEAWY0w&_nc_oc=AdqbyqzSirFWduBxYgUEV8ajO8upu1hQE8QkBjGEJXTDgsqP7q5Khje2zt4g9t-w-DE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6rn-Oj0lhlIbV-_1D0yfUHhQcnSA4KWgPN9N8X8c1Xw&oe=69C11AC2"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
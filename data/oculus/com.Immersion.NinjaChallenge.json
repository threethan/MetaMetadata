V8tiGS_sSQPuBU5ZNqvfe1tWQzCpyunpL0IFCfdO8svVbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBaZ0v2SK21ZlJcCT87yP0GwSsyts-rXWPkNgZSnRYcg&oe=6B00720B"}, {"file_name": "DN_LWay.png", "id": "1512181229167476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1512181232500809_4799425392250328001_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMheAokrsjsQ7kNvwGs7GMv&_nc_oc=AdrJYfGMwoY3m9PEDara_EgdzIZnhlAcxri2z6gScjQ4pyaqbJnuI48ppQlc-9q5ehI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRE9eWhLp-tjYvTTcdPxlrjZeCB-feAhpT4VZLEvuc3Q&oe=6B007D8E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AtAHo1Eo8oQ7kNvwHnlciT&_nc_oc=AdrfLCuO9_RZOXniBm-xVnFjGvQFkVwNWWbFwNkWVN6S_-8ejtc8LiKBjxGwUNFiCpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiSu-5TcfUHS2Lp_jC3sioW-9vTZEjvyTAi6G9ozXw0A&oe=6B006F7A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLHihHqbPMQQ7kNvwGPd9js&_nc_oc=AdoUDx8aWLmuxGne3dkQ0UBwtqOKDsUkkbq3qnBHxn_-mCI7VUZPDMPekjD0khuzH_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9EXOVTibaFNIkKeOURwg3YCXiLi3TrX6qUVULy6k5Pg&oe=6B007173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRJNs_P_bpAQ7kNvwGYntbF&_nc_oc=AdoWaZKskpzu5miH_zoEHZeLfKGYM1nVUwzXh7SzWuCEFtlYFsrQvcukwqKjSJu1y6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ64_wZOMkTEn9jgcJvJfEPX_xxKSBPKnw6tJI8WEemGQ&oe=6B005E02"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
zXwLQq14idv-XCCY3xR4OKCOvN4URcIeigiL6K3B0eHueg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6EROnif4qWRtveisAhUvNtRgu4wrCAMiudiIO7SiUqg&oe=6AFF208B"}, {"file_name": "DN_LWay.png", "id": "1512181229167476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982625_1512181232500809_4799425392250328001_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAXbaOOFscgQ7kNvwFSoNPg&_nc_oc=Adr19Cf3Y-aLqoFLjYeV6YneDvunJ8DLuGMkRYJaoYUHl80qxRT4Uf0Mm0IMb2tAGAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIoA-RFQUU8zlfwLuDWps5X258GJ6EHDu7VQhAzh913Q&oe=6AFF2C0E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npVSCUZGP2UQ7kNvwGJynza&_nc_oc=AdosCMPuops1Ej0bc5hPE_1B0BupUyL6CGgfWNfZn0ISyoz-MkFb0s42RP42EkaFPwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnxEQiBlnK7UMdqpmxkzZM7V76bHAx-6sXtzS3OXBj1g&oe=6AFF1DFA"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLHihHqbPMQQ7kNvwFeUxgh&_nc_oc=Adq0XFqpQUBuaf6REM59xqghtdmQ4fM5hevnlcxVw-QwQApUaeQGR8uvzBukqtBnbQc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuT4hOsyJofVtAeJcl9RzHSDzVTJJqs3NIKcasRQKNKQ&oe=6AFF1FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdCJZvAvkU8Q7kNvwHappzv&_nc_oc=AdqH-rXQAtvFzHWetSQifYb86br1HaNaSMApOUeOwLOpUgt-SPQdYkPvQ2-0MCNyVgI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEU6nCnHJK_b0km48lcIxP8N-XbFENOC5RtjMIYz8TWw&oe=6AFF0C82"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
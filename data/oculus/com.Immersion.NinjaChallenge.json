512181232500809_4799425392250328001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbwxI1fwOPIQ7kNvwFKajHC&_nc_oc=AdlrGj_lQj4PDTh-sOEd97RXq_UBwwbiY0D5AA1R-bDUyiRyv9LEvBTmsrLZhA-5LTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwWZNLD-8t4wj_Jn3wUiip0wf51bwIr8GslOfP4vZXjw&oe=69AEC54E"}, {"file_name": "DN_SMountain.png", "id": "1000261940745773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974483_1000261944079106_2684178465273233153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrlfmegLc0gQ7kNvwHF-JnI&_nc_oc=Admv1BBQv_d20OWpvyode9XdV_DhGRf__c4Hu9rZ8_hvQ4EbF0ktoqvPrUWeUXKu8nQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3olWGseWbloYdGMKarSxyfoPSY2iof0RQEYO-MtjFLw&oe=69AEB73A"}, {"file_name": "DN_JCity.png", "id": "494014281899320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/10000000_494014295232652_7739263442387542509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlMOX0qZfIIQ7kNvwGcPcV2&_nc_oc=AdngF5hzpEiRKhZor71SeVN32Cyr62QgyaeB2MNKaeH4DZkGau1s2MNxgWsTsZeSv3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfySmMxLTjNaJzT0exE9SRhMrEC9MrJU9_UNKAeWtSqadg&oe=69AEB933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "156049823258025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974655_156049826591358_8782886685581282871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-m1Qp6BFccQ7kNvwHHTfVu&_nc_oc=AdkQBO8xsjjS9GUmJdGzIVUSiGefsHNpMf0pzq9BqJpFj-27TXrKs_17PjRG8yAiFgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY12eeY10yPPL03MLgREv-VnxD7PeHpDug6ZcRTUo-0A&oe=69AEA5C2"}, "display_name": "Disc Ninja", "keywords": ["discgolf", "japan", "ninja", "sport", "frisbee"], "long_description": "Patience. Precision. Focus.\nThese are the traits of a ninja.\n\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja!\nYour task will be difficult: reach the dragon with as few throws as possible.\n\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills, come rain or shine.\nWin tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n\nYour path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nThe challenge awaits. Ganbatte!\n\nKey features:\n\u2022 15 maps with beautiful, stylized graphics;\n\u2022 Realistic disc throwing physics with various difficulty levels;\n\u2022 Multiple unlockable collectibles, including unique ninja costumes and disc designs;\n\u2022 Multiplayer mode that allows up to 4 ninjas to compete against each other.\n", "short_description": "Patience. Precision. Focus. These are the traits of a ninja.\nTravel to feudal Japan following the lead of a golden dragon and become a Disc Ninja! Your path will lead through high mountains, treacherous valleys, beautiful palaces, and temples full of deadly traps.\nImmerse yourself in a breathtaking virtual reality setting and practice your Disc Golf skills. Win tournaments in all provinces and prove that you are the greatest Disc Ninja of all time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://immersion.games/pl/disc-ninja.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
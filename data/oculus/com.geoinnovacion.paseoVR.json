dn.com/v/t64.5771-25/38974453_712419439975344_8244907753262600972_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yy5COaPQSgIQ7kNvwFF4DV2&_nc_oc=Adp-NgWn8RikM2oqtuqvOWKBCRocSb_wDFMRyVOMxvwQBfFzpb6oephReaoplhtMJJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYY1cQ5BhtAuoLYWXlvaRuj5R7RwtuoDPtfgG3E7kWWQ&oe=6B01D308"}, {"file_name": "3.png", "id": "1236950433728753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974453_1236950437062086_461950609694501142_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4j022QNny8Q7kNvwFUnPMw&_nc_oc=AdpbQ1HAav535lxSy1WBwj-qVAF0szVMNDd8A2QYIIAivXW3aH-wlADrrw_ESmvu1HY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-8Re-Vt7SqJtNbvb25gxRbQcs-njL_fu28ThEKV7-IA&oe=6B01EBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "xD.png", "id": "394583696048900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_394583699382233_717921612252009172_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bea-Nv6EiqYQ7kNvwGG2NR1&_nc_oc=AdrTqNsTrYPwxrqivbEqVhu64JzD7Yk8j-O0ORfitIqn1xkCYHUet33j25CxiKRuA0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOTyZuzBRzaKCPDNU0yPO8j5_x6mscueLNjNhAxrUxOw&oe=6B01E049"}, "display_name": "PaseoVR", "keywords": [], "long_description": "With our PaseoVR platform (https://www.paseovr.com), we make available to everyone, without any knowledge of software, the potential of virtual reality for tours. Created in minutes and not days, from photos and 360 videos, virtual experiences are available in the cloud on a pay-per-use model. Only imagination is the limit! We contacted to find out more.", "short_description": "PaseoVR is now available on Oculus!\nWe make it easy for you to explore your tours using 360\u00b0 panoramic images and videos.\n\nPaseoVR app for Oculus allows you to recreate virtual environments designed on the PaseoVR web platform.\n\nAnyone can enter the tours, you just need a code that you can get at PaseoVR.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paseovr.com/privacy-policy-and-user-agreement.html", "developer_terms_of_service_url": null, "publisher_name": "GeoInnovacion", "support_website_url": null, "website_url": "https://paseovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "564641671731889"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "764097111628132"}]}, "baseline_offer": {"id": "764097111628132"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1655150520, "status": "PUBLISHED", "id": "764097111628132"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5360288130660325", "version": "2022.1.7"}, "id": "423222832746332", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5303889832966822", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5360288130660325"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "423222832746332"}]}, "change_log": null, "created_da
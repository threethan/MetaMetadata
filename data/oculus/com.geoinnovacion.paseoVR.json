dn.com/v/t64.5771-25/38974453_712419439975344_8244907753262600972_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSQ_wOdJup8Q7kNvwHAjuiv&_nc_oc=AdodJjF7RGFlFOwuAs5HGVs0AW_y0z4R9twEgNDtNZ1e3yYdLGW_7pt-HgC6TF9nnhg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3MYyGsz1SBNjtaBwOWHxVpLxQSXBc8VOSUp1MgVNAFA&oe=6AFC8D08"}, {"file_name": "3.png", "id": "1236950433728753", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_1236950437062086_461950609694501142_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7-o7nx6_c4Q7kNvwHzT_3e&_nc_oc=Adon-hB05zySJLFCKbLxgGb9NbXgXl8yuDYXBDEP0xyqpbOIs9Wxs_RFL4ptIb6SV30&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Q_sg39qY1KiKYu4Lvqtz8Ohmg2Wt46hOqYqNbJI9Sw&oe=6AFC6D81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "xD.png", "id": "394583696048900", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_394583699382233_717921612252009172_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzHc0r-sMyYQ7kNvwFE8i3C&_nc_oc=AdrDSmY-1fjgoJzx254XTIVOnBbvH0my5oXoz9gD6igTEjr3fqvyhzGu7hky_MBnEI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTENlIc2RKF8Xoey85qEy3l3X3_FfW6PUpDIFre4eRAHQ&oe=6AFC6209"}, "display_name": "PaseoVR", "keywords": [], "long_description": "With our PaseoVR platform (https://www.paseovr.com), we make available to everyone, without any knowledge of software, the potential of virtual reality for tours. Created in minutes and not days, from photos and 360 videos, virtual experiences are available in the cloud on a pay-per-use model. Only imagination is the limit! We contacted to find out more.", "short_description": "PaseoVR is now available on Oculus!\nWe make it easy for you to explore your tours using 360\u00b0 panoramic images and videos.\n\nPaseoVR app for Oculus allows you to recreate virtual environments designed on the PaseoVR web platform.\n\nAnyone can enter the tours, you just need a code that you can get at PaseoVR.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paseovr.com/privacy-policy-and-user-agreement.html", "developer_terms_of_service_url": null, "publisher_name": "GeoInnovacion", "support_website_url": null, "website_url": "https://paseovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "564641671731889"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "764097111628132"}]}, "baseline_offer": {"id": "764097111628132"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1655150520, "status": "PUBLISHED", "id": "764097111628132"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5360288130660325", "version": "2022.1.7"}, "id": "423222832746332", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5303889832966822", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5360288130660325"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "423222832746332"}]}, "change_log": null, "created_da
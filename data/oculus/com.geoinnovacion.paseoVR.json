higoWd61_Jw16nCRrpV8Rnqilw&oe=69A81241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "xD.png", "id": "394583696048900", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_394583699382233_717921612252009172_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6K-bcozJ5gQ7kNvwE9XMhb&_nc_oc=AdkTZVxXd7flvX0JvCrts211qwrQtz3DLukwXWxR7FAkk7YlZR2Yu6LaaCsGn6Orxm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftKRgdgztPYH0P0eKAWmxe1lOOPAmVINEwx8Ho_aaOd_g&oe=69A83F09"}, "display_name": "PaseoVR", "keywords": [], "long_description": "With our PaseoVR platform (https://www.paseovr.com), we make available to everyone, without any knowledge of software, the potential of virtual reality for tours. Created in minutes and not days, from photos and 360 videos, virtual experiences are available in the cloud on a pay-per-use model. Only imagination is the limit! We contacted to find out more.", "short_description": "PaseoVR is now available on Oculus!\nWe make it easy for you to explore your tours using 360\u00b0 panoramic images and videos.\n\nPaseoVR app for Oculus allows you to recreate virtual environments designed on the PaseoVR web platform.\n\nAnyone can enter the tours, you just need a code that you can get at PaseoVR.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paseovr.com/privacy-policy-and-user-agreement.html", "developer_terms_of_service_url": null, "publisher_name": "GeoInnovacion", "support_website_url": null, "website_url": "https://paseovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
12252009172_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjQYH3TfePEQ7kNvwErBYeF&_nc_oc=AdmvOAJoXCFbkmAKOtv9NZ9ekgnL_Hyz3SbKzsd4XPrxKpXHoIbu0HsUKvW1pC1AhZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftNa574cf-r2UjH3H79P304gWZwY9RBg3JXp2ChvL0zBg&oe=699F0489"}, "display_name": "PaseoVR", "keywords": [], "long_description": "With our PaseoVR platform (https://www.paseovr.com), we make available to everyone, without any knowledge of software, the potential of virtual reality for tours. Created in minutes and not days, from photos and 360 videos, virtual experiences are available in the cloud on a pay-per-use model. Only imagination is the limit! We contacted to find out more.", "short_description": "PaseoVR is now available on Oculus!\nWe make it easy for you to explore your tours using 360\u00b0 panoramic images and videos.\n\nPaseoVR app for Oculus allows you to recreate virtual environments designed on the PaseoVR web platform.\n\nAnyone can enter the tours, you just need a code that you can get at PaseoVR.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paseovr.com/privacy-policy-and-user-agreement.html", "developer_terms_of_service_url": null, "publisher_name": "GeoInnovacion", "support_website_url": null, "website_url": "https://paseovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "564641671731889"}}]}, "scheduled_
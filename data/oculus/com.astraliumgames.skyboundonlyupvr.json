fe2K7NTFzGuqw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImLryUwPrk7WwMWvQyqdiF78jl4s5kwAMZw0M-wXRggw&oe=6AA16B67"}, {"file_name": "SS4.png", "id": "4394983150786771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311582_4394983154120104_7011182352546650157_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyKCrEKFwkAQ7kNvwGOUPqD&_nc_oc=AdqiLkD49rBqnkiUlPYRTGw_g2qQkeI2uFXAYrlZmqEDiitzxRZTK_KAAHdLrfsC7bg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMbl3NzMCopoQkoBxjSLr1v3Gq6HHFTPIfrV9P_KdvTQ&oe=6AA15ACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cOVER.png", "id": "999135566006034", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822307_999135569339367_7945041199789493595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DhQGS2fHE4Q7kNvwFTyqxO&_nc_oc=AdoGEiHqsG0I0HIF7k2mZ3eWfe6xnmtYKOJ0tmgC2JkxRK7GWwz4mvqIiWIIhKiOgEc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD_9UmwlAbpmXVvrGg7I0hw33xEDqf-8LRwxim3KAFuQ&oe=6AA173AC"}, "display_name": "Skybound", "keywords": ["competitive", "parkour", "platformer", "climbing", "vertical"], "long_description": "# How high can you go?\n\nSkybound is a free vertical VR platformer where the only \ndirection is UP. Jump across floating platforms, race against \nthe clock, and compete with players worldwide to claim your \nplace at the top of the leaderboard.\n\nInspired by the \"Only Up\" genre - built for VR. Feel every \njump in your body. Feel the height beneath your feet. Feel \nthe rush of beating your record by just one second.\n\n\n\n\n**\ud83c\udfae HOW IT WORKS**\n\n\nJump, climbing and parkour your way upward. Fall - and start \nagain. Each run you find faster routes and push your \ntime lower.\n\nSimple goal. Pure skill. Endless competition.\n\n\n**\u2728 FEATURES**\n\n\n- \u23f1\ufe0f **TIME TRIALS** - PURE SPEED, PURE SKILL\n   Race the clock on every run. Your best time posts\n   to the global leaderboard automatically.\n\n- \ud83c\udfc6 **COMPETITIVE GLOBAL LEADERBOARDS**\n   See where you rank worldwide. One second faster = \n   one place higher. That's the whole game.\n\n- \u2601\ufe0f **VR-NATIVE HEIGHT EXPERIENCE**\n   The sense of height in VR makes every jump feel real.\n   Looking down has never felt so intense.\n\n- \ud83c\udf08 **FAMILY FRIENDLY**\n   Bright, colorful, cartoon visuals. No violence, \n   no mature content. Safe for all ages.\n\n- \ud83c\udd93 **COMPLETELY FREE**\n   No purchase required. No in-app payments.\n   Download and play immediately.\n", "short_description": "Free vertical VR platformer - jump, climbing, and race to the top!\n\nNavigate colorful floating platforms high above the clouds\nwith parkour-style movement. Every run is a race against \nthe clock - find faster routes, push your limits, and \nshave seconds off your best time.\n\nCompete on the global competitive leaderboard with players \nworldwide. One second faster = one place higher.\n\nSimple to learn. Impossible to put down.\n\nHow high can YOU go? \u2601\ufe0f\u23f1\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://astraliumgames.com/skybound-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Astralium Games", "support_website_url": null, "website_url": "https://astraliumgames.com/astralium-quests/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgRUFQu_z-cqv80sNj6rPNuCr7dKThVjml_z23fCubBg&oe=6B0F1743"}, {"file_name": "Screenshot5.png", "id": "377268044980891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974780_377268051647557_3185420578236350601_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzM8N6K42rsQ7kNvwFmz9w_&_nc_oc=Adq2yulPyoZGtvaHVNY63ZYo_X8K1bl4JecHusx4322xrfx-vpaYhkdaindVtBmKjqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWs9k6NsleGsjKQoXiHfLWR_ywJBYlw7CV6WshNOgTEXw&oe=6B0EF0B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art_Landscape.png", "id": "355966243501787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_355966246835120_7811106338900258418_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9phZ8qN0wEQ7kNvwFwS4P-&_nc_oc=AdpFPUVH_D_f5-v7F4fRSZOUcLcTu6RbeRcJWwq_gq68UYYeZxADtD97Rj5xRgYDKzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWMN9QkBNAy3FKx20wv6fGqdKEz_u_joZiLbfFKAGebEA&oe=6B0F0005"}, "display_name": "SkipTrack", "keywords": [], "long_description": "Experience a real jump rope workout like never before with SkipTrack! This immersive MR app tracks your jumps while you use a physical jump rope, adding an extra layer of engagement and fitness to your routine. Get fit and have fun with SkipTrack!", "short_description": "Experience a real jump rope workout like never before with SkipTrack! This immersive MR app tracks your jumps while you use a physical jump rope, adding an extra layer of engagement and fitness to your routine. Get fit and have fun with SkipTrack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bork.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BORK.TECH", "support_website_url": null, "website_url": "https://bork.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6968088336579270"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "702619028188651"}, {"status": "PUBLISHED", "id": "776743217820912"}]}, "baseline_offer": {"id": "776743217820912"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1704406800, "status": "PUBLISHED", "id": "702619028188651"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28691250993836358", "version": "0.5"}, "id": "2051653771837935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6735973829790723", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691250993836358"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2051653771837935"}]}, "change_log": "## New\n\n- Hands-free from start to finish. Pick a mode by looking at it, start by jumping. No controllers, no buttons, so keep the rope in your hands.\n- Rhythm mode. Jump to the beat across 9 original tracks: techno, EDM, jungle and drum & bass. Land on the beat for PERFECTs, and watch the music build as your combo grows. - Finish a song with 85% on the beat to unlock a faster tempo.\n- Daily quests. Three new goals every day, like \"Hit a x3 combo\" or \"Beat yesterday\". Complete all three to open the quest chest for bonus XP.\n- Day streaks with streak freezes. Hit your daily goal to keep your streak alive. Every 7 days earns a freeze that protects you if you miss a day.\n- XP and levels. Every jump earns XP, and combos multiply it.\n- Combos. Keep a steady rhythm to build x2, x3 and x4 multipliers.\n- Ghost race. In the 5-minute challenge, race your own best run live.\n- Quick start. Jump 3 times on the menu to start your last mode.\n- First-time setup. A 30-second calibration tunes jump detection and beat timing to you.\n\n## Improved\n\n- A completely redesigned look: clearer panels, new icons and bigger, sharper text.\n- A new Today panel shows your daily goal, quests and chest at a glance.\n-A new weekly chart, records and recent sessions in the stats panel.\n- More accurate jump counting that works the same however fast the app is running.\n- Celebrations for milestones, new records, level-ups and more, with sound effects and confetti in your room.\n- While you jump, the screen focuses on your count and timer, and side panels fade back.\n- The menu now follows you if you turn away, and stays put while you jump.\n- A gaze pointer shows exactly what you're looking at on menus.\n\n##Fixed\n\n- Blurry text and flickering panels on Quest.\n- The menu landing off to the side after recentering.\n- Getting stuck on the results screen. You can now look at Main Menu or End Session, or it returns by itself.\n- Short pauses ending your session too early. You now have 5 seconds to untangle the rope.", "created_date": 1792376541, "id": "28691250993836358", "version": "0.5", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6735973829790723", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691250993836358"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792374484, "id": "28690935683867889", "version": "0.5", "version_code": 9, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6735973829790723", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691250993836358"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792362616, "id": "28689334410694683", "version": "0.5", "version_code": 8, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6735973829790723", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691250993836358"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2051653771837935"}]}, "change_log": "disabled mic hopefully", "created_date": 1703837959, "id": "6947470758641028", "version": "0.1", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__t
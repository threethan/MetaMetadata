.com/v/t64.5771-25/86867711_814218724155615_47084801846210585_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lllR7H7YKm8Q7kNvwGM9hr5&_nc_oc=AdoAyS1M2hns4iH1czxPDOov4anh3eGXqF4828mICA9L0FmYye2PtJ7UoqJZIKEwayE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNuFiX2YIJZeXOFTmfGZAWMlg5g_VWyVx0fVLlHS4wDQ&oe=6AFC7B4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3831938680360904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031586_3831938683694237_9065793620056266647_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpafevbFpTQQ7kNvwGzwy63&_nc_oc=AdqDCLob-SeandmNVmTLBZPwVIFhAMF2IluZ2FDCsgYgozOcS0Tv8t3GW6pieXIz7eE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCAQB34z9Fn2RjplsjWg_RFrA7Fw2motJvJU0_VQ5eDQ&oe=6AFC6989"}, "display_name": "Mighty Room", "keywords": [], "long_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n\nGame Features:\n\n    Immersive VR Environment:\n        Dive into a meticulously designed world with cutting-edge VR graphics that make you feel like you're truly inside a colossal, high-tech room. Every corner, shadow, and detail is crafted to enhance your immersive experience.\n\n    Stealth and Strategy Gameplay:\n        Engage in heart-pounding stealth gameplay where every move matters. Use your intelligence and agility to stay hidden, create distractions, and outmaneuver the vigilant room owner.", "short_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game 
.com/v/t64.5771-25/86867711_814218724155615_47084801846210585_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8PHtrYD61kQ7kNvwGxtQfV&_nc_oc=Adr7LLeei6eF88MKGTfhpCUSTk15a4Y0-sfFC06mjvpWN2jcCnZymK_mto0HOMbPqQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNQuKde_bdatLythlycRNF6h2TDoBSMuD9TCg40PxmFQ&oe=6B0B340D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3831938680360904", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031586_3831938683694237_9065793620056266647_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkiTclQDl5UQ7kNvwHhHRgw&_nc_oc=AdogofDdJKauGzK_AY_-6cHkSAmMSM0ZNVWr3qUlLHQvJmH7YSUuVDoqgB1FW0ZyqOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8KIgr4Iaf0Eded1wNdnPZ7re8AWgw0Mqs0RIVGs7PTA&oe=6B0B2249"}, "display_name": "Mighty Room", "keywords": [], "long_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n\nGame Features:\n\n    Immersive VR Environment:\n        Dive into a meticulously designed world with cutting-edge VR graphics that make you feel like you're truly inside a colossal, high-tech room. Every corner, shadow, and detail is crafted to enhance your immersive experience.\n\n    Stealth and Strategy Gameplay:\n        Engage in heart-pounding stealth gameplay where every move matters. Use your intelligence and agility to stay hidden, create distractions, and outmaneuver the vigilant room owner.", "short_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game 
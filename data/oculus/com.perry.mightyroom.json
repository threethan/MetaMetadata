9_1896196334179134_1647710567474846504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7RxxjI8Q54Q7kNvwGOEZaM&_nc_oc=AdrT75tj2flQMDukGaFtTVmsJlBtjDeMIcBrQNQlp4gBzIcQ-BsSLYkzN6kmrem4eHQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SIvdByW3SzB4mVuiapvsFU584bYQEgXLyluHwxVbSUg&oe=6A465E50"}, {"file_name": "ss3.png", "id": "819976966899865", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031602_819976970233198_786299058505255214_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2d46G_yY4AQ7kNvwEkpgvn&_nc_oc=AdpDborrT-1ctZScSmIMKnG_m4cArlqMsgvzHp7LL-d-J00SQdnnyfTgOtzCHx6nh9w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FouFpuFA3ZUunLpQkC0p4vj9iyi6-3hrZ2nd1YELj0g&oe=6A467888"}, {"file_name": "ss1.png", "id": "408770804888198", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75195906_408770811554864_5333622087250351247_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbUFdZiXQ6YQ7kNvwGBquYE&_nc_oc=AdrMGFKLElXcI_0nY4R5ninrP1ctUyZ7mpRwUZqyBHQjanlQvoR1Js2XOGjlgET0qOc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RskCmFAn0w6PmovXZgLkVU1doehwoMknEHkoSbAbJ5g&oe=6A4661F5"}, {"file_name": "ss2.png", "id": "498593312566813", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974528_498593315900146_8922501169316056270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95Vj_cuuwBcQ7kNvwEeChII&_nc_oc=AdqYZu2Agc5mcThuehKbnm8ZfqjIMTGZBhwg49RW8EYnxy3_zN4mTRwrBDyq0I5fK2E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-xQUBW5wPVJMKNSrSR30zXJdCmpjgjoH1imdRux5W6g&oe=6A46714A"}, {"file_name": "ss4.png", "id": "814218720822282", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86867711_814218724155615_47084801846210585_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg6jth-zKBcQ7kNvwFvVH3I&_nc_oc=Adq1YV4hUTA4GUVPzSy9TRw-SBZ8TaVhNucpSrKsZ8ZgLOMmrRzVTkRCoy-OlXgJOQ4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SGMJuvSuh73lJ-fGKgsiig9wL71JwYC5IwuQLv9U2cQ&oe=6A468C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3831938680360904", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031586_3831938683694237_9065793620056266647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dp9MQmOvSYQ7kNvwGPc_Up&_nc_oc=AdrmL8oBHYdnuWdaC3-jav1kxiLsE27Ei99jpeit-isndQIl1onLZOtXh0WB7iFoo2U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82XOXcQrGyj9bNPws5Zw0xzxwcvhgMcF1efHmY7K13Mg&oe=6A467A89"}, "display_name": "Mighty Room", "keywords": [], "long_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n\nGame Features:\n\n    Immersive VR Environment:\n        Dive into a meticulously designed world with cutting-edge VR graphics that make you feel like you're truly inside a colossal, high-tech room. Every corner, shadow, and detail is crafted to enhance your immersive experience.\n\n    Stealth and Strategy Gameplay:\n        Engage in heart-pounding stealth gameplay where every move matters. Use your intelligence and agility to stay hidden, create distractions, and outmaneuver the vigilant room owner.", "short_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n"}]}, "d
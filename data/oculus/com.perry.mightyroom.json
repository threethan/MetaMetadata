9_1896196334179134_1647710567474846504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Icl3EKMGjQ0Q7kNvwGXg4nY&_nc_oc=AdqpH8l1UMkjh-MlKUZdI7rMo-I6kqsnLKgxUUkTNpbPheuP7-T7HRkAil5fMjf7PXs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm0jIiT4swTmZQN8kwe0Nqyzu1Jltu1xsnyy4AOAw36A&oe=6A7DBD50"}, {"file_name": "ss3.png", "id": "819976966899865", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031602_819976970233198_786299058505255214_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIDajtUEvhUQ7kNvwEUeTa6&_nc_oc=AdrklEmgwTHeaw3EUl1Dt_KtoxeyIx_IEnxy3flit3xwnivTYO0IsgJlevdZ_d1yEXY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmFVPGV1asrs1-HvI8DXDUXD0owTkzkHnCKlnVj6sY2Q&oe=6A7D9F48"}, {"file_name": "ss1.png", "id": "408770804888198", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75195906_408770811554864_5333622087250351247_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGM9FmXw3c8Q7kNvwHms5Jd&_nc_oc=AdpTrT9pxz3ePfVnxX_PjJDFTpQmHaBslH4F2E4LKsndNTb_fV8dYpg-xnbJ8VhNWlY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTNLRbSEryZvUwWWIrdtF3BLelVZNuXXa02nrD1XpawA&oe=6A7DC0F5"}, {"file_name": "ss2.png", "id": "498593312566813", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974528_498593315900146_8922501169316056270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T60yRkhGiEQ7kNvwF24tpm&_nc_oc=AdpUcO8E5CkiiLWn3tnGe0hUDjagPhTgzJF_RefI_uEDB1KUCdBvc69ex3m_PsNepVs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9qH8euWvD_6TLD3EKJ_B5IvALld_aLa7VCY0BFDOPxA&oe=6A7DD04A"}, {"file_name": "ss4.png", "id": "814218720822282", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86867711_814218724155615_47084801846210585_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wLGP5W8wTwQ7kNvwHziTaM&_nc_oc=AdqISWsQGgrMFI1SbHOVyp98S686QTny9Z_iHUbOoGUls6ffS1UFm65FEgE1CapjB9g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXhrnMzyZpSMNEB2q__u2z2Z5TDlniyMFoMFqDdyEPzQ&oe=6A7DB30D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3831938680360904", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031586_3831938683694237_9065793620056266647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14ts_YyZ50sQ7kNvwGlIZWX&_nc_oc=AdqfQhLthVfcq1Rtwa9QD1R9Gttv3VHku65KOn3vIN_VxGwxDUQMtOelMgP3HLvYcX4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdNOUNn5uIXdReoI5TOnOLZymQYffG1fjqslF6zgflZw&oe=6A7DA149"}, "display_name": "Mighty Room", "keywords": [], "long_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n\nGame Features:\n\n    Immersive VR Environment:\n        Dive into a meticulously designed world with cutting-edge VR graphics that make you feel like you're truly inside a colossal, high-tech room. Every corner, shadow, and detail is crafted to enhance your immersive experience.\n\n    Stealth and Strategy Gameplay:\n        Engage in heart-pounding stealth gameplay where every move matters. Use your intelligence and agility to stay hidden, create distractions, and outmaneuver the vigilant room owner.", "short_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n"}]}, "d
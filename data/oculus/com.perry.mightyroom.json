9_1896196334179134_1647710567474846504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HBRRrck7VcQ7kNvwF11L2i&_nc_oc=AdqwHxobWla2aWVYSAnstCWoO_7YYDIT7kFn637-qcT58BOXsj3JypZy7UeAaT2QNH8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L6SlCaTUJyQ7hd-kA5Y5FIS6WfXe0wF9eWNb0GN-ovQ&oe=6A36C490"}, {"file_name": "ss3.png", "id": "819976966899865", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031602_819976970233198_786299058505255214_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUnOog6rLFgQ7kNvwGjDEcQ&_nc_oc=AdqlkLKCW4sXZFdqvppncw5t6VTMsSYPYZNPI39lQPoU6KZdM6pQ1CGptem_NxRUHcw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hq15whPKyeud081DDyGoaI8fhy-sVH4Nuu_L1rc8weA&oe=6A36A688"}, {"file_name": "ss1.png", "id": "408770804888198", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75195906_408770811554864_5333622087250351247_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfC7JcAgehIQ7kNvwFzMtZ8&_nc_oc=AdrDwXYeYMi7zqrELwfDT3PXYIlGHcL1r2D1yeLJA0pHmTJYG7dYNixoBaxR7cOPeQg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lt_BJyrgaw3GwlYliQXPUS_mWhi-lbixfpq2QzXfqVQ&oe=6A36C835"}, {"file_name": "ss2.png", "id": "498593312566813", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974528_498593315900146_8922501169316056270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsBQp9TWDaEQ7kNvwEPY1WZ&_nc_oc=Adr-8mhj3gAmhyYWKlyBcGn2werZmgOVuMFOQpkr_BW-jFK6rM7ulhH4PRkJeeYRXIE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SBXO4ogI96eJCBGHtiZ0H1eGghrUAveNQ9ynvzRmokw&oe=6A369F4A"}, {"file_name": "ss4.png", "id": "814218720822282", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86867711_814218724155615_47084801846210585_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgU-4nczM_IQ7kNvwFCnI9r&_nc_oc=Adonf-xdYfswNabRO_iL4egWjvwvUofowjKxx36Ld8UDDooTOKGgLSFs4Yt1kj_f14U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L_X8DsMTZYZmV6_s4MkN8dw_LueIkEysFRPbkiE8vhA&oe=6A36BA4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3831938680360904", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031586_3831938683694237_9065793620056266647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz9nN3X0mosQ7kNvwGZxPmI&_nc_oc=Ado3ixTTC-mUJ098ui_dCOhqj2NRM-Uw6qhWBeYsjHVeQTwgioP51HYs6P6nBe25f3A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8skPH8E3TzmAqzxm5fdI6m6aOUKb-DxNYrBi7gbR4ttA&oe=6A36A889"}, "display_name": "Mighty Room", "keywords": [], "long_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n\nGame Features:\n\n    Immersive VR Environment:\n        Dive into a meticulously designed world with cutting-edge VR graphics that make you feel like you're truly inside a colossal, high-tech room. Every corner, shadow, and detail is crafted to enhance your immersive experience.\n\n    Stealth and Strategy Gameplay:\n        Engage in heart-pounding stealth gameplay where every move matters. Use your intelligence and agility to stay hidden, create distractions, and outmaneuver the vigilant room owner.", "short_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n"}]}, "d
9_1896196334179134_1647710567474846504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XS3yrzjVUsQ7kNvwFs1qIM&_nc_oc=AdrPRK3kBxohTgy0h6MlUy6uw3sunOJ-iWtrxItr_fAqaOoTZTwnKwBQSfghEyK379U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzC2NvZHzIETzumSTYZtu4FspewLytqxz1w6ndDYbqKg&oe=6AAE84D0"}, {"file_name": "ss3.png", "id": "819976966899865", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031602_819976970233198_786299058505255214_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=johvodSCCMkQ7kNvwEeAgH1&_nc_oc=AdqoYm4p-yLZ-bIyopLbMQ361x2a2447g_wZ4AuXhesiMPyXcr06vgE2onSzdPFHXtc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHh_DIm8SdeOhA0QOsZhWg_r9c6A4HiY2_hacUV1KrAA&oe=6AAE9F08"}, {"file_name": "ss1.png", "id": "408770804888198", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75195906_408770811554864_5333622087250351247_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4XK5v9_9bQQ7kNvwH5q0jV&_nc_oc=AdrH3lBY8XgmmyasPCZxRbYUFS76XcZzNNGSmN-ificfFvLInBAZ9Kg1AjP0SWPEppc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7G93KpO3TDvu8cz3oZBXsslgFADsVk0YFrujZ4axBQA&oe=6AAE8875"}, {"file_name": "ss2.png", "id": "498593312566813", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974528_498593315900146_8922501169316056270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc7l83amy58Q7kNvwHYxwv-&_nc_oc=Adrc2s4lDxycsW9VfjlQhsLHu70XOmhGjoXszV1K9Czpkglde-YcXEyea0ROIbQTbsA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXllWuG2Wl0zZ1GsRuypcBnNP8GEGQAikTPgpVe5mtgQ&oe=6AAE97CA"}, {"file_name": "ss4.png", "id": "814218720822282", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86867711_814218724155615_47084801846210585_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPhrXcR58gIQ7kNvwEzSa_A&_nc_oc=Adpp1gMM1vrmnus-iAOPd6kIWJDDBJfOy5_TdIoZsWEwncPObucdRy_sMdZ62iAgBBE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYyFZgQAcOeXru6gSpeNEhkabM5hKOcQeBzkpgGjTSzA&oe=6AAEB2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3831938680360904", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031586_3831938683694237_9065793620056266647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puESPdBB0LUQ7kNvwFypBuZ&_nc_oc=AdqlECnYpSMMy2d5EMGoxo5QmH4CiJukr-vNveTjODJxz2yc8MuzFkyKNn8l184otJ8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZZLkhRAz3zaodZ_tD9NTVi4sVpyMR8FN3j2cIgge59A&oe=6AAEA109"}, "display_name": "Mighty Room", "keywords": [], "long_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n\nGame Features:\n\n    Immersive VR Environment:\n        Dive into a meticulously designed world with cutting-edge VR graphics that make you feel like you're truly inside a colossal, high-tech room. Every corner, shadow, and detail is crafted to enhance your immersive experience.\n\n    Stealth and Strategy Gameplay:\n        Engage in heart-pounding stealth gameplay where every move matters. Use your intelligence and agility to stay hidden, create distractions, and outmaneuver the vigilant room owner.", "short_description": "Description:\nEmbark on a thrilling adventure in \"Mighty Room,\" an immersive VR game where stealth, strategy, and cunning are your greatest allies. In this high-stakes game, your mission is to \"borrow\" valuable items from an enormous, high-tech space while avoiding detection by the colossal room owner. Experience a blend of suspense, excitement, and futuristic innovation as you navigate through a vast and intricate environment.\n"}]}, "d
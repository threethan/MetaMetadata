8_5151452939540021539_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_S7ar_Y6j0Q7kNvwHEAgPv&_nc_oc=Adq3mOaTuw8Z-R3GqTdxzNd0tUeaneQ6d39V-dBrciPAdEsWAsLVcrjDnx4a0Y9gamc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORu1SuvAiq4gBsZH8lA6WKkJUNiVQZ9v5WpnNh7vGseA&oe=6ACA5855"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadow Chimp - Rebirthed", "keywords": ["Gorilla", "Chimp", "Shadow", "Horror", "VR"], "long_description": "Shadow Chimp - Rebirthed is a VR horror experience that takes place inside of an old, abandoned facility that has seemingly been left untouched for years. The building is completely empty, silent, and decayed, with dark hallways, damaged rooms, flickering lights, and strange sounds echoing throughout the environment. Players take on the role of someone who mysteriously ends up trapped inside of the facility with little to no understanding of where they are or how they got there.\n\nAs players explore deeper into the building, they must wander through different sections of the facility while searching for clues, hidden paths, and possible exits in an attempt to escape. The atmosphere focuses heavily on tension, isolation, and psychological horror, making players constantly feel uneasy while exploring the unknown. Throughout the experience, players may encounter strange events, unsettling environments, and signs that suggest they are not completely alone inside of the facility.\n\nThe main objective of the game is to survive, explore the abandoned environment, and ultimately find a way out before whatever lurks within the darkness finds you first.", "short_description": "Shadow Chimp - Rebirthed; you're lost in an old, abandoned facility, completely empty and silent. The halls are dark, the lights barely work, and strange noises echo through the building. You wander through the decaying rooms and endless corridors, trying to figure out what happened there while searching for a way out before it's too late."}]}, "developer_name": "ShadowApe Studios", "developer_privacy_policy_url": "https://shadowape-studios-official.netlify.app/#tos", "developer_terms_of_service_url": "https://shadowape-studios-official.netlify.app/#tos", "publisher_name": "YourFellowDummy", "support_website_url": "https://shadowape-studios-official.netlify.app/#contact", "website_url": "https://shadowape-studios-official.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "36801388039448231"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1465146114939890"}]}, "baseline_offer": {"id": "1465146114939890"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780286400, "status": "PUBLISHED", "id": "1465146114939890"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38881979064722441", "version": "2.50.137"}, "id": "1277851414516065", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "36801388006114901", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38881979064722441"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
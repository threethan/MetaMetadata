id": "966943823081197", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_966943826414530_2928717887647870644_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwViccIAauYQ7kNvwEU24lg&_nc_oc=AdqzPWdTlPagV-vqym_M7VvBNR-DRdgzuRstFHR_UlFUGzUaL1vjmU0qdlxMj39EA54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3rUxj7LzZ6o45iZescZ0tYK0rdtInoOcx1A8dyBzafA&oe=6ACA75B0"}, {"file_name": "MainScene_Custom..._11.08.2026_00-44-45.png", "id": "1026944950215236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313107_1026944953548569_2154153363120849330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bqhx0uO7B40Q7kNvwFj9d8l&_nc_oc=AdqaETHToMPiKVf04EJLdK3qLEPrJ3rKdTedcHEJrrLdS6xkM4UKLYm7faMeDf1leuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsRmBP7v_-4-Rmeo7wP6kj-zKvnA_UrS93ACOiUDA4xw&oe=6ACA7090"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadow Chimp - Rebirthed", "keywords": ["Gorilla", "Chimp", "Shadow", "Horror", "VR"], "long_description": "Shadow Chimp - Rebirthed is a VR horror experience that takes place inside of an old, abandoned facility that has seemingly been left untouched for years. The building is completely empty, silent, and decayed, with dark hallways, damaged rooms, flickering lights, and strange sounds echoing throughout the environment. Players take on the role of someone who mysteriously ends up trapped inside of the facility with little to no understanding of where they are or how they got there.\n\nAs players explore deeper into the building, they must wander through different sections of the facility while searching for clues, hidden paths, and possible exits in an attempt to escape. The atmosphere focuses heavily on tension, isolation, and psychological horror, making players constantly feel uneasy while exploring the unknown. Throughout the experience, players may encounter strange events, unsettling environments, and signs that suggest they are not completely alone inside of the facility.\n\nThe main objective of the game is to survive, explore the abandoned environment, and ultimately find a way out before whatever lurks within the darkness finds you first.", "short_description": "Shadow Chimp - Rebirthed; you're lost in an old, abandoned facility, completely empty and silent. The halls are dark, the lights barely work, and strange noises echo through the building. You wander through the decaying rooms and endless corridors, trying to figure out what happened there while searching for a way out before it's too late."}]}, "developer_name": "ShadowApe Studios", "developer_privacy_policy_url": "https://shadowape-studios-official.netlify.app/#tos", "developer_terms_of_service_url": "https://shadowape-studios-official.netlify.app/#tos", "publisher_name": "YourFellowDummy", "support_website_url": "https://shadowape-studios-official.netlify.app/#contact", "website_url": "https://shadowape-studios-official.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "38730650186521997"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829689_1032940969350575_8642102354943451096_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUX4ekiAmbEQ7kNvwGkl1HD&_nc_oc=AdpfZbb3P1b8uVtmkqyWWvausGin2AtWa0I_2HbHVJ
0dr5gVMTdCMgjfb6xzuGeH_V-eQWw5gV8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYJy44PrZGk3O4y0QqZEZwUMjeIvM5TrubQQELCMNAhg&oe=6A881E59"}, {"file_name": "migrated_image.png", "id": "603762903542832", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982682_394634374507239_6439063808236322816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94p0OvuMzQwQ7kNvwGsR300&_nc_oc=Ado6t_crhplWQUfj3G8zNCodfGUTbIq6NGWIx9D_PvR8Pv2yT5pTPZfzKjkaLPBdw3c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6cylo_Ic_TuiPz8CNH-mhaMLkhwHX0ANa9Bg00i5zEw&oe=6A884BF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNV_xEblY5UQ7kNvwG79imU&_nc_oc=AdqHU8gcgrWRsA90S8Cr0VFBdWpuEDgS2Ml4vbJUou_nUhdc6p0q4qSJXLq2vCzQ_q0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL-MLWtQvEQhetUjFAw0-yJom2jFQ8sGdQS2F-W2cnZA&oe=6A881D0E"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more f
6_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci6BahsRoEkQ7kNvwFT7dyC&_nc_oc=Adl5Oy7YjNJ1qUK1QNw467Bvwaz3Z8IdwwMDdlLOcx5d_Os90q0kkBK2B4JRAdu9-ms&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftXNAsqJtWKTnRuMv5TtIkN7mtc0OGz5ZvUfbS-TGJRXQ&oe=699C4F72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wws7XUWsnvsQ7kNvwH4PXH2&_nc_oc=Adnuay6vF3Zt5aXVxOxq4xrDCicX7UG4Cq43z2bloKK4l-FyNJe7fGB3-MVwgyXdN14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuyeZqIIhlkw5pB-yNgq_1Lrg6qBt_ibA9nAFWmiBF54g&oe=699C58CE"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infe
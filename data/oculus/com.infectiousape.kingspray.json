1C5781"}, {"file_name": "migrated_image.png", "id": "616563445860021", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982502_2366061466986326_7334240876551471104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccSZrH0-kdkQ7kNvwEpE0NQ&_nc_oc=AdpkBGwDhhxvANPlzrxPP3zumRPofLd7nx_Y0hp4w9EeUS5Li7aakditj_Wt68cvM8c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_sCDN0T4SmUVwESXN1ip-X-3yc-5TJDQqDU-Uc5jyEQ&oe=6A1C3192"}, {"file_name": "migrated_image.png", "id": "576788989581765", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974534_338062773808207_8660192878208745472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEDRRK3Z99IQ7kNvwEo9hf9&_nc_oc=AdpC7KFdgyRBYgm-8HDB_Rol5YJP-N-PGGLzbV8RNCGomPe67qeZyrfoEf8XyI70Xwk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZILoa1saArHi8wVG4pThK1caW6YMdHRKQTz4lJ17hOw&oe=6A1C3B99"}, {"file_name": "migrated_image.png", "id": "2717847824992129", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982682_394634374507239_6439063808236322816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR-r46IVHlcQ7kNvwEzHSKO&_nc_oc=AdpoFPezFXE5A_tTYU5Ii-CHrAJdbtcp7yWauBszGBUqiEWEJ232GK4y3v8_XcFy6kY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j4isfL2ZTnodjjkPQEo_aM5dGtfTpbkOn_9E5kLDYdQ&oe=6A1C30F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/gW9jvZ", "id": "257878025409463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003260_257878028742796_350594443750932480_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_01GHLLig0Q7kNvwFJrUiG&_nc_oc=AdrMnXmUdaNsSb-RZ8Ou1nwOAK_kS6Zvm9UvzH6SM1cGhWhMhnDwNjf-H40FeJvoGQ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q5aGlFSZeh60LdGniHSeeJDP40cgfFNziVvFgkoDEHg&oe=6A1C5830"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Create amazing street art with VR. Sharpen your skills or learn new styles with thousands of online artists from around the world. Up to 4 simultaneous players collaborating at once. Customize your in game avatar by designing your own hat, mask and spray can. Use True to life Ironlak Aerosol colours to design and develop skills and bring your concepts closer to reality. Feel immersed in 12 realistic environments including a trainyard, Alleyway, dusky city rooftop, and an abandoned subway station! This is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": "http://infectiousape.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infectiousape.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "996897104242199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031511_746397252843926_6109089926375896853_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a
6_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72BikEKrr-wQ7kNvwGtafC_&_nc_oc=AdlllTlHgUbfXu_VkkUuDSeFu2iQRLkWeH405X3JLFulyaTxYtAvYpajnWJMmoSmqr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftlZwrsvk32HWH2HEf9riIHn-kd6_PkFwSl6sSRg1LuxQ&oe=69A43872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHg3Q7YcV-kQ7kNvwG5A9-Y&_nc_oc=AdmYvLaRpSifr4-VQV3D_xdS4fETCC71TbA8DPf0_ucqhPRx1kLlggY3Jz-1Z4vhf4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftoqbWv6Vu_nlpZp57-tqpDDtKx--0oXyxd1yM1DELSoA&oe=69A441CE"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infe
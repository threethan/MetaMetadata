v/t64.5771-25/38982502_2366061466986326_7334240876551471104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d9C9hFF8vMQ7kNvwEn5RcA&_nc_oc=Adluhl1xUXXgE7VJYTRqndpKoeJoovaF129nC_vtm3jvT67_D6L8-HLtDz9vT84qHG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftCvHToFjG6kGH9x_C8mr5BPdxgLx1jr6Djru06Ks4e9Q&oe=699AFE92"}, {"file_name": "migrated_image.png", "id": "576788989581765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974534_338062773808207_8660192878208745472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Te0LDlgdDQQ7kNvwHdiuwB&_nc_oc=Adk8BJwSjK50nfYYdr6wDT9qAeR0tj1zqIFNa5ir8d63zpAUC9wpJ-iRNpyBMYPHbYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs7Mn4iU8fTn9RCMTkS2rTpkP4iUGfmS1DF0eWqMpf9Vg&oe=699B0899"}, {"file_name": "migrated_image.png", "id": "2717847824992129", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982682_394634374507239_6439063808236322816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE3CO83rUDQQ7kNvwHrgmM-&_nc_oc=AdlBxTkpHiduNTgggIhL4ZPKd7K2rczP8Y6AvXhKqgkj3uEZm75I2zoMCbaxqkj0Peg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftLhO3g1fVSzlAD1MTIYSb2vy3-Y7MGNuSJQHfoshKntw&oe=699AFDF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/gW9jvZ", "id": "257878025409463", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003260_257878028742796_350594443750932480_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-eRR2cb_4kQ7kNvwHastjf&_nc_oc=AdmhcCdHOK-Ic92XKmlF9sRzAyu5yNT843mqf-6ovhBYnNkIwE236l_1W2Q3DOP9-JY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afte60dbaNRscY7u_Xvqk-xB-GgpFMLGX4weMIpJSD2dyw&oe=699AECF0"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Create amazing street art with VR. Sharpen your skills or learn new styles with thousands of online artists from around the world. Up to 4 simultaneous players collaborating at once. Customize your in game avatar by designing your own hat, mask and spray can. Use True to life Ironlak Aerosol colours to design and develop skills and bring your concepts closer to reality. Feel immersed in 12 realistic environments including a trainyard, Alleyway, dusky city rooftop, and an abandoned subway station! This is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": "http://infectiousape.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infectiousape.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "996897104242199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031511_746397252843926_6109089926375896853_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPkFHpDAGYEQ7kNvwFoIp-x&_nc_oc=AdnYWzZvZsXyCfSp2OBS0PnrbMu1c7Hv5T2KRbhTceqjFraLnGnb7v2smsYZFqsyNaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvQD1iGu
F9D381"}, {"file_name": "migrated_image.png", "id": "616563445860021", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982502_2366061466986326_7334240876551471104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhqvF1l3SuAQ7kNvwHt9RCa&_nc_oc=Adok8XFt16CkL9f--DsBVjrsDsEO9iOF7X7ox_ky7XdrHJO0ImMganc6jC4bURFLaEU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnJ7iZf7EXpxMVFncYu2wd-nOwnW1mNn6ZHPIpS1yQbA&oe=6AF9E5D2"}, {"file_name": "migrated_image.png", "id": "576788989581765", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974534_338062773808207_8660192878208745472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDxO9jkRnckQ7kNvwHf-7R0&_nc_oc=AdorWTx0DalAe210g8O4YqUh3JWMr0ZhySwpiZRIiJ-a1Vlek5H7QHNQoMz1olw99BQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq1t_pIWi0o7EAabOoQi4uinLvFckBXFHBq56B2KUpcQ&oe=6AF9B799"}, {"file_name": "migrated_image.png", "id": "2717847824992129", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982682_394634374507239_6439063808236322816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwnh5TvDZwcQ7kNvwG5Gjj4&_nc_oc=Adqa0fTNrFpgzQ9qlIKSPQDwIwfv0WnrQcRfzQU1raXhoF9ZAtkVYqmZbVl9QGFGfOY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTssT69zu_mBLxSZG5rVmarb2KWiawFhc0N40JCgHWsqw&oe=6AF9E532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/gW9jvZ", "id": "257878025409463", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003260_257878028742796_350594443750932480_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkkzqi7q6lgQ7kNvwGQc9_U&_nc_oc=Adr68H0sMtFMDi-8SnXQqvdOTdLOZi0XnX5Eqrf__dDhrmAH1SEXZKoyAud_YwhQhV4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ9KMY6RQks7CdqsbNPw04SUAz2lXkSt35Q59fvVyHgA&oe=6AF9D430"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Create amazing street art with VR. Sharpen your skills or learn new styles with thousands of online artists from around the world. Up to 4 simultaneous players collaborating at once. Customize your in game avatar by designing your own hat, mask and spray can. Use True to life Ironlak Aerosol colours to design and develop skills and bring your concepts closer to reality. Feel immersed in 12 realistic environments including a trainyard, Alleyway, dusky city rooftop, and an abandoned subway station! This is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": "http://infectiousape.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infectiousape.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "996897104242199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031511_746397252843926_6109089926375896853_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a
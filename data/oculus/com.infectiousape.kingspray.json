n.com/v/t64.5771-25/38982682_394634374507239_6439063808236322816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysPrS3P47BgQ7kNvwF7hJdh&_nc_oc=AdpIoYemkFBbLmBku_v9TrSfw5TVIMHJUHYwSi6cU_C_weOceHPJ5qyqYkRTwU9ttkk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0TU31FIl26MeYz4udB401aytwfvjMulqtXIXcg0v9ccQ&oe=69F200F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEXS8qgzXGMQ7kNvwFjy-5m&_nc_oc=AdoHUgq5yXWP8aQBPEk9hP0bBVvXlSVGH42FhPkTgexflT_ZU49tnS3UjLNkP60Agvs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3kSSamRKnuLkHcv-hT5rgELtfAlP7GdT5lk5J2HWRArw&oe=69F20A4E"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape
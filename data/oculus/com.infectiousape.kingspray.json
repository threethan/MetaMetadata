6_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6xjoluYSs4Q7kNvwEG6GiO&_nc_oc=Adns-m6ESYJ3ICCzoFHkcE9mPrOuIRAvzJH1j-I08JSH5W9uiSA3GtVSEPDehBXC8aI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpjQbVb1i3ENDny43DKiLYfsO51XoR88qxKEKvsRK5GQ&oe=69A2E6F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHg3Q7YcV-kQ7kNvwFz5BSq&_nc_oc=AdmX5DgKNyEcdpn5CuTNArAVbkVr22XC7BbBwtrUolgo_BKxDDKA8yNsXLXpFrFPERU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTdovIhmjgCUlUSKpofLxCX01OAcE8iCcN39tCv-0_UQ&oe=69A2F04E"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infe
6_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE3CO83rUDQQ7kNvwHrgmM-&_nc_oc=AdlBxTkpHiduNTgggIhL4ZPKd7K2rczP8Y6AvXhKqgkj3uEZm75I2zoMCbaxqkj0Peg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftLhO3g1fVSzlAD1MTIYSb2vy3-Y7MGNuSJQHfoshKntw&oe=699AFDF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wws7XUWsnvsQ7kNvwFHFkc8&_nc_oc=Adn-NA2QOebAfTf7B7sEoXkxJIxFrF1bqPQ0FL1pJ0_cpUpjbvgqL-q9dUq_JOtVUts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvGD7o5RFR0hzZ_xElCUlR_m0pmbt3iR-bw4zCe7Fz3FQ&oe=699B074E"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infe
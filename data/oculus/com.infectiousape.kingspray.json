6_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysPrS3P47BgQ7kNvwHaq3nZ&_nc_oc=AdpJX6PK89HVQ2TjNGOsYXB_Xo1mtkWMy_FoTjH4Md1rDpbK_kIp3uzENyhcYdjEDr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af14dcrxQPj2K5xJZr2_H0ozDQXouvC4zdi_X9wXDWjapA&oe=69F0AF72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phTnKylwVkkQ7kNvwHN7sZP&_nc_oc=AdraJQkdjKK5thwd8E7pXe_JeY3Lq40NClKvGdRVefu67x_LUSbEXsMbSYHRj3DpUC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3l_Ni6-ZI8JtwiexriDbbirIuD4NumLI9fcHrUtLXxzw&oe=69F0B8CE"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infe
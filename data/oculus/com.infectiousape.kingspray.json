6_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6xjoluYSs4Q7kNvwE8mwNl&_nc_oc=AdmwfAedeg4IUfEWjFg5QqkJgJ7FAURtw79zLkW2T4eJK3vGATRqBVG0zqBvHi5G3ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcUfwCTv-PZ0M-_AJLsHYVHiru7gCjUIJUubk64gusxA&oe=69A043F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyXkqsmrNoEQ7kNvwG8OtWr&_nc_oc=AdmM3Bs_TTZFi21dCEbkPW3JiW7TwOubCTCtI_hMJRYPg8W6iGpwAMXOCkz5Q6gVIvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsk56LTSMg77OPyfcS8ccrdWlZQsNXn7vwik6ckCsgnAw&oe=69A04D4E"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infe
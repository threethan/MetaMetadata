6_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci6BahsRoEkQ7kNvwGahwBQ&_nc_oc=AdkVvdS9pNvJqPguMJdOL6uYGKzFNOIXIajBBhbFznQ6LJWoB9EOII_s41HnRa1rQlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5aKbAhxKk5KCF8ORntosKufEHkWNmzp-3JZxe8BZ39Q&oe=699DA0F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/u0V51Y", "id": "2491391347618703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974588_2491391350952036_5915712212038582272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wws7XUWsnvsQ7kNvwEwT93V&_nc_oc=AdkBNVGWlygkSshrm_vmJa7ZvYZiV5j3L6N88d9uShi5UKAiPhgvcyH1T4kksBeTclo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsrlYl09eDVFXEu4zkqj4_TB0LyDumZAWy0-v191bnRkQ&oe=699DAA4E"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!\n\nWorld-class artists have helped us create caps, realistic pressure and fading, metallics, wet/dry effects and real-world colors from Ironlak!\n\nWe have ten unique environments include a dusky city rooftop, an underpass next to the river, and an abandoned subway station! realistic paint surfaces like trucks, bricks, metals and various concretes!\n\nKingspray supports up to 4 players collaborating in Multiplayer! \n\nThis is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infe
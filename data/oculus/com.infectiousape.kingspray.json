550801"}, {"file_name": "migrated_image.png", "id": "616563445860021", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982502_2366061466986326_7334240876551471104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApiEWhpNciIQ7kNvwEfoClL&_nc_oc=Adpw9TMRb1Rz08Y20OUqsgyp0lY6TjfRzf4TZDX1H4RkK0akabJ0ocRsCnWvJHNZX1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdCltmFbBdSA2_fPlAUmEJSQ6WaA4nyfTTkryarczvBQ&oe=6A54E212"}, {"file_name": "migrated_image.png", "id": "576788989581765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974534_338062773808207_8660192878208745472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCBIh92CaqkQ7kNvwEw65hG&_nc_oc=AdrxDOlQT0HPS3v-ITb4G2XjzJdRwX2-d_yom6sc7bwRW5MWFlAwRyK7_q-RoWuXQ9w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs4uAnmz46_qSihcqlvTPIIGBxXWTSRJkihi6CR_MWPA&oe=6A54EC19"}, {"file_name": "migrated_image.png", "id": "2717847824992129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982682_394634374507239_6439063808236322816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXlEvcNFUSEQ7kNvwGkNBSL&_nc_oc=AdrLeCDAieDDmOA-TW92vnOkM5nfHIIeViTfUwI7M9SowpNqu83hUssxWS6vzrEWPrA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoDxPOhYscx2WwcF1MUuZAe-HCs9mR8Li5mVcsfdASAA&oe=6A54E172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/gW9jvZ", "id": "257878025409463", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003260_257878028742796_350594443750932480_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VipsHzo-KUQ7kNvwHjiPZ5&_nc_oc=AdpH_TMwvfyAYfvjSM_lHjol0uCe2NQ6HExzdt79vPLiLYtVGva7KRgC95XPIyonUVI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWeoOcE5rhCdf2Yw4wm4LuehdYTdo0Zz6OxbYRQCLE9A&oe=6A5508B0"}, "display_name": "Kingspray Graffiti", "keywords": ["graffiti", "art", "spraypaint", "spray", "kingspray"], "long_description": "Create amazing street art with VR. Sharpen your skills or learn new styles with thousands of online artists from around the world. Up to 4 simultaneous players collaborating at once. Customize your in game avatar by designing your own hat, mask and spray can. Use True to life Ironlak Aerosol colours to design and develop skills and bring your concepts closer to reality. Feel immersed in 12 realistic environments including a trainyard, Alleyway, dusky city rooftop, and an abandoned subway station! This is just a fraction of the awesomeness you will find in Kingspray. Can't WAIT to see what you make!", "short_description": "Creating amazing street art would be much more fun without the jail time! Kingspray is a battle-tested VR Graffiti Simulator, with realistic spray, colors, drips, metallics, and more!"}]}, "developer_name": "Infectious Ape", "developer_privacy_policy_url": "http://infectiousape.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infectious Ape", "support_website_url": null, "website_url": "http://www.infectiousape.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "996897104242199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031511_746397252843926_6109089926375896853_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKI_FRxNdkcQ7kNvwGpB81N&_nc_oc=Adr5HYn5-rQFGMjgNOYOec-NfY9xLZn9TN2E7vv2Dt1vrScBF4hXQYeaX1iR5D3NMeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBGlgUnthNTEzmBv1MdwOIfPaI112CJX1gQIQ8z56Hxw&oe=6AE208DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7a812v2RhcQ7kNvwHz_b6w&_nc_oc=AdrIY5itsaM1n7KV8lm72JH_Wk7ULcZtoanPAqn6uW2cGoglP6ZJ2sAOwJr7oLEQeCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1gR_tOJIT5S7hIqZlioqKSGmZ3D_77Fxh26YyPMR4oQ&oe=6AE1ECDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2PCpYVL2iwQ7kNvwE8dxqy&_nc_oc=AdokPXNc4rp73MLVe6H2IHckdxEVh0AyPIbwPqt8yyOB1xzY7vunEXKNiU68DrHfj-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNZ0fI4uDCdI6lGt7KuluNgGSPb9Nersh_xixywAV55g&oe=6AE208E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
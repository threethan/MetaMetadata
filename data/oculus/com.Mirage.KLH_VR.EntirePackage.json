64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn0wMrxXi0IQ7kNvwEQwada&_nc_oc=AdoXgSFI3h8Pk3IlEJjRBbUDO6qztumPEXnHv7xP2fpL7dun_b34gdg3F82kJ7JF_IM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZc27__HUu9OBqLmMThPo2F5ECsUC1Ui95JMw99ThNKw&oe=6AD236DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmzsYdtPWZQQ7kNvwF9mQjf&_nc_oc=Adra6hKa_AKU0fg6U6TdGpF2gwBgU2oy0v3VJ47sCWB5fhYFEx8WqFUCV95ljiIXXAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkDCfmXoq4-Tsp1sFHgjekUXTEcd5uS1y_l2bqy-3hsg&oe=6AD2531B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGOoijIO6JkQ7kNvwFNnmnk&_nc_oc=AdqDxwxALh6wwo1fr4nU4lTg8qs3PvpvFkYfP6EsTKWZNvgj0DfOdziQ7xnxjjxKtKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUsxjCET5n-tTlcXCtSKEkhA8GGsElaSLGxWcXTK2OXA&oe=6AD236E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
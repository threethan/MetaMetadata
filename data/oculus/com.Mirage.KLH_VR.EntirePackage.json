64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5Iwbpq3wEgQ7kNvwFOYDXN&_nc_oc=AdqzGLSyjXh_OhMtw_UZcEMeeDneEHZtdokgeEuSmF-ZWRHpANIGjss-xYjnK2Wu-g8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lXsxyFGVeTnARW-siXcXbmmge0-aYbmlVnkrwx5jZQg&oe=6A033B5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF-YWXZvcjsQ7kNvwHSBLW3&_nc_oc=AdrcB5ynCM-tTYK7ClD3vkiMjhlHadiukW0q59aleUYDDM3w3WmOOczPfQbQg7moWvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57GNtMGj0nBKgZH3WpARCqgXwxsuO1X2gx3GwslHQfaA&oe=6A031F5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuLz6ml119YQ7kNvwFYENJ_&_nc_oc=AdrEnGQz-bPCv7xtw6GDiPECGpGcVUc9WFTIYdxQ0r4IDCSR3rBxNIcy_j5xrznOjj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IzxIV48gB70OlnSkHzANYFKANE9n1zp88nP-YgHlheg&oe=6A033B60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
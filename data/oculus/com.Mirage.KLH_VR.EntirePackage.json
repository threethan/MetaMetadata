2664_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrYw_Y4r1EcQ7kNvwFcX7qC&_nc_oc=Adq5zg2-okS0eUr0E-9wR0e0qsbqTSxb9esFSlOnuRIT6REHfS-NvFZRbTVpYdGZQ18&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44HHUQuY2pl0sPFs8Q_52idir9lId4QPFhjostmHEPRQ&oe=6A11BBDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukXTL7RihtsQ7kNvwHHkXlT&_nc_oc=AdqTEyV0-PlPn0SkU0zEAQrjHVeIuivN88nEpVOnoFN5nLXgtERjs_ShqumH0oW5kEo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HqAhhkP_LYuIn50LJag4eOx7MJzoEZVE0qVLiXex14A&oe=6A119FDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYVtieizVxMQ7kNvwHAyzMY&_nc_oc=Ado_rPo_3601Zrga1sGtwc1fjnAAHZ-V5RB554lveEuZfob20E03NNnqtHpncF_27xQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b0A-PvyaYSCPNUo04vsbtqLQwTgv1CC5kF9pBJGJZxg&oe=6A11BBE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descript
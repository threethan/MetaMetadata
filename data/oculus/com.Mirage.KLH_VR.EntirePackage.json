64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzq8YJBrpRcQ7kNvwErJfFR&_nc_oc=Ado5WjXoNc08K_FmSrpBmEYEsysJo6EYjNMPCMugPcM4_rlPawMeqdOcRimGBwALo0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhX5U1YWxyjpPWZRKYNlh0P9NdwO7pCsokqBH0y6Uxnw&oe=6AC6595C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYIKD-4XlS0Q7kNvwEXh_uk&_nc_oc=AdpO2DdG_rVLfMxwbDrzBGcZDVQ_VgFQadTAlMSb6XgFhMjt1-IBbmPqKF3JrolA66I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrMP-_em09CzpU13aNe_IaSHZRxRnyTPZ4SrZLeEC5mQ&oe=6AC6759B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcLg8kAy0IsQ7kNvwHHIPMZ&_nc_oc=Adqe7YLohVDl-mWmhPPcL6Db8_CaQ9mlrxFX68k4pml9bmTXTnnnNk5LBnVuvshAVnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9m7iLQEqhXKYo7fKkHJz5HyE2rVxkpjuFWwcZeT2XUQ&oe=6AC65960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
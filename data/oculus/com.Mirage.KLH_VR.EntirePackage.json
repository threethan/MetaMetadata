64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEuWjMzpaPkQ7kNvwHqFIH9&_nc_oc=AdojcUoLzjNAdxuJOjNpcMEXyOXEWmen4O9IWLZgbEBa1ArGKoqon4EgESxOmSaFtJE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx75EJud3xTAhloDDCuKpFx2jzOQcS-0Rm5m3gwinb1w&oe=6A6F565C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcDpGR2eczwQ7kNvwEVQ7Xt&_nc_oc=Ado5IBcgp3IVPyd6PH3nbFpKBF_uXubTGsHBs1JzXlyEoJc2HyzqlTidLGzgd3XbBJE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIH5nApqQiHeA7k36sC_e6ZOF8324OmfVfZNCNn3N-sA&oe=6A6F3A5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h29f7eX3veIQ7kNvwHlzhrH&_nc_oc=AdrS1srTH08E0FgQFihRjIJLpPyOywB5qKEkf2Oi6mYPSbK1pWyGnX2hxFi3uMxQ384&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs4CZuuBnzK3HmmestVgflx4r-Ya3y4cFppBooKIFhwg&oe=6A6F5660"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
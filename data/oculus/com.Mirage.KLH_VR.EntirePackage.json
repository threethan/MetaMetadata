64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2iAWdK6hgMQ7kNvwE4sVnL&_nc_oc=AdoG5zAzfvi9Hvgoz26C2T__TRNPfStxQOnSkr4Vs3gmJpGWWDepVVvZijMLwkrHUMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xwsB_AKI7QtHB6apLTdGfXwhMrI0LnfOe9we5TLsT-A&oe=6A00985C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hqJ5jX8xr8Q7kNvwGo4TlA&_nc_oc=AdphdO1ou1MRRE4MarEtsAsfKfx7u3ImU0TJFsJ78WRpNPydoDH7n5bogEHOi2opChA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bJBWjn6HA_AUAa_KwmbOApyCmb28Lteqrfy1xKsvPdA&oe=6A007C5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DE01iTR32EQ7kNvwGw53RX&_nc_oc=Adp-PiTUF9tA-t6jzaYWqbAT-6w5Fp8xpBM78qVunwkwQkqUwRi2OF2qQEWIxDX3cf8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xmx5NQKOzLXAB__kPd6kOkW7tq1YSH4mK47upKPKtRA&oe=6A009860"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
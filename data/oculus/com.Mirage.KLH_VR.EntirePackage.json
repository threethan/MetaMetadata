64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxDLCNqqGpUQ7kNvwHdJf4u&_nc_oc=AdqN3hIdso9BTpw54cXTF9ZLmN7VXvmsrH4-zrbyUlgW-uq4C8WJrNuuCa220H6_tlY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwF_v_W7iM0MRHeYHXn2gwVdZZxz6PNGb8ryNylZOgymA&oe=69C2A1DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhqhSU1ZH7gQ7kNvwHuCZ2t&_nc_oc=AdoSWJk6sdJwrFpeEpr91iMYxMxOD1nAIU51YtwV1m_BO0KEDhxggRpNkZ6SCWTTpIA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH3mj_NDM9-rtUdkKodb_JeZR91yis7RMF_2cVhQ82UQ&oe=69C285DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZGPwx1eruoQ7kNvwGF543M&_nc_oc=AdoD4Pvp8Wcip__y10Lg8OIIDLyHMYboEv1zt8iCds4xtjC5ZjmJuuQSYcuUG9bmLLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUxZ4TpkFx6n1D681npCBBjwsqy8xjlJln2NfM69MlbQ&oe=69C2A1E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLhopMIkqAMQ7kNvwEW-yi9&_nc_oc=AdpysQy3cXRPxMKtFXbDjk5xKscpWCp97nSu8SNNhSf3e_arcEfOXRqhZHwQONfbBwk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsN_DpcGhQLPJMA8528mgYXB1ItYUTIm9mg1pAEw3bfA&oe=6A5B8FDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q8RT2e2dY8Q7kNvwGMbFt0&_nc_oc=AdpOhZm1qt4uREv5TFiQueljkpID3FkURYYMxDVWMBF5Ndx1TW8S0lZpKWZ2u4OzX24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMNGFhlYx7HxIBIJsWhFVmL6qipiqox5ieTosTM10yMA&oe=6A5B73DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFxwOEzQEOwQ7kNvwFfT7rd&_nc_oc=AdrTvftG88OGOi89inQxt2BrKdncdlaK7Bhy_BdndIFYKX2JdJ28-1VrPfTN026a_AM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1TTLe0Xc0QkN657GZeN4CrgSZDqxGN5aWRnEsrXqwrg&oe=6A5B8FE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
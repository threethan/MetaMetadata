64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mOQPNvrCZcQ7kNvwGX2bvH&_nc_oc=AdrAQYFvwLzYHxzOZYSsFSxE7O8J3FTyZLWi29iOFv99YRvL1MEfrnCSIUKhREgD6io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cjn-WLgdraPvkHKAZfaduPQHrATLmeNUkt3XmnRRfxA&oe=69DA5CDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I75ZDqHObsQ7kNvwFewy7Z&_nc_oc=AdqOrS-MMxwQrS3cXKvDcAcyOOPR1GQs3QajHxA9wO4kSG3fqfoGhPuZbsLfpY1a-Ww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jK1Xul3UKdYnv_iHbfG7i-clZO7BjrkCTZibqc0EG9g&oe=69DA40DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2Cl7-GPxIsQ7kNvwHnxn6o&_nc_oc=Adrqb4iqBZIgHsMso4NzdIOqPthk9SJ8oHuAijYy-WlIjXxtpuzIBKkFNbkO0eTdrgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ExbxgyZTjuWs8mE3ymuaQCoVUjdWXIb5zq-YWV8qJsQ&oe=69DA5CE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
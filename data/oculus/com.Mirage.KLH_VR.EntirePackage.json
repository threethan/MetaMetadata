64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40usklNY4RcQ7kNvwFcsjhb&_nc_oc=AdqtaxlkyrEADtJFGp9dfGHrK2oTWff1oaBkkqAdsl60VwuqIdmqmJ4lMw78DJXf2G0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OIBIviSK0t275WtKWLilnk_wNZcIY4IpFm_va8ffu5w&oe=6A35545C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQXfGw-maPYQ7kNvwHVL_Td&_nc_oc=AdpXmZ3Bm2HC8XU4xS-j3VcL7LKOzYmWiDFvht792DkrHCmPmvLpFv41V-FBi8LXD44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ALn-CZIxOu8pjr4pb2y78dARHcYLcgjJ0ynR_8oNU4w&oe=6A35709B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MafrweE0cOYQ7kNvwG_X-Nx&_nc_oc=Adoy0OlBFUSyTX3_yXACi0KPDf8NzUru1B-hfxPFKoaj_2Wp9OLHiiGiC9F5RMerMC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9_DfJUVsd_rYfazQasdZsy-NwouTch7IHAjPjLAczwQ&oe=6A355460"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJbWxyFW-Z0Q7kNvwH1b25U&_nc_oc=AdppxiXBHqkJukjzizs1ygCoiFz2AoKGDcYJGAdzBnHswqrIdOL14QwsuZDPMNcWJI4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrm-h6TZKuZpUaDLbp7jUoEndhjllCBFEJyBtF65JKew&oe=6A62275C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBVpI1kwWUEQ7kNvwH60bMt&_nc_oc=AdrlSO3rod73z9BodoMWugE8JvxFHL-6p45DOGULHZ47Wnh2EuhzU_8BXoYHvKhY-9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9cxKjHp1I7GpQTTCFcrXbyx0UoI6uhgDqdJpyZBecgw&oe=6A620B5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg7VSNVSDQAQ7kNvwGiPbWK&_nc_oc=AdpCYbAPMZ3SvJX-whzV67bpgNlB1mnjZp-R0Uh4m9bHOLN6Z6eggdBXTFYTSixwarA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFHf29eC8-EfNndFUECKvQWjIt7pUnaCkvcs_OZwUylg&oe=6A622760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
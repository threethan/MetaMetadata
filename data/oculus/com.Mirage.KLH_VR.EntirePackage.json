64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COBmPy_JPgkQ7kNvwF9mjgM&_nc_oc=Adp7iG3xuY8wCSqLnAKJrduiAJYsL1mVVwyjfzCtQszBpEO2X8vcUFUVbeVa5Ql0ItI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB5Cz4wWF1NnM1o3S4Ij4TOU90fStVYqQOjV2496IhLg&oe=6A773F5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QtOidHwJxgQ7kNvwEnrHpl&_nc_oc=AdqlkOxU1JT0FgXY48k7mcTLBGv714IP2Ut2otXIJx7FtWVUukQo1x6cfEN9uSJ61Nw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE00PkLVcAV4sbOFkz1nrRNs_iJluLtZr7OxeWdAloQUA&oe=6A77235B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybftMdwx_ZcQ7kNvwEnjy-N&_nc_oc=Adqz4BDZSPDX03vCqRmL_Qp-MBYAawpRcZiiHCtWAulY2VINZ3JDstCAkOIQVaS9Vdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH73p6gpWRwhucnEeWBtf-s1lXQg4oqQm3U4fV80IPItg&oe=6A773F60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
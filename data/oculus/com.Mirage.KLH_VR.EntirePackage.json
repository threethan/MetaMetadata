64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laFMUM13NwsQ7kNvwEn2-j2&_nc_oc=Ado8lJeSK1_ijsZgJJPxzuIetqiBhQxWXPIvbuA7jtd0w1fx2dzZMrInT8fgXB15y_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD-otiexLMcqg83Fa7S729fiF9UBdnNyHGrTE39A49jg&oe=6AF47DDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeqtzumaoWsQ7kNvwFDQnYb&_nc_oc=AdouXB-JQe8OYxOqYYTBwmlyOvn5XUX-7vm0hMSW6mV-YY1ni7UjTqdgcaTfKR_9Hp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Xq_DszCaT0Sc6eaH1d2OvM6p3A3AtwKS5xaCyi-rLg&oe=6AF49A1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAknGzM7HkIQ7kNvwHJzISh&_nc_oc=AdpT2XYshZ79c8hvaKVkU-YV0QqScQnhJIihCvqAVIbxAmjAtRJvbFb_Hc1tF1LWdTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQeNJyKi83sPrk7J2GYrCe17Ld_3nUh4Ae6_42WPD7JA&oe=6AF47DE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
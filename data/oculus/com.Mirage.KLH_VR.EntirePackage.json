64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCJSKrIPGxIQ7kNvwHrW5Tr&_nc_oc=AdpCyUsUNKM1SkYxg3OrUnHB-hS78AtLjCQYOgLEUq4TKnFobAMXWjw99nxEfv7Hu50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2ZPW6TkUWNeDVvGc51ChrDcyN7Nh_Sr9d4hocGAs09g&oe=6A2EBCDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LdWHiVKj-0Q7kNvwHhzD3h&_nc_oc=AdpT7-X1dvmFWadu03rF-4Dt0TM2h63MKFhhhmugyAxQoYV1m8cURdMISFnwiT8K4sU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XguI25AZvASAqYccdxMC2fI1G7gsXiyiJLtzxrCzVxA&oe=6A2EA0DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PG46laMN34Q7kNvwHQR7n2&_nc_oc=Adrpvu_p0Nq60AB4iElNNNYbxCTEdxzYxiNHQzQPY52T6ShnuN_TQe74L4aXHl-RJr0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--yYaj8NUX4sxeJWObjyZyTLU4cuIQNj_8HX3kGmHZZA&oe=6A2EBCE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
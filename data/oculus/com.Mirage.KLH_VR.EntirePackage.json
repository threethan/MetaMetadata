64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKI_FRxNdkcQ7kNvwGGvL5I&_nc_oc=AdpsC1m4e0eDsfwKtWn6UFecndhv-cJulpFeNoSBQx0kGc5dlf_holP_td9Z3jWmW-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSE0mQRQo9LivH76hModIbjZlgxSYTWRU3845Lep2KeA&oe=6AE0B75C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7a812v2RhcQ7kNvwGWfFZq&_nc_oc=Adq7GkIsoDTPh9iQUaGNq6rRI5-yZnHyFFDW4QaWgwAcY9A4xiWngU70c0f5lueU3Fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0qQw4fpxrIMYZ8TYCDl_0lecgEGA18GUX7AG-FOIGLw&oe=6AE09B5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2PCpYVL2iwQ7kNvwHaDcbT&_nc_oc=AdouMmHYXpvCNu_JkBjTRuHa-loh2Y9m7speau-F0PDqAigglV3NA-r00QmiwyRWI8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuNx2vR2Fj4CxmMCcnVFkyj9yGzn64ZjSqTwWlTBumZA&oe=6AE0B760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
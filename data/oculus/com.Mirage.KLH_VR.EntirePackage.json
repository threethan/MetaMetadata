64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5_P-EoLvsAQ7kNvwHXm6X8&_nc_oc=Adp0YssDgCO3lu6uKquAQG_6FB_b_NZlRdH-umCPoALQV32CqMOakySDIDoCpXc2xzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoFh7qUA8uRsfH_eXCrcBh3wmGuK1mmVUbAgDWwn0_Ng&oe=69CBDC5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHCul-eIKaYQ7kNvwF-n1Vl&_nc_oc=AdoQd1dlgujLuJ3ZSu9comn9uEHqKVhZjot-a2uOMJbFusWZV3UUuirWwLalM0nOCk4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzJx4LKhqRb2AXl3O240TyYecTs4CZZ1_e9lWLvChWhw&oe=69CBC05B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LmHHY2zhNIQ7kNvwH9IC6v&_nc_oc=Adq1jSppot2WcRv_xpTq55i3zVczaf9BgMImur_x109RUYQSiND71v_UdiBrgKCMycc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrBHEUJQeNTq-y2SgTYcStl-QR79BqePwRm6Elr3wq9Q&oe=69CBDC60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
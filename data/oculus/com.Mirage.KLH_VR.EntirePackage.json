64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY67ttl4gd0Q7kNvwHOi5ej&_nc_oc=AdomYFr4B9GzgNes9bwmq5xCyCnr3isKOVTNPXvXCOkI_xoukRgDQsD1jdW2I7e6xWk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KACsg9X-l46rnAj-NTeuYecRszFnx_qbSxWIJMsNFgw&oe=6A2C19DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWX9H8cstBcQ7kNvwGu2Ygb&_nc_oc=Adq7fsKG0Q-kV0mM8J2-QAGRViCKHhA1hqgUteb-T83U2mpeKERDNzV-5IkwZRnHhQM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jIfIsWtp7YHRSSqnKy8UreF7nOfoi0z0xNIa-OSGzNQ&oe=6A2BFDDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2lokkzkzboQ7kNvwEQNrJC&_nc_oc=AdrerK73ZkDK7TMc5CsUV1DRW1V45taWGYqrjLqYSelpKdaaRE3bMYHaVX_fXLky7Bo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PH6aNU7UFlTnfKNm22exprEBgmWWt3msT7tAGSvXGhQ&oe=6A2C19E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
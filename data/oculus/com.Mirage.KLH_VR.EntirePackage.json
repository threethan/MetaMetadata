64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0NBZdp_9TsQ7kNvwGZDlBZ&_nc_oc=Ado0dGwqaHnsTmj42DZTNbBwW7Wsw_uc2_419NNF6PIGkYDrE-GLylHLk_q0QhtbWjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFaw_0ibuUR6T_AopGJLKSjQJ7Tvy_pbiQ5BvFlWMfwQ&oe=6A9C295C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIULLAOdzZwQ7kNvwGKiwUj&_nc_oc=AdrjVEn0-n9zOmUX3IATg8NpQnQdKfOpDXyxENZt3IzGw-AYC5Sf-ELnylskzl3Po9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOj8HU1VTlFRGP6rPtQeFZWvUHQ1SGXLUsd94ep5XxIw&oe=6A9C0D5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rlUBVuIchoQ7kNvwHVh-jw&_nc_oc=AdqKKKUv9Dst10p02QUZauYLvcYsnqiGJCUPHQDBmtcqsNllDd200DLIjqZvhfOBEgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp8XlZBQqlgNguPyqT6ALilvI2xxbcA-7QoxtYQcojxA&oe=6A9C2960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BKoZplEOpUQ7kNvwFs6Ju0&_nc_oc=Ado3CY2i6Ce0guwrdY_-2m24KltCxiU_3ah-BZqOTkrCzYsA_0s81Mm9wbfY-t8jSV4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_41SOOz77xb4ozVxywsNZVQEWM3hbsvV74FcpQK6412A&oe=6A4131DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoiNX22HqfgQ7kNvwFYrPk4&_nc_oc=AdoPv-e3JM4p0a6YMrSVk4PTklGgtd9t37cnM5If_qZO4laUO5PblinUI81aE9OcVbc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ChTDU3lif9CgiqUobs2HyCGVR_sYzPjTyG_MXjEZWLg&oe=6A4115DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vq4Bu9tZKxkQ7kNvwHcxdXT&_nc_oc=Adp_Hc0dTuJnJkBuqmhADv3rADBsURfM9-qTDo3NyI-A-FF9CEJysMj8CVJpwOn1zY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E-Ea4qDMZZZcYcPXTKbokFA0bgpfsn2RqHh-abwOD4A&oe=6A4131E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
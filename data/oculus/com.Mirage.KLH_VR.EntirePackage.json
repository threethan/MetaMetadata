64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkP48OXQRSoQ7kNvwF9uxDB&_nc_oc=AdpEAiBv0CC6Kk4ac5mrcSkh-Je3n6iLfhxbB5RJ1zqPzTT6v84iiIoHl-4Sqp8zwZw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rtRRrnfLctnfBD3oMbzUWpQRZvD4fFbBK3wscDYGPxg&oe=69E78BDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HufuoOCx-vUQ7kNvwEeuxw3&_nc_oc=AdqzThrtaR2mb1JuhQ9WolCUyk6-gMMGJBnzqNCCRoZz4H3n1pYwugyZQkF7lb_ZI84&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xnWu3pjoBVg7wf477xrFBKn6YcH5y_Ylig0TvtliVUQ&oe=69E76FDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPxPC7r5xh0Q7kNvwHy8pLx&_nc_oc=AdovmObgYEAudnluVWrL6nyKMKj1mTdW1zNrzvXDIFfP0bGjoEzaC3cVLZ_5MGRtF9I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vJD03Y8R3H76qp16BJ4dDOw1xYAx8U3WV_EnXYBtTmw&oe=69E78BE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGAiKB6pgSMQ7kNvwF7TUvV&_nc_oc=Adr8mRzW5EJBsqyBRqk297ZwPUFtk_52u5gzRhoO9mxleXKovoBIei5El8RDkKBAwq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28FFY6yvvgZycD995mptXHS-4A5ulUUJttmcu1lLEnKg&oe=69EB805C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye8Nkk48dFwQ7kNvwFXCc1P&_nc_oc=Adoyx17KxyMLi1gKfhKDmwdYpDSZ-VLAWTRzuaEW5wi4KoJHBJdd3pGvpNvqy_03L7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TH8PzSiQXilFzUZ6uKCCFnqd5tWhg6ZpZhhuNtcjqEg&oe=69EB645B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7XCrOgVaWcQ7kNvwHMFZeg&_nc_oc=AdomK77VoAJaSkIXyBM9HlYTBsNqCiAbZ4NeqHAYqGYYJTYSpB2yGZYsaMHlfGSuOuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OjsGfyN78KmcIvu63XMOrvBJ6GhlxNurCbYgxa-uMjQ&oe=69EB8060"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Usq5Rcxyi28Q7kNvwFjhq0-&_nc_oc=AdokiH9OrKfv9NBhwPQpQuC-vy1u81jatOAnztQG3ogC2sELMkfdaeDQI2J9fbO6DqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6jEgj_-suSXawtZc-JBl4XHWNUBC06o3FEC5hqYY7rg&oe=6AE4ABDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mEEaxjklREQ7kNvwE11RXW&_nc_oc=AdphGnMVTYU6e2TUyEqoyCnRO1PSuMnh-eXEdi6scqnRxdXMytix0z97Lsw3L9KMfV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5VzTBlvmht9V6X2md2kPbi1QI7vGbivtx7DBwmc2tIQ&oe=6AE48FDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9CyabZ2-l0Q7kNvwFfbC5e&_nc_oc=AdoDr4lMbMwP6cMKTif3nVb8aBmPGUgUl-cXKdYncaWAWVxTg7cvXKmWXYN_xyYVVQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcg1M3RgRhaKFAK1YLF97n_-DkrQbpRzUsRJWG1zGhJw&oe=6AE4ABE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
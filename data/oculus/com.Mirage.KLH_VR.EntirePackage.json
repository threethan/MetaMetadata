64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nN0q1s7O4QQ7kNvwEBJ0ye&_nc_oc=AdoirtWP7PiiSz4GgwBQ09E-xx8Awj6JDkhMWWQSrMEFkvPGp7gHIW9QZi_We0OSUEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3GY-YpvCNXYuBKuQmjEqNaAnbrtSLwrLuhWsCA3LGqw&oe=6A4FB25C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve8FoMGvnzIQ7kNvwFS6-QP&_nc_oc=AdqKP9hsi2EYOVxEX7oLt8ZonB-Sz2czsv_8UM5ew6uMtCq1z0mqZN6HmZPzN4iJLEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8KqnSej1jsLjwP7r8GYj6if_JPzys8K1f95DvaUCpTQ&oe=6A4F965B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X98MZTIqvzYQ7kNvwFjDm8a&_nc_oc=AdqvvShwogVmuJVyVML2JODKzkeY_gTj63_vusSIqwDoliRcIfAjUod9ux5NmKKNMRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf5qBHZXKnV6dTi17LDpyp_wCIZV0yDMN2HQ_Sd4pAoQ&oe=6A4FB260"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYp9xaCRExYQ7kNvwG2bSJc&_nc_oc=AdoKnA58qQxh8QWXrkM_Kp1_-fu6pyIMybo1wUjcLgsP6Xol9q-8XYp9Id-02tdtp0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWBZ_aTBCKXftHGQ9hF56vp_Bp9QNC4B4QpGH-_L7OXg&oe=6A8C1F1C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-ZlyIQhfuUQ7kNvwFrrS_m&_nc_oc=AdogY51lI_oVUIiegJikRVhG6EzH0szkb4h6fU0pJwiylgY3IZ1aBcSxWsQg-DxHCFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjdQbjzUAt7q1EYcexcAE0_Rm_3RFMVmzh5gjbFUYuPg&oe=6A8C3B5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jcqlLB6A4oQ7kNvwHJESha&_nc_oc=Adp1hlfApnWlGo99ePVcuzR79vJzcBFh0TOVtGJqi2UZoy57zDrlG46LtnGEOjwDE5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8nKgY2lSCuBnA7JIt3hF4C7kSAG2s5BMhCgo2UFZrpA&oe=6A8C1F20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COBmPy_JPgkQ7kNvwGRYaY0&_nc_oc=AdoeSz00CghrcOwC_U1s97qRnYP-2cvhIjrtd74Qg4GPkC9FT2OvSzLnD1oLIn3SB8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAu2w94xjyqswNkswNlefZkt3IQE6p35kNJ8sJ5B-9cw&oe=6A7890DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QtOidHwJxgQ7kNvwF06aQF&_nc_oc=AdoOnaIm7KJK_B47eo0qqZhBY4FHAyUIxx6cwWPWbYd3K5-AShvsGNbj9mNuL6mKb00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4rGLWvPUr_YnXPITA7Pzl7l3ZQqDsq62xR6snD2rgXw&oe=6A7874DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG0yxp61jsUQ7kNvwEKxAZy&_nc_oc=AdoXiTjPndJnaVs5eQNF-38cI8uyCcuA47rGV233ANIQHMgHwv_AatAnz6Cti0s019I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Yt-FkgON9U9FThEfAVboOyQPrBLLfKO2UxAyDVMA8A&oe=6A7890E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
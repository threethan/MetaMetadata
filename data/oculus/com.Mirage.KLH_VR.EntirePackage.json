64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSYgN-mh9S8Q7kNvwEwrTdq&_nc_oc=AdoOg2S7LSZYmV36qR6euVdmJVtvQXsGqKfG3uNmkUo8oq6lvDI6yvyYgpwjz_HKFC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO8niVdehjeCTCyvl_cEigj_EtqTK46FkdvRQYBqszog&oe=6A579B5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9srj7FqcdswQ7kNvwFgVb6G&_nc_oc=AdqXgYrKlTeslp22RI_63gXViMI51tan2b8znYDZkN5unOHx8haqtsImGfhgBiTZc5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7hIcd5WK253AOH5MlnWy8E1gXV47KTWL1Q34UMkg2rg&oe=6A577F5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfsszkGQpfIQ7kNvwFFOaeE&_nc_oc=AdrPkBldVEB0CsKnFAZIzegrCosTyOe5_QtC6ABtH3resowFIF1F4sToIhT8KvWrIuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv65q00bHawE3MH8PV68UymX4RrGCl-vpKmLORaI1IqA&oe=6A579B60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
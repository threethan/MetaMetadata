64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaEFiUfgUpMQ7kNvwHLv29l&_nc_oc=AdqApvAnMrIM2lT0AjO44qXGeeecpGYAMNe2lS3Bsqbq8rkYdiaBwdNNuy1QBzbbJEQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Brk902VBZX6VTmDdi6JoriP6dlDYfjTJabPo1WGmWw&oe=6AF32C5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeqtzumaoWsQ7kNvwGnqrST&_nc_oc=Adra7Of4GfR1LvY3wwV8KCB1wT6XFgGcPkxCEZZf8il46k-SnKJHjk3VrQzHpeyslW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTa9zVJnbK800zJrhjFJ9C_G0bjg5g9KssMd40RzjVrQ&oe=6AF3489B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAknGzM7HkIQ7kNvwFlmFdp&_nc_oc=AdpW5wUnrLTq_hLp5ZnzJ_aaSGJalizgrm4PkwWikSz-Nnwd9waiEqjjuYywl49tGyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdRldKQpfEgnaLl2gw53SSRAYj-7eaZulEsOS55UD1Yg&oe=6AF32C60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BKoZplEOpUQ7kNvwFoNvVM&_nc_oc=Adr_r5gC_Rmt9M6IAW_dijOz8drRGaK7Qth-drAxq0JnEeGlpaNJp5fMT--3VdNhlIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VsDMELR4_HY0O79e7wDaK55Lw3JSOpENPz7vje9zxDQ&oe=6A3FE05C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoiNX22HqfgQ7kNvwFhqFox&_nc_oc=AdpjjRzHtBDrIDmLiYq_KFALi0qYkHPp52dZM8zdiFtwOYZw2Cw6W3E0fHNT_lsihZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_diHq61tcL5uygMuzSuo6c8z5iWccC6v7-uzverkugpA&oe=6A3FC45B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPUbF1OCdj8Q7kNvwFny56w&_nc_oc=Ado-1FIIwhFDEZ-M9kRHNt2ri9sIwbiZgzQ3HvkmsCG-FrpZjCk5LAMmbYPq4YSm7Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JWMR3o3rLbY5UP3Xx8TYSPhzt6T4ustg95tDnJX6eiA&oe=6A3FE060"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
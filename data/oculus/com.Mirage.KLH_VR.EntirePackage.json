64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGVNPa2QStQQ7kNvwGum-hg&_nc_oc=AdqqJMQg_6MRuP4AJnvpWz35rC_OU7hsa7qekhRA07317FP_Qi4nZtDKIYb8gnEWksM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12GFEFPpYYw47wNZLrcWttyj-RgVW2ojlHgCn2nFIZOQ&oe=69EF74DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aTytiMVz6QQ7kNvwHv-msO&_nc_oc=AdpEMuVqw_yAsqJQQGW1gTG5jjeek7cSQZVMfvGGkJ4yTFXM2t0rKckQcHdxZ7M_4_8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QzWk1hY90meGTillegJ4oGdyc9gtCCP0jdKJczX4Pcg&oe=69EF58DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNJdhwKB7cgQ7kNvwGRql6P&_nc_oc=AdqL5-W3W1d4NzsjVyyeheU2htz9HLE9ZELHP-gNmsdyqkoftLTx43kLvoLgnhl6lhc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0l0yNA9cjYvdIG6XV9FHg7gF72zi8PPrsTwvvmJ5tzQw&oe=69EF74E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLsey6vso2MQ7kNvwH-n2tj&_nc_oc=AdrNfKJgZqnjOuEbwPmoX_NDtpG87OsQZX_6nsj9xX4KGLqq9YWhXKkyx2uDDZe_U9g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GnOVkSVFR3rkeNMEElOybvbayQIuirdd41c9IciXIIw&oe=6A2430DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SIODXgCFYEQ7kNvwHYpvnD&_nc_oc=Ado01hvD4XpLYkon4-Rkc3Ch60RO_UkXp7c27Z7-qUjwdcozvsxCA_MOFN_QxqjDU5M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GeKUDtZaIULnCWnB9A6EDUsct_AJpq3OnBdcOQrvOOg&oe=6A2414DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnME4-3VxHwQ7kNvwG_RQDL&_nc_oc=Adrgt5NgBviYi2zUJlmMNjNWA49jhZXsRf_20mqRs22HJgDBVVyRwEb_CzunfkkbskA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97W24IHHXNSujQMpkXyT5heixzfjnN6VZYFJPHuwR_rw&oe=6A2430E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
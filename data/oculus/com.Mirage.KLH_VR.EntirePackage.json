 of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins - an adventure in the vast and unknown seas of VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mirage-vr.com/", "developer_terms_of_service_url": "http://www.mirage-vr.com/", "publisher_name": "Mirage Interactive", "support_website_url": null, "website_url": "http://www.mirage-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "FIGHTING", "NARRATIVE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "293144692805067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12522395_319450561740416_2048651962_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMBgjSOQ9rEQ7kNvwG8Jnhc&_nc_oc=AdrtRxDhHChDIm29IH3do1GUgCaovQXF9Gcd68PrvLBH5N-GvhvhDyWVnvetI1Nnnb0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2GwwV2Z697kFXpivamynbkoTzG3_C2PGmsPStMga9khw&oe=69F1E4F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Heroes of the Seven Seas", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1469602800, "lastRevision": {"nodes": [{"id": "487565814772377", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "841486759289335", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_
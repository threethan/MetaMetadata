64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAxNMuPDPq8Q7kNvwE5NEqo&_nc_oc=AdpFg07W0r805yS3yYT3skpXwaKp9tHEdIuWNX71hRYG6pguSBWV5gcwGUVkmdw5CS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDT601aW2-5Eo_m1ZV86YB6cOjLcHWPQyIMkPVE6REgA&oe=6AEB435C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxSw_n9epoAQ7kNvwFQGBy_&_nc_oc=AdqHMbGiVUc80-gf-iXk5rsZay16HEBc4HxrAd3fs10CGv7wD6IhyTH4bbqsNl7MtWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiqBvXW62BIDMjoc7XX2jSZnklItzMP70UFdQwCmR1KA&oe=6AEB5F9B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUoL43yiUSAQ7kNvwF_e2d9&_nc_oc=AdqrBs6w3Tz5mRCf3nmNa-KfkFLVXHL1G3t2_uPGmkkoeiuzlXL70OoNjseysFvGazo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBnXisDRZKYOIIdrZ316oC-002U16iekh2HsdsYbRX5A&oe=6AEB4360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
2664_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybfd38zTAG0Q7kNvwFshPUI&_nc_oc=AdqVMig4ynoDXfaftcmIvba0Bd6_jdfVcSr8lS7PLB36mSgHRkEjq3dekOso8pfT6jg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuOzypratvXR2Mlnl0F00coz2RPAQ4wZfxHUyF-WTQqA&oe=6AAE9E5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw_ZJTW6FxMQ7kNvwGtLdfH&_nc_oc=AdpH7e0RvAtLrIvL2W8nVgLFNwqned8T0tHyYm5Sc5FDGnnaypT6puCJGn43qICU-u0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgrBKLdRVzXdHzgyW5DOwKsR3BfQp_-wJMxcQFS7A81Q&oe=6AAE825B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOvxKJo9e6oQ7kNvwGpDnrP&_nc_oc=AdqtRF68AUlDYsN4oO1TFZ6YyUKX5M0V2aaSV_D1xL0_G_Ts5niurGKoyX7y8BeK3BM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMi0UIesUEeknjuXpfzAK5GjqGurQkQFODhIOhFqzJbQ&oe=6AAE9E60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descript
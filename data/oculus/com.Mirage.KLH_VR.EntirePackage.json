64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYp9xaCRExYQ7kNvwG8Bz2Z&_nc_oc=Ado-gVJBHfB6Nww65wGRhzv4nU6AIu8Lb90jq4v0wyXkryGcsX7tn_yxzAdvUVAyXkI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuqkseVySwfuTVWbiu2hdFIVJqq_g8wDuNfMbXb1ZL0g&oe=6A8ACD9C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-ZlyIQhfuUQ7kNvwFuuPcf&_nc_oc=AdrEmPhzBFJ3RwJsSVtzp0AEOI_gW-WsGBmoxcPLbYKsXmHk2E5NFSbIBVKQz21R7sg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7X4dLhN1TzCskM0kT9AryHMGranLXl4r-u75QOkSK4A&oe=6A8AE9DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gySM1MQkg7MQ7kNvwHrKSP8&_nc_oc=Adrm3H9arq_z71j8_Mro_7UMMYQC32gRjBaeNDJfZ3Ohw3oZN_MO944tn1qbSM1spAk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBzr4ju7Wh1vor_409aTxXY9zUmhxrYPkboBnh-QpMlw&oe=6A8ACDA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
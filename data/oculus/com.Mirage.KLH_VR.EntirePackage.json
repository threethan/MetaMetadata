64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QH0x3Oi_0YQ7kNvwHovhxN&_nc_oc=AdosWSQ3kS0L_yM7SMJrlzJrramVT301CMxZJGtHkXis7UmQtHAMRinipeGx6ye0TCQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6hcRlWp04txgDTVaxov04-gg8Bf8k3DvDV-drsrIcgw&oe=6A71F95C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhfYBpYyfLwQ7kNvwGlrePG&_nc_oc=AdqVUk6ZaqckWe_1PJVdTGq99k_BcmZI236kPe6H3fGYDZEaW5338ZDqMCgevQIzHsc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr9GFwZ8MBcZCdeM90ve1sSfAQwgtAf3hVVykOK560Pw&oe=6A71DD5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO-18OJCI-wQ7kNvwFsCb2W&_nc_oc=AdoLjGyFZpbNbuqiEejgAUzte_83BXAWQCYofJEpnmdLFvhtkLmnbdnwszvQ5gh3fDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbaZOFAgG206Z7F_L5IO7FTM02RBf9XHphyIkFHmx0Fg&oe=6A71F960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
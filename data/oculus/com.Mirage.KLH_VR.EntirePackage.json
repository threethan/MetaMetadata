64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBm-wTCPq8UQ7kNvwGlCopv&_nc_oc=AdohTBljWUAlnrUR20n7m63p8dTA7Hqe6m1tKh5gf2wnN3LIbJNuM_i9SEftOBCzS60&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfe1lc9mdsD6lxvOH8IMzxe9xisE0Sw6cTB2cX3URQwg&oe=6A971B9C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1jzXA1vbMAQ7kNvwFmMH-R&_nc_oc=AdqHwE3JONViYWGri0ZJKYOuMOafde3fwDv2ZWQ8qmSvBBETqmkMw_SydCNmILHLAyE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMQeZTSYAyRfbdHZLzIWWM4GamlKoAZuoI9g9dO95L9g&oe=6A9737DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl1w4dPPwXUQ7kNvwFg3Cey&_nc_oc=AdpkYdgKwdLzVpHkLpM1AqV8cvhpl247RbZ0uOqn9qe3XgvCE-y9Zt0lV0agFAPnR5g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKhRC2OhoGrEJ6Y7vYW32ODPovOY-0p69WuOlvvb52aA&oe=6A971BA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
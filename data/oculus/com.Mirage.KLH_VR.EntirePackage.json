64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zdHtsADq5wQ7kNvwEGJqDY&_nc_oc=Adpq4vGHIKQiRLPL8igvdGhNtvYhw6vP6GCwlOjdJOJ2Dh3Jdr-Nog6w9SY5PVUqoME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXzhhFeafD5VLDWLvbkUzBx49iWrLwdz-qwAu29X8A2g&oe=6A54F85C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv4-2xizuhAQ7kNvwGvJoQh&_nc_oc=Adq2q7cwoRA4OJ-04oDCEw-zHQpywMJ4GPsJmy7zTpWrHSTHCObCBF6PeHlkUtXdsV4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0ZVPKOcU_IZ3y02WGfWAbFLyibuVQsIO3CR3JYdNA9A&oe=6A54DC5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfsszkGQpfIQ7kNvwEnKmUr&_nc_oc=AdpUM15AtUPOkqS-DmXAPeMWOTembMrRb1pgZERNy83_QeLG7r9H2Ah2TTwjTDH7tjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzxUsX0Lijh4no2sTgsmwudKq7fAG64AaAFXIMUfxZ9Q&oe=6A54F860"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
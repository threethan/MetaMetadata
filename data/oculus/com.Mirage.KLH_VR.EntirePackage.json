64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40usklNY4RcQ7kNvwGU6qk6&_nc_oc=Adpg3ydn7cNp483nxJ1rF_ij6QCnb9BtTQ2eKKENzGgZKYw0ObfU05lnSty2M-TsehM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L5isBI6m9hz45D1DIpfGKV1Rjz9VcjEGLPnsXzPK20Q&oe=6A32B15C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62040CnH1YEQ7kNvwGTF2WC&_nc_oc=AdpcBCjHOCPI7rT4bdMopeXTRJT9UrzlYcTj0MZfiWn1ByV8nI5opB4jAc93fckwdGU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xY8e4ag8JdHEK0GyAEwWdSm54qxiwKsVX4ydC02_5Hg&oe=6A32955B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFbs2OqFOxgQ7kNvwF-RPE_&_nc_oc=AdpphMvAXNTvmyg6cdRNcox2ElIWjXpUAKXHS7-fVIXps64F0qqf41quweUBxTdD7h8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81u_CJIT2y95tRqwym5_dDbjMW3050tnjkzgZxQqhkgQ&oe=6A32B160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
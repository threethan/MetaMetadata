64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3k_uYapRzQQ7kNvwFgf1lK&_nc_oc=AdrAF8IvFAQTHn3CV1ve0fU7_SUWMJ_7KXL4b3BzshtI_c1ySvEREf2EU172SeoczDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iik1OUcEOwgRr1mFNYmxrpJlAGnMgi54JS7pHrnVfug&oe=69F8AF5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOL9y0N2lEoQ7kNvwHlajGR&_nc_oc=Adra1ROwSviMmcLr2qOekoKAVcHiFKLwAyxIK_qp4ovNMmfzCQ08O0ZYc8j0aaWULeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BJpmP0KO5IL2l5N9M6OHZ0gQFeDuBw7JPq2Z0o7QZEg&oe=69F8935B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqoavE2gfAcQ7kNvwECN4Kl&_nc_oc=AdrCljCqX4gTXzJNOt47zIdbcHwCehVBcJuogrL40s-JJzRkRKkmHJl7lYphc_ULwXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vI9og_D_HP1pyhDEdW7JvegPzOU0YjYEzLP1glj-i5Q&oe=69F8AF60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
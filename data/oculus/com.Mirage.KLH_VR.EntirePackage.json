64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iDeSu06et4Q7kNvwFe0QQ1&_nc_oc=AdryWbn4u2r5CF-gaXkF8BYsrd33BznKU2JOWmKgXW9Cn8Qq5N8CMO1niQWTHF1xRg4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XwDEMSr8B7IXjEQ3sCufkuvk2gyfRn-mf3j2-wFzLyw&oe=6A26D3DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0yQG1F8tVAQ7kNvwH8oi37&_nc_oc=AdpFp5NXeKflB_jCo67Kv5qoqQD5Qydhq1ohxnpcp5Df0_tFbEJJZyik0Dq5-HneWg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GsWxyXAVqaDxqkhqXgT2lRjDF8I7XSz4soNUv-nM9BA&oe=6A26B7DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N79BtHDpoxgQ7kNvwHwr_qo&_nc_oc=AdrK32gNtXNVTpLQUEwltqBk554XnxEmHyG3lGIiGFjigfXm6--VzknI_dSQEqPou40&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VS0YPgNNvNtuLx-o6t79YI78hGHgXv7KshtZPovWz8g&oe=6A26D3E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
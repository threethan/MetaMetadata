64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RMkz0n8tIQQ7kNvwF7njCD&_nc_oc=AdpA7sPn3vq2hzYvn5TMy80poELYkmbdv5yrJj2Sf-qPobX4ft8625Cax_JHxlIh_1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd4BC9-6iM3N4a5IlM8sX4Fuf6a241-QJwuJMuggDLXw&oe=6A5E32DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz_jw-Xhv48Q7kNvwFL5oJZ&_nc_oc=AdqsVQuIJwI5ecP-Y1nqAQdBynbbTABnA22qzrxkIt95oZ1Fcq55DPVB0mGpa-7ax74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa-WNTH2WxjpeNXVZYyp5D5UCw3-1kVdQ2mUNwkmyZ-g&oe=6A5E16DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55r35YHGe94Q7kNvwHkk4Lm&_nc_oc=Adr1L2sgwYHjka18wq4h6P9C_KvbfD0fXrWfzemjN6d1h-gjAazboadoxEN5siLz3io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2wa7Wr6U0FVM6IN04ETSkfy8jx3kbAYUEb9AEUNU75w&oe=6A5E32E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9cuLTG4XJwQ7kNvwGlrF4-&_nc_oc=Adq_lSfn85R5YidbpdMxsC3Fc7XNnyuHz6xmN_Tsmc1bdZFTwoeRxxNrrpWDIrlUGtE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af927g0u6QhPfDZ6318zic66Uriq-Z_VD795SJU30F356w&oe=6A43D4DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCTFWZUKlEoQ7kNvwERRo3B&_nc_oc=AdpPjkqZGW4FkKyuPmO_bHpDt6SZAKhuTgdivCQy3lDlyPBeauCNkZ1YOIhKOblL5pg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oy21fejTvhRY4jOOo8Lmu1ybYM-NFGWns_etROdMyXg&oe=6A43B8DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vq4Bu9tZKxkQ7kNvwEBuImD&_nc_oc=Adrn0fq0FwXyFmsJgwgWTpuJmb8oO2QhcL3ddrBK1VJXO50kelLJjsnFYzbB-Zioees&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83s2Veb9CiVEb80owHk4aAQ4p9oFdOltFlfdk4BcEIlw&oe=6A43D4E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
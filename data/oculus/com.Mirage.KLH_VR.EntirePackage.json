64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEuWjMzpaPkQ7kNvwGJBDfx&_nc_oc=AdrHPsaqyFJcOT6oWNe1IfIeCrIrSVbCafhrlAuihqX7rtsIhLL1aRQRYZZgiPPkt3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpv14woARLOFDznGilZXu5NNEPn-xsXYoJ3MjIl7cOlw&oe=6A70A7DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcDpGR2eczwQ7kNvwEAHznb&_nc_oc=AdoyV_XIrjOmktisRUdPVhsZ8mVfUtVMUof7RjP7YaYqPzQu96oTMgMyjFoLXWMJT2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDw1I-N-olfrwWtZoqZSHzZKimRnOBlWjZWYrWbR9lnA&oe=6A708BDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO-18OJCI-wQ7kNvwEajXJn&_nc_oc=Adp_LaGmox-BcY2SLbtRTVYlpWSIeSzfFP0tSSJCIhal3__cHcg7Ym2pUOt4v3-xYf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRP18reWzm6EcnAf5OI0xATV3ahEKgSNa9FeUuu5SNVw&oe=6A70A7E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
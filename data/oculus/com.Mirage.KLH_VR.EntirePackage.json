64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsPCx7PwYSYQ7kNvwFYA50X&_nc_oc=AdrYvrzoNZUqj-07NcA9SmjVCYZR1NL9r8uDxvxrwo4VU36Gl3o8Slnq7EAJEv6nLjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_4Fav_-Yc3A6q-LQ99s6sUNb6iqQwmMba7XbKGEDDLA&oe=6AB535DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAmQLqs35-8Q7kNvwFr_olI&_nc_oc=AdrLHnHXU-KlIWbbx_UdZAdvsKRjP_NHrbrnmBCS9i8D5OLxsxA_ymtFE8vyonY-zpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqlSGKxKygBfUCaEa-Eyp8CDvbIaYuCVsQk2NrCLuucg&oe=6AB519DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_5Wig8Ik0gQ7kNvwFNyd39&_nc_oc=AdreLOgGAWWiizk6S9aMH5NK6BQnS7b2958AfaOUU6HBBL1X1LBztN6NgNDcKL1btXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVnfECI5GBPfQybscbXe0aeEKvIp2bNSmtfDxmA2LV-A&oe=6AB535E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40usklNY4RcQ7kNvwHrEWgG&_nc_oc=AdoniUqe7vmzLvX2JDo_bxLhtW5bOyxZ3YyNwPXj65Tl4WaaFhrkBAmoGKQpZ4YeqsM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jDQSpL7g5lYzNwMWILHe3cYEGm_nSqlREGvr4j0He2w&oe=6A3402DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62040CnH1YEQ7kNvwG63FjE&_nc_oc=AdpzwhUgJls_qbhsW3NrE52rHeOOJOWxbhG71XKgA0czk8NaNzxzI95e5KH6k-JqhHA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MCDpo7eSrVbYpDkta_LHE_gNYjNtYudPSypzsKecNPQ&oe=6A341F1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFbs2OqFOxgQ7kNvwFL_M31&_nc_oc=AdrdyruS9u2eFCjXOjoOptaMEsLSw9i3ErNCJQsRNxHw8BwpAugE0pUqyKV3_mbwnIU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r77jnpb6cG2kWzG0T8PYn4j06nEDGxYaeNSgTQD99Sg&oe=6A3402E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
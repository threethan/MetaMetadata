64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbnaQy_qkg4Q7kNvwF8bVQ-&_nc_oc=AdoGEDuM6CxscYandc8ci-EU0nh4XTLjK9byhaYbV255EJZad7XlW-j5s491sqi7rDA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhDjoxAYcrPudgzEX0qVIpXl4Aqxdedngu4_O82Qid9w&oe=6A94081C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBf9O3xNpVIQ7kNvwE6HsWu&_nc_oc=AdrBK0H0sBW9XRVVIVThtqqpw4_o32lLE3e_qjjgUeTu4d_X1SrAhiVNxzBOdv3WFVk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDFxMiHxBQFUYCcQxvJQRjfiRd44Bd4V_vvaKpqk5sng&oe=6A94245B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl1w4dPPwXUQ7kNvwHq_Nbt&_nc_oc=AdpX7TXy3PzPba-Uzr586vNsOaug2I4yy2sITWW0pWR3mHFDWASQco_xAvXmRg_mMy4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsX-eH0p87gbAriGDMRtndCapPggBREW95CxnFu6X__Q&oe=6A940820"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
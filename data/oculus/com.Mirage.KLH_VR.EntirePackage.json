64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTXuLLcs6P4Q7kNvwEYRJT9&_nc_oc=AdpFxXZM4EpQr2ysqMc-jdcKN_HmWGpaVD8CCqVnvBQI4MGk2Sba4J_kz168Ir_NsCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlHZ8dykWDQksIiX9xYyzpvx7DA28eDxv1aTvZvVQ0dQ&oe=6ABFC1DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwa9q3ff4GcQ7kNvwEmZru6&_nc_oc=Adr4NYMbckyk3rTemVLIhuyBP82RDQC1FHfKGQRP7IkUA6r_yBzSf6tQ1lvHdOH3suM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgorcD7FUWHcYrnCiRo7SU4VEnHQ6Mfe1eezTqNZNm4Q&oe=6ABFDE1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_RYlN0KioMQ7kNvwHvsVhN&_nc_oc=Adr9PAzoILH2JvXbT1FzeGD_mdZHwd_UENHY4iEl-Y5qFqzpVyAkIq70wjB5-RdpkGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHbOV1NBo4MVZ000QzdLhmtS7Ptf2uk9tdTDKZTTKR0w&oe=6ABFC1E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S0gv9IbaPcQ7kNvwFXlqzl&_nc_oc=Adr_KK4UwblpcmV1lQvnEnGNkqfZt1t8G7nlRStKCPantNcoFkAgq0VzyDDLKarWw3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq6SaJXkFJyxvr0riY13Lj1pkVKXauULOWW8lV6lESyw&oe=6AAAA9DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWRcUYeAIxIQ7kNvwEi8kAE&_nc_oc=AdpdsKohKVYSivFlO-b62Mi1ZtbczTSzI37XQgs1KlCQltquKoeDaYnpkozH3UiUum8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6Y8LgnvAop1PvIlNHfngrdLuPbEUM1O_hyWas9MtGEA&oe=6AAA8DDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4aRw5fG_QgQ7kNvwGaQ-7u&_nc_oc=Adq3RV3sswlT98vFmUyqxcNFwToRJEsTdKf2Q4g_JraGP5tMaNmpwC9tfMR5sUX_e80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv4sm_7TQG6YW5KTNLzBpuxAqs7CSPXvccjjdVWJQmeQ&oe=6AAAA9E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
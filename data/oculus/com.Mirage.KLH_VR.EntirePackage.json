64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCc-MQyrjKgQ7kNvwE3fND-&_nc_oc=Ados8zpvp4ecBteqXF3oJ1k9GRbDVtjk4LZUSK5BcZBhVeuGQnVdDIuVix5YugRSgfM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHEVdLdVWScsgd8Q25k-_VYCS02aIQ22u8blUV0kdKdg&oe=6AA563DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtmJIvLHkQkQ7kNvwEZS3OE&_nc_oc=Adq71_S-t3FlUyZwZLENhWEolBuJ0ocRJ73qdd8zjLEtzesEu3IYqGkLEUKMWwroS2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBddwymKn9DIfozMnxbryKa47RbLyQxWcCV_elYn5yig&oe=6AA547DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWGZ3wcPwoAQ7kNvwGgcEhh&_nc_oc=AdqjJ0Eo20Os1_-Uv0C8iUO9vmR0WxmjEB94NmiV3-9OsXEqszmEDq3xVMKoFF9SVoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-zrIhG-n2teRuWT_t0CBpatstDwwf6w404VY-a-cIEQ&oe=6AA563E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
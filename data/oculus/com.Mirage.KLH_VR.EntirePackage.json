64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NITJ_VHYJ-cQ7kNvwEgoC9a&_nc_oc=AdrpoKPclPQx3rMoj9eJtAWkfG2eyeGVPvlcXMKoSfAb5mzyExomaPXQEv_496A8KGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUsQvcTJOdYmKH-MNqTn3IhVapfHSuW0Wc9eI2LWaOfg&oe=6A7B33DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYy-NLQiZtoQ7kNvwEZlwnG&_nc_oc=Adp3wUK1C4BlbVFXo63OrHRL1GDfdKngdBa_zzHZ1hUusOVIUKCzRFrKONen6aHwqfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF41boby6t0h8ddygHxocA6Exo0hxYQxSDTLQchm5s9eA&oe=6A7B17DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG0yxp61jsUQ7kNvwE7w2Jn&_nc_oc=AdpkAlg50RnSQy81DiKNbRG3Ue2Ir9dmacT5w_DXl7orXLak82p1g9zYrDG9SnqutxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE87fPQapL6tIWQkdx-C8ELTDM_2oLszTSs5DqzfcYurw&oe=6A7B33E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
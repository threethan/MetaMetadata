64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_5m5XxqzWwQ7kNvwGe-Z6Z&_nc_oc=AdqlgMrFHTM9VgDUALIkpSonUUB_urzXK4y_Adyf_VoyyDjmztF5N5A9AqSBIvzVy8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm-AlnUZ9NDKitP7lycxUvmViyTBInyc6dPc_PGZ2qXQ&oe=6ADF65DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSHVSPP6vIQQ7kNvwGxkitK&_nc_oc=AdrPsBlp3lFHeeJjAPHKsnKYPF0tPLPWyrle-KoYWlV6ak8BQvWXjDelgU11ITjactg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMle9C3cD_SfAM8egzjFp_BDcxq-3eD0Y9Ox3Pm2IIQ9w&oe=6ADF49DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2PCpYVL2iwQ7kNvwFYFbb_&_nc_oc=Ado65cJttiWUkFVg0HjlGyfkdWgILHJ3qNhf014AHPvMyips4Mjh0ev_HWFMhN6KKME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgfC3B92no7-y_Iuf1FWgRXMM36B8x6JYvdena7Q50Aw&oe=6ADF65E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn19xIZDnMwQ7kNvwFzN5yc&_nc_oc=Adrbvz_Bdxd-bGGYFfia_nlQzc6g4bb9Z6D8Rb_EGDJoZnCZZch9yb-jZn2RYmK_EhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORs3hMX3lapIIA-iRUIov_X3YbcxGUS75vHeh6HsVxbg&oe=6ACA4DDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuLg654bIpcQ7kNvwF9otBM&_nc_oc=AdrdVZOGms54CWamOQflmpbX873z5e9xF_lf9RMvLNmA7fDriLQIWwyL8S37PgVYWNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU9k13apEsPOxHeLRT5Z0ot68i_fiLYpq4GwNBNukWiQ&oe=6ACA6A1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3dBXIAhIjUQ7kNvwFhxCDq&_nc_oc=Adqz0PyGi7dekgVByXPvfsVJhhaF-EXuDbNjk7D435bOMoXS7u4Cxq-lWBatnpWOGLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUHiWt2gVWRSF95B5PrsDz8DL1SlcHClqj5GkEeNBreQ&oe=6ACA4DE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
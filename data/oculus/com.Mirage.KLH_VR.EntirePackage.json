64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyDHF2H-O5gQ7kNvwG_nku6&_nc_oc=AdoFPyRep8tRVSHBq8JNoXszNnLKoebn3qHjgzQzTZxHbXyVLMvJRu6vAejcaWj2rHc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GfkoQUDL2rcycteHU26MPU88aKkqG2pg9VDI5TgSsUw&oe=6A203C5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T18RZgHz_hcQ7kNvwH3UU_W&_nc_oc=Adpbgtj2ddvETfm2U8uqiZ9J6tTaQqRKM8hea7MPGbh_EJMweRBBcreRF1tqLtFEqr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HHGMoTc7R_GmegcXW-vxMCx2icuiikD-IkBQ3gogC7w&oe=6A20205B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGE1jjPNlvgQ7kNvwEQOPPW&_nc_oc=AdqGu4JV4Mr76Se6azmC3VB1ROZDKi460UKCD03ECxLLZ1BZyBDgAcnZaw6k3Ec_9aY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DUM876VpVLzJL8FM4GRignHpKhFMe0AVJuHZhyA6JXA&oe=6A203C60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
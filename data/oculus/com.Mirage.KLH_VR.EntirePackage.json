64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEuWjMzpaPkQ7kNvwHRMB2h&_nc_oc=Adr2JwYsiwhgdA78b9YYuWIwebMuKAD_lRAl7KKMXe_WIRc9HQzVzhTmwEX9SGay5A0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHQDt9ta7P5aervC1CIAVPUseGk3YkvVakWmsoFItzcg&oe=6A6E04DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcDpGR2eczwQ7kNvwEbhq8-&_nc_oc=Adq1kEvLuuyn1TtTma96TTvRV5hUC3g641BeweoXd2TKdIgMMVt7bVLcVRrj2364jVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv8xSej3DFUZNVlypMOZ0ZSO5jK7Klcva2nGqX1eTB9w&oe=6A6DE8DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h29f7eX3veIQ7kNvwHB2NHS&_nc_oc=AdqJsOtX5VGuiDeC4C_5mgwX3ZlO-g_Otw3ekj3fZEfXkt25iZFuyJL7-y5ojeWviU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDglIx9036LRQFwv8pydr2co0DKwuYW-AI2MpeL1PqBkQ&oe=6A6E04E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
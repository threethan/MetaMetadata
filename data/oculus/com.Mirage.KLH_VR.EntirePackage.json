64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0NBZdp_9TsQ7kNvwElQg9o&_nc_oc=Adortki6wkxyeUkSylqEGlHYCA6ffqsWV9ihZDu_MZnbuDByzoyb5DMUZjlchwVUGmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtelvQroh7I7vLfCk1uk6P9iFImaA5-CXJy6NM55cS2Q&oe=6A99865C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL6zKAkxwpsQ7kNvwHNm9L_&_nc_oc=AdoBOAl4SZw-oBplNwRFVV40SgdfMSHRFfyCG2HitDpnfI_3NrLObjfPIHP3CWY3SUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCxNzJTyOuICB6SpjrTqTtdHt1lafD2BPPEQWdEdLGAg&oe=6A99A29B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geDflUu-EGMQ7kNvwEkqZ9e&_nc_oc=Adp2guDTzF4zDc0peMKw3wn6P5yfnmHIQ4O-lmCW_bDAz8Y1W-8t6mXQzYxa807z9ec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKXYYP36YFU4x7M2rCnrV1oAJZIaMODtiORfSVcwus5Q&oe=6A998660"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
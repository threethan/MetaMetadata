64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSYgN-mh9S8Q7kNvwE2X_fx&_nc_oc=Adq0pgt5us6LDFhWq2WEe3J_obhiTFtNdOOCBnpkBdo5CgKOlJIaRKJ9kHPyS5PKrqk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtC7DSxHk64kCGmtRDfr0oFJKisS0kidlAtSRPqXLTXA&oe=6A5649DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9srj7FqcdswQ7kNvwHFCSP6&_nc_oc=Ado8SQd_aHZhD8PdmTkcbwCHuzYCGaP1_3LqkY90SKuypFNzUnBhRSYA20AjzOsSdNQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfyp9FogkEGTikgUjX4ySYuFMEnYKM2GRje4p1yimuNA&oe=6A562DDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfsszkGQpfIQ7kNvwHoF60y&_nc_oc=AdrgQ8tyEtUp1hrZUx38_SYlH9kQQpClQr2aVgQ_65HeXYmwlQfhfn6hg5nheF-rzI0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATTpZdNsE-SUDT5cuqNFGpOSPnWsQUHwZmDbyFSeHjBw&oe=6A5649E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
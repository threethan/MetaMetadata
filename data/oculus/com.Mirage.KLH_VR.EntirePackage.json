64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5_P-EoLvsAQ7kNvwE7A0Tw&_nc_oc=AdoRuh3c_F7q-8B_UQWMF_SeHJu2Chb6NItoZsja9oz-aK_IqccrtLliEvD8i7frt7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytgfY0X9y4OsaanErKnHdy10Wd77TwEN0BiIZek98hSA&oe=69CE7F5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHCul-eIKaYQ7kNvwFgK9f2&_nc_oc=Adpz6GEPO8_vPRaoOZQH8_7EuY7nxpwj-j7zLEnRMVwyc8Lfmy8atbDNuM6kvf3NpDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFoy7eZ1B_I8ute46Pcs6FwsQo4jYhbZ_ia1AB43T3IA&oe=69CE635B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWHPip3x664Q7kNvwE2oUqu&_nc_oc=AdrjE7_PX-LmQz7blP9hifm-rUqjPL-7OGxS2sFp550L5kAQ_FgX-_bqwGuoUf6eAN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySlJP2iBERDRgTkfakBjEXDvFuTptBRu_y3QLKdIFEug&oe=69CE7F60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHlmaY_hJFoQ7kNvwGUIsWK&_nc_oc=AdrEolQ19_rlONDF7WDVeuCEeCb-Mm9RaRqV7SdthVbiTiBFQvceY9O-w94qpm0N9Zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrln4N6Ks9rhS5Qv-H_YMRekZ_JR29DGBXXGaloUTRYQ&oe=6AF8AA9C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zdlI-q1IUgQ7kNvwGZy1X6&_nc_oc=Adq-IU04yBLyJoKMwMLVD0eDMOs8kyupfaA4zZ9u84HrkldOiOrNB-34Z-tlUaSObVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFQ5qAeYS8lWdx9ZEWQfCgyczbfL26FPE_G8FpTh41aA&oe=6AF88E9B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB6pxf5_lr8Q7kNvwHIITXf&_nc_oc=AdojRevg1HPLfl7ogWIIWIGQ_PH-nuBq5r2gohOZEnkvkFYPOtBe_BPZnoxsOEk6qV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk1xsOTOzPvRs7iqlVE4aZvX6tJxyladlz_crZUJdQkA&oe=6AF8AAA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5_P-EoLvsAQ7kNvwG8nsHS&_nc_oc=AdqOUxGNwiezuJdrtULYai9Ve_ypzmhPu79xa21s9toptJe40JO7y62Atisr1qaV4W4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxtfo4NE11x5HkhwWPKWqXe9AfK2RIYL_nHM-Ert7oFSA&oe=69CD2DDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHCul-eIKaYQ7kNvwED3m2-&_nc_oc=AdrnXLEPxAFtK_hSt4mGdiuDFpEPqfaId_8dMMsi6jHx_68Xlm2gI6CpDaL0UgtJrGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAJpJskAPcE8L9Zw1iDma5-sCybQ3uqzJRFfLKbmv59g&oe=69CD11DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LmHHY2zhNIQ7kNvwGC1_Np&_nc_oc=AdqtrVEKKQCQfDODcoyVxkwv1eEib_cffbyRH76IJKU2fIM4IfTobENJ6cDCRw9KxOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx--2JvNXms-DMPxBnXSjplhk2nfrtU-IUzs7xl_KtIag&oe=69CD2DE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
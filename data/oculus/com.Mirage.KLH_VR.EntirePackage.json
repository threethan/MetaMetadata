64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spGFs6BR0-MQ7kNvwHH1Gz_&_nc_oc=AdqXbXMw8CfcjyvpwqU5FkFMbwlVJKnT46C94LSYNyrsV2S-4lAdD9udgav1ooRcMcs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlMt37h_jee8WiBeUNb23_0aebJIiGt3xx_9xl3JeA1Q&oe=6A4A6C5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJZRrF9I2uIQ7kNvwF_q2vY&_nc_oc=AdpigfTK-_esUu99Di3rqPUdU-Y-jL97oqVjtItphvbD-3E0CDZYkan6_21Cp4uS95I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEKxKXVRG5XEAhNglIIgWULjaJi0KPTOqcEpRbowpLcQ&oe=6A4A505B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eu6ElEgKEUQ7kNvwHMDrW-&_nc_oc=AdopDIwehMdiurjDOqGJqwY2WVbpFBGwGpIJfvPJqQ8h-ViwIuDwS362N6t3mA0TBGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb2QxzaaCSvBhfPkE6gujsrRSPgCFFUdsv2K-lkegiDw&oe=6A4A6C60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
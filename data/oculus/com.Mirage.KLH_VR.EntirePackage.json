64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLhopMIkqAMQ7kNvwG02rHg&_nc_oc=Adpz_0fQN3OfmB4mO3yOvxgvuqDbfF5oM40hIUehls6_rIzNZ0yB3XI7jt-AeIjW8-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-SCu_L91n8ynHQCsuINVMKdjnDl3MGo_3p4dcKXgLig&oe=6A5CE15C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q8RT2e2dY8Q7kNvwEJBm7O&_nc_oc=AdpDseuj3UgZCurytUTig9WjLIJ15qBnP9l-Pb50m8rQSlmynKVGcuNFbBWyc1zESdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt0sVeKRPnzeozSUx9H0NA77OsMQDcWPTwRh8IrCC_-w&oe=6A5CC55B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55r35YHGe94Q7kNvwEbNIw9&_nc_oc=Adq6aHxYZvL8XzS-0iKAlll14-Qng0aHhUEkgd2lpkLkfsQElbnKCNSWBiqF_0hXcmM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChl6inNZqXCfFuYK_KGOEJzaijJsQ8rj_WNnUm5Cd4Lg&oe=6A5CE160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
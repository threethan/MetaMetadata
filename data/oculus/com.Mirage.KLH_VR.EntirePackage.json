64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eygf1GO4Ix0Q7kNvwHs0ZIv&_nc_oc=AdptnHpOhQZj4_Hu2SpsDqc_afcQ-4GgSoAPAj2v3soWn-EwrO3POb8kwtiRYkqVNlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69i43Z3vit3ZMMQYQyUiY_zCOFkvR4pJFAMO71wFmrtw&oe=6A15B05C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MUsE5RqywIQ7kNvwESbEO3&_nc_oc=AdpwGzOkJY6SKdLvjXRh-v1gptbIu4XgGTHxAWRyVeMDesAF5cdsuBQHO1Gh2kU09JY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IGNtnKHCGLB_aKvwE74xhx-8_BoAteA3s3c3Rq77skw&oe=6A15945B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YbaB1L-ZxAQ7kNvwGpf0ZQ&_nc_oc=AdoPXDKouBP__LKgbr7su9mvgGHUGl_jsHoJ1OYvv5ZlgXJjI8P1vB1FYby5PikqSV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rhg6m9L1Hh4UeKsk7RPknE3TiXwx2ZtxU-_YVEK9iCQ&oe=6A15B060"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnT2AHDy3swQ7kNvwHA6tYk&_nc_oc=AdoSTzLrmzDNGKp7q-Z_jd05Ua62cN_qm0GlMlwF84J5Q_TIPr4wXq0UPmk_4mICu2c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMLgvV-jgt-XWw5DPIGduaVCWMM8uI-2ivNhWDUbMxAQ&oe=6A661BDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSjo8xFAn7cQ7kNvwEBg95P&_nc_oc=Adp7RttKoQej9ffEN_WYZ_4mj91C2jO1zXUbNsUnqjZrgjrgJhyBtFra5GM9G2zxGqM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9SIR9uxU3ULnht-XpYgksIqVXBmsbeX6cGolA3oy0AQ&oe=6A65FFDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybdlF_moYu8Q7kNvwEv2Xie&_nc_oc=AdoJkXaFqueOOpJIL9wxzhkEOTRtSvAUnL_8ckn1uVi5A8gMNxTqNFyheh1FrKsBB6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATS_UQLLsYxdFJAiqLwibMR_E544ZZ-S-qbsZq2BNBag&oe=6A661BE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
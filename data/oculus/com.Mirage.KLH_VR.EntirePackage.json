64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2iAWdK6hgMQ7kNvwGylSLa&_nc_oc=AdqxR469WV-p8sXP6IacMbjJb77Q49E0Uxc1vTr_Z-6SQqLxpYabc_XJX3J5_qcZXBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4weBLKWYzxVM-1j7SJIVNPL2-06JsKMHpm09pEgkuqgA&oe=6A01E9DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hqJ5jX8xr8Q7kNvwEKol3b&_nc_oc=Adr-6jhBK93Mqp8LWqFc8bFyWtJ0aY2FhbJBcRg39_upNaGNVoBdsAGS0uQhPX2jvOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_iFEwD9QCsSqrZkfgpRLgiIU63S_KUYi3l0FfW54biw&oe=6A01CDDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuLz6ml119YQ7kNvwETC594&_nc_oc=Adp0TvQ5k1XaMtlkNvlSywwRIoqwHrOtcgwKhypNqoXA9z8Xs95nsrqJJj-41XHoWGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OCRQRl4OOLTHDdrRrhHadmA36azDrbO9lrG2f2IpAZQ&oe=6A01E9E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
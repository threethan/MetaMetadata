64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op_O_REtjY4Q7kNvwH0JlOu&_nc_oc=AdrG20yn8DF7KJQoqvLfkFujLrB27OSpdiOFj4kuiZ6Wd_rh4r2FxreufalXtLYVipI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Aexm0ecnd0zJNvhHj3hYq6LLgPYz5UjeplCeQ1mNn7Q&oe=69F60C5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFCYvhBNonkQ7kNvwG4E9DO&_nc_oc=Adp_kEwrf6NNwA4A030SsdhyXXEVDd19SAeelG8I00Iz8dh_v1thhABcafQ3tP_ZdHg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1N132zf782flMtjulW_cYG_OMLPwIeA6UzW9AlFlRvbg&oe=69F5F05B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqoavE2gfAcQ7kNvwGOPNZo&_nc_oc=AdpwIOHttKi2I4-3nq84duPMps_o7Xt7vI6j5mhW5InAYhTzg1-G-yo9mp1oSVVTvDA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20VDdFbQHHyHx4P3EqDRP_fumfsMuNMMjfKg8TlvsCLA&oe=69F60C60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AYpyCwgstwQ7kNvwF9lGcP&_nc_oc=Adpybkq0k-EUJNclSlEU8BVN21NgKXFlJaKx4afxN5l2tWY1KkUvt7dPspkosKIGVC4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeIcjZKGS22YKr6Dn274ag0ZtP85zYY6eZVu0GuuZ_FQ&oe=69CFD0DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvebYbZOYKQQ7kNvwFXCKbH&_nc_oc=AdqbmlZN7nKAFwsiPP_uuRVn9Rxe5-kRdce_qW1CgS3hB2nNg0h2O7o4-lSn_heif88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZGs-XTWChYhbhd2H8cv36ImTQ0O1xwC2Z4RZrnO04dw&oe=69CFB4DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWHPip3x664Q7kNvwHDlEaL&_nc_oc=AdqTP3OiIoHXxB78VdpFpOjTSg1xNDEOC0sUgNK6dwZMNkUGNyEdnFKJ2eavIUuIJ9s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyr7J3N3hTHgTKWH--ksexA4T-IDUxQKdC0c7xGS6HG-g&oe=69CFD0E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
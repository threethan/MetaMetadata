64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsPCx7PwYSYQ7kNvwH-invF&_nc_oc=AdpFNmB4WEsjxkr6Z9fTeLRW7NDlalKt3KVHxBCjB89Fh5QMlWBOE-wO7vtfiOCkajQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILZRe_c8D8c5g0b3EH6OrXJxBAl7N2vwVJWkrVW-2Fqw&oe=6AB7D8DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqdOMunkbmUQ7kNvwHdOmND&_nc_oc=Adra_r5VtV4IM_ALoK_01C3vf9k-Xb5GbuKipxhAbJp9_vt5I-P6i_BJ_rBy4cmEBUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyc8TTC_U6g6bDcjWQ8JlaZnWYaLkhOxnZ0W0iHtCSgg&oe=6AB7BCDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHAOK0UtNGoQ7kNvwFx6iB-&_nc_oc=Ado7QSLx5UQEuRskJix58iJtV8vKZZJ_miRv98wWoBnw1kG26oZTfS5EZ_w9dpRpVAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTlDc3OuUaUgb7FT9F3MsF7YIOc4fMgIsStdKMLnNFqA&oe=6AB7D8E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
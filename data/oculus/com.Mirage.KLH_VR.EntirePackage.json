64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLhBU3S8m04Q7kNvwFLx-Dt&_nc_oc=AdrhZL_1r5-g8gBRDBv3X-7uglOIEXRDfm6CCkgcWrHOUQzGTjn_hCKsQ2fz393r0y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPuneKbhd28K6IC_Em9v7HV0wYhV8kID-MQ9s1syPXfw&oe=6AC264DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwa9q3ff4GcQ7kNvwEqO1Cp&_nc_oc=AdrmCCXq7_icNsnv0splgfptPVvjAvTV3wmUJDpxDQQ9db4kTCR464sQv1HtOvD-9Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_rPQBWt33o-x2x5QV8ZVugVVQJ1zfeHLGhphLyobV5A&oe=6AC2811B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_RYlN0KioMQ7kNvwF0N8O4&_nc_oc=AdqmhV5X9ZpC3iDU5ausy2NzBeqqc6lbUDIs_JNMtpTs6FC9_a2J6gOmKhHfgCu9Nx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq6kHBzL1TGs8gLdn1y29Z2vwJCTGqcPBgsLMXa8o55Q&oe=6AC264E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
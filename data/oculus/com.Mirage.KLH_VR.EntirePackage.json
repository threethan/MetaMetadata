64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RMkz0n8tIQQ7kNvwHsETdN&_nc_oc=AdrF_YUy3kEuhfqBj2oqBy5fWVVG5IxGd7o1zHsOofALKHWl9pWHSBS1LUayrQneknk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu0rL4xYM4AbQ9dJ5EWdaofRhLO5uw3V9q8-kMGI44Fg&oe=6A60D5DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz_jw-Xhv48Q7kNvwHP2pAT&_nc_oc=Adok6z3dMhPm65t1c1mNcmCHewYqHQt4mJXXHVXCJLDKt57kjJj9nLU-9Prl6I82s6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJStRci-VPg5v08J-EXlCt9a6OLBlstNqlV13DzEz8Ng&oe=6A60B9DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg7VSNVSDQAQ7kNvwHJc-PH&_nc_oc=Adry3dTKeRCvZo0gHtqDHelyu_lCWnMwfUtZBt1GBg3oUcGpUMUTTYOAJ-BEw6P9p30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ-_UKQMfypSHW5olRjkCWgSb3ZALWwWQUErPGamWKaQ&oe=6A60D5E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
2664_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDm9q_R69qYQ7kNvwFJRIpZ&_nc_oc=AdpkfT-aUwFCfjNEfcVTbdulJU4OfkDC2IuxWSL-Tsn8MuPeEIzobz556RcLEwxz1IQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLHXTqELdwG83ucdrVmnJ2SwT9TGvP3R_LuPSZOws0jQ&oe=6A7D9E9C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw33mA9rAJsQ7kNvwGNRWKP&_nc_oc=Adp7RkjavlU-u9l9xyh0bq7gWIqVIrtUwjzofzI8hColpVbFuGSvPcakclu7AWbd9PQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED-nPhkn9GpXOb-RUDfjAUl1wOes9tcypD_k9vMgIKpg&oe=6A7DBADB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7I9tq-na0cQ7kNvwH_BRUs&_nc_oc=Ado8pMVMYEJ1rc95Id9jg0IrV1bZfNyWLydqVrxZc6xepeynNDQ6LGuCmZnXexs0B6I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpHFDeNbVMNwI7tR8lZX_Wnq0QlQ8anSEuAoSVZIIN0w&oe=6A7D9EA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descript
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BKoZplEOpUQ7kNvwG6c24r&_nc_oc=Adq0O7G50lKumrgkq4AmMYvCwDEoz3rq7D8ItMLNw2SQX7biz0vwMY6LNouSOu-zXtg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PSLhMpVOg98Xqy_rM3Qu4wZwXs0YlhJPw6VA5EonAdQ&oe=6A3E8EDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoiNX22HqfgQ7kNvwHynmeu&_nc_oc=Adqa3ZqmrtVBY9PwmjvCj0NXEuH-oA-XfHNUNON0i_Sol-qsfwBXVzVChCRHk7FCK1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9seprC12BVBkO6FVBqlABE35JNA4r3SJiMHT1Q_2U2Rg&oe=6A3EAB1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPUbF1OCdj8Q7kNvwF7mE11&_nc_oc=AdptHQCNAl1Wb0kISo49WxLsGcZyMZZPAtqFPRJxqtClW8TWn8GjZw10KCXWRp_2PhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nuW9Vb0NUp-RGmcwjA-WQoWYKA-lZ6aKT1yyZ16gwKA&oe=6A3E8EE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
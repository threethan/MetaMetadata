64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVIm6KeDRbYQ7kNvwFQKHP_&_nc_oc=AdpJ0CqyvMRrd_IfLpG03pr2SyRhV3Os4okc8X-yhDip8df9ldry8mW-znG-2BmfP9k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4clE2u40vuQd4AYOBlZMKjDC1BVjKt-qYWKYRuOZQ1iA&oe=6A0C75DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0AO2qe59K8Q7kNvwFOZ8ED&_nc_oc=AdqKrCRkYA-8D2vi-PQVPZhmbcQiQRF2cokk6ZA2CKJTkQiD5alIvryPwFvr-6FxYIs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gx1KauewFZsLMTT7cNwtzY-YrAKf-wY2GdQkRLPidCg&oe=6A0C59DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HFkF8b6zlgQ7kNvwGREzER&_nc_oc=Adrc2QDKPnkF93nBV64Yh9ffnUVU4vtB3RsG8_0zTukWFslLCELLAGBzhSeInOP8jXw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hcApk5VmQYyPyV-BikNX9mK-V1h4YDRSiU5KXHpH9nQ&oe=6A0C75E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
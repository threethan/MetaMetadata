64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dHo9StRtP8Q7kNvwFCb6Y7&_nc_oc=AdoB-lkj3v9wLx_GKs2Mj3D6JtdmVOU6gddlU4gRcH3ZUwGha5u8MPN2S2uuzm3tf1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WU-oBmwniTMZKeSfCJA5MQNsVSYrgRihPsHcsdH3T4Q&oe=6A47C95C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIOPloNxx0IQ7kNvwFCY1rp&_nc_oc=AdokoSsIwgLB7tgpqV1OZ5EWS5VQcDsYByCyPyYHtFj38qsXA4DHr9qAKVw7HfF2Ngc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9annyMR1KJS4Im-kcp5WNMmiC1CGPk51TDmUTcuRgctg&oe=6A47AD5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMXdEyPmg6AQ7kNvwEnX3ko&_nc_oc=AdquN7BsoJJGsWCSFvk7se_Sk9RzkZbbJ25-AL4-Hu14a28B7ZmqYaRIaQqWtSdkfnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qB9iQTCBZS9xQDjiihkcbTEBByJYUay7lQFZQCFj9DA&oe=6A47C960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
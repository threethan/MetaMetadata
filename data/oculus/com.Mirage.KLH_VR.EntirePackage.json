64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AYpyCwgstwQ7kNvwExA_ZB&_nc_oc=AdrwnnlqQVtvuOApgCGIpn7dfYvb0sLX6yFyXeAClfBss2hOHMNeF2pzKLl4W9vQECk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33CzzaPnoAHM7WGRFZdjObKALzk-hql--dUhYJxol8jQ&oe=69D273DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvebYbZOYKQQ7kNvwEeDMk9&_nc_oc=Adr80c4g5iTj-rCApkd8sPYtPAMeRw7QYE0UZfCQb5DjBgTCjBeiINlzEyv8QU_8tog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07JKBKOoCwVdPh-zpXzfARtOx2esaN93vGK2CMb7fhGg&oe=69D257DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUuVaIMdPyoQ7kNvwFRO2WJ&_nc_oc=Adpf7bkcSblXYVuZPBfZMzHst2aRYMYadO828zKS_gkxvPTt_TGQ0WlGUfnxPHvi8Yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Dnqj-gUOL_6Qxeu9DwfrAdRrTDi3LzE5YG3YZxL9bRQ&oe=69D273E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NITJ_VHYJ-cQ7kNvwFdDfvr&_nc_oc=AdrK8Fl5NORaHxCvD_7NxiN_bkOpybLtgLFCcEkwlgoXtliStm6ca9FKR1oyjKXhPeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENlJuBZIvcK1vmNd0iM9nTZlcuHB3JDakvvwgBgRwMMQ&oe=6A7C4D1C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYy-NLQiZtoQ7kNvwGIW6_I&_nc_oc=AdqZXmprydWeVIP8z5MxNxLn_RWOD4zHRhRSluhbkKe920IJW7Rbh4W4kmQwRw5_j0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEayX6U0d1jEeNZegQBR1DAZDKO4fSZhtnWiUNEwGPVGw&oe=6A7C695B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7I9tq-na0cQ7kNvwH8nd-o&_nc_oc=AdoM57SeMJWv98vSsqNk7q56_F7ZqDZOsdeJJfg7YT9z155HaRFJSSRG01hZTjeGszQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdokvnDIxmFkBaJydqgZ1rOvrQjUr_6bUPa2QF6StkWA&oe=6A7C4D20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyDHF2H-O5gQ7kNvwEQ3eYl&_nc_oc=AdqkcmafRAa5tyw5TwNln-qUYa6DgwntxjoE4B_puF3m4aBsSqapRAvpT-sb22_Gl-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_t8DwWbGsRBlE-eUdpXn2JLP0BoCmzaqhj7mCWcTISA&oe=6A1EEADC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T18RZgHz_hcQ7kNvwHfyfh6&_nc_oc=AdpLRP9tS9Wm-71SzrgHc6npLeoV0nILHxB9jBzT8ngIgeb6-a51zv8fIbqK2F_3-r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sBvIhanVqAPVCC6r8Tx-FhmdkfgVnRIGSBlHYBEhq2A&oe=6A1ECEDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGE1jjPNlvgQ7kNvwESPNr_&_nc_oc=AdoIrSSVsIPSAtfTX_faFfOTacDnowkCDal1MyZlpkiq6Up_878759KD2TdVhqhwXxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tz1vntF_haKpwAgHgGmbpybHz_4kmPiVcKPxZ1EgZkA&oe=6A1EEAE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
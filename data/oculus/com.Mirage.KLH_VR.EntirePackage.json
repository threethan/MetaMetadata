64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmIhlFKIPz0Q7kNvwFODKBL&_nc_oc=Adq0SN5lfXBnC4tMM1kQKwrQ0WL94AsAQiYzsHNgVsEqX1cxyYJ4iL1JIQZ9i9NT74Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZUrMBF7pCwoP7egOaTDzf_oB0hHQ5TFxUi-C2AhvCpg&oe=6AEC94DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxSw_n9epoAQ7kNvwHeyp1_&_nc_oc=Adrj2Yv2JS8y2tuQzZaeblLigKdpkKjynRF-VYqTYaCuUaoRuJcBy_YYdv7EZ--wtHc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnl6xeV5VD7FmNX8xcy0cAFdPRZNOsbDo70xjcSvlu_g&oe=6AECB11B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUoL43yiUSAQ7kNvwEQ-nqz&_nc_oc=Adoawrpc3iaKEy2BB0pjqLiGLCbSSZXvgXBcqLv-_Z-UrDN7dxdsqi5CR9N1_HYjvqg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRguJDaGuIQipMMqbeb0qGOqMok3H8zOLtrllQOD5FcJw&oe=6AEC94E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
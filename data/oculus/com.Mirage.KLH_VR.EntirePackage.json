64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSYgN-mh9S8Q7kNvwECrXIK&_nc_oc=Ador0R8hQempPU2NvEY1SvZzWvnP5VSeR9B3menq25KiUV9Q6bcqu2DRZFVVmg77HFs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAtUkkNTAAcD8X1zffNl1EJchd40LckZd_Zz-xjmiIaQ&oe=6A58ECDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9srj7FqcdswQ7kNvwGmkQXI&_nc_oc=AdoZRzCEiq5nbFTZniMRLB9iQTW2tX3BR_HV9rW66GyxOhFg9c_SfkJ2BEKdn5nJ_fI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5sNlOb3UzAimpleA5T_34KFFMddYVzG-nz1bl1NqGGw&oe=6A58D0DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFxwOEzQEOwQ7kNvwHXMyfc&_nc_oc=AdqMbhpRbqCDG-rh71p4Hg65mvGJEu10vtG0lr2I9w51lWW4sh0H-L-WxC1HXGrICQU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAsGPM-4qnfALP2tdjWr-FZwoahm_YwuZtH_Dkqvel6A&oe=6A58ECE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
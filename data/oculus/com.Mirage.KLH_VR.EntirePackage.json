64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCc-MQyrjKgQ7kNvwERQ0T8&_nc_oc=AdqVq3JKCK-fpHDnl8yd5BPMdGqIBKOYtXOlCVvyp9Gxwlx-noRAwaN_IO19vJweRTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrb8XxvkFbzvmJbbd3qU4w9gTESWlUO7nPuC73o9aYgw&oe=6AA806DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtmJIvLHkQkQ7kNvwGd4BNj&_nc_oc=Adqq1licAnjTtzHiyLoC1SJq1y0zB4zYJyvWNuVeFDPN25JHp1_yO7DmmBuzB1HuckU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_7NTFNjAJi318Pymw2bLk0v2IK_PytMRf53jfwNj1KA&oe=6AA7EADB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4aRw5fG_QgQ7kNvwHTBZ62&_nc_oc=AdpNgy8vJdmvAh4qXbUA9gAxexcLdo5t_tRRrkGyQjPZ98PDP_BaYS8K516Uok5HORA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvvFvEcvTJNQhlB_NDEPJKFbtd_BeuufN7jNKEGEBwpQ&oe=6AA806E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCJSKrIPGxIQ7kNvwExLn67&_nc_oc=Adoyxn41HeEY1QahVUbSp_o-uS_V03pHQWfiIe-ZkQVjx17yik3cggI0OI-wJR-Pw40&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NsmRWEeUXbHd1ARJYfIccB_btG65j-BmRFVAbNyw65Q&oe=6A315FDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62040CnH1YEQ7kNvwHN54QS&_nc_oc=Adr9xOQQIuUtOQvP1fLzHlsIY7D6keUXGVIOyQTXRcE-PVTtt9118fUZGuFNIxWZ95M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vwalcg22OeTNhQIBvLwKoBwcbOIicqTTJG6RquCx2HQ&oe=6A3143DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFbs2OqFOxgQ7kNvwFWyF_-&_nc_oc=AdpvhwMI3VM916d8ydI8OVRgt5H9USsMAlGTXyJZyxaERParCmXqe-XFlM-gA_FhIAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-isnvksxSz6VQxI_Rw1B3EuDlLZC073-LGQmMNpmr9Wg&oe=6A315FE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
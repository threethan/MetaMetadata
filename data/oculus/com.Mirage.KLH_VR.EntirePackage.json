64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGAiKB6pgSMQ7kNvwFE7QKV&_nc_oc=AdqPOQFfAjqM2cG6hHk1PSkPYY44ssI-fY3brJlQQTHIfjQr3lJCebU4NQjkCmslVrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wjz9xtmgZNcfQhtoTKnUvjRRsxypbN3dfvJptF-d-gQ&oe=69ECD1DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye8Nkk48dFwQ7kNvwFmTruP&_nc_oc=AdpLtlGwqSwdm_wQYsCK1qGHfnjSH0bwyrQJvzwFck_eokklxKeSIK2ypn4nJxRflQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jNLFPt7QWZ1ehI_gprzZlrbN6XjZej9I9rCenJyPUJA&oe=69ECB5DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7XCrOgVaWcQ7kNvwHtL7Fp&_nc_oc=AdrKs3rHS_XxIjePqBgTLRnGOxVSZt3b9PIW2GA9d9vsu1vg2ZxI3RDaZdoPeM7M3QA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2COVduaOFmX3iiDI68x8evUFlx2SQI-VLOTF45lio2fA&oe=69ECD1E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
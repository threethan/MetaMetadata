64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYp9xaCRExYQ7kNvwFhLa90&_nc_oc=AdrmbkdG8F9m9-4QWQ1t_xhZR2yp3ljsC8GWzyJ7EzdzWcTerJjVidf63uzuGUeen8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIxR-FjpOge0ay-27XKfTlv7bX_kFouIA3QawRBOZWvg&oe=6A897C1C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-ZlyIQhfuUQ7kNvwEopKXP&_nc_oc=AdqUp4i2S43FjjITY0bcLFKvoZOpOXGdCfed9jZBHGm8YftLQVTG7xRhFo1rwwp05Ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIZtrlDu35WuQE-Hhxo1LB2n9dmqbQ_gmrNho0ez3_VA&oe=6A89985B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gySM1MQkg7MQ7kNvwFm98iJ&_nc_oc=AdqYY-EupNGpmrwNo_Rgl6XTgcvdlpg5nMfZjQFW5QNKlaVXTGDbZrxKeRxI8M4mLTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeiyyaIPAGIo3kRkTZgHBFiI9qPuN0E3FR3Tg6-13WBA&oe=6A897C20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLsey6vso2MQ7kNvwFj5Br8&_nc_oc=Adre_DqA9s59VP97x6YIIB-CfOvaEDT5R-JrJHlJ8B9RhPgEeZQCOJAkhyZPxY-vkAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97D653gGFF5W965xJsKogyRQUR6uvq4F1L-AqXBh70NQ&oe=6A25825C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0yQG1F8tVAQ7kNvwF1UnJx&_nc_oc=AdqZXzBwfh3Nm7O1GQomaFnfUtktj17Q_7zHkAjy1xknAj2ZR7890mphd5fvpehZS-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gg2Y6w8rcISnmxuHf-xFfqDp4wO1Xdf1ROYBaXPIZbQ&oe=6A259E9B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N79BtHDpoxgQ7kNvwFj7Kcc&_nc_oc=AdoEb26_kb4enrYmfg2WNlSB5cYm18pEZcPpkWNjJRyKQyYm06cOs9vHXZfaX5N-rk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ktpnHD9Ge4yZJEz8amjUF_JHZon9wzKck2SkcJNtBuw&oe=6A258260"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
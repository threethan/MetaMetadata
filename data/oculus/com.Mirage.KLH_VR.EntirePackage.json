64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc8BNEfq4QEQ7kNvwEtARQ0&_nc_oc=AdrIh2nr1Z0RoESHpLrizULyR5qK13ekcssjUG4YeMNt2992BtNRDS8S_IsKjFuCElo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ypacFSqwnh7IlVKHtdmcgTVk8R2xdmsi5e41iWqrDRA&oe=6A1D995C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T18RZgHz_hcQ7kNvwGnx6C_&_nc_oc=AdqauhofdKFbBJekABw5LE4pJw_tFGc5NS2IXxWnpBBW-Lo8tXx4rIFdcIT3-Ua73Gk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_6z_fanGjohFsIs_SCsKjV0q5B9WKSFyC_WbOKXttNQ&oe=6A1D7D5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGE1jjPNlvgQ7kNvwEYuju-&_nc_oc=Adr_SZqKfMnRUl63ZsBSKTn7pZO6pLHz_CNS1Dcsvgaq2mtL-VmvFu_SRyWPgcpU7Vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dE9IQwd4qb6Nv-7xfT9eiwKMfm__-IXOwwhWKAnwNcg&oe=6A1D9960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
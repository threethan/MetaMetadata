64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTXuLLcs6P4Q7kNvwE6WC77&_nc_oc=AdpDGtgz24Z66jUyg-ezloYuUcDWJfIcoiXspFgStkDIF_nT1iGmi2Tv6o0LEe84EBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaBH6fVLnkoZUK2-9bX3G7HU5H943IoS2icVWPI8BAxg&oe=6ABD1EDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPjXXp1zh-YQ7kNvwGfhbD-&_nc_oc=AdptJHZHRkCFUh5ryoAyja93EBUnn96IV9TxpS0UToR4d8IQekZT3XC2QJCrD7UYBuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2smfuW2SC79HesQFlVAn1VH7KwOhWF5n3u38SYXLtTQ&oe=6ABD02DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd0go6GKIvIQ7kNvwHrVbjb&_nc_oc=AdrKu8yC6uqXAGMHasLlVV--dXL3wl-ZnFE0DolmN2Wz0eQYh1v0VOfDCEDI2MmalKU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDsOWVCcSuTqiUvY9Wsd8xTu-2BLYAcBsAFx8zOH7fZw&oe=6ABD1EE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
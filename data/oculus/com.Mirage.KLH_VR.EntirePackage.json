64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKI_FRxNdkcQ7kNvwHQAYPb&_nc_oc=AdoqyqaKH6OJIz2C6XwfWJbgCkYnUMd_TzkhMCdDcLhDHWzrPcIh0zSotlEcd2cZMiM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb_NrYh-Y0bj0QIS_5aMk6Dsv-vW3cVMMSN0kW29ua6g&oe=6AE35A5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7a812v2RhcQ7kNvwENisUL&_nc_oc=AdrL8qOWnxMOrlxBe9OC5hnH179X897ddqPcc5bau7nk6_bHN-nZpATKvv0e4uA4kdo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFAW3Dtfe5RN_uf2EfA_tXz999hseOFGl7PY6mPrcAeA&oe=6AE33E5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9CyabZ2-l0Q7kNvwFmRB_J&_nc_oc=AdoghJFtDitDaK8nJOJZ-YHz7Dk_dy3RFWMNuprQf2xcr2xVKqUEpuIUgAqKAh0Zzqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmkd5xz9t5Op4dOuUl_ZCgIyZD52HecKlnCkeWYbOV0g&oe=6AE35A60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
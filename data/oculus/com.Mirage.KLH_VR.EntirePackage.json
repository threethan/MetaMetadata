64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0fLhsRpdkQQ7kNvwHjTYOR&_nc_oc=AdoWTHP2_yq0qdw2wrzj5AsOdoaHYIU0S44Bnx0irLhgvX_sBAzf5MHjUfHzziY1FmQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af646yRx3RU7dXwlLpVahplS0EUXF43oKy-OlTYfVxheqQ&oe=6A1701DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MUsE5RqywIQ7kNvwFG53v8&_nc_oc=Adr3z5ejG751muJ3NMBOleLG0TiJBqFgQ7WzA19_izlqTPzssUBbA8wK5nRsk91xmCk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RacKcujystETLX41lP6FE6qk0gAPatLesed-gM_sD8Q&oe=6A16E5DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YbaB1L-ZxAQ7kNvwH-lKtz&_nc_oc=AdqepZi5wkShtY9XwgT0ZMdOTL7PgKVfrzLVjrk8x-ZvmxSqsGE4cpSvV4wU-dnsDZ0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zyqkQ-9EOLiZwUSUovLx3X6Aov0vcMLb1DREDXt0KVg&oe=6A1701E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
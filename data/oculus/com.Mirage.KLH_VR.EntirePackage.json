64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nN0q1s7O4QQ7kNvwHXDaXY&_nc_oc=AdoczlNnDi6TTLAI4wbagyMXCoI4Ji2E0D-cKMpbPg7gGdeLSkXIEEsa5xE-3e33rFY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3YYkCql97z_hycvons8NWM96VqYWgUN3_-cGLpusvPQ&oe=6A4E60DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve8FoMGvnzIQ7kNvwFgDtES&_nc_oc=AdqeiqkfLP_vda5qnOfbTBgsO6RwNJeRaVkLYdPsvKUCjkFBEdLPqWKLmD3EyTYTBiI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvRqUvRZYhsZ0u10V7gXUvByQ_lzqVFbdeHCHE0d5Hpg&oe=6A4E44DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X98MZTIqvzYQ7kNvwF6vHBD&_nc_oc=AdrWWeDqzt2FGMRzHHJhWZxGgRYGEbJSFiAyJ4CYGKwVqOAnb4GHx4PMJUryX5D7jyQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-eE2mQF9a88pF4wCbfL_fa6rBNVJgT67Sh2Sam8xntA&oe=6A4E60E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
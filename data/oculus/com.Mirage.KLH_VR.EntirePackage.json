64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COBmPy_JPgkQ7kNvwHqTz0G&_nc_oc=AdqTw666BYBsz6B3vRwTAoIX3xoZgijB2PHW_gLp3awFrSRnrXAwvlDTM0YusOgwUmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFifx0lCXtgUGMdK9Zwsv7FFMnsvJ3zuuk3YFq6k_stgA&oe=6A75EDDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QtOidHwJxgQ7kNvwGhP6Nx&_nc_oc=Adq_vs3eQv6uXan99n-gVx0DNuPaYmDvKXzB0sjBYdf9MPqkOQ6erzVvqfmEFXoH1o0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS9ig6Yjc4rD-A8jEhFzCsKkSKJcl3j1vgrlJlhkbu7g&oe=6A75D1DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybftMdwx_ZcQ7kNvwHHJCi-&_nc_oc=AdpHJzFCzdGSBC51CBTnIPV9gu070j7JfrRMygS0gXseYkp3F2jz8ciRxc0yzd1zOGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEyTmqNtgZ5Teh5dwyHfQtMKRpN2p4sWht68a9JNa1sA&oe=6A75EDE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
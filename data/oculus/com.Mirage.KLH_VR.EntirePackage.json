64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0fLhsRpdkQQ7kNvwFesdwV&_nc_oc=AdpbYvyFkcBWcAHCJrXvhErcPZfaxY3l_ctNlOjOPNqpZSDvivBEG20XRRCjEIhYeTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ovPWGdu3LOFALFVLf3d0nt7h_WY5On92RgrGxn5oeTA&oe=6A18535C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MUsE5RqywIQ7kNvwHo0Bw8&_nc_oc=AdpzXcxUsBIu6tDbovTM9I5h9gJbSA2HdA5vRR63ZQk08q2pJxWD1C0RrmuA0j-3sQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CXcQpVj9UNzTzpQENSgiHCPzThu0dziw2-W3L9J8eXQ&oe=6A18375B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YbaB1L-ZxAQ7kNvwE9tKcP&_nc_oc=AdpgXPYDKaWlE9c_-ZnAtK3gjP-Ge_3R-Z-7a-Fy-6doRJ0630CiwezdgxiP1894voY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zEZvkYfaanDn8o1vmWUHQQCqmSPF30QFBFFMqy-7iYA&oe=6A185360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-bX8xtPbewQ7kNvwFeQh6f&_nc_oc=AdpzCFJGuH_WhGptxQC6NM-P3ERSei75MqStonGx39eyly_i3HHfWqKdd0rIWX2DSgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eRcOThmd4UEUwN86j-Nx9LRBtNwQcBO0PBo4GShFl6A&oe=6A072FDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3RZYjEA3YQ7kNvwGUd3ZD&_nc_oc=Adpnaqm8IqIfGsPZDKPV3i22rYWiaIvvxtc7rFoXwXHBeskF9m5mwlgXLMr_JsCR55w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xokLnu0IUsanQM9U6xCE_CiWFaKVEpxMxzL9JborvqQ&oe=6A0713DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly9_Hpn_wNwQ7kNvwHxSvKO&_nc_oc=AdqIxwW-qLJ64hf4TEpVGH3rbvVW8GVf3u2ZIPU6uufMy0YtJAKf-ifKsxGaW8jvCPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xe1387cYTwmKB_mM_oX6UGQxDza7hH_NWD5N6U95dcA&oe=6A072FE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
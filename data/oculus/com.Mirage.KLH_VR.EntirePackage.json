64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NITJ_VHYJ-cQ7kNvwHJHdrB&_nc_oc=Adqx1O6y4crYxsEam1BbBmApqAD3-2QqOI6Z1iv7lZJUuEjmTuEsSHb74Jq0O3wXjbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSCQo_qpg2jOdbpC8m-sOUnDFcguwQ8kfjQpTKcmPllg&oe=6A79E25C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYy-NLQiZtoQ7kNvwG6I9mW&_nc_oc=AdowXNwLObTUJNnQIEGeZQLxFGq7J5qE-qjbjMCKuO8tz5HHBbL4ljwthZg9cI7beNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8egwusP2uWQBOTXqQyeORnsrV71N89B3S01vDrlTNfQ&oe=6A79C65B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG0yxp61jsUQ7kNvwFL72HO&_nc_oc=Ado5fVu0q6jbDU7iu1Kc4FNh09ameF1MGz9GeOiWZRajcaLEyajRImJKDLDHi4Nd55k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKVbqIIFo4cszjI4wSkmVfDrXZCrCoyTEoqNZZGQJGQA&oe=6A79E260"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkP48OXQRSoQ7kNvwFrCyua&_nc_oc=AdrD8aINT56BekW2x_MqB4QgJrSpwB-DRGqPQFBwyPWGt-fx96StB39Q0eCk3xQKoyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-cXxMoq5zkDBbrRQ-mk9-POcC5XeNt7hdyNuSa9NpBw&oe=69EA2EDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HufuoOCx-vUQ7kNvwHchSaB&_nc_oc=AdqRblHREztfIi1d0ur5_BNAKkSF04Girzx88hsQvAHKUyBZVcn3aG14QL8XSehF4PE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31V-QMQhItPfznkRcuXqV6g66I7Nbew-rlkJ_w3q7GpQ&oe=69EA12DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7XCrOgVaWcQ7kNvwEzxpQ2&_nc_oc=Ado4tcvwth40uIZu6B4WJp-bk0Y_IdPNdK7VCBdpMkK14bvMfqucazxOi_JtOqSISW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28JW72ycrCK-I-7eLrPgdLg7s9SIOd0mCgwU7VeoWyUQ&oe=69EA2EE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Usq5Rcxyi28Q7kNvwFUZNNG&_nc_oc=Ado-LCrT9Wis2Ql_wdVLgdLnA93k9f81hzC4_xadtJootCmRIV313PpPIWGuRmpg9e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLrGZ-wRZAPh5RwEuhzYTQZC_kzgP7eoq0voeBE8dszg&oe=6AE5FD5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mEEaxjklREQ7kNvwEEeCNA&_nc_oc=AdrCdQiiTXKUv9Zf929UgRF2nEncX1TNSXxN08Uew39Wgc8gyhCnTunL-Snz_dzVkQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzj4qizWUFP5HWsyXutXD5PRnKeti2TZ_BxBMeb8M2QQ&oe=6AE5E15B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9CyabZ2-l0Q7kNvwHkCdNz&_nc_oc=AdpBeqeEMszWcXtCeychWP0m_1M-OueqomXBPJuE_zQdJmyQs22eSTI7dZgsiI-xsoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgn6_KK6FGArkGuZTKppbxh_v9wnJ7Q67V0-cbLSR0Zw&oe=6AE5FD60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
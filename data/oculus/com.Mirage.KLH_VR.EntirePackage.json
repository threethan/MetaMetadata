2664_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP_kd1Y-C2kQ7kNvwEP_6Mf&_nc_oc=AdpDHygq-8FUddYyJW8ox_7L7MUN9BIBCI81pyqg_LvowsC6vmLzBGLktAKvNkkck14&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISxIYAt1TU_tCVa3N8UozshtiQ8Uu91h8qAbSdpMw38A&oe=6AA4125C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orInKS8RlmEQ7kNvwFJni-O&_nc_oc=Adp2c0VFpXZ2lbp40mlB60fH54ynM90rhU11KpcP0KD-CnjLTE7NWuWxLQrPmCM7Vlc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYX8_Qz811umNL2NP6qLMLHtaz-KQ07quuHoMJUHpHRw&oe=6AA3F65B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWGZ3wcPwoAQ7kNvwHnt2a0&_nc_oc=Ado325eXnSs8hetPZXz9hD-KWYo4TmEnS0jauPwRCq59X6fAL4Y652pNdPPEhPckv0E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5rEX0rxrj7KgrBR0xMmaecytTza7JjtGb3hHYDQqvrA&oe=6AA41260"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descript
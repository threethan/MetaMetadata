64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W_xnD7jIg8Q7kNvwHtBz3M&_nc_oc=AdrYzFudEhzP4BiPx8ZZzsfpbSprmOHXzlkIbskgxpT5w0cTHOglLLHWDdkNgfQAq4g&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52jkisgeob5zYCCs4BEoX54ic62kaB5Sa-rBrU286hog&oe=69FDF55C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8t8kOr6RJEQ7kNvwGAppRN&_nc_oc=AdqdyLr4s-Tojr_CJvXEUKCjS0KXIBel0uRz4dTm8alJbk9wulcRPgcwTEttflSd7PQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53EraZdVI2KPDAmM_pfACdZZPCzH3qZSudfvCDSfEW8A&oe=69FDD95B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DE01iTR32EQ7kNvwEwOfg_&_nc_oc=Adqhp2V66zevRUbB9zZGgEnYQMgWGH6xsB13SZGK0MJ-PEJ62Y5EYldd-l-_Pih8xak&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AjRPWfvM6_1OShjivQ33qnC3aMXzKo0zWZxNmUktoEA&oe=69FDF560"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
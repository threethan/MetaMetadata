64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eygf1GO4Ix0Q7kNvwFIVbx_&_nc_oc=AdpUbs7GSGKrUe11cpQGaJTFHPeXJ0WYw_P2HigRhSm6XXUR7H2yQz1MuGhaNYanEvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DmovnreMP5YySMGPSuCBKQ7Y_7Eqt29us0o3oqGk6Cw&oe=6A145EDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukXTL7RihtsQ7kNvwHOOMr9&_nc_oc=AdrpiWcdpc7OW-ZkwqAbAx4hSUFG9XW-K4dQnEsQzXahvZ6J5ZEEBjsWY1hdk6MkbhQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mqHnvxw6uxso1fri6KlqLTNbJFfxjKBmZ0xRQv7L6uA&oe=6A1442DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYVtieizVxMQ7kNvwECbeKV&_nc_oc=AdqDonJRIMYeLxyQWWZctqxSO45LC_rA5IJ_cgxOONuiTQlmrAYKebrtEkRbVQti8OY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vUtR-C1dlHmZJ85SFTjHvq2uJH0c7CwRemDeawrfcag&oe=6A145EE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
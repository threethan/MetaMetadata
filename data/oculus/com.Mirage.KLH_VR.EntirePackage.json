64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaEFiUfgUpMQ7kNvwFXyXiM&_nc_oc=AdrCXTF0ic0htM3649py06cEVrQTmxX88KwmsTNZ4UpDmt-8f4GRNxzq5qsEVCugUhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5swN-j91RxTGg8xL_HAkGifTBi4u4x_vxaEI4KELLrA&oe=6AF0895C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae7FABL2t3cQ7kNvwGUABud&_nc_oc=AdptDwi5aHJ4gaG8KSwTBDPSP4_wFJGSdxpyT9jnlIqa7_Snom-l081KE-b4c36qVRk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1BlXxoRFgxCw-OKI9v65_I8UfJX7-_BL5gO39SFR5lw&oe=6AF0A59B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CSEjUI2stYQ7kNvwHfGV1S&_nc_oc=AdpzTknctolUb2I0x9RK0CAYwSMlnb-ZdoQoB6d85nS2_FebvWKCoQ5c3040QIOPBio&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMHuiFNHXhmwEs2GXKiz8BgG0EogGyDxxjle9bi_RmEQ&oe=6AF08960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
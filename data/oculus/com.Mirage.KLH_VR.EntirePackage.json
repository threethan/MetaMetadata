64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFFFloSuhEoQ7kNvwFVlS9j&_nc_oc=AdpZezikLB9JpYoBA5qS3ddSr4LQwLQQneF4Kvhf7fFXgLSfq1LQYs6aCjWoboTWDac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06IcGqajG_MVuF4iqgd6UWGQ_bGkdk5-PIjlXKERRhuA&oe=69E3975C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkzlcrgR-BYQ7kNvwF9R5jU&_nc_oc=Ado9VyECD8RlchcT2YRBvjDVg8Sku0aeKHdFpRxg12wZOWXUlwy7Y7tKL50jpl_Zd8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MBuulpl6E7_UdlHCd8BUpgWa-Jo21y0w5zjolaE0qBA&oe=69E37B5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3_orOMWItUQ7kNvwFO9IYX&_nc_oc=Adoetd8Wi97wS6iaR1ADxaaLzA5VtiZTLmpAcgYNsz-q18L41qVCuQK_cA8NTCpEtAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12pjZSZzBqKMn-5X3YF9sMD7XcJ8zA0y8UYDDdt6iqmA&oe=69E39760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
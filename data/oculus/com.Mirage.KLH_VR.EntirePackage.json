64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kx8-bQKC0pEQ7kNvwGSKgZ0&_nc_oc=AdojR0BKd_Z8g8ov0dHJj4gfhRnXdC8FomiaLxdfi_FagtM9QvQq-zjNqkiknD0GyXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnGbzNZDUAX5_i16RkP2yrYQgXWiup2Tlsg29P0BFt1g&oe=6AB1415C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytiZKJOHnm4Q7kNvwF01jKZ&_nc_oc=AdpUG1iyP8oE0ppmXeiW1ximlpfliez-KM11fatXQTjG9CmcfvGjsmNi6FeX00Gmf40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW2H7NEQrZzHXPmnjSvszh34bDHcqsXIZXDYnXiYEarg&oe=6AB1255B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSQWWECs3KUQ7kNvwEcOduF&_nc_oc=Ado5FQ9FR4lm8y31gJBrZhTNr1xxPVCsuOOtGn_39HdXMrko03sMeQIop5l9qzmTMwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ4aGgUl7hzruCEp4WBVQIgzlo_UivvpevI6S71y_v3A&oe=6AB14160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
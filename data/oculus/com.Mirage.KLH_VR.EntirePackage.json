64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGAiKB6pgSMQ7kNvwFNhn6_&_nc_oc=AdoQCM_2mw0bc902hh9oZw7mTtzgWFlXl1oLz3L0Gbsoo4btZBMMOUlkOYgenaD2Tv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WrRv-yUdLdVO5C_KLffQoOqZkkYL5LCnlxTtwYItmmQ&oe=69EE235C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye8Nkk48dFwQ7kNvwE2SrcK&_nc_oc=AdrjSBvm66PdFxraNO0uf45utserp8ek7efUqsPxH5kWoo9MDf3Jnic2nTOv_uu-g5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NlmkQTdWAqf0_zb6VxiLwjQ0M0rLXUvd1sofXPnCoNg&oe=69EE075B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNJdhwKB7cgQ7kNvwEXXIdC&_nc_oc=Ados_5s2lkaUdLmmINItH_ZzT7Xl2GTP2KMcsgQcH-JHmhf8KrT8UESO8gStL_Hc4Ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nTswNJpnctLqY2Jt-tGn3m2IqtrSMDV_2h5YrCHr6KQ&oe=69EE2360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybfd38zTAG0Q7kNvwHLySNI&_nc_oc=Ado5RVpjk32K-901Z-pWjg0dY0bUeJtMrZj5gIeeHHdrP9xhjRNHIT4GdbTbutOu5h4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlD32WBbkD4_EEVKtVGT_Y1LZ9h8Sw90TlV6NE1VokBA&oe=6AAFEFDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytiZKJOHnm4Q7kNvwHaYHRq&_nc_oc=Ado_g1cNKAYIUWVLVTWQwGfcj9Hh7ufZRqPmSNiOTFmvXzM0QicFa6NghQexWJDtk_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtvqSWC--Wa4AJyOPsFN6AP62JYxrx9foKG1uh2xIapQ&oe=6AAFD3DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSQWWECs3KUQ7kNvwG1pa92&_nc_oc=AdrcMnUe9mfPUD6B-4ZYWh9z04RaB8ke9tZQVTXORvQd-YfC2mze7rZTMrqlYhao-So&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlqly2AyAwf7qUrl2ptsAMGT6RcT7LVT0tWPq-vkqxDA&oe=6AAFEFE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
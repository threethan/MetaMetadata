64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3k_uYapRzQQ7kNvwG2DEUo&_nc_oc=Adoh1vCVf7g3H0FOYvt0vbkUNa4BP96iOgVcWntNHhxPlHfpquk_fBDztuW0kOMg_po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37ksxtVnvVvS2C96nz-6OKUqnjwnh7KKXt8q0wgzmzSg&oe=69F75DDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOL9y0N2lEoQ7kNvwFbJmwc&_nc_oc=AdqBcQ0hXbT20QlYgYCqIe2ZlUUuBkTap5ArTbE10YsTW0BfYX7A8OTBHMD9j566ySk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ym7zt7HVBsa7vmzXhBcDwychd-7lWUaKOaTo7Px-Mng&oe=69F741DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqoavE2gfAcQ7kNvwGSDSj7&_nc_oc=Adrc80BuQsPlCbD4oun0A8goO76ce94sxSOnc9I0NR3miZfJz96W3wxdSwdwGRXwru8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eGq41IM8TYyjYRhCL-LqZca5dJuOlUS2KeqtiloM1kg&oe=69F75DE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
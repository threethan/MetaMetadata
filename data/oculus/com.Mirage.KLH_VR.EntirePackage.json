64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrhO-jzM69UQ7kNvwGOO7-H&_nc_oc=AdpB-AdrU0GPH08UkxkO25ynGHtbow3omVp5KCtrPuOEroLChE6nwtolDSSETRpWsL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26-ttjDpXErHxQ4qGmyChZCYtb5ENLc2SbSfQQq34AqA&oe=69DFA2DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhiVy1Y3mt8Q7kNvwHRchjB&_nc_oc=Adr-PK-xmvV9l7LvJMB2oEpXxC4XIWDe6qE-8i_a0EoO9_CeiqCdwFPxDf0OaMU27d0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nZ-DxpSXHRAoQJy1FLWCSozVoKD4ODPNrnM7is6eJ4Q&oe=69DF86DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSuxa2W4F2sQ7kNvwHGi_6O&_nc_oc=AdrdwbVQtED4rUI5dLKqlgmgiZLYv3xwmuXeXzQ1pdPkqWzgDXL1EhJZDmu6d4bxcsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XI_1qooFYPu8k2cOkIyw8HMcCKJojX_2Pg73RKNdBgQ&oe=69DFA2E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
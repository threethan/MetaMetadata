64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BYRXUmBV98Q7kNvwHk1uaL&_nc_oc=AdpreL5cGd5up7lC69-Nj_3nUvSgmAU0hZUHnehl73w7V9RtpaCJiXc2DhCl1IvIwe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8fnZyTVCA7sATltN1lG314tFYiNRrwX_pWT49sz9oYg&oe=69C9395C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jb56bHNArwQ7kNvwHAlvDI&_nc_oc=Ado8d7IScGU3G09aV-k-Q1Czckydi3mOIdZzS3J-hXr_x0XXIw_Oy3-S5-z8_cBQfB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGlKmYxrCXFoT35qjEvdCFn2z5rU_hq01KRILJBNbNSQ&oe=69C91D5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYqELt4tyWMQ7kNvwFvBS31&_nc_oc=AdoZdDi_B_yuCEyfeeCrxfojD4RfoDq_5R-28H6fEn0zEHaZhXKmT9NFvvVbFnOn67c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysGonagoNg7aXlf820wsUQh04giMUPLh7pngVpEoqflw&oe=69C93960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
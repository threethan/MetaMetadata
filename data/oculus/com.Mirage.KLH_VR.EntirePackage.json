2664_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dHo9StRtP8Q7kNvwHMmEMT&_nc_oc=Adoubhx9heM4CVEg_odAhXj0QrmsfLBWammoy99kZ5oDgFQO4zx9pRsy4vEjCuAMFZ8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YvbfW0ZCmRsZjkjMi9-yhqjbnZOMPlHvcAiLnh97FSg&oe=6A4677DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIOPloNxx0IQ7kNvwFR-ODr&_nc_oc=Adqt3-E1u95CkAhS07h_8PhkAC-WTuGuwqX4CUVBpqIF5PXTgbnJEjk4OEvxJItkLok&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80xX-hMDuR3evsrKFOYhk9DTXiT8O0G_9EWwDzXqVaeA&oe=6A465BDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMXdEyPmg6AQ7kNvwHkkG7B&_nc_oc=AdoqqKme880Ieu8bhmjf82DKGNJHtKwTPqYbWRAKqz2COlFB9avsmASJZbLtMRT6CkI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k4IZwujb5Uab_WyIWKfpZWhm-WEV940ZeeNvRvXowLw&oe=6A4677E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descript
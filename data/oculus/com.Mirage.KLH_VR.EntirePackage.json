64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVIm6KeDRbYQ7kNvwF8ARTO&_nc_oc=AdpngGfxjmDijlkGyR96kXU78EDcTw_7OFYO3ovhH7Gt-rRba703cQUGUWaq7LL2CJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dTd79y_qo0vAv4TTg_zG0hPDZjHSgKbkZ5-rDPKbYNA&oe=6A0B245C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0AO2qe59K8Q7kNvwEYFoC4&_nc_oc=Adpt49yqfB43B5JiaCX0sNRohLSAMAPJB9o-LUnQtD7GoNZaoiU697Y49-S7YpkQC9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GZ_ByXBgaNMeuTGupbLIMgbrp_7Fn96bqYc8_TodslA&oe=6A0B085B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HFkF8b6zlgQ7kNvwH7poLX&_nc_oc=AdrU2MayiU2nWaBHvHWhEbFal3h-Hp-93YeqNPR1iimI-diTighIXbrhCYkI6Fx9MBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N266WeKkRvpkKl1uQjBLvildzuWXx9TQB72wC6JUJZQ&oe=6A0B2460"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
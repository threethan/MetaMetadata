64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BplLlyocr7AQ7kNvwHi-xBb&_nc_oc=AdqURFuHIxPlVRjPcGDmnWiWFwzjpgghqh3sw30gua3C2ot0EmPLOpk8TF4qi6Tb3m0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r-qjwSgdaSzu7qCmC4TxvF4vngJzzMhKkWZvKKnFoVg&oe=6A3D3D5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoiNX22HqfgQ7kNvwEmP5k6&_nc_oc=AdqphxKfGiSK48f8_Eg1L_2Qy4NP5DKl5sm3MuOEKMNBScdCyRfrb-Kh284J0kXpQ2Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l0Vp9603ik1LGUrhp2sqd7jTKUdXfZwXxuT3N8HEZVw&oe=6A3D599B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPUbF1OCdj8Q7kNvwGzs6hb&_nc_oc=AdrDyK8UzITHD0VwQQBSVzVbfB_OzocI8cR5QTBfGwyz-p_Bw1tv5aANXzcZEhE8Fkw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A3NvXLRpBccxM3sadaxd5KMFDYCtYuC98TEEaO0xC_A&oe=6A3D3D60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
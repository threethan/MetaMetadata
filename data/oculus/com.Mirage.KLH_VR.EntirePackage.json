64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc8BNEfq4QEQ7kNvwG69wPo&_nc_oc=AdrRp2R8f6lDPImX7IFAvckhJZxdwnYWxzh9A-WMx3MEor_q2J3zKa0b4tLi9QXSeOw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fVabukQsl3AffaXH0w9RHunI5tapuvx6-C-oSQHZHzw&oe=6A1AF65C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BSFIOqejVcQ7kNvwEePQIQ&_nc_oc=AdpNUEsPovzpcPkBw7Ss0pknrIPKBRFtRoNXunaXP4MWC7OQzKleibAFWWhngSi82qI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77zwMWvG-kb_sTgWKaofcK0lN43Ql2NO5NrDYiDQknvg&oe=6A1ADA5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3IA47xbszgQ7kNvwFqo_14&_nc_oc=AdpJ23LBXZrjOZBF1XKSasX2xd6TwcisPELXjj7HauSev0XvLENZuDDgr7KkyJBoiw0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iLrPP8bA-Q_ke9_aUhjiMZtDY43U9rjZtlTu4D5X3Ug&oe=6A1AF660"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
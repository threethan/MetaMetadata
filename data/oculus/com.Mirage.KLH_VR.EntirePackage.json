64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9tZrn19QfsQ7kNvwGlR5dY&_nc_oc=AdrOw2hQ2qGbkTKkOhXXbOAZrrxGgti3DSKh9yJFjy-bBFclDRXniU7FT6BeIbIhQjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUfUMcLoAKiO8NyLWROiaBuCT3mrls0t8Ii8TRA5846A&oe=6ACE425C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZRGhqAdO00Q7kNvwF7IAbl&_nc_oc=AdrSAzIIMR05d373ZGx142CYct1ZHPBXzeKID9CzvBgDQXL8Q-97Ftdqb6AZ1K_samQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg7ucDRAtvSqBeBg9ZXVKXOM5H7DyzpRm9LMNmj-60lg&oe=6ACE5E9B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRuPk8B8gOIQ7kNvwEzqRis&_nc_oc=AdoMdObE-ZtmV2uMkz_9T_Ks0Xd42tjM8HDz5l3GFoPO0LjLrpoJadp1VZS4dtlKBZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw8_AYCH2f57inBJDMQfr9Kytb_CJDRyp854hpF5SW5g&oe=6ACE4260"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
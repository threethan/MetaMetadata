64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDvsjOFzf-4Q7kNvwEXqY9Z&_nc_oc=Adr0O7GOD1XpPdNNhEj_cZSRxo7dG9fZ-9aSPwbLmVT2sCUlmJbYqJ8NTeI1pZooVpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kkC0Sa2ISHbOwCrsIpuxegwyV9GF03kgJM-Kj7G67sw&oe=6A37F75C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQXfGw-maPYQ7kNvwEwmq2j&_nc_oc=AdpRD5l_jlQD1JsFnA5ERiC6OA-rAfOhrjMStZe17YMgf4VQBMeBDBTFpeqvVyvzRIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IY18YZ_IqR1J-kadHhd-kD8vb-lUcmccWabfp6FtiDg&oe=6A38139B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MafrweE0cOYQ7kNvwEGVcly&_nc_oc=AdoS5zYSU1e3bP3rddKI1p3Js5x2Q-P2odvbkNYcvuEddqCJb6Lky7BPMGaUqRbhiS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-bAI_gv0w5ylk47lFian9GTW1CVM6dcGmQi29You5zQ&oe=6A37F760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
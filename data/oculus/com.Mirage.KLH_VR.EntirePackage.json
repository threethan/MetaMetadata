64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY67ttl4gd0Q7kNvwGVas9q&_nc_oc=AdrXhK9jyCdsY-EvJOHUoqVuF-q4Uv4kGE-5i4X5u-MilBFEyPcgTrOzvWAYI-agSgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QMtc1Mm_Sdo-IW06XrU9BPNmTxwVd_sLdG55tUilMuQ&oe=6A2D6B5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWX9H8cstBcQ7kNvwHCek8q&_nc_oc=AdodVY8K5cnQeLHbmtQKBT-8GnMB1VWVLFXPVY9i_EKbt6HZ0fzzjMObjOowGXHO4Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QNJ_YkT1QvPnOmDnZN7wb2mlrPpfBY10FzD6djEOL-w&oe=6A2D4F5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PG46laMN34Q7kNvwGFuAsH&_nc_oc=AdoPbfXPAumm6yunbEOiLgUfxWubhFmaCdcIMPRSlF-LEiyHdb0aXbWGzw4swnEoCcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DL_xKeh9kXcCBBL7cMfWJMO8Pu0RNobDueLW6jAwP4A&oe=6A2D6B60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
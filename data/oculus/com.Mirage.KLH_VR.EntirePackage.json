64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_5m5XxqzWwQ7kNvwEdAeU4&_nc_oc=AdosGYpr7shcMM0tzZ93kMLPyfZtou2IOPGr4EhFyMLogoohPp-q8x1DIccZFHUutXE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsLgeYb8EJGgWosnu2CtvPOwZ41zvtXTYjvakI3ByPOA&oe=6ADE145C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSHVSPP6vIQQ7kNvwHahv7g&_nc_oc=AdpAv5FRo7bakN_DEuhCCBDLZa0LA7meae1qThh5CjL2Pj7axhgPBfl_Erkr7QdAs-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwcToyPJQi4qLPSQUffzbebnDIoXW2hveGvEQl6OyJeQ&oe=6ADDF85B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eFw_cN-WykQ7kNvwHbPGwc&_nc_oc=AdqvbhaFeE7X27M_qrYk_wIZ-39zE9gJaJK1V840V5SgbvtUJg7uGRwYbgpS5m-DAhU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrsPwJuYGJLykmXg2HdI2TFxdGttQ7TYN_klJX9tPnbA&oe=6ADE1460"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2iAWdK6hgMQ7kNvwHLS2XS&_nc_oc=AdrFRXRkhE9EFWVdIFaab2gyil6hQOZUzCyXmQ5c-aNnFKfqtT7zJWbOmrGXGt1E0Mo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t1rYWP47RFPsF5NF7Lv3mU8goC5tVm_rzPbmQaYmPcw&oe=69FF46DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hqJ5jX8xr8Q7kNvwF1UR9b&_nc_oc=Adp8VJgwsiovSlaTsbFWNF9x_qhNUvZiIkqc5Jx0SoqozYMR7tiLZiYHit3_eh3kLxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L7xkzUBZCX6ZLsLneNaWUdgI1dibhDobafqD4gt0jiQ&oe=69FF2ADB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DE01iTR32EQ7kNvwHhPfwb&_nc_oc=AdqNhre7uug9baiux5GOcmCAW4atQ68WvjzD3qHV9Sp9AIm1a_M8oDWjYPX99LFOmdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q6d9n2GcAH44ZBOUjSIxGAcn0GtHb2SdhYgaEBk3CkQ&oe=69FF46E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9tZrn19QfsQ7kNvwG1_r2E&_nc_oc=AdotV3R_2zNKETXca45lJIAzi90K3jSZrvU3CNE-cbEPapvUKd4Zyw9BVo7Mtjh0nuk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe29HJREHy5V75ah0w_YWBqUvdy-vkSmYHyF-3TSg2rw&oe=6ACCF0DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZRGhqAdO00Q7kNvwFddEeW&_nc_oc=AdpsWDvjgXfsKsnNDTGE5-XggWZHfG2P9ordp-ElX7t_L3CogiBI5W5YCZup9JEa-nY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO370I1x5lpG8gbI-Zhgh0co_R8hF4tGU5M3UJpX1257g&oe=6ACD0D1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRuPk8B8gOIQ7kNvwFqUcTE&_nc_oc=AdpYwuEIacDiN45oKpBewgpnb6j-MzVwBEx5ajSsgHDUdEwCLfeC5DgNIGZ5xNQ7n8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM31JQKUf6DxlSYbVTTuOVCly3X635zy8_7HnpWv3rVxQ&oe=6ACCF0E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
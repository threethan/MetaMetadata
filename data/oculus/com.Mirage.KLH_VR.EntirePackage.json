64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-bX8xtPbewQ7kNvwHv4NcD&_nc_oc=AdoY9epWtgHgxjK2795-OHJl5yqvXO4WPhW8Ho8jfSbCAI-piGYU8OvRpC1dNmk0KvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ZyBLRJOISlDbLx3Vv6_tgYhxYXrCrTC6KxBVSWbj-g&oe=6A08815C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3RZYjEA3YQ7kNvwF51NW-&_nc_oc=Adqi5SXb1SlLk1MHF0E2wcqIutZVdyY7ZHTePVW5FNhq-UFP0YviOAkW_cisAlkfsyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iEsF1jDZ5PEMfhUTe2GE-3WL40pgIf5c9yn4cD5Dksw&oe=6A08655B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly9_Hpn_wNwQ7kNvwExUbBR&_nc_oc=Adpzxh0Lqaw_tlGdf1JWuckFT1LCDgJg71QYTquevknyt4gbpYhqOzGoDAvw5bqZcOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54UJF5A6iyC1cneIn2CPvcFhD2tajThFIidcRF6NXkWg&oe=6A088160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
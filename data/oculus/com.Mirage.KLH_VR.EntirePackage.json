64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTXuLLcs6P4Q7kNvwHKi8Gs&_nc_oc=Adp-SdWA9lkKW-MA3xzULetJlxoYsAoBjPfACWUbz8xECBZRYpFxLjX0or1I2F4qBSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKulQJPM1LwCY_44OpImFXyOliaASufwiMeu69eGetR1g&oe=6ABE705C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPjXXp1zh-YQ7kNvwGSlhb5&_nc_oc=AdofXyPPMe3_c9M260e8C4uDp9EL4cklwP_OqFULEHPX4PkRDDfRX0A034r1nRcW2e0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFM1DZgNQCwmKrd1_8eWb1W7aZYxqv8Prh5QpA3UZZ3g&oe=6ABE8C9B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd0go6GKIvIQ7kNvwHhNfNQ&_nc_oc=Adp3fgOFTyG2yj6XhIUDT5QvnkfKF8iSj1Xepk_3e-1Y6eHtLLbONC7IcqYvNKKrrtQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl7HARZ4tCNsh41WaW8Nuz2f3FzHFNOccKLFcjRInYRQ&oe=6ABE7060"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJbWxyFW-Z0Q7kNvwFgf1Yq&_nc_oc=AdqLw3J39LsChvTpMcGfv75FreRXbNAqCLKYVahAqwgEvuUPlObEwcvsnE8dh4-RZes&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBllRrWxiYyv0aH3NYeF_M20qhOGavNFspmBneZXnAd3Q&oe=6A6378DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBVpI1kwWUEQ7kNvwFs-RvO&_nc_oc=AdqN-wrI3K8TGMNHdWsbCCbcP1h0XkmDnYzHc9xGlq-LXBqvY1qOmjhMqmkK0c8suXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN60tPSgI4QeWTDcXrp81TAs_ELhrGTffxLfyhsFUXjg&oe=6A635CDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg7VSNVSDQAQ7kNvwFc9Asj&_nc_oc=AdoI_5g0R5naA4GXE1a4NpkxQqH9WKDItE899T5bGhtMF79ROnkhK6eVuXxu1h1XH2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYwrqn0DDGk9CabBIhdkzSXax1Tg_Olgg-LbdlO3okDw&oe=6A6378E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
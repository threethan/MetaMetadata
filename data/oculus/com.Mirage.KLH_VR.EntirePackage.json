64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHlmaY_hJFoQ7kNvwFEg2mk&_nc_oc=Adq4-VGnLkLMbvAif5-gtOukw92lldjAqqIMqU1qz1gGFX4u2lknOzjPgv4goxtTqFQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGgDxe-IxOJJvjHzEZZCOugNEKlUmbE08zlSSLAhrIJw&oe=6AF9C3DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zdlI-q1IUgQ7kNvwFufRgw&_nc_oc=AdqHlMkudGdK6QaKCJVDUmfp1F2uECLxjN2oCq7FuUD_pyXJbM6NMdGKc33z3dADk_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzcGRd4RQ58D8jOUGE0EHhblgxjnd7NPOpNL0XW4L1wA&oe=6AF9E01B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB6pxf5_lr8Q7kNvwGnmqvi&_nc_oc=Adr1SBFMfjmQUeX3DpunZelrvoBavagn9CE6sppFS1cxzjyZELv76u6Xz88YGdPtQeo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFrAZ7f3cD0QT8QgMDeCQ2_p5dHdk2BP4px135vbSlCw&oe=6AF9C3E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
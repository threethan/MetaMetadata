64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iDeSu06et4Q7kNvwGBH_nH&_nc_oc=Ado0wLMJqvYoZ3y6XdrZU_5Gl_p-cJ-02ryVHy7qoMSm67JNbAvA6UGNqr7LCqOfwJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rPDLv2vnaJTEtUJgZppSRDUYIdJsEXe0jqu5YSdV6ag&oe=6A2976DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0yQG1F8tVAQ7kNvwFrLZq2&_nc_oc=AdqLyUr7Gs_R4CAIUzAgijFuTzVyb0AxkiQ-fyUdca82wpr6EDr2SnVI5DusmL1Zbhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EIceL0q-Rmls9Z6xGliUzay8nMPmcyvcmr_kWZlJefQ&oe=6A295ADB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2lokkzkzboQ7kNvwHwpoFd&_nc_oc=AdpcNU0w5wok_YHHV569w3RWZHqcpXTESV29ar6yCmmhX9I3YTTi5mjWvL4BkOv0dEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j7-DV1hInPPk0KOez1FdKKm5uAeSahVufjguxjLW4XQ&oe=6A2976E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
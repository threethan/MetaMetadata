64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsPCx7PwYSYQ7kNvwH1kEwv&_nc_oc=AdokZKzMJ0YJ2Kr8fU-poTejTNdvFNgtVgGa_WrAox62uM-8F5LjOriNhXzV9rllI_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrEjnoq6VA6JUBg0OfZT2TsMeet8H1qhz4taOxf1BYUQ&oe=6AB6875C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAmQLqs35-8Q7kNvwHaPsp8&_nc_oc=Adrr8SJhGoiVjcfdAtzhNjWTg5KpYxP1RynIqBW2liMfNlrC5rjyUfEFidP_LH1oq54&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFypm3joMP4t2J-h9EWeEuZJfNox0O_7pMrY6F7zN8-A&oe=6AB66B5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_5Wig8Ik0gQ7kNvwGSxAwJ&_nc_oc=AdpJJNRknfyNI76Pp_izk-xq2UUnFGHptW7QF0jHFGKO3cPPj22CA1VpOmjFruS5dHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-7JNgm8RSMwGBuJqzyIMoT7zyespfF9j3Mew1iDQ7bw&oe=6AB68760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzq8YJBrpRcQ7kNvwGrJoS0&_nc_oc=AdoHXFxAf5YA7iMQgcVd_1UTD5NXuQ_mkj5bnEsi88qO3RXmxxBIaVXTvhfq6a8NJkQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHdMlPk7T8niH71eifNkLLlgjIV00UOCXYi6s0PBtDSg&oe=6AC7AADC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuLg654bIpcQ7kNvwGguE2p&_nc_oc=AdpHQzD4yVMSzyn13dz3nGLaVQ0u0hFAyN67LLy6Hn_aaMxnAdnx28bGuSp_vM-pfG4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC2PE1AWlV7X_rCgLxlBwlDtzxc--3jdiTveUhtHlJ1A&oe=6AC7C71B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3dBXIAhIjUQ7kNvwFXQ5SX&_nc_oc=AdpDUkHl6Q1bnF-jb6G9t2uE0dw161mLefF7XACdObYxi-P5mijMU2NeRLjDqHuyg4o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMesy4-I7cPc5rWz-ciXm_A7sGTVsJX4_nm4kQoy5Q_Bg&oe=6AC7AAE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
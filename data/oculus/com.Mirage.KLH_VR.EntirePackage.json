64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mOQPNvrCZcQ7kNvwE7V0J_&_nc_oc=AdrINhOb0km9Uh8BtfBW5yL7F_sZvcvgxbnVs8R5ODkEBpyMfHGXNUe14pnQFsNgnj8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lYr-m4Xx1sMWEsvZxPQ58-W96MfBOMpgeRAmy70kkNw&oe=69D7B9DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I75ZDqHObsQ7kNvwE9p9eM&_nc_oc=AdoVl58TjY2OUNupMdYtrx-pQB5GSHR7VEUZir40BE6EgJR3OocvTPEINasQ9wPs634&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zB7nH1FfCjKnnvgXMBGOu6FrdQ0QPaqUcc1xwhbIe6w&oe=69D79DDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAHhGUcYR2YQ7kNvwGLPSVz&_nc_oc=AdpKbDvVd-rq2jN1qBjEvAgm-JLvsl9PqacyQPW_atK72IsRakDg4ewhAnK5zOE-3F8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38gvAHsn9K9JBaNRy7jLGsySuFfW3qb5fZA0FAsbgzNg&oe=69D7B9E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
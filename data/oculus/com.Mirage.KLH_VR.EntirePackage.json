2664_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDvsjOFzf-4Q7kNvwHSKg64&_nc_oc=AdrU707jU0gt33-ZEs23xBEaaKtfEWdCnaRsU8xgS1AOqpkbm2ix-HEXV8DQsaPaIPw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nAmVeHsYUYN08ZcGwvr_L2O-rbQG54WqqgBJpSJQ6yA&oe=6A36A5DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQXfGw-maPYQ7kNvwF_FEmR&_nc_oc=AdrjspzkGcPM_KwS2RHa3yyiDNS_1KVb9T6ikUGVMA9oSbUJrksMpLjrKB61A2ae3vU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0nMalX2J7acoPq9pwEhMXQ-M3RvXh-MF9UXdYx2TTgg&oe=6A36C21B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MafrweE0cOYQ7kNvwEL5C8V&_nc_oc=AdqONkaWfBmicjrnr0KptxEHMCJUSgJB-53GN7UjIGQLhe2zWsCYkwLVpD0smeg-GbA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cANW5HGSXe859HDZMPshJqe8ektW1GBOIRCUxi0n_yw&oe=6A36A5E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descript
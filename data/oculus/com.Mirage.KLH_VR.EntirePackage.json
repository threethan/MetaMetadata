64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyDHF2H-O5gQ7kNvwEm9vlW&_nc_oc=AdolvIX6TzRdsmmbzr394TT_mwSaMHbNSrHTaKgAoeeEb6DY_WbE14qn48geYdhJMQQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uhEza53y7LPilxEEUV6qTixBakmirFAeGAXTVuk0vCQ&oe=6A218DDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SIODXgCFYEQ7kNvwHt3WJj&_nc_oc=AdotHPSflUFcwU14dctgKSHuX-FlFCWs-0p4QRg800DkJSAdq_8Th0NY5G9UvxQiTWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CaI7SL3Aac-Gni-9fx1KWL1gkmm_XQhLkfWyHoud4FQ&oe=6A2171DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnME4-3VxHwQ7kNvwEceYk9&_nc_oc=AdpNHygdcoanPzQ1B6HA_GQ6_HJx75588HHcOgEOtth89adZzs2aE0z5tAQ6DrFWT2U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-63LpCIOgCvuquMnUuqjWCW5TE7-276ns3rXXtSkauwg&oe=6A218DE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQljuqmv0NoQ7kNvwFBqOxR&_nc_oc=Adovn1B3pLWW7dvjdW18hPFtj0b6YoXHcea0bxQxT11SjhrvQHcUWAQ7QY5dBJLDy3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vaJ_7iYDt7avaL3cUwtlY47EYxavzoTW_t1AtdbkSvw&oe=69D516DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtc3f3g8jGIQ7kNvwEsftKS&_nc_oc=AdrDOlH_wdLXJrAkF4FeU2EZUMWzz0WnNEUU6Kl_HDWUUFIdAkCV_UQwtXVbjMRU_O8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fg-pDq3ABouybOGYwecGEHHkTWaI1Vk3F35hVwyctYQ&oe=69D4FADB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUuVaIMdPyoQ7kNvwEl_bPJ&_nc_oc=Adoq5tSa2cX1JrL6-7sIy97FdRKqIbOdmco4N3F6yUJ8Ox6Nouvy21ds5I2RzfAO8cA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rxBaEcFzxfNDMPyb6wOCNUiuh3EGQpnD5BIp2CsZjVA&oe=69D516E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnT2AHDy3swQ7kNvwEUWzeS&_nc_oc=Adq27FrEs63jVCruxsa5fUmBlJ9msjdXcZ9g6EYZMxn_zV36bqnAw13Vkdt_3koTZ60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCARbjYxvPa_XCjckZ3doXn8JkhEqQKS6VgJKqu5nJaEw&oe=6A676D5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSjo8xFAn7cQ7kNvwF58QGg&_nc_oc=Adqc1Osis0hax2kg3j35Ft0T-gNh6bzG10frcDNfHVgWOVlPY2ZlsTLGYolYJteEIGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXu-AymN6y6-SYpgRY_nkQePk7eo0gE7HfO-YH5VDlXg&oe=6A67515B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybdlF_moYu8Q7kNvwFudSwo&_nc_oc=Adpw1Pu_wMRR7Oe1L0a1ORGd2CpsStLQJVgjnEgo3CNnicTwui8NaCx3yBKQwWUb84k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcaNMvBJDhPLQUaOax9X_mSDiB0FgqSw_dyPhpt1RufQ&oe=6A676D60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
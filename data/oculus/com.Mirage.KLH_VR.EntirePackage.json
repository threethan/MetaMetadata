64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnT2AHDy3swQ7kNvwH-Zxhl&_nc_oc=AdokmX4gxebiRXAsA-SBZKXVhZI7IfEpoFiDHJA0qxe73SNa3_be7lzxklnlUKl03wA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs-7W4G_VX9R1u88QfDYki5hKFmi_mm1d2OjXiUfW_QA&oe=6A68BEDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSjo8xFAn7cQ7kNvwG0gMA7&_nc_oc=Ado26bbilcffkBBwgzWSU00IcUijz7ZKWB2PoSd_6rF96vKM1TVhiGpucWbpJaNkt6g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANa5e8VPJhpPDbcCQBCBSuZG6-FSENoqr2-yGpoWc1OA&oe=6A68A2DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV16eG6Xo2UQ7kNvwFvFajv&_nc_oc=Adq_jy9APbJtSrJeGEziI1Sgucn5i3aj5IQQ1RhZwuzFagiYSl92W7e3bGWHIkOZpRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXc4ySUUwrdru756Lo2qWpw9M5BZ793pnjIwMPLobpBQ&oe=6A68BEE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
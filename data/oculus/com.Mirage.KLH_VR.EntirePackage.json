64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuisJaowQT8Q7kNvwFOJK8O&_nc_oc=AdpxvEG5GtKY-3C7AbDX5HGPUJU8kq6fltlm5ytwp-Ur_nFLCZ9pY_Q_LuQDcvnj00w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzHPzVKALDatds87vlkEarhLFq1wqR8NiYEtz2V04Cjg&oe=69C3BB1C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr_jTB5yF2gQ7kNvwFTvyYG&_nc_oc=AdorD4HRJ7lQnOgo9XGK-94NPbpRJffi4Dlqfomw-m1PLf02hzgFgqjGolFvOqFpNbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDVXVqGfXr3hyshYGM8elBy6Q_rgbYBK7hUkrwafROgg&oe=69C3D75B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZGPwx1eruoQ7kNvwEQO2Ox&_nc_oc=AdokApp1iREidt6f8ijik5TDY3mdC2B2o2YzaNcJm3dNmVA9fBCaC7gWxK4L2hc9gl8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDE8TwD1SEmHDVxHqvGTxO08MAipKFv7GTtFp0V8xCSA&oe=69C3BB20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoY5NNqM4msQ7kNvwEx4Hxh&_nc_oc=Adq98-EZmTPB_2fE00sSrYXgQmFIX5XudURcZ9OhE9DN8K94z6ziyy5iR5eONQ9fgTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsQkUZz5e7ozRjcAdqqAznNROcvyebtTRbbWfcTPa2_Q&oe=6A6CB35C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8WxFmsdECQQ7kNvwF11c4B&_nc_oc=Adqct0q-xdy6tNmQVuogwKu36elSM-rN4KlzxgyxZe9yMXkGmJ2Fc2QCZhZYUGcLTWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASGJtDrc9QySA_xoDUNnPYN_Zfq-jLkJOZ99s1_CrdNA&oe=6A6C975B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h29f7eX3veIQ7kNvwH7m4gA&_nc_oc=AdqHGiM5iw8MBR35FNBIA1WvJb5g9SYk08dGE9HwdnsmNUoe1jIam-IBWC3vz-dPPOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVLKA2pz9QmQHFfxRVCBckxYqGPd-g5D1JrNeC-d-lmg&oe=6A6CB360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eygf1GO4Ix0Q7kNvwGtxfn2&_nc_oc=Adpk1_aQr9yrxHq03aZyxrCxey6N8TZduE1GTPbcHrA4apOvxKxnV2EDy8cjLDUMwww&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kzfl9g_GLK-pMXqvCK1JCcgQxJtLIr1aczl-e0G1_AA&oe=6A130D5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukXTL7RihtsQ7kNvwHtBBCM&_nc_oc=AdqntMj7JCcTpORNtrs95JtFUXdEaT0M3yOTvFJpOlkgubSRrfSp2vBF5-teOTjDYZo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gWWReBxAYuGs05sKvRPomUTvGgLcDIUfCEI9UCxGldw&oe=6A12F15B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYVtieizVxMQ7kNvwFsRh02&_nc_oc=AdosKb_pLj82eAqXf0tepehMeZFDELAflUoXzwPweD9pIvEExs0MCDgGqgjeX0-hVy8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b_PGzd_Bx7fQrfch3FnhrFEbRM6qlupnsUddEp_Hfhw&oe=6A130D60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
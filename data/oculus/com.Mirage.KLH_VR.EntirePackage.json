64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGrGO29WajcQ7kNvwHmPW7i&_nc_oc=AdrSQIBqc8JmQf8v_nc13L_J5VToEr7x8veGAtkynInuFzlPSn7dmTSLhbScNC9vig8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11NrSZWTCiiec7yf4ImF4BPN-XiGUk33iBxaCqhrUdxg&oe=69DBAE5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awoKV0h1bQQQ7kNvwEDvd9-&_nc_oc=AdoiHNCe5x-xqChI9ECFDiVul-rivRBLSE3wigoNwf8fDSYbfT6CMEA_mdpDyqkPoW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-cJHF1F1-67vSYNvbCOmmK3SjyWyAwIb2f4JJY5RyPw&oe=69DB925B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2Cl7-GPxIsQ7kNvwFj669J&_nc_oc=AdpHEtZ8mJvv0cKyLrg1akwWSqglTyn4-Wfg-XeYziCOuC63uNWSyiWMbpGy0hKUDww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qvaIrk2yWINDlmnAWgAZ0o-10Hso2uIqCVF329PyMDg&oe=69DBAE60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laFMUM13NwsQ7kNvwFZQsH6&_nc_oc=Adptnisu5Ke5pjMxdVlq0FJMGiirfOjJ0-Zv_j13W2lxaW5_e3V3M7V2-mvbRgF0rNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkyZCc5BKiAIr86HVnxkUqiiO_-Tl4HA0PnTd1CtMjyA&oe=6AF5CF5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeqtzumaoWsQ7kNvwFB0Wmy&_nc_oc=Adr2te8uOssjwyLof3HJliqsK-KcuA5Kyx9sbaWMkcVZKpkSHF4o1kPUk-diRpvpNVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0vHO7eBEFK-KH_5yjNhcbXU-8gL5cw4Cgyda-VWrPhQ&oe=6AF5EB9B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAknGzM7HkIQ7kNvwErzAzC&_nc_oc=AdpBPA1WqyUGf4TG7vJQcB3dstCyf9dHPk_Hc2tlcTETkLdhk98Hbi23mKez-S0UozQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_o0mGl3frJTbghwlOO523X0nMa-8XXFyfXdca37c8nw&oe=6AF5CF60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
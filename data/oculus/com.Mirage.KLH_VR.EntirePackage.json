64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BplLlyocr7AQ7kNvwGohYrx&_nc_oc=Ado63yD7FT1nSK0M0q0uhgao1P21UkWWIAK2vNzGaJJe79QetiZUkpKM_sgZcTXwID0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6VFXDuypqX_ZFJWyndBYJsep6XEFNgN-aL0D8xpiEdg&oe=6A3BEBDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI134nijYvAQ7kNvwEBST18&_nc_oc=Adq9GbXJUPyB2Ld5ODSgNQpq9EREhM9B78SRELy0_IyKbDkFUnN647PEdpKhsNTs74c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ct4eGGzxPbEHclHFhzfCq__0lQ-DiOwfYz9OIrm4uNQ&oe=6A3BCFDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77VoaunJo_4Q7kNvwFJXh93&_nc_oc=AdqxuWjR9v5cfz05-AbheJBY21HiYvcgB4ukQyQqt22Cv9SsG-qIk0PDH4WdbwuOCoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZIt1PQsfyk2eST8ckTISo4x-LIV5c8vyqel3gMwoO-Q&oe=6A3BEBE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kx8-bQKC0pEQ7kNvwF3AO2c&_nc_oc=AdqnaiejytaY_wjehttwBiLP9b1p-id0aUibFZbxlLqFpEsZUk6jjdDdFRdXUcoHzy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGKXvz3ZuYHDUqdmL9cDDscNFpoQMjXtIpJtbhIKj99w&oe=6AB292DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytiZKJOHnm4Q7kNvwESpCfK&_nc_oc=AdqcAcVOmoz1JVq4oqbLK011rlCr6GdNBwU4tNChIvgjj7MRXwQaUZlDs2c8OotoBqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7tkFBRwpbrXbSQq8JFEJQ_XTfft0R_44wIhN5vPRCtg&oe=6AB276DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSQWWECs3KUQ7kNvwH4f0EJ&_nc_oc=AdqtMakk-cEBIItQkabXWlDwpsdDdB0DnrDZCjGp5FxZ9H__kLs88_5bi5-_N1X0mYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf4F7CvHiy9xKR1IUmu9OFUhQZFDq0hq0vKygojjZxqg&oe=6AB292E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
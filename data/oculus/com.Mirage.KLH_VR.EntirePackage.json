64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BYRXUmBV98Q7kNvwEZQztZ&_nc_oc=Adoe3YOMEBTSKJTqH-VuhLODCMYr67kxCC-ZwUFi7CRLfnDuf1ruTvKXJzA3OzON5UQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfuVPyrqjD8ZRn2mytNQkvTH2ELI_joDLf4oONTOCSNw&oe=69CA8ADC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jb56bHNArwQ7kNvwEjB0Iy&_nc_oc=AdpvnpCwOCzfe4EOjsb-pVUPNNXFom5PYJB4j8pfFbYvEZ9KtGryBLhzR6WbOgDlDF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQP9t0vCcH-u7-NxqrVAF0tX0wNzEgtnBP8e6_nkAM_A&oe=69CA6EDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LmHHY2zhNIQ7kNvwFa9OxK&_nc_oc=AdphASH6K4iEfnldO8Md8kxX2nnrI-jOe5yJjv0FR1Wq9AtC-c1fv7Ffm1qGqFdMNb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylYSyUZwqYfZiMV7SGH7kfwjpCH0c_Alc9B2r71V7feQ&oe=69CA8AE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
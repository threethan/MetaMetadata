64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbnaQy_qkg4Q7kNvwEqT7Pj&_nc_oc=AdrN397uDGgfQzrm3K_-1B7Ph6IDS2QOLx25Wc8Y7NQP35q-qL28e55UpjSflMiATOA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe230gIBJAADRDLHrdUrzoCYsgDEPIFzqOnb4JPNXIQA&oe=6A91651C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBf9O3xNpVIQ7kNvwHNIO_d&_nc_oc=AdpbWa33_WXEi-Ei-qGL4-MEuUcuRY4wNKFFkRfjGnPNYzruMYY_9C9pyD3i_bwcpKM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPLv7Ak_vAj8wnOehaY2sMYLXV_v3--GpsRFfha3R-Zw&oe=6A91815B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7D045tymDwQ7kNvwE84SHD&_nc_oc=AdpQs8JBQ3n_-Z6-vxkn6Tr08Le914kHhU8ccLMDnO_6RnGQTaGRf_NPkXgQIUgzRC0&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd1JPjWyB5AAMmeeL4dJzVUvzoZzkdAPulbJkmd9OqYQ&oe=6A916520"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
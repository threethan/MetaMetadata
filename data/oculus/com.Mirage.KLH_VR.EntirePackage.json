64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9cuLTG4XJwQ7kNvwET5whe&_nc_oc=AdrOOWPk-u6YlM_Bto9VM4p0pNjpn7_JGvfoVggTlH2ueRneuy0tHsxfdmiQwsE_SjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Ihz2i45cTN8epNs5j5aNs0x2c0ePA1cFQ9lCfHCPiA&oe=6A42835C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCTFWZUKlEoQ7kNvwEx8w8Q&_nc_oc=AdoQiU0tQQXQfqejcdWuwakJpy_530oxLzZG8EVSRdhKoeb6UJo8MNyOuYws4eSm7JU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YyxtCZAQmZsyPEU-O3VAi-TOVC50LpbmKmKirUhzBuw&oe=6A42675B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vq4Bu9tZKxkQ7kNvwGZ93h-&_nc_oc=AdrGnbnP2Oijp3dXrUoKBx7xiAMjgcw9zkgwPgZnU34l4U8XsIu2Fb5P6cYltmg5x2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2zBROqlImKoefXTqJMKnXqSsmJAR2xrwSOJrgPb_uOQ&oe=6A428360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kx8-bQKC0pEQ7kNvwHCoLUo&_nc_oc=AdrGg-iu4anAZ8uF-ZHhxNWbUwQFByMYqc9a5NDY7TXylCHn41c1I6sJsN8hggrYTdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFgnEKsGY3jxnEe0L2j9DmmalwkFJc00DBpByCly4IWg&oe=6AB3E45C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytiZKJOHnm4Q7kNvwGkQrau&_nc_oc=AdqELIMdZ85X0pTk7qMfZRccA9gIHNsh6VG5s8U4MtjkCL7U7VZg_58cZmo-_GcEvME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk7pAPa0gxd8oCPx2YzX5z4nMRpIo2JvhlvZcO3v_MVw&oe=6AB3C85B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_5Wig8Ik0gQ7kNvwFm0mZh&_nc_oc=AdqxbINfzBKBi48x4rWRX3HJqbEwNtsa01H5ZSTx6-i1zMO8e_cp_nlgceGMD5uZ9pU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSWLmq5O6CD0LuLCbeE3amQ_Oo3HYnOmBDUzYzUfFb4w&oe=6AB3E460"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
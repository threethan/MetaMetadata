64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDm9q_R69qYQ7kNvwGruVTu&_nc_oc=AdplatgPIQsRrEJjOvDl9mp-6tbhJ8AdioPY5Zx-sWyugSVh5eS6S0AiT9WRDGP14L0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi1t508ohdXNasuWJLEj-qjagEg76R0pH2J4TRgEroRg&oe=6A7EF01C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw33mA9rAJsQ7kNvwHYPqr4&_nc_oc=AdrvnGcUrXEL9o9EyMpMorR4lE85IltmKXiyiOjf_VX_0V5nbfuBPqClUkyWmkFt5c4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdg9o8pI7Z4f2FLLDUYMY7cTWNNu1bWb8_PN7wDIdfdw&oe=6A7F0C5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7I9tq-na0cQ7kNvwFkaBKE&_nc_oc=Adq8jIaj0EmvQTxTxTmStPFrhudfPAK3nKvHzVgOCp0q7ZNK8TklPNh5xTr2or0HAbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3j-Kf-aXHCkjmX9oY9hP8O74wPDQ_T04WlUwn9MLK7A&oe=6A7EF020"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
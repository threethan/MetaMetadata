64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAxNMuPDPq8Q7kNvwFo_Rit&_nc_oc=AdpaOvuUQCTvhe_-KFBNiN7ApNxAFW8LsksgS6ZbM0GmZGpwtG3jMzV_k5aqGmC2oVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcOPPpLemna6haoLYG3F1w8vfPMxS2ShmsxmmLsHZzrA&oe=6AE9F1DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WoU4G4eQTsQ7kNvwF8WdhE&_nc_oc=AdoZtCOEuIWqblaQ4uzNaRlzTc_HuWnP0EGtdlcFgfu0iK8oX_GZDj1SOH3iYRN9BWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGsFAPzRiyIShCb4XaMwLz3IoiB1p5D1g-6uuee-6TVg&oe=6AEA0E1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a8Z2cUgF-EQ7kNvwH0qflY&_nc_oc=Adp_VwbuJFkpE2yYweePtkdU5XKDhJ1W-NmZDNeqSpo9sR1w2DZYSLjapWqobMPvN20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUiLaLOAuTjCbaGNc3BHoXgTeXqtuuhXls4rIZLCBVbQ&oe=6AE9F1E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
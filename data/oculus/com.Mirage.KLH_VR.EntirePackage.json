64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrhO-jzM69UQ7kNvwFe7Mzh&_nc_oc=Adptbg8YJ6S18dUU2J5MHYoX5JTH_Wz0VKp7tFTblAFOjmfe0jbrH81DFGaDC7JUQao&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qd7plkf1ktiTArlZCzAF4vEXosjap6KJmnEAvC6RpiQ&oe=69E245DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhiVy1Y3mt8Q7kNvwGJ2KPi&_nc_oc=AdrJwJ3KapsnWTk77da32RXg6Vol3gXsFxqckckVlrdZ6Zy93TGZf5tgVRGcqQsgfhE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ER2O03w1k47kBdztnpabfsSv3ZJKquFrJbG_YrqjK_g&oe=69E229DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3_orOMWItUQ7kNvwHbc6cy&_nc_oc=AdptCs8zP0e8G1Civ3lJZScaUxm0RxflxRwntJirXqChUwu7nJtuR98yWmQqP1DpOeQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SxFw6n2lfxPk1DcWQx3-vszZpG3pynPTnmKjvsKh9gw&oe=69E245E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
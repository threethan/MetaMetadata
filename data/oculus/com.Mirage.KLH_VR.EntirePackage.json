64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dHo9StRtP8Q7kNvwHq_vIv&_nc_oc=Adrqd-xXr2CD6-IkDlapMVybPkZ7g3g65KKp1VsBgAlER_RgjynhzPUQTKMMQY1WAOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2SokgtAOBSGkvNQTBITFC4xtuAEvlYBF1p9Nz33x7zw&oe=6A491ADC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJZRrF9I2uIQ7kNvwG9XYoZ&_nc_oc=AdpWaANgD1lVDKpLMB0MzlUscdh0QNIeG0tlqo-0hLbhsBIG60ihantQpFY4X0EwHAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrDtPKZjda2Nr9tE16WIjYIv6NU_F3f1LPyq8zQWfbCQ&oe=6A48FEDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eu6ElEgKEUQ7kNvwEamSQK&_nc_oc=AdrAMdiBaa4JnTvHcYlfzOWdZAwnkk6tLWQiTaSl5RciWCSF5191oGYs-iFWK_kdwsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADKqwqeRIxRR0EnFrREi8mI9kk2JXKcE5Gv7Y4bed6PQ&oe=6A491AE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
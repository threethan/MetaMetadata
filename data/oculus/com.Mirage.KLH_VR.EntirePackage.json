64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmIhlFKIPz0Q7kNvwHw9j0f&_nc_oc=AdqWCHgzeYIzxSsFuIeLBgojtaGQeslT_rHGVudiv-ENjMgH48EfJBCL6Q63r8R1PKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZOKGtgX48wZ8GDIGVCNFX6Izxc9si8uE_DTgQCvZeXg&oe=6AEDE65C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxSw_n9epoAQ7kNvwHaDKKZ&_nc_oc=AdqwC82dLh9gerDya9fHtNf7ffGye83D1L1T6A7M0dDaO3U2tYqh7WZ1Oo56JmfoYxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpeo6aU05JJzyaD2Gu37qKc7QkFzEUt5K_H8iSmHyI-w&oe=6AEE029B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUoL43yiUSAQ7kNvwHaZ-dV&_nc_oc=AdphXqMwOGYo2Th4nWmdrt1815TsZgQDIp2uyoIFD859mGTmkE2mZjsCi1z7rvmREv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQygdNtQQGe4XCoUaMX42PVhq0DmdGgvP3tqsxM6EZOWw&oe=6AEDE660"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
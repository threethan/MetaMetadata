64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbnaQy_qkg4Q7kNvwHNtBRj&_nc_oc=AdrGRtNImG7x5HXSyYn0SKkOjiuvETuRXRnkfYiNxoko_VhMwJLeHiAZ9MNbWD4QvIs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYGkbFXDuamdp8lFFDmMk4olq8Ase4VzPJ0odVObBtjg&oe=6A92B69C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBf9O3xNpVIQ7kNvwEVvCPp&_nc_oc=AdpH4xUb9cxKV5ClTlvdgEiHk5dxqJR4qXFyuXzA6tvxJqW98TKDNfDasXvrvJUaQ0Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFIYdyCJJ3KV8cHxiNgO3yPn_8fFykJUM0YkBhu_KuwQ&oe=6A92D2DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7D045tymDwQ7kNvwEaOICS&_nc_oc=AdpsBtk2fufyNrKf-P4W-h3dsUXwjDbA9ZNlZNzRqh3k-hgwN6cw-An-XCZmuM-oqVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8NC6T8erCF2JPHzFgsN1W7kv6BKcpt8GOQEiVDR48-A&oe=6A92B6A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
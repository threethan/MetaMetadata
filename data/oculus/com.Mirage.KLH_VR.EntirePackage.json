64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGrGO29WajcQ7kNvwGYEyin&_nc_oc=AdotynwUpviVXPA7087W1xcS8_Y2Bj2ZYtjLtpfFRqHtPE8wDahMHXjCqc-1UW_3H2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EyX5g9SE8bNuXhcXs3AIIu5VKBA45OZ3x1RRmrwk8mQ&oe=69DCFFDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awoKV0h1bQQQ7kNvwGCsd6P&_nc_oc=AdqKaUsK2leyEC_zFfkd_vadINJJVLjNYZwwSCSEdnCcj8o56W9r9uVh1z6wTOkxQ0k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xfU8zT4LD8zXe5mNIPc8Q2Bp5tD2fVAjAj1QLdz91KQ&oe=69DCE3DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2Cl7-GPxIsQ7kNvwF-Eff5&_nc_oc=AdpkYBMPeUx1ZUfXlGN581fyGDjby7QTP6rm3By8CfNdWK73lz40dOetWUve16DRQ_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TxIUrMYZvZtq4NyKT34tK7_3vlmXipz7JNf9Lz04K8Q&oe=69DCFFE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Usq5Rcxyi28Q7kNvwEY_uVC&_nc_oc=Ador5CfPex2FXwqzxHr8r4jyQxL_C7NNKLlAoc8HSpong5GU_F6RZrVkihY43SAzhY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBac5C6YwDujcB8z1gYdDBoQKQeFTYecjqjVZIT3BQWQ&oe=6AE74EDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WoU4G4eQTsQ7kNvwG5ZBKq&_nc_oc=AdoQEsFvDY363h0PfhiegXjOXwurf8XgGHVFmXIO1b4Wd_ScxU8A7JUhMryozv5T-Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0bnwNXF24frHLxSgpqEknBq5ZlahDjBt9uDe1LzFXfg&oe=6AE76B1B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a8Z2cUgF-EQ7kNvwHQdcJ6&_nc_oc=AdrzovF2LEtbsrbsuSucMJe8AoV9R3KRmRWxgNIcerwEjtDxercGIwrTdgaapoUa2HY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRen1z3QjT3IjHEq8tUfRU_Ytg8kg2aORVBiemV9JzUNA&oe=6AE74EE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op_O_REtjY4Q7kNvwEf1F3a&_nc_oc=AdplN_4zSng9sTUyiTfKUy78jVQYFZ4AdO9CqqUjoJtNsyGb7rG0Qfb66d6XnZXX7Sc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tw4ZlW-qd1F2PTVkSgDgVvb9ZNrB58xzeFHKUYPqCiQ&oe=69F4BADC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFCYvhBNonkQ7kNvwGAWdZO&_nc_oc=AdpD8X9-xXmI4nNH3heMjpwleyW3q7H3ACcKC-p_GFovc--aQPCQn1AAfUqeEYqOz7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0B7tVCdVr3hSqYJlxEWS2LIrI7Hy5HG6WwD1yTIug19g&oe=69F49EDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_AzYlA5G-QQ7kNvwGugTv3&_nc_oc=Adqf9oViwwP0DlPsm3zRPQWvHaennvwcL_5N86wT5gqGyXLMQ7wH3S1y81DHkHWD5Vc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YoVmfnh-dsZF0dJimsPCKvX5VKwCTeJCXzJ3_Tx5Yog&oe=69F4BAE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
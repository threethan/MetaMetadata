64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5Iwbpq3wEgQ7kNvwGrfyec&_nc_oc=AdonKBPrzbhFL1K18wfIMkCuqIudL6r91wUodFBsH5GySnF7JE-LNBkqWTgx5k9ecMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tbMc20lQNsAH6QcQrC7hPKV5bjkQepMVjxv8T308OFw&oe=6A048CDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF-YWXZvcjsQ7kNvwGbXHny&_nc_oc=AdpPBkPblKeLMfm6KIhKOFKOTCmVw-UyWZY3je2OLs-nOtqu2TkCXbTm_k8dr7TQGY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HDy9FA5i3QLpHwmHsv-Xx8AhcPWziABSg_BnrylTfqQ&oe=6A0470DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuLz6ml119YQ7kNvwF6Foci&_nc_oc=AdpHe5Squr39C_unBiWCDFFLTkX4CxD4pUwfiRLkXz1blR1QsPFMOJhtEVEOcx8meC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OorWAyFHD0ptLKskv_OmAGNyNMDog_dqwVQFR2nHhHg&oe=6A048CE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGrGO29WajcQ7kNvwHGYzbE&_nc_oc=Adq084O225L8CZ1yDjtwg5GGxO27hlSu0EVlSRc6_I4nqW__qBsgfTY3sd9aBvsGEfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D0uEIje07Uojiud6PxL-UA1zAjsLUCf4VkARDZkPyOA&oe=69DE515C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awoKV0h1bQQQ7kNvwE67q06&_nc_oc=AdpQe1PleQN12zHfOas_1iPczBQzrmZyX5xF2aGw7X8Skre1f11ZKaWnSTvEAxgewY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Va1etuIo6S3v6atuRmWruxe3VAG7KajYl_iRyg10b0Q&oe=69DE355B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSuxa2W4F2sQ7kNvwGJYw7m&_nc_oc=AdpB3eVvac37J6HYYCb7v2CgsGF-b4UM-rRBxhnn5sGRZvnQD6oy2zy2MzasLweGM88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15zScd075bvW1y1T5knJs65XGTQwL2hJ4L-1T15u3M0w&oe=69DE5160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
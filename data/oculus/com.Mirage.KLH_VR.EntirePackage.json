64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYJQyHU_LTsQ7kNvwFhXuDG&_nc_oc=Adql2bnIBgK7nfpoj6RnnEhO7HIUwd3s5la5Lo97t22b_TZYrGS2je2U9bWUxHL3b6A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9wpno5BEB6HveTy5lwJeZGhA1jKM--0228EGFFSX5fA&oe=6AA01DDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIULLAOdzZwQ7kNvwGjlnXP&_nc_oc=Ado7JYR5o0gyUZYXKClKESV-dFEVwoXsEJkC5UP7Pz0JYKDvejiAhVfW_r9hwxBCJxU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeD5Az9s7LVLlNK--pKHic3qA9Z9kvwjsvCgIGE9hzeg&oe=6AA001DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_uNV6r_q-EQ7kNvwFpi70y&_nc_oc=AdqFvTCEg2jf0etVhDZGhQ_iFau_wXqyJNBXOBlZz34T7-x24IMS1UY2K0wQsz1ngRA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJejepIfKFjwoQT7QKJQxynmb56YuCMhSy1hFXnVdbezA&oe=6AA01DE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
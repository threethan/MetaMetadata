64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP_kd1Y-C2kQ7kNvwFfo0uF&_nc_oc=Ado_rig5Q0QsNMQD2BQyt5cuIM00SweXLm33yM9AlOK_Z5MGBTPtIUDJhpEcZe0TXSY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZehJLsZH6gf2nV3sjddwYpAthJSjvMYQCyi5QsZiJHA&oe=6AA16F5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orInKS8RlmEQ7kNvwFI2Z1Z&_nc_oc=AdoSTgNMR28t0fTwb3jCiD3TjrAHK8BVnA7OIpdvSzc-uTXPNQZKJ1mrCQIkmThI9dY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyhgg1bUMtmhJ1zY33fpPcox5q44j2FR48AmPNVsMbyw&oe=6AA1535B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_uNV6r_q-EQ7kNvwGgv9GH&_nc_oc=Ado_jWzyEWhkvk5UMM3EfFcIWhyMxdQZyKWblICaEky7JJPCNVEN88bIrpdeqHAqdOM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsMfHvF6E5uW8Oi-A68IXuCTNUPyqZg7a-jce0olymgw&oe=6AA16F60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-bX8xtPbewQ7kNvwE28B5z&_nc_oc=AdomYaQcggSHKU7OfafaWxZcSOuvDSeEY8UmTsl5N7ihTmGi9huGk3G_nT5w9JoIF4Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r4ZGnhjzNbMdY28BGnmfgEHArkyDig6Li6kJPhhzfCg&oe=6A09D2DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3RZYjEA3YQ7kNvwEoP8-R&_nc_oc=AdpU-GJFlcc6u26XRq8AeCBak6913ANZ-5V8WR9Tp1z1VjtqcocVt7UJq_A96FYMXNo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63pSITKX1mwV1K3QkaTDnIEGH9lGuk1kwKuaYs1_E7Zg&oe=6A09B6DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HFkF8b6zlgQ7kNvwEy2rnq&_nc_oc=AdpFe5kTUco1jZsvpEamWfHhEb6sp71KdGUP1dtR3amsc9q0ZuNk3RRjP9K9kTuuvQo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ubhQiJ2pxTlN3Vadc_-TIjDFOylvfOcAF10MwPKCE3w&oe=6A09D2E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
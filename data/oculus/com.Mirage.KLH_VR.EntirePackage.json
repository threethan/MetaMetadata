64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E52gWWFRPJAQ7kNvwHU48ZJ&_nc_oc=Adon3bk3xDEluSZLBuia7DKthHHn0H2oRRSXweg4iOjj6hgvVKINpE_-XSxsj1HQcvI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMJY6u5-qo8tfFt60lpY5Tk9KVCRwqUwp3Db8K2_Nypw&oe=6ABA7BDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqdOMunkbmUQ7kNvwFBoxb_&_nc_oc=AdqoQS-q8jV_lTOqjEeb_1HwpRaL24yw6_OF35E9Jzxh8-9f5F0lkZ9b0vg0P0NdKGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmHKBPhVlfdrn-VY6YPkni0qfAV8es8hn7BdPd_Kltuw&oe=6ABA5FDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHAOK0UtNGoQ7kNvwHjkir1&_nc_oc=AdqeK3qiIlifjWd3InDWw1Dq1jgb2Z13fal6kG7sgS_5GwPSure3M_4H_kxURg3seD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZBDOTtB-VvVmHSrI29VdDu-7e1DU5Px7C9arnvuECew&oe=6ABA7BE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
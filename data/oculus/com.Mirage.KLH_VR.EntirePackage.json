64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaEFiUfgUpMQ7kNvwE3lqvH&_nc_oc=AdrC0rGayDHyHlSu8h1eB2Er1j6sQRvvC04eLJphrmMNrs8mQZG9dt5-wnvXJ_sqU04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzCHUdG5CWKIBoUgiWsfaXu5LIfImmROjxEC3fWgPe9A&oe=6AF1DADC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae7FABL2t3cQ7kNvwHyXLWH&_nc_oc=AdoSTgTV9Gofg11mN447nH9lLP-t1wUENdJvgktu9zyIrUOQp-6nC2WG0fCROvJStH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNaXodUCYBUU8vty6NAau8EttL5jOcSZS0uvMdA-E3cg&oe=6AF1F71B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CSEjUI2stYQ7kNvwGvf8Gy&_nc_oc=AdqU-PVSoz1Dvh4o1_Vh4GnEPmBvIclw-J9hKkqPPOVA_pvDLANw5qKN8aXCm1Y5xDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0eBRMftlcD9lcbGuOpIBUMFvFTVhguV0d7bJmmYG6hg&oe=6AF1DAE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0NBZdp_9TsQ7kNvwFLjhRa&_nc_oc=Adp7zJNp8-zydcCFwKIazuoRVdDHcVZEufg_JMm9iQcq0gvKNj_k4-_n-0R81Txer0A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIykPAX7FyVdahAEQpiYw99w2sAchTX_m4JQE2Ka3ik5A&oe=6A9AD7DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL6zKAkxwpsQ7kNvwEe7SVJ&_nc_oc=AdpFxKGvIFBMTh22b85sKIZI5XTCArvSLpbgVHqpdte1l__b-LKeo6Wx25VC-vIXNkc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_5KtgfL_eApJysfYtoJheY-XwS7aAa5g-cSDQIcerUw&oe=6A9AF41B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geDflUu-EGMQ7kNvwFHSkMl&_nc_oc=AdpwMPTuADUASh_jgShDr0S5DA4Q287EdRh8l3pJmbk6Ge0T4chI_CZoPkUZpLWyj0M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXfpvJMTn164zyKu-lTDkI7guxF195im48pgVuh3Z08w&oe=6A9AD7E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
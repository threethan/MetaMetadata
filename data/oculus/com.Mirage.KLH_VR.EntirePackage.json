64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3k_uYapRzQQ7kNvwF5FkUw&_nc_oc=AdoJmqkwNn_xqrYmbfnEIG5BpLfUKaQqaQSUuOOhhY8JMt9JfT46H54O22Zh3ZDp94w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yaz8fnCBxZDaMjViGqN0UK9mkdLDDjcgNHGNQU8N9qg&oe=69FA00DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOL9y0N2lEoQ7kNvwEg8uTn&_nc_oc=Adr3GTgMpVPTAJzX_lctuj1SBvfWMC3vbmRjTHLjqnPjLmYCujed8OtGWRzahQyUf80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WdAfDCPRQqQ-FYoWNDzY4k4Yo47PWzCeMv9eQd-yWHA&oe=69F9E4DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qj9k93J0iQQ7kNvwEwXHCF&_nc_oc=AdpPztZPD6duPjzDySBA5vcF8OH_avaixdErO3AGqcG1LItMXA0WTcUCYYVmy1dVakk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XjB-G-34TFEQvo9YH-NN0gmpsUn3thTYV-I-CmAFJmg&oe=69FA00E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
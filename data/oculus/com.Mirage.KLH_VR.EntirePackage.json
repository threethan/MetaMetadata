64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9TWi9aC_YIQ7kNvwHjKEj6&_nc_oc=AdpwTUhtBYSQvgvP8tFrsHUS_bz7PlJh0rusPKMletskGOMgyGe71YmmCjzPbVi9CAM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj-yGkcrQLSS3HLVTMsY1skOO4JhexkB5ns9AgLa1S7g&oe=6A81931C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8imWfgACty8Q7kNvwEBVZqH&_nc_oc=AdqEgrWobSxRLRIVqaIWn0y-rqjCQpG4GDgUQiOavtnG-MfDtENmhdxuxh6b5Nk2tJE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEguKhRI8BkN65T0pEXB_5a4yg8P54RG8LQ7dOz2nfePA&oe=6A81AF5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjHxh-QdfxwQ7kNvwH26MGe&_nc_oc=AdqG2TCTbmyDHtUyA1zI0t6YnzWvzYy7ZyCVn9YD5JnLvhAP1P-z421X01xxwp7SEwQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-jIE-Vx7Q_dyzu5bdhlm7Tka5nwgLpuW0GXRIc3rdPA&oe=6A819320"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
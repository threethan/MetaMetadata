64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmIhlFKIPz0Q7kNvwGg1gHs&_nc_oc=AdpmbD94xdFr8ifjBb9rnEIQqhozQkMm-TXsf5VhaVF7o42axV7xqS7BbffpH6eJqYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZKRCFg7zP3Xpoz8uyTKSLGxqv9-smfqLBgNObBbsxJQ&oe=6AEF37DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae7FABL2t3cQ7kNvwHzVx1U&_nc_oc=AdrHaAF6oKw7Ew8pKclrD4R0LkTOAU2uZtb6TQUVaGoLA16qJ_DYTKEBniZwMSIA4vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_O7acnfCulY98a7Ui22j74-4-hOQPX4C5_3RyXqYyEA&oe=6AEF541B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CSEjUI2stYQ7kNvwE-pfWe&_nc_oc=AdoKeRwdmGNMeVjZlSESHw76ON0ietu4qZAYHToDJKKX-hVUoKeCJRlBRecaKaRRoUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGwXq2NWPZrTRd4jRfDtcCB26QmjqA_a0Zwgg07uyRtA&oe=6AEF37E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
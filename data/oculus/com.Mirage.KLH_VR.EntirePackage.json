64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zdHtsADq5wQ7kNvwE4uL2x&_nc_oc=Adp9UHB9Uc_Fh2G3nHPkcxCfhmJ7_xDYZ1K33C5s6pcIJCeGPO3gXS2wpZd7il0YFnw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4mUFN9YRuJeUk6vuoZlTpKCXGE6LzG0BnZQKa-x_DpA&oe=6A53A6DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv4-2xizuhAQ7kNvwFl5RPa&_nc_oc=AdrAnnRsAaaAXA_OwIgyQdfNtNqb5ZXC1ms9o_9ggtYwXK7gYrtTZwPEI8cYVMSj7js&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUG2uXHCyKh8g1t-Z0ghRWg9amJ5LH4JcBtfWnWIm4kw&oe=6A538ADB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt2C4oMS4gcQ7kNvwFGQsVa&_nc_oc=Adp1FDgtLZuX7BdDZbGb2nz0VbM3632pEapFai-ZQovtbqXu6YVCoWwJbec5eaN1v_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGxS_GuZ2miUBO0ARZkABrwFZD95aHbbdF2I14Vs0sbA&oe=6A53A6E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
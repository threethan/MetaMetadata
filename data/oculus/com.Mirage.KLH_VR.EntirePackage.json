64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W_xnD7jIg8Q7kNvwGO7GJ5&_nc_oc=AdrcKLIz2-7MTdJomd08E6SULDqclk_KBziYCLsxjsHBDUUkMnmV3-IU2FpUlj-Io7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YmUibxAhRkj4cBgCZznPq3gxx3fKGS3c-XVnwUlVvAw&oe=69FCA3DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8t8kOr6RJEQ7kNvwH2OJeA&_nc_oc=AdrGaUugi2qBtZYh_25PSyS6Nmued00LThRIWpAM0_M79wP_PTsnjStqp2I4D8RqrTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aMZKHy5sCzSWV3sAASgm1eCzCriUGg8SjPFUQ7TP57g&oe=69FC87DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qj9k93J0iQQ7kNvwFH_btn&_nc_oc=AdqXYBdclX_EO0MFUndEvG3mYrsffo7R7qY7j0ZC-gCh06Ark3DcoWPPBijqCq-SRcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RAzjTBBGV1gZv-K5Wu7am8aHdtZKpkDzl7XY0byWCHw&oe=69FCA3E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
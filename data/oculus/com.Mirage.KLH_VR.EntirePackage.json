64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLhBU3S8m04Q7kNvwFeQQjg&_nc_oc=Adq4yCLXOa14tiFqtJy2kLbwcaXBCNNFGtZlYQSwW2MN4ZMM0JQdwkEHOUICLH6SB2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD5jT8N_yuOgPes-nzYvJAwlnBhB2aqYLkXbCgmCbmhg&oe=6AC1135C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwa9q3ff4GcQ7kNvwEQTj5K&_nc_oc=AdoDQaO8BwKXg27jf7yu8iSinnF8FCqnR8QIh8aJuTWdhI1o-PnWg7iWO0K80PqPkvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2HkbFcAFpqs83EMxtCySxXPx-kH5CAt75KL7exiS4UA&oe=6AC12F9B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_RYlN0KioMQ7kNvwHBiDl7&_nc_oc=AdprqUYbmW9yVeX2H6PFQeiY45BZ3WAzlLqOXWf8gU0ThQfN3XFVgD-UyNKBKukVjEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlfPqg_DSR9oZMjMYb8Q-FX03_WVZRzZeNdQO6eIVh0g&oe=6AC11360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
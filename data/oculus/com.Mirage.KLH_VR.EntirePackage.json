64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W_xnD7jIg8Q7kNvwEn-G0m&_nc_oc=AdoZiY4XlYZY_A7Hp8V1X0vEGq61BD3Kuj8V843DdRYPdPW5ncrBdH_hxmnOzg2UVQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IkfDJP5qdjLAhvkcON0Tu_5EdP6ZDbvl2KOa-wWZhfQ&oe=69FB525C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8t8kOr6RJEQ7kNvwGwkn_m&_nc_oc=AdqIrorWxzmeD9UJBfYjPcQjAoaK_x03W3xk02Jf-MnnNGANdcsMYixPDi4uERDXW2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62jnN7W8BMHZlB65_LCieNGTyvTX2JUvR3pfAXu7mrpA&oe=69FB365B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qj9k93J0iQQ7kNvwGuDurC&_nc_oc=AdowxH6AhEtK3L7ivxio0nHUCJ_wRpsM_Wg_KvWM_xyciyLyiKd80hEqbxDupuWdzsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yqEU4gSFvQshr0bnBTRNjmh-k7R8zC_PUGf9Jd3x1Lw&oe=69FB5260"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
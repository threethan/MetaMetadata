64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCc-MQyrjKgQ7kNvwH1RnW3&_nc_oc=AdrMrMD3Y_GlVrsAeucckIPq5Uq5hFNHMr50c_QNuSztQFvJFrEKT0u2Oi3srwgD_5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKKyqwqfWinpFYb08Nno1gDVYvksYnlXXspZgzRrSzxA&oe=6AA6B55C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtmJIvLHkQkQ7kNvwFlhTyV&_nc_oc=AdrvXPGfQb-UK4j88UiYNmEf2quG51lr83fU7D9OqD7LndoJGs5MZdD3YRPNRUuOKYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9Yx6leArsYd8qEFo-xXInlgx2s1p9223csUBkkDpxLQ&oe=6AA6995B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWGZ3wcPwoAQ7kNvwGX3W5C&_nc_oc=Adrr4BB7EN-oZBiuL6c4viRCy52H1QRc6zyDEOuNuEvvdj5FMTgR8uCuYrGwYcr9PSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCye4id7Ql4xmckZ-FkyYiiYLinm_-b2EpFT1TQ6ropg&oe=6AA6B560"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
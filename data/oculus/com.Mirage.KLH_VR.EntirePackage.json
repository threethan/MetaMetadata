64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QH0x3Oi_0YQ7kNvwG3SXar&_nc_oc=Ado_JDFhhoyVcEiFjAUi5nSTkfhAZ3VBUSkekeq8WP62ITSWfEY0KWzyQEtO3MjkcRQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGduS__mGGW2HZUaBGqiN46jllvtC1ZGL6peGxYkza26g&oe=6A749C5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhfYBpYyfLwQ7kNvwEkf9dS&_nc_oc=AdqdrtB-nxZAD3wBUNMeIVOSvx58kOs5ftesaBEZyZYsMOUAfABCh5SeV12Ek9YaKOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg7o5dl9FjnY4JhNPExs6SCpHVDuz-vXsRH0LegrPwhg&oe=6A74805B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybftMdwx_ZcQ7kNvwFV2GrU&_nc_oc=AdrRJgsEF-gOg9PduFNpFBSKdKZ2vOQu0lXwuud2U9g1uvHnfnVR_Bplh2xeAu1o2Gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeDiJbxQe47hAB7e3RFeJNje7wyTHBmO7lOrA-8K9wTQ&oe=6A749C60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
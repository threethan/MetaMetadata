64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFFFloSuhEoQ7kNvwHR_KvK&_nc_oc=AdoYWrUxbjelwNq5o7mB9PUs5UGFv3aqnKCdpl4IeI0MuFQhSWBXaZJ86ySDh3D7Tu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OdlKRwUWsiAqFiU4sw-BTmQ0VtMvSnDlvkVsjnN3_gg&oe=69E4E8DC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkzlcrgR-BYQ7kNvwGK6UOk&_nc_oc=AdpLrOi4mGJ5blY5uF-LdE4Vbdx5KyYQl47Yoe6L3dzPKyL_B00H3On8eMdlHN_pS0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oeFYyFGfKZGRCW0O3YUvd3qhgjpxQoKjmA1OSQUvX1A&oe=69E4CCDB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3_orOMWItUQ7kNvwFfMluS&_nc_oc=AdrYJvSMbr_L3v02hvsLEeFLlgIvY041D494xpqTIN97dx-nVoUy6WCN6LHugDHznj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27Qc6je-bzK5UL0eckGg-96RNW1MHjYJPvufCaVfKyLw&oe=69E4E8E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
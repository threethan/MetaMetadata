64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLhBU3S8m04Q7kNvwGpERsW&_nc_oc=AdqEJGm-FX9924gKXG3usouOpqThwMINE1oADXqhl3CH4VCUr-W0Gyw-D7CL_euUU_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNIW47LwocSgsVHK1_uf2OxBEEZybAuDw60DZ3FmQQ6g&oe=6AC3B65C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYIKD-4XlS0Q7kNvwEgJzN8&_nc_oc=AdoLRceK_TGlAueUQk7fsc_UU-Y801ewd3-w9F2qjWcHGF4yUCLhP48kh3jYLflHc7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3_qpkxM2WZ4KQdyfimsrmFjvtv-jeW6DSYlqxE_FrgA&oe=6AC3D29B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcLg8kAy0IsQ7kNvwErd8Ix&_nc_oc=AdopMfwXmYowVkgf_TaY_dvAEup6-1qCDyceW8fpVpA62oPrDD3PNu9sU7cKkggSqOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGC_WZ0HqUEaJivmAPmeaUb8ajIbOp-T_VZYH_fbyF-Q&oe=6AC3B660"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
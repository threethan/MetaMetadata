64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYJQyHU_LTsQ7kNvwH2PEB8&_nc_oc=AdqnWWanJY4lOBF2crGSLGkuAwYct6EHLr0d5sPqBjLGAPeCixMA-I9RKfs5wFkktF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn_PiCKXzXNTsLumBMpcEkTTgWyKzoutQGIYv2jEBSAw&oe=6A9ECC5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIULLAOdzZwQ7kNvwFCRniP&_nc_oc=Adq_dRppj-UK0hVCEA5XSuKngf7Ks6FLNrM7LwAe5FqdOiiF8l5Iq-SDZx62jPlVzf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5ez5SeFLD7yCYSrahDnaJNj3tWKRmVwrDgY8VyuI0dQ&oe=6A9EB05B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rlUBVuIchoQ7kNvwFrjcTD&_nc_oc=AdogMfZyVP9t9YTMrLtqcW7aLHwb10MF9btd6VULim0FTGgBNiwV8ZAXy_t1Ob8_YT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBpuL1SiMfxg1ai6k3Sg_bguoxA4OYUqvNXn_35C81bg&oe=6A9ECC60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
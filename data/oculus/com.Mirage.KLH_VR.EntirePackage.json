64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCJSKrIPGxIQ7kNvwGwbOU1&_nc_oc=Adr_RBMpFfSkKaQNw6vGq7vl5jZQXVKAas6ZfocmsPj-vEzqs2_NGfKuEdegFGaxgxY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mqmGcs3eMIO2fIi3qKfkbkPBw80RwUgzjtaGTF8fsLw&oe=6A300E5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LdWHiVKj-0Q7kNvwFQHL7n&_nc_oc=AdrrBSV7sNXsvD5Q3jl9pb26RShs96kSbEmUH_3a0ScxifuSoV1U80Oe8SSXuSAYJ8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W55951a4KDscm4ZjFhLCVD_s6-e6uuLBvN95v5lUmqA&oe=6A2FF25B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PG46laMN34Q7kNvwH-ZVJt&_nc_oc=Adpa_L8myfkl4oxW2WwJp8Ls_087LCcnd_7Nq77g-zVY7faEEVuVRJhXkJiv2NR95nY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aLcPm42zI5iQckKhUkigDlXc539F1K7_UxUAI4hWBvw&oe=6A300E60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
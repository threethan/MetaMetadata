64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybfd38zTAG0Q7kNvwGgt2a-&_nc_oc=AdqzgxGNBtqTZRXGp9MaI1RztZUOh52rSmmUrAC9397kA_MI3GrWAz4mPKjH-fzeyys&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb-zyr3pR1XkfTjtdQABKa3dL0HXRFzhsDZcCNLspMMQ&oe=6AAD4CDC"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw_ZJTW6FxMQ7kNvwEpCoFo&_nc_oc=AdqP0T8pF3GoWWUtOyBu5vvolhFmQO45h3_aA6Q6f_PEhyYqIHRcl9Mxj0tVCW-rHi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaQAyh_BKI3XP47eDTIquWeXgZQGgEa1p7w-vTcqhcQg&oe=6AAD30DB"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOvxKJo9e6oQ7kNvwE36OWw&_nc_oc=AdrjnwzLXtheqhosL2G9qpnFsEaeJSgQF9AF8X26Wb3_nXmwhMDuELa1fLEum6TkEO8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLERPFkE_C1JZtodaxZY2TPUVY89IgyP5K-nCTkcEmbpQ&oe=6AAD4CE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zdHtsADq5wQ7kNvwEN23TL&_nc_oc=AdoeLMgiNRWUjenWTgzY_eSayF5Gw56DaeUvp2ZQTkH6pSz_2lIiwd0ni232O92Vq-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEUHQc_qeA7hG9HsLBaW_HJn5uKGAqJ4_ngtzU5Hs0Xw&oe=6A52555C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv4-2xizuhAQ7kNvwECrCSw&_nc_oc=AdpRyhIk1_4CcPzfcH_3W2F2Tl5QSgxCVBsi0GzDBbp6PByy_LhjEt7OI1BBWYHEuuw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQjbWNiQJptbew7n7nXI4T7g6GLTBgDYu-fLlm70671g&oe=6A52395B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt2C4oMS4gcQ7kNvwGssRxz&_nc_oc=AdovQJxBTTMaWyfkKUzAxeWe6FyZuj2hh6DA2OTr7t7-7r2sDzLm3uv0Yi1oUgLtJjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRYslqMoFmyHSAG96mBP1Wn2Li-E4okzZVcHX8WN_gbw&oe=6A525560"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spGFs6BR0-MQ7kNvwFOU0lA&_nc_oc=AdoeabIX-QzbYmN3WxmoOjyLZsr19oFLWmnF7Y1QbntUTCTLFy3iCmf1m3keovsUdN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKbYIgc7AVWm1MZl-4SOR-JJSybUk2bZa5BOizGTJ7QQ&oe=6A4D0F5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJZRrF9I2uIQ7kNvwGl8kKG&_nc_oc=AdrYezYd0wFhKsUxwpQHXBDz0RuGkP-hnfIdbWBUYw19aREA9ByPBq3NUDFIrugf1yU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9eppmo5_UYtP5r1ZPW1a8prKF4X2Fw5AEfCxZpOpf5w&oe=6A4CF35B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X98MZTIqvzYQ7kNvwG1LQyr&_nc_oc=AdolmtUBaIGmHpfgdWnUdigUaUy74cBg5XfSCS92y5kfT0tppyaD-4j5WBCytNEaQHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbdKbuih35HbL5iJCWhShKRVpGJ3BJ8MrjdH_b-AZJHA&oe=6A4D0F60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
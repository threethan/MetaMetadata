64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn19xIZDnMwQ7kNvwF9SZEc&_nc_oc=AdqoxJJQes-FWeRlUP6L8CZE2RtlgxttPmApcV_Bb8g0LZvhpMoTKJ6yJR4gJsqmxYE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmx2yvGwR5tSkOJdgOhopKZ5EbiO9M2E99QpeKN_ZNkg&oe=6AC8FC5C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuLg654bIpcQ7kNvwGtQM5b&_nc_oc=AdqDqa6u3GEr6K7Na91V0cZ7Cbjuk3ighBsV3BmnLnwwASRRY1I-Reo5QdTMebEVICI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOemaTu4PbI-OPZLtgd8Y9fNEZCID78hsj8obxDAmZqw&oe=6AC9189B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3dBXIAhIjUQ7kNvwE4L5-Y&_nc_oc=Adp9WxyxVI8lJ26mVLKwX_C_LlOn4uBcRBwfQw4BvNWgXzXze3fS_ynQxOj1KhRY2VA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3CCDTEmF3PoiubPVbX9XQDj_1Em4hUWSRwVDDRjcRsw&oe=6AC8FC60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
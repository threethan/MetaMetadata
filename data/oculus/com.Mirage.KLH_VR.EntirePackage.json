64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoY5NNqM4msQ7kNvwHxgFJd&_nc_oc=AdoIYUK_dvo8IsqzwrFgV3DYIOSJib9_l22L1inM__E6s6pPS-J1eclVXXP_Fyp-F28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgirxnu0mk61hcwBsbUbYDcYkZJcEEvjOv4R7Jlwp5ow&oe=6A6A105C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8WxFmsdECQQ7kNvwE_q0Yd&_nc_oc=AdpR7cBE7UipYpyr63uHFVa0u1pNi__PF778---4bIshdMxnbyoQi0ZZAtkUU6ho_d0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwKU3zk5n5CLgSdR8FYoJ_K_afeNkTSzL7LG56mmR69A&oe=6A69F45B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV16eG6Xo2UQ7kNvwFAmlta&_nc_oc=Adrl5mp3Jz6JdpvIZQyXTRRcZYEDEi5egvzaVPiHTNx3e2w9_-WRMLe2FrdG9ZK6oWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV2tdtSXKoOOyRBORuKb32Pt1Zt98pgEsXk2HRxXwzmw&oe=6A6A1060"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
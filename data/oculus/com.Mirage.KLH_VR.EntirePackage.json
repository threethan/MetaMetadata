64_415212280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op_O_REtjY4Q7kNvwG6jLUC&_nc_oc=AdpaoQtaJ03PB2bfmansArSoapTHWFdBSJlVAt3H0guLWP4iMaAOqgeOUde9stX82O4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nKHbADYSnE_5qytZAs-7elxHfw-5MEiIAKoOHSyFSXQ&oe=69F3695C"}, {"file_name": "migrated_image.png", "id": "2815411525353053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_1057519040990488_460004055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFCYvhBNonkQ7kNvwEGvv9G&_nc_oc=AdpWO3_NSpFsx67kJk5KP0smWTaY4NP_UYX2RSksOytf7hhsQ85MSx1lLlf4ee4jtsg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YwTC7bZoIcwW1VqRBC6anvxceTSvOI7FDUscPo37rYw&oe=69F34D5B"}, {"file_name": "migrated_image.png", "id": "1452637224905064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602072_1638572083126498_98588866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_AzYlA5G-QQ7kNvwHRnqbK&_nc_oc=Ado48lvPRytuerrGmuATdla1ebdqLFZ9lk2owqr7fJ4d65FiTSGbQVcv552MO2-Kxvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_MeMoF0RMDapddIHzA36w3mTo-pEkTaTg2Iu1E8rKIA&oe=69F36960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Heroes of the Seven Seas", "keywords": ["Hero", "Pirate", "Sea", "Ship", "RPG"], "long_description": "Enter the world of a 16th-century pirate's journal. As a pirate in search of the legendary Seven Seas Artifacts, sail to the mysterious sea with friends, where a journey of adventure begins!\n\nHeroes of the Seven Seas is a first person role-playing game featuring naval and land-based battles. Fight the navy, other pirates, and monsters from the sea. Enhance your capabilities by upgrading your ship, including the hull, sail, and broadside guns.\nPlayers can also trade with merchants at the ports and land on different islands to explore and hunt for hidden treasures.\n\nThis is a real adventure - an adventure in the vast and unknown seas of VR.", "short_descriptio
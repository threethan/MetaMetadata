"id": "815182366767895", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974535_815182370101228_3433563866581743782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9jTGkdT3yQQ7kNvwHJ9cXa&_nc_oc=AdkdY_21NOiCGL_y3bAOaLHZepcT_wuDCH3SkM-gJnRGr2OVa3KKXc4Wwd4D5dUF9n0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvnmvuMFaQCNOx5CKTYSpESVaA24YHusDieG1uN9fV4fw&oe=69A18784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-08-28-12h41m29s602.png", "id": "1272259510147385", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974812_1272259513480718_6996348621559666686_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkTut4VKYZoQ7kNvwEV3tFo&_nc_oc=Adm3s4bPOXn9y9xH5gFMTm9YG0fT1qobrNvhVdCvvYK2gGiasGRx-bGyHPU4bhejg3E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsfJ9JKYdtkZbGAmXO8VgxIGr-chkiwbNDFmCaGIaIL5w&oe=69A18D68"}, "display_name": "VRflow C172N", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow C172N is the interactive cockpit procedure trainer for pilots flying and training on the C172 \"N\" variant. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n12 normal procedures and 11 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow C172N is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26295085990096024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974712_665319995523256_1471992841734417185_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cySRiz1RY4Q7kNvwEg4bPY&_nc_oc=AdmHlAokXvjcqf_uEtkwtM7VmbGKRWNG64Xe1uRxPT-yG6K97WGh3clMW5RpPCm2gpU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvoeuyvwQ194ITuafVHtZ08ZwG31O8453K15M3wu57v_Q&oe=69A19D18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRflow C172N", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 16
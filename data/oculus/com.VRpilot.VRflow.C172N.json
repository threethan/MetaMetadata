tent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SByHae0YUvBuWr5EU_bapaUikIzejLy9kXtIO7WWYuA&oe=69DE52EF"}, {"file_name": "6.png", "id": "815182366767895", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974535_815182370101228_3433563866581743782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zggSC1Es6tsQ7kNvwFjUdYh&_nc_oc=AdrrY2Al6XUEHk-weS9CV5ztvQItSLy50BVVS1vbYPIyS7dC-KWlr5815UDXAcDwD1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08QxF4bhgVe83GC6pAVw2P31SZRz8K6T2l-zR4qQPDmw&oe=69DE2C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-08-28-12h41m29s602.png", "id": "1272259510147385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_1272259513480718_6996348621559666686_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rohp9zwGCnMQ7kNvwH23CWK&_nc_oc=AdqeyFXRtHhRdhqTLia2P9xA-9vfmlg6z1pAVfjgZlAl9drjLxLqgTzb0rGKDEBF0t4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-2aYINXZQhTT3qgGHFX5q5q1IDPYCvXnTJkLmWy7WXA&oe=69DE3268"}, "display_name": "VRflow C172N", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow C172N is the interactive cockpit procedure trainer for pilots flying and training on the C172 \"N\" variant. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n12 normal procedures and 11 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow C172N is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26295085990096024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974712_665319995523256_1471992841734417185_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrMEFX8YC5UQ7kNvwHGwrh4&_nc_oc=AdrPorQyg-vhdHr2ewXf7VkeRGt48rn0Nifm3eMrUzVoJZG41zqABumwuoSTZna3hss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iHw1pNb1A47aIzFB-TPF3nKwg0VSIMQnIwbzWEezBgw&oe=69DE4218"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRflow C172N", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "3626
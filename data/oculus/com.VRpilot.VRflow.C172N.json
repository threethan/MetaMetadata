h=00_Afxo1CdHNmXVNwAIJlmKDbix5ZiZKlLwKsCyeafM4y7oDg&oe=69C151EF"}, {"file_name": "6.png", "id": "815182366767895", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974535_815182370101228_3433563866581743782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dqchlmeusIQ7kNvwHaMtIW&_nc_oc=Adqrt9-CE1PZLG7zw9sl7p4Obic8cJvtK50JkCMw7MYmq-9NabImmeYDsujg8Dl00Q8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi2XX6_X9xsUWOVKcCVuvrwTJuY-MbYC4PXfljgYnQgA&oe=69C12B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-08-28-12h41m29s602.png", "id": "1272259510147385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974812_1272259513480718_6996348621559666686_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3dgVvcE8gQQ7kNvwGUuY_s&_nc_oc=AdqFwClqUNaLxp0w7l8I2PHgTf32emiYl-gc6PEZ0U0jbu5JXzZhO5wxOS-8RLoE_74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4B4CqjQ35UYbMdNu58pYpRR4j4P2BAVRXsqCnYsaq_w&oe=69C13168"}, "display_name": "VRflow C172N", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow C172N is the interactive cockpit procedure trainer for pilots flying and training on the C172 \"N\" variant. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n12 normal procedures and 11 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow C172N is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26295085990096024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974712_665319995523256_1471992841734417185_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BK_9lKr1Wc4Q7kNvwGm6xFP&_nc_oc=AdpcMNcnw_2Y0m-mmFivF_Sglyg5xDGzYhg2kteQDC_5xUSrudqKBRkyqwa7zqvbKJc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvyoNWKvMKzKGXfMTV78WgUAp1qVEdKKgNWil_H_8JUA&oe=69C14118"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRflow C172N", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Ha
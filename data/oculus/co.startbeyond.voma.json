25/75375773_1097318104808314_1391611628678038370_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YbkhB8AjiQQ7kNvwGsCWff&_nc_oc=AdoT9beJwgFQx1oDBSJN39ObcPHopN1nDI2QiDKYDRFV1OZeBTdQfnFhA_GD0kg7LGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1ZwmCRw3jpUR_wFDQ5C97LzKRCocZxvmiU6OEuu_6tw&oe=6B005953"}, {"file_name": "3.png", "id": "954135732791318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_954135736124651_242281798633208075_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4lH5VVa4FAQ7kNvwE5q2r3&_nc_oc=AdpyXTZjOjgCZWp7l0SbGWYKoM_6zuE7y4Hlo93-6CQx_I2lJAEH7-_Q4e2sKFSFYsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5GaegMc8l6YQNcdvV1ZzVkwwvdGPVFLONuKU80rO0TQ&oe=6B006CA2"}, {"file_name": "4.png", "id": "789962276362346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570306_789962279695679_2470344725990122553_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfS7-P3gTksQ7kNvwF2eH9A&_nc_oc=AdqKzMAfxkBkz8O1kt085jNUKS97j3wvkzNMPCe4RZK4O6L_HrUTPoGZigAkeqSegXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLSNufDXF8pt-ThmLn0Tk39_z_QHhqhIgYyV0ziry0ug&oe=6B00681F"}, {"file_name": "5.png", "id": "7395436147181619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617321_7395436150514952_4459932684552727418_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh6TplFbAcgQ7kNvwGI4_tF&_nc_oc=AdpIOqttYABwCZqLpG6ClOpYry-7spWBllhyk3lzzKIqrgPnkUnaMJHFbeW_wmOCB5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh_r4QYuy7puDkkcS9Vo9EAcO6hwgI_sMZZGtnXoAVZg&oe=6B008007"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VOMA Speech Pathology", "keywords": [], "long_description": "Perform an oral musculature assessment/examination (OMA). Explore the structure and function of the oral cavity of a child, observing common anatomical differences.\n\nCreated by technology developers Start Beyond as well as speech-language pathologists and research/teaching academics from the University of Newcastle, Australia, VOMA has been used to teach speech-language pathology students how to perform an OMA. VOMA offers a creative and flexible approach to learning a clinical skill promoting confidence and learning satisfaction. With VOMA, you learn how to carry out the procedural steps of OMAs, essential knowledge for a student speech-language pathologist or a clinician wanting to refresh their knowledge and skills in this area.\n\nImprove your skills in conducting OMAs as you step through assessing the structure and function of the oral cavity, recognising anatomical differences found in children. As you work through the main areas covered in an OMA, including: the face/jaw/cheek, lips, teeth, tongue, hard/soft palate, diadochokinetic performance (DDK), you can record your observations on an assessment form.\n\nVOMA includes activities of\n\u00b7        Performing an OMA assessment in a typical clinical setting\n\u00b7        Learning the steps in conducting an OMA on a 4- and a 6-year-old child\n\u00b7        Exploring the anatomical features of a child\u2019s oral cavity\n\u00b7        Observing a tongue tie, high narrow palate and enlarged tonsils", "short_description": "Perform an oral musculature assessment/examination (OMA). Explore the structure and function of the oral cavity of a child, observing common anatomical differences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.startbeyond.co/voma-speech-pathology-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Start Beyond", "support_website_url": null, "website_url": "https://www.startbeyond.co/voma-speech-pathology", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362
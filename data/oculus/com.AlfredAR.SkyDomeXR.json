png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOr2FhoSDRwQ7kNvwFVabgt&_nc_oc=AdoViPtm2fn-f-WJ5aiOp9GPQN-5YatOAk8UAIkectGc3ykhEzPlzDnV79iAQu65Is8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvJRRCiKwwxxPPqqfRY0r9_0qg8sDF_uOLt-HCFdO1sQ&oe=6AB7BC3D"}, {"file_name": "AppScreenshot3.png", "id": "321877186971639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_321877190304972_6930998570399525966_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJUHtFTPYxUQ7kNvwHRPn2g&_nc_oc=AdqNShXP4wvI7BIq0QD7ECNTn59-VxWkQpfVSvSmbRqEpnrkYO7IHreGgscIpT9uOdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg76ByMZUhhzYlM5ptddx8aRQkDGhZsXGG7QD4lVW1Lw&oe=6AB7ECB8"}, {"file_name": "AppScreenshot4.png", "id": "918850556532307", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035387_918850559865640_6776064351063906177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaDXvWWXuZcQ7kNvwEtysZb&_nc_oc=Adp2vJIameEtLjOfZ0WCjtzVas2kkX6bucenUoijbAGblj2HKO5EHXin4_uc_Bzf29A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBc2PDWtRG86jKRmcC24jtIwVjQeLMBvGu_A7-JuXx4w&oe=6AB7B95A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyDome", "keywords": [], "long_description": "Transform your room into a wonderland with Sky Dome. \ud83c\udf0c\n\n  Features:\n\n- Room Scanning: Simply scan your surroundings using your Meta Quest Headset. Sky Dome detects your room\u2019s ceiling and works its magic.\n- Customize Your Sky: Transform your ceiling into a breathtaking skyscape! Select from night skies twinkling with stars or day skies adorned with fluffy clouds. You even have the option to upload your own 360\u00b0 image for a truly personalized touch.\n- Immersive Experience: Feel like you\u2019re under the open sky, day or night. Whether you\u2019re relaxing, working, or dreaming, Sky Dome transports you.\n\n  Why Sky Dome?\n\n- Escape Stress: Gaze up at a serene sky and let your worries fade away.\n- Inspire Creativity: Ignite your imagination with personalized skies.\n- Perfect for All Spaces: From bedrooms to offices and studios, Sky Dome fits everywhere.\n- Use other apps while having your ceiling replaced. \n(you can only use 2d apps that runs on universal menu while having your ceiling replaced) \n\nDownload Sky Dome now and elevate your environment! \ud83c\udf1f", "short_description": "With a simple scan of your surroundings, our app detects your room\u2019s ceiling and replaces it with captivating skies. Imagine gazing up at a star-studded night or a day sky adorned with fluffy clouds, all from the comfort of your own space. Whether you\u2019re unwinding after a long day, working on your next masterpiece, or simply daydreaming, Sky Dome transports you beyond four walls. You can even customize your sky by uploading your own 360\u00b0 image, making it uniquely yours."}]}, "developer_name": "AlfredoAR", "developer_privacy_policy_url": "https://www.arxbite.com/SkyDome/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "ARXBITE", "support_website_url": null, "website_url": "https://www.arxbite.com/SkyDome", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8329676537068683"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210888_276124615
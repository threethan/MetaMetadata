p2vJIameEtLjOfZ0WCjtzVas2kkX6bucenUoijbAGblj2HKO5EHXin4_uc_Bzf29A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBc2PDWtRG86jKRmcC24jtIwVjQeLMBvGu_A7-JuXx4w&oe=6AB7B95A"}, {"file_name": "AppScreenshot5.png", "id": "1046491176445739", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031568_1046491179779072_446213781492492672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ_H7LNHHakQ7kNvwG5psFC&_nc_oc=AdoQKygI55jXI1Ctqnu5KsoqOs64-7ZSbIOoQPoS7SSFas-A-kvkEY1Cr4In8kcMz-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb8WKQA0VcNvdlXUIGF_n2b5G84ulR2i3RbPCzpBCRYA&oe=6AB7E7FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyDome", "keywords": [], "long_description": "Transform your room into a wonderland with Sky Dome. \ud83c\udf0c\n\n  Features:\n\n- Room Scanning: Simply scan your surroundings using Meta Quest 3. Sky Dome detects your room\u2019s ceiling and works its magic.\n- Customize Your Sky: Transform your ceiling into a breathtaking skyscape! Select from night skies twinkling with stars or day skies adorned with fluffy clouds. You even have the option to upload your own 360\u00b0 image for a truly personalized touch.\n- Immersive Experience: Feel like you\u2019re under the open sky, day or night. Whether you\u2019re relaxing, working, or dreaming, Sky Dome transports you.\n\n  Why Sky Dome?\n\n- Escape Stress: Gaze up at a serene sky and let your worries fade away.\n- Inspire Creativity: Ignite your imagination with personalized skies.\n- Perfect for All Spaces: From bedrooms to offices and studios, Sky Dome fits everywhere.\n- Use other apps while having your ceiling replaced. \n(you can only use 2d apps that runs on universal menu while having your ceiling replaced) \n\nDownload Sky Dome now and elevate your environment! \ud83c\udf1f", "short_description": "With a simple scan of your surroundings, our app detects your room\u2019s ceiling and replaces it with captivating skies. Imagine gazing up at a star-studded night or a day sky adorned with fluffy clouds, all from the comfort of your own space. Whether you\u2019re unwinding after a long day, working on your next masterpiece, or simply daydreaming, Sky Dome transports you beyond four walls. You can even customize your sky by uploading your own 360\u00b0 image, making it uniquely yours."}]}, "developer_name": "AlfredAR", "developer_privacy_policy_url": "https://alfredar8.github.io/SkyDome/SkyDome_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "AlfredAR", "support_website_url": null, "website_url": "https://alfredar8.github.io/SkyDome/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7103415153028167"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "890007056253647"}]}, "baseline_offer": {"id": "890007056253647"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707514030, "status": "PUBLISHED", "id": "890007056253647"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7121647301204952", "version": "1.1"}, "id": "697393765897545", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary
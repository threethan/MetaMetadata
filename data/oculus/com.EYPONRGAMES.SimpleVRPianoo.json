ords": [], "long_description": "Dive into the magical melodies of the piano in the virtual world with **Grab, Throw, Play! VR Piano**! With this simple and fun VR game, you can grab and throw virtual objects with your hands and enjoy the pleasure of playing the piano.\n\nFeatures \ud83c\udfb5\n\n* Experience of holding and throwing different objects\n* Ability to play piano in VR environment\n* Beginner level VR and piano experience\n* Easy and fun game mechanics\n\nThis game \ud83c\udfb6\n\n* Ideal for those who are new to VR\n* A fun start for those who want to learn piano\n* A fun experience for VR and music lovers of all ages\n", "short_description": "Immerse yourself in the magical melodies of the piano in the virtual world with Catch, Throw, Play! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://eyponr.com.tr/policy", "developer_terms_of_service_url": null, "publisher_name": "EYPONR GAMES", "support_website_url": null, "website_url": "https://eyponr.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7623253394362740"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3294449564189619"}]}, "baseline_offer": {"id": "3294449564189619"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711985100, "status": "PUBLISHED", "id": "3294449564189619"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
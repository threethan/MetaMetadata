43.png", "id": "389492730540703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86624162_389492733874036_216098671479745445_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gouzuh-1HvMQ7kNvwEYJKur&_nc_oc=AdpgysZvKohW8AfT6NqO_vzlRtfo5Gg8NgBe5HTjOjXd8G2SFqBxaPjSPUKSsthnQoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW96eklAUlCTV7WHs_RchubMJHsm_-9WduH7SIZDu_3PQ&oe=6B0F0897"}, "display_name": "Grab, Throw, Play! VR Piano", "keywords": [], "long_description": "Dive into the magical melodies of the piano in the virtual world with **Grab, Throw, Play! VR Piano**! With this simple and fun VR game, you can grab and throw virtual objects with your hands and enjoy the pleasure of playing the piano.\n\nFeatures \ud83c\udfb5\n\n* Experience of holding and throwing different objects\n* Ability to play piano in VR environment\n* Beginner level VR and piano experience\n* Easy and fun game mechanics\n\nThis game \ud83c\udfb6\n\n* Ideal for those who are new to VR\n* A fun start for those who want to learn piano\n* A fun experience for VR and music lovers of all ages\n", "short_description": "Immerse yourself in the magical melodies of the piano in the virtual world with Catch, Throw, Play! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://eyponr.com.tr/policy", "developer_terms_of_service_url": null, "publisher_name": "EYPONR GAMES", "support_website_url": null, "website_url": "https://eyponr.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
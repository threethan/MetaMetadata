_description": "Dive into the magical melodies of the piano in the virtual world with **Grab, Throw, Play! VR Piano**! With this simple and fun VR game, you can grab and throw virtual objects with your hands and enjoy the pleasure of playing the piano.\n\nFeatures \ud83c\udfb5\n\n* Experience of holding and throwing different objects\n* Ability to play piano in VR environment\n* Beginner level VR and piano experience\n* Easy and fun game mechanics\n\nThis game \ud83c\udfb6\n\n* Ideal for those who are new to VR\n* A fun start for those who want to learn piano\n* A fun experience for VR and music lovers of all ages\n", "short_description": "Immerse yourself in the magical melodies of the piano in the virtual world with Catch, Throw, Play! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://eyponr.com.tr/policy", "developer_terms_of_service_url": null, "publisher_name": "EYPONR GAMES", "support_website_url": null, "website_url": "https://eyponr.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7623253394362740"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297582_790621815742998_4517337587848916819_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi0KTks4yHUQ7kNvwGAIZ-e&_nc_oc=AdlM36c6OoTmRHvaKR8NzuRxvSAvUX_UcNLGKgRUQLK41YA1mwLGY-CrLfx0C2QmJ50&_nc_zt=3&_nc_ht=scontent-o
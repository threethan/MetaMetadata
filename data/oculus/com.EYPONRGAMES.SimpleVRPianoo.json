x2048_43.png", "id": "1062020614872330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036653_1062020618205663_2751959077143952284_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIl_e1j3O6MQ7kNvwGu68GI&_nc_oc=AdnFgeiV4GUtf-k4C4jJAqGeITjriK14boXHstzmYAqTHYmDkccOx3bmecJX3kbyII4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsGPOHQpLqthA4utoBsIAHMJ8-Bwkpn7X7jQG_Y2anPYQ&oe=69986955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(IOS_12_9)2732x2048_43.png", "id": "389492730540703", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86624162_389492733874036_216098671479745445_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OX-iQXgnBkQ7kNvwGiEAHF&_nc_oc=AdkqNezhlyaP_CHLXCzsqsX3r_sfYpldFuOUwD45My7VMk5BoWfqoXX_bYQXRVB0fh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvm9Z7eE6ZtIevAba020Nn6TMX82I6YchVdDTKaSMcUYQ&oe=69986657"}, "display_name": "Grab, Throw, Play! VR Piano", "keywords": [], "long_description": "Dive into the magical melodies of the piano in the virtual world with **Grab, Throw, Play! VR Piano**! With this simple and fun VR game, you can grab and throw virtual objects with your hands and enjoy the pleasure of playing the piano.\n\nFeatures \ud83c\udfb5\n\n* Experience of holding and throwing different objects\n* Ability to play piano in VR environment\n* Beginner level VR and piano experience\n* Easy and fun game mechanics\n\nThis game \ud83c\udfb6\n\n* Ideal for those who are new to VR\n* A fun start for those who want to learn piano\n* A fun experience for VR and music lovers of all ages\n", "short_description": "Immerse yourself in the magical melodies of the piano in the virtual world with Catch, Throw, Play! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://eyponr.com.tr/policy", "developer_terms_of_service_url": null, "publisher_name": "EYPONR GAMES", "support_website_url": null, "website_url": "https://eyponr.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "c
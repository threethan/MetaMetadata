30f&oh=00_AfxEsOz7JdwwnmjbisOUGSWyy0LvcbMK_zhgjwPLZl0Qug&oe=69C91A7F"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NzNgHtm5JMQ7kNvwGnRR0W&_nc_oc=AdrdnK3VwnU0dZs8UL1Po4IptZD_B5n8i6ulati-ZDwKNFMOyWrRF2BeK8LNyn2KJBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxORNRCU-UabYlzQ__BstEGdC4kIGHmmv15Y5NHhX9PPA&oe=69C9369E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr8hTs00g_QQ7kNvwE89NAa&_nc_oc=Ado7zXItr8sZlKYW_3jkfXDNl5iYi9UlMvyg3MDbTDayHSKkR9CCTYkAZHFDqZ2LItI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx76UdtVW6HIRFMeI9mtgo8qmCMphABZnHUiES-FHDpmA&oe=69C9051A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAGODpc27AwQ7kNvwGpOivM&_nc_oc=AdpHJkDD41YAgnm5TA_8fCvYglJ6qdkhLocyXzefzZtYyWGr0dRAecb4-t7FzHetck8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfkfuwYJhCOnrjEFKXYgn58uolkZm4yp6MouBcSEZmuQ&oe=69C916E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjt8QgAaU5cQ7kNvwGWkC2v&_nc_oc=Adr7NBd_jyUUHdE-IvqQ-M3nRhnjDPY1oW1SOUyrlviTwyzGTDC59oEWTA48nWAf0X0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygwjz0pUpo6D-FrqSDDcZ1wYdkwhJ2XI8k2QIHPkEzOw&oe=69C91370"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyA9TdY0ARUQ7kNvwETrR8D&_nc_oc=Adqi1cenQd4Zg4F4IqgT7MvlkbHBYV-wzKepMctQ7IIqZL6RUN5dndZ9ClHFHFWFVpc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTEyZ2x4KPD75NBDQkxfqAxBVqG4haJFDGGELKtpiCqA&oe=69C90A81"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyRNNS7up6kQ7kNvwE-8bWd&_nc_oc=AdrLE5BDziAm39LZA6eOdz9F7mFNiWxu_5Tj9eiD575wHrFDY5ye6keumJXxmX_kBfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcS3NfzKNUwhzcfsZZWvLXSYRAFIQcWfKtuOhCxUx8-Q&oe=69C917E6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_si
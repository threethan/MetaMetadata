3FidDsgXQdU9WDsu_pdImW1w&oe=699C639E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB1i3HjwpIoQ7kNvwH_JARv&_nc_oc=AdlvyKNzz0-6qcHGqWeXtULoYWn-rAQbEbsveyHrOhmmUYwjw9TVw8vecmz7VNCBWZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftMfZEK_NbsdKlVn7sedUeiAeQAQvTozFRwYHyDzMWkqg&oe=699C321A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf-aG3DDvjQQ7kNvwFBukpO&_nc_oc=AdkZmxDkRPYMX1a8kAzY8qApTB-KjdOlejMpodwxdaDw4LYKEpxnDmcg3_nOcvmfF6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfshhGkjh3Kk5sb6rf770kG_bchNZT90lKm2pjjWcOwIQA&oe=699C43E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbs3Zfphp58Q7kNvwFkVlMI&_nc_oc=Adm5_irVa7eiWtFky76pq6YCZQwuZ_X7BMX13H8CJf7z_-1LvHQw7nJMyiGUpb_rsBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afte85SNHuPdupiRjmEM0ySyZ7V9KPufyevnWgJsb1YMww&oe=699C4070"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mTu20Kf1w8Q7kNvwGT4flM&_nc_oc=AdmgxAzSTL0EA8jYdBP4Kv8UZQeCJQ7udEVcYuag2omp71uddpRt1XWdBpwRWrl3PZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftVIOdhnrX3qmSSvJRDFV-HYj22OovTxu8yfVyGDNuzow&oe=699C3781"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JbKTTaqYZMQ7kNvwHF7irB&_nc_oc=AdkUZ_PXBJ0ZVXKGKqFsgXfhdUlN8pPIYu_J6_XtyxCa5rQnI4xsAmxIIQlQMTorpCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftQHKc-b6uN-kt-BgqQfjvwlG5RygkABiji2EDuwpThrw&oe=699C44E6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHiCgjgpHdwQ7kNvwFrTNmf&_nc_oc=Adk9vqB-SNQt1iPuwuWGl8Ce0PWr-Xece0cxs-RoM5mjTtvs61fHg6BFtmzyjA5-hDg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfusvQ_xsCVDOjQ-C9xSaIpsgPplENAJXNekiT3ZXBqiLQ&oe=699C4EDC"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7IKdTWCiUYQ7kNvwEt16z8&_nc_oc=AdmcBuEABbklx
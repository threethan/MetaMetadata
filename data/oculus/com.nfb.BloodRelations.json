XidXO8_04hTpDq0g9NfH8rYVkkRn6svzGgMXTHwt4rm4PPyPvNeLw44YI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0_TQ8zw05IVK148lBY87kw633QuCRW7MenbMlqMA75g&oe=6B085A20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjMsyJBuVFsQ7kNvwHLOB5D&_nc_oc=AdpiX6sNC_-LRk0S35N8K3iXU9r5MVmiHSMx6A88kCo9v6XU76nzmyJYmnt1aDiqSKM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-PwSPV81zdwno4VCc717Hyqi8UjwCqLsnrFj9pp7pxg&oe=6B0856B0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYP8vCT2CXkQ7kNvwGHQFGP&_nc_oc=AdrEy_PR73mFlZyPzgj22DIfMjCBT0kCcLuykTgUHwTE4G7saoN5d61AoAs5SX5He2o&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwMWO_tI8YeFZTmiLn4EET8
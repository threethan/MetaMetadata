A410F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8irtN8p7eQQ7kNvwGpyntP&_nc_oc=Adq65DBIIVD8FV3wdk5o5Bc2CkHiiK2gmZ_qfLCn18-cbnD-9uoeFXylhHcBAU6BTmQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-6ksa7j5K3XvIk9oQpbVOkpdRQWtmkubewgOKcfdP6w&oe=6A414430"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://astreaimmersive.io/blood-relations-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomm
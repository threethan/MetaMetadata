0_AQX85MWXB1dDaOwF-hB5Fp8M6Z6NjejbTDdIT4OIp2Z0Qg&oe=6B10699A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycTeeXUXKHIQ7kNvwHEtzvg&_nc_oc=AdpkSZYGpH1NzIhpwIOBgmDPpGIfTsdOOlS-nhoXwduGUqBpHNiSXv_KFc7Xrtt-xYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXy8QLmJwq-xp4kIVBa5scDCAsULsYvywF08wfShRG_Nw&oe=6B104320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av3pTL0MLxEQ7kNvwEJcpNG&_nc_oc=Adq2WIvXh-dn7cFOwnKUyLAy_PwoPG_aKUNovSCpJt5Z7vBhInFOMxD5XaI3bhGWur4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWy0U5j-yx6EOahbYShFCqpPbzsZ5B9EoPXsEfoZJIqHg&oe=6B103FB0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://astreaimmersive.io/blood-relations-privacy-policy/", "developer_terms_of_service_url": null, "publisher_n
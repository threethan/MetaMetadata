YcNXGoY5gVK-GyWuSsIWCLSbq3cdi6dTZbjIpOEQOTvxAhHfprPpOxrz4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs3tUwsa2oZ8Aih9S-YzNVuA9kQXOID5HW9zG3RVU31g&oe=6AFB2B20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXsb__aU6gcQ7kNvwFgXeWq&_nc_oc=AdomNjoQaIkPFbhDieLGZSCPKn5BzrRLYK8TIi8z-JsHjRGgaxLROx24ULy9cK9GpFA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuy8rQ_zapEMMKtnZLZ1ol7SSN3zKHhJRA3g_9SxVItQ&oe=6AFB27B0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmZISSkW9iQQ7kNvwEfNaTW&_nc_oc=AdodkHS6cyB7JXV-8Tnctgr1OS73fYvy4YVCguPZuL2pZ_4lzyS_UTnCLFhncMRkKjo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjHvEgEjM3GeYfcig9R30aJ
Z1Ba7zIVriAsCgXM78NokMDephKpxRlMX-3ZjUlWF-r-glqsy4TCYsk-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-TgIBFXmL1XraCsExwDY_rmyANTSONIrMMhpwKssMCg&oe=6AFDCE20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejdd9kxxBCYQ7kNvwHAYtIX&_nc_oc=AdpTkzRS1Ti9YNCzo86Atd_GVdJrUrtZvcV-zNyUtW0BQ3eOM9ECGHTq8s2KQXPe4Kg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgTOj5v2z9H3oygEgiAhoL-OlYlyz4aTUXP0dZjVVaHA&oe=6AFDCAB0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmZISSkW9iQQ7kNvwHbl9uw&_nc_oc=AdpAFLyV_sJBUK0nj_0UbS96SerjDo2mrOKg8iZj02Q79tPb1qgpTWaWybMkkzcjiFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAA5yJaz-JM9Nh72CWvjgdm
content-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwuXqmscaPEbXNcu_H4QCaT1Nh-tfr4mm-kLy806lRSg&oe=6A4E3B22"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "1091005208438497", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984459_1091005211771830_374261301745148174_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sThbPYB07-QQ7kNvwGk7wOs&_nc_oc=AdokAQ0GdMFr1ymof1LrtdzLchRznO9-_2XbtJYSc_Bz5otVvWAuRQb8blr1MkiFQgE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMA3VZbvjelB4Yf7Z8a-_ewvqVAWnuk9rqdZDPyyOSmQ&oe=6A4E61B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "413715450691794", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974905_413715454025127_1738856155332182746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnYzQHAbVokQ7kNvwEzmN3o&_nc_oc=AdqYBYJ_vnKU-eKKoR8j8RxEiSLuSgxVLSR_7l_ORElkzgV4V9hjMRuH7u5IxR-2ZaM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbrkeCZij4x2VNcIN7x5S44vA2OZBgxAAjap5I23RHng&oe=6A4E6D41"}, "display_name": "Liens de sang", "keywords": [], "long_description": "\u200b\u200b\u00ab Qu\u2019est-ce qui fa\u00e7onne notre identit\u00e9 ? \u00bb Voil\u00e0 la question dont d\u00e9coule Liens de sang, un singulier documentaire en r\u00e9alit\u00e9 virtuelle portant sur une enfant adoptive et sur un myst\u00e8re ancestral. \u00c0 l\u2019aide de documents \u00e9ph\u00e9m\u00e8res, de photographies et d\u2019objets r\u00e9tros, le r\u00e9cit nous entra\u00eene dans une qu\u00eate interactive qui s\u2019\u00e9tend d\u2019un parc \u00e0 ferrailles de Vancouver \u00e0 la communaut\u00e9 juive orthodoxe de Bnei Brak, puis revient \u00e0 une ferme abandonn\u00e9e de la campagne manitobaine. Chaque d\u00e9couverte ajoute au collage visuel et narratif pour conduire \u00e0 une conclusion \u00e9tonnante qui donne \u00e0 r\u00e9fl\u00e9chir et nous invite \u00e0 examiner nos propres histoires.", "short_description": "Liens de sang est un singulier documentaire en r\u00e9alit\u00e9 virtuelle portant sur une enfant adoptive et une qu\u00eate pour r\u00e9soudre un myst\u00e8re ancestral."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nfb.ca/important-notices/#privacy", "developer_terms_of_service_url": "https://help.nfb.ca/important-notices/", "publisher_name": "National Film Board of Canada", "support_website_url": "https://help.nfb.ca/", "website_url": "https://www.nfb.ca/bloodrelations/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "fr", "en_GB", "fr_CA", "en_US", "en_CA", "fr_BE", "en_ZA"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477485623906165"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1420161022390678"}, {"status": "PUBLISHED", "id": "495272039906808"}, {"status": "PUBLISHED", "id": "426930780053415"}, {"status": "PENDING", "id": "5659708890763407"}]}, "baseline_offer": {"id": "426930780053415"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761325200, "status": "PUBLISHED", "id": "1420161022390678"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5192641130843312", "version": "3"}, "id": "915500232514177", "channel_name": "LIVE"}]}, "is_for_oculus_keys_o
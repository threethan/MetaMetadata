LUv_f3tr_DWeFdsm_RZPkuuA&oe=6999C09E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB1i3HjwpIoQ7kNvwEWXV84&_nc_oc=Adnc1sQ_ZImhOXwXX9XOlatSfi6PI71C7JYs01bkkNsei_v6WwLHgBoci8CRghXBhjg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcDVx5-blRQ9cmyfYunXzSqGqCkY7VcA8J6o-Oret0eg&oe=69998F1A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf-aG3DDvjQQ7kNvwGL5Vmu&_nc_oc=AdnxT3Z9JA3KBQZDUDj9EuAWJPV-I2d3vaackAVGwRptbR_63hYUaWoKrsb65s4G2y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfukGwoWOs_hdTtNgAmrjkLgBqwg9jA5Oa7njIbPSfin1w&oe=6999A0E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH_giEMmNT8Q7kNvwGAGc9r&_nc_oc=Adkl5YG9JLgdcvIDRQ_-dcL7qVHm-4RI2TE0HVuluy_xd0k3-hPkheqk0ORFNhbpQ_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4ytD5fLXwcDi2ybZh9tYyCXwjxq9lelNVkt505mE-YA&oe=69999D70"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O9JUYiBwuYQ7kNvwHVOBym&_nc_oc=AdkWCbwfJzJilDCuOQ9fvTwPQhbrFpmlpuWUviF3sLC_tjKrjJze5KEHhUr8UfmbsDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftyCfXeSRw1tNws8b2Il8WjxwmcmHLw94Sny7dxZGSQUg&oe=69999481"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JbKTTaqYZMQ7kNvwGexjon&_nc_oc=AdmMJA2l_cPQTWvZxiQzxS09iebPL_mCtFIwdgFXK-EPaYAXHUIKxHUwWtOAdBCaaOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBm_Lk6MSgaCUBX9lS9-Hn9AaU2oF_tYnsrEFGsUBkkg&oe=6999A1E6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhxGt4WhDrMQ7kNvwHNQInz&_nc_oc=AdkxO87njLlv1rR98NMryL497Jbk5Jd7ErtMc3ODvrsEUGaFeOn6tMN9Iss6TW_ep0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftY95GmTRj34U59-5hy6nFu0lYXvZmxC-FVX7wAeXCnaQ&oe=6999ABDC"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7IKdTWCiUYQ7kNvwFtqa-2&_nc_oc=Adn27lSUFKbDH
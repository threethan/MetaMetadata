OxIXEfPbvLGUKgrFY4biuEcS6HNXB9s10_SUSPten04aMVI22YwkKA7kk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTO1T1g6l0ypzW-bp1_m92hRnwq-SYcBwETsFDzpgEICA&oe=6B0B3560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVWUQVg31SgQ7kNvwH0mW5M&_nc_oc=AdplCF229800OKLiy7K-fol_FBGBJqzEzNlHvEw4PCqNpNxEauIfAeWaxZYrSl_-lEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQf47pA-GI2WRg0orrTYN4m2XnmuZRYe8BBal00HDrngA&oe=6B0B31F0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn9pqzqF_-MQ7kNvwHlmkiQ&_nc_oc=AdoC9Iho6-gw_p7DgkXGKC5rv0oomKoypIFLltu0UTWo5XI9d-c6zdaZC119AJtnFDI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTenlmDSsQtgE1bwmZ9DrXlm
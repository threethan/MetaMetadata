uzXzPUiA&oe=69AD6422"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "1091005208438497", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_1091005211771830_374261301745148174_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDo4MyqPN7UQ7kNvwGa56Fz&_nc_oc=AdkXJ3CVAnXiE-UqCVyJTggrRbOcKfDJxxPTrWI67wBBYNE-lMhxkXS-yZOxY2xkrn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyACbm4LW8vSlGa3cngI8_Vf9EgCmrIgxhwCmIb8LKyJQ&oe=69AD5275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "413715450691794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_413715454025127_1738856155332182746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsf8hW-gsxQQ7kNvwHMDkq7&_nc_oc=Adk3sqHn4IX9DNJqWsm4Si2ES5R_-aW1v34BAIp-SfvaZE2Jfrgy05cVqUu_metyzU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1SB50ct2T5wwlqeD8HwFewnC_aKgJFhS0K4guSTBRZw&oe=69AD5E01"}, "display_name": "Liens de sang", "keywords": [], "long_description": "\u200b\u200b\u00ab Qu\u2019est-ce qui fa\u00e7onne notre identit\u00e9 ? \u00bb Voil\u00e0 la question dont d\u00e9coule Liens de sang, un singulier documentaire en r\u00e9alit\u00e9 virtuelle portant sur une enfant adoptive et sur un myst\u00e8re ancestral. \u00c0 l\u2019aide de documents \u00e9ph\u00e9m\u00e8res, de photographies et d\u2019objets r\u00e9tros, le r\u00e9cit nous entra\u00eene dans une qu\u00eate interactive qui s\u2019\u00e9tend d\u2019un parc \u00e0 ferrailles de Vancouver \u00e0 la communaut\u00e9 juive orthodoxe de Bnei Brak, puis revient \u00e0 une ferme abandonn\u00e9e de la campagne manitobaine. Chaque d\u00e9couverte ajoute au collage visuel et narratif pour conduire \u00e0 une conclusion \u00e9tonnante qui donne \u00e0 r\u00e9fl\u00e9chir et nous invite \u00e0 examiner nos propres histoires.", "short_description": "Liens de sang est un singulier documentaire en r\u00e9alit\u00e9 virtuelle portant sur une
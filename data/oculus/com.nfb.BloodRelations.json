UwbdNLR05U6l4qG6LlPrWoEQ&oe=69A44C9E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uifHE-MrVIQ7kNvwFe5P2m&_nc_oc=AdkwMAXgERmtJQsZujL8q6Zg70xEZX9EkqClWAwDbYditi-yJ6QJOultRsysY6QOWj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsj4kU6ybCqRARPJz09ovOgFpJLkDH0vWlwDW9wPJqjwg&oe=69A41B1A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CgBeistdc8Q7kNvwE9l8t5&_nc_oc=AdmpVcL72TlhO9nhgLUPzm_ygpJCvKiPrjP7VgPl137ePkFXZd45j0nQM6-Ey3vW-FA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsuTrzx2z62hue1taUvgQxjjT1nhx5DWJTDXi4CwmC3GA&oe=69A42CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux19CbkgvOcQ7kNvwFmerN8&_nc_oc=AdmzCLaUV69YJMwHr3pnzQ2NjO4gaUY1X-0PakEplKQwKapBAmlHW6vT_omq27MymOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuO7cRfmOG5SabAc_5y8G67moohptHaOTdZ2t-gj6mkhQ&oe=69A42970"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQS_YWzFGt8Q7kNvwFFkOS-&_nc_oc=AdknUNCwA2ySEJMPaizK9Zyqkn7Tdfu-rQPRlUMs-SO-KDlAb5Gd6XkLzlCg3PnI31A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuw4uv0eama-m2PSGYYJzzRh3lokdhLAdpWhGZ4-B4e3g&oe=69A42081"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOahbnOFOzwQ7kNvwFt8LGa&_nc_oc=AdnN2k0sZUNA3NqofJtuL8akXBsPFX__3UjwZEb0v1k3RX_9xiL3OhFcmeRfQDhxmKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu9ct7yZLXNh_GEcCSOnoq9eSNUq57WpBzuXGT1R1yQpw&oe=69A42DE6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP7m3fiSVUcQ7kNvwGMebbB&_nc_oc=AdkFj7UiGFUwr1tYRvzaK4fDB4GafxkyxPSbk1uO2RNLoRX3ueAaEDVYHuyXlsDldhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftHq6P9ja_MPUaVlokYQj7QfSIx3wy9bUxhJFrmrqMz9Q&oe=69A437DC"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhPxjQrzJDYQ7kNvwFVuFTd&_nc_oc=AdmPegFzqLaTW
-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V7xY2yQgtrU5llo1_SElPXi7y4rXH0S56sdZTF9FslA&oe=6A3929FF"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV6dbbLefsUQ7kNvwEZyat4&_nc_oc=Adr5pU0v6i0wmMh1Grp4GqN2j92qsdSM4-YqIewnuiCwrtQFTlR2sgcErjAy9xyCi5Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oAdx-I6gBAaSKOkpG06BLEvdQdafQFq4eMPNazEnGBA&oe=6A39461E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWmXaqkVzGoQ7kNvwHfVKfQ&_nc_oc=AdpIxz_t0vMqkCuzO2NuHoQJ36RY9-gjcz42a9JeZrcxZxwYkw46PEOe5G_1fOQKt9c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99jymuJtOJMDkVyh9_8oVi3fIUJ-D90Vz0B2m81QdDjQ&oe=6A394CDA"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLw5c7KRmpQQ7kNvwFvdcLA&_nc_oc=AdqUvfPea4v3pv0GIMxdGH-A2GRbSmI04VMSrBPdDAna3B9gspXjL8dqhRU-3atD0qs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Xx73G1bTFfI4o3aZ-x1b8e4Mvodgx91rTplRRLIgLg&oe=6A395EA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ8J_FPGcZkQ7kNvwEiyVwz&_nc_oc=AdpQwg5dcXGD-It5-P9KONyooQJBeyRThFsfBj4NIVFUIXAdp2OhgIS8pTpmZLctH4c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5MDcEnNdFOXTZnjDLtUCc968a2w6ZJo58nNsSMX4FBQ&oe=6A395B30"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDpGt09Me3sQ7kNvwGpzBXl&_nc_oc=Adqu5tjF_3Y-GR-l0tnTzPHMe1g0y4vNaknWdfF_S-4qJj46geJEh9iXgRbdLXmEVRg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QH6Cbj4_OXywnJtmQ1pW7K4XUPNkRZqoh3aWe_7fNhw&oe=6A395241"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkju_RPDWXgQ7kNvwHAJ36p&_nc_oc=AdqEJstwXVUtceS177kFldQkB96F7y5lSf3a82zYoFS5QFAEi8LtXfOV4R_HQ9iEK7Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w44arrd8SDub9naM6L8QdSa6J8elBeVN33ugwus8LtA&oe=6A395FA6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.
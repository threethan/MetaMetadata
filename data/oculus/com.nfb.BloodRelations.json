-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qd_SzrVb1d3zvz_ly1tRMnUlbegCz2ZoUttO94kvRCg&oe=6A36BF3F"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV6dbbLefsUQ7kNvwHmH8BK&_nc_oc=Adp8PeOsEHtS7VnPb4RwB88pSgSPibI_12neHny6OFI4jLydnW52IJOIwrUpdEAF0dc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f-wGsVpJ9NKW3kypHGRciJnQVmTHlMR6CHAH-V50iug&oe=6A36A31E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IpBIlKkuyMQ7kNvwHCIYk4&_nc_oc=Adox9A-xQNVzZksLEazfT2p_515OaUD0NZ2ZzfKwvp5RMyB9W3Il_1TEkCKcHCyLaLQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HIxzXoR9GwQ7Hb9zpLTzeFTezIlm0w3G7G3Kk7SVMgg&oe=6A36A9DA"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYG14kfCaKcQ7kNvwFoY2cZ&_nc_oc=AdpZY1Nu0RGTnIkYCVMtovr_zT5BMpSEy8S-6XX_pmAKEQ1LAjQ4DJmk2CWpZi8-s8Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cTPCJ1yEByInV9b8tpKh_thkC5XdImM-3EjdqHoKqZA&oe=6A36BBA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sKVj9b7ZkkQ7kNvwGw8sYM&_nc_oc=AdrURuTWG7mG4NE3h1MRQ4IINXSW6-JVHZkQbaZ9hph3-m03a3TQOiESA8WWknUOV6I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZZ2ON30iQZGdVRorqIcd5Gvew8tduJqaJQFcF2YKcmw&oe=6A36B830"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCARshq47sMQ7kNvwGBCZIA&_nc_oc=AdrZznUz9djyd40Q1SLyBNJiz9UtRfe_702SyXAu3mAEN7YwZ3IklHLkdqqdsc9fElo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s3C_F6wWL8DbDdHGCd5nzzguBshIdgtA_LSwx0FxruA&oe=6A36AF41"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjgOJWSpU0YQ7kNvwHK0g2N&_nc_oc=AdqqoHYO2IoYeyYFnjV0-ERKXXMD6KlDkEIA4OlrAmqeAYHVrY560abnL87C47rRSP0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dhjTiyWmCmBWBOBCxkMNCu4pkmGFIyLx4CqtD-i1SOA&oe=6A36BCA6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.
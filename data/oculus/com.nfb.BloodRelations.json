0_AQRowxK_uGyQ6CiTzf2j9QjBx3FNjaPI9sB64WdLMmh0zA&oe=6B0DC69A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycTeeXUXKHIQ7kNvwHl6F4P&_nc_oc=Adr_buwGHCt288CLQe3YJlIHDH_EPCqk0qbCXMvroRKl0cjNR5FMd3d0h1O63V1sCmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSD_lmXZYjPaeBqEHYrB_zgT3YcYWzcMm0IqT9ltvACoA&oe=6B0DA020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av3pTL0MLxEQ7kNvwFUASEy&_nc_oc=AdrVQ2nzNokCxNskg9_hCeVfh68LiUwa32txFex32n9YpW7g77LQS6ovbVuVMBgR2g0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzvrSDt0-wydBkxl8WcgTNmXc2xmDjgE0IUOw8mkHQmg&oe=6B0D9CB0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://astreaimmersive.io/blood-relations-privacy-policy/", "developer_terms_of_service_url": null, "publisher_n
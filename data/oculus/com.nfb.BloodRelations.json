wUXsz2nKs-CUpylEqtRJaqTn1EP2Czl0uPzPm-6WzUTpjIDluu8lfvqCk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwNr16fbj-LECUyh81QM3Yg7Am3SCg-kIfyfIdkuwxfw&oe=6AFF1FA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejdd9kxxBCYQ7kNvwEDz4HH&_nc_oc=Adpl4GVmqjN__9IIyB_ozfxZgUxOslQGGty1o27_aXR1G2eOPHMMVEBA9aiCgVu47L8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3ufrN_3LBAhH-hxJyhmZKR3JLQqhgXQ7CDtYvxAWwdQ&oe=6AFF1C30"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nE42BkfEm_kQ7kNvwHRj7JK&_nc_oc=Adrx-7-S2pnaFvZzUQiuGk4gN2xmF9P9KFFDCUj4Wtri8UTJZES4k5uaFgdrU_Kx_P0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMu49Kw0zSy-fjUXEnaeK6j
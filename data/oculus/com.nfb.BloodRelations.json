ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3HzbcKmhQ1sMYEbMUnaZlVj3xv0uGE2foM8ZOePz42g&oe=6AFF1C62"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "1091005208438497", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984459_1091005211771830_374261301745148174_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nNQoOrwZvAQ7kNvwHKtfJc&_nc_oc=Adr2t2_4a4f-yvTKLRSpntvzwnfyzzPwhogqAx-lHkTl-kqnO2W6DV_8HpikM9Z5zHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ26GDMCKDMiey5I0FsbUHp3LXOZQDwJlneCWkDx0zCVw&oe=6AFF0AB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "413715450691794", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974905_413715454025127_1738856155332182746_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlIxTgPIyXwQ7kNvwFudFxF&_nc_oc=AdrpSSW3EIwF3WiBLrjIFE8Gp0zlrEu51tgj7Ee5Y4oIIQEgIB19KEUf9HQpwG1u024&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv6_HDnl2KNRxgD9p0qk7fto3m_gWo7-8Ezp24Q_DDrg&oe=6AFF1641"}, "display_name": "Liens de sang", "keywords": [], "long_description": "\u200b\u200b\u00ab Qu\u2019est-ce qui fa\u00e7onne notre identit\u00e9 ? \u00bb Voil\u00e0 la question dont d\u00e9coule Liens de sang, un singulier documentaire en r\u00e9alit\u00e9 virtuelle portant sur une enfant adoptive et sur un myst\u00e8re ancestral. \u00c0 l\u2019aide de documents \u00e9ph\u00e9m\u00e8res, de photographies et d\u2019objets r\u00e9tros, le r\u00e9cit nous entra\u00eene dans une qu\u00eate interactive qui s\u2019\u00e9tend d\u2019un parc \u00e0 ferrailles de Vancouver \u00e0 la communaut\u00e9 juive orthodoxe de Bnei Brak, puis revient \u00e0 une ferme abandonn\u00e9e de la campagne manitobaine. Chaque d\u00e9couverte ajoute au collage visuel et narratif pour conduire \u00e0 une conclusion \u00e9tonnante qui donne \u00e0 r\u00e9fl\u00e9chir et nous invite \u00e0 exam
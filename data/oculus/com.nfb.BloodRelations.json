-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uwOPYfqqty0mmQFHY8bMmLAlT9fqdalJV6a-86LXFvw&oe=6A22F8BF"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwSdeXow__kQ7kNvwGPpRCH&_nc_oc=AdosO18pqfZHr2mqPPDD5gkMCVK_Wd4OZzRmpqRkf-OJSbDl6GPSFqbONx8H6KY3huQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94NXm5-rzOhGf7QL4IGMBa2f2x-fAdD8jvcmqb1Q-T4Q&oe=6A22DC9E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTcLC02FOrAQ7kNvwGTr0xP&_nc_oc=AdrRV7dXfsGqZ8ZAeP_qIlHUXuLJckbW06TXrdW3ml0OXihJa7qLOxH1KNYd3noIJGM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hhnW69L0xYuQmCYsRi8ubjstEdMf2xvfRxjMkNaTnkw&oe=6A22E35A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNvxC_1WIvAQ7kNvwGmkkDC&_nc_oc=AdpCJlVEo1dOotOwOU7L6VJayN_-cHTj7xjfy6qoNB8DUZ95c0fhvby7mc3fPtAh_Ks&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mX6WHqrKeGSVqu3Nae0HkwH02SdhXEyq9dNtuhTb_1Q&oe=6A22F520"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKzxil28TjkQ7kNvwH1r-ad&_nc_oc=AdqxImFcGowR6ECjApPT4UTIOoOmpwh4wVft2eVsappLeKUAX7l9LRLMnOtUgnVqL4M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NUWIAwCXa0jpIH7tk_NY0cbbbUDtEmFBGQprreb_D2g&oe=6A22F1B0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTsOdZ_QfwEQ7kNvwGG6jfB&_nc_oc=AdoWXoGy-mgygOalN-epwLGXJpYhYMzYVQHzMf1hEEnYc7zmIPgAq_7b0yaY_ILRI1o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9onOHFENExUBFShLiMA9MaiUpNFEjss_cUFOOLXpIqIA&oe=6A22E8C1"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgKQZpq2E90Q7kNvwFg53YJ&_nc_oc=Adq91jkeMz90cdSTDdeAI3mEmpm9zY12lZVFmqV4I8FojDU2ByjCV5t0hDs0BUR84vM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ftBkNQm0O4yK8yBUA8zgYJzQDTEaBmJECQ7Rhbu7-8A&oe=6A22F626"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.
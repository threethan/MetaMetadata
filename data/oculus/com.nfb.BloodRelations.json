7zfkvyeUTQ3MLkKKZEPyh8jQ&oe=69986F1E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o4dWSypJloQ7kNvwFwWJe2&_nc_oc=Adnm8bCqEKPUW7XjOqpC9bWs-MJq6lfoZGrfyDNjEW6mlmxIF0T-PtloEsvPyuS46PE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsgn4neT9E69oC_nGWW-CQvQPO4Nxg32QbPMP0EDC52Pg&oe=69983D9A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS4exNb4Y1oQ7kNvwF7Jqb8&_nc_oc=AdnITmXRYdoSj7JAF11Pj2SK4xXKJZTpYwz74Ex3zAa3zCGel6L5IIDAQZ3bLGAOeNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv827w5DdSpZFfTvSs7j6nn55Ow1F6QKm8vbOY7Vj1dwg&oe=69984F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH_giEMmNT8Q7kNvwHgBYf8&_nc_oc=AdluNmkAYxQG8QqnyIDPGTKHmrhQvG6-NI_jYj3IHjWf5D5r3_0bBa6bz6vFqQIBFiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvcOv4FioULMF5St4kDvzBschUVXUZudSF6FgX69zsYCA&oe=69984BF0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O9JUYiBwuYQ7kNvwHqIb-C&_nc_oc=AdlS07NcniOHv9J2n8P7ldAUDKBP0wLJQY77t-RYR2YdgyFsO1hHmDsDFT3RuQkJwS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsZYnrK60gOk4Vqi6vYEi8yfKTzKEIgkb64TE-0aU3ZdQ&oe=69984301"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAiUpS0Zo4sQ7kNvwHRu_7b&_nc_oc=AdkzJb6LNZxXfTyTVRQZhFTTjjv8969Mn-BKs1A1jXnIetmOAWePICoyc20p0VY--3c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu7WAfidFolCMcnxb8_yF8PqL1Ez86b9dyWTrOnADEe2w&oe=69985066"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhxGt4WhDrMQ7kNvwF4dB-V&_nc_oc=Adld3nE46fvRpQPo91zCzaM3ychlyiGvGA5fIfQMqTWDb_YwJZs_mFsijwqKkYEF4Xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfujYfvXdNCns3zN7A6xj1kdwwCf3omAbR2butXeWhWZGg&oe=69985A5C"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHCibR7ztKoQ7kNvwErKUjX&_nc_oc=AdnJGd5ajYTm3
o_ja3uDfZdNW2Oto7q1wxtyw&oe=69A1A99E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uifHE-MrVIQ7kNvwFhSnlp&_nc_oc=AdlMc-tAABrSZUAoRmnmhfy-Zk6weA6qWXAnjwRVGEH_N93AsZ-uDKy6pKhkmeQAZSY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afsm9LCjCO_HLYV7_yLaKCNPPGswy2PZ3YcojFx6rjxYoQ&oe=69A1781A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CgBeistdc8Q7kNvwH8Q0jo&_nc_oc=Adn0u9oFvc2nariYSNBzRATyDpjQ3OemszQ0fxutQb8u2MFjwQlswSlYKh0aRYcFLMQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu3VOtHLgkoSV2OQfG4Boy4zjF9ubr40N4hbCIjCURwKg&oe=69A189E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-gG0GDwL3gQ7kNvwEWmbu3&_nc_oc=AdlM0luXbYSee6CQgP-JOhyNaaPzpyhZbdnEUU0SOM8_3N5gv7YXHudlSH2n6tUN2is&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvjmZobQ9y0axCrcm84iCT7YpF2suFzLASKr8RPHvBLyQ&oe=69A18670"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtJMBWZY8hcQ7kNvwGGWLdc&_nc_oc=Adl-UY2EzWjgsycPNYGtite5HCkl6sJjavwvmAViltea0w2QWYifgQ6WPUwh-VpRv6A&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu3Sjzt0Qo248F9H75x8Ra8XWMg9B21QvXFBh72iPuWZg&oe=69A17D81"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOahbnOFOzwQ7kNvwEhFweF&_nc_oc=AdmE7LXGzIzDyv3l-HbA5aSZMvEryDSuaZR9kqgX3EwgYxr688eVWymWILmvs5LzRbQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvC1BgTNeHPLo4jY3cjdIA_U7CL-7vN1kaOmjsrMQ659w&oe=69A18AE6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AM6vE5DNCEQ7kNvwHCwIGy&_nc_oc=AdlJE71jE3il2L7uXFzk6auxX-gbho1aMYWAmbQfkL-3HKvLDwStI4dFtw6QLCSJfcE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsGuWY3rhfU-hdnFt3q0YIKCOHW6HB4jqVsP9h6B2COTA&oe=69A194DC"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhPxjQrzJDYQ7kNvwEALeeu&_nc_oc=Adm80FlJAW_ge
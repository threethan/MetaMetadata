30f&oh=00_Af2Ckvk-uMIhJh19a4LUL7IpTvSpIJh-wEdLLB2tttD9Hw&oe=69EB617F"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFHygJ3yW6AQ7kNvwF8vK25&_nc_oc=AdpU0CE6BWkwYnP2oTlzRl5t0nYe-BFzCoufz-JX9wRoVAacRxsLh5Vy4bt2FA6mhMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e1j9hKzaZu0NRR4x3G8oo2qPvaNX0UtqO49cHDE25Sw&oe=69EB7D9E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J98-JaGJ_gQ7kNvwFAEC4L&_nc_oc=Adq6B_3wjzghYgiH3yAGNVW4t0GHmCb3kyeVrF3CVTvfCBgq95nMqu6OyL4kzfZ4cIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17HInnaNbvimibG_a7K3iZAE_57-xSMpSwsqVK0_bWkQ&oe=69EB845A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHiKIjTOhDIQ7kNvwH7hXlG&_nc_oc=AdqpwhbX82wtZpYUtdE40hXOrqvj3nNEOJOZ9lLzEul89heuXe794ygA-F2oArHO-2w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q89D-0CelyquTEkdnqfbbSVAcKBCxgdtP8Bo-k7R6ng&oe=69EB5DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Iq_5pLfN2MQ7kNvwGywKZh&_nc_oc=AdrpehgdDNQ-uQanzL5UFB3BnqJRPaBIMXnFCkFamoNwBRPryU0nwUazkAmJEG_lLJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01tfzktBjzvGyRR45bAxsmtKGgsBwuo8dJWlVkgpeC7A&oe=69EB5A70"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md5cb4qMkKgQ7kNvwHg7gar&_nc_oc=AdqH4hP-U4KYZLC1od8H6yD-eBaZKbKneWInwU4bGzgKz2j4RqGhy9D8zIp1LItCwIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j4d0R30wwWbPu3VdLuycYgQEdSV_8x64YWJR3HLhbZQ&oe=69EB89C1"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhDGdhYA380Q7kNvwEtYqxA&_nc_oc=Adphj3uUuQjUQSPREx_cFXM1ytRnE2NuYBBVteqcGTgJGw8jre_AFPnZvakLrCkK0Xo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2W8NkM4J0n6u3e6_vuruoggOk-_aC2DTCUv1WteWjVTg&oe=69EB5EE6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_si
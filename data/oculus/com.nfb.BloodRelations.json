30f&oh=00_AfztllFqwF8tvoKlJ-VrUJG4B6pHIiJrff0xN5OBKJp6oA&oe=69C525FF"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLpzEd62X0QQ7kNvwHFobzd&_nc_oc=AdqaD6wuTBu2h1Enc60zlFKE63roYzeV9hRXqxLGdq37PMQxUmoWi3z8-DvtJFTJ2nI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymWtNuJetlSapw_lrI6PjjAuVn4wbEAfw200lZpxOwzw&oe=69C5421E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTlmS8vIwcwQ7kNvwEjS7qy&_nc_oc=AdpVTT-Dgcne-OAZ33D6Vo0mQItwb2DGzCI43SKa5yMYnHW6AXZJQ4UuK_3yGu50jt4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7x5acGla0gyXenq-4mt36E-qCTDbZ2yKNkjxlBmb5dQ&oe=69C5109A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McU5PaKMJfIQ7kNvwHWtofg&_nc_oc=AdoxlFBap7doEzNvevWTQ8XH4b6TbeDnG-FaSOxTzPyasDS-Efc0-U1asC7ZboRj9Kg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afysc2u33u9G-XsSmRmCL6ApSu7ipOB6XIayvo3xOFCUsA&oe=69C52260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG7yMK_bAXcQ7kNvwGjfyox&_nc_oc=AdqwQVHnhfRfAWMDBZo1rM7EnAxI6M-VzO6EBZGz88qU75IbixVDLGAWDw0PdSeNzL8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyOAKjL-LsJ4g-NDpj7wBA-AvSEQmbmcyTD7NuQoNPVg&oe=69C51EF0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe1xKZRgLPcQ7kNvwFm8Cg9&_nc_oc=AdoyjRE_OJ3ttGFT_Ker2tx59FN1Z_Zv8-DxHqiLW8ry58h_QkTDKk0WIwyHCqPcB_4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweT1W7IkfoDGh3wXYWyrRLOiprZaPLslpAdB3c7sC4FQ&oe=69C51601"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msJwS0XGOBkQ7kNvwF8wkdo&_nc_oc=Adphy4zdrcUEcMZohxoCtddG-9jNuu6SP-kk7n4IbPI6pBeBi6rleTDGIqDZzC2TiG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8p849WXb2_JOCq2nQ9hPpveIDMEfrMEvhD3tfT7uqTw&oe=69C52366"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_si
QQOIoahfUKhgNnRIkpRQ7wUQ&oe=69F0C39E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfUwSgN0O30Q7kNvwGQYDqZ&_nc_oc=Adqy9sq1FSJjEnZtNiEBw_zF2FNmxTZuOt8mxH85JIc-R5f2EjZifVh28QoCqG6jly4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3OHe-ci-sPIZ1_Z1jgxcnesVT9q1zAq4ZSzvRB60NrEA&oe=69F0CA5A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGkt9WCBP-0Q7kNvwHF03p5&_nc_oc=Adp-wEfcqHKl-yJOjXq8ZYwkA8KZ4CK102Qh3dDfx9fwHW38s8ad_Y2sNkRFl7GtGBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0-_VpqpEn7bdES9rEHFDvAsFoaXVKtHkrR2zVBX92eEg&oe=69F0A3E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1Ja8b52-NcQ7kNvwFED-rS&_nc_oc=AdoN7mmm1l6g7ARyflhfMBK5r4DuwjN4n1O0PIaGcyhY0QjlcjK0hwE72lSLccW7tPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2NmHfy-0ow_IsWqsx_rICH_B8YJyrYVTutsVYgBkUzhQ&oe=69F0A070"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz6doGBUFF0Q7kNvwHtmOZ8&_nc_oc=AdqNrNhO5UKWK5z-JZY6FB9RkiOKpdzz3XwPXriZ46AxHoROYh9TrG1kIN2sPtiBxls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1Pt5y8olqdS41e9V_KYL28UHnWoZpNfRXFCIQqAvv9ng&oe=69F0CFC1"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpNOeZi33jUQ7kNvwFXTyWd&_nc_oc=AdqlIL_JIAe9wdZswLF6vMNlFxW1ebiJBdb2Q63sTPsxyVevggVPP3zTkkZKtRPTLwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3UsAyHmnQrmGODxHqs5ShtN-IndYM_09jD7Fff_9_WXg&oe=69F0A4E6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_91xdd6r_WMQ7kNvwHhRq6r&_nc_oc=AdoO5LML0aP6hPs7zsupvowd9M3npSi9cwKCR9JTrpCK8qyzHyAzHBFbkaFesN4zftQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3KUhnz6sq3wqq1K2gUDHXO0DVlcNRaZ9VyVaicl1gYQg&oe=69F0AEDC"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWdEimymrWMQ7kNvwGI7F29&_nc_oc=AdosTWPig-6Ow
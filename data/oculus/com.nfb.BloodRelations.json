30f&oh=00_Af3ytOsLLfJkEmBJiqSjUI5qhpcWL_Y4rxglFfhP3Gh0eQ&oe=69EE047F"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFHygJ3yW6AQ7kNvwHJIu5j&_nc_oc=Adobd60SlHZsef1I0aTcEFuP9kf16-U95l3vNJn_73Gk6jGK1nBBAg6YMOl3U2KuMUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wcs8KZ7hhvRkdEXIG77fUUQQOy0RzJQS-3aEQUVscOg&oe=69EE209E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWFePNDFlqcQ7kNvwFJKA8l&_nc_oc=AdqnP2izrxbKp1oYo0lzsBGrgYiWF_sNTBi8TKyLGwqcs2cTL3v2ru4T2p_T47dGrZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sYJzAKPgGTkPi6apbmRnpJ2_2vLQTjrDUgZntb2RFuA&oe=69EE275A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aKPV3GDKmwQ7kNvwEJMbQA&_nc_oc=AdpdyQSjOix4Ae4bAxE5s8u11cxh_jXyBmgw0alVIusnT4jZvNxe8SetnYos1_zoSQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T3gNBi_RTPL5ufVFCB84tdMX7lgYNaoAnFfRLRTRYnA&oe=69EE00E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1Ja8b52-NcQ7kNvwFv0xse&_nc_oc=Adp_ZPLbcvpqwRK84ElehPGprGTll8jUgXBH9mwdk2KSWAqiS0OSX-2QmqeNSuuQ1g0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b-Baj7XIAhKCKOvjZC_KLmZKFYlEYJC7ch-CrFhWSpQ&oe=69EDFD70"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz6doGBUFF0Q7kNvwEVo6ue&_nc_oc=AdqfNghrB6XLT-2KOr7unyodj3ZtFRs7UXP8sCaXkof6P93DWmK4w-j1TZ1KwQwny1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eP0SWJpHPzz60dxqjcZJKCa4OnbdLYD8J0CVX-mhyMg&oe=69EDF481"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxNnCuBlFC8Q7kNvwHBUyZD&_nc_oc=Adq2LtVL8LHNQ6q31CixdkniIUDBMD5rS5avbPGWjZtYiFAgRekDnij4r1k-wW7vKHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WcWHeSMC9hNwdJcrfgcfUtoKJ7BCX3xCO3ZlEXZ5odw&oe=69EE01E6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_si
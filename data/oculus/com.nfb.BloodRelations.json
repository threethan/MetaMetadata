ent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs6VcwRHUh_c2szud7lw_nbomHcTRusvu9u9AgWkp1Dw&oe=6AFDCAE2"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "1091005208438497", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_1091005211771830_374261301745148174_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nNQoOrwZvAQ7kNvwHkSsXm&_nc_oc=Ado_nAJdDHaXRMG3LrwViUSi_gK6u4xZa8g4P2cvn8j7B7KNi57rYSj5mICeDPjsEqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrZziNuLAR-wx5zFY4l3JLe_gBo9KNww0PQN_2DXmfHQ&oe=6AFDB935"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "413715450691794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974905_413715454025127_1738856155332182746_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlIxTgPIyXwQ7kNvwF4qwQz&_nc_oc=Adot6PvuZbjMUtgPe5QyuVN8v0lmkhj5HJ3aVOQrxBGJ_dDdYB-K37aieVkfZjMUh8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDjyYxfnAEKLPiOxq0kDQicpeMj9EBa7iZifshsgXsCA&oe=6AFDC4C1"}, "display_name": "Liens de sang", "keywords": [], "long_description": "\u200b\u200b\u00ab Qu\u2019est-ce qui fa\u00e7onne notre identit\u00e9 ? \u00bb Voil\u00e0 la question dont d\u00e9coule Liens de sang, un singulier documentaire en r\u00e9alit\u00e9 virtuelle portant sur une enfant adoptive et sur un myst\u00e8re ancestral. \u00c0 l\u2019aide de documents \u00e9ph\u00e9m\u00e8res, de photographies et d\u2019objets r\u00e9tros, le r\u00e9cit nous entra\u00eene dans une qu\u00eate interactive qui s\u2019\u00e9tend d\u2019un parc \u00e0 ferrailles de Vancouver \u00e0 la communaut\u00e9 juive orthodoxe de Bnei Brak, puis revient \u00e0 une ferme abandonn\u00e9e de la campagne manitobaine. Chaque d\u00e9couverte ajoute au collage visuel et narratif pour conduire \u00e0 une conclusion \u00e9tonnante qui donne \u00e0 r\u00e9fl\u00e9chir et nous invite \u00e0 exam
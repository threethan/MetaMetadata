30f&oh=00_Af2_u1mYemSYDWug3g9IQfUFOXb2DyHIGa-FU4_aJlkCCw&oe=69D4F7FF"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB2bvNJG9n0Q7kNvwHeM1Uh&_nc_oc=Adp8ZerXz-pjuTQmzt0l39BXy8QZNym9bsadWiz-BwjiiXWTzYV53mRGIZj__2FQKkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07o1bshBliS1VNN9p50Z-_meBC3mQkCTUhuja53cbNqw&oe=69D5141E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHkZDIei8cIQ7kNvwFcZ3Qi&_nc_oc=AdrpC8BgB-qI__GIDp5z1cVFdp7DgQ6TxZWKn60U1GCRtIgJ5nnAl3Jhvzzzjay0x7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mskin27bxGy4SKI80Wd0-lWmXsvSDg9hVE0627q9xOw&oe=69D4E29A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udii_UhLifwQ7kNvwEg_-Fy&_nc_oc=AdqtB1Xo0FezSZ9eMfnagZb3RReod0qXDCQAUqxqOLOgkU2zSEF5x8HJqRezmsB_e4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22BZwVsQHWL2yLWujoDDFe96a3-ZWuahR-tNhENyrxrA&oe=69D4F460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggOmHAPvrhwQ7kNvwF2C8RV&_nc_oc=AdotL94Db-juVfEE9iZT7wfHligrL2D6NLc0iHuP9WWg9Vwd4mRIpHhJA8E9cx6tB80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CxfXCEsghWHBkb-D6hccPlRl6U-KJOYoeCBTqRSS4Xw&oe=69D4F0F0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrgoCHZNgAkQ7kNvwFOK9v0&_nc_oc=AdoKublg3fvDHgWzkprINYR6ZKkcJV2NWp4hpVVUIGXTJ8wklq5wAXHhbOwpafUHTnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xg_8xFdpy0gZXPfmyVgSwxfQIhG8PIxXQdTrjqbHePg&oe=69D4E801"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0FN_QHbjcIQ7kNvwGRkipP&_nc_oc=AdqT-JIragZ4E4wGKjYc5l3OvwQngIDrk3VNeUftey4a01_voHGa9oeT1PviZAKDM7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vezJsQMGubKGZJy7x_eDpS3BgsnoT7IMp-XgfgbO-sQ&oe=69D4F566"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_si
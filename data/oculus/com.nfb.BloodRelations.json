aC7VaIR7WWLKQXJZudABK5ug&oe=69A59E1E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99H_A3qivzIQ7kNvwFVk7Nv&_nc_oc=AdkhUMOfS9YJfGaOHIKfogzXY3dE6TJFxSXX_JEF9MQy5W_t9mD5hTs8d3sD-tsoFLE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfshkwA9ajPnO3SWddTI4Sc-jFYmXYIrYZ8rOLIK8ZCUyg&oe=69A56C9A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ABxGlCq2MwQ7kNvwF69so9&_nc_oc=AdmzJp9XiGJ7ZJmQZKZggR8YOAvZ1jE8aAwwlG_GfrZ8sPTffbjViiOD7D0QRZMJAQM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvT8rjSFebDR0_hPctM_njveUXLrvb3aZHKwN0j-i8uyQ&oe=69A57E60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux19CbkgvOcQ7kNvwGNM0P-&_nc_oc=AdnGcDx3vekxbzKLR1bl0iePWwm3JWVbogFbmgfcbgD8c5kVHdZqatH6xQgUNKgfNoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsYIcjJ8nsC1IsrN_pY2GKrCXp73Ag64VDSwm2lrkzxQA&oe=69A57AF0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQS_YWzFGt8Q7kNvwE-DN5Y&_nc_oc=AdlEhQ5_LIWMsMLlnQeN420mqWxoVR8lTxKSZXb8yvaAUKdZbKCTO7Dfu99wkqO4tgk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftx6oTVEpZKxcxMufcJ-cb6fxXJNm372XVyP_KMeiuW6w&oe=69A57201"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-MtTfXZgAQ7kNvwHh5rSS&_nc_oc=AdkdIzp7FqeP3ooTaiC8kkwpPqkRLtIRQNgHxDC0a9zod31DJC-oRfjXsv4b1_pysug&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftMzjB7jfpFpolJJmJB7iojzIUjSdRJS9928nha_K6SUg&oe=69A57F66"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP7m3fiSVUcQ7kNvwElaQ4J&_nc_oc=Adk9sJcDIl2lgFFPKj8NItzq2kQrA_qP8B-mIqkJbl1llUaMntrUXoyNdeSAljX0tJU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftC02Ex-gl3CkFwFN3pki7_EbhyGxV-PEFHtJSU10SnwQ&oe=69A5895C"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GCt45NxSIoQ7kNvwGNYw9Q&_nc_oc=Adlqw4r3o02y4
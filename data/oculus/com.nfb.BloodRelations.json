xwsCge_GBcIOTjs_PLyPr3Mg&oe=699F069E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0Ce7oxUvsQ7kNvwE0a1uP&_nc_oc=Adnr3N5AQes2Js8bYz1U-Jhx1zWNGelfs87QqGP07oSLcYfa9l1voGyC2JykbafAy6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuXNU4WnD4bRXQzmcR2BeoAQEV1xYF6EAyfQIVNml5lLA&oe=699ED51A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ko1QiqVrTAQ7kNvwEHgzMd&_nc_oc=AdkwabZuEI9AWJekUHPGTcGI1c5OQ998meoPsNfBecyTeuWKGrGRsSvCx8wOZQrti6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvV5HMD3Hh90Aid5agpIELejkAQsMZ8TRNPKxyg1M9SZA&oe=699EE6E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-gG0GDwL3gQ7kNvwGo_YEd&_nc_oc=Adn5dUjr5GjH9LWctSjun5yEMxxbPpEzV4hpZUaQ89zHBWTe-yPmpEIlzjsufs6bGHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs2f1B-0GBJC5hvlrT0fOrgoHkeh9OzvHDQJlAtmZDvDg&oe=699EE370"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtJMBWZY8hcQ7kNvwHnHp0f&_nc_oc=Adlj2CzVcw4BUChB4WgQppB_38qZkId2e8tVp2KctBGsr1klQ36tHzaTTzSBgG52Hlo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvxdLIyD-d7wXwSaZScWEJSDD9DA7iFv23cW2CVIZhfNA&oe=699EDA81"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9itO1bLHulwQ7kNvwELlYqq&_nc_oc=AdkIb69zssrITsGJPNpCef-XLGDmFoKM2qFtzSIWvvm8T1xyTAwO-aQ7lcMQqwoKO3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv6ezulaqlgr2QtFY_u3B0VhUcBJpb8qT9AjRYC0-laOQ&oe=699EE7E6"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AM6vE5DNCEQ7kNvwEkDlCv&_nc_oc=AdnCgxHehH0HsktMEytTJ6vV7zpDaeHrcHEilxtmdouTlmgloGsMvUP-8zt7y0ppSxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv_SkNSxDz7cwvRO_XK_8bsx1_VeFktzNsgSoTubB1j3w&oe=699EF1DC"}, {"file_name": "BloodRelations_HeroCover_3000x900FRA_v01.png", "id": "1082217212393113", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_1082217215726446_517494784553485669_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80WTKdqO-C8Q7kNvwF1ZbRA&_nc_oc=AdnuStRfoRdys
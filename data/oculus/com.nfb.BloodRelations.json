30f&oh=00_Af3ViC5ajdT79yCxDYgrBULF17ltPFXtGRY15rjHlV07zQ&oe=69DA3DFF"}, {"file_name": "BR_ScreenshotsChap-1_2.png", "id": "749906449585524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_749906452918857_5373892863668832586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08gq28Sz2KgQ7kNvwF5fsY7&_nc_oc=AdolyS3HJYKLsK0B4jTqpgxSDjuDIMVd503zey7_MWo9zRHl6jLuWCTUR0-TlQ3gxn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gjTPG0be4bYUV7i58P4SvCOFebQ4YNpNyRdvOF1GVrg&oe=69DA5A1E"}, {"file_name": "BR_ScreenshotsChap-1_3.png", "id": "768333911020104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_768333914353437_6169083228122452246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WfiOL1BZdQQ7kNvwFG_1Oc&_nc_oc=AdpUagrYbSDMu2GH_mk-rRs6Aq4B_nJuXp4VruGubzXzoP6-2Oq2NMGWic-K734Sp8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jcQJMY9BAdCm-lAH9jbibOpU6GI6cdz0uOtE36FXL9Q&oe=69DA289A"}, {"file_name": "BR_ScreenshotsChap-1_1.png", "id": "459558195525662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_459558198858995_7567890107810226913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZaIuBp6hH8Q7kNvwGXMHaf&_nc_oc=AdqGFlofT8keuae9q8oAcSY5jy1umSjRg3-2WE3rRFzgmQQ4uU1S8w1yaxe7KBgE2d8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29cg4GJ6iRArDmpGQiWqpTgcYwMahyQPJ2sjx-0ylWGQ&oe=69DA3A60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BloodRelations_TrCoverImage2560x1440ENG_v01.png", "id": "771016897240218", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_771016900573551_3469650044417788159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBxf3xLjyqIQ7kNvwFvPOlA&_nc_oc=AdoSmdAM-aANMavrRGPLaML9wLc9gKjsyGUq3Y2zXqya0Ni3eYT38mlkXWiRIol6MA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26z3iyELZP6rsCv4VMXyWRa1NGPktnxCN5GxBCTUYinA&oe=69DA36F0"}, "display_name": "Blood Relations", "keywords": [], "long_description": "\u201cWhat makes us who we are?\u201d is the question that drives this whimsical VR documentary about an adopted child and an ancestral mystery. Using vintage objects, photographs and ephemera, the narrator takes us on a poignant quest, from a scrapyard in Vancouver to the Orthodox Jewish community of Bnei Brak and back to a decaying farm in rural Manitoba. Each discovery adds to the visual and narrative collage, building to a surprising and thought-provoking conclusion that invites us to explore our own personal stories.   ", "short_description": "Blood Relations is a whimsical VR documentary about an adopted child and a quest to solve an ancestral mystery."}, {"images": {"nodes": [{"file_name": "BloodRelations_KeyArt-Portrait1008x1440FRA_v01.png", "id": "3185431641772787", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_3185431645106120_7305487962040821417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuPnxKOmBM4Q7kNvwHmIPQ1&_nc_oc=AdrZ8tiKqZ6U0E27UmSUdhoC0VmqiGjSc6VL9QV-OAsG6FZoAp_MXMRdmKNLvXqv8DU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ulr8-esun_jAg4QoS7SpBraSRodYOa8PZJ9jiUkDUVA&oe=69DA2E01"}, {"file_name": "BloodRelations_TrCoverImage2560x1440FRA_v01.png", "id": "2112431928963685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_2112431932297018_1168886450594301820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0sZ4VGJnigQ7kNvwHWETe0&_nc_oc=AdpsLOPEO6TtHt9RuPBqqJHX1yz0RxA63PnegwdzzIL57oBVKZXNiSb489Dc1kw1JUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14JeYRrHA6UomHn1LFZa-I8tHPlyCkgr9kCGC6Vcu6KA&oe=69DA3B66"}, {"file_name": "BloodRelations_KeyArt-Square1440x1440FRA_v01.png", "id": "1965493300326997", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262745_1965493303660330_6562698748019357103_n.png?_nc_cat=109&ccb=1-7&_nc_si
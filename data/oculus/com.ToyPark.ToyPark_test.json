z_pHhMALUgHhl-yCoag&oe=699DA6C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_landscape.png", "id": "370545948427356", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572948_370545955094022_4840934075632857623_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLdVKwQ0hRMQ7kNvwFtNm03&_nc_oc=Adm8CS_iBZ-sczD4F2BDx2x5W09nAHCx1KvqRUoqGXcPKHNd0ARe8rVpFWBq9jdGzBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftprurtMiZGnCdN_yAaM38IO109ipru1cEAhHrwNdn37w&oe=699DAF30"}, "display_name": "ToyPark Alpha", "keywords": [], "long_description": "ToyPark is an ever-expanding world of guns, avatars, experiences, and anything you can dream of. Super rich physics-based interactions included.\n\nIf you are a creator grab our SDK that already contains all the game objects you need with networking already built in. You don't have to know any programming to start. But if you have some coding experience it will take you just a day or two to make a multiplayer game with rich physics-based interactions.\n\nSo, what are you waiting for? Grab your friends and explore the worlds of ToyPark together!", "short_description": "Chat, play, create, discover in ToyPark - VR platform focused on games and experiences. Or grab our SDK and build your dream VR game in hours with awesome physics and multiplayer out of the box."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toyparkvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ToyPark", "support_website_url": null, "website_url": "https://toyparkvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", 
c&_nc_oc=Adpb8RjrIR0038S8DQDtdMU8gxpzsEIYUs_xg-Eb3GTVCnd1-Tzp5lp9l0VPZYA-rfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Ro11laDA578du5OWxTTXjTmH6tYvwQlGoFr_lzeHsA&oe=6A7096C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_landscape.png", "id": "370545948427356", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572948_370545955094022_4840934075632857623_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWMQhBx61v8Q7kNvwGZ-JPi&_nc_oc=Adou3e44hpSlFv1AFY9Sba1619XKKaOMWSQyIdNDdFIEGzqA-KXKTWgZAZvyJpxv7jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2jo07zvGMI8GheWUsElS5gKIxyJngG34SvQ0i_-fq3Q&oe=6A709F30"}, "display_name": "ToyPark Alpha", "keywords": [], "long_description": "ToyPark is an ever-expanding world of guns, avatars, experiences, and anything you can dream of. Super rich physics-based interactions included.\n\nIf you are a creator grab our SDK that already contains all the game objects you need with networking already built in. You don't have to know any programming to start. But if you have some coding experience it will take you just a day or two to make a multiplayer game with rich physics-based interactions.\n\nSo, what are you waiting for? Grab your friends and explore the worlds of ToyPark together!", "short_description": "Chat, play, create, discover in ToyPark - VR platform focused on games and experiences. Or grab our SDK and build your dream VR game in hours with awesome physics and multiplayer out of the box."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toyparkvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ToyPark", "support_website_url": null, "website_url": "https://toyparkvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "45978150496848
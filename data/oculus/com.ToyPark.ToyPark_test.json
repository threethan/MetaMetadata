hc=ld8PZ-H7GdwQ7kNvwHxX0_M&_nc_oc=AdoavjbZk_9vV23mxhSiXsQBtPDdFKuWZOVOYZml2OtgmW069wlkyh5svKMNc942q1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzAIIGJWGoebSUsbmguxUCP8TmW6MvPGI6081oxzRYdg&oe=6AE60873"}, {"file_name": "3.png", "id": "315316751079519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974570_315316754412852_7558107630380035537_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzmMRuTkoh4Q7kNvwFCkh9h&_nc_oc=AdpzWBwe-7QBCi_Qrc3DgCivjasmkUgegghFA1mfJnAnTATJw_3TKZgBgAi7NYPsjo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFba1dNIMyh7HoYg-fjgYBHXxIyoc7jBbqFZ_bWgGwWw&oe=6AE606FB"}, {"file_name": "5.png", "id": "1033558951403193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_1033558954736526_4949911633544936748_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzmoH-Vu6wQQ7kNvwGj0Y29&_nc_oc=AdqtUpV0pf8yxOXpaYER5GWv9thFHrG7ADARVQK4222kjCg45jz5NQLxeNyK8NOprJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKYwBPHwzp0BRDGy1FdJ0Lo8UjKnQGrNMieye7CdC5XA&oe=6AE5EB69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "playtest2 thumbnail.png", "id": "1274096596568101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982533_1274096599901434_7750591547944012387_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lKA1zHJrVwQ7kNvwHQiuSI&_nc_oc=AdpzOsHlmDlbI-e2aAUIDTtEp07YKa-mCF5K19u5RZU6txfsKF0PngTJ8m0tgqZcBL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODgoMuWmjqi9QPYyVsfH9OHo-B6yfVLyohRgkCXQBIYA&oe=6AE61167"}, "display_name": "ToyPark", "keywords": ["toypark", "physics", "immersive", "multiplayer", "coop"], "long_description": "ToyPark is an ever-expanding library of multiplayer activities turbocharged with rich physics-based interactions. **It is currently in Alpha and under heavy development.**\n\nCurrently, there are five activities available, with more coming soon:\n1. Pans'nPistols - Deathmatch multiplayer game in which your pistols automatically reloads, frying pans can be used as weapons or shields, the world reacts as you shoot. It's a crazy, laughter-filled experience that'll have you swinging frying pans with wild excitement!\n2. InfiniBall - Huge rackets, huge hands and one heck of a ball.\n3. Chess Masters - A classic chess game for two.\n4. Who Am I - An identity guessing game for up to 8 players, with hundreds of characters to deduce.\n5. Shooting Range - Spawn, take aim, and compete with others in intense target shooting or shootouts. \n\nGrab your friends and explore activities of ToyPark together!\n\nOr create your own multiplayer activity with ToyKit SDK. It includes all the game objects you need with networking already built in. You don't have to know any programming language to start. Join our Discord to request ToyKit SDK.\n________________________________________________\n\n\nHelp us improve ToyPark by joining our Discord community and providing feedback: \n\nhttps://discord.com/invite/u6UjkXGXjS", "short_description": "Chat, play, create, discover in ToyPark - an ever-expanding library of multiplayer activities turbocharged with rich physics-based interactions. Or grab our SDK and build your dream VR game in hours with awesome physics and multiplayer out of the box."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toyparkvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ToyPark", "support_website_url": null, "website_url": "https://toyparkvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics"
kFjhgirRnZCqZ7FuxwxcX2i0ik-m_JrIR_OUhVd0EDpd6buwKpQCyTj4EtnzvH5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsvhHfD1JM-n7RWxyNk8o9TXir0lnSQiMVYY6vMpvKbQw&oe=69984836"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oaLcuUnQLoQ7kNvwE1BxBY&_nc_oc=AdmalDuSvx9c3jYDKotXSUvmSkl1KMwn-Ozn-bCmqnUDDg8PgnWZCBHVDRNaX8CV2hU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuMY838gWgUkAH3Olo2h7BCX30cbX2ku4tTeu00Dv8GzA&oe=69983D77"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wA320cb-kMQ7kNvwEK6BRv&_nc_oc=Adky33rwtL01OawCcz5sneUWpeFRFadOHVhnv9S-t6gY_91-ZrCTWDCkksAn86Ky2mM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftpryppv26z0xfC9BIqg6_Kbp39uhRmClmza3T429Lugw&oe=69985400"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCzxkMUamSgQ7kNvwFHusk5&_nc_oc=AdlmaAD-TZ31OBbxZgeHJCZxqqy3XuBCAibZDbC3-z-u5ajfFqvTwAvHLlMBIqn35pg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsziMkY_6xXJGrsHlWPPnmwHOg_h6QeUqzMfM-sY1w5mA&oe=69986D99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGhwuhg7qj8Q7kNvwGe1meq&_nc_oc=AdnMu_wKjHzzIGCbvRMBtX5Y_n1g_KcT5e2lAjNBNcoOqZwauBHkhkdIltNCXGH2HtM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft-CGe7RfJ368K3jMRWsFA24WmcIueze6hOKmtCyLMp4g&oe=69987015"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cogen Bologna", "platform
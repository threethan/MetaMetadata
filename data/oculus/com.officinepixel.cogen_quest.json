_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpSQFHvlG00Q7kNvwF1q5uz&_nc_oc=AdoBjqacERza3ecqQ8Wg_6retnC_W3gbtdH_YHXRWde7NNAQeoTPn4C63G2i-iSPXJ0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmiXrDfcYx8EhBFUVAZdBF-eCDTCYPbuFL-T88fiYOgQ&oe=6A9173B6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boVoaYWO8WwQ7kNvwEY5ROd&_nc_oc=AdrYRTp0D_58s4ECqi0gitt5gstzCytGVjCkfhG8BYtwSb4uqFVdSuQJTVDRbxX2-co&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzWDIqQNDKcyujnH6cWpwrV-_BZaw6JbvHAezNIxxilw&oe=6A9168F7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbTgfUru70AQ7kNvwEY4tOC&_nc_oc=Adryp1zyq8tDa0bk7EL9pyp4AzE30MciGPDExoPIztCPABs_cw_7h2f9Eh__a9u2Jps&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr26aQFYsz1Ncj0z9J32WDWbpyVuCowv7m7fF6wAhPVA&oe=6A917F80"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJEG5zigeccQ7kNvwH1h6Dk&_nc_oc=Ado2P3jrl4ktXvCfh-8ybNTAhZJ1ns9bVTF2wUDl4wf1AXCfyp3PRXRooTZVNulLppI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbccc9sDFUQhD_m8FRE1PBjHYSUxvV_PaN0S7GaRWIpA&oe=6A9160D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60_fJbwonmgQ7kNvwFbVs-n&_nc_oc=AdqDoeIBTbeDGcQogD21KxcTgoi66-TsjTrkbkyOQXcjLacV6Py6gi3W8S10d14v5pg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkV
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eZokbINvMUQ7kNvwHeF9l_&_nc_oc=AdrV2eUb3u7uF0gNDFg7oR-OlWO4vA60o_got-3HG88RIisQKLnoRa2nSN_hdkEZdNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgOvqoISXgkYW5At7GtJmUFM1XV2ENjrzQS2ArCeOXDg&oe=6ACA5C76"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVU4OYQdfe0Q7kNvwFI52m6&_nc_oc=AdrGeIQsSaSIFa8hG8LE_CctB3T1aGtdk26FzPkTN533ngsr9_paq7J6nCBU3ULKB3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7L5I7dUf6Qe74iQ1HH5BxqOMmVUxftdMGocu56N5Y6w&oe=6ACA51B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3o2lHcgEewQ7kNvwEvarMJ&_nc_oc=AdrJV6NO3g0PZg_FOpktjDvt_TYNdXvYcNpuRb_QVqA8ISEwCHE-coZ_6tO_5zEDILw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSy9QuzJ5eM8_dN9xfj-lErinz54SohDQnGcDlnaJ59Q&oe=6ACA6840"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5zh3aZ5cCsQ7kNvwFWguLl&_nc_oc=AdqnnxV5LurUUgm3QjOMnEWq8pAaagzOnIie74dXGA3bd9R3NW3RzY6JZulfco4YIQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLy9nHvLlgy55N9jFbDbPKOjFjWQ5etzQPSZhRMApTZA&oe=6ACA4999"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmo236yMABUQ7kNvwGgznxO&_nc_oc=AdoKW4ouIZ1K7titEzKaVaIUmETuGCMv0R4edLqhl50X8JQCED1pJfzk6jHyO4_8dw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD8
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FQu4hFsRxAQ7kNvwG-XX9f&_nc_oc=AdqDCpn--mtRbGUwefaH-ZFia05MH7UMvN33BigwTdWbeFljL9Z9FGiTFfM3xOEQe80&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTj1v7IJWG0IqlKSmUESVWJ2FFzplD8Cj_5sS2c5LnPQ&oe=6AA02C76"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeBDatDmr24Q7kNvwG2OqWv&_nc_oc=Adp9tGwwqGv3F2raJMu8MzoXhan4lXUjBCXxd3g_Kp6U-BN-o44NKP6Zulfuwj9A1FE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI51wlnVC-vAg84JdFAUKMdN2UsdgmUqb7pe5SQPTUkAQ&oe=6AA021B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_3RPuMTzo0Q7kNvwHOuL_W&_nc_oc=AdqOi3ad4xjDQ-sCHMigUzKkIHuQTWD6aIn93j2guFjxSsG74AFBlQHH1l2DL5fJcPw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl-NDBRP-hldTQQCNoznrZMovoOynbpyE4jrYhKthsIA&oe=6AA00000"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZudEQ3PDvcwQ7kNvwFva4-j&_nc_oc=AdqhOkLC-oZXvGSdCq3ynXfLwmwAeCsbYNWBDGNr1kTifGvNUcw1kF8ekMwJFaOXCXY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP6298_kBSd8xP9QkPnC9SvgOToZEntj2s12GhhfcLRQ&oe=6AA01999"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzqX216QvIMQ7kNvwGZmIbo&_nc_oc=AdrON9AiW4tJGPCrVT60kvql6E7m3ENO43HwSO5165MSd1JwZG3vd5QlWp-eksaVvEo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAG
20f&oh=00_AQSxkruhRRRk3dvNRXqEjBP8Gzke2drLZzzfyCvede0RBQ&oe=6AFB1766"}, {"file_name": "snap1.png", "id": "272009212346056", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974560_272009215679389_1975683392130608105_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QETyFT4-dWYQ7kNvwG5yzRS&_nc_oc=AdpNf7xGABBRNGsV1cOJrVmKn0AekrT1VB_LmIZcF2Ooe039TY8d_9IWu7uq1pBZLsU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcfzdhsE7aKZgtOe7wXIaz_pd7gxs558Yc8WrG4FHPgw&oe=6AFB23F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqL32v2dcakQ7kNvwFpiYMT&_nc_oc=AdqaeVloN7G38_6nCL72G9_wPvdj1H22FpHMjCAf_MSSkHY_LykmsprX_-2pEDom7xg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQpEQXRZE05TOQx0C2QQgFv-xu29ZE2aj3JkzLAlYPIA&oe=6AFB1937"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMNnOhAbijEQ7kNvwH2Q9Ov&_nc_oc=Adr46OThA8o2Ntn7HO94I95MVw15xIdKhhQlKoOKCbGWoNipH64svT9yC5BWq2ekz2U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQePdfD1jTdq2tDAEGxNdHQDTqpmds4HGVgao-gF9hLfQ&oe=6AFB2FC0"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIz3ah7uU7UQ7kNvwH5eyOv&_nc_oc=AdraRZezoluFUJ00DnbRKdxYgEt9kP2pgcFE1r0uJaWLmSaVRXTFDmYRo9qcgLCkqak&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDCq24W31n8Hc6UYgIqbsPEDn-H8XwZ653VCaupE_WcA&oe=6AFB4959"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.o
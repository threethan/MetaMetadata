_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI8Vp0RSId0Q7kNvwEulYum&_nc_oc=Adpn8qRbnI8ESBmucXOmhsci7JJwjUpqFniSmoUnz2FhI0RitF5NZhtC831-nJxVBuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zo31N_6IFj9um0g4F7MkYoOfkc8ukWaY0nMyQhSARjA&oe=6A146D76"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lZhzCGbktwQ7kNvwEP0q5c&_nc_oc=Adq9PvX-X4POnxVv0rkIYihGd1PNcTHptXUQXPJ08GVUbxaaIxXIKsOWSCINRFY2rk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KsxrT-MyL09q_VOWvAt0yMohPOQ_0MO2fzwK5rm8liw&oe=6A1462B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1fJ7tQHsC4Q7kNvwEwewie&_nc_oc=AdrEu_8Jhk0jTgjHshKbk-BNXw0NLeNSqlEvBz-dSQb6E2ks07g4hGK44WnNLll1UCM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tg4a6KbLcufGShUEeGEcdnH45Idqb1IZaSo6mVOfnyg&oe=6A144100"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13yTYmvZQ4kQ7kNvwF6bexv&_nc_oc=Adozp56b21N2igviRHX_gEAp_IsVTCJaIYzoWic-dDEACq5Ir5vWSUYfGSh6dHIcPJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GLdFWhOaRo1MOfcZLOxtrFfiJ7Zng5oZMjX6uydrVHQ&oe=6A145A99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKLeB-gCiusQ7kNvwGP7hb6&_nc_oc=AdrpyAHnh2JGDC_f3KFFYrymeB7jYRdljq1x6HhJKvtZHhM2IVZqf-ldpaIMIAZ5D8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Hp
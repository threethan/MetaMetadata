_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iig9BCeZi8UQ7kNvwF4YG7W&_nc_oc=AdrmQFUSMPHeJyHa3igVfBp1uCpemJIu11RmNm_o0NWEmwctBMJB80G3HwD1oz-lqS4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPUglwa2UkdSvAjPixM3TCTzOxZ4xw61HOXdiBouOtow&oe=6AD396F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfREEbwE2WgQ7kNvwFuoYp4&_nc_oc=AdojB63RS0t6h27x6DrhwnJLEKT7f3pw55vcJeCIvfE648RSGHyroYUJs_KBtb9tq9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2XEvRSWYYtY2h79oIzbuIZIErZtysnpF_fFxXviQfyg&oe=6AD38C37"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD9ZG9cWE28Q7kNvwEr4QOs&_nc_oc=AdqabHBz642kcnjoVkEFpC8ZBu0YezqhFrbWp0Nqu9OOTTllxAQAM-TsAVbokG1f8Jo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgoR6qsGcR6jsOb6UuQM4_FzwVaYMGApO1Nnmcp-XWWw&oe=6AD3A2C0"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JujsczHhfdUQ7kNvwGqYpaD&_nc_oc=AdqugYqJWX5ewJ85T2d8s_DTVziO2j1FvtKTlS3KO7TWq6AMxc4Zty2jYjib1R2L0to&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHC5UZJShy0v2hkyYuD1mWr7vG_EEdNECFqRPgU4auYA&oe=6AD38419"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixT1c5-IZEUQ7kNvwE6SSY4&_nc_oc=AdpI-QF87zQ9pkG23WX9UlyLlDBk476zLqZumOAyDAFhfZNjDCpVPuJmU3pcp8UJ9Ks&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4r
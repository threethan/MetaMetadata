7z4AXT4IAK50oGZ8bEvlUs4qxkCVQbFgA1ov6ftQGTaSySVPA46QhBi8nDrmMZ6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftN5M0T92YGe3yi9z0B0aI-cMc0iaCdGlVbyAqd3HH7kQ&oe=69A6C8B6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY0FxffvNL4Q7kNvwH1y0iZ&_nc_oc=AdkfV2BBSIrcF8ieXrKtfAmUFVLMFimzcAkbTXxDDHzD2e5ayVNvkI-jpi8tVyFpmhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuxqpMTkdHp2oDdNddfAKZ-mVcp_0eKvqzJsP-BhDWpRg&oe=69A6BDF7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDYaIym2evIQ7kNvwHqcgkS&_nc_oc=Adl-rL_mZe6l4IchfIVgNTA0aq0VSHfbOWbI1XeIoKReLv8d69LrDvk-Os6ZCGyul1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAs1mHDyQZ2XxsJCiH9KefDH7CAL1cj4kipctJrqMLzQ&oe=69A6D480"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYbqZPWJzFAQ7kNvwH-Qitm&_nc_oc=Adko8WE4Ocm78Seec0lEQ2_7nf2w0jSor_p-RjCDx0HJlQlcMdhuo29eAyRadl07clw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFDf8nA4i9Hgj2LqJcjGGbFEQrzamuK1VBDKF7JFED-w&oe=69A6EE19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkVCc3hrSmEQ7kNvwFxtGvM&_nc_oc=Adlb7dTR03hj6CXUZhu08Kn5AYGbuRkuNeMXD89-FMJ3fDz0OMFAby0yZBNYr4ikw2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszImEabBGc2MnxcLv-084ldflabDcjQAPSpsFQhUFqgw&oe=69A6F095"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cogen Bologna", "platform
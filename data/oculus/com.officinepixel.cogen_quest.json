_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2_XIi47lnAQ7kNvwEjlHtf&_nc_oc=AdrsvRJnxa1cNgauMz2_fAaNf_0lK_6q5RUI1L4jzgFadxBZxo06_OJpiUUT_fRiQ-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScBrzppRgylCy1WL7FdicNqNViziOX6gsaycj2gPE8qg&oe=6AEA0076"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-Vz7e044t0Q7kNvwFc4QrU&_nc_oc=AdoJNxzYJu5EDnSX-eTQGYQv7hpYfjSvTdxf-5mUrkDgoan08lDnJbSFwlbXD9fiJ50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa6Bztg_bqZgTtEwlqVCQjLNtd4eJrdMJpfQgviQBTjw&oe=6AE9F5B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV3hiOvdjTgQ7kNvwHdRmk5&_nc_oc=AdovS9LdkKm6d2opAhe3R_SapYWeR07QKf4EJboVN9WVQBMzX63NBUaHq-BCf6oCs3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzYqvKFTaUOlLaaM373r1sMYEWuj-A4gqNi0kndWnVug&oe=6AEA0C40"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxyTSaCw-48Q7kNvwGY7JGx&_nc_oc=Adoa9l_jXl4OAcOXIHvJNMJIlD_rNVcUjOuSc78v49t0b9F_L5aWXSUq585x9P_06Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYKUmIHBxYBH8orwuyA8hnYhMIkTf7YKdIFNPCL7wdbw&oe=6AE9ED99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UziJuU_cAhUQ7kNvwFyRj_j&_nc_oc=AdqnjV36H6ktnKhANx9KbFQ4i5gyYBBuC6j_xMY_ahkEQpeibNMffHa0zm6WMUK1ZAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Q
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25sHg2Bbff0Q7kNvwGCvNMm&_nc_oc=AdqlP8ve2U9MC6w0Ah-Xy1fnkzL5D1hcrFETlVutxXwGQPJhQF7pIoNPYRcu86R0TFY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkgFN5xw2EDM6g8tQTYzMa7QMoMnMdGhHaEzfK8yPjfQ&oe=6A8ADC36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpIZutj7iegQ7kNvwHubswS&_nc_oc=Adp_azzbcXMDXNDlsICkvT5uEXbeUr5u7ILjz4ZQb2ZhAKcBcheWhSb7FJKegRkVMVY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIo0KAdt4CmWP9rL0-haAwa7U27Cso_dg8ELvZKJAhaA&oe=6A8AD177"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bao5RVsZZdYQ7kNvwHg8Mwv&_nc_oc=Adpl5j1TNNqbj2PdbH1eJpZFtq7LFglPM7ehlTfoboOxjKV7diD7I-CHFBVHU7TJcgM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMtEiR3ddC0YHdrZQzZQn7VTUllDEhYMam6bFD36O11w&oe=6A8AE800"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=955rbKcaxt4Q7kNvwH_MGAn&_nc_oc=AdrNL8Gw7ZVBzR_irtsJQhIvnK38yoTOZIOQ5fuIfJOQt0MpFHGAanY7_Fywc_CClvo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ-NmFyLYPbzJWkv5C3fp0pV7iABbzkOduaeb9hWvtFA&oe=6A8AC959"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7-guuuVvgwQ7kNvwFQm5O9&_nc_oc=AdquLpi9kPyHNA-Xa8-nic6VLHE99NlxJWQvOMMus39m2CrGxF8M2kb0EC2M3YndFt4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfy
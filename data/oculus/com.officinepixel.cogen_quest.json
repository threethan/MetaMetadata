_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B1WLswesUgQ7kNvwHJu_uv&_nc_oc=AdofyPz3tcLdiTiuQVZeR0RlB-9GxkQ7oR2vV_xMtyW0_blAgjIsxf-EymoUAz7bMlU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7wdSfADPxYsRVBXjGcX4bIfNA2lPvIL6ZPAaEisKjAA&oe=6AD0F3F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IopcBNf-7CcQ7kNvwH6SuRF&_nc_oc=Adof-vEKlhSieJ_gp4GpxVDBXV-kI_NbFKydJ9NN_aG7e4drWgHOvy3vPNCNl2U_VBU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODLN36cMuVApuiGxbP6emRfpvXRI3vpN5JhaNkW0dJdg&oe=6AD0E937"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD9ZG9cWE28Q7kNvwE8ILVG&_nc_oc=Ado_JCWu2f4FziaZkumHfNKRjEgDtjCx_9-fuon3_tWd1w6Gti4rmn2W6Fa6rDUdDFw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtfKAY78yaNknIYXNWHAx1Wrno2V5Pk0hdkHw6hKzigw&oe=6AD0FFC0"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DOP17f3lPwQ7kNvwFW1Pts&_nc_oc=AdqLDlxy0IgIPA4Qc-3A1Ei9v_MxE4S-EunQouu8Y_nzEGojWdGWQ8v5fi63pG8rqko&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVYtUxN7307rLmpmcAh9ba8vNjNQAd3pOL1OOX7n9taQ&oe=6AD0E119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDRQlYcGSPwQ7kNvwHyjDWe&_nc_oc=Adqh6-Ieoz-Z3R-TB53ljFldYynyqznwdx0NMc-GjKDez3U0990SWpu9870uRlRYNCo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSe
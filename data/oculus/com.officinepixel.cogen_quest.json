_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FQu4hFsRxAQ7kNvwGBMRgF&_nc_oc=Adr5IQ9ejf1dNMfgIzKU6vcYNdLnJTvPQSDmGyau_I6s4Phwt4qMZDErII6oge8Zfgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa3XZHzcerhH76lyWG2jvNR2503zkXZ9vif8KAKsvU3w&oe=6AA17DF6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeBDatDmr24Q7kNvwGqtF9S&_nc_oc=AdqcRvjzpCNQ9MH9__SBVMTnAGgRSqHJUP3IzOeAbkKRRhtusxhBB27J_aGvgc01uQQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2j4DUvPc1qZ5mCBLTUO_WS154horWyQQmhTWrw_k6yw&oe=6AA17337"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cKBgOjZX7IQ7kNvwESEWCC&_nc_oc=AdqNCh_04SthSp_Q6KnhzuxWVZF0InoEEwGOLRRELbK5hsFFgEqJcesx6LldrUDPZzU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMDcvTgvcHploEseykWubEIdaZ2hiESsqLr1oIqcZrxA&oe=6AA15180"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZudEQ3PDvcwQ7kNvwHWiqFC&_nc_oc=AdpdqbQ5G1tInH1qpCodtPX2oLe_feGw2HnNBdkdwXBEo1pjiOKUPkLq2OuZTHIG-k4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKftx9hXXg-ycp7G5-dpb_Ve8DiXnjBL92abya5jy6t4g&oe=6AA16B19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzqX216QvIMQ7kNvwEmtjzt&_nc_oc=AdrIgPk2kYba4r8f8CkkemGZV1r3dQriSkxfQq-97sLLXNm2e4jxvhIhu1yoUfIS0Ro&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyz
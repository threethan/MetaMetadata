_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2_XIi47lnAQ7kNvwFP_ha3&_nc_oc=AdotiyDLrE55fmS4bU_zHjpj0ouI10S57WC5f786_Q4NVs996suMd8yH2X1LZQyrim8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkQ7qviwLUgKc_LgwPmyb2VwadYCXgjgI7MXvk0BmD8A&oe=6AECA376"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-Vz7e044t0Q7kNvwFNRW7I&_nc_oc=AdrZBVqZDN2X98Yl8vD7K7ByVZBeX59JzhxQI-j8eUOJ7beldElIkOZLzlCCw7fUdWc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMPrEGqywuqbBybooX1y5ePlTbj9Iqt1C8AUb-E56uGw&oe=6AEC98B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTnQUV6k08YQ7kNvwGudBpP&_nc_oc=Ado1-nccYupXkNtPkMQO4DAJVwvaflaiV_QajQGlTDxCl-dQRs8sxuqiFzcS323GbK4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ-k6Wv7z1MBAZe7GBIodnHLWffFtUBBNBMxEpiNRYxw&oe=6AECAF40"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxyTSaCw-48Q7kNvwFBn3zR&_nc_oc=AdoVofgxE_TNCZDRYFPtWXOH2njsCa3y3IRHVBjbO1fdYCOyWGSelHv6Zkh_ALFzbEM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk4SubVgitVZk5JTLczc4oK6tUtCo1HCsTL1A4NCWrIg&oe=6AEC9099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UziJuU_cAhUQ7kNvwFxE32Q&_nc_oc=Adr3eM7e-mxCgikrjp3VnwsbvyoAXyKUBxWeZqBMynzeYqbQpz3_706ZnTFGkg51uJ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIv
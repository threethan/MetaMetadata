9RmKeZjLA2bfNgu8O1pBBbZQrfqR6B4lpDqWqDJvEqZSh66_0WnPliKhhjeVsyyg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afugus73B4XRssXEzjyBYOSS7jP5t38oIA1EAphQJ25Sbw&oe=69A57736"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY0FxffvNL4Q7kNvwHrMShv&_nc_oc=Adk2vWJJ0vNUxOKSb9PvxFhFGQ-fyrzhhzpylA2t7aWXK4DFFmC_BKQHJxlbZXUiYV0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftDZoQqIOZxYc42Y65d6NmmqFSI5pdXsGte_-EpzXAcCg&oe=69A56C77"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDYaIym2evIQ7kNvwHwVsFs&_nc_oc=Adm34tTjpNa3nrgW-xJwmKW3AfjpKk9ECuaq6yPdcr7wg6X1tvwsnYqyvcbvbNGo8vc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvWP2OjgPd2te9BfOKcd1-k7vYzIqTo4wv0WMRIOnL6OA&oe=69A58300"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYbqZPWJzFAQ7kNvwEg2nAl&_nc_oc=AdkSBC0N2c-hnpGqcxd3knifTdMvCXOcb7mtT6ElYGHl1h-35TTRFE6kbMllpwsUZoU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuVUTamcgcAStezkK-jrb3nH26YT6nY5Qm-sI933j1U8Q&oe=69A59C99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkVCc3hrSmEQ7kNvwHfST_6&_nc_oc=AdmSH5apqINxcs_54tLIwGel-Ph7NT5uzOzBk39mPPGRK7UpWX8Zz4KC1VCh5H07Zjc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu3PR01EAm8tBr1hQ2LD0AyNRyE4eE5XmvTn3qb9eOJXw&oe=69A59F15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cogen Bologna", "platform
png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R283BF4QdCcQ7kNvwH_fdcn&_nc_oc=AdkgcWvoIslVmXBOV99U0p0JA55HAgWQQPEZx8rZ5BuRdS4LZ6qeJ8swblZ3yTqsujg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3Dy6FpvMSHGC05jmP1CoT8OOr_SVWrOijCI5GS8DU9w&oe=69AABD36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr1Ek7S0xhgQ7kNvwG-aPv_&_nc_oc=AdlQ3eWr6ReiTzLQqtQhWE2xny9V_ninQeIn5q6ffmjCZNCVWIX9bROT3w8ewSzrf4g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKi92JvQE1UDQKveYP5dd-PKcHYH6lS9GUBNKds1f1Lw&oe=69AAB277"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHASZLt48e8Q7kNvwHFIEPT&_nc_oc=Adm4g0mg33jVwa9-igvkkAEyDhFEe8AinD7oz6g3ra0U0B7o9b3wkmtmu6tGs0ehUFg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxE5B0fM0T-ikYGw8EMbZjw9WRhyvZEihLdAu1OnYiDgQ&oe=69AAC900"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOtV7gtQaUQQ7kNvwFBUI5v&_nc_oc=AdkndBi6AaLriAoU90cA0XMgaZEZXEmRJfDYBCuJjvLCUxhGxBRR6PNDO3DBUY0aIOo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_jybegaSIbc8I_r8ZoM-ukVbKBGmBnafpRqgmyEdWAA&oe=69AAE299"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qpoq45tvJVcQ7kNvwFwy1MX&_nc_oc=AdlHx1ESFwow6k74qLeKhY3VUMEofYDaDYRniFg5zKGeMUTx8zEu1KZXB2ay2Q7jsy4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfykehRH7FUCyl5vbyUK3FcDIh3bOTGDX0lfVoml9KfYx
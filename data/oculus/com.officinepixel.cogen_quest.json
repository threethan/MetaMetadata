_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFK1vU5kzF8Q7kNvwFOPzgj&_nc_oc=Adp3wIqGR8g3PHxZ-XgUi0-t9SWvYgHiNsY6dBEiI-pCEx0Z6lOeE-LLdMM7_4iWVPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWkb0WHGrBHOlu_wWzKvrGs9lOW7nLloAJG028H4zhlg&oe=6A9C37F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb72aVwT2JEQ7kNvwHHbs1R&_nc_oc=Adr3lth9q465UeAEV11NF6ysZwtg2U6-dSYB3xRfW7Akaur-tnYCWlVWlX2sGDWegYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx2EZizUHFJm5oOwdDrqhCKf2aPpzPhy-_PHTKovoC6Q&oe=6A9C2D37"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmLGVglpzAgQ7kNvwFaOxn-&_nc_oc=AdqDlKwBQmhmWqimd8OOZE6BxTucavC5mzYZvCXO_xP1aDs0KFUIfCceFY--KAITqVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWmwr7IUt-9U8D29sLaNNa4FxXP8CPXFR41pQ0rwyQ0Q&oe=6A9C0B80"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9qLeLXq5BMQ7kNvwH9rqiJ&_nc_oc=AdoSW9jKArAbCAPbSIop-4Vr9VMcmjBsIcthF0vHVwS1bosrXPYGCdkaleGlJ6f5I-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRLAPik3-tBoLBX-ZUqbRDmisfZnNnMdw6DEDZpFfZLw&oe=6A9C2519"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB5lzd5nRKcQ7kNvwHi4OrN&_nc_oc=AdqbI4qOGZ8_DIi672-T_s2XVX7n6SU56K03qu5p4x8J8bt5ARXi3k0OQyqxGx1ANPE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr-
Dn7vM6uwEkaej-HaKPK4DzsSn9tzA20Zup2RB9VWOA6ILrJ-m3Zipw8kUkmYc0wA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuvzabqs5uRajyjiWBjMobkP5_Qs2HacF8UfuEFyMLmdQ&oe=699EDFB6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akiinva36UsQ7kNvwH5CAbo&_nc_oc=AdlD58mj3ZyH_ld_fqexQ3_kQjcHTGd49mdxzPKtiAbvblYfWiK8eM_n_YwiwyRcrlg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftkqpBVIoLuSu2ERy5L8TU349urYb1KlclqPdCilc2FgQ&oe=699ED4F7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA7alxpWLhkQ7kNvwED_2mc&_nc_oc=AdmYFVw7DbtsoOWng3ZHrQ1RpfSi8KJpeohFw4YarLeSujrFqD6_z-RszghVoYuV9qU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8P4HfCY-WAP8tCtPPcVM4liivhi7zl-wZv634b2mSNA&oe=699EEB80"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMmyfwTCHOIQ7kNvwHInLi-&_nc_oc=AdkKDif_Zx2LUROIqvcdw9FaY6Vnnxl0mdEyv0ozi8Upoj8ciTmIS9ncIaVn8VNQpWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuN7m0PB4jdJe8pEvqQhNYdHAbhYQ3HqFMF2B1h538zjw&oe=699F0519"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC3nX9Io4WkQ7kNvwED6-qO&_nc_oc=Adml9pz_e6-C-D9blukW-vg2d6Z8TRSHHTWoSWP3krJNUHq0lXWYob0r6w78qESlE-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs9e6iQuIPONDiKFyLRSQ6OX_hVEJl35dJCSGVs5RFqIQ&oe=699F0795"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cogen Bologna", "platform
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4USaMYpOrJgQ7kNvwEOJhcy&_nc_oc=AdpC_uLdk8_Iki2R1JWSttMElzdeySfP9cVXvU6xLzLwNBq5p1M5rJefVpsFYDI1qCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p5bmeJhYzE3MHB4tF_9W649R4RUa1zEOs50iGpR06Ow&oe=69D39BB6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EXOSJM4zRgQ7kNvwHqh_xr&_nc_oc=AdqiL7_9Y4FZ45dxpkkC1DQYWwCNhsW4dX49einKj2R7_KC4fi4xbR5mHTEZ104GWCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05LYtI0YkHAKb6zaJdTaqSmcBzYMB8eeyjJQtpBrqcZg&oe=69D390F7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsiblOmdBcsQ7kNvwEcFpEc&_nc_oc=AdrXtrg5o2lzgnmtsqtymK4N1KdXGS3nKMSNVBv_jJ12s4ndtxmBGZShe6oKJS5iwAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29np4fugtIsQzf3ioUMKddHwKfUx4UUUs8RIJOrEsaTQ&oe=69D3A780"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzptmJAX7lMQ7kNvwE699Em&_nc_oc=AdprOLJuY_lfcRulIC8nlNGlHvOFnr-T-V_7UJD9zEI1uCozzMUdnYLlH9feJRYWO-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mRVXl_aSO23xj4CqpJBhHnTGuCMcX8LKcOnVGJZ7F2w&oe=69D3C119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss840n2Jy1sQ7kNvwFYbahL&_nc_oc=Adqf7HvBBjcR8t6OklPzglsrX2SYM1PaEC3bZDDoBpI8VQYeCos0fkyo8jQhF69N0nI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30D
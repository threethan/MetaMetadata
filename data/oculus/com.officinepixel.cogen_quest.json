_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T75434hReioQ7kNvwEtCIWv&_nc_oc=AdpkD15FZn8HY5eCE9JA6CyI-kUXVnIT7NPrcph1p4PFM1cXJeqajKjbe-c6tjrOPHI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFbCgcRULYUduEBrqIuzeEXR_L2pz34dAcZpKeETdrRg&oe=69CBB2B6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2f8fPdqyTAQ7kNvwEBJD1Z&_nc_oc=AdrVe_hwaw_k0USLnXyfYgslTgJ0sHY6sR-Wi28bH1zNxwHy-DyUQ8yemrVDlGtHbvo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz81vvca4ADgLFzEjB6jlB5hwIouS1MGQ0JYAJk93-XgQ&oe=69CBE037"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3v49run08gQ7kNvwEtM-8f&_nc_oc=AdoYlkG51DqQIxZvxO5aK1ftTwItwMNvqTAwWCIQJw0F6T49QtSDmojSwUgRvEs4ldQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhI9SH2IaihBmKyTfpIO43xwsjGJLRBNcu6i--IFdbbQ&oe=69CBBE80"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqRL8n0ZuKAQ7kNvwGxQcsn&_nc_oc=Ado4xp6JUd0_hlVHjTRxC2yz5BWrVaOprr6sl9RqJXRbZs-mlSKrhxRSCO_Q5bZ6Zvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPDLIS-vE5Z8ylmrs5ymrP6fvn3gIuO87psWXdtJ5Ogw&oe=69CBD819"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6xsRkHIUncQ7kNvwGJhc2z&_nc_oc=AdpVto6REwd3U28AdTL4id1CGF9yffFBwC1ngXXgtmj-meHwMNRpVP6ntqpAaJuSM9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxj6
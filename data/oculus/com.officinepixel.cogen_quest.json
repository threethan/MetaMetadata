_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH37Y76-KrUQ7kNvwFWo_KC&_nc_oc=AdrYy1XdG8o-zTW45IEqF99SbwPyVnNOZYKR_jNKOTD184bR27TuIgnAdt5LrSxbydo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dlxnNfhW2-_4nm_CszVOGc0eZ3hYf86BMPaQnyJaXkw&oe=6A2833F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd1lOPION04Q7kNvwHtdMhc&_nc_oc=Adomy0soQlfT5p9riGxSmES5XkT9HIb8qRdJjvebpgOCMx919De5kT-Oh1RaTEW-w5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fETOx5dL6ZjbyxC0ToELK43OQsDrTBv2-L7Dv8Fh9fg&oe=6A282937"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7spJoREFhJAQ7kNvwGislwH&_nc_oc=AdphsWfwP-UOThTHKcWWmPJbnkOIHO9qAtrwfhpc2VdYCMCmdCV9SRIhkVeacgsXYfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-99Z24UBHGce9vMXHUqGCjE_bXUARHXoeFiUbQ2GpFVA&oe=6A280780"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IucxqNZ0_7kQ7kNvwEesMJz&_nc_oc=Adrpf2XpX7C1NvAxwW5dvvDgHxnWET7aMu1yJMomsae25lbaEr8-MVXKc-VYhXUc2UQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O_09GyGP2r55xo6OevflbSIJdN1I8rXUqkuKNTrf8Ew&oe=6A282119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeNtyVZS3cMQ7kNvwFihWKm&_nc_oc=AdoAiSqYr-J8gInk02U7lRXCD-GJIJRwglD2veS-11d2bJzJWFO4xFqmQe2MiuY1t6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6v
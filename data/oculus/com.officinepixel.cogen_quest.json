_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTaU7KWfZEgQ7kNvwEeDvcw&_nc_oc=AdoXI6millEa7fuPJ-IBhSNHgyFlxg09y1qZ-nBAZKD0_2MLIkASm4AT9-lGg1NIFk0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bZ5zzjxIsOZX0WLXHMtop326onvNc96GnKHpALwa0SA&oe=6A4534F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdJfZKtVEWEQ7kNvwEzNTAW&_nc_oc=Adqb1bOCSQuIhBw7VvooVjNDNI52VybfbIp17BmF2Z7qrFjueqseK7PX7FeJ0vCMjYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yTDtQBx-ZJ1efaAccy6fKuQdArg9M8x242Un4fNWSPw&oe=6A452A37"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Exg0vH4lVAQ7kNvwH973gQ&_nc_oc=AdpqpiK2a-FM135H3R7Iw15pwXxsQA4KYi_OucPIdpUaxbFcFoWw0rvGo36xJPJShsk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BMji5GSBAid93mpA35eBz9qXqL5tigFiCq1aRXKYjiw&oe=6A450880"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh0UZOQYhpkQ7kNvwGSvLLB&_nc_oc=Adrtlgp4CiSyIVFvPMNCY2A8XedP5n1vKCHb5TaY16GA7241iPUjsTsuyjtYqVoFXHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86AtbbOO5pGAUcUN0wAEgqkebXzfZ33I1-a1MTo0v7Ag&oe=6A452219"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCvhd49wWkgQ7kNvwHhqb3t&_nc_oc=Adq51KEDmng5ebJd-81A5J2TY3Wgj34Taes9WFnTH47p58jy-sY9Vkzz1MiNGUqGsFI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Rh
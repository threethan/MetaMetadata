_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6oxuE99GmoQ7kNvwHjlMIU&_nc_oc=AdqEGaauPMM9JbnHmbDaMFuAkNgIcJWNXU7fdnZnDzY2M99kXEyU9je7G5Mxpjs2tvI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LUGIFRYYzgo3AGmlEZdZl-N46PFoJl9zKjim13h2O0g&oe=6A341176"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMjSHxYhAy0Q7kNvwEzOUq1&_nc_oc=AdrNkUgi2ZlngVf5zfSeDivzhv5C9R9nmHqF_TIw-0biJn35z2Bbzc_Zj3sCwO8MQPk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fTgrYO5jHlMzTNpp0L1T-P6gFkylDRn31mbyk3IR0bw&oe=6A3406B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4cPjga9XzQQ7kNvwEo62hT&_nc_oc=Adpdm88jpFXUrx8CUufa9hFXpnloUalmrlIn_s5Ess1a09Sz9O7R2PYHwkAzDbaK32I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l2JaKFLFhzSW522WdDUuR_i01U01oFylpmJtmUlYXTg&oe=6A341D40"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0d5_GL3FVMQ7kNvwE1B7FZ&_nc_oc=AdqOi7plvOXbho7HbRFMrybFqikyfBkC5QT46qbkOdZo_oMFlZrzDlejZfuTNMsmwB0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ndys2aWPkvi3-bFupEkm-yLbJlWmQkYBnjVk84swIYw&oe=6A33FE99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKMPfA4k-N4Q7kNvwFQkn3h&_nc_oc=AdrByV_nJCVSmRnHSlaGwF0KipBbt5vSOLrk9UAjFntrGPhC4Nob7fsUvivTgohjYSw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rA
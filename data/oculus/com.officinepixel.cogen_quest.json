_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7UkuG2Gr8IQ7kNvwHllXkj&_nc_oc=AdpsI2QeAtLYt7FVIuIoaP32JggSUcWRR8dFK13gyrN3MaXJo9TEo0J8txtpGUq4lE0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYABIHKKjO1F3FWOBpDE577tDqDVKtnWhk88vdbDg5kw&oe=6A9416B6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQdsg6DjfYsQ7kNvwEmDDwr&_nc_oc=AdoCE5VgG0Sq0e4JrhUvFQfTp-RmviEoBxozIDKrLrBDdLQNGQxLQMY2uV8i-F9DbcE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSHdLyn9nhZj0Dzn20AGfuV-n3G0sLkePrO4JC31LWzw&oe=6A940BF7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbTgfUru70AQ7kNvwGgnmVp&_nc_oc=AdoSC0inloHydnrsWAIay67cLNHRh4uYh8ArmE1rPI7u9SAgdA5Shi7BeuPzcalex3c&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0zyh2jBjtU5rdUIHfaOKSvA1eU3V73W_tSBZuTg6eOA&oe=6A942280"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C-vpUnxcWsQ7kNvwGPSb5x&_nc_oc=AdpbtxghT5_2DgXmcani6lanwBGUOcYLZKLrihbYYUHb_0KzNDgvT0YB6p_y_AHBnGk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxbNaPgWBM0cgZG9bRwISq4DuWx9UVgZNuy8XxE1wgDA&oe=6A9403D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCGwy9IE6UYQ7kNvwEf-sn_&_nc_oc=AdqlkN7fwg9nbVCjHp9hJHcoCs38R76I5aZdQdniU5qbH6De7qhlFPXl5CMKp0SPP3I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgg
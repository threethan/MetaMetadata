_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3YbGr1fAx8Q7kNvwH7XiCD&_nc_oc=Adp_UTkuOnopDWB2wBWax4SZQDr1-uQApySQfhEroDtPPENy3JXTGFoJYF3yROeP47A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEeP5CweLaC1fyBuFZLqlyZTV_YFbDOYJlc8_JnPUjEQ&oe=6A7715B6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxpjLo2reR0Q7kNvwG7CmcU&_nc_oc=AdqGZraldKVQpavJ9bP2t7kBhi2fOEsUfMMzpFwA2x7Yc9nTl4Sh3i2Px7xIrSpSq4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmQE-zNjXeitxHFVsrXhEGNYnVCz4d68GecnXgLUNs0A&oe=6A774337"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=757JnR9k2EwQ7kNvwHuSvF0&_nc_oc=Adp0vxpuYgBsNrgWnDp1HVhag3WIcfq0kIouh-bsZAIa5UZFaN9F8-cPhLBnKM1dd9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNb6B3oxXogdFuX8kXWws04o7xMWmIvCgpq3pm8tj0yQ&oe=6A772180"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9b5gv7XCMgQ7kNvwFDhGVN&_nc_oc=AdoI5g-ciUJa_klt_MkeSC3Zq59GecvaQABDd3mSR6uVXMuMVYIbxKNJRGp9YRfP9ao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTHK8JER7e-2xLnJTNQWfrmo9boL9S0x6QnqJPLjEAOg&oe=6A773B19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muzNgFLgCJgQ7kNvwHaCvjJ&_nc_oc=AdqVMZjYZ_tdSvMoWcdPhyD2weYO1THIX72Ju2jfu3weMmAgEeiGvetiHS2ukdJt-mo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7x
luscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qA4CrMlHFwQ7kNvwF82vTi&_nc_oc=AdpDXJxhW0MBpYMosHUTnAoSYIdXN1Pl8C6b9QX-nv1Avp1w03zAV5eqLfiqU5vmr_Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjYsQiyGHhfhcc6pjp_EkWBdXBhgfM_FW8K2jrfpx5hw&oe=6ADCBE99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
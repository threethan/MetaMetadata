_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUxRuQ3mSssQ7kNvwFeTnLu&_nc_oc=Adq9q9vh8eJ1QP2jThATKtr1pIO1S33VA2i__f1WVzOWkILkNBM9evQHz5PESDWrxwg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK43_9Bjqi5bV76dKjB2d4jjlW547DelemRgTjxBUiM-w&oe=6AAD5B76"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f6yPEpnmI0Q7kNvwE6319T&_nc_oc=AdonNvfDl0ZnjnEM7VKzSPsjUMN1D7L5L-fhtQXbFqbeTvLy4iq8b6NYHf2-Xd42rUA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWGrgwwTd0H0TdL2VdMoSZMqnpsdecrX5diVSe1rfAcA&oe=6AAD50B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35ddfouEadEQ7kNvwE5lo9B&_nc_oc=AdqfldE1LAyjBE87a2_flT-BMpQxg6GzbUmoUTXqNz4XJ2aWjDeQdEvxDMxB3_0fcmY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYKtPuNEHy47jvLYfB3QSaWNARa-H-LRKXArhVOYdJpg&oe=6AAD2F00"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iX3yCiNuZeQQ7kNvwFtG15p&_nc_oc=Ado2VyM3pL94Vgnth5HZy6kc7e-ZB8V7MYS2BV3yYvGFYE4K4to7CSkK41b2ZE6KA8M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFeLA4VchQ2nStc-alkOhA-6D0S1L-02MJw_SMZQgZvQ&oe=6AAD4899"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNhvOC0aMAMQ7kNvwFfVptr&_nc_oc=AdpIDl23TiU5L1qtnDAlGsuacQS756iAeRp_2XskJ6oCkY7x4k6g0FLx0QHnwswv7ZE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLf
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58YDu05R2W4Q7kNvwELdPii&_nc_oc=AdrxdoNUu5Ksc0QaNdYxrfgz-uWQM4OthIEAZZec37PO4PTXhLfGxGZ67Xeekj-ma34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDt2MVsbBMTP_Kc7KjnRn1Bofsnkbmxw-k9HlYBIP4iQ&oe=6AF5DDF6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-qxG56WMCsQ7kNvwG4Xx2F&_nc_oc=AdqowEy4Kwh2o2c1vf7hqQw4iBtpkBZCOrhQM9Sn-AFOOL4yGj2-3_VWEeUiQWrIE8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ1dZDu1c1QLa2zBi3eIt1K_32ncrNWXRvIa3iUl6z6Q&oe=6AF5D337"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2TmoH3kl6kQ7kNvwEow2d8&_nc_oc=AdpkltQGc_YbTdGxN_3Gb78px7QStsv1OMkXUREb56Ihmbls4nkSm4SOBqDhtvb9STE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmaecLy9_PMg2s8AN_-y2Uz_Dj6rAeLmqy8qI7Vwg-hw&oe=6AF5E9C0"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=842fVfjmmwwQ7kNvwGOsP1_&_nc_oc=AdrpgSEwqKuW3dAHxnwT8YOxYIkCxAEENTiFqzit0e9HY_UgCM4-Ah76Vlt9K7W4Rsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfDAndc8YOpd8xjb2dw4-aKAlp2FPug6w2edJiA078ag&oe=6AF5CB19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_glLWHrmgi0Q7kNvwF_8J9E&_nc_oc=Ado2olqdUkAa1yQUUvyn9XBfwufNA0vW5bL5liWUxX92A82wOEBcPa6nl7f8Dr9Jh7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv2
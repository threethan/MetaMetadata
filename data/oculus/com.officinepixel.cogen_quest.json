_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOtaj7cs5ywQ7kNvwEBxEIT&_nc_oc=AdqcZ5HyYVqWuuGNq-NbC3YB9Gh_CuEc_sdV31kv1fNLOupLW_zJwI1FZ3OllSvXLAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNAwGN51Tkc5y8yqlD9onSO62ITl0M6M6QK47iMCJUdw&oe=69C51B36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaVVsXuyLT0Q7kNvwGsPxYl&_nc_oc=Adou5sY_d8v96Z1L7igbPH36XNIskR0G-_3-BzYoLkzYD-x7019WyteUQy79ju_Dzzo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOdoc8l6wzXE_8Na520-91WDWWXpmlqpBaJEJn7R0MAA&oe=69C51077"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=787qAzVN8M4Q7kNvwHpBUZJ&_nc_oc=AdqRZZGOa7EpGmNz6WpSPVSicTq7ozlhFo66ewQw_UYfwQkp2hy8ORQwLL83K-6JBT8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5WdeHH-njbZy2eIZMCH1Q-I3Q5mkeztPYzQOevzmJNg&oe=69C52700"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQYyZdR4P_AQ7kNvwGrj4lx&_nc_oc=AdqH7ER9Bnl2vtO0eeCW2srFXgju1tRF8HjXfGpdSty2GOlNv_h5fuzxTiCD_LHn_KM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5xiyJSCdnP_jn4O0oJerSNCxpo55Duv6V9DM0Gv-l9A&oe=69C54099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCl3w0FboOsQ7kNvwFUhrSQ&_nc_oc=AdqikCD0PqSKFo1S_9axaFMrhwRsqLYGUA7Yd5WZ4qKfMZ7uYMzEZ2wMkblnpqy0BIw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR9
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YvgalMqY9QQ7kNvwFRzAL0&_nc_oc=AdpBR7tc7-xPy-HGP73olQiW--tQ5DBAB4GwfWGLKMD7RlW76i9zE48Yne1BfZv7ph8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP628L1qdrJOZkw6Vt1mzgmIFiu4sgf3fRrcmk9KMLyg&oe=6A6DDB36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caxm6iPu1zMQ7kNvwEItldt&_nc_oc=AdqF8YrurWPS1GqWfHyH45ZpCzYrSgsmCQLjXbRu9rAdgm5nmjR2ELUF0Q1CA1Wce6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV1FIcugcdjyCLdLAS0swTyr0pDyiiJrWellFp3UlOjw&oe=6A6E08B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BkChTmsnp4Q7kNvwFqkp2U&_nc_oc=AdoOt3e3awF2MBrOrsVkDJPwNigSGHuXGRV_AldjfZ8PJBbBSCk7xQ5GAawUHF-Egj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqceU6Vgw1tQV6cRRXIdXE1nDFa2t_fsU90GYwCU1cgA&oe=6A6DE700"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOOEDRL727IQ7kNvwGWoewq&_nc_oc=Adrhzag-foF0khn494lqKjBVNd4CkwfcBgmFPV6aBvbT2rrQE0ApToDyP0OT5_V81RM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9YwVTX_fkMjFLJPzMVnL6oKbY-B7qgCxb-wM-11iaBg&oe=6A6E0099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F7ihmDusUkQ7kNvwGGUU5V&_nc_oc=AdotiFCO-Rbfx4FiEYHX_X0BqcHbj_zv4sEYIIs21j1aUr3oU3AHd-4YYKcFmOlnXRg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3z
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpSQFHvlG00Q7kNvwEog-eA&_nc_oc=AdrlulMHoDafYhZhBDtAzP9Kb4ZRWusNBMJU7t2kx9KiniuOkwDnHzm9nzte60I14uM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELWqYeR6X4Ozc5bWa2f4b3BBSzAMu9e8w9dZ9qg7_giQ&oe=6A902236"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boVoaYWO8WwQ7kNvwFvdDqO&_nc_oc=AdofXfSXH3Tu7BxL-HNlxL5TYWbfGeQ_48h1FTC6PKfbOl3IOvavde9KDgui-HDnKRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE99BF-7qQ-flELBwoGU2neY2zmzkaIWL5llKRYQxhAeA&oe=6A901777"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFyCHRVSJ6cQ7kNvwEkahO4&_nc_oc=Adp0FGSuJxexEgkt525HIzUlJ1m1MOvHH0S_lVTIvW4UL8zPiUA3xQVJZsc5YXoZH_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv9hNzwRUzkat4PamxuXQ0htL7ejcTsld1zcALX0jAeQ&oe=6A902E00"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJEG5zigeccQ7kNvwFAPXHh&_nc_oc=Adoh_WRd9e6uW-tEu0hAwO3V-V0JRMvVbbtuKOtiu6UNmQLV3ghSo7qRma1CuYC4qj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcOxPCPcdGgn5tQRdDkPK_UlrxKcarwWBhkY1x3ZkRTA&oe=6A900F59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60_fJbwonmgQ7kNvwF3hrax&_nc_oc=AdotNlbHZciehMMadfk818g1RhGYK5vcJVrFFV55rnwV_vnxGLnKnSSPLGcvF8xMJUg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr0
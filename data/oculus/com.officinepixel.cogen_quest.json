_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPmD9J060vkQ7kNvwGzRAPI&_nc_oc=AdpcJ_HcLnjrIIzFv6XNfiVuzEdkfuh8-ujrJUv8UMjKlrGWm2dsuZnS8va2g2Y5M7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hI1QSQj-vriQtgipPakWZZ04AG7Rf5a2NLkUKuXkxKg&oe=6A19B376"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KRpKENy-9oQ7kNvwEKJ6AC&_nc_oc=AdqoSydjNYqxOHThY32bZHJ5Mvy23KkXcV64DVQ8fLc8FwMd7Piks0bA3i3ot2HzvOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OLcQbXIg0lWuJwqN74M3mE2r23SI54i-deWu4DLRHgw&oe=6A19A8B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdNZ5Lzq0gAQ7kNvwES2y85&_nc_oc=AdpqdNgMydHbvtUosdaFmEf9eRViiN0UXmcPad3rTuu2Ib-N45ONbxgwCVDwoIIgPZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AsF2X5cS5fjQe_FEwdjS60yptBcUtowlKpOWMJ3pazA&oe=6A19BF40"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgAgef5qqMQQ7kNvwFq8yVw&_nc_oc=AdoZhhohfnjl1z0KEIQwrZk__EBsCouzwBphma95yGZNV81IMpRaTx2B8yioAm_EUaw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dbYyDlqESXl2kKqZvjg1AA35zZbzwz4MsUhCs0YhsTA&oe=6A19A099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtEYDRxdBWYQ7kNvwGZtpnN&_nc_oc=AdqHIDdhfhSw6AXwZC5Eqc-GhzfPsFaCgeyO_D_K-OGp3Oz4f_enzj1Eg-DtD0rXVJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fO
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUOzd0DfykgQ7kNvwEZ3sp3&_nc_oc=AdruWUOisllUcC0tar28j8BWoySrCSZicIAuaQeeiNun2YzPL0mS1w6u5FGzEks2IIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sbRzsqvVq2CBwJzAe1wQqHF093411IDml7aWmoIc9kg&oe=6A3E9D76"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCstQw6lYTsQ7kNvwFPkBya&_nc_oc=AdrJ3w-ZF8EgQqVbl38TWP7oxFlWftewwgYb5j9p9s1Pm4KZfB68vWVLTXHDrqeo7T8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fHy-Nd0Yxzpm5uN8K3gTUle_Mbv3bu-gnoU2GK6WzIQ&oe=6A3E92B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zo-HaLkvU0Q7kNvwHA2PAC&_nc_oc=AdrFqN5t8fk119cVGE-3xcn3Dp2Xqczo0BNMilhnJQ_iVVPWwaw7Vb-02KJZtbGNoZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93hXfmwsrFr-JbFtfh-ne2x5gRT0wH_1S81JHPGMUzwg&oe=6A3EA940"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlURCjxQbv0Q7kNvwEt8y19&_nc_oc=Adqe6NO01JAwAV-LMRh_FLh_C6UKkBl0YbQoI68l8Rqn-ebryroNV7oYU6shMBHCzuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84IhbS4NOAHrUiaPvXtF17uGyoP-dEjtZzMpKbhEPnkA&oe=6A3E8A99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVaVeXSWP8AQ7kNvwEoz7rT&_nc_oc=AdrOTs2OQBcN5XK0aZBIB3q9lKMiKAYiR_mwSJLwOXacLiubfRgwglkpnOaHj0XRLQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oj
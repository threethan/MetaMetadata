_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A3hJuS-O74Q7kNvwG99IZb&_nc_oc=Adqgm4C-aq2fPFLI-gWJ09kYtJdEI1KGMl7aPM6UIoK_BdtMkMm9--HpGtDqmrSg5PE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69Y7nYuY58aFnaYb45i-wWKPYK6jOLub7wvsL6M2t52Q&oe=6A1078F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foL5hKpcS8wQ7kNvwHRZHrU&_nc_oc=AdosTSjDpsbummhzuSk0w-ysHF-RQgyAk4FVptw7LpkR3TUyxgdDnt1VXeiLdSLDxGk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K0szsDCub-bKukMUG3y8U6NLhjBxItYcebmA1CrXliQ&oe=6A106E37"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSOhn-V9l1kQ7kNvwEqNNkT&_nc_oc=AdrEuFMbKjWPoVA600VGyiSxIoSqhIkDIO1BaLqBIt_yllKT9MF_eRl0RrNEMAp4dKg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dAFRAya7mUmWJ-saqBY-ERy1p7whyet5jWX3_bDSI8A&oe=6A104C80"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sry6y2EQ6VAQ7kNvwEwqDzZ&_nc_oc=Adqx0G3B8Mm35QkZhmtZqV7ezoGI4xrRQw29smMcUTCVCtnQBz04N3r8fJ9YPvZQIE8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5htuV1mVM2GhM3yYUsLTXKtPu69icMedRtDhvfdrK-1g&oe=6A106619"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou1JgRMmfBsQ7kNvwGhKoPl&_nc_oc=Adr9P9yb0ogeIJtx78syMJEIeJ9V4faRF4PPx1Yz6rDOKMtbNXwBmgd2Ac_lgu4jDlw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ht
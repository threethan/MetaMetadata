_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTWAk_gaoi4Q7kNvwHaF0X1&_nc_oc=AdqKReqoqsZ8o9Ipc38sCSXmKHoWQrejH2f190Jlr1A8xuLb09aSRXsEV9RQ_f4V7HM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlE4EEWTFZun712GNgZ5mhCb7LAfsBsvDgZ4ipqjlgqA&oe=69CFA736"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmc2WmBVN9gQ7kNvwGtacHV&_nc_oc=AdqetNGtYkd-lf2PPe96U5oxIMlxbG9h1sKHsBTv8YNbW0yyweVWd6Gjcuagb25sHSg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRnXlbNwvvUckyrS7BE3KVFl_q9-UtpVUJ1JemHxpyjA&oe=69CFD4B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ml6uwMnmDwQ7kNvwENM38o&_nc_oc=AdqknJUXpShsioTDtytbqVv7zp2TWCLuQfIJQKTjwuasidDdEkjIHDZm1pnghtuy3z4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyjo8njW6X6Mu7MGAXR7_Ai1-kcKgeJCW0lkSFK3N8n4A&oe=69CFB300"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqwujxAiOLUQ7kNvwE7-Gcw&_nc_oc=Ado-ZNy53KAd6cr4R0K-krUtz6I7JBpQ9IrLx5NxV1e2wqSdWSuBiGfknSfUDIZRh88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAtedtqFj35I_agBYoum0F-T8WHoZ0aNiYBjLM-P-Nug&oe=69CFCC99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGBG1krvGKgQ7kNvwFTmCy7&_nc_oc=AdoSdDWqKp3t6sHM4D34RMv_fuPqLo5vvR8E9-wB5BinEf3QdllFLIAANMY-2vbihS8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwya
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOtaj7cs5ywQ7kNvwE-Qz0k&_nc_oc=AdrnsOJSs_eR48uRxYt4UyrQniU_vWXCn0u2SBwI6fPtiHwfGsGeIlzEgtpG4MlhRR4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNHbDuXQiWo2bl0Ffg_urftpaMRWHyL6VMkeWacZLRMA&oe=69C7BE36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaVVsXuyLT0Q7kNvwH4z477&_nc_oc=AdovGvWR-ndkVM0H9LDea2G0fo9zNlw5RN3GCfUf9-Jnl6Rw972WWgfM_yTt5dSR4C0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzte6DZqLy-aHNS8j9a1-IX2Vk-58bR9yzsWvgBqBcksA&oe=69C7B377"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ4eQr_gmwEQ7kNvwGQcFcJ&_nc_oc=AdqmWPKE7sm15VGFW-FcWegj1nPnDBz0EpxvQdGiYixFg3OLtqIIZ52uT56cDyOJA-o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynvG-sTkWtS8ysVX11cWimdt1_8m0fz__XUSMgzkH2Zw&oe=69C7CA00"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQYyZdR4P_AQ7kNvwHWL3S9&_nc_oc=AdolDDlrroBkuqvwxlk-hU1AWopZSWpmLZqkcdk9e9LRV6u_XqKsTXMHq1pBCn-AwEU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCNGnlhRjwsniNZ8S3aG43zL9kjotqJy_a1IGqEABNIg&oe=69C7E399"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCl3w0FboOsQ7kNvwFpEp_f&_nc_oc=Ado1Bp0IP5t88i8hw8aUADrdIUBS_Rz5OYUWJoGWjPJE132h7A3_64r5-hYPzyrHvv8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8z
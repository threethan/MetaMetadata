_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rldv3yh57pYQ7kNvwH641k4&_nc_oc=Adrfu4fD1RcX0EsMe596GRtmD8wmWqOq89UqYx9bj-nqMxHsAvgpvgmdSLEMcBPDkRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGZXsXNLlhwKM0ofOAg47Hd7M0sGFBtEMeztnMi3Pu2g&oe=6AA6C3F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c0t_F5R43AQ7kNvwGKlEhv&_nc_oc=Adqj9B_OAaDTHaT7zua33GNaSTWqGRzgtqClFGD6qNiH0ylsey114Y0KbF_owg5FMJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyc0j3riYrGQZS1mVtJzoS3ZYBXU3Dp29k9AqsTxaDFg&oe=6AA6B937"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C88k3tnfGTcQ7kNvwFS-qzB&_nc_oc=AdqRvjfwn1eTu1MnyaPVn29LIBxuCu03Qs-OBsRS9zuKgCSCogphsg7dtLZHlDUtTR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcGD1EZwweW63Gp7LG3imYV9gXiaYIFkMWLulT9YLZNw&oe=6AA69780"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=devd7xJ5oq0Q7kNvwGPA_s7&_nc_oc=Adq7cXtDWtbINYcE20iax2rlziI7OXHek_GseWXXykHYDfL4luoNMaq1vEOsi62Ekn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfnEalTO10BwUoQp73Jlhmo94W6_ilJRmukdDP4QSuuA&oe=6AA6B119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO7gE3FezAIQ7kNvwHPrM0v&_nc_oc=Adpj1g6EXhGfgNynjFkf55xWdyfI4fXAHQ2LbMFcNM_rQBzjI-IOIGzeen5o4Juuux0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB9
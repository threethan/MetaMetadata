20f&oh=00_AQQZuGZ7ZOn7hMN6X07XCjWyDXeQvMpsjHnnFisZyKZ9oQ&oe=6B01E726"}, {"file_name": "snap1.png", "id": "272009212346056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_272009215679389_1975683392130608105_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4n9Tc5JFI4Q7kNvwFAWM7U&_nc_oc=AdpSQ9lrLxtrrgEwmDIhnff3CW7fWArN4I7avn6H45JBzo5IQ7d7hoaPbs7EMzrAh3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_-KkO9OwpI58FMqoG7pmCXWzxJ4sNOqvXmmuEDRM54Q&oe=6B01BB76"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7-ccTFTtZ4Q7kNvwFu3Irm&_nc_oc=AdrMh11bf-BNG1zdL1x6pG5M-e6F4S1CCTwdHBYg9o1Q0LcoqnMXPPbk4nApb3tUinQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzSppeGcYYbW-t67DSCAlgOFQghMI0mTAgtHOkQVa_9g&oe=6B01E8F7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7yK4a5z_UoQ7kNvwFkX3mN&_nc_oc=Adrr-lxMeb-tYj9EkqVZRRKqyPtDIOuMnwoQnhTkafnIItEFK1YDlCNeRl1GiDPHYn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSYcYSif8JoiC0Q90nJHhN9Y7h0NlvqNMcoGhhX5DbFQ&oe=6B01C740"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV1B8fgE8KQQ7kNvwFOdtD_&_nc_oc=Adqez6YpgKKcH0pa6k99tRi0IF8Fax1emaQTQPuFO6-vQh4_eeeMfRvy7heeqzqC9bs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPPfL39E8nthWZs1DQV9cj2IQKXTEXdCBhyj352pMMHw&oe=6B01E0D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.o
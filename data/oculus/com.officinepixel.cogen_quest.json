_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiA26PVJ1S8Q7kNvwG1ogP3&_nc_oc=AdqiWIPaghxsPYGhW3irIMcPIYT-JWSUM_04G-Uof5fkg70SWUa4lmA4CPyrMuPwuDM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I1NVGSgv0IUgDaUtsVtniTtD_Cj7-oacpvOSLePSw3A&oe=69E21C36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqMtiblWWdoQ7kNvwHkdTRi&_nc_oc=AdqBA-9iUaUbsDdPCZjQEgLMv98cFxe_G8tiytv8zqVYq2xbj0GjoiAkqcVsYA6qhxk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CxtUwD7d_b6J1F3LQux4VK9y1E_Ajpu4CJgkLlWN7xg&oe=69E249B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViYkgOWnSlEQ7kNvwHcmWJo&_nc_oc=AdpTmz00hlJrydQdTIzRSdxog78xKCzS3wjJYuSScPCyc07JePpKqO-5rHHKxPAjcoU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22udTBbcJl-4-fd1zpabQ7Cx6ujAuSMekBwy5a84aTOA&oe=69E22800"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZreRrpelS8YQ7kNvwFlDd88&_nc_oc=AdrIPEieOAmq6iNcWK9wps8RpHsaEdKQurkoz7AKAbPufsk5QlEvNpJvuC6YrL88vMc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y9zuLyv9ZJaf31ueLuHx44R-5ZWKUye54GR81rqBZsA&oe=69E24199"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6usW0_7n4PgQ7kNvwEcXoUd&_nc_oc=AdoAMTqqwIsw836AMv1NDPgIo7W5FYtcH91zEDD_7VB4g3N3c6jp5Q8sGwiH6I1jc-w&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ai
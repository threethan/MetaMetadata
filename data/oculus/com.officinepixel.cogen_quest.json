_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18IhX2sseOUQ7kNvwGCfUvj&_nc_oc=AdrcmOsJ9XGr4PdDzdn_mbDJpjSVBxwxHixFJ5Mnn5vczUdomTzR3DeL_f0gGTDtiH4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeinHS_dBGCWi_MoMji_owramq4BHNVOuGtVJU1q42Cg&oe=6ADCD176"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Efy0j-_MWAQ7kNvwGhjFWV&_nc_oc=AdqKYLbhVBjZBYmVEMkAkYJ1evu2e-OpQh1R9Nae7TjNHbgha6l0YRM8FiC3hB7QNfY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdbeDl3pW9IUMl2m1SawxZScv2xOcIP4Nynn-ArD2tDA&oe=6ADCC6B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yu4BHyx5OAQ7kNvwFNZBW_&_nc_oc=AdotDa9Dk94nWDlDwjcm1K5eACNc6cvHQAGIUYaUqez-n9YSBFwqDY8N-Gmhm1h1lt8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1iUD0uldSU1GeceDGP_x0vWOu0qsjOddHs6nQBHLy5Q&oe=6ADCA500"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qA4CrMlHFwQ7kNvwF82vTi&_nc_oc=AdpDXJxhW0MBpYMosHUTnAoSYIdXN1Pl8C6b9QX-nv1Avp1w03zAV5eqLfiqU5vmr_Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjYsQiyGHhfhcc6pjp_EkWBdXBhgfM_FW8K2jrfpx5hw&oe=6ADCBE99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFY0RMINEHoQ7kNvwF3CuyM&_nc_oc=AdqBGZqojww7YoSGezoEIzjS_YGHh5ZAQY90isPTxnvkfKsfwT5hz_bZRT3mFwZ2Wxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUr
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTdgEFv7GLIQ7kNvwHgBBbv&_nc_oc=Ado5FRp3epV19pU6M0FcYMdTVKvogjGIrcJdCw7RMttelX4qVlIP4drJNQx-jEDIAAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VbtvcxiPSidXXZuesnZbm1SMndWKAJHBWdYVyn17mFg&oe=69DA3336"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9Hwpd6jZRQQ7kNvwHUQZ1-&_nc_oc=AdorK4VJCjYcRh4Z-AAbyY8ElGnRDdcyB3H1-YJ5U4v3fcC1fxSHVCnQzJtUQQpKzRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wxAr2YE_qgylZ6pWpMrvuu4tI8rgKbhHiO8xSvY-SEA&oe=69DA60B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo7HPh-L1lEQ7kNvwGCWIux&_nc_oc=Adq_eay7VaTa9H_T07TIx9Ss7lLu3XsrZkXKCQYJJ6Z3PfyGR8__3PGln623s5cKB_8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33NRfJ8Wv1iu1K8WmDHc7Ur6HtbSRYDqQFqtxNTDB2OQ&oe=69DA3F00"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezCHaJogF0IQ7kNvwHUmzX-&_nc_oc=Adotazj0pD1qcburUVnXzA3g3sMX5wqHXxEp4WUnJIx1dRlo6L3MDc_gcCFHHFtObLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28b2a6vHhnK8Hm-Iby9sTZFRbF-wAlEomTxe-GYjzHLg&oe=69DA5899"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNvyHsOE1hwQ7kNvwHH5Ihu&_nc_oc=Ado_Z5TAnkyE1AXFc9XG1YPbLq_CPP7mJFR63ES745U-D9jnN47NgoF8dZko6q3rSeU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Kd
20f&oh=00_AQQxVM50piyhuTYW7yM0aiTx8rk8zvRsQWfjlorRJfepmA&oe=6AFF0BE6"}, {"file_name": "snap1.png", "id": "272009212346056", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_272009215679389_1975683392130608105_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7QjTZP3decQ7kNvwEcsywG&_nc_oc=AdqTxEJ425MIYVjaMz98wwzsqnPh9eQxEVeonBEXet6cacVz7SqBdK1q6o90XQFsXHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpiu-OdslPaFIFL4JxEd_bd4NMgNBtQlddHbH_mi3kQw&oe=6AFF1876"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1bDSopMJHsQ7kNvwH1XIYF&_nc_oc=AdoE51FoaSirQaIZmSUm6zzKDWJcGxYEQQhAbu2EL1cG3aikqvUJjj8cEsdmvex4F5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmz9k6VvMHWlvOABE_sREkV78KV1-EQsvbna5FVt83Ug&oe=6AFF0DB7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_MaUrCK2I4Q7kNvwHYxbxO&_nc_oc=AdpiSkpfCENZlSh5IaC5NLc3fsxUK0o611IwAVReXw4TCNv7wiKlQNeelqLmDFQ6C40&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR37MGaROK6LIjs-9pIL8185aGoIAvEI7qI7IU8FVlgWg&oe=6AFF2440"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alR_6dXFGdUQ7kNvwEBpNfv&_nc_oc=AdowC_Ir27qok8shPDedmI49Ludv0Kut5xNOtj0KzSu70sAPOFuWF4Wkpaix9vE4qRw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaSp1mc1ICEcuws7WIDrq5pR5Ulb9RNvBYKgEQMgEkOg&oe=6AFF0599"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.o
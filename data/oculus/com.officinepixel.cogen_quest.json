_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDLGEAB1_PcQ7kNvwGZnd3Q&_nc_oc=Adqm8YMtfaCTChz7KHFDC4Zgy-iei8Zk_4DtAaMvVCWUZUS3TYNDNzdqZedNmrWjiZ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeyP2MGbV28GDQQy8pA4Pt7H7PwoQCbGaMz9CmVje5pQ&oe=69C27836"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJOG_Gc34ogQ7kNvwHM8jPO&_nc_oc=AdqUcPT5IRrAYGpsuwdyPwDumh5JjZ6fRblQDyK8UlQdunm03HPQL0f_dQJnTwQTpus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjTbZDeV1SvR3NRqvR5LPPGwx9Alg9eNREJWqcpEidwg&oe=69C26D77"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYK_sLnpIuUQ7kNvwFZpKpm&_nc_oc=Adr6xXh8J5-MUaGWiyGsEU4TNrdUHaJ25PAbWl5K3BfpMrtsosuy6sICZTekNlyHhtU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGnzct0RsDO28wlIPnfnGxhVMJ7TdGHbO4HYef2ao0lw&oe=69C28400"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbvyWBTUAEAQ7kNvwEMJn_X&_nc_oc=AdpNgx03TPADQ9KEDvRo3OyeWV0dfh0CjqPfnkfShSCnIaN7a6i8NMM554dWmebZJKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX5GXfraNewLM7DRUMscSNNREx7e9u7GezfsNBsi7VYQ&oe=69C29D99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBZS2N2CLpQQ7kNvwGZvIZb&_nc_oc=Adr2x0htO6KgoE80MZSwroo6uzgsaoC8pgo-T2oATIiQdT3v-_zfgC4QHWvIkQu0PP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIP
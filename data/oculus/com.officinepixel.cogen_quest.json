215679389_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnC2JD1tbZwQ7kNvwERzGW6&_nc_oc=Adr0qfeaDi0Jd4vYeiCPEJzSGakG28A8MT_xx4vEekFCfnFRXtIOahq-jDL0s7Kt1L0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW92n7RI7_basyfNUqtSYgkqbs8ZXVe4tYWCL7fqhIBg&oe=6A7DAD36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqS-cluigl4Q7kNvwEpDtDu&_nc_oc=AdpUb_C3KJ5JNuyzlYsgtK7WDv35sIvnMTSB71w-5RO_Cowb5WeQRFE2P_FXRBvky_Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqcTPTVea4HUGGetjX2Kw0udoWQDJG--TOoFhY0jWjiw&oe=6A7DA277"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfioI1Q8aasQ7kNvwEW_GYt&_nc_oc=Adr5Z0oZgeq3sbrNx5elUFlRHzZZ1fTNPzOgAdGgcF9c_aFFy4xyp09wfpWJ6lsNpys&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi6UaC80YjRr-893FbNI9sOKxq7JqbpXkv5DqBE-9oug&oe=6A7DB900"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE1kBLCn08cQ7kNvwGDh76T&_nc_oc=Adpuit2XuUvxKAKAhOiDjinL2qO01jjj0PX7UdOR9eCr-iL0peyWn72sN0RYfPJ66zo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKN6aIh4h5DzbGxojCgYs8w2GFRRfboekaQT911MiVtw&oe=6A7D9A59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sFpPFHKOHUQ7kNvwFo-BYG&_nc_oc=AdrPfwB5LGjWXd3T2j68mNHE2r9riGrj6Z24Hy0N9B1h7TcNayWhW6W3HsO6fNf6Vak&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f
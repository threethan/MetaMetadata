_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VS0zQUYKjggQ7kNvwH078E6&_nc_oc=AdpWx761izJC9YpTp31KmBgtbqcNUsrezXaJZxr2RoEy0kdTMkdp8D4d3EIFWNa9atE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39sSzVY8UT-IXMbQNjrrfC4YldVZoqxj6_xFw9CiA7Ng&oe=69DCD636"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdA9BjI-gnsQ7kNvwG-EG_U&_nc_oc=AdqbQatjNqXV356XZJryUjBNye-CY8A8Q5fsH-UY43QaIwW-CxZI8azFxwSs1fjB1Bg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w8GqK3E0ZK98kQFNJUcbYXadDvvvG-XZzdfMDp3jjdg&oe=69DCCB77"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-bQqp3DpG4Q7kNvwGZOpur&_nc_oc=AdrWSb-8xeuITIvs0X_34ZtuvuxXqqwOQ_FTAOPcZ0tA_OBUPJ4DvtBRaUVSWQf3tdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SH-tbm2tZeV9R9RXolQdO-6TqoBOyrTyrrkc5nRAk_A&oe=69DCE200"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-LjYVqi9LgQ7kNvwHxv5CB&_nc_oc=Adolov2av3QqLKk8hOcgBzCDk7PUlJULCMQyizs3PituORC_4H7VJciMVhwi4fv6aaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KP1ROlhOzxUuQ_OXcErvxqtHrXRicqiLIridD_KkDxg&oe=69DCFB99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9I9Xs_Wxe8Q7kNvwFLhXpS&_nc_oc=AdrKa2Ajcw3k9QgP-N4Jv1qRTazcVZ1_4SJt1ViQNSWxXdBQ0-pQ0xFetXLqTtGCMsU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cj
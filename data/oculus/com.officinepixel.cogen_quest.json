_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QETyFT4-dWYQ7kNvwEHVZd-&_nc_oc=AdobAZiiFvy_YtIzMGIgcMqKGfEZBgIhrjY6ywZMYFo4JZ7A7bjzUeUMp2Jvi8S7LYE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGVQ1be4vSrgeMLPoEUUJFUGcgmRUts80kvXwFMx2ljg&oe=6AF9D276"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqL32v2dcakQ7kNvwFOTR8R&_nc_oc=Ado6hXmTa3yvybYC7wtLW0F9-DmONiMJtqF2pekxXlpQELOH94_w1AOwFDr39X6NTnE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF11goHDIrVvzbo-wU28l1NMJ51A-GgAJ5WTe5VV97vw&oe=6AF9C7B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMNnOhAbijEQ7kNvwFxAuwr&_nc_oc=AdrAuDIw962enAMtC95tQIFN6hMtMrgvP0IaHk3eZPQ4CRK4LXCVw6-um0f4uMilvwk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-x_9VpFyw9iHgIwo5HPPSq26SCah8FmcNr5yONpsfjg&oe=6AF9DE40"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIz3ah7uU7UQ7kNvwHAYeDV&_nc_oc=AdqI2KuFaAEjiNVNY-nzaIfjQK8h379ng0SDqYVE3r0MF0lC2grGH7Q4l44bOMU06ag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdMVwpuOBRm0FP3Dp6CI_KRTqVqtjmIvplr0SUPPsV4Q&oe=6AF9BF99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9ijz12cFfEQ7kNvwGivFXw&_nc_oc=AdpC6bK-aLHnCcc1HH-iJzRyB-aUkLaM_FVeZj1Dok12rClbjtq4Pi2SJEuwUJ-tY2I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCZ
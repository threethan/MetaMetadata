c_ss=7f20f&oh=00_AQQwwVlxn8HOXCJqze6cRj5G_8qja4aeVbgg5C6SwLOnOw&oe=6AFC6AB7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_MaUrCK2I4Q7kNvwEJpVF2&_nc_oc=AdqtHF03BJ1tTXb0EkD0LBsb8EiqVzSYGdwfFZT9eZrI05p_NdEP96hkfRsmrlxp7-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl1aoeLNDjp09bagkyS0OCUpWuQurgO8kFMPljsk7q8Q&oe=6AFC8140"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIz3ah7uU7UQ7kNvwGOVy69&_nc_oc=Adp2JYBZfzoBPqWdjtjNfuzeqqBQhL5iYml6J49lDM17SIJLbC5nRRMQDmgXRBGaYhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAcYnqgCdFCnWS0hRUknweStCN98Dqywn3DbPo2FBYcQ&oe=6AFC6299"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1006411797184046"}]}, "baseline_offer": {"id": "1006411797184046"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1691787077, "status": "PUBLISHED", "id": "1006411797184046"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6529967097094927", "version": "1.0"}, "id": "273295268642935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6465640073527630", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6529967097094927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "273295268642935"}]}, "change_log": null, "created_date": 1691772909, "id": "65299670
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjxllaXHQFcQ7kNvwFlv1MN&_nc_oc=Adr0KNIOGCxKgAFdeQPNILnil4Xfqp3DGfWDZYBz2Lq4o8YF9_WDN5bpiy2FmZ9E2V0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMnW25g81Ls2n3f6QPN-0PF8tNC9HY882YeQSCOmJbcA&oe=6A7EFEB6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMctrXpMv3wQ7kNvwF7VcWe&_nc_oc=AdoiIaLHOUN-q5iRoUfKuasPR-oriXEaXSKZ5mGK4Dg7rZnC5dfGrWwWyOxy-Lr-NWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3kLN7AYtwN1S6yWWAwwJ7eSVZd3aXxNAaLUJws9F3yQ&oe=6A7EF3F7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfioI1Q8aasQ7kNvwFFPl0-&_nc_oc=AdpX8BClZ73DvJSuSuwhyhZ6X9ITCxKH0u7dxKpYnmflFSWoJ0WHtXRCCJ45dGlyHG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLaycthKEowczBeT8i8WqsImGG3Q_vdUek3s3kTICtRQ&oe=6A7F0A80"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVM8T8twkbIQ7kNvwHa3Zml&_nc_oc=AdryEllYBsrDl46zykK49RCqDxyAIyMuJzExyVsG5zfX81oYc0BzzGRsvIwp3RUHlrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVs3ax_wn_CYMsN1mxm0IY0IEfK_d43B2Xm6fFBxxLzA&oe=6A7F2419"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK37IEZd2yUQ7kNvwHNvPAj&_nc_oc=Adqd4jsTpCiq7SF9ebLYhVYW546kfapdLMPuVIicv2kDlnfX-mH6DVtziPptLniQIw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH68
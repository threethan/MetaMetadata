_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOB7uof30gEQ7kNvwGF4iTE&_nc_oc=AdpTKSJ8xvd0ZmFd1UoKG7giIoWmsyFc9ZSvVDzFSeisICV7OpgwsebBnYSUIXc_0fE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0c-6FTiy30qH_LWxePRZa5m_xvGAnxgeHJC_LDUjUavw&oe=69EF4B36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQFlwciyk0cQ7kNvwElQiFL&_nc_oc=AdrF0nDwuoTq48o6CtgBRNJMMvROF4R2AUDsKCa1_JS6FVpB-BLwX3bs32f57VlbweQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bgnQE7dSsWQ8U1yL0A4ekNBGdcw8KbwtBvn2zPXRmaQ&oe=69EF78B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBUfUbv-fSAQ7kNvwHF9fca&_nc_oc=AdoQ8uzK59zZrsvOhPNSizW-dAnthjSkCMKkvl_NoE6GZDo7FsF3ivEHPoYapqvN-lk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0y-MxVb5uZiWduuDmQfFXD4oXkICLAh_cAXbtV7ov2fA&oe=69EF5700"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSZOYooO2sIQ7kNvwEE0PAp&_nc_oc=Adp1sdoALGuqb7ESnSYIQFfw4nXq_gvuQyqlMaeMvmB1PF8xJ6wC4JbysN2DK-rNCxY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c8GrlnmYfcFnJvpTcO2s0pay9I23fFOFzLRMrkYTxxQ&oe=69EF7099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fNBeA6zV_kQ7kNvwF_RLTy&_nc_oc=AdpuuSCkAzutza-ihNtKCk2GFTdoLI_grMVxeWT4mfJALRePqz_e3zBIylMteFZBI7k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37d
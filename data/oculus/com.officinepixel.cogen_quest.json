20f&oh=00_AQSlvTEQrSsi590ZTbhAj2dIhr3CkqBEJOdlEELvmBE37Q&oe=6B0338A6"}, {"file_name": "snap1.png", "id": "272009212346056", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974560_272009215679389_1975683392130608105_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4n9Tc5JFI4Q7kNvwGHb13a&_nc_oc=AdpszTTfZz9QKiCGGU5tRjn13OkLtOFW7OmH_bVuBO-XAEUoyKFYbwWQzDv1XMN5K9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4bUN1gUEYFxc0L7FLPe4pO1J9hnswfenQF5bBPf4CmQ&oe=6B030CF6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7-ccTFTtZ4Q7kNvwHhrU2t&_nc_oc=AdoDlqj_FIjIYxAbuL6GJzfOEXJiXIqnnu2JTaOu3HvdI-yABgnEWyAb5smTkNR5Nas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq3tmivIZ8uMwblS0x79ZBswNV-jgbr8NwWizBe-v1yw&oe=6B033A77"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7yK4a5z_UoQ7kNvwEfXPJb&_nc_oc=AdqGoh5lMjK0KZcfmTcQDY8ghSybwv8g6gvtbZUGSk0xxBYj-D0mFo-JpqEqScav6rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOfcRwbQDpaFlNSM1Ez3RwrxE4yplNZu2MTnPAAaneCQ&oe=6B0318C0"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV1B8fgE8KQQ7kNvwEV9hVQ&_nc_oc=Adqbe53u-ctEWfY8S1Wwfz3e_-M7T3pG7WjqeNymV-zxRYVxgdqGrvYMo8IGhv_KqTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkQE-B5W4cf4OO4q3kycPZtBQRfCbtvN0nufYOUlynCw&oe=6B033259"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.o
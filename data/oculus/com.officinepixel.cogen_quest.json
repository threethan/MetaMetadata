OTyab8z2SkyR4qxJB_DyynjD_lLDQ6VwYUNCoQg4Xx9tltsR_yo5izpPwt4lnUq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfttYQdP7MoZAz9tx5cgxkXWe3Z2UWFlhCE-mj_hhGPThg&oe=699D8E36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akiinva36UsQ7kNvwGFC79I&_nc_oc=AdmrOSV2E5NK_C60Httg7ro5dGn879AivXMTMkV1P55q__PJGN7XjRBDZ8XyKU2iq6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfthRm6HFxURqObu9Z2h64bGJC-U7MB83f4hMyr-jaHECg&oe=699D8377"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA7alxpWLhkQ7kNvwHR3HLI&_nc_oc=AdnfDIvdaS5g5g2Tp2L-eQx6PywgYEo8VIwP7BAW_xE-Mx3YhrRwmk2nIPM8DT6lhb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_PTY4-wp-_R79-WccO7r-lXG4ZGO9jObCk8QU--O1vQ&oe=699D9A00"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMmyfwTCHOIQ7kNvwGwwXNK&_nc_oc=Adlx4Rnb-HpPaMQ4Q-q8OQf1pv2-P-XG1KlJwD7FzGBX6CPEFFe86oaavlxfEVGGp_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6oaUmd_YPCRwY08EgeyXLhkvV6rNkClgtpBb_ITng-A&oe=699DB399"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC3nX9Io4WkQ7kNvwFUEEgP&_nc_oc=AdndZj4tIyKMfkH9IuZKILgmRdtNQp2pLgcFWcLJVCELLRcP8aNCK_CS6X6yFq9cnEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsYPv7WTeqsw41ERBt7VboswsAQumnwi5ZdZLXJoEGLtA&oe=699DB615"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cogen Bologna", "platform
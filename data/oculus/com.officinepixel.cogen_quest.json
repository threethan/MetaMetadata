_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiA26PVJ1S8Q7kNvwGqH0Lk&_nc_oc=AdpFAzFIdhkYUeYSMz7BQZVEdvcSJgJxIz9Cw_10khAs57kSYlSuhsJcVWg1vsfLvKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oyVj-KaWhU56CHu2WNYzPCqxK8T2dF6hPBi7TqUKchg&oe=69E0CAB6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqMtiblWWdoQ7kNvwGMlNDb&_nc_oc=AdpXAbffaA6HxPWyQ4X6a7QRx_mzA3DpFlPqEhhnpxA3R3AVS6V9viBSXacU1ILAf4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P-msf6Lw2eu69pp-PzfL-sMpIkj14PEfoY7W3g1igaA&oe=69E0F837"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViYkgOWnSlEQ7kNvwGa9mh9&_nc_oc=AdolSl8b1lk59NLmu7FZkT52j-t6n2dNICCMnOqur4A01hFpNzih74o6RFIdGOLEC2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v8AuKvNZ4fuo2a6LWDWsTzNWrRWHn87B_UDtjBfml9g&oe=69E0D680"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZreRrpelS8YQ7kNvwHGESqi&_nc_oc=AdpB6M9OH6ch2NOljkyEhDBGUk9lLloXXjn0S_T2zKKHlk3b8NzudwUPOA_2_L03Opo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z_iGLE5qS7sFL7glAdltc0qFLP4BnGRBiYd7qz2Sw8g&oe=69E0F019"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6usW0_7n4PgQ7kNvwFwNIuV&_nc_oc=Adrre_QEnpQdq4la31xzqyHMFD88MBrrwCVwddByOYweOBlwixx97rsjLZr-SBeEYgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i6
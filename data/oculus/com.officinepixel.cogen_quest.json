20f&oh=00_AQSWWq_yo4Ll86qyPRRtkUajue-8SmHnHF4OWdG4k7Ps_Q&oe=6B084666"}, {"file_name": "snap1.png", "id": "272009212346056", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974560_272009215679389_1975683392130608105_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ4vaJNWlVgQ7kNvwEj5nzp&_nc_oc=AdqWdrBd-ONwaL-QQ17-DnHWERo1griugWyDnp5CHrwGD0S361LH_BcxLsH6zY-XYx8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXald7RPhTfPjlNQedaNcNg_h-YEkDokPGxUQIrcW-hg&oe=6B0852F6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgujn0zwnogQ7kNvwFE7syu&_nc_oc=AdqOBfmz1-_yNvz0B3HnwuFrwaYmnTY7QJhFQuyPstI4OsnL_a8Arbfjbrh143UWkAw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa0DWBiJ8JfAgap-S7QtcBgp6pfuTH_RdsHYUImEfpvA&oe=6B084837"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7CewPZLps4Q7kNvwEYWxe8&_nc_oc=AdorvsgMvjh2ap6DS87bPEZOOVxc3rPluDZHq9sCgbGL4U-1IW2SkdhkVXvWvJeqx5Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoDIMdLl_LwMaPiDKRZ_rJYWTpEVNELqmnfCKRxfXDeg&oe=6B085EC0"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvyp3jNtFV8Q7kNvwHiLzNT&_nc_oc=AdqDabaduTpCGIKrxNv49LCODg0iwHdRkUVJd0K9RuHCdslTrSUKo0xBk_EcdJvcyUA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW6iIGBvGLyCP0hPbBbmsv8b_vnJa7Rb9kO5x9ndF66A&oe=6B084019"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.o
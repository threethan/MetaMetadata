215679389_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-v6rUTlKi0Q7kNvwEGfTEt&_nc_oc=AdqenvBlImLYKHoQW3nOgX7p2JjceVbfHwGqdhgS-uQwaRWm8TvpvsnIFTWCOhdTT-c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIiSYtcBQfdFqKYZIFUhs3kv1Uz4fIVW7Vf5i4CBlUnQ&oe=6AAEACF6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umtkz5TT6UUQ7kNvwEFhCNj&_nc_oc=AdqX5o1os6QBvKpOFJV3h_DBDlYKPJiktANOdckfHVLYpayWb7bZpyMfIudoE92LrSc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHDqJw0UxNjQb85RrHhBGboF9o95-KP-5tDx3D5wV3EQ&oe=6AAEA237"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35ddfouEadEQ7kNvwG-024K&_nc_oc=Adoy3oPO4jYSRaI1DY6sKLBOG-cdS1sn96Gr1435sluWlwqir8V6oDLUsbPk6A86uwA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz87Ifon_S87UsHnQXsD34lPT9qEcrmA4hkfRKDe7VWg&oe=6AAE8080"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51J__nf4s_4Q7kNvwGmspo5&_nc_oc=Adr_40mxh1QmJHRAm7WaIEi526FEI6651ur0n-YBIacl2-Ww-SXHM2n6eCgNge9UQDQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsVe_smEPGCNQhIKEIwidyzKfnXND-WPqAIxBvHCBmsg&oe=6AAE9A19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4oumYRpjOAQ7kNvwEASU3l&_nc_oc=AdqshqNsg2fcofsr4i3b559r-aC5UL-2HIgMmH0JPr1DFC3zT5jKo5VdCk3zNljRv0s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f
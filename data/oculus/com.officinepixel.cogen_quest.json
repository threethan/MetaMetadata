09215679389_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BziRt6SyuQQ7kNvwGhfIXD&_nc_oc=AdoCvl1trQ2GIjRMAFVVf_gX6zOUX0YWALvyyyxYhjt5bX1-Kzn8aAAVoSVsu1eM3oc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaTcj39p1htHfuFMfnkyDswkHMd79Q5PhHa4DKXzMLLA&oe=6A859636"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_KpPhhCMGQQ7kNvwGJb5x8&_nc_oc=Adq-P3jB84UQ_Wf-0kjmrx9xP-SgEDFFoBFpHTRteICu20illH_mzZTKfIaisiL-DlE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8ZFYOHZNY7kfGFwFdcP5ZGlmFSaKWLIMfgRvmTfT1Mg&oe=6A858B77"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTAWWy0Hx9QQ7kNvwE1KlZX&_nc_oc=AdrFDZX1TLJsjem5mhgD_G0keMCuGGG5wSyUyZR3JwdIf0uDVKVH9kteU5jpm7cTfvg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_V6nRAFVFBkMJeU7NhCJy32AFiQ4hdCjMH583_uEP3g&oe=6A85A200"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgFTvmDYlPsQ7kNvwHxcBKX&_nc_oc=AdqR3g3jiVt1uc1pDmuuqy5flxAFYpAV1ygf3Cn1K-QcBycc9yPmYrQmOkkbLsYcD8k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGACADY0NGp0AY0n1VpH7v68QgP8O6XTuGqgTZQlJEn-Q&oe=6A858359"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_11IlsE1A4Q7kNvwELSMtc&_nc_oc=AdqIa246qEDCuBP16Ero8GNIcd1FVAmKMR4DANpoRnnLkR9GSZXjSqWgDsmGk1FkEZ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss
09215679389_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25sHg2Bbff0Q7kNvwE5tyTd&_nc_oc=Ado9G6xOq-WOt9p873VuxrkK8cRzyYrYeCYJhAv6h-PSwqVUj-akiNjyhp-LTqnuNcE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPPV5BGNChaQIzjPuPcw-_TC-ocY3lBECtuMa63vCgtg&oe=6A8D7F36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGy5w72kCI4Q7kNvwHzjcXn&_nc_oc=AdqXHwF8q2IU-O2j2Xc2QmVnc16qkNGz3id2QS8_DtrkU7BWogjO7PebHJZ8jBz2wRw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYIcc-N14QXvpNqSurcLGQbh4vMtXcjebSBkG74g52Zw&oe=6A8D7477"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFyCHRVSJ6cQ7kNvwE6vtRI&_nc_oc=Adrtip3DgFEG9dDSWxnhKUrY8W0h3blxwasZYmOzpzoRLdVS4d-ngNIjijuzJ6W5Od4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9FC9--eBXWUmXnbQ1QlBi8FAf5cXXQUqZ9xW2cV3LIw&oe=6A8D8B00"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=955rbKcaxt4Q7kNvwE3h_vC&_nc_oc=Adpj_lYRUuX8lFRoZwiNLO9JABXPal7ho_b_kom0wosDJVGThsVkyYzeIDBidrKmoKA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzcpSyhCOuaADyjF9IKDgAOZfHcYB0APu0tEAOeTaiXA&oe=6A8D6C59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7-guuuVvgwQ7kNvwGM-nFq&_nc_oc=Ado5rAtI4xdVw7MezZSHLJE-2K0o-9AtY2ZFnuMFszNAF6He1nCuzn8OHMQv7VCZdvo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss
_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vw3itKcTxWUQ7kNvwHn45o2&_nc_oc=AdqH0zSBunOQieJJX01QIDZZ3YyzH9_nOcFDvZam18KNVxP9juFASGZMqXtiOxlFR48&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUWq0QZZZJrm3qQN1pTN0Mwz0L1wni-3zdimWObrZfYA&oe=6A58C336"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9bFqr8Y47YQ7kNvwHmyPjd&_nc_oc=AdpNNgdNWAl998om4S0fcUam2dcOWe2DdNTK3hDdcMThuW6IAJ-0vG1y9JTiGY66sJk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAERPLkYxQfXLchhMYEzI_sZdEkPjBbBGyDfYA3pkRyw&oe=6A58F0B7"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA2G7IpthUMQ7kNvwETGVHN&_nc_oc=AdpV6hzw4y7mUMApotc42gyZ8__URkedv6yVRdqrn3FX0fM_g29aJo7sQ6LNpzoray8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcIp3tPKZpXumzzBmk8FWXdIvQs0w5y0RoCqQqyp9xWw&oe=6A58CF00"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvmAWndEFEMQ7kNvwFw4S3V&_nc_oc=AdocWW6-_sx9KCls9WRCQ75a3-PosIfmuQu310hiFAv9r4pko-j9SM217OEWQHUKXT8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN7ZmcrSFT2ntUMM9kikUd3JrNXYqKcwt4CZtFXbgd6g&oe=6A58E899"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lp2LhOa1TsMQ7kNvwHgzh0j&_nc_oc=AdqV3taZSVRvVJIOECkrFpFBoKJi3vuDKIx_KZ29CZAWlLoXsgr1uEmvZtWoDPJy03k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDid
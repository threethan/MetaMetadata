30f&oh=00_AQURiqZJq4sHMtKdbd970a-imCHt1hUv_Dsk_A-s2J1mJQ&oe=6B1067A6"}, {"file_name": "snap1.png", "id": "272009212346056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_272009215679389_1975683392130608105_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHQn8fVVf0EQ7kNvwESIq3Q&_nc_oc=AdrJzzMdZHvYKUlI7mjoHTmDOy8Igiqst13D12TMA8N0JOClegP1OEvKDIn1c31BSzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFZGlsiUg6vEsx5ayeuhm-aVYXNADmKVnDWUKph4Ue6Q&oe=6B103BF6"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzV4_Dtm_T8Q7kNvwGR25gH&_nc_oc=Adq8rBPZ3g0qfuvuB0f_9z_GFHVfmdWW4hyo2ujC17iF2usVccpjduMiWBosSZm1f7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXcbYdhcI7DF3jJAsZRopYqdoXBtBh0NjyrUL_lhy-0Uw&oe=6B106977"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nx5f0SxvGHAQ7kNvwHjA6Ch&_nc_oc=AdqU5YTeo7ezrT62C0locvKJ2XN8lyBTIWqW_CNhG2FzXrnTjVZq5_ydkJmMiiKlYVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXek4N7lul63CTUPQRkDMqIA5OXerNX1kvu2bleuUAow&oe=6B1047C0"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxdpTiadL74Q7kNvwFGhn8T&_nc_oc=AdqLHAdXWoGlu05_o761sjdNxbjj8QYGBDPrgarhNRVidvS058Jq4AEOv8umpsXq7gM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxw95aFy5vn47cNAnPJsIsq2GrSb5EEPTMy_xvy4B9Pw&oe=6B106159"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.o
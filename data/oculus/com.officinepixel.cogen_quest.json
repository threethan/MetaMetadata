_1975683392130608105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vcb6ghKiqfcQ7kNvwGvypok&_nc_oc=AdoZ7X3kDd0KjGyBANUMWlxNK6stAhTL8gGWi8VvWOUAyF8niGwC-xFY-mln1Wx584s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyZcNOxBR31EVrvJQtQq2P3HMZ80QIsQE28vmWWpFW9A&oe=6A972A36"}, {"file_name": "snap2.png", "id": "316291900744301", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974753_316291904077634_5417683953155986552_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss_Vk1ZEQR0Q7kNvwEfpUye&_nc_oc=Ado7ldeBweCBlFe15MXxSJuFhspXNfHgH6WnJYOgkGKxo05nU_gdt-u8KXRY8Bt0zuk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkk6QicS8se5alDv0fTMWIkkEu-9GdaB3mLJejI77v0g&oe=6A971F77"}, {"file_name": "snap3.png", "id": "790030386251446", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974901_790030389584779_2727747340867349461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1j2GgE5z5kQ7kNvwGC-FKU&_nc_oc=AdoKF4CaiKIiS4_9yU21ndu66TAVUEmMZRNIwZfcdnRalS-64LuqEaaWXO292bJ7NUQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpCzq__w_MecXhMb_8xqlXdKFx8bXGWgtChWyFgbPJrA&oe=6A973600"}, {"file_name": "snap5.png", "id": "671692601495253", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974560_671692604828586_1222675315470194582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tegpYJTU63sQ7kNvwFn08fW&_nc_oc=AdrCgxVdyoU6JRnfJjvgqjUvOe0eZx7K6qgkx-O9fZf7vwb1BFjSNhE9cPQ35Jb9nP4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH873pMdnkn4LoxAIhjEehutWKCj33h6tGWm84Uh10tQ&oe=6A974F99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cogen Bologna", "keywords": [], "long_description": "This application offers a virtual reality tour inside the Cogen plant of Hera. The district heating system, located in the city of Bologna, provides hot water and electricity to 8000 homes. The conditions of the machines and the measurements displayed within the application are provided in real time directly from the plant itself. It is possible to view the historical status of the signals over the last 24 hours by using the left controller and pressing the trigger. By pressing the A button on the right controller, you can change the navigation mode between walking and flying. This application represents an innovative and experimental way to allow a non-specialized audience to visit dangerous and noisy environments that would otherwise be inaccessible.", "short_description": "This application provides a virtual tour of Hera's Cogen plant in Bologna, giving real-time access to data. It enables exploration of otherwise inaccessible environments, with modes to walk or fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.officinepixel.com/privacy/cogenBologna.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.officinepixel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3464471713882069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974792_2458774370960572_5452653619284679751_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbD4RLkKg5sQ7kNvwFHqp4X&_nc_oc=AdrkCRFmVPLZ4cpkkQXoZmEEYPKhDtuAFjah82-5Cmp-DWzo87vzWdjY8N1xptC0LBQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEch
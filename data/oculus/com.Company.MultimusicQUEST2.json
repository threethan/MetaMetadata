ulo2.png", "id": "158717710379329", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37lxkZFf3jkQ7kNvwFWJzDJ&_nc_oc=AdpLZUypFMGe_tJghn2vE0IpnlBRox0-1VbMdkd9HQ8RaaUZWB47jWaUkp3XMZ3vzno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwveHS1HoYHy5uducjKA3_Yid4HsOb-L-oLUv599JLkTA&oe=69C13832"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CZn6HPKeBEQ7kNvwGr9EAW&_nc_oc=Adprs_PsLBeUcFVbopHK9R0tmAk_OQRMjOjrLMly2-xXjGcbCN_1g4FQOQB2-rebMiM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxmtkMh2SijieyTIo8hiu2aMGF-p7xBAPSvGaWxiws1jA&oe=69C151CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBKDEq-7aesQ7kNvwFruplg&_nc_oc=AdoKF0lx0D3uMe4R1gh9Jp3d8KOhPLnZS68l6urRF29ifuoZfPNpNK_HLxL8t7Sf7oA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuK4zVtCZiMCaiYhhCF3Dh3g_mtfYbuy86IMxqIqdbjg&oe=69C11F28"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3clJloBi90Q7kNvwFKK3Z-&_nc_oc=AdqPOFhY1HlYpzNveEIHH4cBrndBy-Kc1OANZ5lQ9H3OZd6JxKmY8PnNZPIPdFkX578&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxPT4qMBoFUMsOomkpc7DziGXuWkLruiUuxOVqbjG2FhQ&oe=69C14696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yUbZC6S0icQ7kNvwHtEnCm&_nc_oc=Adr2ncVOOy5UCgn3PijDCyPCDH4iKtmPqYllX_8CKYUIcUFABkWdo4iB6JEwgAdh8B4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_mGebxK3rlQVpQt92yYidzcU4XL27L5HrS30ySwJJBg&oe=69C141CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW2Af6ZnCc0Q7kNvwE-arlu&_nc_oc=Adr0lZcn9EV8DuQfEE_pPZzpx7QHZMI9dXGGZvNxS52OH1BCfqe3gzD-Y8BZnaa5yro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVL46cUhwxm4KtNGOVPrbmyL73awUF--Vn1EXDIwBLWg&oe=6ABA63B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R2ZELNUURAQ7kNvwEzPu_P&_nc_oc=Adrje3KYiXQblb30kFTL6pvukGw8HG56KZJ2HrCkva4sbXsn35iXi2aXn7RphBPwu4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsXIQxdT8rJfyEA4gRyIRTHLWCuy-CLQa103orLGbExA&oe=6ABA7D4D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KttyIKMcQtoQ7kNvwHVJiqd&_nc_oc=Adqu7S1pbM1ZqENxbIdQY8CS_ZGoZsYjV7x2-0I_w7kPVM20G881i6XHEs9SUaHSBXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHbxEfe3Y55EEpp-QeOQDjrofRME0gK96TSiwikqI68Q&oe=6ABA82E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsoPCaK8dV8Q7kNvwEy0Ds2&_nc_oc=AdqdLZcD_tzAcbtvzRe-Gt6fvDpn22O-o2Mon27o4uYBrN7aMbwKCkc03zbFZATLK0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtxqVAXM5oHBYBF-hpkGB5POL5KjLijl_slRjuXg343A&oe=6ABA7216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPZpPXaUr74Q7kNvwFa0ixF&_nc_oc=Adq3KbB63eCYMeDlOPcQib1R9GVpmlU-d_hnPDx6uo3mq9s0LTzrpjQgpjj73ekdS8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-dpFij7mVfqYnDxe19TxF4SKvpYNlN2SHZO9_9GTwlw&oe=6ABA6D4E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
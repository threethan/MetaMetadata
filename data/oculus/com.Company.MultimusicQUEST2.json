8717710379329", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yziIqmN4t3YQ7kNvwFTjmgm&_nc_oc=AdpIsm5FYsZ-38auhH0u3UYqjUplHP1_NodKEqTzs0Fs8g53llzzifc89Yl8fUesxOg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rg26jqLpqGMDzhrujqvXIwZTG9f3IAJgQfSvVakR7Ag&oe=69F1FFB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjkGighfWAAQ7kNvwEEDwKx&_nc_oc=AdrQlZA8uJaGiTKfuDUVI8ZJKAMLmjrgDAF3YM4jKUWtjOaLryhi0ZCaH1i7lkEqp2Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0f1ZqGWPvm1wV_2hR_RXvXXkg0Qij7q3QXY-ncTC3O4Q&oe=69F2194D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5hPRzLRLzkQ7kNvwE03KNE&_nc_oc=AdrGi7hssLHKedK2b-mVRLCiw_q7eIVYv5SqCnGW3CxD0ixn6WrI45pvIkZ7vKkQZtU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2hGyp7uuS4qYXkUGjwP9iF9a6LDSBNFGiZiHvBS_ELig&oe=69F1E6A8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgLPVFaGas8Q7kNvwGq15uz&_nc_oc=AdpwVdTh0NPw8XZqJMbmGpogLuXcLlPlvKmnrnKRkc0R1r7x101mSTWbz3-gbc6jiTo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WWdjaE0M02WDuMqzd9kL4ZhC1cYUGGOr88x_o1pwAsg&oe=69F20E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clIJf7Gp9sYQ7kNvwF0_zVr&_nc_oc=Adrbc7jQ6G751gAAekZZVP4_8lMKJCHzMD8zgsQvFaORxPWIHlmi3YNjFbEHMo5JLKs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1HF4XBM-nhyDaR4zbCT6tb95dnDxbBggtoh8mKKG95hA&oe=69F2094E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_trac
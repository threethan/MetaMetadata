A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sT2YXAW6nfsQ7kNvwEscOh_&_nc_oc=Adrmx27MgM5C6p7K2Yw-dZttHY70MkW28dCFTK_UkqZHjq9jFAn7fAbcwGPu0XELIfg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVArMuZKzJRY2iOIC1IT6YMqboQodtT10_mwiSoVDopw&oe=6AD10572"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HT_fsGm1laAQ7kNvwHVId_u&_nc_oc=Adrz1Gq80qTKH70i9A0P280gI37aNkmC8mlbZgFmbo5hm_mea24rx6FaDoXzflOtkSE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE57XLDlJLH4JQrsH5bMseTjxUbMWVHVh_p32h9xU6uw&oe=6AD0E6CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDj3Ltq0vEsQ7kNvwFq_-UI&_nc_oc=AdpBPRpftQnq8UGMK-gMAlN1Gr9Pk1s9Vbndlqaqhc2NuGn7zJuklLeADzNn_NwE7e4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKHH4Pz3OF8SttyrX39xihZOFhZ-Bd9jkGoKZdINYh0g&oe=6AD0EC68"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWqlelUs__oQ7kNvwEEnfx4&_nc_oc=AdrbmZ5dY3lXIzAt2e3pf0PhBFCV5xp_M7fXtA6vC6jbjRuIDA3-yaBaotfLalOjrh8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNIdSi1cn6uQX7MBiIDuqPDSDbEpPtK5qwlJJVuKs7Vw&oe=6AD0DB96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0BkFw4bADkQ7kNvwHGSLC8&_nc_oc=AdqYpYtdxpVQeWdBjU9gP9o6rB9AAXrG2uvupXpd_ZDZl8OhgOb7mYtRIW3gk2JUrrY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObUhcOh-duVUy7-i5hkuNAA0Yk5EtAjHwM9mOsFmveVw&oe=6AD0D6CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
ulo2.png", "id": "158717710379329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETAzWAJgQIUQ7kNvwGU_aUx&_nc_oc=AdkQ_ujmmHDAPdK3TaBpAtL3OjjFRMKjfCKlIQ7gjCZFkP1ufJPR35KCK0LUepp0Uh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzw6WLxG4IrjEuZzGYFSyohDC6wRV4yDiDeXm4e81OqwA&oe=69B16632"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHfOqA6UN-oQ7kNvwEMeKWX&_nc_oc=AdlxJ--53UKghAQTlkpgj1DuLZ5j4ZV5tkwNQ7AffFHSoVptjQglUq4g02cR9m6o7So&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhBbes6cBU_m7JxZ4fVQH9uQX-Q88BOrrIqSHDv-GOaw&oe=69B1478D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCVsIgLynz4Q7kNvwFNdNid&_nc_oc=AdmaMveEafluSSsotTqVgYE6rLbaKsRByN0Lk2uxVT6sQ83mEFOxRXicCWCIu3DG5nU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqpn-6kpEQdxtQGDZ18ZNwhi9BVo8GXJekwz20yja2DA&oe=69B14D28"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0K_DIRogF8Q7kNvwGN20Ze&_nc_oc=AdmUk-G0YECmeh3AYNdP9soXqSnw1g10HVc0ZyOEODbANQsToBlXBYwtaEzKrI2OSoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKtBv9roP8ZBG9b9PvmCrkBvejvJXlIlSaJ_kmKmiOrA&oe=69B17496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXgFomJELp4Q7kNvwHCnSma&_nc_oc=AdmKtNFvZaT_54EE8R_CEn1HlVBXdXgC8jiHkzKgOTmaZGfAcd8eLv6e801a_nzhQ8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW38bhuEIt8eblyuHHVM5TDmIActOorCrtGg99B-h7xg&oe=69B16FCE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
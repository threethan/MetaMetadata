A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBQhd74uUcgQ7kNvwFAIPul&_nc_oc=AdoTRjoy4yY8XgVXE-K7qsIw3y_apvN8IO2D9kCtcU1BrbSgsNDwa1lLbBaEQTHouAI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ribAOYxHSWJ_fI4YVmHZ0ngM5aj079T4lYqn56mH9ag&oe=6A1ADE32"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZpT8-UJsUIQ7kNvwGNU3c5&_nc_oc=AdrCvtwhDqDHY8ByRYHSEzo3mEgY-eMs_Ybe-UX1tbsEQ1qWlqaj9JBgNSwga4-Qn-8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Uz1bx24s1YZdJRZoue_KOk8Pni0qFD_7l9NdUcSYRw&oe=6A1AF7CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-FBAYoa1BUQ7kNvwEIcPQX&_nc_oc=AdoHl3qsk3PXgzVl49IFZuBBR8nTEOJT1r8ys9IbeBiysv90FZRI7K4oT2OpfIrQ-Bw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rv5Ec_brvQarUi_KruayyEChhqN_cAcgwRe6x4cMmmw&oe=6A1AFD68"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb5kW5xeLpoQ7kNvwHlbUB4&_nc_oc=AdoChpEcC_RpmNUP4QEbDKNoE4-pB7rAQ8FxRqSKeRB3MBYnJ5ROG5Wsui4fA84K5r8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ILzIC9wc2tZf39zfNeKroytTxa1BRBCmjXPPbu3GysA&oe=6A1AEC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-64y0o_u2IQ7kNvwEgcOhz&_nc_oc=AdqB0XackZyVg_u9J0bekOMRmt-WTbygWR9qFpZ3rmK3hI2yaly905WeJSeZrmcYZWs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pv2sFoM4ie7o5qc2mNS6y2vqKNol5tbB16T4Ut4tbHA&oe=6A1AE7CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
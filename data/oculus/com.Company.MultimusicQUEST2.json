A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb6Ogn0gjXgQ7kNvwExNyl4&_nc_oc=AdoibA2QK4xVnFPuziTdXYhz6a6SK4mML0_jT9V6aZBRQei7-_MOIPH76_yQBu5vebY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmaecSCp4ar-KweQa3Tkm2u53uMMI-NWZHTSa1EhkrHQ&oe=6A5E1AB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNd9NWBnIuAQ7kNvwGv8FrB&_nc_oc=AdrUvl3M-Dr4IK9BxdSiPvZp5j_aFOrdfMJICNpgxjUpzmtQvoi8DP2d4gPgUCfhIqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_gKR6S69gC0nKgOqynww8jXsXDFKnc6_010IH_iUpBg&oe=6A5E344D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEe2O5jW13wQ7kNvwHIk6fk&_nc_oc=AdrxTKEqGMQlZpLoQATIFCTJZXcMs2Ravm0yLt4akRRIPce5GwOY5viK5Np1v7tK5ZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx5Gs3zYUGL8GVqjYeFf2wWNSWdEtWE4SE1-243Pss9w&oe=6A5E39E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8xcgjSJ1qwQ7kNvwGLh8z4&_nc_oc=Adqi4bp1vdUSwlTRZFnrlr8qyoywq-X_ju4m07BcPj1RSiUHARN7k3m3rOqP5ggnjg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsabWsQZcWiogSJV7OcSIuowVNcBa0npe8jQyKbb0Z_Q&oe=6A5E2916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3Mng66Sd4wQ7kNvwEP5VgL&_nc_oc=Adp1dMiRwJE8BsIMsiAxV4zJ07R50cxlVepidFjzkAaiqYo08eCXZiZlJWuPDarAq2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrIYavDWiOn6Rt6bweEFMu83hU6qZBuPpvG9PWssobdQ&oe=6A5E244E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
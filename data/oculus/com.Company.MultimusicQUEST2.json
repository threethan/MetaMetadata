A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MHRUOhv-YkQ7kNvwHyka4K&_nc_oc=AdoSkd2qcUQNs3Bj9B2SfTYZLv_7IsvDiIEPt49q_KSdMSX5kSEMY5uygEu_Co7Kj2g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxvmg0tiwaqGOpwV8zRFLXCXNkdzDZblHeFQvhyobmuMw&oe=69C7CFB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWb_p5OyzYMQ7kNvwHHKDsx&_nc_oc=Adol9oeAz5rjxOiPi4Ew8fHa7vdc61gqjM6CGNDGTsP72gqOMnlnodmUJTqTE_mmaYg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOlnziCgTnbTqP7Hmfa617_12iCliG7bEd1L1tYdT2bQ&oe=69C7B10D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn4go8jmIUgQ7kNvwEYjzhO&_nc_oc=Adq_9kjvwTIQxYIzP3q1T4ld23EX33lbfy4jOl7e9UOYIgyS9CafxU0JYqvXMd7FCk8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1LI-2a6t28tFXzP6ctbcYKFfR0EpuZwcyzRKZRAJ5vw&oe=69C7B6A8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bc5_2Cx5lMQ7kNvwHD0-eK&_nc_oc=AdofcN2PM8PlG52IXuQXvQwVPhmMyt_khvAVR6GO9dsXGQzfZPr-zf3nF21fHDN_S0c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAKCEOxeHVcCPf9RpHRq6EPs6ti0sUprmAa__yKGI3BA&oe=69C7DE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGoV3xpJYocQ7kNvwGcJOS-&_nc_oc=AdqxOeqGyKqFzI3O_F7UCPuBX0624Ei3T93gQG287O72PkvYWcg1lKsBAVUFXxDGG6E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxCQsC85xvCv80fdSlUgeLUU6HWo8Wo_ybFLJxy11XQQ&oe=69C7D94E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
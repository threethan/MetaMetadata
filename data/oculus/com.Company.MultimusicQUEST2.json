A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUhHWoZdpGUQ7kNvwGwskkk&_nc_oc=Adp98EcP3i9BpEhFMT95fwtDUmvClSdiubIjGPmaOa37EqBsYKkf12SevZbvCx0LSu0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2LMXMzNujVSqv0caS65Iv--eLhzN8Nk-KOOUS1CsCTQ&oe=6AECB4F2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2qMPXc9hFIQ7kNvwHGoqF7&_nc_oc=Adr5NvF5uqnv2EW8YZNJ2Ej-MAJZfralcUZxuDgPGKbMbfJ45Av2Ol0ZpO6qK0g99mY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkFdDMJ3QTfmQLGMBu71qWMkGaqvrdi4ac5aUEIUIjbg&oe=6AEC964D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPmCnsRDQ4oQ7kNvwFuGmdZ&_nc_oc=AdokCR2-YMKbtfXrOnuyjh5YvxUGCrYWhUOLo47lIMK71SmfzDBE9wOy8oBcSqGEQww&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1CNrUy9p_hilnD1cEkJAe3V-Bh6-RLtiUQVqA08uZhg&oe=6AEC9BE8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDQ3wwj9Y54Q7kNvwH1bz3z&_nc_oc=AdoN3Rtg_DAQJS9eflHPbWYw5UMNjA01ZX1c4qMGk3ubVU4Q8LecaxC7EKu_qAS-HZQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWllrrmrORIr-VCqq7hBRWyJoO58h1uidB_1zXVbGYhA&oe=6AEC8B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl6NwSFLWxwQ7kNvwHKaWDP&_nc_oc=AdotFWWTgaEfsDw7m2KPC41RjJSdT3MExeUhLQUkozJSg5HsBL57G2S8NjboLNQNqtM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS--ZLkz46Z1XUfFW-6qu-Y3lQWcwN_M4Ew3omO9TSOxA&oe=6AEC864E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
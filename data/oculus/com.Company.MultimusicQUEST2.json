A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ss26UyD5CEQ7kNvwGGbZJ9&_nc_oc=AdoxsJxGWnlltWEg5ZAojyDASc5vrSSoMCsxlsGujhjUuR0I3WgPqeSrPYApxXnrj3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqXGUko1kYoiKWCBTmDPyp9Hb0dfBeTWki3OOTL32NNg&oe=6A9033B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax7LyB0TLhYQ7kNvwGsvSKv&_nc_oc=AdqqDLt_U4qCkro12-XlbU9-P82LB0-xY5_yGgXwdm7X1Kz5j20xqa4I4NGSr_IjLb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe9_wKFKRuc2mkCGTfuSFV-fRuLgaFL78zIq0WL6M75A&oe=6A90150D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko-4cA4QQK8Q7kNvwEWsEdw&_nc_oc=AdpjocZgYD3Y2z8CJ26b0yqetL9wZGjAqMNWoOCpxt3G6EC2H_d3Tp24mx55NzPTqI8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcL0oR4acJML31vXqnsIPJ0HEsO7AQnP5-8byR94HDIw&oe=6A901AA8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f77xFIpSqiEQ7kNvwFFV3gl&_nc_oc=AdrAVWQ6Zot6YsUrc8QXQ6VPsMiiOLA34Y1f-bODKTxJKFy66HhdJi2Sr3F-oZGTpk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHCRZm4_mS866aCI7sQVueXaUZy9ZZmlFYgw2XB5Nhiw&oe=6A9009D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QzPO_09uVUQ7kNvwFlCQyB&_nc_oc=AdpGLfJn4uWhDd6nScKGMXMHiICIWb-nuQOH-9Q9xLnWxVpI0l35QnVvzBoqnQu1veI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg-tx5xNopPxtjB3KiRj4rfHs2oNuQnXDy6eQ6swr6iw&oe=6A903D4E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
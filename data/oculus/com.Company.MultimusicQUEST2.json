A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqhrKZ3BUGAQ7kNvwE7K3q3&_nc_oc=AdpLwsAa0rrvvHZVWgOlY-PlkYMjfhBejXfrPFMa8ljjNRvhTalBbW8zMwNsPcZTqoY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNt8CabJKQPtrmMoNeRu0f88xpcrQfWp4VqAG-qH7u8A&oe=6AC91C72"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_NYuVXVodMQ7kNvwFro_bn&_nc_oc=AdpBGewXB0jBy4r6L1i3xZrXWxw9qnrK7UXwGIgJb0TsKhLRuEZUUkIFnORfy3qMjIk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdGO4X1Ay2zpkrale6FvMNIxQemytB8-jzw4DmHq0Z_Q&oe=6AC8FDCD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uez3XNFUUcQ7kNvwHBn6FB&_nc_oc=AdojbcIBpIBVBU4KTRt8RqRP_cZ3QPTuhsWVP8G0yGCMyIBDWsmSgkZv3mrhGDIN9xc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIy0NuLAFZNEGG5zb2yv1dbTX1uvXBDJCxEhtBw_s_6A&oe=6AC90368"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_upyLi9gIsYQ7kNvwGbh3Cj&_nc_oc=Adp1-4Mkj421WJolC3okfrLCtGFGy5vZsTxON8QDy9ApMM29U7XyjiwfIoYH48sGtHU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkGE14n7LGGgiAn97RBOvMYamUs3RHtBCHPszs40GtZA&oe=6AC8F296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0jqUsjOohwQ7kNvwFHdxtr&_nc_oc=AdqFwrcrpPj39v7Huwzie3TTNqVLnk0MbLzGpKOH87vHOqyp2tZPBnuwF-GWqOP1Esc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvlpUrWMXVs9j14amkg9upB2mlUVDErD3qpLAEZ6PGJA&oe=6AC8EDCE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G5ZZ4ERnyUQ7kNvwEBBEAi&_nc_oc=AdqKqeh7Uck-KrwI-KGooBrPnDxlJh7LmSkKUAuPTaWaKUr80MIqylE5hr56QmbqRTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjhLh09xNjIpErFZZAZXvtIR4ENLkqot-N8xEhrVv2wQ&oe=6AB91232"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R2ZELNUURAQ7kNvwE77I0N&_nc_oc=AdpD1RYE4myKgbXctd7S-1-vxxGv0tp-CSIMQmy86utQL00NZWJxxCBiDIP0H97Ywt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCGyey2vxpTgO3hdXaSPIyikUfhX5BVsoYw7ytLkkksQ&oe=6AB92BCD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KttyIKMcQtoQ7kNvwESIRSj&_nc_oc=AdoCLKXGUL0I4U8UO1eE-Lu19RdG0HIym-IgRvAeKh6d1JWlqjPGg5oCazOJnm9wLng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzbByDFtkzoC3Jxn-60bOzf7kXAbik4-szqB0l6t4mzw&oe=6AB93168"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsoPCaK8dV8Q7kNvwG2JQai&_nc_oc=AdqHR6Hj2R_w0gXq5xGobsyGehFGPUAvplG83Nh1n9RXcTdULsNJvW5RSv0hOkqf-W4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM6PFo3KBP4VkyofVi9Rhorftb_JoWj6IBQMdKrnJ4OQ&oe=6AB92096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPZpPXaUr74Q7kNvwEB_Iq2&_nc_oc=AdrgLejyNI_eKYMTRpo7Zq7YGdzVjdvjP-EbgeMwb-SnJwP2BKOvsOLZEDwginCtyUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-lgLsO5od6ZJvSn4kb9N6-SQkAko3CCqNjcnn9FWubQ&oe=6AB91BCE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLgZtYxLbdAQ7kNvwFCyIuS&_nc_oc=AdoKzpZTSBuKPQpH4ePKN3fMNxVUWbS936jtVdHLN0Qk-0CZ4CLMgQ-xqrcy30DJUqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaPQLjTCFlF6g4wgeYr03liZ81UZSBBBHHuywy_Bv3Ew&oe=6A9EB432"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP9KTsNqXlMQ7kNvwHmGl2X&_nc_oc=AdpfyPCOfcHIfQ3cib8BWPMZL4m9QHqbFRtpAlzZ5jgYYLbCxs47_aRmFVETctnJvB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhO83sod1WL-lIcx1mBhSbdoplgPBvyNTx-Wjhy2emHQ&oe=6A9ECDCD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCEn5udNiukQ7kNvwEPaz24&_nc_oc=Adpbp0ts6WaUgf_COIHGEcnCsc5tpLM3x9W7V39ug0Cjm96HRqYZNIncMAHJvC7Ow4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIByW8mODIjU9ebmoEwmM3gUVY1hnWV_MXf_7eV-jiO9A&oe=6A9ED368"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxgDEfkrMVgQ7kNvwFcYxvr&_nc_oc=Adp1x7mIzmx-Qw_1Of70_9d4Q6TRAJZ-I6WAqWNIOLvBYe7D5e1Hxo9YMh61Mjp0p6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXsNuyq_mxH-5Pc7Srj60Ibs9rIMEpNAONxqK6fnWlXg&oe=6A9EC296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-HBosdAHdUQ7kNvwHVeEJM&_nc_oc=Ados7DJKb8mGC-eoZH5-dNe2gM9wuTMEBBjXRVfktA96BoJD_dHkX92AU7CJM8WIq4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpM5gLh70sJsRD-P1bM2G2AQNiz_NstRg4hF_W2_0niA&oe=6A9EBDCE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
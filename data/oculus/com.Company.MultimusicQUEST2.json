A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOjnKk2waQsQ7kNvwG2uw2n&_nc_oc=AdphjuAbbiP1OfrZyJHN4MERQMC8Ghz7Yf7an0ezqhGIKiCZb9f8cVZYs5dB1i7os1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJrSConxqGN9knIbcCjTlkeVOHII5hJ1BX3iZ0uHHhTA&oe=6AE76EF2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnaSU8G0Y-AQ7kNvwGyqepM&_nc_oc=AdoYj9RVk_STKolUM5sg4pBURIUuyzstseBWKP3hpcq6d3ETFlcgFws9Qy3ksGBA5eU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdWgx1ksA0mcsh-pbsPgztnj-rx5PryoBVOLnqUz8xeQ&oe=6AE7504D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhfKgEB7LeUQ7kNvwHp0kpz&_nc_oc=AdoqU-7facw3_2jujV2i-uu93VpmvjdxQYSqxpLqUND8l9ELqc7LsUpv2HjnEOQj8rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgxhbPsu01S3VvT4XVoS8eoAlFeAAwLq5rITg-yVhqxQ&oe=6AE755E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgvUMTXbij4Q7kNvwERIoZ6&_nc_oc=AdqWPACAiOmaJGQejPhZQwK7gpeNxSav-FFKI_EJjIosvLt9jhTWd8VNn-Si9XrASJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt7PJscnr5rWcxDSnCbW0EZrxM_u2eWS-DmJa-4Jibwg&oe=6AE74516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOcOsVoQcHUQ7kNvwFZd1zy&_nc_oc=AdrimNIxuy1ziyNMBeQmq_H1c6XiPMgLm95A2NEwy2YQlZDIwI4xr5WHoZN95XAoPmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOFfu7H7OT5mzzYbC3vya6hE5ApYyJvlq2VbZRMau1IQ&oe=6AE7404E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
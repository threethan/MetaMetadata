A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfp3ZF31DkIQ7kNvwF6Qhfm&_nc_oc=Adoj4zX3yZddanrCKW7a14JOv_2GaiseJV9zcYR03HGsadlFVqg_xBEOYCP9kpROe9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThOVXVw77aHECrcJyPfPmKlUavLw8Yhd-YHGusTSjBQw&oe=6AEE0672"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2qMPXc9hFIQ7kNvwHsLu_Z&_nc_oc=AdqlkTzj7Gcq1Ey095HjQ9a4gfms0pTvHcNrMcy66XmzCvfqtCtZKQEVC0e8CQ1keJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSppsRWI_bd8eZ9Vm2e5npi_U5RovMg6kFxBG-5wZxbJg&oe=6AEDE7CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPmCnsRDQ4oQ7kNvwE9-uPZ&_nc_oc=AdrmIWuO8GR_DCsiV8tqHKiRxjZAxYxjIx2N6cXJh2XpHnEyda9iE0KMUHlZUo8K_NY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-j6G_lvDdCjko3_VFSKEd7TfFB2p1HWX1nChIIGsUxw&oe=6AEDED68"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDQ3wwj9Y54Q7kNvwGosYfu&_nc_oc=Ado5WLUHouYdlumEuVW73q9qS8SXkXIcIBMJ5eX_0r2uk69nEHtjBcIYFD24e6hYVas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWP-VgwI9tvB8D5deScuByk98GF2dFbRBGoxfi6SVjcQ&oe=6AEDDC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl6NwSFLWxwQ7kNvwFh7Omy&_nc_oc=AdoK7AlkazJvZw5NsxqYgy8sggQSTqNBVrMVcCZ4JQb9CfuPaCUfcZoTjMKWFi-bNyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRAB11qYEerM1gVQqCwchYjWs3IbUra4QZddlWpEiGRw&oe=6AEDD7CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
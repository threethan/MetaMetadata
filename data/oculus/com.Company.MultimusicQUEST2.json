A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0dQD6NY2G0Q7kNvwF5S1XC&_nc_oc=AdqtU6f4rEVI476Kpgf20mf92EkG9KIVmaGLSHJpovM0szdfAbeL3qptz3nE6OhIkik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-fB8LxmgvwIUBO8M-rt-3ryBsObrC5o2EHAZUt-k1uA&oe=6A6F3E32"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m8eIi52KLkQ7kNvwGW74Yq&_nc_oc=AdrnrPyF2CyZHNoXs2rYQRkbQYzVYL4ccHs9KUpYx4Sq7HPTSlnsPyxSWjNMj2r5SDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGw64k1it3LboM8RJo51Xd6KsIbzlgA0DKbn-bqomDtQ&oe=6A6F57CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqHwYyLXQy4Q7kNvwFNmp9j&_nc_oc=Adp36_B6Wcea8Gl3Czqtmm644K1kzJBRU9C6uR7kxt3Y-2BLAz53X6yqiWXnLQ83G0Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB_Zn_quSMidH_sYUEJezZ58pm_lxHq7ySAGFB8-HPaA&oe=6A6F5D68"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHVR1-YLyucQ7kNvwGDL4b3&_nc_oc=AdrwboZzoJfjXqx7Q1FYvmH4Cy653o_ChQZIDBW1DEHvvMcsmNTz1AW_aNSXy983rAU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm93n0DPgjg3M7FtRNjiVGM5qotwQJHMGnYfurmEMo7A&oe=6A6F4C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWegBm-a9C4Q7kNvwEJVoAw&_nc_oc=AdoS9t95YDGBGsYK04gI1F7KESwozyEVpAArj6p2QIunyt_L2JGhLAof0uJpRsBKmIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSF7jz-FxXkAAR6KtgEIcWmwpEHVYpyRzbBbUQUHyMlA&oe=6A6F47CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
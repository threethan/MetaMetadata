A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yziIqmN4t3YQ7kNvwETG1KN&_nc_oc=AdrbCGgPTxpUvjTgYA3e7b7e_xV4F7NXXiQSs4RdvknRGX3ZwcXeWD7AmMfmflcYP0U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qjEggsiwvLbM6pMJXFuXXWSckxrKnBqUXEuo-H4qzGw&oe=69F35132"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOWPLAV_yhcQ7kNvwEGFd7W&_nc_oc=AdqlFtCCxBIq9QeRLKOwMGfUyr8owSP7SpCJTVbdib8XthDYwaGXD3ANlI7e9xrBBSo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1o88B_FJw711Izx1DAH0wlGHGm6urjxTxmpo_FqcvVOg&oe=69F36ACD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5hPRzLRLzkQ7kNvwGkyoHG&_nc_oc=Adoj9xXDp_VK4Jwxm9KaxBSJ4iLGk-rYxG4SCYuf01OAnrNqNQP_jhG2V7XCzzWSYnM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Q7q9Qu8_80uC3XkQTXXqrlOykJRUMWDlPF_jXrt4nhQ&oe=69F37068"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_UnJN66RC0Q7kNvwEU4HqS&_nc_oc=AdpV8ol_rxcdAmIoOG6-j0GchgAzmFaLlLqMntox7ZRAfliGrcpyGRoFAaCxuFppAzE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RwCWGeVmYULiWFWg4qdkwGkhht2zTpsLasEuN2FFpiQ&oe=69F35F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zw201-5r1sQ7kNvwHNoH-U&_nc_oc=AdrwQxPRok7l4VPoiQJtvHpatBNR5VWh4Dn53wyttG9vIHvHrGoSS0dh4_q2I7zMtfw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d2jeDD3OGFIF_0q1jgz4eUOzvTfldRN0rMKroSAASUA&oe=69F35ACE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBQhd74uUcgQ7kNvwHNvuEm&_nc_oc=AdqlnIbygITgZ1K17eloxJGNUQFh8grRaAPe9vHF7Bg0xyYNP6-dgDfDRHr19STEFpU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OLaFh3twoTMM1qiBBiU9YmVya5Hx-ypISqOO-THOVAA&oe=6A198CB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9D6h7YgczQQ7kNvwF6-X0B&_nc_oc=AdoNr2DA9734Ymtzr9ZJnQepAMf-ySRXcWiQ8dXl2tU4PZ_JXy0jU7_tFg_REjGDd_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KGxURIaWUiAtcRSxoFdb9YF-2dqcusA6IlA49am4SDg&oe=6A19A64D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-FBAYoa1BUQ7kNvwEbL8es&_nc_oc=AdrTTYPWwZpLH1jlJ7SAu54uJIMCiNXV2TX_sNVIMCiS4NUalrASWiBLREsgVGJljVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C--D440X5PiCR54gBLLREr7DlCmj5o1rL3nsyQqyN5w&oe=6A19ABE8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpgj1Jkc3TUQ7kNvwEelYxT&_nc_oc=AdqG6pxGnEs-_1n3XvlhW5bUCeCfSuslfKIRzWDSZrlOZWZnh9iW_TNq_PPES7KYT5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y8556pq1ZoRHF6Y6gvO2q_xuFCgoC_k9qTJFIlFTyww&oe=6A199B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeS_aMTT-aEQ7kNvwEw4okp&_nc_oc=Adq8COsGodZa-OC0TTFeZq4SZltF1dd0seb4ZX1Zy7a5unL2n0q9U1kUdoWML4XwDkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W1cwTHmO5v1BA_j0FwoFfHm9tqqR-MxbcxpwRtFZVlg&oe=6A19964E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
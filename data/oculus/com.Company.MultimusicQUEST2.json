A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQjqifsLN4MQ7kNvwHJesta&_nc_oc=Adoijl-TdHNWKvjolkzs-rVA0rHkpPLm1yr0l-Q3hb3g45lYYPe41OdHp3RCMzfIahQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFQtjopm455sNONnlIBc6hKlA1jm4KxXncbDeGXMxDNw&oe=6A8AEDB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFk_Svrq_G0Q7kNvwEbb0Jm&_nc_oc=AdqoPaD8ykBHrj7MVGihVhKcBxpuKkbZGOPnf2us3BAke4djlxh9x8lWjlUwRZfkciw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzVh0OD4Q5M9fI2EII1Cj7sv751KV1ZoiSn_pNMbUj7A&oe=6A8ACF0D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7wIksqHDmIQ7kNvwFgl54L&_nc_oc=AdoG7d6X8jVCr2r54zmJreVWwu1_IOx3MFHoaegoOyvWs2y7yEVqmq5qM4p7Y9eq868&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjrrCvVJck80catDoUBCuVWLbgIZgBEW3xM45XILw6FQ&oe=6A8AD4A8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r56RTph9S-cQ7kNvwGN8Vtf&_nc_oc=AdosT2E6l0iqhNPgHB4si3x1AnySSR6mT6BZzjWH1gWJ0NpBZ-20yZ5kO7o6SSsvAJQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUPOYbBNikqRg9GpotmVL3ZocjeTw3H-Jy_iBklW2E1Q&oe=6A8AC3D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czq6IAWbbiIQ7kNvwFfS21Q&_nc_oc=AdrX1XzglZzJx747tVKketufmucfYnGECZ2LZRIF668oMdvHWmjRr0GfifPu9x4QN9s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjbSG9pm1vMbfJs6C6yvbC_evg8tW3kPMK7CZyJsS2mg&oe=6A8AF74E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIwDv-VHfhoQ7kNvwHA1eYP&_nc_oc=AdqrtJBBTD08g1sHfqLFJWwsmLpOvDLehy3iPFwAg-ZDPtcuW6f6mXUQBJmmy4an4EI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLiWRL0w5sjocdsJBCyY1RAOhk9M59chLNCT1PYPa-6w&oe=6A4E48B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM263GqmfagQ7kNvwHCECIv&_nc_oc=AdpOlhcdUG8kDmWospGxSkN36uITm7VJQiu6j8Gg5K99cAxBC_kbTI9NbxChx7NXjcs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBys7jr-XZoqn15t9qq-d29MbR6SaxmW17TD6rtn1qzqg&oe=6A4E624D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ZOZqv4mBMQ7kNvwGpvEGs&_nc_oc=Adr7MMJwNTwrvaPLErhfzaFfZSVoh0Mbv9ceaFZeANCRubL_O0t3DCFrxsOBMYO_pOc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0Zy0EuOgHla0EEV8SN-AzAxKYDJr2-CKgd9jYoMwuJA&oe=6A4E67E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ9hzKFZSnUQ7kNvwGZxHa4&_nc_oc=AdqK9G6YlhO4ht1zN5RVvgoI3QZjpJPzDEn9OsPK5_fqig6hYc3E6kSLZFvIagJ_1_o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXUjChqH6AkV-ssmZh5YFOHhf7nrNIb9UCNMkZAYCjpA&oe=6A4E5716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwyzuNk7dygQ7kNvwFpPj8N&_nc_oc=AdrzOatzME2Mi4CgWsYxYZd6i__XLtjlz0DvoKrgwcFE50zfYdOX4tLc0sDlTbzb6so&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpUvdaT9rHidvDtCI7aqjNvU-Kmqg0xVEQtfrR0jAJrg&oe=6A4E524E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Uoy4ZWo5qQQ7kNvwGZwQ1m&_nc_oc=AdoJJW60L8IAX9_vk7OShDD_c-SgRrKSBOIEDVktLvF_ayPIyCTdKFdOvPymFc-Wzhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1WabyqkCJtGzJyH0DWk76E0nMwaU45GMaq1iL0TVd2A&oe=6ACD10F2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3szQ0JOIKSoQ7kNvwEzoecD&_nc_oc=AdqIDfWnvkNn0qyvgPxM5SQcog-hpzNBlpIO2C6tZm5W03-W6TFtvL6UAOXlQGs13lo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCoEVS0VJZwJ4EXMJKKCfht82aBebnyZ9YDclhYxFS0A&oe=6ACCF24D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plvGxAzlRwIQ7kNvwH7NuPl&_nc_oc=AdoZHMigv0a_CPWVaToUM7jw-fXaCjzxW4YsuQefIJCJhAYzEXaXF-L68IxybzwcL2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPam3czqQwPMeg0ZU1FD2LwAYo3wbtWUldZxuiCaaC-Lw&oe=6ACCF7E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrraAh8kNxYQ7kNvwHRcCad&_nc_oc=AdqXf3O4Z85UKRUSONzqAvcGCf37Muf3N9ukuhErKeGVvb83L-t2ioivLcJvmpXCInE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdOWI-dvCpwBsNSFA5E8RolN1eY-TUPIkBsLutFObWkg&oe=6ACCE716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HoxStMOGkcQ7kNvwGBDjDD&_nc_oc=AdqD6WHWKVohGRXFg4HtyJZSI8OQX3MsC7jp3q-o34yReXf2CM4Kq9RXKdvBfMGGUQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfCeMNQW10bNzN-WKMQQxXHoY6GQqE-pP52vAWwZrJNQ&oe=6ACCE24E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
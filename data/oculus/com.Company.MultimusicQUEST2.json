A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwTjJN8nAnQQ7kNvwHT8zcj&_nc_oc=AdqgXOm9w-7Z-beh2b9kjYc1KmMNiGksUf7CNlCMlOSwFDEhc76Na7SaZwu3wNDehDI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gj44wj1EhhI9NiGi03yQPND17gmBdjsNGSNR6mig72Q&oe=6A2418B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwgR9RaMIN4Q7kNvwHFqr_j&_nc_oc=AdpiXGuD8uD3Dmy3Z_nFqcNs8dHkWTk2sJEpYdY6pjjmrFaZVAXroEqcOWhKz3-OWMk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x6GDLNYZ2QPoELjRbeWx3rHLvjEieYUwUcUXX2pxh2Q&oe=6A24324D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQHKNyG7sI8Q7kNvwEzSP4Q&_nc_oc=AdrLtCxYjwOzqzvC6pSPkjYwbk59QpeRVOmfPzces5YfBJ6vrm29XNbU0CsOJRODlYk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KtsyIQbB5I49T3V9gFu8erihBEYtFHhLh5JFonPfXBA&oe=6A2437E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQBmnhGN2eUQ7kNvwG17JC-&_nc_oc=Adrucd_RFfJQZG8-5V-osB0Rg_96mTfPbi5WS1gSx-eETfmTF2y_fhQxpicWkKVNhJA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mE7afdyUV9TQOiH6jcm9w0O2vPJLqoeei1f9Kncmm4w&oe=6A242716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyLAKlSEzk0Q7kNvwEk9tZu&_nc_oc=Adr-DqmmxM1dhdUPxoPzohMF9VSLwRBPr28-9EjKnSClKVnlKxc_zzQGvFLBTmUY0fY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e8hp9vGW98jpEVub_ZK6FO7Nqfhl6pwo5roR_FzJLYg&oe=6A24224E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
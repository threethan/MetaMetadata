ulo2.png", "id": "158717710379329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjyASsTjPlsQ7kNvwF0_RUX&_nc_oc=AdkgyciRokaj9C-rgV9iAdHO8RgF9D48A-0LG4wV5sFuz1ZeJUeLcPx9HnMZoYE751k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyI6nbWizlWaM9N_IJ1lB-h6nC8xe8tsM-TJAQ-q2jDtg&oe=69B55AB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLixritvN1wQ7kNvwERy6MM&_nc_oc=AdkxnptLOjYLH7as-IdIUkLiXJvm0mdkFDlO1Q6Q0Ji7vvrFZm266mX4vc3RhlL0cWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQUc46RkwG0_B4LGTtf4QTULVWpbemJK4S4Du_1TPWNg&oe=69B53C0D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJrM4-9rvbUQ7kNvwEfFQVb&_nc_oc=AdmCoSlHTJVOBB4Av4jaG-LF-sVhJv1EEaiYdy-qrwATGvNI630AcIRubPhnykAGW9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI36cC4h1TaFNb-xljx_r_K1mHufAeiOQz1yAGfh5VJQ&oe=69B541A8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xa9JjaeqlwQ7kNvwEaKInt&_nc_oc=AdkScLVoO_9wIBeDEfwjtLsh4iQ3tVFQSDoFu8zk4Zbq3E2Ii-ucYBINQ8j5V_RCHeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylEK9tqiV-Cl-C2XJNCWwlyyUMa8TGFdhAyioDLnxdHg&oe=69B56916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGkPb-m5VwoQ7kNvwFoCPLw&_nc_oc=AdmbI9u9y6iCM8ivZopUppA1Lx2Bpd5yeBCMyKh75ihd8VwLHCwQS7lDJoK7IQY34Nk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSoGp_jcO5QEibJllvnloLDV_6JisQiOB8hqyRuoZzvA&oe=69B5644E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
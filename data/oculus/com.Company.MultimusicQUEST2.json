A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Smsnf6PbT4MQ7kNvwEYkxWB&_nc_oc=AdoN9Rcr6m14En9eH3X6OjR40CBE6cDZAnCESYkf3JD84d-Jb5UK4VF6yl2vk-I70_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y9eVOECdMSWRztWdP7pS5Aqsh5bQcuPNWU0UaMRsiqA&oe=69FF2EB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MEyc_dcAGgQ7kNvwG59SoS&_nc_oc=AdpLmdV3oSqnAOu6TYxF4j4iI_P9npeWU4Lf6yirukuS-eblr1-_ndBrB1tPM3TvFdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MH4T_cDq0kFPFxzPrg4qZkuQWP5aAhTf0ytw_Rlps5w&oe=69FF484D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESDt23f8DRcQ7kNvwE5zGoE&_nc_oc=AdoK8cWDPyCNWC36Ju0J9Qp_1X7UtoMUpD5jLT_pqTSKB3yGwUSViZh-aZ2HGUEtNpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ySEDWur89pPqsrH-cISO1YI0H5KhDF_y3Nivma0SrPA&oe=69FF4DE8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDRAdb9CAKcQ7kNvwGuutLD&_nc_oc=AdoXr3es8Y-VwtTZ_TiqYNubcKomZstkGr8bachsgMxeMICNLfYVYxlQ8nRDigB_lcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pp-x0funq831_8EJGgvN_h5f_ixcNzs-m_Ja5F1CN4Q&oe=69FF3D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ4yljfp5NcQ7kNvwESL_ai&_nc_oc=AdrbVjoNlHCwr272_UiGO4cUNFWM6moChGJudsShe6Doy-3359r_cTCagIxMQQuoCtw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bVmR4FbTtiwd8E17plMMKS2ljB10bXcQsfFXA3V61Qw&oe=69FF384E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
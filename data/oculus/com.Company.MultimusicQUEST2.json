A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB4a9Voclb8Q7kNvwELpmeB&_nc_oc=AdqoZbVTFPX4n2rtOPqvbmeCJXmEYCoXa49AUUO8gAhI9l3RxcV5iuJnG0yxcTJ-9Q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H6bpmX-OidbraqbJfTYpT0aSvJox6yefFW6KnZt85KA&oe=6A3147B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sBPaesy6BMQ7kNvwFUpXnu&_nc_oc=Adqd-Zi2UjQLfV6VxA8-hMNY7xpUKt_u4lPsJuJ1StDdr9uBmRZ3eAuZexII0-p-2Yg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DZOQMkPjsL6pSKTnuueI10cURskpWbG7AL5U2b_PDpg&oe=6A31614D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ik3cYC0XAcQ7kNvwE2OraJ&_nc_oc=AdqFA3j2WlDGO5rmpjFVbKGN3BuElPZ479eOkqzbm8qgZTcA5EsBH_2_LI08Y9MmEuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pVtOKlw9RrSr0SJOJ3-bI_bHwntPiAqc6Cj-dTLmJ2A&oe=6A3166E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gPqftJ0LRsQ7kNvwHJ1qG4&_nc_oc=AdqGkKXxC9Hwm0UniJbrKH5_kSupdM7HYBceHwRRB9SgYY0SZaDrybCkDMY3O-3Ty3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94wKoK1OfcYEZjur7F-MqFRRR4b3KgMiMMVNrHdqJo6Q&oe=6A315616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WaWgIDrr1gQ7kNvwHjmoZH&_nc_oc=Adq-t6zAytt8sZ4yHFjmncz9agsxdHD-MD1Lz3ihZ84GBRREf4ZXXdStb2y_ABtc6sA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YsjQwEnL6Mcnj5dJNLIHnSEyBip1Tdsig--IAj7Gi0g&oe=6A31514E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
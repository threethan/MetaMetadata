ulo2.png", "id": "158717710379329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_nm5y7GNTIQ7kNvwFA25kn&_nc_oc=AdnPSHddgdSTXIGY_4KlbBPH6Eq3QUySb_PhbL6N16Wnf60Wrvrsv8o3hHsFEvYWMWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO5MEuo-V3eMEYxm0gqMuLoPpOJtOmSyrMDTvwl006KQ&oe=69BFE6B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CZn6HPKeBEQ7kNvwGR9pUy&_nc_oc=AdnFJljBIv3oBI6kvyPKomGSmzrFFYd40xWYCLng_nZTIGPJOBw6grPbdz8-230sHpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzdpEVtdWXCjbM-ZfiAM5uWZSKo0I0DFJV04vWQpZtkJA&oe=69C0004D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBKDEq-7aesQ7kNvwFmfPbx&_nc_oc=AdkYVD6aXOnpmSScy_tGTLc8b84oxOnyasTdRCMoHQV1Ku9mZXDnfkfH1esUvMu6I7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxwnyhn_PFgs_PpzGV0bh75mUML1j7NmpLAODT12753dA&oe=69BFCDA8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3clJloBi90Q7kNvwF5Yt5H&_nc_oc=AdliL8yvNSQN1JrQM-qacTf6CA1nJBDz4tzpFbQZFz1kVJ6bYp5MPVy-ztjlDN-k6Ho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqq9o5fH-U7nP2O7Or6eFlt7D5bj8eS6fJNyZb1p6TNw&oe=69BFF516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yUbZC6S0icQ7kNvwE_bscA&_nc_oc=AdlFtcce5AKF1BBT-0CCosCyvwTcArxk5y_lNmHK1kx8EYV_2u7enKGkLKZ3zhQXOSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfziYPZxS5fx3tESsALrijT6M-LKg7uI31rKkf0ZD-XcSg&oe=69BFF04E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Smsnf6PbT4MQ7kNvwGbW7o2&_nc_oc=AdpkeqqsVR4jdM8X1M17jrv9IyDrryAiT_r14shRoNIqjsZpRCUHuxSxs_nxmb_14LM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B78JHBQBz9InJTPrcPWqQNdggDpctP24rCPcjBzv9Kw&oe=69FDDD32"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI_fY7DMa_wQ7kNvwGy0uGT&_nc_oc=AdrHR-wYxz55-pBnLpqRXuvjuxcgbkpK_lfFjyvqBdUn-8iuNbS_Qm8NC2DKdx5iCm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x6Gs-wYyDBTrxrDluNjnCbcPk9jrnVy2gjDoI_JMeLQ&oe=69FDF6CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESDt23f8DRcQ7kNvwEjwHot&_nc_oc=AdqQXpqV3qL6flaNGucHoxY7W8-a_xYc3LT9N6iLHDp0H0pxo64DG1tV4NfrZ-5kwBU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K37OsbNL8x0MS2ljeUIrPmrSjWXKqzKSbioVebn7OLA&oe=69FDFC68"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KN5uZxiL-8Q7kNvwHu_YU_&_nc_oc=Adqn3CdUPt6a6sIt4Bnv04TFFRekqFyhCAcB3os7r91SSLkBHi_dCOArO_38wHagqUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40zVPEcLF6QQy9oi40Z5ac4CRCUuS7MyQ48yQd99T2yw&oe=69FDEB96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSS6Z90LqSAQ7kNvwH0o-3Y&_nc_oc=AdooNXPWmAMl7AZ95NhSYjbAiq-1h3HHgpPYLGD51oHstscmmHlvubt_6gcJb1JKygI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZaN6BWhCDXRaonTl2jhXOltEMvZ0liUOQWjlIpRr9yw&oe=69FDE6CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
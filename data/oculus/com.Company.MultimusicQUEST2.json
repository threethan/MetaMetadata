A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqKXTsn0MH8Q7kNvwHCpWP6&_nc_oc=AdoazL_KmG2sFCAewTexIYeC4vqZRP-RItDZWfR_lfGKrDcITNbw3ZVM0x2B3MUbsqw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR1fd2EXQWotaCXnnbBoWo7zOP9_6EP9Y2RCrbKjM5lA&oe=6A5A2632"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMhNoUOrm3MQ7kNvwGDa8d3&_nc_oc=AdoTQVNGr-fGMRERT03-pgYIVwwodm1jI8U-J7N2E3hvjjY_fE-aTKl5mzj9uHGx42Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn67ZVK7aLxR4mFOqKm3racVstl3LGU4qpQqy2JrTPKA&oe=6A5A3FCD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDeSJWKpVGUQ7kNvwFAaChS&_nc_oc=AdqsRWKD47w2BnjwbhVUZFMwtKEs-lPgzw2FRE5_Tgqisg1pgAJsvxeZGXuU1UFI9UU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACkPiXb2Kd2fgvC82t8fUszhXtks-54j5CtYcS2gUH2g&oe=6A5A4568"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVVSInzhAvcQ7kNvwHZrnDY&_nc_oc=AdrrCCSFMunRzcaywR-6j-zmIN7e_9AobPPDQIaD_WVbHh5E-4USxVy7RuqU3HMA6CQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA64yqr4m4_WV0WBQNrt06N00q0Dm0DULzji61-sLOZ8w&oe=6A5A3496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwhzTMjefzoQ7kNvwFFKHJx&_nc_oc=AdrAkTVrhJkzXFRVsNjXAMQeVW1PBFqRGpW6ZIj8ZORPI1no4G5eEyke8tgzbNucx8k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4xRfYxWf0agvlWA1wuaQ8FZL_EV3D7nlDVAa9GpFAmQ&oe=6A5A2FCE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
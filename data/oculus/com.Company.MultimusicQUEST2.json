A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TtX2ukf6_sQ7kNvwFfBE1u&_nc_oc=AdpWpmWEFfmBUPGKpWa93UnbRzQv8swnYi-45oM8552m_HCdtAxuQ2Ejv4pA8fUI-74&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb07aCtcoakof7Aa9cX28Z13BM9kCjcZXjIWE7Wq0_yw&oe=6A973BB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En_gmUnBOVEQ7kNvwF3nGzP&_nc_oc=AdruExkr_iwjXz1EqInj41zkUsp5ver42fLKeSqFuWXewZ7zzT5QMdg4an_oyp-TLQM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo98RmnLc5Rakx5Y52egGspmQ_9S1u1MKB9SBJKLQoag&oe=6A971D0D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoMODtNeRNUQ7kNvwEH8Fqi&_nc_oc=AdpqgoPZyutaUc75vDLrwTK4tvZu6KbTFOAOJfRrKeGZH3hppBkYVRLMTnBuSZGCgFc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGumqObUIqo7fugUuu7uaCMbXIn9sIU-YRhF5oAKi66mg&oe=6A9722A8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcaDcSQWO4UQ7kNvwHLPs0_&_nc_oc=Adr8V3SK6arxzeH9Zj9Hp0WBH2CfCreY1kii8Yjg5uNk9a6N4CxLKatgLHl62LHVdpo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGt0QoFh4wJwjo14dC_D9nk2sbG14qbek39qHIU1mG2g&oe=6A974A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R0L1JBN3A8Q7kNvwEtUWW-&_nc_oc=AdoppH5HkDJHhnDpdgJ_q8g4m2Dgs-yITrsUuwyBUwyd1q5Ix5JiTubbjub4bLaZqjQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3gGauFmGiidMBvBVCYBlcFwq937nATTV6PPS4DCFzLg&oe=6A97454E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
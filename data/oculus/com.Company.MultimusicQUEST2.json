A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAyOyvbJWdsQ7kNvwHZLm0s&_nc_oc=Adp6zCSg8bBD7LQz2RKDN6ARRuaKwuD8rISjjfleaJ-ftFRNZYpoYH_kGW0TyXnhrk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO42AejJ_p-pDt4hyXGazbG0rSWwx2RS9TA3Qz1kL0nw&oe=6AB12932"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV1ek1AscMUQ7kNvwFD_7NR&_nc_oc=AdqYfHy_fsNdFZ4t4uv3vzVr7Oe79_6v8z4f6a3gF0gMCmatHs2o9qtUowY9le32tNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4UTlocGC3ussqgSp5Ay8uTaVmMbJh44lY6ZV6Xaog-Q&oe=6AB142CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skHUBOPU5wIQ7kNvwFnfoXa&_nc_oc=AdqOWIO6n6Xm3dHpBu8GvV16odVkPgoBG7k3dQ1rw_dr5TYj0Erh7Lvut1J4hzqq99Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-Mx9yigMO8bKi9omgCe_-bIaVOzgZX03TWkV9iQ9y0g&oe=6AB14868"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFcr534qTQUQ7kNvwE42KVp&_nc_oc=AdptxQxOOM-Q6JliDg8RLCcnlcPlz3lFReP-MMSFMdiDi7UOR0fXMpr7p4RarqiFBfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxOTB_GsQ6p3jEIXU0Yzcrj38ZS8l1f9rgnXv3jxahOQ&oe=6AB13796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4-uh8do7jIQ7kNvwHw5P1p&_nc_oc=AdrzXAZ8hspOtCCa5i--B_0Utb2pO9FsT-G29dYWFtQQnXDI3Gv4R-0tO1wWJAuinrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwRCOmaYK-yhGrjAnZzzTzRqjMn4T16muyRkJ8YmGNJg&oe=6AB132CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
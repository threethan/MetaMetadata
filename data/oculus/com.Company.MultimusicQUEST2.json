A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPMKUYX8vD4Q7kNvwHQ9TbH&_nc_oc=Adpa8EhlZfanhtSEM0IHA6lQdQuLlpj94DpHyJqHqHBOPoeFPCuUHvpDA3l6WzgG4xM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9nouH6N0IcC2IICuGWRPc5AePrp-lBDW4yZY34JvZuw&oe=6AC13372"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWhPQtcimIMQ7kNvwHGyBdb&_nc_oc=AdrnDsd4ptCpplT7tp9S9Fppe9er4KLc-1smv9yzL5aEVE1UmLypXXtAxvjIEug1t0M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhOGHu6hurRd2T2dKZHVL61rotRToSLtbSG8jvJ_DGwA&oe=6AC114CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwPaPQsnrwMQ7kNvwFsz9u7&_nc_oc=AdrgZ1S4dlqsu_JzlGJICEdQSiyfTynVpdjd11nXda2lp6XXNHdphTjP5ieChU67tpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOty36g2rUY_3XNyF82hP3dJAat5x7vaRFAXx6dwbvdlw&oe=6AC11A68"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adxuErG6eAkQ7kNvwHtDHFY&_nc_oc=AdruPfXh3aVhkMtYzCeBMPlIQw_ZEo0eEyKV6uRcUmrAzlFn-g-oEQBJEbz2do3GWGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7_7prZeuoJM4c9GGObw_O8jjcgZCiEGXL-VBEAbtyGw&oe=6AC10996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXAXFhZ4t-0Q7kNvwHPUu2p&_nc_oc=AdpAiQvk4vS6OQjw9gRyEHSG9hxAnwR946Wn2vwaTVYKEN84AIG9D515_V-O1viFcw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPljMRXONfUBgS_CrkXIhHmTCmiA9JozU3px3xiQGZCXg&oe=6AC104CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
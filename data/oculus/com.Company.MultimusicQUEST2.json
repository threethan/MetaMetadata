ulo2.png", "id": "158717710379329", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_nm5y7GNTIQ7kNvwEuViFr&_nc_oc=AdnBYLVCzrW24kwBp7jbj5VGrAppOTZSGRj5fj3NuBX4uft2xijuj04YwMsqTQACZWw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyjv_fe3YeDUyQhT2gSWyosNItZjAlWxG4Mb0qgbYeAvQ&oe=69BD43B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq0Dwxfh5q4Q7kNvwF1VxXp&_nc_oc=Adm_8OkrtUSIAQ4IcHwodEUYDApX-C5fnhsya0or910FD9ZNeXKZy2BaDfE5GaQEggA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywuzV77Tl5FDvCgqfmlA_IITl1Lf0dT0g0grQKNhWmsQ&oe=69BD5D4D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJHnnxxP3b8Q7kNvwHXv0eJ&_nc_oc=Adk1U_4ounaaCn_DOdOAzRimjBvNzXReqnbI1evmQNwE7FydD2cABYVW8fkr8SWWdDo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1q0r9m5vza4MOjk3VOpWerQa2nbVOzAV8QVtAQwRvFA&oe=69BD2AA8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goY3yNmVKhgQ7kNvwFCLcWI&_nc_oc=AdnK8GNm0PHMTKeLWbdtPy1xyVkCZ-yV1mE-Qi8wJSLd4zr2_B7vKFq9yr1WayrGIRw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvZ0I_2Dgn3R_vUapwJySdOCgQmVF-eL2oUn0397i_lQ&oe=69BD5216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P23QKyMcdL8Q7kNvwHSGDxf&_nc_oc=AdkoW1n4E2KEVlM57--j8es5Ls0DinUcpIdZxBWeBzRR05ColIM-UxhUD4r2iB3hRrs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfySu5naKUSLjoCP4jL9Hg1y3HfnG5ALYC4Yp4WIXjR7GA&oe=69BD4D4E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
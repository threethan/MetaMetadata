ulo2.png", "id": "158717710379329", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETAzWAJgQIUQ7kNvwGmRXIh&_nc_oc=AdlQB36eGKA8NvpT3nBGJJQwzzAaARlKTxi-O34E0e1vsrQTEzV8qfzeGIlNb8Mb1nY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwruCWKEQxcXmvIFfDL0TS8jNziqXQvf-hrDkNP5aXFQg&oe=69B2B7B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHfOqA6UN-oQ7kNvwH6mcXU&_nc_oc=AdktzN1XBhHBA9MV273K1qPTi9rEb3U7vnBdb-z5S1VxGJsdOEmSWpnLnZNK3aMzhZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9bx2fbNrcXJFIrMn7qkmCe8ECSkIsgIH3rTVtkMTawA&oe=69B2990D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJrM4-9rvbUQ7kNvwFP7yIP&_nc_oc=Adm8_dTj1S09zcNcCOWK8UmBAA0Xp7mbA0Fg55_2BevJ5TRw43nqZ6NELzb15GET4C8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfworvYTgiKAPZ1PK2GVtqdr02p5ShqzmvovEfyNwYvAAA&oe=69B29EA8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0K_DIRogF8Q7kNvwFzsC0u&_nc_oc=AdnCUtrJkixCYPZuVsByPELpyUjTJ66_s4uT1pp4iv7b08FV-zVKl5oyhg7trgiC-14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbNXwY5AWanmyOC3a_h11f4OooSKeXqlT5Ag6aInoekg&oe=69B2C616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXgFomJELp4Q7kNvwFf9-QC&_nc_oc=AdnE4rc46qk7CU1wEdGKv17tdRCre3qG39ho2L_6TYDO05P7_MfIpubM31-loidyvu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVSwjk3ddqEAM0tJrGHcsRtxY-WNLWSr5Mu4FSYFc8Gg&oe=69B2C14E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
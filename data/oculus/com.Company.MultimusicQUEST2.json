A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQjqifsLN4MQ7kNvwHSROJT&_nc_oc=AdqdaNrNr9iht48vyYqMhlDbgilmAd7DRRiQqpym-295sW11qiBM2LrQSydtnJBNEeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVpbLBCYRWovx9qtJKpEeOX6iVPwaxyhO3ZWY833wrpw&oe=6A8C3F32"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFk_Svrq_G0Q7kNvwHLp6pS&_nc_oc=Adq-WUp4k01JhqIBc_LeYHGhHyG4t0iR58xPiarbmX4qHJmYGAYaGFwrrLW7Dq4l_c4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETQcOY41vLTEjtbdgCL9isCEodANDJAGGUHs-4U_H6yA&oe=6A8C208D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3tmvmRvV34Q7kNvwG8uXAE&_nc_oc=AdozMh1NfY_oOkVbZMEHnXU6PgH_x0h5NhbRyMEHAJVKweArZZL3sjdgP-ENZpP3KJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEsv-mfG6M5qh3t90MgPhKnvABzc5uEsCjnlVIabC9fA&oe=6A8C2628"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r56RTph9S-cQ7kNvwEE2Mc7&_nc_oc=AdrXXpA8hObfRI9_zg4yr0Udyt0y6st_upj1KAFUhEzpXXoVdMXq26aUgQwv25gY5lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7k_U6gTJvd2VwkFir4Er2sjJZB7eB5nMXCcBTk5ZPrA&oe=6A8C1556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czq6IAWbbiIQ7kNvwFFnZYP&_nc_oc=AdqZzPIUqPUkRyBEGMKdq1vYhYMlLd4NmpNWHA6B3iP7TWJXgQGmCLr6MAwXdKk0yGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiz0402Ahbc4GmgVii8VBsfGgyT4Uft4JDkOkjRGv29g&oe=6A8C108E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
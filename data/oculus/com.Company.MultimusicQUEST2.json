A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MHRUOhv-YkQ7kNvwFSiy-x&_nc_oc=AdogYi1j8xY1lmsHbK2kr-jB07snyHzfGS-MaRhvfvKLKfdTesp8PO79SSe4rxr_-MI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZnW3FGz8SU1m0qfZXiFLUh9aPtIX6VRPyt35n2L_mRg&oe=69C52CB2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hQdAFBSsA0Q7kNvwHP20pp&_nc_oc=AdpG5J3SReC62uk9UEk8O7P6OJTvT-qeKetKoPElC93ORD0ItyirLd-AcrBrw376aYg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9Pbm00CX5_uA92YMf9ohz4V5y-EYDNjRFqqB2Eas40Q&oe=69C50E0D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pWzhX5CoZ8Q7kNvwHHIuke&_nc_oc=Ado0uaS5oDUcbYyIFM0UYbZg7ARsMLqrKQYTSnncGucs5kLpocKtYTm5iuCwsL-xc0E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_KaRWHP3kLWi8lAb_4fxDdqtvczKgt1NtSqCMCK0CSw&oe=69C513A8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohsvO81qMzIQ7kNvwG5WvcX&_nc_oc=AdreRTGX8PDRenlQcChj4u56FAD1TeKbNFV-WHM3Nq37Qvvaupj_fVUqHWFHPwrKyzs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwulPh_iOdR-LOtLn7yl2ZrqxaT7_2UCRXO9NvTOkrXkQ&oe=69C53B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoEg8T59gykQ7kNvwGuO2eD&_nc_oc=AdrMKryDMI-N2qci8WsZSCHxIrVFjzGubYyV33JfdcFwlTrSCIpHxCbOu71uASl3Y6c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVXg30AleQVdnsg3KJDRlGWdAk7w4FLeCt-oSqWNN8Rg&oe=69C5364E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
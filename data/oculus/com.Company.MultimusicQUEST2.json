A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbLWIxt6Zn8Q7kNvwFCmmE0&_nc_oc=AdrvV_jMLQvoryoWo60uRKGoZs2VIt6dSlKNyjTq7M6oLPtycuI7MHwX09_zU1B6yho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhQFagO7kOm5Y-GQW4d06iV88R3H8BZ97mATBiylnAIA&oe=6AF5EF72"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFQOhxCbGJIQ7kNvwGqgDqp&_nc_oc=Adopx_8huFgZNKkWw2oGRYz737UFkxD9egA9Vzyi4Fp6dbHhqqolvL-PbTxMIF3o1P8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK20_uoFYpd9FFb4_hZYMFJJ2mUrynmDQNaAR-jHyi2Q&oe=6AF5D0CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gc35VfwizEQ7kNvwE5ACWl&_nc_oc=AdqF2NA9O1x3MMYsdLB4lg2H4NhPwcH8lpd5_KLpqqb6Dzxb_X_Wn1XzS9CtxA-DvDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_izwO_BcfiJ30m6tSlvWo1PA7fei5d84Yw0nfcJNxDg&oe=6AF5D668"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb6ZCcCjVHgQ7kNvwEZsIu3&_nc_oc=AdrQ54jlO1hBDNlh7gZQ0lyNQCxlUdZQrpQ-mWs3Dkc3bVza9wpceanSLq418xtxKMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt9PAD_ekZJruopxTgFyHmKrszMPcQICfZz0WH2rBZBw&oe=6AF5C596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcy4lG7R_YMQ7kNvwGAz3Yt&_nc_oc=Adp4KFMOLf2Gn4dcJCt1PFK33VNOK5VbcJk8daTp8zmy84HWXBSQYbjziF6pA4zgvb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYVIQarl7SL-qZXd6yHjgN1-Gwr8BBLx9IHY3-FrOSzA&oe=6AF5C0CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
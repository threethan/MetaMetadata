A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijlpJUPQ1VYQ7kNvwEQG7m0&_nc_oc=AdpnFViUlI9ZnNAV2kHhDDPdyxSYKWl0DWN6sDRt4D4XvZiL-rh1Y2ctHqKgZv3HZT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRP5F_JViHGQuxToithLvXYnykheTpIzd52boBCvHIDw&oe=6A6C9B32"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrFyjyYBr1YQ7kNvwGb0bct&_nc_oc=Adp9qvh_9j4eb2UTd7qCuwafoYjWujWoePbxtJ0g4--U7GQtAL06yXuKQ5IAhrd_iaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkI0e0vGk6qEQBxOUtuvHOwmIc1fX3O_s4qcWQUelGuQ&oe=6A6CB4CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqHwYyLXQy4Q7kNvwHEzjA3&_nc_oc=Adq8CYk185xZxFqAHY8kyZAW6-CWuVU-4doWt0dGv0awmGNNoVKlWgrIhENfeYek4ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmdZ9-xknoSP5S2rk05ZK2UfQE5eeLkLgutPEHiJh-3g&oe=6A6CBA68"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaCy8PxbcsMQ7kNvwFyf2Z-&_nc_oc=AdrtzHcjNe0PIUmy3wlfl4NZFMLqz09Owa0FFeeKxK343jjCSvAwvkbNJn7xPOSE-gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB93cjuz0ClyWS8R1-cYvsEOUMELiY4XwMtyk56eYs8A&oe=6A6CA996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j153fHWxTgQ7kNvwHSQwjJ&_nc_oc=AdowvArPo77WdWhTY_MSyEE9ciKQWSVycimF2HBOeOby9GJ6kUOu7w2nl5mdqFaDAGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0fSfGxbvzgu2wn9IjWysARsn4Y7E2ikDi3ev97GtKZA&oe=6A6CA4CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hXXH31Mk8cQ7kNvwEd6wxV&_nc_oc=AdoOINowTaN2bxZrsA-U3-o2SP4UDzSfTkxVGqrPm-09RhcJO5FUIAbgcCPR4tx7r_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7HJt20bOtgxNDMlCztjvY939orDBZING3u9rNqfgYMA&oe=6A8304B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNchc00p6eAQ7kNvwEXvk-k&_nc_oc=Adp0yW-rqojPj92cUeHeWTy2sU-8acU2xRCXwf9RaWfKDfHmXvTCZpcuXFEOJoAtyuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc3B4fVvYrwDZPF_oLEwqcrzIr1bdvfh1XQ7xrtjy0WQ&oe=6A82E60D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j9GIFpualkQ7kNvwEsohTs&_nc_oc=Adptuwy9p3h31ijqokf5Yi7KgfbEPaz6cbmlhVSzpxeruUnQLjaA1zkLiedmVRlhJhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYL4LG9KYjdKBW2h28vbaqQ5v7q7K3Ll2ttfcta3I69A&oe=6A82EBA8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=genY_WXNprAQ7kNvwElhF0s&_nc_oc=AdolWUuAS_IeusA1fc6sO48jMv1VggYkE36NjPC_tzuSZzNhXjT40WSKRHK6OhrQNQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHytBLGKJppMe_MiHRM_4Dgj1dq8ZGWpXXZcDVW8WJsdw&oe=6A831316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVtT2000IgQQ7kNvwFTFKfb&_nc_oc=AdoV6v5YtvbVGfCgkT17i3hn_X0CqDmyGYvtJPH_wSR6CeOS0h0fJwd3HuKFVe-91IQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa_AaPBLqNxAZnlzUU2IAbOxeajSp-JpAaHJ6lCc_AgA&oe=6A830E4E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
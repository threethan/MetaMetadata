A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLpSo3WBzaoQ7kNvwFiU7UX&_nc_oc=AdqlPhsE_V7R9pH1-i4XUbYW3PAo3GB5g9X7BQrChr6tFrz40gK7TwOsw2zfFO0rGBg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cRupzKutqMdpuBuB9JBMONLd26o9XmdffrfJHIj_O7w&oe=6A2175B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHLAN7o_jUsQ7kNvwEdnQlv&_nc_oc=AdrLfI3XQ3z6T9TZumoBeOgUg7k43GAd8y70FSoUs48-7gGz4OtHWNWmzLxZsx4wbRg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fHTxr9uRa30BH4lkRqzmF32mLwX_SqNii94llYjLrVQ&oe=6A218F4D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQHKNyG7sI8Q7kNvwEiJc9y&_nc_oc=AdqegEY-KJMyH5Ncpt6aeXiFSx9jxWoWzbODQgD7wZuPFGlIbQwhig7dTX1mFlY-J_s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8siz9i4gqlhxXdL60IGOiz7vAZYcA62h0QA5SDsEX9jA&oe=6A2194E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1l2sDE8roUQ7kNvwEQTGM2&_nc_oc=AdqvRwYkJW2iOSKjVPK48eWNgV9GCm4BeAEpJEMzFsAn7MGW7VT7xgzD11nWPmLZefo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ME-CNT9F75yxLg1Gfe6G0q9xjrta2p9WJsnkx5AEanA&oe=6A218416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Un1_X3k-89oQ7kNvwHUyT0O&_nc_oc=Adr0iB2Iim6buKmiRQDZa3f_bHV_drClJOtNkhIMh9jO0NLACO3KXCiekX25REf6kUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lxQASJTHnSdtQZH7dviAAPlaK1rMxB6n083MaGMGkHA&oe=6A217F4E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
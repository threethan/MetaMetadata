A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_manZCrith4Q7kNvwGCer7k&_nc_oc=AdqEiYRwqxcRfrOz4m8ongNNeGl8LhsukDa39urRfMNJ0DJoJVqmUF_4vozCPxRNY1k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLHoR3Ms4i0HQRqL1Cgkpoonuj0vqP_JxYqcUXSGSv8g&oe=69D10A32"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z1p5LzRITwQ7kNvwFHsRdv&_nc_oc=AdofRiLeUE9i-_4j3cXDxAWdTOCXuVVI0UEAY0VBiPJLxl5cZod32zgwPE5qB9d-vvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfG8zDz2GQ0LblvXmb9Dg6xao4emFsdpn5bmSE9S2Pxg&oe=69D123CD"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH35zVvPDwoQ7kNvwGLkk_-&_nc_oc=AdoyATrG09bMjGmjRg1wYBtKJXXk_2wy_yq5FbLxgL9cpH9YKHXt96Nq20v5kiBnZpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxlb0kxHB0xe-7ATDZ-MQ2adEeL3as_lY50JbtKRgxBHw&oe=69D0F128"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2L19VzwCCkQ7kNvwFri72b&_nc_oc=AdpwPkdt-4oe7hMsyDFy4vlnKGipS42pt1APsILSPyNtjyKvj15voCligQwNGOJhm00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7XBVqMM0vRu1pI-0_UCSLgxdI5yCg-IB_vF3-vTLPCw&oe=69D11896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEOva8Bbz4wQ7kNvwEmnWk6&_nc_oc=Adq-9iAAcDplQlVZ2DLzCYXJtuPNFmCHlnQHnkVQoxCauMrirnD_1FsSMfF7iRRATRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJg-aNeQeC3QgtbcmwbKcjLL-wquVUkGAXHO7dkLhmxQ&oe=69D113CE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
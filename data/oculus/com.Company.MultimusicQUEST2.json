ulo2.png", "id": "158717710379329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwnfQNI7NLUQ7kNvwHzhqJ3&_nc_oc=AdkhSdo9iRmXDe-kDP681z-eWu6VXm_S26YwEC_zVvaFWctNLZLg04NzjZxXU9lKd04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx92KWaUvADrtRUMCytAlKsGqYapgQ4LCGehzTysylGyA&oe=69AEC332"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRaNZ2cjnhwQ7kNvwG7ygq3&_nc_oc=AdnZv5txaGXGbgAyDf77NGOFs8EILHRw5RPvUtjuOOuaCZnHYwoaiKHSXvd_A7SkAgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfydeTO3RmuwCD6HLWDc6kDnWCvMSVqN8uAT4cVlhNRcfQ&oe=69AEA48D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCVsIgLynz4Q7kNvwHEUGhl&_nc_oc=AdlL1H8_0YYTkA0FI-lPon5HXmh__chEiKV_zEDYYNQ6J3LHYJXhwHYDWb-avB9XrAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-eCq7l4H67IguNfbo3fcddxTDfK4f9WjfV_XDyssPlA&oe=69AEAA28"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JywQT5iea2MQ7kNvwFt_pq2&_nc_oc=Admy81K1VonyY0xLQqa4eKjOhSElMoIaciu0uxLGmRmg_16-qjox7GL3Iv4As8q7aY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbwujZs6CBb000D27oGHUX3MSg1YJeW2DO2g1r3qpXAg&oe=69AED196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8nmDT2DpH4Q7kNvwHZuqPY&_nc_oc=Adm6Qnd7NbWo1Mp1xpbdkuk9SJlRTOBp1tib9oJ02bmL6uDTwygNHpmtL-6OwzO2yw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs9ZSUszNTk_EzCJzoPTDuTYzYgzCVsgN-jzmVevZaVw&oe=69AECCCE"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
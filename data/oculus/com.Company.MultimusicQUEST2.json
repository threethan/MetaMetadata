0Q7kNvwHO1Tve&_nc_oc=AdmnLNTsf9lxq8QffxTniNexTzNP_p8QxvoY8cc4IFaYx0B0qL7hW0QzxuChEvn4pRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7L-S9hrKbEHjKcq2S-yQRCQ1_eCZzazuxJFQ6fivwkA&oe=699D86A8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6lF7TsT9dcQ7kNvwGEPlFu&_nc_oc=AdnLBAuUvuFcss4R7ZcDdTTRoLL2kussOgUUVnFuj417RAJBxMTCFBoZ3NaLUhM31js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftK0r9lJ1MQE-Aah2u0_bQTiGEeywG9239v1fJhuP4ODg&oe=699DAE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-oZ_umIueQQ7kNvwGIscg7&_nc_oc=Adl79aitlPqT2h6WsFLm8kp4LYhWTfSu5SjBlns7MKJJGa3QqcsQFwgClund4rwbcLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsyLXgFKfE2ThUMze_4u9p9SHyY-DmP5y4H1q17aU8N4A&oe=699DA94E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "184509411014193"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6393925397305632", "version": "4.5"}, "id": "754310422675817", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6393826977315474", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6393925397305632"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "754310422675817"}]}, "change_log": "- Added Hand Tracking.", "created_date": 1678655511, "id": "6393925397305632", "version": "4.5", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_res
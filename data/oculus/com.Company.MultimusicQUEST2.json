A"}, {"file_name": "Sin t\u00edtulo2.png", "id": "158717710379329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_158717713712662_6317028818623523464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkWTrkf-KCcQ7kNvwHZTxcd&_nc_oc=Adr6C3hhHczGj05WtcfPkvSkl2i8z-Y9tXRQk81H2v3vLRT87FM2zjZNX7rlj7lE77E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CV2O3J58B8FVh4Z4U1afNJxTRXBpxF-8OCLEAl1w7BQ&oe=6A3BD3B2"}, {"file_name": "Sin t\u00edtulo3.png", "id": "894584921616367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612006_894584924949700_5742918106421512137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8wUbrhdpdYQ7kNvwF44Fgv&_nc_oc=Adr8lUCyKsA90cEIdAcPyTGMi_5OGWLf8fbA_BMhP36VHaa7A5PL3glS61Qs2kE9gbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x4f6VmwHQaefIlxty700rTJRQchjpL-SpjJh5i8GrCQ&oe=6A3BED4D"}, {"file_name": "Sin t\u00edtulo4.png", "id": "1316246445590523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035464_1316246448923856_4685813099764993945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZknMQxMWiOcQ7kNvwGa4dBQ&_nc_oc=Adojm1M57RtJ1q7JMF0vBqyn4mxQkjFgm6hA9iollb8F0LMc-Sp3R1gOlkUzMCOQNno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LL-Q4_rGUrI3_twYLeOlWIZxS9N-o1OIptm0Pq4aNnA&oe=6A3BF2E8"}, {"file_name": "Sin t\u00edtulo5.png", "id": "593371649331355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_593371652664688_7933124050739087461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgEjcIjedQYQ7kNvwFYcJVq&_nc_oc=AdogOFNJp5yHRnk8MC9jEugryhRHQqUfjrakZ6zuuOHr1CUu1W1GfXa8ERelO-vdkX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kYQ8WQg3DvIVXXWYVh6xYtxyipzhaqLnCuhVKfthHXg&oe=6A3BE216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "746610606836421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469632_746610610169754_4645638496184634992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldoWzg0hg2oQ7kNvwGzPJIi&_nc_oc=Adrw5BQ_DAf57vZJ9eWUO58Ai0P_HY9XWTS-LoGjitqfAIolrFQftsVnVdnrB79hQAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hwyu2admt15hREQqi-ZosgFo1trRt5oPPcbBKMufgGw&oe=6A3BDD4E"}, "display_name": "Multimusic Quest", "keywords": [], "long_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \nYou  have to select the multiplication table that you want to practice/learn. You have to get less than 20s to obtain the degree in each multiplication table. If you get it, the table number in main menu will turn green. If not, it will turn red.\nFor musical notes and ear training, you have to get less than 30s and for memory levels you have to get more than 12 hits.\nThe 3 best times of each level can put their name in local and online leaderboards. To win the game, you have yo get all the degrees of each level. Good luck!", "short_description": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ab850223-262b-4a78-a7e1-94c7416d1aff", "developer_terms_of_service_url": null, "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.rafaelgimeno.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
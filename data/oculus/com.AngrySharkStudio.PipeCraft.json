4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFJgjb6FGxwQ7kNvwH4npdY&_nc_oc=Adqg4b-r8PvFfmB-e3wfu0bp9ocPRtDULRVTLBRlkgvf-duC4HZ9n8_CIyacXzvs5wI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeVXAEbEeIlQcRU9dhD3RnJGpZyxpn1sn8ntgp14YhMQ&oe=6AA1741A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXj4iQfkbcgQ7kNvwHVJWap&_nc_oc=AdrgHYr3O9Z1tj7XmLIn_VQT63AzR3ojG_2IaZHnqNLMFSfh-RROSmLq4Vc6OyIa0Y8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrDO_-8kKN37syuF0CfJGZd8NU9QNVsFtZ2r2k3KqVFg&oe=6AA17895"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-qvaWtLW58Q7kNvwFaXRMj&_nc_oc=AdpZGPn_2diE05KwI-vvi_ehpsUFDmcApmBFYM6E7jsEayIloHhxjvrcJE__27osQWM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmS7q2vCkLu9IsuC0ZscDo5XNLhz6v6aJeEYDiBqyBQg&oe=6AA16602"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3DKpIDUcaMQ7kNvwFScQWl&_nc_oc=Ado2wDlv9i7l84x3epL3DVwqRd5vV5mnRHEEObGuMGOJVn6H3iA-uzBGCdNo0ymM6uI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILKPM8JXYugk_YhqpQl0uNL3E5iqHjtr29H5Wtazf9DQ&oe=6AA16ECF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwkcf6GycSIQ7kNvwFAVxbs&_nc_oc=AdpSB5g_WMMIeBcEQr71pOzrM4lz_m9S9nf1QFWrf92Sw7arWPN06Ef2mfq0BABWeYs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx6XAdE9dPtBCy16hGlGvslSUXPaArmEn14HLTqIW8Hw&oe=6AA1777F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
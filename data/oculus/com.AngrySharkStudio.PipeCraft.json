4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZf3N9bPgE8Q7kNvwGuryYG&_nc_oc=AdqKjJTzXy3YMjYPsa1FWP4JgqJAZQg2zrUSw1T1zLDZqbasVPBwmH1d9xepczMHkAo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-msCOeleSU0X5bD-WJDX5ZVEKsZp1Zvwe6xMQ70P3fVg&oe=6A43D99A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frnSJUE4XQ8Q7kNvwGRoTHM&_nc_oc=AdpgvoJMFpIk-J2wG03k5ES_R04a84XITKvqWRZT1W_c0E3QFedQnB6hm7S8lGoq6Ko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lapKePHgsjB3be8qS0KYhbUyjlq6dby81aoVeDUgr-A&oe=6A43DE15"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvJ1h7G-n3wQ7kNvwHjksME&_nc_oc=AdrXZeqJl8gsuXBH-cWKKQibrJiX4vaS-3EZNx073VxbdorzuszCBb9lJXxJcBrWFfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80oys8OuC5ExFjw1gqRryMdcdWJ7MsHXLOE8KzaVO7Nw&oe=6A43CB82"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQRjkRBRavgQ7kNvwGxtkbp&_nc_oc=AdrGqkIc1RC4eT2v0UXRoC1sYO2CS1rS7_22B7p76r7AUOHeZM8j8_AVT2drOhZpEPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8wjrSttx_dqoQQpHppqnLZPZBrT0cRvnGbdUG18i4EA&oe=6A43D44F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnG9AzxIxEAQ7kNvwG1Khzy&_nc_oc=AdoCJ9A8p4G4OVoUEERcg35otTdXjEAem-2gCuTYDcv-5YYnu9J-eVG6Awfsqik_naQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cPjdwDiZ-sbvp4FaJVomxyH_Cg89Q40kkhh8xrjOOEA&oe=6A43DCFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWnXUSfxm1kQ7kNvwFuFd4K&_nc_oc=Adq4lXvWZHIFPpZtzOcaAF6nbvEUeIQN1fs08WD1qhCrDEVD_zzh_e085SofRyaKZko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENvN88jDWBvd2p9lPK0m8vKIJo1pCdvZsL3f1Vx0t6cA&oe=6A75F29A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-e-nhIsL8EQ7kNvwFL0EGz&_nc_oc=Adqh_VqkCrHoS8983yDrk7a8OfBe9qawkOmg7iqImpk6YwgB2s3kPIcKRhEeD0P-8xA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnSOR8iWeEyT-O9QupTrQd5IkaSVsFhREvUvBI-bh_dQ&oe=6A75F715"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQCHke-1s1cQ7kNvwGeH9D0&_nc_oc=AdoGwXAGYIG7FtQBt_-d58xRrwgyqED3Ad7wDfGF5PUhZGv2pMwXw4vvVODmXyx8yuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWt7oGNkj3s5d3ZZVUsKobcd58G8yJeVS2RO6iUPhnog&oe=6A75E482"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWwn7hTHPXAQ7kNvwGx6fna&_nc_oc=AdqR4ukpfJgrtW4wChLcDheK59gn9zkkr8HYGwAsSfuRBVxJMwULO7LtIh67d-rpt3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVP_vB1-7JnwM1Vfzkf4gnZn4lzDiKkJ_LQtx8Yk9VDQ&oe=6A75ED4F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK9F7qbqIbIQ7kNvwEGsuVt&_nc_oc=AdrTcuQoL57gAgw7YBYLoRTebVtUBFyEScC3fTvSb_-205ZACJi_N5KRn5uyjo3W5cM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9yE9gug-s3TDo-69qiKpv1LoeYlUUOfSvd44Ab0nU4Q&oe=6A75F5FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
5935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOtKTYB87oMQ7kNvwF8PIe9&_nc_oc=Ado4myOradbEg4jnr5Ks3LZEXsUcpNENupC104JO39qZ81zrP5zNG6_8YwPPpY3mPEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fHRYnUg440xyNSDVwgrcKz1a3ZQJiBTsOcJF5U7FXSg&oe=69DBB31A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o4xq3PtqXgQ7kNvwG2oORU&_nc_oc=Adqe6uxyvXK8BoeILVgQSGGCLcaK_mZaIxTx5AcrZ_n3brw-AzJ4feKy7Z3zgtYfHbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07QB27cmjd5vRjAbRVWCxRI92Zx8PPVCrtqgQ5rL7b7g&oe=69DB7F55"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpUcL1d8PUcQ7kNvwGs8oQa&_nc_oc=AdoQf5c2KACY-wl1k3SFm5BV91kc6dwK_OjZoNSQzR4ElJwtbXz5CkS43KTqouYxpaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RHxUF4_CKQnTIpgZ_1SeMG_ZrBqscFPpuvWpYviF_8w&oe=69DBA502"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxhCCSx8EVIQ7kNvwHZJ6oF&_nc_oc=AdrD1HeOCtCsPh3mI7zVotKhY7ugCNyfskXORhkHHvX86X9nvKi_2l568EeUrDaWY74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C0wiyG5gopueVKwqq32_dVdHZXievJ7xK3b7YCZNzew&oe=69DBADCF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGySNe9W3UEQ7kNvwGbMeIg&_nc_oc=AdrdPY3HlRhn17WQBIUI8crkKArSRHh0VkYJ-A_M8gicz7ZMxN92wPQhff-fKHVJ-T4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Iwjghf2SYCj6z9eQY0Qek80-3K2GeypZoNeOd7BxZFg&oe=69DB7E3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/c
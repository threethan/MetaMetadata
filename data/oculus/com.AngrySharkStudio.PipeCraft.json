4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3q5na5Q9PsQ7kNvwF9SW_x&_nc_oc=AdpYAnvKBQM6305wYRGAOtKoxlVPqNoLymKK_LuuBPPYW9Y1TZLeZfPDhz2NeZlp1Mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OlFvAEMm--CAgGRFC5PgyQ8FT1fmKioJBTdmHXXkx0g&oe=6A37FC1A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZibzOUk5K8Q7kNvwF5jwr5&_nc_oc=AdpOcf_PQywc5p4sVryXanO-67_PzaUG7O8J8RJjH6AXxMUCgYdgJ6qvODm6_Y9tDTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rBRhd91l9bij_UROeD7moXQDoYQjbZGolHxLY-At6hg&oe=6A380095"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaJ2AuUOSEkQ7kNvwFzUQOW&_nc_oc=Adp_DGZxd3EwTd0yRtzZ77llrRe-ghNDFmsSIrVmboM8vBnELm7K-FoB6r5tKVjKf9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gSkaqJLv7cjbgbQlre0Mo6sDUeG5P_R5J60fGDkPIYQ&oe=6A37EE02"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6JkeCz77foQ7kNvwFxQTpA&_nc_oc=AdqdM5ELy71rnTIQg5tlw1y63u68wiBbatXh8kYz75MBuhXpYqjTtYPObKV5Ukm_F8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wudh6i7P4xWme1BF3_hdaV4IrS_dfVF4HqukLluEB2A&oe=6A37F6CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8Y5-ZMStPwQ7kNvwHHRYFX&_nc_oc=Ado3klk2wmT9cEje3poMP7Y94Pka9AAx61s00OLQ4rtUOEbtDL6ypvqnHVLuTcGklR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97VFhngrDXJzAfsHLK0Ot2ut2Ujo8HmphRWIIwHZx8oA&oe=6A37FF7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
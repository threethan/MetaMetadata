5935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApiQdb9qn_sQ7kNvwGukkTc&_nc_oc=AdozOb4QJuBfPG-vJ4jZA5zQi8SAaWv5nt3a0li59s7X8U2XWpLumfjvaDEyJk8B7dM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03mj4qPJNnGV-bKoHAiQ0fT7--TgtHHqqV6c4uMfWCxw&oe=69E8E21A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3patzFhS3cQ7kNvwES_HHv&_nc_oc=Adpdtj5gaiOh0DTUWvWdy2GkWRpmPLWV2PF19CR5ftBwNatgH_CHQVwnd2zf37NBXAY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UcSkMiQIox97RVoGWrW7SCeteTp71hE5PtHuOuKvsaQ&oe=69E8AE55"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4eIzQ1JoG8Q7kNvwETRbWB&_nc_oc=AdqdrdJyla8YSwn_Lc_LiyTS9AsM2zjv6BBIoeaGWwIAApOujbtk2pnBtKFjjKbwiEc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JUWPPrC1nRe6viPTtgyFAgwnjEl6HQxX3JCQW30VRVg&oe=69E8D402"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm_Ld-5k17MQ7kNvwEEqO7T&_nc_oc=AdqkcrBEBlCNWx3rfVbBU6fNCYWDvJ9ZsU4uDDU1YMp-tS01r2rPIHVvsXhp9_kEZBE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04MNDXgdsztC9DKh8uIwKBLlijFPDhsKxzeBzpq__o8g&oe=69E8DCCF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-bltMEn-YIQ7kNvwEG1DS2&_nc_oc=AdqxsgzUA8ypy0iNphq1_G1A_VuVlOL7SNwtOYLQOL5jVCJP_YvxpNHoBMr9hUSnD0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xudTcqt8uw04v7SYryO7HqKQ3qxVAP74BsAA1pcT0aA&oe=69E8AD3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/c
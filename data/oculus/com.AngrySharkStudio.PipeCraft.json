4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aUP2_EkbaoQ7kNvwHsqdtg&_nc_oc=Adr_pPBGfAcDN49FiMtqTejbwjUYyhXjSBqg4mGT1ajDROb8SqkdC3LWfXtU5szmWQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mg1fyv-kr1uK-cUTmQbGUSYO1hP9_lngYTsQhjteQDQ&oe=6A25871A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8wPEe0uxw4Q7kNvwHqu3C5&_nc_oc=AdrdE--6O4BKA_bhsTsNwoGgwsSnbQ7gzMTi9nEQnBZdaG55_cLdRteN2Ol8YJ6c_GU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hy3mzAouWmgvkTrKl9-2lFs4uW4kyLVCoHSuxt4Qw8Q&oe=6A258B95"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBYRt9-GpNUQ7kNvwHL6qiG&_nc_oc=AdojmF9_kPL7ACVlSmmTEaDcrMf5PKtW8bE3s4pwgR59CFF9tw-RaOgsKCvqFbMzA0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mWyMfTXCKhwVR6GuEUL4PGWym7fvlbrwEnV9twUXaBw&oe=6A257902"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA8QDM8b_BIQ7kNvwEpDL_A&_nc_oc=AdrVXn6ucZlTH5cw1J3jGN-cViZ3zEadGyaKsR6RW0l9eYQhxP4ouv9p_99CP0TyYaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4aPwY-uTttv_mMJXjtf_QzqTCX1p-F9bYUBmkV6n5pg&oe=6A2581CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TgkWWpFcYgQ7kNvwGcgwDS&_nc_oc=AdpobGJ5KwvFJbWS_LfftV6YnJ096dIAC99f-cXjEzSJ810CNHXMdHJxF0YffzsnaNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SyIH1zvvTYBUMoh4AY5a42WKCWInao8kjbKPgi6nSVg&oe=6A258A7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
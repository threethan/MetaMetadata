zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mJ9Z32JOmExHElhuSUlU0r57tOb-75fZVBq19pdZKyw&oe=6A36ADFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/contact-us", "website_url": "https://www.angry-shark-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8730545763670053"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1104035744575577"}, {"status": "PUBLISHED", "id": "944522350914280"}, {"status": "PUBLISHED", "id": "1724825531839982"}, {"status": "PUBLISHED", "id": "1315986737112772"}, {"status": "PUBLISHED", "id": "706816055754469"}, {"status": "PUBLISHED", "id": "1903160083633857"}, {"status": "PUBLISHED", "id": "874430565447090"}, {"status": "PUBLISHED", "id": "1206037118300525"}, {"status": "PUBLISHED", "id": "4229882740614717"}, {"status": "PUBLISHED", "id": "789325600185817"}, {"status": "PUBLISHED", "id": "986877440194742"}, {"status": "PUBLISHED", "id": "1206225790844434"}, {"status": "PUBLISHED", "id": "955545903377316"}, {"status": "PUBLISHED", "id": "866339048745701"}, {"status": "PUBLISHED", "id": "944520244188188"}]}, "baseline_offer": {"id": "1315986737112772"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1724825531839982"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9562526403805314", "version": "1.0.4"}, "id": "879672987642789", "channel_name": "LIVE"}]}
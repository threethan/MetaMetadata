4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmhah4jup7gQ7kNvwE9OB7g&_nc_oc=AdogV1D4D0pIm03PXTy-qV1FDlyqRJRPuUMwHBZ2iTf4b9Wt2S6tUKAAj3t7oE3mS0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImTHTvP-OykJN7Wgc7bV_VVejh6kTw2WQZWgpuVu3i6A&oe=6AAFF49A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw8gHiA1hj0Q7kNvwFpM6jE&_nc_oc=AdpHFZIEbDFl_G34aDLTnTXC6zaijRUC61V0O14VWsUn2-c9BgcdbqxJco80kSRd6WE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO0oaG4w5uQDAaUvfCaOCg3o0i2OkLGy2kcSqUxDhxzQ&oe=6AAFF915"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3zAmcPesr8Q7kNvwEl0nOp&_nc_oc=Adork-9OGwShsPt9vwHwsEII5aqiiYoBXlcAdgxBcsLhoY8BbbU1TdV5K9d1uZWIDSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjHaFJ9XHnLwuC1ZVsQrh9Kf-OEajoAyLp1EtSOWYBYw&oe=6AAFE682"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7oy-t12tmMQ7kNvwGPJ0tK&_nc_oc=AdrLH1Xi7SvvLSbNAqoSkjvR2cOD-zob1wJ6fv5oDlH2V41qeRF_m7B2jl0H8my6KB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6bwULI1MmZ8YpZR1RBOtcm1k8wBtyRJalyRSBqKLBsw&oe=6AAFEF4F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd4De1bCEUAQ7kNvwE8kzdQ&_nc_oc=AdorlAI9pHgA9TSsdlZYtfhoFdLbYC6z4kqHi97RyoC95w3MJhCnJopmrcjvwWmQcHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBcjH8m2djKG2O9dQrN2d13Qt4yFZoi0z4Bs86WF6CxA&oe=6AAFF7FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
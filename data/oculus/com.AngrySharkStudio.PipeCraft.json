g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F73IwQhwRMgQ7kNvwEpR0Yg&_nc_oc=AdkLwp_vLos6bfgiXBM8jYnyUW_CUfbBNj36IUS8_xh6D8TXzI4R79YIMLu5LcaQUhc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy90FWQakbjPijpEFV5-VJFDBR_m0xWBf3EbgZe2PLAIQ&oe=69B690DA"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xpx_lu1_PB0Q7kNvwFIr7yW&_nc_oc=Adlt0lWoIzxXKNjI3FnU2rSIKjMeaybI43G0ULu7jy6AhgH6RS8-Z-esFAR9dZaHvdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK5oOyFqnQoREHSvemxE4a2e9QXl2jzaWJloyZDa8G0w&oe=69B69555"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs-Ge4GkEwYQ7kNvwFFlxC3&_nc_oc=AdlGnvkKCZswINSeV8fESDQK1z_H-GoMN9zOVW2yDgNIZQT7juB4MsrArWMBCuq-OWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQ4IFCjnGl09M5ekTyoYFJRSrzwGzepf-En4XxRxqYkg&oe=69B6BB02"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNMVKj9e1aQQ7kNvwGw3Jh6&_nc_oc=Adl3l1MMgKuo7aIZve_kN5fqbOuW-GLes4SW6Tdqa_vLQ80ih6Ywfhbh9BtD2mVeUHE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLIQx7nNytF8U2Y-PCUNR6SX5pNN2TTayIvnQbFKs6lQ&oe=69B68B8F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-Auee9TsXUQ7kNvwHGXg2a&_nc_oc=AdnZvGBvk8WYKoTw89ylnc9hFKauJY_9vnLZ9JYr-MI4k1fwPbEeWIAd0GMKL9aQYqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ-kfKnukPdusKbgsLGsLESTT4iv_YD5SKiLyZV4P0rg&oe=69B6943F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/contact-us", "website_url": "https://www.angry-shark-
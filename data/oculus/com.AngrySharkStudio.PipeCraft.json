4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XK-E4BCYg2YQ7kNvwGzI8No&_nc_oc=AdqGKi_t2yHTXlcRSoa9Kuz2ipBCQm1sRTQZDICdu14_ac1Cu9ThTnY9v2597RJOSGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6YPruABdC2scqN4lzTAKzTMw9wsUoC5iEt21fz2C0SQ&oe=6A31649A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n9Mof9UVQwQ7kNvwGaIJJG&_nc_oc=AdooK17Px1zHwwworYCJRCbpM8WM-gty_VGKQkqo_PIbHUvgRmqmgjnTSUXraQJrJwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RJ0hvyhofGRNg_-Tvx4MgeyMC6LnoalVwq3jgGNu1vQ&oe=6A316915"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zplzmLktPAcQ7kNvwFXSmJD&_nc_oc=AdoQPvxLwR_yQnqEGw5IaCK-whDcvf6H2P8G-aw2baDuKj4_p3Ve3GbltFU1uoDBsig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J2l-IV8WYKlFWP3sZiDMsoXT26hOx6bfRXAw3VifHTw&oe=6A315682"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwWg7q-rAFIQ7kNvwFCkL3t&_nc_oc=Adq5_mjPWqVie5g_L1uaswL_xuIEw-n03y_IUwg0oGU8de0orO8F2Rf2_umCaUzpVW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Md6ddEjtrq3CK9-v-uAquhHbKtLzAdCoCGHpWfFLGEg&oe=6A315F4F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9SKx0cZNXYQ7kNvwG34rQZ&_nc_oc=AdrK_wByFHLn_iLzyAHJ1kS4qP98N6qk9AiS9r5HYnEc7YATmfXR8QAKZE1lGT2h1Nk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JJKr7iqGX2TF54tBgb4_WHcglw3XQw8tNW6PWL_mnmw&oe=6A3167FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFJgjb6FGxwQ7kNvwGx6GRV&_nc_oc=Adrcik84nFLyVNVS4A_zERCWvpnkAGchTUJ5_A-zfL4s2lqQWFLqKV5IbxPK3oXQI6M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBwzt5Y4TxhHJjdbHZMc7NlYzH2ntQHW4nVeXNzOWkvw&oe=6AA0229A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUDgwMaSH0kQ7kNvwG6wZRl&_nc_oc=Adq2zYfw_OXpsNX20rFJL3o5fryeHTMzJOLU40tqqozsgQouVZgfNmFOGndjWoa-SJY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGxEbzRDdRK4TM-l7aqzMfxDUIyHeQPtw4dHSi5i1Q8A&oe=6AA02715"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGEXTtJPDmUQ7kNvwHQsKgZ&_nc_oc=AdpGMF1iNzsy8vtPbNW_QxQOKTkEaafYioNnycLx_795mzYeOKcCxtuJZm3zft0yvw0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjKhDdrWpNpFU7jx4Uq27aX91_avKmsjFHI1sK0Ks45w&oe=6AA01482"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTD4riivCtAQ7kNvwHC-dfP&_nc_oc=AdrrFWqbONa9Ce0n2ZkQVijqrwF1nDnLXrtORUlNsODnwZPkeXUAhe5P-4sLV41nmIQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL45tcZqxWFPZdJy59FcznkNamMsx_4_wDgzSKm9XCXJw&oe=6AA01D4F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwkcf6GycSIQ7kNvwG-gDwn&_nc_oc=AdoVt7FW1qe1O3gnevlZua7besilJrTE1InqBEy6yN6OpN_BSGbFAXUFbMBzFrbzeN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvPn2BzHKLNqNjNbbs53HzLwQe09DgGw-DiqvY6qSiCg&oe=6AA025FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
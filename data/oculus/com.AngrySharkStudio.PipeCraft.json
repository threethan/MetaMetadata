4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhZrGdFBo4cQ7kNvwFdga5w&_nc_oc=AdrX1RCGSaiRvul5Uq-1VEXU2uC7_8XUzSWqyiI1948IiT4kKZbt5O5xuOrDkWUZnDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8IVifSZUhEQqt1xwmfgSTM0SN8IBiBhtjN3XEZI8T7Q&oe=6A9C2E1A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g_px886J1UQ7kNvwFwStTH&_nc_oc=AdpdsuXRkRqg1d2PNldaChJQ3DVVXi8Lv1ByLqF3nr5wqitivWw-gFblykVTDvSLKuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Y0fy84-4Pvr9j7zZYpWu97Xf1dfzcvdmZww8DWT3jg&oe=6A9C3295"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqWbaRmrLeEQ7kNvwEvI6wH&_nc_oc=AdpYJ84lKuhP9YZKmExoXNLP7rac_wCG3MmWdiE7EuG25lRagoPjJ2gz2Fk91NmiLFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWURLr6ba_NDHOui9ju0f6zHtvg2xGCr4_Uq9amt4CYg&oe=6A9C2002"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaeR-qPYIVoQ7kNvwF1HWlM&_nc_oc=Adrwh7y2Jjg9w9odLHoScS7awnI2VWUAbiJc86ukO9Dmz0PvrZpYoTyZv7K1vkjjjh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL19I3f6Z_xcI5ca_E_95uQtPCnhMZJEFlfzHVUQlZPzA&oe=6A9C28CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa8Di_NZXYsQ7kNvwFAXYtm&_nc_oc=AdrPDx1yWerCSAItoEkA8NCxvIvKcbTvAULg-vP8JIwcxiWAcWWA7ssh1F3vOYQ0zGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqe3JC-v33523bdF6GtvyrpaLY2ZR8HjcuJ7DS5CzJ4w&oe=6A9C317F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
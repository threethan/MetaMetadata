5935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V63BrWNnX4Q7kNvwEALj1B&_nc_oc=Adob4nwkqF0AJ_GdPOHe9N_m6b8M3O0oLDKj55mu2J_4quQCEvy_MOtXg5AMAsAiOQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gqfHOpF1nJ7X460RTW8ZhadrThBDQqLBZOgA0MOps7w&oe=69E0F91A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMxJeQ47in0Q7kNvwEx-P4N&_nc_oc=AdpCCj8PB7-eIl5Oinm6hVuOCkM7hpazAxk97j5Zc03zuG1IHZMbziqi625-AHLaFbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ugBkZh97A4A_JyI9DMNJvd-3Es30BQNZSHWLmTCbldg&oe=69E0FD95"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra0yGS_VQbIQ7kNvwEli9aT&_nc_oc=AdrKyarprn7qaYnBkhiKqNulLnbKOmCxoG1hiXZ9b5927LvYEJnAxwh_laBk5G60Sfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12lPhHSqkK25Qd_Y6BR08o5unqu2Jhuh9WjvYc29uNxw&oe=69E0EB02"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxUPON8gDOcQ7kNvwH93d5G&_nc_oc=AdrtIbgXtT3kW4CbIY8hOtinEHwufk5xd6ESBVFLBjimV-tfvEYXAMA0GR4UXjWOqJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GjnwN8hhIxtbra79PhsBsSgWtRJ-D834cXCVJAW8ZzA&oe=69E0F3CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_dGlI9hMTQQ7kNvwGHgnug&_nc_oc=AdqHihpa16Ui1Mzy4QllRyP-FnglO60ANyKGE-deacPy_YXL9hg6xTH209E5e5CM3Bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u6C4Pgci3ns3cm_nS5He2WSxev6TY9g1WWL8CZfg0-w&oe=69E0FC7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/c
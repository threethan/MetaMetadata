5935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-GltvJA8bYQ7kNvwHtpaYX&_nc_oc=Adr57UOU4YvzybND8crtZi4i1U12DNsy99sdt-_p1CZmWKQ4EIpzgWlTThFTHcDAegE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VLzDl1A_xfSEEY20srR8oqWfc_UyZ0rhEe7_i2bom1g&oe=69E24A9A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMxJeQ47in0Q7kNvwE5LcPZ&_nc_oc=AdrTXKSsZQ2FYCjJPA2W0MQlA1pvJevMwyA9FjGddHa05aVP-_hwxvPdkVztIQvfdW0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JbX622pN1QBWVwIAV_bEaS0ARVJKzjIa2Sv5fpLXs0A&oe=69E24F15"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra0yGS_VQbIQ7kNvwG7rzx0&_nc_oc=AdqbWMC4U6uWm28xg8ZRJbrAqRzWCF_Hy5FY_4-Q7XU2OXRjkPqdcyaxOfWQnEghnxM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uKv4r_M9Q1x_Mne1KNpN8wSuVTiFU4MlFTx6Gqkpcgg&oe=69E23C82"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxUPON8gDOcQ7kNvwHAtDC_&_nc_oc=AdqbVkdUaazfSHfLy40Owy37c4DJpMEQz_Z1ehJ9FQJvZoSQ03HI93zEjaMCArhCNJE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r7qqJrUx_wyIYOdr6byRVCxoMwAukS9qxtHWFfyYX2g&oe=69E2454F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMsLMF3ptWwQ7kNvwETd2ki&_nc_oc=AdphBR6WmCyLeCyCY_GQNCuNZbGKDo0HT4Ah7VePZiJ3cPzf9xvg6JBfVA8nzc1pOGg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33mrkxyNGHUglOjkALKNzGYT0EkpvBIp2ft1tOq3cOuQ&oe=69E24DFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/c
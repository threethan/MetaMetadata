g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhj_L0e0zw4Q7kNvwFUM6HO&_nc_oc=AdlVmyWFvjDTU4FTwiOjbTz-jZQ3Lpk7XJ0XHVdGIlWOSQeCUgANnyNyN9e1JAiM2pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybNttgwrlnXRXTdpvfffpIu9sTwsYhd1g7LsPmUnunBw&oe=69AEA7DA"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MU-OMEaUekQ7kNvwGw3Tt4&_nc_oc=AdnVzc1-4mpXKmTV8fPb7gEC6oNGDOFZw9dmQEWzFgCY3LEqySZIescg51VSNsV4kn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvCLwG7a6xENqtWJcPxZEf3bniWxhvPECwZ6Xy0jLZlg&oe=69AEAC55"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMN-d574XjQQ7kNvwENQxYW&_nc_oc=Adl19Fq7BeXPRD9kTujbP4-1sbvyoGnPTVNa0IDJ1qahfR9c9ILtHSZHZ8ptkPZV4QY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxppWvgixkejrSbl9bTlpJt8OiKOGrc1Mx6v6DYSgTZ5A&oe=69AED202"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sME9Q1ld5kQ7kNvwFiH2OD&_nc_oc=AdkoHaMhiRJ8jglaAc6P8QTQYqPgxpYgLkibFgTSL_kcx_IfWan9g3ufGO97qCo6xII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeLBg6wzj70RrCWuA9EJcljoPvHLXT-zPoW5qduaS19g&oe=69AEDACF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3qhJlsMbHUQ7kNvwHfIgT5&_nc_oc=AdlDtD_OKcn_icY-9CTp9zHtn2UMM9emWhKnu20J0pMB50czr8pQJsTCPtr-iPpIDaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYdDaa1VqOJ7j_45caHyqNj3wCqvMHCK5JEGkSOJ4_gQ&oe=69AEAB3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/contact-us", "website_url": "https://www.angry-shark-
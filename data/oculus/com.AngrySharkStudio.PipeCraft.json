4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug-NfGD7pboQ7kNvwEcjKqU&_nc_oc=Adqdj-se1fSLpggFAJJOCk3EU7a55zMjgMahC6JJQ41WXXXtsXnbUpK4Q1zNYygujMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzBbt0b7q4tUH66o74gD3noIJf9bMieDTTiA2jgjJ0wg&oe=6ACA529A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqqtNFn1EsEQ7kNvwEKjXrX&_nc_oc=Adqgs5WjHX0d1Xe0PDnu5FLDeKDRzPRXLOEyyx0ZGxqBG1S7LEa0wklmUAR4-dBZXPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf9-bFNtnm9RTuUV1SeqQUAbpu2iTG4CuyLlNJDl2AdQ&oe=6ACA5715"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm3YaPGPFsIQ7kNvwHwmQDI&_nc_oc=AdqaFmLlaDtzLoctEtmTNsbitBOUlKjs7eHZU6p6K3VFH062CrZ45Rw8vT4_Xts-0Vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgJvt1pFCZ2aVha0O-uYUeFrT1o_DFzxFVzk-JjHIttw&oe=6ACA4482"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd3aKJsRjAEQ7kNvwHHNaAA&_nc_oc=AdpoZQWCcIdDJxjcrNMKZZfvr_ngR50cbAV6NLqwH1vJxIpfNCJYMzdIfKUDtSYjl9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIAS3izgtscNcgKw3I-iqJ6rtf9Nc0xTX8maySHgonEw&oe=6ACA4D4F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxZODB_uUi4Q7kNvwFgIChp&_nc_oc=Adq5pleid2uxbEUhTMXwyxHHaiYzwm2yGi6oj58fupqlWTDNFmtxTWdOvrajptQ2HVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDtkTBUk-0fDO6EuNBkXLRYP8fF4IIxdXAXjYeg8juEw&oe=6ACA55FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
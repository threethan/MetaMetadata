4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yu6T_8JmtpwQ7kNvwEphjsw&_nc_oc=Ado0WbK1qSt55p53qP2RPZ6MHJOyCjULuw6Z9A4utKbbEMsaFaI3q9ZDMYyARSaA9xU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3aVQWbI6m4b8Yo8_YFRM4IAJVnMPq36_CtMgO5Ay30w&oe=6AE0BC1A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w3IPl62dpIQ7kNvwHIcQs1&_nc_oc=AdqT1IdwKmS-by2orjOfbY9fg0d5cDcgYp2XIAhUglr5ZcYYJsiU16JGaZMHmQkJim8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZzJxDEQKQJd5G21prI5eFPqAFzYYHtGTjwG57MJiLcw&oe=6AE0C095"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4vtJgmmIzEQ7kNvwHH05Lg&_nc_oc=AdolslxVzOJV-gFgDcEwI6GFXWoKa1J84jeyP3Q1UgearGuHO1aOa2hN8qxjGEpOrF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOVuloK-VsgEtwkHz8-GEwJAPoxhwrA8PuxBIIv2HyfA&oe=6AE0AE02"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJuns_s_vfkQ7kNvwEzxu1d&_nc_oc=Adrw4OgdfbFcYwH5shAXLaVCLjM89PBsDDOtBo79wSVxsQaGPYzxfuPa9sfv7liB_z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEqMorJXnob9hYvrMcbqp2ml_gZ_nZWUBIeK1MG5Hwyg&oe=6AE0B6CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqO3jj8PxzMQ7kNvwF1tpz1&_nc_oc=AdqgMKuvvffMq-5AtJefaDvk1MbvlqoKMWwUtejpR_qvdC9VHLS12dlbQeJ87PBB03Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9X6ByblxSHq_9onaX-KiTdxhKXWDZg7cjlTs4IcKcAA&oe=6AE0BF7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
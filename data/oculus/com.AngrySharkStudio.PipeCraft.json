5935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApiQdb9qn_sQ7kNvwFi6PSD&_nc_oc=AdqO6BtmBLzGr4CCheA2mVAIv6wnUMJyGa_C3lbie_Bpzs2HwJqjT2qVNEdy9dFU4NY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kQFpj-KOsk62warCap3QCiRoYTwFPlJTh9Vf5uUjrhw&oe=69E7909A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3patzFhS3cQ7kNvwEokESP&_nc_oc=AdriQ7bdd0h9PT2TXvQ2PDY3b3SM58PhMWwtow_4mstmk62KOpg7Nx44LcRDgspkzDI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DcYaqWojnXtogcq6Hmnv0yo7HQQhEsiQFK08iovqZEA&oe=69E75CD5"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4eIzQ1JoG8Q7kNvwHEieKP&_nc_oc=Adr6YeVuuNzQ119mf3P7XHkMVhG_VoAe_Tb90iDjTorYyvTUk35F-F2et5fWuOFaON4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zAcMJflttMTn0zny9GWp31DEiy0SJfEBYQKFkXfGt_w&oe=69E78282"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm_Ld-5k17MQ7kNvwHMsJKd&_nc_oc=AdoY_cnNqGk4XmuFfZDhuUD4cVtHfPYzQuQ9FkvtKQfbHpManIdcHGr689quZauLDGc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08EJ3nEzHTyyoEaPJKmvIn5hzlFk4dShE-gZGBbcKkFw&oe=69E78B4F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-bltMEn-YIQ7kNvwHR5pMO&_nc_oc=AdqsjsVqgDPV-M3mY9Cu4G0l9SxXPe79p-2bTY3xMuREVHmLnSj7-OLjwEgipCrk6h0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oUkrZNmXcEAnKdIHSDoJKAASwApNt-FjUzzGEak0erg&oe=69E75BBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/c
4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4i3vtZjSVMQ7kNvwHqYo88&_nc_oc=Ado1Il02DRV4AchyS8w0AJmSxcgv5j3YhDLmmuUWkTdIvSuJbM27cEP7G7RBT7KNCro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8nTaCZVqu_9mvo6jCPHwVW7J0tMlLdO8dbWXOvE9j1w&oe=6AF08E1A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYTdMoCnnTEQ7kNvwGqNymS&_nc_oc=AdoYM2AOVvNcirz-eQOCH73rbNunUXKBaw9NNtkmBozSxcswfLfjXJFgaSK73HDLZsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPFHCEsitRsoic8RR9bPJfwY9TBK1cO765wQu5SyxZ7g&oe=6AF09295"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmpzJHOEvXgQ7kNvwEWe79H&_nc_oc=AdpWJXXqyj6VJ0kdyyyWjUrMpNpwdy-bMpSDM5HK5rY-LNufLcTPdKXOLgEKO2mBuw4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK252PE_aaqv1Hey9m4od2706Fnr7thp2H6zJamgR2SQ&oe=6AF08002"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjPW9JFOMpcQ7kNvwGLGDYq&_nc_oc=Adq6pBjCsLX5OYzoB2JRHoYFeiFgIj6nIaxzMwkFEXwpL_pJNCA1SKqPQe8w3YhVKR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8dznpDz2s43qOF47UX_nKmc-YyHBjPFcuKmUnrpGCGQ&oe=6AF088CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkZ3Qs6_aSgQ7kNvwHZu2Ae&_nc_oc=Adq9EjKX_u3Fk4DdyXXwgvADywrsioUXlgoGEeIbOFMCrMjOjg8YWZqalKx8IdwsKH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLvgEe1l2W2n5iP_nGILhxJ74XxTg2mCtCGStFgZXpag&oe=6AF0917F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
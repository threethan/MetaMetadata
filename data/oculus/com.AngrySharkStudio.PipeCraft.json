g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F73IwQhwRMgQ7kNvwFx7M-H&_nc_oc=AdmrTxhobyGfy-nmPMPqXQOBPqr94wsCmoHeTSBXAXQ_RmLSMXMBHcNP7JCgZxPghwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpgSE_gLtAWL75jdj-6-LPnFjPVrZLZKpsQr6_TqLWqg&oe=69B7E25A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiKZXPbKCqEQ7kNvwFBZT4Y&_nc_oc=AdnzwC2jEtXHsEDpri6Bc7am-t5IN8Qtune54gPKaOy1HfEXLE4SkYg5ekIBGWfF0qE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc--3PVCfrj8RJl8MhoBhNPyTpf1PSkAu_LTXfuiZv2g&oe=69B7E6D5"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Om1J7idQegQ7kNvwEQcuO3&_nc_oc=AdkvqUqd3aEpy026znxZedvGnEsTxK3zMgSFRr1_IzO6RBCrIngMzgBAFk1TYqyCiW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyStdjuF_RbOW4JfBj4-TNanGjcanUbIAGDRCBq97XItg&oe=69B80C82"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hzHzYaV49IQ7kNvwEAadGu&_nc_oc=AdkUw7ZEy5TrMlbrXYGuozGbjB5yjGdoND4aZg2pZWCtvZF3h20BqbW0rahF3d_Q2zg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNdkGASFT9G2vNy9QIXb9ElFBbGLiqdunkJzQHUlBHiA&oe=69B8154F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-Auee9TsXUQ7kNvwEaT7w2&_nc_oc=AdnyG1M6pmAyu_9AjDLmNBr2mtObiPJrJEk_xdVW-PXhjciP6f9C14n6CiYkkHPHqgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBQboPxQOzuXJ2IAD_9qjEFpYXz5rYknbXKIyqiWBr0w&oe=69B7E5BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/contact-us", "website_url": "https://www.angry-shark-
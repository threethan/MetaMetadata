4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSk7pcBEGswQ7kNvwGSDQrF&_nc_oc=AdrXfrrqpHG7uELZEI7zuht5x-i9xgsdZ0bruzcHrbB2DNJ1x-OHjbpVNTRHYkf8e5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDFR-7M301dOORSbke94ZAwIYO_f2PmZ5yqaXoJ2FrJg&oe=6AB92F1A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vLcuw0m1lUQ7kNvwHlxhFS&_nc_oc=AdqxX7PF0yrkid0Rdw2axaEL5Ps4SN3i59avDUq_TMsjlrstTHMnEya1DLVWsTjL7sE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInNeWZR9zx41Lh8d59tktEU2I07vNrGwWaM_YJu9lzHw&oe=6AB93395"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L84Xd4scdlIQ7kNvwFgjCw3&_nc_oc=Adr9TlFKZcJVKpN9SlqB9TQJ5dBWmcZHVO9H-uZbbgdll0-lTwtZOndiaIOkL2ZEsrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoKxOHJuLaHTvAISI8eGN6rIa0ODpd_uMLolm_G2xHRg&oe=6AB92102"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkyzFpGnRDQQ7kNvwGDquKE&_nc_oc=Adqmphwe1_2bUqtYBSF6_avMt26DAs2xCstv-E3FeAA7V97IMKUhrFpQTe1klup1hVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-68Qd-RYNceG--KvvzQRNnSlk-ZTYyoiklIt-AHBD6A&oe=6AB929CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMEjTs1CEVUQ7kNvwF7eauO&_nc_oc=AdpfBJ3Zey0hdn8FFhnocablt9JbRjTorBoEHzK1NBE11sf1gIcXyrONOFm8oRigmBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwbg3IWYwkF5DY8Yj0tbqRB-W-ZyfDcQaJ310Bl_uEVA&oe=6AB9327F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
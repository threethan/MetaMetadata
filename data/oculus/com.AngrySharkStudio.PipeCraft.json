5935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmH1l5v6io0Q7kNvwFL4mpm&_nc_oc=Adq_0CCI9dDouXAdmvb7eV8QiwZiq8slGSFsv5Vp4oOaQk7dXu_rpZ36GjvJ-ZHZjMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PfNKYcFRx5ElJ4dZi7OTHCwadDoOPGOMuob2ez5qlag&oe=69D8D7DA"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20W1kSJcii8Q7kNvwEjXmAT&_nc_oc=AdpsrJ7Bt8Ei9W7i2IRKGjL_7dv5Af5dIagRcHs9Ghx-4shtm3U19qJEDWeeHWJSK6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qV2skI5zxPC-XMvlMCSKG1SwfkzemswfP9S_XdFF-iw&oe=69D8DC55"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEHgvjRO7bYQ7kNvwEU2ZB9&_nc_oc=AdpEl7L0kbiEZ6lOs1QfpBrIwczm5HGejgoGqLhy4M-9XIqRR0ZkDWLEpXJiBZgrcF4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n53J8KWgYfeqqUJbQR3Esfn3R--fiGmS6gjM_Kw-veQ&oe=69D90202"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr__9eXTVQoQ7kNvwG1t_bM&_nc_oc=Adps-rwfhAgcYW9S8Yx8MWDbVqzlWk1v_zCEHrIAMbxCkuN1yi4dALf0NlPEN7ZUxlo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12sLI-4Lyj9hj8MFPUW5K-sx1MnTly8uNsKDad9t82Lg&oe=69D90ACF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP2EDDJyW6kQ7kNvwEH3e3B&_nc_oc=AdrnQXPxBYRlTKauoz0_04_j5s7TVNAw3OIabwCC9Tk8Uz1u2ByE1fDzY2WZ4ImtgCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YS_f3_d1T2BZhH1yGV4QCAm4tUtvBY5HySPZng4tTKA&oe=69D8DB3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/c
4415935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sY6iyVn-5Z4Q7kNvwFJpytN&_nc_oc=AdrhUF2R3v1hK8M3ep-XJjyfG_QnbpaaIVA5j9seD6Yoe2FJIqGcWjjBYHUzailyrcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx-XyJ4TYib1g-5LaDh7YNRsw7y3VZ8eoJ-DoXKCdkOw&oe=6A5B949A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aXiQOnSOaMQ7kNvwHnMDeH&_nc_oc=AdqwR7KWF9Ex0_aXeaHWK60hNzs18ppiF-mcb-8WIbGSyoHArycPLXUtEeEM1CRf--s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeyJOcf4i-wVklLO9fS2TAvIPyvzrsCF-W-z3OF4Y7dQ&oe=6A5B60D5"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaTnO08-a5QQ7kNvwGCw8ZJ&_nc_oc=AdrLeSjDcM60ihTHkDj4dZkWdWiIWvDiYkNFXIa9XtxdInBwFCS4cBhyyYAsa2eeq1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiP2jRjx5VeCh5gXB1oCJ_oIvyl8XS3YLEO4vjCU6WuA&oe=6A5B8682"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-sPANFiL7cQ7kNvwED3jV9&_nc_oc=Adod2EXGcNHfnpMMmnSRTy4yDJ20Z9G0PY_46wtNF0lV-WMfaKqrcC4sQvQNstw3swc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNMXIaieKhNvnyGOnHD_8z_Z6TL_cFSg5mBeNlp1m59w&oe=6A5B8F4F"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIwrQUEIQk8Q7kNvwHjP_W4&_nc_oc=AdobvtpXi7hvrShuOS6ylGvH81srgbaFYRLW1CV2WlxJfTreJp9gzTBYlPDHq49O2Sk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAebfESn53UTsT6zBFnTG5dFqvnHAPFQ4rQ527WsVpn2Q&oe=6A5B5FBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.co
5935732_6722814523355528470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApiQdb9qn_sQ7kNvwHeDq6F&_nc_oc=AdqRzIgkg7VFRw_CbijbvL4Jn2528FDbrE5LyQUA_0mTx3ER9W4pJiNfS9bfNyveTdY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3flycnI_K2E1ExDyLzKIcmFxL2jvEPYr6gKBFoznciJA&oe=69E63F1A"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL-XpPPGN50Q7kNvwFzVmYF&_nc_oc=AdpaA0TswNg2Ay6E-ZtP8vDWSq-qYfCIvXM4tSOo2SSaQQgSV2lMZ0ZYTmo_PTydhu0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18aTsfInS-tnAdkbs-ujT376-UO7jLYj2NKpWD8mZGDw&oe=69E64395"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvl0Q1vZN_MQ7kNvwF8ww6b&_nc_oc=AdrhL6XUicw4BTcBGkZrKmK6Ju52cSjIE3r1Btks9z0DSB5Q9BSK16ZQSyylfSYeNbA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KJmcNXZMpkD6uE9wjoFVa8Rg-pTR-VaiLks3s7-IJUA&oe=69E63102"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=316sa5Xiv-wQ7kNvwF76RZt&_nc_oc=AdqW5PcepvH9CAbj4QuoRisSOOfb6nz__guO-cKP6maA7OGwb6FzrSymVJasloNFEEg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m_As2GvdlFaoivITm4Fv-pBRhzNlEn50Fw4Pzj3xMCQ&oe=69E639CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-bltMEn-YIQ7kNvwEYqSNd&_nc_oc=AdrvcOVmeON0VxlO78hM1QTuh3NED9XdmY4WqjEqPK6sqDSR2rh_KUDs4vG0xbrMIuQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lty2tPjohx_Q_6y4IwYbTjxVSMwFFeLRHvG2t_tPBSA&oe=69E6427F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/c
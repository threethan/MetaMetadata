g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZM4WK4wAx4Q7kNvwGltBoB&_nc_oc=AdkrDMseLJmAp7cPDfj0U4GBBg0IJT2bUlVYMUog3cEGY2ToVJlGyFoEQCK8UULycVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft7o8dp_5FDBhuy-MPM02y8LRAvt02tHOmF__u71pgrog&oe=69A961DA"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1073350347274261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361355_1073350350607594_5782444683239920288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh5J8iq3SdMQ7kNvwH6GDo7&_nc_oc=AdkR8TBQ5HuEd3mN5ioNpdjXd31qmOev1pGYXsM3agC4ijahzZdspI46lJjXhh1XM6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuh5pMOHBnxjkgqtIT1ELcg85p9rADYF6VNGicNkYnvlg&oe=69A96655"}, {"file_name": "2560x1440-screenshot (4).png", "id": "1244516433458534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031578_1244516436791867_6932105054452192355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrR_o4wBi3QQ7kNvwG7YguZ&_nc_oc=AdlOaeiHR2jOkYcdUh2DlGy_OunQKEoivrlbKwamNTcx8n5iAMgLedcgtUUVn8YsiZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvQllwvUglVoAfi2PXV5ixDu4N7pXpJ509tqhcMtPEqzw&oe=69A98C02"}, {"file_name": "2560x1440-screenshot (7).png", "id": "563129386366012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422373_563129393032678_6724384902397449954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEL9NusByuYQ7kNvwHbCCNY&_nc_oc=Adl-BxVkP-aR8szCGSI5fBl0ptbYRGRxq-K2ZfGznhpjvKLoS4Qku4Tx9fiNqoKwBBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuCS0wE-aVcDPFj6We8EiWY5sM4B7GE2uAP-6Ffw3WJ9w&oe=69A994CF"}, {"file_name": "2560x1440-screenshot (5).png", "id": "546879648066653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974685_546879651399986_243333815591735707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV9Y8Or0xxIQ7kNvwHM2e3j&_nc_oc=Adk6pJ9SD-92d33BRcB0qBuGADejaMhIInOcLJAWYfYt1Ekt60I3-bn9AKBfTJPcU7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvQ64qlTV4uo8fuLL6xIM0y5eemo6V5fncOMYBPPdvrxg&oe=69A9653F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pipe Craft", "keywords": [], "long_description": "Welcome to Pipe Craft, an enchanting VR puzzle experience that invites you to immerse yourself in the art of pipe arrangement. Inspired by the calming concepts of games like Cubism, Pipe Craft allows you to relax as you connect a variety of pipe shapes and sizes to create intricate designs.\n\nWith a vast array of levels, each presenting unique challenges, you can tackle puzzles at your own pace. The gentle, ambient soundtrack enhances the serene atmosphere, helping you focus and unwind as you engage in satisfying gameplay.\n\nAs you progress, you'll encounter increasingly complex patterns that will both challenge and delight you, providing a perfect blend of mental stimulation and relaxation. Enjoy the satisfaction of crafting each puzzle and watch as your designs come to life in a beautifully serene environment.\n\nWhether you\u2019re a casual gamer looking to de-stress or a puzzle enthusiast eager for a new challenge, Pipe Craft offers a delightful escape into a world of creativity and tranquility. Get ready to unleash your imagination and find your flow in this captivating VR adventure!", "short_description": "Discover Pipe Craft, a soothing VR puzzle game where you arrange various pipe shapes and sizes to complete beautiful designs. With endless levels and calming music, it's the perfect escape for casual gamers seeking relaxation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/pipe-craft-privacy-policy/a642f113-1b91-4b5c-bc0a-61984ae503cd/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/pipe-craft-terms-of-use/db6f1492-499f-4229-a738-65af1e9f49eb/terms", "publisher_name": "Angry Shark Studio", "support_website_url": "https://www.angry-shark-studio.com/contact-us", "website_url": "https://www.angry-shark-
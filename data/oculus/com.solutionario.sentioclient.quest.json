pjMlNylAqIh_Iukl6d7aGiecsTnbXin5BMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b34_mIC6aNNaK2qcUpicoqDCtypg8XegLNVDIg7QoDw&oe=6A14455E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CMOYAFgOg8Q7kNvwEJ3AJ-&_nc_oc=AdrnVTe8rgU0-gBvQrgSg3x4jgW7y0x5mTciZFhwlfkREyTaoT7mH52rVxhFLUupf-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mENW187UtiNsR3YuyMVBFinLpSyNuGZZi-QzybaXR4A&oe=6A144B4C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_kfgSDaqnoQ7kNvwHtunpU&_nc_oc=Ado_v274mWpkGE4iaGsOtDVGTGAGb7pT3ehSVyELXXabej1wCCT3GdQvkNLw67ayE5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xKCLsUbc2scKBjFS_EU4FZrmcuMcX_H0LKVowK5EVkQ&oe=6A144CCF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41YsllyMb-cQ7kNvwHviSBn&_nc_oc=AdpEf_MizXd_nvHfU8WolplEGQG9o1CNQ2o-u_Jpts45GNBC0q43G_soAUKyTFg6qRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gVvlLjQY3Jf4qPawbEdtUBjHir36ivrUkmdK4ujt3Iw&oe=6A146CD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T2RLU9modgQ7kNvwGeIRHy&_nc_oc=AdqnmWkg7WW9QYbw3UMEzzyAy0dl00qh2s9EnM9M74ZwSunb5ZNqTM0Dva1Nj_i-dvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RZA0v1KL5WpkvC-ix4FtJMvJfOVafRIs2E8tpklSZgQ&oe=6A14670C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
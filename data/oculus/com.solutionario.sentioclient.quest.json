ttps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210884_429777491607169_8716825292085708675_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKED6_rQII8Q7kNvwETxmZp&_nc_oc=Adph9keDwkRn7F50DTeRjTYYmxjzL0GlujVX3RYVLmYTGSDKrwRMp5dcdLHzIxs1b5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhfuaQgRIad_qly--m6N_n52ppwSEgJoSVIbAjk0Aerw&oe=6B01CB9E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUiTRJbEgKMQ7kNvwF_el7d&_nc_oc=Ado47-nUV-3kOsM_39NOGsZQl6WhIhxy_rnmzm7jg8YkA21kSmTIcZdtl0oT6OgQ91U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6ZP3tVwXA7vMGs_c9_0vtVqCnYQzyTDv3g3lW_vcJ8w&oe=6B01D18C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPQf_tF8dsQQ7kNvwHV24tB&_nc_oc=AdplakXW8NEf6q1CFiWbhpP-6djPg12aaP_-ZxDm5nDjf3EgySkwDuuQSWLkp8Ygd_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScLTtomJi7UTIWZhru3AmhpINYgSRBfTxnDcBGtwilnw&oe=6B01D30F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjeWCg7Z_fcQ7kNvwGTzExx&_nc_oc=Adr3zU-pGpjIG1sP9lImogp9-tStTTAjLTn2uAzevzZ0lPS_ZIyGWNA63dTSCTGy3gg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZchaII665_y32iPDtcgmXAJ8lF1ClJGahBbE0r-rJ8Q&oe=6B01BAD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Ry_OpvDtIQ7kNvwFC4MIn&_nc_oc=Adq5XmKkcq68tE6blKdwsORQISLXQgZhOhg7EWAYtaQW8cjcd4xGGPwIoIV81kW736g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyAke36BdsoLIyvmxivW9dJWBtyF945N_Dx5UGhkHyHw&oe=6B01ED4C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "A
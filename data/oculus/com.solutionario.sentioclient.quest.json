74rRb4lo72akRMPOgzlFJJSBic5zeg&oe=69A0415E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yE_8AMsPC8Q7kNvwHMO6Xn&_nc_oc=AdnkmevjjHG2N4T3rmFnq_Ye4JtfFLDK7NKxhoBUFOnNnV0qR2r5RhkbZJ2XnOWavnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQJhCY8RS5w7ye_wkaa74fc_YeFkYWr0B3H4P-933WiQ&oe=69A0474C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5BGvx0cJ0MQ7kNvwEJE6fw&_nc_oc=AdkMyP-bqliv0Hy2ZTGMsjHinrwoRzL9VupJePisWLT6D_OwFW2FNozi9pB8FNJzxCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAf0caxlAtaeSllBQscCVp4cnuLHaPeCAv4n48LkVtEg&oe=69A048CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-BqxkUbboQQ7kNvwHZZ0G7&_nc_oc=AdnL3Is0_jgfMo0asrWwqDUSpsTDggTRH8DFycgxWjuPx2CG3rcgA7cNZUccUncMFPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afus6CDA24koxXxaFT4hfiHHjjKSqeBxg2BBjYD6wPuRnA&oe=69A03098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfF55MraNKUQ7kNvwHAg9AQ&_nc_oc=AdlvaHU_mJ9J1_2HUW5i1ytvPv7VrDE-HPFNoxyV7MHXqv19VTf2qAmeymBVQkXGiYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssusC6xB9sG6qimKA7juHT7H53ckpHKGpXsHFNF5qcnA&oe=69A02ACC"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
BzpO_sQjybe7kgVpjueLAaM3M2Ap8a2qnYE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pv0q6AXznqeisJq7XjLz5X3C8Mu2pravvi68MW-YX7g&oe=6A16E85E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyX-axMFteIQ7kNvwFlKmCg&_nc_oc=AdoSLUC23LFGWiY3UDtyPZ7U3P47df7WkJ2SCZoRylytod9p90QmPy4bIs5Ma5Xo1aQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vCm_YzQ2QqTPTcYHAlbaFGLvkhZz-7U63wEwSIpmHeA&oe=6A16EE4C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_kfgSDaqnoQ7kNvwEEHkHF&_nc_oc=AdqkxFTLuyMHTYdAG8QGqItTGfD3bbRcA1ZhFalW_q9byux1e0vnImWOw7MBOwmGmMw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PStDP8V6bagMQLHUdHvoYwgKnCitEVrXqtZLyepXx_g&oe=6A16EFCF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX69Ns9iVZYQ7kNvwGbIpnA&_nc_oc=Adq4ddh2tDW6MxQYsj_OVV7WFodE9sMH5KBUXMZ00uNcUSfRB-fKPvcbw17ltIzQQhE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q9NTwORmLGisQYb84jqXjJg72PG8vHO2k14Y7OBynrw&oe=6A170FD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T2RLU9modgQ7kNvwEPJL6e&_nc_oc=Adqdhge3d1Y3kd1Kz_uJ1tyQlEGwCil9b7CjgnugbbF4i3DOzJRWJxO03ljQgpNdUsA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ohQRTsdOF3T8xacytMlkwGFnqE_q8EAhaYDPnEOX5gQ&oe=6A170A0C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
yn6yG_wOKH-OETgjEUvxBgaRkrH8Ig&oe=6998585E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTRzjiuSr24Q7kNvwEDY-UI&_nc_oc=AdlxcBopGJXFfpDlHyzXZEHCcFEHdpBM-np-A24mJ9I4QeJuwpG9co8gObpdcoD8jjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftPZWG6tkmlwvirwwvO1RjY9PlZ_Qqnvbqlz8bu1NyY4g&oe=69985E4C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGxVD9h0zA0Q7kNvwHsSOoE&_nc_oc=AdljN3Fr8CHiKhmU8IZqimNaR00uDJoqbuYXF0OE3j1ZOkBcUeICPOexYXm2BXHbkHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftoJt85YdqPRgE537vgRxfK_2hB8LHBXw2bDYCmZf3t6A&oe=69985FCF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szdoDPYqVrkQ7kNvwHiQUJv&_nc_oc=AdniSpa1gau6_hmYtxd6auKgY3u32mpBPUkh3Yk7vvyX1_mU8f_1fjp5hrtNhbPexvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftzr2aW51yq3iOLPycJQSU2P4t0oqACO0VrlvkNmmj7IA&oe=69984798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqj_Hcuy000Q7kNvwHawAVm&_nc_oc=AdnxLdiBZCIxEijQKj52PCULeZlzsf9_9fjdFlCYJRIx1-DjaKP8AI-i_04OfXF06Io&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft3HRSxrbrXH9sc1TRJlI29Fem-nCI8N5aDKKbD8TJKUg&oe=699841CC"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
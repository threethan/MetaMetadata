j0P4rVcHFRQs8Y-tpGhRsbBQfU7bpwEUGVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtyFLscGTp8P6cyVM8unNSgvbIBZZs9JrRo6st1fJaZQ&oe=6A8454DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuOwT-aMMKkQ7kNvwGx-UhW&_nc_oc=Ado4s8xO5rG4Jmxn6jACHVKT51fJiXYWsVdprVB5yBumw-3ZkDcrOrHlxXTqj_HvNNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzhjGYYWYF_MP3uV5lvwqPkZHJ1mUyt6MAZs6J9_avpg&oe=6A845ACC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8ATSmfTBBIQ7kNvwG-82aq&_nc_oc=Ado65roszo3adTiBYASgH1clu1VYG30LQAo1a-xpb_KBspoVxQFD5xKFGYTYo4GjFaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqlOKuM9Mdux_MANTMmG1OFJ1O6iJES3lC77uUNsynSw&oe=6A845C4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK4-SsDgwTkQ7kNvwGnFRgR&_nc_oc=AdpitlfEwh1KJFntOuoqPIGDXpexOUqV45seY3oahTnJRkb2hRp1Wu4-yDOYrbuU_S8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSoKSQB3fjaeWy_FQu1KdGER6KWn1HvcWBHQkYxEDCRA&oe=6A844418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZdT1-o07MQQ7kNvwHPossa&_nc_oc=AdoFyd6TdCCycXyA7wIvaHFpzldJlZSOPOYFSFILYjvsKkW2blBVdS3JyEBvB79h4bI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQOptf-mlLjqTsNoFwL_D5SO7S5vblyTtUtzF53IBY0w&oe=6A843E4C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
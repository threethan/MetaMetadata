eW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfypjzctlTbDG0M78fmtLNpJBw9o5_sQspMXiG2di4IKbQ&oe=69AC1EDE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWJH7YtgyI0Q7kNvwGpKcyk&_nc_oc=AdmiwtRbA_3jiO3zVPblRU0MHPTqRWJ0ge4_5X6QXcyO4BeGK-hspgPLA7QtUu-3mvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwukFHMC3Ghf-t5k6nz3FlLy-ZQUYd_TmV0V92xE2-hFg&oe=69AC24CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm7bok5xxcIQ7kNvwEh1cUo&_nc_oc=AdnrC61ZM1_mGHHn-Q8EvYwJh7CT9BWJbphvMXm8K6vvioYHRKDoFMojbF_ha6rO3po&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvH5U-uIhlL4AMMrudASHHBCglG6fmuqQd8cbmXTUOlA&oe=69AC264F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_0sVpZLay4Q7kNvwHhUuTJ&_nc_oc=Adlbqec-gUP5iBnBjDWNtiddicspxtrAeS7XbA8Eyv5-3KV9ChvOp3xRJ8rZsebzYVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwEUPx9mEB1RWMWIKKwflYPnHwWjB5HeTxhYpjbZ4YeA&oe=69AC0E18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-Rl6oJBJ2AQ7kNvwEHnT3L&_nc_oc=Admv1EhUa-j_fUtuQ_4I-7WEXn8kXFJRN2hKSh_LOsjT0lY4GL3FlYvShOWutM55ueo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwaf4X_f9h1Kz_9Q-PyGnO2MbGqBjiWk8nOD3t8rV9I8A&oe=69AC084C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
Wso4xxiaEhxMd6SUWLEz-0A7fQqb2_4Aabs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wJJEA7q6ICnfupbyDh3D3qlPwCGRZYhHise76sYTKBQ&oe=69F5F2DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3uz-5K3QTMQ7kNvwEkICuu&_nc_oc=AdqDAVoUlkEeCzaiwqrJXGiAxfO_eP7wcmLQZ220T1Qvk4EaPMdnAY2PuvPmPiHxN7U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i6xy_mAheQ3Ozq82FL7QiGQGENxjRqU11T0VoRHvnyw&oe=69F5F8CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fa6Cl4880AQ7kNvwGVJXms&_nc_oc=Adplq_dVvH0wucDhvBhN1WyR1ymjPXYnec1hyBo3DwxhpSQ_oYd4PiRCILX0boYwCT8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fJ86k5VHO-RtCtDysc1rXKgO4Jx9k1UlEA1q4KuAVBw&oe=69F5FA4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6bcDqVfeVAQ7kNvwH6pjse&_nc_oc=Adr3WFkf8l8YU2tH_64GgMeyvh-LpOKf9u8UdAOPEGwPIgl9NaQ_fzHLXm66EdSZU8Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Vm_OaWTtdetDltJYzqL6gMlbV7CBcVucz0-MwTwaXlw&oe=69F61A58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUsJ2TVqzbEQ7kNvwHdh5gh&_nc_oc=AdqjqlcIsg4IoFKETfFYkvL6fMEamQ1ilWyMMo0ML8cL4noBTxctil91_eE1WxVlOOc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NDOrS_0VKlmfRE-MXCg1jQf7wOau8Zi_72YmC1NNHVg&oe=69F6148C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
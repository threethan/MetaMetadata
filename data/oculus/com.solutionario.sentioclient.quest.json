ttps://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75210884_429777491607169_8716825292085708675_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEpB5GNvz08Q7kNvwHG7DIu&_nc_oc=Adqq51iEOybvka_fffXrICsV06rbq1ibWWp_Zfjzm-SEKU_aDEHKoFOqcoHMQH41IQ0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeHYDrbzoZSxMF8ekBqrtXpWzB-hkvqp5wV9x8WAdrbw&oe=6AFF289E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUiTRJbEgKMQ7kNvwFz6vr7&_nc_oc=Adrxg7c-AZBMEW06p2l9pZMDt1mnw8GQG0PQWPxrphetdAWBfm-lkUl6rXylBh6zrn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuK8eilM6uPGOrIoptLVXa5qhM0e1Qn7rCeHW9DvgqqA&oe=6AFF2E8C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwWdzfU3i4gQ7kNvwFq5yxw&_nc_oc=Adr7gTKFrtAuluTRr2ww1twANzmCrlsxBO3e6LDuVyCJFPrmu1-Enx4-K0erUnQn3QU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFn_fCNbXyjw43eKwQUeUkOSYQ4YmtON1LmmLViemp7A&oe=6AFF300F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjeWCg7Z_fcQ7kNvwH9EtTv&_nc_oc=AdpchXo03d_RHOqag1wZXu3PbYdRlZ4pjVrItre8q1qubFZu-pTfeK9Eu5Y4t4FvgzU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYCWhRENYHPsKTKgosJaWZRu86eyPM_KLAYaWNv9B1lQ&oe=6AFF17D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XC6jLXuhh4Q7kNvwHjbH6L&_nc_oc=AdoU5D9OQGe9o4ggTKBUZTiAmwetmZ96TwqZx9DfaXOIBCIlx2wNH9pvDSFsFCjYJvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Pn5EoP_TjIjUHlPsWNRdl4ObyeJfCi-SKqYZXRqEjA&oe=6AFF120C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2621377568007083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974557_3681210411945497_6364834566122363153_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-y_9HATei4Q7kNvwEXZiQq&_nc_oc=AdobfI-QPychhcrb4l8VeKa3wBnfJAigOUP1YydjxfqkrgSVR8k5T4qNH89aWerjFZs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdsXisNhhpvlS4M-Tosv45fkBV1Tcr8sP0hWchYFG49A&oe=6AFF02CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SENTIO VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1615562541, "lastRevision": {"nodes": [{"id": "1616280075427269", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3823372177726598", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1887625498156187"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": 
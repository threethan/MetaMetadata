_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1F3kUerACqkDzH31sh_VU6qGvlz5CIh9oJBNuYHLyoWw&oe=69F1FE5E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBtVU3jJwIUQ7kNvwEEh6FU&_nc_oc=Adoavv0YAGb7f0seT5Q3ULroxKzMJ6qH2QeJGNsqqVoBuwplx-WV_jefQIJnaZ_Hm54&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bosSn9noXBwJzs6e6OQYDflLe_cgax-OlqtLko0j72w&oe=69F2044C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n7ESqBBIYUQ7kNvwFFpPkk&_nc_oc=AdoKEZI8F-qGOmoSRXerOSWj8C8Ch3HHA-VexJNnBPrEcoGq7-F-F0GG2eQiFP_TvQg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1njgyd9r-zpbk_j_1qzMk9BxNNIAyoJnKRUrXc54cp5g&oe=69F205CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AyRLXyC0BwQ7kNvwEUIJwH&_nc_oc=AdqRgbhYRTqmPf8FMf8XPMXY_SYQiYfN9TP-uKl3QqPy_ArcdEZA36j3N6r_OKvp0jo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0x1sFv5IWMdPRRrB9MiC8a-MQrzweqAQNFZhJ99rzjCA&oe=69F1ED98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3H4LVcVoBUQ7kNvwFm1pFM&_nc_oc=AdqrJ2hpJXJJZPqz6l0XsVFFdo3X-pPKd_uVGGzA_g3YagTA9NNVk7LmQEpRlzTrKtI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3tKOPcehfilt6RlaOjWyVlUqlE2ZgJPenAbaU2DGvdaQ&oe=69F1E7CC"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
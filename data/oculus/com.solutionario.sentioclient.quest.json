31957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkO4WB1KawwQ7kNvwF-CeGX&_nc_oc=AdnU4EvakKg7yMyy9Rxtx6BHe4dU8Aq_KnN0CaJNbMfDvGZOSMJbTXuNS2UTWeihz5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsvRLZ8esmTNgr1oCDvxfBB84ZVlmcaThLcPdA4PsQitw&oe=699C544F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjEDsbLk78IQ7kNvwFNwIkj&_nc_oc=AdnJ_prvf2Es23N_CGsLKg2zm7K1JYVBrdvpD9nAIh5EnVMPHZhq-b4G22HKH9gwsLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuN83tG1tYUtGX3cvzHmtXA0dbX-H7wV1D5DukXKiCvCQ&oe=699C3C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4G9JxMx3y0Q7kNvwFJwHcM&_nc_oc=AdkQKnvNHVWgGSLCU4dXQ62FNYj0VVOStQRqkBeEUgcr3cNCDxev5AAo6YBmkhFSS6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvhUbwZdNymb3ps3-N5lUazDLaQxDvh1ya-XiJ6o8a4UA&oe=699C364C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1qFROWZPNG97M6dEBbC4k0YLRcanJt7Q98sCi56HR6MI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "3013178319011693"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "279903826853759"}]}, "baseline_offer": {"id": "279903826853759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1615562580, "status": "PUBLISHED", "id": "279903826853759
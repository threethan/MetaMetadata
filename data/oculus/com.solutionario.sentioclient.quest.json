2S2fQg3G2moysdleQuBOxgqePWTC0DaQabc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05C7zGyzxZ2BqbtWwuPakqg4YJR03duEuaMomQtuD-kA&oe=69DE37DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR9PWcxu6iUQ7kNvwFOp2r5&_nc_oc=AdrgiAajNPX4nbzZZgxaIJzrQRQKE0Nqvl_6RON2QeZLur5Nwweb2zcf94MBWIeRUDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gI8z4wtw7ePbKDVrr88tAM9jPPRsYcl5PLw7m-3xSYg&oe=69DE3DCC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNRta7FOHKUQ7kNvwEQdKGl&_nc_oc=Adp_TbRDI7x6WaVa-gvsFW8YsEiPWAjTo-0aEYCzCkMG905AQ4RkWPmWn7Zlx8ypeJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22_YogRNjbowk5xxJnQ0rOdNALcvw3JgFoJF3WFdVAUA&oe=69DE3F4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBfoybhjeX8Q7kNvwE1lKd9&_nc_oc=AdpuyuQnjC-Bumu6ws0qFl64BhT1XC-D31zpOXNduxeIj_ZgojMwQy27m_om0ad8sUg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rmk3YA7edaHp68xTygkSFXt7HhE8clKdf_LMmKIDfUQ&oe=69DE2718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK43_00FLgcQ7kNvwGiZVBg&_nc_oc=AdrSIx_z9D5E5i2OpuMxQ0zdcXU_62JGK7BjkKbyPIRlqI0KPz2exq23MfLS-oak9zQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Jldf48X93wEyXeSzJ4iyT6Pm6FXA_7TRAhstY2QBwQg&oe=69DE214C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
hLRhwLFfI0LBFnN0OFTnIBRII0WuI93tflU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d9KErhIc34oD9LnZ-mZGg-VycU96y1Majaz2JPXV6eg&oe=69E22C5E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoIf2V0C34sQ7kNvwFdTjWQ&_nc_oc=AdrNL1VfhvmQivRJ3Se47mybDO3LTLMIqcJmrtqW36USmVpxkBvPJexbszVe6iPuZw8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09Mcij-p314tB57KS1EpXz_BGycQU-eDwKXCERKcUpNg&oe=69E2324C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPu3xdMThA4Q7kNvwF53agl&_nc_oc=AdqAB1e44U7zOSP3A4OlQ6GzkG9q3s25NzLXJdKgiJl2j_Yrd81nC3al9zJmnNfQiLU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wd9XCmXLTZ0yL00O0Dwm5vHAeVZgWiHY_bCQwnoLYfw&oe=69E233CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2_rGlPUBSkQ7kNvwFTa0Od&_nc_oc=Adomov_EIKEyBxvc8JymbkSHz-74MVLlxua0jJPmFGpFoGPzWTZVK_QUppD4VH2qr_0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TxSM2c5PHQS5Ky7S0-rhqoyz-C2_IX9Iw4V4_rVsqXA&oe=69E21B98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dxgv3HUl1VoQ7kNvwHjCaGw&_nc_oc=Adpa8e8I7Lkm4iNl6f7dqre_jg_if5dmouE65FxS3InK2fuz4Ll71sUqApNei_I3Q04&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZoyS95uSVzi8UmZUEWlXcti-k-qvEE4zWO6d7T7yYzw&oe=69E24E0C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
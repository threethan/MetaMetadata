euAsvBSgQ4SGWkqT6Z-FYooavzyRIvYDdyTo_XwbSgIBfc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhlc-HAi4txjl2_ZgvFpg2HWLchx09gBpW3KwkNNf7yA&oe=6A8D8F5E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_dUOGfIeP4Q7kNvwG9meDX&_nc_oc=AdonF_v78C1ICuTjitKIkhlnrVDiHZDPTPkQvbBaXNOXWZiOn3WcxBNAqPseaWkduDU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMNfTGUAQjbIuW4hfYnAdIFqDsOOQa_43pOiy8aHYuGQ&oe=6A8D954C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZT49phC1cIQ7kNvwGACme2&_nc_oc=AdqOlX0j6HWUoJ4B9fljFMXnp72UOQYo-Rsr6zGGLmpO9J56OMh8_WN6dJy7WJWGE-g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9M739Ka4pF7XoeigTIRevmO7bLPaYOmS0qRPpf0JanQ&oe=6A8D96CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtKN1ABM5dsQ7kNvwH9TZ9j&_nc_oc=Adqm1S5zakgWseXhpMNe4AXACw0tq1vNBzy1kysWknAO7X4h4B8CGVSm7CkAL77iaWE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD-7XTJkO-rs_NpsjsG6Vj5CJoRH9M0mFIbGAqDrowFQ&oe=6A8D7E98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBr3dJX2pg8Q7kNvwG_n7fu&_nc_oc=AdoeB_GMOGFs0FiIx-VmQXOMESY7suq1vber5KJEtReU5oLo_4sQBVYI17bslj-ota4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHauEyO84-bnXrrdJN57TPsnUpbSksOKKy16vxwShBy5A&oe=6A8D78CC"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connec
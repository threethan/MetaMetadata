uG4YmeCV4NnwX0SuGl4ODtoM2tAhNuIqvi8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IGkLDbbjgnFT4u6UYIi0zrBgnsMlAV1rPdGhsF20Wrw&oe=6A2FF4DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6UNlbUp0PAQ7kNvwGrTjLP&_nc_oc=AdqxU67NeZdlLw-8yp6kpN38xr5Yyo2dVbzEm2_1RdjbmmlOkIocmC_qiThaeBJd7VM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af860zVeWvTysGmYeUH8cp3lTg-yfm39a-aBtPOrIAyQ4Q&oe=6A2FFACC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkuF1oa7kZgQ7kNvwFaEZ6Y&_nc_oc=AdrCkHtkP33eY_Eytu-SV5tGc0YTkc18M0MPA6GNUIrLUfA3l2njS0ho0NFqw_bQ4To&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pKpzvTn4572feNm95AfFBbBe8c4VqlLm12dWsHG5z6w&oe=6A2FFC4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5ER_VBJn6IQ7kNvwFa5ZsH&_nc_oc=Adr9YNTTMoXy8j0PjXdVgzQEWiiHUzc6WglCjxlm2X2PVvdGuKdYAWpI6_ytecauAjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YJyL9FxeA_MxSUDh3x5-6ETGRH-bV5HiGdKqt1U1NmA&oe=6A301C58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCzkAjoBhksQ7kNvwFjyfcg&_nc_oc=AdqGQ2SQIQRLYkrYHPWxVzhkGhUIAt6mjIufhE_2LSCbQm1yVu41YsHjMAB88tXJepI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A-1H7g0fT6moORHoVMoBrAihUJnI-dRFpMXkYojf4Vg&oe=6A30168C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
d3_qLaXMxev2Qcmt7R4yhMQKAl4Pfg3l8QU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzgk6dtAMqWTpFQRBTHcPSqzh2R8wFvficD_2jL8mx-eg&oe=69C67CDE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twqu_ab_ZIgQ7kNvwHAsN3g&_nc_oc=Adqck51V-dpHpb2Ggrg-yslvZYmMKifq54FGpB1_KBsCggA7pYN0pzAkSsc0KvDaC1w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyngZbenOHSpDfS30nqCoUVXNxQXog_fAvWXzHSze34KA&oe=69C682CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsNkGcWUuq0Q7kNvwE0dzCl&_nc_oc=Ado8TZM9ZrbJqRiBW6SDZQHAagzdvoei_6THklG1oadJZ31Q_FpCcSLjrUQ5-2Ln0kE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSYKsVko652D8Y3dZPFSKlEWSGYyGaQ5xMe8q9OvGuGw&oe=69C6844F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP5JHOv2Z3cQ7kNvwHoPOMv&_nc_oc=Adow6tRkBdJDbDBrapP8KNj3XACW3O5rGL1O70kkqxy1nayRoNzZHTILuub2f7hS9XQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq9wgj55a_t-Jv-L6kxxNMCxKFxiVcsumZqKhgTl_zWw&oe=69C66C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqHYF9Rb6qAQ7kNvwGvjaq9&_nc_oc=AdpPS8aGJu5122_Ru0BzYEApxka9bYcqJ0zEiHWfEULEij316oUQA5JaccFPvjVnLKI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh7ECrKXQ-o7xb1M6m9JrPDIpzykru0HOoBVyb_EqEaA&oe=69C6664C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
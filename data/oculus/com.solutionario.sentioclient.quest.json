i5Z_94OyIbEFBfxSmAQuS7MaD031P6QJQBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kNx7hSVTRmbPTT38XPtzodzBEe8ISFCiwv76e4DW3OA&oe=6A3EAD9E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZS8D6NuAxoQ7kNvwEDrMSl&_nc_oc=AdrMn2mkZr_G9vJLdHwqLmlrvV1XNDU7U6MD36wK9HxWQMOOXvnTq9aKxVU40CfNxg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NzZMWQLqn_H5iZ8Ma58dtz9dRJyoS4ns9YEdYIyT79Q&oe=6A3E7B4C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEnYxquC-IQQ7kNvwGCX562&_nc_oc=Adq0RtV0BptD4pLpPqb2EpL54zSwVIxjgbxoDiDHibLEagi1gR4kqi6Yc3v9mrzTj_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vkD-Jy1rKTGbXIKR64QcrD4GvSCi-iBzOHeP4ncgszQ&oe=6A3E7CCF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULeO-c0MuawQ7kNvwEb6-ao&_nc_oc=AdqdbJqyBgTsUCpmugsp4T0lFkfBfaBExLyDk8WAZ8YKcbD0Asjt216CaDXwxO8XevU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sQfufgr3ItAyJ39SjPT8sft34LHYDYF94ZQivcqIVvA&oe=6A3E9CD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sRIMupS7l4Q7kNvwFta0YQ&_nc_oc=AdpnuKOG7WYxJfUULMtcdtasDN5IhrAwTDEaDbSdywdlmm7SmpTCGMI02qvpDj8wWQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ei-OHGPRdSzsIr7XRT8EnYA-QPfmbv4CBcVi_CeTq4g&oe=6A3E970C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
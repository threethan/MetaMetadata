ng?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnGqaHzvBeoQ7kNvwGbAVfJ&_nc_oc=AdpLCAErC22OqzrazYmPXDvaPAg2uaVNytOqNdZ77YcyL2TGeAS_F7FnvAoDs7x2bHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3I_gaJedaq7qb9-pIIiCoctFE4sieNervV1Sfbq5Qjw&oe=6AF8970C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTsRIZeJxCkQ7kNvwFdsTYp&_nc_oc=Ado0JU4-XFfSmm81hIqXgtN_FZHMG9q2Auy00X7iaScQbK6676qhnIY8WthHCM2TmZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzFzdcwnKQ5TpRoUA7koityktMSKZY_tARCLp3ISHgIQ&oe=6AF8988F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-e-4OJ8LEYQ7kNvwF-9p4Q&_nc_oc=AdpqlNyjsrUDYtYn-K3MUlCzyPZJt3mexgPIFfJ4OEVmJzqwC-MSdGTTCvzWXYZ1cgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG6YVF1vul0c6itvYJuaDZTqCVmf1ZqPGwsfoogWDa-A&oe=6AF88058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUMrl4hLMc4Q7kNvwHkECI3&_nc_oc=Adob3RoS0oTD5cEU5-vHii8FoAEWGk5OjUiF88Lcdk-WC4nphdoGOEjfL4ZU63Dwlw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8J_uA1QggfHxF95JDwNQJf_O7KtSPyMBrwZ8twNtrmA&oe=6AF87A8C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1qFROWZPNG97M6dEBbC4k0YLRcanJt7Q98sCi56HR6MI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_
Jds1jEvSsKqQFHWRrOtQXMeHFH-QWOq2ukM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zHuIF20kDRqgkXcQyOXIWL6KjGkhkIjB66sRaYFMSwA&oe=69D3ABDE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibML-ilLDOEQ7kNvwEM_iVT&_nc_oc=AdqVUzNMapGXJURDg5y7pVmfzIw05ztyq7SkmM0XM_AL40c1iTDBhNGNsMhuV_rvcoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32wysE5A9p3wbGhA2d6UWAN37f09t5VLwTe9lG3zKueg&oe=69D3B1CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_keZ-y6Q59cQ7kNvwETxjX_&_nc_oc=AdrU3Sfz4i3AcqA7EoKik-hplyeDWUHbQrnbguaEU1u2LMniC8pHQZrlZnicQOCTclo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PPoR9PeEKujCwMyDGWDUD4KQENZWLm0yhJ-VKcGO9qQ&oe=69D3B34F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhLV7HijAfYQ7kNvwEAa0AG&_nc_oc=Adr69s__WWZZOH32qAhV33pKqZ4aGcSE2ZgDt42lAxB9ygO6SV_Y6EHdJ099-FZgmCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H5xCDTztJfEvWdrMgVWpfDGW8S8a0C52ln_JdL6eb1g&oe=69D39B18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWyENuns0CoQ7kNvwHKhObM&_nc_oc=AdokXCaA3adV2plAHBvzID0jj5So4Z4jTGAQI4b8jGSR4fUBAN6lXetu5xm-HFy_H7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03UE-MwnzQqsC7VbP82F0CGYyeYTcm88zEV5qvOwpEgg&oe=69D3954C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
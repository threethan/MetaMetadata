0VVdx5_i0W1b7H4vAb-fS--Ej2lkXLbIDjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYLlnovd3pBPKrhignIqM0oxRbH1gsv0oZVZ4lyPdkkg&oe=69C2885E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCLingT-Wy0Q7kNvwGSQUFx&_nc_oc=Adoj22RkTlKXeAHJG1tjfr2GCwjtQhm1uLA3y-1nUEcgwq5ISXEC1oFrDnbVNxGLy2o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzk0hzRxHlqjiqXNbl2Goi2XRX7PlxLbwMioAwxktFYtQ&oe=69C28E4C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6wws3oOQ3gQ7kNvwH0_5Oi&_nc_oc=AdqzmfY9oxkOtWnwmeAC7SJmMBOJxUaUkqkI0T4xXoG-_tMKZpkvtaPT_dbDS_uV5I4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDBGHbuZypiL_Q7MZGKV6MuRtRuALHOn2pe6kfH9Si9Q&oe=69C28FCF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAIkfhzQWKQQ7kNvwFRrYMi&_nc_oc=AdpW0-5sUgatzOB2AjiXjZhAyJhhOQ42f9XlSDzIxTvFVCIGyFHnPgU-O7ExxM8WeLs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFc95h2GQWFHzqZEzUYBZ4GzJ-y5HiXAkaiAOAvc-Wpg&oe=69C27798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfDUXexG86cQ7kNvwGRQcxo&_nc_oc=AdrfekK39agVAmL9cEgful5pwSu3f9Ym_8vhQKFxcuNUypKMSCw9WzxipQsYgvEqvY0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdI3tNttvksIQfB-_oI3ewoh7b81yyZwqT0xeQw0TTFA&oe=69C271CC"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ttps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210884_429777491607169_8716825292085708675_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NofnFVsisuAQ7kNvwHpCmgT&_nc_oc=AdrloBYabOw6vdloP0pi4U2zfV4_9w1t5aUFO-qaU_3VQFotf1H80UxVXnOFF2U_kBQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO7MVT5i6XEavfUMHqGlP-4WxSqruylt6f5UyoBg3L5g&oe=6AFB341E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOjkZAdDFucQ7kNvwHqQd7z&_nc_oc=Adr9KBBeIYJyUTC67om2MLrq3Vl3jukY2jq2ox2UgHI1KKBRuCMRY5TEa2BAH4LU5ms&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXqS6H4je5PKBqr0VDYWqq0iJevQHEnmHTkL-Ag1rDRg&oe=6AFB3A0C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMTaaQrHRysQ7kNvwHrL698&_nc_oc=AdptUy3QZxBHArYQaSZBGE87jX6RF1fOFBo_favkm5OJrsUh0MENxjDeitZwtoNRPSQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7XowABjbdMWfF7MOWGG7ZdopmTROH4mXL1QSCQsAjdw&oe=6AFB3B8F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1ZfnLfVTKkQ7kNvwGtGwKl&_nc_oc=AdqRylAzO1c8369oByhWCMmkDS5jO7zoysQJ-Q8f7XiBj_KQIoCYr9TrksYveFK8Cvg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBiXLTTCzf1f3BHK8aH8SsbKRkD-6AOTOCc4dex79Ddw&oe=6AFB2358"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRorSDjdGXoQ7kNvwHNoXEw&_nc_oc=AdrRnlPBtcPs2xHZMDxrH6Uh86JJm5BsKsepIXZKXCjAMu2Anj0TUrkGdOdjv82Z0Uo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqjNUFjSNPhYBd6Phfm7dL_btLtDUCPq0Qkjf0V14hkw&oe=6AFB1D8C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2621377568007083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974557_3681210411945497_6364834566122363153_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymht2Ejt6aMQ7kNvwGPJJdm&_nc_oc=AdormDaVtgTRMyECtr4Bkpl_p-6hWh76tAdwAXiElgm9-adwoopwHMUPQzvifbr9ArU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9vS41DFOy2p4e1OTFFqimrSmE2X5gtK--tiV0qb_3Ww&oe=6AFB468C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SENTIO VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1615562541, "lastRevision": {"nodes": [{"id": "1616280075427269", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3823372177726598", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1887625498156187"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": 
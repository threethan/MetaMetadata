LyElZo4QH3NQPyrmkteGDQpBHKGxd-rh0oQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bdSujhGXgLm79qDgDwU-_JMWyFklbrieTp-PTxEpH4Q&oe=6A3297DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_efRjqtwCgQ7kNvwExH_3s&_nc_oc=AdpytecA-aIRX0H2PSfvaFx9HWDDhrAyXCgeGidYwNMGfNVucPgkWuCumiCDwMbO8vI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DqhbaKgxpIOkYlXYYCZ6v_DCsHMuouyS-k-u6QizWtQ&oe=6A329DCC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkuF1oa7kZgQ7kNvwGgS3ZD&_nc_oc=AdqoFcQZ0I5YDr884z6UprYZbhTr2D-GzHwnBrz3cJlcm-cEIGPJVhbfstXb3JliqxE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AXWNBfCdMQdK0NMd3zBS3HxZXfq2Xut55cvm675PcSw&oe=6A329F4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InJU42ziU0oQ7kNvwFIfNFu&_nc_oc=AdqBYV7ZvU6GaXMTe2_kdFZBZBHTepse-iB95rKs6v3M3PC_yd3hd0ytz7iLoJxwpXM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v9LzBBz8JQIkKlSdjWW-RB-QALK_lSvG2QOiSxR33gg&oe=6A32BF58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCzkAjoBhksQ7kNvwEPyxBY&_nc_oc=AdrFfb1NuA31qfPy5b9eKMriYkMNbyke0L9WSEj159lEGJ39x2KR27Bde4s5e5yWvwQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CngO0S1S1OJvTULC94WP148XFp7BvGgZY2VXquOI2Iw&oe=6A32B98C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
oeRUcMgDDuMuWi9GXy1dK4ze7x5kuPt0HBw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12qsB8m9lPh0NminclvWclDYq9Mpe67QKVeZY7nHotnQ&oe=69EF5B5E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAHXBkhciU4Q7kNvwEh_S-L&_nc_oc=Ado99r3oXyKUJ1fTSVy3DDhqK15RcDQahYWFieRe3856krt3cF6N5cTuebATT3YjDSg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0i8OTZQ9-qIMpM13iMA5App_kq-DET9qPeCQ9b8xqg_g&oe=69EF614C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD0g2N537QcQ7kNvwHQIBBu&_nc_oc=Adqx2273WTkYSVS2ndMLLA1EozUcvb7fdgvhTfgLG7_bZ-NStKrzFV5I5MqebB2RZ7k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JIH4-o5LQejaJHJEFpZSFM2WTtYRAsCIlf_DcML6mvA&oe=69EF62CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoeAcSBtz4oQ7kNvwEboYxc&_nc_oc=AdpKG1p9FcY17f4R1G6vrG_JvE2HKhatXgQi0h5g_yZsrtEigirjr6DC9HZu0O7AOmI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iW6_t-PBQ33dVB_iMXqz0YPjXBpVxc8THiy21RsF1YQ&oe=69EF82D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOlyO9NHP68Q7kNvwFxxrWJ&_nc_oc=AdqXI6IolF9mcgIk54gjIPudLoTyqK-xhRk-fxudx9hSH8l5DyG5arNN_wUW6q-s7Lk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UE1PLfbFYik7Iu8S1wsG0LjfrocZi7gEkgxc9e7P4UA&oe=69EF7D0C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
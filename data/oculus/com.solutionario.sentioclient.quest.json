eKOgz6PXfiybxptMeuzfiT2sJL6dwCHfll8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeYOBES9iuKu2fQvD3g_Iypuexd8-uyUmMqCOiofWisA&oe=6AE340DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zq5Hvkmcg8Q7kNvwGANS1U&_nc_oc=AdoxasHappbFLZxOPl1hw-xIP-8LSxd4hIT1MrDj1V_uaHj6dHjvqMgBiQjEKdg5LXI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXl8bb60L_YyvNinS2ezJwrim1gpE-uvQ-3TFPO1lsyg&oe=6AE346CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbs_jmPOOwIQ7kNvwHXBopv&_nc_oc=AdqYOgistycTovx22cpX2akKSBEVMVU-9tl89pgKnGJcTHpSJjCl-DudC_ANQ77snVk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6MMq8Uz_9bfMfzsVFTdpjQ8AMI_-bAKkft1UPpcm3OA&oe=6AE3484F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ5UTvymhx8Q7kNvwEE58hC&_nc_oc=AdpOIdw_9HlvduM6D7OKjaO1VOvnlSx1Qisp0cnvZtAkrLK8MbS9ZKwNn9eO-ufnfTI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN60jKSYjhT7Pq7NyHiagVjDI8RsWcUOeU8yw6pKiaVKw&oe=6AE36858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_ZDbmyawaYQ7kNvwGdqhv9&_nc_oc=Adqo8OobRwRaBdIGi6oZCjiDoeuqxE4KeKdUg1drQhNuxtVcsTC1KmgOKS0rKryZ3Oo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZmyvR4tUAKRS7VSDgkx_740sqvw2h9dM8lT6GLXOFvg&oe=6AE3628C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
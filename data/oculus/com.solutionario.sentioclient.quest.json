ST8wmGV_h2v_jUsK1NHfWM4maDNkBs902aASE-E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vopJQppWsOryG41SoVEXE7mIJ4XvZqZKNHGkQZ4t5HA&oe=6A11A25E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CMOYAFgOg8Q7kNvwFmER4d&_nc_oc=AdoH1Tn4cNKoSDmyDkPwk-N9ONlkJnwbCN3qu2w1wiZ_-ChGe4CloVXxcTI8Mo3CsA0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AX-1dfiu8odWpaMI6_QI5E4lJUEyPqhaCWcaHUef--g&oe=6A11A84C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-INzLZm2wPMQ7kNvwEQrlA1&_nc_oc=AdoL0HyHkbsgW9NYB8_FH5FA2Xe5ckJY2tA71JPZw9HGRfURvUPwwslr4LJcTOYURC0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af576Ksh6_P4xW5Vc87jw97UQTisoNruYIu64Kebp3gkDg&oe=6A11A9CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41YsllyMb-cQ7kNvwHXuyra&_nc_oc=Adra94f7_LTMJxsylLkc98h03t_ozioazi1df-OAmUW5JTWYUIgyPK-kppxQ9U2w9XQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iuwmnx1Ob8OJBS-KcbtjMHAvNHveu3xlk8gFn5Y5uPQ&oe=6A11C9D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sen0bgkud0QQ7kNvwFX4GT2&_nc_oc=AdrvMTZvy0slxsByhtgCGeMJHCz2wMexF9Z8sLXzIItEdUgYJ_iCpzzrsnVOTIJsj3c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GyTl_7I_DCb7Nyqz6tZ-PxVOpQuWNIe7L-VElDyGyOw&oe=6A11C40C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "
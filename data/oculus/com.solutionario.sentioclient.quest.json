hCeICDB5XyaaOmcnC7rrbJeqBfynNKzhHv0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvgE5b4BbgrKzlVmjNZXOlt4s3eM8h8Fk3d0zZRy2Gfw&oe=6AF9E29E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnGqaHzvBeoQ7kNvwHYqyBK&_nc_oc=AdpLTs7F6BLTObIDx8IHYBb6NY8Ga0HTvCabAA0Y46RoTsXu5PlbqLylfDJls2fZz4A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRGnUc6SiMdnpDkAmzca8ao04JhtRAU5fzUB9o_ClbNQ&oe=6AF9E88C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMTaaQrHRysQ7kNvwEChlC_&_nc_oc=AdpQMI5sUlQlvClzFSKKTTlptCj11Dqnrbue56ewLWokhBGfaAjJGBnFhYqfXiBTUsk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt2A6JLdE3cUEfdI9gG3NeWpb0I_-0xHf1LdH6b8J7-A&oe=6AF9EA0F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-e-4OJ8LEYQ7kNvwG1Iw3i&_nc_oc=AdqRfv-GOVNwRlRPJh_3hsnNxuNgvDXZne4pgfKDrryNHKexsVkugTSgMuD1PP2C9p8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo53NiCBJDnkZo6gXZboGqCUt6wBPQ77JDRu02hhi1OA&oe=6AF9D1D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRorSDjdGXoQ7kNvwEn2R1y&_nc_oc=AdqxEjpT9a9BuIHbyUQF5oEm73W9H9EdUh33e5JXJrDDw87Svu4NpZ7jLITYclV2XJs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdFVBPXHcERjFEo8DgCXG8T5VELPg2mEAgYz8WSH-U7w&oe=6AF9CC0C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
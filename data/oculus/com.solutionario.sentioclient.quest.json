WEn6Z3NhgqXNzSYMaDuMf7_RRVGpzfGY-Pw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYR0q5lJFM8v7vyO7U-aaOwzBIE2oYy7TM8elqqoL4pg&oe=6AE8BF1E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLy1zjyHfRMQ7kNvwHhjMJl&_nc_oc=AdoHl24B0MuJMLXNSnGlNrqtWB2K8XWMLX9TDoMVe1vsmaK4TX3y-LeL0ksemrvVi2o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzwrpwh5GGfjUnAgoPQnfw5JLM1DJrZVl8KNrIbDB5RA&oe=6AE88CCC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGqgSyBz8SQQ7kNvwELQfcS&_nc_oc=AdouA7h6DNDtDkuTE5RvbEKGMiSqWcA1a2NFRlInWymMgfIjOcbCGOTC6DGQrw2p7yY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJcPDbSv9Ku23TD4d8O8Z2kEUvwbOk9rHR8UlS0L0ShQ&oe=6AE88E4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpwKIVaPktwQ7kNvwFsZQdn&_nc_oc=AdrEA-6zBqXa9nqt00bHFLPVDuo97YxX1ImTCkwgGx2JPdUzEXzCVX9w3XbhkgMbdDw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB0c4Z3nzBnDgXFYiWSq6YizKF_HfoXkc88CNGCWslXA&oe=6AE8AE58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mfx2Va7xJwQ7kNvwEsf1hX&_nc_oc=AdoBEaOLOP_7K99Vs90SJ1cMLZHhnsm9p3Xnylh7g0bxGkyNEtkwe8aMrnvK0O_2Tag&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbyTqr8zLn47eQstL1dEq3UcH17IToDhrLbBkbq7o_eg&oe=6AE8A88C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
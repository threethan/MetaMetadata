dbk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3XUycdHuRRgaJYxxBplMhveNR0VWRCj648F0iY9P8oQ&oe=69BD425E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i2hg0lQspQQ7kNvwGsKM2Y&_nc_oc=Adm_NTep13pI3603XfS8kSb0XCFDGuhOo_cAPKFpVRfgb9H_hQA73fwDP6dGJMDQaC4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyloiYZvwuH0JG5gJEDy0LNfeMD-OT9E7JQ7uqeTyA78w&oe=69BD484C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dbJzP6e1j4Q7kNvwHu2Rt5&_nc_oc=Adk-MCYUnU3kPJ1vJ4NUht-DcM5_8ICAp2QUYVm-zk097z7d1ArIt7LcTJe-N60ZmTM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8TdKlUAKCCkBstczCc2TYOWLufawMb2mGibtCozaEgA&oe=69BD49CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnVQJz4wJt0Q7kNvwHSq0cP&_nc_oc=AdneDIewlOm6C90FH483YRv6gMuQXw6j1k4mSyicYUokNG9i5z45Zlmp_1OaT6-GAwQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXyc8S2H_rE5aRyWJSo_9NYdcEH-JTbsSRA1jpT485hg&oe=69BD3198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coTGNubE-jwQ7kNvwH4vRd4&_nc_oc=AdnbrvOgJpxeOgMSGI0OsOugznPpE8tF5LOd6Ts7eA0VM92UIq4p7yurjoZUc_KY8U4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfybsLFegpQVhChAhSxxE6ZrsDDWBTr25x0Y2re7oJOSaQ&oe=69BD2BCC"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
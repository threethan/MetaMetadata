ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk7dF5tijd-XXajOdIbnCEVh1iefYBm8lXU5txBT9PMw&oe=6B0863D0"}, {"file_name": "4-bim-data-in-vr.png", "id": "1507008661490229", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/908842275_1507008664823562_2110276655969063682_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdapj42p1kMQ7kNvwEB_8ED&_nc_oc=AdrXb91q5qG7D06yOyNYynyKTm42rsysDSpkUkeb7W5nEqi9CmJbfqu3Xef5utuXwxM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPSXr7wT92plJv4NyuKP7YRWcqBKbStT3Of60jYVOSOA&oe=6B0845CA"}, {"file_name": "5-ar-on-site.png", "id": "2355805888600653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/908842293_2355805891933986_729930331332683479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw-iRWkmYGEQ7kNvwGOfUPA&_nc_oc=Ado28oVQON-iDXu2MIwWya4ujkITcBPheNtVDYSAZ4C_i9wmcbyBork7Wq-W6VcSRxo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwvOP2UKvFMiYc894NiY5fxmY21gA1aTwVaZ-VV36PNw&oe=6B085E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2089341601716788", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/908842200_2089341605050121_7539917369109559188_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5hncjoFYPgQ7kNvwHMUxjZ&_nc_oc=AdoJNwVkrQxq_uqyjxuEojcyF-Pxl8A3zGvgfvP-O4ddQUN6-92v2FdzNkh4KXTQm9Q&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1d3wNKDu6ccoipWrfbQewsgKkEg4-SMyapiWIiBZp2w&oe=6B0849B6"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "# Use VR/AR to present, review and verify before your project is built.\n\nSENTIO VR brings 3D models from the design tools you already use (SketchUp, Revit, Navisworks, IFC, Rhino and others) into VR, AR and web experiences in minutes. Simple, standalone and secure.\n\n- **Present:** walk clients through SketchUp, Rhino, Revit, Enscape, Twinmotion and Lumion designs at 1:1 scale, including 360\u00b0 tours\n- **Review:** coordinate Revit, Navisworks and IFC models with BIM data, measurements, visibility controls and issues (export to PDF or BCF)\n- **Verify:** overlay the BIM model on the real site at 1:1 scale in AR with Meta Quest\n\nDrag and drop your model into the browser at sentiovr.com or import it from Autodesk Forma (ACC), then open it on Meta Quest with a code. No PC needed. Viewers join by link or code from a headset or any browser. Host multi-user VR meetings and work offline.\n\nISO 27001 certified. Used by architecture firms, contractors, manufacturing companies and universities around the world, including KPF, BIG, Turner Construction and Hensel Phelps.\n\nQuestions? Email hello@sentiovr.com", "short_description": "Use VR/AR to present, review and verify before your project is built.\n\nBring SketchUp, Rhino, Revit, Navisworks, IFC, Enscape, Twinmotion and Lumion models into VR, AR and web experiences. Walk clients through designs at 1:1 scale, review BIM data and issues with your team, and overlay the model on the real site in AR.\n\nNote:\n- Microphone permission is needed for VR meetings\n- Device files permission is needed to download 3D models"}]}, "developer_name": "Solutionario Inc", "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Solutionario Inc", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
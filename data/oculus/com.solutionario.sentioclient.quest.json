GuWcfhzYWEUk2qYXjaiG0wdD-N2ieHDgnUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9SXaDKzLLYQdZY3amx3i9HxRUBvnNP0fXbz2qsLygEw&oe=6A6753DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6hLW0MRnTQQ7kNvwHdYmSZ&_nc_oc=AdoFCprpdnYnDsG4Y1xh6iThcsakONsMk3ICEcy4wkmg_yTSTjcv2Bq7rwrgwE10Fzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW7VqNv9uJc006DGxABIVJ9QQs0d3C6Bc5m8gxKsHf4w&oe=6A6759CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pQPI7nybBIQ7kNvwFHppN0&_nc_oc=AdqTgWngRskhUfDgl3wC0IVfDqqtUgrSfkV-CxfShxr9ZShxv45f4qjO9XCHa284CIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAdzpR40o2laotMVe8h4_VsXP5a5fnz2NUfInR4RV0Eg&oe=6A675B4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU2FCuL4OhEQ7kNvwEiX4jR&_nc_oc=AdozE-LGuYNr8WCbrDtG_JCxhI-XBwklAUy2N2kWaiMYk6V6tnxWueK-Mwl82oWCEnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkJU_3zIWJo5RZn9m-t0ojH5lampRFbkhN8Cm7MQHCOQ&oe=6A677B58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds_WR3_JHO8Q7kNvwH3jyCT&_nc_oc=AdqNB78IHpontoJN3376cCNOZP4PC7tM12y77WHK8HIFEthS1IqyTuOZgtY_1RAkfR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyuRsAyxlD-ptitIyyGdWO64H8hv8cAOtFTB7vyyD7yg&oe=6A67758C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
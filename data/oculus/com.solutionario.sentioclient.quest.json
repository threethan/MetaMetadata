Zn4Hy64TXe3R0VFdSrm0-r_pfJ176KIDqow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MmRIqP5Oo5I2SNyjBQeZoIXdg30_7STDX0kWnvHQ0iA&oe=6A1596DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyX-axMFteIQ7kNvwF5kUZX&_nc_oc=AdqPxFdB4xMRSVy9NHJbGXd-Yhu2daPiN_TMe-hsvL3oIGAkQDcIlS20xWJ6dJuIFq8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gtpm6nY37XDjSOi5tI-jRqHv33pj5ZnQ85obXYkL9FQ&oe=6A159CCC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_kfgSDaqnoQ7kNvwHUQ13M&_nc_oc=AdpEbjgwgn9p3WiFfO2dnJK4oVIPJi4JsLZb1rm4pOHSH-8pRk6CYiZAUUybLaU1WCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zr7xzF0c7nuRahrNr6tkDaGvYIe364ROtSYDjmd60aw&oe=6A159E4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX69Ns9iVZYQ7kNvwFkBjKq&_nc_oc=AdoyIykg3xlUMlcJoad2lzglNS4_QinT9zftxkbo5dkYwklgXga48x0K5oj_UX4E9BA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s0-oljpGFchBOMP4dd2E2u6yeX5c307KnEuBznEbJtg&oe=6A15BE58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T2RLU9modgQ7kNvwE-EQ85&_nc_oc=AdoGGXAR05YYszsi2XCoKWeCh9EuGHpIo7tXFOLBUkDALQBavPsd9wuF5sO5Gx3L_fA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af798xJCfvoPBtzX7_0lzrt-wuM85Rub4GFqk5OxToOffw&oe=6A15B88C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
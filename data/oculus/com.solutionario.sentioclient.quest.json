RRGIROb8DwgkN72IzPZaqNoRi9qjFLd3RYg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FsX226c8urBwR_qVge7RNu_JnciWJe4Lra38WMAq29Q&oe=69DF895E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR9PWcxu6iUQ7kNvwEiEmoZ&_nc_oc=AdoTPv3Jg3CB87heKTvy4daEiAbHPQLScaY1Kv5RkSFgtLVA-b2tcS24-_nJGtbfLMs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SgV8RA2kDzWaASCPi_-AYJ6nyWDivJJ1UGnbz_VHOSQ&oe=69DF8F4C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNRta7FOHKUQ7kNvwF8qLcI&_nc_oc=AdpX1pQwGsVS9u_K7l3UltU9_OLuTde4cOGbFlZMWJJio7HzB66rinc2Y-jSIaAVOd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gakjtd6mlMvXrcPKn1PqnLHvQ6FF_SEpueUh6Y3EywQ&oe=69DF90CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBfoybhjeX8Q7kNvwE2q357&_nc_oc=AdoJaxRyZ3n3XxlILiKeKeOOOHnF0K_c7fvcZlUKaiuvrFcMKTWuGWwnojtBXDx2FD8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WHWzSKbsPvXS2ey-qqtOVWmdUPFcihgoSWK_wlG_BOw&oe=69DF7898"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK43_00FLgcQ7kNvwGcXLLE&_nc_oc=AdrVCTxgdQ9vBpu7405HciJ43qoxjuuM8LTHhmjlg4NVb8oV77cfbf_lgIMYR6cKHeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IEXhxprWUaHN-smuwbLNeYl8QhQ6XiTjMQyIu6cjHMw&oe=69DF72CC"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2621377568007083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974557_3681210411945497_6364834566122363153_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSTO4d4xhZgQ7kNvwHo1EnP&_nc_oc=Adqy0LjUFpQOKYZVO_UGEZQ-kMiq0HgnQoLHYp4VBheBRwtbiUYhzaugfoRYd3VFaa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EfxjhS373FnrXZhH2Wh7BzPphOjwPzGbLb1ji92vHRw&oe=69DF9BCC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SENTIO VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1615562541, "lastRevision": {"nodes": [{"id": "1616280075427269", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3823372177726598", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1887625498156187"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "2560.png", "id": "3877776608948381", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974442_3877776612281714_5379011091208338985_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJK-zTa45MEQ7kNvwFUDuBE&_nc_oc=Adr1fuIWEJzHqzwEXDUfttlBdWvMWa6kNZcr20grH1tdG6U0bj1P83H5BMtAt-kg7UA&_nc_zt=3&_nc_ht=scontent-ord5-1
wGydRCLKmL8G1x5dFOEE9iuwmTMvVKTSnpQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGmk424fnAQd9TDU4l53p052IIyMRE_eW96dLYYFifDQ&oe=6A9426DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFrtnv5HDuIQ7kNvwES9sJi&_nc_oc=Adq_ZeqQSVNA0Gpczr-zmkAohCszbdZGldbVaSYo77vVrAaJVcldVbXdiLrDFtrjyBs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERCDPsvyF6tS97uCC7TLvC-WZhmmuD0M469UAnIMQ6Sw&oe=6A942CCC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnHyCBBthxAQ7kNvwHEylUK&_nc_oc=AdqbWy1GHK14Jz7XQYnWwbz8vz4CRdf2Q-tPrD5yReYJ7fQwhWKXzm8f4PyjGPT5HPQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2GY7hORlUApr87qr1FC6WiqPsk5cBtHBrNnskd6iLdQ&oe=6A942E4F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khKj11O1MaQQ7kNvwGgvwg7&_nc_oc=AdoW20xPxFzwUb3s9lUSOHbEjQK9hPiSVevZWEMiixCaZJK1zSBHWyRs1AXMzYSzcfk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGbq7P7aqOsN1DJns_1ho5ZaPJA_6hsOHgbj1h7YO0fg&oe=6A941618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKjt5wBD5IQQ7kNvwFyRkpS&_nc_oc=AdqWsURSYwVEsewMbCqauKn7rImZe8agPtgCnp3yLEwXOmm38hC9mCSln_1DyUHMCjw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG2S3FXExMT19cgcF2vt1cwhHHsd9WqweZd63_jSoI1g&oe=6A94104C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
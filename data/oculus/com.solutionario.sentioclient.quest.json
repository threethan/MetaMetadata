wgyI2QXg0vFjsv8Z4Qw356GwidlHGzUkh7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXXKcXpuatzxfzwLh5a0gvS1cKzig8BK2FfmNzASSIqw&oe=6AB51C5E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImArDOaD4CUQ7kNvwEWs6GP&_nc_oc=AdqbDmOLRVFDQZWMbo24rN0vBdRAEYfkiDaJVnGPlatx8oTqXj75F6-YAiHGFDRTDGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQqdqOTEghiyXfCII0A9OxNuSATvhE7TNmQERMd89zpQ&oe=6AB5224C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tnI1CEP89kQ7kNvwHmeRST&_nc_oc=AdoAq3D_jCuHcpASzu9HJ_u9GzbK85CXqBq6cmHhoX5BhET_ptmccGiYTvGVpvh1k2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqgZwiMnNXVDgxP8XnD0tQ01Va9o4iCcBISr9aBXepuA&oe=6AB523CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkdnrs_4ZMgQ7kNvwFfR6a6&_nc_oc=AdpRXkZYsvSuubEABALXUp4P3yHkXsQP62UJgadMqF92O8TWF9gEw20u7MtIozHFczI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLooB1xrVbbgYHH6ekzCAcoZ0_vacgDxyoG7V1JQtfb6g&oe=6AB543D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_U70HT3tXMQ7kNvwHICMIg&_nc_oc=AdrbPJ7nrV_h0W7hixwfIiCOFXykWf0UAhX5Yvw28NS8go0pWrfCyjbO_ejjQt1t1wk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtA84jDeMIlEKV9HMNgq7KqxqozNy4Kz4pDQpK_Z4NIQ&oe=6AB53E0C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
pe3q4DU1OSQSno1YKu-tvLFUYy0EUA&oe=69A6D8DE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_F4XsQQB6cQ7kNvwEFqwOH&_nc_oc=AdkgrSkNoIDpY-XVsKMcLtp_OUQr2ueRhFpZ1QOT-VORudyigQvmVRXzYjIRrXXoe94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvILne0c8oaO7mwUAUdk9TiKRfClOfYjt4cd8K-GupXrg&oe=69A6DECC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpk0b-t5N2gQ7kNvwF76GDb&_nc_oc=AdlxEnSIWhHM-_7Tf10hPHETN1R13ZlpAkNwc3He6csqGTT-PxdNqiylV03QaIsXCos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1HRwrCBP1gjrnOwv52bDAcjLSMegZENws5GQ7xMrgqw&oe=69A6E04F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20zWZhwRg8cQ7kNvwG1rjNf&_nc_oc=AdmHP6QMZpHMjE9OrqEVjpLpNxV_g88pSX_kiRV9gsdkncjk08Y2icqL_Fg4nTLX_x0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsjM_XfXLztG80S0eUHpSfKl9zyChz7QxDYvqYmR8fsMg&oe=69A6C818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ehuYeUxBQ0Q7kNvwFstVBg&_nc_oc=AdkTUozCOs-i3aluGPolSC_C3cUgNuOUicKtBZLz1wRmEHImJmKbIJ26g8rUQnGH4CY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujGAwjwprSBmGiuhiDlPXllgspbp_MXKAoCbKLE7uqDQ&oe=69A6C24C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
G1azrlqmXeNsb7JpBzMXUaDJS1SS_tEcOuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K2QK96CEeKCXtqgSVAppKh3pyK5H_lo_woTyB-e-BaA&oe=6A43BB5E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EoGfZKtraIQ7kNvwFxzMW8&_nc_oc=Adp5xo0-XyCKG-YnC4pVetobbsKUZ8-h2BiQMLFRngx5HOAVw1Oi0YC7paMvUJ7zImU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_spXkvkmV4D7dNbfzmxM3779VwkcaFM6MBTQNWr9bJ6A&oe=6A43C14C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgSUuASfmaoQ7kNvwE8WQoH&_nc_oc=Adq1e6YYVUpXjeRM44GTpz0ePV4_qpkWAvB0dn46-fTMbTXR3eDj3q9MyPQiZJsDbP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tRIhRv8v_l_kKjcBv_Zlo8TxiCEO1mjHnKxeQz7Tf0w&oe=6A43C2CF"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl8j8PEpNQwQ7kNvwFxavXH&_nc_oc=AdrhvyuF_S92Vir6Www_EZ2MlwFGucX-XSpI0w1AUmdkpOP6tXJUAIEoYnPH07y1l0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j2Jn3sdj6gM_hPeZOVyk6bj703a93zlUkYs_nOOnriQ&oe=6A43E2D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVUIvKRiPugQ7kNvwH_f_-v&_nc_oc=AdpUQHWIOzYRi-2YJ58wMKsY7tibIZIVSyESlHCOIGwtzMq2O9N2-Bppi5QQcD8nEcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-89CP7jK0uOWg0dTfZ2_vA1UU6UbIaZGimEM5cQmaZTA&oe=6A43DD0C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
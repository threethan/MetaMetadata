LuLKnuaLYkY07qVhMFlgfwNA9BGG9X5K2rQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJirPAW-weq4F9Z9Esw3OWkYkWrbxxQhtKlJfkBQOEdQ&oe=6A71DFDE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5kJmbDNSNMQ7kNvwEJZ1ev&_nc_oc=Adpy7RiZm7UnrSKjD9nwp1A0T5raxT8wPWdA9BtURe9UcTNq0xOp2Ze8ez8EL2V__T0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_usGe5QyO7pknR_L9uj6BD26QcvGVBL9TqS-kVnlslw&oe=6A71E5CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN9PLtRRQOkQ7kNvwEWCuIx&_nc_oc=Adpv7lxec1Mfqpk9J9n4vMMun73XAyw9OCpX8hbk7fLf-YpK-mCyfAE1CR0ZYk8DvIw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_Tm9-JAkxAtn2oCSFybr-urx7B51fjUeg0wlTDCqo2w&oe=6A71E74F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7rz4VUGOs8Q7kNvwH58va0&_nc_oc=AdqO-YzzKUSAXfMQMCUNcTk3wXIuTtS09k3hjHb5N4YgCtWNTM2Exp2gwd-EKv25wSo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpBMEMbNK-Siiwtzk_wwEW4lcwQsaj1cgz-BAN7Y0ztQ&oe=6A720758"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIXnrFNpw64Q7kNvwHIoz9m&_nc_oc=AdpwdN3G6_DacH_AMGnA_IWEearRC-58eSlYFYysOEwFrVsW55aICZkjBA3IlcJOO_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp_dZ5G-2k4wtbvs28lkE3CavAGG-_tPhjw9QS1XH08g&oe=6A72018C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
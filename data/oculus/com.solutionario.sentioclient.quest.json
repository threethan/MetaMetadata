cB7_XbXl9TLqzGbQJ0z08s7uGL128hRiZsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJDd6T0lhDlyiTamcZDOMhMQZTaCUiapUtGKANwt5xBQ&oe=6AC6781E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VGcm-ngTsIQ7kNvwES1Art&_nc_oc=AdotS8x9gGZPtahCeW1u9qwMkD_4UDNaYKZ7mF4bRg-cGn9mgdH_pCAyu6S6Nml9rpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyDcNrgu-yHjcfAZgsI53OmB9YidhYmzDgvxSutyHOIw&oe=6AC645CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtAXI5oZnZIQ7kNvwFmG6JI&_nc_oc=AdqSt43ImN5fKvvqUSXwKFJBJTOouzLUb4fCGMCdJam-A0Ev4BxQpaUmpIKmXM5_BIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWgA1xmh-ktUHN8V4FURA9W-LHjXTLd0Vt1M6M_jUe3Q&oe=6AC6474F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b4rBAvi2REQ7kNvwE8irjl&_nc_oc=Adrf90nTV0yJCL2ssFESDBT2nq3-8oVlzkt-KAKJuc0nTbDSNMhGv9G2jz0OR5s0jME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2TOt2MAmYteoRIqNL6TN5wLEC3B4YB8yf6-s20zup3Q&oe=6AC66758"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVgooLIMX0oQ7kNvwH8Uati&_nc_oc=AdrKjyvL9pTc8BzCRoWNnaxN0U9XPA2ueZnoJ89GpsHCroKMjmeKLKyZJ24MOOu654M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdK3h3nBod4YmjfT0v2c1fddycKNZN_DrKD5ia81rK-A&oe=6AC6618C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
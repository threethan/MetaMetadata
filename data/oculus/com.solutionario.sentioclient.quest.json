ttps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210884_429777491607169_8716825292085708675_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHpYmy87uB0Q7kNvwHQjop6&_nc_oc=AdqwOqGC6kPLRywY-n4ym_MJQIGgv7ALyNinANSO9oRk1cT5fFZUALkUnnFkdDxYBjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNN0Fpb__mK4IvqHt6Kqfls7CFrn1SomIMlBKxSq7g7w&oe=6B046E9E"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE4hSy6gGdQQ7kNvwEgjUGM&_nc_oc=Adra1fKi0HjmrNootPdCfYmOMiG7N-xpD1bVRNW2UWbg1i3GnZZ6bXrd_1a93Y1D2G0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3fneDDA5oBOiJ6j44Oi0UrYBqIv4Xu9g48xDRjnLiaQ&oe=6B04748C"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPQf_tF8dsQQ7kNvwEI2lue&_nc_oc=AdrZFK2S1QwUaZifb1MsSu8zvQYmiAMsd4lfvgTfqBUHVJNqIxxNl2hOSFEL8XGZgwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUHXgLmAUpfXu87_LmivQtQNvVDWji7i3hZbYQDNl4LA&oe=6B04760F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ll5X7H09-oQ7kNvwHhKAYU&_nc_oc=AdqO5ArFAejLw6Dxf2UcjGJ-7V-waYyYSMuuKfIiVE58Wo3DqT5Z5La140Ap7F4gb_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzv7zW5-G0v3dTmFoJMs5_W-F8soNP8ErL7-HEwJur2w&oe=6B045DD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Ry_OpvDtIQ7kNvwFrZcrI&_nc_oc=Ado0u9ziP7-WzXSOufDBACVftGvcQPKnIyG2ztjmslFNyOvp6AwLzZAFZ7IIHjQQnwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQv2dFkh8-OW9h0XLcA4ag9zzAovTXPCr0pVC9jKcnEQ&oe=6B04580C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "A
ikk8xNwYO7G65U_skHea1xANLn5hm-CcG54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dpH9kxaO_Nm1Gt5HMfk6i9M4RP4I91FnwC2WfD3rmOg&oe=6A0B0ADE"}, {"file_name": "2.png", "id": "425967098635508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458089_425967101968841_7573424558178569741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGPm0NQZpJcQ7kNvwGaAVrB&_nc_oc=AdquLeK7yngXV0tL62-3HOSPgG-gfJrJSoTKRT0AKoPOYsiNxHc6odTXUHsrG2uVuZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50L6J5LrvPVX2o6pE5LrAlYM8dwH4va7pTvQ4ZB4tXqw&oe=6A0B10CC"}, {"file_name": "4.png", "id": "222765492631957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031465_222765495965290_212792495828102734_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkBNMOGJHWQQ7kNvwHK182n&_nc_oc=Adq9Sla3x41It7zjysH1g89UOCI7JA0jvFgc-06QmjBKlzkBQtJwFuAP-Iob4hE1Fck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46nw4WcyZ5SHAZLpn_vjkhC5dOhWWzbMLe2dAkjpBijw&oe=6A0B124F"}, {"file_name": "3.png", "id": "169433328311430", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982653_169433331644763_6500055822036622297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JugUtqF_ohIQ7kNvwHY9nlD&_nc_oc=AdrQu5x7ZcKKc_k0zFMRJcYwrOic3vEhm4jtdgr-UBso_fYiRDHVeAFr1UseWYofEXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UYywp1vMQRS97F3B3LhFhEE_7yrm1XOfPtbmumJnQMw&oe=6A0B3258"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "117521453594753", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974535_117521456928086_99350484779883293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p2LsD6P1tAQ7kNvwEA8tsZ&_nc_oc=Ado1XnWR8HkeVeftswHQ4ahnSQI6IfBLRuiY3Tcst9PaKDCgHkwLt08SrXuGdA3NjZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mto6Fm937cdA1oluFkW9FOGPJgg4HaJePrNE15YYFGw&oe=6A0B2C8C"}, "display_name": "SENTIO VR", "keywords": [], "long_description": "SENTIO VR is the preferred 3D visualization platform for professionals working in the Architecture, Engineering & Construction Industry in 100+ countries. How does a project that has not yet been built look like? Instead of reviewing 2D floorplans, renders & video walkthroughs - SENTIO VR customers put on an Oculus Quest headset for real-time feedback with clients, improved designs & win new projects.\n\nHere are the key features that make SENTIO VR stand out:\n\n1) Plugins for SketchUp & Autodesk Revit\n- No downloads or upload of files needed. Works with your existing design tools\n\n2) No additional downloads\n- No additional PC software is required to manage the model upload process. \n\n3) Intuitive VR meetings\n- Multi-user collaboration meetings have never been easier using access codes & passwords\n\nHave questions? Reach out to us at hello@sentiovr.com", "short_description": "Want to view a construction project before it's built? With SENTIO VR, multiple stakeholders in a project can meet virtually, voice-chat & collaborate over a 3D model enabling better decisions.\n\nSupports SketchUp, Revit & 360 panoramas.\n\nNeed some inspiration? Explore a unique collection of 360 experiences of architectural spaces curated by ArchDaily & our content team.\n\nNote: \n-Permission for Microphone is needed for VR meetings\n-Permission for Device files is needed for downloading 3D models"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SENTIO VR", "support_website_url": null, "website_url": "https://sentiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQU
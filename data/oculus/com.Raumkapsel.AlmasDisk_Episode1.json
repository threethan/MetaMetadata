 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OcGbTG4dUcQ7kNvwG4w4dK&_nc_oc=AdrWUUpPuibuJL6IZXKnxJ7EvpVU6Ey9cB37FjqCCqUtPXc-JNNDnasqA1Uwi1vnGlk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKsrwLgJ-t-677dbxPWdAhCB5Zg4-4G6zM82rDk2D8og&oe=6AE8C072"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEwLoXirAPkQ7kNvwGRsqgx&_nc_oc=Adq36JBHRY21jewJa3n-PptyPjZUzfs1wXhJyrUece1lI1ZuKT2mW8MYVxpc_KOz1Mo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrmlRNS7PTd5N1XNzH88VfzP4BNXldNGzlBra4jKgwsw&oe=6AE88D12"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIA4w4s97NEQ7kNvwE7BULP&_nc_oc=AdoTZzqn8rorAmfdTXZIvWE3Rs2q7SoEMQI__AG1vUIBxh6Qy6pdZRy2pKHnvRvWuFE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuu9g914ML7RNk-TJs58pK5-ABsRZuQVZBxHem97PHcw&oe=6AE8978D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGH7NvZfY2QQ7kNvwG6I19H&_nc_oc=AdoxN6G5KSf5GYS40ogi0Qre6JFj6S0EEdPhFrhMYH9_XTk4YsJJRhRnVHZQNlT_RsE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1fGqJkdiC2RbUloFD_t36ihMV6tWqfmg-P8ovnCfpfw&oe=6AE8AAC0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgovDFcDwwAQ7kNvwE2nAlf&_nc_oc=AdqoK18eRLvxvWZlHCeoElPIgvP0fu40q5SSzAKirsYOsRth_Jm0fH8w-wafq-HSzKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT21DPn6-fpcyHOwyLqhUhWc5qmj_DA9fKfrK3iOmAQTQ&oe=6AE8B408"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X46q8NXWbGsQ7kNvwGXQ2jL&_nc_oc=AdqcZjP_LbF0eSpzTv1inRXmV2LIsmBBtvZXdjizuO06lVTpqKAZFjxuWJ_3PgtQSAk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG_3Gtaz3NZMz0dTIm82VM_MVaof5UxYnjM49DH2x-FQ&oe=6AE89663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_A1PdvG-MMQ7kNvwF9qzY7&_nc_oc=AdqysKbGQNRuoOlhKfgtEvxVQbvRid6Wnutjn-py6BmY3I4EEKdrjloa4WMZ40iMitM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy2X63sovNoGmwYUGYT41YjwVJrC0i-Y9_umducco-2Q&oe=6AE8C23A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
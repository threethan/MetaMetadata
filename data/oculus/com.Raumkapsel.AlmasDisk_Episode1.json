 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTFEswIJJogQ7kNvwFGGiuD&_nc_oc=AdpbgUpgBBpsSoUf30nvWjexv5vzb6FTjVVGyONI47rGy8WyOaPOFf9pznnjGXIhFsg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i8u7wn5vYn9ZTTx-4k3Ul8IP31EdbNZ1e1qixm2jMMg&oe=69E62232"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-mWJ7Hv-BgQ7kNvwGQsBbY&_nc_oc=Adqp0fS5Wu2b7y93g_Z35H-b_SSTPLU0hFmEJrFYVLUqCSqO9buvNwfPcnb5aXXBNV0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-j--nSrnWs7u4ZR8NUrPYZR-PBf2_eeNkb0BpV8d5mA&oe=69E62712"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPWWlAE0BzsQ7kNvwFcxtm4&_nc_oc=AdrBKzDAyawfCLTzFzdZQ82cQneB0G6Pyjn2DDTxUorqjbeKPzTqpZoHelbTxEH60yI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jGcSx6yOmQCCTTk7Y5d8kPMTHuThF-ZtRXwykRNimcA&oe=69E6318D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga52qGErvyMQ7kNvwFsSktz&_nc_oc=AdpymHBPK_JWfEKt7YcRm92K7bbh3nwZENM5VuaSHz7hvBbvu-FDiK4mwvXSYZsYuE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b8HtR1y6Suq6_I9rG4xJYdmi1Q_K7WvrhVlcBibugGw&oe=69E644C0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YW_I-pS_DOMQ7kNvwGWMqm3&_nc_oc=AdpX0fG41X4pbv8agcSuefolGUWWyngRsXgYVARfV58xtHrTJayZTTSPumHHr4xRNak&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JsGi6QQOwManW7GXdqTgRupkPQMeurpvH-6l5x-c5ww&oe=69E615C8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QglVFQMLMx4Q7kNvwEVDrsu&_nc_oc=AdrKxc80K_UYp2roN56t9gpyxHD4_50FDQhJbfiKwDz4Wac9DNXY8r8u55-JuJ7WCV0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DLeso61c-SRwTALo_LL-XXt4n-7AoLAj6TmrTaVs7xQ&oe=69E63063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZNEaERI9icQ7kNvwE1j6i3&_nc_oc=Ado7vu2qTItrj_aM1jVnCbYE68wYSszLegBC9EH7lXzatNJVnLaVWR6BwRUe24S0THI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gQkoG7Q8KUJGy9C36NaREQvxRFVH7LnCFw0aa9fxwWQ&oe=69E623FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
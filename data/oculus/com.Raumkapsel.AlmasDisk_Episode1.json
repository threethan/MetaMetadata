 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8qw0RkbvAcQ7kNvwEKlygC&_nc_oc=AdqaxJYbsJhL3WHlU40XAfxKdyNsKC0nhbpgkZvkyfy9XKUhHRQ46LYo_AhXxFnQGAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbQ_RHRPhS7aFZEFWpK3013vCchZunAP9m0rb6V8I0DA&oe=6AEF57F2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5xZoZ5FnogQ7kNvwHWojJO&_nc_oc=AdqjT6V3w4f-BHq7OoTyT35woUNjPXHoL8oGMZQ6wgp5gkBSJUrdP_8wbBhCenSGXdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0sBt470maa9Vz89KMJXjZg0Y7BOOuc1KuOi3H2WguOg&oe=6AEF5CD2"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycpTQcjG_ioQ7kNvwFKMTCB&_nc_oc=AdqK7XCeWD7PN7Minz5ZYaTDMz2LU9R5h0-y6Nbay46sZgPDthy8l-Hie8e2Do7obn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKVoZ0muPEiFqOnm6b6ZVjFRNEyk63TFsxNFbEBWsLyQ&oe=6AEF674D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj9EnpQLJh8Q7kNvwF2g2WE&_nc_oc=Ado4frZkE7H8bFYMIEx3bv6pYPgBF4iFMPutV7Is58RQUsXVQfa1denC-7UTF4YvZTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7nYtTdNGiakdFG5PGdEXUWQ6bYFKEMb8PTko2PJV4LA&oe=6AEF4240"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaxLE9JMnOsQ7kNvwEZLpZK&_nc_oc=AdqmjxSmoH7eJm4ogAfZnY4vQucdyyg3uJLnMh0xddHvdGhFwmb-CAHoC9z7JC04qNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa5iEPzpsouS67q6G8IDhj3e13PEhGTTk9Xaq2kGuU4A&oe=6AEF4B88"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83hXTynYzO0Q7kNvwGtmYoU&_nc_oc=AdovIRvKr_ei_g6UtrWom2VvHEWAL8VEEb32jFlATS_Q9P_igtVo8rBhuetIYblDmlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6CBiWeT7RBDniw81RA0ONnzJ4cirq_Qlts9F4TNw_Pg&oe=6AEF6623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze5flCuiUokQ7kNvwGmo4b1&_nc_oc=AdoBkHLgAY9XspvCW7ZlAJwCcB35rSlbhkl2OSTi22GlqA8NXqmvY2T6wc2Tlkq_JUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMdxPuvWVOTn8d31juoIltCU0mWG-ODY8sWiDjTPPeoA&oe=6AEF59BA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
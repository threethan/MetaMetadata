 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zxbAFGfoGkQ7kNvwEPAYuU&_nc_oc=AdqXCX1VP_lT4nGRp743PDHs8GYfGFekz2P_bPQA0n7aQjAuPaNANEGiW32IstxBOaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtnv2Z_vd9fxT4W0-4VeSjOeEOWbnXUa96WjxcZkw8jg&oe=6A675532"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf05H7DdDI0Q7kNvwHqUOde&_nc_oc=AdrzpvrzOC2c6rAUOwsSJHnWR1NEZuYqPwOCjEhUnuaIT5zxD4DltJTj_qtDbdV2euM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8OirEq-2nzpNECCCVGpP81uI3BkRVCrJ_pmRn3qDrtA&oe=6A675A12"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVTKA6zbkykQ7kNvwH6ihaA&_nc_oc=AdqLM0HEIJr4X1OmkyncKAHFzEiVC5uXqVlxngZFWdICZwt0ZoSq3aJWL9ZjyZMi-NA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9TUIOgeQoZpPSg3fu58UgruzTA9uuiN7efg7QjSt8ew&oe=6A67648D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv6_dLT1RPIQ7kNvwEFRFBW&_nc_oc=Adq3RjApKR9cJtw0vmLRN7XyyjrWdn4vFWp_eEPaoEMk0hmaZ6h9fqW0hlpnoMAElh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn0NYQHIb5T5DIxF9BW6T87w963GzDVt0fhQ2gLkecpQ&oe=6A6777C0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbXkNDSYVMsQ7kNvwEZ4HOW&_nc_oc=Adq4wO7L1oPhAFr_kIZnGEG259iE2X8o88diDMAdm0rPMQiF7dLLpiIpP4o83KOsOB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDUmrDo9JX723pl0BQQ_WE6COYK3RAEMIb3cX6B-oUcg&oe=6A6748C8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrYa6yn-yjEQ7kNvwHqIclZ&_nc_oc=Ado_zfaivdksOXB2eF_kpqnjLSm7epBi28VXLb0BgcikOurL0BoopUceXtNKN5j7x-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnsh9iXbIsOzhiupt3-J0U52tF3WlfXOWFyUbderuHzQ&oe=6A676363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmAe3DSAu-sQ7kNvwHNyAiM&_nc_oc=Ado17crpdLP5L4N8F5g8kRIyW9S8_CY758J2lmMe3x0q8weHQpafx7n2gcTWyc-hFP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1uGPf43vS0O7WpbI_8ogDeLoAqyK_DNaNqnkFLJJFEw&oe=6A6756FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
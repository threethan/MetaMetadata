 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8AehSQGiNAQ7kNvwEWs2x1&_nc_oc=AdrjA-F4qL0VLvGUdf-DOmuAzdpMwkMR0SIfQBlWpeBq1PjdfsHr-9rzAct1noYaoYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-kFAGI5Z_5xsuiGOTCxFpO5aO5o1tlE6fYIkzL1TjIw&oe=6AB7C0B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VS7h4gi7XE0Q7kNvwGcdOQz&_nc_oc=AdqY_z7koGTLoqCKp9E7G1GA9Ic3jnhjIpO4lfNJqTgyyWTJoh8p0zlYMVABDlRamNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL5FjwXzOAmm7uonC1Jj_hjQfkh4aHo-0pGepRnKKg-A&oe=6AB7C592"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lU35AW4OIl4Q7kNvwF7sJmU&_nc_oc=AdoQ88ily9k6RHgnTW4eYE1YAPdm2X6u_nW3QntHtE9ozhd3C36wgLfDESmviEreAgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqTEs922begnklSASasy7Irn7KBV4mpHb4iMVfYBcyTQ&oe=6AB7D00D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om7Dkwe4WygQ7kNvwEy2njM&_nc_oc=AdrXx5wy73VhFGQeLUl9P-n_nnB_cyjoQZLyJ3GPRl3_Tfzdq9BYf550FDVOI_jZnuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmUDNiptq1kHKbEmJaOSOOjrdtZrkK9zM4QHeACDflXA&oe=6AB7E340"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhT7D5k6zyEQ7kNvwHUd286&_nc_oc=AdrWnmvLEgHEjd1jlvyHkTZ8RvvBbJhJo894dSK4RTpO3mak3T02jvNpIYjEUKRh3xg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTuO7Y8fIcGZMce3dQT92bgjx6DN_-uWo51z5rE8h6rQ&oe=6AB7EC88"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ze0nARMm30Q7kNvwF3zFnq&_nc_oc=Adoam-zLYUcfw_EeVL0l-7BUyBaN-HL2Mo5SffHfbIMzH_CwL2cjRa4_mpe7CTfk8XM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrybgXX_a2bzgppLx6YJj1ktQ-E6w6Yof4L65Omjyi3w&oe=6AB7CEE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vzXh4Ix16oQ7kNvwELq28f&_nc_oc=Adq7ZG_9qaFkqd1yxdsfFuHp2ILesdZ2jGBs0sUojBeU74tCSgN0qdJjx34u_0-jm3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUNYKv8jG9Quj4Bk-EPSn2e_W7U3wh7jJY0A3YA1ggew&oe=6AB7C27A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
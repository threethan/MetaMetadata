 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyB5sE6CMkYQ7kNvwEMRcGC&_nc_oc=AdqkoftwjHIV5mZCoumZtx2uD8-2Wr0e3N4QmCe7v-bi8l11kCJdyvxxGp5hpJxDORo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U1-_7tjaKfyqm6BTIn3DqZs1YHKUMNrKIT4JkoTDdMQ&oe=69FF2EB2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8dCDRu5vjgQ7kNvwEQyEqL&_nc_oc=Ado5z7FiDomuIkTNRGs3gnMXE6Og9PQ2Ue1eRuGoU1WHtkFR_hct8VFpIkNw6jv9VWI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oWDlXL8OPZKz52WPxZyMu-g0y-gkVoL_RY5xNh1cn4A&oe=69FF3392"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh60_BTjmwQQ7kNvwFv_C3M&_nc_oc=AdoLLb_Y-NBNyJn6ieHmJjnebMBzeI8e81yE8rWGgnWNUT6O80znpsgvyY5QFGC6MSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QUCuYRyyXVtMpT-fOr7kLQnJz6HGxcQNVbZLR3gWABg&oe=69FF3E0D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1soqBi1qOUQ7kNvwGUgbwF&_nc_oc=Ado0Q744Glce0EK7T6asEdkMRPEgtE4GEPfMU83pwwKAf7btLDdpHqjD6UtdM_wq1y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48xZLfRMFdhHuIDk8Y_zLhFz7_cIImoeT91nOfOgWfxQ&oe=69FF5140"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIzxfUmd3nsQ7kNvwGMvM4l&_nc_oc=Adqfbz3P9Kz1FeobpxiwmDfPSwEqsKbsyxpwAmAuS-Omd19Wb9WtW4P2mZoaXvCs0cw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5clkJEI2yTl1Nz29EneJj04FhIdTr7akc3SXDnamNzgQ&oe=69FF2248"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT3Q1ogF06oQ7kNvwF7DHf3&_nc_oc=AdruoajeWS8CV-wQC93yFOBCzmetPaH8fbqOidhhotYpjRmr80r0AiZw-XXxz0WV--A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nWx9aQ3kQ2FN2z4Vg2hjN37r8UzsOio4cVrZgMAWL1w&oe=69FF3CE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jOsQ2Gf7sgQ7kNvwHEampY&_nc_oc=Adot5mxFfiEgOtO-C1aTjJGFyGwHuGqAn-z7oVKN3NHBxFbznRwrSveSsMlq0Vlf3Qc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44E59wFL19-WUHA89lQo1rbzMBd_t4p6NudC7RN78ypA&oe=69FF307A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
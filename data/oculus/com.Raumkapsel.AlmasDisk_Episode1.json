 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMWwNXMgLCkQ7kNvwHXpte4&_nc_oc=Adq5Pn9orXi9UQEfGcjJS17Nrd9FQrgNZYtLopt1UFwGgk6EjtPJbl0zLHEw6NPjEI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC__xhWgAyyjCI4jHqLxeHmNSDKrNe2mfECTnbwC_qXaw&oe=6A5B77B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svI1Oe8VllMQ7kNvwGEIQXI&_nc_oc=AdrLocJ2J7SxPlA9UVenAV7TzgdyiwhbqyNpp0JVOVP0oSZK1FnvDG5qmFeqku_uh5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQpw5xlP3iZR6knWikpAhGsl2bpKVmyQp-iaX6TCLEMA&oe=6A5B7C92"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BntA9112YpUQ7kNvwE-AznC&_nc_oc=Adp8snU5S85u5gwH6plVE0SIwshZAdkQ-5z7knw694JAPIOf7cozP_mNvlih1no4Myw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTtKb5uwJ85M9bocrlVjY-c3YEPp13ycOA8PZV0wa_dg&oe=6A5B870D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYMgA9nf02MQ7kNvwEeRUyT&_nc_oc=AdqXDPopqZRkoDgkWA_wVPIrGCnMAUpN9Seho0Xdlw8NxgTzx14n8EQ9356biqXoh7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt-cIq61vp9gfngt_h74mhcjXMr7mUBv4y-SGLQBG31g&oe=6A5B6200"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uB_LG3U95koQ7kNvwFLZRaa&_nc_oc=Adq4nhh_i5p3pv8Q9Hl1DVpQHW4xgACzp-MTXqwSQ9hKJOb3rgYgHNS-6L6Q68s_C7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBvsDUAVZwe2ymrL0eyxaq6Y8AokuTaPpK1bxsOX3k7g&oe=6A5B6B48"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdVFfqPwbzQQ7kNvwGqbFya&_nc_oc=Adr25o6qjrO2YyTO6mtTAUN32tLwDzOY4FU-kjjU3k3HuT2oLufOvPoZUl6HikWSUHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtk4S77sjtUK10jJ6E25tZlVNB9ofGxE8cNtYg-ymoaQ&oe=6A5B85E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhrs8g9OyNwQ7kNvwGlYEph&_nc_oc=AdqjQaJQmNrSd5tpYS-L_nQ8rRoMuM6QSQnkuZ2_uAO6GKk9UdotJEFrrk83z6pny_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsFONIbNdMpmbkctB8sG1xJOqoIVGhZaB92xac_dtwxA&oe=6A5B797A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
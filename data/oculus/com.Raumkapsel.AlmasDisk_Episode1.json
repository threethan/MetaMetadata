 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVez4EAVSNQQ7kNvwEyCpCt&_nc_oc=AdqXw5S_XnTuUaWFT59jxb19THCdZwZuGTVauwra9I4qabWU91eq_w1gLvlaVymHifY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr66a7VOjrvYJ9hBaJNn-da5A6zY1UkdrdYlpWq_hbwQ&oe=6A58D4B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svI1Oe8VllMQ7kNvwFIA_Uq&_nc_oc=AdoVwFKxpfdmvNv83mocEAQlriF8Clw4P46OvZGDY4i-JnSjEIYhZMZSDDNSNiroXUU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZMcx9anbtzfZ6NFs29Yd3Ba1HtcSd-Isx-zZ1P4qE1Q&oe=6A58D992"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzjzX61gdCoQ7kNvwEShCTx&_nc_oc=AdqwJPXN9xa8ujRKpykLevIP5OTuaE9AIwTBi8FmHDPAADTBqETS4HXVP9w8KjYHLVk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_xMWMoEXsFUvJ1n0B3KP57chvv3ydMtePJwhONLLnsA&oe=6A58E40D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPuzY6CRL6oQ7kNvwGoDJbw&_nc_oc=Ado49ltB3ol9IFd3kPEaY7fPfdecejpP9KA_0wpP_ruh-xMQIZpy3xE5r6HV1gFvyqQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBViphMZhkVXnxGps6ov4XgwfDo8qbKu7PVfBfXSIdRKw&oe=6A58F740"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uB_LG3U95koQ7kNvwEh-YOU&_nc_oc=AdrkAJrqX-wvC5Nv92irz_WhWnZrJbdF2j8wbyxVNFqyfJK6MGnGCTj8NKpwl9tmM5Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo3rXpAJ34eZ7FGhopFJEGqhYfYfsBD6naBpDlHJ5Kdg&oe=6A58C848"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdVFfqPwbzQQ7kNvwEn78mP&_nc_oc=AdrWwroz9HyQ4HKlZ61T2lMHycBHow7B1yuyitqG4-ehpwOk69al6K_9z-3xfs-5LqA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwfE301FvCxiy9KOYOzINeAW92BuNKTlaNrOomIY6C5g&oe=6A58E2E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW4kiC4PPqoQ7kNvwGap63M&_nc_oc=Adq5uz5uTIY8Z3TcGAx7S0WVqsHneALwFaBzsoocj6N7GBiwNCyKk6bcMJHUtYJkjso&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv0ZuzB0e9FY0DUOWxuqZL6fOvh86Z8lXmTTOW72ugNg&oe=6A58D67A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
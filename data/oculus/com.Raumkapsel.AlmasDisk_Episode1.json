 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaEVOa_3GL0Q7kNvwFrkUdR&_nc_oc=Adq9W91lzCkqEVR6Hyp7655H-LBk8XNFoECSM8yYC6kcnsiQOURA8AydcbwuAq9czXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUxqPAnr1OWWJZcw8-IQ99CprfoLu28-BwNYmi35SlKg&oe=6AE493B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EYcW7UU8VsQ7kNvwH6J12B&_nc_oc=AdrGWZBIr-oMyrKQ0D6DOmtaS3ah7v0-OaNVy4_SxZytHKmZK-TyLJA_BBfHR0V_f9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2lNV090PemDsZt4OdjJLN0rWwXU1GHPc234Tk9dhiZw&oe=6AE49892"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIgp8pbS0RgQ7kNvwG_GhI3&_nc_oc=AdrrPEYBnSX9NyS2luk3Uyq4pcYh32eYAaIawGayPU7Y5YPmOdo_KZ7-Djb2yYQIiTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSF35M6HV3BZoMFY_xLB1au6ccRGiE72XANjEE1HRlKA&oe=6AE4A30D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubxqiDZBf-cQ7kNvwFcO2y7&_nc_oc=Adq4jJq3zgN4mXRsstQCzc7aHrK1CpIQ3cAXEG685yOZCaPrhv2yHL3FVe4wk1Ki110&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGKpsF9sHc11TVC8lfE2M8c5wyk_926fF_0Ml1UsKdbA&oe=6AE4B640"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GZcorLIm-oQ7kNvwHwGFfz&_nc_oc=Adqo15qQJNy72IDvRkPXO55FpAVZRVjKnQ7BF03oh2Tuka8jT7Wa6yo70Oy5i56KL7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcW6WDU5ZidP23RkaD8bkFikZDejpTaibtqPVxV5MCvw&oe=6AE4BF88"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Euc_N1i-cLkQ7kNvwGIQizU&_nc_oc=AdqASTwarHtIdm6DUcJZ_erG4HGIp2IyTUVs05qSqtlO7SeV8892-m1CF31rrCiVq_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMYdAG9Lalrw0fdA8bmpjqPifo8zVQwKGNsnQWUANu2g&oe=6AE4A1E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89DtBPEAbzIQ7kNvwGsYWVI&_nc_oc=AdpD3i17MS_tTKmTJBBPOswk6oDZgadryz9mBuDA49pjY-oeT0h5LnWU3GRBx5uoln0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCb-ygZ7otloUHR6KgWLVysceaZ-oVZTlBkGGnwa4GXg&oe=6AE4957A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unt2cUyZuswQ7kNvwFopyYD&_nc_oc=AdrBY8wircauwvx24ankPcD_X693Z5FuSFXt4nlAM-AHXth8J4yYoxs2gVnBCbiKrmw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QbmnpQVF9GoJvD4GpBMycFfw6Ns1S6zWcMD8oZc-Ghg&oe=69F5F432"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meuKJn48jcEQ7kNvwHgbOty&_nc_oc=AdrVlB-WJ6m_jX4tCKWo-2f1XpWoiMWNVeu3vBKntNmzsF7hq4rYoxOlXYsHV638gZo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yZ6dcwL0FCs8_mO1xgwxlPG4GCLfDPiQnM_JZ4DsnbQ&oe=69F5F912"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqYMmBPb3vcQ7kNvwE9YxSa&_nc_oc=AdoGs4UtZGQarG3msFoX3mqIqQq2SfDVCVqoHcje_sREgJ3qOj-7-vXmeUMcNpl8cFk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wSlKdOny5H7j_9_CzBmQnhzjABT9XPdK5nPIqX3GDlg&oe=69F6038D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KlaCE647XQQ7kNvwFR26J-&_nc_oc=Adq9INjZI8Y0DKFNcK4TXKQ-K34FP_fafi1N3KT1nbOowclijme9freKNvvR3_wjphA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KOt6MB1x2uc8q85Fnv5s-3GUGPWHorvY3ofxy7avFew&oe=69F616C0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--FCnK_GM5cQ7kNvwGZy2yf&_nc_oc=AdpqoEKiwBKjXSvrQtFGXFa2sm1uUkOEfOaD43CXowpbOe8gcqJxV4LGV9_o0-3cC3U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DzCLGd6DNV7QLtiM0HQVEaJmQpdATUjS1FxvTX1qAIA&oe=69F5E7C8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WknqkvLAkwsQ7kNvwGFg23B&_nc_oc=AdpgOCl8B7qsMhmVq1scBYPzjnsS7kF1nFDxcxJq5k6tEM6vkeUitlfsJHcaBVIzI-E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VQZjfEViPFlHH3dD6J7OkHgm6Z8t3TDAMBty31hCPQg&oe=69F60263"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqqmo2sT2D0Q7kNvwEiHPzU&_nc_oc=AdpI7YIwzsjQY8kyvz2WY8wSfJEQWlxcxgbNDX2nsi1y5bTJptlXBQewmxhyRVx4NVw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uhZaXTtMwElP0Vhd3QdeYEsrVnimEcJPo4E__ih9b9w&oe=69F5F5FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5JtmspmOWoQ7kNvwEpvGPG&_nc_oc=Adra4BwWdelLp_wX3IxB6oDVH6R4V1vx5ix2zQ-EF9mX4dLCRe8cNPgJhw05tXjLoa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a755-D5uNrcJwvGPXzyK1M4pIWPyrJdFlkg2k_gNOIw&oe=6A3EAEF2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlGx3EY-8O8Q7kNvwHAxjhB&_nc_oc=AdpHX1oCg3NfUfykxcl3j0D491AHxOisUFsFwuLJRdP6vCFnRwPJJWCGDzInIPvYbW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GPfsQsqPVs0Wgw3fH4-2UhpFmp4URA8sKoaIv7J3_rg&oe=6A3E7B92"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AMweynPLvgQ7kNvwEIpvHM&_nc_oc=AdrNlpz8yMx_bDX7S_-dDY48EH2ZdXmEB3mnqiYyLxS7lghTd-Sl5PoaaZ5cBnr7rWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IG91PxUKjQAjsk4aJTyei-HV-e_uKEimunx7Mdtg0lA&oe=6A3E860D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8ag1xIvAfcQ7kNvwGLdFyx&_nc_oc=AdoQOwrkUJD2iiJMe_AnAVbMz3gjzaSb1MxERrSvCIe0f1tSkKkRcwa88NHWMDatEJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9konmEV4kjIbxtbbo4vGcv1jSSikVxCtetATXvP1Moug&oe=6A3E9940"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cOno58ohmMQ7kNvwGbOG1Y&_nc_oc=AdpxzQBj7gpBmto_uSs7eVJoMuaG6tlfg9T8m9wSSX4Bjs49Vj3ePhXAIJ6q4DqdYQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gItbYKo7sSpERT1K2SghckyoJESdRixLKxeLDGlhV_A&oe=6A3EA288"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz5WnFcBgOEQ7kNvwFgjXaH&_nc_oc=Adqw7rpPGT5sQBTTTu19U3rzNyk4hxkGhUNs8dHFWFDhXoSoExa4zYch92X6NxA3-eQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tmn0s5RjWznvQJNN0qTUxjxI9aoA8Kd9ch6wOETElwA&oe=6A3E84E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi6MNcc9GEAQ7kNvwFfRi70&_nc_oc=AdoM-qAN1wwJVy2oa-15boAtf2AMRM8f5BSLLyv0PW2BS0JY2zyCMFRe0nZWJ6rD0S0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eO38d7VQjJJhkZRNbBXtgMpGcYjpGm4TBLU8XJBmwhA&oe=6A3E787A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
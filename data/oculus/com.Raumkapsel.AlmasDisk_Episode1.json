 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr4swg3mn9UQ7kNvwFOEGhO&_nc_oc=AdrhnAaopaVLpd1slHrDWxKObb2ME1ty9u9GDpgiAEYEHey7wivE4P3l66XUr5ACR4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eg_EvRaednQA_iCf9EcyHRYVoA_mLAAW5YXuHmbjJYw&oe=6A032332"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY_X6v5dZY4Q7kNvwFwfASW&_nc_oc=AdqdJBOn34c_EeXVpcQAYqf9467xnKtohlXc5F0ln0O6HB7ULpGNYArd26YH8F-688U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6shSU5uu-xD4_rHscyQXplcwJZHHEZbnnWT4yi0S9q6w&oe=6A032812"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7T8INUwWwwQ7kNvwHqseaN&_nc_oc=Adr5FU5vBpIF5JfPL62lN_7bO3gZQMWSAHwMBO9Cv8vRO4-tjv7Gia9MVN-tA-2VzaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oMwPgjm1Jev94uCMhGbBRwh3aqrZTvFS_-VvKIu2LdA&oe=6A03328D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VyJFx_3VW8Q7kNvwFkFOgg&_nc_oc=Adr-AjMhXxREV7fAEhcAO9-phdUNE0C0Dr9TJF4cNbFpiym2IUOOAjhYJHwDI1C3Haw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EnVbqj-rF39NTOIJMl8gj2kYnnyzYvmWMJ4TYU5Tm8w&oe=6A0345C0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4Iwhha2cXAQ7kNvwFkr69T&_nc_oc=Adq3NGkLvUHBOQOYLfNSKyuivjq5HVlji1H2_Zj97PSRVt7xedIPE-bG6CWGYzKmgKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kx5ZpiN_fwoiTTf8slX7QpimgJe5OO-LUOM9jJKpngw&oe=6A0316C8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaMQCaQ6URwQ7kNvwF2bIDU&_nc_oc=Adqqiyu7lo_rRJM2nh07YcxsUvMtkFuhGuz4dtzbuJ3E7XbvwyRtB7O5KUvOLeW-vQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77WTSoDJ4Fe3-U8RoVUV7lLTzoUkXiOsxGjtwTs_4msw&oe=6A033163"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCLfgJaIDt0Q7kNvwHShYQ-&_nc_oc=AdqZ4-FcV8AOAEsqVSV-pCMZD8tV7hpJs7m-Mglh0zL2QWGLw_m5Az-YMDVS_4ypp_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f56Oj3_LFIE1219_BGNgpFUeEi_-aSiiM1vGLm2i5TQ&oe=6A0324FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
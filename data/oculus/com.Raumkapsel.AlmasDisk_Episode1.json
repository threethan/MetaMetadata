 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oFF1KegpT4Q7kNvwFbrUZt&_nc_oc=AdoiltdKjr6W1CiH9Df4wfy7t_i-F6d8KC5QRtCvHwBV1Sg9kCjxZ16Lj0dCVZxUDMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKssLIxk0V8TsvnRsxWVLj0M23qdrLxJY_M1RfMDyUWPQ&oe=6A9AF7F2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSBeZNUV93oQ7kNvwE6jVK2&_nc_oc=Adq-Rx55b-jaXdkVNM8VVzkT002IiM1CNZ3isC3Mmp1eL58cLy0nPD7J8JvTVaCwVeY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgU9N9bpWEmeLS5Bf9su03x3pOVcxml04mMtLh85SbHw&oe=6A9AC492"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIPvizTUz2YQ7kNvwHpuF0O&_nc_oc=Adq0suvPr3BaAcZryQ04PyXWLsoBBfEiGPRDhGCTEZCR6__Zu0pn9FWtVlSzs22d55U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhjiuKMiH80sF7SLgV58az4bNcV1qptiAvGk5xyKNZ5g&oe=6A9ACF0D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3gry4uHlqAQ7kNvwGlbg2L&_nc_oc=AdoQb67tQxZz3qdh26GGCQaqgbdEOKBfmq3pi8knroanGP9eTl_ADuNOfJeZUuksHW8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCDICqEsUZSc7Z338Dbe3PvnAPXExHELIuIi5RKMARgQ&oe=6A9AE240"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNjXcyGfWrgQ7kNvwFinhUd&_nc_oc=Adq_LTGJtr2ryZhSw2dv32a1nVie63ODadlp42sp8LxySwPIN3JpZvDO3DFryoHrW-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISI2TZ3Sk8NzBW48_XcYBd1ba__sO65NIDNniIFptolA&oe=6A9AEB88"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trA9Uy9xXiEQ7kNvwEl0eAG&_nc_oc=Adowr4PJuIh7n-7p9mX-gltdVq3QnzL-VvPyBV8rOxwlcolJudbvWk_QoeLLr3Yn8Gg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJawgMuyqCZ6HmDMEAiubRRIm1A-UcZygb0rFrKbuaAnA&oe=6A9ACDE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JcD7aYNAVwQ7kNvwF2G1bm&_nc_oc=Ado4RegBlyX42hg4tOTV8bXx6DFZkcgbaSnCTbPDeYli2rYznhADHCQF8YIuIS4X_o0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOA78rmQKFmyVLJVIPfOcfPSLeV8cTaU26H9XfxSBnlg&oe=6A9AC17A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
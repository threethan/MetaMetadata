 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipTDOYuLJd8Q7kNvwGUYDmz&_nc_oc=Adq95tyimgSD3_A0e8nb762PoTfcw7rbjEpV3mFqel8Ya5cynTTvOW4aKWmPGoD-99U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHULvffiyAF3rJPmRZygFBFsGvC9QSgHoqfEDL_EjW7tQ&oe=6A973BB2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI_6KdFuCKcQ7kNvwGMqcIa&_nc_oc=AdpjwCzc0J0rpl3jD3rp4jGcv5JMpkaNQBTOee8Sm95rmr4HRM8wNPi8B_MGe9sx5n0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9eyLcLCQ-EH4d0txwsqp-keWTM8IKss9jhpIlrn15MQ&oe=6A974092"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcWoXVtC7NEQ7kNvwEzKarA&_nc_oc=Ado5_dkxRW8SMgBJmMJ2-T-MgG-DJWvLhsBZ7TGDjGnf0P3KaBMk3NSSvmtKAZ7YGCY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG06bzv8HZmHNAk0kukdJQzG-ZUiWjQJApfHbJXWLVsIA&oe=6A974B0D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGJ3yeB9BBUQ7kNvwG598sE&_nc_oc=AdpDMJq3NboAsXGWkDX04DcEEVG9pO_tswVeQE8a-7x6QfztgO8770T5St4I4uUjO4A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfucbLxhIigZGph1E9apedPjXdJtiDWcTbXqvFoWMpjQ&oe=6A972600"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_VDJAd3Lq4Q7kNvwEqV7eO&_nc_oc=Adp_odByFdf4b2Dyg7XQ9q1QHAtW5A3lddQNRgsLvnx0GGGiUSk1LCCIYb_GJP6Piao&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAag0PvCcrQNr0D8asddAn1d-R0AkjmtoRAG2m3QykUQ&oe=6A972F48"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKTPdFEYsV4Q7kNvwHbgzbF&_nc_oc=Adq21uDeXRCDBAPmd0O13Sa04pDeheE0MhSggYaFcPhZXVHQ9Ehwo4Yg4afSHFgPOJk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK02N2eufjnVXIf2hda3plqmaFIsgLDp8yUiOx84EiGg&oe=6A9749E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkNn1ThQ9GAQ7kNvwGRvvBu&_nc_oc=AdqsJCRdq7B9ut9HoVlZVvkfc2x9ONGTAVYSAMlZ-8P8yJPQ30NlzKum5Iy37sPt5mo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi_wxsMz8dcpYs_bYYRC2Y0rwYS7qkRWZM5_-JdRfjvQ&oe=6A973D7A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
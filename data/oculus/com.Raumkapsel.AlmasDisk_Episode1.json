_512x512.png", "id": "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEyBhWv9LY4Q7kNvwFq7Ixb&_nc_oc=AdrEaIipTv-7BR2-U724N2tYrpZR_rr9v2YxYdTegBA4taef5iYtfQ2AuJ6skkr_OXM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0hIWwvPAC9fbybICJ9whZ74BcyaqagbFuwrJcY7mFmA&oe=6A7DBEB2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhcdSwCuyNwQ7kNvwGiP1Jt&_nc_oc=AdqcMOds3a9hNyIq3aV3WQq2ZeaxgWwrEVNEZx3TghyvCOjlSDbVi34F67zU8gS-8dE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHDOllLowz_5PchLgCQCaDCjvyotEu6tb8VPfqE6CXUQ&oe=6A7DC392"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjrjIBBaVbYQ7kNvwGCrlEu&_nc_oc=Adr3X1QtiNhkVhHF2_TsB-OM0I2wJXph5bxlIEeFssm5U5KSrSZeD0S-TOhXeqDBFds&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpelxHegJ37DNlDx8GpmjS-hT0hHEACxSvJBnOKIZ0mQ&oe=6A7DCE0D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOaKOAiakVIQ7kNvwFtnXPB&_nc_oc=AdoI-XGyLzs84DxsNkN3eEAIF6b_elnn8ALTiwxhyQzWFDviPCXoCQhP4-BrPZh23NU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkFlY1trotJC4diDngVqGvkIhNTawxusgA3DclydxQPQ&oe=6A7DA900"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_O4JB1awVgQ7kNvwEweAEC&_nc_oc=Adq2mSWg7oUln55i71B2nZEA1Sw5nPIVGOWjLtDQto6yQQMO_yFE2hSaSEnzPvAgtbs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfphaQD8ze2mznVa5HLsqmaqtce4-Q_kraFaghqdunvg&oe=6A7DB248"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSKmZgmZngcQ7kNvwFG_NZ6&_nc_oc=AdrTEEX5_UCiVo3S1w4NUMrURpqxeayerl38vNXAL5gIwW0V_5QRRmSnMyUTUVarHRw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRL4obhq99GLAlkyXEt705qFRkCH8S0nTAtojuBd2WsA&oe=6A7DCCE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNGtvoi8w0YQ7kNvwGPIEgr&_nc_oc=Adrqpu1Qh2pljPk7iwUgubcEFcyHMBo0tJcOJ_h7mYqGo9cJps5OHXscSJkLRk41NxA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2TKIXLl0wTwttTM0rRMaGbsPVmJ1bNJOvz9nUtadjZQ&oe=6A7DC07A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_suppo
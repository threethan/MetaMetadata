By3271gHvhv-CLmxm7AdA&oe=69F76840"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--FCnK_GM5cQ7kNvwHs4LQL&_nc_oc=AdpEGlifFlczSLcC9Mf_3jNVUXOiC1JioSqye1T0yGHsMpCBYMeWEpu7jq04AUlJnhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34Vfe9GPYNSQcsIt6Sxv-NocNCFI_COAawk9cJDt3hlA&oe=69F73948"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WknqkvLAkwsQ7kNvwFxMq7H&_nc_oc=Adqm7Tr0gfaOLSLeLBRDsYgiBQpwVWWGj3AiVEvQ3N9gaXGb-T8t7vVV4kn8UZfLKz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cQ2Gg4_dGqmJdr0VsstGzKfagCy55ASr685llH6xe5Q&oe=69F753E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IadI3wADQqUQ7kNvwHvNog8&_nc_oc=AdqX0uzsjPNFTwpLQeUenZZop00jNoh4KsbHIt75mHXz7qrHvCdjuyR-Fps-4V0sBDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KNoZGP4Dstgqdmo6AFj-J8RZqzxZQpQfSRJvEBWvYUA&oe=69F7477A"}, "display_name": "Alma\u2019s Disk \u2013 Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25255795927408896"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400793_2662600390603925_1784600606855490818_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OLi8eoY29IQ7kNvwHhlkBH&_nc_oc=AdrPXdDMO82VKQOFFHLaWBlvSU
_512x512.png", "id": "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHbPMTxoO00Q7kNvwFf_WXP&_nc_oc=AdqZn29GfGDdUKm-clYmTVfQZsYJ5LcpdZIYNgeeNZKOfE5onRx9Y5keBXmqv7H_ku4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nVF7hThdI3Z7Wu_Ptbww8QrYTWdeE6GIWQxLQVrxjnw&oe=6A3930B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijUCa4jPDS8Q7kNvwGiO7zm&_nc_oc=AdptqerMF3ZIMqfnVbLsFvmZWRddCxtH9igK4FmiZP9jIFoRhaUOT3dpe4ugL-x3ajU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af862iQuWDQ7hssTN5HKnVdFb0aVPJDDXqYpZ0VBo2TAxg&oe=6A393592"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkANwXcYBVIQ7kNvwGi6N24&_nc_oc=AdquvvOG8sKJqmOFThE4ltIUpkR-8luyxXpMpZnd8ZqnMKjlkP2JxtyRtHZSlDpNNro&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ok6rMcTxl9mRRfkC3uUmQDmm3VVv0PTpd-xgtaOf3nQ&oe=6A39400D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAoJiqbfC0gQ7kNvwGPBE5Q&_nc_oc=AdpwNf0V7ZB16jCZ6VM9LU1LBEe338KTaPxG-mcGIvaK1kZBwRijgsP1d8uvmLcttYo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S6Jeaf3dZgYyubyy6gQBDs9aldBNXzprztZmH7f049Q&oe=6A395340"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFHCL6ZfMpIQ7kNvwH3zL5J&_nc_oc=AdqqyND7zIgVXeu_8OSWxmL24yUhW-KPWWe3yslZdyJ376_Dx5uEaMqFS6Loukp1CXI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eBAQ_dqeC37Y-N4LHEUf8zn7Y36yyHUeiaMYxV-txdg&oe=6A395C88"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5mKV_lXob4Q7kNvwF0xzLw&_nc_oc=AdoZs9mSmll_ZjtGHi7QFWoyn10HokIghSn2DN9r2sZLZQTqMO1yDI5cf6CB4r9DvjI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aB_gNBdzcCPofBnHXXV9e6jdKvsB2PuV_gw_cGCAvyA&oe=6A393EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfSAqNzR9joQ7kNvwEGbqge&_nc_oc=Adr2nGgETxIdLY1PSinClE6pXv73qwLsY9NJWWf630HIxWNnOrCJQENmMWjMjqWGkSg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kDrVt3NOJWHdgzUAgQ3TXUV7COR5hW5m15H1hmlBcQA&oe=6A39327A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_suppo
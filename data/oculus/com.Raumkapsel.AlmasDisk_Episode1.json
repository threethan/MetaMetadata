 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLrG-ZrV1OYQ7kNvwEQIM9W&_nc_oc=Adq5pWVmXhq0JB38VfGYp8ZcxgoiiFbYL0F93tV0lWaJgQxocEZeBuMtGIQmj7wRPVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2qPGLiHL_jyheLrwfnHmUAlmcFRc7bAa79CBMPiEsUg&oe=6AA2A8B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeMHpTh-l6gQ7kNvwHP3LD9&_nc_oc=AdojQP1u76TfssfIBumXM16sO6zq5YU_CPci6aEAj0d8zJh0GVN6uO_27e5lnwCy72o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7u5PvSqWySR9-oFVMw0RLDG60GC7Km_JLybfkfhuNUA&oe=6AA2AD92"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aMz5Kho9RsQ7kNvwESZ0f5&_nc_oc=AdoDImHE6r9uChe8NJN_-vshyVvUKH3-NX6WMG0ehY_1l6W46z7F79_Ae5NkByYV4p8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVpgf3cKCW6VOUvZLrxwXY_4KTOhEevpLJTaYNH9QdKQ&oe=6AA2B80D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWBYEMMJbXEQ7kNvwF7xDi0&_nc_oc=AdphYGLfpxjnzfMsJK7tw-TezZ-O-S3NuQElTbur6BpVMsmgr2urJA-CudsoH1T-CB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR3mjy84rAi3dUiLOITQ1DaY2mGyWkbIVoRgq6Vfhygw&oe=6AA2CB40"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS4nea4ND70Q7kNvwHB7uFo&_nc_oc=AdoZyIXzWkja5Q5v2kpcuyjkqRpI2_QY803b5r7EkkvdUZwQgvZ2qReTUwQetW3gDns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoo-B1_Vu0oa8Jl1fo-MYjx4uwxCOi3KhXmph_wlHZJg&oe=6AA2D488"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpRl-3Gar5YQ7kNvwFbc1bj&_nc_oc=Adp3ZxNeJiYLu3PCS-2bugjwHfS2077qS-zfiHYxMPlEq9n7YltgWZI1HR85G5CmI7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWs62Yd4MK45w3D9YuHkCZa6z6ZVHVvhSz2sE3Y2O-9w&oe=6AA2B6E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txg2kS5PB5IQ7kNvwE1DLgV&_nc_oc=Adq-1hb5ng3Vup3Nv38po5EKM9b9QfOPdzSRgiBLWYZI2sfThTwMmV62WQQQJ3GwJd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZqo_uS1mZZoOGiNfjBCHWKoWYKvRcIzDN_eujGG52og&oe=6AA2AA7A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdDi24ib3I4Q7kNvwE-LhU-&_nc_oc=AdqsIuHmUPXsmES29X5DSZ57uCkgeTRrz9V5djj7HYSd3wJ2pS9Ih-x3XInSzTFXDac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECNF08jeBQABv7iZPs6zG8MGxJdU6eOvqHXRyxaoPCWA&oe=6A8304B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAph0XiK0XsQ7kNvwFe3aO4&_nc_oc=AdowNF5juFK9wU3rq582ozN65YHJsO2bvyM4CHGWN9GWxaf78B8EaGEIufM5SRrMTXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOeUzTi-p2zrBYL5USDlqy4Uk06QnMgmzde_qm7l-UWQ&oe=6A830992"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ylpdpj4tUgoQ7kNvwF7yKJY&_nc_oc=AdoFDmP__nCZFjG7CHSJr5OLiePYeIssQ27mQPiJ1zNuXmxLLCd4Zx6vMAr9dMa4XDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_lQeZG1ApfT6U9T6U2b4OlIwhVgJzleuC1R9vJbbjcg&oe=6A83140D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJHAzW4BWVgQ7kNvwG7-lWy&_nc_oc=AdpnK36iMspKUCSgoAby_RLzuiIR1Q3dHrrX0lkH1tM8g5BTFVvIdn4FMkbIcPNNcUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZa90bo3LK6AqrUUFghfLPVEZ2pldC9TimSKo8f8i2pw&oe=6A82EF00"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5HiDkKBgQsQ7kNvwF0r7O3&_nc_oc=Adr6M01sia-_jJjoTTf73hBGMGkNhTdi6Q3bc0td85-OPeBxJesj1xFyTiX1oYxDj70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmzjIkSqKZp0aKDfYYTNpCv2xQTnZkKD7T3hxSM6cF7g&oe=6A82F848"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BmAuUT4tWkQ7kNvwG0j3X4&_nc_oc=Adr9v27qFOw75cWJ-9W4fQWZTEMO2CyyaMjlYAzp48_cc0xFHaVco0CL4VLbr5BxyZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWLvXyLYrqksRzMq_FTdUCjEHp6JSIUV4n0MSHmgzVJg&oe=6A8312E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UID8oUnwCawQ7kNvwFHuY6W&_nc_oc=AdqAqVu12nDg6PhuyrWC4tQo4Z8y-yZQVwXd8Kb0LQtplNiQrODahw3QzrLZUtO6wqE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOXNvp3uvbzr93N3TvxQ5gZJ-ktO5cbQK09W2pYrzD6Q&oe=6A83067A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
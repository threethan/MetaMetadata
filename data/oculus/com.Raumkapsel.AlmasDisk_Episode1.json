 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_vjxCXd2HUQ7kNvwHeCOBT&_nc_oc=AdpDjiXB-qpe3inB61hJmtnroaNpTAVQqhChoSY1TTKRy9optcMGH0EpleuItHyzyHQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36Bkvd9dFSdd1Q3c9pOe4fiCdO5YEszERciNq1OzZjtg&oe=69E22DB2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y72rrn_IJdsQ7kNvwHngZqr&_nc_oc=AdooqVreXioL_kWIM2KhkLg2PtrP-8m8lCAx0l_Hbk1sFuF_rSJfAPEd0g_ueGATQvk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RR7UnCiTyObMaPRpMs7VxsmDzdVPA3iFrb6iB1jeKow&oe=69E23292"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0tSRMK44McQ7kNvwFx9KEQ&_nc_oc=AdpsPYF7qCGqWOympeW-Oqv7E7cAlRfVXh2NfNxY22cbwE_N5OhXJYWEZvSPpqQZo-M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pvz_0W0LfzGwhJRBA2IygIHGG2XpJJX1d8zmdXGCA1Q&oe=69E23D0D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VO6DC4OtsJcQ7kNvwGB33FF&_nc_oc=Adqx2uG1ohBgS54gGrTV2jLJhldpQMFf5Ew4GJF_MtrQJjz3TX8hUBbVkgPWWnmJYUY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18Ct8VRIgJmhEfiqLBCJCitwxVWPSvLiyLfElo-b0Tfg&oe=69E25040"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLgF_O7Sm9sQ7kNvwFcu8jO&_nc_oc=AdqME3IitRQ0XIpI1b8U5DmoRpDH5ATbTOAmXHUEmZNPKT3y6_kp6cq_EI_-vJ6a-Mk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N2YTRrCbntgXqiFdUTnAgABvZoXFaJmWNucM9QmApAw&oe=69E22148"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR6ImLa0bjEQ7kNvwEArWOE&_nc_oc=AdpSsQKfQ_N8fdvk93cdKyQdYKHUgSq1eRPkK3w9_HpvQHLXp8WseB3SJzPCT9JXjkI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H-FBFXEa4W1s9SreeqTvDnoRjM98Zn-5-HjcxwRmbrA&oe=69E23BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3hqdl9Ci-0Q7kNvwEt3kkz&_nc_oc=AdqGfDrlSDxbCQ1_Pmmgh9Z7Maw-qHCWPe0pzM0vwNfDJ-XI7U-Xorgwl1CgggbgWBI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q5ErO0iqbXEMuaGU6TZNQ1omwtto-4RD2JxSKGKQ-HA&oe=69E22F7A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
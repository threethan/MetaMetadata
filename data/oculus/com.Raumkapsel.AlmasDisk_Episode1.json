 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ul3gri6NuHUQ7kNvwEm_MyV&_nc_oc=AdoPgzWoejXyUvyRV9Z2wq_QkEWni1HuwSi-9FrZwamrvh8_WS0wbAUPT2O7dcf4bHA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aeCTyGFeccoBXJaBi3PqrY8MthA4myUp5dw1aczokSw&oe=69E8C532"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-mWJ7Hv-BgQ7kNvwHQpLnh&_nc_oc=AdoFoyRZV87aqeQicj0o66i70_9XsH4fXGvgdSmAgSZe2FXISZCAUCF6lJmOvuOrx8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w2iZjm7Cgx8v_gvHOzwPeCoTGyM7YL6_UDqDcjIwqnA&oe=69E8CA12"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K4mbBS40lwQ7kNvwFU_6W7&_nc_oc=Adr-4oXhKi8v2wgMFj0Z8wmqrwGKkAQj8Fyy3yEhhjm9IhS2VhyA8u2CP8IysJZFcwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ltwECO2dFiHJx35C8TGKunPdwVkhhrBJo939TP6sUMg&oe=69E8D48D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYphh9kaHsAQ7kNvwFABfyF&_nc_oc=AdpmgoDFNvbTLpZ6BYJU667vuk_baNTRObiZ9YkwVyAHPx5Hta7TjbdDV0ENm1J_iLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J0k9PciNH-VZfFXkdNx1BfJU2TfYFA9gMwePcU19EtQ&oe=69E8AF80"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YW_I-pS_DOMQ7kNvwF5eIju&_nc_oc=Adr0IoVT5jA_01leq7P_KLPFzDgVrW2QvbT8nOSBwQjDsOMQpdzMoPACbtzjWhkDCcg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ALdgH8KHNZxtaiCNcrix-xIWV37ZM3k7z2oPkUV1l1g&oe=69E8B8C8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QglVFQMLMx4Q7kNvwGJuylq&_nc_oc=AdpAC-qfdVhkaj5dDwflWxmuX_0r2jgHiGC5ARZHMzoN7WBkR__I-f0sObtJ5cqfg2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p1eVOL6dM3f0oD5I1W1uZVMngAYwxQKBUJvlW9bAGFA&oe=69E8D363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6sEjpcgR0cQ7kNvwGyHlMM&_nc_oc=AdpDO1txSIrYHqk_K74iLGVD0Q2H0I1wUdH5b43qvRRHp8VwwZNcKeTba2cP_AtCeAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zQRpVk-ZLfnCKBYHoek210vbrWwZBvOq3nLW2MxEVfg&oe=69E8C6FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
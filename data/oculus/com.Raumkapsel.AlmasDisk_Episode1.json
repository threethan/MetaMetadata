 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnRCOV8B2uwQ7kNvwG9yexG&_nc_oc=AdrQ0JBYZAj9KjO4iqtkV073Jphl3he_X1cRgTlF4RtD0o3LIEWv-EC9a2Mr2Pyk640&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIvcfrybpe5AoZRm3d6QFwYnlkw_kqzY5VRDpNm-wibg&oe=6ACE6272"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls2PQvdOsncQ7kNvwF-kCTp&_nc_oc=AdoN0DNbV-XkhiN-NflFRvBkOD-TC2PrU_KLS3AciDERLfANl9J4jSGHhtPxtmDX4KE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp_jxqj1ULZUYauuoMMxlozgOrH6nW0O2FCqZEKWfmZg&oe=6ACE6752"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFt0DA2AkjEQ7kNvwHC0liA&_nc_oc=AdrdW3fPWMnNhkDSwP518cxE12m_FK9ZJuhAJ0azXOp_7ZITCUfATg5IZWSMzvzz4LQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv2-Z0IgMpwKsnYA3NPFx36qHQhlDR1PGSQET7zVA5Yw&oe=6ACE398D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4nESJA7XAAQ7kNvwEgOqJG&_nc_oc=AdqoEFG1tAqLMUcgrNzusASnypBQ0uysceQMw68j-Bma3oi3OPcG759z5eGf3i4iyAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjf7OOQvSJZWza_rkPBNWNeV8JjP2amMMvdUrz3HMTVg&oe=6ACE4CC0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNpQw5Z-ImYQ7kNvwHtdD4a&_nc_oc=AdrfxMviF1g6Lmgr_D1ctJvzFJjxPN5R9Y3i6dAwya29dEevMJ0GjKgHuUTakRnSIr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdmb16Bdhfih1g1HAQzpVcbMq4OW38PznMZEB8zPWFPg&oe=6ACE5608"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGsEsX9OhAoQ7kNvwHDxhb7&_nc_oc=AdpKeV-V9eeM0xUNF3rjZACs53FHLcyli3TiB-i6KuSoW21W9mVnoLL7JKFkvGxcqbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTNl5gyEjVYwbTSSZ8pvT2py0TrgZdvQacUEPYxRUUew&oe=6ACE3863"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NonY22s_zeMQ7kNvwHGLwaA&_nc_oc=Adp662_iYYb4Cb5-PDIvAcm-iSna0TC_D2UHLfkkikxZPjf6hdXUtnFPkOBYGmCt8n0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1bwQlRbzOFSQE4TZWseoQK0mYDBBJFdwYR5ovMPZCPQ&oe=6ACE643A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
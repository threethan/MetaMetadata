_512x512.png", "id": "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVDrivgAaq0Q7kNvwH9QExc&_nc_oc=AdqZOY9Fa4iUOC301tPy-Ogm3NrNm-7DpIw2Ye2ZI4VKleYNSebxqHngTMehiOaXWyc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_wCInTFIbO1e8P8l111qwl0IOK7CiiZ0zKj-DeQIjCQ&oe=6A465FB2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF5L9OKjIBQQ7kNvwFYZAgZ&_nc_oc=Adq6hKBYHQVyrlPJ8rrt9xSyea36MOAjCAYE904W2oll5pbQKO9QL1yyO6bFgW1676Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qTt44_itrr0gpfQvLMX9kAPeRCtdUAufyI74LIKvEFA&oe=6A466492"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdClcGw_fOYQ7kNvwH98JoM&_nc_oc=AdpsFw0E1bKglNeiNFk9kZRBaeP3lUYIavfcyU-3yZOwXYqVBo97VZZhRY5HMUr95ec&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J79nvl_LAvKmmrDxKTpqaolAKAlY1XNNVgmIPk-FrsA&oe=6A466F0D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohtNp9BRmekQ7kNvwGD0DlX&_nc_oc=AdqL9yjhyVsFCoYoD01jtb_t2oDo-BeM0YKzNT7m_TfL2lqxaNlc3oen8CNYYYfi64A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vCTdiLwrswptDvjVfcO7Gu-K0mMLqce90ZHyJosovVA&oe=6A468240"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SniDYDJakicQ7kNvwGDAwYb&_nc_oc=AdpqYTK_T2PwTchJu7VbP_Ibm18Fjdf34RPCprkeVLf6X1e0wnPiwaoiSzgDDl0nx20&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mCQhWupBOpLU62CI7kKxFNlROsGRBlI7BA8l2dPSOpw&oe=6A468B88"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDlD2w7P7yYQ7kNvwEd0n59&_nc_oc=AdrmG6CYIgrz7DVuCgeQozshvBBvMyn-q3lkV2I-tdK5FWF6IsVcu8LLewMwge7mgLI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6RgNx5pdG1Gq3muJyjFJEfW07F4p7laIliuE-UW-zHA&oe=6A466DE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltp2iHTNCnsQ7kNvwGQFnEN&_nc_oc=AdqpDVSRDXlmpMk-pR1u53aMb_VN3i0_qbd9-fNBLM4qfaO8BMm-xPMW_gdPGiQRIEY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H9okvtBvdQMxDAOdoy7mA0CE4b7SK7dLH88RakMdrrQ&oe=6A46617A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_suppo
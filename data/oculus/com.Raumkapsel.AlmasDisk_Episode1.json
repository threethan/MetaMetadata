 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8qoWWkPR-0Q7kNvwH5GvOK&_nc_oc=AdqtQHEJOnnGXQzEP5Qnk9PDCAVToNOyL9EzJ0e67Z_-GYTD_3E159vYLm-PJ7EYYXY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gXdm-A84o5FxdHnL2J-wkk6Hc7IKM91fIr35AguxpLA&oe=6A1ADE32"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bq1EHU6lM3AQ7kNvwFpNejf&_nc_oc=AdotctiTzMUtMIzG9DYkYhHnRu7IYhesfZz0vJk23pd-T8J7J4nzoOIYfX8LP_aKqv0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yeN1RO6aFIiJs5osO9-LNWrRIg0sX-vl1JKiHPNDnDA&oe=6A1AE312"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh7w5KdKGFMQ7kNvwH35hIs&_nc_oc=Adqs3qK2paw4CItfHNzZgEi6IjsuZvca4HN6RiM0iL8m6zXERIHNpMey9-yTsBfagWQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HvwkoS0038L9C9vR250ajX69gVlIZY8yRP3Ct_B-iKg&oe=6A1AED8D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRYhFzdWvegQ7kNvwEC1dxK&_nc_oc=AdrIjeUE1hCHqZ1dti-CZ963Q-cXW4Rvavt3zyaXBOgE-77hUQ521kw5p1iUrjmvaH0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67wM_fITdo35myKnUOM0_cMP69JqSAq3AQAZpwgoNxrA&oe=6A1B00C0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4TSs4cUh3UQ7kNvwGRTPts&_nc_oc=AdrRRB1awunTvIikA8-kgKIHXeH_I_bJ-7fqZ0e5rU_ZDdDPAtfB6g_pmh-7iR9fyaU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SZ7ynhJ8pyheRwpP57rYO51wcip-Wm4audsSzao7MJQ&oe=6A1B0A08"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTv5Y1PyAi4Q7kNvwFK8zgW&_nc_oc=AdrdKQWdfTjo0vUCCLvmz2O1tZCpMFNi4a2HOi-rwp90juW7Y3Na6paN3VevRKYv0Rs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PsZv3Ii50HzHNPkuVhdlkIsyOhzLUZY8ta2wsnnWpyw&oe=6A1AEC63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gphHrd8fu8Q7kNvwEj_84K&_nc_oc=AdrS_81j179HsaKEAi34MLoN1U75a3nt7_KlmenfwvDCb02ZS5AT7CEMWfSe7eCbFBg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dmI3vV3GoNDHwTnWHjphCfuwxU9p74foUET5I0kylJQ&oe=6A1ADFFA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
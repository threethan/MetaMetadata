 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMWwNXMgLCkQ7kNvwESjL6j&_nc_oc=AdpKQedRciQlVWp4bWxQb40u8jKC-jEoZBNAW2iMdofQlKtm8EqLs0MGGyvrMyN2aw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs7RysMkE0CJNnabBzvMPIuXz6CWtahn8JB3ZbDGocjQ&oe=6A5CC932"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK0iZdEKdDkQ7kNvwG_JcmW&_nc_oc=Adp0AGiBj11IbrwxhJOlVTXL_P6T5vvgJckaHWP4DpfyIGSRSSAGyTi9Tq3usoXVkeE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsbVfT6zaPlZLFc7-t4zdobwz6XK70zmx0ZNcAaA-Afw&oe=6A5CCE12"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BntA9112YpUQ7kNvwGSXVs-&_nc_oc=AdpKJv6GxpyOAPng9_yqrVweu0LqHNE5nIzLifFu6MWYBq-vIjM6BdOd943YaN1UTnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA996DPfkxjgAALnGPPItlQWsLO5H4-WKhBBULHLxelvg&oe=6A5CD88D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYMgA9nf02MQ7kNvwEP1kwq&_nc_oc=AdqMOJj5wj_marnj1aWlOI0k3ICf24tDGK6zh3CUtgwdD4JzCVQhnJd-NLGqub5AWfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtclMgfrIEAZa337LLtwOaCdBQ70ffUvO28DDt5Lru1w&oe=6A5CB380"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz-cbsvfVDIQ7kNvwF2eOwN&_nc_oc=AdpzNT5BgUkqOShOia0rmYYSWUAt3HnMyLByeKdkhe9omFi8tA2xwJeaxCuqzz9lco4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ4MHXfoaWn-nwSHyC4t8xJlIxsyc_8zzcnu2DFOC4SQ&oe=6A5CBCC8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaZZb5N3e7IQ7kNvwEFKaAo&_nc_oc=AdroZZsqQQ1ZQkprwpK0zyGxgg9f7ACK-zLP2iLToVBt2qqsCHnuuAWxPDrtubPTKjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa95-egQE1ntnx3KI2bpGU1uQJGD1F54fPVNqxOEODRw&oe=6A5CD763"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhrs8g9OyNwQ7kNvwFT0geW&_nc_oc=Adp7oQIYSrxNbERvDpgt0IkUzp22BJbd193nVsVYnbwDO5iSwtTVFywNxD6L0jh_n48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOeomrLDf13SP6uAmsjITjGrdrT_DbPkOiP2IdPVl1bA&oe=6A5CCAFA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5JtmspmOWoQ7kNvwHWqb5n&_nc_oc=AdqFBhmDquosd6mIbjS_C3n0-IdMuevIPROuxVOpP0p5UgqN13x9iOs2buvsgSHU3pY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7L_F26wu80IbBvXZcHF7njJ1_0X6i-DeQTnKLXrHWhw&oe=6A3D5D72"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlGx3EY-8O8Q7kNvwHo3R78&_nc_oc=AdqnFA69-xyMFr-JlFXOhW6e8o_EY3VH7RpWf5GuwJH0o4j_sRVfPEGCJBc_1RurFSw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mczIjMLGjVuPT2heV5r_ka3JVQs_3vBObCy7CKEG8bw&oe=6A3D2A12"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AMweynPLvgQ7kNvwFfSavc&_nc_oc=AdqJx_hrhwg3Xcin9AKo5swzMTmCxfc07oMrJTVl1qx2neG8IQ8Y-ceP3AcYOBpmP94&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9btj85aaBPnzLBWQ5e4PVLlDfGvhYlil2fqoMvOOj28Q&oe=6A3D348D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8ag1xIvAfcQ7kNvwF7oUQ-&_nc_oc=AdrTuts6p_WTCgS_MYSaYKuPUZe-OG9TGmBdxltcLUu54BGdyovJ_Xy0fELcJ8I1u-0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_CcMujNO5IJJYuUsymsoc2MHFN-6yvcEaI7qfc4w99g&oe=6A3D47C0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cOno58ohmMQ7kNvwEgQSUy&_nc_oc=Adqxygd__05y6Gqp_yKO6Q_MWdx70Y_k7tJZdgATtoXMZWwbpDsE_ApGc8uBRA95zF8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jIhZ8GCAy6oQLLBL5oWwSmESgtZ4PUorpHiOLQa5E1Q&oe=6A3D5108"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz5WnFcBgOEQ7kNvwGxkp4n&_nc_oc=AdrRWREkJeu16PXawF1IuqxCQy2e-DIeRBdJlJIz4ZwNRS9VuL1I0f5O30CnHde_HuY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DoORhOz3JLo4WfXW0bnjA62y8rTIyWxJFr3Z7AYdIBg&oe=6A3D3363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr-DObpBTZUQ7kNvwG-f_Qz&_nc_oc=AdoAUR0mdCFrEzyBjR3qVmdc8F5I5GhQU7n2sr3Ay0cfgYub-ODRkG8AKdEbpBsr1M8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s-IGYgM-EfcQGkUXSSZUzxcdmE7OEz06QLwoh5VrAGg&oe=6A3D26FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
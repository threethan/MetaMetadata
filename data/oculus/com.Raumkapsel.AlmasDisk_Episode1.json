 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoM2aoupRDcQ7kNvwEYdt-9&_nc_oc=AdoH8f6bZBRa4QaZ9GRa3bqZI_SIue_DvNmzwghRYkkI_xep8VXZyr3IE36GjkZ8u4Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME-mTcl4FuVAjlhLrbLJZCah89EpCql1YiKveueg9Pjw&oe=6AD10572"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs1M6jU6K3QQ7kNvwES9HTM&_nc_oc=AdpisC5nUbSpXSlzg2yqFEqcw1NTvET7UxNKrUhXnSHxePt3e7O81AbZ0bVOL0zavUk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsPF4TLdPUHYbn0R9se9otut3VRcVupice79V7b8_3uw&oe=6AD0D212"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFt0DA2AkjEQ7kNvwF4Xnc5&_nc_oc=Ado7IqAKUILIm1zwCk9n7mJj-mVE6zFDBBCYia9GFiobktg-54WFyJpuAB2Gp7HyWBw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdLoFz-u5Sp5yOjBkb_lrKD9ASBLeKMli6fzhVrS2RQg&oe=6AD0DC8D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4nESJA7XAAQ7kNvwEcY0IB&_nc_oc=Adp1_ZlOiGn7MdAOL4YC99n_muWsu0EAWn-48LKlZTjfMpF0AMh1fE02bWB9zjbeFSA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWyTcLoZHk_OnPbmDQpyzxBHpi5H8-piI4DLfgtLBzNw&oe=6AD0EFC0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cB5yKTnl74Q7kNvwHC9Zt9&_nc_oc=AdoaRjWpLro9cGsAl3mnR_o1VNkqNgk53o59ahSPUbfH2cEL-GQA4rpgQ5SUFVtmkWg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV39X9vw20h7FyVk9zmjqviaB-cBJBqJ9palztPYt8UA&oe=6AD0F908"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttsP6ZI_3iAQ7kNvwF4S8DY&_nc_oc=AdrEQ4W8Mzglb2SRsxwvkDklwI9ALRYfjw2j8ICJUTIXO3RKCA_1oz84io4vhXL6syY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN78VZLhkvQSSg4r_U6cqY2ewfjZqqDLlsN1PVCc5B3QA&oe=6AD0DB63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WCJ9_XM0iAQ7kNvwEGKdSL&_nc_oc=Ado0gfo3ysviuBzoaVtZDD__MrFCiJ0wri2BA06882i1RADD6VESvemnXA6vJ8y_0IQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrXNDmFoZZv1LZaVBnClZmFyL4IH6RSElUrxc9mjcazw&oe=6AD0CEFA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
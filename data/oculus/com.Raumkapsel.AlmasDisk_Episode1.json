 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U76jVSW0WksQ7kNvwFWNHWU&_nc_oc=AdoQODMwQynnVTeXRZF45w-creu-8mWQm1DY83MV0GU01boZXeaP99kM8f5h_9R9I3w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-cl1jPDPOKTfqv8Ifir_4t4lL-iVx7VZ2R5O_6JIYoQ&oe=6A918532"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXNHJKj2wWUQ7kNvwGqsvT7&_nc_oc=AdoQqK1ePIYiko1akKGvxdZglpuR2pgA_6gbPWHJXM6L6Co0buxypunMFCDEf5JTKK4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG80bKi-P01MgGJ1ceuJRD1gihbCv3nz2v_ppJ7i_DWGg&oe=6A918A12"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuBDvLfirkcQ7kNvwEkk92U&_nc_oc=Adoov-CTZRDAqJkdhC1NnNz4_eFrPwHvXgr4GdGv0HGmBHmZNgw84rRao7wQa_PITnQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHuujA3se4deyKD330TBUP7OyFLiO2XB9zD2bxdwEE4g&oe=6A915C4D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnbXCg14FnYQ7kNvwGdK6M5&_nc_oc=AdqKUahXh2fqtGACQlzBKYkiI4EWl3wSh1LBg9HnrCoBlAPtz6TqCnU_5f4fP6ElVDs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx5uUmvc48iq_jngOsZmRvPlZxWLhbAxZUg5A5jH-zGQ&oe=6A916F80"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvIrb5hfPdIQ7kNvwEwMJpo&_nc_oc=AdoX6kfVa22pq-yFMOtuSI-y_JPnJIG8JAC0brnl2ldEXGrdvEj0zpLYAxGfbGGSiGo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsSMhXWcZA36AgYI5sw-0rZRRXzcTY890jqJq8oA_vFw&oe=6A9178C8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWEvIVsGJRcQ7kNvwHUQyXz&_nc_oc=Adp4HEZU1L5vXQvjXnn2W1kL05bAvy3KXXxPqx11D0NaTVNlwQ1DWNBGoViGQcQxMoI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3417rr4N_RLijwDTjHY8oplqDGaPNjEeLE914q3Tigw&oe=6A915B23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K6SjedJ5CMQ7kNvwFxYFpP&_nc_oc=AdoOFf33duOkX11sFjSf1SJR4DgSAuemFQ6vN1Yk9OoQGbRzKJZiyy9mhg9fXD_ESlY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4PST_MST6Yxcc9eV1-4pMj5cy8SRhS6f8hv9AJciWyQ&oe=6A9186FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
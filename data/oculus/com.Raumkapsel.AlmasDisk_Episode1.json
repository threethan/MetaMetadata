 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x59bwFKtccQ7kNvwF7VCI5&_nc_oc=AdpQvwd28thm8UBLOwD0quqsoblNFD1T3S0Kv4Mn6rf8nZVrOoMfL7yrV7O-S9GFVX4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XNqi8Ryuu9h9sGnnFLpDuOtSmm2XngZbiJompVB1YVg&oe=69FDDD32"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8dCDRu5vjgQ7kNvwFzQ6It&_nc_oc=AdpPpcNIoUMmmZjSnaZUvPC-uYBw4Ep-swww9_0YzPgQ05_C8s6uY2ygU5fqqWPrJNc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mEI05urAfTamLzLdoBRuUHYUFYockr5sky3rDesBLMQ&oe=69FDE212"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh60_BTjmwQQ7kNvwE4RW9-&_nc_oc=AdrG7Sbbmtcb7hqV9eO5oMBr2Gpn0ZyIwjZtIHkr-XkG7_5bmrghcNndVPTM2FJvOlg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4umStISiUOBtMk_0z5uhnpqs23cXjkadlhq5lm3E6HGA&oe=69FDEC8D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1soqBi1qOUQ7kNvwHZeW4r&_nc_oc=Adris2kG2uBueFoDG8fk30Q0rfQXT8Zt84UWP9vIsNLS8Z0ySJAiiguW3xynAYsQcgc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UYRKdbeBhHBXaYzgpB0Uqot5FY0EFkNc5F2G-px6Jow&oe=69FDFFC0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIzxfUmd3nsQ7kNvwHorYoo&_nc_oc=Adpc7mERa9JVJ1v7ENFfaixZDt52ZGQ5uMSkRZuAdKKe9JRJmW_fNbdVNip6lwXpdZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_YfuDYvlkuYE2N3TWO2grHz1HHzy8A7NAgfW1QYuSXA&oe=69FDD0C8"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT3Q1ogF06oQ7kNvwHuF5HT&_nc_oc=Ado0E_sgEy1YxB-eL_sG84qgNSTO8MJFnN9VjCG1lDShbSzKyVvAifImSnUeuEKdnyI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d5lScOiZTlmoefEL__wJUal_Vi17FL_bP_V-bYDHU9g&oe=69FDEB63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vODqdTVcP2cQ7kNvwGCdaqy&_nc_oc=AdpYdqm1IrwAWHpBSyOZEEirHOXgt59v8xM7sUSLiVNyy4eScjdiCT64yqAaySx1ZxQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ntZaU0FE_TeauzoVfwGnknNoErhcipqtdzjz3OyyMGQ&oe=69FDDEFA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
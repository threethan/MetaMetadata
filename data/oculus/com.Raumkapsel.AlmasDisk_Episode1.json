 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PKZz_jawlgQ7kNvwHGBU7y&_nc_oc=AdrSBpHd62UhdUgSKJtyKoNXVLKt-YeJOmmEinwuBIO9Mkx4E3GjmUvPZxBomJ2B-ME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PrA_xCQeiZMSIKr8SeAC1QqyfjuIECWs7urZU5NvUlw&oe=6A0F00B2"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSKPpgZUnBcQ7kNvwHSNYfE&_nc_oc=AdoM9_ZGEOC9i1gb_mrepKnFE4wMWsVN9he499671FlXr8mH_4jrluTaNpVp23is0-0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NFQ4VYjKXOSWdQVjjI30-m5JElqzzALyg6VrGZxJ_RA&oe=6A0F0592"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMOUzfltaBAQ7kNvwGGlwOI&_nc_oc=AdpnJf2NaRbQ7EcG7r05rbb8D-V4FVeQE8QY1bxR9FCRel9Yz6m98L0Wf8KmogTP7L8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53-LDKaOdMRZdIq_fUA37ADRPcTK6VN7NsigeBIc20YA&oe=6A0F100D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sO1svz68xbkQ7kNvwGrIeDs&_nc_oc=AdpNBs9YGWqRRNcXCXLvPUjQIF7Y5z1rMMULzS2P1QNa5RnD1kTeg280vHrwsyeQjGY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YTNDwFY0Ql3mBMYSreQVqWksJBhpNftqLbJ8SrlOrDA&oe=6A0F2340"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lje4gpRJGMMQ7kNvwH9wBy9&_nc_oc=AdpCT3g2g8PXa_ANbz-972l93J87TRYTgFt9JXwvaesB7U0j-Ao7IvwfvBApylhyBdU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NZTUL3aENDnqbmddfs33Di9Njc6Mw5GzthjNq6gVP0w&oe=6A0EF448"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHsj0Zj2kH0Q7kNvwFjd-fT&_nc_oc=AdpGq9CQFgcTJMWwaHPnIkoPUkaOCY8dLJF2RnhdG3RHr7SSXdde-7QVqoMNfKcO9nE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TuWqmAGqzm9Oa0oiDgmgJj_zeOVxdJUQKIMvnR4wWLw&oe=6A0F0EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmWPQfCsQ_MQ7kNvwFIewhY&_nc_oc=AdpNvSbyzt4MXOOjm6Am4rRcgoIarP7xa40QNIp_KstGNsJub2PCWybBS74CsonO678&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QYRFAYUZAQf4zWywRyP0pxKGwhireo-voJnNrxTCX8A&oe=6A0F027A"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
 "625542963453561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_625542966786894_1402263989425948881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZngglColpUQ7kNvwE5zU5X&_nc_oc=AdoIYzEXWnIut4JGj3leA45IQDNZL-WJqKHkNIf4NI2ASRqJAkD9wjPegS04A1JIGb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mxGfYyTz3aS01mFpkwWOHCrPBQPUzlMk3JnXilDa-Nw&oe=6A37DF32"}]}, "id": "663495843018773", "locale": "en_US", "screenshots": [{"file_name": "almasdisk_still-03.png", "id": "1287220066160925", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_1287220069494258_4455351246127430293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TERv3jF0lccQ7kNvwFG0X7h&_nc_oc=AdpPGtiBLlci328hPFgc45Ndyfo1jY_Yij-V6GTU6CEeSY4jGfw1unt5ZT1tASGnT8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87I0KMLjnQXABRDEJALg0bimG2eJCpWOlXpeOJk-LSDA&oe=6A37E412"}, {"file_name": "almasdisk_still-02.png", "id": "1312911423095900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1312911426429233_8021725242682163770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkANwXcYBVIQ7kNvwFgrAMy&_nc_oc=Ado8g0qMgMjnh9utuQPiVXM1-4SlVQnaAOKHTdW7-tZTwjUBGCISYOz0GrGBly6iipk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MAfJpgXG92HWGyO-usiMZ9taQqZ0_QBFD8tscNnTfcA&oe=6A37EE8D"}, {"file_name": "almasdisk_still-05.png", "id": "1213259170222572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1213259173555905_3078244163518727811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAoJiqbfC0gQ7kNvwH_gwHg&_nc_oc=AdpafbmYfM2dK_jg_Kk-oUUw1xEziODJ9ow9LKuQEURQJ_buOUb7JqQaty0ze0S-rJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vip8lc_saGgMVdjoFXw1gtoD5ONekwg4MVfUiwpux7Q&oe=6A3801C0"}, {"file_name": "almasdisk_still-01.png", "id": "633960766460735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_633960769794068_6262819144675741415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTbs7_UU5nwQ7kNvwH0y_ol&_nc_oc=AdoL9jabzECsfFdFvhz82Jas9C8CZbSB9WxOO-lbsD8viznvmBywa4wv2pq-mny5m_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GWbYeKp1y11PPxMqKh7mQ-whrNcNbE6A1BHjel7DMLQ&oe=6A380B08"}, {"file_name": "almasdisk_still-04.png", "id": "1359288438560656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1359288441893989_7541015039161468262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rawqNfy3J3IQ7kNvwE8ttcU&_nc_oc=AdqPzeI8vKPrPat7L_E2R9WtfSVD5TBnHU8m4R5qNTKYXW12kTAustMzeNE4KyjBkyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q1cPa8W0zPNFIbddU2sLP3QnwbM_1p0cETpVGlNCGKA&oe=6A37ED63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "almasdisk_trailer_cover_2560x1400.png", "id": "1376204146699152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1376204153365818_505638764312966618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfSAqNzR9joQ7kNvwEJbvz9&_nc_oc=Adr11QK2FJkKKHqyJiGZnchLEvNwEfKga_4X1OGl-MxjgbA_BCYGq2qm81_SDF82d08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f-MWLCIjTTZPh8UvBA-4nNeyUQVdYQutAeBf-yqD7sQ&oe=6A37E0FA"}, "display_name": "Alma's Disk: Episode 01 - Atom", "keywords": [], "long_description": "\"Alma's Disk\" is an immersive VR learning experience that explores the composition and structure of Bohr's atomic model. Players can move freely within the inside of an atom, similar to a \"sandbox world,\" and use various tools such as magnets, magnifying glasses, scales, and calculators to investigate the different elementary particles of the atom, along with their properties and structure.\n\nThe results obtained are gradually entered into a logbook, which is structured like a mind map. It's the player's task to independently use the various tools for the different elementary particles of the atom to achieve the goal of completing the logbook.\n\nOnce the logbook is complete, the periodic table is unlocked and the atomic structure of all elements can be explored.\n", "short_description": "Alma's Disk: Episode One - Atom is an immersive VR learning experience and the first entry in a series.\n\nDeveloped to archive and preserve essential data records, Alma has suffered memory lapses that have fragmented her storage disk. \nNow it\u2019s up to you to help her recover the lost data by exploring the world of atoms, closing her memory gaps, and restoring valuable knowledge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/almas-disk-atom/startseite", "developer_terms_of_service_url": null, "publisher_name": "Raumkapsel", "support_website_url": null, "website_url": "http://weltenzimmer.de/almasdisk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9290064044408673"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "32779911078291123"}, {"status": "PUBLISHED", "id": "1192707215604822"}, {"status": "PUBLISHED", "id": "2740660346128949"}]}, "baseline_offer": {"id": "32779911078291123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765361340, "status": "PUBLISHED", "id": "32779911078291123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
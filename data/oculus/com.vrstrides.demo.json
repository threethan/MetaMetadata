com/v/t64.5771-25/491823757_2416800745813577_7219342449479063139_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byKxvSwtHyEQ7kNvwH2w32n&_nc_oc=AdoMVakbW_MEcl0VaAt6Wj5MZvJuGOlfopXmt9QyGfzx9YFr71Y9ySOPe6HsTptQigE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPylb3gZfl3F8BQIVBMbIDY0foLanItPySM6rDfLRpb8A&oe=6ACD19C2"}, {"file_name": "02_start_line.png", "id": "1607566237770533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_1607566241103866_706671957305580633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c5IXsf89j8Q7kNvwFJvT31&_nc_oc=AdoKwa19_vAawZJuSUiLS5fvYCcN7JjElti8u7gemjeWV_lvR-qODyUkEduBWILrmv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNjkLUbcC_BYxZ4OL1EL4eMnYa9dRDDt2ymKUxRvkxfw&oe=6ACCF34A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "00_universal_vrc_logo_2560x1440.png", "id": "932498279324221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827973_932498282657554_1656482385832638663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeHkzFsCrTMQ7kNvwH3Zu9W&_nc_oc=AdqyWde-rIYG9PZ84QgcisXM8GNBCNjL0Bd06PC7SxlbG33hPU8b7Hnw_jAW_ejvY6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhiqG6ZyZGNCqjstctZSrIY9sVh1C9few18NZCS10hxg&oe=6ACD1533"}, "display_name": "VR StrideS Demo", "keywords": ["jogging", "fitness", "running", "movement", "locomotion"], "long_description": "# Move with your body\n\nVR StrideS turns jogging in place into movement in VR. It reads motion from your headset and controllers, nothing else.\n\n## Standalone demo\n\nThis free demo runs directly on your Quest:\n\n- No PC or additional trackers required\n- One night forest trail\n- Guided tutorial and a timed lap\n\nAn internet connection is required at startup to verify access.\n\nPut on your Quest, set a clear boundary, and start jogging.\n\n## How it works\n\nIt is not just head bobbing or arm swinging. While you jog, the app reads movement from your headset and controllers together to estimate both your pace and where you want to go.\n\n- Jog in place to move and control speed.\n- Use natural head and hand movement to indicate direction.\n- Move forward, backward, or strafe without touching the thumbstick.\n- Keep using your controllers normally, even with a two-handed item.\n- Adjust Effort from a gentle jog to a committed sprint.\n\n## The full product\n\nThe full VR StrideS product runs on a PC and feeds movement into your own PC VR games as ordinary thumbstick input. That requires a PC and a linked headset and is not part of this standalone demo.\n\n## Comfort\n\nThis app uses artificial locomotion driven by physical effort. You will jog on the spot in a confined space. Set up a clear boundary, begin with short sessions, and stop if you feel unwell.\n\nLearn more at vrstrides.com.", "short_description": "Your body is the joystick. Jog in place to move through a standalone VR trail, no trackers, treadmill, or PC required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrstrides.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "gnuj industries", "support_website_url": null, "website_url": "https://vrstrides.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1302140486315339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.ocu
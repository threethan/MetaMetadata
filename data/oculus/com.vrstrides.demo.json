e.png", "id": "1817860802541271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1817860812541270_2435183173882904315_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eelGsR7mD18Q7kNvwFVQjrU&_nc_oc=AdoaCtLgfFe4SPP4HtTjk75E1SiVoU6-L9gCOZaYuulq_UTVsdnoykG8_v2o2Nlwtt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxTmrtWThaPpXWJvlss064e7rpchIQqTJjB9-ShSHs9Q&oe=6AB3D03E"}, {"file_name": "04_gate_run.png", "id": "1166055282541296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1166055285874629_6444550180844003618_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdKZeaSxsxQQ7kNvwFkL6Id&_nc_oc=AdoCUfLZo4q51MZc2eLy3U8A1NnENi2CNGoN4Yxo-MZJa4JKNCFFQJSx9tnPYazJKe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWAsP1DoOoSNPdX3QYziY7weqYRtWqy0amE2CVRDfkvg&oe=6AB3C56C"}, {"file_name": "01_moonwell_deck.png", "id": "2416800742480244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_2416800745813577_7219342449479063139_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KqkGpHasQAQ7kNvwHLYbC8&_nc_oc=AdqHVpMjbnxcJj-mk-e3dAJjrhzZFEQHCerejd7QLuWxvxP0FKYMsGF5cBDzwDKmmkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7AycqUlXGBv1BuDWwx5IyspUHghwdOkypyvf5qmA-Vw&oe=6AB3D502"}, {"file_name": "02_start_line.png", "id": "1607566237770533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1607566241103866_706671957305580633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3AwPZ8Q-0QQ7kNvwG7sOGw&_nc_oc=Adq9Mm48jWvdUUH8hifOnIkDLrk0caeo4sYnldDJfm8Tfod7sZZWUsOVJe21CoKtSMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqxrSiveGIWHJ5YeDPONhwn-PR0-jurV40aZfkwXKEYQ&oe=6AB3E6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "00_universal_vrc_logo_2560x1440.png", "id": "932498279324221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827973_932498282657554_1656482385832638663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88DoZmPhAW8Q7kNvwGV_ylw&_nc_oc=AdobZqdGx0svCgT6qoggcXVUj5abSu3G82sW-z0RMf6VZy0C7ZQd9qasCeXOk9p9sgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgeQmMtU_bsi8gIBTyxkcFP0oT0NaQ5S5_ACysfBf5xQ&oe=6AB3D073"}, "display_name": "VR StrideS Demo", "keywords": ["jogging", "fitness", "running", "movement", "locomotion"], "long_description": "# Move with your body\n\nVR StrideS turns jogging in place into movement in VR. It reads motion from your headset and controllers, nothing else.\n\n## Standalone demo\n\nThis free demo is fully standalone and offline:\n\n- No PC, account, or internet connection\n- One night forest trail\n- Guided tutorial and a timed lap\n\nPut on your Quest, set a clear boundary, and start jogging.\n\n## How it works\n\nIt is not just head bobbing or arm swinging. While you jog, the app reads movement from your headset and controllers together to estimate both your pace and where you want to go.\n\n- Jog in place to move and control speed.\n- Use natural head and hand movement to indicate direction.\n- Move forward, backward, or strafe without touching the thumbstick.\n- Keep using your controllers normally, even with a two-handed item.\n- Adjust Effort from a gentle jog to a committed sprint.\n\n## The full product\n\nThe full VR StrideS product runs on a PC and feeds movement into your own PC VR games as ordinary thumbstick input. That requires a PC and a linked headset and is not part of this standalone demo.\n\n## Comfort\n\nThis app uses artificial locomotion driven by physical effort. You will jog on the spot in a confined space. Set up a clear boundary, begin with short sessions, and stop if you feel unwell.\n\nLearn more at vrstrides.com.", "short_description": "Your body is the joystick. Jog in place to move through a standalone VR trail, no trackers, treadmill, PC, or internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrstrides.com/privacy/", "developer_te
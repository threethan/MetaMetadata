e.png", "id": "1817860802541271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825546_1817860812541270_2435183173882904315_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eelGsR7mD18Q7kNvwEDcLXT&_nc_oc=AdraZyMlmNSF91imTGnCehxTI41eQ-lGdT3Q9V9iiW0aTzDNE9F55rtBfXdCBqdjp3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiUFJvIr4SPus_W-mTD_zD1KSIQNwJHAkxCcLSTn3l1A&oe=6AB27EBE"}, {"file_name": "04_gate_run.png", "id": "1166055282541296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823905_1166055285874629_6444550180844003618_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfnGYC14Os0Q7kNvwFRemEg&_nc_oc=Adr7u67_Cth0j7TnDDUGULLS1ygKutYSk53647fwSVq0D_TFlq5KNAfpxR2fmFDlFvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMsYrQvEgtYt79hW1YQECDNnU83uVsdUauFr-fw32ksQ&oe=6AB273EC"}, {"file_name": "01_moonwell_deck.png", "id": "2416800742480244", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_2416800745813577_7219342449479063139_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZaLqr2VoHsQ7kNvwGm_L0T&_nc_oc=AdokI9lRNC5VGlqBaQKdJ37YWiKQDcz0LnOsXoZMTKFm3kmk9cG95dTr-59m-6v9XEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW7QuuaCinPX_o4uI_6QpmAs0nuhAuoAopeXkWGv9qBw&oe=6AB28382"}, {"file_name": "02_start_line.png", "id": "1607566237770533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_1607566241103866_706671957305580633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiTSrJr1SowQ7kNvwHaecMC&_nc_oc=Adp0rw5UwutWXJPGuPqGKS0i-xsInlEjz2NcfARw12TfZ3sTsmbRIS2EaOOvbP-YF0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGVIExMixglWuiHfX6xL4CXAARB4x_2OI3nT1_WR2obg&oe=6AB2954A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "00_universal_vrc_logo_2560x1440.png", "id": "932498279324221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827973_932498282657554_1656482385832638663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88DoZmPhAW8Q7kNvwGhNGqX&_nc_oc=AdrPLvqydEXExIJvY084lD6GHVFuTofWxxVkGThN-JK-dvrKYIm3upuJ_sZRFFqgABc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI71YHsMkTlsNwXXdWwm1H1cdVOyrHSdLIyKm2CkPPSRg&oe=6AB27EF3"}, "display_name": "VR StrideS Demo", "keywords": ["jogging", "fitness", "running", "movement", "locomotion"], "long_description": "# Move with your body\n\nVR StrideS turns jogging in place into movement in VR. It reads motion from your headset and controllers, nothing else.\n\n## Standalone demo\n\nThis free demo is fully standalone and offline:\n\n- No PC, account, or internet connection\n- One night forest trail\n- Guided tutorial and a timed lap\n\nPut on your Quest, set a clear boundary, and start jogging.\n\n## How it works\n\nIt is not just head bobbing or arm swinging. While you jog, the app reads movement from your headset and controllers together to estimate both your pace and where you want to go.\n\n- Jog in place to move and control speed.\n- Use natural head and hand movement to indicate direction.\n- Move forward, backward, or strafe without touching the thumbstick.\n- Keep using your controllers normally, even with a two-handed item.\n- Adjust Effort from a gentle jog to a committed sprint.\n\n## The full product\n\nThe full VR StrideS product runs on a PC and feeds movement into your own PC VR games as ordinary thumbstick input. That requires a PC and a linked headset and is not part of this standalone demo.\n\n## Comfort\n\nThis app uses artificial locomotion driven by physical effort. You will jog on the spot in a confined space. Set up a clear boundary, begin with short sessions, and stop if you feel unwell.\n\nLearn more at vrstrides.com.", "short_description": "Your body is the joystick. Jog in place to move through a standalone VR trail, no trackers, treadmill, PC, or internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrstrides.com/privacy/", "developer_te
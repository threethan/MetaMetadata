TJA2a5blhprAf3layewIsux2tUi2XucuFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CSlLEPwsCGkr7fxp-K6aLaK9jedqVJelrjm5LrFGwwg&oe=69D51696"}, {"file_name": "5_dukovany_ss4.png", "id": "754714936113487", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_754714939446820_4895062985324465723_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02KhKpYQWzIQ7kNvwHE9IYT&_nc_oc=AdpuaS8LSxeT6GSnZE4jc3rf7PP7tV4fWfdDY7XsenqVt5BNW5mqTwC1Q3TqJ6Vgjv4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z97Rjw-Rng8UJ-w2gCFaBSAXeYi78ft2Y1AVKxNnd6A&oe=69D4FF41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_dukovany_ss3.png", "id": "200687256153289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251818_200687259486622_9163713063267919662_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_Fua_YnyKEQ7kNvwFTThh8&_nc_oc=Adpuo4gsolafCPpozIyrujCGI-k1NNbt82LvSQrNRv13O4u9UpQiJAcO1i2MrS_ZcMs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b7JPwEaxPpXau-DZ3xbu01Vu5brgeCFcR0JV3j8TltQ&oe=69D4F90A"}, "display_name": "ReacTour", "keywords": [], "long_description": "Have you ever wondered what goes on behind the scenes in a nuclear power plant? The Reactour 2.0 is an epic cinematic experience that invites you to explore the highly secured facility of the Dukovany nuclear power plant in the Czech Republic. Designed to amaze viewers of all ages, the virtual reality tour entertains and educates in a fun way, featuring hand-tracking and interactive elements.\n\nJoin your guide, a witty android employed at the facility, on a fascinating journey through controlled areas with limited access, reserved only for those with the highest security clearance. Choose the topics that interest you, and test your knowledge during a quiz game. Learn about the magic of nuclear fission as you play with the holographic 3D model of a nuclear reactor.\n\nEnjoy the view from the top of a cooling tower, captured in cinematic VR as if you were actually there. Meet the staff responsible for maximizing the safety and reliability of the nuclear power plant's operation and discover why nuclear is the cleanest energy source of the future.", "short_description": "ReacTour 2.0: The Interactive Nuclear Power Plant Experience\n\nA one-of-a-kind cinematic experience in virtual reality will take you on an interactive tour through one of the most fascinating places that are forbidden to enter: a nuclear power plant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersive.cz/privacy_reactour.html", "developer_terms_of_service_url": null, "publisher_name": "BRAINZ IMMERSIVE", "support_website_url": null, "website_url": "https://immersive.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1692068727929977"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "830557522672174"}, {"status": "PUBLISHED", "id": "772376104470102"}]}, "baseline_offer": {"id": "830557522672174"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761667860, "status": "PUBLISHED", "id": "830557522672174"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9137126326355176", "version": "1.0.5"}, "id": "580308343960336", "channel_nam
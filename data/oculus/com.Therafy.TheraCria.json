9R_z529MFVsfu3b8VorKL1EVK1Fx5fmWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U36J049dOzX3SzoaIt-8Zfe-5-s9l2Bkx2aoIYZklIg&oe=6A37DE56"}, {"file_name": "Design sem nome (12).png", "id": "1235737281830690", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311582_1235737285164023_5436835542733124372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiG42I0ejG4Q7kNvwGOJQjW&_nc_oc=AdqiXEqN6YG8mNkxueooFbtjCWdCmRRr8GHYKCiyPPOqDWrrUWe5Rl7MPJnKNZRoXN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QTEZXATQBlLAytbpjL6zE7NCpXjOFIR_Aow-odb4yfA&oe=6A381167"}]}, "id": "987424820943496", "locale": "en_US", "screenshots": [{"file_name": "Design sem nome (10).png", "id": "1022210530153895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313074_1022210533487228_2651047037051783946_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PubZujezT2wQ7kNvwHwcHr0&_nc_oc=AdomP665Fi9NhXAmJqcQ8MZnXTdNJoQOzfDPSW4yzgiOw_Ss7wyMb2PzGULDaOfF-xI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vj8oT97Ste9VsGqakMhlmDWhOgqP6MpMakfOcYjUvqA&oe=6A380371"}, {"file_name": "Design sem nome (9).png", "id": "969812959380614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310720_969812962713947_7068261688455937488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y2UIthu_hsQ7kNvwGfPBCa&_nc_oc=AdrRB9GBoPElvTT8T4iPgE6pVgoMC-gQNL-JS52B69gB88rwAd_X6Eyquj6AUL_h3tQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zvQ43aASb53YlL8JnehTFw4qMT_-JstkhfqXynkbDvQ&oe=6A37EC26"}, {"file_name": "Design sem nome (8).png", "id": "4537763039825784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303707_4537763043159117_2433044749603132698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z5_VjlLTjIQ7kNvwHVMLjL&_nc_oc=Adq5ImPyZowfaRi22rFbFbnOJes1O9rUnptoSBgAT8JqieH_k6-3OM5tz-KxLXB4zjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yJPIjx8kkHh8VZOhOKR-y_ugrcXHLgqibKCQMX9FeWA&oe=6A3804EE"}, {"file_name": "Design sem nome (16).png", "id": "2255375741881396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673645340_2255375745214729_6347166107100214665_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtbANZMHeG8Q7kNvwFLpPTz&_nc_oc=AdoB4R134J4MT9Bq9IMt9TKYSoeTAgcw4eMcML7S4a-F7boqIZPFP8RbNUKuO4WFgDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R_rOkwwU2KBhTKheb8yrIBTrVYaXGq7MWRsWzoB6Trw&oe=6A37E33C"}, {"file_name": "Design sem nome (15).png", "id": "897356223393001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303769_897356226726334_320923964864377045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWNz090VdgMQ7kNvwHUZFbq&_nc_oc=AdoBxI0E2t3_-7Wtas-kvklM6n93WCK0t_AKIGU5pil_HGrzux_ACzhWEEcAxv3C0Yc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80ae71fwxKwXi7PvN7bBSczRm6qJrHptuFdiJPJjWnUA&oe=6A3802AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Design sem nome (8).png", "id": "1005390025322116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1005390028655449_3287465296250224746_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzXG8F20E4IQ7kNvwGqmju4&_nc_oc=AdpWTCYVxPd9zcyWlxIwTgxwbnme99hF5JQYjl-ACJLH0GHm2EIoYvGqQ7K4iuN4idQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DGnyXyYuCanGZL5DGldxEcz-m2udutWFVcPwdtEP7Rw&oe=6A37ECC3"}, "display_name": "Thera Create", "keywords": ["painting", "color", "brush", "therafy"], "long_description": "Thera Create: Unleash your creativity in Virtual Reality!\n\nThera Create is the next evolution of VR art, bringing an intuitive and immersive experience directly to your Meta Quest. Forget physical limitations and turn any room into your personal studio.\n\nFeatures that transform your creative journey:\n\nNatural Hand Tracking: Experience the freedom of creating using only your hands. Our advanced tracking technology lets you draw and paint fluidly, removing the need for controllers and bringing your movements closer to reality.\n\nComplete Art Kit: Master your style with a full set of professional tools. Easily switch between pencils for precise sketching, pens for bold lines, or versatile brushes that simulate different textures and artistic effects.\n\nEndless Paint Palette: Explore a limitless spectrum of colors. Select your favorite hues and customize your palette with ease, ensuring your artistic vision comes to life exactly as you imagined.\n\nColoring Library: Looking to unwind? Dive into our extensive collection of drawings ready to be colored. It is the perfect way to de-stress, practice shading techniques, or simply have fun.\n\nPersonal Gallery: Your creations are unique and deserve to be preserved. Save all your work in a digital portfolio, allowing you to revisit, continue, or admire your art anytime.\n\nThera Create is recommended for people above 13 years old.", "short_description": "Transform your space into an infinite art studio with Thera Create! Use your hands to paint in VR with total freedom. Choose from pencils, pens, or brushes, explore a vibrant palette of paints, and relax with our collection of coloring templates. Save your masterpieces in your personal gallery and let your imagination run wild\u2014all without the mess. Thera Create is the perfect immersive experience for all ages. Your canvas is waiting: create something incredible today!"}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "2488085508374747", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313105_2488085511708080_3989357650805544939_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSWasGFg4ogQ7kNvwHoDXID&_nc_oc=AdqkmnSFPtD9WdpmqmtF_JkxzHgblswnIoV_AuZ193m7ul2-F8OsKCU7TjAlVhOQ-0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AIojKJv3oqKEjbHX2pwKLE2jwdgJlUqzCEg_kx7CluA&oe=6A380960"}, {"file_name": "Desig
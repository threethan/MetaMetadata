esign sem nome (9).png", "id": "1717545602897781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299928_1717545606231114_3829077451109774631_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKyCHtGyzp8Q7kNvwHlAJHA&_nc_oc=AdrB1X6iL9CM38LGwlVwTs6kdhsN-Pq5OmKKSSyjwBRePct6j0iWjaZsRSTNzKegKec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DFWZfLZKTg2n_R12g2N44RIxO4ZHlalE_ZJa5R3GcIw&oe=6A37EDD1"}, {"file_name": "Design sem nome (10).png", "id": "1539432394494024", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302344_1539432397827357_3905833770671908310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33aHjPCwiS0Q7kNvwFcYDYr&_nc_oc=AdoILz5KYqOJ2oxBIqOvz66EjZRFYvnBmVYCXyn3ScULsZmkjb8nX7aXWhK9aUzr5rY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af957-5OrcPD7XpFQtBlQV3aZmIATHQn96WhWSvl-dN2yg&oe=6A37F2C5"}, {"file_name": "Design sem nome (8).png", "id": "2121566395089797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307352_2121566398423130_8512543592502638280_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HXYR3vfrSUQ7kNvwHyhXP1&_nc_oc=Adq78_YIVaPSZTxhDTcc_P5AIc3inFdXp6nLBCFuKt_s7frWTnF1KX2gzOVi7e6hG60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bh6lusUoh2DUttCpajJx38ADiyiIDjmli8QaCzxIUrg&oe=6A380A4F"}, {"file_name": "Design sem nome (16).png", "id": "1557118002650405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593790560_1557118005983738_1248094122242113568_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfAlvjyTOl4Q7kNvwE4viqH&_nc_oc=AdoUvIzU_EIOkXw37Desjz8ak0eCKQwkiy0qfdvghaYwNltmRieRGOky9baq1a065sI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CwQO4VsUtxTdmEPXdtiUUi8iMgP_YbOvPkfSFojX_OA&oe=6A37E429"}, {"file_name": "Design sem nome (15).png", "id": "1376464717874845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620530_1376464721208178_3904208223643941968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibdp2mc5YHEQ7kNvwGp-Pja&_nc_oc=AdrQFg4E68oxrJe1JafT8ux0gDfc81c-QlRbXF8x_AR7XYJmLktEMS_UFDRX5LHtfIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Aq5u6-KH103_jRr5gVghzvGqynSKYml4A3T6yWJkY2A&oe=6A37F638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Design sem nome (8).png", "id": "974066982265644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_974066985598977_1776042439934654065_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNAXjBxGk38Q7kNvwHQw08t&_nc_oc=Adpl3CkUkywDWAqJ-esQKyFv27grDjlgzyPrke-wHJ2zGxHQ4fIMy1wPhK1OKyzOCaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_5LYYZ3gFp1uG7KuxtnEXbOPh1x1IrI__762DvhB1MQ&oe=6A3815A7"}, "display_name": "Thera Cria", "keywords": ["pintura", "tintas", "colorir", "desenho", "therafy"], "long_description": "Thera Cria 3.0: Liberte sua criatividade em realidade virtual!\n\nO Thera Cria 3.0 \u00e9 a evolu\u00e7\u00e3o da arte em VR, trazendo uma experi\u00eancia intuitiva e imersiva para o seu Meta Quest. Esque\u00e7a os limites f\u00edsicos e transforme qualquer ambiente em seu est\u00fadio pessoal.\n\nFuncionalidades que transformam sua experi\u00eancia:\n\nRastreamento de M\u00e3os (Hand Tracking): Sinta a naturalidade de criar usando apenas as suas m\u00e3os. Nossa tecnologia de rastreamento permite que voc\u00ea desenhe de forma fluida, eliminando a necessidade de controles e aproximando sua experi\u00eancia \u00e0 realidade.\n\nKit Art\u00edstico Completo: Tenha controle total sobre seu estilo. Alterne facilmente entre l\u00e1pis para esbo\u00e7os precisos, canetas para tra\u00e7os definidos ou pinc\u00e9is vers\u00e1teis que simulam diferentes texturas e efeitos.\n\nEscolha de Tintas: Explore uma paleta de cores ilimitada. Selecione suas tonalidades favoritas e personalize sua obra com facilidade, garantindo que sua vis\u00e3o art\u00edstica ganhe vida com perfei\u00e7\u00e3o.\n\nBiblioteca de Colorir: Buscando relaxar? Explore nossa ampla cole\u00e7\u00e3o de desenhos prontos para colorir. \u00c9 a maneira ideal de desestressar, praticar novas t\u00e9cnicas ou simplesmente se divertir.\n\nGaleria de Obras: Suas cria\u00e7\u00f5es s\u00e3o \u00fanicas e merecem ser preservadas. Salve todas as suas pinturas em um portf\u00f3lio digital acess\u00edvel a qualquer momento, permitindo que voc\u00ea retome projetos ou admire suas conquistas.\n\nO Thera Cria 3.0 foi desenhado para ser acess\u00edvel e inspirador. Seja para um momento de foco art\u00edstico ou para relaxar ", "short_description": "Transforme o seu espa\u00e7o em um est\u00fadio de arte infinito com o Thera Cria!\n\nUse suas m\u00e3os para desenhar e pintar em realidade virtual com total liberdade. Escolha entre l\u00e1pis, canetas ou pinc\u00e9is, explore uma paleta de tintas vibrantes e relaxe colorindo desenhos exclusivos. Salve suas obras favoritas em uma galeria pessoal e solte a imagina\u00e7\u00e3o sem bagun\u00e7a. \n\nO Thera Cria 3.0 \u00e9 a experi\u00eancia imersiva perfeita para todas as idades. Sua tela est\u00e1 pronta: crie algo incr\u00edvel hoje!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1jLr2iUCyRdNdGOFK3KNkiD1V1dgZBi-y/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Therafy", "support_website_url": null, "website_url": "https://www.therafycare.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36916372704612720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1817986962510835_5354721074871286112_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih-Fdz2YHDIQ7kNvwF5qLL9&_nc_oc=AdoggKB9RZUylcloLkiJZ28cRXRk-rzpeg1E7BJGC2JWj-fAqbOhAjLbCamHy04q8Ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fZIQmp8RBl1B7VSsNh2Kwox8izSKuFEkFuswS7YCa_w&oe=6A37FC26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thera Create", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1781617080, "lastRevision": {"nodes": [{"id": "35040737458842930", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35040737318842944", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2096137424306200"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1817986959177502", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1817986962510835_5354721074871286112_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih-Fdz2YHDIQ7kNvwF5qLL9&_nc_oc=AdoggKB9RZUylcloLkiJZ28cRXRk-rzpeg1E7BJGC2JWj-fAqbOhAjLbCamHy04q8Ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eNCOoezhRtgr1u082ADMi_5731gKdsmmY94v68Hb02w&oe=6A37FC26"}, {"file_name": "Design sem nome (5).png", "id": "1577016420664593", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303606_1577016423997926_761941
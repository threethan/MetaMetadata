xIus9CZYU51N-MAxxBCcLeUjGx3V2yvgc9NZXBvvNZFryNz4lTQ8puE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAW0P8iqDpTwcs-wt1q3GW3dNF8x3tHdv4g_AkqUGGAg&oe=6AF8AF65"}, {"file_name": "screenshot02.png", "id": "1609538480763259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593862973_1609538484096592_3712289591921604548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhFILcwsnE0Q7kNvwGLH-lf&_nc_oc=AdqIbjLTS-JaKMisy7_7kLKBW9bv0P2w8XPO5439CkvI1qIPPFzizlGi6On267RcQGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_qd0WHXpMQC2E6eICaSmI89GOGgn6cllMBOHtmfK0_A&oe=6AF87F0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Service", "keywords": [], "long_description": "Room Service turns your real room into a cleanup adventure. Using mixed reality, the mess appears right on your own floor and walls Toys under your feet, laundry in heaps, sticky grime, and cobwebs tucked in the corners.\n\nEvery level brings a new mix of mess, each with its own bin. Toys go in the toy box, trash in the bin, and laundry in the hamper. Grab any bin by its handle to drag it and turn it wherever you want it.\n\nClean like you mean it:\n\u2022 Laundry that drapes, swings, and flops like real fabric\n\u2022 A sponge and bucket for scrubbing grime. \n\u2022 A vacuum for dirt, a mop for spills, and a duster for cobwebs\n\u2022 Watch out for the toilet emergency. Plunge it, flush it, and scrub it clean before time runs out\n\nPlay your way:\n\u2022 Race the clock, earn stars and points, and climb the leaderboard\n\u2022 Play with no clock, just tidying at your own pace\n\u2022 Use Reach Assist to get a grabber claw that helps pick things up off the floor\n\nRoom Service works best after Space Setup, so the mess fits your room and stays clear of your furniture.", "short_description": "Your room just called for service. Sort toys, trash, and laundry, scrub the grime, dust the cobwebs, and save the day in a mixed reality cleanup that happens right in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://befuddlebug.com/privacy_roomservice.html", "developer_terms_of_service_url": null, "publisher_name": "Befuddle Bug", "support_website_url": null, "website_url": "https://befuddlebug.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1436898616167758"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_1697544191795884_7864010696344122479_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9CIru0kqNYQ7kNvwFx-q3t&_nc_oc=Adqk_QN_VHP1DTcaXQNYAKva4W-ceiWMpA3cXz4HJ9zRVVrX-xs0aau51-WZBDhP0OU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw6p91oAKLxEKr2oS4NRY644c4qvuLNjS1LOsFiyTjdg&oe=6AF8798B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Room Service", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1792774800, "lastRevision": {"nodes": [{"id": "1394038347120452", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1394038333787120", "is_first_party": false, "enables_in_app_ads": 
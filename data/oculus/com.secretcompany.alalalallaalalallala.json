8_790905938170789430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUUhaxzg86QQ7kNvwGf-f4b&_nc_oc=AdloH9BpMPiix2zd-F6JxTaIvx62HW9ImN1H9u5GhIuMvqj5opQMP1de9Fgx1ECM7UA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-CbItMAEtnRD8kz-gOF35PE-Pm-0OQHn42k3kiWhuiA&oe=69AAD942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "1300155881098866", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393450_1300155887765532_7735691407181548782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqIXrFlq5-MQ7kNvwEQ2V2S&_nc_oc=AdnYQ_0-80ZdDI8imh0iBQPNUAVM_RfYb-azfcVv_JX84o340rTXzEhpXtPhCN_Wdo0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzmP_Vr6NQ7qaT_Q8zUq-Xp-xBn9Y2y6pVmzcQ8RbBuw&oe=69AACB11"}, "display_name": "SECRET TAG", "keywords": ["training", "competetive", "hard", "monkey", "secret"], "long_description": "This game is a unique training experience with a little secret \ud83e\udd2b. It features one of the coolest locomotion systems in VR, designed to make movement feel smooth, immersive, and incredibly fun. You can use it for daily training to improve your skills, whether you're practicing agility, speed, or control. Perfect for games with gorilla-style movement, this game helps you master the techniques needed to become faster and more precise. Plus, there are hidden surprises waiting to be discovered as you train! \ud83d\ude80\ud83e\udd8d\ud83c\udfae", "short_description": "This Game is a Training game with a little secret\ud83e\udd2b"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/secret-tag-privacy-policy/e5cabff8-516a-485c-81e7-06d8b696d3fd/privacy", "developer_terms_of_service_url": null, "publisher_name": "Secret Guy", "support_website_url": null, "website_url": "https://sites.google.com/view/secret-tag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "27433260
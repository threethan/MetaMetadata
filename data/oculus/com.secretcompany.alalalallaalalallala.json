/v/t64.5771-25/473393164_1649103559326208_790905938170789430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxKYdgvvKiQQ7kNvwGxpuTF&_nc_oc=AdptXBYOz1TZbOlEW94ysYZU7q8UWcfq2ebMF9nfwgHyNMe2lDolT2DRamquAvJZcH0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIPPSaWaLEQZYdWvHONotZWjCTCGgzxpTRK5-cFdj_Cw&oe=6AEC8742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "1300155881098866", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393450_1300155887765532_7735691407181548782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1eBl5I1o78Q7kNvwF59XKi&_nc_oc=Adr-DHPFvgZTcyUZvWPHgmJl61RKTL_EthxGLoSZl-72o2ZzGqPy4b9pgjkaIsOvibo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSphaHRa5TSs-G0GR2AV8vYAKV9zHYjp_GYeOPi3d9C8A&oe=6AECB151"}, "display_name": "SECRET TAG", "keywords": ["training", "competetive", "hard", "monkey", "secret"], "long_description": "This game is a unique training experience with a little secret \ud83e\udd2b. It features one of the coolest locomotion systems in VR, designed to make movement feel smooth, immersive, and incredibly fun. You can use it for daily training to improve your skills, whether you're practicing agility, speed, or control. Perfect for games with gorilla-style movement, this game helps you master the techniques needed to become faster and more precise. Plus, there are hidden surprises waiting to be discovered as you train! \ud83d\ude80\ud83e\udd8d\ud83c\udfae", "short_description": "This Game is a Training game with a little secret\ud83e\udd2b"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/secret-tag-privacy-policy/e5cabff8-516a-485c-81e7-06d8b696d3fd/privacy", "developer_terms_of_service_url": null, "publisher_name": "Secret Guy", "support_website_url": null, "website_url": "https://sites.google.com/view/secret-tag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_t
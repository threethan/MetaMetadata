.com&_nc_ss=7f20f&oh=00_AQT9mqzmvklgn9TTN1t6K2IwABt8OTCeV2UUoFGs2JyLqQ&oe=6B05C157"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQjV_qL1RQcQ7kNvwHWVTvv&_nc_oc=Adp98ZTHQdTbTgTb9me63tVY049GGdT2b4i0AenwrRK6ZQ1Y4PC-kE6K3FcVw1FKo6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOfQCVU9ILZF5ccE6R9mvB8SdJF49cxz-tOMzNYYeVzg&oe=6B05B5F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJICatjN-i4Q7kNvwHd4QGV&_nc_oc=AdriC3qgNOBrNMLvzm0xL7V-bSgf-lHOA5HzNViaeH1fAKA6aEp-sG3OsVWwNdUXkNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7fD3uE6cSOTPG1wzhJ4xg0STO0nL_YOYJqHxdXqzvBw&oe=6B05B9A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
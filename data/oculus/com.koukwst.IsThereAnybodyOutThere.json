.com&_nc_ss=7f20f&oh=00_AQTyUmq_7f83lsFOR5q2CUzBC5pcWXVQZJPBNYlCnh_JyQ&oe=6AFC86D7"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtVnIurKRAMQ7kNvwElGgXh&_nc_oc=AdpjSFtxUgQpqrUV-gGmaICsaojCxOQpCcKLNLIm7DDpc5hAm_jEK6b5ngNrwNXAeaM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDtEox3EC7-qbbvu0y5QgmUFsKChiHv_UUNELcyzdvmQ&oe=6AFC7B74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SneaeVCe8fMQ7kNvwEZrtIW&_nc_oc=Adq134tsouqxwSuFexlXMi4W-NImDrEZW0igHsQSCBHJeFkXTFC9Lm782-keV74ipOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDkaoiL70XWV9CSL3hLsgJDK15GV78W3ZNdv1BJI2z3A&oe=6AFC7F25"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
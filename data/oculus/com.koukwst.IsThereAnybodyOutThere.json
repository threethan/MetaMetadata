.com&_nc_ss=7f20f&oh=00_AQRPbxNtNwLHMVTqJzeOuhh8tRhdP190mHZsTPzsZrtrzg&oe=6B031E57"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9PuBreLpVkQ7kNvwFdfrWe&_nc_oc=Adq38yUF_5bKMUmvkrDLNzUZI7bZMSxrBNKaQRzMlUyCFhfj-F5mMYodKGtaRNJV7pA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfussx7pEOn2RDHRkyjHxpPINap15Dt-isghnVDuUE-A&oe=6B0312F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QrnztGOFQUQ7kNvwHfgk-4&_nc_oc=AdqXmCfivUlb7Iax2Plhm5_Ze79brnziMr6NwfIL2qV_t386zMfEvvYTCoJV9BO6-hw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaZvbk7pU6FDOI2C4oT68_bCDTN4lXL_qMUVTdROvyzA&oe=6B0316A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
.com&_nc_ss=7f20f&oh=00_AQT-HgzQTuTXOG4Y_N-uU5KFwd5H3IjK54Yq04jhA4pxJw&oe=6B0712D7"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQjV_qL1RQcQ7kNvwH1AVmf&_nc_oc=AdqBCN-sFbk1FK78aLde9GCNu9Ey1BnmuFL7trm9ASjULaqO2YUYp3t1F10zCKClYbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7e22N-DN6uMDjGxLcHF7VFx-uvdLbdOz4NEqtHagZlw&oe=6B070774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJICatjN-i4Q7kNvwF_8cAq&_nc_oc=Adob1v3XP5OiO8oVlj_32q5yMD1i2EmH-yOm2ZmODlw2rsp6wP18ti8AT0fbz8pJqsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRMRHs6dE4nZrp86hTqHWc1qlFwffPqX5t0gbiaKq4bg&oe=6B070B25"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
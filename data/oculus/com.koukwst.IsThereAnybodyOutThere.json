.com&_nc_ss=7f20f&oh=00_AQR585Mz_XDuZwwYhT-4t1BWxVBtbxQAxeLHVkevVmKgPg&oe=6B086457"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-grZLc2CJgQ7kNvwHUtd0H&_nc_oc=Adrf4RFB0yqoInrAMbx4awWINGY3okNLQ8SUKLq-SgZuCvMY3kJ7nveDZx_nqu0l1qI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44dnnQZoS5a9W1GLzMlMUv5NVdQsHR62ELhVaHa7vpg&oe=6B0858F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzX7qlc-rNoQ7kNvwESznRE&_nc_oc=AdrMewP7JygP0tqbJkm7jiVMn9SL7wDZuN4Wf5dwd2tAEER-BnGpI7a0umTUPzaAVxw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdm5UjyuuwAmVX2hRgkB9QaRgDQSP3Vp9-r8wu75bdNg&oe=6B085CA5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
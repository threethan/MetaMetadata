.com&_nc_ss=7f20f&oh=00_AQQzg1EJzvkcXf1Fldk0vUNQE5s0gPW4O3XRTaE6X5uAqw&oe=6B007B57"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9PuBreLpVkQ7kNvwHF_ByE&_nc_oc=AdqhwKe7QAhGM2kCwWuKhusApkmoUBrbgMq-MixAJKc7fswl2Z2DQy6DmzRm_SqA4Q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjMD9MbPWzqS2SGUMdf0uIARVo8qzQLM-F3jBKFBxBuA&oe=6B006FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QrnztGOFQUQ7kNvwEfWs9P&_nc_oc=AdpJdk4lZz_7Sz6Zy9WAHoymVSwzolIFg4pobbEtiuRFHTlun3qx-FfiZz4thYkdUKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3dwb5_HvNgrboorW63Ox9B_owMfd7BTC_aoixeZib-A&oe=6B0073A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
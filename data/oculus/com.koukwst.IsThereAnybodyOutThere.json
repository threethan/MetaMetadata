.com&_nc_ss=7f30f&oh=00_AQVMvJnWUjEUSFmuAs_dxUGrPtVvRsmER9RkyYDnOWC96Q&oe=6B0EFBD7"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv0WFqc6P_cQ7kNvwHkAU2L&_nc_oc=AdrrZj26M_pv7nEbAO9fI5baK08f43GfRJ9YIPzAoFmO_3tytrp9cTODcERgMnUJZtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeKCUBZEFz3h77Rj2pXG-3T5h_qlcFFs6gGHiAMw7HOA&oe=6B0EF074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQw2W0z1z2sQ7kNvwFLLr1y&_nc_oc=Ado3QhE_xc-4YY-UschV5pNgiaIVGKQaHV0Xr2P0bInjnFswiOjMGq76iduOkiahf7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQUw7x6uLm9hoOcO1D09A3aDEBNLia3T5BbffRSpqClQ&oe=6B0EF425"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
4184832014", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1635264188165347_3255307565768521860_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY2H8yhVegUQ7kNvwFj02NN&_nc_oc=AdqgxopdoLpoWvM4GpYpAvH7JBkN641Y4vzEXUH-oAoqeINDmXNXvhmEyCljX7-WFCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1S2pB3duiPCbJEaTasHh1s2UandMUI0RS94eSN8NIig&oe=6AF5EF57"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON8yVLaRd1sQ7kNvwFQm-D_&_nc_oc=AdpPjMHtMHpTb73SjXV_Gd7cuV-RJMDoS2ZOMZhoRtbVtf7fkzaifEUCAUHQr39cYrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpyYeA1U3j8IZb9jSLG5rBbCYLR13dD1S3ULClDhEr6g&oe=6AF5E3F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT2PvDAOCwQQ7kNvwFHI0iV&_nc_oc=Ado0jzpaEjAykD8SJM87upgJmxaFMz-5oOonCiip6jAZ-J9AH3RfAcR4OUeRSCxxT70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuPiQzlZiwDtt43mbAh-WvllR7IOe40XnKCmPZvrszGA&oe=6AF5E7A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", "short_description": "A short narrative VR experience exploring isolation during the COVID-19 quarantine through environmental storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT5QdrbsP1J1QHwcQ3XR2Uj8dgRGDnGVzDusBQiKdr--5nVK8Af5Er9vAfRdERjSk29HIjF5Ulm5LLg/pub", "developer_terms_of_service_url": null, "publisher_name": "koukwst", "support_website_url": null, "website_url": "https://www.linktr.ee/koukwst", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1369658909553439"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1092623760391189"}]}, "baseline_offer": {"id": "1092623760391189"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789578000, "status": "PUBLISHED", "id": "1092623760391189"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1363103586875638", "version": "1.0.1"}, "id": "1689069385525471", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "
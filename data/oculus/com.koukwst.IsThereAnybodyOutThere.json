.com&_nc_ss=7f30f&oh=00_AQTL01CkYjWREnTbcJfn6Q57RD-BVM--bzcbcckpH3kQZQ&oe=6B0B3F97"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-grZLc2CJgQ7kNvwFoj_HM&_nc_oc=AdpE3O0SaC5lBxdTsXG1ngJ74B2OLWZEwOIu2p87gRefr-H68KB2n9Zmzb-xivU0t88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfnbOvuJAesKJce4gxY8AlRMSMTdZ4jvrodVepVG2TKw&oe=6B0B3434"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzX7qlc-rNoQ7kNvwFET__b&_nc_oc=Adr7N60B8i4SAqrzuRFLFQjHeILTVqImQWsU_7brg6n6N0_2ZiAC_waT6nbWSLRe3WA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQl-1LBw9oAOqQrJFEECNXAMfOYbMQ1Sc9SxaSfNnPsgQ&oe=6B0B37E5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
.com&_nc_ss=7f30f&oh=00_AQX-tJPhs2-7aeurrm2t9m7dm2VRn5koiLpIvcOxtL8FtA&oe=6B104D57"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qic7sB3thHgQ7kNvwEzz3SS&_nc_oc=AdpaWsepUQVQhnVZ4w9_1_lLORONyJL5j1duzSwbW6iEThEoC60X9kGEhcAheyDYt4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwtuvPMKMeDy8jVtc6O-mK7T9BybhslHOG7JKg0TaqtQ&oe=6B1041F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE3FMCkKW-YQ7kNvwF8Yv_z&_nc_oc=AdotHfm4Wqxokg83l9ty3PXMFQidf7--Pp2mGPjknHhphHqCvS07q7Di3OcghfQkOBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWkgsUQgvW4VCrarwKDmDyviGVj-VzQPiM4RzQ6fO5i4g&oe=6B1045A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
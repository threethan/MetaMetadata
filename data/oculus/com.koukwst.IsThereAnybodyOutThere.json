.com&_nc_ss=7f20f&oh=00_AQQC6ld6TqHL88FWdUZ17c7XIiXMuS819pD0rVLko8YlHQ&oe=6B046FD7"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQjV_qL1RQcQ7kNvwFBinq-&_nc_oc=AdrY3TN23hBv_ku7avlm_lMcReu5ESkAxKczAEJOyMdVeIEu-r2IwXiIemqNQuT5eZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXVgN36v7WqLVJW0K5eSEe3BR8JS2Ge-p1nsQO5Wb2SA&oe=6B046474"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJICatjN-i4Q7kNvwGec2z1&_nc_oc=AdrAkpHTNxc4QUKDFaA2je1ieKg8o1uBjf6cfVDUuN83Z8fJKuOg0at62RCaZr0azZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpj300A25A18KbhZEdc-N5jHxzsiMz2bxRmpAaSyCw_w&oe=6B046825"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
age Sequence_012_0000.png", "id": "1555015845855796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1555015852522462_5274654059791846191_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOAxOrt-VoUQ7kNvwHUPDiV&_nc_oc=AdpmZdCIMrHtttPs30rA0W8p-K0tjFgT45SaVOleiMl0-uWeWtfRkQ36RrgVxsdU3FM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqhMwT9Kcu_VA-_wEnERQYyayNVso09wRfrkUQMm2rtQ&oe=6B00575E"}, {"file_name": "Image Sequence_021_0000.png", "id": "1635264184832014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_1635264188165347_3255307565768521860_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APwlnE098QMQ7kNvwE19S48&_nc_oc=Adq0a46ngFc8kuzq0AFFZtZYchD4LPxV7AucIAKdJv8r37HJrbi0RY3zSI-m67yEgsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzg1EJzvkcXf1Fldk0vUNQE5s0gPW4O3XRTaE6X5uAqw&oe=6B007B57"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9PuBreLpVkQ7kNvwHF_ByE&_nc_oc=AdqhwKe7QAhGM2kCwWuKhusApkmoUBrbgMq-MixAJKc7fswl2Z2DQy6DmzRm_SqA4Q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjMD9MbPWzqS2SGUMdf0uIARVo8qzQLM-F3jBKFBxBuA&oe=6B006FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QrnztGOFQUQ7kNvwEfWs9P&_nc_oc=AdpJdk4lZz_7Sz6Zy9WAHoymVSwzolIFg4pobbEtiuRFHTlun3qx-FfiZz4thYkdUKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3dwb5_HvNgrboorW63Ox9B_owMfd7BTC_aoixeZib-A&oe=6B0073A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", "short_description": "A short narrative VR experience exploring isolation during the COVID-19 quarantine through environmental storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT5QdrbsP1J1QHwcQ3XR2Uj8dgRGDnGVzDusBQiKdr--5nVK8Af5Er9vAfRdERjSk29HIjF5Ulm5LLg/pub", "developer_terms_of_service_url": null, "publisher_name": "koukwst", "support_website_url": null, "website_url": "https://www.linktr.ee/koukwst", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
.com&_nc_ss=7f20f&oh=00_AQT_8JWWiOsCKRkeqy4r4pETCkHxcnNgepc3tfKZ5sAZtw&oe=6AFDD857"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtVnIurKRAMQ7kNvwH21rYy&_nc_oc=AdpbjiU-oqCKvCbzZw0-V0itWRn7jBeLePbgsslZP-AH5Xuy_AvoKnsZ_Aq-iM2lRUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkGmR7u3a1VaAcZx0YbZEP1udXLatOXoDJHr5w7c0Ryg&oe=6AFDCCF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SneaeVCe8fMQ7kNvwFB3nSf&_nc_oc=AdpNEDGh8wGF64l857BZgaKADPAtXNVm54krl8edu-qA-RQ_SXtBOvN0iJ39BBNFs4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTti8T3-GHO0u-BagwNFyqlR4uSpguh_1BW-z0dSx6ujg&oe=6AFDD0A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
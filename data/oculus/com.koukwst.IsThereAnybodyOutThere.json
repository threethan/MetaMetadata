.com&_nc_ss=7f20f&oh=00_AQS8ITAu1xoTahvIz3uwPlFFe4H_JyBDDMg3av49nid62Q&oe=6AFF29D7"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtVnIurKRAMQ7kNvwEoMeIm&_nc_oc=Adq53U3Fu1GZEDh4gQZyOghpF-3j39-WjkVtpNHLWHGRXOpSkjhdVWsmzAAY5OrXPjs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe8Gi45_-rGbjtUBbrLBy2WlLwzwLMHPwTgbANL96zWQ&oe=6AFF1E74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SneaeVCe8fMQ7kNvwGuKt9e&_nc_oc=AdqdbAH4Ib_rCW4EmF0MDfMaqyFPGqDjTuHSR_fbP66Q86aL3WrlSJ1UEfYQg2N7d2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfD_DziyG_OCC8REA8yaTGOFcWVlrNOYrxzU9oPZR9zg&oe=6AFF2225"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
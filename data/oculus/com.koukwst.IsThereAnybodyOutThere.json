.com&_nc_ss=7f30f&oh=00_AQTzVE0g-KzGzxwT_wdVR_c39jH01PLHblaHvktV6xufRQ&oe=6B0C58D7"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv0WFqc6P_cQ7kNvwEvCit5&_nc_oc=AdoMMS2dF0BkXZS0KS8u_XRMZxMaSCWu40jZxuVF-qKy6D5IDjOPVddi6DW9AslXt1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjDMqz1oVDHOggXLLBxwJvx1GphD_QgRcDHCrTxDm1kA&oe=6B0C4D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQw2W0z1z2sQ7kNvwEQ7P3L&_nc_oc=Ado5KcuUUlIujDyUTzK8qYw040oiQprB7Vo5Kt_P17IRKJFZvUrKArwFZlUBkRw-zio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6y3mMRZSbpiO7IFnSVz1Lj0qhgF0DbCxcqrBal8hS8A&oe=6B0C5125"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
age Sequence_012_0000.png", "id": "1555015845855796", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596068480_1555015852522462_5274654059791846191_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWtz8QdYaQ8Q7kNvwFKJamy&_nc_oc=AdqBaJvIFZPnGLLgY0Z3Je_8bW3FWHeDKEpbggC_N-GK-vFqQhGSRf-iixdEx8uJGog&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2BikR_CA0EMROwzYQJy8TmuKlcD_sve11G13exhs0PQ&oe=6B08405E"}, {"file_name": "Image Sequence_021_0000.png", "id": "1635264184832014", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595119480_1635264188165347_3255307565768521860_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_7tUjoR2Q4Q7kNvwErWwQZ&_nc_oc=AdpfD1wNa1ALmFXzV-Xt9c9HAjk1ajJSfvrHohZfeF4UY6B4R9A50JwLkFIn8cPkljA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR585Mz_XDuZwwYhT-4t1BWxVBtbxQAxeLHVkevVmKgPg&oe=6B086457"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-grZLc2CJgQ7kNvwHUtd0H&_nc_oc=Adrf4RFB0yqoInrAMbx4awWINGY3okNLQ8SUKLq-SgZuCvMY3kJ7nveDZx_nqu0l1qI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44dnnQZoS5a9W1GLzMlMUv5NVdQsHR62ELhVaHa7vpg&oe=6B0858F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzX7qlc-rNoQ7kNvwESznRE&_nc_oc=AdrMewP7JygP0tqbJkm7jiVMn9SL7wDZuN4Wf5dwd2tAEER-BnGpI7a0umTUPzaAVxw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdm5UjyuuwAmVX2hRgkB9QaRgDQSP3Vp9-r8wu75bdNg&oe=6B085CA5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", "short_description": "A short narrative VR experience exploring isolation during the COVID-19 quarantine through environmental storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT5QdrbsP1J1QHwcQ3XR2Uj8dgRGDnGVzDusBQiKdr--5nVK8Af5Er9vAfRdERjSk29HIjF5Ulm5LLg/pub", "developer_terms_of_service_url": null, "publisher_name": "koukwst", "support_website_url": null, "website_url": "https://www.linktr.ee/koukwst", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
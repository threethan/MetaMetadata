.com&_nc_ss=7f30f&oh=00_AQRLxQ11I1Hpqrq88RN3QyjIWyWGLY_p0L2kDsRHE3U7Dg&oe=6B0DAA57"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv0WFqc6P_cQ7kNvwGtVJyF&_nc_oc=Ado0Gsjnx0d13_gEgCKEeAThsseHkbiLjj5udKUwBNRyDmY8LJVehxRsSzdvOiVczEY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnJunvos3_2kvav4jdcNcVBXi5tj5Yk2i4mbJMN9hk5Q&oe=6B0D9EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQw2W0z1z2sQ7kNvwHlvJWp&_nc_oc=AdoXFy6tGezsKj7H-VqkuuQz0KGFq6jgcTA2a8Xj8uXZEYTDoBz4o4XC7AahZq7lpyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3AycZ_XTQDsyd_S8Hm9XUd7i02CemGGsHgINyS1b8Rw&oe=6B0DA2A5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
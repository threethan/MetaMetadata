.com&_nc_ss=7f20f&oh=00_AQQtQBK33DZDXGwgtu_Jb1MBzEiqI9kcYiRT04WEkT1gHw&oe=6AFB3557"}, {"file_name": "Image Sequence_016_0000.png", "id": "1857954198907456", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830441_1857954202240789_9131111756457153012_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nptydj4Fbi8Q7kNvwFIT9o6&_nc_oc=AdrIo79KForw2FFnAvqj3oXjK5RexjJJRkTFb0h_M1GCqsh3stf0fuIXeomlrCN6gRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQycmeb3_AZzC9XmFhe9xnh6ilH3bKWndiuFKIFBDW46A&oe=6AFB29F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal.png", "id": "1371696198501943", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604317775_1371696201835276_3028353133938139973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzcSntjQ_vAQ7kNvwFr8lKM&_nc_oc=Adpz-ouWBdN-FLWS2uE10193A4VWVsxOHAq-CcR468UbH_O_YSNn7Mp4l5O82mLfCGg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtKDTTBC-FMzcq8R1pzOuZwG50B0WbJ-O2KPK4eEnXFw&oe=6AFB2DA5"}, "display_name": "Is There Anybody Out There?", "keywords": ["narrative", "story", "atmospheric", "experimental", "isolation"], "long_description": "Is There Anybody Out There? is a short narrative virtual reality experience about isolation, routine, and the need for connection during the COVID-19 quarantine.\n\nExplore a quiet apartment, interact with objects in the environment, and listen to the narrator as the story gradually unfolds around you. Rather than relying on visible characters or dialogue-heavy sequences, the experience uses narration, atmosphere, sound, environmental details, and simple interactions to communicate its story.\n\nDesigned as a compact 5\u201310 minute experience, Is There Anybody Out There? focuses on the feeling of reaching outward while remaining physically isolated.\n\nOriginally developed in 2023, the project has also been presented at international film and XR festivals.", 
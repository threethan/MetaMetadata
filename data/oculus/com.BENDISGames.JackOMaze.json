hics that make you live the experience to the fullest! You need to escape the maze by finishing puzzles and by making right and smart decisions. Fight the monsters and avoid traps! There are multiple levels of difficulty to choose from but be aware, the maze is changing all the time!\nAre you ready to live this engaging and unique experience?!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bendisgames.com/jackomaze_privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "BENDIS Games", "support_website_url": null, "website_url": "https://www.bendisgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26841325412151523"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031334_1343662856481668_285302278543015994_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlzGOrQ1YFYQ7kNvwFswOnq&_nc_oc=Adl94TAEZBjKFhEeoxCY_lOk7oJNy85hOCYvq5mqwBsT30mQ8AkC9-mQ12ObRyAfhrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzPL_plyd0m2wEhC5EgLxtcWmaYLbv_-d_IxEdlOkoBA&oe=69BFEDFA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape Jack O Maze", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433
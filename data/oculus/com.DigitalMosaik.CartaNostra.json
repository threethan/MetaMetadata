gQPzLxmmqz0vM9X6uQ2A&oe=6A1464E1"}, {"file_name": "Screenshoot_Applab_5.png", "id": "1302224807097279", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75608439_1302224810430612_7982597134487643110_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovA9_Ej76RsQ7kNvwEEGmcj&_nc_oc=AdrwLLqHaEmhFnVoUI4s_qGkqBYLr4ha47zbbS9sOnsQGbWOmahNrHJ_OZsnaZypCsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mHxBLuspu0ip92kKhAkn04FCk8fAusd92VKSTaccnsw&oe=6A14575F"}, {"file_name": "Screenshoot_Applab_3.png", "id": "1328471114521780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_1328471117855113_685468836251971060_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQEQ39sw6xoQ7kNvwEpjKXl&_nc_oc=Adq-4nFIArupxtKbsrxqs-4oCm0GQH25J_rgq9_XWjLZnE5H5U-jmx4vAF-D0YQrbpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76FI0rfJ4vLzFve4Osvzx4UILMxpTEagCXvEPy6Ltw8Q&oe=6A147512"}, {"file_name": "Screenshoot_Applab_2.png", "id": "1383184772300771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031449_1383184775634104_2848305183515865790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io4fK5PysbIQ7kNvwGOmgoP&_nc_oc=AdrFyXjE3-zjZeLMa0XP-eBFTtPyk4tgjeeXblS6fFxPpXXetNk-gHm4IYURtDrkd08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TTe4XE4jfX0KjYwz3MQpGDF5MCokBOINoN4BT3ZaNbg&oe=6A1449A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "919237919541961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_919237922875294_3330695461102676473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsrhgjIPywkQ7kNvwF2B3GO&_nc_oc=Adrz8gC8feuPOF0MdMdDXYsNhiNsOvcpPAJDKNP2Mps-UHqAS4lt_pyz6vLW-C9qYo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wIm7bArq3BwjRIYrN2vaQOpAKJKIujH9cR7-JCS0CNQ&oe=6A1454E0"}, "display_name": "Carta Nostra", "keywords": [], "long_description": "-Travel to a beautiful island\nImmerse yourself in the sounds and colours of a small Sicilian town, a carefully crafted and hand-painted setting and characters\n\n- A story of revolt against Mafia oppression\nBecome a protagonist in an engaging story of struggle against the injustices of the underworld, help the animal citizens to redeem their rights and their territory.\n\n- Choose which cards to play!-\nDefeat the mafia by choosing the cards in your deck, you must be careful: not all cards bring positive results\n\n- Sensational visual effects\nEvery time you play your card, you activate its effect: energy bombs, storms, music and much more...", "short_description": "Carta Nostra is an educational virtual reality game, a compelling interactive narrative dealing with the theme of the Mafia. You will have a pack of cards to defeat the mafia, each card will have positive or negative consequences throughout the city. Make your choice and play the card!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/en/carta-nostra-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6181564018546685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974692_11496
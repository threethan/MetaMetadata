3hNxA3cZp4LwOwFkW4Ew&oe=6A9ADDE1"}, {"file_name": "Screenshoot_Applab_5.png", "id": "1302224807097279", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75608439_1302224810430612_7982597134487643110_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjendU-ywB0Q7kNvwH6jfbT&_nc_oc=Adqf9VnvoMLzZ57wIMBG742eQ1cp0gGZ-ex-Lq1qURRV8qBoX-pRDj_jtUbbdgdqjAM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-2UWeJjYr3TXxCN6uYpvwbUtV8b145WIK_TLYyrHamQ&oe=6A9AD05F"}, {"file_name": "Screenshoot_Applab_3.png", "id": "1328471114521780", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1328471117855113_685468836251971060_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNxQiw2e9xMQ7kNvwErpGX5&_nc_oc=AdrLW3CfDYm-_rQeR46XdOSg2KOvzwXrUC9Cp-jfeVHGoBp27EqRcTYBY-uySWmtyak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1ptwdDjnB6j-CPpFW2rijOLPX53up-yf_Ctri_mjczQ&oe=6A9AEE12"}, {"file_name": "Screenshoot_Applab_2.png", "id": "1383184772300771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031449_1383184775634104_2848305183515865790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqZkNjX8KA8Q7kNvwFQwCha&_nc_oc=AdrE7lnrwhVvlUkl47Dyk-AYSYx-1sP8o3gYxzHLmb3rMzZHmGZwAN4w3GeLMkI9phk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbihZ3G9AGh9HMpz7pGIeagOQrr819lSlSSAKnA0-Rww&oe=6A9AC2A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "919237919541961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_919237922875294_3330695461102676473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8logK9CDKeEQ7kNvwHDBYWd&_nc_oc=AdoMEWzgrSWq15v2P2l4WMULz7jG5SN1bwCmZJfwS7FdYn0Auf7a2ZEYsrGmaDLxPio&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvAWPaYW38KhErPbU-lvl0E6TU9fXJac_pAGJQpqV_Qw&oe=6A9ACDE0"}, "display_name": "Carta Nostra", "keywords": [], "long_description": "-Travel to a beautiful island\nImmerse yourself in the sounds and colours of a small Sicilian town, a carefully crafted and hand-painted setting and characters\n\n- A story of revolt against Mafia oppression\nBecome a protagonist in an engaging story of struggle against the injustices of the underworld, help the animal citizens to redeem their rights and their territory.\n\n- Choose which cards to play!-\nDefeat the mafia by choosing the cards in your deck, you must be careful: not all cards bring positive results\n\n- Sensational visual effects\nEvery time you play your card, you activate its effect: energy bombs, storms, music and much more...", "short_description": "Carta Nostra is an educational virtual reality game, a compelling interactive narrative dealing with the theme of the Mafia. You will have a pack of cards to defeat the mafia, each card will have positive or negative consequences throughout the city. Make your choice and play the card!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/en/carta-nostra-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6181564018546685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974692_11496
_minilandscape_1080-360.png", "id": "861654008788163", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_861654012121496_4498794080903733538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCQp8shKNbAQ7kNvwG-YsWZ&_nc_oc=AdkIh5_Uh7X4aoNNspfDrRu1SHtvm_Yp0Kb8oh6TD3EbfvjAGTOvzZCgl-fWh21r3Ic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfssxnVUSpD9Sl2te1uAmH7brdx45y-pqWvf8brRMaoS9w&oe=699C4951"}, {"file_name": "Carta_Nostra_Portrait_1008-1440.png", "id": "258352783890072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974858_258352787223405_5859488931600628597_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAtKXCAHMqQQ7kNvwGcAEzI&_nc_oc=AdkbF27mG-UKXNOMgwPEb5pytPL7FQ8pAtD1X-pHjMLOyipadBauB6EL9nbbQdQdmyY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvJvPKM_BitPnfHBNA0ixeJrHDHzBjsSSyUoXn3i7QlTg&oe=699C4721"}]}, "id": "290905370632540", "locale": "en_US", "screenshots": [{"file_name": "Screenshoot_Applab_1.png", "id": "1534033607355336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282161_1534033610688669_7260423836989543554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wWoi17C8KoQ7kNvwGiURqp&_nc_oc=AdnfL_vX6MbdLa6S7_ZtRNp2Qy-mI_EaguldGdkDVU92mlCRf86X4xZRM3guuAjRjyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvSVgZTiJBTLtwgF2d9ul9ac8S0PxnvGA0Kc3MNCR_dMA&oe=699C38C4"}, {"file_name": "Screenshoot_Applab_4.png", "id": "402627712091655", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65395359_402627715424988_6228681843867696856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYYM9wDE8tUQ7kNvwGi8Ejp&_nc_oc=Adm54SugEBsH9X3sMWQo9lRVdu-a4CJGRJUj_31bFbP9WK2jBLQbQwV-WhgHLsXkdoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsDoq6lVyifOPUWOF5eg4RmdtPh8_0n63nmoKSUhrF7rQ&oe=699C3421"}, {"file_name": "Screenshoot_Applab_5.png", "id": "1302224807097279", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.
wj&_nc_oc=AdnUSg_zMvyes-PrJVbcT5iA50lNo9tY8AkpndwNRKaNeNh9X5upSfdjxz4qhdVIUc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJXmupz902iP-gZ0vIV5y0ysAP81KtP_fl9K6imj_uBA&oe=6999BBDF"}, {"file_name": "Screenshoot_Applab_3.png", "id": "1328471114521780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982671_1328471117855113_685468836251971060_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-nfPBcQwUAQ7kNvwGdPsM3&_nc_oc=AdkWzFYLQZEXy_PcBCDVhDeOjArHy9edSe8Ezmxxj9HgHnN9FNUj-EdrXyZUBLVU5BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGMCB6sGlkLKT05hyIdaZslCRu00Mc_Suqf8OrxW5oIg&oe=6999A152"}, {"file_name": "Screenshoot_Applab_2.png", "id": "1383184772300771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031449_1383184775634104_2848305183515865790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpQLSJn2LZgQ7kNvwH2oR8z&_nc_oc=AdnemRtd1f8jgcUf5hzzekikraHNY9PxydbJWOoOL7vggLv4m-8-aeGcKKS065Z-BI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvxz-hSvnqDr7h8nDc6t4l8W0P1BPxEIib_18Ad2yoPww&oe=6999AE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "919237919541961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001654_919237922875294_3330695461102676473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNpGdbEYYyQQ7kNvwEzaL26&_nc_oc=AdmmVGIG12nB1KJnkLFP0xwtSxq5Alcl1rX32d0Ali5Rh1sqZoYcanXkYUeBSrmpivc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSsXsZN9tO9dIz6GkSOJb54IVqWuedpdChxBi7kVYE8Q&oe=6999B960"}, "display_name": "Carta Nostra", "keywords": [], "long_description": "-Travel to a beautiful island\nImmerse yourself in the sounds and colours of a small Sicilian town, a carefully crafted and hand-painted setting and characters\n\n- A story of revolt against Mafia oppression\nBecome a protagonist in an engaging story of struggle against the injustices of the underworld, help the animal citizens to redeem their rights and their territory.\n\n- Choose which cards to play!-\nDefeat the mafia by choosing the cards in your deck, you must be careful: not all cards bring positive results\n\n- Sensational visual effects\nEvery time you play your card, you activate its effect: energy bombs, storms, music and much more...", "short_description": "Carta Nostra is an educational virtual reality game, a compelling interactive narrative dealing with the theme of the Mafia. You will have a pack of cards to defeat the mafia, each card will have positive or negative consequences throughout the city. Make your choice and play the card!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/en/carta-nostra-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6181564018546685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974692_1149684546009139_7602248288164393664_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9lCn1HRdpoQ7kNvwGa1yO9&_nc_oc=AdlPiX6jfxO4obF4eed0HajXNlntJcgRIrGaB_hfaaw6thaFmGTQLGF491R6mvUI3lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAExSra9TTQej6p4X0WB85Fh88KrqjnyZusFWLYMx_Qg&oe=6999A3B0"}, "is_concept": fal
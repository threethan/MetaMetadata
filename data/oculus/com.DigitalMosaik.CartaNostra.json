_minilandscape_1080-360.png", "id": "861654008788163", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_861654012121496_4498794080903733538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoEfb2lgG-AQ7kNvwHw4Prs&_nc_oc=Ado4CNRZuf3j9fgvmOLhMS3X6KDX49tOIoSLOfsn4ikIMeWRPrnNqrnkaVGZD6iYv2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3gi6MAFcMRgDih-AgdhpJOaZD-0xM2_uXR2CI4aiZRcw&oe=69F0A951"}, {"file_name": "Carta_Nostra_Portrait_1008-1440.png", "id": "258352783890072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974858_258352787223405_5859488931600628597_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ip5VaRICuoQ7kNvwH2qXlu&_nc_oc=Adrcgsn2df-NZNnKeM2Z5XGdZ0AkVkn3XFNv2-9KRl0YrgNShVFWkrU4HtWEZbSzEi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0dEnrpulUTI5ZQ0BbX3zBJzzG7fmbDkoES4xUrENPIVA&oe=69F0A721"}]}, "id": "290905370632540", "locale": "en_US", "screenshots": [{"file_name": "Screenshoot_Applab_1.png", "id": "1534033607355336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282161_1534033610688669_7260423836989543554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJkp1FV8MAIQ7kNvwFvG0l9&_nc_oc=Adpkzmf8tadmiiMQCdBwLFuKqrGE07IeyKz3XmBG7Eo0wQrijdM2wbxJr9YZhSQtHEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1dH5gpvI9EssF4c7EMahcW0lPjIgmgg525ySOY6XgBMg&oe=69F0D104"}, {"file_name": "Screenshoot_Applab_4.png", "id": "402627712091655", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65395359_402627715424988_6228681843867696856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDegCL8dzVIQ7kNvwE-qIOZ&_nc_oc=Ado9uI7i1cdey7qojv3VECBYBeiPHaDnJnCRp3pMlhEEMjT3yhupphtukf0htAiXrns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af08z82v7Kt3dQstnaELSpg_N-H_uiIuRFdbsHtTMAS3AQ&oe=69F0CC61"}, {"file_name": "Screenshoot_Applab_5.png", "id": "1302224807097279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
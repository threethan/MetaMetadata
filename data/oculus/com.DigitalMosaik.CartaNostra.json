_minilandscape_1080-360.png", "id": "861654008788163", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_861654012121496_4498794080903733538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXW_zKYYQWkQ7kNvwEYX-b_&_nc_oc=Adlpef3WnDw-Z5llchxlDPtmhj1rB5eHg3_6KW4C8qQa4zen8L4-m-yqA12y6i1kNM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvhz8mu535vbdBQVYuZvJn_sIhlJtj0B4R8idOhSTixOg&oe=69A2E0D1"}, {"file_name": "Carta_Nostra_Portrait_1008-1440.png", "id": "258352783890072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974858_258352787223405_5859488931600628597_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr244AV5IbEQ7kNvwHabEj2&_nc_oc=Adkd5YPtbXyO0u-mQo5u-yM6QbF1okDfp2JlJjI_hfi72DU9CN0MD8MEVZ9ekopFZk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuM4f6buxSbII5Mz23Ev6bXZkak6r4Omb_JuzFU95zMNQ&oe=69A2DEA1"}]}, "id": "290905370632540", "locale": "en_US", "screenshots": [{"file_name": "Screenshoot_Applab_1.png", "id": "1534033607355336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282161_1534033610688669_7260423836989543554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_TsUDaJ-SwQ7kNvwEnpWLp&_nc_oc=AdnMkOA1398wTe8r9_qx-vpuehpn4O9WtbOxwaJlTFeJ12hCStzktjGojb12LaXQ9fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvE1gnAmCqfFcgFVxJDz82YoIakY2eqkkOU-n-eiiWwUw&oe=69A2D044"}, {"file_name": "Screenshoot_Applab_4.png", "id": "402627712091655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65395359_402627715424988_6228681843867696856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNXU1tJg7mgQ7kNvwEW6eHw&_nc_oc=AdljpNehu80FgwGbEh3gC-fZxM4WJfcipSm_eZejbQifcUiusGnFG9nOwcHSUAj263I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRl3YrRLP42bOqWEmDYdA2Hd-v_U4rM773Ky3pZpbFIA&oe=69A2CBA1"}, {"file_name": "Screenshoot_Applab_5.png", "id": "1302224807097279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
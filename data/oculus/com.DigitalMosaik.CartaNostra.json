fe&_nc_oc=Adl4RpbDJudDVKLUufcnHJVg5vnuSkl1eBoO2dHBDn6XkoftyuYuunLV7VOye8naFT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsBnX03O9hzWtOdVKE6M4BXcuKPxU26w8GOYNlj-GmDGw&oe=699B0D5F"}, {"file_name": "Screenshoot_Applab_3.png", "id": "1328471114521780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_1328471117855113_685468836251971060_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXwUHpDarqEQ7kNvwFQaJZ6&_nc_oc=AdlxiQcTFZs9iswUrX2D5Ogb26_8wd068DEvSrxdYo2osspSmXei4L-SZo6KG9bVA_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu6N6NMJvuJjVniXEDN_gSlMJVAfJbaFn3boQDoU9sjWg&oe=699AF2D2"}, {"file_name": "Screenshoot_Applab_2.png", "id": "1383184772300771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031449_1383184775634104_2848305183515865790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG4LszLoDtgQ7kNvwHCY6ZZ&_nc_oc=AdnCUrBXUJHFOsfLp9mkOZcHobOcmjnSdYhDjN8lnnpvR2zjntrea16H-i_NW9d-93k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvi4HVG3-udLLS6VQ7odxQFg1NqvGEPERfhtuo0PQ9VHw&oe=699AFFA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "919237919541961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_919237922875294_3330695461102676473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNpGdbEYYyQQ7kNvwFdLgwU&_nc_oc=AdlzuzcSEE8b91vYBsE6FfROUCqVOKgR5qKVmFrSi5Fenf7BX9ZfKoM8tJlWe_Lz51w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftWR3gpRU6-hvPZWUd1Oyb5P1XH0XTzBwnqxAyK-JDfaQ&oe=699B0AE0"}, "display_name": "Carta Nostra", "keywords": [], "long_description": "-Travel to a beautiful island\nImmerse yourself in the sounds and colours of a small Sicilian town, a carefully crafted and hand-painted setting and characters\n\n- A story of revolt against Mafia oppression\nBecome a protagonist in an engaging story of struggle against the injustices of the underworld, help the animal citizens to redeem their rights and their territory.\n\n- Choose which cards to play!-\nDefeat the mafia by choosing the cards in your deck, you must be careful: not all cards bring positive results\n\n- Sensational visual effects\nEvery time you play your card, you activate its effect: energy bombs, storms, music and much more...", "short_description": "Carta Nostra is an educational virtual reality game, a compelling interactive narrative dealing with the theme of the Mafia. You will have a pack of cards to defeat the mafia, each card will have positive or negative consequences throughout the city. Make your choice and play the card!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/en/carta-nostra-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6181564018546685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974692_1149684546009139_7602248288164393664_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9lCn1HRdpoQ7kNvwH674tJ&_nc_oc=AdmMBXY5048VOUDTSLrzDR_bJJX67nijrUflm7IQPm6UHAAwGJDzHzQ4xOeNP292EIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvU8NA2PBiKzWrBZ6BwfVmrOpCfHnGnLhSLEiH_JpAMiw&oe=699AF530"}, "is_concept": fal
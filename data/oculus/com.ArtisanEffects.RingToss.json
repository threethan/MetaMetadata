30727555_3453489833415117234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Kh1WPC0ajIQ7kNvwECaUbD&_nc_oc=Adq3V4f8ROhHba-Oc91C4yZXajaYduKX-ADaNTbgHQl4TAKwWho89h8waVX7h0mlggM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0BjkDnla176bLl_K69BzcIlvCfkIzZgyDAHAqljqpUtA&oe=69F0D2BE"}, {"file_name": "4.png", "id": "1103459884098313", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476597_1103459887431646_5733395252769767476_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbqiGMPNnMMQ7kNvwGsyppL&_nc_oc=AdqgfwL0wwWhquRF9QNKmiOb7asTK86iKp4nnwOlkvtE1WkVA_5y7yma45UNGxB2Nr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0fb8_DPDY9EgQ6Y9DGSljqxVyPeLfSz2OteQ8t5tSZ2g&oe=69F0AFBC"}, {"file_name": "3.png", "id": "2259244384415283", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770912_2259244387748616_8902619268996763540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wgxc01Fae9YQ7kNvwElCl1K&_nc_oc=AdpoVMB0GG9BicXYNGVjLQIiQcOg66-1bhLd5MaBRcZABaK_NTBVOG6GqXA0eYSUve8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af15TyCJniWhqZo5DcxJXfqRJRo0uLnjWmpbjBbUlXWgwA&oe=69F0BE1B"}, {"file_name": "2.png", "id": "422654703964695", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982659_422654707298028_5742817564110713231_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDc-csz1tAUQ7kNvwEfq0Ke&_nc_oc=Adpl8BL-vozWhkFYD0ExxpCFI4ggsGkBoqeBerzQJ6GfnFoi5EdBfTfXsSh7azVy-i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af35OuHuf8KUSWndPDzg0ciIObpCSLkgBBFzlZ1BxfNkvw&oe=69F0A772"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Olympic Ring Toss Cover Art - Video Cover (4).png", "id": "369271119076220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_369271122409553_4178350087346444669_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BEhbdz6L9QQ7kNvwETJSYv&_nc_oc=AdolNZnkNx3AHkOJ2eNjqvMJlmRa0miW04KvzgNAKxK9cdy6IBZZjIWPXTcADgXCszo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3eBKvFM0KYLA1p64t1-M_MZeUycMmOo5askn-MP5l8Ew&oe=69F0C7CF"}, "display_name": "Olympic Ring Toss", "keywords": ["olympic", "ringtoss", "cornhole"], "long_description": "Celebrate the excitement of the Olympics with Olympic Ring Toss, an immersive mixed reality game! Step into the vibrant world of the Olympics and test your skills as you aim to toss rings around landmarks from host cities!\n\n**Gameplay Features:**\n\n- **Intuitive Controls:** Use your hands to grab and toss rings in a realistic mixed reality environment.\n- **Practice Mode:** Perfect your aim and strategy without the pressure of time.\n- **Timed Mode:** Challenge yourself to score as high as possible within 60 seconds.\n- **Wind Force:** Increase difficulty by activating side-to-side wind force.\n- **Landmarks:** Gameplay features host city landmarks, such as the Eiffel Tower from the Paris Olympics.\n\nWhether you're a casual gamer looking for some fun or a competitive player aiming for the top score, Olympic Ring Toss offers a unique and thrilling experience that brings the magic of the Olympics to life. Grab your VR headset and join the celebration!", "short_description": "Celebrate the excitement of the Olympics with Olympic Ring Toss, an immersive mixed reality game! Step into the vibrant world of the Olympics and test your skills as you aim to toss rings around landmarks from host cities!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-olympic-ring-toss", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/olympic-ring-toss", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
30727555_3453489833415117234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9YsDzZlNHwQ7kNvwGF1HMW&_nc_oc=AdmN7lVkCBFnhN2zesELlXh-o2CSPpnwHJYnjJmhsXzzspflOcgZwwx_zZIoqMrXdUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfscIDdKNR6D7Mwz7hcmPvUtb8YOEbE66FQLOfrAXK-lnA&oe=69A6C67E"}, {"file_name": "4.png", "id": "1103459884098313", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476597_1103459887431646_5733395252769767476_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebOu7p4UaToQ7kNvwEXjYtc&_nc_oc=AdlQ5Uhj5qzktGOmbnjF9kXe89jK3wD6NBtWGsVSuwdYrBU9sjkC7BKgxsoVOZKBtWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEdTLc6oE39upE_LDOXnUSfFICSKd7fzIC8CtCxtBZfg&oe=69A6DBBC"}, {"file_name": "3.png", "id": "2259244384415283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770912_2259244387748616_8902619268996763540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqvsTeTUEJgQ7kNvwGeg6II&_nc_oc=AdnQ0XzO2Oni-LUq3YULOJAEOBv5AYovc-0kI6plQFPkRoPu-HmpXESdN24i5VkouYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftlox0Sb0yKCr8B1CXGz42XfWhbimbJ-JN6CvtLif1MCQ&oe=69A6EA1B"}, {"file_name": "2.png", "id": "422654703964695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982659_422654707298028_5742817564110713231_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc-zWjGLEUgQ7kNvwFzWZPt&_nc_oc=AdkmDliKdSQ-H3PIM6R6NutZF2keQ6Hps-LKNOX8tGGRZue21YdGkPaWDApngt_EjqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7aLAxfhRyGBEGuqTMXNpXG7uiIjW75Mg6MOHG4QweHA&oe=69A6D372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Olympic Ring Toss Cover Art - Video Cover (4).png", "id": "369271119076220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_369271122409553_4178350087346444669_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DWLmpZyRJIQ7kNvwFVWGaY&_nc_oc=AdnHJhhnHaGnKH1l_zN0MQe6l6I7cRzc1HW3CHkHZHnaKgxiWGtc8FlU-0zNKmNyGH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftgef-vzfA_qFAmxSM6m1W_ZFHsInpQ_E9jmxPgqV91zA&oe=69A6BB8F"}, "display_name": "Olympic Ring Toss", "keywords": ["olympic", "ringtoss", "cornhole"], "long_description": "Celebrate the excitement of the Olympics with Olympic Ring Toss, an immersive mixed reality game! Step into the vibrant world of the Olympics and test your skills as you aim to toss rings around landmarks from host cities!\n\n**Gameplay Features:**\n\n- **Intuitive Controls:** Use your hands to grab and toss rings in a realistic mixed reality environment.\n- **Practice Mode:** Perfect your aim and strategy without the pressure of time.\n- **Timed Mode:** Challenge yourself to score as high as possible within 60 seconds.\n- **Wind Force:** Increase difficulty by activating side-to-side wind force.\n- **Landmarks:** Gameplay features host city landmarks, such as the Eiffel Tower from the Paris Olympics.\n\nWhether you're a casual gamer looking for some fun or a competitive player aiming for the top score, Olympic Ring Toss offers a unique and thrilling experience that brings the magic of the Olympics to life. Grab your VR headset and join the celebration!", "short_description": "Celebrate the excitement of the Olympics with Olympic Ring Toss, an immersive mixed reality game! Step into the vibrant world of the Olympics and test your skills as you aim to toss rings around landmarks from host cities!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-olympic-ring-toss", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/olympic-ring-toss", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
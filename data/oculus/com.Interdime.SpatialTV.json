0.png", "id": "460727386930428", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQutBW79vwcQ7kNvwHVI2eo&_nc_oc=AdpeKocJEMV5efVCsCJ6bGQkD55xdz_JO1GovzCaHSDYjxXK6UMWCDD45KWLIK9uHBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkJ4mX2GDZpZpHUnpQpTO_--KiL4WFS5jhO3lTrUi7jA&oe=6A90189C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGtQGoduT8kQ7kNvwHrv8Yu&_nc_oc=AdoUqhAghpzeAc48ICPr8vikcz-iHrxjbFiOdFcfp82VVVWuVNKVefLPDK3BjCfgDfc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2Q_P_ffMNkBIPB1c03wgUozN1oIIhIGbG6PYNXPzsAg&oe=6A903E49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFXfKvDJc-gQ7kNvwFOL2TJ&_nc_oc=AdoK2wxYZWNuoe6vWlMhaU57bgerOtI_pXIaNIs7FM3La20EAgBIHU-HCPoj-tIH-2s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeiSnOP-dkYBmb5UyEtCef5e4dFJgbeQmPVweYiDVf0g&oe=6A901D13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahhtr6uIchcQ7kNvwHSTVbB&_nc_oc=Adqra3eyAvH8Kvv9nu1as7ily83s7U1N2LjtyPHN0Hn2VSoPuU2QPFMAzSzJ65gbI5A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTLZNg51X5XMaWl1WfcZjd8i3z51bvci6r6L1heVWdUw&oe=6A900FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zsf7c-mRIl0Q7kNvwHhltQU&_nc_oc=AdoF_LM1da3MoBAOC-VFYHiA7ZXPIgvmF3A066uLzzV2GYE69QHTmrjwtdsSpSqjQv4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3RSKTF5GFJZSW7d1gacS4dx6292rOLFW2-1lEYCyKGg&oe=6A90380D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-95irieTjDgQ7kNvwGGACV1&_nc_oc=AdpwwDPrpn_EokwQYhekw2JXi7TozxY6l2ueQu0_s0eryy6-yI_XvrQKBM_mSi45m1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjJUFthTtbw4VEGo-p3aZiHGZR5JuY0cdfd_MN5Q6DLw&oe=6A6A155C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_Jw4jiA4EoQ7kNvwEIHC2s&_nc_oc=Adq7QBnvQAgz5C9nvNXlphztnuy8NNB2lfd5iXEcsNKoiLq9N4EJhn5rR-h_3TczWfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANKx2QZsmHGCZcFJxv70FEQ8hNwiPV9rIwrY7f3ryeJQ&oe=6A6A02C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKvCd9g_vZcQ7kNvwGPmiQw&_nc_oc=AdqPP6lDSq4NOsPUhxqYqbZ-l872DmB3WzWXJ8aU0brmrAqInP5dk48_px-9d3DOxoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZDQtUlW5-KL_uC0a86VLSXQ47zquZNvtj6_Wmd0MPyQ&oe=6A69E193"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hj-KSWb8y1sQ7kNvwE2mq_3&_nc_oc=Adpmm8GqIT2K1MRRAYtvNvt4XQX47fFSs6roi9Ayvc0hQ0HM9YHgDJJeWbWm7OfwkTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB6DPV1i5kTQe1gXAlnV-XsX_9yegIfXbTgP-2fUu5PA&oe=6A6A0C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGHVSLSvWhYQ7kNvwHsMfVJ&_nc_oc=AdqXuOQv7HL5dSwUshbbD_ndUaNqZTxsjO-tF4bWRUFnoQl5d9Ikyjb4sHC80cPulyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRxm8neue0HdbA-S36HsR-m3JvLBSlkZpD1U13JuFKkQ&oe=6A69FC8D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
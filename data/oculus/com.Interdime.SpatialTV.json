0.png", "id": "460727386930428", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78hUBrXu7s8Q7kNvwEVr5oE&_nc_oc=AdoaJs4fdle4usTUD5gnLN-GrTPctl5KvZDM1THJEAlNK7qmRu7n-r5RWqmbsWnUQos&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyP2KLmGGKv4z8SE3F6X4KgGTxzlUE3GT_yGctji-Ogfg&oe=69CFD5DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN_g6WODvPcQ7kNvwEp7qyZ&_nc_oc=Adr1tefwqkZijKNTvjX8KKRIpehZCeY0b9XDcF89NamWpYvMszTSPieJdhpK0B9dsOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZYYM2qXOoQoLCNg3gTFi9BliIDO5kyyIQApuszS59fQ&oe=69CFC349"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM4giQ2gbNwQ7kNvwGYc5_0&_nc_oc=AdrrG8V4zNZpA_Yuiu_k_wWwsV5rY8patwLZvcpU-QfjLwBHx5UN0PQbcp-s3GIXhJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUzIjLDPwYGU1jPBsOFi9Ge9sAFKwAuXF6MSxV4ETwEA&oe=69CFA213"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xanh2jNaeDQQ7kNvwE8qvp4&_nc_oc=AdoEws4BPT8IQdBaiai0OxmH7q5XUU3219vqQ4vOekPnI2ijhAYL3hu8GvTTpeSJK4Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMdWIRBKpMa8e1NC9N_aGvbxWvwiChVjgkzjQa2tKoAQ&oe=69CFCD12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tqk4fV43OAQ7kNvwEECY9r&_nc_oc=AdqlmtoAZtvZczajk5ILyzyIEXseMWBbHQzoGSLjzrxPSgssad2ML8_E7--SWKg_6T0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcbRgJ84j5bZEIpgD26Q8uFfgO5jvasaUQDaeH4XrSUg&oe=69CFBD0D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQPPya1coK8Q7kNvwEru-84&_nc_oc=AdneNsPwJVdSwHrNc0eUEQye1dmKAI8I-qsc_UzOGEHZh244HlDgJ4fqWhrMX8gKmqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdaeFfcBakbSEDUIOJ7dJjjP-mARmsP6vlhtmDMVly6Q&oe=69AFF99C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEtG2f0nCT4Q7kNvwEsUs7h&_nc_oc=AdlxTZsg-ga1JMP3Crzl-SkfE9UMaR2fKpux68wYV0cT9rbHM5CoyiRzQddKDjZlIfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZnOGiidAGJnlV4JoBVQu7iU99P8xfIKoRxX9Vdp01JA&oe=69B01F49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2xZKRkiQS8Q7kNvwHsALoU&_nc_oc=AdnIikEfpX8kF1eAicdT3Ha3zgmi0Ev6xG3icAP-315-JLbl3vtmR7Qi5GuovYm4UpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQRx9iByg8XLbeqpftdGdC-yp0cur7Wk_JPN9stvBzAg&oe=69AFFE13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVzGAlufyowQ7kNvwHG3xAh&_nc_oc=AdndAPDOX-8kUCyS8z66vUHCvjOkIp1dq5SIdgc_9xvYBAmD3WbWS0S-tNkUBlo3gT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtzXDt7NdLio2-QX3NGMikfIlVwGQvUkfPdAXFvD7V-w&oe=69B02912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHrultdeZd8Q7kNvwG8l-IB&_nc_oc=AdmIQ_F0zvTHwz-IpcIwZNmdA75kC7KvCoPLq9CoUbM4BqnDwGgXINFKpkO9v2zIMeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW6NjM_jAUQX1zjE-oytBJGcBaYccTEYqAx8wbJxWxdw&oe=69B0190D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
0.png", "id": "460727386930428", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r5o6Av8ezAQ7kNvwF7Tzi0&_nc_oc=Adr1Hvizyb9qYmHdNrLz_z0Ya21YqJYTO71MpJih1RKlfii4MaslkWVI-zuxO9TYJ_0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68UEbY8NSSfcg_cpRzKKjt-G0vLg-mx8Awtuhp7524hg&oe=6A0C7ADC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZpUgIMypZUQ7kNvwG-uY6q&_nc_oc=AdrGTKpfJJiEu0rhJAkGfWdbSddFzhquInLcknedMPj4IXO9AID0BTdfz0PCwYxgLMA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VaQjRpG46dBeR5rpYkQZUU2iV_Wr9gDwxLK59RsJhHQ&oe=6A0C6849"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00_cne5-oZoQ7kNvwHUXERt&_nc_oc=AdrclDUYxq4_sDqDx3i4obs9hg4gyCxzOnO8qRm5ikgJTXUG7JT1lUWqIRUooBmOjDU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wALLdLMjJK-HtkBqFQydCUW9muH52ydbiAyOuyrTU8g&oe=6A0C7F53"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q3et2PFWswQ7kNvwGDbmat&_nc_oc=AdpSLh-dTfbNCpPCrMbl0MbPJiAyiJfYb0orSZWSnYEgn2yZUBga8xlanYbhzzUiGeA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rl2IbFaeickY5bMx16MOIbpVUhKbT2J33bQTO2O35UQ&oe=6A0C7212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl6reUrTqZoQ7kNvwERYyrV&_nc_oc=AdpHpZg7Ca_wDHBfqty0o-qLm2ct16Nduiy8X9SKy7qYQ5RujEY0L1XdJhWnkKUfb6A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W3BXYfhaIADLK07APdrOpXgRt0Vu8gY08i7JL5BRt6A&oe=6A0C620D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mU7aGt7EFO8Q7kNvwHjjgLj&_nc_oc=Adq4AkaQelacX4_Mqu4XOE056kBVqzmmvF8g8-T8upvmh2R4MtCEgyNw0VFTS8gj-H0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdwHez1q8dTnaDACvAseqGATMhEZ4fGJM3-HbnZ2IsLg&oe=6A58F1DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGwvAuVynZgQ7kNvwFjH5HA&_nc_oc=AdrCOswZDHZ_Rh9bPyxu8C12B-0RhGOR_g3pnewCUjdFmX9Xs4rvHvvTvOM_5DB43kQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeW9biUZrH0phQ944uES6SbvLRq2CtW-jrrLP3Fkz2aw&oe=6A58DF49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vahyugtqPsQ7kNvwFSEyDF&_nc_oc=AdoW4EUfarQRvZj3EzCW7IjnfOhg9FXPD8uW6Saz6v7YIlxqahEEMdI9YYssxSSKL6s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdqtSknPJLhF3Gf9tOfxfaIUpxvMpxEc9-l9k5rscilA&oe=6A58F653"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NvRJXw7qs0Q7kNvwHEAZbt&_nc_oc=AdpWaZanAtSqXvRDExvFImsIly_J2wVBHgJ5GAqT1aqLaFrCi99xa0uqdeComhzpxCc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy6CIRNPAc214b6oLx0HVcCyw3yR8UIs9gDzXun3uSdA&oe=6A58E912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spOTgS2zvUwQ7kNvwFpE71F&_nc_oc=AdprsJ6LbN8F7rAhCCSRQk7GGM18BKF2vahF1gs1U0_zIA0dm7V0KLv6FC3GD2SP1uc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgFZ55jjriAURBjuzcJOgift1KoO8L5UBO0T-sSsw3DA&oe=6A58D90D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
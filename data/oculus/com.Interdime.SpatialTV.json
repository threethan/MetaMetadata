0.png", "id": "460727386930428", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v96_PntMxLUQ7kNvwFKKMsL&_nc_oc=AdpiPSeqaUIkguzoBGHS7QbzeY8DQcelNYN4w_hbk88DJ_GyNPhYDIkJgxfohSVvhPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByI0Dje5QDIgfNpOt7sNUpGT9OXvlT424RhLIGpqE2Fw&oe=6A525A5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M_2mA1Gp2AQ7kNvwHp0fPl&_nc_oc=AdqBTn-gpkUQCQGs43I55nIWc_MGtb-o5CkV2v33Y0p7m_ATy7xXws65YJtjwlvJkq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd6xfrmZerWh_PEK2ijemO0vLK0_pBFUEICshbrRCgpg&oe=6A5247C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhnZV3bSeTUQ7kNvwE7Y5ni&_nc_oc=AdpcocRg_-OjvmuTNK3cyv48MaIC3S07QDyrk2cXKbpBtfOaLvv6mONjZysisyPiS4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoe_EM5a46WNdXStQrgP7OV1U453nhRZ3N2we5F7oaDw&oe=6A525ED3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iArNl0tQIwQ7kNvwE09aRX&_nc_oc=AdqlaLiWJyCMvGAXJUly5CXQnJ1urn6F5DdSpk0GnTjBpibqEZA6NBr1V3YYe2LiWuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAMWW8zaSBQyLF4IKU3xR4_NoRjl2_RcO3SUhXE7XJxg&oe=6A525192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-8QohzeAUQQ7kNvwFKr62X&_nc_oc=AdrDmM-TUOV1CrugGtYcm0aPc7EU2GaYr_Yx3ggWTNxrzcf41F_C6KewpMlgM2A9L9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7QUiWM1a1u29WIuwnQ8gOE9A8xfBfu4z5WWXxiLTj1w&oe=6A52418D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
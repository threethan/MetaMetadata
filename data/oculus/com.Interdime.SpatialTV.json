_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrC0RxI3tc4Q7kNvwGfuFt4&_nc_oc=Adk5QMD5SRCMM8eBVhj4qBuFyV6VL9eQfg8k1b5pG1IybqR6yq58w8yB4v0OQ9SPNtw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsABwYX6hf0kb6EQplYQOfuOn3WSEI3Mc8afn8EdEBeVg&oe=6999901C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Anosu_GXmDQQ7kNvwH4rOEU&_nc_oc=AdnASEkBziF-mK4eU6Otj8qRRpfvdei_8fOqBZ533ztwjGWuA8ufsYoubDzJnwkFggM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshNfik-hEz0TYZmImM_-8p-KmoGZpJXJMm1VJOh4ekTw&oe=6999B5C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx4fncE7IZgQ7kNvwHlbbmG&_nc_oc=AdnDrgA6IQUCwtBhqyC3eKMXbESbNcYHu3SvL19TXBxvx_XN8A5Lh3K8x1DVPralmZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft9UTkRQx6bppWfIHi6l3bkf74Z_NAbE9ClpBuTUaeJ7w&oe=69999493"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnNF05tRSOIQ7kNvwEjSEhH&_nc_oc=AdnUhh4uhHUGrIFwF3Rywi3_Lyk_XY6qky1SFZVV1ZyrsmqLCM3XDxP5nrhOH4Ouzuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs3xREdDxL7JhI-4OADgWqGceuLeT1rVkpTZvtYccPlxQ&oe=6999BF92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJTXUIeEhkMQ7kNvwGdGyjr&_nc_oc=Adm5HgZyFzf6XMCZO49Xbf2F4vPxcqPMbxDf12M-QICiidpbj7TJL8vN8qygZRw_Jkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftjfw8JvUsmyHpjtd9Es84nNsDkQt1irtsqzvUXI0T72A&oe=6999AF8D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres":
0.png", "id": "460727386930428", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuXP64NwTrcQ7kNvwGfaaDV&_nc_oc=AdqbvekrFVvTds0xD06IwWHtX93DORbRhsQjOwNp9TBLE-ZMYlhlLo1w9Hq6nSbCHjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3-baKg7YKreQdTo04Skp3KlxqgavzMBsbYMmczboypQ&oe=6ACCF5DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4PtE2lWJt4Q7kNvwGSjIT0&_nc_oc=Adprud3dbf4EUNZsAdgvet_QDeJJwLaJso7MsBxNAZcYI70V_3MQQep_W3QJZqPrXVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeRsS-7kPVH_yaTgiMoG_IruGG5sQOdh9-Pio6O8Wt7w&oe=6ACCE349"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPcsqpwD1qMQ7kNvwGgO80u&_nc_oc=Ado18JQQmIhV0Rqjl51-SyxbAFCHDUFDLtypgVWapwcs7RLrVvjrBJ25Fx-OO6ggkd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRDlvHmWoWl2JZkDwIto_wmQBhMOfKmM1QHA4xNtGxYw&oe=6ACCFA53"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2d6gg-pLoQEQ7kNvwHww-8J&_nc_oc=AdqaSZN7DdvoNgDFg1RvAPFgilH1SSEmB_vD7wuC7z54xZla_SBIcMYicrJlisAe5ko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJK3hF2K9dgLdPlv1H7C0h6pXdh2AZRiSlyrDSpJMh3A&oe=6ACCED12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A930663HJIsQ7kNvwG4Tnzu&_nc_oc=Ado1FepRxGGDnk8JA83jRqqyksVvNRvx5cFlDq5atg7z2SlBe7CBAcOkGuCKZ6PwReM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU--Kidpmv39YSm55jhbUlCDeCkBQzGKAdsyndVTO0vA&oe=6ACD154D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6uL1RU4v5MQ7kNvwFuOKNG&_nc_oc=AdpcXUomD6Uwng_LVCLvGbjK-apfjw1ZQuk53zUcs5-zOk8o1hsgd3qRPiE_iVoJEmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8KNnQi7cSZIqAlH_Fie941wrPDC63Uv8T3DLTxWfopw&oe=6A637DDC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPFhhW7vnYQQ7kNvwEFrFYu&_nc_oc=AdoDoIQO7mxR4AdWdiAsK4SR-PqFc52K7_yCgcoux4_cSPubehNF90LFXv64jG-2Qlk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJW-qtHOc-Z4K1sl5pfApp37pAhAtlsiryGPbYPl0H1w&oe=6A636B49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmCEe-vUWO0Q7kNvwE5Sdef&_nc_oc=AdrkxRyFJ-GfKMme9jkMjpjY6zrzD8efjnZPC0etKG2eVTtltp2X-pQm7wrbqF0PzxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7BgojJM-eckCo3cFLqiMGC6ws6bjJM2mz4eIKBXm40A&oe=6A638253"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Irutx6dzz48Q7kNvwGMrG9t&_nc_oc=AdqE69lYVvoq6eY7iX-7aZHk-x3vO1pNOeZqcbHAx2zxTFkiAADnRRWB_4l-2NyYEG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNiiw5849cdrCcIeCu7kkOAtcOJ4ChCTtJ_6iXC4WVNA&oe=6A637512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbfzjhwmp44Q7kNvwFKN_3n&_nc_oc=Ado8z4yCh655PrmTvDvN9GBuzHtvKbO9duV2p0Vf8TyTs1MjJ_aDlK2g6uvMJ6TAsG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnOqx-2LaOyPisg5TRT0v_0P33G3V215M6XfxsGKl1rA&oe=6A63650D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
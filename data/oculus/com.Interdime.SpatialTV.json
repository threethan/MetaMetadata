_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2BWEsSCHYkQ7kNvwEYq6mo&_nc_oc=Adri92jkkhYugES7kowTEWCk-0mPNrTc15ySNNIzjpxBhW0svjxwx5zfe211rKZ8LD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3t8y89G_HsLcIRUpQb3C25du1cKU6w20yIPunIwjD-zg&oe=69F0CB5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAJ4L8hoptkQ7kNvwGf-grm&_nc_oc=AdroA1T3aXItn1GYiYKXwji5fAURd8ENYWpBs1sqmsdQiNY6lWHdTNk2HTBrUzvxX4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2k54Gt5Jj22LgXcL7XeWcd4e5USihrqm2S3dSbp3VtEg&oe=69F0B8C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MhYRgjxnKIQ7kNvwHdozIL&_nc_oc=Adre7A1vBzaq__dM0zrP09mUfVdfhIiTh0N8kWuI4eDMWj9RdKVlmHNimAAAb0Bmql0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af36C1kPhTWin9jmU-OtIclHlh6OPQiTs3K-xqDCoVVr9A&oe=69F0CFD3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrmepdX-NBgQ7kNvwGOZINr&_nc_oc=Adr_Gl4_87Cq2Eg5HospauMSd79JnXcurWDEilLUboZSslEfxwBfxEhT8tE5Ivh38Rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3oi1paQ7TKZNFZpnhuslqECYnd_YBzBunhpHyS0TjpvA&oe=69F0C292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRyGVUjes9sQ7kNvwG0O5NO&_nc_oc=AdpVuYFFwx1POGzcJs3Xb9spXyS8HujBHyTpWvyFvaOLzMf2EMzGua7k1wFPR_zPvqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2O9Vier70MWTypvJ4HUEQmkuL1t7VhsdFfGWZoH5zbHg&oe=69F0B28D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres":
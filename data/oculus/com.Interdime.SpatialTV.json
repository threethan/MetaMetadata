_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roUh25dhZtwQ7kNvwHx2gg_&_nc_oc=AdmRjDUB1ib6f3GaDfX-FBo3oyWU9jHacN5v8I0OefbjtVaC7Isn1O1j14WUYOVZY_0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvcaQOgSWj3DaW8ZzLuKXgcbmYMMCQ1M07Zee2XixIp8w&oe=69A1791C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-GnQoeRfEAQ7kNvwFK_dVG&_nc_oc=Adka2T1MrSEac36GA7mubdpHaa3_tboTowfV-Mg2TwrNTp-QUcT0fe3cOSLGHn5nEEw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv1JbldNhrD2qHknjGEgeiPHvZmFVOENF499eKoUsBrzA&oe=69A19EC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt4M6ZU7Z-MQ7kNvwFqXxr1&_nc_oc=AdmO6JoW430ae8MGVDSaJ_pb0J_FuSvHHvpK5EMJWprDrkbYp2rSHeGYkyFYpw7bag4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu0s1gxAnInyXDTocSaWtEMq5n_Zm0fYPhQzdjcAKZTFg&oe=69A17D93"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFv1snnPQuMQ7kNvwG-1TOl&_nc_oc=AdmDqIu58873qf1-SmG1hYOEdJKusAopLmq4vlNqHMI_pN3q5a3hR2nV-eGTYeJzEuw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftfoda5AfKwOO09v1M36j3-vM5sZbYzrK6lUqW8Vj2qJg&oe=69A1A892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbdEEMqMiT4Q7kNvwEFV356&_nc_oc=AdlrHNIkwb-9BdNh6XvvOnR_XOr8Ayp6C6E7Xnfm1gyRWGjasgX9hMfgTYSFHwJ05fM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft8tAbIEZjJ2grl4QK2Lvo0Tu790m7ECxCGAGytfyOCdw&oe=69A1988D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres":
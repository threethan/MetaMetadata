0.png", "id": "460727386930428", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wENCHQufU6wQ7kNvwFfjZSj&_nc_oc=AdrB87EHu2HrFjp2j6YTKnk7-iPdHe84VwDKAi18w9Fled2IpCqHEdQgYhMOuF7K_Co&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAn-BcvjLSU6hh2J7eOY6iu3yKjaWulNMyu-InvBXUIg&oe=6AA1745C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Fbv3ndUcXcQ7kNvwEEcsY4&_nc_oc=Adpxlwuq6A3W-ZBTayzl9quY-JpVpjGk1Pmngeoo0nOHQob_G0XeDM0x5y0C2mzofc0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDS3l_MLeOXL_9tzY11ivvMrskE9tYPfcJKyiFiIYswg&oe=6AA161C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lllFsf8zkTwQ7kNvwFgRMsT&_nc_oc=AdpLBX51bX84CNPXGU_lpJEEFSCsCFvwr5JuDI2b8PGaByhNByugOnSu1xdjZvRP4J4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMPIsVwNNxFrhwYD7qz6xkGsDCInAKwZrhLelqPYlalA&oe=6AA178D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB7z-RsVt0AQ7kNvwFdsVM6&_nc_oc=AdpbubZhiPS4N9MV-wut99OVUh5BsnqDDx8iu83ml8Mn7js_QItJNyMSqs4UGTnn-OM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwy3RnkLe4WkIGNjEKAq-tfGIGnR81OYEuBmfhmC1iwA&oe=6AA16B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8AOeCNk2gIQ7kNvwG0EAHx&_nc_oc=AdoC2iugQWUxfc2iALLVUrtbFMVv4hHAFpix8xF9DmRge3Sx9g1ICtJ5YRSQi3ob92k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8Io0aiWbqLTYgjYptMCA0ihobKx1VQ6rOuAw7_guu7Q&oe=6AA15B8D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
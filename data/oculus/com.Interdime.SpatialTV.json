0.png", "id": "460727386930428", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96hWgZpgpr0Q7kNvwG4NlPY&_nc_oc=Adrv44nnDMlbbl_C3ExGefgJOWIj7Ab3YhF_H09IOqcVWlMa3T-m1VhxN0qyxTzpj-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vj6jkWceF7lnaCv3JyNM6U1PkCKH-5cxXZCGWTRm_Rw&oe=6A2ACD5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEc20QX9aI0Q7kNvwH3mdpM&_nc_oc=Adp0nLIzJeE3zh5FfswV0DFKf4sS84vmJJrOYvnvsvQyPNDmgZHn19iOXbgjvBGKyvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jcprcur0KoIJqNa86XfBnML7Po3FPCLQMFTJhosvpPA&oe=6A2ABAC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqHXAprHPYYQ7kNvwF6fsn-&_nc_oc=Adp_v5ovKV_R35kYbY1s8ZiAa1QDfDyzTuHXywHGKzlyDg7J9CLWq95T6XZfKKUzJhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e9twYO_s6zPeQUek4JzgDHhpDs-yFGcmRLFpvGEgltw&oe=6A2AD1D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGXYJsTwoeEQ7kNvwGRkKYW&_nc_oc=AdonS3DYxHo1umEi3wJFwFfmYwHFm4a5dHZYNOR9oB7xjfwP_BS0aAoqRGJC251-5Ks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93bkyXTzDg3BmWjomUYczSVi7e_TGiM4qbx0pUSqZBnA&oe=6A2AC492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqe8gvTFNfsQ7kNvwHvZQ45&_nc_oc=AdpM5OvFAT0NJM83bEw8RJzPMA5YCum-KphS9JjvDwa18u_d16Wq6-bcTbKx7vHREF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FwfYZ1jPEFvBg7SgVJaygqitzYtSFz9QKS0K227AZAA&oe=6A2AB48D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
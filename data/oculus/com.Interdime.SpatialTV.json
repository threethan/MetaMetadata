0.png", "id": "460727386930428", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiQ8M_-bwx4Q7kNvwEjty4u&_nc_oc=AdqSCIKeijpwbr2o0Ra0EW_RHup4NhRtmXzhELHpyRV_VFwhRmChIXKHPReJ-hr1vS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhO-HDW1JTudZkLMVuKI4bJpSpdEZQI6CJf3V5YxDdMg&oe=6A4A715C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z9gn8LD4esQ7kNvwGCgLjz&_nc_oc=AdpseZFmBCd0jlB49Rc7AsjrlWq5FhqN7pk0mn_3U4brHiae7J66k1LXkbc2qQ8mKxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1f8PidmLupxC4G0tAHkHh3cFaL_WOY97lkc8pYq-5ew&oe=6A4A5EC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkNF9GjaJNMQ7kNvwE8n1iD&_nc_oc=AdrIztdI4q4SZrxNiH1Al_VcUalYktLOAWzye12BkncvtwrZSkHdfdxbgd3n7ztzTPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0VdZtgLyCJlt3fo2PlrV-92OtjRyNUDetfSho1oQK4Q&oe=6A4A75D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Zpq6TiqtEQ7kNvwFhaQTa&_nc_oc=AdouKxt4hEgwGvD9PkrMu8XEQoEe4u0h3raS2RL6yS4klJBNib_idi9Ia5p9FLBBC9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTUCiLIsOdOme30KLVdMhr8CDs_cY_WbdxyYuGy-cmBw&oe=6A4A6892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm-nHt3BPugQ7kNvwGqKHQp&_nc_oc=AdqdMOeofIMhDMen4__87VEd8dBapPYaQ33zGeNywhL-I5ornLT5V3nV88iHeLWc_wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFiH9cA8ALwHot2hIXBrKKgnifj9Z5VhvsTYWCSZ75Yg&oe=6A4A588D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
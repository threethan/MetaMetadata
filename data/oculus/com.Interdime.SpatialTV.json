0.png", "id": "460727386930428", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWOru23UaWYQ7kNvwHkhPge&_nc_oc=AdpP7EYGlq38O9ZvgNNU6aeZwvN84ZXdKmwBKrmmq2MxuyhX9Tg6FB8A5QgBHaV68m4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3QyaMqhcc2RLW6BODuErAolJy4Fb1pZx7E4Pu6sbbBg&oe=6AF08E5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVrG6zACZJYQ7kNvwH35dzo&_nc_oc=AdpcOQQKPkWS7XjDzx4xX9CWatXng5DmlFoUY52dEusunNoReXLRGA-lzWacpJIg2OQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjmF3YmmH7r7cy7L6zXC4CH6EBAu9ZNa0rUaXTtRGh-g&oe=6AF0B409"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFl4lFhfMCoQ7kNvwHKDXPQ&_nc_oc=AdoyDLPZPKTphFiulyWuDMxJyU9Mf4LLCORJYGbZ4nIS2dHPAFaIhT0xfWShSd5ZQH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7_vhd9T2F7taYJtGPp9UNPxMwxdhqSMNdX7wd7RRKOA&oe=6AF092D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWCUcVdRR3cQ7kNvwEqvQw-&_nc_oc=AdrohEdpPC0CWcA67tFt7gkxCFKUUJtlDUv-tOBSaLTxocT5NMUvV63KLxtWrwUdDyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLJc9QeSnWiAoRCzheIUs-nAbKF7naMG4w7reFnemIZw&oe=6AF08592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z42cKe1FbwQ7kNvwFfqtOA&_nc_oc=Adr2tG6gqabWdKsT8yVzDngQ5YIfdMqCpP6h3AlKooVKpSP0F5tvyHDUTQ3iUQTVLLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFVjPBM9J170JK9cIaCpssQMNtTelSpnlKE2CVnk5PtQ&oe=6AF0ADCD"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
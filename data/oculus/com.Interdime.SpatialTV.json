0.png", "id": "460727386930428", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBSWQi6A8XYQ7kNvwGE4QZL&_nc_oc=AdqQHG9watg0GuDgwXKiCYO9VJgwLQ1Mo6ibNnu1RWKX2EW-B7s5zEy40Dj_JP-1F9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrQJaC5XpWb9FF_QIZC5CnPe9GzClDrczo2krB5Yj1bQ&oe=6AB7DDDC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht7xzJ0FixgQ7kNvwGWtJ3O&_nc_oc=AdpFiOOk4sry8kTooLY1VodTUH3AmBKRwiIB9KVXKVyz7LQkYiS6Za13471fMVi0LpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyQ8-MpLUr0xr4Ws1-CrrQyBSr6NqeZDht9lR6Zbq-xQ&oe=6AB7CB49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89DE-HrcHKIQ7kNvwGLvFhu&_nc_oc=AdrURmxI851vK5o9TkMX9tjuCiigHKdyzI2bzaOUnjIHie5c2dO1NMFeDx_RNcgcnY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2-AqhOVfNgf66IhJq5wqZxXzot4uDUz_BNlqEUjAr6g&oe=6AB7E253"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC5WmsYF-7MQ7kNvwFvNNCm&_nc_oc=Adr3ys10_aUOUPpEKDNHJYtg3uKNoWs1pBMFa_OxfK589PT633F84ve6aKwRO43jOdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu137A8Z2ZQGrUzp8WwMd-xEs_xzasNygwg4uYYGvh4g&oe=6AB7D512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmneJK6yHW0Q7kNvwEicyBp&_nc_oc=AdobNFJM1eAPScn23TIOxz4KhyWYmEOY-GtbngJcVwC1TnmsqFcn3r6cSLJk77UR9_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLer2N1BpxUCgbTwFRjj1HeBLJegPTPWyx2c_9zc2oFtw&oe=6AB7C50D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
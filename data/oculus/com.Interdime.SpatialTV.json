0.png", "id": "460727386930428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIp9kEwsI-8Q7kNvwHTC8L1&_nc_oc=AdpB5v-EwJeGVAxCb0crtInXHvf2O9817bxCFeBldoUH6S3o4RImosHRZWWVxP2CvpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlz0CGIGgrbA7uXxNQ3QNjcV_jXu0pJL84FE-SQjZ6Kg&oe=6AB3E95C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Df0ZpQmJ000Q7kNvwFt0eED&_nc_oc=Adp_jNzCe7wyx2CgAJcnJ_hYQyVX8HiqlYTEoN7YfwUm_1_3H-qRuUtgFZoxUrmkI6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw6IUqOj9hfpS3-U8pJqazVNkMPGgF8a8yy-uZfZ21Mg&oe=6AB3D6C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6XbEeAaiuwQ7kNvwEpKk1C&_nc_oc=Adq5J3cuLKrAh_WfujCRzLX4lb1Yif4gQoAzXvgVPZcm1TKTwJu7LiKgzJ9xpfqRyfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPRhRX6viGGlOhiQYXYMMsH-anbkaouUf3GezJT-inCg&oe=6AB3EDD3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsonaCxmq4IQ7kNvwGk-pvT&_nc_oc=Adrhptd1IE5KFtftPapsR47wTfYIhGvB37j3EXmP_h6Q04UDTB4Ktb75l7p3nKq7w20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIsND0Txkz_qUUPH-qdTAc_QeoxDZJVmynU7ihdeAphg&oe=6AB3E092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_4WdRghB54Q7kNvwFMoLvV&_nc_oc=AdrG5e1mDr2K7LaZhAYjdS9soFvtrXLnXc1uvMRGzAGP_X0cilqEHznF6q1w4jY7CYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItdrq1mH7iKkA5BxeLuRSzF-lCNYUsbeuu-nS72x9k6A&oe=6AB3D08D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
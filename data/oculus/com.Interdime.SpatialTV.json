0.png", "id": "460727386930428", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7geb10tmwoQ7kNvwF2pfTy&_nc_oc=AdqQlWiUwtoPLCGIg_IjFqSfIaZNP9BV6bhGEu60y1k-zmsbHp4jD3sE4cLMXxP76qw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhBOOaBjSRnwVAWKN1JyallLkqXcH7sIVrn5KQhKVAHw&oe=69C7B49C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlSZdbYAT6UQ7kNvwHDUACG&_nc_oc=AdpAWb-1p8Ao2MWPU-aKvUC9ueiFWxqRK7Xu2VaFO15N94S5TqxPV1aKmuHgSbZ6lz0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI_VdXzHwxJ2CMeS0zzNlQVCc9DwkieqXi6Mkr4aA3PA&oe=69C7DA49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQVbZJgjpL8Q7kNvwHvymWz&_nc_oc=Adonc2E3Ox36FoMnqcDl9vFvKAcenmRF7mN3iQSEw2cdNTMfzGMsrvQxXaauSXS6Q4k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTo2qJzLUcaSxdiBCMXfERDfyLMD6DEgBUS2_S8IyivQ&oe=69C7B913"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0hcyN3NJhMQ7kNvwEchzid&_nc_oc=AdqduZbISjEC6qW6PbikKANoSvQ73l7c4RLkLW9bTEwhMw7A9Og7Zx3AQ1yZ-F0hh6E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ5KpiybhWsnDvwO7Ty1RKOWJ5aFmumyMl4gAK2IdmfQ&oe=69C7E412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb82UjI3YL4Q7kNvwH4AV8z&_nc_oc=Adq9dis8rohxiVX_TVi_Bh6VLoFVkIGXOPeHb6Q-A3z7XSL5lmy6Th1WSngjl0_GxeI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeM5-83ayW9NqVDOaR7qoJfXK3k2yp2uKw9Jd3fZEf4g&oe=69C7D40D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
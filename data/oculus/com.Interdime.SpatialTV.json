0.png", "id": "460727386930428", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm6WkL5H0gkQ7kNvwHZcbxO&_nc_oc=AdotQ_EFai1TDwCmhoWH5UY5catATLPe_-AhgvQ3yHhTmOdlKJmhHyXHL_p8tbK6C2E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZN2rLVEtPDp2WVwtf_5EvNsAwOfFFsuCD4IjG5AX1hQ&oe=69F6115C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLzPeyo_BfcQ7kNvwEOiGBO&_nc_oc=AdqtE2uhzWNIET5o88igf4veFKCi33DRwvbTWKYBbZN-wOZ-chGp15CXJuH4fLa3Jbw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01eahuZVeYE_APabyINFeNdCmllukr50SOq6EPfjnTtA&oe=69F5FEC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxNtKZ3q0ckQ7kNvwE5dv1x&_nc_oc=AdpmndTHTLYLii7dOS7l5vQniMTw5jryx89soV1jMOLFz0ymN_54lACpAItPLguY_oM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02RGrOdeoWpad5bLbnDlCRE-ty6r7XKam2MQYU-o1xmw&oe=69F615D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxTnirQbEo4Q7kNvwEA245e&_nc_oc=AdrtC_8uwq1ElUXs2dm7xOF2q5qik8Jy0RG_7vRSJEgvgqd2ehIBfvoappheLcxxXV0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2I4N72MWxPDysFX5sS-m7k4tNu2P4CykoCF8_jHvAayw&oe=69F60892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJQZwmS8YkIQ7kNvwGOO8p3&_nc_oc=Adr1bUjVg--8NX1zn6JDJAyeGYUhOT97LwOJaoXkYlVKcZEq645GgpX49ikLDsW4g4w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33l9f2GommkV77kUCUD83CsivlJ2paR5EsiKcOMHop8A&oe=69F5F88D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
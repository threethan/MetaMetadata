0.png", "id": "460727386930428", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6BP-mEmpPYQ7kNvwGlmtI9&_nc_oc=AdqCvlqBl6w7WmgqhXFkz16FUphl1ILwK5rG2AKtUN1I3cBSOufqswVn-82XJQZhuQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DJKDR8_FUMNEu5Tt3SKDgFpU--h4giWeTp6_b33Huww&oe=69D3921C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku_Odcf3D5cQ7kNvwHbPvyi&_nc_oc=Adoq0xsk1AJB10lAxNmNj_yFrXrtIcr7nMWydaZMNXUfzgBqmeVieYB05KB-3ONYvy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15UgJxIHmddjpQw137b6m5Kx2BtohURXFzgY6DY4DA6A&oe=69D3B7C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlsE3tguLYIQ7kNvwEDnbwB&_nc_oc=Adqe30K0KyZXa_x6JwLoAOYdgc53oLe57fMUXxqHHrqEXf4C28yEEm9fJOBUuGjBgqI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rIj0AR_elSWU4mhWWNBOvSCSO7a_ynBKK6gxD5M9Mlw&oe=69D39693"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmEJ9c_Usi4Q7kNvwHik9C2&_nc_oc=AdrBgp13m5MKp7RdI1dDi0V4zLMf-VNUtbnNoaKqU6flQtFlS5PIwb9k9TddWZJWoCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21Yu0E4Oyj0yi4olLkZBjza32tc8_zFUAlyxjgeexkrw&oe=69D3C192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMCcRnR_Pv0Q7kNvwHCAprb&_nc_oc=AdqgdNy4aOEnj51LZlnz3gY3y8C2gcuZYgxKHo1ih9BH-zXq0QLyQAXOE-_9W2xNaRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c19eQJVeZEYNe_vpyYR9iBi8rPka50DQZK_LRG2ysOw&oe=69D3B18D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9CKp8FKPv4Q7kNvwEz2IGh&_nc_oc=AdoMQXr7_cKvwLOT3v-ZJ6IlRO_LxaCtwxs8UKQ0yGnwZo0ENhFDa7Ygy0lpVDnGQ0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzLwHGBxFeoa9ggMIVs2vTSexNNVpcRmp94gDplDDfvw&oe=6A89811C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noFKgCVdwi0Q7kNvwHXofaF&_nc_oc=AdrRGoChXqkmAZL9CVpG3SeZs6_fU3l0NCJdfAKukK7zqaOSWytjqQ6qMdKoe1ahRPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH33iUkNVnwb6-yo_BDDsMzVO3B7HYpIZ2Ur8fKlLg_Tg&oe=6A896E89"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fbv6MHKI06IQ7kNvwHj6ayi&_nc_oc=AdpuPj_UZ_RczYveusEYqMwCQhBNxxU1A_pdvtu2VgoUkoAq6vskASWjGL3QlnMbt4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGODd1MF0KZucdmSuARr-qwJmFVWckjpxFtuHnlRCCbDg&oe=6A898593"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FapwA-jUnmgQ7kNvwEO3nQG&_nc_oc=AdqbHEuwyETgeUryx5fxaVn_Js4cN10TnHKFM6Y_3cUTb1GZTsm53JIefINslMtywwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGki3j2J9BYgCR9HYwzHsjQLiyko8qDGVBwc-ZB2_MGQw&oe=6A897852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJNB6zOuO-YQ7kNvwEEdHjk&_nc_oc=AdovX9dkwuOuZlUuEw7mdTyRXJjiiEV9dltKFFO8PI_kx0iuIKw00d5SLTI_ICbtzq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMda9Q5r5K0e0kC8Igi6XUGsxOA1FcoRpE1eMgoIY7Ag&oe=6A89A08D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOI_XdsdUcMQ7kNvwHJyclf&_nc_oc=Adq2KWbH9ctWwqOhCKfrtffvBDNil5s3DwHL3Sq2uZXEgkCmRTTtLtmMgdNWxdWZaYg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb8BnpAXGsTAx31uabwGpBrvAL8jRkM06LOQs_dhjy7w&oe=6ADCC7DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_AUHHRPL2YQ7kNvwHsClZv&_nc_oc=Adr-cZEN-gV4JKFqsMWgQCIWoGH8the1TJGI5hYmkhK1YHTs3MYxdAEdrRie7Ng8PdQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtOHdqdZg2D4JRd5LVuQkGeF3pEOywdFb3qu6hyMcEPw&oe=6ADCB549"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mEirI4GBc0Q7kNvwGAxkXu&_nc_oc=AdqxrMUVzxl-f-9SNdOCMe4BmaMUA1DCL2-FSGIT38HMuh0jpo5KzL3NjmkubPUbkhU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGucixkFttq_qJ3PjZAsmu6iCwadkpsASElnfHhfjCpg&oe=6ADCCC53"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYvy6LhpoS8Q7kNvwHrFRLZ&_nc_oc=AdrPWAmHmC6eg_bBdgTr9YYN1vUA_7gNnlOY4W2kKH0GtXoeZJZtIB4IIZPgOFkJjFQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_-HzhMK1tub7tUX9E4AH0-24yyc6EkdinEKCBwoxU3g&oe=6ADCBF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHok2bPldSAQ7kNvwFNUNVw&_nc_oc=AdpMo-aKHqf30VbqZFH-PvEsj3j0N6FHBun77VPwGNkWOFibnAsWflzlnau2WUs2xa4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtWpKzR1RfAGnBI5X3acPhLsNmYOYz1ty8D0qcG6hEsw&oe=6ADCAF0D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
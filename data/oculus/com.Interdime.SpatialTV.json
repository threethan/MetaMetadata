i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlmwkW9qf6oQ7kNvwH4MFE7&_nc_oc=Adn_dQg8V3Id66Ha-uDuLcuyOz9eBZpu_szPitBknfVzvMWw3M4fEZQLUERTgQwGUOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ432TqVWLCWO-04_VeeMGb5jLMrKsQYazqrkPVQikUg&oe=69AD569C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khYwseHth88Q7kNvwHT53RY&_nc_oc=AdlQaq56UzRpU0e8Qus8MhEGA9KekpYVQMBfFeMEBmLaUWiAR1hHCwG4S1phuOt-XjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJLM4VzReqGIxAm4qzcXCBdLGhJD5_4ygrtvToyr8xbQ&oe=69AD7C49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6k2nYV82bYQ7kNvwH7pOvp&_nc_oc=AdmpJvXq6ocYrANkVKf3f-uXTlecLrp5qemvqzgD151SuCLj9U7d4c0jIDEWRn4Jgus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE86GbOAj6ZLtF20rj0qitEw0BVYCwQ69JY8fURIopvg&oe=69AD5B13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGHStV_Fr-4Q7kNvwGnDkT8&_nc_oc=AdmamQ2PGZlnOiFob0H4ZEKmnTBqvtkykgju7XHR-dAVCxI9-j1_li0aCr8XARSZvaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIpqzXlqXvIbNXuFMXTxGsdEqxxUney6YyIqA7uCDwuQ&oe=69AD8612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZOCDlUYYzQQ7kNvwEgl3kc&_nc_oc=AdmAIXdlJa57Oq1-beBQSfB9d-G7fpa5bmBHM1pOosJHEYy2JBq1V5pz0hhYBGP6i4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxR3YHryK2V8VqFDSOxoVzRrvxOuNYZD5sypvvELR2oGg&oe=69AD760D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
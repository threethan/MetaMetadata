0.png", "id": "460727386930428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymv1GFAUljIQ7kNvwHAaCIm&_nc_oc=AdqIk0I6CWVqGwb8HU8eZWsqoCyEOrjsLcgJfNoHMh9ANoOFUz6eKJd1-ax1X4w8ATk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMelf-3po6u-2v9nbNjqexby4zhs_FT7RdMXNtcClXnHw&oe=6AC65E5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn_lbbgON_kQ7kNvwGwJNgw&_nc_oc=Adqq6iuix0gfHFFzq8aoRJ7zzPBJRg_xQvISuVyrB2BdD5neb2dZ_4xeB0-0CJcP66U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcMPIyKHi2l5cmBx9nxpvI05aliqVcBBtBbOvoNJ657Q&oe=6AC64BC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUHTmmUIBCUQ7kNvwHuU9ED&_nc_oc=AdrMnxYT88ZmgLh6kdWBJvv3ik4wUPe1IBfcBThEc21GkJTJz5kA4zooClhVjDU06ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9jWoDAKLnvBjhlf_YET3_woRw6XK9SY-Dn4Sm849IgQ&oe=6AC662D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3s9txf_VEwQ7kNvwGnvHYm&_nc_oc=Adqnxbpbnc-Qhjp-nl5mV2uu5tFYS3xOfL_vbvsIaqk1NnVb7aYZOvyUlVUycF2hwfI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlnXutqS5R2N0mdm45AQOvjgrnsAzXoYAweL61WF5ZuQ&oe=6AC65592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1yhlqcGTkYQ7kNvwHiyu-c&_nc_oc=AdpqPaU4RziXl-Kon4eLJRo3ZFifI3YbT3jzDliTmQMaasOQKH-MVpFwZwj3A9gZ02I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiZ8HvgJNMoL-1wnAN-oERzUc7j3XfhINStZFziuqWhA&oe=6AC6458D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
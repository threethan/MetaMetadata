0.png", "id": "460727386930428", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltWYXXTHi1MQ7kNvwEj4O3q&_nc_oc=AdqSrGLUsdk3t2EqW59Mz8gA1EgBJq5nkkfpWIjuTmPsS_CzaVZpOHja2mdZePd5K_o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_qQFp9AwD7X1k1_Y-gWEV_lD1bb6LPWC3ZJpR-Vz4Lw&oe=6A1706DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICKV__L2ibsQ7kNvwF2pEM1&_nc_oc=Ado4balvvvEsLePgIDk2iOoCpVdG7iMIXgIgMbr2o2gufBwtPZatuRbfGaiNw6svlu0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fvPM5NM_i1FosHIk5NC7imoO6afPRZoDNokwf6T54dQ&oe=6A16F449"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us2bPOjPTfkQ7kNvwGfSy2Q&_nc_oc=AdpMP4eE9Md4JJ9V8orVn-45KNYlYL27QT7YMJhRm2wAeBiTtdwifEsFrjX1qqqDLEM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gp6yR_Qm8YVjzvjCQmLED_y0eQeVp3AzAv1cnbqzNgQ&oe=6A170B53"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu6OEpVlafYQ7kNvwE4oePP&_nc_oc=AdoN6tyWcG62r6Xo4tSd7ww901pnQ0TemUr6aeuNGMY6IvRwI5exvlXHZa7NN3J2clY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66ekbsAQF3QTUGYWO7_LuXgUA5zBMEi5Iat4cBZygFsg&oe=6A16FE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Oe4uUCvDlIQ7kNvwEONGo1&_nc_oc=Adqn-VasJMnkxEshprHsve6h0B-JjUGmhYTSW_47FyFMFDgoifF0BzO98B-hzjykTc8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WC5YnVcHtkBmJHXfi_7jQYYX8yz5-BpTfxUOVHkmhKw&oe=6A16EE0D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
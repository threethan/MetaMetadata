0.png", "id": "460727386930428", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoNP8cvnpxsQ7kNvwF46ntb&_nc_oc=AdovOZ8Jc28b6b9tpKX_Y4LcC_ln2W5QMdJ3JlK6hcvxllUANRB3znBJurZPa6pJQbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hGf-MznnQAsckloAfHcz29pjTe-7-Cielhxpxd_j7FA&oe=69EA33DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2MQHItEkXAQ7kNvwHhERHB&_nc_oc=Adpl7Dl-j3tETcFMxQxEhxeA_c1KzsOh_Yt2unpN36aOZOUbfgFrnNmB3G_q01HP1Ek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s7KnSXsexsqhagFgo6dbjqPYGVhajL2BRiBeGL-q7Ww&oe=69EA2149"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki03-z3w1h4Q7kNvwGnYNjj&_nc_oc=AdoS6n8ILAkiTP0j5mxjEo4EXI3gQQYaoLToQqDiw-mjA8c1e6a2YwYJiGfG9XqRG64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z_zB7utkywJGlVrQVJTf32TvCqoxRFj7OTR_k2GUPKw&oe=69EA3853"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrxhuP1fDmsQ7kNvwEDW03a&_nc_oc=AdqbdmGfcR79ZYhDMFxDhEOLWXMIyRbJ7FQ6fcTXxuMYj5SYEoH93Tmd-eVqOUGwK_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G3U6CCzgmEFBVsiasnn633zNz3BdoR6bPn5ACTMt4nA&oe=69EA2B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00mUVy0kVs0Q7kNvwEFqmVR&_nc_oc=Adp-hrA8APpxTzk2FXIUK7pmdxv9kMY5J42UH7TYx1w5PHHw7wfr6VptL2GnHwwR818&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cvcpEVV4dewIvB2LMif7RtA86EjvLIADuY2C3Ur1zIQ&oe=69EA1B0D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
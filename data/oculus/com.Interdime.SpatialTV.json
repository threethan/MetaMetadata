0.png", "id": "460727386930428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi2WkNsunRAQ7kNvwH9PYoc&_nc_oc=AdoxpsISqa5njhCn26M_RLheJ0fBOLzfLl-OVXuVwimp1LU170w9kSGhLTltzSpCfk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOsPKW3gOvy1IdEWKPDWVQiUZ7IXvcr76FCE7d0ITJhw&oe=6A734FDC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6O9pkqqex8Q7kNvwGCSTFJ&_nc_oc=AdqqKzyGiMUiuHYNLZp1j9n6PzndWZfw6CfbKtiM6i5ObvC-TOV8uhoohw-At_QK3PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwhX-6USbk7oBt5ozczYqr4LjSnI_UiAsLVfAq-rrjXw&oe=6A733D49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bIuwyX9guEQ7kNvwG2Ivba&_nc_oc=AdqE09hpDDMFrlkgDqkkXyXO8vLcsk3GSDsgRDbAb5Mn42duDyEIOuwDuCK4I0cPYSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErMlgtcSP84PMiQ3ca8gCTRlKcTtW73JJ_yvePOFPD9A&oe=6A735453"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xs2d9OAqFh0Q7kNvwEEPC9V&_nc_oc=AdoB8c3YVJhNOLGI2bNSnK58Z31FtYe8CPUjD8isTyc6-VDwBGfD00OWkdzN7FmTlqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgCEwUSdy4XUEr8v4XLUI4bJQILm2gaSawktRPmRNd3g&oe=6A734712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmV2XPvcM1QQ7kNvwFdKcx6&_nc_oc=AdofuVO5oI2KI_3hFFBWeqGn7x7tn_9UgMfl8hEHGlfkUidDbhewhzOACWM02j7b348&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiivNRbwNMBaxLrPyvroF99jgc5TzqpfYFB60Cm31D9A&oe=6A73370D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
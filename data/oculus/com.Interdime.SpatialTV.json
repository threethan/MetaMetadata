0.png", "id": "460727386930428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iZNDlPgTZkQ7kNvwFDtYcs&_nc_oc=Adon4IlAo5QC03lujnaNx1u1n49TU6AZeyTvkqZZBuAadwZXcvgxNjaSqlVIKBUwrNk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfaD8DHHqurN6z1gXP4VSyoanbzOncsimibt5muxfywg&oe=6A7B38DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyuXLynLFocQ7kNvwEWHbhZ&_nc_oc=AdrLF2LD982gaUDULPb3TL6M3RfQgSZOL0e95dqKhBlK6HpSHFffePQYZoOzMfYm47o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6f4MaIFdA9k7IrjWuQ_ycZtP2zu-MTuUFZ5ZxfUjhcA&oe=6A7B2649"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d43OjcbunL4Q7kNvwFbyOXe&_nc_oc=AdqIIXWMu0xR4ABkZsYzxiu-e2yNCDjdfGBYV3EZUplBZDztCvs4C-C8f8uPfYrPgR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9gX-uNSLK34yyfQy3dXiZ3GHT_V47olKRHuvXXFO1qQ&oe=6A7B0513"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUjov5TfXwIQ7kNvwHmjTP3&_nc_oc=AdqGoJw-vLsgy8QA_WqSAefiGSr8NnWLZ3CDau4SyP60_tjuvtL4ybHdqlQVnnBLUf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpTlQmt88PIye7cTSmATtEmhvFcilyCc0IliCbCS9AQQ&oe=6A7B3012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ef8fL8QfpgQ7kNvwEFv8qW&_nc_oc=Adr3YxWfL4LRfSEcQA89Rg4EzDd3SUjVnQ4QjbYee0aikRKHzCuzMMj8cFpkpWyfXQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbBLzmvrhsPZBW1KSrDuTlSryMNqERszRh5XZEV7YpmA&oe=6A7B200D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
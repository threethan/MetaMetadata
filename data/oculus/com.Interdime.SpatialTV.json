_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y3J6Pz5DUcQ7kNvwGERd87&_nc_oc=AdlPgEc3ansFwiU2cjbRLwXk0WTdgQu9RHSNQzcLM73RmWIoF75LGmZNKm4-qn1FXc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZ0DjFjEn5t0yC6An8EjFxPE0zm9VIfjSpafv-ApdzyQ&oe=699ED61C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-GnQoeRfEAQ7kNvwEjrEAN&_nc_oc=AdmX6dw5vv-1nCfmcu24b11F4vbBQjB_6nzs_AUUNHydA9-OtRcdj-6k0r76xNVh8_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsdN28DdQGal_Pi-NxH5p_CNkhbbFoKdRL9FAglH7LnfA&oe=699EFBC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRaSdbwhWHsQ7kNvwHCzJCi&_nc_oc=AdmEJjubHWxkSQe74aLtMvic0Yd2-mMu7XQedo5IMaTpjA0ZN7HPbA5Di3dgcxXil44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsSMpgYAO8G8o18b6zdkVPSnoYpy3ye9OILV7wn7fnRAw&oe=699EDA93"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFv1snnPQuMQ7kNvwGvaNv0&_nc_oc=AdlDg-6tmmuq66zW2P71vNdSOL1uFKLBT5_SKkMl_RczzBTRHYqxXwQHMDhBk8tM5yU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAWBJsycsjhOrvLFldXBlaP88xRt_7cAI0pGRc6AaCMg&oe=699F0592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7S-DBTbMLQQ7kNvwE69uXY&_nc_oc=Adn0lUMqfacMZPQJMLElhPWcQ2ljuQxkiIU4nfp0pEgsTIbloF7F49e0OM5yO8QLSbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsefs8mJrtKjB_vbCU0b7N3xJoKvstjGt-clItsCjGOzQ&oe=699EF58D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres":
0.png", "id": "460727386930428", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdok5-4lOkYQ7kNvwGZcpEV&_nc_oc=Adqx32EWJUAfzQPlIYl43djZj4pM_z2CjeGLpoC-NDLLIK9ISQ_8jxJ8vNstfPXwMo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO5URtAGo0xnMMz1zcXnjJb5G7cByI0euALGb6MOEFZQ&oe=69CD32DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ONbBDEdaXQQ7kNvwGNvhg-&_nc_oc=Adqd39wlah944IvyRduVFfOCu7qaQ3VdlkyUdiSHtIb5qJ79VKPZwDabQNKoW1QZ0qA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0wOO-MhaD2IgoSkvGswxut_FOL_QLW6eC2tKFg5St6A&oe=69CD2049"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iLRVv32BYgQ7kNvwEciwEk&_nc_oc=AdqjvXi3ohZ63m82PkGlG0m7nXyyqeV6AjNA0EkgpYSwpM50-lzZxofcGo7Vy5oki9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFKjdUF1zevk57_qAUQBVOQ0j8uPTsgKkoLzvgFGL6kA&oe=69CCFF13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5BmUSxywEcQ7kNvwGiM_L6&_nc_oc=AdqEJYSFo-q7wfsGWO9ypVjQvFRvy-hMY6Xd49SfPfEMVhGrc87_O1JcuB6wWvakez0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk-cWmo_tFmkasqcLNGzst_2blHBSlqyv1klguAYaErQ&oe=69CD2A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF7COF2DQasQ7kNvwEwO9pU&_nc_oc=AdryD5E_jP6dwGDlp-vi1Il92AIg4p9_DtYMVYtyBRg_8LlKyGQNFIYr-_ZRtoil0Pc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6ZmOSb0-js2mZ-RMP9uEgLs0P7ZUb6K99lEoZoFi3Eg&oe=69CD1A0D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
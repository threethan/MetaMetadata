0.png", "id": "460727386930428", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2BWEsSCHYkQ7kNvwFvB8d-&_nc_oc=AdrCfhDPlO-lydME-X7JCVRRgpo7qPyXfCMis0gyp5-LpO22G4Gpn3os5I6g3jB4DE0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00BsfPXVHcr0OJODulQyXIyh14Y-md0kzhFs7LnIBLlw&oe=69EF79DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAJ4L8hoptkQ7kNvwGI_wjK&_nc_oc=AdqW7EVXaMHYICsGUpOpe6XaJ2qvO8lBSYsXdw6fpZnTwZtI_pkwxaq3xzxOQnao2Eo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GDmfd4Z2fBybiJ3UyOrhGlA6WI7arowjFYhASDPb0eg&oe=69EF6749"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MhYRgjxnKIQ7kNvwEFWYQT&_nc_oc=Ado0uysqpKR4NWq_n3pCgECgsKnr9c9kP96h4nsSZm0b7cWqO3HZvAfV1Qy4wedtSdE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XIh3gQJ87MokUTH3jNx0wShkkEnuOw28nZKZVlItq6w&oe=69EF7E53"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrmepdX-NBgQ7kNvwElSccJ&_nc_oc=Adresydgt-qN0jcgU-P7u9nQjpb5VuwbTxM310pRhr9A8RaN9zZGcFwlpBxLEvVSW2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0piPtY7OusQsn2fzp6-VQhnFufGNSzrtJ84RCDWfLMTQ&oe=69EF7112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRyGVUjes9sQ7kNvwG11iBI&_nc_oc=AdpC7yVjXCIwB5JzMHQviPg7Yn3UY6zbsoyU5sZ-NteuRJQ2EuZu4jYqo3qW3h6Dz2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hRnDHI5oqkueN0P2KcVnBAHIRyMlU2pgNkIs_Wcs0tQ&oe=69EF610D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
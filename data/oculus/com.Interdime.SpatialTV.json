0.png", "id": "460727386930428", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1u0wTb4kTIQ7kNvwHMRGHL&_nc_oc=Adpfls50rp6lLRXlrwr0eiFEyUZteIUMh0OeidnyLuCj3uVltw-ksEUtpjbgVXGrGNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wDHiHHkC_2Fcod06uXzw9QpJYcAOjUsWnKtjtTw7trQ&oe=69E63F5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1x5M5WvVCXUQ7kNvwGRfEnD&_nc_oc=Adonoz67YIxeir7exuqy-9gF5vEbgr3hH91b9AEDTfNjRLql8eoh_ZvDFIDRNOblV4s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1anXFWA5DvWWlv25ZLuNb7cKUk05GCRE2sfhhers_uDQ&oe=69E62CC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ua3B8u9UWwQ7kNvwE1IYc7&_nc_oc=Adrp2BzkVV86KxgUx59NS16O4X4DwOZBYa_LEGEaec1CFYVRS3tUtb-7mUCrmmCVfGY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C0R5Br8ldgulh_Xqbq5eQeOwQBS4RoVixMNQDT0mVAQ&oe=69E643D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfUfV6EF4BIQ7kNvwFuZxZV&_nc_oc=AdrbRl2X6SCwJa7KWqkaYuIUbQ4JK3nlwngvbFAAJDiKOe0uAc1lqv3lvy4hPqz1Nng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-wpGNv3dvG6aKKQbU4t8ul6-VKL4QQYz41bminABeCw&oe=69E63692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEmPQug6Fp4Q7kNvwE9qd-U&_nc_oc=AdpVYykC2NGMqJqitIZ6B7eCgBhlLJXvB48qVXcwJuH-nlQEJWGTuZ5coiqwgwFxFiA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Twn1UXNEDqKtzC8-WENQIlrq_0mOv8sUe0q-bwwEZRQ&oe=69E6268D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBSWQi6A8XYQ7kNvwHmLxvB&_nc_oc=AdqcYrmpaMDzCa-IorEdtbMiKnk8RrEmurDhv9I9savh3Tcg4rh_sEfxS49K24sLvjA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkcleH79dqpheD3vn_Ir3jkdBiHban0UMkJykwx96vFA&oe=6AB68C5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Df0ZpQmJ000Q7kNvwEej5AY&_nc_oc=Adrm_zKFbHPz8BveQ8kFFpQgxmlUoKDg_-CK6weIp77QeKX_S9iZdk88PEm8ETV8avo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkXSMuNBxu6EQeKW2MvuooPqzhAEC3XehGQakPbN7unA&oe=6AB679C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89DE-HrcHKIQ7kNvwF43FVl&_nc_oc=Adpl2xU3s5H_J6A6rTFJ6A_zu0GK77iiHvezURKF_2tcukYag6zRJQdC719dMFLg2BM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLGMjtCJqArteBL3VpKSGXVdKhurMcWE6ePtdgq5G4cQ&oe=6AB690D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsonaCxmq4IQ7kNvwE3Rf0K&_nc_oc=Adrq1jeDWI3K-IwCmpxqtvjoMQg76zFm1q_oIrVOPsgvyKBIwP3dAC1Wub5zxbUVahc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfy7fYHjxOZp6E-hmP6EsYse7KL_K39qcq_Rgs_zYLUw&oe=6AB68392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmneJK6yHW0Q7kNvwHYtszy&_nc_oc=AdqKDqFZi4gX1lcUnzVwNfHWjUnYvbPwOgQWC_QQdf0pNgr2drgBKQwF4Qp6qwbM3Hk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpWrKgN60en_SZs3_eIzaCxTuXUpCa2bApY2G4lpCliw&oe=6AB6738D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
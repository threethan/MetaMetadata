_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roUh25dhZtwQ7kNvwHWcfv5&_nc_oc=Admkc2DeC60KbrCFhzXRxCars6IBO61sMa73HeP8Vo-fIhNo6sJB18dK0EuGwO2jGf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOSkdT6z-gFg61tnh5pb6GSGk3Wuw1Y_LWuNcstbeO4Q&oe=69A0279C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-GnQoeRfEAQ7kNvwG7qM78&_nc_oc=AdncqLBeGb5YN8GPX4pYJr81bR6Qo07s-HY4NwlmaTi7sZva9h-gZVK4TgSQLpZInvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvasl2MT6Y73qZJRBW159HtswQoisz1tCvV3wk_WSULiA&oe=69A04D49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt4M6ZU7Z-MQ7kNvwE6O6LC&_nc_oc=Adnn2JTJx6xk9rFK-zo1LDxM8HMut5qXSyKOmGGGHI0ktd0KuWzdCphXtWe1tAJ9gmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvf1v5jRCqd7QlaJrydKqlczyhtTTZ0qtXEO5cu2DT97g&oe=69A02C13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFv1snnPQuMQ7kNvwGRlrjl&_nc_oc=AdlR_sGcbY-VxkKXwzPFR9jYgns9hW_H3yKkZdNd6msobR24aV_c5wcSe-BzQpGnpsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afun8cnVokAtnTwWnlWt6on1mGnmJq5DuUv_u-4g3voh8Q&oe=69A05712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbdEEMqMiT4Q7kNvwETHbA3&_nc_oc=AdlwCWwnQjwk2xhrPeTkzOTtbO1TwEOoFgka8M2UQckYoAynSCCn4FilKaSTzNyqkm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3bb1FsAodu3GkV2l-xIO7bKoER2xUgB6aPamEisUJPA&oe=69A0470D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres":
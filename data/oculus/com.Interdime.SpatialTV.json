0.png", "id": "460727386930428", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SACemJR-rn4Q7kNvwGQwSt3&_nc_oc=AdpvfTb-_QSudPOuvTAEykTx7jLUR5rfQSKS-xQdvLjA55lisVp86kasY3Th_vhWOsI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1OxOxjtaQtM8_F2SX6D6QaQsVDCKEpacok5VeHPwxGQ&oe=6A32B65C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIK-2rjsssMQ7kNvwGwJ3O4&_nc_oc=Adoifl4Tj4Im0EUID6XP92l8Dg2W233Ifc-6cadUnVFUmWi4si0qBwt1Ky9Po0_2h28&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zma693PiP5gg5FomExkRiREprtE-cuxFKAehgRygfmQ&oe=6A32A3C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngVu13bWN_wQ7kNvwFsDlPI&_nc_oc=Ado3U3L2L-_eHBfYxyu4IhPjSI-0UCGngBiohPdFK58pJRDvrBttt0jyZzcewv9w1fU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_odAqc09Nm6Tz25PfSm2AYkbLNbJPNfCMpiPvqkMN_Yw&oe=6A32BAD3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGGoVYwXffMQ7kNvwG-DNqC&_nc_oc=AdrPCfmOXfJaHSqnU-lbNLris1yDTmhyxPC3cd06gNmeXHF6DC8Jzi6QqpnYO-Jtai8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z0QwM_97Hfi0D7DOdL_SAy-YyAyfb0mSbY-moWjJgCQ&oe=6A32AD92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZdpjQ09GuIQ7kNvwG1IS0s&_nc_oc=Adok_XiUXrv_fgHadeX7DR-5Qms8CWevRU_8tpo1_phphlE_gb0fp7u9ZfP5hW0B-ao&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LH6c3vFueIcBhdq9IfRF9CB2HsjA9DqS0t-rhRGRp7Q&oe=6A329D8D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
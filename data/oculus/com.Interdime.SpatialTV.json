0.png", "id": "460727386930428", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm6WkL5H0gkQ7kNvwEC9jRn&_nc_oc=AdrONhllwxRiXRVs92Sn0yNbC4a9FRL4synT1PbQGiOQYZKO9wL21qa-8SrzcpK9qmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28Uz5DAoSsFixZS2yn-Q3WFTOgXGK-BUIBDOfd2zFJVg&oe=69F36E5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afiiw3Qk4dwQ7kNvwEC6mmF&_nc_oc=AdpOxQFhYVoGXL9Enxc9cb74DSSyDza4l-D8O1JQL3td5EKknsjoMFeRE0Gsuhe0P64&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ft4IgGb3NlvGNsGyfHIfV4Nx15aXeX-IpgKtwSx6jSQ&oe=69F35BC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxNtKZ3q0ckQ7kNvwHZl2RH&_nc_oc=Adp7_Zyo0QMBzPd6Gbmjsn9DNiC8vL_2rvqWUG-Q4E7aIFUzrDHyCA-8WpZ--h-tL3k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WCjOkTvY-fTcqbxsV4Qnkw8_Zy9tOLr2Cwj7ppyr0bg&oe=69F372D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKsSjQEsUi4Q7kNvwFKi1CV&_nc_oc=Adq2_kjaSFd9npY02kFUKM4svY49w-WQVYs2UWq8Py5VnTVvNV3QoI62g1u0-7yjZoU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aKWp0su2WKSiyAnSteCnhFgRtS1pN9VIe2Uw4lkFZlg&oe=69F36592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJQZwmS8YkIQ7kNvwFP-Cik&_nc_oc=AdpoUmGIHc2-6-ki-ktajx7X9bKK5U43ln-RCjphSDost8z2-WjJCV1__zpmBhaokg8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ITChc9LoYRrYXhBJP3zN7KAiLlBFYoDfcwQDzVhcw7g&oe=69F3558D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTpzxfHWtZ8Q7kNvwGhscaK&_nc_oc=Adqm3eEb8DfyPYiwzUe11_DlPtZmOsO-c7ehQouvLO5XNh8fB1PZarUCTzMHaLcDhPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IP8wfTkp1pMTQc42UBGq0mepKSVMknJsV1fiTMHM8xA&oe=6A42885C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQQQuTZNprYQ7kNvwFMAqQN&_nc_oc=AdrN8P4A9Spbcrse-9ZPA1AOT7mk7gDs-_MwBPlrS0CiOQEJ9Ti-hPN4zN3OG9_u9c8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dportAuegIRxRai0sNgoL4-ep7-vsQMPTxl82x2hM0w&oe=6A4275C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_dLFLd0rvMQ7kNvwF46de8&_nc_oc=AdqvLmY-bmX7whB38tRuO3ghv_v53vvOGMBYr2wRQXzcKYa2Bj9rZRRMp4KrPU9FiOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l4fds2YcNtUysvoo3m0EVJve2EBCsP51Ztr-83GMh1g&oe=6A428CD3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=613djWisqpcQ7kNvwGKSLr_&_nc_oc=Adpno6Nh6iCIkSryWZIyJq0J7RcZNhEdvpcMOuP0ipVVNvs1dGMx4J-VVbRK_KMdjVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AkrgUTzHLNrMVEa7dJR5-95gGXxn0OaCHGsYdk2tsKQ&oe=6A427F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH5Ah-8PX50Q7kNvwGWaHGu&_nc_oc=AdqLd2m_yxeahiXm3XvWGotrSBSsmkrblRL_Tae1Y09H2ehrDMKF48M7US3TByBm9wA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sBJe0UpPgmNE8dCMyxOMHhKJNxgVQlS0OSya8xyRZxQ&oe=6A426F8D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
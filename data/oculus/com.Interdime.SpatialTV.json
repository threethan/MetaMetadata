0.png", "id": "460727386930428", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoNP8cvnpxsQ7kNvwHvjfBP&_nc_oc=AdoJHss6r0wj9oWedrf4DJLMD7zVRPd-YyQihL0USXd1dC-ksvCUBjiv_n_1mtQ-ndk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3re0DAWOv_XruARES138jAjqIwMsV_ya6qdJbKRVSEFg&oe=69E790DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1x5M5WvVCXUQ7kNvwG1iU9v&_nc_oc=AdpJKMdXJyUtW4Efer6fBrEikJ8fuToLHqT7AOe7H0_D6P_xgeXQ0Z1VchEif2K3qvQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hKYQaFat6yKjkssQ7kMYugIwvCQzCrHRbs9ysKHdMRg&oe=69E77E49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki03-z3w1h4Q7kNvwGkB0zx&_nc_oc=AdoLiH4G0oxEV46Qm6hB8jO2iCmCDedZuzBUx4PWYwT0Q05b3u9EAaNQe3rQ4RZscrs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R96tj5cuV-m-Aom0d_q1eS4YR2jBAlzeCgFUhRCzVPg&oe=69E75D13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfUfV6EF4BIQ7kNvwGH03gj&_nc_oc=AdoLWb7CEkoJTAcft0jkTq3bh3AEQCR1TloCSHA5IfXhHgv0CteAhY_FxH99R1rpVAM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ekX9x4en4CvLnob0RN-PH3nNILG4pH3xHxuQngnRGUA&oe=69E78812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00mUVy0kVs0Q7kNvwHNwg9X&_nc_oc=AdqCXtej5rgBJufr3YmCGXmllxce8SfMB-G_NjcsR2Vz84SVdpiT7ky81DWIJlUmCK4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Fhn_0JEZOLjOb6shJMxjWMnpoEDUJOSXUxySJZH_osg&oe=69E7780D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
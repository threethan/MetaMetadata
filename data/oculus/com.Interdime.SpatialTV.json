0.png", "id": "460727386930428", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWCB7Bo3fU0Q7kNvwEHO6hN&_nc_oc=AdrUe7pbiqeg2Fk_57JyexBMMFrMcjkz28ACF4Xtyzh97NMd_rNgxm0f5o6ktBgbtFw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oHQC0On-8-Y9Hgr5UqDcFGT5D3di7c193mSGgkD1k-A&oe=6A3D425C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwS8g6zv4WAQ7kNvwHk_fFF&_nc_oc=AdoeEcPg7nHHmkqB79x2jasOVl6QZNcLq-rFx4RCvP_DoGc7zMipONZ11ShV2zAwePw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pm4koNTrYmObD4L-P95jYhHGwsc4RxMKGGGj9lsjcmQ&oe=6A3D2FC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVVHh0yXBG4Q7kNvwHlVY_n&_nc_oc=AdqBfVpTA6Sj9_vuSGn1ivLlCV4vAtMgR0tbFif-l4mamDrGWfRXqVcBfUw8JDVTYI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wpXe0qMEpctVNVYh9MvMx0J0ogaCuf2IDKY4o4VrucQ&oe=6A3D46D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8QN1gTeUksQ7kNvwFSsgng&_nc_oc=AdrvqJK13Ctdc8c0l3r6FOuX9mhRpdiQRK-lD3CGm7eukhqS8UPIsscA40pYP6TFruU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w_N0-P7JLZXt-2OZH-mQEx-qHsNZIRKeWA0-RyQ_WpA&oe=6A3D3992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1ndqpn7T2wQ7kNvwFK-7Lm&_nc_oc=Adqxd3J8u3nY7LW0XW8pjCilRwpRjBMg_LFmT0e3mggXfm4h1BcZbSF5NOpfKd51CCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bBThBWEKLwHZWQbcYOFRAjrWTqq0xJekq-R615Sw4EA&oe=6A3D298D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdok5-4lOkYQ7kNvwGRFaMZ&_nc_oc=AdrNSmybyfVyQj37VX8ypXgvA3Mmf3F0AZjjpaTO1rYMqgk42nOyBqJy3Jq3cXwl4FY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLb7BIsS3kMFZeBxX6Z5LW55rmwK_vWmkQFd8BubRTVg&oe=69CBA91C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ONbBDEdaXQQ7kNvwGEvn1X&_nc_oc=Adp6g09LgoeheSF23cWYf1TCs8TYpV4OfgZL7TZoR2YVrsqWbL_tAa8ACoP_7Ry2Elc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwkztb5fxHaLOyP4DCdCF79WRwZavDWk4Hot-RzC8IJoA&oe=69CBCEC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iLRVv32BYgQ7kNvwGCiKHs&_nc_oc=Ado7Xi4uQ_Xt2IhWEd4y26j-2piIe76O88uwpZCFIj9rOarRGDdJuBXeIYyvqGeBBf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCBq_MX6BZMRMcJTmExSuzNgOCXCyXoPcWCn0_h0WoBA&oe=69CBAD93"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5BmUSxywEcQ7kNvwEnZEuo&_nc_oc=AdrrKvVLGZPYJ-0NoaT267bmKfequGYhOrkVFQX9YkeuwINJQJz5nV8eqqeeAPHlqO4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGw0YhHz-s-HuoEWuWpgejF1JVrQXBRg5i85d6SP3XQw&oe=69CBD892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF7COF2DQasQ7kNvwFBfbrP&_nc_oc=Adp5ajyqlsdoibQz6OwTXbLcUQC6ieITLcM0A3EgXFwpZsgdj79YWopSlRvebXWmDy0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afweug0e506avi8iY2A8gVR7Oe1Dfs419XzwnhRw61nbxw&oe=69CBC88D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VOEgJk9Lo0Q7kNvwEOlMcv&_nc_oc=Adnzxrnyvug850Dg05FMVRwDsedNTkJ9D-HXkVB_DfNJHTMLrEP_xkLbl_suAthxWRo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwG3Vh4ZRrulzUY3q440mXhNiCMIKguXh2dS4WYSFp4yQ&oe=69BD60DC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvZkcrXbQs4Q7kNvwF2FY6_&_nc_oc=AdmiJyVTBKyaPHXx3Z4-4l6qkYgNHbivtYUmnOii7JQHOnkFUXgC2-kti-trmK22wrI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCj8-GMrK29Rx2EfB1XXxw_UnADuEYwnTWL_HQ6PLdrQ&oe=69BD4E49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSzW7gVBJ_UQ7kNvwE3HUwt&_nc_oc=Adn4pqO-8OSdxVvqbLpRqqHQejlub6tkAshxtf20ZT3Pzy0maqFvwWCwLXJGYMPw328&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwr7fFKJtP4bJ-UQEf50Hpk3J4ejwzt3rj-qSjAY7EZZQ&oe=69BD2D13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLxmIv5wes4Q7kNvwH2HJ_o&_nc_oc=AdllWpGqqk1jozpEo3u8e3gzTrpWGMPjFdEBXO-bODU1ZX3XkVToOhKnqH8QCvPHOfk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzzqKES5emLxPNQvkhFs9fyIzHvIUpGHQCagDrnGC5ow&oe=69BD5812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZmGWi2kbOsQ7kNvwFc5pV4&_nc_oc=Adn1nGPh8Ao8t56QcKKXBafrTEpoIX3e4x-q3I-55LKKnVEj8SlCHXp_u1gaxz_r1g0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd0A_gcUQtOd47F4dc6224uiOOGyFSoVYwxcLR2OWJ2A&oe=69BD480D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
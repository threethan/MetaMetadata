0.png", "id": "460727386930428", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss5eVIEGEm4Q7kNvwEk0nHl&_nc_oc=AdrBXIRY3XeHnIYFMdlqFc_F4GRQtpZqQWB7UNWAXA-3gVIx3xfuRLIdzpmtfvadGnQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmnZjDTwkSz8kq-bLIjNOl4VYoYOS91k8KNOnx94Cfnw&oe=6A940D1C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHtAreDsGwsQ7kNvwFPuLZ0&_nc_oc=AdpavVAf5L7zirx_oL7HdhmXD37H1kQSu7WQtLq3K2l3yXQMFgJ4MNGRt8FsKJrw3IQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdaf0b4SZm_qLAE4VjY9PRqR59me3kpNE4et2LqjF8JQ&oe=6A9432C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkDKRVlagb8Q7kNvwFdAPMd&_nc_oc=AdozbsxU4YnNs2SM3t0g_sFnXKZhLqjAay0NcX8MqC0De0TW_T6JvMRY24VajmpkSOU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt8Bh4vtl--XIYsI18u6EJVBlPGi5p23b7IA8zFPqi2w&oe=6A941193"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyDtymtfscUQ7kNvwFZYIZE&_nc_oc=AdoSu5YEAyVh6ibYizpdYj0EeT0Qs_Ma-sdwrT_0b3mkITVV7uGeS5oNth8iCQW4cM4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8BKG4XzFM_xxhOZlnjt5HnYkcoQ6Akcf699ptm3Xs7Q&oe=6A940452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL-B2q3kdzUQ7kNvwGJkKML&_nc_oc=AdrdiKkiY3Z34YOpHwut2AUgmCj-9WjF_jUhM3twZbazc8-qKUGUm8GhQruQ6cW_UgU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyR5Px-qTX13JGfpPODAwSyHDtQQDclMs53uhLgrPoJQ&oe=6A942C8D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
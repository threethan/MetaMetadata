i": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5edqq-WzVe8Q7kNvwERgQUE&_nc_oc=AdnGbTtCIgHrGW4Z4KF3Gc3g2gGhQruEllplirbWeVBy0xvKMN__YLdWNKBWYpK0w7E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzIyNOjN2ScbblMmrx4f2wZfx-aIRNJ41hOP2KkAE8uiA&oe=69BA859C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvZkcrXbQs4Q7kNvwHlA3bz&_nc_oc=Adk3n5e-3lElSJ_j2uo3bx_aybsUXTlZBWFn61XLfxQbcyt5wNasl2PZ9ElzjeEUSNQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtlRVPeJmDdMSoBJAyVRXNCjFZGwkJa-qPVVEYasWe3A&oe=69BAAB49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEQ0M9CTY6cQ7kNvwH8BhAe&_nc_oc=AdmnJ2Eyacls0eqdnBSKO4hwSmNWhb75OBqVor8D2OBeIyA0jb9XI3_MHzGIp4WVXL8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYE07j4I8bNG2jpEgiEJxluG99Ue4KJmaMyihvR7_Ikw&oe=69BA8A13"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLxmIv5wes4Q7kNvwGLVV6Y&_nc_oc=AdkyK133CvSSiqtkg91OWb-nxMvfLaW6fbg-IGLuB_yXqRElY_ELBRMZ55P4r5-RTi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzY-TPPZDez_Fcka07Bl8LhJcNUspeVm_Jrj8Dl_-x8uA&oe=69BAB512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2nVIu5jlAsQ7kNvwFsn9GS&_nc_oc=Adn9pmfUnl7YvGKw2-P4GdW5alwoLYp0iJUy9XopnhDztz7BBbdWovWN_Hmlq1hchr8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzwxFC59n26I6x5Ze8FyDyC0BELk3IXcDQedKZe7qPVA&oe=69BAA50D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
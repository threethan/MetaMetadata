0.png", "id": "460727386930428", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCQf75wHongQ7kNvwEBF3zZ&_nc_oc=AdqEak1_JBvF-jUIMNHcmZ2muR23Y5ZmJuVuOLBpwoSzJgfxc9W84K1U0J0O0-j6LAk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEysiKr1eqtGZrPYpM66CoyoQuWmIWUnWFSOuZPtvwR_g&oe=6A882F9C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noFKgCVdwi0Q7kNvwHKz94U&_nc_oc=Adq14EnKx4JGdCbrAW9X6QctXrVgsCu61XrYOeRWqXo4t0gGLlOsHPpNjdLe1AQNwO4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjkwBT8_uO5gD4GS3xzjcyNR9d4wAT_5WgjnBmbVuE8g&oe=6A881D09"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZEB2iJ7e-kQ7kNvwH67rK8&_nc_oc=Adp7g02HVFYqhxeH8n1a2cx_X8j6_YRc-3HthUKxez2GiRFOhCM7sAXQtq6zT4eq28E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGV1r3SR07W1gUXMckx7Oxco3szaa8w9YTZWMnvkm8tQ&oe=6A883413"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FapwA-jUnmgQ7kNvwFwOINL&_nc_oc=AdrwBBCrEnEEMGaQeEuxcyIO2cTptKwTGDz6ru5ezkRUaYXYsnLaHiauEElxHR3biNk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjwSYFD0aV7fIUjo5koFFtVMwC7EUsSfrQWrbHgQLBwQ&oe=6A8826D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn-A1okYJjgQ7kNvwGMQbVA&_nc_oc=AdoQs-d4mSvYgtFLqE4_v3KyCSUsmiENX7p0MHoR93XbZQBuQ-PC5sDeGV33As1hihU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEtp-Yw5JjIPel94O6BzgUoC27um56yo5PP0q0ESwbXw&oe=6A884F0D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
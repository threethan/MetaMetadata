0.png", "id": "460727386930428", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYFTDMeocbMQ7kNvwGeh37D&_nc_oc=AdrSePiCeC5_0avC_4HyNuQPhR6PuFqTOdrR6syn0Y_eflSo5RwsZcIPaRTyR9RZWIY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EFO1TmwQX-FRrq_QA1TYpCQAk9gOMa_VIWWmqqO4Pqw&oe=69E24ADC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpfElC_PhpQQ7kNvwEv-qS1&_nc_oc=Adq4gOTDFOEoLrJwMs9K7qBgjos4wPjG_azrfeUwambpg-LmxhOO7Qmhqrd41BZWJAw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jb-cQLZxh_hrK3rfZTNJhtxWj1oTjgqUH_vVS2N-uOA&oe=69E23849"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xf_GfqJNSMQ7kNvwFbaMUP&_nc_oc=AdoumDyEWei_MngW83Eyh-1LRojcDMsPa9X1yVGl_UnhHaAjGTd_Kj1Go4qINTTsmBQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-A5COm-SBUBhXaPmubQuWLnOL1uxRcHyeNmJ1x-0UJQ&oe=69E24F53"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXbfWkIfEjYQ7kNvwG_pO2k&_nc_oc=Adp4-8cp_WAdzVX9o53H8oH7lmlQouuMBVKnSKjoEGe_st0Eh62hliZIP93L0zzDwNA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bXGWjCLtRB6LBMFoufEuOj2hxien73Wvt35lqZIRKXg&oe=69E24212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK_z7eU1OKcQ7kNvwFdvqhr&_nc_oc=AdqYhEVgnGmq9J4Gf4ji_alxvF2ehcNj-9wvt92eMigIaOe5Da1idb2s9OK5niHr-sA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qEHZ33vr9sGonat4WIe2OWJ26ulnmIOUuOnHqVr0FMA&oe=69E2320D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
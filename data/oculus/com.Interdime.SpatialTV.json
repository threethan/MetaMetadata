0.png", "id": "460727386930428", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyAgJc5FfJIQ7kNvwEN537J&_nc_oc=AdoiyeUvGUkNyLudLoiR3a6hs3TJ874xG_MJJuldErrEfI5ztp8VZU4b7_q9xMJSrMs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJVfT6VcpbctiLtHITRniLY65sJ5tOHbyO75aEFLZ5cQ&oe=6AD38D5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD0gq7ewVOUQ7kNvwFKjYhg&_nc_oc=AdqjIhp3L9a5581HXQjvXsNV56ediuZ4W8aC6__lW6tCWV6U325cY619AaIEPCaw1X0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxw7iIAMVjWFQwOuBMHpiWhCHpxFybk4e6ChjMB92h_w&oe=6AD3B309"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwQFKrXPMYwQ7kNvwGW8Aqa&_nc_oc=AdqUGW4XIjw8-cpuBVH_6vAg9wJ--xG31QWpdcrI7seItVWwdxNZ2S1zyzsNmbqrqbg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRYgJfrvVH53ByBovArbFBRs3w3HP5snlVrNjAm2RJZw&oe=6AD391D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NERuJ_noSFwQ7kNvwFu2LyR&_nc_oc=AdpoWmb_JSfGnkrrwOSpVpq4GT1roDG0GE6w21l_VqW0Gmixea72pfomxj5ngm6zSGw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0YJNVTC7znqmTsjIevDND8TFnAkyvt9gtLn8fxEmWrg&oe=6AD38492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyDoVJuMhvAQ7kNvwGQgN9D&_nc_oc=Adq_0m3XyfVFA9FAxKuIayNnIM2i-WQmJwp8Uf6-rlt5KmqGF4yVYGqLzog2Kks_HUA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGI2lChnVSiiRNAaXgCD_mNYUDeuVAgK7DU9l66KXGAQ&oe=6AD3ACCD"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
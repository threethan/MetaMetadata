0.png", "id": "460727386930428", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwL39zQrVMIQ7kNvwGVwJSS&_nc_oc=AdouM91amlktXMG4_mWt56IbC2S_xS6lhKH5xgjQUenIE8biWfGz206xIfCYi5cAbmk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ym6CpzhlGTxZZ7yEF8N4uglGHmrwrfMg7pDfZMcMgAw&oe=6A1C4CDC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-TMpd7SItUQ7kNvwHjSIE3&_nc_oc=AdqdaI4eUdOV0EjpSLF43BPMwAKY7XKYbYXQHMGhLcvTpoEn-AM9j-5KMah4Ra2A-20&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MdllH8eN2hejII9qBv44_56EeiJOnmGcI5W3253vWjg&oe=6A1C3A49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNy5f4aBKyYQ7kNvwFuBVja&_nc_oc=AdrSFDFTORyW6RKfu8dzHVVvjKoNbZisZM12TTH7sk4SObsL0vJBmUV8E9Pbb9RTYDE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Or01Zt7Bt-Vry1vbMO1TnpHIaccmmqpMzAZTHF8wpfQ&oe=6A1C5153"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXLyqlXtNKYQ7kNvwGbQjvh&_nc_oc=AdrsP_8lsvKb6rf1VHUWvffOf1e3NAeROJOYGDqFj99Of0-TfM7zhrAQlHLVzzy7jzY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SSrN-1zhZ7qPOtJ-5wpmHxabDN7VNM25K93VIoBLJcg&oe=6A1C4412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0aYwOzx1KUQ7kNvwFYCK_A&_nc_oc=AdpKKG2fEmIHWTecjEI8t0g_whajsDlj84ulaX0W1k8iUrZ9QvULlRsqSeSbfcA9HzU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Qb05wSIHG1xqrDipqpkHWTGVRbStaYnneyTaZdobBfg&oe=6A1C340D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
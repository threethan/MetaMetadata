0.png", "id": "460727386930428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l39hGtrLkGAQ7kNvwGAXfI9&_nc_oc=Ado-MCIysaT-nVJHZ6USHkrPpMB8_vQYkf5GIsRzshd3xGyxvKyLM6YU-8nt05cI5vU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHt5PtBt96Y3HE6iEA4Ay396bN8fy9tyarPng-Km7t_w&oe=6AA6BA5C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnskGlgX2FoQ7kNvwFEdFqx&_nc_oc=Adrf2haSZIZZ5QJw8vSTUME1PA-JmkSUjufW5v0XDEFQZq3BGJ8aIqphERK_jeeytq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI75A16gi8y8FkG8NeGX3DP4CHWn_jO2gacz2la1BgxIg&oe=6AA6A7C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXvIX1q-DuIQ7kNvwH1WmxS&_nc_oc=Adpfg-13Zdp_p9Muad233DeV2hTCGgiVWxyffsXkfMEfX2FYxBJXfEGRWbpycUqXm0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhQSuP7NoUZ7-D_vbWPlsvOxzTBiDlII3RfjJcETxnZQ&oe=6AA6BED3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3VXTQIxeOcQ7kNvwH5tDlV&_nc_oc=AdoRFAQ9Dqijt70L87HMgSbeMX4U1hQk070F05MCS5QLCPeS4UXUzjciKYMlx6Mjd5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-fSK8Sj7mAAv7l9elLVEjZ1v9mwntDluFL0EmIHWBuQ&oe=6AA6B192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCWSC-jDNz4Q7kNvwF39Bls&_nc_oc=Adpxq430skmksszkP49JLMzLKxh6r5E15HJsmYENJWDjphQoGcq0EFSDLai1cdXk5Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRCO8oVaWrrRVHFgJqyQ-hvCppY9B28SsA7jzyvCJQfw&oe=6AA6A18D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcES0uweII0Q7kNvwE62RhD&_nc_oc=Adqf1Topvm1qhs4vSBtlQEOjDiA7nTLkz08vxA9JZ3GypumB97O8YHR8RUmf0qNEgKA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rpENNv9trXdz_1fnr5vxdC34I22d2RyDPUgWBJZTXbw&oe=6A0F1DDC"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bfPu350b6UQ7kNvwFBWKau&_nc_oc=AdppYE2ILc6mvUYsSMJajzNpi6uu-R8OR9l01ZPP6W6UhDxvkI-7wfe6R9lL6h8zwPA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57KvmQjoWIVaOP6qBOHx9XhorYiZLfoG17BmVNeyO7TQ&oe=6A0F0B49"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGjN6gVFGEAQ7kNvwFYcIpa&_nc_oc=AdrgtigICgBMwXbp_RwOtqtGRariGZX9WATZ4wobQ6NfYIdSPEGNgYyCHlBhwzuwFKE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UIiXGQaNRJTIh0-YQTF4XupOz_SbF_o4Mj1D95ouvoA&oe=6A0F2253"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6ZXaxu3VaEQ7kNvwEIrmnZ&_nc_oc=AdpxAfiz9n_N_OGZw88lRMmi8qi5od8JrvkMnrNUXHm8v-NYssV85OJyqFjft55NB1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TzTGJiEwJ6o4hbDMQiKMNZnervKGXY0FUE1F7pN0JVQ&oe=6A0F1512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZFXuB7d0Q4Q7kNvwEV0efK&_nc_oc=Adp9IQWdD1y1a3EasIBZp0PJXDDi1srGSu8744Gc-dtZt9ROgEdS5L9FgbCyMRJFnqw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67xVAPxCqU-HOSOwOgy2q1vvkNC5QLBzFhx_iJH9REVQ&oe=6A0F050D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
0.png", "id": "460727386930428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031655_460727390263761_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQqIojGF-mwQ7kNvwEP-FIs&_nc_oc=Adp0QLMhCAXDtDjZwpbhuvPnskGQ9NTdfgRgsvk87ZQHqhp3D7M3A2ZvQ8oz-_KhZ5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEh7g0UyM11hY5AL3rxgxfqtESISF8souBLMUInsBrag&oe=6ABBD25C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_HfYO0JVd0Q7kNvwHZvOXH&_nc_oc=AdpGSkSKfbnirltAX9gEyTy6dit3oBmcCDdCWmcU7ivGtRK_ISAcEs8jb2Kt4pRewZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc-IVDJEiL8vUt8h-IbRNjsNCeGIprancAfh-i-gLXww&oe=6ABBBFC9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODJjSMjmObsQ7kNvwGIw9DR&_nc_oc=AdroJ5jBX-9coIijC5ZsQfnyyVDHtF16YAwqW1OWJVN-wKpuFCqR2Zr32Gw-x9IvEZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS1i2inUOYcAn_hODLnHwYNogL06ZbGnq9VUTY3NXfyQ&oe=6ABBD6D3"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_FtSNjKZ3UQ7kNvwGgNwiT&_nc_oc=AdriQgXBvYrmNJ11x3V5nGmpd8bVklAVJ4-23pMjGgR739WecacSUTnLRbWrFlAsg24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrr_9nxNwP4z8NOxbOBrU9oUFob5eZyj1LRw83UQltKA&oe=6ABBC992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H5mChMMXWgQ7kNvwHR05ao&_nc_oc=AdpvZBJ-yfkzUiJIELT4WjLakcVW-GyrzoXPDkgEVvadmmKt9u0gNdCofuw_Zr7tMjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFFcM_nAepqhtDJqVevbkT3-MSaiXPAOS0o5PR1B08jw&oe=6ABBB98D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
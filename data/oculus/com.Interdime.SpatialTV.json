_9081801733047056990_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y3J6Pz5DUcQ7kNvwH1Sm6q&_nc_oc=Adnsh0LJhkGy1B1e4jBCqsFn8hhNCxVhZdtgPWJjkvRBqMNtRiAmdVhqvXsaU_MkjUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvs7ykFogm671n6qR38k8pAgLHmsa8B2tMCjum-A0R0Dw&oe=699C331C"}, {"file_name": "glow.png", "id": "1116003646903939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_1116003650237272_6007306760773728309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfX2VH05LBUQ7kNvwEKH1Mu&_nc_oc=AdmtioZ3ZjHK7xYNyheAFzlCIaN3TH54TmKIw36Qkwbs2wW4KKPVuizlRo60reW1v6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvo_yp9xLxzmjvtzElT_M4cHmNHK1HrZ-cgX2Fmox-gfA&oe=699C58C9"}, {"file_name": "glowwithenvironment.png", "id": "1113184757482952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035308_1113184760816285_2144318049796039853_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRaSdbwhWHsQ7kNvwFx-Jnk&_nc_oc=AdnoD7HzBqZPNBG-u09r78Y7ri99Ly42_Hkb7k9FkazPUVNGb5vyG1w4A9qd9k966Ao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsW-ltwvg8W2uAg9qOo28YA5Si7LDEI4uW7b4jLiWdCRg&oe=699C3793"}, {"file_name": "icons_2560.png", "id": "837700041651002", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031639_837700044984335_7632039083082594382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdsncPgVx0cQ7kNvwHu5oh8&_nc_oc=AdnRYnVsmqW2SkDqmiXOtrv1zX9Kdsdk6bPihjz8_I-52jYczOJ56w9RyjXCRlmQhzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs129LYD-FhBwOwoFwPOVY4qXgHStuZyxKp9_jPS7twRg&oe=699C6292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "1728150691275503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1728150694608836_5619279543287794777_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7S-DBTbMLQQ7kNvwHjyxXd&_nc_oc=AdnYAUA5jNHfsqMDbyWNM9WDn-xmiYIxeU-e-tNbDf8vgTOd2YdOEoPkwHhMQzhPIOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft0PTe3uq6FX4_cT5sPEejfsFourQF95YW2RulOBXRz2A&oe=699C528D"}, "display_name": "Spatial TV", "keywords": ["Disney", "Video", "Max", "YouTube", "Hulu"], "long_description": "Spatial TV is the ultimate app to watch movies in VR. People love the amazing ambient light that transforms your home into a movie theater. \n\n**Dim your environment and immerse in the amazing lighting effect**\n{852842470242705}\n\n**Glow your screen**\n{871490895031711}\n\n**Supports YouTube, Disney+, HBO Max, Hulu, Apple TV+ and more**\n\nThere's also a built-in browser to access any video you love from the internet!\n\n{1152430492726135}\n\n**You will also love**\n\n- Optimized screen clarity with 3840 x 2160 super-sampled pixels per eye\n\n- Making the screen really huge and enjoying your favorite videos while lying back\n\n- Super flexible screen placement and intuitive design\n\n**Enjoy the breathtaking ambient light now!**\n\n{1150597832678777}\n\nNote: Netflix is not supported on Spatial TV yet\n", "short_description": "Spatial TV brings Real-time Lighting to your AR Movie experience\n\n- Lie down and enjoy your favorite video on a huge screen\n\n- Feel the magic of real-time screen lighting\n\n- Maximum sharpness with 3840 x 2160 super-sampled pixels\n\n- Supports YouTube, Plex, HBO Max, Hulu, Apple TV+, Disney+, Crunchyroll and more\n\n- Access any web-based content with the built-in browser \n\nNote: Netflix is not supported on Spatial TV yet\n\nFor support, please join our discord: https://discord.gg/G6J67kW2Vb"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatial-tv.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Interdime", "support_website_url": null, "website_url": "https://spatial-tv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres":
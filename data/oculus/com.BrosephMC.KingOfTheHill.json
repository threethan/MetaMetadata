5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKrjuayiDv8Q7kNvwGXvTHj&_nc_oc=AdolPDUlPWhuNcmjLTi2NSTQnGZKK5kjL8C8RKSjZV2T9YhGmnnGQKUyAQupOU_3Kv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP0mrtJ3Ek2awb2i1egg_uivt7FlndaEjQ2Ly6o0l0VQ&oe=6A6DFA2D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1DdeedyJFoQ7kNvwEQrJt_&_nc_oc=AdoEisaw7OH5Clgpz3mfjn2J-tBy-m-KTcA7vWHcDaDAl9N52Iz83xQDQp9lvZbh_Xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2og1ftUYayj8k-NEMVXH4eVGPG6gsgKMKJDjus7F6qw&oe=6A6DDC2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBez4p46Q3MQ7kNvwFU2Ivq&_nc_oc=AdoUjNVybGo6rSosNq9BQbBhLWnhB6NE2NaHzaV7UvRmN-JSuTNgivyXu4ksP7eQ5Uc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8QaN0KMJXztUAQHWhWk-ThzY1QuXfHc6DL6NY3WsE7w&oe=6A6DDA42"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
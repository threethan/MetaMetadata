5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rAnN0MUmCQQ7kNvwFN-dwZ&_nc_oc=AdorSeJ0OnEyI5lg8kfoT_QFjIpL8nZrnkqtAsdrF_m_lnUyOMrOa-UTgVeJgcrB3VE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r6OP_hONvTVeXtN-zRgGQInoKLj2Btuubdf0ZOJYffg&oe=6A3549AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnowO-2WsAEQ7kNvwG9sDmq&_nc_oc=AdoMExGsWPgrbZHn3KggQAUOS22xpVGG5rw25Jdi5RBNHRy7bwn_zE3eg8vg85bWUd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qzs2LUOvT3FfhjSOwBfiyUWLFJUNlEDJZ_lLArJ5ZaQ&oe=6A3563ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9no1qEQG7cQ7kNvwF-maxS&_nc_oc=AdoxN82-z_Pp5wKLAw6Q_xYpESYPykQbaIteIMl1TgKxokSVFhXtmUH_F2zxldgG2AE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TvJprjhISA8MBDKrfkMex503vC9xIkZZjnirTo1-ZEg&oe=6A356202"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
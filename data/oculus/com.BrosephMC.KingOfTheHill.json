5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z_NRdF-s0UQ7kNvwGc6tgA&_nc_oc=Adpeh36PfOUQcYrFnT5JZ6KjNvu0ouFGyMubFH3gJHhJ6AzScFEbJqRpVn7zj5fFRn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sCeOpLnUmNBpuRZC47bQjmFEdZUUpfi66tL3co0vsMA&oe=6A2031AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnxtwe_Ihl0Q7kNvwEjS_yp&_nc_oc=AdoXWFL3ta9vqaKGID21Hxde42OvmDzVT86rQ394ogHzHDU6VWbmyEVDv52F0vWrwps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tzt3Ig-EdgPw6D_OBL2q9vg8jiA49uSSgD4HwUXDnHg&oe=6A204BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g48Q466Zwf0Q7kNvwFJHyp-&_nc_oc=Adpjvyby_a-5izaYiwaZvaR-Y_ATlXPllZmRv4oEK0cLY4WaEvcMVSvIF81Fr2enBeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FGlBCkJCCtHqEwSBqtBNN3wkustgW0HGmUXqkm7xSsw&oe=6A204A02"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
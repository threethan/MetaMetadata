5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHySsjTZMX0Q7kNvwHZOpP8&_nc_oc=AdoTpMdPnitFrUE4E5kfR6TJTg7uRgOseNuAGbDeLwDhHScl4qkeX8lQSiuV8VtENPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vh5PPHKhxadcdUmSTWJLco8ZGm8cf0koJrB25ciGqRw&oe=6A01DF2D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c61U406YSZQQ7kNvwFumN0N&_nc_oc=Adq_OgEufVC-kDzYLohITnJB4MTpkeQEnkfG0IAdb2LHjbqjstg0UyEUJmW3PCAyhO4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Efp_Z_feabdIzTifFLN0oRBU7f6b112rhh5oEcDQ13g&oe=6A01C12D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qrwAyikww0Q7kNvwECC0x-&_nc_oc=AdqUEgZXDvwFprnsoNXzcUWYylPEX7Lj_S6PhtOndWg2FH2sS7AIznOKRipeJguYV6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qH1KcoJHQLboou_hsyEnM7ckAViIksATA7Mb0AMFm5w&oe=6A01F782"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
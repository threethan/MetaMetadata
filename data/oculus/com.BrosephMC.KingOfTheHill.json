5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03kN-rmqmQsQ7kNvwERoeOH&_nc_oc=AdozGSbKzlDt9_KRybxnF85jreigp0JzvTsZqOt24MSWxiItYDPOyuguCE8D3tGnMsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-qHdmEbV2A2adyJm_ebdNTXTtQKMsCaiPeBAVrMVKvg&oe=6A2ABDAD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOtowGdWskcQ7kNvwHnQDp3&_nc_oc=Ado_Au9AoOIvqnKynY2eWmyz4R-D9W552ZjVEpVy6Ca8oRIKtinmRcBSsQB5bv6vA6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bZKsVO5CZG_TsCE-sDofUnGjNgjiWBB2cB6J6fTP0wg&oe=6A2AD7ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3apjTP12er8Q7kNvwEOzBo6&_nc_oc=Adp3kXF_JpTQd_uT8LMUoMMYnEVMpjB1_XB9W5ka5S9CgUN7PDJ6-IY_I2Y_AeHijMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q_U3NHYC3zdh_rVEUvxLUKrDSMI_2P8D_5Uq4ljXh1g&oe=6A2AD602"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtzXhuTn0GwQ7kNvwH3NlMJ&_nc_oc=AdoPVAM5OrSTthut0NYv1vkX5VGosvYMU8XnOzAAYFkgTY96CJH5vAdkX0i9_KWCfbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qy8btJQDoDms1yyMYPjVis-01hAa5vT2EzLD2j0Ol3Q&oe=69EB75AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmDOYnj_wHQQ7kNvwEEttTq&_nc_oc=AdpKMYj1fIFTNpDe0Ki4QHIi6rmd6TtlZRgUDvL2tmLGgv-GXhjxUEckcj9W_Y020OU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GAO5xBaXhZ4zMul_w2vU-4-CGF433mGK0lrDLungbHA&oe=69EB57AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJrRgcZA-ewQ7kNvwE5SNnj&_nc_oc=AdrOUnn0yQGhbvrYR1qtEDHYnfggOfPPcP0_nJxFcNyDz6GY42oYh8sts_5uDEnf3Wk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dmn3j7Ux9pIfUsN6z1Cxe3EQuJHjxOd2h2ktg8npF5Q&oe=69EB8E02"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
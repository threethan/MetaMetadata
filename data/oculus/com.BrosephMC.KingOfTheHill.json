5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP-D0Hvk8vIQ7kNvwGVJVGP&_nc_oc=AdpdZ4RNh3FhFwlAGOsQ9o9bEhU7VU-K_Zjlmem9QAhBK52BssF0H7OjXC__K1lBros&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eKYkRlg1588jBFOLau1P5BoV3rJFYRtDCn1u3UO6LkQ&oe=6A199A2D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWsezETUJ50Q7kNvwEiTitM&_nc_oc=AdoU3hHKx0jZi9tKMlKsKDSJg1orq2j5Aw6M_DmKx75L69TT1cPcmia-z9vANdpLzSw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X5gqGU6YYxMCYl2_CsG1hmly1khTiW-fq-jBrLDZeig&oe=6A19B46D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a84ob4HI1LQQ7kNvwHGkKza&_nc_oc=AdoNw-Q0Cu3qMzTd-H9b5FDEiH0RvgGMjhs9eyeVHeKo_LWAxt9192LpejRKYlUdRNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53jjxkCCyXao_iJWdrkd1Bu5a3BNuGQCG8lkcuiKrhsg&oe=6A19B282"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
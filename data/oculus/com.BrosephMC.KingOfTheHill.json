5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z17FB7bVGCgQ7kNvwHrpwsH&_nc_oc=AdrrUE4chNyBnLQ_X5-T3z2semD98LeMJ99CicAzVTs9Tk-mpalKr-otMe34EclOV7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JNmSWHdRXmWhWPW5BY-Ow4BVYCBsrZ09x0mmHuXty6w&oe=69F8A4AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3C98YiBuHcQ7kNvwHzbXHy&_nc_oc=Ado7M9g3_1QB06ZubS3An5q8ujtWZKUniAf5hyyxbxZ55RgGBziFfd-h0vXA9CGYPLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1v_0qqeGgT_JXVbSDcffYleUChj965tQt2HHyAo3C4NA&oe=69F886AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYeIax--FOIQ7kNvwGeZziD&_nc_oc=Ado3rr54rvxwDdx3SQDy68SHEJ7dxwGALDvHUQQBgDnJAfuuMs8wcvUJ7Hil0G-kPhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2I1VphG174c2tXQahTPHITfnoCWGoL2msuc_xrbsCZZw&oe=69F8BD02"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
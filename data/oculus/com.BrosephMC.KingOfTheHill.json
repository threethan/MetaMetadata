5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKrjuayiDv8Q7kNvwGQeZuV&_nc_oc=Adry1qJqghjRt3TUSg4D5heOzMAAf2eg7tO1NNaQYH58cEoDLwpugMUx__rM5rpDCNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKpADE9L5t4py0oUGBElLiiHhE_8E5IGWkMFDHxpE-tw&oe=6A709D2D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdP2m2JCRc8Q7kNvwFj8KvT&_nc_oc=Adr7zP8zYXv027fX5eb9J2LhFa_kTft6ep3b83zG0N5J0YYhWhWkhJVrR7DZ5wEbM5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhwiDPXZXogY9CN4-9p0tw6bvJF1nPjzTozhBSBH2ung&oe=6A707F2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBez4p46Q3MQ7kNvwEdgx2D&_nc_oc=AdrSaa0aw9E-Tdp9qX-Kg0OhmRePqW7nlzoT2BR3y8duhMq-JDc8htAWT4c-0N5uYjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEuuioScptFj9Ym_7F-5dhhL0hJAyE9wWZTlRl15JazA&oe=6A707D42"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
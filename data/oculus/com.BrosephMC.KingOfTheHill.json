5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjgSWtYWPOMQ7kNvwErUdII&_nc_oc=Ado7aWMhjceu0T3sl7-dUM01dUHG1YGC5iMoQaD2yBn7gNBftGr-TU_ikZAkZcHNoxk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWzIJklZ0rWA7nnce7QUnRFfo19gfxL6I4m9ijk5YLDg&oe=69CBD1AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJT8W-g1H10Q7kNvwFHEmGD&_nc_oc=Adov_yv8KyApdbcZAw-oqHe9vuS2WhhiytKcBNaaMugBsNYTZy74EYjUPZxQHOY2U0E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0zQyxmRwgms9xDtERRUWun6WQmh532CpCnRNl_n50yg&oe=69CBB3AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdKZgqZf3UUQ7kNvwFkCOJA&_nc_oc=AdpDzZYkMl6AuL54QQ2GMFpTymTwj8CnsLQQ5H1tROVIGVjPMmS8sgckvZZXA9pqOwk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWQc1LJMYJRVHNHXJkQLejcHLPK8zzbd3CR2eugsm6Qg&oe=69CBB1C2"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
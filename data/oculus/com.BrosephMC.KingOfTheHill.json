5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWPY0FOtXoQQ7kNvwEUMZMe&_nc_oc=AdpT0vFcnKwgpPdGmHkmxLWhqvf6xbhJ3sEOxJ5Qg05cLuz-bndB9LNaeAhu3du_lZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZG3HC-i5Sz6g8gd-4fRhN8EFPWOH3A8ncuD5c19zqmw&oe=6A6762AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ujc2_BCiyUQ7kNvwEpoRaF&_nc_oc=Adp4ipZm6xsJg3liMYP2umdaUpAgAI_RHoq9HBsMNUDj61q5_ceaTT3XGANgi6bRbAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSVLQVCOXQ9_yUMMZARTTvU_pZ4oXfUTVM4m6eygVkBA&oe=6A6744AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSyGUuf5qm0Q7kNvwHD2JeP&_nc_oc=AdqMbAcedoG4wNPZEzkj6TEx2BWLrceZDToQ0a1prWldB3rZQuWfoYM08H2HiBb-0f4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtXQfJ201ttHdLIhuBDvUy4pNrzhzeKKDI_l1pIVUCiQ&oe=6A6742C2"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJLRFAA0qSwQ7kNvwGpqm8X&_nc_oc=Adp8XTqp8Qk41WobJ1qas5Rm-VpOyhNkn_pH3XFx01WrvdMZ00Ui6cFRWhXsx-G8Q2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1bnytBy3v3JTpCGL-QKq6s-CVxtjTOlF4s0upbSvs-w&oe=6A8C146D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh6g7VQ6E9EQ7kNvwFo2JBL&_nc_oc=Ado6os63ODs_8qhqdKFXEmx8fQsLY5EAp0SdlT2L7-RAyMFfD6VzetFXuALKAGdH0b4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn7NDdKE5RFLRc41aL0OlvByuyaAL3xo2-S-jAO38Xpg&oe=6A8C2EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu4hOd0W8jYQ7kNvwFA7tua&_nc_oc=Adqi4tX-I2fHwPk4N8bolgX-joPIwAr3ns11cXVVOnmin881cV8GFUj1XPqaUOO7f8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAk13-e0PdUpa9BM5smm1epTtJ4_xcoywAFuvORcSSlw&oe=6A8C2CC2"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9L6iAwm328Q7kNvwE45gB-&_nc_oc=AdoE3TUKIYY88smayUT2sfa7DEWV9irrfqwGYcXUMWSU8HCikFSJmFfsD9S5s2ezd9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIG7BI8F-RuDKgsFMfFYLMOJb5ladVNDlngDq2NbmRtg&oe=6A997BAD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljmZgAnHNDIQ7kNvwHZi6up&_nc_oc=Adoysd1IbpSzcsBWmuYaANvQaGUHN6hrEzhoaIFoTe1-lPkIS2DKRAwofNJLqFYgMF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWRWBJOD23OO45Cd4kOvi05Qcqc_cU_DP8_qt-Q-7a8A&oe=6A9995ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTgDS6l5f2sQ7kNvwHafpW7&_nc_oc=AdqvdxaztFph7j9vYIRNg_U1wW7qQR4_bq21vKt5HIeaVBxKQQnHdnr3jz5lPQKO8NE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt2gQdVUK0na6Ujrjd2sP1BCHIlxitmKzG_8s2A2wvtQ&oe=6A999402"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
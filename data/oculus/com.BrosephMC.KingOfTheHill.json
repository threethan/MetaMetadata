5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-3qae2o530Q7kNvwHGUJYB&_nc_oc=AdpGNc-XVr1i2JVLdTSIq-Da_CTwuUpFxVRWJFn5c0c442WTVIrAOOOdMUxAdlR1qzI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUXXu7OBod70Hd8WM9FGBhp5QMm8NLYo39WTl9dlywUA&oe=6AE895AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcOJ_FnWvhkQ7kNvwGCp92l&_nc_oc=AdoKm4WLjS1KkhX6FxYTxxXj81YNhQU4QNrFoMXUOIrV05LQotndVv-Jj_gVHBIBBjA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv082b_FDWtkmTUWCQDKibruMjqR2ZOd2G8IaSf6iYvQ&oe=6AE8AFED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7deDIMBnSkcQ7kNvwECMfWk&_nc_oc=AdoN2yvUcKI4rjZoLbxgSWazjYobqoBBooG4GsqGDCfpBY83MgFYQoyetadzHLMP_es&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7bazqh2sPeUNOePLCmpx7lWMzofH5aI5Q7DrDTKpt8Q&oe=6AE8AE02"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
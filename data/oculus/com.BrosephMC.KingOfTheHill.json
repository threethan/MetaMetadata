5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52U9b6VUM48Q7kNvwGq8PYv&_nc_oc=AdqjZDMRgV4izFRm3MYUmPbvptCv5X5m22yDYDBlpFO3ftnDPeYGp7DnDSNla_x2mps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TyjRdqfmdEXHVnPw2VbbTXae6S7K7vuI6WBowRY1TRA&oe=6A31552D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBRtqCfsA9EQ7kNvwGYAal1&_nc_oc=AdrKtucrI_HJwxCsCJ8UT4GCgD-kPr6fnAkdbqdQJDAC_0QwLPh688fHcTZQEmr8nNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UrAPu0lv_P_qSSyr4ZrP2EWTFGx6zW_Kvj-taScZe2w&oe=6A316F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5JEiWnpRXwQ7kNvwFt32_4&_nc_oc=Ado3SNMmct2Yk-KMP_mDxzaDnDVRHUouMGlPOZc66wuqRmb4I9z3_rZZmLiyiFClpP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99Ur5iAzeqvlh7J5vAUFYlgNjd5Q2Fs4nFHkhe-BsI8A&oe=6A316D82"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
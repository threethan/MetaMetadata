5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btUhsBqmdaAQ7kNvwGDbNlh&_nc_oc=AdqGQP4Su2y-p8XtvyqUMO-torR1oTYGVsobkzHmgdW9hNdkaDHFXoLKaAdWixIf3aI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTleLfoPNP31ZJ9egQSrQXD3_i77_xHMS4lYovSFOEOCg&oe=6AF4732D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwnNo1t2dhYQ7kNvwEktmsV&_nc_oc=AdrsxQfka15O3GPN_TESJxr5Y7EW52MHyZazlYK7Nb9VdsgD_AXOjEcUvaYkhfHx0tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs2IZAzP72LWWa2Wfp68d34taXn1nAH80RXMP9WTVj3g&oe=6AF48D6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9ZQ1wseFboQ7kNvwFQzYCI&_nc_oc=AdpipZqQ7AWG8yEmPOz2wCGfM1Mx_ygMFUe_Kwc8M-jhst992nXeubA0orcB5sEqBLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdxdSZ5W6SO6fIHAYl0ORxWUPc4cQfcqGm3RKY3z1RIQ&oe=6AF48B82"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
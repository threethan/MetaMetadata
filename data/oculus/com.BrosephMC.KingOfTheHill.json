5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsoUlRb9pJgQ7kNvwE8BpfO&_nc_oc=AdrfRnDRB_rt2kKPuScfJ0xVhxLXrJtL6uR2_m92GLtweh07MSW1ACpvg6Uu6kbmcZs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO81f4NJ8LLB5JSAwfMAwiyt5zrSpYUW9lI7HGIsmrZaw&oe=6AC8F1AD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQdbdYaNSs8Q7kNvwHsKOAs&_nc_oc=AdrceLCavE8KI2Y-IBFjQ0Giq9-_YYDxfCAkqfXLskLkO7mXnhWxmLBZ1ZOsRK1NXao&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3ORrFQcp0HF2a0FFxtw3OCN_3_CqcBX531sJze8abNA&oe=6AC90BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZGJKFLboEgQ7kNvwFm1fyi&_nc_oc=Adq-5QrrqERkbURRN0Osyv44UAhE7MFWfwK_jzymvh-U4UlSuWUNFnTx_dCaqULRiEI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgVMVGxlv2D9dENXIkPxDcrQegtoGlaJ6bJ2lsOE197w&oe=6AC90A02"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
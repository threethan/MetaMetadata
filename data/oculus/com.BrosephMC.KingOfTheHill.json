5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3bUetgbvXsQ7kNvwFiQ2m1&_nc_oc=AdpR5pFz-uZd5zYV5TGXiK1CP3p5qoQeX_nwb2y4-1fwa9GQVYSZe03K-F6P6Gv0YOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89GLNEQNCKHQS3rDD59Rsb_iXDDoOOawKnoNQqXsJ7SA&oe=6A3E842D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBvpkkMfCW0Q7kNvwHVNDIA&_nc_oc=AdqGDR34ji-floeS1iFlhwN1i8HfbTMZMeSuj3PmonXeztNYOoXbqQk_WfFgbg_bUHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A3JrLs1vnhjUF9TB0E1v2lGldZe5rQJm9cuCjB8T8eg&oe=6A3E9E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8mDuCtiLZEQ7kNvwH1_5Rm&_nc_oc=AdoOkRI9Kq8pFVdVbEuPe7tYHLUMlXLMa4u4HDz-JvjOjE8qqCijXnCbMLHHU-z1AAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Nnipre7nzX8pMGMNHFiD6ju3N60g1m7TOxwCjsxXoUg&oe=6A3E9C82"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J68VVV2u4bQQ7kNvwGUwP7a&_nc_oc=AdrNe7hs9PuW49YP5nlMNdzsONv3NrMD6MyWRAFzMX8m5KNcoK7SbAhv9z4dY5ATjG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIP6FSdwrwSRsB0GlZ_a4qwptCgW7zQVLfUbfbn12k-Q&oe=6AB2882D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMCacBRM8HsQ7kNvwGABVC-&_nc_oc=AdrqPq_Da4maGPJ_r0fv8PFioH6HaBLpiRd87diy3dhCTtP_Qab88T-kqUvzErvbJxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWerPCEbckhKDl4JuEYlU5nhyvmz9sDkNZhelIPqMY-g&oe=6AB2A26D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln70GguC0eUQ7kNvwFNGEar&_nc_oc=AdptRwvJosAOAE3VaGmraadkvI1fd3JcbqCzTgsuSjWJTWU4NOHkpOFFpIxcDTmHEus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmU3f00iwi7Yvu0W6TXl2SdyF422U0HMi0bP2ZIcVR6Q&oe=6AB2A082"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0YzbEdQfcoQ7kNvwFzir3E&_nc_oc=Adrfl0zkDY-dRwqM7DJMelmMAIi2upzjgFzT1HQy7j0YwmFJW6UDLcnjLE1bmILfLC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaukvDWCVMpSXUEPzTBWccWZtCBBYJxk0NNBnbdqzpIw&oe=6A524AAD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAarGBlvd4MQ7kNvwFtSjHw&_nc_oc=AdqXvqTNWYqS5Vlrkr5kYVRmGCDsGFH_zJkrlUS9BaMX7jTSakBv4OqUmZSALVZqtlg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwtoNvu2VayTg5e1WyrIrxxLSvNoPVPXkfLXB70YMz5Q&oe=6A5264ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJVni453DqgQ7kNvwH5MpPO&_nc_oc=AdriUU5LFi_6LYJj_ovRswF9X6wsfyDGKJSQONG0iuJfgaooLAYZs0UUsvLBIlKn2fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgWMkBSH0Zo03_aRgrSt2v9OLm2BNWKeKCh7jDgharGg&oe=6A526302"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
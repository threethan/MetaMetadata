5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z17FB7bVGCgQ7kNvwFEFj88&_nc_oc=AdrrVaFAjpHfHy2F0SKIlRdtzKTuJmW7dlffTxQGkELVmitw1h8SmYrwk5xxmjZYj4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lM-WSMUXjwhzdJNlm86UMPlv5XP4ApZY-5juKMoATBg&oe=69F9F62D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXhAJJ0lPwQQ7kNvwFis5h-&_nc_oc=AdpiTjXbhzfXg9LCPgcvwF5uQ7vL87fBoKAE0L09p9dFytc5BgFhZG0gMI8Qk9JcQXo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v5kJfm44_9h2_H1xgeDXoqWaR9JyqC8462BfxIILerg&oe=69FA106D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYeIax--FOIQ7kNvwGDu1Ot&_nc_oc=AdpPVtv9ZUs_gpsz8Yu6O_jDt0L1b94jnebAH0M17CrlAPNHj9hbDN9WV8TWZ24HFj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b1RI_edz3bmFpcwN3IoPZ8uG5CV3FniNqvw_TrK3ghw&oe=69FA0E82"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
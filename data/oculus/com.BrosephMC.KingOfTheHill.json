5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM2xTT8eyTwQ7kNvwHMl-Xp&_nc_oc=AdpMSZT1g5LQXzKlQG77a9GDt5a4fsvAt6tWaG4izRQDJQHVLLoHX-aui5umyxYoga0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzC5XXS5gqku1JSeA3h87gGCFvBDcH4Md-GZINdAkkAw&oe=6AE4A12D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RFqYx_ifAoQ7kNvwE7-V-k&_nc_oc=Ado85NIkBlu-_5p9x5H-kINmGQuaqHMJKS6gX4grrPpaGrVTf6NTgHx_LekBh6fVy58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVoc-E9q5uR9DyVdrThqVU9U8_hhnKtvau0N3pDC1K8w&oe=6AE4BB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWa2nSPd4h4Q7kNvwF-mUHL&_nc_oc=AdpsmjnFgVTnRW2Btrjfzse_R8RWFGUCfZ1hT0xmIAMVjLVlPFJrkzcxeD3albL-3rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWEtrwpzuF5YT-DJPqgjq7bpUr0Wv7TyZiB3DzDX5orA&oe=6AE4B982"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
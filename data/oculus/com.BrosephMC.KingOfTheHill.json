5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OraXFNeZ6fIQ7kNvwFp8w04&_nc_oc=Adq7e1w7p77TVXHUBwseik_pVJi8gGuuld3gg_ZHyljKADJI-Z3H2htqIu66C4IRctA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlC3m2XHIblbqm1oBvbPYLQcAAjOZBetFEGk-jHDAMKQ&oe=6AEF656D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CD8htTUca7wQ7kNvwFGSFAo&_nc_oc=AdrREKDg6TqkOByslcMJFjNtCRKPRg09zUiWFJp2fQGfCBT3hFGnfhaPH6x4d6jfDsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPwBMMpm8NLiDAHMA_Kyf8SJVLvv89KLJ04X6bjs_bvA&oe=6AEF476D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOdQHeFoZwAQ7kNvwE-8UfF&_nc_oc=AdqWin0T4i1FA_Sbtn3pV65yxQAuKJikMGrVUd0WwyCc8jy-Q66xJ0T4X7ruRhKqyRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHMAvb7zknzMtuSg63BVnsA8zL00HgVBiy3FS52QmhXA&oe=6AEF4582"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrlf5ES5ZCQQ7kNvwEl3CDe&_nc_oc=Adq4purxRRigLshNETTXoM-WZ6i5oritjQDuz5cdXiAv7j58MFu-Ljnu1BSCzjNbkJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXSixNfaydcoab9OPxpO9AjlfpxtSqiWc-ZGpyF2hPeQ&oe=6ADCB82D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNXy_qArrvoQ7kNvwEPi-cb&_nc_oc=AdpCgNJp9GaAi101X-scmA0_6JYkdeBmYKahWhlSXwU5cAnhL_Go376WXD47AO5CIkY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmGM-ymz4k-bR1LjTAzZFshWtFAIzN_XvnT0_56-vs9A&oe=6ADCD26D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJV577qmbN0Q7kNvwETgIdp&_nc_oc=Adpvk96YJluTFe2MA_K__E910dr-Tr_a_6SoZl5_Y_SLpFhzuYQV_SkR9EjfWbq6Wy0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGPGXPOkbcaan3qPU-AZr1riPvZIF7cUE31rktOsTWtg&oe=6ADCD082"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
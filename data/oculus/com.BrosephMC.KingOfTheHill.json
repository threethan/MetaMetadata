5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52U9b6VUM48Q7kNvwGjKIx4&_nc_oc=AdotfdWx7GffPinJb8Wa90EE2FUIEsLu4PlnIm4g_7yEkWE_Aj9pEOVZwCwJaUSyiYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kpzNL6opwosZq0dfgwq6UPsoItdFMlo1yGJEjbBeqZg&oe=6A2EB22D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKy44q81n88Q7kNvwEy8meo&_nc_oc=AdqowHVK8C8GKGgERr_daj5reymkeywTK5OFn8TDzc7--jQiALsYmiXAtMOHQOXaYWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2uqFHVshUiLDNOpNpx_c9P02JK5qesy3pl-P9lmCmug&oe=6A2ECC6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5JEiWnpRXwQ7kNvwHfNBli&_nc_oc=AdqPiuRqg7nCAwEuhuf6kND_AABdLBcnCYipz7LxktXT_pRbUgqPdXQsRd_OlNvd2DE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i_g3cB_AT9Z5berMYbIZTyj3drdNMcUwEiGrXOpCSiw&oe=6A2ECA82"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
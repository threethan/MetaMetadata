5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEI4MMo6aWAQ7kNvwEm9A2g&_nc_oc=AdqBi6sqG-_AELtZxBiZeE6297FRH5grjLwz9I-Eon6BhttYrwwVVcaXd-UUb6QzgxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GbF5arAYyh0VkB8soTMQkbevP1mKse7HmJ5HqMADCNQ&oe=6A1D8EAD"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnxtwe_Ihl0Q7kNvwGWfrS2&_nc_oc=AdonJB5CxclohBntCrcXDbxjrpwTuKGJJX5AvTu7uw5t976FKgGNSFR-7xPq8UZctD8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NBN_ixs8cg5iqbAj6ZtRYxJF4_kEeJBkDEyPWherAsA&oe=6A1DA8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw6PesTfZJkQ7kNvwH_ltkQ&_nc_oc=AdqFKMfiatB5iDBftOC93EcTAXeyutvnIL8jLdz9omL1gyrn-81eLagUwtTQFXJEcdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l4E8aM10Tq_PcRXt8Ku1ZjNMkL_mhREGzmsWFTbr83w&oe=6A1DA702"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
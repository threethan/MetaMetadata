5/499354924_1040841204134069_896003151647027548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxVl5QU7968Q7kNvwEA6G2g&_nc_oc=AdqXR3tZ-h_gYT1tQNaabHebs48tAnmxBdBzj0mpAqBS9NUJJMddyH2TRLek6rxizgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6Iy5CVmAUhtEcv0yOOKkAaHGu8QUiwtdIrRUjbHgJPw&oe=6A73402D"}, {"file_name": "pic_5.png", "id": "662874583231788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818910_662874586565121_1078974927226679305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdP2m2JCRc8Q7kNvwHYtaWC&_nc_oc=AdrA7_9zqkwF-aW8sq4z1LSvkDjNCJVYAtvi4Z1dtNiOA4wHmPlFC8aK6LhwMol_UlE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZmtGx2qL2_Qi41KUoSPZDzOx4JDIWMOOWoFxPNVD1Lw&oe=6A73222D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1363042301475660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332288_1363042304808993_2616460222294160756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfXI36YxkN8Q7kNvwFw3-uT&_nc_oc=Adrw-ux_KPH1gtLmP1IMHp70ME4sEFSiQMgfqY1h8Zs3_AdE5WjIXcR2HBgC205wtV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFqalMCNzE3ZhkrGf-04gUTptfmU17P_1Fo1i8x8j-iQ&oe=6A732042"}, "display_name": "King of the Hill - Mountaintop Battle", "keywords": ["roomscale", "arcade", "ragdoll"], "long_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch, shoot, grab, and toss your enemies off the cliff before they knock you out.\n\nCustomize the difficulty to your fancy and experiment with new game modes. Re-draw the battleground to fit your play space.\n\nPunch green rocks.\nShoot purple rocks.\nGrab gray rocks.\nProtect your head\u2014take too many hits, and it\u2019s game over.\nKnock down flying creatures to heal.\nSurvive as long as you can.\n\nHow long can you hold the hill?", "short_description": "Battle waves of angry rock monsters competing for your mountaintop throne. Punch,
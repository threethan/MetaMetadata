Q7kNvwHr6_MM&_nc_oc=AdqHhLCJ7nvk7O8cBjkSF8ng9N_cTikkwi_V4Yj5eiHp6x15qf8rSw6IY3tszG-hb5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QEdn8AchX20AbG2mtQTi80K0Nh_dch1b2k9Nyv2V71g&oe=69DE5654"}, {"file_name": "Screenshot_06.png", "id": "1030315862293669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1030315865627002_3736866487587406482_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpyTxHbhbZgQ7kNvwFjA8bG&_nc_oc=AdpsYixjuGKRP25uK_qVVOH0FbeorjpzWoFykwB6Ld-HV8WuHjVgq_IncVQ11Y0Han0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TMqblZUrNGa3lkYOM-Mrl0fHJUP48D9K05jhpC0oYaw&oe=69DE25E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Preview.png", "id": "1720291412171744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391926_1720291418838410_7178437947440452577_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2dQcMfer3MQ7kNvwH3s_8H&_nc_oc=AdrZcCIpOiNm8jYYHEzs14haLzVaULpnVsdkNQvx4-fndgMCnjvqk5CFZvTqf_lIbmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rQYWJwJaCHas_GifcgUjDExxcizE2nDZckJ5izUfwDg&oe=69DE2933"}, "display_name": "BEATABLE", "keywords": ["Rhythm", "Music", "Action", "Competitive", "MR"], "long_description": "\"The Next Era of Rhythm Gaming!\" \u2013 Naysy, VR YouTube Star\n\nBEATABLE is the ultimate hand-tracking rhythm action game, designed entirely for mixed reality. Transform any table into a high-energy musical instrument\u2014tap, snap, and clap to the beat using just your hands!\n\nWith precision-tuned controls and real-world haptics, every move feels incredibly natural, responsive, and satisfying.\n\nWhy BEATABLE is unlike anything you've played before:\n\n\ud83c\udfb5 Feel the music\u2014experience real, tactile feedback on your table\n\n\u26a1 Lightning-fast response\u2014zero gesture recognition lag for pinpoint accuracy\n\n\ud83c\udfaf Instant calibration\u2014jump into the action in seconds\n\n\ud83c\udf0a Seamless, intuitive gameplay\u2014every beat feels effortless, so you can flow with the music.\n\nNo controllers. No limits. Just pure rhythm.\n\nTurn your table into the ultimate rhythm battleground. Are you BEATABLE?", "short_description": "\"The Next Era of Rhythm Gaming!\" \u2013 Naysy, VR YouTube Star\n\nBEATABLE is the ultimate hand-tracking rhythm action game, designed entirely for mixed reality. Transform any table into a high-energy musical instrument\u2014tap, snap, and clap to the beat using just your hands! \n\nWith precision-tuned controls and real-world haptics, every move feels incredibly natural, responsive, and satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrgames.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR Games Ltd.", "support_website_url": null, "website_url": "https://www.xrgames.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9192869134134235"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "9398632930198429"}, {"status": "PUBLISHED", "id": "966580025667199"}, {"status": "PENDING", "id": "1682537348966313"}, {"status": "PENDING", "id": "1268359744257145"}, {"status": "PUBLISHED", "id": "26201296532862649"}, {"status": "PUBLISHED", "id": "123612478834342
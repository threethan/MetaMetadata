_ss=7f20f&oh=00_AQM_5QS72p_cGo8nF_KCTr3o8GPLwndH1W572qFzIfKVcw&oe=6AD3A851"}, {"file_name": "2.png", "id": "913209514203229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391986_913209517536562_8373885792268648987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDqXQoNMTHsQ7kNvwG7W090&_nc_oc=AdrTdUQCGKfSj84hlcdka7qu-bS0bv8SMxIEPifXK1ppdNAYGEHCqJ37gXhDPtEtuFI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_-_aZMfDCHDr-2UxUdqudxwCJeb19BBU-EfxAhec2bA&oe=6AD39BE4"}, {"file_name": "3.png", "id": "661920256346685", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391883_661920259680018_2532293023006185515_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NulPVRxmxQQ7kNvwGZH_im&_nc_oc=AdrxKkCQvsMBbTBl2B8wOJdEMoxbibP8GaYy7-j7JkGpAjdyv1NrBJZOehmlEwGLMPY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZFavHlZTBCYd4By_T2EPBoJw9rnjH8WmzvStJmqUf_w&oe=6AD38B8B"}, {"file_name": "4.png", "id": "1350974566092037", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391934_1350974572758703_8574320645961474284_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCo7aRSLy3IQ7kNvwGW2sk2&_nc_oc=Adr_WVQrneQHG8STlceJZsEcTeHTn2vRuqAMQqiUJdnpdhXmwFrF4nU6DscFa9mYVTE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG4oGaKMlBnfFjEyf6ceFL8W4VEZ_6dz5280ilOpQTfw&oe=6AD39635"}, {"file_name": "5.png", "id": "3915082862078540", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392000_3915082865411873_7368711296240016217_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNi-Un6XzBQQ7kNvwE5bskd&_nc_oc=AdoYBPwLL-A0B4xGpgKqY6VyBEUYwHGV72s_LFzi6VuDs7r9AD2iFhHa2qRErafIRPU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjgGmwz1ZHVPOyM89i6GGJrxT-PLNjwgKKxGxyj3Fa1Q&oe=6AD3A76D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bubble-Fit", "keywords": [], "long_description": "Bubble-Fit is a virtual reality experience designed to help older adults perform physical maintenance exercises in a relaxing beach environment. With three maintenance exercises, you can work on neck mobility, stretch your back, and exercise your hands and arms, all from the safety of your seat.\n\nDuring the exercises, you will be guided by interactive bubbles that you can follow with your gaze, touch with your hands, or pop. The navigation is simple and clear, allowing you to focus on your well-being without complications. Accompanied by relaxing ambient sounds like ocean waves and wind, Bubble-Fit offers a peaceful and revitalizing experience, perfect for improving your physical well-being in an accessible and fun way.", "short_description": "Bubble-Fit takes you to a relaxing beach, where you can perform mobility exercises specifically designed for older adults. Improve your physical well-being with stretching and mobility exercises, all while staying comfortable and safe in your seat."}, {"images": {"nodes": []}, "id": "1687759795148594", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bubble-Fit", "keywords": [], "long_description": "Bubble-Fit es una experiencia de realidad virtual dise\u00f1ada para ayudar a las personas mayores a realizar ejercicios de mantenimiento f\u00edsico en un entorno relajante de playa. Con tres ejercicios de mantenimiento, podr\u00e1s trabajar en la movilidad del cuello, estirar la espalda y ejercitar las manos y los brazos, todo desde la seguridad de tu asiento.\n\nDurante los ejercicios, ser\u00e1s guiado por burbujas interactivas que puedes seguir con la mirada, tocar con las manos o hacer explotar. La navegaci\u00f3n es f\u00e1cil y clara, permiti\u00e9ndote centrarte en tu bienestar sin complicaciones. Acompa\u00f1ado de sonidos ambientales relajantes como olas del mar y el viento, Bubble-Fit ofrece una experiencia tranquila y revitalizante, perfecta para mejorar tu bienestar f\u00edsico de una manera accesible y divertida.", "short_description": "Bubble-Fit te lleva a una relajante playa, donde podr\u00e1s realizar ejercicios de movilidad dise\u00f1ados espec\u00edficamente para personas mayores. Mejora tu bienestar f\u00edsico con ejercicios de estiramiento y movilidad, todo mientras permaneces c\u00f3modo y seguro en tu asiento."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arsoft-company.com/en/politica-privacidad", "developer_terms_of_service_url": null, "publisher_name": "ARSOFT", "support_website_url": null, "website_url": "https://www.arsoft-company.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9838963806135837"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "638527992124248"}]}, "baseline_offer": {"id": "638527992124248"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741939500, "status": "PUBLISHED", "id": "638527992124248"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9869922069706677", "version": "0.2.0"}, "id": "626717820226500", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9838963789469172", "is_concept": false, "latest_released_binary": {"__
uscdn.com&_nc_ss=7f20f&oh=00_AQI_ulKzCRpQ1eMG-LKjESxP1UslnSVXVd9K_lWR-Ww2tA&oe=6AA2C3E2"}, {"file_name": "SS3.png", "id": "1248557997409533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_1248558000742866_1653848628927839123_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQtFuC_nTl4Q7kNvwENoFhO&_nc_oc=AdovsPQNQndo-v8G0-FprqXXVgE9hTSoSNvZ4cd_TuXqhvgYWQbTYJ2JvAMr9MlonXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIYHk9ysu7TQYb_E9kfLQULiQ0m_TdyGn5dEzj4UrDLw&oe=6AA2AACC"}, {"file_name": "SS1.png", "id": "2868472803343937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_2868472806677270_1264192218352139219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKbTBWnmhcQQ7kNvwEWL1G6&_nc_oc=AdrCwkMMnNA1fnEV87yUNHSJrzznQJJT0T7MintbFrZv_Ss072BgLnD4jK5PUfXcIeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-NN8i5XAujNYizkuDjh4roNPRHhNBTvQMO1NCeXnxcg&oe=6AA2C4E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "757167047264627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_757167050597960_2031197756836117518_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV61COZHacQQ7kNvwG9JODS&_nc_oc=AdqabsMuJrMxdqlcPYUgBi3V4ieLVGbh3OdyLifmiv47sMgbOgzMMcR-5lxcTmH6tJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9d1huLRAsvNnwY3TKZPUUQr7bmK25UVe1qelOVe3bdw&oe=6AA2A987"}, "display_name": "Open World Racing: Cyberpunk City", "keywords": ["Cyberpunk", "Realistic", "Racing", "OpenWorld", "CyberpunkCity"], "long_description": "Open World Racing: Cyberpunk City is an immersive open-world racing game built specifically for virtual reality on Meta Quest. Step into a futuristic cyberpunk metropolis where glowing neon lights, towering skyscrapers, and reflective rain-covered streets surround you in full VR presence.\n\nExperience high-speed driving from a true first-person cockpit perspective and feel the scale of the city around you. With gameplay optimized for comfort and immersion in VR, players can cruise freely through the city or push their limits with fast-paced street racing and drifting mechanics.\n\nThe world is fully explorable, featuring wide highways, dense urban districts, and hidden routes waiting to be discovered. Realistic lighting, dynamic reflections, and cyberpunk-inspired visuals create a deep sense of atmosphere and presence inside the headset.\n\nDrive through the city at your own pace, enjoy the neon skyline, or master drifting through tight corners and long streets designed for high-speed exploration.\n\nCurrent Features\n\n\u2022 Open-world cyberpunk city designed for VR\n\u2022 Full in-car cockpit driving controls for immersive gameplay\n\u2022 High-speed racing and drifting mechanics\n\u2022 Realistic lighting, neon reflections, and atmospheric environments\n\u2022 Comfortable VR gameplay optimized for Meta Quest", "short_description": "Open World Racing: Cyberpunk City is a next-generation VR racing experience built for Meta Quest. Drive through a futuristic neon metropolis, drift across rain-soaked streets, and freely explore a massive cyberpunk city in full virtual reality.\n\nThe game now features in-car cockpit driving, allowing players to control the vehicle directly from inside the car for a more immersive VR experience. Future updates will introduce online multiplayer racing, bringing competitive street racing to the city"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}],
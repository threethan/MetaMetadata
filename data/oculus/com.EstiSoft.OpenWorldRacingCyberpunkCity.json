ontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1tzSdLjfE9m_GgybzLl6fBOte6zHt8BwIbKh3tpyEBw&oe=6A85867A"}, {"file_name": "upscalemedia-transformed (2).png", "id": "1073080221623234", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818885_1073080224956567_4264850156571717511_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YwwLNZI9e4Q7kNvwGIk3Mn&_nc_oc=AdolKZF_Uq0c68-eqdzAjc7PPp0aRc4i2yhVNgYcXmk2zoi3N0TJA8WJzt4QdFZCGis&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG43uBjQO7cYan43IrFTseTctDuYXDCkNOJHMG4XMbywA&oe=6A85AA8E"}, {"file_name": "upscalemedia-transformed (4).png", "id": "1941097593146577", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825546_1941097596479910_5288215036529106932_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bell_QxWhuQQ7kNvwFhstot&_nc_oc=AdpIkOZeyn6zfb4hUrWOTinNek8Rq-goYQRh6Iof7JRiHm2AgenGmZeIxlVfHT_7FSI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-2xQwewG62J1aNdQ4M-qRAFFUz_B9q4rmIP5dk50KXw&oe=6A858263"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (4).png", "id": "1394871265426706", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823949_1394871268760039_7486469910743974516_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XcdnKd1WoAQ7kNvwF9gTs_&_nc_oc=Adp8cZFzhiDBMPQULC75RQfGm8K91YcXJZFHmzigveSkndsQDYiMNZbOMp4rzjhrrrw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEper4c1SrpwkW0pTZdxWmqL6pIgteFaGS3VBVjNif3Ag&oe=6A859505"}, "display_name": "Open World Racing: Cyberpunk City", "keywords": ["Cyberpunk", "Realistic", "Racing", "OpenWorld", "CyberpunkCity"], "long_description": "Open World Racing: Cyberpunk City is an immersive open-world racing game designed specifically for virtual reality on Meta Quest. Step inside a futuristic cyberpunk metropolis where neon lights, towering skyscrapers, and reflective wet streets surround you in full VR presence.\n\nExperience high-speed driving from a true first-person perspective, feel the scale of the city around you, and enjoy smooth, comfortable gameplay optimized for VR. Cruise freely through the open world or push your limits with fast-paced street racing and drifting mechanics. Realistic lighting, dynamic reflections, and cyberpunk-inspired visuals create a powerful sense of depth and immersion.\n\nThe city is fully explorable, allowing you to discover long highways, urban districts, and hidden routes while enjoying the freedom that only VR can offer. Every road, corner, and skyline is designed to enhance spatial awareness and realism inside the headset.\n\n Upcoming Feature:\nIn the next version of the game, in-car cockpit controls will be added, allowing players to interact and control the vehicle directly from inside the car for an even more realistic VR driving experience.\n\nWhether you want to relax and cruise through the city lights or race through the streets at full speed, Open World Racing: Cyberpunk City delivers a stylish, immersive, and evolving VR racing experience made for Meta Quest.", "short_description": "Open World Racing: Cyberpunk City is a next-generation VR racing experience built for Meta Quest. Step into a futuristic neon city, feel the speed, drift through rain-soaked streets, and explore a massive open world in full virtual reality. Designed for immersion and comfort.\nIn a future update, in-car cockpit controls will be added, allowing players to control the vehicle directly from inside the car."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}
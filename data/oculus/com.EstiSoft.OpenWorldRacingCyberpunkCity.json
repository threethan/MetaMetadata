uscdn.com&_nc_ss=7f20f&oh=00_Af5G294bXYcZDqF1q2J0lzDF8XcE1arYPXARI6sGOxoHRw&oe=6A106D62"}, {"file_name": "SS3.png", "id": "1248557997409533", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491819982_1248558000742866_1653848628927839123_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9MhfxaXiJgQ7kNvwHJdr6x&_nc_oc=AdojK0jmkQRURVJ-qcixjbjVEQrEvL8wBWN3xu8GOeXbDF-A9Vk7j5RUT2V4lSHe0Ms&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NsCdiXWbcJeA-BtTTvRS4ZFAv4UKXm-meXi2CDIeLiA&oe=6A10544C"}, {"file_name": "SS1.png", "id": "2868472803343937", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820428_2868472806677270_1264192218352139219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYWnApupU-4Q7kNvwGjN6a0&_nc_oc=Adpu2CgYR-Z2X6bnWienxrWg3nTWREInwTk4kDQMjuRnbj17JcU7h5icV44taz-OEyg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KQXbwhGJSynn5aerGPThbvNXZJAaX2LcAGD9zvcvWsg&oe=6A106E68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "757167047264627", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491818890_757167050597960_2031197756836117518_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60n5O8Ra6YwQ7kNvwFtGqa7&_nc_oc=AdoYPBNMoVUjbVg3SQaq4nsJpcDbVs_VtmwXg7zA5kiJ5uVgVv21ewcJ6pTSBAyflZM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T3Efyx0bWAyZ3n8zHkoPY_NqtrgjXqINfYhCcoDz3DQ&oe=6A105307"}, "display_name": "Open World Racing: Cyberpunk City", "keywords": ["Cyberpunk", "Realistic", "Racing", "OpenWorld", "CyberpunkCity"], "long_description": "Open World Racing: Cyberpunk City is an immersive open-world racing game built specifically for virtual reality on Meta Quest. Step into a futuristic cyberpunk metropolis where glowing neon lights, towering skyscrapers, and reflective rain-covered streets surround you in full VR presence.\n\nExperience high-speed driving from a true first-person cockpit perspective and feel the scale of the city around you. With gameplay optimized for comfort and immersion in VR, players can cruise freely through the city or push their limits with fast-paced street racing and drifting mechanics.\n\nThe world is fully explorable, featuring wide highways, dense urban districts, and hidden routes waiting to be discovered. Realistic lighting, dynamic reflections, and cyberpunk-inspired visuals create a deep sense of atmosphere and presence inside the headset.\n\nDrive through the city at your own pace, enjoy the neon skyline, or master drifting through tight corners and long streets designed for high-speed exploration.\n\nCurrent Features\n\n\u2022 Open-world cyberpunk city designed for VR\n\u2022 Full in-car cockpit driving controls for immersive gameplay\n\u2022 High-speed racing and drifting mechanics\n\u2022 Realistic lighting, neon reflections, and atmospheric environments\n\u2022 Comfortable VR gameplay optimized for Meta Quest", "short_description": "Open World Racing: Cyberpunk City is a next-generation VR racing experience built for Meta Quest. Drive through a futuristic neon metropolis, drift across rain-soaked streets, and freely explore a massive cyberpunk city in full virtual reality.\n\nThe game now features in-car cockpit driving, allowing players to control the vehicle directly from inside the car for a more immersive VR experience. Future updates will introduce online multiplayer racing, bringing competitive street racing to the city"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}],
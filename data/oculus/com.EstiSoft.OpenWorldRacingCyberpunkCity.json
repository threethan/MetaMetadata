c_oc=AdoSsd53rCdMpIz23Y13I-m2fLQ5HghxCe6HlUPJPWKEk_-79JXCv4lMKx8mwXxsOVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRoUgQq4sbNms_0i3W_fok8iJnU8uG5M_kZUOXiIg2Iaw&oe=6B0DABC1"}, {"file_name": "upscalemedia-transformed (1).png", "id": "998094316716276", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_998094320049609_7494058480868351129_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kot1GC22gIMQ7kNvwGssIMZ&_nc_oc=AdoEuZVo-i9XWXRaAwRJ_XkVxfb63FhUmIFtS3MGmHEdD4ze6ALFmhJFmpTaCXxTSkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNBYIvHTAdpwy0T14AK7ypswF5QTfHlcL3SfHaL9YlNA&oe=6B0DC17A"}, {"file_name": "upscalemedia-transformed (2).png", "id": "1073080221623234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_1073080224956567_4264850156571717511_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94zY9GelBNEQ7kNvwHA85b6&_nc_oc=AdrPXR2z94R99w6tsDiQ2RH42oqkSySTM-R7r6UX0DOj0FwVkjRCCPZAf9yT410lPcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVpx8dE8nukW8KzOK7tcunWTbbcskDb5x_njrOp6GG7Q&oe=6B0DAD4E"}, {"file_name": "upscalemedia-transformed (4).png", "id": "1941097593146577", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1941097596479910_5288215036529106932_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7P6xoEPOL4Q7kNvwGw2MLE&_nc_oc=Adqs1gJgcIwEbxp1xizywULQm1qwUUWRZRlSIHBjaQCTWIfG1vdklwRk5TdJnZ6Yzcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_c0TTDH6cxkC16RDhqVOiqmvwMKx6VyIPVxIxdD-sSw&oe=6B0DBD63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (4).png", "id": "1394871265426706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823949_1394871268760039_7486469910743974516_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOTDDJNU4gAQ7kNvwGwjVmh&_nc_oc=AdpDuer4toHkANTdVyw1qMewox-p4bekPAAwxlAtGJzQVpOfvRCU5oPkpkCmsW9vKPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIZnzpI4yhRu-WSn-YiT4IWRAvJgLU_2y6LkN_fal5mw&oe=6B0DD005"}, "display_name": "Open World Racing: Cyberpunk City", "keywords": ["Cyberpunk", "Realistic", "Racing", "OpenWorld", "CyberpunkCity"], "long_description": "Open World Racing: Cyberpunk City is an immersive open-world racing game designed specifically for virtual reality on Meta Quest. Step inside a futuristic cyberpunk metropolis where neon lights, towering skyscrapers, and reflective wet streets surround you in full VR presence.\n\nExperience high-speed driving from a true first-person perspective, feel the scale of the city around you, and enjoy smooth, comfortable gameplay optimized for VR. Cruise freely through the open world or push your limits with fast-paced street racing and drifting mechanics. Realistic lighting, dynamic reflections, and cyberpunk-inspired visuals create a powerful sense of depth and immersion.\n\nThe city is fully explorable, allowing you to discover long highways, urban districts, and hidden routes while enjoying the freedom that only VR can offer. Every road, corner, and skyline is designed to enhance spatial awareness and realism inside the headset.\n\n Upcoming Feature:\nIn the next version of the game, in-car cockpit controls will be added, allowing players to interact and control the vehicle directly from inside the car for an even more realistic VR driving experience.\n\nWhether you want to relax and cruise through the city lights or race through the streets at full speed, Open World Racing: Cyberpunk City delivers a stylish, immersive, and evolving VR racing experience made for Meta Quest.", "short_description": "Open World Racing: Cyberpunk City is a next-generation VR racing experience built for Meta Quest. Step into a futuristic neon city, feel the speed, drift through rain-soaked streets, and explore a massive open world in full virtual reality. Designed for immersion and comfort.\nIn a future update, in-car cockpit controls will be added, allowing players to control the vehicle directly from inside the car."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25896621503311914"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1945526106604299"}, {"status": "PUBLISHED", "id": "1023859440231280"}, {"status": "PUBLISHED", "id": "1320605263324269"}, {"status": "PUBLISHED", "id": "2738185676532415"}, {"status": "PUBLISHED", "id": "2135733526960686"}]}, "baseline_offer": {"id": "2135733526960686"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1796155200, "status": "PUBLISHED", "id": "1945526106604299"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26350554137918646", "version": "8"}, "id": "1069593248645964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBi
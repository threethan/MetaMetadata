2).png", "id": "1073080221623234", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818885_1073080224956567_4264850156571717511_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy2Lq4TxS_AQ7kNvwGr0W35&_nc_oc=AdqO2pfSn6alYDZVvyh-q3_IsHY5DcWv3w1shzAogDoFb5bH7H1ujJUJD1VOQpMKvyc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHap1GY-JD4wbRfNEgHvWQeAiBQpfUvd2ueXcJlhiVmw&oe=69C52F8E"}, {"file_name": "upscalemedia-transformed (4).png", "id": "1941097593146577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825546_1941097596479910_5288215036529106932_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b5vivcdfqQQ7kNvwH4XBnW&_nc_oc=AdqArsipsgCNgvHBPVYgHB1LygRsDFAUBddbnwjVvDP-iKF-KQ30JMWY7D-71rCQw7U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdyZjCjGx4P1Wiie0f2ejszWQ102w29E-6zfpar5FCag&oe=69C53FA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (4).png", "id": "1394871265426706", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823949_1394871268760039_7486469910743974516_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVanP6WVGJsQ7kNvwHjl--N&_nc_oc=AdqZdlFCc8c-OTGbnEX75TxawCaXU_OthU13w5V8JZYd7ZpkGxGx1bfCU-PyjI17x_g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZho-aKkI_Osl0sdEpMv6ouTlxBMAhxXHLGZ-uvyFicQ&oe=69C51A05"}, "display_name": "Open World Racing: Cyberpunk City", "keywords": ["Cyberpunk", "Realistic", "Racing", "OpenWorld", "CyberpunkCity"], "long_description": "Open World Racing: Cyberpunk City is an immersive open-world racing game designed specifically for virtual reality on Meta Quest. Step inside a futuristic cyberpunk metropolis where neon lights, towering skyscrapers, and reflective wet streets surround you in full VR presence.\n\nExperience high-speed driving from a true first-person perspective, feel the scale of the city around you, and enjoy smooth, comfortable gameplay optimized for VR. Cruise freely through the open world or push your limits with fast-paced street racing and drifting mechanics. Realistic lighting, dynamic reflections, and cyberpunk-inspired visuals create a powerful sense of depth and immersion.\n\nThe city is fully explorable, allowing you to discover long highways, urban districts, and hidden routes while enjoying the freedom that only VR can offer. Every road, corner, and skyline is designed to enhance spatial awareness and realism inside the headset.\n\n Upcoming Feature:\nIn the next version of the game, in-car cockpit controls will be added, allowing players to interact and control the vehicle directly from inside the car for an even more realistic VR driving experience.\n\nWhether you want to relax and cruise through the city lights or race through the streets at full speed, Open World Racing: Cyberpunk City delivers a stylish, immersive, and evolving VR racing experience made for Meta Quest.", "short_description": "Open World Racing: Cyberpunk City is a next-generation VR racing experience built for Meta Quest. Step into a futuristic neon city, feel the speed, drift through rain-soaked streets, and explore a massive open world in full virtual reality. Designed for immersion and comfort.\nIn a future update, in-car cockpit controls will be added, allowing players to control the vehicle directly from inside the car."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
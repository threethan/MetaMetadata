_name": "migrated_image.png", "id": "207540320470902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_1897102280618743_9056227934217437184_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX1gwn2TAP0Q7kNvwG3mZ2E&_nc_oc=AdnY9JD21mltpyR2cbDUw98SjX2V8xlSFGVS3sjS7pzWuKkgxU92RfF0LlN1FrUN8jY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuosHh4BnLkUk9OEAWw8PoM6Q2VwR8YH_KKwdSTluAi2g&oe=69A98CCF"}, {"file_name": "migrated_image.png", "id": "2582566635298365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162711_303388423500748_3981020811753422848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn7i2COSkBgQ7kNvwGrdLmG&_nc_oc=AdkG6Elt2lA-PUxIb8T-1HdaWUwvCQtN7qXyPpE4xz7OfPhv-x4Mo2FIrGhTVJ-eQrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afus5hWSlZ8RTC6tnYDAjBNMp60pR0Xgf0FZ8SJQ-CCo9g&oe=69A98560"}, {"file_name": "migrated_image.png", "id": "245336186504089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_1751067885196237_4192934072936300544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfTa2vIl9HAQ7kNvwFvonD8&_nc_oc=AdlklISrMfskC5q1YTxs2jLQFN0PqvbCH4r9wGS09Tsw5FBACupFGyASxz3OUI19yUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfujCxX91DhQ6QnRsm1zywBZQoGMIurg371x8ziHMgBa7A&oe=69A99178"}, {"file_name": "migrated_image.png", "id": "2583005401808767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_752442554951652_5817019880825683968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxChRvzdKioQ7kNvwGkGSZa&_nc_oc=AdmHx0iiEqIMX6832YDFz6oFTFHmXLiY4nC7uvPiV-87F7BjYvrarM62PR-RfEwfgdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuQ1fNYP9dExepkGUeVlGepVk09Pd2kWN1ia6tTShK7pA&oe=69A98AFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Shared Space", "keywords": ["immigrant", "immigration", "trump", "muslim", "maine"], "long_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities, inviting viewers to ask questions related to the physical and social spaces we inhabit and what we lose as communities and individuals when we are out of contact with one another.\n\nIn this piece, we follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected.", "short_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities. We follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected."}]}, "developer_name": "The Yarn Corporation", "developer_privacy_policy_url": "http://yarncorporation.com/#!/privacy", "developer_terms_of_service_url": "http://yarncorporation.com/#!/terms", "publisher_name": "The Yarn Corporation", "support_website_url": null, "website_url": "https://www.sharedspacevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "519781529360516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://s
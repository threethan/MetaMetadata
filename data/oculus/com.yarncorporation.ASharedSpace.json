": "207540320470902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_1897102280618743_9056227934217437184_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmQv_UrO1RwQ7kNvwGgOqH0&_nc_oc=AdqH3AR3bAsIzV7yLx99MqzATbsSaGutFQsctBSDvKNvJ8Or4gtFxT1N8Fbg37EDR-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wphTdksUVZLmaH_L7lcCXWylj3UDYKVBwk85qvzlvcA&oe=69F20F4F"}, {"file_name": "migrated_image.png", "id": "2582566635298365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162711_303388423500748_3981020811753422848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3BWXbOrzE0Q7kNvwG5vAdI&_nc_oc=AdrzC_7rs6ZnqDQmEgEqp4ax3-xVQJw6uiNeqiLWqqLa2vorVuL4iqREo2OucXgpn5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1o7lOQ5CMxl2dWWa5c44IKIpztvRxpjxSS9QSuzPVEQw&oe=69F207E0"}, {"file_name": "migrated_image.png", "id": "245336186504089", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_1751067885196237_4192934072936300544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yvblsjyW3YQ7kNvwEcLxkE&_nc_oc=AdpYxIg3NP_21qf8m2qg1VpsD2swAKRVephCioS_VAdy-dWhIdmDrmuCrYss0ZQUA8g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0LTvVeJUxH_Toqex8e1inMnV42er7QPanZqiZuXiidAw&oe=69F213F8"}, {"file_name": "migrated_image.png", "id": "2583005401808767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_752442554951652_5817019880825683968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGvT4OrQIaoQ7kNvwGkyYhN&_nc_oc=AdqOMcNs8-_yNo_N_6oDfu5gtz0I-PJKVcIRllPzPd3SU04WUMGgAdBnsIAeEUsJpbc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WK1vPPW7wSB1XEI6UGNPMh_PIhCkpleV_gsLGxo1vBg&oe=69F20D7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Shared Space", "keywords": ["immigrant", "immigration", "trump", "muslim", "maine"], "long_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities, inviting viewers to ask questions related to the physical and social spaces we inhabit and what we lose as communities and individuals when we are out of contact with one another.\n\nIn this piece, we follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected.", "short_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities. We follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected."}]}, "developer_name": "The Yarn Corporation", "developer_privacy_policy_url": "http://yarncorporation.com/#!/privacy", "developer_terms_of_service_url": "http://yarncorporation.com/#!/terms", "publisher_name": "The Yarn Corporation", "support_website_url": null, "website_url": "https://www.sharedspacevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "519781529360516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/
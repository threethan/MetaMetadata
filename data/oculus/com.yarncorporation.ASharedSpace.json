_name": "migrated_image.png", "id": "207540320470902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_1897102280618743_9056227934217437184_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkvZou7bvfkQ7kNvwHfzFyv&_nc_oc=Adlot2KIvZ1LrlixItIN0dyVJMNpmqkZ9YO63PwfLa8oi8KvPw28NLIgfTc_AA87iyU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5WLHjhp_uIiatSaXKyCGQKolgF_jFt8dDH5fu1mzI3w&oe=69BAB04F"}, {"file_name": "migrated_image.png", "id": "2582566635298365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162711_303388423500748_3981020811753422848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvumCtsPRFkQ7kNvwGD42ow&_nc_oc=Admzw3UW06g_d1_CGxpO-kQ3oJ9fNDXIwEJ3hqQ_Or_HYNK7jItuhZPnBtT20qyXxJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3K3eQcNxP9lvrGAGAhPw4DZS8XgmS21yE1XdH5__k1A&oe=69BAA8E0"}, {"file_name": "migrated_image.png", "id": "245336186504089", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_1751067885196237_4192934072936300544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4ERWfKonv8Q7kNvwFDTuxX&_nc_oc=Adn_kcIdo-hG50IRJ-VaO4NCEefNRn3VPDPPSmPj50WrToX896Eefj0TXLI0r3HAxEY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1q4upqwkgfE5n9NRIl-02o1djWX5bf-0X1V3lTn-thg&oe=69BAB4F8"}, {"file_name": "migrated_image.png", "id": "2583005401808767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_752442554951652_5817019880825683968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtYwwy-4-isQ7kNvwGAqAC5&_nc_oc=AdlgHGQp3-T423r37gV0NZgzm8dI_aErl89j4nMcBsiZioZyiyw2Dez0mFv0bHQ1N3k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYZjm0YBnUc4xe0woMyMq7OZdreWRX9KraYhQq_nvxLw&oe=69BAAE7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Shared Space", "keywords": ["immigrant", "immigration", "trump", "muslim", "maine"], "long_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities, inviting viewers to ask questions related to the physical and social spaces we inhabit and what we lose as communities and individuals when we are out of contact with one another.\n\nIn this piece, we follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected.", "short_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities. We follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected."}]}, "developer_name": "The Yarn Corporation", "developer_privacy_policy_url": "http://yarncorporation.com/#!/privacy", "developer_terms_of_service_url": "http://yarncorporation.com/#!/terms", "publisher_name": "The Yarn Corporation", "support_website_url": null, "website_url": "https://www.sharedspacevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "519781529360516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://s
_name": "migrated_image.png", "id": "207540320470902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_1897102280618743_9056227934217437184_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkvZou7bvfkQ7kNvwENqk0G&_nc_oc=AdlQxipZqd8nwgmcBbRA145MeqJVulX4VXQGKOdSV8VCBSYrpKsZ97MWqALotFlAFds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv2VQkZM0T8JfLAvNSmmVbu6ju461sbE8W5ZoBaNTRKg&oe=69B80D4F"}, {"file_name": "migrated_image.png", "id": "2582566635298365", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162711_303388423500748_3981020811753422848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4hsYfXpx2YQ7kNvwHZGoP0&_nc_oc=Adk0kG2iHoaqXQhYLsIDW1Az50OHMtshTjq0Iw-STuLxBEBJ-rxvvt61Xy33oiJ7S-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afycq5bOIE49jeZ-eFFgi_k4c3kLXcr_V4pUpW2t8XGScA&oe=69B805E0"}, {"file_name": "migrated_image.png", "id": "245336186504089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_1751067885196237_4192934072936300544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loxUvO01AzEQ7kNvwEImPTa&_nc_oc=AdmPs5AgyFRSVW7jftXYT3CflFLwBYVDgEZrB1HoZdrW4phTx_07KrUowwFqPNIh7GA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbMPr6TYrc51cdVLKutP_RAsI1cMI0Jw5scSX1SCEW7Q&oe=69B811F8"}, {"file_name": "migrated_image.png", "id": "2583005401808767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_752442554951652_5817019880825683968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_JadUlBPBgQ7kNvwHYCQoW&_nc_oc=AdnKHOI6-z6gez3Mo1euA1CWQ9-DiMUdbrQ31byir3ctri4hBQSEvo6zy8Z38bn1xpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI1fvSLr0qqKsNrl8JxP_Zxslls-m_n1qGAFyXLxTiLQ&oe=69B80B7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Shared Space", "keywords": ["immigrant", "immigration", "trump", "muslim", "maine"], "long_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities, inviting viewers to ask questions related to the physical and social spaces we inhabit and what we lose as communities and individuals when we are out of contact with one another.\n\nIn this piece, we follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected.", "short_description": "A Shared Space is a collection of immersive 360\u00b0 films set in Maine communities. We follow Hilowle and Shuab who grew up in Dadaab, Kenya\u2013 the largest refugee camp in the world. Today, both have started families and call Lewiston, Maine home. Raising children in the country\u2019s least diverse state in the wake of Trump\u2019s Muslim Ban and rising nationalist sentiments has created challenges neither expected."}]}, "developer_name": "The Yarn Corporation", "developer_privacy_policy_url": "http://yarncorporation.com/#!/privacy", "developer_terms_of_service_url": "http://yarncorporation.com/#!/terms", "publisher_name": "The Yarn Corporation", "support_website_url": null, "website_url": "https://www.sharedspacevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "519781529360516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://s
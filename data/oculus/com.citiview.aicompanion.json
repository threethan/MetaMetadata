_742799008199442205_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjiMqCXH8f4Q7kNvwEk7i9E&_nc_oc=Adq4fmA7OIg5AgMFj_mVna-ny_wMY52r4fyttLzTZDlhKyONpMjEcBiqLlUiFJTx_zE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc7lsozUBly4QFMv8CXtcCGmy-rkH8n5VoUg_ZORNa3Q&oe=6AFDC491"}, {"file_name": "screenshot_3.png", "id": "1473626867959519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1473626871292852_7472082483000761252_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kKoP64r5-QQ7kNvwELsk6c&_nc_oc=Ado74B4JiMB0gazKEWcJf4QgGoeDUZTLl7q3gwy9IrLvfkk3eu2wgy9LuFZwEM8ZuKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXrbyBa03TTyeTc7SRsI18c0PS3UEfH55eYOsN_7qZtQ&oe=6AFDAF49"}, {"file_name": "screenshot_4.png", "id": "2459044111293024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_2459044114626357_94931678435762353_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTZ0wjXRstUQ7kNvwEjqJD6&_nc_oc=AdomKyqJbuG7JjKRHIH35CSMcPaBXMSvVIHTIMgo-UGEen2Myp8EL5gmf1YX1VswF_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRruQWflTDOmrX6g2sDQq5CfOA2LjatelR2BDlt5xAbcA&oe=6AFDD81C"}, {"file_name": "screenshot_5.png", "id": "2249613375828867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_2249613379162200_5779246898061726038_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=betss8rNH1UQ7kNvwEiIARJ&_nc_oc=Adrnq3YZYfdWFUqnE55gWbaO5YJ1HqTGs1aDEkfMUqkSAxoClbk-CGVdC3ucZXpykPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8gLTtCglInKr86WgdpqQ3saCPIM18g1QADlygjGm3Vg&oe=6AFDB1E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28895314036818756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_28895314056818754_2147642710239001603_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61wltzvhWAYQ7kNvwENE74K&_nc_oc=AdrCan5Nmj_5zVsRPRqu75sOnRk94vz9qvuaUD8IGeVfFOg7kl3LQ182pGjxPEueBc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_xWVInIHXWSPj8C-HGqb3N6CNfQHq9LQNqZluLotOJA&oe=6AFDE09B"}, "display_name": "AI Companion", "keywords": ["companion", "ai", "conversation", "relaxing", "chat"], "long_description": "Someone to come home to - your own personal AI companion, 300 metres above the city.\n\nCHOOSE YOUR COMPANION\nMeet sixteen people - eight women and eight men - each with their own look, personality and voice. Point at someone and pull the trigger to choose. Change companion any time from the menu.\n\nJUST TALK\nHold A and talk out loud, then let go - they answer in their own voice, with real lip sync and expressions. Ask about their day, tell them about yours, ask for a joke. They remember your name and what you talked about last time.\n\nTHEY LIVE THERE WITH YOU\nYour companion walks around the penthouse with you, sits beside you on the couch, dances when you ask, makes you a coffee, shows you the bedroom and looks out at the view. Wave and they wave back. Press B and they come over.\n\nA PENTHOUSE WORTH COMING HOME TO\nA floor-to-ceiling wall of glass over a glittering skyline, a balcony 300 m up, a TV lounge, a full kitchen, a dining table by the glass and a master bedroom with its own view. Sky traffic and airships drift past.\n\nCHANGE THE SKY\nSunset, dawn, daylight, emerald and neon night - just ask (\"make it night\") or use the menu.\n\nNO MONTHLY AI CHARGES - FREE AI FOREVER\nThe AI runs entirely on your headset. No subscription, no account, no internet needed - your conversations never leave the room.", "short_description": "Your own personal AI companion in a stunning penthouse 300 m above the city. Choose from 16 people, hold A and talk out loud - they listen, answer in their own voice, walk with you, sit with you, dance and remember your name. The AI runs entirely on your Quest: no monthly AI charges, free AI forever."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/aicompanion/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/aicompanion/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310936692112303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/793139181_2256533678464210_692002479650155053_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjO_l_HrvOIQ7kNvwHVc1fQ&_nc_oc=Adru8UaucsFidph1dKO1lpE4MJvme36QrJM5pPsR0HTZNJQPCe8-KFYQLikhvYo9rm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNXQ2Om54uU-901VCxFiIvRFeafZr6mUCvzwVW8Jnnig&oe=6AFDCB53"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AI Companion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1793366820, "lastRevision": {"nodes": [{"id": "1310936702112302", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13109366787
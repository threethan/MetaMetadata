_742799008199442205_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjiMqCXH8f4Q7kNvwExkkuP&_nc_oc=Adq076QO9s3CUpya-EWq0EUkSFRcJ9p0ru8V7ULvLZN0vbnZzhYW0o9ufHe5WZ4JYaw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3zPePWn1zWKiL3HUVjchWX1uZOEZnaEYPope9uGH3rQ&oe=6AFC7311"}, {"file_name": "screenshot_3.png", "id": "1473626867959519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1473626871292852_7472082483000761252_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBIGNfuD5-wQ7kNvwE4C9Tr&_nc_oc=Adqqc_Mr3o5bGXpx2-E36lyc8Qkj1TUmLmUYkjH_2bPf21S5eR4mgSzXcBIti39iO5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTuHiLf1JI99tsDQuPtCkyi8Tg7MBcpdrWciOupnACTA&oe=6AFC9609"}, {"file_name": "screenshot_4.png", "id": "2459044111293024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_2459044114626357_94931678435762353_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcPUznGUl3cQ7kNvwE9uYsy&_nc_oc=AdrjwVWkk1z7gnAoAlW8aVuRxYoQEarmPdZIW5I6kmdEx1NgvNmXBlCnbYfKGx2AvYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6VH7Wkm2LaP4SYpFbd8PNVe5b23erUoKPh51DHvzjhA&oe=6AFC869C"}, {"file_name": "screenshot_5.png", "id": "2249613375828867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_2249613379162200_5779246898061726038_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtqBIoa5F8YQ7kNvwGBnszj&_nc_oc=Adr0HKR5aivx1NUGbCEGwDsiCAO3UZ6BzcCc2_IKMMa2e8VMTAPaPPPPPBrR2iC-u34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEzaiMOq5P75Eb-K-E4lG01M6FtkAtP2Np_md8TmldEQ&oe=6AFC6069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28895314036818756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_28895314056818754_2147642710239001603_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61wltzvhWAYQ7kNvwFHpTPq&_nc_oc=AdqqTUXsu44ooJWrEU2YIo431jE9xNwZm5_AkrhY63ESkUcE8z32Z4QcD3sZUeyeC4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTx4y8eHxR8HxNpi70d0iOfhZ1sOYqw2jTEbE8h1Eg_A&oe=6AFC8F1B"}, "display_name": "AI Companion", "keywords": ["companion", "ai", "conversation", "relaxing", "chat"], "long_description": "Someone to come home to - your own personal AI companion, 300 metres above the city.\n\nCHOOSE YOUR COMPANION\nMeet sixteen people - eight women and eight men - each with their own look, personality and voice. Point at someone and pull the trigger to choose. Change companion any time from the menu.\n\nJUST TALK\nHold A and talk out loud, then let go - they answer in their own voice, with real lip sync and expressions. Ask about their day, tell them about yours, ask for a joke. They remember your name and what you talked about last time.\n\nTHEY LIVE THERE WITH YOU\nYour companion walks around the penthouse with you, sits beside you on the couch, dances when you ask, makes you a coffee, shows you the bedroom and looks out at the view. Wave and they wave back. Press B and they come over.\n\nA PENTHOUSE WORTH COMING HOME TO\nA floor-to-ceiling wall of glass over a glittering skyline, a balcony 300 m up, a TV lounge, a full kitchen, a dining table by the glass and a master bedroom with its own view. Sky traffic and airships drift past.\n\nCHANGE THE SKY\nSunset, dawn, daylight, emerald and neon night - just ask (\"make it night\") or use the menu.\n\nNO MONTHLY AI CHARGES - FREE AI FOREVER\nThe AI runs entirely on your headset. No subscription, no account, no internet needed - your conversations never leave the room.", "short_description": "Your own personal AI companion in a stunning penthouse 300 m above the city. Choose from 16 people, hold A and talk out loud - they listen, answer in their own voice, walk with you, sit with you, dance and remember your name. The AI runs entirely on your Quest: no monthly AI charges, free AI forever."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/aicompanion/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/aicompanion/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310936692112303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/793139181_2256533678464210_692002479650155053_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5u7nAwNS54Q7kNvwHUgxKG&_nc_oc=AdoDcGkV2snzwZw3lkjX2pxPGxa8BO5Xn-A89rRRYO8SihDRrbY8uH14V3bsP5uAsqs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC_9uk5VHX_cpk-d0H7ZMPp5udpmw5poRqOo-jUkEWtA&oe=6AFC79D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AI Companion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1793366820, "lastRevision": {"nodes": [{"id": "1310936702112302", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13109366787
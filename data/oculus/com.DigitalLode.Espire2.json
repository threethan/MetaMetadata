com&oh=00_AfsSOyNrh8LCQD2EYx6z2-R_GJpQ0ROIlyXgvMBocm5boQ&oe=69A048B0"}, {"file_name": "Espire2_Meta_Screenshot6_2560x1440.png", "id": "671318730789823", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_671318734123156_3442114715172056886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezWE08tmZXIQ7kNvwFTwf1a&_nc_oc=AdllReF8gUw72-dFEeFp_5mfsA3HDhqo2U8Llw5kvucXhtFJpfGYqITZsdfj-oXJ150&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXgKtrSETmHNtxiog18g7_frMXMoab9QCISxFTzkDqjQ&oe=69A050B7"}, {"file_name": "Espire2_Meta_Screenshot3_2560x1440.png", "id": "1451691341948051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_1451691345281384_5566265960535576074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrI1SHyG6xgQ7kNvwGrfVRP&_nc_oc=AdmbxqBfhkyB0Qas4kc-O5jK38Ph6oPSFq7PXLWue_Gw9loZRISBHoQFK4cl0pXXC8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1loqkp92nXehq_C_xH-8w-J50Ra_ePYaRFciy3n7t0g&oe=69A04100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Espire2_Meta_TrailerCoverImage_2560x1440.png", "id": "5050552518324859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001726_5050552524991525_2055276904076754336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP2mJmE8RYAQ7kNvwHl1eeg&_nc_oc=AdnghFj7nZZtkj9RS8DKO8Tqs3IB18k1chcF1YdtEgJnZM9LJ9MVBsEtQgixyd8AGJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsP8Dtf1xNExIHEsdA_IaZyEsb5oMK4WXhM5O-Q87TiHA&oe=69A04944"}, "display_name": "Espire 2", "keywords": ["Sneaking", "FPS", "Stealth", "Multiplayer", "Campaign"], "long_description": "Experience unparalleled stealth action in two unique story campaigns with Espire 2: a full-fledged VR FPS on Meta Quest!\n\nAfter intel from an anonymous whistleblower reveals the terrorist group OPHIS\u2019 plot for global domination, Espire Operative Poe once again finds themself at the center of the Espire program,. With the entire world hanging in the balance, it\u2019s up to Poe and their Espire frames  to dismantle OPHIS from the inside. \n\nKey Features:\n\u2022 Become a lone wolf and take on OPHIS or team up with a friend for a co-op adventure in two unique campaigns\n\u2022 Control multiple Espire frames each with their own special abilities, attributes, and strategic benefits for you to discover\n\u2022 Handle encounters with a variety of unique gadgets or neutralize targets with a wide array of realistic weapons\n\u2022 Distract, hold up and interrogate the enemy with the option to use your headset\u2019s built-in mics \n\u2022 Choose your comfort level with the return of the innovative \u201cControl Theatre\u201d comfort system", "short_description": "Experience unparalleled stealth action in both single player and cooperative campaigns with Espire 2: a full-fledged VR FPS on Meta Quest!\n\nAfter Espire Operative Poe wakes from a 7 year coma, they once again find themselves at the center of the Espire program. Intel from an anonymous whistleblower reveals that the terrorist group, OPHIS, have a new plot for global domination. With the entire world hanging in the balance, it\u2019s up to Poe and their Espire frames to dismantle OPHIS from the inside."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thelode.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tripwire Presents", "support_website_url": null, "website_url": "http://Espire2.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "NARRATIVE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "ko", "es", "de"], "supported_input_de
com&oh=00_Afv5ecSOThwZATJda9jUwWDmzpv4Pxf2xizGxXR3lmxbgA&oe=699EF730"}, {"file_name": "Espire2_Meta_Screenshot6_2560x1440.png", "id": "671318730789823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_671318734123156_3442114715172056886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezWE08tmZXIQ7kNvwESxSZ4&_nc_oc=Adn2k4bdkKAS8uXJU-1EFgSF1Ybsnm_8ecDNaXlfjb_p4jf9Q3kC6lkN81p6N5J2d-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft_xUtdt9gpoAawya8Nz9vBFYGcva3HC2faZbcbk-WvPA&oe=699EFF37"}, {"file_name": "Espire2_Meta_Screenshot3_2560x1440.png", "id": "1451691341948051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_1451691345281384_5566265960535576074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrI1SHyG6xgQ7kNvwEmUCgt&_nc_oc=Adnd-aR9M43ierGwUQRU7qqL5G5l1OabKStbVGplUlcCodjRyfFBJlJ4QHo6p5B_zJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftmE70M76bvhJRKDfPpyePwmnv23O5ppU0qJHZa58rOpg&oe=699EEF80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Espire2_Meta_TrailerCoverImage_2560x1440.png", "id": "5050552518324859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_5050552524991525_2055276904076754336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP2mJmE8RYAQ7kNvwH57yPY&_nc_oc=AdmtTdJVPh6D1XZyGM4_AGeAxMW_qywsdzIuB68n_SNMGiex-K-mttoxNrCR7TENWuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftJ9Nxzlr5daoyDcufXG4y1V3OnO-qX6H09teW_j7eatA&oe=699EF7C4"}, "display_name": "Espire 2", "keywords": ["Sneaking", "FPS", "Stealth", "Multiplayer", "Campaign"], "long_description": "Experience unparalleled stealth action in two unique story campaigns with Espire 2: a full-fledged VR FPS on Meta Quest!\n\nAfter intel from an anonymous whistleblower reveals the terrorist group OPHIS\u2019 plot for global domination, Espire Operative Poe once again finds themself at the center of the Espire program,. With the entire world hanging in the balance, it\u2019s up to Poe and their Espire frames  to dismantle OPHIS from the inside. \n\nKey Features:\n\u2022 Become a lone wolf and take on OPHIS or team up with a friend for a co-op adventure in two unique campaigns\n\u2022 Control multiple Espire frames each with their own special abilities, attributes, and strategic benefits for you to discover\n\u2022 Handle encounters with a variety of unique gadgets or neutralize targets with a wide array of realistic weapons\n\u2022 Distract, hold up and interrogate the enemy with the option to use your headset\u2019s built-in mics \n\u2022 Choose your comfort level with the return of the innovative \u201cControl Theatre\u201d comfort system", "short_description": "Experience unparalleled stealth action in both single player and cooperative campaigns with Espire 2: a full-fledged VR FPS on Meta Quest!\n\nAfter Espire Operative Poe wakes from a 7 year coma, they once again find themselves at the center of the Espire program. Intel from an anonymous whistleblower reveals that the terrorist group, OPHIS, have a new plot for global domination. With the entire world hanging in the balance, it\u2019s up to Poe and their Espire frames to dismantle OPHIS from the inside."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thelode.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tripwire Presents", "support_website_url": null, "website_url": "http://Espire2.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "NARRATIVE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "ko", "es", "de"], "supported_input_de
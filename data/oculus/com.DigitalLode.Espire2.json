com&oh=00_AfvVR751c0HoiVT3qhUOY3S0QBoMRS6kkgpiPMzIwMSL-Q&oe=699C5430"}, {"file_name": "Espire2_Meta_Screenshot6_2560x1440.png", "id": "671318730789823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003281_671318734123156_3442114715172056886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLLrpJi6ShMQ7kNvwEUsk_9&_nc_oc=AdnF6Ga0hGs4GVm8toI7uOPV0JVWUjQuOER_3lMOzhggf72OWFbgfcrn3eoC-MlA4nM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsxXdeoIgahpqKtydBjLMmEj-QH3XriBk_PlmA5OErTfg&oe=699C5C37"}, {"file_name": "Espire2_Meta_Screenshot3_2560x1440.png", "id": "1451691341948051", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_1451691345281384_5566265960535576074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KttU9aXs7RsQ7kNvwG80mOM&_nc_oc=Adk0z5Tifr_le3ialKdtiNuSSW8A_RH0-f4xd9qpWu-_BQRDHWt1RtgdZzcVTP9LcaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftY0TYCAK178S08l3ZMTvFWEPd6o0UX59ebe9r1NBe0qw&oe=699C4C80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Espire2_Meta_TrailerCoverImage_2560x1440.png", "id": "5050552518324859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001726_5050552524991525_2055276904076754336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTwi31BpcsgQ7kNvwGkP6p9&_nc_oc=AdlgjgaPAaVla_2mj8g1a0IYlAsUt0Sp_6JGUTQLLaZjHGnfNsUclhhR5U18ezgqxYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvrAhj6cIcvZVmueInCPNXXPZm6UhfoqU1a61BcTtpNvg&oe=699C54C4"}, "display_name": "Espire 2", "keywords": ["Sneaking", "FPS", "Stealth", "Multiplayer", "Campaign"], "long_description": "Experience unparalleled stealth action in two unique story campaigns with Espire 2: a full-fledged VR FPS on Meta Quest!\n\nAfter intel from an anonymous whistleblower reveals the terrorist group OPHIS\u2019 plot for global domination, Espire Operative Poe once again finds themself at the center of the Espire program,. With the entire world hanging in the balance, it\u2019s up to Poe and their Espire frames  to dismantle OPHIS from the inside. \n\nKey Features:\n\u2022 Become a lone wolf and take on OPHIS or team up with a friend for a co-op adventure in two unique campaigns\n\u2022 Control multiple Espire frames each with their own special abilities, attributes, and strategic benefits for you to discover\n\u2022 Handle encounters with a variety of unique gadgets or neutralize targets with a wide array of realistic weapons\n\u2022 Distract, hold up and interrogate the enemy with the option to use your headset\u2019s built-in mics \n\u2022 Choose your comfort level with the return of the innovative \u201cControl Theatre\u201d comfort system", "short_description": "Experience unparalleled stealth action in both single player and cooperative campaigns with Espire 2: a full-fledged VR FPS on Meta Quest!\n\nAfter Espire Operative Poe wakes from a 7 year coma, they once again find themselves at the center of the Espire program. Intel from an anonymous whistleblower reveals that the terrorist group, OPHIS, have a new plot for global domination. With the entire world hanging in the balance, it\u2019s up to Poe and their Espire frames to dismantle OPHIS from the inside."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thelode.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tripwire Presents", "support_website_url": null, "website_url": "http://Espire2.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "NARRATIVE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "ko", "es", "de"], "supported_input_de
308p2zlWzy1rvYlmCMBjGYGhs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCa9yptx_iBpxjIX3JG5x1Qf8s7QZP-wiXhNOb-14dfg&oe=6B08413F"}, {"file_name": "vlcsnap-2022-07-10-10h43m08s424.png", "id": "3122750581276639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974576_3122750584609972_1891619389783166365_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJpbFGw_yCAQ7kNvwGEns2x&_nc_oc=Ado-Mc7xuz71jih0o4ZenNOilM6FOH-zqFcmreJq5_0L4bBcjlKLPSUg_gQ3-dP26iY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8znMINEP-p_lLGOIgbE6PVoHIG-5aFVBxHsu7sgg6hw&oe=6B086EDD"}, {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "964043891044645", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974716_964043894377978_1771482862319125599_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS8vUGTFnJAQ7kNvwHLnO7I&_nc_oc=AdppAqPwAb-BcMrmpqzRZBbABm0qm3Gc2Ub4JIDFkYCCRGShJPgucz4nWIN_Bv7snl0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwSewK1Na7rqSwjg_WGTIGUu1oXHDC8LFRT8IKKYaM2g&oe=6B084104"}, {"file_name": "vlcsnap-2022-07-10-10h43m15s407.png", "id": "360818522904027", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_360818526237360_1953202593247852704_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMWIGaksiIkQ7kNvwEcHAfX&_nc_oc=Adqjxq91tj9qcMWfW30n5UgaSDoDlOKuM1oTX3fA10LjKuaDjLMDCb8G30uGLvUEc2w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSurxGjtjMIb1SYLBdEPKMWI6A3svY8zclI05jbW70pcg&oe=6B086EF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "1040755996641977", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974672_1040755999975310_4762885264913517635_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kHchuifU-kQ7kNvwGvPnXS&_nc_oc=AdrMwhzmZTk7TT_g6UoArA9Ez8ci0i6gwtQkkLNBEoFKRDatl2G3OCTxJ4mrMpoWWUk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5GzKTgk_52dXAcsV5NlcqW0PHcmzFPzGhRqXmvSQHxw&oe=6B08617F"}, "display_name": "Non Fingo VR", "keywords": [], "long_description": "Non Fingo is a VR space combat simulator under early and active development.  It is about as realistic as I can make it.\n\nThere's n-body gravity acting on all the ships and projectiles. G is a few orders of magnitude larger than real life, which means everything is moving at a rate which is actually observable and not insanely boring.\n\nThe travel is seamless, using a floating origin (sort of) to avoid levels and loading screens.\n\nProjectile/armor collisions take into account relative speed, mass, impact angle, materials, etc. to determine whether it should ricochet, stop, or penetrate. Shot placement against ship modules determines which ship functions are degraded.\n\nPlayer movement in 0g is physics based. You can rotate in any axis, push off surfaces, grab and climb, or attach yourself to a floor or wall and walk with 360 locomotion. Also you can have personal thrusters or whatever.", "short_description": "VR spaceship crew simulator with realistic physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inchoate-elk.com/nonfingoprivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Inchoate Elk", "support_website_url": null, "website_url": "https://inchoate-elk.com/nonfingo.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
3MXidMHVTnP17z9C91enx2w-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxBCYRn1oMJ6Z5AYUumN4n3U_JlTPOLVa5gb3h68tV5A&oe=6B03337F"}, {"file_name": "vlcsnap-2022-07-10-10h43m08s424.png", "id": "3122750581276639", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974576_3122750584609972_1891619389783166365_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arnKMw7I3CUQ7kNvwELuZKf&_nc_oc=Ado_gSuMe2Em-ydzA1VQ85fiFPytWfsAvYOIwHvPoXf0cQAe33eIpIQZXrO5NTkvNjE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9LAppvCoXOB2hpDU1jBxi25OjeLs3cNmHblS2oqbNgA&oe=6B0328DD"}, {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "964043891044645", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974716_964043894377978_1771482862319125599_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq4f3S9CEkIQ7kNvwFEM3Fz&_nc_oc=AdrL33LvHrrnMwEFD62W7e2PAtusVtH-rWoMTgBimuo2l_cvoD_s0LiGbKTdsYitwRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDdvNZx3sYK4GPDdR2LvE2hjC6PFIp0FAjtc3Ye7V9kw&oe=6B033344"}, {"file_name": "vlcsnap-2022-07-10-10h43m15s407.png", "id": "360818522904027", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_360818526237360_1953202593247852704_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN9hm-DemN4Q7kNvwF_t_wW&_nc_oc=AdrcafO4gaWTVMkNN22tQuM3AlBHb74mmNd16mQ5nKuJOMqeEiSTcj_pYvYEtbKElas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ3gaku6u_022HF2JDXC2adplhuPjG-R7mbiZQOM6rcA&oe=6B0328F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "1040755996641977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_1040755999975310_4762885264913517635_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF-x8frFFx0Q7kNvwFsjtfN&_nc_oc=AdqfHei2oAv2SIXGh-6bwZ6GGv2UBCV_uhSm3w9Yg0ZTYHXJT182hfohdTso9HjzRu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKE61Twx-TkahhWAKIWgQgEHDSTJLA3QQAwWEW7F9YKA&oe=6B031B7F"}, "display_name": "Non Fingo VR", "keywords": [], "long_description": "Non Fingo is a VR space combat simulator under early and active development.  It is about as realistic as I can make it.\n\nThere's n-body gravity acting on all the ships and projectiles. G is a few orders of magnitude larger than real life, which means everything is moving at a rate which is actually observable and not insanely boring.\n\nThe travel is seamless, using a floating origin (sort of) to avoid levels and loading screens.\n\nProjectile/armor collisions take into account relative speed, mass, impact angle, materials, etc. to determine whether it should ricochet, stop, or penetrate. Shot placement against ship modules determines which ship functions are degraded.\n\nPlayer movement in 0g is physics based. You can rotate in any axis, push off surfaces, grab and climb, or attach yourself to a floor or wall and walk with 360 locomotion. Also you can have personal thrusters or whatever.", "short_description": "VR spaceship crew simulator with realistic physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inchoate-elk.com/nonfingoprivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Inchoate Elk", "support_website_url": null, "website_url": "https://inchoate-elk.com/nonfingo.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
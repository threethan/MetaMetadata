scdn.com/v/t64.5771-25/38974716_964043894377978_1771482862319125599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KNEtGskv8QQ7kNvwGJxwGl&_nc_oc=AdpU6pWXgONt9PS4RA_6YV6hBWknoIfXLlKl8X-vhbu1q0E_Hc9a3kEJ1GK8vRckVVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONHA7ioC0YAn_HULAuH37judUcYW578G2ukt7OpAqDIA&oe=6ACCED84"}, {"file_name": "vlcsnap-2022-07-10-10h43m15s407.png", "id": "360818522904027", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_360818526237360_1953202593247852704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5uuLyf6QgsQ7kNvwHMWOMi&_nc_oc=Adov-A3EH9dnx_apeBScbqWTQdl7ZAFal2RpMeYB08RSnAMCZHS7dIxkcxa_Wo9k_T4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMUqn3YiRtl2ePsKLS289hNy_7AWl8BSrVUBzPnkjpMQ&oe=6ACCE332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "1040755996641977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_1040755999975310_4762885264913517635_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiLLBdofNo8Q7kNvwGq2BQA&_nc_oc=AdqEp5b-U-RS9llflioQBtBZD-nszNRoTR7Kr3vFlnSXWa-NPW5PSoLvQPgdKYk6imQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4bwFcsppnsg7Q9ZQ6YNgSf_SiCpdOcBGbkLteLqFWTA&oe=6ACD0DFF"}, "display_name": "Non Fingo VR", "keywords": [], "long_description": "Non Fingo is a VR space combat simulator under early and active development.  It is about as realistic as I can make it.\n\nThere's n-body gravity acting on all the ships and projectiles. G is a few orders of magnitude larger than real life, which means everything is moving at a rate which is actually observable and not insanely boring.\n\nThe travel is seamless, using a floating origin (sort of) to avoid levels and loading screens.\n\nProjectile/armor collisions take into account relative speed, mass, impact angle, materials, etc. to determine whether it should ricochet, stop, or penetrate. Shot placement against ship modules determines which ship functions are degraded.\n\nPlayer movement in 0g is physics based. You can rotate in any axis, push off surfaces, grab and climb, or attach yourself to a floor or wall and walk with 360 locomotion. Also you can have personal thrusters or whatever.", "short_description": "VR spaceship crew simulator with realistic physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inchoate-elk.com/nonfingoprivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Inchoate Elk", "support_website_url": null, "website_url": "https://inchoate-elk.com/nonfingo.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "592224475440662"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8889863967694957", "version": "1.0"}, "id": "410550167617596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5820175951330456", "is_concept": false, "latest_released_binary": {"__typename":
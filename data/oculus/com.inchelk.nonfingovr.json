ArIzTrCTGHX40WukLb9t09TkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1DXJN52JdfPdJA8jdRqlUqZePDQ1JGN8-uHxD4hngfA&oe=6B0C6DFF"}, {"file_name": "vlcsnap-2022-07-10-10h43m08s424.png", "id": "3122750581276639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974576_3122750584609972_1891619389783166365_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4ZbyTIsLKAQ7kNvwGUsNXy&_nc_oc=AdpDMsoV2SMgGM47d3M7j5_FmtTfq_KIx73u4lZMNv2maC7z3-Wa_GZrni2ewGoKtJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTw6HS_rs09s1cy1omizvglKxir2YKQQwS7ykHRZQr0Zg&oe=6B0C635D"}, {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "964043891044645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974716_964043894377978_1771482862319125599_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_Yy9IORv4QQ7kNvwGCPXMw&_nc_oc=Adoyky6TX46ylzdQ_RdI3mPvsL4zSsBj51Atfi3dM76C9lU_pn70TjkF1Dz6yP6-DWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSI2_qUeK-Q9h5o9sObupvhlXnu8TLRMqCiNHU8hp2J0A&oe=6B0C6DC4"}, {"file_name": "vlcsnap-2022-07-10-10h43m15s407.png", "id": "360818522904027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_360818526237360_1953202593247852704_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z590m5jG6L4Q7kNvwEGNHqc&_nc_oc=AdqFvc2fgSFWGFZsjDagZbSpk_qrnVV8nOTBwpgqEc-oszNiHQlzQQuQifnZ6QpTxqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-O5f2m8Hy5hQeM6-JlQcfIL0PYXEmRowSEAPk6aGiag&oe=6B0C6372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "1040755996641977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_1040755999975310_4762885264913517635_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMj3XF6Vf88Q7kNvwG6jFbK&_nc_oc=AdriKLYOV1S1XhV84j-xv96WwG-eUxFAygnfRZqL_xf-HoqE4E80Fn6cShgYT_3wuvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgv-zxqfsjUSRZXMIu0xE5BHXkNARPgNxUZB_xK1_sSA&oe=6B0C55FF"}, "display_name": "Non Fingo VR", "keywords": [], "long_description": "Non Fingo is a VR space combat simulator under early and active development.  It is about as realistic as I can make it.\n\nThere's n-body gravity acting on all the ships and projectiles. G is a few orders of magnitude larger than real life, which means everything is moving at a rate which is actually observable and not insanely boring.\n\nThe travel is seamless, using a floating origin (sort of) to avoid levels and loading screens.\n\nProjectile/armor collisions take into account relative speed, mass, impact angle, materials, etc. to determine whether it should ricochet, stop, or penetrate. Shot placement against ship modules determines which ship functions are degraded.\n\nPlayer movement in 0g is physics based. You can rotate in any axis, push off surfaces, grab and climb, or attach yourself to a floor or wall and walk with 360 locomotion. Also you can have personal thrusters or whatever.", "short_description": "VR spaceship crew simulator with realistic physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inchoate-elk.com/nonfingoprivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Inchoate Elk", "support_website_url": null, "website_url": "https://inchoate-elk.com/nonfingo.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
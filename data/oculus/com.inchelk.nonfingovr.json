gJ7DjV88B3FthYZmEUHbOlMpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlr7mvFhdlugIvOyKavJEa_CjiFwh87keLF5NHzyjRyQ&oe=6B05D67F"}, {"file_name": "vlcsnap-2022-07-10-10h43m08s424.png", "id": "3122750581276639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974576_3122750584609972_1891619389783166365_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJpbFGw_yCAQ7kNvwH-Fy0j&_nc_oc=Adr79AfEmQCR6rtyNX9kvHEEZxiNUdYCbxSD5s5TN99P9GQRKIReLUPs-l3NNHA4_P0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfQz2LE2jMJ2JlD6Phy3WNEpAm4E3eHl_Bt5_HTx_u_w&oe=6B05CBDD"}, {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "964043891044645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974716_964043894377978_1771482862319125599_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq4f3S9CEkIQ7kNvwGu0Nzq&_nc_oc=AdpwldRq6WnwecPtKYxCap3Tm_d8NW1DpBUngZLPayJ8nEabFl5d8QGPAR5-GCx3rvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKufAH_v5NZPeOmWZoJ9vW_5LeMBrKwDKA3oOoVzO-VQ&oe=6B05D644"}, {"file_name": "vlcsnap-2022-07-10-10h43m15s407.png", "id": "360818522904027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_360818526237360_1953202593247852704_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN9hm-DemN4Q7kNvwHo1IyB&_nc_oc=AdpLf2NJpOp6Q5QSeQvTHCQNT2rNzfJYW52qMQYo_qE0HTthrDsYb-jtON2hRyQ35t8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShcrLdNaMCY5-3s-j5aJ3LPteC8Y8jaBoD8KSjXXgzjg&oe=6B05CBF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "1040755996641977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_1040755999975310_4762885264913517635_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kHchuifU-kQ7kNvwE6j9TU&_nc_oc=Adp3UXyrpQrLtzzK5o2bdkqDgLiPOtPumrxdCYe-cMVaSLlslYC31aaMWojc9RzlrMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQZ2Moyo2YjGW8po4R5BHIaLPWJAUkudVuf-VAHR2r6w&oe=6B05BE7F"}, "display_name": "Non Fingo VR", "keywords": [], "long_description": "Non Fingo is a VR space combat simulator under early and active development.  It is about as realistic as I can make it.\n\nThere's n-body gravity acting on all the ships and projectiles. G is a few orders of magnitude larger than real life, which means everything is moving at a rate which is actually observable and not insanely boring.\n\nThe travel is seamless, using a floating origin (sort of) to avoid levels and loading screens.\n\nProjectile/armor collisions take into account relative speed, mass, impact angle, materials, etc. to determine whether it should ricochet, stop, or penetrate. Shot placement against ship modules determines which ship functions are degraded.\n\nPlayer movement in 0g is physics based. You can rotate in any axis, push off surfaces, grab and climb, or attach yourself to a floor or wall and walk with 360 locomotion. Also you can have personal thrusters or whatever.", "short_description": "VR spaceship crew simulator with realistic physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inchoate-elk.com/nonfingoprivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Inchoate Elk", "support_website_url": null, "website_url": "https://inchoate-elk.com/nonfingo.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
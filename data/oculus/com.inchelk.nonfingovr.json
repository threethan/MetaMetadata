-LIogJDKxBCg5bTu0XYCgHxyY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUr91MhowTabfgutByc2hT4mqGgpaA6iKTR7BdUjumhg&oe=6AFB4A7F"}, {"file_name": "vlcsnap-2022-07-10-10h43m08s424.png", "id": "3122750581276639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974576_3122750584609972_1891619389783166365_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH26sCxQtC0Q7kNvwENy4dF&_nc_oc=AdpQzq8Z0n-ERJpOze7kNuB_utf3p9o0OtB1OS0pTmmG3Rm7u-Nh1czREtoaX3DK_JI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWsRAJvae7Fj6ZEqMmH_YCVl4PVfyXezoKkCQbduPFDA&oe=6AFB3FDD"}, {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "964043891044645", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974716_964043894377978_1771482862319125599_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6OGIOYr1BQQ7kNvwESxUwt&_nc_oc=Adq0Qv03b_cEVRnjh8UJsXaUL6S020T7r0bUy6cxdmLH9zTtV9COXjipsJ3o1pRQBSU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSZgFF9QoVHTIIMotoWWKu1Fxrmtxxu2aWyid9M3ETvQ&oe=6AFB4A44"}, {"file_name": "vlcsnap-2022-07-10-10h43m15s407.png", "id": "360818522904027", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974711_360818526237360_1953202593247852704_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVvmXt4VxYcQ7kNvwEGMh-f&_nc_oc=AdrOdNMehxO0hPlFMYcxUd_jwBjvJu7iMHAly6gioP4mtNU7z8IdUiOYsBWxoX6qqVk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgnsnou-s1GmI87I8P1S3MERflKCTfVM5ysLJw2g3MWQ&oe=6AFB3FF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-07-10-10h43m29s527.png", "id": "1040755996641977", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974672_1040755999975310_4762885264913517635_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuCj5mHocOkQ7kNvwFt3V7-&_nc_oc=Adqbbjvsp8Edlg-tFoi-Xy4jUAAaxjmgF9DMwod7DqnR4kmEvwJZk9Rubtpl6_4HB5Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRELJUeAsMReaS25K8WoRkZmQm8Jl8DMaxJWeRKfb2_pg&oe=6AFB327F"}, "display_name": "Non Fingo VR", "keywords": [], "long_description": "Non Fingo is a VR space combat simulator under early and active development.  It is about as realistic as I can make it.\n\nThere's n-body gravity acting on all the ships and projectiles. G is a few orders of magnitude larger than real life, which means everything is moving at a rate which is actually observable and not insanely boring.\n\nThe travel is seamless, using a floating origin (sort of) to avoid levels and loading screens.\n\nProjectile/armor collisions take into account relative speed, mass, impact angle, materials, etc. to determine whether it should ricochet, stop, or penetrate. Shot placement against ship modules determines which ship functions are degraded.\n\nPlayer movement in 0g is physics based. You can rotate in any axis, push off surfaces, grab and climb, or attach yourself to a floor or wall and walk with 360 locomotion. Also you can have personal thrusters or whatever.", "short_description": "VR spaceship crew simulator with realistic physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inchoate-elk.com/nonfingoprivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Inchoate Elk", "support_website_url": null, "website_url": "https://inchoate-elk.com/nonfingo.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
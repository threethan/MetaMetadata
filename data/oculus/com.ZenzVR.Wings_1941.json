ots": [{"file_name": "Level8.png", "id": "1188908844980629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031330_1188908848313962_8765417084185969790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JE2ix9Hss0Q7kNvwEdEDyN&_nc_oc=Adp3ZXY7LWfr0Fg8lA49vX4KAEW18VTGMbUQ8E4BLZYBfhHGxqBmxUqGFfLZ6ymWa9I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYsSz29-aseCLwDfEMmlomsCPapIlpIaJnQKRz1velMQ&oe=6AC5282C"}, {"file_name": "Level6.png", "id": "1180394342760998", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974824_1180394349427664_4274700922446404293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNHB9sLErL4Q7kNvwGueJVi&_nc_oc=AdrDybwnqZFyZs62ghGIc_ojUwtJHenl6QakZqVbDCwOR_5qFa4-hJm3ZhEQL2k9Itk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOv6jW8gCJmwtJNLA1vnxXjYYBxpoxvEjwF_O8fu6Gpg&oe=6AC4FE35"}, {"file_name": "Hangar.png", "id": "736078127429054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031532_736078130762387_4087786333617780074_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX3k59ScsAcQ7kNvwH6mf6r&_nc_oc=AdoHoBMkKIaHU4jlpBCtScv5v3tG9arcZYjjTBDoh4VzqUhWVNtFgokEu3WYz3X5gjE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCNYf7OyXUczT4h66IysTXRD7OT3qdktd_1jjyi3Jggw&oe=6AC508AA"}, {"file_name": "Level7screenshot.png", "id": "3487740514786451", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982619_3487740518119784_982484226486325661_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QvWMvsC4ZIQ7kNvwEW-4lD&_nc_oc=AdqVGFvjPfOElFRzzyRkntUd5PI9ryCjTmfUbBZUsnCP_sdPj3Rges1Z5NERE7_TP5M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIh6wT1QVmJ0ukaHfLrpS2enHJauTquLma6PtKbGNj3Q&oe=6AC524C5"}, {"file_name": "Instructor.png", "id": "1091616001389700", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982714_1091616004723033_4771933676956629913_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ML3ZPJGpdMQ7kNvwFB2ZXO&_nc_oc=AdqTN3gmkrGARs6C8xWbn2JRnxyLOGHyp2UPlA5NxTG7nMbN6sTEKS9x_kNIWfQqlR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQH-5pOi8MVN1IJ-DDDap74gJbNhVP0ZRnniFfRBtwew&oe=6AC4F461"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wings 1941", "keywords": [], "long_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, the great Zeppelin, the fearsome Tiger Tank and many more!\nGeneral Brandon will guide you through each mission. Do you have what it takes to beat the 10 epic campaigns like Battle of Midway, D-Day, Stalingrad, El Alamein and more!\n\n* Unlock up to 10 iconic planes such as B17 Bomber, Hurricane, Typhoon and the cruising Mustang!\n* Pickup coins, chests, bombs, rockets and powerups along the way to upgrade your plane with\n* Control your aircraft with your hand being able to do barrel rolls and quick evasive manoeuvres relying on your wits and reflexes.  \n* Play with a friend and be the best of the best on the world leader boards!\n", "short_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, Zeppelins, Tiger Tanks and more!\nPlay with a friend and be the best of the best on the world leader boards!"}]}, "developer_name": "Ztar Games AB", "developer_privacy_policy_url": "https://www.ztargames.com/privacy", "developer_terms_of_service_url": "https://www.ztargames.com/termsofservice", "publisher_name": "Ztar Games AB", "support_website_url": null, "website_url": "https://www.ztargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_
ots": [{"file_name": "Level8.png", "id": "1188908844980629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031330_1188908848313962_8765417084185969790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JE2ix9Hss0Q7kNvwFuvpTt&_nc_oc=AdqeGYaeaktjMMMl2R8mwlPAhHDUNs_RpUZaiXr7dDhOOmroweG8W66gl8tf3W4TB1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQdrJS2mGVJMKqtUuRYAWbOzjlbGUVBjXYwucijkivbw&oe=6AC6416C"}, {"file_name": "Level6.png", "id": "1180394342760998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974824_1180394349427664_4274700922446404293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNHB9sLErL4Q7kNvwGxUqNP&_nc_oc=Ado6IhX8ihPTDy-SyWzuq29CTaw4OOy_waQaVABMk1OMn2zKVUvTw3Sjvv1fTdf81Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZlsPxUSS8-78FqBuTFjljCSFOA66Fvz6VXbdVV6zKkQ&oe=6AC64FB5"}, {"file_name": "Hangar.png", "id": "736078127429054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_736078130762387_4087786333617780074_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzPXMsznlc8Q7kNvwHY50XV&_nc_oc=Adq-EFH3m5ONB7r_nQHM5lIXAv6t--_8KKRvPuQEINHuVZtS6XhYN8O4R4VAML6mbUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnk7xYPxiC59G2srpCY480VczZjYAJ9pDVXaF6qkuD0w&oe=6AC65A2A"}, {"file_name": "Level7screenshot.png", "id": "3487740514786451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982619_3487740518119784_982484226486325661_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHn6txnD_n8Q7kNvwESiK97&_nc_oc=Adry1T3ZrDh5rItic3a0Mha8bHuo6Bd15UXCsaMsyv7FX8wGkRb45gQ4FrjZLd0iCvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqNCKv5rEF-pEISuPowBoS37WRSA0K6Euu2wFakx66jw&oe=6AC67645"}, {"file_name": "Instructor.png", "id": "1091616001389700", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982714_1091616004723033_4771933676956629913_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ML3ZPJGpdMQ7kNvwGBXnnw&_nc_oc=AdoTvD0ymSZFz5iC7XYb1rj6SGUOlUKlTJ6NTGl71m1QYLah8sT1ggmAaFKwuypNtDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3z250vYzNlZpR4fM5ouyvlpzSj-3aPVrMXeQZ_N45tw&oe=6AC645E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wings 1941", "keywords": [], "long_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, the great Zeppelin, the fearsome Tiger Tank and many more!\nGeneral Brandon will guide you through each mission. Do you have what it takes to beat the 10 epic campaigns like Battle of Midway, D-Day, Stalingrad, El Alamein and more!\n\n* Unlock up to 10 iconic planes such as B17 Bomber, Hurricane, Typhoon and the cruising Mustang!\n* Pickup coins, chests, bombs, rockets and powerups along the way to upgrade your plane with\n* Control your aircraft with your hand being able to do barrel rolls and quick evasive manoeuvres relying on your wits and reflexes.  \n* Play with a friend and be the best of the best on the world leader boards!\n", "short_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, Zeppelins, Tiger Tanks and more!\nPlay with a friend and be the best of the best on the world leader boards!"}]}, "developer_name": "Ztar Games AB", "developer_privacy_policy_url": "https://www.ztargames.com/privacy", "developer_terms_of_service_url": "https://www.ztargames.com/termsofservice", "publisher_name": "Ztar Games AB", "support_website_url": null, "website_url": "https://www.ztargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_
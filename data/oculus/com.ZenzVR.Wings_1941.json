ots": [{"file_name": "Level8.png", "id": "1188908844980629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031330_1188908848313962_8765417084185969790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl7qr6JwkU0Q7kNvwF-PR3e&_nc_oc=AdqLrGeiayh-eVQrBn7QxtLWMJQ5sS9WD-hYSAzxOT3Hy5R4tqPxgTKjl2svUrhGNxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4QWNSLLedOJJmD6llx0XwhonBy_EnoOhVwssUop8-TQ&oe=6AF49E2C"}, {"file_name": "Level6.png", "id": "1180394342760998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974824_1180394349427664_4274700922446404293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Qp-jXfMxJsQ7kNvwHr5qyw&_nc_oc=Adp99SVPJQ9FiHvyQhkii7JW63e1XpmVwAs9QE7NdycNgJQeQcozDqUt1K6Vyu3pF8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_4QzVGLxSIa0KRC4lW0EdE2uvNIFoWPVa2k7pz708Jg&oe=6AF47435"}, {"file_name": "Hangar.png", "id": "736078127429054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_736078130762387_4087786333617780074_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhQNT0iUAnkQ7kNvwGMH-Qt&_nc_oc=AdqbYs2Wr-BWJ4L6E91mhsGBV1jRZMiXZsb-jYsV0TZVSUvb3U05QM1m93w8II_8PVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXNbOBxXGZ-caEHL5v1U7cngCa_DuluGuUNPOP80IY-A&oe=6AF47EAA"}, {"file_name": "Level7screenshot.png", "id": "3487740514786451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982619_3487740518119784_982484226486325661_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De-WfjLpsGYQ7kNvwEiXX70&_nc_oc=AdqaK-qq3d9Onzu9PGK9KyfW8Iagx2_qR3vzfHkv8E2ViBzOXdXUCuieSYzW9TPF_J8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS06WXb_SUkz4lNRkbcn6snSZjbSBCBeZdhOGV-hEtd9A&oe=6AF49AC5"}, {"file_name": "Instructor.png", "id": "1091616001389700", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982714_1091616004723033_4771933676956629913_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdf7OmIbstgQ7kNvwGzf90L&_nc_oc=Adra0EgO36FiZC2G6vPnG5COUfyht2FXe6gkqMAeqp8i_iIZ7YjSWRElfsl717sUxPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPmXy73fjy-BC-vubhDFwna4ZzrojGXTMXUkk9_r3Rgw&oe=6AF4A2A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wings 1941", "keywords": [], "long_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, the great Zeppelin, the fearsome Tiger Tank and many more!\nGeneral Brandon will guide you through each mission. Do you have what it takes to beat the 10 epic campaigns like Battle of Midway, D-Day, Stalingrad, El Alamein and more!\n\n* Unlock up to 10 iconic planes such as B17 Bomber, Hurricane, Typhoon and the cruising Mustang!\n* Pickup coins, chests, bombs, rockets and powerups along the way to upgrade your plane with\n* Control your aircraft with your hand being able to do barrel rolls and quick evasive manoeuvres relying on your wits and reflexes.  \n* Play with a friend and be the best of the best on the world leader boards!\n", "short_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, Zeppelins, Tiger Tanks and more!\nPlay with a friend and be the best of the best on the world leader boards!"}]}, "developer_name": "Ztar Games AB", "developer_privacy_policy_url": "https://www.ztargames.com/privacy", "developer_terms_of_service_url": "https://www.ztargames.com/termsofservice", "publisher_name": "Ztar Games AB", "support_website_url": null, "website_url": "https://www.ztargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_
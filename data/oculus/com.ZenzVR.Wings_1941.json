1njXGJPRBUH2iGJSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6HdSkE15eDankf0YCEf7IW-W80jx5Sxk-j0boR_0npQ&oe=69B16AE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "664027801328571", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974526_664027804661904_3262388285200213290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avRGwvnvMFkQ7kNvwG_2CLW&_nc_oc=AdnO3mDuqkVW7huagPK9CAxpkh1EnBmg8EXFAuNtSNrDaSImu13VTFcAfGavJAzeWmE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYZkaXxy5hiXCS9EFfeqFlkCelWdqkJWWnOSXWdMYGwQ&oe=69B16513"}, "display_name": "Wings 1941", "keywords": [], "long_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, the great Zeppelin, the fearsome Tiger Tank and many more!\nGeneral Brandon will guide you through each mission. Do you have what it takes to beat the 10 epic campaigns like Battle of Midway, D-Day, Stalingrad, El Alamein and more!\n\n* Unlock up to 10 iconic planes such as B17 Bomber, Hurricane, Typhoon and the cruising Mustang!\n* Pickup coins, chests, bombs, rockets and powerups along the way to upgrade your plane with\n* Control your aircraft with your hand being able to do barrel rolls and quick evasive manoeuvres relying on your wits and reflexes.  \n* Play with a friend and be the best of the best on the world leader boards!\n", "short_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, Zeppelins, Tiger Tanks and more!\nPlay with a friend and be the best of the best on the world leader boards!"}]}, "developer_name": "Ztar Games AB", "developer_privacy_policy_url": "https://www.ztargames.com/privacy", "developer_terms_of_service_url": "https://www.ztargames.com/termsofservice", "publisher_name": "Ztar Games AB", "support_website_url": null, "website_url": "https://www.ztargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "sv", "ko", "pt", "en", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "397042062187363"}}]}, "scheduled_offers": {"count": 27, "nodes": [{"status": "PUBLISHED", "id": "2758953524465470"}, {"status": "PUBLISHED", "id": "34034477602833779"}, {"status": "PUBLISHED", "id": "894527516833025"}, {"status": "PUBLISHED", "id": "605833669286927"}, {"status": "PUBLISHED", "id": "1624933995138738"}, {"status": "PUBLISHED", "id": "3772646106372098"}, {"status": "PUBLISHED", "id": "1966129437286068"}, {"status": "PUBLISHED", "id": "1088241666794786"}, {"status": "PUBLISHED", "id": "2093500544472048"}, {"status": "PUBLISHED", "id": "677308674793748"}, {"status": "PUBLISHED", "id": "1667911237125390"}, {"status": "PUBLISHED", "id": "1073635298110008"}, {"status": "PUBLISHED", "id": "1284073809269756"}, {"status": "PUBLISHED", "id": "1489787505102306"}, {"status": "PUBLISHED", "id": "483581927743196"}, {"status": "PUBLISHED", "id": "939433304
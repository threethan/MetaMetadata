ots": [{"file_name": "Level8.png", "id": "1188908844980629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031330_1188908848313962_8765417084185969790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbEjUHC5W3IQ7kNvwHHtwgT&_nc_oc=Adqlqq5ja3nxYA29-MF_7T6xzZ_5wWWaWw2MaCT4WhmjJJ9gOvrlpWqCHpuZ2xgOFRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbyhgiRhpxiDi4kALPv_YS7vaY96jAhtzWYU8x4CY3OA&oe=6AC2852C"}, {"file_name": "Level6.png", "id": "1180394342760998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974824_1180394349427664_4274700922446404293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K5EZUlHHcoQ7kNvwH4Df37&_nc_oc=AdpSw5DQM_Gmijr65Di7e3uy4JD-cTMyw-jGxeeMqvvpiuoLwUpiQgfvv_Jn93_tGpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmu24rERhqEgNYT2bdIpQ95NPNBEmei1tnMmkwi9wcGA&oe=6AC25B35"}, {"file_name": "Hangar.png", "id": "736078127429054", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_736078130762387_4087786333617780074_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX3k59ScsAcQ7kNvwEKJegO&_nc_oc=AdqVVdZEf_8XBKSVq3p5EfcnMVVXtQvOo84-ktKuaHUvM0Kf44xv9HAPWY3hrMIG1VQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyRfPWqJvBBYwl0hRTqmM2N75UlO-GHxg8AocJw34rJQ&oe=6AC265AA"}, {"file_name": "Level7screenshot.png", "id": "3487740514786451", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982619_3487740518119784_982484226486325661_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QvWMvsC4ZIQ7kNvwGLJpvE&_nc_oc=AdrAF0C393nHW2XqsP_qlEYeWLMc5975DA3i6CcYvvo-T0C1jKtkYxfNuWlA1PaJcj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYyxCmWziPIT1ZNfcRxabMdcYUuQFQO5JqlSWYyisPqg&oe=6AC281C5"}, {"file_name": "Instructor.png", "id": "1091616001389700", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982714_1091616004723033_4771933676956629913_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGO0WVNyVlsQ7kNvwFVN07u&_nc_oc=AdpqrjZIG1-sG2EpuM4O_fTxlT0-Ra6Aqfi-Y2o4QEWo__2CTkMakoXGyXvigbHNs_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNVCir90EXThH84ZHSvNeWCQ1FtaYrQjhbkZnE-ok5bg&oe=6AC25161"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wings 1941", "keywords": [], "long_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, the great Zeppelin, the fearsome Tiger Tank and many more!\nGeneral Brandon will guide you through each mission. Do you have what it takes to beat the 10 epic campaigns like Battle of Midway, D-Day, Stalingrad, El Alamein and more!\n\n* Unlock up to 10 iconic planes such as B17 Bomber, Hurricane, Typhoon and the cruising Mustang!\n* Pickup coins, chests, bombs, rockets and powerups along the way to upgrade your plane with\n* Control your aircraft with your hand being able to do barrel rolls and quick evasive manoeuvres relying on your wits and reflexes.  \n* Play with a friend and be the best of the best on the world leader boards!\n", "short_description": "Experience the thrills of the 10 most famous battles of World War 2 in this retro voxel shooter. Guide your aircraft through a hail of bullets and enemy planes, ships and tanks. \nUpgrade your aircraft and take on the the most epic bosses such as the Yamato Battleship, Zeppelins, Tiger Tanks and more!\nPlay with a friend and be the best of the best on the world leader boards!"}]}, "developer_name": "Ztar Games AB", "developer_privacy_policy_url": "https://www.ztargames.com/privacy", "developer_terms_of_service_url": "https://www.ztargames.com/termsofservice", "publisher_name": "Ztar Games AB", "support_website_url": null, "website_url": "https://www.ztargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_
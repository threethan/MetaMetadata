s": [], "long_description": "Get ready for an exciting Car Racing experience packed with speed, drifting, competition, and intense road action. Choose your favorite car, master challenging tracks, race against rivals, and push your driving skills to the limit. Enjoy fast-paced races, beautiful environments, powerful cars, and thrilling moments as you fight to reach the finish line first. Car Racing: Speed Rivals is made for players who love speed, competition, and arcade-style racing fun", "short_description": "Car Racing: Speed Rivals \u2014 Race fast, drift hard, beat your rivals, and become the ultimate racing champion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1282805881587973"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604347072_1512479264018696_5993458229586203251_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QxL4ucSjlQQ7kNvwGJ8vPt&_nc_oc=AdrvwyFLw-IdKICLtkS4jOPlqDEvsPNmrSIC6l5cTNekmkKvweHXHADqSMdsd-v2WdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&
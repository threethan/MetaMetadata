file_name": "4.png", "id": "2345924559279744", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303976_2345924562613077_961924828600898077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_qxXeAZKGgQ7kNvwFpnDCz&_nc_oc=AdoqWURYAYxT6NJUQ4tSXnIp-Eak6BFq19wWUkrjguknUy_a_nd9qgcq7DKlNEylOBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXq2Pjlaqdez3jyvTWqC951jT8CyCX22LuzFTEh39_Hg&oe=6ACE487B"}, {"file_name": "cc.png", "id": "2345371949608828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313069_2345371952942161_3328953411714628219_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbDb3aXHzaoQ7kNvwFSHf6V&_nc_oc=AdrUge_u5av_E6BAHC1xgk3Stt8vb3xE6s-e6yVLRFg-FgAGt-oTY0zVxJiY0-fkr20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMvhGu5N_-kfqG5KRV2Qbq-NenCPSx7AryLbBEmu-9Ug&oe=6ACE3E04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing VR: Speed Drift", "keywords": ["SpeedDrift", "CarRacingVR", "VRSpeedDrift", "CarRacingSpeedDriftVR"], "long_description": "Car Racing VR: Speed Drift\n\nGet ready for an exciting VR car racing adventure!\n\nDrive powerful cars, enjoy high-speed racing, and experience thrilling drifts in virtual reality. Take control of your car and test your driving skills across exciting racing challenges.\n\nExciting Car Racing\n\nGet behind the wheel and enjoy the thrill of driving in VR. Control your car and experience exciting racing action.\n\nMaster the Drift\n\nTake on sharp turns, control your speed, and enjoy the excitement of drifting.\n\n3 Challenging Levels\n\nExplore 3 exciting levels and test your driving skills. Complete each level and enjoy new racing challenges.\n\nStart Your Racing Adventure!\n\nPut on your VR headset, start your engine, and get ready for an exciting racing experience.\n\nCan you complete all 3 levels and master the drift?\n\nStart racing today!", "short_description": "Enjoy exciting VR car racing, master thrilling drifts, and complete 3 challenging levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1314273681774526"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1797977484676238_4120688268720129887_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5sJweM4LZgQ7kNvwEVB79z&_nc_oc=AdpbicNylr-_l6ODQOJhqj2qNJjQbJ-NBdIsx0xmq3SFmdit6LJ98z2g35nYFLonbp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0BOjVAsshLCwhMRngNnbEP-7sCM8bGdsXvMg-H61oBw&oe=6ACE410E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Car Racing VR: Speed Drift", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1787314860, "lastRevision": {"nodes": [{"id": "1242564745612087", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"ap
368"}, {"file_name": "com.medvr.aw-20250521-162151-0.mp4.00_03_00_23.Still000.png", "id": "1914754009280193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308349_1914754012613526_4127833603228476215_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gQyPkQw0sIQ7kNvwG3JcjV&_nc_oc=AdkACvbL3a4t704Irm8ZtcRa9vdjzpTtkEgMrTV4oVcikJzxLjZgXhZrdpJaZp5B_mU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTaj4VJmGQfJkscVNGH3SbjJdAP9Y04iGwZnWAW6X5cA&oe=69A80B5A"}, {"file_name": "com.medvr.aw-20250521-162151-0.mp4.00_17_13_06.Still007.png", "id": "1243871040564961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618912_1243871053898293_2188050935228984887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34rMpMLSRoIQ7kNvwHNHnus&_nc_oc=AdlgXy3vnittTiyYwc-tLvDLM5GrgOuFWAl4EV1DZuncYAW0rX_MAeR2Fvf7svgXnnI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvE4tAEZ7lB3ejeVhyfrxy766Aof99dI38OLYquYrlRzA&oe=69A83F48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alcohol Withdrawal Seizure", "keywords": ["Alcohol", "Withdrawal", "VR", "Medvr"], "long_description": "\"Alcohol Withdrawal Seizure\" is an immersive VR training simulation designed to educate medical and nursing students, emergency responders, and clinicians on recognizing and managing alcohol withdrawal seizures. This realistic scenario guides users through the assessment of symptoms, risk factors, and emergency interventions in a controlled virtual environment. Enhance clinical decision-making skills, improve response time, and gain confidence in managing this critical condition\u2014without any real-world risk.", "short_description": "Step into a high-fidelity VR simulation designed to train healthcare professionals in identifying and managing alcohol withdrawal seizures. Experience real-time scenarios, assess symptoms, and make critical decisions in a safe, immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url
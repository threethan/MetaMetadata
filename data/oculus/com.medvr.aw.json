2.Still004.png", "id": "3710567599240465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315359_3710567602573798_1659094283444565725_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NYDesCNq88Q7kNvwFiorSR&_nc_oc=AdoPMG2WE09W-UGBLJlKorVB2DGkjXhf_brXltDReiHt76vi78rqfkMQLjErlbVClH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3Pe90_9pqHzXrAIwmmtoYO6XSt1heV_JjsWr4K6W-bZA&oe=69F0A5E8"}, {"file_name": "com.medvr.aw-20250521-162151-0.mp4.00_03_00_23.Still000.png", "id": "1914754009280193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308349_1914754012613526_4127833603228476215_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz2F5_nZ0I0Q7kNvwETJIpl&_nc_oc=AdrtX6zUH5Tnb5eYHqKcItlm8fDOD_p5_d2iPeZKM5-XlqDwOfVrCZgtcQjye4kPFg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Cd0h8F_i5sSYBQiCmqzfF_ZqgLuEMpc5D82sbT9E2_Q&oe=69F0C61A"}, {"file_name": "com.medvr.aw-20250521-162151-0.mp4.00_17_13_06.Still007.png", "id": "1243871040564961", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618912_1243871053898293_2188050935228984887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOLyZT-PGf8Q7kNvwGlhUdK&_nc_oc=Adoa78Nkf9iSXncctqH2sx46SsQNt3yNaJXB1qGa1ZVtIrIYFxLnGEWvgTGvTKJy6mI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2EfEggN8IUMYBzlNqNUSI28YsalRfjICcEOHf8Ty9qWA&oe=69F0C1C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alcohol Withdrawal Seizure", "keywords": ["Alcohol", "Withdrawal", "VR", "Medvr"], "long_description": "\"Alcohol Withdrawal Seizure\" is an immersive VR training simulation designed to educate medical and nursing students, emergency responders, and clinicians on recognizing and managing alcohol withdrawal seizures. This realistic scenario guides users through the assessment of symptoms, risk factors, and emergency interventions in a controlled virtual environment. Enhance clinical decision-making skills, improve response time, and gain confidence in managing this critical condition\u2014without any real-world risk.", "short_description": "Step into a high-fidelity VR simulation designed to train healthcare professionals in identifying and managing alcohol withdrawal seizures. Experience real-time scenarios, assess symptoms, and make critical decisions in a safe, immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "23870755335854119"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "698473749775084"}]}, "baseline_offer": {"id": "698473749775084"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749622440, "status": "PUBLISHED", "id": "698473749775084"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24624302493832729", "version": "1.1"}, "id": "915744614011203", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23870755325854120", "is_conc
n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW0r0GUqxiwQ7kNvwFyXEWj&_nc_oc=AdrMhi3AZ9xmKEOg6VzYJi3XOy8If8WXT1gmERHyiXNtMaawU0Y7KfgRozbKjSABnAI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVgZjVU869iPmmJwEmsScTtqUISQ3RB-8n_H_nNV5dFQ&oe=6AF084C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alcohol Withdrawal Seizure", "keywords": ["Alcohol", "Withdrawal", "VR", "Medvr"], "long_description": "\"Alcohol Withdrawal Seizure\" is an immersive VR training simulation designed to educate medical and nursing students, emergency responders, and clinicians on recognizing and managing alcohol withdrawal seizures. This realistic scenario guides users through the assessment of symptoms, risk factors, and emergency interventions in a controlled virtual environment. Enhance clinical decision-making skills, improve response time, and gain confidence in managing this critical condition\u2014without any real-world risk.", "short_description": "Step into a high-fidelity VR simulation designed to train healthcare professionals in identifying and managing alcohol withdrawal seizures. Experience real-time scenarios, assess symptoms, and make critical decisions in a safe, immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
&_nc_ss=7f20f&oh=00_AQRliyBXptknFWgYdPOZAMVBtwL-sIMN7uW9BPSXimaCig&oe=6AFDDD2D"}, {"file_name": "3.png", "id": "1108753288753904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507832394_1108753292087237_5372653666096350555_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcB-OSmQJZYQ7kNvwH-3tlQ&_nc_oc=AdrRYgJHoe1-Npg_ni7Gj4Uw-nzm_NM_OAuOe8mkJYH0bU27Hg4FjHgYOKXte9DXStM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyXEIp-MwL-9aN3NBIs0PbYWRIh3Od8aF6J33JVJMLnQ&oe=6AFDDD7E"}, {"file_name": "5.png", "id": "2911904849208758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593882405_2911904852542091_6973070165334123657_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU6D8OiCXJ8Q7kNvwG5fxCe&_nc_oc=Adoe2hpp5F_g26kN6RVdRJkk7Ie8LfsVIrXVJquhElLJXQNCWi7P_7zcq61i-QbrlPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRECNRaQDVoS1UMyfeSaVsB_ht8BltHN0nKkNtLhJ5FqQ&oe=6AFDDF03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paint Shift VR", "keywords": ["paint", "hide", "colour", "mechahidecolour"], "long_description": "**Paint Shift VR** is a colorful VR hide-and-seek game where your surroundings become your best hiding spot.\n\nStep into a playful world filled with colorful environments, interactive objects, and unexpected places to hide. Move around the map, explore your surroundings, and use paint-based camouflage to blend into different surfaces and objects.\n\n**Find the perfect hiding spot.**\n\nMatch your colors with the environment, stay completely still, and try to become part of the scenery while other players search for you. Sometimes the best hiding place is right in front of them.\n\nBut hiding isn't always enough. Make quick escapes, change your position when the coast is clear, and use the environment creatively to avoid being discovered.\n\n**Features**\n\n* VR hide-and-seek gameplay\n* Paint-based camouflage mechanics\n* Hand-based VR movement\n* Colorful stylized environments\n* Interactive and creative hiding spots\n* Fast-paced rounds\n* Fun social VR moments\n* Easy to learn and replay\n\nEvery round creates new opportunities for clever hiding, risky escapes, and unexpected discoveries.\n\n**Can you blend into the world well enough to stay hidden?**\n\n**Paint your way in. Blend into the world. Stay hidden.**", "short_description": "Blend in, hide in plain sight, and outsmart your friends in **Paint Shift VR**! Explore colorful VR environments, use paint-based camouflage, find clever hiding spots, and escape before you're discovered."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/city-art-horizon/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "City Art Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/city-art-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1261579153704051"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2158055998258454"}, {"status": "PUBLISHED", "id": "1410156754374327"}, {"status": "PUBLISHED", "id": "1449986770297684"}, {"status": "PUBLISHED", "id": "2798286387220793"}]}, "baseline_offer": {"id": "2798286387220793"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789923600, "status": "PUBLI
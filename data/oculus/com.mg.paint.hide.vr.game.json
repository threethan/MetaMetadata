xPbkriIyXPQ&oe=6AFDBF93"}, {"file_name": "1 (4).png", "id": "2676333792787578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_2676333796120911_2199222331707975599_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvE9H4XLILsQ7kNvwEid8Fw&_nc_oc=AdqvdOmY--ukW8zSfCInLbCYWFLX849mQ07OQpgKZh4plM69ssNrqDpJu0hhi-Blpw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYacqGzz9cfvEG4KukvhIuCLstNDVImniJmgRS-4o0UA&oe=6AFDBDD2"}, {"file_name": "1 (1).png", "id": "1672623897778574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_1672623901111907_7615135590743453933_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xwO_hzxp8cQ7kNvwFCOsqy&_nc_oc=AdqHaee5AI8gjlkl8qc0RYghsQgrdIXnguaJFnfGdUQF56avmdChCgodCCBXxk_8kaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQWeagU_nWSwPtUXJJPe0Kp-g9qKTDt7u1c5Jsn-MRcg&oe=6AFDD6E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paint Shift VR", "keywords": ["paint", "hide", "mechahidecolour", "Chameleon"], "long_description": "Get ready for an exciting game of camouflage, exploration, and action in **Paint Shift VR!** Explore colorful fields and immersive VR environments, pick up your gun, aim carefully, and shoot your opponents before they spot you. Hide in plain sight using paint-based camouflage, discover smart hiding spots, sneak around the field, and escape detection. Outsmart your friends, stay hidden, and be the last player standing!\n", "short_description": "Blend in, hide in plain sight, and outsmart your friends in **Paint Shift VR!** Explore colorful VR environments and wide-open fields, pick up your gun, take aim, and shoot other players before they discover you. Use paint-based camouflage, find clever hiding spots, explore the field, and escape before you're discovered. Stay alert, move strategically, and prove you're the ultimate master of camouflage!\n"}]}, "developer_nam
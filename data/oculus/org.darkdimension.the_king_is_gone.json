82428476616724_1116172443318779459_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye0PvTKmrt0Q7kNvwE7VmTv&_nc_oc=AdmcTwOK0gqUJExWwY6Dsq83Tf6Q09GdowLI5ZqjASSDDjxbiy20MCEVEilXK53Fzic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfGi-YDKs1kb9QFWHEx2OUPMT5wKGeOlYK8ms9BFqHxg&oe=69AC3411"}, {"file_name": "scr_4.png", "id": "159298223794289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031624_159298230460955_160499850208589564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoVK1kLE088Q7kNvwH5m6Ee&_nc_oc=AdnbdbRRrxwLKRbnDQcvuMLgB1ppnCmaik8lwqp5TXD5aruoeBJNMjct_NHPKxlZjIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxctc0I2niq211VwYHyfvSsIa3cwaTSn5t3_8xkulHvdg&oe=69AC039D"}, {"file_name": "scr_3.png", "id": "1622890074875818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1622890078209151_210179435196440368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GSiPzPy8NcQ7kNvwFGH0BI&_nc_oc=Adl7-tsvG-4Ce4WH1nTIjKVOIJg5NshgbCuay3LDi424SL1qlud9yhmAHV6xtiG9wOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afymn4RWUt2F1COA1R0F_zrv286SXFa4rJarX-ujh2Y6zw&oe=69AC2EB9"}, {"file_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HYvrTZF2msQ7kNvwHmq3K1&_nc_oc=AdnAHFHdd9whA_ETyoO-vfyNk83071ifR8jO1t8j2XzrbcNl78RHQSS1KAAXuasOmjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyewLPkss0SdQbBIMyRJSmjKKkcod1Mktfab5jfje-vDg&oe=69AC1D0A"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYYsdXGw3IoQ7kNvwGEUXqW&_nc_oc=Adltmc0U8yULUZg-SZVFx7bA9RzGDuiqyBDO12QsCUrul0cHua1qbUnpO0pUyEbXa4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSvxQGqliN9CsQM3uMyx9z0vb2O2q7QJsHSogr3IUzFA&oe=69AC1DDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloofdev.com/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloofdev.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": 
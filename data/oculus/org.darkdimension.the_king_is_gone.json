82428476616724_1116172443318779459_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tfrHUVUbyUQ7kNvwHFs1nG&_nc_oc=AdmdKEIO6Az7BZH8NXORLnNTZ41XYGPODVKtg5DNQwexQ_G5o7KWDBaK5hqv0f2Nra8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz6bYi0qoIT1mBTU7ZNgasl5RtZsnukleokSYj-9-_1g&oe=69BC0611"}, {"file_name": "scr_4.png", "id": "159298223794289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031624_159298230460955_160499850208589564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS5fADsNAi0Q7kNvwGRHv1W&_nc_oc=Adlf0ElWqRAYM5eUa4Lxu4i7VRDJnnpELE_FvNDvLdifIL-Cig32mrFelUunP5tLnTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGs-G7zsnTbCwJxxeTP4ioeWMqpTcSq1fxnsv92ANohw&oe=69BC0DDD"}, {"file_name": "scr_3.png", "id": "1622890074875818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1622890078209151_210179435196440368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EViCJqV2mbkQ7kNvwF8sePR&_nc_oc=AdkfUZkPj0l3_7QUxbcW0gTCAY1qdC-sbZ4i7uZt5ocBPdTqzxbwtpfBd_a_sFx7Mh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3iBQDdTcEMY0AwQm0sBuD5qudbfVKyJOBvh3uRPXRHA&oe=69BC00B9"}, {"file_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9egBz4Ap1DkQ7kNvwE-Qv-Y&_nc_oc=AdnrEAmnaPP2KO2sg6cgy8qzt0J7c2gI70q5_DRAW366BXOlfZPF3Q6QS_8o3GSAdRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZur9upVFfYDjaevXB804Ds6JFlZwxaNup4SJ8VlbIVw&oe=69BBEF0A"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzL2eWat85EQ7kNvwGEdG3s&_nc_oc=AdmhaF47tEE54UFa8f5gn3CWrlHvS5Z0Xc12-zcDSziJEifG_s24H9d5ReOhJpaMByU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmAsOUnajkhU6sOJhJreGSgetLbWq_8sU0zOKZzuijvA&oe=69BBEFDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloofdev.com/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloofdev.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": 
82428476616724_1116172443318779459_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRW7ylvHZyAQ7kNvwFAXAVW&_nc_oc=AdnATJWy5Q92J1_KCuJTpZG7tMjzLba3-DFTNdPZxg7LQoDpzzVo5tBAPbJPtFpIJ4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpxoM3Wll7frXGnCLilaO1fQyL8VAF1uDiv6vjksJKrA&oe=69B41D11"}, {"file_name": "scr_4.png", "id": "159298223794289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031624_159298230460955_160499850208589564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DbGLTrdIA8Q7kNvwH6ghV-&_nc_oc=Adm02XhYb_QuqlWBk9Vb0F6rCbuPs066tgAOIJjZKu70ciSifQ7y2brvdGaJPoupybs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxh9GUaqgJJQLBST8BXQn0trJxMXe-HMcrJPu8NAMDfxg&oe=69B3EC9D"}, {"file_name": "scr_3.png", "id": "1622890074875818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1622890078209151_210179435196440368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXyYTuUKdqEQ7kNvwHacGD1&_nc_oc=Adlq_Clx5y2CyFW5KttXgNyp0cErdaiAm0wTo3ihNZzBYasJ8zzA13y4ydBvHgoq674&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrDGhGf-jo7wMqSIjAHY3JtNuCXIibke7wBI-wMfQcBw&oe=69B417B9"}, {"file_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSiH5LiSLYsQ7kNvwHn2SCy&_nc_oc=Adn9tio8rkkMJKZfpc4byT2HpR7OygBaY-7V-1eOX-XwnD2v3tLkCAywYfiZKLEcUg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz70RXreTQM96dJKYuCoWKJ3ifNdP5_jgA_7fFOMqGXcA&oe=69B4060A"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-z02HgL6AsQ7kNvwHkiEa7&_nc_oc=AdlspJ1Wpr_bt2gklFFchfOUWi0Wd4wIgHcIFvinSUzpmsXo9mwaqIE36MGURd9VVsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMU4s0J-2D2bHIn3mkSYqaPq_-VZfvWUmdXH79zvhQPg&oe=69B406DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloofdev.com/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloofdev.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": 
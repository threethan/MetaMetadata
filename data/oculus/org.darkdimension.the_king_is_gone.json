ile_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmX3DRBhtu8Q7kNvwFUfGFM&_nc_oc=Adqi0ZpQTZqwvlGqsb3-ldtKm0PJYIbvpcuZl3jaLi94XpXYqBEHi1cSg_c0q64vFRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_abgtozb0bLSuk2zlOLqZgEK3v411MDe_W0jmZ1CtJDA&oe=6A38144A"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-P2M80EoS4Q7kNvwHGxrj_&_nc_oc=Adq3eR4Y9fAtTI7j4CpBvL8b2jXGXDCLu8C16RDOviCA1J9_fpNmkoUM1XygDaBk6pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3K4_7TAWo7re8AXovDK6azPKLpSzoSVi_6BxGjgZdSg&oe=6A38151C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloof.dev/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloof.dev/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24500439129581678"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031491_1485227315343125_5468368369070362490_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jEeuRBZsAMQ7kNvwEs_Nx7&_nc_oc=AdquowDN0hTcSzsTwZ859RuktkUgsnrSiSma91yvaYoLGKJDyTJGZVgcxE8t9mqXmVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N5N2U55qRuYmWfzn-zjokPJ2FrgnwVIADBU_97dniMg&oe=6A37F46C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The king is gone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1686340294, "lastRevisio
_ohc=WkUhd_JGHQoQ7kNvwE414fi&_nc_oc=AdrH22-beGW1z4Dp1s0tjVjBvptLS9TCYizgjVGjr582Jsp4xY9SnxLQHGc-XnEuYfc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjDPuhHoUdbm1MAtGqFVWKM-PTL1c-pwBdHozoM6EEPA&oe=6AFC9579"}, {"file_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-drDY25Fs4Q7kNvwF-_gXB&_nc_oc=AdpKzQUtME9G0iDGWCqGNy7gpF2ir2r49ifpbpBOYR9Al9A3k32Oky0MGzothU8LH_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL_4nzYJoRpzOEgRNT1sc4daEjYkFQeQjg17cn-xSs9A&oe=6AFC83CA"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPva7AbzYaQQ7kNvwHimsYE&_nc_oc=AdppjOpDre2c53wrzDQtaVeTFWkHqO2GF--5t4Bp8FjHD6czJQEWCHqA5j7LHXCOlzs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI2JpjH6z_B3mEYK0arUjvmXAmdUNCl1pXSh0NGB4WmQ&oe=6AFC849C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloof.dev/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloof.dev/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24500439129581678"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031491_1485227315343125_5468368369070362490_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hONi20sV570Q7kNvwHqQjpG&_nc_oc=AdppQxZ3r0oxE8vG9Ny73ysvF46BQGNEVeHWTq-xncLdNgoet55CuNxZq6B3sdCpyuo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu9KHOTNDYPYZtJNKQBda4xgwdTogiADnJv89JtoFWkA&oe=6AFC63EC"}, "is_concep
aiZIFEPKIKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJ5_2hepxuHyUCPLS2xk1Lelh8CvTdft-YkqOcPLKuDA&oe=6999BF11"}, {"file_name": "scr_4.png", "id": "159298223794289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031624_159298230460955_160499850208589564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULDBi85-7IQQ7kNvwEyA21k&_nc_oc=AdlSw7uhKno6tQ4-ipQ6B5Rme9EO5PI_mnYdq4wIT_7KJzt5lH2ZxQBtCduuZYI9fOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvl72lZpI4ejjyNIwzoic2rh4qwYNlBqau9vUxntRZhTg&oe=69998E9D"}, {"file_name": "scr_3.png", "id": "1622890074875818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003228_1622890078209151_210179435196440368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7Ut0dsCniEQ7kNvwFI4RHr&_nc_oc=Adn5XBIvpKRGhLKaN3JrpB3G26qARkIN-A1u48EbHlVCLK1oVQWKEj-7-kxsAeJoNQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGPNQO5WbpnReOciKE02KZRwQNavd4EBkiAZ3ZetWKDg&oe=6999B9B9"}, {"file_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enk5xEOH__MQ7kNvwE4avIu&_nc_oc=AdkgpXZKSFmBWfk9anOAwc9sut4r8pJ5zxIvjmbI0P5ijEepb-89I223FlrAnUUOVyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfumwLcAkfxxDV52tclfA3_60OxaCbLbtvijPqrNY1p8mg&oe=6999A80A"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPJzAJ76XyMQ7kNvwH4zQq2&_nc_oc=Adn3CURXpCjt59MHcwU7Vl33KcckHpd3WIxWdgZe1A5bG6089VgbLyTLVJinUnm_dB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqU78fmrqbN7QGJGrAvNhMVw1JMxBSV37tI6KHDSsrhg&oe=6999A8DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloofdev.com/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloofdev.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
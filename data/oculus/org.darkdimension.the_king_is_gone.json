2LTUisL8SLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0jI8HZi3ps1nfQt-fUMtuT98Q6NMUU73JtS4IXdVxPfA&oe=69F0C211"}, {"file_name": "scr_4.png", "id": "159298223794289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031624_159298230460955_160499850208589564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiHylH-cF88Q7kNvwH3Q_fN&_nc_oc=AdoR2VxujZI8FkBvl6gm2j1h-ybZ-UI3IGsFiZvLlxy3LMZALumuIZzAddkKUr8mniQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1FhhWQ1A6t2lA1qogzmN-tmwshal4FZKuG47W9semz3w&oe=69F0C9DD"}, {"file_name": "scr_3.png", "id": "1622890074875818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1622890078209151_210179435196440368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RPVUYHqpJ8Q7kNvwFvdIe2&_nc_oc=AdolaKBi8N6l7RQ5oDteAZgrHt5wqvQGef0zDgo4PRgguZHdkoK0tL8hgqtP_1ZA5gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1C7UX87t432R9DCPNeqThuDPPYTndzisBrepGrZLiJrg&oe=69F0BCB9"}, {"file_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRokjyaorSoQ7kNvwGdFLI4&_nc_oc=AdoegYKvdPOqKM6BjLAki6LOUBKfkwc_-cVduG43LPtvXBA9KPmA8zsfLQPqv3bpicI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af03rif05hrEAA-V-nFCg2VTl3RwNDHdpTLhl6jkyULZKg&oe=69F0AB0A"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kV0LIlHkhYQ7kNvwFTkUMM&_nc_oc=AdqDs1PWhvSuPxOSkDmBtysbRQvCdydKfwCXB5aF52DIWjsJ1_2QmpuubMJAXMehlFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1rmGiB4ZR09ua3S0KkNFZq5gQhvkse60MSDxEQSNR4BQ&oe=69F0ABDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloofdev.com/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloofdev.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
x2uvcGIfVSE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvIssetYN6EbNaZVxGDpczhPlCmW7CRRSf8fwYxzB3uYA&oe=69A1A811"}, {"file_name": "scr_4.png", "id": "159298223794289", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031624_159298230460955_160499850208589564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoAkLKZGKswQ7kNvwHfEF1X&_nc_oc=AdmlmwV8zG8u37_4XVIbDVEf-O4KbVlGdNftb6zaPO8KDoiyjMHdmcRJf8iPaojJ7gc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftltkvGF-iIKKB1zQmueOaNIfpwqKWAhiQtBc5FHZgSeA&oe=69A1779D"}, {"file_name": "scr_3.png", "id": "1622890074875818", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003228_1622890078209151_210179435196440368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnm034tkISMQ7kNvwG-gtqa&_nc_oc=Adn8xwzXAp4Tv-gAL7kT-pmmD7Hmf7y5ctpfb8CMCo_Vd3PcSNDfc5ity9ix2DFdn24&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvxszRjbIlZvO91WO4b3hWSW214rrokzoZPUo5RdA_mFg&oe=69A1A2B9"}, {"file_name": "scr_2.png", "id": "177703811915843", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39003228_177703815249176_1528287960455225088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvuytMo8mssQ7kNvwEnZMl5&_nc_oc=AdkS7D6IQKjKx4SGl7oi_IoZk8OZG4Lyf7ZYjGTy_eL13U1W_8d1VCsYm7nF2RVGhiQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsoDCNXsc54RwPvdKh-radePZAe1TyR0tW0ZbHLs9Teig&oe=69A1910A"}, {"file_name": "scr_5.png", "id": "808935813774196", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031332_808935817107529_8861221418933832083_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZjdmCZqPBYQ7kNvwHKbuWO&_nc_oc=AdnNgGwcVzrqk0svmu2w4dJteZtML02nXDRFANZGehl7t_Z9h3pmleBSG4BuEH8bKro&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftqtceh8Tlhi80In_XhO21-gn3mvUr1F8aSnzCS2nRZww&oe=69A191DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The king is gone", "keywords": [], "long_description": "In this game, you have to run away. Different doors are blocking the way, that need to be unlocked to proceed as fast as possible. Each door will give a different benefit, and a combination of them is the key to succeed .. or fail.\n\nTo open a door, a puzzle is presented, where pieces of a key have to be rotated and merged together to open the door. The further you run, the more difficult the key puzzles become.\n\nThere are three different modes:\n\n* Normal Mode: Score is increasing the more you survive. It decreases the more you stay idle in a room without picking a door. There's a set amount of rooms to complete before reaching the end.\n* Endless Mode: Score increases with each room that is completed. There is no end to the amount of rooms presented.\n* Random Mode: Each door has a specific score as a reward when opened. Rooms and their rewards spawn at random.\n\nThe available benefits from the doors are:\n\n* Green doors: Increase running speed.\n* Purple doors: Increase lock-picking skills, which makes opening new doors easier.\n* Blue doors: Gives extra chances before losing.\n* Brown doors provide no direct benefit, apart from helping complete more rooms.", "short_description": "A puzzle game about running, not because one has somewhere to be, but because one has somewhere they don't want to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloofdev.com/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://www.afloofdev.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
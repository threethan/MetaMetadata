.com/v/t64.5771-25/473391883_2079445595860491_2028458573256282914_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79crXKUr5jwQ7kNvwFdrZAB&_nc_oc=AdnJF47qYuBVFLIzJWVJ4x6RHZ6WZSpT9izgjUEK7D4JxSPdlQ4BnZ2ztJapg5uWUlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsIh1rg1JYN_Bbz3GVWmvuGp19JjGyWoZF3i2Dn6irc3w&oe=69A82B8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u8bbe\u8ba1\u6e38\u620f\u56fe\u6807 (6) (1).png", "id": "1017544210308768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1017544213642101_3256962725665488887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypblVYxVsZQQ7kNvwF7SiVC&_nc_oc=Adm9psmh_zqK4HMMghueubLw26IwH6rD43GDJDXYrIipE_XPUehfwEhziTJM2Vg4H8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsXV2yY6MI7DrDaRhjKu7at3t81EdRAQCPSA8RWQ6pAQQ&oe=69A834FA"}, "display_name": "ZenInkParty", "keywords": ["party", "game", "ink", "climbing", "art"], "long_description": "ZenInkParty: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nCore Gameplay\nBattle, climb, and explore through three handcrafted VR challenges set in a breathtaking ink-wash universe where mountains bleed into clouds and cranes dance like calligraphy strokes:\n\nCliff of Whispering Winds\nGrip your way up ever-changing rockfaces using VR motion controls, where crumbling ink-stone holds force strategic leaps.\n\nHammer & Vermin\nWield a giant (zh\u00f9ti\u011b, cast iron) hammer to smash mischievous ink-rats bursting from rice paper screens.    \n\nSongbird Sanctuary\nLoad a bamboo slingshot to shoot clay pellets at phantom sparrows terrorizing a Zen garden.\n\nSecrets in the Scroll\nDiscover two (j\u012bgu\u0101n, mechanical puzzles) to unlock:\n\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges (e.g., \"Most rats smashed in 60 seconds\")\n\n\nAdaptive grip mechanics for immersive weapon handling\n\nSpatial audio reacts to environment (e.g., climbing winds intensify with height)\n\nFuture Horizons\nLaunching with 3 core stages + 2 secret realms, with quarterly updates adding:\n\nNew\u673a\u5173 puzzles (tea ceremony balance challenge confirmed)\n\nSeasonal variants (snowy mountain climb, cherry blossom slingshot arena)\n\nExpanded avatar customization using historic Chinese dyes\n\nWhy Players Love It\n\"Finally, a VR party game where beauty and chaos share the same brushstroke.\"\n\u2013 Beta tester review", "short_description": "ZenInkParty: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges"}]}, "developer_name": "LeoPardVR Studio", "developer_privacy_policy_url": "https://github.com/LEOsangMO/-ZenInkPartyPrivacyPolicy/blob/main/ZenInkParty%20Policy", "developer_terms_of_service_url": null, "publisher_name": "LeoPardVR Studio", "support_website_url": null, "website_url": "http://www.zeninkparty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9273843682692844"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1186110842373209"}, {"st
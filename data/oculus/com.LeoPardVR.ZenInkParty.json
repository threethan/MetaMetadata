ent-ord5-2.oculuscdn.com/v/t64.5771-25/473391889_1337212340813946_9129971569962884707_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6zwl_hUl20Q7kNvwFO-iYq&_nc_oc=AdqyYWpI2UuH8O5zYVX1d2ERFZMAzUo2V_dWW1Yh05tLAHIIbwYs2G5VeNsEZQvtlxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E4T_gbtRkSdEt0nyHAYItYirpqC5ropw9HqFpINVWyw&oe=69DFA06D"}, {"file_name": "com.oculus.vrshell-20250324-155118.png", "id": "1731803624429578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393752_1731803627762911_6455060953460563439_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4itsbXNs6EQ7kNvwHx6hw4&_nc_oc=AdqW39UtNQtQI-jp3117WhdPcq3Zdy0xjQH3hvdETjtq-NijL8vBTjvSQlCMlUXzYgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VdNf9spIdxsa4U4blp4PLD8SGDrmNuDvl3KhjUYbKFA&oe=69DF9066"}, {"file_name": "com.oculus.vrshell-20250324-155309.png", "id": "1453787232252421", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1453787235585754_9124498965573823185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R2TNQr-wMoQ7kNvwF9MsYF&_nc_oc=AdpW7Mbd_vWgvDdmgfl5IRKIpLKVtoeKrviUrGdjRqZXjfE9SJsrxcVg1WaIWk_vHcE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af058m8gR3CPdBXnGR4gQSCqcm2nuO9S1FBoHRiRAJ2S4Q&oe=69DF71D1"}, {"file_name": "com.oculus.vrshell-20250324-155349.png", "id": "2079445592527158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_2079445595860491_2028458573256282914_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLlGkqU-W4kQ7kNvwHWLdT2&_nc_oc=AdrPyuu7VC8e4TwN9U__OyvMbJBcEU6pN4PV-AxBq1UdLURI5t5trbv3gMD0IXvbJy0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XudV27djDHyyMm6DSro71sv-24LVAFQCIfzy3lsulug&oe=69DF8A8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u8bbe\u8ba1\u6e38\u620f\u56fe\u6807 (6) (1).png", "id": "1017544210308768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1017544213642101_3256962725665488887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lem3a-JaEJwQ7kNvwGo_GeJ&_nc_oc=Adpc963xfRPXeY3zAf3-gR3FkqjbYOrLQm6qIltQ2uj5jMKGtPpM_kRRKf2RyuNMJbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bJCJsou61nowWSuLUHQJKGbtjF_tinmg4jgAnpZdxhg&oe=69DF93FA"}, "display_name": "Zen Ink Party", "keywords": ["party", "game", "ink", "climbing", "art"], "long_description": "ZenInkParty: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nCore Gameplay\nBattle, climb, and explore through three handcrafted VR challenges set in a breathtaking ink-wash universe where mountains bleed into clouds and cranes dance like calligraphy strokes:\n\nCliff of Whispering Winds\nGrip your way up ever-changing rockfaces using VR motion controls, where crumbling ink-stone holds force strategic leaps.\n\nHammer & Vermin\nWield a giant (zh\u00f9ti\u011b, cast iron) hammer to smash mischievous ink-rats bursting from rice paper screens.    \n\nSongbird Sanctuary\nLoad a bamboo slingshot to shoot clay pellets at phantom sparrows terrorizing a Zen garden.\n\nSecrets in the Scroll\nDiscover two (j\u012bgu\u0101n, mechanical puzzles) to unlock:\n\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges (e.g., \"Most rats smashed in 60 seconds\")\n\n\nAdaptive grip mechanics for immersive weapon handling\n\nSpatial audio reacts to environment (e.g., climbing winds intensify with height)\n\nFuture Horizons\nLaunching with 3 core stages + 2 secret realms, with quarterly updates adding:\n\nNew\u673a\u5173 puzzles (tea ceremony balance challenge confirmed)\n\nSeasonal variants (snowy mountain climb, cherry blossom slingshot arena)\n\nExpanded avatar customization using historic Chinese dyes\n\nWhy Players Love It\n\"Finally, a VR party game where beauty and chaos share the same brushstroke.\"\n\u2013 Beta tester review", "short_description": "Zen Ink Party: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges"}]}, "developer_name": "LeoPardVR Studio", "developer_privacy_policy_url": "https://github.com/LEOsangMO/-ZenInkPartyPrivacyPolicy/blob/main/ZenInkParty%20Policy", "developer_terms_of_service_url": null, "publisher_name": "LeoPardVR Studio", "support_website_url": null, "website_url": "http://www.zeninkparty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9287246361352576"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391960_2233080573754421_3776271644659064315_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob5eKmPwOtcQ7kNvwGCxF1b&_nc_oc=AdoVQJBEoFq0vmERAkDGFpP2PgyOcw9KYisauZr9ABBKSnMAh1QQhIvZkcUy7Ly2hVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X_ufcHC8yVxHxCNzBQP0SWcqlB3yo5NNOyxrKgTJung&oe=69DF9D16"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Ink Party", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
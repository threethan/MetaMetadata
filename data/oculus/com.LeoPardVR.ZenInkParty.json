771-25/473391889_1337212340813946_9129971569962884707_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POjKVLssOoMQ7kNvwG3lnuE&_nc_oc=AdmlcP40OhBdFCD1ui4T4qFTadrpafLQyriAS3U33WdR2D49iHq95MddUOvJniwHq7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvmvfCewggwxlka4BbSdqvApQ-dJtB4T836iwEx8-9TUA&oe=69A8092D"}, {"file_name": "com.oculus.vrshell-20250324-155118.png", "id": "1731803624429578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393752_1731803627762911_6455060953460563439_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1dKUJ6TFioQ7kNvwEsEsWg&_nc_oc=AdluUlYQZ6Yu00fG9kgy1tyDdK4iF_2Lgi606Xg1upxd-PE9LM-mtV4_nSAe1KcT5b0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsQeHnDUF9KLzV8QoF4F0tiqyWaIv1VlFIPR_qsSO5-Ew&oe=69A83166"}, {"file_name": "com.oculus.vrshell-20250324-155309.png", "id": "1453787232252421", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1453787235585754_9124498965573823185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ks3Kv3AL5kQ7kNvwEpw9lr&_nc_oc=Adk57WPaN4yxDXmqwMkK-whl_TdqfAfK5ewJVsOb234v8fbD14rIthJ7b6C3dZ9MXfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsHE86dxoLIEJijSVgVxaic9vOQJEcLyqGAkKs_CN7Jzg&oe=69A812D1"}, {"file_name": "com.oculus.vrshell-20250324-155349.png", "id": "2079445592527158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_2079445595860491_2028458573256282914_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79crXKUr5jwQ7kNvwFdrZAB&_nc_oc=AdnJF47qYuBVFLIzJWVJ4x6RHZ6WZSpT9izgjUEK7D4JxSPdlQ4BnZ2ztJapg5uWUlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsIh1rg1JYN_Bbz3GVWmvuGp19JjGyWoZF3i2Dn6irc3w&oe=69A82B8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u8bbe\u8ba1\u6e38\u620f\u56fe\u6807 (6) (1).png", "id": "1017544210308768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1017544213642101_3256962725665488887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypblVYxVsZQQ7kNvwF7SiVC&_nc_oc=Adm9psmh_zqK4HMMghueubLw26IwH6rD43GDJDXYrIipE_XPUehfwEhziTJM2Vg4H8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsXV2yY6MI7DrDaRhjKu7at3t81EdRAQCPSA8RWQ6pAQQ&oe=69A834FA"}, "display_name": "Zen Ink Party", "keywords": ["party", "game", "ink", "climbing", "art"], "long_description": "ZenInkParty: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nCore Gameplay\nBattle, climb, and explore through three handcrafted VR challenges set in a breathtaking ink-wash universe where mountains bleed into clouds and cranes dance like calligraphy strokes:\n\nCliff of Whispering Winds\nGrip your way up ever-changing rockfaces using VR motion controls, where crumbling ink-stone holds force strategic leaps.\n\nHammer & Vermin\nWield a giant (zh\u00f9ti\u011b, cast iron) hammer to smash mischievous ink-rats bursting from rice paper screens.    \n\nSongbird Sanctuary\nLoad a bamboo slingshot to shoot clay pellets at phantom sparrows terrorizing a Zen garden.\n\nSecrets in the Scroll\nDiscover two (j\u012bgu\u0101n, mechanical puzzles) to unlock:\n\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges (e.g., \"Most rats smashed in 60 seconds\")\n\n\nAdaptive grip mechanics for immersive weapon handling\n\nSpatial audio reacts to environment (e.g., climbing winds intensify with height)\n\nFuture Horizons\nLaunching with 3 core stages + 2 secret realms, with quarterly updates adding:\n\nNew\u673a\u5173 puzzles (tea ceremony balance challenge confirmed)\n\nSeasonal variants (snowy mountain climb, cherry blossom slingshot arena)\n\nExpanded avatar customization using historic Chinese dyes\n\nWhy Players Love It\n\"Finally, a VR party game where beauty and chaos share the same brushstroke.\"\n\u2013 Beta tester review", "short_description": "Zen Ink Party: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges"}]}, "developer_name": "LeoPardVR Studio", "developer_privacy_policy_url": "https://github.com/LEOsangMO/-ZenInkPartyPrivacyPolicy/blob/main/ZenInkParty%20Policy", "developer_terms_of_service_url": null, "publisher_name": "LeoPardVR Studio", "support_website_url": null, "website_url": "http://www.zeninkparty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9287246361352576"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391960_2233080573754421_3776271644659064315_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZnTgpzaznoQ7kNvwFFyX9K&_nc_oc=Adk2PGJzoJ-9gQl5KtoelfWlnugHoP2Pq3c7MwT3clVlwpSd5DUQVUI5GKG1SQc7kd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuHSdx8cSctvfYQbhVArrfzUgOsim0DMoYAASYcQE5S4Q&oe=69A83E16"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Ink Party", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}
771-25/473391889_1337212340813946_9129971569962884707_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R-pnjDqfigQ7kNvwFS6aZ5&_nc_oc=Adn69oREhdCyqjDeoYHSYUDe0gVwzQCwr2j37OmpyWjzq9F0Y1MaVmhAOfrN5mjTs68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT7c25PAyu1rJQLg9D0k74gXgajlc1z40jYjmaplXVxQ&oe=69AD876D"}, {"file_name": "com.oculus.vrshell-20250324-155118.png", "id": "1731803624429578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393752_1731803627762911_6455060953460563439_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bknQqxd7q4YQ7kNvwFZRZO8&_nc_oc=Adn4CA_83lQrTuAShnsmMcaEZX-7dddfd5ibqDXOKwdq7drDcRynF3Qiv3CwcVF5ACg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf0xOkK8osFquWg1RQOVgKaciqU13RD6sW6JtyV9wqig&oe=69AD7766"}, {"file_name": "com.oculus.vrshell-20250324-155309.png", "id": "1453787232252421", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1453787235585754_9124498965573823185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRdcONI1ay8Q7kNvwEIlyue&_nc_oc=Adn0aT1j7V_eP-_O_8ibI3bBumIZIVwZ2Ckife7svhWANpRM3BURq1Jxg07qwmFvMcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjErfFu7WN8LcyQ5Yw66GyseptHgHUrQRHXng-zR5SJA&oe=69AD58D1"}, {"file_name": "com.oculus.vrshell-20250324-155349.png", "id": "2079445592527158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_2079445595860491_2028458573256282914_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMnR_D_sgm8Q7kNvwH13gUG&_nc_oc=AdnRNlQCD2BOwa1uAXkZ_WeGu_lqE1amJUolc60TBVREJw1bi4aexbXf7DWX7hSSeF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwbc7JUxAH-8aweSszrEXpEMV-A8W-EEjbd9X7bXajAtA&oe=69AD718B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u8bbe\u8ba1\u6e38\u620f\u56fe\u6807 (6) (1).png", "id": "1017544210308768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1017544213642101_3256962725665488887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw2BY_bIUXAQ7kNvwGHAoV6&_nc_oc=AdnZALYdZxTY_gEXpGVSY4ZG7ouqbKP5D7f7MzH40O850jmnvltHN37gBwx6NZLjNR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNJ3p7pt-JtXVhepe7484U8bTDX2W9Vu8zc5X1ruh4Kg&oe=69AD7AFA"}, "display_name": "Zen Ink Party", "keywords": ["party", "game", "ink", "climbing", "art"], "long_description": "ZenInkParty: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nCore Gameplay\nBattle, climb, and explore through three handcrafted VR challenges set in a breathtaking ink-wash universe where mountains bleed into clouds and cranes dance like calligraphy strokes:\n\nCliff of Whispering Winds\nGrip your way up ever-changing rockfaces using VR motion controls, where crumbling ink-stone holds force strategic leaps.\n\nHammer & Vermin\nWield a giant (zh\u00f9ti\u011b, cast iron) hammer to smash mischievous ink-rats bursting from rice paper screens.    \n\nSongbird Sanctuary\nLoad a bamboo slingshot to shoot clay pellets at phantom sparrows terrorizing a Zen garden.\n\nSecrets in the Scroll\nDiscover two (j\u012bgu\u0101n, mechanical puzzles) to unlock:\n\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges (e.g., \"Most rats smashed in 60 seconds\")\n\n\nAdaptive grip mechanics for immersive weapon handling\n\nSpatial audio reacts to environment (e.g., climbing winds intensify with height)\n\nFuture Horizons\nLaunching with 3 core stages + 2 secret realms, with quarterly updates adding:\n\nNew\u673a\u5173 puzzles (tea ceremony balance challenge confirmed)\n\nSeasonal variants (snowy mountain climb, cherry blossom slingshot arena)\n\nExpanded avatar customization using historic Chinese dyes\n\nWhy Players Love It\n\"Finally, a VR party game where beauty and chaos share the same brushstroke.\"\n\u2013 Beta tester review", "short_description": "Zen Ink Party: VR Adventures in a Living Scroll\nUnsheathe your controllers\u2014an ancient (shu\u01d0m\u00f2) world awaits your touch.\n\nLet's party !\nHost 2-16 player sessions where avatars in flowing Hanfu :\nCompete in leaderboard challenges"}]}, "developer_name": "LeoPardVR Studio", "developer_privacy_policy_url": "https://github.com/LEOsangMO/-ZenInkPartyPrivacyPolicy/blob/main/ZenInkParty%20Policy", "developer_terms_of_service_url": null, "publisher_name": "LeoPardVR Studio", "support_website_url": null, "website_url": "http://www.zeninkparty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9287246361352576"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391960_2233080573754421_3776271644659064315_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkRVZ8vLzOoQ7kNvwG2GJSt&_nc_oc=Adl_GzLr_TCwhbZVEL0MdPtojwjQRsBBxmB6mwK-t_FoVfS9-9KkK1ZG3r4iaZtrd_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVfF3LPHa3Ptoi--n0oL1tgjC6fdnFWI9XNYFEO7t_1Q&oe=69AD8416"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Ink Party", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}
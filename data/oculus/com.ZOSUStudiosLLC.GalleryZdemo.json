yc4rufLlE60-A4MX8gzKacn-I8_5zyB3YYobqMnP7HU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziD5ZNoF7eC5Of-jLdIZ6dDOZXlI8o2AV8YGhFexBifg&oe=69CE6A6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "darkscreen4.png", "id": "479696827019627", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_479696830352960_5549907941080741188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA4pBNhEPigQ7kNvwFFmPDU&_nc_oc=AdqYxnL2nETleRgJ_Ot6FfasLjENaY10dH58-cg3_hQfLSiuMNcYIeqiqcdYKVlfuK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4fI4pJPiTfiL_YWqxAfr1bgKiKv1RPrEBUGpIx0EXUQ&oe=69CE7A82"}, "display_name": "ZOSU Castle Morgue Escape Demo", "keywords": [], "long_description": "Demo of \"ZOSU Castle Morgue Escape\"\n- You awaken in a dark and spooky castle that was being used as morgue after a pandemic and must find your way out through a series of simple puzzles and mechanics, it is very dark, but fortunately you have a flashlight\n- This is a casual and somewhat scary escape-room/area type of game\n- Some events are slightly randomized for replay ability\n- 2 game modes: \n1)  3.5 minute demo time limit in the dark mode\n2) Exploration mode with puzzles off, light on, and no timer\n", "short_description": "- You awaken in a dark and spooky castle that was being used as morgue after a pandemic and must find your way out through a series of simple puzzles and mechanics, it is very dark, but fortunately you have a flashlight\n- This is a casual and somewhat scary escape-room/area type of game- 2 game modes: \n1)  3.5 minute demo time limit in the dark mode\n(full game has no time limit and an extra game mode with extra timed visual hints)\n2) Exploration mode with puzzles off, light on, and no timer\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_
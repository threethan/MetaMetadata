eI7oBZmftpOh-VRQjKKWGhP49AkVkz1Q2EstPfSu-9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IpAFhFnEHjmyV2avUl6Wg-M2LdZmhvNH8WouPUgUDmw&oe=69FC8EEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "darkscreen4.png", "id": "479696827019627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_479696830352960_5549907941080741188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpwP1xp5-pcQ7kNvwFlva9a&_nc_oc=AdpOOVeH2O0izjN2UG1usFR-QfPWbAJuEx5GlAkuPE-rV_KXscrJ1eBDsT8NSX5whuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sRYuIBneCMG6r_xzcd2t3-6QtZI20CpR-_T4jjT0Q-A&oe=69FC9F02"}, "display_name": "ZOSU Castle Morgue Escape Demo", "keywords": [], "long_description": "Demo of \"ZOSU Castle Morgue Escape\"\n- You awaken in a dark and spooky castle that was being used as morgue after a pandemic and must find your way out through a series of simple puzzles and mechanics, it is very dark, but fortunately you have a flashlight\n- This is a casual and somewhat scary escape-room/area type of game\n- Some events are slightly randomized for replay ability\n- 2 game modes: \n1)  3.5 minute demo time limit in the dark mode\n2) Exploration mode with puzzles off, light on, and no timer\n", "short_description": "- You awaken in a dark and spooky castle that was being used as morgue after a pandemic and must find your way out through a series of simple puzzles and mechanics, it is very dark, but fortunately you have a flashlight\n- This is a casual and somewhat scary escape-room/area type of game- 2 game modes: \n1)  3.5 minute demo time limit in the dark mode\n(full game has no time limit and an extra game mode with extra timed visual hints)\n2) Exploration mode with puzzles off, light on, and no timer\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_
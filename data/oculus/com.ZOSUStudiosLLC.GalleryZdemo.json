07941080741188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f88ifhsHvwQ7kNvwH8va4f&_nc_oc=Adqhy79xSCsZ2pwubYpS8mPTuffVXikZc0xk_LxiUTEN5e2wVrL40E-uQNCMBlBePps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1xRLSu_5maKfil_Wo32lFWM20imCuG6LzKCIurfoX0w&oe=6A9EC782"}, "display_name": "ZOSU Castle Morgue Escape Demo", "keywords": [], "long_description": "Demo of \"ZOSU Castle Morgue Escape\"\n- You awaken in a dark and spooky castle that was being used as morgue after a pandemic and must find your way out through a series of simple puzzles and mechanics, it is very dark, but fortunately you have a flashlight\n- This is a casual and somewhat scary escape-room/area type of game\n- Some events are slightly randomized for replay ability\n- 2 game modes: \n1)  3.5 minute demo time limit in the dark mode\n2) Exploration mode with puzzles off, light on, and no timer\n", "short_description": "- You awaken in a dark and spooky castle that was being used as morgue after a pandemic and must find your way out through a series of simple puzzles and mechanics, it is very dark, but fortunately you have a flashlight\n- This is a casual and somewhat scary escape-room/area type of game- 2 game modes: \n1)  3.5 minute demo time limit in the dark mode\n(full game has no time limit and an extra game mode with extra timed visual hints)\n2) Exploration mode with puzzles off, light on, and no timer\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "https://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "EXPLORATION", "PUZZ
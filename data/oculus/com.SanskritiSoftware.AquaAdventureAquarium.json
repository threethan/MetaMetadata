": "1477812352920736", "locale": "en_US", "screenshots": [{"file_name": "Shipwreck1.png", "id": "499686879225933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031484_499686882559266_9160463049980407071_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK6A1YD-72EQ7kNvwGE0e-K&_nc_oc=AdlybjUVu59xKnB77o6HDMBaO8ClRWai7tqaJ1gzlkapHsAwiZxlCMMRdpKJKkqrEZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxa3Cj_VdDR-0X58pG1QG51S-r_9C8Bed9UzAWZSzhh7A&oe=69B95824"}, {"file_name": "LandingHall2.png", "id": "1588857742066497", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_1588857745399830_763871961541924280_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKv-9NsxXNcQ7kNvwGDHjEt&_nc_oc=AdnR0nL1JfZ-ioadgrO-LPa4wMgxsvA0NKFXUihu6nNq3QHmyE7EaAnMK9dJoij2T4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzx85FD1g0gpIY4CrZoAQgk4VTfeN_p3DX7q2aCJNP7CQ&oe=69B93B17"}, {"file_name": "AbyssExplorerAdventure.png", "id": "1682142292327498", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982511_1682142295660831_5926867867162846141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zkhpJWfUu4Q7kNvwFD-MCd&_nc_oc=Adk4jqm8YXcqU42e7C9HJQLrIJGnMCg6bGAIyQT21AGZ6a2uT3fgz-a-zsU1f-2samI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyz4w2HpbLtlrcgRyJ-zvdS59hgAQ8ffQzgWld1EXORJQ&oe=69B9336E"}, {"file_name": "LandingHallUploaded.png", "id": "8328920843836777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_8328920850503443_5824309639553317778_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cs6OApSFEDAQ7kNvwGEZmS8&_nc_oc=AdlYkgiUiU-UTnw3w76ZgYlhBEciWy8W0pDH9bfJf7lGocd8h29NAQdsTBNgguJoRNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwqsBMM7cp5q9rWcYr_UYNZJilGK5-TADdcMgVwOcPCsg&oe=69B951EF"}, {"file_name": "LandingHall3.png", "id": "829269906017334", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974795_829269909350667_6989487726579619340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8p5Ozsxk_8Q7kNvwHqiZtH&_nc_oc=Adnj9_yTVlTgGEfHzbEAjm_SS9Y3uvxaY6ohQFLEScVQYcNaSD-hAvnUSqH8fga1Ij0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwTAEXGGj2VxLAU6_Tob1szfLevBNfuWqgKk9fUrfUelw&oe=69B93C3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shipwreck1.png", "id": "461632456869271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035469_461632460202604_6305906705940527865_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNPSewyzANYQ7kNvwFZ_IQR&_nc_oc=AdmshlN388rCM2dEGprxAlMoBj-nRBrRoaGRv40TyMp1wHAo29kDXEJsFLGStfEF90M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzbKzUt4tJgc87y6R2FEVw0ahyRLqEfiFbitVQTS6Bbog&oe=69B954F8"}, "display_name": "Aqua Adventure Aquarium", "keywords": ["Aquarium", "Nimo", "Fish", "Sea", "Adventure"], "long_description": "\n**Dive into the Enchanting World of Fish and Sea Creatures at Aqua Adventure Aquarium!** \n\nAre you an Adventure Seeker, Sea Enthusiast, or Casual Observer? Aqua Adventure Aquarium has something for everyone!\n\n**Discover and Explore:**\n-\t**Over 50 Sea Creatures:** Walk around and marvel at 3D models of dolphins, sharks, octopuses, clownfish, whales, and more. Learn fascinating facts about these incredible animals.\n-\t**Shipwreck Reef:** Visit this mysterious area where you might encounter gentle manta rays or come face-to-face with deadly sharks.\n-\t**Abyss Adventure Explorer:** Hold your breath and dive underwater in our Scuba Cart to explore uncharted territories.\n\n**What Aqua Adventure Aquarium Offers:**\n1.\t**3D Aquarium:** Five tanks filled with a variety of fish and sea creatures.\n2.\t**Shipwreck Reef:** Explore a shark-infested shipwreck.\n3.\t**Abyss Adventure Explorer:** Step aboard the Scuba Cart for an up-close encounter with reef and deep-sea creatures. Buckle up for a wild ride!\n", "short_description": "Dive into the Enchanting World of Sea Creatures at Aqua Adventure Aquarium!\n\nDiscover and Explore:\n\u2022\tOver 50 Sea Creatures: Walk around and marvel at 3D models of dolphins, sharks, octopuses, clownfish, whales, and more. \n\u2022\tShipwreck Reef: Visit this mysterious area where you might encounter gentle manta rays or come face-to-face with deadly sharks.\n\u2022\tAbyss Adventure Explorer: Hold your breath and dive underwater in our Scuba Cart to explore uncharted territories.\t"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sanskritisoftwareneha.azurewebsites.net/AquaAdventureAquariumPrivacy.html", "developer_terms_of_service_url": "https://sanskritisoftwareneha.azurewebsites.net/SanskritiSoftwareTOC.html", "publisher_name": "Sanskriti LLC", "support_website_url": "https://sanskritisoftwareneha.azurewebsites.net/About.html", "website_url": "https://sanskritisoftwareneha.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8552743358069029"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1445460393889878"}, {"status": "PUBLISHED", "id": "1408968000707652"}, {"status": "PUBLISHED", "id": "832257099352217"}, {"status": "PUBLISHED", "id": "1361894605553779"}, {"status": "PUBLISHED", "id": "1774387453492963"}, {"status": "PUBLISHED", "id": "1581311985890857"}, {"status": "PUBLISHED", "id": "1149939110146279"}, {"status": "CANCELLED", "id"
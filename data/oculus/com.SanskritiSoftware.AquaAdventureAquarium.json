": "1477812352920736", "locale": "en_US", "screenshots": [{"file_name": "Shipwreck1.png", "id": "499686879225933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031484_499686882559266_9160463049980407071_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sC9QxXyMWsQ7kNvwETHfPF&_nc_oc=AdkJ2CFal_fKf4puqgQL9Hymv-PLiIhCaP9Y2lmV6Ctn8QhQbYqYfvqmdCblgfhsiDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvF3GA6GurudnjNYPiuSGsKjY0QlMDVOf7NO9Szk-3S5w&oe=69A834A4"}, {"file_name": "LandingHall2.png", "id": "1588857742066497", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003276_1588857745399830_763871961541924280_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7OfNq1dv2AQ7kNvwH9xH3i&_nc_oc=AdmW_pg67YR_T4BoGeTxehTDOlfHVBD4OFQWd3d1vCOcS2hwk227xnlY1lpWnbWRXTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv_zx19xH5sU5LaVG700Ht6thqZcIOWUKWieuyuLRgmeQ&oe=69A81797"}, {"file_name": "AbyssExplorerAdventure.png", "id": "1682142292327498", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982511_1682142295660831_5926867867162846141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiFxBF6UaD0Q7kNvwGTfThb&_nc_oc=Adkk20XtD6VrKvu2-d1CgboeIL30rkYOJKdhRvjAH3AwUcZWF4IhZs13vTe3Nr3FMrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsF43ACyxOvl6iIR1Q48qwF0h3s1cxr07jggxi6yFHpgw&oe=69A80FEE"}, {"file_name": "LandingHallUploaded.png", "id": "8328920843836777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_8328920850503443_5824309639553317778_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnakjNRLCGMQ7kNvwHVwKmH&_nc_oc=AdnhXqWWtn9SMeUDu27ECVOG5y0w06nLZh4m9uKehJSgqajsyPHMZc_eQBXDNwpTOqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsHxEoR86ifnjNyiIX8sMY8VqiEhCoTLF2GKew0bYMkDQ&oe=69A82E6F"}, {"file_name": "LandingHall3.png", "id": "829269906017334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974795_829269909350667_6989487726579619340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCcC2NkRZ1QQ7kNvwHBnoeX&_nc_oc=AdnLLyWHpexCYf8-IqqWZyXjRtIu8H4DM8m6s69I4xj9q-EszjdhAbvQjkFm4llvJXQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsq9c63xpNDdM6a8gTtNqzjtMlONZAlW2yN2J4K4aJUHw&oe=69A818BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shipwreck1.png", "id": "461632456869271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035469_461632460202604_6305906705940527865_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tnOKJZgh-QQ7kNvwEZ3H1P&_nc_oc=AdnK91lk4kfy4fZagt5HAMmx54KfFz-0QbRu2alRYgJ9j14hB4tcp329LxTFh2kylMs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftiEStYS1FG-O1AzFtmNahfbPHPj_pXYKtVlzxJKJ_8wQ&oe=69A83178"}, "display_name": "Aqua Adventure Aquarium", "keywords": ["Aquarium", "Nimo", "Fish", "Sea", "Adventure"], "long_description": "\n**Dive into the Enchanting World of Fish and Sea Creatures at Aqua Adventure Aquarium!** \n\nAre you an Adventure Seeker, Sea Enthusiast, or Casual Observer? Aqua Adventure Aquarium has something for everyone!\n\n**Discover and Explore:**\n-\t**Over 50 Sea Creatures:** Walk around and marvel at 3D models of dolphins, sharks, octopuses, clownfish, whales, and more. Learn fascinating facts about these incredible animals.\n-\t**Shipwreck Reef:** Visit this mysterious area where you might encounter gentle manta rays or come face-to-face with deadly sharks.\n-\t**Abyss Adventure Explorer:** Hold your breath and dive underwater in our Scuba Cart to explore uncharted territories.\n\n**What Aqua Adventure Aquarium Offers:**\n1.\t**3D Aquarium:** Five tanks filled with a variety of fish and sea creatures.\n2.\t**Shipwreck Reef:** Explore a shark-infested shipwreck.\n3.\t**Abyss Adventure Explorer:** Step aboard the Scuba Cart for an up-close encounter with reef and deep-sea creatures. Buckle up for a wild ride!\n", "short_description": "Dive into the Enchanting World of Sea Creatures at Aqua Adventure Aquarium!\n\nDiscover and Explore:\n\u2022\tOver 50 Sea Creatures: Walk around and marvel at 3D models of dolphins, sharks, octopuses, clownfish, whales, and more. \n\u2022\tShipwreck Reef: Visit this mysterious area where you might encounter gentle manta rays or come face-to-face with deadly sharks.\n\u2022\tAbyss Adventure Explorer: Hold your breath and dive underwater in our Scuba Cart to explore uncharted territories.\t"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sanskritisoftwareneha.azurewebsites.net/AquaAdventureAquariumPrivacy.html", "developer_terms_of_service_url": "https://sanskritisoftwareneha.azurewebsites.net/SanskritiSoftwareTOC.html", "publisher_name": "Sanskriti LLC", "support_website_url": "https://sanskritisoftwareneha.azurewebsites.net/About.html", "website_url": "https://sanskritisoftwareneha.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8552743358069029"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1445460393889878"}, {"status": "PUBLISHED", "id": "1408968000707652"}, {"status": "PUBLISHED", "id": "832257099352217"}, {"status": "PUBLISHED", "id": "1361894605553779"}, {"status": "PUBLISHED", "id": "1774387453492963"}, {"status": "PUBLISHED", "id": "1581311985890857"}, {"status": "PUBLISHED", "id": "1149939110146279"}, {"status": "CANCELLED", "id"
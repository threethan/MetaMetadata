": "1477812352920736", "locale": "en_US", "screenshots": [{"file_name": "Shipwreck1.png", "id": "499686879225933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031484_499686882559266_9160463049980407071_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLFdEAk_9scQ7kNvwH3fgzg&_nc_oc=AdnP3r0IKjzmliiOlUShiEXnF1wboxHQC0LghK5o1zQaXfPZxD6M2Yez-HclkYrDoqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyOwa6hJgyOg0cSnyRRPZgjYTVZzN0CG-Sw-S-sTIybA&oe=69AC2924"}, {"file_name": "LandingHall2.png", "id": "1588857742066497", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_1588857745399830_763871961541924280_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adu9SHG9bhIQ7kNvwH2niZ8&_nc_oc=Adkbyf32oqKYrGeMEE0N65G42dz8dxWrlhk8pVjjvHJt-aApeObQeMSzTXaA-74vTzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxt9IJ9iM7_VAbVb8JbLZkfxX76XMPF08qaYpPNN6EiQA&oe=69AC0C17"}, {"file_name": "AbyssExplorerAdventure.png", "id": "1682142292327498", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_1682142295660831_5926867867162846141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CJMx6hI81AQ7kNvwF4oRvN&_nc_oc=AdmoHVwgFAxRsJ_1GG3MtIAuny1sfWnOfxb3_33AdBaV7gLNvayMt5we_h9pdLYdxY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwl2B7zZ7ktLAXEeXmlI36osdabs5mWIfXel8p5Ddabww&oe=69AC046E"}, {"file_name": "LandingHallUploaded.png", "id": "8328920843836777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_8328920850503443_5824309639553317778_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2umAMTDResQ7kNvwE3zbli&_nc_oc=AdkbPrSdH8JBh1ATdj8zbqYTls5GlE2n2p3iFMd-qKkLS0TQxdBsXcbHgZ2U0W8f2us&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzB74egwSvabisHl32NumL2i-Hr9mQZNgnfIoFkYr3QhA&oe=69AC22EF"}, {"file_name": "LandingHall3.png", "id": "829269906017334", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974795_829269909350667_6989487726579619340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-UKCqkJjpUQ7kNvwEWPbYo&_nc_oc=Adn-n5CKywwwn8J1f5eiZ1-F5U-BgHtDG3uFgSK8e6o0CFGTRsavKbmi2b1NUYIz2ag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0v7xw9T6x2TfNU5k4g_EYX6ltHgzWh_5n0rcpD4eTWg&oe=69AC0D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shipwreck1.png", "id": "461632456869271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035469_461632460202604_6305906705940527865_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTpOpOiqEc8Q7kNvwGL_umP&_nc_oc=AdnBq8By3BtSCWcJ_DRxrNcM5__Re0lZt9kQXG1id3OddgAjxWdhoRCBDez5Cz_iV_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwu3-_i_bUiS3gpnHq8VO39Txz39tsXUKIadylrD_Yk0g&oe=69AC25F8"}, "display_name": "Aqua Adventure Aquarium", "keywords": ["Aquarium", "Nimo", "Fish", "Sea", "Adventure"], "long_description": "\n**Dive into the Enchanting World of Fish and Sea Creatures at Aqua Adventure Aquarium!** \n\nAre you an Adventure Seeker, Sea Enthusiast, or Casual Observer? Aqua Adventure Aquarium has something for everyone!\n\n**Discover and Explore:**\n-\t**Over 50 Sea Creatures:** Walk around and marvel at 3D models of dolphins, sharks, octopuses, clownfish, whales, and more. Learn fascinating facts about these incredible animals.\n-\t**Shipwreck Reef:** Visit this mysterious area where you might encounter gentle manta rays or come face-to-face with deadly sharks.\n-\t**Abyss Adventure Explorer:** Hold your breath and dive underwater in our Scuba Cart to explore uncharted territories.\n\n**What Aqua Adventure Aquarium Offers:**\n1.\t**3D Aquarium:** Five tanks filled with a variety of fish and sea creatures.\n2.\t**Shipwreck Reef:** Explore a shark-infested shipwreck.\n3.\t**Abyss Adventure Explorer:** Step aboard the Scuba Cart for an up-close encounter with reef and deep-sea creatures. Buckle up for a wild ride!\n", "short_description": "Dive into the Enchanting World of Sea Creatures at Aqua Adventure Aquarium!\n\nDiscover and Explore:\n\u2022\tOver 50 Sea Creatures: Walk around and marvel at 3D models of dolphins, sharks, octopuses, clownfish, whales, and more. \n\u2022\tShipwreck Reef: Visit this mysterious area where you might encounter gentle manta rays or come face-to-face with deadly sharks.\n\u2022\tAbyss Adventure Explorer: Hold your breath and dive underwater in our Scuba Cart to explore uncharted territories.\t"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sanskritisoftwareneha.azurewebsites.net/AquaAdventureAquariumPrivacy.html", "developer_terms_of_service_url": "https://sanskritisoftwareneha.azurewebsites.net/SanskritiSoftwareTOC.html", "publisher_name": "Sanskriti LLC", "support_website_url": "https://sanskritisoftwareneha.azurewebsites.net/About.html", "website_url": "https://sanskritisoftwareneha.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8552743358069029"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1445460393889878"}, {"status": "PUBLISHED", "id": "1408968000707652"}, {"status": "PUBLISHED", "id": "832257099352217"}, {"status": "PUBLISHED", "id": "1361894605553779"}, {"status": "PUBLISHED", "id": "1774387453492963"}, {"status": "PUBLISHED", "id": "1581311985890857"}, {"status": "PUBLISHED", "id": "1149939110146279"}, {"status": "CANCELLED", "id"
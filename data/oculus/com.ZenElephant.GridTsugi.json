6", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820574_1106981071063299_2197925056157474590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxUXmIV5_jQQ7kNvwGCMjOg&_nc_oc=AdrIHMFlcgYUh4sckX7by409a0keRCB0tl8HgPHI934W8sUV2IDH1wz_OAovx6O0HEI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgeZgvqOWRbmhIRG-3fGdnKcr0ySPCc4zro70bj-z_BQ&oe=6AD0DBE4"}]}, "id": "4625772717746471", "locale": "en_US", "screenshots": [{"file_name": "screenshot_04.png", "id": "4541231462759651", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628456_4541231469426317_2819465230772260294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHfHin2NyTAQ7kNvwHQmIhb&_nc_oc=AdqXMUuimbDvWNeyh-iHN_PGjGKegTnnUmGnc8sRvtypWBikSLMYBCeN84-sslv6pPo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCvahJlNygC1qyVjHNKObTHcNi0a1CrJG3jPYwTmtPxQ&oe=6AD0DEDF"}, {"file_name": "screenshot_05.png", "id": "1622684176301236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623585_1622684182967902_7512470868757646834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNek1KPxbYsQ7kNvwF-u88x&_nc_oc=Adr2ayxyKZZlASoZwGdHuJuLCXsialVDVjf80IJpvxyOE8Xe1E66VJUrqiixDsghsaM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxLZf_dXFUq32brU0Anw0_opgTkAIe3M6Vsc1vL3Sgww&oe=6AD0D8E8"}, {"file_name": "screenshot_05 (1).png", "id": "2328842851249108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628447_2328842854582441_333859088209898254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55-lKVWRRGgQ7kNvwFglSe8&_nc_oc=AdprgmFVPLiLpGwfHo8XF9v_Rrksdr7RBnGSvXvn6Mu5JOuDGwnERjuB5vwyvujxihE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL3n4dyoybOGnLBKq9v3DXO8XN4w3SPspEPUpFNzY_Bg&oe=6AD0E340"}, {"file_name": "screenshot_01.png", "id": "2421664005264429", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620532_2421664015264428_23257912880260569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZNStZFLgpQQ7kNvwEMfvt_&_nc_oc=Adqykt1YvewnHp-svbqL9HciPpro1cLVD5UGffTD-IK61rIyA-lYIBTcZ6bMDW1pTiw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND8WQVNkIDW5SVKCnwLzWi2_VxcPQes7gMP5uz79pPhQ&oe=6AD0DC4C"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVT8ooAT2lUQ7kNvwFbPoSo&_nc_oc=AdpqNWFqRGz6DcOly88tXbIuHPSs5iniAMUJLRGeZxc4Q1a01iY23O52bSFDSI6K9lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIhy6ng9XCYc_Nt8djQDtIXO6DjHD5JEWXWYZ7xfkp2w&oe=6AD0E15F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdspiS3uTNoQ7kNvwFX1Utj&_nc_oc=AdptjZdcunt3I0V3tCxo5qhim-B_TKu3YzdpxKIdI8dk1PWVOmpqjBpuywGbaCNT4jA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvDrxXFvv5bI2SoVjOWGyHXacsJgFQGs0003HGExsCOQ&oe=6AD0D4BE"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28910293798608173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFHrkJtN0MwQ7kNvwGidSvu&_nc_oc=AdrXHeNRN4B4Hdim9U-9tYnSFx3vICYScC2spaoqrGE8lZ
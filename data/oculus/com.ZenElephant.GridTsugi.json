oculuscdn.com/v/t64.5771-25/499619594_1246318130565048_5610258775523403073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3RS5nNbQ4kQ7kNvwFPlmIO&_nc_oc=AdpfMACvgI_YmMBMdT6ECur3rDXrChD0AhWW2LwjkS2NR-ZwodUWXOqpkQFVdjvf2OA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6eVJ0c7orVZe3pf46NXaeycjIk_YUrDQCv4f4b6RhKQ&oe=6AAEA1AD"}, {"file_name": "14.png", "id": "1527800441913081", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499617847_1527800445246414_2947654254938259878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkvpeeqbeXgQ7kNvwEXqxGF&_nc_oc=Adr5bUF6t1oy42faU-bpGnDuh4wzt6uWhcKUilXwU9Voc-a8VnVKz4njSa7KYi25Tx0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEt81pV6XZEKuLkWYWYWwPU0HcsjV4VkR45xSWEzlZDw&oe=6AAE9343"}, {"file_name": "13.png", "id": "783545940853635", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_783545944186968_1919964374083555883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REOuvxyEb84Q7kNvwGZoPeN&_nc_oc=Adr-aOS_xj7d7MkYAJKJ1F5ArDdHDPq0MYOfyFqQKXl7Aw_p66HtHmf-Z0s4FydyTew&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLdaecxCtsTdQy5n679jTExeeBBVMoRjTDWwW3cdk4GA&oe=6AAE8B2B"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKuJtzYx6MMQ7kNvwH-AkKO&_nc_oc=Adp6akPKTZu0bKeTFax0SX16ZuEOvLYZjsEyaDIubxtKfAfGxT88fU8iOP0qfhYuEqc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlslW-C7HVo_2aVObjc2HPUT7rsKiTf62kXzGRJdKhdg&oe=6AAE9A5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bill.png", "id": "2159435804565949", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820566_2159435807899282_6248702263933543711_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOBJ3wR8BD4Q7kNvwHWBzpq&_nc_oc=AdrtO_VETCHQYUkBcfZVbYRej854NK1D5J_JM9TsrSgEF9hPio-rx8Z-impEHdyicGQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8bMSJfaaDiAl3_MrcdtQfkeYEbdRIVID-GN_i2b_KJw&oe=6AAE8E44"}, "display_name": "GridTsugi", "keywords": [], "long_description": "## GridTsugi: Maze of Woven Bridges  \n\nStep into a *cozy mixed-reality puzzle world* where you connect floating islands with magical bridges. Put your *logic, patience, and creativity* to the test as you solve puzzles that are equal parts relaxing and brain-teasing.  \n\n###  Features  \n- \ud83c\udfdd *Endless logic puzzles* that adapt to your playstyle  \n- \ud83c\udf10 *Multi-language support* (English, Spanish, Chinese, Japanese, Korean, and more)  \n- \ud83c\udfa8 *Pixar-inspired hand-painted art style* for a warm, inviting feel  \n- \ud83d\udce6 *Spatial anchor integration* for cozy room placement in mixed reality  \n\n### \ud83e\udde9 Gameplay  \nEach numbered island tells you exactly how many bridges it must connect with. The challenge? Only certain paths are possible, and the puzzle can\u2019t be completed without careful *logical planning*.  \n\nWhat starts as a simple challenge quickly transforms into an *addictive brain teaser* that rewards focus, strategy, and creativity.  \n\n> *Relaxing, cozy, and endlessly challenging for puzzle lovers everywhere.*\n\n# Get involved and join our Discord: https://discord.gg/6hvkBCn6gj", "short_description": "GridTsugi : A Cozy Logical Puzzle of Woven Bridges\n\nRelax and challenge your mind in GridTsugi, a beautifully crafted mixed-reality puzzle game where you build a maze of woven bridges between charming little islands. Designed for calm thinking and logical satisfaction, GridTsugi blends cozy aesthetics with deeply satisfying logic mechanics. It\u2019s not just about solving puzzle. it's about weaving connection and clarity.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_nam
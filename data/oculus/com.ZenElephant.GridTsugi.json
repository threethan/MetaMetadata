scdn.com/v/t64.5771-25/499619594_1246318130565048_5610258775523403073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kKISM4B-PwQ7kNvwFzyROa&_nc_oc=AdopFaLruaFvSrksSVrYFJAkWtXVsp_NYSYHBlRGbEGLLO1au5ISUr75MbfFanHh-vQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpLh2KSzCeMBGbYYgLgIWoIPGTClh-SZG_P9nN0YXcvA&oe=6AA2C42D"}, {"file_name": "14.png", "id": "1527800441913081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617847_1527800445246414_2947654254938259878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox76QjSovjMQ7kNvwGlZgFM&_nc_oc=Adr40u1nBjRTeynngHEM4utIzsCoR-8ybaEeVtyM6aq8iacx8SKNalg8j4DFoyWQGtI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUdm4hOagazwxUikdP-y6cXkaSf6z4XCXVo1evTD0x2g&oe=6AA2B5C3"}, {"file_name": "13.png", "id": "783545940853635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_783545944186968_1919964374083555883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEEvG6_UDRoQ7kNvwGovrnc&_nc_oc=AdoEllj_OMQA6nTOs5Yv_OYAjnjRGcscHu6HPe4gVpMqtgDK_2foKTeME0gMgrqNONg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh1agP2dxQaEiw-P9LCRjOWZywP8n-U4ORvk9BdwDuUQ&oe=6AA2ADAB"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1YHZgZg0TAQ7kNvwFyhyD5&_nc_oc=Adpy4UpeUD8X8cwnflpWxtwuWhgYa3GfrjuWC-qv91jsblwzHFt7zdVAt_jV3BOizXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRkdl8p8XRZ2Q87gpn8YO7H63t6u0pdFmAUqWt-ApGTg&oe=6AA2BCDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bill.png", "id": "2159435804565949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820566_2159435807899282_6248702263933543711_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6WxJ5oPe98Q7kNvwG_K9Dp&_nc_oc=Adoml0M2BbrwBnwocITlJScJ65Tcb91rEAXnw8V72axj0S25wYcVCl8jaS63Zss1I9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa2QsCHnn6gJxNrBh9-mrYHdbJ9Or9ZzXtF964EeNk1g&oe=6AA2B0C4"}, "display_name": "GridTsugi", "keywords": [], "long_description": "## GridTsugi: Maze of Woven Bridges  \n\nStep into a *cozy mixed-reality puzzle world* where you connect floating islands with magical bridges. Put your *logic, patience, and creativity* to the test as you solve puzzles that are equal parts relaxing and brain-teasing.  \n\n###  Features  \n- \ud83c\udfdd *Endless logic puzzles* that adapt to your playstyle  \n- \ud83c\udf10 *Multi-language support* (English, Spanish, Chinese, Japanese, Korean, and more)  \n- \ud83c\udfa8 *Pixar-inspired hand-painted art style* for a warm, inviting feel  \n- \ud83d\udce6 *Spatial anchor integration* for cozy room placement in mixed reality  \n\n### \ud83e\udde9 Gameplay  \nEach numbered island tells you exactly how many bridges it must connect with. The challenge? Only certain paths are possible, and the puzzle can\u2019t be completed without careful *logical planning*.  \n\nWhat starts as a simple challenge quickly transforms into an *addictive brain teaser* that rewards focus, strategy, and creativity.  \n\n> *Relaxing, cozy, and endlessly challenging for puzzle lovers everywhere.*\n\n# Get involved and join our Discord: https://discord.gg/6hvkBCn6gj", "short_description": "GridTsugi : A Cozy Logical Puzzle of Woven Bridges\n\nRelax and challenge your mind in GridTsugi, a beautifully crafted mixed-reality puzzle game where you build a maze of woven bridges between charming little islands. Designed for calm thinking and logical satisfaction, GridTsugi blends cozy aesthetics with deeply satisfying logic mechanics. It\u2019s not just about solving puzzle. it's about weaving connection and clarity.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24695322420105353"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1356670202680111"}, {"status": "PUBLISHED", "id": "1536471428132939"}, {"status": "PUBLISHED", "id": "2330327287479733"}, {"status": "PUBLISHED", "id": "1208800693909899"}, {"status": "PUBLISHED", "id": "874062371820244"}, {"status": "CANCELLED", "id": "708752878556367"}, {"status": "CANCELLED", "id": "1833755053927139"}, {"status": "PUBLISHED", "id": "1150193973935326"}, {"status": "PUBLISHED", "id": "664594682780081"}, {"status": "PUBLISHED", "id": "778073677987873"}]}, "baseline_offer": {"id": "778073677987873"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786647600, "status": "PUBLISHED", "id": "1356670202680111"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25521698807467706", "version": "1.0"}, "id": "734829259154167", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24299528839684715", "is_con
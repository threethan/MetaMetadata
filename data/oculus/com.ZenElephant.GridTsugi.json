kNvwGvM6yT&_nc_oc=AdodtcXvtn2cBXSdGoLhqA6LwIw25Z9CESd0JiRR33qtgD4zcs-KSkEORR00yy1CuJU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE6Nka3zfCtJdWNTzxjr8XDhCeVQF6BNwlBXV8EJL4Bg&oe=6A81B82B"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-1NIycJRNgQ7kNvwEmu9v0&_nc_oc=AdpuK8RRBxX895Fnb4rUveCXnb9CGWP1gFURnlY9fU51s34U7dtRR08GScnKLjauG8E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2RltYYPMLtBO8tV6mJMY9LslQEpGD8RwvKNJ-QdaXsA&oe=6A818F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqT6iZajKxgQ7kNvwG6j0lx&_nc_oc=AdrSfCHQEUybkQSj3VZH35jER5pZBoZD6LlVAMWdtdZKUGxj54J-ZxSboYa-objoom4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPQBhdYLqArK5Np4IrT-uhvK9z3K_0yh4mvvuBwhLAlA&oe=6A81BABE"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25426106017026986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-85GVHQiQB0Q7kNvwGcQNYi&_nc_oc=AdouScyFRTWW02grFBCBFGmxzv-vxJWkB4jynKDlcTlsWyOkwyWd_6RVaAoN9DdOb3Q&_nc_zt=3&_nc_ht=scontent-fr
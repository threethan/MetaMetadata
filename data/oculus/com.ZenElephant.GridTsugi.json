6", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820574_1106981071063299_2197925056157474590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxUXmIV5_jQQ7kNvwHiPbFh&_nc_oc=Ado-FdprxoUEzi9_F8tho9QE5VlBNcjzKV9pqnSL9V6YAc1rwwDWa1nOqCWMeqh6Q0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcQ04XOyPQ4V6Alt_oP-jM7L49XxrFrjuNuXbpfONrUw&oe=6ACF8A64"}]}, "id": "4625772717746471", "locale": "en_US", "screenshots": [{"file_name": "screenshot_04.png", "id": "4541231462759651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628456_4541231469426317_2819465230772260294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhM10ldIq9YQ7kNvwHO59aX&_nc_oc=Adp5CM0Ik5Kh8MbVMIFpNVQezjjE1apT39Gv3dCI2sUhyP3MlhlvIktRbyyTe0er3PM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN17gvkyEZxIdEHqs36FTJxxq22e95YftiEdfvUE3Mhww&oe=6ACF8D5F"}, {"file_name": "screenshot_05.png", "id": "1622684176301236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623585_1622684182967902_7512470868757646834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNek1KPxbYsQ7kNvwGLce4v&_nc_oc=Adpf_l5EyRVijPNIxmlVFmmC0yALEiynq9130lbwcBeBMeIjhAbqA7X3W-8Zbb107H8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn4FKHvdOSwMERi7cg6V_gsnDVtk-TTJYUzj0K8J3CGA&oe=6ACF8768"}, {"file_name": "screenshot_05 (1).png", "id": "2328842851249108", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628447_2328842854582441_333859088209898254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeeWtyLG2H0Q7kNvwG9V2y2&_nc_oc=AdphVIN7cvFQmCJnyfHKlB-cyrpRyK5q4tKa3c9KDLLC7w1j2VuwgrL2Kg6zI2CHv38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZuKjnsrM_px70-YCu9XhTlVqJzYLQyciizvuSv43ERg&oe=6ACF91C0"}, {"file_name": "screenshot_01.png", "id": "2421664005264429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620532_2421664015264428_23257912880260569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZNStZFLgpQQ7kNvwG_hRXD&_nc_oc=Ado4An0T5uSlXPGLkVKUt838oKW_2nVdpghGc-UZqo2Ra19tXaGqBPcy6XE30m4kFMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAzN5C4c45wuWszWanHUukEMjCaoxNwJ9-zJd2jILNSA&oe=6ACF8ACC"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i86rH-p1H8MQ7kNvwHG4Zeg&_nc_oc=Adr66k_V9GWkgeaEqi060zz5UPmVW9T5CeKdGl-IGsst44DlzWROQ6tNwZeG0CizG4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu1k10IdCyy1SCs7a8vd8mYuokYTRIj50TSQ_XWK4_hA&oe=6ACF8FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdspiS3uTNoQ7kNvwHDGTz-&_nc_oc=AdqJJIMIZZUAQQ2b868h0spxw098lfWHdvpSd6043Nq62u8SXR6iR-K6c2McjReHL4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcrGGGnqwM0-PWMp22wLWR81KazP7gIHmZ30TB9Izeyw&oe=6ACF833E"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28910293798608173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFHrkJtN0MwQ7kNvwG6vwoV&_nc_oc=AdpBnm5F6oHxeCsahhbnoWp42jJx9WBYaAcSf1ekeFbsh9
6", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491820574_1106981071063299_2197925056157474590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hr4jZJnIagQ7kNvwFAburO&_nc_oc=AdoA_82w5uGMowz_ngT2Md7-R2CVdJzMRoSN37EnENq2rV3XR-odMQECaMwpoOfSh80&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPf3zTvp8P4QOCAFVJMhe8phZY4MVT8oa-EIT8wJFeEQ&oe=6A7DCD64"}]}, "id": "1152874566920315", "locale": "en_US", "screenshots": [{"file_name": "12.png", "id": "1246318127231715", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619594_1246318130565048_5610258775523403073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtJCdjEene4Q7kNvwEKPH9v&_nc_oc=AdoJDgRtxNFdO5R8slOqzfMV6QpkC4u2nrzbgXdMpar9aUSr3b7qgeDFKaUeIFccclc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbA-lVf_GA3o5uXG7i5OPjGRzEjvdYu5yjyO6maXg8rg&oe=6A7DA1ED"}, {"file_name": "11.png", "id": "1856758458236723", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618432_1856758461570056_7896927351997580334_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sD_BFbLIaIQ7kNvwFmhOY0&_nc_oc=AdqS64wR8TirAlUqCK9gpOx0uwEY3mXtNrijy7pFCIu_3w7dz9HswWpl1BEoKck1BTQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhoDh-Sfn08eilKQaSt_tpJZY84umR3RhKQ99NhjjbeQ&oe=6A7DB357"}, {"file_name": "14.png", "id": "1527800441913081", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499617847_1527800445246414_2947654254938259878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44Z474EC_E8Q7kNvwERDCUO&_nc_oc=Adomc8ZmZfU2pNeEKCCltzudbhM4hJXJHSQAm5RKNR-JIgL9Z3Yfvbf9k9OjMTQ8PwE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfoT-7ZpFdC2ZT4dqNBM6C-cDuDAGAzJ_umxrAuTOvRg&oe=6A7DCBC3"}, {"file_name": "13.png", "id": "783545940853635", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_783545944186968_1919964374083555883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKvnNaNTBRcQ7kNvwHuRphc&_nc_oc=Adq8WF12GSY_NrgvK4UqIP6P88alktuAouOS8CrNsJ8VgFqf8jD1Xf8DFBVh-y23Avs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpBDu3nyuHw_gbj3HSr__kaAGLnjPLw_EoK1OO0ISxqg&oe=6A7DC3AB"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pn0k6cdEccQ7kNvwFwgcf9&_nc_oc=AdqQJ8ftavQbbJMV-V--OX0vGSCJzMmZe0_8mHAHyrnCQEMHD06V3fEAN6PTUUgx9ds&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLUqRClYjGxqB8l7zoJLAQn1y3fNxCkBL0FFniEYsuYw&oe=6A7D9A9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBKgnBVVbRIQ7kNvwFWdQZU&_nc_oc=AdpAPJSOI8xRuLTkt9X7O6d7ajdwPGe8sP8j6DWmLIG01r5yMuCe14-w4q9aey130QQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH72fqo4Kre__cvg_odUHGU3H1WjTDm7DBk57RqV2Z6ag&oe=6A7DC63E"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25426106017026986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvwg0efNB5AQ7kNvwF1iTOq&_nc_oc=AdoP8nLFPAPgeGjeZrIkzVKwyq6-rtbaBxoT1pp9vuCyyBcuFhvPF70dM_bzTHr84Jo&_nc_zt=3&_nc_ht=scont
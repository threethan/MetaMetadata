9AvdQzWcsA0Q7kNvwFggq9H&_nc_oc=Adr7rTq2W0BjCFTp8_RJKueTM7CHC0Rkax0pb0mpuWpnR0wXJrGpBrgQymSdVrXJBX4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7zaQhRGEEJdaTCOeVncTSjg_-VzPiJPQyKuKbfpYOAA&oe=6A85ACAB"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ylpjk7QpB3oQ7kNvwGJulNr&_nc_oc=AdoPSTVss3zt2jb8swRPFnV6bqADV7GAoNFzBSwdY9T5TRYD7IJ5x4b5_0bmlW6oz4g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6hNwMIZAAN3DASXwNa26-TfwWE5T6fupJvpCbBoeGZg&oe=6A85839F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzHwZ2l0sXcQ7kNvwFPi0lI&_nc_oc=AdqMuNz9Upj7BRqd7DhQ4NH3bFklOF38GGbrnBySHibEThAW16qDbJk8CaKFgyDGgS0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrKc16zGnZqmb4IW_ibLI6IIZSxtmbWNmJEr69iEzO0w&oe=6A85AF3E"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25426106017026986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4JmpnDOwbUQ7kNvwHrXUmL&_nc_oc=AdqdXktFKNIflfNiaEY1P8VrSin2vLLe1gR0EX-RzcxDogv5ahvWpeDRRXmSojC0jIY&_nc_zt=3&_
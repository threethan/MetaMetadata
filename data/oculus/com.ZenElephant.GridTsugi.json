oculuscdn.com/v/t64.5771-25/499619594_1246318130565048_5610258775523403073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lo5Y7H413JUQ7kNvwGm0CEk&_nc_oc=AdoLNNzW1SmMMByDaFrnU_pU9W8VJ98_LN4nA5BX9YCc5xw8KE5yOTyQHZQMJ3GuFJg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI24_FkG1TBeC4OgEgQz-N-JSi8oBeLihJALa4hQB2uqg&oe=6AA415AD"}, {"file_name": "14.png", "id": "1527800441913081", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499617847_1527800445246414_2947654254938259878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q0De1HUAscQ7kNvwHjbyk1&_nc_oc=AdphRmfI8FqYhORNUDU3HeLhVmrPAFHCbg7ua-VC8o_20hobL3-P-hfgdbpqNSH6q8c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGKGUaHe2GM81rvXWYX7jNsX1oTeWG9-98vgFBTIgB9g&oe=6AA40743"}, {"file_name": "13.png", "id": "783545940853635", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_783545944186968_1919964374083555883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEEvG6_UDRoQ7kNvwFA8itz&_nc_oc=AdpgKSKRWIHHTC5vqeBxApaTTv6ZD-t3JWHzLGTrcJ3pfj2Y1YfVzbsstYUp-a33iGA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF7Gk6rRjKCFMQgRbx2fbT-hIBFSNajluT9vTXH9HjnA&oe=6AA3FF2B"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1YHZgZg0TAQ7kNvwHlrCNy&_nc_oc=AdpefMuT90eub-xngXPmgiT-YRqx8CCRcJWW0JMShL8twlykIUhXmyd2po7_KZQRjVs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_7zw6wA89zXusTtjqFeV-52YqL5MR0v_ll2OlOZoT4g&oe=6AA40E5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bill.png", "id": "2159435804565949", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820566_2159435807899282_6248702263933543711_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6WxJ5oPe98Q7kNvwEeNo02&_nc_oc=Adps5O03ZHcBCkBvXgcSpjDTOtRZuHmNSgMP_t8W-XicKZV3JCRJhkVNnFVjbaXdXs8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn6np5II2Hw7CJb16162B3nXNGV6upB_JBOUqFkiLFNA&oe=6AA40244"}, "display_name": "GridTsugi", "keywords": [], "long_description": "## GridTsugi: Maze of Woven Bridges  \n\nStep into a *cozy mixed-reality puzzle world* where you connect floating islands with magical bridges. Put your *logic, patience, and creativity* to the test as you solve puzzles that are equal parts relaxing and brain-teasing.  \n\n###  Features  \n- \ud83c\udfdd *Endless logic puzzles* that adapt to your playstyle  \n- \ud83c\udf10 *Multi-language support* (English, Spanish, Chinese, Japanese, Korean, and more)  \n- \ud83c\udfa8 *Pixar-inspired hand-painted art style* for a warm, inviting feel  \n- \ud83d\udce6 *Spatial anchor integration* for cozy room placement in mixed reality  \n\n### \ud83e\udde9 Gameplay  \nEach numbered island tells you exactly how many bridges it must connect with. The challenge? Only certain paths are possible, and the puzzle can\u2019t be completed without careful *logical planning*.  \n\nWhat starts as a simple challenge quickly transforms into an *addictive brain teaser* that rewards focus, strategy, and creativity.  \n\n> *Relaxing, cozy, and endlessly challenging for puzzle lovers everywhere.*\n\n# Get involved and join our Discord: https://discord.gg/6hvkBCn6gj", "short_description": "GridTsugi : A Cozy Logical Puzzle of Woven Bridges\n\nRelax and challenge your mind in GridTsugi, a beautifully crafted mixed-reality puzzle game where you build a maze of woven bridges between charming little islands. Designed for calm thinking and logical satisfaction, GridTsugi blends cozy aesthetics with deeply satisfying logic mechanics. It\u2019s not just about solving puzzle. it's about weaving connection and clarity.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_nam
6", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820574_1106981071063299_2197925056157474590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avw1QqbpwVkQ7kNvwHGIGh6&_nc_oc=AdqvZrDEiAH3m72aW6ttcYTSrqqwFrCtZjKHAnC5b5eSVeGUww72mard-PUcbTMetYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXnIG94GodjiTatkwEsE87QB_FDw_YvPbg6-FqEYHGvg&oe=6ACA4464"}]}, "id": "4625772717746471", "locale": "en_US", "screenshots": [{"file_name": "screenshot_04.png", "id": "4541231462759651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_4541231469426317_2819465230772260294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPlXrxjELgAQ7kNvwHMU-gP&_nc_oc=Adr88DtOee6MhSMVe3AqiGQpzf89dcI_jexFWfV7ww2ygDwmJvBdr1cga6-UXrxIkLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgqXPOtX0lBQRDn6UOHIaEsK9SJjEsZ-yocHb3eBYgwA&oe=6ACA475F"}, {"file_name": "screenshot_05.png", "id": "1622684176301236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_1622684182967902_7512470868757646834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPXDPsmAvN0Q7kNvwHeuI0k&_nc_oc=AdpiZNpT1N1_HMkbtalzrLlfQfteY517zWCHoHZMwMvb8Ngv8AEJtmgSDUzTGnkejXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4T8uopZe7vcx3RA-nOCxZUUrXem6lfqz9wKmCgEhjvg&oe=6ACA79A8"}, {"file_name": "screenshot_05 (1).png", "id": "2328842851249108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628447_2328842854582441_333859088209898254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bs83xswJh4Q7kNvwGkCmqg&_nc_oc=Adq32IK0JQ9SK-avxvhuvh4TUF6kDmCDy9IcCkJAF6N8yeSspVE0wfZUTv9hFa5nZPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsIZ46VUZGXoqO253BywhDrGICGoR4wTI3kaAIZm1GXg&oe=6ACA4BC0"}, {"file_name": "screenshot_01.png", "id": "2421664005264429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620532_2421664015264428_23257912880260569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5DXwfED9KIQ7kNvwGuCylU&_nc_oc=AdqWhaP22zmRYCb2pmQ1j3einq8i2rQ-weqNj-xbevDAbwmHbeWzcM06_6x28oPFIls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOnkSRsBK7_xrZ5uu-A2pIJ1jQUOAszZRwrH2qAPB8TA&oe=6ACA44CC"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjUW8g9oO14Q7kNvwEqSQKX&_nc_oc=AdpV0rF9sqQPDsg-qtMD_YzimoMEquoijzuHmftvAw4dZUjIjZX-LZzUW9ePguq1NTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7kIwNGCUcVBB5wltJMHELIjhDWb9qqx1RGt12LMasfw&oe=6ACA49DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99v-XYXfNW8Q7kNvwHQHxBW&_nc_oc=AdrgefQRZE8EzHt7UhScXsUSz8J5cmFu_tNhLVf28OyLj9FytBoU8Gil64007cWElgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtQ5Iq9Yq6y1IcRGUM2b2CjTOY9F9nQl1iSwdFR6OziA&oe=6ACA757E"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28910293798608173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ok66CoA-p4Q7kNvwENVReW&_nc_oc=Adq3ppyR-4zNSeOmWYnZt6PvyHGkr7ZGZUOUC5sqlan13m
6", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820574_1106981071063299_2197925056157474590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avw1QqbpwVkQ7kNvwFqxqLS&_nc_oc=AdrVLfl43_0Rbk7KOKJl5KvJ51TipPMsh2eE7RVYtEqj8Eyv4Z8EwbcW4x-3APvGPmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1WaCCFn8nVYM2q0cHaO8cKdBObiG7A7XhjsXd1X2x8A&oe=6ACCE764"}]}, "id": "4625772717746471", "locale": "en_US", "screenshots": [{"file_name": "screenshot_04.png", "id": "4541231462759651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628456_4541231469426317_2819465230772260294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhM10ldIq9YQ7kNvwGiUHT0&_nc_oc=Adpfi7ENpteipEdAzv_FTWitJxMUgHt5-bgFfQc4X1w1_L99x1H0oSgQVpTroeOYjj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM96h51SFp0wPJtiwM44bMu6uKNQg8G-x829NeHo614aQ&oe=6ACCEA5F"}, {"file_name": "screenshot_05.png", "id": "1622684176301236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623585_1622684182967902_7512470868757646834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ1Q5mxoZSAQ7kNvwGfu2xs&_nc_oc=AdrZegXjpPX9zgjFWIqP1myzGDhUeh_gE1CmRkp1aWAl7s-rj4g4MU6UzG3m73HY35A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNykqW_JhDCcX2Ag3FA0FewHj4kJ2sCz_lecc8cXCW1MQ&oe=6ACCE468"}, {"file_name": "screenshot_05 (1).png", "id": "2328842851249108", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628447_2328842854582441_333859088209898254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeeWtyLG2H0Q7kNvwHIiVLK&_nc_oc=Adr-Ce8RLireVbotS8yEC0Lp9dZmteKMTOA2E05_WvV5mlSkRpWanS-vZbVlKrLTfoo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1lIL7qHj5Pege8fx1o1_R4lWl4zWnztB1RkCLelkpJQ&oe=6ACCEEC0"}, {"file_name": "screenshot_01.png", "id": "2421664005264429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620532_2421664015264428_23257912880260569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5DXwfED9KIQ7kNvwF-P5S7&_nc_oc=AdpY7WSEWLVEj4htT9OpcC9jjJVKjDDCpH502j2iLuXk1YDr3S9rc6yubABXE77Mj6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1r-7FEkBnXDX_8iy1tHyP9NWN8EC6NwoS1cNd0oOr9A&oe=6ACCE7CC"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i86rH-p1H8MQ7kNvwGKay7x&_nc_oc=AdqGktsw6so9Oc_1F2R0scOHOWJXgHVrrISmTTriBIF1_i5KMhC3ZYBgZI2NP6XbuYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFVRuBuGhe9z57qu4hVWfM30ky0XNqOFtfiYs7dsw5lg&oe=6ACCECDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99v-XYXfNW8Q7kNvwFvburA&_nc_oc=AdpU4SHJvqnB1WtNfDYtiUu8JG9BERc17e7v0YLat77bb6QO78rSZFFjV6IgEzcmux0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZHZ9n5xkNw8EAnSU3dYxdgBQws8cNko9PjGzXfWudlQ&oe=6ACD187E"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28910293798608173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x4TPS1ytjsQ7kNvwHq2jsy&_nc_oc=AdprZZCQ232xjkNqaS_puJyTakr14AqQtF8lmrK7URrtTW
6", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820574_1106981071063299_2197925056157474590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avw1QqbpwVkQ7kNvwFSlrpT&_nc_oc=AdriA8wAirl3AYfKWpXXwvbahvBJfL-Bsg1tSUmabRv66Zap4S0SOaC3dCnuGJAm7ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAtRDn6er7MejNFJWSd6KruTstiVZWX3zfRh394mJPng&oe=6ACB95E4"}]}, "id": "4625772717746471", "locale": "en_US", "screenshots": [{"file_name": "screenshot_04.png", "id": "4541231462759651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_4541231469426317_2819465230772260294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPlXrxjELgAQ7kNvwFz_V9r&_nc_oc=AdouTL8jnwJLg1lHi00q9E8Q3lW4uLik2_C80IHHpkUH0ghGe935xht3C_4lBWUZrTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6EWBAGx-upA_ZQjj1DS6ST3F9nyNUVxr9EHf6qi2lWQ&oe=6ACB98DF"}, {"file_name": "screenshot_05.png", "id": "1622684176301236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_1622684182967902_7512470868757646834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ1Q5mxoZSAQ7kNvwGfhMNV&_nc_oc=Ado3ef5JT7zbmoxshIi_fKgxOaP1Aewbf8gBmx1HsjqQkSSEKB2RM9R8OCrTttW6nJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS1iYPZWp62Rdr2MUYbiJVFzy--ecr5O2cDB3xHXRPXw&oe=6ACB92E8"}, {"file_name": "screenshot_05 (1).png", "id": "2328842851249108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628447_2328842854582441_333859088209898254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bs83xswJh4Q7kNvwHAaDWC&_nc_oc=AdrnGCTF5A-HCcKmxTLDLVTxFuM1LJHXOvkXFiyqanZaaf8QC4r4qRe1blQbvlJ0zug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdMHyI_27RAenas_eefssbFs66pNJyC5fdLOcqIJXEPg&oe=6ACB9D40"}, {"file_name": "screenshot_01.png", "id": "2421664005264429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620532_2421664015264428_23257912880260569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5DXwfED9KIQ7kNvwE9ps0F&_nc_oc=AdqfCs3gDdTtM6qotAJefan-u7nsoZoI2ndkoJFJ-MmQLeJ9l3v2tjFmCoAObgcIC5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXLZFLqpP8AHP-N3eevtSDiukd_EjmMkE8AV7Kfz9LZg&oe=6ACB964C"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjUW8g9oO14Q7kNvwGzrYNG&_nc_oc=AdrWakoIba9sqPPPMYkMx-12pap5SEGPeQ4PKTmIsRWh69nPL7ZZvalPjEgclAhC8So&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCyICYfaXnUvBBozGY-j2TuNpELV_a0qGYqiu-13xYww&oe=6ACB9B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99v-XYXfNW8Q7kNvwG2ic-S&_nc_oc=Ado-EyIOFH6AAHos46pF5gZbSqCEwh9FUN2kOhT4UVzv9MzcRQX7HzPG8qt115Pzg2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH-SSujnxLAKBYUEyBBKOPI7MXOTkjW8bwgepmLY_J7g&oe=6ACB8EBE"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28910293798608173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x4TPS1ytjsQ7kNvwFulGQS&_nc_oc=AdqcoVg7poYyEegiq6Lvbis_ZCr_OKWChCzNFabxqQ__vj
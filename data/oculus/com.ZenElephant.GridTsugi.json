1VQ&oe=6B087183"}, {"file_name": "13.png", "id": "783545940853635", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_783545944186968_1919964374083555883_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92ZTYoglJa4Q7kNvwFdGIp6&_nc_oc=AdqC7yX-fcx7t4C06Il7h-2cBGWFGUE08JLuWF11Vze1WHD_9yLgbWKp7-g6bVHdcyw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfKsDsRDiSKgkQSpGO4pJyreug8yiAc4RB8TrtGKTcsw&oe=6B08696B"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Opt-Laug5IcQ7kNvwG4JlKa&_nc_oc=Adqh8QxvubWBQA8xf6Wq-FBymk9x9MO1PO9Wr2zwM3PmO3tHsY5FGUPS8JPHaIwtK4Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKf8-CM2VjCgAnvlLGJffFzJpZEB01v3DFF4l5VcC77A&oe=6B08405F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwwPZAqrH_AQ7kNvwHRZCXj&_nc_oc=AdrEjoiZQKHvdO0FrziDqRGCZ9-wJWUBTPNIlXKrpz-kGOzwXUY_LvhgYFO3JzNITis&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8aEgMyGL-RwZ4OboqCjDqzUrG_zfXy_QIENX5OacBow&oe=6B086BFE"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29075716365399248"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
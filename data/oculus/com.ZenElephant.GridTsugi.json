6", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820574_1106981071063299_2197925056157474590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZhDPeG_32gQ7kNvwGW2ymv&_nc_oc=Adr1TbMkFsz_vVFVUCHKu89bGeGNpWz0uqNLwO-7otiEa0LKQSlAW4uxeqZgp-dAoJg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn0gHI8k906ZJiMD3rXgchp6N5tQoQxHXGuLgljlfZlQ&oe=6AD3B724"}]}, "id": "4625772717746471", "locale": "en_US", "screenshots": [{"file_name": "screenshot_04.png", "id": "4541231462759651", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628456_4541231469426317_2819465230772260294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHfHin2NyTAQ7kNvwF4PN5k&_nc_oc=Adq5ut-L9vgqunxuNT2rm8WUpewQ0_Dp8Xg02jgE1YC12jpk8uw-GRz7UecaRA1HIpE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlE6sPXTNBbPNdn_JTLDGjbl5vYBVmODNFQSzhR5TE1w&oe=6AD3BA1F"}, {"file_name": "screenshot_05.png", "id": "1622684176301236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623585_1622684182967902_7512470868757646834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sgk5-d16doQ7kNvwF-cEBX&_nc_oc=AdrkUPMGolBP52vgTRcn60GFMc5u3ZU0UeL0y_ibk38V2-hvb4QXSWHT-R76rK0Zo1c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_co2QLPWP2ZQnK_oxb0RFkeuvC4-UmqVKEgUPLxs8CA&oe=6AD3B428"}, {"file_name": "screenshot_05 (1).png", "id": "2328842851249108", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628447_2328842854582441_333859088209898254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55-lKVWRRGgQ7kNvwF-T_WS&_nc_oc=AdrU7V61nATexx_aZ9v_GI4Wx5uNqy-DNXbqpDqwxucCwGQbhXY2TtTmq34sY_ZxObQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP41dgr43hysKrdJilfakeYjPpEMpnAN7vrutTGs36iRA&oe=6AD38640"}, {"file_name": "screenshot_01.png", "id": "2421664005264429", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620532_2421664015264428_23257912880260569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ3RJp3n86gQ7kNvwG3MH54&_nc_oc=AdrNan2gUyGL2AlKV83xRJF0ZlBYf-wRVDI71pSZKIMaESy8t61R6lU8NMLYuZk2AlI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_aATfan-_Fe6YHanYVO9HF_OGwcAcWG3Mx17_pilcEA&oe=6AD3B78C"}, {"file_name": "15.png", "id": "1301782611407009", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618264_1301782614740342_899962846342761491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVT8ooAT2lUQ7kNvwGYUFTk&_nc_oc=AdqATKMdP9j2u93xCgur829zhM4fSPA6roMcQ1tED8Y0s1PljnFyrXBlvJd-naz7PkE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1XmMb9rIHJAw5dajF76aFbaGsezodf0VVOPJO2uc_yw&oe=6AD3BC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "721320676973178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618512_721320680306511_6945490733402754471_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p_dOtPSjCIQ7kNvwG1JA7d&_nc_oc=AdoTwbacDlyhUT4Q4p75ysg_eVsWyazeFDQZyKhd6e3XBJNcwjzrB-ZRdEcIZBi0aqI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqhWQE07swGlWhx573mGYXAVWxfMN6ybrD6_mQfEZmQQ&oe=6AD3AFFE"}, "display_name": "GridTsugi", "keywords": ["puzzle", "cozy", "BrainTeaser", "MentalHealth"], "long_description": "\"A game where you spend only a few minutes, and suddenly your brain feels like it just powered on again  ,gives me Zudoku vibes!\"\n-VRnewstoday     \n  \nChallenge your mind with GridTsugi a simple bridge connecting puzzle game where each level gets trickier as you progress\n\n\n---\n\n# What it is\nEach island number equals the bridges touching it. Place single or double bridges, avoid crossings, and connect every island into one network. Cozy, readable, hand-painted look.\n\n{683415147367906}\n\n---\n\n# Why you\u2019ll like it\n- Endless logic that adapts to you  \n- Infinite replays to try new routes  \n- Mixed reality ready: spatial anchors remember your board  \n-  Rules Covered In Multi-language : English, Spanish, Chinese, Japanese, Korean, and more\n\n{1703688680341198}\n\n---\n\n# How it plays\n1. Place the board in your space  \n2. Read island numbers.  \n3. Lay single or double bridges; no crossings.  \n4. Win when every island forms one network;\n\n---\n\n**Connect islands. Trust your logic. Relax into endless, replayable puzzles in mixed reality.**\n\n---\n# Join our Discord to share ideas, report bugs, and celebrate wins:  \n# https://discord.gg/6hvkBCn6gj\n\n\n", "short_description": "A cozy logical bridge-connecting puzzle where you link numbered islands into one satisfying network across village, sci-fi, and vine themed worlds"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/zenelephantxr/GridTsugi_PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "zenelephant pvt ltd", "support_website_url": null, "website_url": "https://www.zenelephantxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28910293798608173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304190_3428855310602768_8908075042335583333_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYCWKKepWzwQ7kNvwFL1Sx5&_nc_oc=AdqUgwK7z5i-eYNwUmtFjoFdt9d2fNoKlx3kswpWjfeV0N
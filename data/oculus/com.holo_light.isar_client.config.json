.5771-25/473391986_939692864718427_9140555284876475848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NizOWEl_JmUQ7kNvwEiuqbR&_nc_oc=AdoCpRujssyNwpc-l2ZOdnrV6vZDcsYb_7a-RxaPKriAL0Mt13VreYffSOr9_MTOAyM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJUv3Rjdx1aqSApegiP2dp4ClPywRMoBfbrmNBgv09RQ&oe=6A8D69BD"}, "display_name": "Hololight Stream", "keywords": ["Hololight", "Stream", "XR", "Streaming"], "long_description": "New 2026.0.0 version is now available with:\n\n- Improved pose prediction.\n- Added render time reprojection using Qualcomm\u2019s Adreno Motion Engine.\n- Added planar reprojection.\n\nThis application connects to a Hololight Stream empowered Server/Desktop/Cloud application.\n\nImages rendered by the 3D app (Unreal Engine, Unity 3D, NVIDIA Omniverse, Autodesk VRED, KeyShot) are pixel-streamed to the XR device. The pixels are encoded and encrypted before being transmitted over the network to the XR device. The device then decodes the pixels and displays the images in their original quality. These rendered images of your application can be streamed from a local PC, the cloud, or a local server, without being limited by the XR device.\n\nFor more information, visit our website.", "short_description": "This application connects to a Hololight Stream empowered Server/Desktop/Cloud application."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-policy", "developer_terms_of_service_url": "https://hololight.com/terms-conditions/", "publisher_name": "Holo-Light GmbH", "support_website_url": "https://docs.hololight.com/general/index.html", "website_url": "https://hololight.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_c
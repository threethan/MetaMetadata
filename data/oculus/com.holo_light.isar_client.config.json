png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL62L9KjyD4Q7kNvwEi2HZ9&_nc_oc=Adlv135fbxMKQ-3yz9-kjTON9PxhGwaq_Rvq_rgpFQq5yr9JEN9qUGYACn9ynlY6u_g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrQamC_iUbU2cs-c8KJu-8m1u4uzcRwQYYyKbX_Eugxw&oe=69AADFFD"}, "display_name": "Hololight Stream", "keywords": ["Hololight", "Stream", "XR", "Streaming"], "long_description": "This application connects to a Hololight Stream empowered Server/Desktop/Cloud application.\n\nImages rendered by the 3D app (Unreal Engine, Unity 3D, NVIDIA Omniverse, Autodesk VRED, KeyShot) are pixel-streamed to the XR device. The pixels are encoded and encrypted before being transmitted over the network to the XR device. The device then decodes the pixels and displays the images in their original quality. These rendered images of your application can be streamed from a local PC, the cloud, or a local server, without being limited by the XR device.\n\nFor more information, visit our website.", "short_description": "This application connects to a Hololight Stream empowered Server/Desktop/Cloud application."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-policy", "developer_terms_of_service_url": "https://hololight.com/terms-conditions/", "publisher_name": "Holo-Light GmbH", "support_website_url": "https://hololight.com/knowledge-base", "website_url": "https://hololight.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_
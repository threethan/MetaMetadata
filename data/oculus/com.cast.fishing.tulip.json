om&_nc_ss=8&oh=00_AfzbkSSSrrkxzXWMY5UL-VCFm5mVhr2_ofKLNr6hi6K-5g&oe=69AAB236"}, {"file_name": "1.png", "id": "551812067606239", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031487_551812070939572_2278692296292511739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK0MZ8IbkB0Q7kNvwGYZzl6&_nc_oc=Adn0o3p4-2yAbx5VhkYs5hu_O4byb5MZixpHu8nCKzcc9jyauGgS24FjJ5rOPyLd-ZA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afx8kDokVXUM6-cH8u70U-yDxVV48XZH89sipjBItNTUPQ&oe=69AAC4F0"}, {"file_name": "7.png", "id": "376266318842068", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001733_376266322175401_8339554002797319173_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOCzZSTZ0EcQ7kNvwFKIN1R&_nc_oc=Adm_mHYgOIOxJSr5WZsAFzj_hg9sR1IUUqlez_ZbQRPQl1_ClqbjLLbzCLvujSMiU2k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwA2KYmhQq6BOxkURx8pz0GHMUZHNFtOYnHWH52DqmrQ&oe=69AAD5FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cast & Catch Fishing Game", "keywords": ["FishingGame", "Fish", "HuntingGame", "Hunting", "FishingRod"], "long_description": "Embark on the ultimate fishing journey with Cast & Catch VR! This immersive virtual reality fishing game takes you to breathtaking locations, from serene lakes and winding rivers to the vast expanse of the open ocean. With realistic 3D environments and dynamic weather systems, you\u2019ll feel as though you\u2019ve stepped into the world of fishing itself.\n\nIn Cast & Catch VR, you can cast your line, reel in a wide range of fish species, and perfect your technique. Whether you're looking for the perfect catch in a peaceful lake, challenging yourself in the rushing river, or tackling deep-sea giants in the ocean, there's always a new adventure waiting.\n\nFeaturing intuitive controls and an expansive variety of fish to catch, including both freshwater and saltwater species, the game offers something for anglers of all skill levels. Track your progress, compete in challenges, and enjoy the immersive soundscapes of nature. Perfect for anyone who loves the outdoors and fishing, Cast & Catch VR brings the best of the fishing world straight to your VR headset!", "short_description": "Dive into the ultimate VR fishing adventure! Experience the thrill of fishing across diverse environments\u2014lakes, rivers, and oceans. Cast your line and reel in a wide variety of fish species in stunning, immersive 3D settings. Whether you\u2019re a seasoned angler or a beginner, Cast & Catch VR offers endless hours of fishing fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9306770379400628"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984442_576449951502141_1771918924314978495_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYzumeo5CQcQ7kNvwFPHtFM&_nc_oc=AdkyCmno8y51VdFaHTIo_GVz7cNGkxDCZG5-HrT2RWiwu3Crg8mDFeYQkhWH8AcRgdU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAudHKAuFqdanvVg4HO8K18grdimKzYeAxyNsIZDWyXg&oe=69AAC03D"}, "is_con
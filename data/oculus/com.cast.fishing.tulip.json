at=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hx5oaNEqOLkQ7kNvwFm15cr&_nc_oc=AdoAMj8CsPxBXm4080opiSNxWE7pdZTlp3SJ9e4P3rnIp42tNh6pLZH649Ivpar91Io&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qRj9lk8lnm0w3Fi1j_LWIkuDrS49lCKUCm12t9x8HCg&oe=6A1310F6"}, {"file_name": "1.png", "id": "551812067606239", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031487_551812070939572_2278692296292511739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYmXy8HIEKoQ7kNvwFoRKpq&_nc_oc=AdpWCfkCZaTk_j7_3W7WgphBv3fwF15_HJ6jKdtMfQSJCxI5Qb3UrwUgMz3WZ5TPIdU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YWg0hzbU9Xl-0mkISJ3Pst_D4mnqbM5gu-BMGHYNS2Q&oe=6A12EB70"}, {"file_name": "7.png", "id": "376266318842068", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001733_376266322175401_8339554002797319173_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xG1qNnbctQQ7kNvwHS39AG&_nc_oc=Adrf5FBYnRGL0Xfk-kJIaUm3XjRzXKiDpzNQKq_xvRnsQLESvd6qC2p60YC_IRoCaJM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X81oI9GKymc7axdF6EyJNKz4XxjGXzzhem2sEc3zS6w&oe=6A12FC7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cast & Catch Fishing Game", "keywords": ["FishingGame", "Fish", "FishingRod", "FishCatching", "FisherMan"], "long_description": "Embark on the ultimate fishing journey with Cast & Catch VR! This immersive virtual reality fishing game takes you to breathtaking locations, from serene lakes and winding rivers to the vast expanse of the open ocean. With realistic 3D environments and dynamic weather systems, you\u2019ll feel as though you\u2019ve stepped into the world of fishing itself.\n\nIn Cast & Catch VR, you can cast your line, reel in a wide range of fish species, and perfect your technique. Whether you're looking for the perfect catch in a peaceful lake, challenging yourself in the rushing river, or tackling deep-sea giants in the ocean, there's always a new adventure waiting.\n\nFeaturing intuitive controls and an expansive variety of fish to catch, including both freshwater and saltwater species, the game offers something for anglers of all skill levels. Track your progress, compete in challenges, and enjoy the immersive soundscapes of nature. Perfect for anyone who loves the outdoors and fishing, Cast & Catch VR brings the best of the fishing world straight to your VR headset!", "short_description": "Dive into the ultimate VR fishing adventure! Experience the thrill of fishing across diverse environments\u2014lakes, rivers, and oceans. Cast your line and reel in a wide variety of fish species in stunning, immersive 3D settings. Whether you\u2019re a seasoned angler or a beginner, Cast & Catch VR offers endless hours of fishing fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26817539467897115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984442_576449951502141_1771918924314978495_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NGPhjMpIcAQ7kNvwF6MeXw&_nc_oc=AdpQGo5VBuKEilMpXrGFbhlK_UH1sQEAt9rqugTENpooeCrB0jUh21x-2H4s
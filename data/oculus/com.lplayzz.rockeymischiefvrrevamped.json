ays the rockey mischief has a lot of cosmetics to chose from. holdables hats tops and more.so what are you still doing here download the game and have a good time with others!", "short_description": "rockey mischief a vr game with gorilla locomotion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10Wxox5b8tiTlHA_7CEHnq9dzrsm6Y9uSYtv8zlDR6pA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "lplayzz_vr", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UC2ktvvuBQwCduHjt_ICptDg", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8477561172336114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031565_501219342189638_7388540311070500298_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuylkQ9vdC0Q7kNvwE2NavT&_nc_oc=AdnQ-1t-FgGJ4PViAh_m4t6Xva04tAv9DYaa9sPRQZPL-v_xMaibfNn272nC13fmjT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftpcGBRE_2UcZsHbX62o9uVlW7M9sdtBB62cEbvwNJ5Fw&oe=699C3932"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "(closed) rock game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 168970
cdn.com&oh=00_Af20R0pfa1Ga1d2Vm0ofWIf5y1KnnIiap__MMKy5W-mC_w&oe=69F218D1"}, {"file_name": "com.oculus.vrshell-20250819-180017.png", "id": "1883034135895438", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyswWbd8kHoQ7kNvwGaHUMZ&_nc_oc=Adpid3g8dAchH3dqBgMyZUyL6sd0dbfUXILIRrmoYIDP7nsJp9TGGiSeswim82EecV4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1TSx0BbmFvcFPZpFeQorSJRdA7x2CdyUJIDI9tRMKxZg&oe=69F1F082"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fspn3B60XfUQ7kNvwHBMKhg&_nc_oc=AdqvAwwST4p_NgjrPAYxDQgL0EjK4wpOKyc-ctwebJBwepfRP0VYoiPxmCFT9n9HP8o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3LLe3xIrRB2WIKYXRm2O3tvaLD9ZiRyU2kos23F9R0tQ&oe=69F2077E"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sinqbiXwtnEQ7kNvwFN4jIL&_nc_oc=AdoNLV1b1ApQTgNSZ--X2TPmG_WdU949aV7bJblwi1OGZGaiOCWqQQD5G52LGH7ULdc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af251xHJYn1pdKz1NypD1QbBb_hwdqJholB-tjIYauCNsg&oe=69F1F408"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24626088823676119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499293658_24629606386644447_784528995680490684_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI6FZn5_otYQ7kNvwHAI7wb&_nc_oc=Adr-BlrU_vFOMMV-Thhydgeo3r98u-jBbKPlUiJnErTtKGAUUbel_OGJb5J5OYKjwrw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_
391xFRj3ng0MKUN-0PAkVCTxyVxU8xTTs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_tggX3Krl4Unbwql0K6fWD5M3iW_XOsPPDzXkC_5PBg&oe=6A5A2071"}, {"file_name": "v3.png", "id": "464389309430051", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974466_464389312763384_9069537642276165631_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAygYfIIVZUQ7kNvwGdJxeL&_nc_oc=Adr9AZITwnCnc91ZSiuH0ct45puPnJkV9ociA4msXai62zZ6fiJKpRqBi9EVdhRUOM4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ2ls3x3-ZAALRJE-Xd8KIWxGLPomYYGlswt3fa4gc0Q&oe=6A5A3138"}, {"file_name": "v4.png", "id": "8325219104273613", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982708_8325219110940279_5950254241398881098_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eVH1ybwa6MQ7kNvwHqndgS&_nc_oc=AdpQSZx-XHTHALEPtUAaka2i9XA9lXnZVJB5BtyPjK2LC1-qKqTpEzYlPoSA8lj2IP4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB44gCyHdeMdVxrG9WcxR00ynFUP61nleLnKEt_7nW_g&oe=6A5A48C8"}, {"file_name": "v2.png", "id": "444768718246772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974839_444768721580105_7005804818555441484_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u53yI7n6JwQ7kNvwEDhcTJ&_nc_oc=AdrSWBjJnGYakoYKGR0WNie4a4GWocNpHOG_KW5l3h35r2ZFJjI8IpEORZNvgBMA3vI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBGxaXXWF2h3URXApJqj3Bo_tZso2TaGpxe7tVNCDblA&oe=6A5A15A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8955226571188930"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "988422324161348"}, {"status": "PUBLISHED", "id": "1002675308297827"}]}, "baseline_offer": {"id": "988422324161348"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781268600, "status": "PUBLISHED", "id": "988422324161348"}]}, "liveChannel": {"nodes": [{"latest_supported_binary"
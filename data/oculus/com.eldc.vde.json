com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMsBzHdWBVYQ7kNvwH6_7sN&_nc_oc=AdrcFXUgTVKO63dyxnMutwc_u7dda8da2hNxnV9G0am9kz_koAOXj48UFPFqn0XSfzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy99myS5zS7ReVBWv6inT9QkbJkjWT1y9x2qpZ86rVBCQ&oe=69CE5802"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aESuAyWSsxAQ7kNvwFem86q&_nc_oc=Adrdq4Y6GPa1wzzVvPIQO2Vb6OEjltU5sgfmXAcaVsCSLBqmjyuncpgFlgasK4YEWas&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdmKZWVSmJkndd2GazKaFR_6pQ_4SL5oLSpMX_H0_jkw&oe=69CE6EFE"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbF0DBj4VXkQ7kNvwH4GGgf&_nc_oc=Adp3Shj6CklcKLbW6G2e6i2JXqthPKMDnUWsHbydVkFpDe5CfAFbGP7gdNvl5-5dYt0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVT8bgJqKDvWjQAGBee9cTQB9XYGP5djuNn23UPFnrwA&oe=69CE5B88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verb
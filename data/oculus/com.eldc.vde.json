com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sp9Syk9e_4Q7kNvwHPtZIX&_nc_oc=Adp_F8NeSg5H6xJAHsw_e74bcrYR0Z8tmXq6FsaPRa9RGvcvEwCKIP-rsphLeLQD10A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypC7TK9RN3oUE0z9BOxT1lXSKelV76xn-k4xoF8cwm2Q&oe=69CD0682"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aESuAyWSsxAQ7kNvwFEWArk&_nc_oc=AdoRt1jbhNU1AFoOI_sQ5x65Y8cQ4nzgC2Aleu2RZv9XkI3sCebHuKDaHPvZ0mu_2EQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGWjbE3Yd490DUby6KFNudKyxKuRqXs1BHPu4q3eWbxA&oe=69CD1D7E"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbF0DBj4VXkQ7kNvwEgeStv&_nc_oc=AdqS7dpuMWrvtFMk8bqaqqkbniJHtXolVwvprYvLJlnU9wUyR9GGnu8eIjcqipNCA7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbVF8wBz9ofLQdW3MNADRd2s0pzQ5Y1GBzxj8xTuQcmw&oe=69CD0A08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verb
uscdn.com&_nc_ss=7f30f&oh=00_AQQEJ_qxXfbpSZ_rA5CVd2OMrk9SvUbVmMdG3p_rptPRSg&oe=6B0B2426"}, {"file_name": "v1.png", "id": "492521377273452", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001658_492521380606785_749110342414682666_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSzdK28CSycQ7kNvwEi-EXH&_nc_oc=AdrVoDOJONIvYMkLKjv47kc9YMe6F7icGzma0KPM4_GSIow1pLcoi-1Feny3bv3D6cA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYwPeMI9nsvtT8v1QDzqs0a6W0Hvff8kvVbnGWEGtjpQ&oe=6B0B39F1"}, {"file_name": "v3.png", "id": "464389309430051", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974466_464389312763384_9069537642276165631_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70VD_TEBPyIQ7kNvwFLA6_F&_nc_oc=AdrLyNwaDwxE9cGehst_V3ncth-b5NJwrI9INsgYMT5LkRAStKK9O3fEF3ckEXVKoW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBE6mv9CmMITYOTip9hWdkfE1QNJSqiN8Kg6JfxHDnVw&oe=6B0B1278"}, {"file_name": "v4.png", "id": "8325219104273613", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982708_8325219110940279_5950254241398881098_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwYcjKLtepIQ7kNvwHov3dc&_nc_oc=Adq3MhI_hpwYgpvt5s7wBK4IPrJLaGNN8AnZ61jt7UotLRCl8rRpOv46xpq8kr_N44k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjqFiulTgO-FUmRmdoHYt36v16Q4i5hPfN9dcrY8HeAw&oe=6B0B2A08"}, {"file_name": "v2.png", "id": "444768718246772", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974839_444768721580105_7005804818555441484_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lcH7E9LqoIQ7kNvwEURYQC&_nc_oc=AdoHGZ0Zi7YqA3oxmRrFoYlBZm5vaw7o7r0eRDyH4BnW6j214ct8kIOdD28m8Hsxq8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMeAzWFXEohad6mpOVkKubRYNkqDYlwPfoLjLLTbDmdw&oe=6B0B2F26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supporte
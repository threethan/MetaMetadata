414682666_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2tleg9TtAwQ7kNvwGxYBS8&_nc_oc=Ado-1pEVUy_EhmShCtuPUtRYaMtWC7mo_SbcngM1dPFZ_Q7YzYRmKNTJg6Nzaway-CM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCtnipNozC799AO_nn0tHleSqN-tVnEzRK9LLwJVcQSA&oe=6A8AE7F1"}, {"file_name": "v3.png", "id": "464389309430051", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974466_464389312763384_9069537642276165631_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnl6_tLFN60Q7kNvwGsHbLT&_nc_oc=AdpYTVYIEWOteUVQG_rnb4zRaRJroiuYDkOfkQ7DhbqJZd8h9cWO41P2y0W6zCEa7Ko&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0gwDZCAubKJzNCbapM5Xbn-hoFZzACej87anKaaY1xw&oe=6A8AC078"}, {"file_name": "v4.png", "id": "8325219104273613", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982708_8325219110940279_5950254241398881098_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYsZU7kM4oIQ7kNvwHkKEEG&_nc_oc=Ado_LVL7tE-USVBdBhQ9zuIXu-0onfrG_ScqFFv_AJoG4HgrAWnzEOKUAfyujtdLuPg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9CHsZZw0jUVA2hFWpL737GPIA_lxPijrK6qa7jLsPkg&oe=6A8AD808"}, {"file_name": "v2.png", "id": "444768718246772", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974839_444768721580105_7005804818555441484_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqZ8qOSvueYQ7kNvwEtGqsQ&_nc_oc=AdpU4jLb0dH5sKnT2ifo7_F6UYZG1amBFIq1avN4Gp1Ah6Q5o5S89G6FswjR07M7Kjs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGTdcpxUg_0jM2mtQcnk8GLEt_9P_DBaMvaNBAl-J8FQ&oe=6A8ADD26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8955226571188930"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "988422324161348"}, {"status": "PUBLISHED", "id": "1002675308297827"}]}, "baseline_offer": {"id": "988422324161348"}, "is_approved": true, "firstOffer": {"nodes": [{"star
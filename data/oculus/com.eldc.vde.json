com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEBLWiYDRkUQ7kNvwFA-n7U&_nc_oc=AdqiUJvNJdxgtCLEyQ-T01Clqv_dbw7rznOeyRCACxeYmgZ00BtSGS8DlGkL1pgDH-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EzRx9BH2aPBfAAUvaWBv5tqcQxkf4Lxr7dU2I0A3jwA&oe=69D24C82"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faax6vWP9dQQ7kNvwFVtuIi&_nc_oc=AdoNCLU8r9P-E_U_yH8qhJcAQF_ELsgHh4avKm8xhi6VKWPE1E_mwQa_xgRQHyTiCmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MamERuAJA6AjEqNUa-rHp9VXqrGAAiA22W6lNjPSmVQ&oe=69D2637E"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50n-Uc0bSusQ7kNvwHDRPyB&_nc_oc=AdrzgPnnZjOn6prkU1EmojMzuN9YhfkSk8T9fKie4Uy6UP5wMf47Lil10wNusqNN6LA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Jj_1ZzCZRBbXzc7ZSJOyb1i1SYn6m-ELEb_5Q4mQcww&oe=69D25008"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verb
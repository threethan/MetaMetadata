com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMsBzHdWBVYQ7kNvwHya62U&_nc_oc=AdrebstprjjHmt-Mwlo8d5XOqDp2kUHa2ouDfOVzusbl55W8vzy_2wH4nDeJlcpogr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJcx0xMnyiS56KksDy6L91v9ZojeeCwdGlO-yntoMkWg&oe=69D0FB02"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faax6vWP9dQQ7kNvwH9jv8y&_nc_oc=Adqte9KOqcZA7-3NDi2k_sHZuHa9UF5d36ZTGXPqIeSc6N7dV8XoLhMlSZukoCMv9mk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4T_EB_iyRw0lKjc-61GRh5tg5TDVptowS6n1g6H8WGg&oe=69D111FE"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50n-Uc0bSusQ7kNvwE7HXLi&_nc_oc=AdoSEMJRIwqxT4f2fiSzx-zCNTuZPXR8ANp3d1kf6ZXDGV0i_gZErDCx95W5108Cg-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN16iOIfN_SkMVXGK6AugWlrZl-IpypIpEh3-PTse2wg&oe=69D0FE88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verb
414682666_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFS2moNhAmIQ7kNvwGKj9Kr&_nc_oc=Adp1FA0x-KrVXageoX_D-7FJS-VKaO5NRTRpOdMgq-P0NIIOBcXtSnolJheAlId9Cvs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHKJ8KjxVvZnjmnrKoeeOqMqvmzyrwW77w2skYxvXaww&oe=6A9AF231"}, {"file_name": "v3.png", "id": "464389309430051", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974466_464389312763384_9069537642276165631_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LcWMK0QfAwQ7kNvwE3_j3O&_nc_oc=AdqvXU0X1g01CE5s6l3XVycJvh36wM1NaIK2y5EAawBsgLqiU34inlBEaIqpz8JJofE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW1TuUJenV-GjWRd321CS7cKet4r23n-xRV7bK7mtoJw&oe=6A9ACAB8"}, {"file_name": "v4.png", "id": "8325219104273613", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_8325219110940279_5950254241398881098_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC8LrHu2Z4MQ7kNvwFaHREr&_nc_oc=AdoA84JHjaTqevM2YGGNCB5dmyXUbB5-2_Dc0-JBh4zZCT9YpgHEbuq-9Ugjs4huT5I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI834f-aFl10n21T9Eojtn13TIxG8pcXRIjZFyHu11Y_Q&oe=6A9AE248"}, {"file_name": "v2.png", "id": "444768718246772", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974839_444768721580105_7005804818555441484_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vz8BNCMiHAQ7kNvwEZuX-X&_nc_oc=Adq6r9YCVgfjnZ84aUeSqAVya07BCtvHR2rZ4a-WFmTzo89-WLIZmL8fQzuGEh-nqfM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvqLwMmBSunUVbiB6fSiBSNSnXhPLM6YU9B0mDBMk6aQ&oe=6A9AE766"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8955226571188930"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "988422324161348"}, {"status": "PUBLISHED", "id": "1002675308297827"}]}, "baseline_offer": {"id": "988422324161348"}, "is_approved": true, "firstOffer": {"nodes": [{"star
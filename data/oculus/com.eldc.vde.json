com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sp9Syk9e_4Q7kNvwHAXgFx&_nc_oc=AdqfBhjqadl88BHa6N-llzOGZ_QC3IztvXHq1nu67k_Wtl65vIKvFbN9H-npetvQ_gU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypZM9R9OYRbEvIlIz7-CANWpp0kcn9TC7UJBRCxexcIQ&oe=69CA6382"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB3bmSShfkEQ7kNvwH0fcOR&_nc_oc=AdqILahEMHT3kKtE40QdCNUCVwyxLEl-b8mwX_LTXTVZUPMEkdc9GFUCxStH14GCQS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH4iF7I7SOMhNA9PhagyXaXYbupcKWCPAoJpBkV-O_JQ&oe=69CA7A7E"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jvHO4OOyR4Q7kNvwGKNym9&_nc_oc=AdrvsdPkdt9sOCmTuMbUkErnmKO0y6RBj9L7j1dCBJZ3PTD3l3XVkcYh-SN0NkWZJFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1F7_0ZYWeSoQSVSgX3R9cMDrdxiszlpuil4ayK5tXPA&oe=69CA6708"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verb
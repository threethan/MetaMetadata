lation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supporte
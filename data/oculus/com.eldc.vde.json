eir patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24626088823676119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499293658_24629606386644447_784528995680490684_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LR-Cqe44mcQ7kNvwEkhK31&_nc_oc=AdkHKlhIfS0sC0FJn6qh_qxX2Fvvir83HZ8EUK3QOfBENg931rVnH1lxsSdSJevzR_0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwklaM932RfJ95orIo9TtMvqTONFO6N62bOUsFQq_qtuw&oe=69BD460E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Verbal De-escalation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "47808930
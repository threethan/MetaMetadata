UpcVRd8KrnWRKFrkDM4oAtXvgcxd78mLE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cFbC3DCDo6-2W-Y4PrroFihdFPefVngtChy0dylRKEw&oe=6A47E3B1"}, {"file_name": "v3.png", "id": "464389309430051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_464389312763384_9069537642276165631_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-37RoVXwcI4Q7kNvwHtKFvc&_nc_oc=AdrTVikiDyah-vuFRfrJPFJLJPyQLdV8qA3XhW0Cktq_K0rRVFqc_5OR0J0Zrp9Zsfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_vAZBmj2CX4n_6yvgLp20xG6a1prYx7Fz_E8bCUiULA&oe=6A47BC38"}, {"file_name": "v4.png", "id": "8325219104273613", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982708_8325219110940279_5950254241398881098_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZmiGfY1AOYQ7kNvwFDrLI9&_nc_oc=Ado6stCKm7-f1jd8DTfbnyXQSIYBTlFyIRYn438bdDN9KkU_1qYyDKRVhKrkBzKsIoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LT9YYb4IKyNROJAkvctHA7UuImflTZ4HxbIJU9e7aQQ&oe=6A47D3C8"}, {"file_name": "v2.png", "id": "444768718246772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974839_444768721580105_7005804818555441484_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sfPW18z0VoQ7kNvwE1qMDm&_nc_oc=AdrRMN2f9evng3q2gnohpTXNOF7O34XGNNY1ggv-nFifDNKb2GDbDOqN5_YdI58N-pE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fRGNYNF8LX8A7Anx82689ezbweBO96r0kjw62jkB7Gw&oe=6A47D8E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8955226571188930"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "988422324161348"}, {"status": "PUBLISHED", "id": "1002675308297827"}]}, "baseline_offer": {"id": "988422324161348"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781268600, "status": "PUBLISHED", "id": "988422324161348"}]}, "liveChannel": {"nodes": [{"latest_supported_binary"
com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEBLWiYDRkUQ7kNvwGoP4bf&_nc_oc=Adq62cZ10bCgiK6vt6hHABJt_LjDuXp1Q4FILMCqkzf2uVRmWvZ-ZlAqt4kpFPYKT8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28IiLzug7E82HmXci10WPP0B52DLXeXurFHMvo2RJPpg&oe=69D4EF82"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QFd3z00JvAQ7kNvwENZkos&_nc_oc=AdrPl8ZoeHSQqyNGR9KKhh4-FMJ5WrfeXtPG4XHDTlKyrGwKPncwZ2DjUAArrE0uDws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f4Aa1ihjYqEftXTRgiSxiOIGYnDK-XKEBwVVrSBTphQ&oe=69D5067E"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EX5Yvuvt8wQ7kNvwEFeDnm&_nc_oc=AdraXw43g-IK44fRI49DJVs9eebPbdgYiRsOdh6f5ksqG11ViEWC2kT2tf8uTlVF8cs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g2zV-Bk9_z-aIL-D2ZwjdEU85cecsvxBvxkWci8gjZQ&oe=69D4F308"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verb
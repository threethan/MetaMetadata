1YaP3-506mEbu5ZpYyl38NBTHeSuvKT20fxNXg4SX_UTDBKxpcRyJc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5mThisQy_hNMeey6_dzM7v0Ev36Lve-Heb3FMorZ4Eg&oe=69C12902"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXpKbRXm6NMQ7kNvwEFgClX&_nc_oc=Ado9ZhF-V_1RYzvPE3dRAQ5fDBTH7rpl4oIe_XRegA6URVjUIXzOF1iP9tEhZkSa1jI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYqMbhOL64jVlEwrgkl6NH0L-hmQwgoc39_7WR1b-4Vg&oe=69C13FFE"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-LHdMDEqy4Q7kNvwHZ5X3W&_nc_oc=AdoGsTNN7LamCkIkPsBXazf5QnOOewAxndBSWdJ2My9qdSYgqCKMb6zcLLFTJf5jxUA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwu0PEDIhZl9tqv0olZ6Mvn_Lr4naN60f_GRLSSYfza0w&oe=69C12C88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medication. As a nurse, the first task is to apply de-escalation techniques to calm down the patient.\n\nThis VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "This VR simulation for verbal de-escalation is designed to provide practitioners practice in managing and de-escalating tensed situations like an uncooperative patient. It helps test learners on their patient management and critical thinking skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24626088823676119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499293658_24629606386644447_784528995680490684_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4Vms1eyL6QQ7kNvwFHJrv-&_nc_oc=AdoDcoWnUguEVF3cleWll4ImPStVx2aQiGhAj7cs9QWiCxDChJgA93vW7Hg6ft_H86k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzXoaQ4fzw-VN6yWiYMw43uHPhIEv1Leoh5HzIN2keK-g&oe=69C13A8E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Verbal De-escalation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "47808930
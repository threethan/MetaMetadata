, {"file_name": "com.oculus.vrshell-20250819-180017.png", "id": "1883034135895438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296296_1883034139228771_2099861060717361001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsUP_FaEpkwQ7kNvwHcJFM4&_nc_oc=AdrME80PG-Y_vRyqObNBJDFaVSsYNFUmpg2k519h8ZrMcQ1GeGRn-jXMiHuRMX_KEBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M22eiiO-q5i1oSeWwOxI5fBA-DndspOAXvnzKPWvE5g&oe=69E0CD02"}, {"file_name": "com.oculus.vrshell-20250819-180308.png", "id": "1208314801050077", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293844_1208314804383410_1046346970609002813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfg6Tq-QUNUQ7kNvwHg60Ep&_nc_oc=AdrbSkgTSH-lnGriPw_EqZZCBHrjeM4gw86lLhgKY2pLkmLWDLqxNOkA4fmLBBe2eVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sVn-vcswZSInL9iMuV6zq8D_G06aEMiTaYs0JpILnpw&oe=69E0E3FE"}, {"file_name": "com.oculus.vrshell-20250819-180053.png", "id": "3401322753353767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620513_3401322760020433_2480182061215844918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Qf9A7gcnG0Q7kNvwF6tAo7&_nc_oc=Adq6KyqAWZJ9qeLUWnwH6NwXN852chWNKpPodIsT87ecpcE5pCnlMA-5tw86I_KyUoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ui9f3xjSGe6lbvuWwl1ObHjALTBaKxMcXbncKYJJmTw&oe=69E0D088"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Verbal De-escalation", "keywords": ["Medvr", "Education", "verbal", "deescalation", "VR"], "long_description": "68-year-old Robert Johnson has been admitted for complications related to his chronic obstructive pulmonary disease (COPD). He is also on medication to manage his anxiety and depression. Currently he is on oxygen therapy as he was experiencing increased shortness of breath. When the nurse approaches him, he appears agitated and starts shouting at the nurse, making it difficult to check his vitals or administer medica
rSzksaBRaXvw&oe=6AEC8AE0"}, {"file_name": "SS-4.png", "id": "3057714254560728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823783_3057714261227394_3435111403424638299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R9UDQV-EtUQ7kNvwHQYoUJ&_nc_oc=AdqyPvA1aL8zIFAzYbEopZHmNA0pYrzpFtEvc44c1srXTn6pl16kLETcnyrr0kmeJkw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO2eToIJZwIQfxZcVAtnRlbLlbhDHNl9CTxSGTbfMLLA&oe=6AECB339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-2560-1440.png", "id": "1545850526790618", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831279_1545850530123951_3379948765234100242_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJXbfVAN284Q7kNvwFK-RX0&_nc_oc=AdrE1W9FDrCpOq8x3ZYxBrfUQ1EsXYBDtDIlVSWw1yZEpJJVn9BmuQgdyjwtsPqG3t4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCcEB0bGRjHZ9Vjjgr4hXvti3GvQSx3s1EQXCk3X7_7w&oe=6AECB9DA"}, "display_name": "Gas Station Chaos VR", "keywords": ["GasNCar", "GasStation", "Car", "Chaos", "Fuel"], "long_description": "# Welcome to the messiest Gas Station in VR! \u26fd\n\nRun your own station, serve a nonstop line of strange customers, and decide every shift: do the job properly, or turn the whole place upside down.\n\n**\u26fd Fuel Cars & Serve Customers**\n\nGrab the nozzle, fill up tanks, take payment and keep the queue moving. Fast, clean service means bigger tips and happier drivers or you can \"accidentally\" spray fuel across the lot and watch it all fall apart.\n{1480212097474567}\n\n**\ud83e\uddfc Wash, Repair & Restore Vehicles**\n\nScrub off dirt, swap damaged parts, fix engines and hand back cars in better shape than they arrived. Quality work builds your reputation and unlocks better-paying jobs.\n{2292202898283904}\n\n**\ud83d\udd27 Wreck, Grab & Go Wild**\n\nOr don't fix anything at all. Pull parts off cars, smash windows, prank the drivers and see how far you can push before someone notices. Every shift is a physics playground.\n{1407453281277525}\n{1009792685219800}\n\n**\ud83d\ude9a Keep Your Tanks Full**\n\nYour station's fuel supply runs out as you serve. When the tank hits empty, call in the fuel truck and pay out of your own earnings to refill it. Manage your cash carefully no fuel means no customers, and no customers means no money.\n{1368775175320429}\n\n**\ud83d\udce6 Unlock New Gear From Deliveries**\n\nSpend your earnings on fresh tools, gadgets, station upgrades and unlockable equipment. Each new item opens up another way to work or another way to cause trouble.\n{2240456520037041}\n\n**\ud83d\ude94 Track Down Wanted Drivers**\n\nKeep an eye on the lineup. Some customers are on the sheriff's list spot them, stop them, and cash in the bounty.\n{1751464029403820}\n\nSandbox chaos, silly physics, and a station that's yours to run\u2026 or ruin.", "short_description": "Fuel, wash and repair cars in VR or wreck them. Refill your tanks, unlock tools, catch wanted drivers, and run your station your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
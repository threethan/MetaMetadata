qXk55USTuSY4L6GZXh4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXdxiLk-jt3Q7N7_dIgvaL-nMcxn5Wt8o-YV_GDLQnjg&oe=6A58EE94"}, {"file_name": "image 918.png", "id": "920586690951916", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827601_920586694285249_175135595857101336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-ZbYTkPYzUQ7kNvwEVPeXt&_nc_oc=Adp9-GRO6-JzncMDTya0mvj3oosaA-9d42-PIiPgTJKgd-qfQh7ew174ODDRhnialwM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn0riWubQ6AMVOiuJn2zOW3mruA4T9KXGmRDEnhFzTEA&oe=6A58DC8C"}, {"file_name": "image 915.png", "id": "1650105163080501", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824318_1650105166413834_6019090749993835658_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG2Ausx_udYQ7kNvwGTWuz0&_nc_oc=AdrR4ZXRQkrOuPo14hM94VRf3qNdyzsqwUoSCadxvypMNRqKhIPXhIoKCX81XIQ0ONU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbwyaSxOC6mF1OIMTa52BwkbZ5A9cGmC0rKqelvE3zWA&oe=6A58EC78"}, {"file_name": "image 916.png", "id": "2444576579310258", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499308131_2444576582643591_5384632134913691701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GltreOw0ctYQ7kNvwGep58a&_nc_oc=AdrOsC50w7ikcN6HAoxAqkoUDmHXiF8AxoVniKSP-bAb87DZPipQlqmpEgQwwop7bP0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTIVFo460gHqcD_YY-Dyyz5DHrGY4lhHYhNPBUECM9Zg&oe=6A58F740"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XReadyLab VR Physics: Thermodynamics", "keywords": ["Physics", "STEM", "school", "education", "laboratory"], "long_description": "What students do in VR:\nManipulate gas containers \u2192 change pressure, volume, and temperature in real time\nGenerate and analyze P\u2013V and P\u2013T graphs \u2192 interpret system changes\nSimulate isothermal, isobaric, and isochoric processes \u2192 compare conditions\n\nWhat students learn:\nRelationship between pressure, volume, and temperature of gases\nInterpretation of pressure\u2013volume (P\u2013V) and pressure\u2013temperature (P\u2013T) diagrams\nIsothermal, isobaric, and isochoric processes\n\nFor Schools\n\nAligned with IB, NGSS, TEKS, College Board, Cambridge, CBSE, and other international and national curricula.\n\nIncludes:\n\nReady-to-use Lesson Plans and Engagement Playbooks\nStructured guidance for classroom implementation:\nBefore, during, and after VR simulation\nGroup organization and activity design\nKey topics, simulation objectives, and instructional support\nReflection questions, analytical tasks, and practical assignments\nAssessment tools and troubleshooting checklist\n\nSupports both classroom use and home learning.", "short_description": "Interactive VR physics lab focused on gas laws and thermodynamic processes. This VR physics simulation allows students to explore how pressure, volume, and temperature are related, and how gases behave under different conditions using kinetic particle theory.\n\nDesigned to help students understand thermodynamic systems, energy transfer, and gas behavior through direct interaction, measurement, and visual analysis."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xreadylab.com/privacy-policy-thermodynamics-simulation/", "developer_terms_of_service_url": null, "publisher_name": "XReadyLab", "support_website_url": null, "website_url": "https://xreadylab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
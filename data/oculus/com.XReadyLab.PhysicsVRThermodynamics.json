kbZ5A9cGmC0rKqelvE3zWA&oe=6A58EC78"}, {"file_name": "image 916.png", "id": "2444576579310258", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499308131_2444576582643591_5384632134913691701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GltreOw0ctYQ7kNvwGep58a&_nc_oc=AdrOsC50w7ikcN6HAoxAqkoUDmHXiF8AxoVniKSP-bAb87DZPipQlqmpEgQwwop7bP0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTIVFo460gHqcD_YY-Dyyz5DHrGY4lhHYhNPBUECM9Zg&oe=6A58F740"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XReadyLab VR Physics: Thermodynamics", "keywords": ["Physics", "STEM", "school", "education", "laboratory"], "long_description": "What students do in VR:\nManipulate gas containers \u2192 change pressure, volume, and temperature in real time\nGenerate and analyze P\u2013V and P\u2013T graphs \u2192 interpret system changes\nSimulate isothermal, isobaric, and isochoric processes \u2192 compare conditions\n\nWhat students learn:\nRelationship between pressure, volume, and temperature of gases\nInterpretation of pressure\u2013volume (P\u2013V) and pressure\u2013temperature (P\u2013T) diagrams\nIsothermal, isobaric, and isochoric processes\n\nFor Schools\n\nAligned with IB, NGSS, TEKS, College Board, Cambridge, CBSE, and other international and national curricula.\n\nIncludes:\n\nReady-to-use Lesson Plans and Engagement Playbooks\nStructured guidance for classroom implementation:\nBefore, during, and after VR simulation\nGroup organization and activity design\nKey topics, simulation objectives, and instructional support\nReflection questions, analytical tasks, and practical assignments\nAssessment tools and troubleshooting checklist\n\nSupports both classroom use and home learning.", "short_description": "Interactive VR physics lab focused on gas laws and thermodynamic processes. This VR physics simulation allows students to explore how pressure, volume, and temperature are related, and how gases behave under different conditions using kinetic particle theory.\n\nDesigned to help students understand thermodynamic systems, energy transfer, and gas behavior through direct interaction, measurement, and visual analysis."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xreadylab.com/privacy-policy-thermodynamics-simulation/", "developer_terms_of_service_url": null, "publisher_name": "XReadyLab", "support_website_url": null, "website_url": "https://xreadylab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26555732397448854"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "966588369272316"}]}, "baseline_offer": {"id": "966588369272316"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774547580, "status": "PUBLISHED", "id": "966588369272316"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26521145854240842", "version": "2.1.3"}, "id": "1195244212722276", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26000634739625292", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26521145854240842"}, "release_status": "RELEASED"}, "binary_release_chann
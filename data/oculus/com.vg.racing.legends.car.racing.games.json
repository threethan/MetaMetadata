{"data": {"node": {"__typename": "Application", "id": "32963036933294573", "organization": {"id": "875784642289398", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26284596184538347"}]}, "id": "4227995920849727"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26131362596472316"}]}, "id": "1470273441283671"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25961992680123475"}]}, "id": "894620013345458"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26266739576243485"}]}, "id": "1275260831195141"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "32992940870351444"}]}, "id": "2950987335096251"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25171410259210873"}]}, "id": "1558913495251431"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "32879906881624343"}]}, "id": "1625321481961619"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25013175685050565"}]}, "id": "1365928914992417"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "32963036933294573"}]}, "id": "845484844895448"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24823524320683584"}]}, "id": "1168208654957526"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25327207263586857"}]}, "id": "3830774870562441"}]}}, "firstRevision": {"nodes": [{"application": {"id": "32963036933294573", "release_date": 1766058240, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 7}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33166511442947120"}, "id": "1524310399319728"}]}}, "binary": null, "live_binary": null, "created_date": 1778733444, "id": "35892626980335539", "is_initial_release": false, "name_with_fallback": "v3", "pdp_metadata_with_fallback": {"version": 3, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "35892727843658786"}, "release_status": "RELEASED", "id": "32963036933294573"}, "id": "35892727843658786", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "32963036933294573", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1199457252250622"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1999302650712490", "locale": "da_DK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racing Legends - Motorvejs Bilracerspil", "keywords": ["Motorvej", "Racing", "Konkurrence", "Hastighed", "Simulator"], "long_description": "Tag dit headset p\u00e5 og hop ind i f\u00f8rers\u00e6det! Racing Legends \u2013 Highway Car Racing Games forvandler din Meta Quest til et komplet racercockpit med medrivende VR-kontrol, hurtig trafik og intens motorvejsaction.\nUndvig biler, drift gennem trafikken, og pres din bil til gr\u00e6nsen p\u00e5 lange motorveje, neonbyer, \u00f8rkener og bjergbaner. Hvert l\u00f8b f\u00f8les realistisk med bev\u00e6gelse, autentisk lyd og cockpitvisning, der placerer dig direkte inde i bilen.\nTjen m\u00f8nter, l\u00e5s nye superbiler op, tilpas dine biler, og klatr op ad ranglisten. Uanset om du jagter highscores eller bare nyder farten \u2014 giver denne VR-motorvejsoplevelse dig ren adrenalin fra start til slut.\nEr du klar til at dominere motorvejen? Sp\u00e6nd sikkerhedsselen og hold godt fast \u2014 din legende begynder nu!\n\nKey Features\n- Realistisk VR-cockpitk\u00f8rsel og styringskontrol\n- Motorvejsr\u00e6s med trafik og overhalingsudfordringer\n- Flere biler at l\u00e5se op\n- Realistiske motorlyde og medrivende effekter\n", "short_description": "Racing Legends bringer h\u00f8jhastigheds VR-motorvejsr\u00e6s til live! Overhal trafikken, m\u00e6rk adrenalinsuset, og mestre realistisk styring mens du konkurrerer p\u00e5 endel\u00f8se veje og dynamiske dag- og natbaner. L\u00e5s biler op, opgrader ydeevnen, og bliv den ultimative motorvejsracerlegende!\n"}, {"images": {"nodes": []}, "id": "1580635676820522", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racing Legends - Snelweg Autoracespellen", "keywords": ["Snelweg", "Racing", "Superauto\u2019s", "Competitie", "Snelheid"], "long_description": "Zet je headset op en neem plaats achter het stuur! Racing Legends \u2013 Highway Car Racing Games verandert je Meta Quest in een complete racecockpit met meeslepende VR-besturing, druk verkeer en intense snelwegactie.\nOntwijk auto\u2019s, drift door het verkeer en duw je wagen tot het uiterste op lange snelwegen, neonsteden, woestijnen en bergachtige circuits. Elke race voelt realistisch aan dankzij beweging, authentieke geluiden en een cockpitweergave die je midden in de auto plaatst.\nVerdien munten, ontgrendel nieuwe supercars, pas je voertuigen aan en klim omhoog op het scorebord. Of je nu op jacht bent naar een hoge score of gewoon van snelheid houdt \u2014 deze VR-snelwegrace-ervaring levert pure adrenaline van begin tot eind.\nBen jij klaar om de snelweg te domineren? Maak je vast en houd je stevig vast \u2014 jouw legende begint nu!\n\nKey Features\n- Realistische VR-cockpitbesturing en rijcontrole\n- Snelwegraces met verkeer en inhaaluitdagingen\n- Meerdere auto\u2019s om vrij te spelen\n- Realistische motorgeluiden en meeslepende effecten", "short_description": "Racing Legends brengt supersnelle VR-snelwegraces tot leven! Haal verkeer in, voel de adrenalinekick en beheers realistische besturing terwijl je racet op eindeloze wegen en dynamische dag- en nachtbanen. Ontgrendel auto\u2019s, verbeter prestaties en word de ultieme snelwegracelegende! \n"}, {"images": {"nodes": [{"file_name": "Untitled design.png", "id": "1547084619946593", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1547084626613259_8994567575115839726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxqZremOF_QQ7kNvwEGSPlJ&_nc_oc=AdpRIXxqdSKIM1bbJSv1viG6MEcg9uEnbaBVBZAlNRQu57d0j60GaBRvCIeBHCo2N2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E8y0qwKRgDOAlFdt00J6HDmfGx-RtBxGNwmGXn0_O4g&oe=6A3EA663"}, {"file_name": "Untitled design (2).png", "id": "1442092574584730", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1442092581251396_2395093239362393241_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF_Gw7DupyQQ7kNvwFeKPEl&_nc_oc=AdqxFn995eqzFY4LaJS6tXotKjOWP0nHNIrQcAeRdKqENYyrpoWwY3e5s5-7Z_ml1Ak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PNqQRUxAGYz_3J9x0eMnIZ_zt_P-CJdSotbWjeEw-0A&oe=6A3E811A"}, {"file_name": "Highway car racing SS.png", "id": "1415583233293436", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300678_1415583236626769_7400727793058366099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOsRJBwoVIcQ7kNvwFmuprv&_nc_oc=AdrEUrEexDD3W7AOM9lmG_AgiKwPZGXmeWoGqHHCq5bUWBmV454la12A_HIwbtn4lP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0zHlECq3I0qA2vy9BCHIWUnJm7dxwV3xCjfu1INbOzg&oe=6A3EA75E"}, {"file_name": "Untitled design (1).png", "id": "1362633634846673", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823910_1362633641513339_4110837046007613467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPdGiP-py4QQ7kNvwEsDw_2&_nc_oc=Adqq3EOeTxN82WK9CFMeE_Zk0U8ur-sBN7Qx1h1BvVGVTtk
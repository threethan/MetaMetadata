-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xXXOTJX3exJULSJOAUlzgrgEKkic1YwrVBRUUPc_bsQ&oe=6A184AC4"}, {"file_name": "Screenshot 2025-12-10 081132.png", "id": "1833614621363573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1833614624696906_8787197337241278715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oenAuDdtU-4Q7kNvwETfMWk&_nc_oc=Adp7ZJVPwadkzbIbiQm4_6Depd2BWCqL9_OpL2O8G0F0rTPfWxWjs8ZWZW-XBQwRIxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6poCeXcuXpQKv1yeQn36u6njXqfIVHwqT3WdHFphgpfw&oe=6A1830DC"}, {"file_name": "Screenshot 2025-12-10 080737.png", "id": "1352487566328051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1352487569661384_2369858932751589385_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuBdZ2KBx4oQ7kNvwGlgLQ3&_nc_oc=Adq0QD9epqO_iQcE1dTtP6WZHeVV6yGkwuHoZVTaFyyQ1xhvG0YlBV721-daMC36-HM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fLVcQDV7G0f47BSTw2B4IHHkSEQ3Y4LiwOALFjXOu-A&oe=6A183B4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racing Legends- Highway Car Racing Games", "keywords": ["racing", "highway", "driving", "car", "speed"], "long_description": "Put on your headset and jump into the driver\u2019s seat! Racing Legends \u2013 Highway Car Racing Games transforms your Meta Quest into a full racing cockpit with immersive VR handling, fast traffic, and intense highway action.\n\nDodge cars, drift through traffic, and push your car to its limits on long highways, neon cities, deserts, and mountain tracks. Each race feels real with motion, authentic sound, and cockpit view that puts you inside the car.\n\nEarn coins, unlock new supercars, customize your ride, and climb the leaderboard. Whether you\u2019re chasing high score or just enjoying the speed \u2014 this VR highway racing experience gives you pure adrenaline from start to finish.\n\nAre you ready to rule the highway? Strap in, hold tight\u2014your legend begins now!\n\n**Key Features**\n- Real VR cockpit driving and steering controls\n- Highway racing with traffic and overtaking challenges\n- Multiple cars to unlock\n- Real engine sounds and immersive effects", "short_description": "Racing Legends brings high-speed VR highway racing to life! Overtake traffic, feel the rush of adrenaline, and master realistic steering while competing on endless roads and dynamic day-night tracks. Unlock cars, upgrade performance, and become the ultimate highway racing legend!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33189465387318392"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1463837781848392"}, {"status": "PUBLISHED", "id": "3066774563711265"}, {"status": "PUBLISHED", "id": "2729173440762934"}, {"status": "PUBLISHED", "id": "1245399270736541"}, {"status": "PUBLISHED", "id": "25557892790511942"}, {"status": "PUBLISHED", "id": "4303952666526330"}]}, "baseline_offer": {"id": "4303952666526330"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "146
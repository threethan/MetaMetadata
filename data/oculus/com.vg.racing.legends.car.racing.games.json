=6A3E8089"}, {"file_name": "3.png", "id": "851410487800271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310817_851410491133604_6116200042648256107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZclCaoJETmIQ7kNvwGCIFvn&_nc_oc=AdqyIZ-qV5pWF7PMFDPrH5JES74BnxRQo6w5MukC0NMVEDA0PpTsc1_76cOBVHy5hEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88KavMhNxep0HjGKnp0SLr8G1okn0okenZDaxAX4FJmQ&oe=6A3E8282"}, {"file_name": "5.png", "id": "1222400079800255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305194_1222400083133588_2166269982719955146_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccUqkpA-nC8Q7kNvwFD2W6t&_nc_oc=AdpsIW8YeLVMvYvxEhLsb93SIhuYc0lI1-ra5Sf2A2LpRYWlu1KHm3Wv95cGUCOihRw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af920DpocMF318pkAi61RatoT5d2LTh_vDycOpGYqD4WKQ&oe=6A3E846D"}, {"file_name": "4.png", "id": "1158810333032942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298502_1158810336366275_1311154636908376448_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCyenX32KzEQ7kNvwEXvPqf&_nc_oc=AdpnesCdn8BjHPzZoWSZSyPeP6HgbL1KfFw6sj6c57eKd5hXzwwKSud9UIaPEfhKv_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iWCotM5gCCoFVjX1v3iJO5s5AD_AJzSN1jQdKkr5_2g&oe=6A3E7718"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racing Legends- Highway Car Racing Games", "keywords": ["racing", "highway", "driving", "car", "speed"], "long_description": "Put on your headset and jump into the driver\u2019s seat! Racing Legends \u2013 Highway Car Racing Games transforms your Meta Quest into a full racing cockpit with immersive VR handling, fast traffic, and intense highway action.\n\nDodge cars, drift through traffic, and push your car to its limits on long highways, neon cities, deserts, and mountain tracks. Each race feels real with motion, authentic sound, and cockpit view that puts you inside the car.\n\nEarn coins, unlock new supercars, customize your ride, and climb the leaderboard. Whether you\u2019re chasing high score or just enjoying the speed \u2014 this VR highway racing experience gives you pure adrenaline from start to finish.\n\nAre you ready to rule the highway? Strap in, hold tight\u2014your legend begins now!\n\n**Key Features**\n- Real VR cockpit driving and steering controls\n- Highway racing with traffic and overtaking challenges\n- Multiple cars to unlock\n- Real engine sounds and immersive effects", "short_description": "Racing Legends brings high-speed VR highway racing to life! Overtake traffic, feel the rush of adrenaline, and master realistic steering while competing on endless roads and dynamic day-night tracks. Unlock cars, upgrade performance, and become the ultimate highway racing legend!"}, {"images": {"nodes": []}, "id": "1030324839666695", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racing Legends - Snelweg Autoracespellen", "keywords": ["Snelweg", "Racing", "Superauto\u2019s", "Competitie", "Snelheid"], "long_description": "Zet je headset op en neem plaats achter het stuur! Racing Legends \u2013 Highway Car Racing Games verandert je Meta Quest in een complete racecockpit met meeslepende VR-besturing, druk verkeer en intense snelwegactie.\nOntwijk auto\u2019s, drift door het verkeer en duw je wagen tot het uiterste op lange snelwegen, neonsteden, woestijnen en bergachtige circuits. Elke race voelt realistisch aan dankzij beweging, authentieke geluiden en een cockpitweergave die je midden in de auto plaatst.\nVerdien munten, ontgrendel nieuwe supercars, pas je voertuigen aan en klim omhoog op het scorebord. Of je nu op jacht bent naar een hoge score of gewoon van snelheid houdt \u2014 deze VR-snelwegrace-ervaring levert pure adrenaline van begin tot eind.\nBen jij klaar om de snelweg te domineren? Maak je vast en houd je stevig vast \u2014 jouw legende begint nu!\n\nKey Features\n- Realistische VR-cockpitbesturing en rijcontrole\n- Snelwegraces met verkeer en inhaaluitdagingen\n- Meerdere auto\u2019s om vrij te spelen\n- Realistische motorgeluiden en meeslepende effecten", "short_description": "Racing Legends brengt supersnelle VR-snelwegraces tot leven! Haal verkeer in, voel de adrenalinekick en beheers realistische besturing terwijl je racet op eindeloze wegen en dynamische dag- en nachtbanen. Ontgrendel auto\u2019s, verbeter prestaties en word de ultieme snelwegracelegende! \n"}, {"images": {"nodes": []}, "id": "1008397565193519", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racing Legends - D\u00e1lni\u010dn\u00ed Z\u00e1vodn\u00ed Hry s", "keywords": ["Superauta", "Rychlost", "Sout\u011b\u017e", "Z\u00e1vod\u011bn\u00ed", "D\u00e1lnice"], "long_description": "Nasa\u010fte si headset a usedn\u011bte za volant! Racing Legends \u2013 Highway Car Racing Games prom\u011bn\u00ed v\u00e1\u0161 Meta Quest v plnohodnotn\u00fd z\u00e1vodn\u00ed kokpit s pohlcuj\u00edc\u00edm VR ovl\u00e1d\u00e1n\u00edm, rychl\u00fdm provozem a intenzivn\u00ed d\u00e1lni\u010dn\u00ed akc\u00ed.\nVyh\u00fdbejte se aut\u016fm, driftujte mezi provozem a dosta\u0148te sv\u00e9 auto na maximum na dlouh\u00fdch d\u00e1lnic\u00edch, v neonov\u00fdch m\u011bstech, pou\u0161t\u00edch a horsk\u00fdch trat\u00edch. Ka\u017ed\u00fd z\u00e1vod p\u016fsob\u00ed realisticky d\u00edky pohybu, autentick\u00fdm zvuk\u016fm a pohledu z kokpitu, kter\u00fd v\u00e1s vt\u00e1hne p\u0159\u00edmo do auta.\nSb\u00edrejte mince, odemykejte nov\u00e9 supersporty, upravujte sv\u00e9 vozy a stoupejte v \u017eeb\u0159\u00ed\u010dku nejlep\u0161\u00edch hr\u00e1\u010d\u016f. A\u0165 u\u017e hon\u00edte nejvy\u0161\u0161\u00ed sk\u00f3re nebo si jen u\u017e\u00edv\u00e1te rychlost \u2014 tento VR z\u00e1vodn\u00ed z\u00e1\u017eitek v\u00e1m p\u0159inese \u010dist\u00fd adrenalin od za\u010d\u00e1tku do konce.\nJste p\u0159ipraveni ovl\u00e1dnout d\u00e1lnici? P\u0159ipoutejte se a pevn\u011b dr\u017ete volant \u2014 va\u0161e legenda pr\u00e1v\u011b za\u010d\u00edn\u00e1!\n\nKey Features\n- Realistick\u00e9 VR \u0159\u00edzen\u00ed a ovl\u00e1d\u00e1n\u00ed z kokpitu\n- D\u00e1lni\u010dn\u00ed z\u00e1vody s hust\u00fdm provozem a p\u0159edj\u00ed\u017ed\u011bn\u00edm\n- V\u00edce aut k odem\u010den\u00ed\n- Realistick\u00e9 zvuky motor\u016f a pohlcuj\u00edc\u00ed efekty\n", "short_description": "Racing Legends p\u0159in\u00e1\u0161\u00ed vysokorychlostn\u00ed VR z\u00e1vody na d\u00e1lnic\u00edch! P\u0159edj\u00ed\u017ed\u011bjte provoz, za\u017eijte p\u0159\u00edval adrenalinu a ovl\u00e1dn\u011bte realistick\u00e9 \u0159\u00edzen\u00ed p\u0159i z\u00e1vodech na nekone\u010dn\u00fdch silnic\u00edch a dynamick\u00fdch trat\u00edch ve dne i v noci. Odemkn\u011bte auta, vylep\u0161ujte v\u00fdkon a sta\u0148te se ultim\u00e1tn\u00ed legendou d\u00e1lni\u010dn\u00edch z\u00e1vod\u016f!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35892727843658786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
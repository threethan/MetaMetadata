UZVPoPDCs68yfISOJwsGTKMtLHW09CA9cZy-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLuy61NpHi-2J-W0K9b6k2yzkFUmP8mzkOpXi-gAI_Sw&oe=6A86EBDD"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_LxRYmdweAQ7kNvwGR_R-i&_nc_oc=AdqNpn3ufb0lcCKSARhGAJzJ_qBRqAeL066owEqrHUrmzACZBJ9jusjsbioupTHnd28&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdbRmjN3IQqPgvO641ONSyTxHtMZWB2ZxvsbuOIHLiPg&oe=6A86CF83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into the ultimate gaming display! **Horizon Stream** is a dedicated, open-source PlayStation Remote Play client built specifically for the Meta Quest ecosystem. \n\nWhether you want to play fast-paced shooters on a massive, theater-sized virtual screen or lay back and enjoy immersive RPGs while staying aware of your surroundings in mixed reality, this app delivers a seamless and highly optimized remote play experience straight from your PS4 or PS5.\n\n### Key Features:\n* **High-Performance Streaming:** Enjoy crisp, low-latency gameplay at 1080p (and HDR 4K on supported PS5 connections) with buttery-smooth 60fps frame rates.\n* **Immersive Virtual Displays:** Resize, reposition, and curve your screen anywhere in your physical space using Meta Quest's seamless window management.\n* **Native Controller Support:** Connect your DualSense or DualShock 4 controller directly to your headset via Bluetooth for precise, zero-compromise input.\n* **Open Source:** Fully transparent, ad-free, and community-driven. Horizon Stream complies with the AGPLv3 license and is built upon the renowned `chiaki-ng` project.\n\n*Disclaimer: This application is a third-party, open-source client. It is not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation\", \"PS5\", and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Experience your favorite PlayStation 4 and PlayStation 5 games on massive virtual screens in your Meta Quest headset with low-latency remote play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1321917184327955"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298387_4457419771191465_3373717246728062486_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU3P5wZVlX4Q7kNvwHzLEKe&_nc_oc=AdoYwx2Lh_xlAbN7HtM4B8qN33y4mlmTjG4YKGgXUNH-Wn_cb1wxCFp_0L0g-jy_wPI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF41A7jp05QptG-Qxh-AwirAPOe7ve1sjaVWFPHwE-1UA&oe=6A86F09A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horizon Stream for Playstation", "platform": "ANDROID_6DOF", "co
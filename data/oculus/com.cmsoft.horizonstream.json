7a0a&_nc_ohc=8zx8V-esa7EQ7kNvwHYL63a&_nc_oc=AdoaMHhCg8tRnA3OD4l1IpJO0nUIYCaHXsbzyvF_NFWcGsEQFA1EQE3I9fL-EYOSgFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7luavJWH5U0iZWSYduORPCMIw0iZRHqS2WBda6SSkCQ&oe=6AF20983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "1099898599104396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1099898602437729_8716243327825891942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUYV7IFnRCIQ7kNvwG3VZ3j&_nc_oc=AdrjO7YgYp7Z8dfgT2wfmrKdjNopoMUJ-sJVd-TXzjlWvTC79icIF7q60DE7QHmF9iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTdEl7-QA5qbeiqz0xDY-WKsSMGHTK3CiZU6Q7X4X4iw&oe=6AF1F584"}, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into a PlayStation display. **Horizon Stream** is an open-source Remote Play client for Quest 3, Quest 3S.\n\nPlay PS4 and PS5 games in flat view or immersive spatial mode on a large head-tracked screen with animated surroundings.\n\n### Key Features\n\n- **1080p/60fps:** Low-latency Remote Play, depending on your console, network, and headset.\n- **Guided setup:** Discover your console, allow camera access, sign in to PlayStation Network in Chrome with the Horizon Stream extension, then scan the one-time QR code in Quest.\n- **Saved PSN account:** Horizon Stream saves your Account ID so repeat setup skips the QR step and goes straight to PS5 Link Device pairing.\n- **Camera pairing:** Scan the eight-digit PS5 Link Device code through the Quest passthrough camera.\n- **Quest Touch controls:** Virtual PlayStation mapping for buttons, sticks, triggers, grips, D-pad, and Quest Menu.\n- **Bluetooth controllers:** Pair a DualSense, DualShock 4, or compatible gamepad with Quest.\n- **Optional AI depth:** Add simulated 3D depth; it may use more battery or show artifacts.\n- **Open source:** Ad-free, AGPLv3, and built on Chiaki/chiaki-ng.\n\nSee our setup tutorial at https://youtu.be/70w9avqWMr8\n\n*Horizon Stream is a third-party client, not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation,\" \"PS5,\" and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Play PS4 and PS5 games on immersive virtual screens in Meta Quest with low-latency Remote Play, guided setup, and Quest or Bluetooth controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426392203880452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593716858_2180303759185353_3812066210480513278_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw6Mg3o_anMQ7kNvwEJsiRm&_nc_oc=AdobzwCa2zjBgDnquqm1xMpnfcIs43-rls9-HoVSscrWlNtlrmzSxBNrwOkWE6KjJZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHk4Rzkcb-HNSE4H_amLlmGoUtZnqmJL6kRIzwf5Rxvw&oe=6AF1E661"}, "is_concept": 
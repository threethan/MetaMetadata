locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "911052678694394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593877129_911052682027727_4172099378348758025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRYitw9loLAQ7kNvwEAElwP&_nc_oc=Adr7DhTXp6aZcFKtzlyLok8D9Opzd3x7gL0hCwHxlwJeVssfgZbKl5JdEA0GMv6BkTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8lCidCZ5eN3Y1sz5PL_JuAPJgx4CJzhqG3d4NmGGTtw&oe=6AF73458"}, {"file_name": "screenshot2.png", "id": "2309821096513913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_2309821099847246_3431504175430180737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_YngHEMNZEQ7kNvwGA20eI&_nc_oc=AdojlXxl1F5cGp_-63EBTH9QoltOPNkZPd1yks_yr1kNA0mnopTEuevIstvo-KlUM3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5MO1wGXF-XegoypREmEzvG3P0tCDlRe0h12jAoNAbhA&oe=6AF738D5"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N84wlMZupqkQ7kNvwEETJpZ&_nc_oc=Adob8h5jJd_C7DYuPQc8TH6Dxfl9aEl-fIYzTZ4BuCYgNLALnRZ7TGi5F_xdkyxl_70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH7j6FmqfhPDYHoaivCsr-JU77ydkYgIcuFc-W_k8Emw&oe=6AF72719"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDkHr2rs7ugQ7kNvwHHWAqe&_nc_oc=AdpyUTBB9Qp5-izBn3_ULwu3wVxUpWpZICEvjIDt5pGCvfTjo1d_j1eFgIOBzryzHw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP9FrAKqfwC6DASub7HdkkMZ80YXwVWvd53ooCv2CRCg&oe=6AF7339D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lxc4N1-UNhoQ7kNvwHnaGJz&_nc_oc=Adq-tvkH3tMUBH64xQsB9aN98wDiVUQHK0maBn4GB2ommty94EOp4ND-USh-J9Yoql4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_BS2DyMp4qrotoaSB37AuqW_ciBs7FBzWSPiXxGuARg&oe=6AF71743"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "1099898599104396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1099898602437729_8716243327825891942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMH6eJfS-ZoQ7kNvwEe6yrQ&_nc_oc=AdqmuzKhGaet6zgw8wGhrIiXtFkuaodsL9ExqpRhJeNX6rV-j6VVTfn6QY7LvxqzGUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Gp1zabVJj01KymIqVBNR7-i2Cy3NO-OnVXAB3yauoA&oe=6AF73B84"}, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into a PlayStation display. **Horizon Stream** is an open-source Remote Play client for Quest 3, Quest 3S.\n\nPlay PS4 and PS5 games in flat view or immersive spatial mode on a large head-tracked screen with animated surroundings.\n\n### Key Features\n\n- **1080p/60fps:** Low-latency Remote Play, depending on your console, network, and headset.\n- **Guided setup:** Discover your console, allow camera access, sign in to PlayStation Network in Chrome with the Horizon Stream extension, then scan the one-time QR code in Quest.\n- **Saved PSN account:** Horizon Stream saves your Account ID so repeat setup skips the QR step and goes straight to PS5 Link Device pairing.\n- **Camera pairing:** Scan the eight-digit PS5 Link Device code through the Quest passthrough camera.\n- **Quest Touch controls:** Virtual PlayStation mapping for buttons, sticks, triggers, grips, D-pad, and Quest Menu.\n- **Bluetooth controllers:** Pair a DualSense, DualShock 4, or compatible gamepad with Quest.\n- **Optional AI depth:** Add simulated 3D depth; it may use more battery or show artifacts.\n- **Open source:** Ad-free, AGPLv3, and built on Chiaki/chiaki-ng.\n\nSee our setup tutorial at https://youtu.be/70w9avqWMr8\n\n*Horizon Stream is a third-party client, not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation,\" \"PS5,\" and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Play PS4 and PS5 games on immersive virtual screens in Meta Quest with low-latency Remote Play, guided setup, and Quest or Bluetooth controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426392203880452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593716858_2180303759185353_3812066210480513278_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9PcJ9jVG-EQ7kNvwEgt-OG&_nc_oc=AdodeIHcTINg7jW_Sds-7kcXKly_XOuJmmc8h0BBpl2RYYxTXhjSjnGI_UBQmSJ0NOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTspC-HnS04h2y8FkQxax44Z-W7J3QUMhhRYgN4d-7juQ&oe=6AF72C61"}, "is_concept": 
t=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUsxB9UBAz0Q7kNvwFgSN-z&_nc_oc=Adqh4N3nH0T3le2haDMqO1RC2rjtUlpoxWmA2g34dajWOahvQcAdEkqXmDEe1rYfHkA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdBuD-bdgbOMeHmrfh16kQgjWebA-zElUeI7fDBJffOA&oe=6AB27295"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8VG4tsnNToQ7kNvwHb5Obk&_nc_oc=AdoYjlGiOaqRCjx6q-_jJTOKxc6DW7w-R79zuUrEIpIa4Zt6mDRT9xPAHkqgZxf6AA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-EW_guG6YnLhQeDHsPaxR-em9V82sklBre5ayfp-uIQ&oe=6AB29919"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZaZmnMZBwoQ7kNvwFe4VQ2&_nc_oc=Adp5Mo5gaiDjmb1jpUK-OXOAtwkR4smoZ5AT4xRNlTGfYkppTm4B37QL_sDR10f1MNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGoPKY5NwZXGEb_4QQ9Ma8UtKOr-s6Nuv-WbY6VEB_hg&oe=6AB2A59D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU3j-2aPTjAQ7kNvwEqvD5Y&_nc_oc=Adrroc15fPVbetPyDvWSrlgLTXAzZI7C1WdR3ckingo9h2Q-nduFZ80ReUDak8RhX78&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEdXWhoRn6o7HE8xFsm6YWQiy_H7P6N2jBf7iXi0Rndg&oe=6AB28943"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into the ultimate gaming display! **Horizon Stream** is a dedicated, open-source PlayStation Remote Play client built specifically for the Meta Quest ecosystem. \n\nWhether you want to play fast-paced shooters on a massive, theater-sized virtual screen or lay back and enjoy immersive RPGs while staying aware of your surroundings in mixed reality, this app delivers a seamless and highly optimized remote play experience straight from your PS4 or PS5.\n\n### Key Features:\n* **High-Performance Streaming:** Enjoy crisp, low-latency gameplay at 1080p (and HDR 4K on supported PS5 connections) with buttery-smooth 60fps frame rates.\n* **Immersive Virtual Displays:** Resize, reposition, and curve your screen anywhere in your physical space using Meta Quest's seamless window management.\n* **Native Controller Support:** Connect your DualSense or DualShock 4 controller directly to your headset via Bluetooth for precise, zero-compromise input.\n* **Open Source:** Fully transparent, ad-free, and community-driven. Horizon Stream complies with the AGPLv3 license and is built upon the renowned `chiaki-ng` project.\n\n*Disclaimer: This application is a third-party, open-source client. It is not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation\", \"PS5\", and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Experience your favorite PlayStation 4 and PlayStation 5 games on massive virtual screens in your Meta Quest headset with low-latency remote play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1321917184327955"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1712350793299371"}]}, "baseline_offer": {"id": "1712350793299371"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786038300, "status": "PUBLISHED", "id": "1712350793299371"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1404848236034849", "version": "1.1.9"}, "id": "878891168138203", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1282152088304465", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404848236034849"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878891168138203"}]}, "change_log": "* Bug fixes and enhancements", "created_date": 1789683837, "id": "1404848236034849", "version": "1.1.9", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1282152088304465", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404848236034849"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878891168138203"}]}, "change_log": "New immersive onboarding makes first-time setup easier with guided PlayStation Network sign-in, QR scanning, PS5 pairing-code scanning, recovery guidance, and controller mapping help.\r\nSetup now retrieves account details automatically after sign-in and skips QR setup on future pairings.\r\nImproved headset camera scanning with a head-following, zoomed camera view for QR and pairing codes.\r\nAdded a richer immersive streaming experience with adjustable screen size, curved display mode, vertical and horizontal reorientation, and in-world settings.\r\nCurved immersive screens now default to 120% size.\r\nLong-press Menu/Options on Quest Touch or supported Bluetooth controllers to pause, then open immersive controls.\r\nBluetooth controllers can navigate immersive settings, PIN prompts, and recovery dialogs with the d-pad or left stick.\r\nAdded in-world controls for Quest controller support, AI 2D-to-3D depth, screen curve, size, and exiting the stream.\r\nImproved support for DualSense, DualShock 4, and other Bluetooth gamepads in immersive mode.\r\nFixed controller handoff issues, immersive-exit crashes, camera permission/setup reliability, and release-build crashes in QR scanning and AI depth processing.", "created_date": 1789488469, "id": "1400676299785376", "version": "1.1.8", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1282152088304465", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404848236034849"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878891168138203"}]}, "change_log": "New immersive onboarding makes first-time setup easier with guided PlayStation Network sign-in, QR scanning, PS5 pairing-code scanning, recovery guidance, and controller mapping help.\r\nSetup now retrieves account details automatically after sign-in and skips QR setup on future pairings.\r\nImproved headset camera scanning with a head-following, zoomed camera view for QR and pairing codes.\r\nAdded a richer immersive streaming experience with adjustable screen size, curved display mode, vertical and horizontal reorientation, and in-world settings.\r\nCurved immersive screens now default to 120% size.\r\nLong-press Menu/Options on Quest Touch or supported Bluetooth controllers to pause, then open immersive controls.\r\nBluetooth controllers can navigate immersive settings, PIN prompts, and recovery dialogs with the d-pad or left stick.\r\nAdded in-world controls for Quest controller support, AI 2D-to-3D depth, screen curve, size, and exiting the stream.\r\nImproved support for DualSense, DualShock 4, and other Bluetooth gamepads in immersive mode.\r\nFixed controller handoff issues, immersive-exit crashes, camera permission/setup reliability, and release-build crashes in QR scanning and AI depth processing.", "created_date": 1789486866, "id": "1400632523123087", "version": "1.1.7", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1282152088304465", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404848236034849"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878891168138203"}]}, "change_log": "Bug fixes and enhancements", "created_date": 1789355049, "id": "1397973203389019", "version"
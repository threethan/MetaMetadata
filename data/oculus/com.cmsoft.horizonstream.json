ements", "created_date": 1790301856, "id": "1417316238121382", "version": "1.1.10", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1282152088304465", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1428112830375056"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878891168138203"}]}, "change_log": "* Bug fixes and enhancements", "created_date": 1789683837, "id": "1404848236034849", "version": "1.1.9", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1282152088304465", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1428112830375056"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878891168138203"}]}, "change_log": "New immersive onboarding makes first-time setup easier with guided PlayStation Network sign-in, QR scanning, PS5 pairing-code scanning, recovery guidance, and controller mapping help.\r\nSetup now retrieves account details automatically after sign-in and skips QR setup on future pairings.\r\nImproved headset camera scanning with a head-following, zoomed camera view for QR and pairing codes.\r\nAdded a richer immersive streaming experience with adjustable screen size, curved display mode, vertical and horizontal reorientation, and in-world settings.\r\nCurved immersive screens now default to 120% size.\r\nLong-press Menu/Options on Quest Touch or supported Bluetooth controllers to pause, then open immersive controls.\r\nBluetooth controllers can navigate immersive settings, PIN prompts, and recovery dialogs with the d-pad or left stick.\r\nAdded in-world controls for Quest controller support, AI 2D-to-3D depth, screen curve, size, and exiting the stream.\r\nImproved support for DualSense, DualShock 4, and other Bluetooth gamepads in immersive mode.\r\nFixed controller handoff issues, immersive-exit crashes, camera permission/setup reliability, and release-build crashes in QR scanning and AI depth processing.", "created_date": 1789488469, "id": "1400676299785376", "version": "1.1.8", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1282152088304465", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1428112830375056"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878891168138203"}]}, "change_log": "New immersive onboarding makes first-time setup easier with guided PlayStation Network sign-in, QR scanning, PS5 pairing-code scanning, recovery guidance, and controller mapping help.\r\nSetup now retrieves account details automatically after sign-in and skips QR setup on future pairings.\r\nImproved headset camera scanning with a head-following, zoomed camera view for QR and pairing codes.\r\nAdded a richer immersive streaming experience with adjustable screen size, curved display mode, vertical and horizontal reorientation, and in-world settings.\r\nCurved immersive screens now default to 120% size.\r\nLong-press Menu/Options on Quest Touch or supported Bluetooth controllers to pause, then open immersive controls.\r\nBluetooth controllers can navigate immersive settings, PIN prompts, and recovery dialogs with the d-pad or left stick.\r\nAdded in-world controls for Quest controller support, AI 2D-to-3D depth, screen curve, size, and exiting the stream.\r\nImproved support for DualSense, DualShock 4, and other Bluetooth gamepads in immersive mode.\r\nFixed controller handoff issues, immersive-exit crashes, camera permission/setup reliability, and release-build crashes in QR scanning and AI depth processing.", "created_date": 1789486866, "id": "1400632523123087", "version": "1.1.7", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
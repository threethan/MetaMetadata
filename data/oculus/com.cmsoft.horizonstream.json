locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "911052678694394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593877129_911052682027727_4172099378348758025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GULNzZJihcQ7kNvwGHIxB9&_nc_oc=Adqe6X4hJMG8mpUjGBzWiuMM1SCGghY8KpJwtK1buOR8I9POpuGR1sIe8aXFGCp7YvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3zWITZ_5O2QkrNfNhZl7a5Ju1bzGt7DWEtxy7lTBHYw&oe=6AE0CAD8"}, {"file_name": "screenshot2.png", "id": "2309821096513913", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622916_2309821099847246_3431504175430180737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHHbWEhqSGQQ7kNvwFiKu2E&_nc_oc=AdpFdyDxlT6s4CCZuCw6-0mRq3Fs7sciopmTS13wZofF9xux8DOVilZPM7sS4FTz9QQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7C0rSDekdOzleTbedstH2OCuFXc_QAWwG0eC2I3ZKYQ&oe=6AE09715"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukW5iboAvz0Q7kNvwEM29fF&_nc_oc=AdoeTqLfNfMLlZIsLaHTJ_3fn-DMkLWI21gGrEbOw8E2dFe7vblNRYVDKtXtShz54ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNngoMJ-8QzOVGZuGdK9ANZTpnXkLWaOFOJ6cfMhRNGg&oe=6AE0BD99"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0IKK86w8mEQ7kNvwEy-QnR&_nc_oc=AdralaQULzu5-oBKa6QC9ARp_LYeXvUm786K0mpUAcaA9Rq2UVfOCnv9iR2UaNUvZYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMblxCQp09VwTmsu8BA8AWFa1yyO1wGeGMApKbBeVUZjA&oe=6AE0CA1D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lx4mxEB5OScQ7kNvwFLms0g&_nc_oc=Adr5U2pTMUIjzv0TDsDrLhuDFKzY7o8JXr9Q7x3vBU4rFxVHfiJfLhTyjfhL4kUTy4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3sAtEFURvEgX07Ewd6gzoALc4V4iD6CBhZsbE5VPBbQ&oe=6AE0ADC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "1099898599104396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623876_1099898602437729_8716243327825891942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL8NtnaFelsQ7kNvwGQkRHn&_nc_oc=Adpv3XXYUUL_FpUTYrIga4437rm700RdMdr5lcDYkbe_tVsqvnVALA76atrfkTYUSUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyJ6Y0N58UHzhViNiyNSEROZM99OHxKMQXaqxVpMyg7A&oe=6AE099C4"}, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into a PlayStation display. **Horizon Stream** is an open-source Remote Play client for Quest 3, Quest 3S.\n\nPlay PS4 and PS5 games in flat view or immersive spatial mode on a large head-tracked screen with animated surroundings.\n\n### Key Features\n\n- **1080p/60fps:** Low-latency Remote Play, depending on your console, network, and headset.\n- **Guided setup:** Discover your console, allow camera access, sign in to PlayStation Network in Chrome with the Horizon Stream extension, then scan the one-time QR code in Quest.\n- **Saved PSN account:** Horizon Stream saves your Account ID so repeat setup skips the QR step and goes straight to PS5 Link Device pairing.\n- **Camera pairing:** Scan the eight-digit PS5 Link Device code through the Quest passthrough camera.\n- **Quest Touch controls:** Virtual PlayStation mapping for buttons, sticks, triggers, grips, D-pad, and Quest Menu.\n- **Bluetooth controllers:** Pair a DualSense, DualShock 4, or compatible gamepad with Quest.\n- **Optional AI depth:** Add simulated 3D depth; it may use more battery or show artifacts.\n- **Open source:** Ad-free, AGPLv3, and built on Chiaki/chiaki-ng.\n\nSee our setup tutorial at https://youtu.be/70w9avqWMr8\n\n*Horizon Stream is a third-party client, not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation,\" \"PS5,\" and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Play PS4 and PS5 games on immersive virtual screens in Meta Quest with low-latency Remote Play, guided setup, and Quest or Bluetooth controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426392203880452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593716858_2180303759185353_3812066210480513278_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUo39fsKj5QQ7kNvwFMun9c&_nc_oc=AdqB5ugfmrau3M-gnbsj8FhKuO3ttgZkST2BODKj2vL8PdKA5PCcpKdCiEqL0WSSdWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Und0Ogz29ty7X2vSPN-0wA-v5Z8ixms1OCqCZw6fTA&oe=6AE0C2E1"}, "is_concept": 
locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "911052678694394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593877129_911052682027727_4172099378348758025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRYitw9loLAQ7kNvwEQ_uE0&_nc_oc=AdrZJdgV_j1XCjWmGjOQA8TW_0btyJBuVQXhRpOyVFVwnkftZhn5mMOZjA3K4SGQOAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLYMr-fEWbETCy00KxXS-GvvCO_d95kAMd978KK5jc_g&oe=6AF885D8"}, {"file_name": "screenshot2.png", "id": "2309821096513913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_2309821099847246_3431504175430180737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_YngHEMNZEQ7kNvwH9yzzQ&_nc_oc=AdrvjZzRPfPbQx-MqcAyCT4pN2CJwLyC8YwdhVJMpSaRm4HM4quoA2B8eHSagKLIBRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNROJfvUWaUuhoxsh03LIJKaifmeYB68b3bif2jhPufA&oe=6AF88A55"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N84wlMZupqkQ7kNvwFU3l5G&_nc_oc=Adr0S1KDBQuA8ZiwwUwOXbfSdJaXVqhletyq0b2C9R0gAEowgnNz2Nn_hBT9nWUPnpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS62JI_5c-ywdckfdtppfsJ4N4Ao2SUW5NWoer6-u-JgA&oe=6AF87899"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDkHr2rs7ugQ7kNvwHsBRtr&_nc_oc=AdptQB7fNuptpfQ4vmoFoNehd43eQCEyA40YzuOhfhhvpF-leqDkZyF07Fs8zEf3JyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJW8iRLXcL9CBYWKciBicx1G-2fMIlzpZYTUvEjGx66A&oe=6AF8851D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eXr1XAEYQQQ7kNvwG7-K_0&_nc_oc=AdpB58QQzoFuN7clujCoAmfX1mtNQi_vW_rOgwmvz4KLRAZlBcqjtq-eyPPXAGx5dDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSynFNX2xi4BshIZZK3d1roSEZwpFVY7g2aH19h4rwg6w&oe=6AF8A103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "1099898599104396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1099898602437729_8716243327825891942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMH6eJfS-ZoQ7kNvwFa_peg&_nc_oc=AdpAghMqMKD27ZTlaydBciIXFDiCl1t3j2osdAxcHZ16WqlhNV4WjT2WptF1iFBg6-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZRMbVzpth7aorILwGpfoSEQdPcHJ2ncF2XXXRkivIyw&oe=6AF88D04"}, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into a PlayStation display. **Horizon Stream** is an open-source Remote Play client for Quest 3, Quest 3S.\n\nPlay PS4 and PS5 games in flat view or immersive spatial mode on a large head-tracked screen with animated surroundings.\n\n### Key Features\n\n- **1080p/60fps:** Low-latency Remote Play, depending on your console, network, and headset.\n- **Guided setup:** Discover your console, allow camera access, sign in to PlayStation Network in Chrome with the Horizon Stream extension, then scan the one-time QR code in Quest.\n- **Saved PSN account:** Horizon Stream saves your Account ID so repeat setup skips the QR step and goes straight to PS5 Link Device pairing.\n- **Camera pairing:** Scan the eight-digit PS5 Link Device code through the Quest passthrough camera.\n- **Quest Touch controls:** Virtual PlayStation mapping for buttons, sticks, triggers, grips, D-pad, and Quest Menu.\n- **Bluetooth controllers:** Pair a DualSense, DualShock 4, or compatible gamepad with Quest.\n- **Optional AI depth:** Add simulated 3D depth; it may use more battery or show artifacts.\n- **Open source:** Ad-free, AGPLv3, and built on Chiaki/chiaki-ng.\n\nSee our setup tutorial at https://youtu.be/70w9avqWMr8\n\n*Horizon Stream is a third-party client, not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation,\" \"PS5,\" and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Play PS4 and PS5 games on immersive virtual screens in Meta Quest with low-latency Remote Play, guided setup, and Quest or Bluetooth controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426392203880452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593716858_2180303759185353_3812066210480513278_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9PcJ9jVG-EQ7kNvwGteTYn&_nc_oc=AdrNDT4KSIUXrZi44qJbMDGMsjBMEDuaYkojM5u_nOS2J2dDxUHXRxrKdX2mMGYRAwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeimHcWDqEz4Fn67doqo2bGT52nCGnUoVXitAoJh3k8w&oe=6AF87DE1"}, "is_concept": 
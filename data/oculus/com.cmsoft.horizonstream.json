_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEDq7yGaS8QQ7kNvwFFUjQC&_nc_oc=AdoHssMditl8b__EtIsjOOBZQ3FJBaCTpLRuem5chW3uxLei9T-Rw12N19UkbUWFV4A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbLvLVPS5qZXl-kZ9w55Whm3kWHaQuh67JqJE1DWqoPQ&oe=6AA3F215"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkMOKjuXEWcQ7kNvwHhGFNt&_nc_oc=AdoES6QTTyLES4VR3ufBMQubQlnQ0xB_Ywt5ugCITq15KDWNuX43X1uDPAGjpfjkYiA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIziIyUBwXJEsZaVTdKK3ZAigHz7_LV_tzHfuhp7EQvPQ&oe=6AA41899"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loMAv4UQ0_wQ7kNvwF0IAFW&_nc_oc=AdpsaOtIMn9cLlJn2YUB9050mbf3UVmHfsBe0ICmPXllysnLT8i2sYTfYw_Hfe2KhIQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGH4H0Fm8QnvwCIC8-b4SiKFKJVINronkVs5kB_QsqQQ&oe=6AA3ECDD"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQsAWzXD0oUQ7kNvwFW4hZw&_nc_oc=AdpfaTruezBhw-CGjGIRrlHj7ZugKwfVk5ig4OLtuilB3JzRwAnJmpPIhwjXx3C7S1c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvIzlI9jG3dmjQQONMOutLFkXO7NSWyD-kO_4e1CaRZQ&oe=6AA408C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into the ultimate gaming display! **Horizon Stream** is a dedicated, open-source PlayStation Remote Play client built specifically for the Meta Quest ecosystem. \n\nWhether you want to play fast-paced shooters on a massive, theater-sized virtual screen or lay back and enjoy immersive RPGs while staying aware of your surroundings in mixed reality, this app delivers a seamless and highly optimized remote play experience straight from your PS4 or PS5.\n\n### Key Features:\n* **High-Performance Streaming:** Enjoy crisp, low-latency gameplay at 1080p (and HDR 4K on supported PS5 connections) with buttery-smooth 60fps frame rates.\n* **Immersive Virtual Displays:** Resize, reposition, and curve your screen anywhere in your physical space using Meta Quest's seamless window management.\n* **Native Controller Support:** Connect your DualSense or DualShock 4 controller directly to your headset via Bluetooth for precise, zero-compromise input.\n* **Open Source:** Fully transparent, ad-free, and community-driven. Horizon Stream complies with the AGPLv3 license and is built upon the renowned `chiaki-ng` project.\n\n*Disclaimer: This application is a third-party, open-source client. It is not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation\", \"PS5\", and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Experience your favorite PlayStation 4 and PlayStation 5 games on massive virtual screens in your Meta Quest headset with low-latency remote play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "911052678694394", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593877129_911052682027727_4172099378348758025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Yal933WuYcQ7kNvwGrLA77&_nc_oc=AdpV7ZXmOvt8wPZ8vkstTQQLZyC8y2c9eimSJN5p9sQNFxrFCyT3UH_t-NV_WrluLyk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxurWImqAZNOaXe2gyfLPHPuA_eFE91HiOmpqD5wcUQA&oe=6AF33FD8"}, {"file_name": "screenshot2.png", "id": "2309821096513913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622916_2309821099847246_3431504175430180737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qidOupXQSk8Q7kNvwF7F7kg&_nc_oc=Adp-rX-K7MtBuKOilFiS6nuWELuH_JP5vDucODkKGLZoQwIl4h8aY4p4CgO9nB1hOZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIP0YeS6RJD7ueDQcZFCq65azQ9eIQ7ENxq7YkNkNAJg&oe=6AF34455"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D09qz5g7k0Q7kNvwGW-3ad&_nc_oc=AdraF3557-zX34xHZmWZIdtbMtHw-fzbtFAc3gg7M_NxpaLzedCV6djSczUrppvs4pg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMTuWk41q3y8p3Kei32dOj3y2pN3iPCB4neU4OoMKmPw&oe=6AF33299"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK2yJjHYmR4Q7kNvwGrjcKr&_nc_oc=AdoppnixEpfKRe9mMmANrkYyA_IJhCkUW5YMDwIJd4ISNlvJmQYeEFiW_iAyY8JgE9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJD0kBwuZkiDhwPMqdwUJR7pJNmOP8_ckYeZQoowyksQ&oe=6AF33F1D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lxc4N1-UNhoQ7kNvwEO1gTy&_nc_oc=Adq33WKq0mnFbx_JDUhdj3hQj1XTSbSozrQcx9WXx5_gmQoabOtWg3ZMmTySQ20iUWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJVBJh3nzH_JX6IaYuuumO2UYOi81JiBT0hsK89o18lQ&oe=6AF35B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "1099898599104396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623876_1099898602437729_8716243327825891942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQLDmU1IncMQ7kNvwEtSDxj&_nc_oc=AdoqKsF_mHgFrk5eJtghyNo-VEUfuS9QyqvIviEhqZGD2zeMXCPDdjuO_wSN8KN6yBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ0ZSD6-U7r8BC6IedpTkhzRU0bVX3rBA3MHxXGDW0zg&oe=6AF34704"}, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into a PlayStation display. **Horizon Stream** is an open-source Remote Play client for Quest 3, Quest 3S.\n\nPlay PS4 and PS5 games in flat view or immersive spatial mode on a large head-tracked screen with animated surroundings.\n\n### Key Features\n\n- **1080p/60fps:** Low-latency Remote Play, depending on your console, network, and headset.\n- **Guided setup:** Discover your console, allow camera access, sign in to PlayStation Network in Chrome with the Horizon Stream extension, then scan the one-time QR code in Quest.\n- **Saved PSN account:** Horizon Stream saves your Account ID so repeat setup skips the QR step and goes straight to PS5 Link Device pairing.\n- **Camera pairing:** Scan the eight-digit PS5 Link Device code through the Quest passthrough camera.\n- **Quest Touch controls:** Virtual PlayStation mapping for buttons, sticks, triggers, grips, D-pad, and Quest Menu.\n- **Bluetooth controllers:** Pair a DualSense, DualShock 4, or compatible gamepad with Quest.\n- **Optional AI depth:** Add simulated 3D depth; it may use more battery or show artifacts.\n- **Open source:** Ad-free, AGPLv3, and built on Chiaki/chiaki-ng.\n\nSee our setup tutorial at https://youtu.be/70w9avqWMr8\n\n*Horizon Stream is a third-party client, not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation,\" \"PS5,\" and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Play PS4 and PS5 games on immersive virtual screens in Meta Quest with low-latency Remote Play, guided setup, and Quest or Bluetooth controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426392203880452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593716858_2180303759185353_3812066210480513278_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_tc1Nek7l4Q7kNvwG4izbc&_nc_oc=AdosXPRiN24g2ZB_WAEQDwOxRsE5wz7YyyFq_cil5uy8F8omXQ8Fdx6KBvQvFu5jlU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuiu1wayGbgNo5TJ_eYLeRF55lJDD3SGb5atATUxp32A&oe=6AF337E1"}, "is_concept": 
locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "911052678694394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593877129_911052682027727_4172099378348758025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt7vQpPrPqMQ7kNvwGRgK74&_nc_oc=AdrlZ1U9Tc4LI0SnyXdED06oV5Gnto-CTphcle7HoGNaGuf3tOLLIwIUfXXR8rb3z3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkdtTBg24VCM0VAmHvjXCw4ZvqnKMKEfK8W4UGRkH67Q&oe=6AEA0558"}, {"file_name": "screenshot2.png", "id": "2309821096513913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_2309821099847246_3431504175430180737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKeFX43HXt4Q7kNvwHo2OuE&_nc_oc=AdoxIIluJz45wkQb__VjRQmqcX28xVd3VezqnJ2q3ux4pGUpwenIhhUAiITti_7sr3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1UJt8Cev0TRXt7u0VAwQOZo_xxaSnygF2SeRnE_5NQQ&oe=6AEA09D5"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiPQdU1TkAEQ7kNvwGfUfy9&_nc_oc=AdrMsau0yPRwK0MdooQgVdqWPoNB7bE_Jc_qJls2H3iuDUr4RpLuGXt4xrHvTgo6lQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4uRC_NXqo-Pg4jdbKtEZ_ZT4S33ehZxiTkthci1KDMA&oe=6AE9F819"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VDl-cWb-hoQ7kNvwE0pRn3&_nc_oc=AdrGrqq7R9rCp_QplQTU4nPjC_sGmPKsVaARSIlbh0wM6tlf2al1n16hT2woe1rxF8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcAxViWzdSAKayZ4HEfFzSj8ysuta1UX4XYzad65JI6g&oe=6AEA049D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ungakgYhIEYQ7kNvwEQ0sIn&_nc_oc=AdqnHs9urHSJpQcfg_TLSgIqYqA1hrd2fEnknp-qCDCXkQv0d3B2SFJSZdRWqZ4M5EY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTezQRaawO9hj2PFq8C0WXtr_iGkQPxi1zwdOGoSgmMUA&oe=6AE9E843"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "1099898599104396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1099898602437729_8716243327825891942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=924uXFBFoQIQ7kNvwHg_v26&_nc_oc=AdrowaByZ9TUCeTwt_wjw_NS5SVpRHkI8bs_Q9FY3UCV4RuSyKshY3iDVQnE1Gu-4k8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRckqrKE8-ammmwk08boVTsGSBuCrCeg63Ojowrv1EtQ&oe=6AEA0C84"}, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into a PlayStation display. **Horizon Stream** is an open-source Remote Play client for Quest 3, Quest 3S.\n\nPlay PS4 and PS5 games in flat view or immersive spatial mode on a large head-tracked screen with animated surroundings.\n\n### Key Features\n\n- **1080p/60fps:** Low-latency Remote Play, depending on your console, network, and headset.\n- **Guided setup:** Discover your console, allow camera access, sign in to PlayStation Network in Chrome with the Horizon Stream extension, then scan the one-time QR code in Quest.\n- **Saved PSN account:** Horizon Stream saves your Account ID so repeat setup skips the QR step and goes straight to PS5 Link Device pairing.\n- **Camera pairing:** Scan the eight-digit PS5 Link Device code through the Quest passthrough camera.\n- **Quest Touch controls:** Virtual PlayStation mapping for buttons, sticks, triggers, grips, D-pad, and Quest Menu.\n- **Bluetooth controllers:** Pair a DualSense, DualShock 4, or compatible gamepad with Quest.\n- **Optional AI depth:** Add simulated 3D depth; it may use more battery or show artifacts.\n- **Open source:** Ad-free, AGPLv3, and built on Chiaki/chiaki-ng.\n\nSee our setup tutorial at https://youtu.be/70w9avqWMr8\n\n*Horizon Stream is a third-party client, not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation,\" \"PS5,\" and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Play PS4 and PS5 games on immersive virtual screens in Meta Quest with low-latency Remote Play, guided setup, and Quest or Bluetooth controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426392203880452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593716858_2180303759185353_3812066210480513278_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLaBe6otBwsQ7kNvwG7d3hN&_nc_oc=AdrjYy-brHpH6FDnwh2qreTPopLHY7HK3MI7RJyGvVvOCqkqN3bM0Ycp-Vz-vfExcZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-Yzkl-xw0Ml0C51dN32ZwSe-BMkvMyj6ms_v3Y60zyw&oe=6AE9FD61"}, "is_concept": 
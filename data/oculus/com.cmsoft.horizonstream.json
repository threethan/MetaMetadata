locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "911052678694394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593877129_911052682027727_4172099378348758025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2Yp4V8guQEQ7kNvwE1M3oc&_nc_oc=AdqDYaSiZK-ti6IR6_8yRsFK9gyuiO1sqKe7fXehnRZhZNzb4ZpacrXf_5ykjRApeMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNWDDvmVuJ7QBqqQRtXhtoHttbY4Qthk9k5VvAt7tcWQ&oe=6AC66CD8"}, {"file_name": "screenshot2.png", "id": "2309821096513913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_2309821099847246_3431504175430180737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaGuZkmUhCMQ7kNvwHsvpwA&_nc_oc=Adq4clrSh6pvVKS_VbffHUByzM6HFyCy4odFpVfdy2lWq5hqaH0aIFScpNwiF4NRx9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVHi4LqvhbMspto2_oDZ1dZxJDtvu4dVWgcruNDESrCQ&oe=6AC67155"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Eo9EHyh8bMQ7kNvwFY2XKo&_nc_oc=AdrXnqYzW2H76NYFdg1ONwzc0Df-Xxbst1RoaUFIEl1qzDtOPY4XiNHSSut98qYN3Cc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqDsN36revWMy9MsR9X5WgrCuqxNn2mA6po72PHDf6QA&oe=6AC65F99"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLcuolEGYTsQ7kNvwGGKqAM&_nc_oc=AdoANk6bAxGPJ1IT7BesEZs_AZVChCR74g3DvD-1_WlWLUqbjW69o6x2vjT8F__2V_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhMXwOykZ7G_6MU28FTuBmXpQSH7SvpJFtDhSlAdld0w&oe=6AC66C1D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcrfE_7DChkQ7kNvwH5-8gg&_nc_oc=Adq6o7ykfBQrJr7L-XpESfA6HEEZ2_0vDD143QqfuBGSCUp0-kD4RY_2OqgGXwF5l-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbgtDrVxNLgU1UhfvNZHemxlUwBKJtcqrQGBMpSp_mdQ&oe=6AC64FC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "1099898599104396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1099898602437729_8716243327825891942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2jIu_YDXrEQ7kNvwFwIRkl&_nc_oc=AdoacB33r4FbZ25m_-H57ZJHogmQ8U05zO371N79DMaBAWMtaf8WplokHlubplwlM8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPideXMOOItkh61Q1t0ZawCGIeh1MVZgbQ65zzshpVWwQ&oe=6AC67404"}, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into a PlayStation display. **Horizon Stream** is an open-source Remote Play client for Quest 3, Quest 3S.\n\nPlay PS4 and PS5 games in flat view or immersive spatial mode on a large head-tracked screen with animated surroundings.\n\n### Key Features\n\n- **1080p/60fps:** Low-latency Remote Play, depending on your console, network, and headset.\n- **Guided setup:** Discover your console, allow camera access, sign in to PlayStation Network in Chrome with the Horizon Stream extension, then scan the one-time QR code in Quest.\n- **Saved PSN account:** Horizon Stream saves your Account ID so repeat setup skips the QR step and goes straight to PS5 Link Device pairing.\n- **Camera pairing:** Scan the eight-digit PS5 Link Device code through the Quest passthrough camera.\n- **Quest Touch controls:** Virtual PlayStation mapping for buttons, sticks, triggers, grips, D-pad, and Quest Menu.\n- **Bluetooth controllers:** Pair a DualSense, DualShock 4, or compatible gamepad with Quest.\n- **Optional AI depth:** Add simulated 3D depth; it may use more battery or show artifacts.\n- **Open source:** Ad-free, AGPLv3, and built on Chiaki/chiaki-ng.\n\nSee our setup tutorial at https://youtu.be/70w9avqWMr8\n\n*Horizon Stream is a third-party client, not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation,\" \"PS5,\" and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Play PS4 and PS5 games on immersive virtual screens in Meta Quest with low-latency Remote Play, guided setup, and Quest or Bluetooth controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426392203880452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593716858_2180303759185353_3812066210480513278_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_AsySNaCAEQ7kNvwFSZvlO&_nc_oc=AdoPyq3OIw5pR8eFy8oivh-FRwCyRgHOtLZdMhnlJCDowiE3PyBsde0OZIeBUQcV6sE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQZ92wcpGwJ-Njs7NEwG3iDRo1G9SQX3zM8p2EYN21Ww&oe=6AC664E1"}, "is_concept": 
t=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_5fWxgGGGMQ7kNvwFReUd_&_nc_oc=AdpiZYoGDDIPoZeKzkolqUtc7siy1XuTDABzBnZyTRF1w94d0lhBH_b7hBxzvKsVzwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9W26J77B0kKUx634e9B7L0WpquEocpG76h6mojfz1dQ&oe=6AA69515"}, {"file_name": "screenshot5.png", "id": "1565257435272534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1565257438605867_2356564702737949913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkMOKjuXEWcQ7kNvwETtw_e&_nc_oc=AdoD0b7ZADzFnefZ7JbPQR25u-VU_payNAZ1JzKV02_XNgP9aeFPv8k1HHuDz-q7uqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLekUDzS0-nAw4f8t9hlr6yrWU6NjyHmCJvciflYApiow&oe=6AA6BB99"}, {"file_name": "screenshot3.png", "id": "1344530570990057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295969_1344530574323390_1861244110054035209_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loMAv4UQ0_wQ7kNvwFzSEK4&_nc_oc=AdqYHiHWb32odOP0LJabMGzTgvub1SDrxJMjjtKjlrzXh5cDGNmrgn6gf8nyXcxz2As&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzCrNC9V50BGDIKrreIVURKWa9OqgxHtXYCg3OYCuHJA&oe=6AA6C81D"}, {"file_name": "screenshot4.png", "id": "27403191982699810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305114_27403191992699809_3205907500373806607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr6KlL2yg3kQ7kNvwG4h0t1&_nc_oc=AdqlH-beIQqsdltVlbY4QnoALnT8yH0ejtwi-4ItZoXIM5dQ46I5Sky8ueUbSYq07MI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVXWoZimVKyMYJ738Uz4XC8-SiR3t9Wxh6wjgYqe0-jg&oe=6AA6ABC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Stream for Playstation", "keywords": [], "long_description": "Turn your Meta Quest into the ultimate gaming display! **Horizon Stream** is a dedicated, open-source PlayStation Remote Play client built specifically for the Meta Quest ecosystem. \n\nWhether you want to play fast-paced shooters on a massive, theater-sized virtual screen or lay back and enjoy immersive RPGs while staying aware of your surroundings in mixed reality, this app delivers a seamless and highly optimized remote play experience straight from your PS4 or PS5.\n\n### Key Features:\n* **High-Performance Streaming:** Enjoy crisp, low-latency gameplay at 1080p (and HDR 4K on supported PS5 connections) with buttery-smooth 60fps frame rates.\n* **Immersive Virtual Displays:** Resize, reposition, and curve your screen anywhere in your physical space using Meta Quest's seamless window management.\n* **Native Controller Support:** Connect your DualSense or DualShock 4 controller directly to your headset via Bluetooth for precise, zero-compromise input.\n* **Open Source:** Fully transparent, ad-free, and community-driven. Horizon Stream complies with the AGPLv3 license and is built upon the renowned `chiaki-ng` project.\n\n*Disclaimer: This application is a third-party, open-source client. It is not affiliated with, endorsed by, or associated with Sony Interactive Entertainment. \"PlayStation\", \"PS5\", and \"PS4\" are registered trademarks of Sony Interactive Entertainment Inc.*", "short_description": "Experience your favorite PlayStation 4 and PlayStation 5 games on massive virtual screens in your Meta Quest headset with low-latency remote play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/0TheRain0/horizonstream/blob/main/meta_store_assets/privacy_policy.md", "developer_terms_of_service_url": null, "publisher_name": "CMSoft", "support_website_url": "https://github.com/0TheRain0/horizonstream", "website_url": "https://github.com/0TheRain0/horizonstream", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
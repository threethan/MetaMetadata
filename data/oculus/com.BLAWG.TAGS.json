f&oh=00_AQT7Broxkajnyp8OdaUJ3OkRuY2Qd__A4oNU9ZR5i-we5w&oe=6AEF3BD9"}, {"file_name": "Screenshot 2026-07-10 234252.png", "id": "2510423576036797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_2510423582703463_8881677950229016674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AVLwq5q8xUQ7kNvwHBg-YT&_nc_oc=AdojTQ40Hy7E8ZqhMpWELD3IB9TpEpuCcbUlKSyjDfsEwnvmyEFQEnroKaA46e2xIOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRplHb9NfncUrT2aTcA6AZ5Qeue9un3BrHCS-BLmafaFA&oe=6AEF38D0"}, {"file_name": "Screenshot 2026-07-10 234055.png", "id": "1517277922942488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1517277926275821_5813678455099112886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ805x6b9mIQ7kNvwGv32Sx&_nc_oc=AdrKp8Yc5gqWvgjT4kriTRW4poAQ78XkXEGH_84eFaxxG4Jx9c2cFCJT6m5xLBMJ8T4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK0scAmiyQaG8G7ujAwJWni-1yCQk2IR34AMmXmutcHg&oe=6AEF650F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blawg Tags", "keywords": [], "long_description": "Blawg Tags is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, Blawg Tags delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Blawg Tags is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sHaTW0PnqzcLzEX9RL
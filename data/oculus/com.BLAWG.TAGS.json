f&oh=00_AQIUmuYP0kDnj2prnr6mbRxomYe3i4twnbnKseiNLkJrWg&oe=6AAAADD9"}, {"file_name": "Screenshot 2026-07-10 234252.png", "id": "2510423576036797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_2510423582703463_8881677950229016674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKttlM-4O-UQ7kNvwGbfVGL&_nc_oc=AdqWVj4xy7WlNHxrEmg0tVnRM0d3LrmGHAS_uPhQmIusWM-L4pKE89zlzDTSXgUAOts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMInKrU7QmZsnI8ymBl_BuAjSNKsH_LIrA0QYBsM8kwA&oe=6AAAAAD0"}, {"file_name": "Screenshot 2026-07-10 234055.png", "id": "1517277922942488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1517277926275821_5813678455099112886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnsGF-3atMQQ7kNvwGleXgf&_nc_oc=AdrySEKxA5ZOOEyErud2pJ0kceZKbomDiOwEB0ArVTPv8zUytBkNM83hoKVGCJjtEhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbdzttNlpy1hf72EikiPcRS3u1RQQrR8ZTGAEVcvtg3g&oe=6AAA9ECF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blawg Tags", "keywords": [], "long_description": "Blawg Tags is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, Blawg Tags delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Blawg Tags is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sHaTW0PnqzcLzEX9RL
 fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sHaTW0PnqzcLzEX9RLzIUJODeOYxHTum4l998mJ-m-Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HawkHarlumLLC", "support_website_url": null, "website_url": "https://sites.google.com/view/blawgtag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1074538049085663"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823837_1047065774332515_6059538737453263590_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yndbtxHdqc8Q7kNvwFCfgsk&_nc_oc=AdpBv1H_FFGMozkTU4PIlD2bJc5wdLc8SjsnFkCXjLBZuGeEtUGJ9CNve7qB-4C8IC0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSihe0rQEFgZMHyaSN1kjY_-sP8LgS_N9ZPue7hY7PLfw&oe=6B086B50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blawg Tags", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name":
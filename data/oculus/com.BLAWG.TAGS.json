f&oh=00_AQPOgK_D2yp5I3ApIdm57e--l3LH51jo2sJ3Ij8Ysgmy4w&oe=6ADE1859"}, {"file_name": "Screenshot 2026-07-10 234252.png", "id": "2510423576036797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825415_2510423582703463_8881677950229016674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l_sli73DykQ7kNvwGYlJmo&_nc_oc=AdpXF-kslG00Cc_-KZEZcIVZhFrb5s1VJUBfjWecQgglcuPgN9N_t15YtVfXD0l5Lgs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy_wJ8pJRTndA0-gqdgA3J6ukov_8Qz9ruxCDkG3Lq4w&oe=6ADE1550"}, {"file_name": "Screenshot 2026-07-10 234055.png", "id": "1517277922942488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1517277926275821_5813678455099112886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uKv5oswekAQ7kNvwFYMnOW&_nc_oc=Adpo1oMqEhbmqyEfjo63hfL2L_Qazl-eGor3YbXu0aMAulCHfXkzpMN1lmt959XN1eo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY_134A7xA0oDzvsMHDr8wkT8YUd1PWCw0NzGCvrk9Kg&oe=6ADE094F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blawg Tags", "keywords": [], "long_description": "Blawg Tags is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, Blawg Tags delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Blawg Tags is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sHaTW0PnqzcLzEX9RL
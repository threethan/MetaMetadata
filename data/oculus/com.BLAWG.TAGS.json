f&oh=00_AQIOKTCSRRa32QZi-IK_8rH-29LXnZEHb0RH_3ZcNICuYw&oe=6AB92E59"}, {"file_name": "Screenshot 2026-07-10 234252.png", "id": "2510423576036797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_2510423582703463_8881677950229016674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-0Gu8vHDxEQ7kNvwEyz-uY&_nc_oc=Adrw1ZA3jhM52HVjYtfLN5tTBzy9szZNm6XLr4GWpUuDFF6uZDIesoUdZV0kNQnWBwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR2s_Bj0E16isJ4wcpdO3OdZXU8qJM0iCn6DP5nznkKQ&oe=6AB92B50"}, {"file_name": "Screenshot 2026-07-10 234055.png", "id": "1517277922942488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1517277926275821_5813678455099112886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Pkalc4-79IQ7kNvwHUyOla&_nc_oc=AdpYHMvI-uCJPTXmQbB7iis1QGFSNvWHqOaXRZ7hqNUPWkUw8CDGXzjLfs_aYzJH5Fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6vkrmii43xb7x9x1ugHM_Iw32cbmBoSvwiCeE9mjHJQ&oe=6AB91F4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blawg Tags", "keywords": [], "long_description": "Blawg Tags is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, Blawg Tags delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Blawg Tags is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sHaTW0PnqzcLzEX9RL
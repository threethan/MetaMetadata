f&oh=00_AQRqECwXeZOBhjg7WoGACGWVGY0ZImcclLE6FHTsY2RSFQ&oe=6AE752D9"}, {"file_name": "Screenshot 2026-07-10 234252.png", "id": "2510423576036797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825415_2510423582703463_8881677950229016674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mds2-9s2mc4Q7kNvwFxBLAD&_nc_oc=AdoyrQ3XBJ0ECGcM3JhRag6b2uyoJSlSE-yGwFdQqp1jHfjGhTbkK0tFaY4leyhcZu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQasZmvDni0Q4dgZD3v_AXNSeYz6OT3YRJ123tP0ExrlA&oe=6AE74FD0"}, {"file_name": "Screenshot 2026-07-10 234055.png", "id": "1517277922942488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1517277926275821_5813678455099112886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjPglMDSlaUQ7kNvwH38aRN&_nc_oc=AdpI5Q-JjMeEWyr-iEpxdeBreyNd34JHdrwTVFftbMkaxIOc23v7CybpIfhCCDdGcpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Oui_fSU6HLfYsyBurqgXlnwmYUwwE6VdvQVj3Sg4sg&oe=6AE743CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blawg Tags", "keywords": [], "long_description": "Blawg Tags is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, Blawg Tags delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Blawg Tags is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sHaTW0PnqzcLzEX9RL
f&oh=00_AQMTKZm_JI0auY0_OSIrycf8rCMNrk_9nrhZbp3X6CWDTw&oe=6AE0BB59"}, {"file_name": "Screenshot 2026-07-10 234252.png", "id": "2510423576036797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825415_2510423582703463_8881677950229016674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ax-cWYr7QZEQ7kNvwHugc1t&_nc_oc=Ado_g-cYSqfyebTsSWvoUsn04nRSm9YehDJ7rOI0l7RM9j0xbwGANNBmyc8TTrLoshM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3W_Hpd0AK9yZV4UEDU8wSrhk3xTrHKXJYb6LKffU54g&oe=6AE0B850"}, {"file_name": "Screenshot 2026-07-10 234055.png", "id": "1517277922942488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1517277926275821_5813678455099112886_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7UkI-2TVo8Q7kNvwEuJjHm&_nc_oc=AdozaMXnODBCE458b7pljsLU9kptako6Eugc15ytErBspLbKxA70Bky54GaxhlRp8zM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhiOKkG2jKHtt0D_O-AewxUJG-n5HIFVp3dj9QdoNuKg&oe=6AE0AC4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blawg Tags", "keywords": [], "long_description": "Blawg Tags is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, Blawg Tags delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Blawg Tags is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sHaTW0PnqzcLzEX9RL
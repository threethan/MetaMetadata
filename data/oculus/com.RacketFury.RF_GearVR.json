WlRt0T30Q7kNvwFJp81i&_nc_oc=Adoup7d_iY6C6u_zdTcQBHDWSTc84qdOIPvZ6hX-x0Kob7vctJxzEYr7elbfrNZXZXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlsSG-Q3qXpjl23HddtwfMd2fIKphgbaMUhOSjnJ_RyA&oe=6B033739"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nGAXNN", "id": "3593009564105866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476595_3593009567439199_8021258528050118656_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ-WpMnMdxsQ7kNvwGwN2fD&_nc_oc=AdqArvA_wQXV_u_fN_IX9xgznqErpTdmzIO9-35geiYImNe4jsdPhp7rPSSK-HnB9IM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_juVhh7qrw_aHP7ub5K_40uQFAeZ5bwDPomA3Bs6QnA&oe=6B030939"}, "display_name": "Racket Fury: Table Tennis VR", "keywords": ["Table", "Tennis", "Ping", "Pong", "Racket"], "long_description": "ADVANCED PHYSICS:\nWe spent countless hours on developing our own physics from scratch and tweaking it with professional table tennis players. Based on scientific research, it\u2019s extremely realistic and translates your moves in the most accurate manner.\n\nMULTIPLAYER & ONLINE RANKING:\nChallenge the players from every corner of the world and defeat them with your smart strategy and unbeatable technique.\n\nSINGLEPLAYER EXPERIENCE:\nYou\u2019re about to face 16 opponents in the singleplayer campaign. Beware! The higher the Cup, the more demanding and troublesome it gets!\n\nARCADE & SIMULATION MODES\nDecide for yourself whether you wish to obtain the most accurate or the most entertaining table tennis experience!\n\nBEAUTIFUL SCENERIES\nChoose one of 5 amazing sceneries and decide whether you wish to play in daylight or at night!\n\nMOTION CAPTURE ANIMATIONS:\nTo deliver the most realistic characters\u2019 movements, we relied upon motion capture data for our animations.", "short_description": "Step into the most intense Table Tennis experience! Get involved in heated exchanges in Multiplayer with players from all over the world who, just like you, are hungry to win or take on challenging rivals in the Singleplayer campaign to climb the ladder of the Crown Galaxy!"}]}, "developer_name": "Pixel Edge Games", "developer_privacy_policy_url": "https://www.pixeledgegames.com/privacy-policy-games", "developer_terms_of_service_url": null, "publisher_name": "Pixel Edge Games", "support_website_url": null, "website_url": "https://www.pixeledgegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "873806546729693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974498_446854799417443_3570098626002681856_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0VM4EmWaIEQ7kNvwEgcS5e&_nc_oc=Ado9lz5oecmxl8EajZKTIAWeV_o5mOJqj28wySc6-Ml-NBO6xuNATqW9NhbBzR4P19o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlvXfVgTbwNAghN3izYglAHYd4eBZM_s-cVWgoaNjRBA&oe=6B033976"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Racket Fury: Table Tennis VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id":
082815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974513_1233309070166867_8162137608592293888_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zswdDUOVMRoQ7kNvwFEhqWB&_nc_oc=Adqlis5gpZoEEA_RWRVJ-uJheL1lAilU1ercbtWMAhDL8OkzPwg3qWmMlBKXa1sBSEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUeqP6cyLw0BKhcnvOIoWeLs1xWKITNP3UVcfvg2mTmmA&oe=6B0EFEC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/iFUkFz", "id": "333196980882034", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974534_333196984215367_8961908618446241792_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCV3CxYj4VsQ7kNvwEp_k1P&_nc_oc=Adozbm__aHanDeQg7vm_lszRUaBMqsF2f0kiH_zxPmI4V-CeRg1qoeg0gatCM05GK0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXobdRJ8HIQssQG2XTNKSVQ54HAFiu0-0xvXUt-YCgiYw&oe=6B0EF94A"}, "display_name": "Racket Fury: Table Tennis VR", "keywords": ["Table", "Tennis", "Ping", "Pong", "Racket"], "long_description": "ADVANCED PHYSICS:\nWe spent countless hours on developing our own physics from scratch and tweaking it with professional table tennis players. Based on scientific research, it\u2019s extremely realistic and translates your moves in the most accurate manner.\n\nMULTIPLAYER:\nChallenge the players from every corner of the world and defeat them with your smart strategy and unbeatable technique.\n\nSINGLEPLAYER EXPERIENCE:\nYou\u2019re about to face 16 opponents in the singleplayer campaign. Beware! The higher the Cup, the more demanding and troublesome it gets!\n\nARCADE & SIMULATION MODES\nDecide for yourself whether you wish to obtain the most accurate or the most entertaining table tennis experience!\n\nBEAUTIFUL SCENERIES\nChoose one of 5 amazing sceneries and decide whether you wish to play in daylight or at night!\n\nMOTION CAPTURE ANIMATIONS:\nTo deliver the most realistic characters\u2019 movements, we relied upon motion capture data for our animations.", "short_description": "Step into the most intense Table Tennis experience! Get involved in heated exchanges in Multiplayer with players from all over the world who, just like you, are hungry to win or take on challenging rivals in the Singleplayer campaign to climb the ladder of the Crown Galaxy!"}]}, "developer_name": "Pixel Edge Games", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.termsfeed.com/terms-service/c3c5ea338578ea9459348f5d9456e4fd", "publisher_name": "Pixel Edge Games", "support_website_url": null, "website_url": "http://www.pixeledgegames.com/portfolio-item/racket-fury/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1855185954677825"}}]}, "scheduled_offers": {"count": 33, "nodes": [{"status": "PUBLISHED", "id": "2683365725340272"}, {"status": "PUBLISHED", "id": "581326558121527"}, {"status": "PUBLISHED", "id": "1465994997431320"}, {"status": "PUBLISHED", "id": "537246382301275"}, {"status": "PUBLISHED", "id": "323005677528800"}, {"status": "PUBLISHED", "id": "1074358157352702"}, {"status": "PUBLISHED", "id": "699932447218528"}, {"status": "PENDING", "id": "237375816042006"}, {"status": "PUBLISHED", "id": "926232255237767"}, {"status": "PUBLISHED", "id": "759655338111325"}, {"status": "PUBLISHED", "id": "8352775
scdn.com/v/t64.5771-25/39031379_1261745490843544_6546576956719746909_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPCT2Yy9JYYQ7kNvwHP93kx&_nc_oc=AdmE817vOXpX5ylQqrJniuCwkFhHh7PsmVntnhpn8n69rRaAERk-yRYvCAJ4OmpaW_Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfygR6F1cke_tQUF2utCQ_jSDFDdpFW-DsD6QYUm-zp3NQ&oe=69BD2C98"}, {"file_name": "screenshot 5.png", "id": "761958987986216", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210896_761958991319549_7202105472889043738_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcPFcOZdSAsQ7kNvwEgAKui&_nc_oc=Adnol212H5uftKpa8HLMqjRSraRUNb-7yzL2wB9gurkUHG1vjMDZp3M1Epji2L2FJ20&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9cjBdF3CYRsP_rFnGAglHhvQDV2Xw8QEiyYFBZFXwMg&oe=69BD4D41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Gorilla Travels", "keywords": ["travel", "tour", "safari", "guide", "city"], "long_description": "A Gorilla Travels\n\n\u2018A Gorilla Travels\u2019 brings the total collection of  VR travel  Film content, produced by production house VR Gorilla, to the Oculus platform. \n\nStream it or download it in the highest possible resolution for the Oculus Go.\n\nTravel to Rome, Bangkok, London, Amsterdam, Paris, Cancun and many more cities and other \ndestinations from around the globe! \n\nOver 35 unique experiences, and more destinations to be added monthly. \n\nWe believe in opening up the wonders of the world to anyone across the world.  For those who are not able \nto travel, who lack the funds or mobility. But also for those who love to travel and would like to see more of the world \nthan their actual holidays allow them. \n\nWe invite you to travel with us  on our guided tours and meditative relaxing travel experiences. \n\nGet out there and discover the world from you living room!", "short_description": "A Gorilla Travels\n\n\u2018A Gorilla Travels\u2019 brings the total collection of  VR travel  Film content, produced by production house VR Gorilla, to the Oculus platform. \n\nStream it or download it in the highest possible resolution for the Oculus Go.\n\nTravel to Rome, Bangkok, London, Amsterdam, Paris, Cancun and many more cities and other \ndestinations from around the globe! \n\nOver 35 unique experiences, and more destinations to be added monthly."}]}, "developer_name": "Headjack", "developer_privacy_policy_url": "https://www.vr-gorilla.com/a-gorilla-travels-app", "developer_terms_of_service_url": "https://www.vr-gorilla.com/a-gorilla-travels-app", "publisher_name": "VR Gorilla", "support_website_url": "https://www.vr-gorilla.com/a-gorilla-travels-app", "website_url": "https://www.vr-gorilla.com/a-gorilla-travels-app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "RELAXATION_MEDITATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "340698741245666"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2392836514438876"}, {"status": "PUBLISHED", "id": "1600860066751930"}]}, "baseline_offer": {"id": "2392836514438876"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707321841, "status": "PUBLISHED", "id": "2392836514438876"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3247779081998657", "version": "1.1.0"}, "id": "2754259388230558", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "And
a7LYk6w&oe=69BFF46C"}]}, "id": "996984982586223", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1086511503316446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820083_1086511506649779_9157129667432897863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTiT8h_bnJkQ7kNvwH1BVKA&_nc_oc=AdmTovmWeH_j8wsotbAbm2VJ_uHLylGat0ztf-t4gAS262s8sp730DMpszaCC33jWEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm0KacT2l0x11vRwwZ7AOqbb5785sEWhKdWUKnG87OPA&oe=69BFF543"}, {"file_name": "2.png", "id": "1678119692803601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392168_1678119699470267_8375662633581533173_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2J9rK7mXDkQ7kNvwEvF_gf&_nc_oc=Adkpf7LpenhqbSocyaLOKp4aNXi9DNOETawnDsFmel_NlgFl7pP4lKL9p4ns4kT4VFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_VRqE6FASb5Ut_VF4uhbfGQnguuFOb0y8cKXQG9HnBQ&oe=69BFE5AA"}, {"file_name": "3.png", "id": "1349687872919018", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821956_1349687876252351_2809881743848579038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiVFas98-icQ7kNvwEasZZn&_nc_oc=AdnHy8ugGon7Ynd-XrrWCZUHe_qhoyvoPMN7zn3p3rqg0BpjBmenzl1NkI6q31-TQ4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjAr6rVtVW_Xqc3mNUIE4Sknx-Fr02F5nCjExeqOLpsA&oe=69BFE109"}, {"file_name": "4.png", "id": "1703798340522488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392168_1703798343855821_5914837618091013476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaNQs2brBG8Q7kNvwE_O-aW&_nc_oc=AdnV9BpEzTjg8vIXZRgu3rVkmPdK06hJsXKRo9UFXBNxrjKrfdaKMQswP29Iij0dogA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBV5t-rtKeZIZsY6mmyx0hAL9JQMYc7bbXEi-GKKvUNA&oe=69BFFD50"}, {"file_name": "5.png", "id": "1397924478002414", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824169_1397924481335747_5720202155712594802_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uubIVReny1QQ7kNvwHa2XvX&_nc_oc=AdlFqVz6hf6htYFu_eME2NY3L0zdtHxiPUsSD7Zxmn8JvcccXQ5SePFzjFJyuXKs1dQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyo1v0VU6blyo5RnGngEtedbEQhx86C7J3_DNhqtbDyaA&oe=69BFD9CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nature of Western Mongolia", "keywords": [], "long_description": "Western Mongolia is a land of striking contrasts and raw natural beauty, where the towering Altai Mountains meet vast steppes, glacial rivers, and crystal-clear lakes. This remote region is home to Mongolia\u2019s highest peaks, including Kh\u00fciten Mountain and the sacred Otgontenger, as well as ancient glaciers like Potanin and Alexander.\n\nThe landscape shifts dramatically from snow-covered summits and alpine valleys to desert cliffs and volcanic rock formations like the hexagonal columns of Kharandaa Khad. Pristine lakes such as Khoton, Khurgan, Tolbo, and Telmen serve as vital habitats for migratory birds and fish, while the milky white Tsagaan River flows from the glaciers, earning the nickname \u201cMilk River.\u201d\n\nMuch of the region lies within protected areas like Altai Tavan Bogd National Park, preserving its untouched wilderness and cultural heritage. Whether viewed in person or in VR, the nature of western Mongolia invites awe and reflection, offering a rare glimpse into one of the world\u2019s last great wild frontiers.", "short_description": "Western Mongolia is a land of dramatic contrasts, where snow-capped Altai Mountains meet vast steppes, crystal-clear lakes, and ancient glaciers. Home to sacred peaks, pristine rivers, and rare wildlife, this remote region offers a raw and breathtaking natural beauty that captures the spirit of the wild."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9929363523794413"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2165771757557750"}, {"status": "PUBLISHED", "id": "2271050949984073"}]}, "baseline_offer": {"id": "2165771757557750"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773214140, "status": "PUBLISHED", "id": "2165771757557750"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9939074656156633", "version": "1.0"}, "id": "687542730437487", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9929363517127747", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9939074656156633"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "687542730437487"}]}, "change_log": null, "created_date": 1746086179, "id": "9939074656156633", "version": "1.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9939073049490127"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "An
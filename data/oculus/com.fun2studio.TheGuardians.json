FenDTimKFlMms3g&oe=69A05321"}, {"file_name": "237453_0.png", "id": "1705348926613037", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974516_1705348929946370_1323409686179974529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHGdHgF2M74Q7kNvwHgpnvc&_nc_oc=AdlI-19Mi5Corjhf7ycW_Xh1oVrKo25O4sqRFYtLc0f8KPR7btXxLyYeLhfg7V7TEWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftN9ARcSCPYSPBMoajkQO-N6oqRr2F9L1n2oTn3anju0Q&oe=69A02C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u5716\u50cf_2560_1440.png", "id": "1082116223133167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254869_1082116226466500_208783859597425828_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_2bPvkrl-0Q7kNvwHnSq-C&_nc_oc=Adl7HljOtT0cqSYcVHPK1dIWXA7eheCO4UiEdvQKSOqqCWZ_MdeUNv2P1dDJQxBf8zU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxEuHLb5LMQcF5kW4P3RP5NDGDvKLWv-K9-BESXeKluQ&oe=69A058BC"}, "display_name": "The Guardians Ver.1", "keywords": [], "long_description": "The game \u201cGuardians\u201d is specifically designed for teenagers together having fun. The gaming scene is a fortress and you have to use the axes and magic to beat monsters with your VR controller. As a warrior guarding the fortress, the player must not retreat even a step when facing the attack of the monster army, and drive away all the monsters. In addition to throwing, you can also experience VR's close-range slashing when facing the endless attacks of monsters. Be more immersed in the feeling of charging into the enemy army.", "short_description": "The game \u201cGuardians\u201d is specifically designed for teenagers together having fun. The gaming scene is a fortress and you have to use the axes and magic to beat monsters with your VR controller. "}]}, "developer_name": "Fun2 Studio", "developer_privacy_policy_url": "https://fun2studio.com/info.html", "developer_terms_of_service_url": null, "publisher_name": "Fun2 Studio", "support_website_url"
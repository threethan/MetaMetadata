lashing when facing the endless attacks of monsters. Be more immersed in the feeling of charging into the enemy army.", "short_description": "The game \u201cGuardians\u201d is specifically designed for teenagers together having fun. The gaming scene is a fortress and you have to use the axes and magic to beat monsters with your VR controller. "}]}, "developer_name": "Fun2 Studio", "developer_privacy_policy_url": "https://fun2studio.com/info.html", "developer_terms_of_service_url": null, "publisher_name": "Fun2 Studio", "support_website_url": null, "website_url": "https://fun2studio.com/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6901442876631746"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2333564543493943"}]}, "baseline_offer": {"id": "2333564543493943"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1708466340, "status": "PUBLISHED", "id": "2333564543493943"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6901483356627698", "version": "1.8"}, "id": "749890293658853", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id"
920434248426479_6579289253812897934_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9YjifQ21osQ7kNvwFP2_Nj&_nc_oc=AdlKfKCF4hEtctr5o_O52W5lek0lRHY8A4zeGG7ft876HymWtQ2phn96-iGLCmLkhEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsuBFkKXDlIfnsA0mIDEGvkKs0FqtoRZOU4bnziRtvEOQ&oe=69A2C6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.coverImage.png", "id": "924208342831139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_924208346164472_4247257832494819444_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa22CvBpabYQ7kNvwHsXAg_&_nc_oc=AdkKuKU6O4UAijzCEfWZd5TwoboM_5ks-qpfw5FpbU4dQ8SZ17KezBfFciKUnMq-l1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7Iw31EJhYViowqbasuLT6M6kVK98_jTS9HcQ5j8d8TA&oe=69A2DFC8"}, "display_name": "Picking out figures", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "It is a cognitive game for cognitive rehabilitation training to help rehabilitate people with cognitive decline and mild cognitive impairment, and is designed to provide two or more cognitive experiences and training in the game. A cognitive cube picking game designed to allow people with severe disabilities who have difficulty using controllers to play through hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_servi
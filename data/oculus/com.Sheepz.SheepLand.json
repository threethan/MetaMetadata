-lga3-2.oculuscdn.com/v/t64.5771-25/38982614_1313388332771285_9060810443549835604_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIFUA6lp3XsQ7kNvwEVlL1Q&_nc_oc=AdoeQ_wwutDuoiFmfKu1izLXzLnU0tPTduitzBov3f7atSmgtd3g8JKGszC5cWCVfJg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3YJdxDoXWTc2XNAMaUY5Dmre7cm6HelY9CBQ1YqyJfg&oe=6AFB2878"}, "display_name": "Sheep Land", "keywords": [], "long_description": "Sheep Land is a VR game with a special locomotion system, Use your hands to move, In this game you can look at yourself in the mirror, Try out a new look, and change your ingame color! Here you can do whatever you like with your friends! in Sheep Land you will never be lonely! To join a lobby, Just enter the game and you will instantly join one! If you cant join one, head over to the server buttons and manually join a server, Upon entering the store, here you will find a variety of cosmetics, Ingame moderators will have special cosmetics, including the Kick hammer, Hotdog cosmetic remover, and the \"funny collision sign\" If you see a rule breaker, head over to the leaderboard to report the rulebreaker.", "short_description": "It's finally here! Be a sheep in VR Hangout with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/sheepovr/sheep-land-policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Sheepo", "support_website_url": null, "website_url": "https://leerickfriday28.wixsite.com/sheepz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
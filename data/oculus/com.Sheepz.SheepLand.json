 leaderboard to report the rulebreaker.", "short_description": "It's finally here! Be a sheep in VR Hangout with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/sheepovr/sheep-land-policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Sheepo", "support_website_url": null, "website_url": "https://leerickfriday28.wixsite.com/sheepz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "3266398663574469"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "720878789693290"}]}, "baseline_offer": {"id": "720878789693290"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1673975280, "status": "PUBLISHED", "id": "720878789693290"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6112775682118596", "version": "1.3.0"}, "id": "672301067728602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5883402155055951", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6112775682118596"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{
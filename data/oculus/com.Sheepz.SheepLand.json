culuscdn.com/v/t64.5771-25/39031335_975680420471358_813294959552854787_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWE6P6V9wV8Q7kNvwGnPK6y&_nc_oc=AdorMQtdWOVK2y_br460Rbht4ZqVTriDXkdMtC0SW52ThGgQkVLWGO2Ne4JDacZ4WMQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdCm4BmNocJW_HEEMpXaOLt17CN8D3y6_J_GmN-wff0g&oe=6AA3FFA1"}, {"file_name": "screenshotfinale.png", "id": "5721048141293583", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982698_5721048147960249_3938309491549312504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwgTAOCzy5IQ7kNvwHyspNz&_nc_oc=AdqnEhM6yyi_BDHMh1XUHfWPZHdGJyL5eG0oK3Fuh6ExCotzeKjFvDNICfYKQ9pjfig&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR0uFFdiyy9OX3xSoV4waNUtcKjmpfa93iniOmLJ60zA&oe=6AA419BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1313388329437952", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982614_1313388332771285_9060810443549835604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_g_Hln37eMwQ7kNvwH43-ZH&_nc_oc=AdoVlh23d_F1fyTSsuBN_u52OuE9Rb2tMVmKzhPsPKsrDQuZyl82RowOszc89aeiwDE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg6LnsfDJsCwUzP1dkEYA4WTp6HxOZdoUKoKYEu5qDGg&oe=6AA3ED38"}, "display_name": "Sheep Land", "keywords": [], "long_description": "Sheep Land is a VR game with a special locomotion system, Use your hands to move, In this game you can look at yourself in the mirror, Try out a new look, and change your ingame color! Here you can do whatever you like with your friends! in Sheep Land you will never be lonely! To join a lobby, Just enter the game and you will instantly join one! If you cant join one, head over to the server buttons and manually join a server, Upon entering the store, here you will find a variety of cosmetics, Ingame moderators will have special cosmetics, including the Kick hammer, Hotdog cosmetic remover, and the \"funny collision sign\" If you see a rule breaker, head over to the leaderboard to report the rulebreaker.", "short_description": "It's finally here! Be a sheep in VR Hangout with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/sheepovr/sheep-land-policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Sheepo", "support_website_url": null, "website_url": "https://leerickfriday28.wixsite.com/sheepz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "3266398663574469"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "720878789693290"}]}, "baseline_offer": {"id": "720878789693290"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1673975280, "status": "PUBLISHED", "id": "720878789693290"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6112775682118596", "version": "1.3.0"}, "id": "672301067728602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5883402155055951", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6112775682118596"}, "release_status": "RELEASED"}, "binary_release_chann
yers and newcomers, rust taggers blends intense multiplayer tag gameplay with immersive environments that keep every round fresh and exciting. Easy to learn but challenging to master, the game offers endless replayability as you refine your movement skills and outplay your opponents.\n\nWarm up your hands, sharpen your reflexes, and jump into the chase \u2014 rust taggers is tag like you\u2019ve never experienced before.", "short_description": "rust taggers is a fast-paced VR tag game powered by hand-based movement. Climb, glide, and outmaneuver opponents using skill, agility, and strategy in an immersive rust-themed world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rusttaggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RUST TAGGERS DEV TEAM", "support_website_url": null, "website_url": "https://sites.google.com/view/rusttaggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26019734811027065"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26114763924857486", "version": "PRV5"}, "id": "862497146745292", "channel_name": "LIVE"}]}, "is_for_oculus_ke
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4UoGstA7eoQ7kNvwGQnmpa&_nc_oc=AdqngoRF-F4BHiBMYL9_phT7hW4Y1mF0sEbKLX5Sreq9y2sv_pj8cnjUGTNHk3OzKN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiQsBQ2m9BlYbMf9zqGF1_qRiCYQxUa6kQ8JeTb1_KBQ&oe=6ABFBC70"}, {"file_name": "Screenshot 2026-01-14 172034_2560x1440.png", "id": "1575282086865071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1575282093531737_2790714399201192023_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQa24dupMHoQ7kNvwE_tRQ1&_nc_oc=AdoANgVHrAGlT9n_lrR4DUAnbZSRzcerGXI2FuzdZMB0QV_qjifKikr6TG9mT2MKfxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxICU7NpCpVifx5EMWu3mAPSMCDJwScL01pVBAFJWFvw&oe=6ABFB1CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "rust taggers", "keywords": ["taggers", "locomotion", "movement", "tagging"], "long_description": "rust taggers is an action-packed virtual reality tag experience where your hands are your only way to move. Inspired by skill-based locomotion systems, players run, climb, launch, and glide through dynamic environments using pure physical movement. No joysticks for walking \u2014 just momentum, technique, and control.\n\nEvery match is a test of agility and awareness. Whether you're chasing down opponents or escaping by scaling structures and mastering tight movement routes, rust taggers rewards precision, quick thinking, and practice. The more you play, the smoother and faster you become.\n\nDesigned for both competitive players and newcomers, rust taggers blends intense multiplayer tag gameplay with immersive environments that keep every round fresh and exciting. Easy to learn but challenging to master, the game offers endless replayability as you refine your movement skills and outplay your opponents.\n\nWarm up your hands, sharpen your reflexes, and jump into the chase \u2014 rust taggers is tag like you\u2019ve never experienced before.", "short_description": "rust taggers is a fast-paced VR tag game powered by hand-based movement. Climb, glide, and outmaneuver opponents using skill, agility, and strategy in an immersive rust-themed world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rusttaggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RUST TAGGERS DEV TEAM", "support_website_url": null, "website_url": "https://sites.google.com/view/rusttaggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26019734811027065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_1367930448425407_4440506543093686529_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZdB9vukBUoQ7kNvwG5b_zt&_nc_oc=AdrBoR4FUN-Mfo9qLrqh2ARSGhk-6tL-k8xeQexGRn78UI9QnvjVTZRwOnEsAfq83b8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTCbTuKXr9n36R9kWS4qWfPQz5hHNNvGAsDonaw5AHBw&oe=6ABFC6B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "rust taggers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1773331560, "lastRevision": {"no
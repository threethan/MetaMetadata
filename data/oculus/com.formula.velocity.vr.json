zRJ5XL1bASz3vIRgsvjHRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0yEmZ-bTJv6_6r6du9ySB7UNm6sn7VfmJhMYCVHy9Tw&oe=6AB3D122"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4kTFFXEbjUQ7kNvwHic3Zd&_nc_oc=Adr_hrNhD-awcaywLzhzvUNKACCRXqOwcUF_8sMZhoLgXPGwguz0Lw8VWuYJGyPNKCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq5eAL1Rx-3ztqfY6IbbVlfyD9SAgyh0TyuzslUxNggA&oe=6AB3DDC3"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7yQO6ACAs0Q7kNvwEmJOMB&_nc_oc=AdpNOcT2SvF1wtEphZYnMGBZulAIUwMHBDoHyrClOf7GJA6K9qWAx5ilQbU2hi5FmYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJssq25Inbs2xAmgRTvoeaZhfrVLItxvl8uS7f3uiDcaQ&oe=6AB3D1CA"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDscWgd_dJoQ7kNvwHqJtLU&_nc_oc=AdooDONuPt8tnrgxM6LG2RBjWGCxGSq_0Dc7xIVCiTJy1KKzZZ-nvpPrHq2ClYkUVIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuSkqLTZnrRqizQwDpRAp1sC0y34sYIGqbQpMC6YktFw&oe=6AB3D4D5"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMc9oVAupzYQ7kNvwHP6Dq7&_nc_oc=Adq6syOsnM2hzvNqPdKc8QaLzb2uodyGlvTkwyQ5aBtNcai0j3B9hbK8MbiYgSALeiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU7rLsgqoj47Gn8T2oHS-jM8kc7qCqurKJeDrD8aeKGg&oe=6AB3C83D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "CO
r1dtbhewONniCZ1CLdmRRyl0kQkGAo-SRRPdrDq30nPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiZYhYZBfbNv1WmnRau92ffH6JNScOx4rzgYX8VH93EA&oe=6B032715"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHK0Oyi6DMUQ7kNvwEkWSGh&_nc_oc=Adr4QWB0q2pzEob9oYGC-7Vv0guDRDFWzwnlGCSbc3WGDkPSi4NWYx1wnVjphGwxYKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL_n-252RLHIUI6Jjc9Wkv9WFVPUGKsnIksZI-CdI71Q&oe=6B031A7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1201482916387305"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1109767128430829"}, {"status": "PUBLISHED", "id": "1004858932370950"}]}, "baseline_offer": {"id": "1004858932370950"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1109767128430829"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1201555819713348", "version": "0.1"}, "id": "888291287683212", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
5QkXuudcVbAnEQOuWyhm5LwtK9clXNVI3Ej4F1aJg&oe=6B09BAE2"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb4Bw4U7vvYQ7kNvwE7bg4z&_nc_oc=Adqhk52kY60ERBVqWRKhMLEO4kiFlnunibAnpO43xPFsNo4TW7t5OuSpcxYkDlAzciA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzvHHRVLQqlKSOiiH08ALHfMyItH5x_522F3Khxm_JLg&oe=6B09C783"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_2MrUUjb4wQ7kNvwHyw1T2&_nc_oc=Adq_JkDrVfwMxKoSzOtmB01z-rlVZ5ysIW9wGAhH8Y16BQAI3BBrvFK1Kt42O4HkrmA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXM4RxXdDn61rN4blMDmKWP50DGMlhzD5w4ZDwx52NWQ&oe=6B09BB8A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aPzTu4dg9oQ7kNvwG7d7Sz&_nc_oc=Adqpfa9IRYtgjtwyfGCDARoOF0N_9yD05nnNgdB2ZprSr8g0aeX4lDSBSEHuXD-oneo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk-sXlzANrIgA_naIuAGR8iVkvFlPRWzP-6DWN9xUyTA&oe=6B09BE95"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfWZX0W4A9AQ7kNvwEU9uYt&_nc_oc=AdoTHTyJKb3sB6JPmjRYt5PS874c2L7c3LOYf4I7fxwjzF2-lgWhK81Q9VrpgLoEnQ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZKwIHC9CZBtKMW3DS5ghzC4wzBFaWVZLexJVWi5lVAg&oe=6B09B1FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer", "keywords": ["city", "formula", "race", "racing", "sports"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_
m&_nc_ss=7f20f&oh=00_AQTx96tsDwDwgI72koT3RrnRAUJX3wM59NfnDVoR97MPeA&oe=6AF4A2E2"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7-yqGUnnJcQ7kNvwG4OuRc&_nc_oc=Adr9dkFUVGkusJjnBu5qWbiNCIgZh8htUw8M0hndAtwoMc6B64tpvjwQzFtAChE1QAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR3pDaK6bUBbbA5UOQp7v8JHX1MAuKX2BWZcMdbV09Lg&oe=6AF47743"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p6Of06EEqwQ7kNvwG1urmI&_nc_oc=AdrisFyMhwSZUZj9eFKMKBxca-NyqOn7BTQcdxY_A_17l7VuOgemXeqMykSItNsAh7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHqmiV9Dra1AcL0d9zXJTJlpmNLyu-eYh4SBCMwLb9VQ&oe=6AF4A38A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBOHyVbPlKIQ7kNvwErZYgT&_nc_oc=AdpNUCIDElEH-6jFg0jnygwGp24MKg3-c72qCRtuocbQsoF-VVEu60JxgTiZ8biCJKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbC7YeqhXZdzmj3iEHGjTQ92arB2CeO3HmZabN0xhqyg&oe=6AF46E55"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSO-y-OxwbYQ7kNvwEwxeSZ&_nc_oc=Adqmb9ELT91o-BTsW9jRp9X7CUusA_JIuMeWl6yF0M9lNecjhct_PN5eJsvHxG43Rcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAykcR1oNxX-6lLRvXl-uz-2dgf7GGEzuJvR0-fM7SsQ&oe=6AF499FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
26_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4KmCY5pw-cQ7kNvwFm5HB6&_nc_oc=AdqnZHwq494uqK9HyfFBfWix9KgJ-a7l_fDAVkPb6OzOKimJ4MfgbXaxOSkCySq_hac&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR608QuobazhjLGx9Icu7EiOtFOvHFr_ODKcuSlm1Dpwg&oe=6AECAF7F"}, {"file_name": "Portrait.png", "id": "1131190979609286", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595129854_1131190982942619_1545673628298544254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZyb3oAKNxUQ7kNvwFjHBpN&_nc_oc=Adq92t0HPnhh3Yy1BFpg3olIp80tKHzQex6t3sivrLMPz2xDObvTUxobZnuBV8aF5iA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOmznVzuiDd2TntGcVYu0Qy3nnT0fT8YppmA680auGoA&oe=6AECA60B"}]}, "id": "1679913710167111", "locale": "en_US", "screenshots": [{"file_name": "4.png", "id": "1585860042996347", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310734_1585860046329680_2520353159314434035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iryysvc6JMsQ7kNvwGClDCP&_nc_oc=AdoCi-TfEYLQcEwlJ-2IusEHgdq4Vws4bJ4esUSi94sjioYzAnKlemWa1U13OiV_PG8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShZdIRW4CAfMMJcs1WeUWVJIgNsSVXZRm0cXccq0sL6g&oe=6AECB9E2"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qj5q-Be_nsQ7kNvwGElaaT&_nc_oc=AdpO1ORpdY7JUW3_W6n2LR_6b35Vb0QxMEwfijchyNfTDQ3Uor-MlaAkBGvs5EjKVQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy0deaS_0KVbQsxmPlz830v-EaApJwOXJpI6BVAbkOBA&oe=6AEC8E43"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ-EYJkYGs8Q7kNvwHUDp7r&_nc_oc=Adp4-I7XFPI7ilu5eqnUSHmSAN7xLv5CXl0gCchotrdphs0Hhc8pw8ATdMLziq9o5zw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZCrklMNVKlAnoUe6Gf6tU3f2EBFx_AXcT5uRYcXmKEA&oe=6AECBA8A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfq-rOXxuE0Q7kNvwESN660&_nc_oc=Adoiv2CS3mBLE8KI_jwa477c2rGm8d4R4tHvu6xhF56tzSqnF0ywxgLPZYtFuDrQ_xg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSve4zbNX8oHZVSm7rJHJht0Fs3qsL_hdyc-kAPtUEZ9A&oe=6AEC8555"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfR7xS1w49EQ7kNvwEPbelL&_nc_oc=AdpdnDpkFY1nvBMhzX6Wod_dJzDDVuByRT9mzs0XVSe6puxU-LWv0trByEdToRr4nug&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ9YYWIaBDCHazL2vr3ne3xL26D9Qho9cqrVGgePbTIQ&oe=6AECB0FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer", "keywords": ["city", "formula", "race", "racing", "sports"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1396210800247848"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/787089464_2962579034126694_8710168046293803171_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqfRqN590DcQ7kNvwEG2ZbI&_nc_oc=AdrOj46dsjwOA5bEvLoCJ6Cm5UC
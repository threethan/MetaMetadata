64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTl7m7V8bW0Q7kNvwG3YTgv&_nc_oc=AdoPfcYdkuhGKRkm1Gl_IdB8eE9t4_Mo_3EgBghto2gRpwTtsSmvkV6q9rxLko4tZ44&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLMPegHVYZ7A9anHV3DnqJXE3EPKaLUCTS7QF7WJAuMQ&oe=6AAE97C3"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UryfdNHykrcQ7kNvwHbavTt&_nc_oc=Adqvn9CZnkmCAs00Su8c-0j7YD8KwAh74AwttjLyYyHE9_h89ihT0ADdBn5mIP-_ScM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC9_hHgEuRh_lEDIMI8dA2niuuNY-DZ_-Zw4e-RVRUEw&oe=6AAE8BCA"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wek1pNPjALwQ7kNvwFWgUxD&_nc_oc=AdrHEPxcX4FAUvvLEl2KawxyfHRscf5tJ9V00BlTm5lnUytffPaHIF1q007ahZ8df9k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId8t2WkGQQsZCES8Y_hi2Y8GiaJy5CwKFg9o8l8VEdGg&oe=6AAE8ED5"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENzyILJz2lYQ7kNvwE0HhAS&_nc_oc=AdoiCT8JgK5rcvxFC1ZuJhyAo9b9UnfxE8lhs8c4qbtr799UHb-pZBor9SDOIDIyFAE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsM0B2PI5fgcmzLakVyavBuskBHM_erzljLQE6p8J0qw&oe=6AAE823D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres
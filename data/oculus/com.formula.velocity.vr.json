26_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4KmCY5pw-cQ7kNvwGHqYsu&_nc_oc=AdorsoqOZ3jVvLArr52TLRpXcuaCQI8wZXn2WzyxvypMjlVqKi0vdyBeKHP9HZwm43M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZc0xV8_cAt79KTnBINEilphQD62scChlYOGosnuhC_w&oe=6AEE00FF"}, {"file_name": "Portrait.png", "id": "1131190979609286", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_1131190982942619_1545673628298544254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZyb3oAKNxUQ7kNvwHoMHXC&_nc_oc=Adq3eFQmf7GKmOA9VwpjsCDuL8N_ngP8elPfCcO14YUONwgSH_QQsRTeKgPw-c_AROE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfC3jPKraDah8H46FqyUb_fNZoU6HyVH1Xr92kF0bZrQ&oe=6AEDF78B"}]}, "id": "1679913710167111", "locale": "en_US", "screenshots": [{"file_name": "4.png", "id": "1585860042996347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310734_1585860046329680_2520353159314434035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iryysvc6JMsQ7kNvwGv2lOO&_nc_oc=AdpJKXHts36tM_T9al4PgRKTaotiyEDDk7Bmj-1HwdY_bIM5bvx1blNVjcxUY6ea_do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeB4AmG5lKI8KX2BQcZCWNsNZ0ET4nfKEO7qpin8pFzQ&oe=6AEE0B62"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVrRwdXnVeUQ7kNvwFW_I6Q&_nc_oc=AdoQ3bbQxKjyC5VgQ24s-TDIBm3d2rng1gVE0xeZ1iBGd9EHyVTeJ6wmR7aYuE6_PQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST2BRoSjZic4kvKEnWcyX5uRCJt7fsZxUnjbWR8NNnSw&oe=6AEDDFC3"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ-EYJkYGs8Q7kNvwFUcx2u&_nc_oc=AdqMkw4d4DvitbTcnNPu8zhRAfdDyS3FL6Q1oBvHb9Pa1PG7qGM7uD7TWTjiIdTRKAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8p1rqB7Cw_cvJ7HRnGvo8GQKuvJgstJLrrhKQLYlL_Q&oe=6AEE0C0A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfq-rOXxuE0Q7kNvwF-muGg&_nc_oc=AdrpCbeUJq6UcaRf-kxSqfDOwHRTXTqBWVXLKhDwT2mdzdo91vyzWtiX5vLthbWDNOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYIZFPzMXAAwznO_EPgJhgT1e1P2AG1dBtQ_4Wa5Ur5g&oe=6AEDD6D5"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyFULLZxoT8Q7kNvwHn9urb&_nc_oc=AdpCF5JeI3ymNQZoiGHP5myStsjij7qAY-UGxZS77aBmYvvXo8SaqKmk3SLGp_FNB6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzkupXvUo7L1fTQktlyVhco2OG7Ha_fQUevUXA4gSMdg&oe=6AEE027D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer", "keywords": ["city", "formula", "race", "racing", "sports"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1396210800247848"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/787089464_2962579034126694_8710168046293803171_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqfRqN590DcQ7kNvwHmXBiH&_nc_oc=AdpZAw8_ryvDHkvWIJ0SAb0mWsW
585860042996347", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310734_1585860046329680_2520353159314434035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ye8y-KgByUQ7kNvwG6MdI7&_nc_oc=Adrvcg8Kt4EdDvXG-jSMgXZxeLr4e7s5vf4MU-NFdY1d6O_OYxI-THmVjqgJGlleN0U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMusvrW7MxqoHNqjwoU1dW5NVNqAUN7cI_o70gXH3P3MQ&oe=6AC8E922"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoGmnRYZXVQQ7kNvwH8l45A&_nc_oc=AdrNZNwb_qBVuvmLjbfSBGw8IesaPTF_RaYnZDKuV_2RtAFQFQgkrY50c3N2MAXH2cI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsoP7rIYJ9Rmkd-B2a4QqeGc5FNyjBP7_23Eu0pxX5sA&oe=6AC8F5C3"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baXFpGxidB0Q7kNvwHixf-h&_nc_oc=AdooONDNR48xpIahdGFE0pD5jgNp7ePzdhWVewXVz9fnMLJFPUZcOyPPTZy7r8q3XpY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3E3pzc57FOPg_s540TRhj9fuT87Dsi_lxoXmYvwWoxw&oe=6AC8E9CA"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUUANeKqtaMQ7kNvwHWR8Ho&_nc_oc=Ado11G3vngDLqbCfGBIdYbUrOGuWDId1gzn1MaQ5aMr1bfHq_v3MIQdgxZLZkYPAduM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvYEX66-cpeoN_RB_TqlQB_81jCZmCksDpxXLkLIKBzA&oe=6AC8ECD5"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvbZdC92AHMQ7kNvwFdumGZ&_nc_oc=Adpbbd3cHYE0vwzKkWQ5Jo8Uye6YdkAgPMqgB3tRJ91eIA4pl5bvQJKrske090S4p54&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMjcx0RqFfKU-6tScxbn0wc7L4-rki7-EKwTmgpElR7w&oe=6AC9187D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url":
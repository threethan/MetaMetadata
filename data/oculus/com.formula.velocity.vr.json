://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUy4rz3JZuEQ7kNvwFdfD7T&_nc_oc=Adq38SA8HTdHiAL5RGN15PJx4MB2YB1y9c_seZOYQ7wJDihrds1eCdXVAWFw3RqsAwE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExyzJC5iedgxpb4_lBz70RT_iAl4S5HRhAVA76AkMi3Q&oe=6A940183"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkkCjLtKtrcQ7kNvwFD5Ff1&_nc_oc=AdqE8F55rIEV5gUOtkaVKJvLbwzhJgMAOr_InGG8xMacKecrIc_7LON_jrc2m1v-3ng&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq4lSOyFK732U8wIOihblX8Iooh42Z2Ns24PMeS2ZRoQ&oe=6A942DCA"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBA6DZyE-ZIQ7kNvwHDGgUJ&_nc_oc=AdqV2k5NvpSR_FYkJ1E8X4IrlktTOy_4iHgE6yHNHdgVvn5f6BSMyBSON9XwKukwu3Y&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9n_yRssY1929HlXaijL4E0m6iMIFin3tGfMSJndVhIQ&oe=6A9430D5"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4DS5RzWkncQ7kNvwGhPxOk&_nc_oc=AdrznnuirQ5w_vM354xS_ZI3pXSMcStgPwR7dmX-ZfZKzxicNtM7pAmOfihuqJOlbz4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG51fxj5VAqpX__1Q8tFX98hvzxgYJ7QgyzX000SPo0g&oe=6A94243D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscript
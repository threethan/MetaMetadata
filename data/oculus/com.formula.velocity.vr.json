kZrZJvg821K1-9HBC22Flt7AR56rd4RxTF8i5eBcznnSPZQJD8uzN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpW_SAHlvlSfZszzYHFc6Y39Yb9b5SMW_d2YAVnNI3RA&oe=6B105262"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaPw6-yHew8Q7kNvwEfYcHj&_nc_oc=AdoqoNnmW7ez0dY0OFg5TQM75_VQkulklm-XF6mE_m_XN2OYhAP7wmaBQkbI2n1i_Oc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJwaclP0oQUyFSGvOBpIbBMx3PK4HObNQpTEs_u20uMA&oe=6B105F03"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byQrzN-onRsQ7kNvwGH6Xmi&_nc_oc=AdqDuBFC2Vqg8Yl9ylS4asIpE_S04BbOFUu1k7Eb16hQ8s-Tn_LbCY8I-hs6xjNQm6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUW8aEU6uoXaM6_FKxQPmvRKeUIIQAadxusKMYbVjyQBA&oe=6B10530A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3xrxn4TZOkQ7kNvwHU9l8P&_nc_oc=AdofuLTrYKpIXMTBLblgPii161JkKsIFHwrXOkrU65SNO86izli8xNN0XsZeWOW4pdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoSLB1jjJPW4MKF71cPwPufGaCQkoR4hvf-BZHVyd3gw&oe=6B105615"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElnvIYaHrSoQ7kNvwFHR-X_&_nc_oc=Adpb6zlvCpvKEa4CP6N5bAQyNc2hwnRpOrdFdlYrvzU0G9AOFY-KkQ-blwfD3okouB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXeChEyHdfaX4X3ukTgLX1-OZue7OSSDtePTYEQVJ_VGg&oe=6B10497D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer", "keywords": ["city", "formula", "race", "racing", "sports"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "webs
_AQJ2Us80ofhGEjMWje6xd5mpaQwnFJvpUsNyBLCbwL4Uzw&oe=6A9C1622"}, {"file_name": "1.png", "id": "2109492799978791", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9LRdOdigOsQ7kNvwG7DjRJ&_nc_oc=AdpcIBINknc6rwI-4edqrqgGIEZSxY2HDzp1ASoVPCczhkxyMxHFrZdZSqJAltX-DhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsvhBER2gxcv5QSlKL5DIxb8pNxfX7dgwit9CeJ_O-MA&oe=6A9C22C3"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYJA7sCAgI8Q7kNvwHm1Jjy&_nc_oc=AdoSYNGGNbtxRBF63S0G95qOoxocOlkm7MDy8bp4bSczmhLyqcT7IgD0ZElm1BOJUso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDohaA2ZINlCvlHPkkK0HXwQExymJN84gbx8xHE9fdZA&oe=6A9C16CA"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMb8dOjZjqsQ7kNvwHGvw0D&_nc_oc=AdqIHUo1FDqkxcdvE4qA0JhwuROdaqI0rp2R2NXDXL4bDH6fR9mN_qv2zKn9SYDRJ_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvg6ITNpxbbhyEvmFitgS5k7A02m5Uq1tGoAY5GXF1zQ&oe=6A9C19D5"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gLg-adZBfUQ7kNvwFlD2LJ&_nc_oc=AdouDj2oxraiqyQPXNRe1DW5ZpMdZ3jZOsxbKB8vVQVw4FDbMTbkHyA7s-z3C9TxRIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV_bU0iITAseKq0g0VzPCbKv5mNm2gzr8rp3sVN3fFvA&oe=6A9C0D3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534",
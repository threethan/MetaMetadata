ntent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312454_2109492803312124_6168041457191444923_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85G6M8qb110Q7kNvwHZcp-F&_nc_oc=AdpDI0f_Y3C8LfTL2TZIOcYw8PKgCHptVStFkNTrsBoGe_Wx1IuR5fD-6p2wUKiXZt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFRKzYTAMI15Pgs8ohqlIsHjf4iCJrKzSVTqtJJ9crhQ&oe=6B033003"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynvx6sFjQZIQ7kNvwHJ3zvZ&_nc_oc=Adpqgqmhp7n6iAplUF0Clb5UGncYYgZ7MWExAqM5tDF8IsVejEuqSJycD3TOONPeoqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1gEqLtmq51zIDOZAipL-m3_VOay-cnQE0eUToqgGHOw&oe=6B03240A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2jh577xCsEQ7kNvwHf_r21&_nc_oc=AdrFuyU6h_BNHjbMKP4elBEr1dtbhewONniCZ1CLdmRRyl0kQkGAo-SRRPdrDq30nPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiZYhYZBfbNv1WmnRau92ffH6JNScOx4rzgYX8VH93EA&oe=6B032715"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHK0Oyi6DMUQ7kNvwEkWSGh&_nc_oc=Adr4QWB0q2pzEob9oYGC-7Vv0guDRDFWzwnlGCSbc3WGDkPSi4NWYx1wnVjphGwxYKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL_n-252RLHIUI6Jjc9Wkv9WFVPUGKsnIksZI-CdI71Q&oe=6B031A7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer", "keywords": ["city", "formula", "race", "racing", "sports"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "6733851832
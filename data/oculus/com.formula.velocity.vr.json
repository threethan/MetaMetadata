MOhfm7PLtkYZhkDpO5XwxQlYADF6Sjqo5Xktu7L9Ism6twnvWdKdB7L_fRFWbU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYXUdSKn_FDIAnA3DKl-HgM1pxND9__PeAnw4du9j4bA&oe=6AE20243"}, {"file_name": "3.png", "id": "1009420911937123", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzP5-gozEQgQ7kNvwEBN3_v&_nc_oc=AdofXO5rq1kJ_rDfun5Ny4DNy4IUIDBIH2heHsYUJsMYexC1F3y75XjyCorBhWL2Asc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtbsLdzBLMGE1tQih84UYtfhCwCkZW6ADcX8TDMKXg0w&oe=6AE1F64A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20ygPrzRcPEQ7kNvwE5N-M4&_nc_oc=Adrs8DKr5vP5Br1SlLJcCPqSvTZnglrk4rsqPF9xRK23e0bFVXKZyT6GcCP5XBxIHq8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2lHD8Ld4b9TdAtZZIgjF-4hriPP_-XcL9v0UUkvJBaQ&oe=6AE1F955"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz5sxz16qi8Q7kNvwHD0GHX&_nc_oc=Adq6IDjwmfg3cS5DqUF94UUDkuLF7goTaOfg3M_iR448bfIUdeqIBits1W5wAhu8ml8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoXgLWkvtSrhAs2UnQpbtTZtxWvAxrMpPZwqryRZ8YaQ&oe=6AE1ECBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
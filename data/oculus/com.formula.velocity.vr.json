tps://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593858738_1009420918603789_7770799512677328953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAbLdPGJmjsQ7kNvwFbu4k9&_nc_oc=Adp5HrJHZfNhfuxk5-CGu78Ds4713uCuBaI8QWSPqeRPC0T960YlmOjRbneHcSM1VDY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_2MNgnvAfrnP7BzmiX_TSkG8p5GHgYbrOH2avoWDqqA&oe=6AD3AE0A"}, {"file_name": "2.png", "id": "1568603708105724", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312332_1568603711439057_6638901497728289888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6UGMD4Ve00Q7kNvwEzLEL-&_nc_oc=Adpgrhurj7FQFxO5Vj78A6s-9OOnf5MSTI94TIJ_mEhe82d-eiK-gQRlSr5jGUZxwbE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcmHySYnD7_Qd4DA06BMBwO7KK1WI9Itr0w3qKx-hr0w&oe=6AD3B115"}, {"file_name": "5.png", "id": "1666228574484583", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312470_1666228577817916_4801998343550850000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPGCctfxJb8Q7kNvwEjpwHU&_nc_oc=Adq6KY4zJsQDV7eBAhQEGwBdPwAhNJMsFhsoUa83fg-V7EgYvYp3lHnZFEi1ZYpV8Po&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFqPuQoMH4KSDnhCpOAw2D4b-2T8MDni4CudibPMpN8A&oe=6AD3A47D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Velocity VR", "keywords": ["FormulaCar", "OpenWheelVR", "VRRacing", "CockpitRacing", "RacingSimulator"], "long_description": "Formula Velocity VR is the formula car racing experience Meta Quest has been waiting for.\nSlide into a fully immersive open-wheel cockpit, grip the virtual steering wheel with your own hands, and push a high-performance formula car to its absolute limit. Every corner, every overtake \u2014 felt in full VR.\n\ud83c\udfce\ufe0f Three Hand-Crafted Circuits\nThree tracks built ground-up for VR \u2014 tight street sections, sweeping high-speed corners, and technical infields that challenge every skill level.\n\ud83c\udfae True VR \u2014 No Compromises\nDesigned exclusively for Meta Quest. Motion controller steering, a detailed working cockpit, and comfort settings tuned to keep you racing longer.\n\ud83e\udd16 Single Player Career\nEscalating AI difficulty, career events, achievements, and leaderboards. From first lap to podium finisher.\n\ud83c\udf0d Global Multiplayer\nReal-time wheel-to-wheel racing against drivers worldwide. Draft, defend, and fight for the win.\n\u26a1 Realistic Handling\nTire management, slipstreaming, late braking \u2014 deep enough to reward precision, accessible enough from lap one.\nAt a Glance: 3 VR circuits \u00b7 Open-wheel cockpit \u00b7 Motion controller steering \u00b7 Career mode \u00b7 Global multiplayer \u00b7 Car customization \u00b7 Leaderboards\nBuckle up. The lights are out. Go.", "short_description": "Strap into the cockpit and feel true speed. Formula Velocity VR puts you behind the wheel of open-wheel formula cars across 3 hand-crafted circuits \u2014 with realistic physics, AI rivals, and pulse-pounding multiplayer. Built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "120
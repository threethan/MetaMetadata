nc_ohc=FE57saSkd8YQ7kNvwGb-_mY&_nc_oc=Adm8ucp3HqztsU59-2cI_qRoTTVSRVvh6ZDOKiJ2Pf65I9GrkbA8FE2mwhlxPdZ5x1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft20zQ6v2nwEjkGE9trsXT2mMLPP3QVgHl7-rtzOOtNVg&oe=69A2F13D"}, {"file_name": "Screenshot 4.png", "id": "1002536005369383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299201_1002536008702716_2481660248282128125_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs3HLlh6x0gQ7kNvwGXhQVT&_nc_oc=AdlYA0BtvmQCse4I55OpD8VAAsZbr3xkwO905rxPXjBODrV9H1wWo7vFGQiOZSLlnnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYrCmTHzXKbBKNh_kDoH_sx4XXovmSakE01aQVRL0c_g&oe=69A2E5DD"}, {"file_name": "Screenshot 5.png", "id": "1247507606884944", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301073_1247507610218277_7876549522657136285_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQvo9z0v7ZwQ7kNvwF-E3w0&_nc_oc=Adkx6KiqOCuN2sA0DyQvH7kZqS6RmuFxQTThF6-ybr82aKyD5o0bG7S_PGQdwXKow-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftohgR1oVwVxEB2EyCBA0vVWKSVmBP7ZQpdZ2OIMr2zxw&oe=69A2ED25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munkies Island", "keywords": [], "long_description": "Munkies Island\n\nRun, climb, and explore in VR as you dive into the oceans of Munkies Island. With a unique locomotion system that uses only your hands and arms, there are no buttons, no sticks, and no teleportation\u2014just pure freedom to move. Push off surfaces to jump, and climb the trees to cross the island to escape your friends.\n\nIn the game there are two game modes to choose from:\n\nTag \u2013 Sprint, jump, and climb as you chase or run from the other players across the island. Use the environment to your advantage and outsmart your opponents to secure the win.\n\n\nCasual \u2013 Sometimes you just want to kick back and relax. In Casual mode, hang out in the treehouse or explore the island with friends. There\u2019s no pressure here\u2014just a peaceful place to chat, chill, and create your own fun.\n\n\nThe movement is easy to pick up but hard to master, giving you plenty of room to improve your skills. Whether you\u2019re avoiding a tagger or simply enjoying the island\u2019s beauty, there\u2019s something for everyone.\nThe island is yours to explore, with palm trees to climb and hidden spots to discover. Jump into the adventure and make it your own.\nBecome Munkie.\n", "short_description": "Run, climb, and explore in VR as you dive into the oceans of Munkies Island. With a unique locomotion system that uses only your hands and arms, there are no buttons, no sticks, and no teleportation\u2014just pure freedom to move. Push off surfaces to jump, and climb the trees to cross the island to escape your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1LULye7vTup6dzAbRj2VZoGn_rbvGJ7DprJGKUKuDXnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dreamspace Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/munkiesisland?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "31561162766865255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499365338_1931663714270234_5571187579044250310_n.pn
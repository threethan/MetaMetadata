n.com/v/t64.5771-25/499298442_752401843778750_9014938859268885462_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH0-FcMsuLYQ7kNvwFv5DT-&_nc_oc=AdpVmK6wfALkh7lyu7b1DB4FSUYear8H4DcjF5pLMUsJQ_knVVG18lO12c4Mm9jD9qg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6d1iIFeSgE1v3G80wdoj4t1yU7x-dXiAFl852598YeQ&oe=6A7DCA3D"}, {"file_name": "Screenshot 4.png", "id": "1002536005369383", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499299201_1002536008702716_2481660248282128125_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WApB8fuITSoQ7kNvwFvQdVN&_nc_oc=AdpTZ-LOMRxhPWOHGONZxpSdy8M8k-U2yAbg3FKBuGfofRkzg_2VRndkkZHgwsSOneE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbO2D_6aic_rw_ZBjrSEKNFGeRohV38h5EaqbDU8hBWQ&oe=6A7DBEDD"}, {"file_name": "Screenshot 5.png", "id": "1247507606884944", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499301073_1247507610218277_7876549522657136285_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nev_mOjgmQ8Q7kNvwGZ35B6&_nc_oc=AdqxAYtMpLlfiMVVhXbE4KXVtpTAYJNnCDny8vgZWzpr1pq2A2_lsVoYw2qL-zcJDK8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNZ9GJx1LQwrdkWodi1H_B3uIUMJ0HtSyGelAQDieJhg&oe=6A7DC625"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munkies Island", "keywords": [], "long_description": "Munkies Island\n\nRun, climb, and explore in VR as you dive into the oceans of Munkies Island. With a unique locomotion system that uses only your hands and arms, there are no buttons, no sticks, and no teleportation\u2014just pure freedom to move. Push off surfaces to jump, and climb the trees to cross the island to escape your friends.\n\nIn the game there are two game modes to choose from:\n\nTag \u2013 Sprint, jump, and climb as you chase or run from the other players across the island. Use the environment to your advantage and outsmart your opponents to secure the win.\n\n\nCasual \u2013 Sometimes you just want to kick back and relax. In Casual mode, hang out in the treehouse or explore the island with friends. There\u2019s no pressure here\u2014just a peaceful place to chat, chill, and create your own fun.\n\n\nThe movement is easy to pick up but hard to master, giving you plenty of room to improve your skills. Whether you\u2019re avoiding a tagger or simply enjoying the island\u2019s beauty, there\u2019s something for everyone.\nThe island is yours to explore, with palm trees to climb and hidden spots to discover. Jump into the adventure and make it your own.\nBecome Munkie.\n", "short_description": "Run, climb, and explore in VR as you dive into the oceans of Munkies Island. With a unique locomotion system that uses only your hands and arms, there are no buttons, no sticks, and no teleportation\u2014just pure freedom to move. Push off surfaces to jump, and climb the trees to cross the island to escape your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1LULye7vTup6dzAbRj2VZoGn_rbvGJ7DprJGKUKuDXnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dreamspace Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/munkiesisland?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "31561162766865255"}, "review_messa
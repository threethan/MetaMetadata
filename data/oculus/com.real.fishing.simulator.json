=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTLUzobI1CHmfaPmQFzhiUsjOzC7MouD-SciLATchMtA&oe=6B0DAAD4"}, {"file_name": "2.png", "id": "1092295876957619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831964_1092295880290952_4508271140630355981_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUvfEnvlwPEQ7kNvwHQ-v9z&_nc_oc=AdoG-36_dcHuwSV2RdBJ3AyDfmVP_xcUm-k9eHd6Lx5q-u7xyBxUp1Li0kUuiUEXC7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS78FaNw02mUiKHz-UXWp8udXgbD5Lsj3KtWqQpoTI1YQ&oe=6B0DC9F8"}, {"file_name": "5.png", "id": "1043661045365717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/761640323_1043661048699050_3422244807608158925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izG1iIJy3dcQ7kNvwFdoK2G&_nc_oc=AdpzgQP2YtwL9e64Me8ryp3cqUFEDlm5PIG7KoLyTT86hIbQ-kCpbkAYoXbR0fVwecs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9_i_zas9C3OCVF4vTnCNqj0CDTX6OmbMHptcJ1li-ZA&oe=6B0DA644"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real Fishing Simulator", "keywords": ["real", "fishing", "simulator", "blitz", "fisherman"], "long_description": "Welcome to Real Fishing Simulator \u2013 The Ultimate VR Angling Experience! \ud83c\udfa3\ud83d\udea4\n\nStep onto the boat, feel the motion of the water, and test your skills in the most immersive virtual reality fishing game on Meta Horizon Store. Whether you are a casual angler or a hardcore enthusiast, enjoy a true-to-life simulation packed with deep mechanics and exciting challenges. \ud83c\udf1f \n\n\ud83c\udf1f KEY FEATURES:\n\n\ud83c\udfa3 Ultra-Realistic Mechanics: Master the complete fishing process\u2014from picking up your rod and opening the bail to casting, managing drag, and reeling in fighting fish without snapping the line! \n\ud83c\udfae Immersive VR Controls: Designed for motion controllers. Feel every tug, rotate your reel hand-over-hand, and use your free hand to land your catch. \n\ud83d\uded2 Tackle Shop & Upgrades: Earn cash and XP to upgrade gear. Unlock better rods, heavy-duty reels, and professional lures for rarer species. \n\ud83c\udfde\ufe0f Global Destinations: Travel to famous spots\u2014from calm mountain lodges and serene lakes to deep-water rivers. \n\ud83c\udfc6 Daily Goals & Tournaments: Take on daily challenges, complete collection journals, and compete in tournaments. \n\ud83d\udc1f Keep or Release: Keep your fish for cash or release them for bonus XP! \n\nGrab your rod and start your angling adventure now! \ud83c\udfa3\ud83d\ude80", "short_description": "Dive into the ultimate VR fishing experience! Real Fishing Simulator brings realistic physics, breathtaking global locations, and immersive tackle management straight to your headset. Cast, hook, and reel in the catch of a lifetime today! \ud83c\udfa3\ud83c\udf0a"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1417608468099862"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id"
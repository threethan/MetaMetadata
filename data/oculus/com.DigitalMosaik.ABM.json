t=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIyYpRu7Ca4iskc0BcYTktnvVDrSoDb6MvKfnDO2Vg3w&oe=6A6DECF0"}, {"file_name": "6.png", "id": "272119357481836", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036644_272119360815169_7377751046960096522_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8ygtCgjCpgQ7kNvwHqyrXV&_nc_oc=Adq0LDAqBF1-mbwZK6nBIewJKdiKtvdslJHc0qV1B74O_t_Yrqbu8fz3R78ImtIV-14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy7KUSS0Ht6q-2Nc4wI9afInWP25ZYRjp5Cqe7P-dJJQ&oe=6A6DE1C0"}, {"file_name": "+7.png", "id": "1388656028005663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_1388656031338996_1044566759170430884_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCprFjYp6ZsQ7kNvwGDvLgL&_nc_oc=AdpXlAQeDhbvMJ2td3Olu7sGtrAduR_tlfVTU-Ymb8L1lpadziN5hcdIFDP6a-2_-PA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDdQPQzybL0AMU9Gzj3vnNSkZD8YAyRaNZZKimzVaaAw&oe=6A6DEE7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aceto Balsamico di Modena - VR Experience", "keywords": ["vinegard", "food", "madeinitaly", "italy", "modena"], "long_description": "Have you ever wondered what a drop of balsamic vinegar of Modena PGI holds? Why is it called Balsamic, and why does it have PGI status? You are about to enter a world much older than you can begin to imagine..\n\nA narrative story developed for the Consortium of Balsamic Vinegar of Modena, an institution that deals with protecting the originality of an excellent Made in Italy product.\n\nThe VR experience transfers the distinctive values \u200b\u200bof the Modena product, to help the public all over the world to appreciate, recognize and look for the real Balsamic Vinegar of Modena PGI.", "short_description": "A sensory voyage in discovery of Balsamic Vinegar of Modena PGI."}, {"images": {"nodes": []}, "id": "556501488374612", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aceto Balsamico di Modena - VR Experience", "keywords": ["aceto", "cibo", "madeinitaly", "modena", "italia"], "long_description": "Ti sei mai chiesto cosa c\u2019\u00e8 in una goccia di Aceto\nbalsamico di Modena IGP? Perch\u00e9 si chiama Balsamico e perch\u00e9 solo quello di Modena \u00e8 un\u2019Indicazione Geografica Protetta? \nEntrerai alla scoperta di un mondo molto pi\u00f9 antico di quello che potresti immaginare..\n\nUn percorso narrativo realizzato per il Consorzio di Tutela dell'Aceto Balsamico di Modena, un ente che si occupa di salvaguardare la qualit\u00e0 di un prodotto d\u2019eccellenza del Made in Italy.\n\nUn'esperienza VR capace di trasferire i valori identificativi ma soprattutto distintivi del prodotto, aiutando il pubblico di tutto il mondo a saper apprezzare, riconosce e cercare il vero Aceto Balsamico di Modena IGP.", "short_description": "Un viaggio sensoriale alla scoperta dei segreti dell'Aceto Balsamico di Modena IGP."}]}, "developer_name": "Digital Mosaik", "developer_privacy_policy_url": "https://www.digitalmosaik.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Consortium of Balsamic Vinegar of Modena", "support_website_url": null, "website_url": "https://www.digitalmosaik.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "332098535484076"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "CANCELLED", "id": "16237605229
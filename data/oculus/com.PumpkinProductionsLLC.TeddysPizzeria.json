gBLEFGED0lJXYLDzwGRMdgh3GUl_7-qUwUS5JvheCV8GfxU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9kPQUIF3G-aSbwQkB1MNA9h1n1bbqMh2V43SvdXpWvg&oe=6AA01078"}, {"file_name": "New Project (10).png", "id": "1205441165038644", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823790_1205441168371977_5809491352518320452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrg8vUbawkkQ7kNvwG2XbL4&_nc_oc=AdpXt9ONBa6rD2KaKJrOppS-qpVfHIGEbQAg5yUahHdDBYPF914D5F3mf9nUG9edsWE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJasLfs9ET8FJw5oXXFVx2ork8Oz3t2hl-pxU2k-uJdg&oe=6AA023F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499618298_1450163709829861_2123210422209342854_n.png", "id": "4538689399786702", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617831_4538689403120035_4404579291015801617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siDKH5f-T_YQ7kNvwFziT1n&_nc_oc=AdrbT1eLONEKorv8Hm4oNBZw7eozkc4VMW5gM5ZstgNuzhmH2ER4X_TuBblor_0iHAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5Pmf65yfUAVv2SywGdVG6JtvVKrNLIO2JHEPa7SeRtw&oe=6AA01BF1"}, "display_name": "Teddys Pizzeria", "keywords": [], "long_description": "Welcome to Teddy\u2019s Pizzeria, a horror experience set in the early, forgotten years of Taz Monkey Entertainment, long before Teddy\u2019s Pizzaplex was ever built.\n\nEach night puts you in dangerous situations where survival depends on awareness, strategy, and nerves. Take on stressful night shifts, risky repair jobs, and other tasks while deadly animatronics roam the building. Teddy and Chicky are always watching, waiting for a mistake.\n\nNo two nights play the same. Use modifiers to change how the game behaves\u2014some make things far worse, like encounters with Golden Teddy or Shadow Teddy, while others can give you an edge, such as extra power or faster nights. Choosing the right combination is the key to survival.\n\nEarn Taz-Tickets through gameplay and use them to unlock modifiers and push yourself into harder, more unpredictable scenarios.\n\nNot everything in the building is finished. Rilla, an unfinished endoskeleton, still wanders parts of the pizzeria. He\u2019s unstable, unpredictable\u2026 and oddly attached to his banana, Nana. Ignore him at your own risk.", "short_description": "Explore the early, forgotten days of Taz Monkey Entertainment, long before Teddy\u2019s Pizzaplex. Survive stressful night shifts and dangerous repair tasks while avoiding animatronics like Teddy and Chicky. Change how each night plays out with modifiers, from terrifying threats like Golden Teddy and Shadow Teddy to helpful boosts like extra power or shorter nights. Earn Taz-Tickets to unlock modifiers, and watch out for Rilla, the unfinished endoskeleton\u2026 and his banana, Nana."}]}, "developer_name": "Pumpkin Productions LLC", "developer_privacy_policy_url": "https://sites.google.com/view/pumpkinproductionsllc", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin Productions LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/pumpkinproductionsllc", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26046719481648571"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "898905069785431"}]}, "baseline_offer"
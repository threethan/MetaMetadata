077862149_5720584195004137387_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsiGGKw-JgsQ7kNvwEK7WRG&_nc_oc=Adomk7nS12zfgM3kfXPR6QWhyOYFqQQJv0u90dtOZFeXTJvlfC6X-H7IIXij7n4tGzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsxQ8XpSBGFtPU1dn4dsIHbX7T4qwlGNHB1NOfD7Nh6A&oe=6AFC8DB7"}, {"file_name": "2.png", "id": "1039198431000511", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821920_1039198434333844_7106976977011833921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JurqVEV3wFgQ7kNvwERlH6q&_nc_oc=AdrhHcVuJh-4gNL-LAHYg3reiztxhJ1MH021gEh06_wvNgIQhI3PJLfTPjrrj9msBNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQx1WNFGE7qOBhzEBfLqWK9DUktDupfXnAchsMCgnnlQ&oe=6AFC6D4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Club VR", "keywords": ["Hunting", "Simulator", "shooter", "shooting", "hunt"], "long_description": "Immerse yourself in the Hunting Club VR demo - traverse America\u2019s most iconic national parks, from the Grand Canyon\u2019s vast rims to Yosemite\u2019s granite cliffs, Yellowstone\u2019s geyser basins, the Everglades\u2019 marshlands and Zion\u2019s narrow canyons. Track realistic waterfowl behavior against dynamic day-night cycles and changing weather.\n\nThis early-access demo focuses on core hunting and single-player gameplay - only duck hunting with a shotgun is available now and no multiplayer modes are included. Study flight patterns, adjust your aim and earn demo-zone rewards as you perfect your timing.\n\nComing soon - additional species, rifles, bows and gear, plus online co-op and competitive multiplayer will expand the full Hunting Club VR experience on Meta Quest.", "short_description": "Explore national parks - Grand Canyon, Yellowstone, Yosemite, Everglades and Zion - in the Hunting Club VR demo. Hunt waterfowl in a single-player duck-hunt experience with a shotgun. Future updates will add more species, weapons and multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9753045381446032"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1419491886241155"}, {"status": "PUBLISHED", "id": "1546038213057651"}, {"status": "PUBLISHED", "id": "668185662633209"}]}, "baseline_offer": {"id": "1419491886241155"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767877740, "status": "PUBLISHED", "id": "1419491886241155"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9802598536490716", "version": "0.2"}, "id": "1198827285363609", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9753045364779367", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9802598536490716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel
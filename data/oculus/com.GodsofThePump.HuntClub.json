=8D-mDlVV4OQQ7kNvwFQcZwi&_nc_oc=AdpYefIjB8qg66BGxFFRdHgULqmR4qbGMtnzJMcztPUSQlrXGUtVdrgngxkJN-NwKaU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7yKOyhtOh4S_sy3QyRAN_UW_ehYqNNWhWK7kTZXAl_w&oe=6A395E3C"}, {"file_name": "5.png", "id": "1173951071195483", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396577_1173951077862149_5720584195004137387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRfDd74Q35EQ7kNvwFVXXtk&_nc_oc=AdrHOMBBIx933GB82jnzQ2jA0G73defodhAskHn3nVHFrTi64OJxQBe4xIuaXTHOnBQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zXvqitOm98eoR5fbBKYML6BxXIGNptuozS_EDU01AcA&oe=6A393777"}, {"file_name": "2.png", "id": "1039198431000511", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821920_1039198434333844_7106976977011833921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN6DYhdwK3wQ7kNvwF0PyTP&_nc_oc=AdoMKZvt3VuuGXyUGkvVlD9f7feBxNZiYD9MtMdeQkMYJ767Xo8q4ZjQv-bJS-6Usg0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tx2SxGAGdwbM7k7_D210__Tm_rXlQPYF10pqcvosvWw&oe=6A394F4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Club VR", "keywords": ["Hunting", "Simulator", "shooter", "shooting", "hunt"], "long_description": "Immerse yourself in the Hunting Club VR demo - traverse America\u2019s most iconic national parks, from the Grand Canyon\u2019s vast rims to Yosemite\u2019s granite cliffs, Yellowstone\u2019s geyser basins, the Everglades\u2019 marshlands and Zion\u2019s narrow canyons. Track realistic waterfowl behavior against dynamic day-night cycles and changing weather.\n\nThis early-access demo focuses on core hunting and single-player gameplay - only duck hunting with a shotgun is available now and no multiplayer modes are included. Study flight patterns, adjust your aim and earn demo-zone rewards as you perfect your timing.\n\nComing soon - additional species, rifles, bows and gear, plus online co-op and competitive multiplayer will expand the full Hunting Club VR experience on Meta Quest.", "short_description": "Explore national parks - Grand Canyon, Yellowstone, Yosemite, Everglades and Zion - in the Hunting Club VR demo. Hunt waterfowl in a single-player duck-hunt experience with a shotgun. Future updates will add more species, weapons and multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9753045381446032"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1419491886241155"}, {"status": "PUBLISHED", "id": "1546038213057651"}, {"status": "PUBLISHED", "id": "668185662633209"}]}, "baseline_offer": {"id": "1419491886241155"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767877740, "status": "PUBLISHED", "id": "1419491886241155"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9802598536490716", "version": "0.2"}, "id": "1198827285363609", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBi
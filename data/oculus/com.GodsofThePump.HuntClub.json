nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28n3V4ZMmacQ7kNvwF0vi_D&_nc_oc=AdojdVYlSFFAM0LLfnz27vQGgGi4RBzFg6nKpBQ2BeQsYOrUjuDNBOstorbd14De7cQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXnfS1GCHXsNDPz3iX5VgjChY1g3s2gPPBGXBS24j9og&oe=6A69FEF7"}, {"file_name": "2.png", "id": "1039198431000511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821920_1039198434333844_7106976977011833921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC4WFLdFqZEQ7kNvwFGB-iQ&_nc_oc=AdqMzAv8G4AR8K9t6eyUsdlQ6Xu3pTeBapgdo2RhaQ6pJA1IKmir8dQfR7rQozGYVCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWgYZoBMSole6tLmAeeBhCc4s_qANRX-lDb4xMK4RNjw&oe=6A69DE8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Club VR", "keywords": ["Hunting", "Simulator", "shooter", "shooting", "hunt"], "long_description": "Immerse yourself in the Hunting Club VR demo - traverse America\u2019s most iconic national parks, from the Grand Canyon\u2019s vast rims to Yosemite\u2019s granite cliffs, Yellowstone\u2019s geyser basins, the Everglades\u2019 marshlands and Zion\u2019s narrow canyons. Track realistic waterfowl behavior against dynamic day-night cycles and changing weather.\n\nThis early-access demo focuses on core hunting and single-player gameplay - only duck hunting with a shotgun is available now and no multiplayer modes are included. Study flight patterns, adjust your aim and earn demo-zone rewards as you perfect your timing.\n\nComing soon - additional species, rifles, bows and gear, plus online co-op and competitive multiplayer will expand the full Hunting Club VR experience on Meta Quest.", "short_description": "Explore national parks - Grand Canyon, Yellowstone, Yosemite, Everglades and Zion - in the Hunting Club VR demo. Hunt waterfowl in a single-player duck-hunt experience with a shotgun. Future updates will add more species, weapons and multiplayer."}]}, "developer_name": null, "developer_privacy_policy_u
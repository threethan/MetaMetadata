nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RIve2U4ms8Q7kNvwEk52h6&_nc_oc=AdoUPuLlTx-LRupaBMDTtryBitDxgWp8qH-3gURXDzJBuAAXTodfT2qGNwLuDjMW7m0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYEAvt67TMS3pXrNebib5rnm5E9EP7PnD7A4KvsVTf-A&oe=6A6B5077"}, {"file_name": "2.png", "id": "1039198431000511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821920_1039198434333844_7106976977011833921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC4WFLdFqZEQ7kNvwHMv5V1&_nc_oc=Adqn4mFN-Qj5kM3ar8GelzwvCpxVkkbFDqoPNcpfGrOv18Y2fzOPKLyJw6SrdYjiI6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNY4Hzlda8ojwXpgMMc1AFWobeH-2HUIonNu5iJrLHlQ&oe=6A6B684B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Club VR", "keywords": ["Hunting", "Simulator", "shooter", "shooting", "hunt"], "long_description": "Immerse yourself in the Hunting Club VR demo - traverse America\u2019s most iconic national parks, from the Grand Canyon\u2019s vast rims to Yosemite\u2019s granite cliffs, Yellowstone\u2019s geyser basins, the Everglades\u2019 marshlands and Zion\u2019s narrow canyons. Track realistic waterfowl behavior against dynamic day-night cycles and changing weather.\n\nThis early-access demo focuses on core hunting and single-player gameplay - only duck hunting with a shotgun is available now and no multiplayer modes are included. Study flight patterns, adjust your aim and earn demo-zone rewards as you perfect your timing.\n\nComing soon - additional species, rifles, bows and gear, plus online co-op and competitive multiplayer will expand the full Hunting Club VR experience on Meta Quest.", "short_description": "Explore national parks - Grand Canyon, Yellowstone, Yosemite, Everglades and Zion - in the Hunting Club VR demo. Hunt waterfowl in a single-player duck-hunt experience with a shotgun. Future updates will add more species, weapons and multiplayer."}]}, "developer_name": null, "developer_privacy_policy_u
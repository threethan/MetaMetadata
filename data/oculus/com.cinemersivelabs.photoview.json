sive Photos", "keywords": [], "long_description": "The app shows photoreal 3D scenes, created from single smartphone photographs, dual lens camera shots, AI-generated images, stock photograohs or a camera rig capture using Cinemersive Labs technology. Six-degrees-of-freedom capability ensure that you will not suffer from VR sickness and enjoy higher level of immersion than with traditional VR photographs or videos.\n\nTeaser video music by bensound.com (license code: 1ZHJDBV9NWAXPWFV). If you recognise yourself in any of our content, and would like to be removed, please email dpo@cinemersivelabs.com\n ", "short_description": "Immerse yourself into six-degrees-of-freedom 3D photographs. Travel around the world without VR sickness. Iceland, Scotland, Thailand, Venice, Hawaii, Grand Teton, and many more, are all waiting! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/apps-privacy", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6837797099655998"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_945758706525336_6913836303642713151_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uadK-Abq
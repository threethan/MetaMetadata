 "343732500483423", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_343732503816756_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKSjpgVRRYkQ7kNvwHUphzE&_nc_oc=Adoi4-jRpB4BrLd21mw3SEqLXu2CNp3DvSESpV2tmY7X0Lnf8FAOJkuTtmshQyUJR1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXXM14ExPzzHLf8ZxF1ij8hKjt0dLqEOMmxXlpwTBHqg&oe=6ACF844F"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXK9sskomLgQ7kNvwEphDZx&_nc_oc=AdoLsB2rhF46KUKlsqmfazWtBYP3_3Fji7s7er_xACffF2LGOsW6XYQsI85c-qUqgj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj_aj5P3Fy_PGiBj3FTUJEfv03zLWYWbOjRVau0xrAkg&oe=6ACFBA83"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz9KsLjN6PEQ7kNvwFiFmKy&_nc_oc=AdpENoEnGNXCLTTTHJcSiM3e51mXfW2Dp_OhQD4heYP4NDzxEX7eeAM1-ntAyOq3p8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvvluXxh2zZ3Sy5T7ZT5TZLJMsm4YGL_ARffoGhRB9mQ&oe=6ACF934E"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgCvAMVfSEMQ7kNvwHcgyns&_nc_oc=AdogdamBCgioFL6tMsvVdNnJCcxX18JVL-4uDFyjr83Xozy7oxD5CbP3JUlBDzrOqoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrV3ltFBbiNr9jhQLN2djanlD1RsTq9Z0bWUrEolNP5w&oe=6ACF834D"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW2q9MDFl6UQ7kNvwGuoP4W&_nc_oc=AdrMrY0bclIt6xOiWHEM-PqwsALOat93-9zRTe86A_xLAGsPLq4QtMaoNcX2xNFmmXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg8ILddX0tdpYD2B2s2CAcgSwREwiE1i14GFSGn5XS6A&oe=6ACFB29C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hV-9gNdPGZ8Q7kNvwFh1Xm5&_nc_oc=AdqeEZaRcUkvNLmVOJjo6HN3dvOg7x4QBtCkmGMIT_QrsmjuKW8hbEQPUOUSP_Nzwug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmhJVD4AeMErXQvaix2xXpEUbC7IDmCZ-FQD7rTcrk4g&oe=6ACF8361"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dr. Bloc", "support_website_url": null, "website_url": "https://www.drbloc.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455727353053945"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2251301718962980"}, {"status": "PUBLISHED", "id": "1061119893233907"}, {"status": "PUBLISHED", "id": "2412709099214054"}, {"status": "PUBLISHED", "id": "1663723711305268"}, {"status": "PUBLISHED", "id": "1659656667998366"}, {"status": "PUBLISHED", "id": "2164483573747877"}]}, "baseline_offer": {"id": "2164483573747877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2251301718962980"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6190930700941477", "version": "1.0"}, "id": "506328637444046", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "
 "343732500483423", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_343732503816756_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I0Qkx3eSEkQ7kNvwGJE2aD&_nc_oc=Adpo1tzTM-yvKsAzL7DhWWPTtVlhj1H-vmx4gyh7t_Vs5fu-k763YWjUdIMVaGYS9GU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEth3kMx6Zy-i-I9CoOJ4Rlgkr-ifEUd46Qmd4ob5hazQ&oe=6A748CCF"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Wpk2-PXoL0Q7kNvwGGTSQ-&_nc_oc=Adod8h6_2JwtQWEaM3RDAol0q4T_owcUtnw8pjiGleOPmWqI7hY0qMZgRp4cUrXeNVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmGdEkrVvN9BVjFrhMjveRT_UPqWEaRRq3yNo5npucLQ&oe=6A748AC3"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcGiuQk3T9UQ7kNvwHdfDzb&_nc_oc=AdoXnXDPkSsicTI3QDmx00HB9p3R25RK0xQOX1gGEQ5ZVomweejgL9rLSTZfHkwWAn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_svAmVezrzry74ljZkI2--zuaD8mBmvXWVvKcuFmq9w&oe=6A749BCE"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2X8k0WzyNVoQ7kNvwG_xlYh&_nc_oc=AdpiSWQnN9rtH3IKSs9k9N3Xf9MGn8t7K0o6HgiRoXY3OTTfrGBdEC7rVLThm0TjRa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc80sFXdj3xKlbqu6j3vxkEOCMDlIrj1JeL2wKt9Mbrw&oe=6A748BCD"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhKjWY5AXY4Q7kNvwGkfzKd&_nc_oc=Adq-v1nLAiz21JmgVhPmZNFKmpUMhqDK3gLRUfvCRUHns_zZamq618rXBguGLLlWjIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPRu3du2pa43cflUn-03COpHX73jkmedz7wPptZdigYg&oe=6A7482DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo7NCLP3dkEQ7kNvwG2uWuq&_nc_oc=Adr3OUyz5cKmEOmV4upyuFb1Py2RUq1uZpUiwa2GvyOEVcLJO6MBKLEQlwTda428YvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSDA7u1fit2aHNqN603rFgxltRsIQlJ9FGErED5dbfeg&oe=6A748BE1"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dr. Bloc", "support_website_url": null, "website_url": "https://www.drbloc.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455727353053945"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2412709099214054"}, {"status": "PUBLISHED", "id": "1663723711305268"}, {"status": "PUBLISHED", "id": "1659656667998366"}, {"status": "PUBLISHED", "id": "2164483573747877"}]}, "baseline_offer": {"id": "2164483573747877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2412709099214054"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6190930700941477", "version": "1.0"}, "id": "506328637444046", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4131312370236664", "is_concept": false, "latest_released_binary": {"__typename": 
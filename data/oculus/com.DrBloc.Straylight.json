_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPlaFWv1CeAQ7kNvwFWRYuO&_nc_oc=Adn5XG5k6Gj1GbsfegudhKVeqhtdLeacoBS1ggVC8NzxaGUrFCr86t8T4gM79OKDg4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftOStEXXJAZSH0BGB-zQPTXP1gRH35srxb2oIruY7mjoA&oe=69A5914F"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drfUiGlrvJgQ7kNvwHqtCHl&_nc_oc=Adk0W3z6VgW1u-SHVvY7YShH5iuCKww8gUA46323I96JNUyBT1Xcmn3D6ocLqxFnruk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsq8QhG9iUKyHQHsgv1V5YxdD2Oq-KXEmjzPEuAIZKUfA&oe=69A58F43"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iqcxYcqvooQ7kNvwGAjz5P&_nc_oc=AdlIyA8XksnJiJJ-AUEvpNgQuU8fNQpznb6jcnpvMaBqQc2JAyn_HtLpV4mKgg9BJ7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftsEupfwrzxrnOpiKYxL0SxvszCRNYVlUpBenc_VwtBJw&oe=69A5A04E"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScKQmce-AqEQ7kNvwEgZ7OE&_nc_oc=AdlOSMwJ8CYHK4-N5qOL-YeEeMBc-kW5Ij7wzUFoc-XOZxAf52AJCls8YLwoFgWW5IA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfssQJorcuGjRWDjnQ7cbRWHgi1r-lpuB88mzus-HHrWGQ&oe=69A5904D"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBidcmf51GUQ7kNvwEvtczi&_nc_oc=AdnBxkJeBkck0jCH_24rfZ5fsOABUmdTd2B_xe8gfctVp8zVCBU_gBm9D_uJstnXpUU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsP7hz0JRbLkaYAasq8j6JV8ayiuCYqrM1_cc69XxMJRQ&oe=69A5875C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ptZwJuLc88Q7kNvwFAr1NT&_nc_oc=Adn6U5CD2gmLQxxn7oEL_QMNU33OPuK7BtYVy7XJNcSqjdDcrnkvEjB3CgDQj69FtJA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfueaLWik7j_aYO7HpaSzuTthaYS_deBw8JnlOtX8pnmVg&oe=69A59061"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "de
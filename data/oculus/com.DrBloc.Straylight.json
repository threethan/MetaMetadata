_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXkq4uWQpAUQ7kNvwHZEswq&_nc_oc=AdnDreLRRRXvbi4BGsL0YrgBwxyyr3Drgc82n4zcorE1u71jsbniPzsfC1tWTyHVFPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuBLhIZVbsDzuGW5_HgXtAzE5fc_hwGlZ1z8QG8tDDNsQ&oe=6998624F"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7Tb6C-0O0kQ7kNvwGRBBkE&_nc_oc=AdmlGbIj46JJO0bXxeAtnstyubAFlAyqVV2pMX-mOTiOUYPEa8DbI0ENe8prm_ylTa8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsP-StU0gjE_4kKOgZng6-DZGFs6kGTyEngdGxf69VGOA&oe=69986043"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r7zPijoNOMQ7kNvwEOtkoO&_nc_oc=Adkn5M-X_dHxrhzJQESLSrn46C9ZejZbC_YttAHQPbOzO4py-yPhoC4beBPWprWlRvs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvWXRuZ0r5emDmIj7Rq2jTid04jY-66nquiNQKrSdzxUg&oe=6998714E"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csN_CBA8Jw0Q7kNvwHEn1_3&_nc_oc=Adl09FLf8DEGbwOiSI4rLiNwGR6fqpaQaaVs3-EEdELgklecMuNNFlg8BgTH6i7kUts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuju4z0QK7GA-ztY-h2PtzPkD6v6usp-WPimjD7NEO2Hg&oe=6998614D"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2-mBfy6LTMQ7kNvwFyim-o&_nc_oc=AdkWPnD-Z6VR4-MOCR16zc4ub1KKaoopYp-il-bTRSnL1ihCrthuPZxQ7RHLl6wdsWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftEgQHiZp3lonCuNyyLlyu9hy-o2xJmFxcDpye6K2QtrQ&oe=6998585C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZTl1PxTT0UQ7kNvwHI5qab&_nc_oc=AdlCWXQfxxUm34tWt2zkXrgx_gMCsBxMSCpvzhJ2OpOAo9ataMbjnYfMPDU4BFQxCgw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsEzoCiV0oowPp-bvf1zQ1T7gUS5q8CQi_cmj-_jadTwg&oe=69986161"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "de
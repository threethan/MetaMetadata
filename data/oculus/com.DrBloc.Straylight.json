_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXkq4uWQpAUQ7kNvwEDVp2w&_nc_oc=Adnzx4LlCo_JDT9kzPHuGsqbtRkz51cPglaW17TPP_5obsmkcIPFe0Ih514t27qVuUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGk7sqGvAPpHGFQQMKjIriN89q2JWdmsnMo86x5uQztQ&oe=6999B3CF"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7Tb6C-0O0kQ7kNvwHnUIsT&_nc_oc=AdnIHzwXtO6DIf-aSrYaasOzAn81T3FPuXwCaVBzE85p0e2CpWZd8uH3NRI9KZ-Vo4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4k6Mu2MmAuFhhHPiE2QzOdCucha8LhTAL0nDfao-mTg&oe=6999B1C3"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r7zPijoNOMQ7kNvwFXBU51&_nc_oc=Adm7WU29IqRA4cwI1EOn1qYEFZtiPJLxzBGTGKtkzvzqBj-wJKhyF7Rm7fHvzAC7XzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afufi_WE8tfiRpbz-FZNDIcUboljHxJdmVS4p_aKgS2Idg&oe=6999C2CE"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK4Hhz7uE7gQ7kNvwEcOt7e&_nc_oc=Adl6wW-ZY-JLV5VFXi76cOqs0JGB0xFnDUzf7QglOpyzZA7VUF2eK3f3CFhxz8sQGMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsboC_aVh6_j5Ps1SrZ0_OFA8O1FXsixMsGVrRM-ZV50g&oe=6999B2CD"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFWck5limC8Q7kNvwEpEP5D&_nc_oc=AdkO6Zy1FYBm7yJo1PbSdT1p9VEGJ6WhIAEVQPPnRO8IbximLvVS1xavscaS-DP6dXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuhJ-b3cjn5IkQlpHA9Bztjdv1i3dxdhkjcevGVZuqQJA&oe=6999A9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tzc1K6diyCoQ7kNvwH6fXX_&_nc_oc=AdkjUVDvRi3fE8THBqjZJ-GfMFj9a8zza5yy63z1T9oqiNW8HpLeWWhwQFWy3bvdRQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvYPx-sK8764Fi-vPF7zdHN_pn5NW8aNQ4LUD7emkmyCA&oe=6999B2E1"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "de
 "343732500483423", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035305_343732503816756_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34tdwz0evGMQ7kNvwHjw8FC&_nc_oc=Ado6fNkCNpE5YNEjZDkCp8RGQT36uK82iy-3msHxwB_FQmoti86aRbTcmJU2BF3b7Yo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYbRzhi9RUc3n9x_5xiUOuX2-QOKbrDobpU9yH1ULAig&oe=6AB677CF"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgWEjf6Bo3AQ7kNvwED6E3J&_nc_oc=AdrtuLtpank975chCLiLDqzF7G-di-74RQmj_Ls7N9VnZMgEWv2bwK_pNIW0eOGyqyY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ79Y88U2WhLbqhBXszOgmlxtBXkD6mNX75PQZ-mUf15g&oe=6AB675C3"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp_FOTi2GekQ7kNvwEtIHbW&_nc_oc=AdqEJJ0Ju5eTNoYHCP0KYbOn4TSmsINJyR5b01dUrb6G7sMw6ks_JpnTocaeENPciOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE8K3hJ7R_Co9VbIcEog3zUyyKCSRVm-In1IiEukSeQg&oe=6AB686CE"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC7TwNuq3h8Q7kNvwF3K1wG&_nc_oc=Adpcmf8fwCxUWp-7MxrbcgoW1rxiMUzx4qI_7XjWWpXcPcjKeS6-QijIopt9l21CdMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjrYCfMmiuYrCJbO99XS4BTYaRCIrwLe6Wtf869A67dg&oe=6AB676CD"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTGFuu9oJkkQ7kNvwFWc1Bc&_nc_oc=Adr1ysihoCQFi-jvPc7CQf6QYB2DwDxc6JSuiHe_mLdiRKLV-XtDCFZ4yzYcZtWLPMY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlNGCXr8w_tOhIFfHvOMvfjVcLTo0qFJVUr5-Xr4XN-w&oe=6AB66DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARcCF-k6-FwQ7kNvwEMbcUq&_nc_oc=AdoAbQxD10pqPj96NFt1psmt9DPMET52motn1to1MZcTA1ZSKaB1lW3RVyRSRKv9XHo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzUtK2Cjx1jt1Lb-QW8DYeKV48FknPESWOiDAyzfwJow&oe=6AB676E1"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dr. Bloc", "support_website_url": null, "website_url": "https://www.drbloc.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455727353053945"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2251301718962980"}, {"status": "PUBLISHED", "id": "1061119893233907"}, {"status": "PUBLISHED", "id": "2412709099214054"}, {"status": "PUBLISHED", "id": "1663723711305268"}, {"status": "PUBLISHED", "id": "1659656667998366"}, {"status": "PUBLISHED", "id": "2164483573747877"}]}, "baseline_offer": {"id": "2164483573747877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2251301718962980"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6190930700941477", "version": "1.0"}, "id": "506328637444046", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "
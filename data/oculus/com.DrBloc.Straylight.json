_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPlaFWv1CeAQ7kNvwGuxmIm&_nc_oc=Adm1PNXrslKOr-ekL7S7w2ASUzdyIX0hyjEUeEUj5f2xXRCHyZn48SeWTMTtyL9D2CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLqTr6jtDGpmuM4N7fliQAL_fsOH0Aef33jZP1PP8A1A&oe=69A6E2CF"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drfUiGlrvJgQ7kNvwHCG9B1&_nc_oc=AdmIZdDuPWJyCk97cGIdLje2Ybzz_xgX2YRC2SEAWe9wws4noZQIOVFMB5k1uvTJuXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupEUgXnNDDlmKekIbdoET4p9F5R5PHrgz-8o2kVNgZOg&oe=69A6E0C3"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iqcxYcqvooQ7kNvwHgZQHv&_nc_oc=Adld2igtPP0XnxVAfz9ELaAv5g0qtSXxd0NNCnyyKdfTJRGsawTL3i9KW8K3gPZArr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9Y1IynoHss4PVYenLYBTBrmRdiA0zA0dwhDn6XFYrFg&oe=69A6F1CE"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScKQmce-AqEQ7kNvwFliOhf&_nc_oc=AdlOqRANF76fbp3rnxR1KiMdfZOh3ugOZy7k513rdH85mmD_AUnh2zysriC6pMGh64o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4VVIpCIVwi4FxDJiooq7TeIydEZ7d1PRvcsjrKtZ5uQ&oe=69A6E1CD"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBidcmf51GUQ7kNvwGJh0ag&_nc_oc=AdlR-bY9CPsfd9SIWFjT4nyOFUiNctco71mkhljj2PBebAVYvX8c3i93K5kFGErVW98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs1UWZlm3d8Qdmog8nQz5QCK1Ac7d56f7ltQ4grA__q7Q&oe=69A6D8DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ptZwJuLc88Q7kNvwFts3Yd&_nc_oc=Adnrvu4Ac8_j6Xs_qIevdgXxd2OwX7U1w7itV5ovH1EM11zWUcFdsn6q6eXiQcBcj2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcwEaVgQ8YWOhfgZKwNxyOOrqYiyo7zUwNGgA7deKw0A&oe=69A6E1E1"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "de
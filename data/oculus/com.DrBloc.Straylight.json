_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPlaFWv1CeAQ7kNvwE0ydFw&_nc_oc=Adkq9_RiJ_D30504JlKYpJam7Sy8ENPr6VCkRjo1IZYd-VmlfnL_p6Fi7ynNcExtXao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuNYVjDmvS7zhvEXCKvBqWITbEeWJ5bYVfIaB_B39i7Pg&oe=69A43FCF"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drfUiGlrvJgQ7kNvwG1TQeA&_nc_oc=Adn_urBmoIR21dSPoKTFpDbUHMYzI35JyyHUHsL-rNLVMdm260XHQjQFfrjIiSSaIXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftKy8LgoEnI2ekZs3CSGblkp5e3p9b6buisy-2DwGPonw&oe=69A43DC3"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iqcxYcqvooQ7kNvwFnbVvF&_nc_oc=Adk9dl1iMjGzxZpPLwqVFAuSI_7Zn2JEqNNk34Zb18d84noa0TafWPgbtZAZOY3HKnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv2Az-Wpb1v53HYFEqNrETNYF6sUqt7rZ44M_i6pyiLug&oe=69A44ECE"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss2QjCuPm0IQ7kNvwGoe97P&_nc_oc=Adn7O7uZ3StrJIeXgXCP-7-nkCCh_ZwZSOj_-rJ2XDh1K2cn3yoqeZndPFVMk5NMUiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsZ5UGYDFzlg-JrwVV_SyufaxlktDJBtxTs_-CjrInZnA&oe=69A43ECD"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5YMxi0gUUkQ7kNvwFZg0fm&_nc_oc=AdluPRouLem73c3XLI0hnmb_eFWE2jnlxBOQcbxxt1ffC-LCpmtnJq6zqEvCtJMkNAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfumrbZhJqPVXgU5k9S4uF0LD3RL_V9LPx7BYAJHuw-HzQ&oe=69A435DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVf5W8Mh58UQ7kNvwEvhLEI&_nc_oc=AdnAqYXGm6pZvAYL63hzzZd89fIdb4qi4VH484HFunD-fbiTLk2G2z-2If68OhAUGuI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsjaiEuY16pGDkXB3duPZKaBubf0InUjmKDOaB4qFHfDw&oe=69A43EE1"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "de
 "343732500483423", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035305_343732503816756_4796639553724927372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am37OnKVEe4Q7kNvwEAKl6A&_nc_oc=AdqzvZeT0b3EzTkCx4JSIiVh-hk4yb5Ru76P7i8kQXDxS6N1wWPkzkQyXlWaYNwbBG0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvQRjk9ID_PsQI5dYZSgcWj-lkpslbadm0OytfySUGCg&oe=6AF9EC8F"}, {"file_name": "Straylight Screenshot 07.png", "id": "4319684464736699", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974685_4319684468070032_7887641738360073106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci6IrgpCa6QQ7kNvwHtSL46&_nc_oc=AdpYMI1lgldJO6etnBD-vfe5YZcX5hI9CFRPIfK_WPBA8Sc0kOHgw271_hoB5KA5OBg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSruZAIxPnM3Ri_Yg0dp8Qom0ruEwAcLSPQYnP0OMZqgg&oe=6AF9EA83"}, {"file_name": "Straylight Screenshot 06.png", "id": "2985168481754603", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974630_2985168485087936_7877350992138306494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JqCRo37ZW0Q7kNvwGvLHy5&_nc_oc=Adrqvw6ATEzcxaL_IpxS4MA85nnhEVeUl9yq5CZPhVU92zK-n2lWewI0PIFt44egvn4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyRP0JPVDQpA76ROf23yKfON3k_hN_KlKhTjinseEmNw&oe=6AF9C34E"}, {"file_name": "Straylight Screenshot 05.png", "id": "306461414530100", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974454_306461417863433_2013603082060758168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qp8m5v9H4c4Q7kNvwHYP1rN&_nc_oc=AdrO1vBChAPz9Z0x8PSwUjg5SPGbrDEj7sMlfMMzPlPLHSgeKJbZO8eFWZNUsUJindg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJjpuGyprDmXLTLgX7c4XI4i0GK-zJJcj7JLDuYX_QPQ&oe=6AF9EB8D"}, {"file_name": "Straylight Screenshot 08.png", "id": "330324378700085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974800_330324382033418_8613667374889529408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnBks-ztXmwQ7kNvwEbHYaF&_nc_oc=AdpMt-fh7_-r2DdTR4K-4ShY1_uQB7xnFJrS-HsJaqX1qL8SC-l4_1c6H5hWJ3TDrS0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqumTCqhDeaCS6E9PSA_VPlRn58WuwTFMZ2wlN2IaY-Q&oe=6AF9E29C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "334272634986723", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974602_334272638320056_1646791582313961751_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feZoGJ0XvnUQ7kNvwHM4nZB&_nc_oc=Adqm1rKVVsUgauHPiYZ29KAdxDdenBd6YnTtclFkoNdwMCPDCI-ShyCB9LXo0arP6No&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5OAqd7ba2Zjb4vCUOiuKyUaj0mKOhBlY7xIgXeySk_w&oe=6AF9EBA1"}, "display_name": "Straylight", "keywords": [], "long_description": "Have you ever wanted to fly? In STRAYLIGHT, you will soar through beautiful and deadly obstacle courses meant to evoke the simplicity, difficulty, and fun of old-school platforming games, but in a way that can only be experienced in VR. You will swing, fly, and fling yourself through beautiful and deadly cosmic playgrounds. It isn\u2019t all freedom, however; you will need to navigate increasingly diabolical obstacles to reach the end of each challenge. Though the gameplay is simple at its core, it is endlessly replayable as you try to nail that one, perfect, beautiful run.\n\nPlaying STRAYLIGHT is a simultaneously nail-biting and zen experience; each level is crafted to provide moments of exhilaration and wonder while \nchallenging the player to navigate through the flowing obstacle courses. The score, composed specifically for the game, is tailored to heighten and magnify both sensations.\n\nWe developed STRAYLIGHT to be an experience that anyone can enjoy, even those brand new to VR.", "short_description": "Fly, swing, and soar through a beautiful and deadly universe in a new kind of VR platforming experience. Using the Fling Engine - a propulsion mechanic designed for totally comfortable movement in VR - you will soar too high, fly too fast, and die way too much. Can you master the STRAYLIGHT?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.drbloc.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dr. Bloc", "support_website_url": null, "website_url": "https://www.drbloc.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455727353053945"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1851013122752940"}, {"status": "PUBLISHED", "id": "2251301718962980"}, {"status": "PUBLISHED", "id": "1061119893233907"}, {"status": "PUBLISHED", "id": "2412709099214054"}, {"status": "PUBLISHED", "id": "1663723711305268"}, {"status": "PUBLISHED", "id": "1659656667998366"}, {"status": "PUBLISHED", "id": "2164483573747877"}]}, "baseline_offer": {"id": "2164483573747877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1851013122752940"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6190930700941477", "version": "1.0"}, "id": "506328637444046", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
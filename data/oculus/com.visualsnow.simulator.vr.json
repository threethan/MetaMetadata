20SYkYYVYh5Dsb6cFVkh7RWA1UOvao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVB67g220I_9VUGSVyXXNOUZn5aAaS0z5890zm-KqY29g&oe=6B1054C1"}, {"file_name": "53cdb3803bffb386f489950f709258d9.png", "id": "1436530915231285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771275_1436530921897951_5255957074823132955_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PAW9ogT1wgQ7kNvwHKqdZu&_nc_oc=AdpaIFCRSxMT4OqNaIzI5CJYclLLSfqlVqYot8PLlFDAoES_F2J7X8V9sPDXwwSKLnc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAUGV7sajU6JKTEh92aHarH6pp1jFaR3aPWAgxMGeD8Q&oe=6B104B9D"}, {"file_name": "7aa0f900346418c5d6202443e167d5ac.png", "id": "1454788206778637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771316_1454788210111970_8468424455807462138_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXgG2qHsZIoQ7kNvwEY-QwZ&_nc_oc=AdpSj7hBA3l3ud1DiW7i9nDkF7juZfsS-h74TTxkxlEqJIyBwO4uWKF20TGklQc2jB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-jSEOOK2GVnSZcdo4Zy8gCDmHRhKbeuoQa_9rtU_vmw&oe=6B104E1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Visual Snow Simulator", "keywords": ["visual", "snow", "simulator", "visualsnow", "tinnitus"], "long_description": "Decode Your Vision. Quantify Your Data in Immersive VR.\n\nSubjective visual noise is difficult to explain. Visual Snow Simulator VR lets you visually recreate your sensory symptoms\u2014directly in your physical surroundings via Passthrough, or in immersive virtual worlds. Designed for individuals with Visual Snow Syndrome (VSS), this tool bridges the gap between subjective experience and structured clinical data.\n\n\ud83d\udc41\ufe0f IMMERSIVE SIMULATION ENGINE Tweak 60+ adjustable parameters to recreate your exact visual symptoms:\n\nDynamic Static: Customize grain size, opacity, flicker, and noise motion patterns.\nEntoptic & Distortions: Accurate physics-based floaters, Scheerer\u2019s phenomenon, afterimages (palinopsia), glare, scotoma, and photophobia.\nPassthrough: Overlay symptoms onto your physical room to show others what you see.\n\ud83d\udc42 TINNITUS MATCHER Match the pitch, volume, and pulse of your ringing using built-in wave synthesizers.\n\n\ud83d\udcca TRACKING & CLINICAL EXPORTS Log daily metrics (anxiety, stress, sleep) and lifestyle triggers. Export structured clinical ZIP data directly to your headset's shared Downloads folder.\n\n\ud83d\udee1\ufe0f ZERO-KNOWLEDGE PRIVACY Your logs stay strictly on your device. Fully offline, no accounts, no data tracking.\n\nMedical Disclaimer: Not a medical device. Does not provide medical advice. Consult a physician.", "short_description": "A zero-knowledge digital health tool to quantify Visual Snow Syndrome. Recreate subjective symptoms in dynamic VR, track anxiety and lifestyle triggers, and export structured datasets to advance research and improve clinical dialogue."}]}, "developer_name": null, "developer_privacy_policy_url": "https://visualsnow.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Entropy Vector Group", "support_website_url": null, "website_url": "https://visualsnow.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26571450929190930"}, "revi
uluscdn.com&_nc_ss=7f20f&oh=00_AQQI8_xHtsOLuceNtamR4ykuUERfscYldpWdb9NoFi6PtQ&oe=6AFDC1A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1923898685139808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1923898691806474_7892290483044442211_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xawtAE4bdMoQ7kNvwGHw3gf&_nc_oc=AdqNgpXX5ujmUlLQZQXvF1JfSxucMRfyLaVKliY9W-7pLq_1bwhhyGs6UaknQuJW5sk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQQLFuK2nnly3lquSFTwlf-FilrASM2WkzyzmNd-ogvw&oe=6AFDCE28"}, "display_name": "Wurst and Glory", "keywords": ["VR", "fighting", "duelling", "sausage", "medieval"], "long_description": "**FAQ & support on our Discord:** https://discord.gg/D7AwRvu8U9\n\n\u2694\ufe0f\n  #  Step into the arena as royalty and settle disputes the only way tradition allows: SAUSAGE COMBAT. #\n\nWurst and Glory is the premier competitive dueling simulator for the noble athlete \ud83d\udc51 Every duel, you're offered 3 random sausages to wield. Pick one you've never used before, and it joins your arsenal.\n{1411341814296035}\n\ud83d\udde1\ufe0f Master the physics of floppy meat combat, learn which sausage counters which, and collect every wobbly weapon in the arsenal.\n{1719873979214189}\n\ud83c\udf45  Become the master of the banqueting hall: throw tomatoes at your opponent to blind their view, or use a pretzel as a shield. \ud83e\udd68 \n{1055000533733580}\n\nNo skill trees \u274c No pay to win \u274c No microtransactions \u274c \nJust you, a rival noble, and whatever cured meat fate hands you this round.\n\n**Duel for honor. Duel for glory. Duel with sausages.**", "short_description": "Wurst and Glory is the premier competitive dueling simulator for the noble athlete. Settle royal disputes the only way tradition allows: SAUSAGE COMBAT. \ud83d\udc51\n\nEvery duel offers 3 random sausages. Pick one you've never used, and it joins your arsenal. Master floppy meat physics, learn which sausage counters which, and become master of the banqueting hall.  \ud83d\udde1\ufe0f\n\nNo skill trees. No pay to win. Duel for honor. Duel for glory. Duel with sausages."}]}, "developer_name": "Yaga Studio", "developer_privacy_policy_url": "https://yagastudio.com/wurst-and-glory/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Yaga Studio", "support_website_url": null, "website_url": "https://yagastudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1250705864790966"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1419677259819523"}, {"status": "PENDING", "id": "1370310738399455"}]}, "baseline_offer": {"id": "1419677259819523"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793610600, "status": "PUBLISHED", "id": "1419677259819523"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1395558730305678", "version": "0.1.86"}, "id": "1346763373558060", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1203022606225959", "is_concept": false, "latest_released_binary": {"__typename"
Qn1GpfLzBpP5uh9Mu-Mhwznari63gfoVnWOY1HwD1I4HOR-a_6zZN2Had_g9kP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_wUB9KmQ08EfcCcpfTiyqILEnPrzSpB9Y-2NTPwFhSQ&oe=6AFDAF10"}, {"file_name": "tomatoe throwing.png", "id": "1965666108152912", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_1965666114819578_4961985969884485155_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmXCB3LcP0AQ7kNvwFAZ0-X&_nc_oc=Adpein__L-LMp9KuMiSmNijVBUyxjDa_OStJ9tJApvkgteQpjr2lHfD4V0z_7LBloPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbjrgiDidOF8cAL5vzHgnH6KIQwJcsfh9YVyALxI7OLQ&oe=6AFDD31B"}, {"file_name": "fighting_1.png", "id": "1574449664071203", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1574449667404536_2441105016086172646_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5emA2VvFOWcQ7kNvwGs6FF0&_nc_oc=AdrnouxlJ0SESscYLSZxoXIWwpi1HZhuvLylrCHugXaBdBcLZF26a6ECCCH8gern3eE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoznqGef1KmcONvV5_SMToN3sN_fOjfJ057VWvWSVFzQ&oe=6AFDC2D6"}]}, "id": "4426003554280267", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wurst and Glory", "keywords": ["VR", "Fighting", "Wurst", "Mittelalter"], "long_description": "**Support & FAQ auf Discord: https://discord.gg/D7AwRvu8U9**\n\n\u2694\ufe0f\n\n# Tritt in die Arena als Adliger und l\u00f6se Konflikte, wie es die Tradition verlangt: **IM WURSTKAMPF!** \ud83d\udc51\n\nIn diesem 1v1 Kampfsimulator geht es wirklich um die Wurst. K\u00e4mpfe gegen andere Spieler und lerne wie sich verschiedene Wursttypen verhalten und wie man gegen sie ankommt. In jedem Duell gibt es drei W\u00fcrste zur Auswahl. W\u00e4hlst du eine zum ersten Mal, wird sie deinem Wurst-Arsenal hinzugef\u00fcgt. \ud83d\udde1\ufe0f\n\n\ud83c\udf2d **Meistere die Physik des wabbeligen Wurstkampfes**, lerne mit verschiedenen W\u00fcrsten umzugehen und sammle alle wabbeligen Waffen in deinem Arsenal.\n{1574449664071203}\n\n\ud83c\udf45  **Werde Meister der Arena:**  Werfe Tomaten auf deine Feinde um sie zu blenden oder verteidige dich mit Bretzeln und Tellern. \ud83e\udd68\n{1965666108152912}\n\n**Kein Skilltree, kein pay to win.** Nur du, ein nobler Rivale und was auch immer an Wurst dir das Schicksal liefert.\n\nK\u00e4mpfe f\u00fcr Ehre. K\u00e4mpfe f\u00fcr Ruhm. **K\u00e4mpfe um die Wurst!**\n", "short_description": "Hier geht's wirklich um die Wurst. Trete im Wurstduell gegen andere Spieler an und lerne wie sich verschiedene Wursttypen im Kampf nutzen lassen und wie man sich gegen sie verteidigt. Wirst du Wurstmeister? \ud83d\udc51\n\nIn jedem Duell gibt es drei W\u00fcrste zur Auswahl. W\u00e4hlst du eine zum ersten Mal, wird sie deinem Wurst-Arsenal hinzugef\u00fcgt. \ud83d\udde1\ufe0f\n\nKein Skilltree, kein pay to win. K\u00e4mpfe f\u00fcr Ehre. K\u00e4mpfe f\u00fcr Ruhm. K\u00e4mpfe um die Wurst!"}, {"images": {"nodes": [{"file_name": "tomatoe throwing.png", "id": "1719873979214189", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827987_1719873982547522_3940857031776771802_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d9y_f9bF8QQ7kNvwGuPEx2&_nc_oc=AdpA9LPSMouc-0XJYOaEfQdizoFVXmSPGCdFr34CUeBJOI1BC06_FZ7CHh5pPhJ46TQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThx7bXljhkenNlpfUKPScY8hLa7u5yXmkDBdL1TcPSkw&oe=6AFDB430"}, {"file_name": "buttler sausage 2560x1440.png", "id": "1411341814296035", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_1411341820962701_1213899280361127490_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbGAwV3aWYUQ7kNvwFNzd0a&_nc_oc=AdonIysejF3anONYWH59LPhSZqm1T7L302VPd6LACtxDkYl_xFrXnQZgFq4
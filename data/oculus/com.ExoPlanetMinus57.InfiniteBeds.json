Tk0uvLnUTlvyqyL7WJuZjQu75qIpxE9rUplhMyPApCpw&oe=6AFC867F"}, {"file_name": "image-2560x1440 (2).png", "id": "1888875452094045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620403_1888875455427378_4979461908000322399_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZBB8TbA9aEQ7kNvwEEPtnT&_nc_oc=AdrfYVY7XbVaKr3yZXZsJ7H5J0A3eOTBaLONzHuicwC4OiX4Yflk5MLnUimt0HyLRAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREWSrenOZGsNYgtLFnovzwwZCDjrpTisEDOsuKM6hhiA&oe=6AFC6E5E"}, {"file_name": "image-2560x1440 (1).png", "id": "2201331120794719", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622186_2201331124128052_1716827678591429094_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD6yWiVyJuMQ7kNvwFoziNi&_nc_oc=Adpn2q1e1zzXvs3guPMtbu_0gtPakhb2OtMPUN15bdNW8b4cMFGkFLqlOusH5klKem4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKVGv2GUba4GPSBWfwEVGtXPijvKt0_xSG_ltTSeyrfw&oe=6AFC5DF7"}, {"file_name": "image-2560x1440 (4).png", "id": "4587356258151438", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499627379_4587356261484771_4152395559705050850_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaHpJb3u7DwQ7kNvwEZhJ2A&_nc_oc=AdpTv3WUHdq3Z8dMRtYyG1ioj6s2X3kBA58y0WI-aZKVeZfWJES0oi8lZaMys1_Xv68&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3N1ZQGvRGB-o8hN0DI4DAoBBO2iSreBG2zyDQhM8j_Q&oe=6AFC6EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "infinite_bedz_cover_v2.png", "id": "1160006443123093", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593845024_1160006449789759_73618572570377910_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mG96NOpExSsQ7kNvwGmWgwo&_nc_oc=Adq4CsBNuxz8WS087vgR5bl11DzkZE8LuhilLaHVwS0vDxuHgNpfGdTQpXGVXMgKTZ4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSti8tlv62l-DiAFRMevZofj-FEVhcPDaUXD0x5BbD_CA&oe=6AFC7565"}, "display_name": "Infinite Bedz", "keywords": ["beds", "wars", "pvp", "fight", "battle"], "long_description": "# \ud83d\udecf\ufe0f Infinite Bedz\n\nBed Wars is coming to VR! \u2694\ufe0f Build, fight, and defend your bed in Infinite Bedz, where every block you place and every swing of your sword happens with your own hands!\n\nJump onto floating islands with your team and protect your bed at all costs. As long as your bed is standing, you can keep respawning. But once it's destroyed, your next death is your last!\n\n## \ud83c\udfc3 MOVE YOUR WAY\nNo joysticks needed! Swing your arms to run, climb walls, and move around the map using smooth arm-based movement. Rush enemy bases, escape close fights, or race back to save your bed!\n\n{2001454090545686}\n\n## \u2694\ufe0f BUILD, DEFEND, ATTACK\nCollect resources from generators around the map and use them to buy blocks, weapons, and tools. Build bridges across the void, protect your bed with layers of defenses, and break into enemy bases to destroy theirs!\n\n{4366995756888033}\n\n## \ud83d\udc65 TEAM UP WITH FRIENDS\nJoin online multiplayer matches and work together to take down other teams! Rush straight into battle, build a massive bed defense, or sneak into enemy territory while nobody's looking. How you play is up to you!\n\n{3713084218858021}\n\n## \ud83c\udfa8 STAND OUT\nChoose your team color and unlock skins to customize your look! With more skins coming over time, there's always something new to show off.\n\n{3005617656457567}\n\n## \ud83c\udfc6 WILL YOUR BED SURVIVE?\nBuild your defenses, grab your sword, and get ready for some chaotic VR battles!\n\n**Protect your bed. Destroy theirs. Be the last team standing. \ud83d\udecf\ufe0f\u2694\ufe0f**\n{1542224287946368}", "short_description": "Protect your bed. Destroy theirs. Infinite Bedz brings the classic Bed Wars battle to VR! Team up with friends, swing your arms to run, climb, and leap across floating islands, then collect resources, gear up, and bridge your way to enemy bases. As long as your bed stands, you respawn. Once it\u2019s broken, you\u2019re on your last life. Defend, attack, and be the last team standing in fast-paced multiplayer matches built for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/193fBKcCk4vb4owmm6UmPlnxU7xARal00-auVlNDGOrU/", "developer_terms_of_service_url": null, "publisher_name": "ExoPlanet Minus57", "support_website_url": null, "website_url": "https://exoplanetminus57.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1075832912164548"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628447_1659635855670132_6611357761951420578_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI-obLrVVaQQ7kNvwEGlVUk&_nc_oc=Adqpj__I_qgVfkSbqgbhOQvtvQDBmZNeHppBgw-w2dsztHBeecs87D8w5vkNEaIyck8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCfW_bQN3XUuuv-pm99pf8hjg_6-mrfzS2WG-sUjyH0Q&oe=6AFC808F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Infinite Bedz", "platform": "ANDROID_6DOF", "context_category": {"context_catego
s://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593854747_3942692559204176_353124453385953157_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymzZ7X5L0zUQ7kNvwFm2bzL&_nc_oc=Adq__2EbtaQoaWHKVjzy3ibp6wdm5anGB27kXOejEr4KdkzpwNc2rZTcRI7obUkRiY8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk0uvLnUTlvyqyL7WJuZjQu75qIpxE9rUplhMyPApCpw&oe=6AFC867F"}, {"file_name": "image-2560x1440 (2).png", "id": "1888875452094045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620403_1888875455427378_4979461908000322399_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZBB8TbA9aEQ7kNvwEEPtnT&_nc_oc=AdrfYVY7XbVaKr3yZXZsJ7H5J0A3eOTBaLONzHuicwC4OiX4Yflk5MLnUimt0HyLRAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREWSrenOZGsNYgtLFnovzwwZCDjrpTisEDOsuKM6hhiA&oe=6AFC6E5E"}, {"file_name": "image-2560x1440 (1).png", "id": "2201331120794719", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622186_2201331124128052_1716827678591429094_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD6yWiVyJuMQ7kNvwFoziNi&_nc_oc=Adpn2q1e1zzXvs3guPMtbu_0gtPakhb2OtMPUN15bdNW8b4cMFGkFLqlOusH5klKem4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKVGv2GUba4GPSBWfwEVGtXPijvKt0_xSG_ltTSeyrfw&oe=6AFC5DF7"}, {"file_name": "image-2560x1440 (4).png", "id": "4587356258151438", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499627379_4587356261484771_4152395559705050850_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaHpJb3u7DwQ7kNvwEZhJ2A&_nc_oc=AdpTv3WUHdq3Z8dMRtYyG1ioj6s2X3kBA58y0WI-aZKVeZfWJES0oi8lZaMys1_Xv68&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3N1ZQGvRGB-o8hN0DI4DAoBBO2iSreBG2zyDQhM8j_Q&oe=6AFC6EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "InfiniteBedzLogo.png", "id": "4651861728419701", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622186_4651861731753034_2778392474446616257_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxGfl5qvtuEQ7kNvwFvWGf0&_nc_oc=AdpVIO5QgzybJ5yJFR1aWTb_5bjMcSOObY43pqeTcjAqfwgfvpbYHUdpOUEdaOfz9Do&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZWtsz31AnKN_1gTudtyjPNh4SSXGm_9HvLZs_5FQ1Jw&oe=6AFC7AE5"}, "display_name": "Infinite Bedz", "keywords": ["beds", "wars", "pvp", "fight", "battle"], "long_description": "Infinite Bedz brings the legendary Bed Wars experience into virtual reality, where every swing, climb, and block you place happens with your own hands. Drop onto floating islands with your team, each guarding a single bed. As long as your bed survives, you respawn every time you fall. Lose it, and your next death is your last.\n\nMOVE LIKE NEVER BEFORE\nForget joysticks. Swing your arms to run, scramble up walls, and launch yourself across the map with smooth arm-based movement. Rushing an enemy base or racing home to defend your bed has never felt this intense.\n\nGATHER, GEAR UP, ATTACK\nCollect resources from your island\u2019s generators, then spend them on blocks, weapons, and tools. Bridge across the void to enemy islands, break through their defenses, and smash their bed before they get to yours. Every match is a race between building, defending, and attacking.\n\nPLAY WITH FRIENDS\nJump into online multiplayer matches, team up with friends, and coordinate your strategy. Will you rush early, turtle up behind layers of blocks, or sneak around the side while the enemy is distracted?\n\nMAKE IT YOURSELF\nPick your color, rep your team, and unlock skins to stand out on the battlefield. New skins are added regularly, so there\u2019s always something fresh to show off.\n\nFast rounds, constant action, and endless comebacks. Grab your headset, protect your bed, and see if your team can survive Infinite Bedz.", "short_description": "Protect your bed. Destroy theirs. Infinite Bedz brings the classic Bed Wars battle to VR! Team up with friends, swing your arms to run, climb, and leap across floating islands, then collect resources, gear up, and bridge your way to enemy bases. As long as your bed stands, you respawn. Once it\u2019s broken, you\u2019re on your last life. Defend, attack, and be the last team standing in fast-paced multiplayer matches built for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/193fBKcCk4vb4owmm6UmPlnxU7xARal00-auVlNDGOrU/", "developer_terms_of_service_url": null, "publisher_name": "ExoPlanet Minus57", "support_website_url": null, "website_url": "https://exoplanetminus57.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1068389992908840"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1572940957468267"}]}, "baseline_offer": {"id": "1572940957468267"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792184400, "status": "PUBLISHED", "id": "1572940957468267"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1087645310983308", "version": "1.0.2.1ab"}, "id": "1132019829340868", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only"
.5771-25/473391888_24104645505802621_2712937462871418310_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSdGlm173MQQ7kNvwG8u9lf&_nc_oc=AdpE3b4Z_4Ks2y7pjfz1JCCt3P8GDrwR6XTNvXkvEVDVh0OIiFNj3_eD73cOBJDi_UA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq7qW2AsBubBNsUIunS3R-h1QOh0p7j_d3xEYbhFl3tQ&oe=6A4A779F"}, {"file_name": "4.png", "id": "642461704816972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_642461708150305_7011859734522612308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1Vqb8QxOF8Q7kNvwH3lu68&_nc_oc=AdrK7j0iQwxpjh9HU50yb02ZPRdq3HBohhA8C0z7pcWchGfh35RbetZQXeq15OmVU0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSCYdNyQSGM_kXoIrNLITCkCzLKBmTowr1Wr-O_D0lBg&oe=6A4A52DD"}, {"file_name": "5.png", "id": "1544831662900141", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393496_1544831666233474_4453649644027628004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsNaeDVanlkQ7kNvwF_LzyX&_nc_oc=Adr6v0INwFXjgCNqZ_0_zArxp0IHhppTmbsXNz9-pVa79t4IjLusiz9cVFu4PjZ7PYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOfBjdblfIMm3WEXOXP2mIj9fx3DZu3jAiaIooIHYuQw&oe=6A4A55EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paso Adelante", "keywords": ["vr", "down", "vass", "virtual", "formaci\u00f3n"], "long_description": "Paso adelante es una innovadora aplicaci\u00f3n dise\u00f1ada para mejorar los procesos de inclusi\u00f3n laboral de las personas con s\u00edndrome de Down a trav\u00e9s del fomento de su autonom\u00eda. La herramienta est\u00e1 compuesta por dos m\u00f3dulos formativos dirigidos a la adquisici\u00f3n y entrenamiento de habilidades b\u00e1sicas para lograr una mayor independencia en el d\u00eda a d\u00eda.\n\nExperiencia del Usuario\nPaso adelante ofrece una experiencia inclusiva, intuitiva y motivadora:\n\u2022\tInterfaz amigable y accesible: Dise\u00f1ada para ser f\u00e1cilmente navegable por personas con diferentes niveles de habilidad.\n\u2022\tInteractividad y pr\u00e1ctica real: Las simulaciones y escenarios virtuales permiten a los usuarios experimentar situaciones reales antes de aplicarlas en su vida diaria.\n\u2022\tSeguimiento de progreso: La app incluye indicadores que muestran los logros alcanzados y los pasos pendientes, fomentando as\u00ed la motivaci\u00f3n en el proceso de aprendizaje.\n\nObjetivos de la Aplicaci\u00f3n\nEl prop\u00f3sito de Paso adelante es doble:\n1.\tCapacitar para la vida diaria: Brindar herramientas pr\u00e1cticas que permitan a las personas con s\u00edndrome de Down ser m\u00e1s aut\u00f3nomas en sus desplazamientos y preparaci\u00f3n para ir al trabajo.\n2.\tFacilitar los primeros pasos para la inserci\u00f3n laboral: Fomentar competencias b\u00e1sicas que sirvan como base para alcanzar una inclusi\u00f3n laboral m\u00e1s eficaz.\n", "short_description": "Paso adelante es una innovadora aplicaci\u00f3n dise\u00f1ada para mejorar los procesos de inclusi\u00f3n laboral de las personas con s\u00edndrome de Down a trav\u00e9s del fomento de su autonom\u00eda. La herramienta est\u00e1 compuesta por dos m\u00f3dulos formativos dirigidos a la adquisici\u00f3n y entrenamiento de habilidades b\u00e1sicas para lograr una mayor independencia en el d\u00eda a d\u00eda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fundacionvass.org/politica-de-privacidad-app-xr-paso-adelante/", "developer_terms_of_service_url": null, "publisher_name": "DeuSens", "support_website_url": null, "website_url": "https://www.sindromedown.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
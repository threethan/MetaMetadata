Q0mOUngsEQhzIe6q-Nwjziv7aU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTR1HktRM43Q3UNIc_fqMiddEF5EOU6xi0qvdXp5h5FQ&oe=6B0DB043"}, {"file_name": "5.png", "id": "1101798581633815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618034_1101798584967148_5937639186656194217_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIjd7l1TpzAQ7kNvwFLDO6T&_nc_oc=AdoSJoHFstx8qioxmv0CZHn3m5fwE8U8RdgKFHbs1VFJC9diuCblaaUCfrYIdbOQJbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUWGAJullqLbb4LU8kc3NE3zjAhfRHTDxDtTedeBdILQ&oe=6B0DCA11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440\u65b0.png", "id": "1608139559901204", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820382_1608139563234537_8005835790204978770_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sywq73Ij_q0Q7kNvwHxNu-I&_nc_oc=AdpIzpJDxEl1RWg91X58uV-dYFjc2Zl8SR5GeEaaVU7dQ7zpjPwFeXnoxwHJREgE6E0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSm3XTbnTCVSGGBN7G6A6JOVtzIP5NUFNR98BL8bGgMCA&oe=6B0DC524"}, "display_name": "Claw Royale", "keywords": ["action", "tournament", "cranegame", "competition", "leaderboard"], "long_description": "# Claw Royale \u2013 The World\u2019s First VR Claw Machine Tournament\nEnter the surreal arena of Claw Royale, where the childhood claw machine explodes into a global VR competition. Compete in thrilling rounds, chase rare animals, and rise through live leaderboards to prove you\u2019re the ultimate champion. This isn\u2019t luck\u2014it\u2019s skill, speed, and showtime.\n\n# Why Players Love Claw Royale\n\n\ud83c\udfc6 **Global VR Tournament Vibes**\n\nEvery match feels like a live esports showdown. With real-time rankings, announcer hype, and dramatic stage reveals, you\u2019re not just playing\u2014you\u2019re competing for glory.\n\n\ud83d\udc3b **Thrilling Claw Rounds**\n\nGrab bears for points, chain combos, and react to surprise events like shifting platforms or sudden wind gusts. Every round delivers chaos and excitement.\n\n\ud83c\udfa8 **Collect, Customize, Show Off**\n\nEarn animal trophies for free, unlock deluxe skins like neon or crystal, and display them in your evolving showroom. Your catches become your bragging rights.\n\n\ud83d\udd25 Join Claw Royale today and discover the thrill of turning a claw machine into the ultimate VR competition. \n\ndiscord.gg/X2JUFSqVGc\n\nEvery grab counts\u2014are you ready to claim the crown?", "short_description": "Compete in Claw Royale, a VR claw machine reimagined as a global tournament. Snatch bears, trigger combos, and face the colossal Super Claw to prove you\u2019re the true champion."}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/pa.html", "developer_terms_of_service_url": null, "publisher_name": "Time Traveller", "support_website_url": null, "website_url": "https://www.timetraveller.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24210814728590989"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary
&_nc_ss=7f20f&oh=00_AQOFAON8FeC1HFCqvI97PJSdcPchGR-086wVUvuFe18MVA&oe=6ACBAD73"}]}, "id": "1906201963257512", "locale": "en_US", "screenshots": [{"file_name": "1_.png", "id": "1909354663256955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819934_1909354666590288_1096453123780659117_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7h-GBkkvQGUQ7kNvwGUXUe3&_nc_oc=Adpu7_rrzmRqB8RB0kBnGc7DLiWrUhg-i97HpHMy-m7zUSedL0Zu3oYc_eASUk-02fg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjbpStZuMUpIfjFXyvII8Y5CHxAISi64y_Jgas9jdC8A&oe=6ACBADEF"}, {"file_name": "4.png", "id": "1482097982707309", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830032_1482097986040642_4271069152371103352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36lEGbF6S80Q7kNvwEBv3Sv&_nc_oc=Adr86jbR51mya3ui-6Zs0eAAtrKkRYExCfiXckM4MackTpy2NXW5VaHFNpwnz4gtTYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqF5R8QdS2NwbuxUynqKUp1awCXp8gxIsTbu_VqmccEg&oe=6ACB8D36"}, {"file_name": "6.png", "id": "752454914240396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_752454917573729_3804344264589887699_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvLNletbMkkQ7kNvwG8D9f5&_nc_oc=AdrczRXAntRLCVZULL4jvWLbOdLd10kM3Xm_A9ePH9E3TnIMe9q5fgC04znDCdtn06w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8RUJj6On6m0h1-g0gSF2OCu_yBjb8jl84AVQoICy5fg&oe=6ACBB454"}, {"file_name": "2.png", "id": "4243475152589974", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304019_4243475155923307_5507276873016868216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5pCjalvHNEQ7kNvwEKpl1n&_nc_oc=AdqTfmlBh7AhwHrY0t5Spl8u0aNLa5XckTfBjU71R8p-ybwvmcW2jr-jVKeoldZhmlU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLyqzGeUnv3plMXS0Qt8Fc_Gg85Rtf4SYIaXiDYUKOwA&oe=6ACB8D03"}, {"file_name": "5.png", "id": "1101798581633815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618034_1101798584967148_5937639186656194217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq1WUbuKgqMQ7kNvwEVHVRH&_nc_oc=AdpYACq6lv9j6Hsu-5sTHzvziJm_5f0UO9AQX6c8ZJEvYp3l31KJxnxBhqAazXZBLUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP9gjvhS7sAgM8tV2aM6ZxkCFhCjQFy3mYbS_aVDNuLA&oe=6ACBA6D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440\u65b0.png", "id": "1608139559901204", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820382_1608139563234537_8005835790204978770_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivvcVpONhbcQ7kNvwH60V57&_nc_oc=AdqsD7cQmo_vGEq4Rm5PUERrhgJagWPYGnpPzCXRZq_8N9ugweJxmSzwan2S5_494g8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQtKWTa1f07hMXm8j8uVDD6lzHL_qWdzJOdpKVNaGqcg&oe=6ACBA1E4"}, "display_name": "Claw Royale", "keywords": ["action", "tournament", "cranegame", "competition", "leaderboard"], "long_description": "# Claw Royale \u2013 The World\u2019s First VR Claw Machine Tournament\nEnter the surreal arena of Claw Royale, where the childhood claw machine explodes into a global VR competition. Compete in thrilling rounds, chase rare animals, and rise through live leaderboards to prove you\u2019re the ultimate champion. This isn\u2019t luck\u2014it\u2019s skill, speed, and showtime.\n\n# Why Players Love Claw Royale\n\n\ud83c\udfc6 **Global VR Tournament Vibes**\n\nEvery match feels like a live esports showdown. With real-time rankings, announcer hype, and dramatic stage reveals, you\u2019re not just playing\u2014you\u2019re competing for glory.\n\n\ud83d\udc3b **Thrilling Claw Rounds**\n\nGrab bears for points, chain combos, and react to surprise events like shifting platforms or sudden wind gusts. Every round delivers chaos and excitement.\n\n\ud83c\udfa8 **Collect, Customize, Show Off**\n\nEarn animal trophies for free, unlock deluxe skins like neon or crystal, and display them in your evolving showroom. Your catches become your bragging rights.\n\n\ud83d\udd25 Join Claw Royale today and discover the thrill of turning a claw machine into the ultimate VR competition. \n\ndiscord.gg/X2JUFSqVGc\n\nEvery grab counts\u2014are you ready to claim the crown?", "short_description": "Compete in Claw Royale, a VR claw machine reimagined as a global tournament. Snatch bears, trigger combos, and face the colossal Super Claw to prove you\u2019re the true champion."}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/pa.html", "developer_terms_of_service_url": null, "publisher_name": "Time Traveller", "support_website_url": null, "website_url": "https://www.timetraveller.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24210814728590989"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24269458222726639", "version": "0.0.0.11"}, "id": "1097804795130639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2394468859520
luscdn.com/v/t64.5771-25/491823443_619198341193469_3326769251814915123_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrSnypgFCp4Q7kNvwFim46i&_nc_oc=AdrEz1mrlEaqPrreTS83rgOw8vXNILWSPJsuzkfjidHJXz0HuIP7wZDdbgUB4ZrA22c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTm774bXoSUMu5Xhyh-H1tYjTDgRAKUMerpmVulSOJvQ&oe=6B0850AC"}, {"file_name": "New Project (14).png", "id": "727679349871613", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824609_727679353204946_4576325471928986104_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qLuVfNeViwQ7kNvwF6o7Dj&_nc_oc=AdrvmkwZ5lCiZibzcvEQ39UHTvyapWD381oyI2TGt0OiQrr6vYiM6hNel_NCRMzBGgg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjcG717DBq0O-peulYAf9bk3nmkFonlHQn8MQ20-bgIg&oe=6B0872D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ring Rush", "keywords": ["ringtoss", "carnival", "hoopla", "dartgames", "carnivalgames"], "long_description": "Ring Rush is a fast-paced ring toss game set in a nostalgic old pub environment, offering an immersive and engaging experience. With just 10 rings and 2 minutes on the clock, players must aim carefully and toss rings onto pegs to score as many points as possible. Featuring realistic physics, intuitive controls, and a time-based challenge, the game is easy to pick up but difficult to master. Designed as a hype casual experience, Ring Rush provides quick yet competitive gameplay, encouraging players to improve their accuracy and beat their high scores in a classic pub-style setting.", "short_description": "Set in a charming old pub, Ring Rush brings the classic ring toss game to life in immersive virtual reality. With just 10 rings and 2 minutes on the clock, your goal is simple\u2014land as many perfect tosses as possible and rack up the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/ringrush", "develope
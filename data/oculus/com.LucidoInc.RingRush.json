luscdn.com/v/t64.5771-25/491823443_619198341193469_3326769251814915123_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKdVETGqF5QQ7kNvwGo36_J&_nc_oc=AdpeuMz2NKWpzV7IBOpN3k3KKbSh8Oi8wnl4PJ-DuwwsLKn4wwTy63QwGAg6IZ0GCiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7hv7KexQnHYInZNzGxJcSpU5rB1AM9Q8H3y5muVBirg&oe=6B0DCEEC"}, {"file_name": "New Project (14).png", "id": "727679349871613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824609_727679353204946_4576325471928986104_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3fiYXM0E64Q7kNvwFvcY5d&_nc_oc=AdpYuDhmz1r20oVyFJBac5l-kvpMDXCmuW4zuCwDmlJiBV7oAAqi4ORduPoQb2n9iRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9n1jCMmHyTJcsD-p47t4Cic98i7XDOkGeNRmQ3bprvw&oe=6B0DB8D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ring Rush", "keywords": ["ringtoss", "carnival", "hoopla", "dartgames", "carnivalgames"], "long_description": "Ring Rush is a fast-paced ring toss game set in a nostalgic old pub environment, offering an immersive and engaging experience. With just 10 rings and 2 minutes on the clock, players must aim carefully and toss rings onto pegs to score as many points as possible. Featuring realistic physics, intuitive controls, and a time-based challenge, the game is easy to pick up but difficult to master. Designed as a hype casual experience, Ring Rush provides quick yet competitive gameplay, encouraging players to improve their accuracy and beat their high scores in a classic pub-style setting.", "short_description": "Set in a charming old pub, Ring Rush brings the classic ring toss game to life in immersive virtual reality. With just 10 rings and 2 minutes on the clock, your goal is simple\u2014land as many perfect tosses as possible and rack up the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/ringrush", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30199779379669467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296890_1088528696665381_537677869873494421_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBBDTFr9X4oQ7kNvwEjqxxI&_nc_oc=Adpwnlmf7Xma_vX3-caBtijuFvcZ_Cy52VPtLzWhBT3PwIWsreelyHCknCzR1qITOXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMr8Ch49LmqOVg937urg9Bl9n6VdKpuyrBhBbSe2TpCw&oe=6B0DC0AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ring Rush", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1751526000, "lastRevision": {"nodes": [{"id": "29939511779029563", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "29939511722362902", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3300613293438361"}, "iarc_email": null, "msrp": null, "translations": 
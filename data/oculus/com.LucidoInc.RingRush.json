=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoALmnwCU-iCwwSyJeZ0IgjOcy5rYCaeJzhd5k_1dOgQ&oe=6AE366AC"}, {"file_name": "New Project (14).png", "id": "727679349871613", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824609_727679353204946_4576325471928986104_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll-ODrHfL9sQ7kNvwFvVLLT&_nc_oc=AdpwgqZgQnef2V7RR9s7Dxbwtq6RU2JU2udHGXOno57_PXtLBfQodQ_77PRjbxoWH1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONoRJVFzvEhv3F7N8SAu9vxg8jM4xdQ5VpNm39klFGCQ&oe=6AE35098"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ring Rush", "keywords": ["ringtoss", "carnival", "hoopla", "dartgames", "carnivalgames"], "long_description": "Ring Rush is a fast-paced ring toss game set in a nostalgic old pub environment, offering an immersive and engaging experience. With just 10 rings and 2 minutes on the clock, players must aim carefully and toss rings onto pegs to score as many points as possible. Featuring realistic physics, intuitive controls, and a time-based challenge, the game is easy to pick up but difficult to master. Designed as a hype casual experience, Ring Rush provides quick yet competitive gameplay, encouraging players to improve their accuracy and beat their high scores in a classic pub-style setting.", "short_description": "Set in a charming old pub, Ring Rush brings the classic ring toss game to life in immersive virtual reality. With just 10 rings and 2 minutes on the clock, your goal is simple\u2014land as many perfect tosses as possible and rack up the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/ringrush", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
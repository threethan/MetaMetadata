luscdn.com/v/t64.5771-25/491823443_619198341193469_3326769251814915123_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoFYib9XzRcQ7kNvwHLdKNg&_nc_oc=Adrl14_Qc7aumk-Z_qta2ablvC8Iuk4sLDUkbN4iVZjQsL6gjvJjuJq_sLQEnsRq0Fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxS_h8WYjc-rJ1ZeSsLcfz-Cz7N3a368EdRiXFrAvGSA&oe=6B0C7D6C"}, {"file_name": "New Project (14).png", "id": "727679349871613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_727679353204946_4576325471928986104_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3fiYXM0E64Q7kNvwEvTk_1&_nc_oc=Adog9Q-cm0E3e_fRfShjAW4Mi9FnF5PYLeU9x20YJliqxarqke0-KDY40eQUduEk8DY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpFY3dn5RjL5ZzRfS9UZ-4cxPtTt3X_KVJbWZKSdh5AA&oe=6B0C6758"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ring Rush", "keywords": ["ringtoss", "carnival", "hoopla", "dartgames", "carnivalgames"], "long_description": "Ring Rush is a fast-paced ring toss game set in a nostalgic old pub environment, offering an immersive and engaging experience. With just 10 rings and 2 minutes on the clock, players must aim carefully and toss rings onto pegs to score as many points as possible. Featuring realistic physics, intuitive controls, and a time-based challenge, the game is easy to pick up but difficult to master. Designed as a hype casual experience, Ring Rush provides quick yet competitive gameplay, encouraging players to improve their accuracy and beat their high scores in a classic pub-style setting.", "short_description": "Set in a charming old pub, Ring Rush brings the classic ring toss game to life in immersive virtual reality. With just 10 rings and 2 minutes on the clock, your goal is simple\u2014land as many perfect tosses as possible and rack up the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/ringrush", "develope
00&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKK9wVwdPOEQ7kNvwGneXIx&_nc_oc=AdqXUxLdupVNQW_wtqPciEh0dBUIuZ-3-Rjfir_Qbr2ewXoTXFV93tp93vEKVz6ir0Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1guNuafaw6CZaByd-NaGFcOlm8mOLX78Yn5uxc6slDw&oe=6B0B3FAE"}, {"file_name": "08_harbour_l4_2560x1440.png", "id": "4486440448275799", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299715_4486440451609132_6489777871098235643_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oos6jVWOSAMQ7kNvwG0we-f&_nc_oc=AdqUiJfFxTw4b4h-lEBtfX6U-uHQnWABVOeW0caW-9iZmetHn4nBWypMA-l9lmF9waA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRJ-0ZDsa-LIq-XrQzvC48AEvBZyvyJogQLLoRaiV5tQ&oe=6B0B3AB6"}, {"file_name": "07_city_saved_2560x1440.png", "id": "2414350686044221", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313107_2414350689377554_1629867535950904491_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWQT9VoIWzMQ7kNvwHOs5k9&_nc_oc=AdrNqNi0cqH8-kfEEih6L0Crp-AZmSXSz2xmaGUsfSwu3EX8wt9XHUxXvZtxEiCVwNE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXkP2X30jMmXWsYOzI-Nlgvap5b61_loODnEWHlkAJBQ&oe=6B0B2D72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1157352913429475", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299922_1157352916762808_1754014580718499773_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hbkyi6tuehYQ7kNvwFXyWRd&_nc_oc=AdrykqMRpE-hr4ZPEV-vPrq_wj5DSNDXOd4jcurqwgBhrLvO2p23fXIfiR4QVUZ-OB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzQfmocr8-ktBmh7BNZ7xotqUqMsfOhKsbgvxe_ZiNNw&oe=6B0B30C6"}, "display_name": "Neon Intercept", "keywords": [], "long_description": "Neon Intercept is a classic arcade defence game rebuilt for VR. A glowing city floats at table height in front of you, and the night sky above it fills with missiles, drones and bombers. Your hands are the city's two batteries: point, pull the trigger and an interceptor streaks up and bursts into a neon ring. Anything inside it is gone, and its blast can catch the next one. Big chains score big.\n\nThe reticle locks on at the depth of the nearest threat, so pointing is all it takes to start, and reading the sky gets you more.\n\nFour worlds, forty levels:\n- Harbour City: warheads, armoured warheads, attack drones and the Raven Carrier.\n- Pine Ridge Array: fast missiles, bombers and swarms, on a base that bends around you.\n- Solar Flats: missiles that split, jammers and smart bombs, half a ring around you.\n- Capital Night: everything at once, on a full ring, against the Black Raven.\n\nShoot supply crates for power-ups: Rapid Reload, Flak Fan, City Shield, EMP Ring, Chain Arc and the Kestrel drone. Hit a passing supply drone to refill a battery. Then take on Siege 360, the endless mode, for a place on the top 10.\n\nGrab the board to move, turn, tilt or resize it; the wave waits while you hold it. Your view never moves on its own: later worlds wrap the city around you and you simply turn to defend it. Standing or a swivel chair is best; seated mode keeps every threat within a half turn.\n\nNo account, no ads, no internet needed.", "short_description": "A glowing neon city sits in front of you on a table-top board, and the sky above it is full of incoming missiles. Each hand is a missile battery: point, pull the trigger and burst them before they land. Chain the blasts, grab power-ups, bring down four giant bosses, and hold on as later worlds wrap the city all the way around you. 40 levels plus the endless Siege 360."}]}, "developer_name": "Guidry Games", "developer_privacy_policy_url": "https://guidrygames.com/privacy.html", "developer_terms_of_service_url": "https://guidrygames.com/terms.html", "publisher_name": "Guidry Games", "support_website_url": "https://guidrygames.com/support.html", "website_url": "https://
om/v/t64.5771-25/499303976_1071639195931883_2798202645703139872_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2IZs9Yq5KIQ7kNvwEgvMjY&_nc_oc=AdomenVLKSLKI62Sf5QTEpo8nY5BgSrXei84tS_JvICWNvgINO4OenR4HaJ1y8yZ2y0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwozgdOc0h5DSbN83runH59a6zRvh5_vqwV-ig8cVqtQ&oe=6B0B37F6"}]}, "id": "1778037263263562", "locale": "en_US", "screenshots": [{"file_name": "02_pine_ridge_l13_2560x1440.png", "id": "1089472744125602", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/737543484_1089472747458935_2317452649474618941_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6OH24d1gxAQ7kNvwEYSxsm&_nc_oc=AdqGpaDa2xa2hrsvIesEEty-GlAQauDPEpir-pCOZ4qVjVIjc5MCHXG8xLDGRfkxsT0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1mZq0OQaXCqZY4sZWnI3deGABUXrxHY_5_iSY5jgCRA&oe=6B0B217C"}, {"file_name": "04_capital_night_l35_2560x1440.png", "id": "1837777444088944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295992_1837777447422277_8406991201209602417_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYV8bLNJBGYQ7kNvwHqu7rw&_nc_oc=Ador5t0wR0_nrH2scW9PoItCO9EMHhqpgAUrEaVroKcE2yGcWFxSdiAa_qm4LuDcr_M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjR5OQYGx0uEk_3MQJ7tObidyDeKG-wRGbIMXFF1inNw&oe=6B0B14A7"}, {"file_name": "05_black_raven_2560x1440.png", "id": "1084542011296694", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295512_1084542014630027_1794950594826599860_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKK9wVwdPOEQ7kNvwGneXIx&_nc_oc=AdqXUxLdupVNQW_wtqPciEh0dBUIuZ-3-Rjfir_Qbr2ewXoTXFV93tp93vEKVz6ir0Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1guNuafaw6CZaByd-NaGFcOlm8mOLX78Yn5uxc6slDw&oe=6B0B3FAE"}, {"file_name": "08_harbour_l4_2560x1440.png", "id": "4486440448275799", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299715_4486440451609132_6489777871098235643_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oos6jVWOSAMQ7kNvwG0we-f&_nc_oc=AdqUiJfFxTw4b4h-lEBtfX6U-uHQnWABVOeW0caW-9iZmetHn4nBWypMA-l9lmF9waA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRJ-0ZDsa-LIq-XrQzvC48AEvBZyvyJogQLLoRaiV5tQ&oe=6B0B3AB6"}, {"file_name": "07_city_saved_2560x1440.png", "id": "2414350686044221", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313107_2414350689377554_1629867535950904491_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWQT9VoIWzMQ7kNvwHOs5k9&_nc_oc=AdrNqNi0cqH8-kfEEih6L0Crp-AZmSXSz2xmaGUsfSwu3EX8wt9XHUxXvZtxEiCVwNE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXkP2X30jMmXWsYOzI-Nlgvap5b61_loODnEWHlkAJBQ&oe=6B0B2D72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1157352913429475", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299922_1157352916762808_1754014580718499773_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hbkyi6tuehYQ7kNvwFXyWRd&_nc_oc=AdrykqMRpE-hr4ZPEV-vPrq_wj5DSNDXOd4jcurqwgBhrLvO2p23fXIfiR4QVUZ-OB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzQfmocr8-ktBmh7BNZ7xotqUqMsfOhKsbgvxe_ZiNNw&oe=6B0B30C6"}, "display_name": "Neon Intercept", "keywords": [], "long_description": "Neon Intercept is a classic arcade defence game rebuilt for VR. A glowing city floats at table height in front of you, and the night sky above it fills with missiles, drones and bombers. Your hands are the city's two batteries: point, pull the trigger and an interceptor streaks up and bursts into a neon ring. Anything inside it is gone, and its blast can catch the next one. Big chains score big.\n\nThe reticle locks on at the depth of the nearest threat, so pointing is all it takes to start, and reading the sky gets you more.\n\nFour worlds, forty levels:\n- Harbour City: warheads, armoured warheads, attack drones and the Raven Carrier.\n- Pine Ridge Array: fast missiles, bombers and swarms, on a base that bends around you.\n- Solar Flats: missiles that split, jammers and smart bombs, half a ring around you.\n- Capital Night: everything at once, on a full ring, against the Black Raven.\n\nShoot supply crates for power-ups: Rapid Reload, Flak Fan, City Shield, EMP Ring, Chain Arc and the Kestrel drone. Hit a passing supply drone to refill a battery. Then take on Siege 360, the endless mode, for a place on the top 10.\n\nGrab the board to move, turn, tilt or resize it; the wave waits while you hold it. Your view never moves on its own: later worlds wrap the city around you and you simply turn to defend it. Standing or a swivel chair is best; seated mode keeps every threat within a half turn.\n\nNo account, no ads, no internet needed.", "short_description": "A glowing neon city sits in front of you on a table-top board, and the sky above it is full of incoming missiles. Each hand is a missile battery: point, pull the trigger and burst them before they land. Chain the blasts, grab power-ups, bring down four giant bosses, and hold on as later worlds wrap the city all the way around you. 40 levels plus the endless Siege 360."}]}, "developer_name": "Guidry Games", "developer_privacy_policy_url": "https://guidrygames.com/privacy.html", "developer_terms_of_service_url": "https://guidrygames.com/terms.html", "publisher_name": "Guidry Games", "support_website_url": "https://guidrygames.com/support.html", "website_url": "https://guidrygames.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
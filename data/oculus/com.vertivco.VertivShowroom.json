UkBrPiZuO0XHrSNF9vW_Jv0XNhTaQf3n8lbuMNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMxWgp9KoHZf6cljn_APVqR701qCbaSBcZaJezSHfZQA&oe=6A9D6E05"}, {"file_name": "5.png", "id": "525864925681784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035407_525864929015117_2067174753097488729_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3G0A7bbtpsQ7kNvwFDgImx&_nc_oc=AdpbSBIy68e0pzxij-6evnAbdYYvlCRRbrk9RuXqt6vd5jWNHTU02mb6DrqXBF4zNzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjGlHob-ZS6Wqc8O3Si3LLfoA3iNnru5T0vmasQ2h8QA&oe=6A9D72E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Store Trailer Cover - 2560x1440 px.png", "id": "414506797547722", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974836_414506800881055_3845959089342143649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNUcUElo2LEQ7kNvwHz5FFV&_nc_oc=Adpr_Y0N_zRywnEoZZJuVdKTASyPpHZp7xYOYr88av2U1ujiYnZDLtMwLyGY4WQJwdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdCTXVIgvPLEDvnoCNP_Z6kfXNU0UoByAtpSgWPJ6D5w&oe=6A9D85B2"}, "display_name": "Vertiv Virtual Showroom", "keywords": [], "long_description": "Take the guesswork out of the equation when you're looking to scale your critical facilities or future-proof your existing data center and IT systems, by interacting with state-of-the-art digital infrastructure solutions from the comfort of your home or office, whether we\u2019re talking about comprehensive DCIM solutions, fully equipped racks, highly efficient cooling, or intelligent power systems.\n\nWith the Vertiv\u2122 Virtual Showroom, you're in control of your exploration, from one end to the other. You decide what solution to explore, what features to look at, in what order, and what functions are most important and deserve a more thorough inspection.\n\nEnjoy a showroom-like experience without the hassle of being physically there and leverage the immersive 3D animations to visualize otherwise impossible-to-see functioning scenarios and invisible features or to spotlight the exact sub-system you're most and learn how it will help you achieve your goals.", "short_description": "Explore your future critical IT infrastructure like never before, in the Vertiv\u2122 Virtual Showroom, leveraging its immersive virtual reality experience of photo-realistic 3D models, enriched with engaging animations that reveal functioning principles and key underlying benefits that were invisible to the naked eye, until now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vertiv.com/en-us/global-data-privacy-and-cookies-policy/", "developer_terms_of_service_url": "https://www.vertiv.com/en-emea/campaigns/terms-of-use-for-the-vertiv-virtual-showroom-app/", "publisher_name": "Vertiv Group Corportation", "support_website_url": null, "website_url": "https://www.vertiv.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "866839484506927"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "311499331223595"}, {"status": "PUBLISHED", "id": "826356521794711"}]}, "baseline_offer": {"id": "311499331223595"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737723180, "status": "PUBLISHED", "id": "311499331223595"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "An
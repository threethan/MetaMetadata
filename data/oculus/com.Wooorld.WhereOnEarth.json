3xhbEWdlvCjUilxB9jyQIsXOaWdFHz64Zg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_IB3OEcdZufEn9IIOPngOBL69qIgwq5EqJBXs9nhceA&oe=6A74A2A5"}, {"file_name": "05.png", "id": "1011986270801803", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgpe8Pfm5osQ7kNvwEp0J7a&_nc_oc=Ado6Wu5z4L4_65yh8BdtDjv08vPaBqyQbI19dVV15aCAIqS2BjUf3VRxVgy-_Ov2mRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmcxc1vg-ChPNfieqofKflNQigruIqfJKR17qtx_fEsA&oe=6A74966C"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hwkQvjHqxAQ7kNvwH791aL&_nc_oc=AdpdhJ7BBtK9GPsTD8U0sb9GrD0dRNJALHB65pij0LmL5j9IGQRBT0xGTRAGI7Fobvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmGfVwlqex6L78HlF5rLjZblaoEyest9tVDS3xP6TYhA&oe=6A748294"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSP1UhIm-W0Q7kNvwFwrSHu&_nc_oc=Ado2sI2ZB7a6OF2X-EOsJZOvYCUiusiFi1VYamTaKx67kQmZCeET4tZBBwr8yBhmeq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp-9CA8AVKscbJje8imGJV24U4GPaYPifpby4JRyOCew&oe=6A74A625"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNPmDaCuaTgQ7kNvwGgCZ5f&_nc_oc=Adpul4j5r4MCsTOzHmVQVjk89DEZ8r32qr4_6bYsg3RahJTkc3HLACFdgM1Cn3rMzAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBUddXksdGpMHZf3KuFJech3NtCg_d-PW_L9E7YyEmmg&oe=6A748FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_web
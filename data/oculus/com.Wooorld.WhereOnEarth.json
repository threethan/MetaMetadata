t_gwdYn7nhofmKF0AAXCnoIwjupYErC_9x18&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJg4XbrWQdBGTcfneRGxaMqtVW9MY4HfYYqG1FHGotsQ&oe=6A7DA4E5"}, {"file_name": "05.png", "id": "1011986270801803", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRLDzQuhbocQ7kNvwGFj4HH&_nc_oc=AdpYQ-K-IJD0zX0cCoLemR8fI31mC7eGI7uWXQbz870x0vNln66q5Q4O3fjSPDWJKqA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFse1ZpuLH2bO_gDHSiZp69yXEb5f1egGjTjfxKsvux_A&oe=6A7DD0EC"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3W708kG8d4Q7kNvwF6J3o5&_nc_oc=Adrpfdw1hQRbk14hGAt5Pzw6579yf5PRBERoSx7TcR_Bj0LGWq3LUvqVjgvD3n94blM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkXseZEGRLriA1LsklIxyFKErb4Gcg8u8SaXtEwIP3Wg&oe=6A7DBD14"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7Zdm0XNRS8Q7kNvwFAo8Fh&_nc_oc=AdoAEquOv1NR96H5ndzdwAMDTT-cTLhCavti1PVF3j-fpN2DdFuVl50bl6QO6RDRSac&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWX-qZQhoYFCRfnpFfD3u0z2a4cxdd8iQCIyz28GpOpQ&oe=6A7DA865"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLXwsLfFMSYQ7kNvwG3MC0K&_nc_oc=AdoNk8wwGQv0Pn9fA-O5Itj6qcEmDI58TD4-SgFMoJaBMfBT_RTvPSUGDDIrevCBeYU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhsCYBRRd4cDaz-YpKFxU70_g8M-_7Ge9XMHZiWyxHwg&oe=6A7DCA58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_w
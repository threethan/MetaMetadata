scdn.com/v/t64.5771-25/473393333_537562535482966_3524953578614336156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF8cDrUyzP8Q7kNvwFDs8RR&_nc_oc=Adqv-qmQO8CC8QJNPzkYYOZEg3UMMQzuU650iqhWtAh1mjQyhknUUUEVAFdZSGEQKgo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxmif8svmOh_7sMaeTA6UCE3lLC4NbbgMynkr0SiuG1A&oe=6AFB1BA5"}, {"file_name": "05.png", "id": "1011986270801803", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCe2hpijK9UQ7kNvwEn_tDy&_nc_oc=Adr51wRqwhZ9D7QXNZj3qnuy0OaE-NTG3ya_Uj91ncbAjhllXDR69cU4hZKTqFVhYoA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFy4_PxY-hsaiJihNnpfIJDQ7pzBprVzePEl8aak-AIw&oe=6AFB47AC"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQgOhyiZ_KYQ7kNvwEo7Pt-&_nc_oc=AdojyvHT5SicflNVXf6rKbc2Q2Nuns4LNlRJwlyzRBtxDnWds_7hvg8_nIxEE-7qH-Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPn63T42Ddu_DlX4Ngx_JvBCFSG2EvXcqwxIid0d9QpQ&oe=6AFB33D4"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e36ncWlowe4Q7kNvwHck4YW&_nc_oc=Adrw087tu2QnOfpgOazkobg9Y2GVd6l5gy8KjFTeDL8kN0tJ6cM2MGAWroy2OILiKWI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg7ntBZzQV3dNORWSG6UZgDDrfX_eF8nkeWoX3UZOKOA&oe=6AFB1F25"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELj9WvZxiOsQ7kNvwE67_iX&_nc_oc=AdrPybwsm_iwOa6udnc9CBmXDTpg4-HAbpgDhE5tfCNs9raESwjWLSkegmCro-UcddI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqis13kbcYokP9cNBxNY8Q-2RvR7JvU28DChDmvMva1g&oe=6AFB4118"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_website_url": "https://wooorld.io/", "website_url": "https://wooorld.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28744914425123247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393770_1612047546341261_3102586240096112785_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGfU2yn755YQ7kNvwEhyhF-&_nc_oc=AdrISnz98pMgzBx6Q97SYQAp63_c4v8yPhVHjYL3eojQkmRH9p6-siPHVNMKbR3katw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIEKIVMA_3YM2VUFvQWs870eqe7bRkOq7Lyozwjrt3rA&oe=6AFB286A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Where on Earth", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "i
3392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2GIcbLheO0Q7kNvwHCdc5c&_nc_oc=AdkbFirsUm_GaCmoxoDf7lg5eV-rHXn3PY5PZQZ4riwlCLURQEnCvtL816_PEYkDcTc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyx4SKedeLH8bZ_XBj8CaBDHK_7B3lYuxDyUoT_Zs1S3A&oe=69BAB2EC"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AssS88akkUQ7kNvwF5bSEM&_nc_oc=Admd0RyD8uXOkio91xLlgfyLgShgeTo-oHqGO-atLUDskN7EH6RzKLC4C73aJJtxczU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSP3EP2pJvIprQ2jbj-zCuus9kE5NdHcHdSXbwt0tlLw&oe=69BA9F14"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De1-wHTCAbgQ7kNvwFAlqoY&_nc_oc=AdnW5ZBMEVVBqJ9iTNMTrjBdx-7Pe8qPB00W99n-p5VfZC4A8Yqnd5o7FQWUhnDc4f0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzki0UD2KP3FpWZ8-u5l2sxjA7Vt2OEuCKo5vxcIDsciw&oe=69BA8A65"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiIGKCylgn4Q7kNvwF8nXsi&_nc_oc=AdmiiiA9B0HhFybVrYVp0wj595JvuN6WX3STPn1n318HuSTEsKbPCtyJsN24SuRIBz0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBnnPBvOLIw8e7urPdtkBBqW8M_BijqeqzS0CdDUn1xA&oe=69BAAC58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_website_url": "https://wooorld.io/", "website_url": "https://wooorld.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "377978
, {"file_name": "05.png", "id": "1011986270801803", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=br506jz2urwQ7kNvwG4TOn6&_nc_oc=AdnbM7rK4Ofi5lgoTnZxnjL7GyCaUOBCYVbqHvkBkg04ydl_KdJfsqeJfLwkAooXsUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-EpEYxup8iHoSd48dmhoZgTdJ5ZTcwyMcKnnY-7AFFA&oe=69B6BE6C"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoQKjvEnlvkQ7kNvwHbSh8K&_nc_oc=AdnnnDaAV7Tp5wRv1E3KziiNRC7-kREVDA9tlhvmODpYqvVoRpQ_XmDqiXpynXES8SQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXv5KUDExd-oK5U8QffP8duECUOMFqdb2F6OZe1i1FXg&oe=69B6AA94"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbBKXAu0zL4Q7kNvwG1WDg0&_nc_oc=AdnDw9nEGDy8xPH9M14XX6DFZlKojrx12R3Llptg6XzMO8xKyf3K8KY_u7I_FvDto58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1lLTZO4-TBmrhvhqIHH0d5sUQJ5DuVk_c03CtXqVtGA&oe=69B695E5"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5in8-MCnKcQ7kNvwFlckXY&_nc_oc=AdmDAnW6WghsYX7jhmBrKcCcvLwjxZLQHO81cLr9PlxJyLmPUQhexvt1p_rUxFMTJYM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCgDVtU2fTW_0MyTO-XRK9Dmrq2T5NQKQoRfym3VDPcw&oe=69B6B7D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_website_url": "https://wooorld.io/", "website_url": "https://wooorld.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id
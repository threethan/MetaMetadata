scdn.com/v/t64.5771-25/473393333_537562535482966_3524953578614336156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfD1BRXvc7MQ7kNvwFB8KdP&_nc_oc=AdpmpmDYyl6EHrw74YkhSfcfYneF_I17Y8Wf0WZTxTW5mCcb7xpRRV6DkLit0jFuJP0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNol4WpOKLWIkjQ2tQktiMhS2OlYhL9xRwGcayQN44DA&oe=6B084AA5"}, {"file_name": "05.png", "id": "1011986270801803", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChpnPcQnn6kQ7kNvwGeJuQI&_nc_oc=AdqiQTcUL-E-heI8a-NwBJCYmKqDS8O3F45CgDZj_GUk4HxXCYqGeCe-K0xrh1tBhQU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8LXa6KAXC8-D6xa-a-zGqjBim7MYvQG41fYb00e-75g&oe=6B083E6C"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkntwHJMEbgQ7kNvwFRxJE8&_nc_oc=Adp3poB4QboFEc3DswbhQ7ZTkIIQVcbJ0sug70COaEFVGwfNOGfugYVU7OIuB29bFT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqqFAem1dyKGCaJAieBwNkaoaPV-xy7URIoslfLSoFGA&oe=6B0862D4"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrR7U4FDlq0Q7kNvwHYS-DM&_nc_oc=AdpeSrjvdmisY2uWgNC7yHxGqdr2Dlmcs3T6aSL-rILBx6pB0ss01aitiXNcgaMCm9w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpk1hLa8PZ45AAHT0nsn9y66ZfMfwJ2DxNTake8CiZiQ&oe=6B084E25"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3R6a7I3UCMQ7kNvwHCmLoh&_nc_oc=AdrFB_brlrQBvn39JcryPqD5TZ5Ao0Ki-kBpxWncirRwPcgtuI9vq6QrIg7qO88rzc4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUt20ao4AAxGL_hFkjP2h_TrtGfNrOW3D_Jk9P_kJo6A&oe=6B087018"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_website_url": "https://wooorld.io/", "website_url": "https://wooorld.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28744914425123247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393770_1612047546341261_3102586240096112785_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNnAALi43foQ7kNvwFGUiud&_nc_oc=AdojNwQUiZFgV2qF2MG9qZgx9wP8cFvp9AZtsI3S-E1LU2pz-xkd7kzpTgSEuvoDRc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUPJ_JrHx1CqTmXhX2tgRAYjGL2Bhcs4wwAhjFxXlDJg&oe=6B08576A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Where on Earth", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "i
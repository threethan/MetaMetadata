ZfqUqbMOFR87CEgsccDPdmxJmQ6gzmrfGY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGduBMKpPa73KK4pGUQBy2AlK6HS-ntKKos10hVaPAV8w&oe=6A8047E5"}, {"file_name": "05.png", "id": "1011986270801803", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWFgRmA8BZwQ7kNvwGEIDLQ&_nc_oc=Ado4J_s2uc78qDVhjfmAnhabM2OtEsD9WGmhemCyKHqJbprRld-NizRt0eqnqKmZL2U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjQhhZiMNB3PTAiBvPt5QTOzgLruOAfFGs3gJ5bgDdIA&oe=6A803BAC"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpbBNJED7PAQ7kNvwGIwJRl&_nc_oc=Adr9trKRKL3RYLTCelv0a_eWWPZ4Q9KlLYnPkIm_gB9lH5-1CrVbSDhqg8Nlula815A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs2ruWu7q7Etg0lQSUDvHWSSPt7GwBePBeDmIgtIW9zg&oe=6A806014"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7Zdm0XNRS8Q7kNvwGhhvMg&_nc_oc=AdoJGWq_uO4_wijXNpNDKOe8uVlbZf6hgjuYM9xZMPqGQWVmgXGpgJAcsGaszLhDjdA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3N7mk7AUItPA3Sd-9D9lbMJ_SsK2aEtNGeEK2stkvqg&oe=6A804B65"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtDPITnTnoYQ7kNvwHMlT9q&_nc_oc=AdqZx8cqb8aihvFxnolv2lXesvOVKGFhdkpEdZELzEFsgrRMbsn9ibvUmEJlk3onG2M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtt7Wr3AB3RfT2-J-jGpTRsbF9bSN9P3rONyIYanXg-w&oe=6A806D58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_web
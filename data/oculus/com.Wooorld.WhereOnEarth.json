d3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6RXRRUmnD-uXXuQ_vhN6ZGpDrJjiCY5_wja8jeGbwPQ&oe=6A6A16A5"}, {"file_name": "05.png", "id": "1011986270801803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392168_1011986274135136_8399905241677803131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb4aMS9VLy0Q7kNvwHbKP4-&_nc_oc=AdrHITfGw6Rx7n2G7Fuj_z-L8U6jky6kG6LWvFhA-Rlvx9k1FqS57i4Khc4_PMATouk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtVB3jq1Z2dtsiDjhM_ULeRVenVyxZUJDsz0Fm3s0rHg&oe=6A6A0A6C"}, {"file_name": "03.png", "id": "1423632349004757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_1423632352338090_4524777843854749483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIpcw5qfpooQ7kNvwFQJgT_&_nc_oc=Adr0nBqsP7DWlXK8mdYgVV061526sx6uNmu6Ko-oMGIy1LdL-p2wKnwNi1FWZIUIf3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANYm9m8WGKS8LGg5g_yFumsE1N8PRwUF641MKSmaqOTw&oe=6A69F694"}, {"file_name": "02.png", "id": "1161324799063900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391860_1161324802397233_129808103212474493_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ2m8PO3ceIQ7kNvwEgt2Bc&_nc_oc=AdpF1X7goqa9ChwaR1Khp5OrgXQHnIReodYP1FXMVmgceZaw4nD4Q5zqP-ltxFq-ID8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKLKVQr6OyCJHCGXT4J_mrKTtOY5bM-Rg138vNDdOGeg&oe=6A69E1E5"}, {"file_name": "04.png", "id": "1548219542522619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392104_1548219545855952_3726187648419365918_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNLSH1n0LMgQ7kNvwFQGkje&_nc_oc=AdrJuOrAfIuXpg1ApE4SX5hpp5ehiRlu7kncFxSG3Bd3uyGEQw8ZBGj_YPjGHcInUk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnchaoRPpZpLGKDZIr8BOUqTR5kbjhYuesdSF6bJOO4w&oe=6A6A03D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where on Earth", "keywords": ["Earth", "World", "Guess", "Travel", "Geo"], "long_description": "From the creators of Wooorld comes Where On Earth\u2014a thrilling, fully social VR location-guessing game where your detective skills and knowledge of the world is put to the test!\n\nStep into immersive real-world locations, search for clues, and pinpoint your location on the map. Play solo, cooperatively with friends, or head-to-head in intense team battles. Explore in 360\u00b0, using intuitive tools like the magnifier, compass and laser pointer to share insights and strategize in real time.\n\n**How it works**:\n\n**\ud83d\udd0e Explore & Investigate** \u2013 Jump to different 360\u00b0 spots, zoom in on details, and analyze your surroundings for clues.\n\n**\ud83d\udccd Make Your Guess** \u2013 Drop a pin on the map and lock in your answer. The closer you are, the higher you score!\n\n**\ud83d\udc65 Team Up or Compete** \u2013 Work together in Co-op Mode or challenge opponents in VS Mode, where teams battle to outguess each other.\n\n**\ud83c\udf0d Social at its core** \u2013 Experience real multiplayer presence with 3D avatars, shared laser pointers, and fun mechanics like seamless teleportation.\n\nWhether you're a geography pro or just love the thrill of discovery, Where On Earth offers an exciting way to test your skills and explore the world\u2014without leaving home.\n\n**Think fast, guess smarter, and prove you know the world!**", "short_description": "From the creators of Wooorld, Where On Earth is the ultimate social VR location-guessing game! Drop into real-world locations, search for clues, and guess where you are. Play together in Co-op or battle it out in VS Mode. Explore in 360\u00b0, use laser pointers to highlight clues, and work together -or against each other- to win. Think you know the world? Prove it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld Inc.", "support_website_url": "https://wooorld.io/", "website_url": "https://wooorld.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28744914425123247"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2094436324756960"}, {"status": "PUBLISHED", "id": "993579043528681"}, {"status": "PUBLISHED", "id": "2179530689531746"}, {"status": "PUBLISHED", "id": "25877993131829052"}, {"status": "PUBLISHED", "id": "775096765632011"}, {"status": "PUBLISHED", "id": "3704205176542302"}, {"status": "PUBLISHED", "id": "1367485911466372"}, {"status": "PUBLISHED", "id": "24637224945902425"}, {"status": "PUBLISHED", "id": "721036657527615"}, {"status": "PUBLISHED", "id": "1624062154969783"}, {"status": "PUBLISHED", "id": "688778580140280"}]}, "baseline_offer": {"id": "688778580140280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2094436324756960"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28745162411765115", "version": "1.0.0.S (1529)"}, "id": "1321489819099194", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "284283352701
ator.\n\nParti's mission is to radically advance architectural representation as an experiential spatial discourse.\n\nParti is a DBOXVR series. DBOX is an Emmy Award-winning Visual Communications agency that has been representing architecture and envisioning futures for over twenty years.\n\nParti 2: Features Oppenheim Architecture. An award winning architecture, planning, and interior design firm, lead by Chad Oppenheim. The firm\u2019s work is built on both a physical and spiritual contextual sensitivity, supported by evocative and economic design solutions that all serve to enhance life.", "short_description": "Parti is a series of Virtual Reality podcasts exploring architecture."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.dboxvr.com/", "developer_terms_of_service_url": "http://www.dboxvr.com/legal", "publisher_name": "DBOXVR", "support_website_url": null, "website_url": "http://www.dboxvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "227752729564788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162682_323109744827473_8060706870655975424_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP37XBfBKLcQ7kNvwGlTqOe&_nc_oc=Adp2XfKxz7BrapEzgo2dWzedb8FvNLu7M5eSQiD626RxUEkBQ2EmjYBYA_vD1RJzf0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkZrdOziCYW7Ky8uiPzdd3
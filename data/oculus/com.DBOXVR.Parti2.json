hysical and spiritual contextual sensitivity, supported by evocative and economic design solutions that all serve to enhance life.", "short_description": "Parti is a series of Virtual Reality podcasts exploring architecture."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.dboxvr.com/", "developer_terms_of_service_url": "http://www.dboxvr.com/legal", "publisher_name": "DBOXVR", "support_website_url": null, "website_url": "http://www.dboxvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "227752729564788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162682_323109744827473_8060706870655975424_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmJbUt2aL9IQ7kNvwFoQ8TD&_nc_oc=AdnJMP6ceOo6NOzXneQdMmLFwsdUqSwJt63fIhzKTsyCDRnyyCAAL-HMGvyYz2IydO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGz-mPBynGb1w64Wz0B-ID4P6qsta1U9CBso8cnOop1Q&oe=69A6F00D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Parti 2: 252 Bal Bay Drive", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1512669900, "lastRevision": {"nodes": [{"id": "1641054832624587", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1324679164310094", "is_first_party": false, "enables_in_app_ads": f
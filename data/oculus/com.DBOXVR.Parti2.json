cdn.com&_nc_ss=7f20f&oh=00_AQGiQO3B5X_jBWyR3BpnaKZNGqJHh8OsBtpFmDSDrniKnw&oe=6A858D71"}, {"file_name": "migrated_image.png", "id": "522771675101861", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162687_503479870016651_908172969337946112_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVT8Izx7KXIQ7kNvwHDih_0&_nc_oc=AdqRvodD_MuQ2gCk--apzVGSWul82mcYSVWdTO7OKdfqUUJSgBa0cdvondxvykI4VTQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjyCV0h4b5KvkIJ7GaVkP7TYWHPMbgLTV1UrK1OFwUNw&oe=6A857D13"}, {"file_name": "migrated_image.png", "id": "241153913707802", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162732_354425545011912_2279967347378749440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs2oRomF8rwQ7kNvwH4Bso1&_nc_oc=AdrMhoS7FjFdEPHhr_woAJeSBB_b3xWt8WVj3E_0m11VjSx2PfGttjOUVQQ0x6lvMnA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRjAUDaKCov6QgT3US09f7Hn2VmokPmniQrl8MabW23g&oe=6A85A973"}, {"file_name": "migrated_image.png", "id": "234119674301600", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162681_156035548317406_7746430077654532096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCVrrcLgLPcQ7kNvwGsZxR6&_nc_oc=Adr6zCKPEr1XJPbCNp5nt7pSz0ndUCJEQfFDMEf7J3G4TH2ijRIxahjG_qqH6PMhhnQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6xDWJX-bojD8AknMaBv9bcSyQwfYi0huTV-eJInsBIg&oe=6A858B68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Parti 2: 252 Bal Bay Drive", "keywords": ["Parti", "Oppenheim", "Architecture", "DBOX", "Miami"], "long_description": "Each edition of Parti will examine a design and its concepts in a dialogue format with its creator.\n\nParti's mission is to radically advance architectural representation as an experiential spatial discourse.\n\nParti is a DBOXVR series. DBOX is an Emmy Award-winning Visual Communications agency that has been representing architecture and envisioning futures for over twenty years.\n\nParti 2: Features Oppenheim Architecture. An award winning architecture, planning, and interior design firm, lead by Chad Oppenheim. The firm\u2019s work is built on both a physical and spiritual contextual sensitivity, supported by evocative and economic design solutions that all serve to enhance life.", "short_description": "Parti is a series of Virtual Reality podcasts exploring architecture."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.dboxvr.com/", "developer_terms_of_service_url": "http://www.dboxvr.com/legal", "publisher_name": "DBOXVR", "support_website_url": null, "website_url": "http://www.dboxvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "227752729564788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162682_323109744827473_8060706870655975424_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxOQvrRRuysQ7kNvwGGTt7H&_nc_oc=Adpx3AECV97QtVnXER5rMJLPgBnvv0gvqN0ZdjcQjtCkd2w7ArGrmqWfmTbHluF2BMc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy1VV6PLpZ33qWJygL3Vgc2P4b_e87NQMlOtwq1UdSvw&oe=6A85854D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Parti 2: 252 Bal Bay Drive", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1512669900, "lastRevision": {"nodes": [{"id": "1641054832624587", "release_type": "
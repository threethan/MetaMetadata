3-1.oculuscdn.com/v/t64.5771-25/491823837_1106166491999058_2896398958615943122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFNpkTbxBGIQ7kNvwHlTUCI&_nc_oc=Adp_1EXjFBoiTqXUOZGbNH4x37F-tnwFolXDyC7oiQkxIoPOsFhsQ04GkwpXHkVc7jQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5nzGWuwerZsSOlXSypVdGgN1VFMt4SYmvWgLDf_wtfg&oe=6AFB1603"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cleared to Land", "keywords": ["flight", "flightcontroller", "airtraffic", "pilot", "plane"], "long_description": "What happens on the table happens in the sky.\n\nYou're the air traffic controller in a glass tower high above the airport. In front of you sits a living tabletop model of the airfield. Reach in, grab an arriving aircraft and draw its flight path through the air with your controller. Then look up: outside your windows, the full-size airliner banks along the exact line you drew, all the way down to the runway.\n\nGet it right and they touch down safely. Get it wrong and two tiny planes collide on your table while a fireball lights up the sky outside.", "short_description": "Draw flight paths on a tabletop airport, and watch real planes outside your control tower follow every line. Land them safely, or watch the sky light up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pratikpansare.github.io/clearedtoland/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pratik Pansare", "support_website_url": null, "website_url": "https://pratikpansare.github.io/clearedtoland/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
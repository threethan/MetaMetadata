": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827585_1102387985901108_9186005726764518639_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPxAQEYh-VAQ7kNvwGX8HoF&_nc_oc=Adr-Ii0apAiym3-PQa17KhqmQBRA8_o2vBuWKzVzL3tqkd6KaVV_wckMYXMVcFeIhLo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2_V1_KSA8srEaFOer7ILPK_odpjdlLT5Z6TnVftpR6g&oe=6B0B1BB3"}, {"file_name": "Foreground.png", "id": "1096553246349411", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823366_1096553249682744_3478633078240364237_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFpq6FshVz0Q7kNvwE8Gafd&_nc_oc=AdrJ-Kt8AMmQbMbWpVK58WbvyhbYJ1YOP6elbpctymDE3vTbyWKsg77cDJdQ_tOOmGo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNZL2d0HgcucWXlcg164DeHcCk0HML5OfdBFy447266w&oe=6B0B3346"}, {"file_name": "banner_3000x900.png", "id": "991591293197255", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825415_991591296530588_3063785441051625951_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BeXbCgzsscQ7kNvwF_mkZ_&_nc_oc=AdqFFSqOntslTD1Xww6XVzevXeIZFtv6N4POj9rqojwoAfUW5IYfSWWOlgYc10zNcnY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqptwVEg8vruV4Rn4XSigLY9T4FByQKfe1pq2inH2wbQ&oe=6B0B1123"}]}, "id": "1146454445003281", "locale": "en_US", "screenshots": [{"file_name": "01_harbor_overshoulder_20261018_142025.png", "id": "1985314558806116", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823757_1985314575472781_487419074401767254_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v5tgcDECr4Q7kNvwFDlrcb&_nc_oc=AdpcAvpaAYpc9EXUdR9NNma8UX9LRdHKsQyAB9j5a7ylpbwN5Vszx958oZB4OrgAwcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMBHG23Qbi-OsQmH0YVe4tPowPk-wYVqq3MOJtMjY2SQ&oe=6B0B3A59"}, {"file_name": "02_harbor_window_20261018_142029.png", "id": "1467031845276310", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827585_1467031851942976_2999260486527164971_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mvb8fie1UYQ7kNvwHbuwlA&_nc_oc=Adq8FXx_IUsZhfAglqTE44OEFlW7gaNZMfegX7uGZdrojmX_CmvrdOI2joQ_k-d4GqM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCy0OE7OLMaVC8n6BQCCylXoYpv37HZjYRnB9yIRXheA&oe=6B0B3FEB"}, {"file_name": "03_mountain_chase_20261018_142100.png", "id": "972209439262405", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824307_972209445929071_4760850493507189140_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0ny0BPqpucQ7kNvwFc7k2l&_nc_oc=AdriwPiqnnsOomxUrHTUfa-VvXkY53-dTd-NDQkWGHTJRfJtOA71-OGvGDP-w6na928&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDD0cqmc_QLCY2DN3gXtHj5qwumrnXkHCpgGyezkSx_Q&oe=6B0B2976"}, {"file_name": "05_crossroads_table_20261018_142129.png", "id": "1101703792408507", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_1101703795741840_3310338282266619893_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnB_6kTdyEoQ7kNvwFFA8xO&_nc_oc=AdpSoIQw6mnWsWGAIJ0snvu_OsX4gw9SkkVvpPDJPtaU34RkyQDHCQriG_omVRoHwA8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZXAucNyHKTWCDviGbDv0c0950AC25EEyMuEUVANVvQw&oe=6B0B378E"}, {"file_name": "04_metro_aerial_20261018_142117.png", "id": "1106166488665725", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823837_1106166491999058_2896398958615943122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0-USDmTS4YQ7kNvwEN-rYz&_nc_oc=AdqaNbBhONO4kb_wQ16wYcGLbeBetlNnN-EoAhymMCxYRZorbtEmla425J4VP8QLinM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEwcETC-xJaCk_QBuLMhJU1Fskzed-KOmXoU0OCTSZPQ&oe=6B0B2043"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cleared to Land", "keywords": ["flight", "flightcontroller", "airtraffic", "pilot", "plane"], "long_description": "What happens on the table happens in the sky.\n\nYou're the air traffic controller in a glass tower high above the airport. In front of you sits a living tabletop model of the airfield. Reach in, grab an arriving aircraft and draw its flight path through the air with your controller. Then look up: outside your windows, the full-size airliner banks along the exact line you drew, all the way down to the runway.\n\nGet it right and they touch down safely. Get it wrong and two tiny planes collide on your table while a fireball lights up the sky outside.", "short_description": "Draw flight paths on a tabletop airport, and watch real planes outside your control tower follow every line. Land them safely, or watch the sky light up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pratikpansare.github.io/clearedtoland/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pratik Pansare", "support_website_url": null, "website_url": "https://pratikpansare.github.io/clearedtoland/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3041756242838686"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "29675806565355838"}]}, "baseline_offer": {"id": "29675806565355838"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793080920, "status": "PUBLISHED", "id": "29675806565355838"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3079109032436740", "version": "0.3.0"}, "id": "1434102701987676", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3041756236172020", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3079109032436740"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1434102701987676"}]}, "change_log": "v0.3.0 \u2013 The Hands-On update!\r\n\r\nNEW: HAND TRACKING\r\nPut the controllers down and play with your hands. The game switches automatically:\r\n- Pinch an aircraft to draw its flight path\r\n- Make an \"L\" with your hand to point: menus light up under your arc, and pinch to press\r\n- Point the same \"L\" at the floor and pinch to teleport around the tower\r\n- Make a fist on the table's handles to move or raise the table, or grab two handles to walk around it\r\n- Tap the round pause button on the table's rim\r\nNew tower-style hands to match the controllers, and a tutorial and tips that follow whichever you're using.\r\n\r\nTHE TOWER IS NOW A SANDBOX\r\nEverything in the cab can be picked up, carried and thrown, and it all has real weight: a paper ball flies, a chair drags. Store things in drawers, shoot paper balls into the bins, play basketball on the mini hoop and throw darts at the board on the stairwell door. The tower remembers where you left things (Settings > Cab props > Tidy up resets it).\r\n\r\nALSO NEW\r\n- Comfort vignette while walking around the table\r\n- Props in the tower resized to real life\r\n- More accurate collisions between aircraft on the runway\r\n- Carrier fighters fly faster and roll out further before the wire stops them\r\n- A new binocular view\r\n- Sakura Spring Station is now the first Getaway\r\n- A tidier Settings menu\r\n- Many fixes and polish\r\n\r\nv0.2 \u2013 The big Getaways update!\r\n\r\nNEW: 11 GETAWAYS\r\nCozy, themed worlds with their own twist: Teacup Valley, Sakura Spring Station, Tulip Canal Town, Lavender Hillside, Sunbeam Bay, Maple Creek Campgrounds, Harvest Fields, Firefly Hollow, Lantern Bay, Coral Reef Research Station and Desert Oasis. Dodge hot-air balloons, time a drawbridge, land floatplanes on lakes, steer around dust devils and rising lanterns. No goal, just fly at your own pace. Land aircraft in any mode to unlock them.\r\n\r\nNEW AIRFIELDS\r\nCarrier Deck (fighter jets catch the wire!), Snow Valley and Palm Atoll. All maps now run from easy to expert.\r\n\r\nENDLESS MODE\r\nClear an airfield to unlock its Endless run: traffic keeps building until one crash ends it. Chase the global leaderboards.\r\n\r\nA NEW CONTROL TOWER\r\nA round tower you can explore. Move the table anywhere, pick up mugs, open drawers and raise the binoculars for a closer look.\r\n\r\nALSO NEW\r\n- Living worlds: ships, trucks, birds, windmills and weather all around you\r\n- Bigger, more dramatic crashes\r\n- Keep your own pilot callsign on the leaderboards\r\n- Locked maps preview as glowing holograms\r\n- A redesigned menu and a friendly tutorial\r\n- A new look with soft glow and richer color (can be switched off in Settings)\r\n- Many fixes and performance improvements", "created_date": 1794992168, "id": "3079109032436740", "version": "0.3.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", 
5-1.oculuscdn.com/v/t64.5771-25/491823837_1106166491999058_2896398958615943122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hclGzQb4fpMQ7kNvwE6h6NZ&_nc_oc=AdrX3_F_nATPcXCGAEp96Nc3YvdoRQWWbazqJLJGGuzVsNZaVq7tx_rYsj7CzVJnoJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlj7FdstAmLMNvzWoAYDqGC1GN-1cCuugALkMoguFRzA&oe=6AFF0A83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cleared to Land", "keywords": ["flight", "flightcontroller", "airtraffic", "pilot", "plane"], "long_description": "What happens on the table happens in the sky.\n\nYou're the air traffic controller in a glass tower high above the airport. In front of you sits a living tabletop model of the airfield. Reach in, grab an arriving aircraft and draw its flight path through the air with your controller. Then look up: outside your windows, the full-size airliner banks along the exact line you drew, all the way down to the runway.\n\nGet it right and they touch down safely. Get it wrong and two tiny planes collide on your table while a fireball lights up the sky outside.", "short_description": "Draw flight paths on a tabletop airport, and watch real planes outside your control tower follow every line. Land them safely, or watch the sky light up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pratikpansare.github.io/clearedtoland/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pratik Pansare", "support_website_url": null, "website_url": "https://pratikpansare.github.io/clearedtoland/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3041756242838686"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "29675806565355838"}]}, "baseline_offer": {"id": "29675806565355838"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793080920, "status": "PUBLISHED", "id": "29675806565355838"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3074159269598383", "version": "0.2.0"}, "id": "1434102701987676", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3041756236172020", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3074159269598383"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1434102701987676"}]}, "change_log": "The big Getaways update!\n\nNEW: 11 GETAWAYS\nCozy, themed worlds with their own twist: Teacup Valley, Sakura Spring Station, Tulip Canal Town, Lavender Hillside, Sunbeam Bay, Maple Creek Campgrounds, Harvest Fields, Firefly Hollow, Lantern Bay, Coral Reef Research Station and Desert Oasis. Dodge hot-air balloons, time a drawbridge, land floatplanes on lakes, steer around dust devils and rising lanterns. No goal, just fly at your own pace. Land aircraft in any mode to unlock them.\n\nNEW AIRFIELDS\nCarrier Deck (fighter jets catch the wire!), Snow Valley and Palm Atoll. All maps now run from easy to expert.\n\nENDLESS MODE\nClear an airfield to unlock its Endless run: traffic keeps building until one crash ends it. Chase the global leaderboards.\n\nA NEW CONTROL TOWER\nA round tower you can explore. Move the table anywhere, pick up mugs, open drawers and raise the binoculars for a closer look.\n\nALSO NEW\n- Living worlds: ships, trucks, birds, windmills and weather all around you\n- Bigger, more dramatic crashes\n- Keep your own pilot callsign on the leaderboards\n- Locked maps preview as glowing holograms\n- A redesigned menu and a friendlier tutorial\n- A new look with soft glow and richer color (can be switched off in Settings)\n- Many fixes and performance improvements", "created_date": 1794688035, "id": "3074159269598383", "version": "0.2.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3041756236172020", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3074159269598383"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1434102701987676"}]}, "change_log": null, "created_date": 1792418419, "id": "3043008429380134", "version": "0.1.9", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3041756236172020", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3074159269598383"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1434102701987676"}]}, "change_log": null, "created_date": 17
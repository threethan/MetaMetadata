tent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823757_1985314575472781_487419074401767254_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Tem2bLXaIQ7kNvwF1kzvm&_nc_oc=AdqO59Z00P0WDvhCeFxUjBbqpPFYeaNS2wai00BCsTPtMU0XgRaEcK7F_bdSBYAsFEg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoBdnF8t5NP5iFAc2HcuflUF8ff7YOKIITvvTlwYwhpw&oe=6AF9DE99"}, {"file_name": "02_harbor_window_20261018_142029.png", "id": "1467031845276310", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827585_1467031851942976_2999260486527164971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mNbRbxmTpMQ7kNvwHdkx0O&_nc_oc=Adodn0ODhuHJ5ZmiHIGerB52yVyYWSABQL8sP4XQmfCbgYrQ_WVcv6QmOJ96oaSbk6Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-pdTu-NMuk3_wloApnmN1_jQtBdlrIZd0HrXRcCfNBQ&oe=6AF9E42B"}, {"file_name": "03_mountain_chase_20261018_142100.png", "id": "972209439262405", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824307_972209445929071_4760850493507189140_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2aHt4M6n8EQ7kNvwHENkJJ&_nc_oc=Adp2UsxYNrX2gdWqfC2KyK2HsrAAgP7llU9_0xs1ciGPWB9oWInspUKApjCcqBGYbjI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSONhtXdkQ-WLek571XLVYkiBiI8GiZp7a-0HIM1GLu_Q&oe=6AF9CDB6"}, {"file_name": "05_crossroads_table_20261018_142129.png", "id": "1101703792408507", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821796_1101703795741840_3310338282266619893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl5NBOVdaUsQ7kNvwFfmBwT&_nc_oc=AdoVsNA4FGLQGy5043VfN7EkpssqrDXYiijFErjDwzlWtF3zr-Mo4fiXZ67fuQTlQPY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSifiMCFuamutNLW-9ojIhgWV_FSjgRHpNQuf6mbxED1A&oe=6AF9DBCE"}, {"file_name": "04_metro_aerial_20261018_142117.png", "id": "1106166488665725", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_1106166491999058_2896398958615943122_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFNpkTbxBGIQ7kNvwF9gK2t&_nc_oc=AdrhaBACjW0eDYuyBwbbzpiesdiKBd4V9lgeltgev2DBW0nXQzLN_cmLv7g4xPNuTpA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzPetAwRfbSSttxlxAdWZOGDERUwCCm573KwiCQqMyTg&oe=6AF9C483"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cleared to Land", "keywords": ["flight", "flightcontroller", "airtraffic", "pilot", "plane"], "long_description": "What happens on the table happens in the sky.\n\nYou're the air traffic controller in a glass tower high above the airport. In front of you sits a living tabletop model of the airfield. Reach in, grab an arriving aircraft and draw its flight path through the air with your controller. Then look up: outside your windows, the full-size airliner banks along the exact line you drew, all the way down to the runway.\n\nGet it right and they touch down safely. Get it wrong and two tiny planes collide on your table while a fireball lights up the sky outside.", "short_description": "Draw flight paths on a tabletop airport, and watch real planes outside your control tower follow every line. Land them safely, or watch the sky light up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pratikpansare.github.io/clearedtoland/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pratik Pansare", "support_website_url": null, "website_url": "https://pratikpansare.github.io/clearedtoland/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
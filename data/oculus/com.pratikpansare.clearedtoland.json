of you sits a living tabletop model of the airfield. Reach in, grab an arriving aircraft and draw its flight path through the air with your controller. Then look up: outside your windows, the full-size airliner banks along the exact line you drew, all the way down to the runway.\n\nGet it right and they touch down safely. Get it wrong and two tiny planes collide on your table while a fireball lights up the sky outside.", "short_description": "Draw flight paths on a tabletop airport, and watch real planes outside your control tower follow every line. Land them safely, or watch the sky light up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pratikpansare.github.io/clearedtoland/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pratik Pansare", "support_website_url": null, "website_url": "https://pratikpansare.github.io/clearedtoland/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3041756242838686"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "29675806565355838"}]}, "baseline_offer": {"id": "29675806565355838"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793080920, "status": "PUBLISHED", "id": "29675806565355838"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resu
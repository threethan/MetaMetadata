ure and each other to rely on. In this peaceful yet challenging setting, you\u2019ll work together to turn the untamed land into a thriving farmstead.  Farmshore is about cooperation, creativity, and finding joy in simple living. The island is yours, make it home.\n{811296841237204}", "short_description": "Enjoy along side your firends, a farming simulator on a deserted island! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6425cf4c-3c54-4f5f-9bd5-52e53aa75f8f", "developer_terms_of_service_url": null, "publisher_name": "FarmshoreGames", "support_website_url": null, "website_url": "https://sites.google.com/view/farmshoregame/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24948882374709070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825034_1807406676870712_7723998895198099330_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjAFrt_jtS8Q7kNvwGrS58j&_nc_oc=AdpjhnMg1n766jQAkVQu5J9__o65tls-lH8xllE3uXDxRBoSmy1oIC3IXnKR_D62nKo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxrh4rnDh0XCBFdDRkcVtjHDjIN78rynfp6IwNvdYAJ4Q&oe=69C7B375"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FarmShore", "platform": "ANDROID_
5771-25/753032404_2105064660108153_7847465253145879904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDwMaLhP0usQ7kNvwH_W1j1&_nc_oc=AdonuzV9TRQ54cMtiV0u-FCqxcPcL6Vi9LWOhqHEgopbqJItoIjsDWFQjlRCmDbQ1zs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa1e2Z1b6UiFLcj0UIA5RFOMrdOzFsAa5_Usp3oQOfmg&oe=6AF0AD11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Linde LVA - Truck Unloading", "keywords": ["Linde", "LVA", "Training", "Unloading", "Truck"], "long_description": "This training introduces the safe and reliable unloading of liquid medical and industrial gases from a delivery truck into a customer storage tank. The process involves several safety-critical steps that must be followed carefully to protect personnel, equipment and product quality.\n\nBefore starting the unloading process, trainees will check the work area, put on the required personal protective equipment (PPE) and apply the wheel chocks to secure the vehicle. They will learn how to identify and verify the correct customer tank and inspect the unloading area and all relevant connections for damage or other potential issues.\n\nThe training covers the correct preparation and connection of the equipment with particular attention to preventing leaks, reacting to icing and product contamination. Trainees will also practice monitoring the transfer throughout the unloading process, recognizing abnormal conditions and responding appropriately when something is not as expected.\n\nBy completing the training, trainees will understand the key safety requirements and correct sequence of actions needed to carry out a controlled and reliable liquid gas transfer while maintaining high standards of safety, product quality and customer supply.", "short_description": "Learn how to safely unload liquid medical and industrial gases from a delivery truck into a customer tank. Follow key safety procedures, use PPE and wheel chocks, verify the correct tank and connections, prevent leaks, icing and contamination and monitor the unloading process to ensure a safe and reliable gas transfer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-lva-training-hub-trainings-on-meta-store/", "developer_terms_of_service_url": null, "publisher_name": "Linde GMBH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "ko", "zh_CN", "ar", "hr", "cs", "es", "fr", "fr_CA", "fr_BE", "es_AR", "es_CL", "es_CO", "es_MX", "es_PR", "es_PE", "es_VE", "it", "ms", "nn", "pl", "pt_BR", "pt", "sv", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28468075632800704"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1100444079303093_2084202865456732995_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrxOdEhwCrMQ7kNvwF8K3Km&_nc_oc=Adr1QPvNH259i9HQpQ3_BcdyV3ccE3XSTAy9_zm50VhkO3MF3ul101cWrX2Vx7g61lQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7QvXiVpdZrHnxl5TRlzx7KUHYY_9SLqYSem4iKtEgvQ&oe=6AF09B64"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Linde LVA - Truck Unloading", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "5
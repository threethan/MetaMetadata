ity", "Multiplex"], "long_description": "Step inside a new world and instantly visualize SketchUp and Revit models on Oculus Go and GearVR.\n\nKubity VR+ is an everyday solution designed to streamline conversations between architects, engineers, designers, contractors, and their clients. 3D communication has never been easier.\n\nIf you have any questions, please contact the team at: support@kubity.com\n\nwww.kubity.com", "short_description": "Step inside a new world and instantly visualize SketchUp and Revit models on Oculus Go and GearVR."}]}, "developer_name": "Kubity SAS", "developer_privacy_policy_url": "https://www.kubity.com/privacy", "developer_terms_of_service_url": "https://www.kubity.com/terms", "publisher_name": "Kubity", "support_website_url": null, "website_url": "https://www.kubity.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3153577471551898"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974517_1593549067413627_6317836084269023232_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnmMZTyAN8MQ7kNvwHhM6tY&_nc_oc=AdrWP_ZmA-Xlpe1MIpIcSWkdQQ5GbU2OiMqTZl9jdB0IWhflLhkI1XCmYNjEtKvOHHw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2k8Lp-Wc5c7l_1xTAa8v3sxpXil32NbkHiwRqL8sQI0A&oe=69F20C12"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kubity VR+",
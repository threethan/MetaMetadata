6_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me-SU1f1y2AQ7kNvwHBRExB&_nc_oc=AdrJySi3vdBSBMORLoaXf1LlFCG70EvlPxX67ljpf050zsxDFSOKKepMXC19wj2Rr2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eY_vHcEJUG7eD02L5796iQH3LEM4PuZOOtg3QJpi0Mw&oe=6A296A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "147436909356199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386259_147436912689532_2294681183780339712_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJqESr0u8T8Q7kNvwHalqKJ&_nc_oc=AdoLx5RzKp76MLaIyKoOJHkrO0lAHT09YAhM3IRu8Y69vdQHTaYLf4luTUx6WbyOPMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98jfTKrL-tcegQ0wg1G91XaW96cV-dEz1uCR_8xtco_g&oe=6A29691D"}, "display_name": "Kubity VR", "keywords": ["Autodesk", "Revit", "SketchUp", "Kubity", "Multiplex"], "long_description": "Step inside a new world and instantly visualize 3D models with Gear VR.\n\nKubity \u2014 the first mixed reality multiplex, is a system to instantly visualize SketchUp\u2122 and Autodesk\u2122 Revit\u2122 models on multiple devices: desktop computers, smartphones, tablets, augmented reality gear and virtual reality glasses. \n\nIt\u2019s an everyday solution to streamline conversations between architects, engineers, contractors, their clients, and the rest of the world. \n\n3D storytelling has never been simpler.\n\nIf you have any questions, please contact the team at: support@kubity.com\n\nwww.kubity.com", "short_description": "Step inside a new world and instantly visualize SketchUp and Revit models with Gear VR."}]}, "developer_name": "Kubity SAS", "developer_privacy_policy_url": "https://www.kubity.com/privacy", "developer_terms_of_service_url": "https://www.kubity.com/terms", "publisher_name": "Kubity", "support_website_url": null, "website_url": "https://www.kubity.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_top
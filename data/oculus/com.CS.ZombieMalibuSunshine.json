a&_nc_ohc=jNYccvxD0qwQ7kNvwEsCaI7&_nc_oc=AdmpHfzkh4Yi_kUzqpgEjrl3ex2bF4dMrrrwidhscHGr8XBVbLEz6IpbFn_pvQUxMls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu4vct8k7st96L-xzREObgVJ_71r2uSjjnPwzw7W62PIw&oe=69A573F2"}, {"file_name": "com.oculus.vrshell-20241202-123716-03.png", "id": "1280364729826275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035358_1280364733159608_780024036038615783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1kIWHv_ZLMQ7kNvwH2FEdf&_nc_oc=AdkQ_BHcMjTi_SibXs-Fm3W_CxtpfnDJCFtnIF02lN0EIUkizhyt6M7KH0Ao9El-vVo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs1JeCXDrRe_SzpDuKaY_2tnWvgUHsFaoFLFn8naGdSoQ&oe=69A58C7B"}, {"file_name": "com.oculus.vrshell-20241202-123716-00.png", "id": "3968971760056610", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974655_3968971763389943_7698613039626497141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLHv9hTiwnkQ7kNvwH8T2UY&_nc_oc=AdlaiZLJARPjJxfcl4PXjjpWM-3FQk9NcPeQk0vC5aZI8ABQvq_0pQdlBZ1jVPdbN18&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsITgwoS_fiUp5HYnuYaywuDTSS2X-7DpJFBq3aUnvCnw&oe=69A56C2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapezombie2.png", "id": "1791319625008446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974510_1791319628341779_5895832432799380764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct-FIYDhKUkQ7kNvwEPtf-q&_nc_oc=AdmZi6HELsm0_Ga1Rjom7yFdBHEN71xug69VIHWhWPGC3upUilZ_IcA-WBgJKwe-42g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuMVSjtzAc7qE_19Dv0j3yAj6BiHVUjmyNzELGro03uhA&oe=69A5955A"}, "display_name": "Zombie Malibu Sunshine - Drive Shooter", "keywords": ["zombie", "arizona", "sunshine", "pavlov", "dead"], "long_description": "\"Zombie Malibu Sunshine\" is an adrenaline-fueled survival game set on a stunning yet deadly beach overrun by waves of relentless zombies. Armed with an arsenal of weapons ranging from pistols to automatic rifles, heavy machine guns, and devastating rocket launchers, you\u2019ll fight to survive the ultimate zombie apocalypse. Master tactical defense strategies and fend off hordes of undead in this thrilling combination of tower defense games and action-packed shooting.\n\nGameplay Highlights\nMassive Arsenal: Start with a simple pistol and upgrade your gear as you progress. Equip shotguns for close-range carnage, unleash heavy firepower with machine guns, or wreak havoc with rocket launchers. Every weapon is designed for maximum zombie destruction.\nDeadly Power-Ups: Collect powerful bonuses scattered across the battlefield to turn the tide of the invasion. Use explosive bombs that rain from the sky, fire and ice bullets to burn or freeze enemies, and bouncing zombie-killing balls to eliminate entire waves with style.\nChallenging Boss Fights: Face off against massive zombie bosses with unique abilities. Strategize and adapt your tactics to bring them down and secure the beach.\nTrustworthy Allies: Recruit loyal companions to join the fight. \n\n\n", "short_description": "Defend yourself against endless waves of zombies on a sunshine beach in apocalypse world. Collect bullets with different effects, use a diverse arsenal of weapons, fight bosses, freeze and fire zombies. Collect bombs to explode enemies. Use your soldiers to destroy enemies faster Your mission is clear \u2014 survive at all costs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
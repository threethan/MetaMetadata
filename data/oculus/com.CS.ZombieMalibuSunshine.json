zsPsN7oc4g&oe=6A50E76A"}, {"file_name": "com.oculus.vrshell-20241202-123716-01.png", "id": "1719169318862935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_1719169322196268_8966571529934969728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPozmb8B7RAQ7kNvwG2uCdF&_nc_oc=AdrcklN_FAzUr7-CRAKa2HsO0xYRN4dXJ6juMUdB0u2HrHX7KbKDXAMGyQjAxGRa14s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK8XEWISIUbTAw_WiwwCH7Pa7SLK2hSYRGLWxH-yCriA&oe=6A510F32"}, {"file_name": "com.oculus.vrshell-20241202-123716-03.png", "id": "1280364729826275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035358_1280364733159608_780024036038615783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luxSdl7ng9YQ7kNvwG9zcq2&_nc_oc=AdqZPkDp4sQHT4raaDCgpJgwzThC-uOkyRmtl_MS0BiSjgu92tFxBG-7jbgQv7vJELw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_5JX0fWDbRaQRS-BDXWRWAPgvA5gI6ApfIx5UDUxsKw&oe=6A50EF7B"}, {"file_name": "com.oculus.vrshell-20241202-123716-00.png", "id": "3968971760056610", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974655_3968971763389943_7698613039626497141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XiVjDEdZQgQ7kNvwGclQ0z&_nc_oc=AdpZjCtpyOg7PI8pIz7fp-vtODM0zPpX_hdR1eoP-6Jke8IW22h-lCLiCcr3mPdJrLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoMCmIym_MFhOwryT7RmV2a9lbXbV8KNJF-kauxBJYZw&oe=6A51076A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapezombie2.png", "id": "1791319625008446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974510_1791319628341779_5895832432799380764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=847HqvDAOdEQ7kNvwFDPcXg&_nc_oc=AdoT6GIAeUFPds9TOqdyeuzBtc_TBCUKVBOQmdCLSbe6Zk7Ye2OwITAZ2JP2Edx84vw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI7t-bJIFaq2rhoEb6yq9tP0sTbQHhRSDhliLm1Jta2A&oe=6A50F85A"}, "display_name": "Zombie Malibu Sunshine - Drive Shooter", "keywords": ["zombie", "arizona", "sunshine", "pavlov", "dead"], "long_description": "\"Zombie Malibu Sunshine\" is an adrenaline-fueled survival game set on a stunning yet deadly beach overrun by waves of relentless zombies. Armed with an arsenal of weapons ranging from pistols to automatic rifles, heavy machine guns, and devastating rocket launchers, you\u2019ll fight to survive the ultimate zombie apocalypse. Master tactical defense strategies and fend off hordes of undead in this thrilling combination of tower defense games and action-packed shooting.\n\nGameplay Highlights\nMassive Arsenal: Start with a simple pistol and upgrade your gear as you progress. Equip shotguns for close-range carnage, unleash heavy firepower with machine guns, or wreak havoc with rocket launchers. Every weapon is designed for maximum zombie destruction.\nDeadly Power-Ups: Collect powerful bonuses scattered across the battlefield to turn the tide of the invasion. Use explosive bombs that rain from the sky, fire and ice bullets to burn or freeze enemies, and bouncing zombie-killing balls to eliminate entire waves with style.\nChallenging Boss Fights: Face off against massive zombie bosses with unique abilities. Strategize and adapt your tactics to bring them down and secure the beach.\nTrustworthy Allies: Recruit loyal companions to join the fight. \n\n\n", "short_description": "Defend yourself against endless waves of zombies on a sunshine beach in apocalypse world. Collect bullets with different effects, use a diverse arsenal of weapons, fight bosses, freeze and fire zombies. Collect bombs to explode enemies. Use your soldiers to destroy enemies faster Your mission is clear \u2014 survive at all costs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COM
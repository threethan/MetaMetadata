1-25/38982637_1719169322196268_8966571529934969728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqbyyXDfBL0Q7kNvwHJbXR7&_nc_oc=AdnCB2eSVszdxu7cVMIyhqVi_2MGjZVMFJhNjcarSMDfZaplFI2Y983HBsx1uhHIWKk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2jk83R4-aIENl5U4Ue7WoDxJEXcyRGN3vzhpZ1wo3bQ&oe=69B15172"}, {"file_name": "com.oculus.vrshell-20241202-123716-03.png", "id": "1280364729826275", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035358_1280364733159608_780024036038615783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZsfPvKHWnEQ7kNvwFcKVw0&_nc_oc=AdkmB3krv5QTaK9lyeKE39djFlbVA3MDQ21QQYeaZHmXS88dpd5Itdb-5P2J8It57ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGM_6vKwzKO2bd7r06GsD2nPIzc1M55c0ulppZn9wTsQ&oe=69B169FB"}, {"file_name": "com.oculus.vrshell-20241202-123716-00.png", "id": "3968971760056610", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_3968971763389943_7698613039626497141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6x599RB9uMQ7kNvwEmhtaA&_nc_oc=Adk6516OvwhZsBWctElgvBKyWJ9k51WRGEz10nM-ukawSTChWPvQXvvQRtM4k3IUemg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzui7PU5xBf5qPD2OhP8p3hJavrmBgk23D68oq73npvYQ&oe=69B149AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapezombie2.png", "id": "1791319625008446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974510_1791319628341779_5895832432799380764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTcrQpal8XIQ7kNvwGhJIm_&_nc_oc=Adk7W1OeTWw6ZGZmkXXH5biYmr1W9l6ABzct5gKWuMCWjJ4LRfMMOWVAFCQ_b7-5eg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwtL6V1zzo6-pCam4ghQzFKgTXPHu9Sxy3HwrUOvOSXg&oe=69B172DA"}, "display_name": "Zombie Malibu Sunshine - Drive Shooter", "keywords": ["zombie", "arizona", "sunshine", "pavlov", "dead"], "long_description": "\"Zombie Malibu Sunshine\" is an adrenaline-fueled survival game set on a stunning yet deadly beach overrun by waves of relentless zombies. Armed with an arsenal of weapons ranging from pistols to automatic rifles, heavy machine guns, and devastating rocket launchers, you\u2019ll fight to survive the ultimate zombie apocalypse. Master tactical defense strategies and fend off hordes of undead in this thrilling combination of tower defense games and action-packed shooting.\n\nGameplay Highlights\nMassive Arsenal: Start with a simple pistol and upgrade your gear as you progress. Equip shotguns for close-range carnage, unleash heavy firepower with machine guns, or wreak havoc with rocket launchers. Every weapon is designed for maximum zombie destruction.\nDeadly Power-Ups: Collect powerful bonuses scattered across the battlefield to turn the tide of the invasion. Use explosive bombs that rain from the sky, fire and ice bullets to burn or freeze enemies, and bouncing zombie-killing balls to eliminate entire waves with style.\nChallenging Boss Fights: Face off against massive zombie bosses with unique abilities. Strategize and adapt your tactics to bring them down and secure the beach.\nTrustworthy Allies: Recruit loyal companions to join the fight. \n\n\n", "short_description": "Defend yourself against endless waves of zombies on a sunshine beach in apocalypse world. Collect bullets with different effects, use a diverse arsenal of weapons, fight bosses, freeze and fire zombies. Collect bombs to explode enemies. Use your soldiers to destroy enemies faster Your mission is clear \u2014 survive at all costs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "4597815049
bC9NxFQiA&oe=6AA152EA"}, {"file_name": "com.oculus.vrshell-20241202-123716-01.png", "id": "1719169318862935", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982637_1719169322196268_8966571529934969728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMw03Qic2x8Q7kNvwFyQ0gi&_nc_oc=Adr_gjJZI8rtmog9YncmIsNIIgiVA590ZSzk1h5Za_52q5Vq7_ReMa2Xk1X_BZVKm6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmcWmjVkPAyWNQI7qEY8kTbHJXY-xD4b555Bcj5mRh9g&oe=6AA17AB2"}, {"file_name": "com.oculus.vrshell-20241202-123716-03.png", "id": "1280364729826275", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035358_1280364733159608_780024036038615783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nelgQKsKgBUQ7kNvwHhXDUk&_nc_oc=Ado9fz6K011faH5IhdZMLqMduQjOOxEGSOVNq3cQj0P0N6oAczfH_jLBukLTOe_Z2pA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcUPkEOu_jIQb6MZWYGxIqkc3MfIl3dWgPFH_6T72DAw&oe=6AA15AFB"}, {"file_name": "com.oculus.vrshell-20241202-123716-00.png", "id": "3968971760056610", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974655_3968971763389943_7698613039626497141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsM2jd6ON70Q7kNvwHl-tFU&_nc_oc=AdrqS4g-7S1tydqQElGWs_6voKT8GabDyikFnKVstwgm8D4syPk1et-vP8A5EIl8d0M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxxUc6wEfpgn-QWsUXiWqUiY2IFm1npH-IzbTxKqQWgg&oe=6AA172EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapezombie2.png", "id": "1791319625008446", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974510_1791319628341779_5895832432799380764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcnI2p6VVc8Q7kNvwHzP89a&_nc_oc=AdotP988W8kmh0nrOYoCPtv5ujie8XdTYuYjOsLbNb0GPuydp2BfEubIThJjFFM0JrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx-jZRC8mlk3KsaQYGmCkcIZhlL8LQwcWGa0LL89tMKA&oe=6AA163DA"}, "display_name": "Zombie Malibu Sunshine - Drive Shooter", "keywords": ["zombie", "arizona", "sunshine", "pavlov", "dead"], "long_description": "\"Zombie Malibu Sunshine\" is an adrenaline-fueled survival game set on a stunning yet deadly beach overrun by waves of relentless zombies. Armed with an arsenal of weapons ranging from pistols to automatic rifles, heavy machine guns, and devastating rocket launchers, you\u2019ll fight to survive the ultimate zombie apocalypse. Master tactical defense strategies and fend off hordes of undead in this thrilling combination of tower defense games and action-packed shooting.\n\nGameplay Highlights\nMassive Arsenal: Start with a simple pistol and upgrade your gear as you progress. Equip shotguns for close-range carnage, unleash heavy firepower with machine guns, or wreak havoc with rocket launchers. Every weapon is designed for maximum zombie destruction.\nDeadly Power-Ups: Collect powerful bonuses scattered across the battlefield to turn the tide of the invasion. Use explosive bombs that rain from the sky, fire and ice bullets to burn or freeze enemies, and bouncing zombie-killing balls to eliminate entire waves with style.\nChallenging Boss Fights: Face off against massive zombie bosses with unique abilities. Strategize and adapt your tactics to bring them down and secure the beach.\nTrustworthy Allies: Recruit loyal companions to join the fight. \n\n\n", "short_description": "Defend yourself against endless waves of zombies on a sunshine beach in apocalypse world. Collect bullets with different effects, use a diverse arsenal of weapons, fight bosses, freeze and fire zombies. Collect bombs to explode enemies. Use your soldiers to destroy enemies faster Your mission is clear \u2014 survive at all costs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COMF
k10eLWN_w&oe=6AF5EB2A"}, {"file_name": "com.oculus.vrshell-20241202-123716-01.png", "id": "1719169318862935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982637_1719169322196268_8966571529934969728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkAau-OJyCMQ7kNvwFteyQN&_nc_oc=AdqytTK2i8u2ZbRXToVZED75qS8pnrBJzhRXnoac-vhAVi2m8cDVfqBDkt9ckk6XT3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcyNDf0qCg7UhZeYhikGINkx2dztiMgpydvDa-nhSXfQ&oe=6AF5DAB2"}, {"file_name": "com.oculus.vrshell-20241202-123716-03.png", "id": "1280364729826275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035358_1280364733159608_780024036038615783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIHhSBNsdVgQ7kNvwH7N4AU&_nc_oc=AdoZM5qBtCsyZUDEorBhuwr9O54c8ggWlFLYhoKx0dyQtsPa7eJOsHBz4F0yCcbvKxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEeouju01y_y9ngcvl219BHYToEqe8RMsJmgYrTnBiTA&oe=6AF5F33B"}, {"file_name": "com.oculus.vrshell-20241202-123716-00.png", "id": "3968971760056610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974655_3968971763389943_7698613039626497141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DHR4MwA2fcQ7kNvwEItKAf&_nc_oc=AdpwfcJ2zMcn2VsifdwfCEj2-L5DcNRkcxn89dES88ukgRLyrKwNKWLDKFIeQZUYBDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyUP21CtD906G0irTBG9SlJJIAqUCVId_Gbkz4vbjlGw&oe=6AF5D2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapezombie2.png", "id": "1791319625008446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_1791319628341779_5895832432799380764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HngAvw0Rt6YQ7kNvwHYPyoY&_nc_oc=Adolit5gRD3sbgBnvO2fqHGc1NKNQSx9MhQfIbix44_0GQuBw_o2unukN0vW_rKZInA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5PEib753Trbn_Ek3SD1vn1ZEXKERIbLS6CGEz2riQ0A&oe=6AF5C3DA"}, "display_name": "Zombie Malibu Sunshine - Drive Shooter", "keywords": ["zombie", "arizona", "sunshine", "pavlov", "dead"], "long_description": "\"Zombie Malibu Sunshine\" is an adrenaline-fueled survival game set on a stunning yet deadly beach overrun by waves of relentless zombies. Armed with an arsenal of weapons ranging from pistols to automatic rifles, heavy machine guns, and devastating rocket launchers, you\u2019ll fight to survive the ultimate zombie apocalypse. Master tactical defense strategies and fend off hordes of undead in this thrilling combination of tower defense games and action-packed shooting.\n\nGameplay Highlights\nMassive Arsenal: Start with a simple pistol and upgrade your gear as you progress. Equip shotguns for close-range carnage, unleash heavy firepower with machine guns, or wreak havoc with rocket launchers. Every weapon is designed for maximum zombie destruction.\nDeadly Power-Ups: Collect powerful bonuses scattered across the battlefield to turn the tide of the invasion. Use explosive bombs that rain from the sky, fire and ice bullets to burn or freeze enemies, and bouncing zombie-killing balls to eliminate entire waves with style.\nChallenging Boss Fights: Face off against massive zombie bosses with unique abilities. Strategize and adapt your tactics to bring them down and secure the beach.\nTrustworthy Allies: Recruit loyal companions to join the fight. \n\n\n", "short_description": "Defend yourself against endless waves of zombies on a sunshine beach in apocalypse world. Collect bullets with different effects, use a diverse arsenal of weapons, fight bosses, freeze and fire zombies. Collect bombs to explode enemies. Use your soldiers to destroy enemies faster Your mission is clear \u2014 survive at all costs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COMF
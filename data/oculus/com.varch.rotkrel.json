.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4RWd9lt8mI34nAlCGBzjoPOJ9saUqR-4z3P-QuZoUkQ&oe=6A2AD9AB"}, {"file_name": "vlcsnap-2022-05-11-22h20m42s592.png", "id": "543172157362634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035421_543172160695967_4686024457388524508_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8M6K99WohsQ7kNvwF2tOER&_nc_oc=AdqLWgdxPNvQDifuS-Pgs6-Nln4j4Dj5nmJzswMfRu2hm3iTke7Pjz3wnjDcK_9ZxmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LxfKZDV23pBO7lk53WkL_btXcW5h9UoK9aR0cPIWuNQ&oe=6A2AC067"}, {"file_name": "vlcsnap-2022-05-11-22h13m29s843.png", "id": "1908519432671357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982698_1908519436004690_5303259187601408640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJwwUZ0rRSAQ7kNvwGjTA6U&_nc_oc=AdrST97fgLL9BlxGQTIvbp4TDIa4fhSGzu_Bd7bHiJkmDdfSMkJYGNK3DA3QDu3ajZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8223h8D4DHYpHDKyiQbhrUiCaW95HKskd3Tdt3qfDvEg&oe=6A2AB9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Min_2560x1440.png", "id": "689767128802899", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269300_689767135469565_3473535513870065346_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFSHZDFngAkQ7kNvwEpcFxq&_nc_oc=AdoIik0UZU4-XEamsGHQKq9hvtmzl8DMOAkwv_u0xwtDwcLR16fiOwqxuMwaCawxyJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zg6aYnofLQjdy0OLpkxsU2UNZOCWyE3DD-ZjLZEtssQ&oe=6A2AB60D"}, "display_name": "The Rhythm of the Knight", "keywords": [], "long_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music.\n\nFeatures :\n\n- Makes you feel epic - Deflect the shots like a jedi, slash your enemies, destroy walls with force impulse. You'll feel so powerful you won't want to stop.\n- Designed by hand levels - All the levels are hand crafted to be unique and fit each song.\n- Six stages declined in 3 difficulties to match the skills of everyone.\n- Improve your skill in a configurable training module and master your lightsaber.", "short_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music."}]}, "developer_name": "Fabien BOCO", "developer_privacy_policy_url": "https://github.com/ValtielChan/Privacy_Policy/blob/main/ROTK_PrivacyPolicy.md", "developer_terms_of_service_url": null, "publisher_name": "BOCO", "support_website_url": null, "website_url": "https://rotk.muware.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24890783513934083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1065183851072473_6287303416542783360_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXXWx5I5ezwQ7kNvwHo6RUm&_nc_oc=Adr_Ob63pIxsNE6adiKfmkYq3kXN-lI2lLJG3rCkqSwixMFK_XcWwtRTXX5LzrdglTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss
98_1908519436004690_5303259187601408640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEmjF50h1G0Q7kNvwG8c6MO&_nc_oc=AdmiK-7CtPOpPSqWiW3ftAXOtNMXhO3H1DeYDpIP7eLhxWLsAwy16z_orvlxIszHJsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspQTbj_VZ_9IZ05gY3cnPqWoghoawpUUpMXAgfBP6fdQ&oe=699DA949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Min_2560x1440.png", "id": "689767128802899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269300_689767135469565_3473535513870065346_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeDv6PvLS0EQ7kNvwE4MF_z&_nc_oc=AdkOHXWgLFOJMvFyowk_zDitV5jFg-sYNcrbNl5Sm_yf1yBLM7--D14N93W-PmFnqx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftcjys44LSJQ4IcC37c5j74qHlv0kJQZk4SLYgkjfmxAw&oe=699DA58D"}, "display_name": "The Rhythm of the Knight", "keywords": [], "long_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music.\n\nFeatures :\n\n- Makes you feel epic - Deflect the shots like a jedi, slash your enemies, destroy walls with force impulse. You'll feel so powerful you won't want to stop.\n- Designed by hand levels - All the levels are hand crafted to be unique and fit each song.\n- Six stages declined in 3 difficulties to match the skills of everyone.\n- Improve your skill in a configurable training module and master your lightsaber.", "short_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.voxel-arch.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_na
vG3KzW3iOmdpb2wb8pIEXT03jqsCcY6z9_7IhDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06igGlRuqzn5WbSjjIL6dIUGqIAfIYyVjZ3rUvlAF_yw&oe=69E38F67"}, {"file_name": "vlcsnap-2022-05-11-22h13m29s843.png", "id": "1908519432671357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982698_1908519436004690_5303259187601408640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erK6fmGSYPQQ7kNvwGcDNhT&_nc_oc=Adq3l-v_HRX0wc6IqKTwzN8nXcCgQoorXLwEdqqfTYC9q7_a5ecpvtqIJeOeTI1Oxmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cadtxds5GYrgUDGZsxLKleudWHsMHaUwytKjDqobC8A&oe=69E388C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Min_2560x1440.png", "id": "689767128802899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269300_689767135469565_3473535513870065346_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umQGcMu1hBMQ7kNvwEuzn34&_nc_oc=AdpNRDZWS_yM3V4oErhW8AkxpEMAxtPsXoM2dEEJ2_aIhPoRhOrCFmX8YjBU6xRSyl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yLmB53U2TVw9hrdX-IBlAQPHqg8q1cgNhIicvYVUMqA&oe=69E3850D"}, "display_name": "The Rhythm of the Knight", "keywords": [], "long_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music.\n\nFeatures :\n\n- Makes you feel epic - Deflect the shots like a jedi, slash your enemies, destroy walls with force impulse. You'll feel so powerful you won't want to stop.\n- Designed by hand levels - All the levels are hand crafted to be unique and fit each song.\n- Six stages declined in 3 difficulties to match the skills of everyone.\n- Improve your skill in a configurable training module and master your lightsaber.", "short_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.voxel-arch.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VArch", "support_website_url": null, "website_url": "https://rotk.voxel-arch.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "685131475926461"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "2999877820181778"}, {"status": "PUBLISHED", "id": "2599198770472705"}, {"status": "PUBLISHED", "id": "2050188625780233"}, {"status": "PUBLISHED", "id": "1965876997292070"}, {"status": "PUBLISHED", "id": "1768548980523929"}, {"status": "PUBLISHED", "id": "1571295817221382"}, {"status": "PUBLISHED", "id": "1559595391651364"}, {"status": "PUBLISHED", "id": "889532690199491"}, {"status": "PUBLISHED", "id": "869451225946644"}, {"status": "PUBLISHED", "id": "819124804323084"}, {"status": "PUBLISHED", "id": "727058163776666"}, {"status": "PUBLISHED", "id": "706414182169378"}, {"status": "PUBLISHED", "id": "687532134223174"}, {"status": "PUBLISHED", "id": "357070246410872"}]}, "baseline_offer": {"id": "687532134223174"}, "is_approved": true, "firstOffer": {"nodes
=8&oh=00_AfyTN_gfbfef1hbM0zm1cBY7CR1UmmrhPvK1y6gNlHSTXg&oe=69BFF6E7"}, {"file_name": "vlcsnap-2022-05-11-22h13m29s843.png", "id": "1908519432671357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982698_1908519436004690_5303259187601408640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQkenUs9BPQQ7kNvwGpBLLt&_nc_oc=Adk1OFaxAi1ftGVzb8gKNkOyK8tgSyXJnwT_y1U5gC4FYKdbxvvz65ZaFHbFWqh6iM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEDrulzDCbed4Njp7Kj1PzoKkOOrtFSjsYlnSI2Sg38g&oe=69BFF049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Min_2560x1440.png", "id": "689767128802899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269300_689767135469565_3473535513870065346_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zlhL-SkSt0Q7kNvwFP81jJ&_nc_oc=AdnYgeZ_p6icfOGenfRLg8eDVjRVYovOzLxLeNjcaxsj2cXVGJ6Y9C9D-QaauNcXevA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEMh24bSVimxgW93adkgOWvbJxmBzdn0T6KunvmUIUCQ&oe=69BFEC8D"}, "display_name": "The Rhythm of the Knight", "keywords": [], "long_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music.\n\nFeatures :\n\n- Makes you feel epic - Deflect the shots like a jedi, slash your enemies, destroy walls with force impulse. You'll feel so powerful you won't want to stop.\n- Designed by hand levels - All the levels are hand crafted to be unique and fit each song.\n- Six stages declined in 3 difficulties to match the skills of everyone.\n- Improve your skill in a configurable training module and master your lightsaber.", "short_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat 
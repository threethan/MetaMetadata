_5rJL0Q7kNvwF1L3a1&_nc_oc=Adq94Omd3iw9KivQ7-hl780FJRuMrxMBNO1cOkCubJfu1XlMoA2I3AikvnRooSnKdX4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlPvd9iM8V5RDAAH1het5EvSlOrGr3DXnQwgpf2njs4Q&oe=6AA180AB"}, {"file_name": "vlcsnap-2022-05-11-22h20m42s592.png", "id": "543172157362634", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035421_543172160695967_4686024457388524508_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT8hm5BKr1cQ7kNvwFvETVF&_nc_oc=Adp-22D2bkR9veXUQDOCU_1BqyzR-gEEMnNCf5Fn4O8iNzgV9pUtmSzq5I3vls2JuEk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRqL8Z8o2q98w_vhT3I5bFwJveN0n241WI2Nk1zSuY_w&oe=6AA16767"}, {"file_name": "vlcsnap-2022-05-11-22h13m29s843.png", "id": "1908519432671357", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982698_1908519436004690_5303259187601408640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdMh4G6iA0wQ7kNvwHWjyde&_nc_oc=AdpjGCX9BUKNhczG2wj9TdIAnj_9Vvqz4VcsWFXZrKDgbSYvN3ndgonT5TjmuDYcljY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbeoQm8PWl2Pv5QJboyCb8vEhN9HL2WLOarFJ37RObeA&oe=6AA160C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Min_2560x1440.png", "id": "689767128802899", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75269300_689767135469565_3473535513870065346_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AB193qV5HyQQ7kNvwGWn_sC&_nc_oc=AdqHLfnJ0M0fEdigCPsnAP3XB4q-bmO7YYQOyryuONHi0qTc49n6mw-ZlVI_kkhqRP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrSQWP5jA0YdfQJFiCfZ1DXgZuoKCbXNNOd-983XgzRA&oe=6AA15D0D"}, "display_name": "The Rhythm of the Knight", "keywords": [], "long_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music.\n\nFeatures :\n\n- Makes you feel epic - Deflect the shots like a jedi, slash your enemies, destroy walls with force impulse. You'll feel so powerful you won't want to stop.\n- Designed by hand levels - All the levels are hand crafted to be unique and fit each song.\n- Six stages declined in 3 difficulties to match the skills of everyone.\n- Improve your skill in a configurable training module and master your lightsaber.", "short_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music."}]}, "developer_name": "Fabien BOCO", "developer_privacy_policy_url": "https://github.com/ValtielChan/Privacy_Policy/blob/main/ROTK_PrivacyPolicy.md", "developer_terms_of_service_url": null, "publisher_name": "BOCO", "support_website_url": null, "website_url": "https://rotk.muware.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24890783513934083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_1065183851072473_6287303416542783360_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgGsxWcsOjYQ7kNvwGn8Wxa&_n
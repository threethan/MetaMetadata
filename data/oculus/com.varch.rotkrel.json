p-2022-05-11-22h20m42s592.png", "id": "543172157362634", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035421_543172160695967_4686024457388524508_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48Y9ClUXjsYQ7kNvwFk9MnX&_nc_oc=AdlxePUGeZxDUmrAtigMocuKijx3r8mIOWvZn_AlFBgjpKRx1dsOYGXlroBVuQum10c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4ZJKhlbkyPdpqiYb_xoS9VFOeDgVbT4qXbb5hZtwdDQ&oe=699C5E67"}, {"file_name": "vlcsnap-2022-05-11-22h13m29s843.png", "id": "1908519432671357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982698_1908519436004690_5303259187601408640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEmjF50h1G0Q7kNvwFSwgTh&_nc_oc=AdnSjQw-C6kw5D9AhlxI1p9TIlZogvpxcDXaPhZRK8U-VDTojWZHoY_qgZXqRGcy4js&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft9c0egOEmW9d1YNNLKW-IprlG_8dupjYOwsE-cpBSjlA&oe=699C57C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Min_2560x1440.png", "id": "689767128802899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269300_689767135469565_3473535513870065346_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeDv6PvLS0EQ7kNvwH2qRNq&_nc_oc=Adm7uti5WZjKYjTquMw7fvernC43k7T88I3K21oK46g9Rd4bhHbxAVbT19DkR1_f10g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvE_OS_fvAdcNXX6SJT4JV5_-fBdGv84_E0G7RBz3BGxg&oe=699C540D"}, "display_name": "The Rhythm of the Knight", "keywords": [], "long_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music.\n\nFeatures :\n\n- Makes you feel epic - Deflect the shots like a jedi, slash your enemies, destroy walls with force impulse. You'll feel so powerful you won't want to stop.\n- Designed by hand levels - All the levels are hand crafted to be unique and fit each song.\n- Six stages declined in 3 difficulties to match the skills of everyone.\n- Improve your skill in a configurable training module and master your lightsaber.", "short_description": "ROTK is a VR rhythm game based on your reflex and lightsaber skill.\n\nDeflect shots, slash projectiles, slash enemies, dodge obstacles, use your powers to break others. All this to the beat of a dark techno song in hand-crafted levels designed to match the music."}]}, "developer_name": "Fabien BOCO", "developer_privacy_policy_url": "https://github.com/ValtielChan/Privacy_Policy/blob/main/ROTK_PrivacyPolicy.md", "developer_terms_of_service_url": null, "publisher_name": "BOCO", "support_website_url": null, "website_url": "https://rotk.muware.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24890783513934083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_1065183851072473_6287303416542783360_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgiO7NDnHSYQ7kNvwE_MXsw&_nc_oc=AdmM6Xwy2nlAGYx5QD_EGepp-Uuo6iav3j4RNQJcFncoUBggXAFh8Jbgq2UOfHpdMfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftDj-E_0QCEVNZUbQBHAsJE-DMhkixW4SHrqSbwI5_dJg&oe=699C642F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Rhy
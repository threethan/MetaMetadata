c_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBvnVCkbQVAQ7kNvwEuHeMN&_nc_oc=AdqgUmkrWGmfCcAj-sHbbECogtx6gIy4YImlzvBgxkAJIbchRetmpe0VTvVPrntQ9Ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UmVErERuJvMS9rqXaVtnUchrXz3jdVHdKeIbLsU7hMA&oe=69F9F298"}, {"file_name": "ScreenRecording[00_01_07][20241112-180012-2].png", "id": "917293560330178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_917293566996844_2929464444855220538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0kgP3jq41kQ7kNvwF5MKJy&_nc_oc=Adrl7pD337zMasIWoa5E8X-TwnKkDariQWElNMG6uu0Kt9dl7O_qsv6cyNKcFMK6y-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JqTJ4Zr2EKWDfFkMZRrqLAsgskxoiPo7mhEyNg55A3A&oe=69FA10E0"}, {"file_name": "ScreenRecording[00_01_01][20241110-194457-0].png", "id": "485078333885404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330721_485078337218737_2935127151916969330_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwKpGjfoQNwQ7kNvwEeHbeT&_nc_oc=AdomNP_4kPGVqs5r-EYq-VcrlMC9cmgvAgM7oHbzVYihFMMlmZbcE_cWlk3iKW7KmPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5napKEGBHO2O7QNXAIXr-uXpOao-I57eD6Ijtp5uG2lA&oe=69FA132B"}, {"file_name": "ScreenRecording[00_02_55][20241112-175740-5].png", "id": "804316151749194", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488380_804316155082527_4595553698061542681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkLOuazEocoQ7kNvwEGKNc4&_nc_oc=Adq30Axy48jkbcXlhNdysQhj9xeixb0NbQjWE5v_LaNfN3NRuekmEXZhoOo6HEWvoOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FxwcjEJ5W_lJpEnd02W40OIL-3cBDa_EJFIMMyXY_BA&oe=69FA035B"}, {"file_name": "ScreenRecording[00_01_54][20241112-175623-2].png", "id": "552204494408252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_552204497741585_5388111841251773757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5NQwe1CcBYQ7kNvwEsIoaF&_nc_oc=Adqhrba1LO_LsM0iYHVE8DEbaDE3iVWjkVqvYzabpsdjDWz2XTdo5crQokBfo2MfZZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47ywWYQht3tWLGfPuELruoJ8wlU-kuQ3_fJoN1MfXCPA&oe=69F9F6B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video1-2560.png", "id": "1670979423479337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468729476_1670979426812670_4443040485130606822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIsyV4xqCREQ7kNvwHCprXU&_nc_oc=AdpdzD0U67BwDBHjat4l0WW2c_d85U9dL3XPmUY_Y921SyozllkQIrU4VXmpaiT6094&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hrhknlGZ8sqLPEjrmQhggoBoByqOB_jODA9Qd8QMlwg&oe=69F9EF37"}, "display_name": "Mecha Warzone", "keywords": [], "long_description": "\u201cListen up, rookie! From today, you\u2019re officially part of Mecha Warzone. This isn\u2019t your average pilot training\u2014your mission is to operate the most advanced crawler mechs and face off in the battlefields of the future. If you want to make it out alive, you\u2019ll need more than courage\u2014you\u2019ll need wisdom and skill.\u201d\n\nLesson One: Know Your Battle Machine\n\u201cThe mech crawler in front of you isn\u2019t just a hunk of metal; it\u2019s your lifeline on the battlefield. Every component can mean the difference between life and death. First step\u2014learn to customize it.\n\nDepending on the battlefield\u2019s demands, you\u2019ll choose from various armor, cannons, and auxiliary equipment. Heavy armor can withstand enemy fire longer but limits mobility. As for weaponry, whether you prefer the devastating power of heavy artillery or the agility of rapid-fire guns, balance is key. In combat, any piece of equipment could be your ticket to victory.\u201d\n\nThe current version supports multiplayer, with new mechs under development.", "short_description": "Enter the battlefield of Mecha Warzone and pilot your custom-built mech crawler in an immersive VR war experience! Combine different armor and weapons to create your unique combat machine.\n\nIn single-player mode, face powerful enemies and adapt your gear to diverse battle scenarios.\nIn multiplayer, compete against others and coordinate with teammates via voice chat for tactical superiority."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/skyfirework/privacy-policy-for-mechawarzone", "developer_terms_of_service_url": null, "publisher_name": "SkyFirework", "support_website_url": null, "website_url": "https://sites.google.com/view/skyfirework/mechawarzone", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN", "en_US", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8711434672308570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974826_1080796287063845_3623891285919186995_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw_dgQY6qa4Q7kNvwFBS88W&_nc_oc=AdpeBOSYIv2h3niJx-Kg2J-DNRqKO38R4ru8_rEDbwIOVx3steDWY4FAR_rBc8-pv_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K9jbNOIPoErWx6lbcC5FvHF6H0M7Pj9Ok77NqxpdS3g&oe=69F9EA47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mecha Warzone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "374404007
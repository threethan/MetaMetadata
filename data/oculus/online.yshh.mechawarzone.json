c_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTdFBolw-N4Q7kNvwFxC1ys&_nc_oc=Ado8GSGIGNInE6n4bj1Ldib-85fY4fLDAYFHWUy1zJbKQHnZ87P4o2Q5mk8WdpHcK-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qmbJWfxALwj9zQHKAD9wIAehyUyy22KDBdEDceIH0UQ&oe=6A427518"}, {"file_name": "ScreenRecording[00_01_07][20241112-180012-2].png", "id": "917293560330178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031606_917293566996844_2929464444855220538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL3q4ETegY8Q7kNvwHikSx8&_nc_oc=AdoFwoip9oJOawsiofSdlsSa1Vln3RpmF3GjeR8OjhaVlpnwKkYbWymcNPaOnMcTrl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Mdo20XbOqoylfNKFh85QH6J0k-S9mDJHeLSnYqhk3kw&oe=6A429360"}, {"file_name": "ScreenRecording[00_01_01][20241110-194457-0].png", "id": "485078333885404", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330721_485078337218737_2935127151916969330_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfhz4inm-qsQ7kNvwFpMkOS&_nc_oc=AdoxsPk3T7B78SL-JDbvLT7tMs5cfjP7GhD_A-EIZWTKZGY_hxGuY2ES1KYQsYFYItk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FeQR5GwV61G5MuQ5V0lnZMLo0kKqR5U_X9RMNSRNpLg&oe=6A4295AB"}, {"file_name": "ScreenRecording[00_02_55][20241112-175740-5].png", "id": "804316151749194", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488380_804316155082527_4595553698061542681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv1ka2JAu_8Q7kNvwEzh8Fk&_nc_oc=AdoSOsDqNc1UUrxj3CvfLaW_Fc7kAHdJpIIbe2i9bupStnYeFyKFBiKA7TPrXzeCSzs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IvhhEclJokFumMDW5oOlFp0slP6VDbodxWxYEU8vpPQ&oe=6A4285DB"}, {"file_name": "ScreenRecording[00_01_54][20241112-175623-2].png", "id": "552204494408252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974469_552204497741585_5388111841251773757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHTiwcN-kiAQ7kNvwFUY2m0&_nc_oc=AdoOoUsJv9EPo8ytV_X_lH7lwwCf-duWJ9N_8GN1m22GiELeLfVwxpDiYhGHDwrAl84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zJe-NFWcNI10YQED0Ulbmxco6-iPh1C8MYsSELmdmVg&oe=6A427937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video1-2560.png", "id": "1670979423479337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468729476_1670979426812670_4443040485130606822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKNuNBKgUXMQ7kNvwFXQWKk&_nc_oc=Adp5FS7OSN4OaRYLDN3hGLjPN0u4BuJdpeZwjqUv73-01vq2yoC5KgJjC8OemlhrijE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pilmZXPSX_3dTeZSbVcSIfcRguF1kEvWYoIPnaFPL9g&oe=6A4271B7"}, "display_name": "Mecha Warzone", "keywords": [], "long_description": "\u201cListen up, rookie! From today, you\u2019re officially part of Mecha Warzone. This isn\u2019t your average pilot training\u2014your mission is to operate the most advanced crawler mechs and face off in the battlefields of the future. If you want to make it out alive, you\u2019ll need more than courage\u2014you\u2019ll need wisdom and skill.\u201d\n\nLesson One: Know Your Battle Machine\n\u201cThe mech crawler in front of you isn\u2019t just a hunk of metal; it\u2019s your lifeline on the battlefield. Every component can mean the difference between life and death. First step\u2014learn to customize it.\n\nDepending on the battlefield\u2019s demands, you\u2019ll choose from various armor, cannons, and auxiliary equipment. Heavy armor can withstand enemy fire longer but limits mobility. As for weaponry, whether you prefer the devastating power of heavy artillery or the agility of rapid-fire guns, balance is key. In combat, any piece of equipment could be your ticket to victory.\u201d\n\nThe current version supports multiplayer, with new mechs under development.", "short_description": "Enter the battlefield of Mecha Warzone and pilot your custom-built mech crawler in an immersive VR war experience! Combine different armor and weapons to create your unique combat machine.\n\nIn single-player mode, face powerful enemies and adapt your gear to diverse battle scenarios.\nIn multiplayer, compete against others and coordinate with teammates via voice chat for tactical superiority."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/skyfirework/privacy-policy-for-mechawarzone", "developer_terms_of_service_url": null, "publisher_name": "SkyFirework", "support_website_url": null, "website_url": "https://sites.google.com/view/skyfirework/mechawarzone", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN", "en_US", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8711434672308570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974826_1080796287063845_3623891285919186995_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1QWNmXJYmsQ7kNvwFDfC6r&_nc_oc=AdqIIklgqbTqmRm4KyNE6ROJOD70UWVJ0StSOKIymcWYn9Qm0ecDhtSePnvN63lMdFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hYoJwinNYFkainTf37LYT_6av5qTx3wR4-rF5L8Achw&oe=6A426CC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mecha Warzone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "374404007
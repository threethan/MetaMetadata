c_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=591nYg7mCLMQ7kNvwEDJG5E&_nc_oc=Adr0eWFTEicyrvmFj_EkUWaFNd43zUN9-R0nSiZJIbHNnQQ05kzEpVCrtuH6syh6WdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9wtnydijXeF0gIVnFiJol7b1zkW7zb66rvadmvg2tgA&oe=6ADF5798"}, {"file_name": "ScreenRecording[00_01_07][20241112-180012-2].png", "id": "917293560330178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_917293566996844_2929464444855220538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KQk6L4LNxMQ7kNvwGgsNNi&_nc_oc=AdqjMWEWp11odvULwIEx0h5f0CVWNRf8RsgF4HJp7OTGcVbI_MvLytXb1-hstmzKn80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSLRLwH6LqKfYo1MjBJiTpdTvyfVT9PX8rU_gybduyDA&oe=6ADF75E0"}, {"file_name": "ScreenRecording[00_01_01][20241110-194457-0].png", "id": "485078333885404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330721_485078337218737_2935127151916969330_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpCIS3Aew-oQ7kNvwFrsvN7&_nc_oc=Adq3SEDJQ-A8Akq4UI3H7Ltd9Khzj2rV3a4rMR9TYqY6IVrhCUw1ltGYTini34sP5WQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxbvSQd4dv6PaVtHIDUdjO_-R2pQzR-VJvhDAg_ZE11g&oe=6ADF782B"}, {"file_name": "ScreenRecording[00_02_55][20241112-175740-5].png", "id": "804316151749194", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488380_804316155082527_4595553698061542681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9OnulYa18oQ7kNvwG2FIUJ&_nc_oc=AdqbHlRsCeW2Ad0b007YCjdg9Y1xIDhmcTAYxq8oSDPIE7k6TdlT7UF_E7gz4P-f3io&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONfxGJoXWdpO7HHkm1ECe0e8NOufoZkkkRmxSH4cK-yw&oe=6ADF685B"}, {"file_name": "ScreenRecording[00_01_54][20241112-175623-2].png", "id": "552204494408252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_552204497741585_5388111841251773757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHsn8zkLjjUQ7kNvwFoVhfF&_nc_oc=Adpm9b1uPZpn7me9YN8DcDlf2xNItGKXSHUscIbWdTAOq_Y6rA0PbWBWVsds9BdGDz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF6MY1_z76KXMKDgvTLYXsSWw1gCTfVUeyED8RD7rtCg&oe=6ADF5BB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video1-2560.png", "id": "1670979423479337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468729476_1670979426812670_4443040485130606822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekLU_uJ_5ogQ7kNvwHxk8rB&_nc_oc=AdrDyXkRtf50KVqaW4jCKtha3FNi2g4SAVvTZoDrkCn2mD_2S-8pNShAJuJ_cJYf6hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvgRLhm7rhTQgPG4p7iOgvG69CBqk3EKUBJeDfh90w4A&oe=6ADF5437"}, "display_name": "Mecha Warzone", "keywords": [], "long_description": "\u201cListen up, rookie! From today, you\u2019re officially part of Mecha Warzone. This isn\u2019t your average pilot training\u2014your mission is to operate the most advanced crawler mechs and face off in the battlefields of the future. If you want to make it out alive, you\u2019ll need more than courage\u2014you\u2019ll need wisdom and skill.\u201d\n\nLesson One: Know Your Battle Machine\n\u201cThe mech crawler in front of you isn\u2019t just a hunk of metal; it\u2019s your lifeline on the battlefield. Every component can mean the difference between life and death. First step\u2014learn to customize it.\n\nDepending on the battlefield\u2019s demands, you\u2019ll choose from various armor, cannons, and auxiliary equipment. Heavy armor can withstand enemy fire longer but limits mobility. As for weaponry, whether you prefer the devastating power of heavy artillery or the agility of rapid-fire guns, balance is key. In combat, any piece of equipment could be your ticket to victory.\u201d\n\nThe current version supports multiplayer, with new mechs under development.", "short_description": "Enter the battlefield of Mecha Warzone and pilot your custom-built mech crawler in an immersive VR war experience! Combine different armor and weapons to create your unique combat machine.\n\nIn single-player mode, face powerful enemies and adapt your gear to diverse battle scenarios.\nIn multiplayer, compete against others and coordinate with teammates via voice chat for tactical superiority."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/skyfirework/privacy-policy-for-mechawarzone", "developer_terms_of_service_url": null, "publisher_name": "SkyFirework", "support_website_url": null, "website_url": "https://sites.google.com/view/skyfirework/mechawarzone", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN", "en_US", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8711434672308570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974826_1080796287063845_3623891285919186995_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8r51sEbH7QQ7kNvwGFP2QQ&_nc_oc=AdoHWLzZNI6ci48FiCKI6UE3rBgCNPoDJ6oBE7JUSKxXlGqPtm3pr69Zxy_14AtjXaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkyjcBqH-iz-4XZATTXEZfwZL6EAru8iYxOg43rjqX2Q&oe=6ADF4F47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mecha Warzone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "374404007
tent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzN_bvEA6QRxr1NTer-EewNSnhqdYYIJFz2NrD2dNhOWQ&oe=69B6BA37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video1-2560.png", "id": "1670979423479337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468729476_1670979426812670_4443040485130606822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NrJ0ujJCdsQ7kNvwG6_BRd&_nc_oc=AdmmGXDL5boorpwhNvHC1m06W6yDO9FgVXLXfTvJELph9zMlPd44veco_6s0aY9RGWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlyRzO1XJ7SuXuqTa6CPCV-TDhhmJEtZyjNZhG_VyKtg&oe=69B6B2B7"}, "display_name": "Mecha Warzone", "keywords": [], "long_description": "\u201cListen up, rookie! From today, you\u2019re officially part of Mecha Warzone. This isn\u2019t your average pilot training\u2014your mission is to operate the most advanced crawler mechs and face off in the battlefields of the future. If you want to make it out alive, you\u2019ll need more than courage\u2014you\u2019ll need wisdom and skill.\u201d\n\nLesson One: Know Your Battle Machine\n\u201cThe mech crawler in front of you isn\u2019t just a hunk of metal; it\u2019s your lifeline on the battlefield. Every component can mean the difference between life and death. First step\u2014learn to customize it.\n\nDepending on the battlefield\u2019s demands, you\u2019ll choose from various armor, cannons, and auxiliary equipment. Heavy armor can withstand enemy fire longer but limits mobility. As for weaponry, whether you prefer the devastating power of heavy artillery or the agility of rapid-fire guns, balance is key. In combat, any piece of equipment could be your ticket to victory.\u201d\n\nThe current version supports multiplayer, with new mechs under development.", "short_description": "Enter the battlefield of Mecha Warzone and pilot your custom-built mech crawler in an immersive VR war experience! Combine different armor and weapons to create your unique combat machine.\n\nIn single-player mode, face powerful enemies and adapt your gear to diverse battle scenarios.\nIn multiplayer, compete against others and coordinate with teammates via voice chat for tactical superiority."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/skyfirework/privacy-policy-for-mechawarzone", "developer_terms_of_service_url": null, "publisher_name": "SkyFirework", "support_website_url": null, "website_url": "https://sites.google.com/view/skyfirework/mechawarzone", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN", "en_US", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8711434672308570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974826_1080796287063845_3623891285919186995_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdPff-XTXrUQ7kNvwG7aNwE&_nc_oc=AdkdDZR70ioDxd1061mZv3327vXUMF6YAWJ0Q0Mzw3DKy2nxkEECNAk7tBvwEi4QQeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-hBnSYyf7LzEKFfHNgshkx0VjIyZA-vpdtQrnODpEpw&oe=69B6ADC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mecha Warzone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Strategy", "id": "27562921020
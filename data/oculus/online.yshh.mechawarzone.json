380111882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569452_1050987383445215_2794290521524843464_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2jWUPgPY8wQ7kNvwEDpPTp&_nc_oc=Adqy5yjsLCw2lukNa42OGLbpkWkxsx3_d3ZjZw6nvSKsMvM4pN7FWWl_teVuu8Yyhd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8pgIYmrrzlgm9r_lynOZ4X-ZEWNZtAUIGlrgeZOJy5w&oe=6AA2B298"}, {"file_name": "ScreenRecording[00_01_07][20241112-180012-2].png", "id": "917293560330178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031606_917293566996844_2929464444855220538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pyFQHbe-sUQ7kNvwFJXOFm&_nc_oc=AdoMlvGuFrWdKguFEhGJ4ke0bUuso96VrZcy_at4B5lseqGwuN_6FRL5vCHQ_BKYpNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT7YmUL4Gb4JBmeRZAR7rQcvLIvaVbJzmAVbfApK5Eig&oe=6AA2D0E0"}, {"file_name": "ScreenRecording[00_01_01][20241110-194457-0].png", "id": "485078333885404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330721_485078337218737_2935127151916969330_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4fKHoJ2WjoQ7kNvwFW4B3C&_nc_oc=AdqregLxP5KdMigzEIPgiwkgzGbL4U_LgXxOVsagvWn9MfISsS0f-QOhsdhB9PH9iK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtM9ey0tsVqRtrfLuCfhdUudYU6LvdcgTbaY0CYfZ8yA&oe=6AA2D32B"}, {"file_name": "ScreenRecording[00_02_55][20241112-175740-5].png", "id": "804316151749194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488380_804316155082527_4595553698061542681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ_McbVHvugQ7kNvwEGv-6C&_nc_oc=AdqXUFeYI6t3wvmCOWmAMiD44IygX2b6bwBswDZh8sTZjTUXWwBxIrrNq9IFoNgn6g8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5ZH152pmxfPu4bBXTKarrlzqB6WBDFEidDkJZcKP_Ow&oe=6AA2C35B"}, {"file_name": "ScreenRecording[00_01_54][20241112-175623-2].png", "id": "552204494408252", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_552204497741585_5388111841251773757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fuYcOSpzdYQ7kNvwFOHnCZ&_nc_oc=AdowMnWcCIMnfxOs64adFMhY6n3Lxls00OdwnGMMj_DQb3ira3eucsKN5yzVgeejb_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp91bSWW_-asdB1JSb0zrj7qolwYmjmltQCUCUiO1UPg&oe=6AA2B6B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenRecording[00_01_54][20241112-175623-2].png", "id": "565743355860514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282160_565743359193847_2274738165193106264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8sZk0d6OUsQ7kNvwFuzDWx&_nc_oc=Adprd6CMTFrafIjtfqaRrmfhMvj9WhZrZDLCDKJCsfcfYFQDEuCSA1kJN6FqYJFqfyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzseuB5u-v92VkZQaiCkI-LvjBwg4YQpIuieCLojjYRg&oe=6AA2C916"}, "display_name": "Mecha Warzone", "keywords": [], "long_description": "\u201cListen up, rookie! From today, you\u2019re officially part of Mecha Warzone. This isn\u2019t your average pilot training\u2014your mission is to operate the most advanced crawler mechs and face off in the battlefields of the future. If you want to make it out alive, you\u2019ll need more than courage\u2014you\u2019ll need wisdom and skill.\u201d\n\nLesson One: Know Your Battle Machine\n\u201cThe mech crawler in front of you isn\u2019t just a hunk of metal; it\u2019s your lifeline on the battlefield. Every component can mean the difference between life and death. First step\u2014learn to customize it.\n\nDepending on the battlefield\u2019s demands, you\u2019ll choose from various armor, cannons, and auxiliary equipment. Heavy armor can withstand enemy fire longer but limits mobility. As for weaponry, whether you prefer the devastating power of heavy artillery or the agility of rapid-fire guns, balance is key. In combat, any piece of equipment could be your ticket to victory.\u201d\n\nThe current version supports multiplayer, with new mechs under development.", "short_description": "Enter the battlefield of Mecha Warzone and pilot your custom-built mech crawler in an immersive VR war experience! Combine different armor and weapons to create your unique combat machine.\n\nIn single-player mode, face powerful enemies and adapt your gear to diverse battle scenarios.\nIn multiplayer, compete against others and coordinate with teammates via voice chat for tactical superiority."}, {"images": {"nodes": []}, "id": "1092143839239029", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u673a\u7532\u9635\u7ebf", "keywords": [], "long_description": "\u201c\u542c\u597d\u4e86\uff0c\u65b0\u5175\uff01\u4ece\u4eca\u5929\u5f00\u59cb\uff0c\u4f60\u5c31\u662f\u6211\u4eec\u673a\u7532\u9635\u7ebf\u7684\u4e00\u5458\u4e86\u3002\u8fd9\u4e0d\u662f\u4ec0\u4e48\u666e\u901a\u7684\u9a7e\u9a76\u5458\u8bad\u7ec3\uff0c\u4f60\u7684\u804c\u8d23\u662f\u64cd\u63a7\u6700\u5148\u8fdb\u7684\u5c65\u5e26\u673a\u7532\u6218\u8f66\uff0c\u53c2\u4e0e\u672a\u6765\u6218\u573a\u7684\u6b63\u9762\u5bf9\u6297\u3002\u60f3\u6d3b\u7740\u8d70\u51fa\u6218\u573a\uff0c\u4f60\u9700\u8981\u7684\u4e0d\u4ec5\u662f\u52c7\u6c14\uff0c\u8fd8\u8981\u6709\u667a\u6167\u548c\u6280\u5de7\u3002\u201d\n\n\u7b2c\u4e00\u8bfe\uff1a\u4e86\u89e3\u4f60\u7684\u6218\u6597\u673a\u68b0\n\u201c\u4f60\u9762\u524d\u7684\u8fd9\u53f0\u673a\u7532\u6218\u8f66\uff0c\u4e0d\u662f\u4e00\u822c\u7684\u94c1\u7599\u7629\uff0c\u5b83\u662f\u4f60\u5728\u6218\u573a\u4e0a\u7684\u552f\u4e00\u751f\u5b58\u4fdd\u969c\u3002\u6bcf\u4e00\u4e2a\u96f6\u4ef6\u90fd\u80fd\u51b3\u5b9a\u4f60\u7684\u751f\u6b7b\u3002\u6240\u4ee5\uff0c\u7b2c\u4e00\u6b65\u2014\u2014\u5b66\u4f1a\u5b9a\u5236\u5b83\u3002\n\u6839\u636e\u6218\u573a\u7684\u4e0d\u540c\u9700\u6c42\uff0c\u4f60\u5c06\u53ef\u4ee5\u4ece\u5404\u79cd\u88c5\u7532\u3001\u706b\u70ae\u548c\u9644\u52a0\u8bbe\u5907\u4e2d\u8fdb\u884c\u9009\u62e9\u3002\u539a\u91cd\u7684\u88c5\u7532\u80fd\u8ba9\u4f60\u5728\u654c\u4eba\u7684\u70ae\u706b\u4e0b\u652f\u6491\u66f4\u4e45\uff0c\u4f46\u4e5f\u4f1a\u9650\u5236\u4f60\u7684\u673a\u52a8\u6027\u3002\u800c\u706b\u70ae\u5462\uff0c\u4e0d\u7ba1\u4f60\u662f\u559c\u6b22\u91cd\u578b\u70ae\u53f0\u7684\u6bc1\u706d\u6027\u6253\u51fb\uff0c\u8fd8\u662f\u66f4\u7075\u6d3b\u7684\u901f\u5c04\u6b66\u5668\uff0c\u4f60\u90fd\u5f97\u5b66\u4f1a\u6743\u8861\u3002\u6218\u6597\u4e2d\uff0c\u4efb\u4f55\u88c5\u5907\u90fd\u53ef\u80fd\u6210\u4e3a\u4f60\u5236\u80dc\u7684\u5173\u952e\u3002\u201d\n\n\u5f53\u524d\u7248\u672c\u4e3a\u8054\u673a\u7248\uff0c\u540e\u7eed\u65b0\u673a\u7532\u6b63\u5728\u5236\u4f5c\u4e2d\u3002", "short_description": "\u8e0f\u5165\u673a\u7532\u6218\u573a\uff0c\u9a7e\u9a76\u4f60\u4eb2\u624b\u5b9a\u5236\u7684\u673a\u7532\u5c65\u5e26\u6218\u8f66\uff0c\u4f53\u9a8c\u7ec8\u6781\u6c89\u6d78\u5f0fVR\u6218\u4e89\u6e38\u620f\uff01\u5728\u8fd9\u7247\u5145\u6ee1\u785d\u70df\u7684\u6218\u573a\u4e0a\uff0c\u4f60\u5c06\u9009\u62e9\u4e0d\u540c\u7684\u88c5\u7532\u4e0e\u706b\u70ae\u7ec4\u5408\uff0c\u6253\u9020\u5c5e\u4e8e\u4f60\u7684\u72ec\u7279\u6218\u6597\u673a\u5668\u3002\n\n\u5355\u673a\u6a21\u5f0f\u4e0b\uff0c\u4f60\u53ef\u4ee5\u6311\u6218\u5f3a\u5927\u7684\u654c\u4eba\uff0c\u7b56\u7565\u6027\u5730\u9009\u62e9\u88c5\u5907\u4ee5\u9002\u5e94\u4e0d\u540c\u7684\u6218\u6597\u573a\u666f\u548c\u5bf9\u624b\u3002\n\u8054\u673a\u6a21\u5f0f\u4e0b\uff0c\u4f60\u53ef\u4ee5\u4e0e\u73a9\u5bb6\u8fdb\u884c\u7ade\u6280\u5bf9\u6297\uff0c\u540c\u65f6\u901a\u8fc7\u8bed\u97f3\u4e0e\u540c\u6218\u573a\u73a9\u5bb6\u4e92\u76f8\u4ea4\u6d41\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "http://yshh.online/pdf/PrivacyPolicy_MechaWarzone.pdf", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://www.yshh.online/index.eng.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_typ
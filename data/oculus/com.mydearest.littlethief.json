q2eKcQnQH3Q9jm2GNPEeP7Zn6bk_yPH0OQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJC0JNcuy3K-Nl348x1mpbvafOeH70rYT_XqsC8vVHdw&oe=6A60B5E6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 02.00_12_13_16.\u9759\u6b62\u753b008.png", "id": "10088620217814687", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392170_10088620231148019_3077698023116776089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSmdpp6R1nAQ7kNvwFj3nou&_nc_oc=AdrJIpDqk2S2fkKCf2UiEmfuUVAWOVbB5DKLeCTKxaN-10I7ViP2fHdciUnptVdkOGE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc-ePJvn2a7UEBQOuP6Qh7vXQbA7cnmE_Ej8ypBGiTKg&oe=6A60CCC0"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 02.00_01_32_07.\u9759\u6b62\u753b003.png", "id": "1356566445561762", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821827_1356566448895095_242416944507376058_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlLnWUy6-mYQ7kNvwF6Er7j&_nc_oc=AdrH-S2VX1Gr9tASwAN2FaMwPe-eV-hqaRG2qzEiVOzFIPy3XxL6PeujbqlTNH_dHcs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIzYjo6pKnpf0macYcLJ8ER-IT-ycdompOOe2pesX_Bw&oe=6A60C947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1295147352025740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821886_1295147355359073_8182514868869084369_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbvlud7lhDwQ7kNvwHQNY0Y&_nc_oc=Adpbj-8RkIrOb0kepamrZnlOEv7kv7lHwCbfBu3pYShnJKtfJrcsasXBn043yCFDdg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADuTsNCpreMkIuKs1v2BE5BIlpi6kOIpgK6XpLvMnbkw&oe=6A60C806"}, "display_name": "Little Thief", "keywords": [], "long_description": "Get ready, thieves, a big break-in just got bigger! The new Mega Update has arrived and with it, our biggest update yet!\n\n\u30fbThe house is getting a renovation, unlocking brand-new areas to sneak through (did someone say attic?! \ud83d\udc40)\n\u30fbA new family member, the Daughter is here! It looks like she has some \"Little Requests\" for you?\n\u30fbThe pinnacle of thievery, the Ultimate Gear Thief Tool is here to help you snag all this new loot and avoid detection!\n\nWith this update, Little Thief isn\u2019t looking so \u201clittle\u201d anymore!\n\n\ud83d\udcb0Steal from the Rich, Become a VR Robin Hood!\ud83d\udcb0\n Little Thief is a thrilling VR game where you sneak into wealthy homes, stealing anything you can grab\u2014over 400 unique items! But choose wisely: your backpack space is limited. Select carefully, steal boldly!\n\n\ud83c\udf92Prank the Homeowner, Escape the Police!\ud83c\udf92\n Use items and your environment to set mischievous traps for unsuspecting homeowners. But watch out\u2014if you're caught, they'll call the police, and you'll be forced to make a daring escape!\n\n\ud83d\udd2b Unlock Your Thieves Tools with Stolen Goods! \ud83d\udd2b\n From portraits and jewels to even the homeowner's gold teeth, steal valuable items and cash them in for advanced burglary tools. Unlock new possibilities to enter previously inaccessible areas and snatch even greater treasures!", "short_description": "\ud83d\udcb0Steal from the Rich, Become a VR Robin Hood!\ud83d\udcb0\n Little Thief is a thrilling VR game where you sneak into wealthy homes, stealing anything you can grab\u2014over 400 unique items! But choose wisely: your backpack space is limited. Select carefully, steal boldly!"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "269
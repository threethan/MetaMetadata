d": "10088620217814687", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392170_10088620231148019_3077698023116776089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-yWZuQvB94Q7kNvwHFdN-S&_nc_oc=Adq2kJFHi5_eAXydWWESWlQw74BVpsMNakbbT2cb4blYo4-SYPAEMPa9tbgERHS3BLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sgdz9JCvpLuwVzZYL123AYon1ZJI8KdqXKdcc92scIA&oe=6A199BC0"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 02.00_01_32_07.\u9759\u6b62\u753b003.png", "id": "1356566445561762", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821827_1356566448895095_242416944507376058_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcxWb9v8iMQ7kNvwHtaLpZ&_nc_oc=Adrv6ve58B1FVyzrhCMsRXhVaUeDxgipNUfCYkR0FVWNytuqyCKP4LeTtFFnwyy-U5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rx-Sx6-okP8Vr6gr1Nc0jouAvXDneK1LGe6ttBvxQTw&oe=6A199847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1295147352025740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821886_1295147355359073_8182514868869084369_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGRRjGB7vWsQ7kNvwHccIQ2&_nc_oc=AdouvhY-c_RseQtQTo9JTZQjzDX5LiVvVRJPEjgWs7wstt1NwGbRcLPjONGMg6wEajk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CUE6W3jtt-uqc8hss0opBCt5jWrbnI7qSqd4XbgNOKg&oe=6A199706"}, "display_name": "Little Thief", "keywords": [], "long_description": "Get ready, thieves, a big break-in just got bigger! The new Mega Update has arrived and with it, our biggest update yet!\n\n\u30fbThe house is getting a renovation, unlocking brand-new areas to sneak through (did someone say attic?! \ud83d\udc40)\n\u30fbA new family member, the Daughter is here! It looks like she has some \"Little Requests\" for you?\n\u30fbThe pinnacle of thievery, the Ultimate Gear Thief Tool is here to help you snag all this new loot and avoid detection!\n\nWith this update, Little Thief isn\u2019t looking so \u201clittle\u201d anymore!\n\n\ud83d\udcb0Steal from the Rich, Become a VR Robin Hood!\ud83d\udcb0\n Little Thief is a thrilling VR game where you sneak into wealthy homes, stealing anything you can grab\u2014over 400 unique items! But choose wisely: your backpack space is limited. Select carefully, steal boldly!\n\n\ud83c\udf92Prank the Homeowner, Escape the Police!\ud83c\udf92\n Use items and your environment to set mischievous traps for unsuspecting homeowners. But watch out\u2014if you're caught, they'll call the police, and you'll be forced to make a daring escape!\n\n\ud83d\udd2b Unlock Your Thieves Tools with Stolen Goods! \ud83d\udd2b\n From portraits and jewels to even the homeowner's gold teeth, steal valuable items and cash them in for advanced burglary tools. Unlock new possibilities to enter previously inaccessible areas and snatch even greater treasures!", "short_description": "\ud83d\udcb0Steal from the Rich, Become a VR Robin Hood!\ud83d\udcb0\n Little Thief is a thrilling VR game where you sneak into wealthy homes, stealing anything you can grab\u2014over 400 unique items! But choose wisely: your backpack space is limited. Select carefully, steal boldly!"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
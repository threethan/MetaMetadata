_nc_sid=6e7a0a&_nc_ohc=or7NekVAzRYQ7kNvwEpLKIV&_nc_oc=AdrhUiLm9ZBhupfW3sPIS30q7QdRhX5gZvAVR4aRASnR5d1Ny_CiW3PZ-G1aSEbMC6A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYGhymClFKM6Hlu3F-bGV_UVgVpGpHDE1ClXuZetJxXQ&oe=6AE35ED3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lW_tQUOFtwQ7kNvwHMj6my&_nc_oc=AdqRgu_N7r99sqKIQ2TpLfQlUqLL86z1c461cR2gJxlnLJD642yR9woM2q7WBRo0C1o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBhbMOnQKoYSOqJJGYA-kYorakCIAgS7L3a_F_jMq-kQ&oe=6AE344BD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCA_e-zY2b8Q7kNvwHCtpjx&_nc_oc=Adq6SvFHF2_LSi5ZZuisk9h4zX9lmzn1toNDN8s2ECuOy4uR5S6DYPC5DM2NCqgKc9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgo1w0qmoJMbGRmlJb1JiaQj5gR0JZUv9PeUWnIJpoXA&oe=6AE34A58"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvVU19gyyM0Q7kNvwGcHWmD&_nc_oc=Adq0ZoTOQLNWiJXOoR9DuXAwtmFgTjjm4NTYtTmF4gaMsh_rZHQLI_OFQhPGsCWRhw8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIP5dHKBQnIjnkg3GmCmKxzSNoqPg7lBL9ucVbBQI1mQ&oe=6AE35581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vY4JDolMzgQ7kNvwH6QtWa&_nc_oc=AdouB1aTCkYc3UIGmxGAKREDSqmS6bLMJvhFQDHL4yH4I8HQK6LGDzxq8c3uckH0FqU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrCqoK8-8SRYGmvLMR_rCJ7jlbQnJCyRKGPir6tM9QQg&oe=6AE33CD7"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
_nc_sid=6e7a0a&_nc_ohc=9Bjmn2X_mywQ7kNvwEFKRK6&_nc_oc=AdqyZRk-y2-9kBzPfZbHrNSHIcKkV5Q-yRunvUNGlLBzZm99V3PNLTOHZs613_LUsGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGLlp7WBtpfBJGG8MCirpvFggg8Rgqg-TqX-o85bDMIA&oe=6ACE46D3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VthZK453LzEQ7kNvwFpqcpD&_nc_oc=AdoIji6kNq3fYWnM0abl0rdgZgPUwN3Z5ZgexOdcGEni-vN6kAgxnsXwHTDE4Z4FJuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN19DeisFPVMmdRTpoe7UJeCiNAk-Lw_N2m7AH2Gg5pgw&oe=6ACE64FD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cabtuv0VX4Q7kNvwHt0T5O&_nc_oc=Ado_2q9DIGWhTol7zAJBwLKsur8anwK7oDHsMdFWULxSEv5ARajyTqsLo2dt506zuLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2VfSTMKo4e3AeIbFwGvuztOk0o3EQ3JJrfMJrMFUtRA&oe=6ACE6A98"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zf3ei8MVasQQ7kNvwHavmAu&_nc_oc=Adq-f7BBYYly_wjhCxPjuGEeVPyXUTChtHgxrQXLyCA4PhRvJ3aoDQs2I9BzW_Y6FQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwEgWiz94EkdYq2wE2Qw8pfkDS6OaGOZvZO4v7UHXKVQ&oe=6ACE3D81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNBnCrmOHEgQ7kNvwGGl_DZ&_nc_oc=Adr_4Eat4j1ueyuc6Gbob0FUPvKaZcjLVJNw_3_dcsZZPZ913MwzCMxYdfRse5tLWc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5BHq682P_LSxpIMWMb6ANM2QecH7S89gbZtk9qQeFug&oe=6ACE5D17"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
_nc_sid=6e7a0a&_nc_ohc=e8CZZqYngwEQ7kNvwH5-Zl6&_nc_oc=AdopovoIA6kmHZ_xjzNSnN3R7PVSSbn_c1-irUVbQiwDNgoKawOAhrWwO1vYwMH92Dk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwbinkEIwFo1TNjpf5G8QWHN_rFXzdshlprx5HfZD2uQ&oe=6AF330D3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6hzwy9HrYwQ7kNvwE6YZzp&_nc_oc=AdqVnwf_Ow2Y-mhB9VY06mGdaaC4s6yWkpuVZGIXIusQhvuO2GzdTHaPKE7Czt2ggho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOcLnDsiMIZ57L3vwwRC0m9yViUjkGjcN-u40pApOg1w&oe=6AF34EFD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYnNJVcaOKUQ7kNvwGcx7Dj&_nc_oc=Adrwde2sZoSOnFzxEb6oczUuaIEXC5rp9qpg8Nd-d54vItz-x5a5ZCDsw7vt-VKuuHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ7_K9dnpfNtrIS1XBNosFAeJFP2Ph2iZdIogXysol4A&oe=6AF35498"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPZv4qFiVhsQ7kNvwENzjJQ&_nc_oc=Adq_tA54iUYADs6DDl7XdYTeOtzwOpRXakOEQKKs6k98fJFfCA2hPabYOkHMKuZ3gkc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsvbGoLfB-Hr6z3GHOEHA3eDCYeHdY7i4pQL4NyXwZjg&oe=6AF32781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlloCiHlntIQ7kNvwEmFL7m&_nc_oc=AdroN-5v4IbSgEFJpnVGGFBqslEK2iJBJN8lcdgajQVo-q2ocnx_pEhMqa-xAFVGzHw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnFSXAjHu0bC9Ddkp11fy1tvd48tUNS999v7ShSMwzPQ&oe=6AF34717"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
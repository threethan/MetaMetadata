_nc_sid=6e7a0a&_nc_ohc=e8CZZqYngwEQ7kNvwFEo-2A&_nc_oc=AdqmgnftceaVXxY-r77cqEFUqwlnnJrbQxMzmL_FDtLLmF3XAKwjYUH4FkytKue5uFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQylbHS13QvTThGgUJJSaeZVx8oeuAKm7qZTBrWLl26gA&oe=6AF48253"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqblOS8kKhsQ7kNvwEW-a6g&_nc_oc=Adr3GNG6cW7iRPAy9ALwTz1fQPoJXPDYkr292yCCF0a7vnhR8tZTvh-ePKerJMLVLxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWFIQLkK6xYafSPpbmnPJ2-Zr2JYx_xhxbIgzdYqtE0g&oe=6AF4A07D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT8BQaIjBOsQ7kNvwEBLobd&_nc_oc=AdpnCYi0SIldGoPjEGwod6gVZrJugzsK8xntX5PGMG-XXkbgqGsi6taXxxBKgEciUHM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRimPtb_70aP_4R_NU_I0D06dVHnCWj2okdkrNEA_R6g&oe=6AF46DD8"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jktnueCRzQQ7kNvwE57noV&_nc_oc=AdqXc41wnk7qF6uBFvPb4JHXcOyCDp2LPlxORLYfIkjkkC3FMZ2ax3pk_eJc0YuJGDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2yb_Hv0jK2OEEpYCuOA1eirK8DyM6bzIhmcBb7oDGsA&oe=6AF47901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlloCiHlntIQ7kNvwHT2xIQ&_nc_oc=AdpILLmBFlen2At6gb5g2ktT4IS6_1O2nfyM9PVtyDOIkIFatGLWh97_pWWK9HQSAdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0H6Z2XyHj4wZZGXuVRXmPW_8MECqSuPOxepi6D9ieYg&oe=6AF49897"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
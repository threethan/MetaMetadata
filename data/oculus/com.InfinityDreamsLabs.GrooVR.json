_nc_sid=6e7a0a&_nc_ohc=Me3BUO4yL-0Q7kNvwHRlLFq&_nc_oc=AdocJn43igPEPzZ9ZR45cNPPZaTUEKeAdzOA4V0cVBIErrOLHue_EiLHANGc4RzUsBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6omCMrgedVhj558m4e-5NL3vPcIIFccBT-jjjn5hROA&oe=6AD23B53"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiO2kBNaqHsQ7kNvwGgW-pt&_nc_oc=AdqZIwIfw_GzL74JMajqojODDOsTJU9tQYAk6isInYhzAvcg8K2wWLALh7NYDhBYfeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTnzIaUuT-p4G5t7vNnGO6d-OGTCsPZ7Jz0VeGaC1Hcg&oe=6AD2597D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO_QUCb3wtEQ7kNvwGOyOf7&_nc_oc=Adrl7CWr9Gni2CAQ0MEXhIXywYCH-p8s0s5nAAYFmvugU-HzcqVHnbSndtCnVZRUg7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8iPVcArrDCsZ81tMvXMNHu4dCfqSrvm6r25IdRUlwEA&oe=6AD226D8"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdu8k8dQDSwQ7kNvwGAGf64&_nc_oc=Adql76y2hYElyBU_pudFIhgTI5mClpUCMYrcjGBwCv9q71lTH0JzyvaX_WtwYcQoUmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCLGwsL5ZwmXrD5iL2MICS15OhzpLV_XdkXaWLhaftZA&oe=6AD23201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4Jviu89_xAQ7kNvwHv2W-j&_nc_oc=AdrXjMpJk2u6vyZcMGCvCkZMfCrFETmYO1qDhxmYHT3FKHNQqIAEFSeSb-wRxrbJwQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOndmPoclsYrapz5fQVLu8UIQVpIdtWvmCfezMmU6a9wA&oe=6AD25197"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
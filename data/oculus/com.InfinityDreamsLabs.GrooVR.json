ps://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38984467_516535342898049_301673776289574558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNUwaf3H-jcQ7kNvwF7LyE7&_nc_oc=AdreqaFbgwkyaFGMzJqyEFXVhqMnjgqoINGfmCVTrjASXGKb4Pk4SqOi9fOY7qYEr2k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TwSJ5TRooCALk708I2gWbwMpIrY-NfNXDr3lLDjo5iA&oe=6A36BF4A"}, {"file_name": "Screenshots 4.png", "id": "2610125395960217", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974767_2610125399293550_4239908028570259345_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pExziyt05jIQ7kNvwGuaUS2&_nc_oc=AdpJA9sF7cqvCbFasgjBCT4AKDcH2tXBU-IAtlj6ZKgHiDuIWco6Sjko3tGv26bKdgY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9dDXWIrw56e1NF8NXXQGvfuWQGkbtfel3Ea3-a3GbIw&oe=6A36B525"}, {"file_name": "Screenshots 2.png", "id": "4249367498460560", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982445_4249367501793893_2946959581537283578_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpHAwtn5l08Q7kNvwE_pcYF&_nc_oc=AdoED52yUfBO2qk5Uc4Fu-REvvcaLSrligqE2CmwaKaK2re1zgqnro7-TpsrbJKFJqE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qc58HmRF9O4wFjynbpOYiLxLjTTV0njMuHmMq4pOXGQ&oe=6A369D16"}, {"file_name": "Screenshots 1.png", "id": "1029347187868523", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974649_1029347191201856_1702021506251304605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AW7yUFzvsgQ7kNvwEBaYbd&_nc_oc=Adr_ngvAb5dBmv8E9EiKz9_NXJPi-jpR8OVEa4b-kXO81LPRySpO4aJe8DdJZxWUxCo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LzUxw6qNB9eON0dp4TLr6I71nZrLe3f673GFOrfrW9Q&oe=6A36A549"}, {"file_name": "Screenshots 5.png", "id": "546937099673884", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984471_546937103007217_311446915470168227_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHQ1--Amy4AQ7kNvwH-NBSS&_nc_oc=AdrgL1SnQXd0sdTDCOFv__B8va98F7wwyCaCDHoZT0mqDJZbDyvJQuYaXG_oQhzMUAU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T1GkGEiPq-EaoiHlr6WxUfHxhfu6GqV0ILp07SMsorg&oe=6A36C122"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GrooVR - Air Drumming (Demo)", "keywords": [], "long_description": "GrooVR is a unique VR rhythm game where your goal is to hit the beats (represented by small plates) as they are coming at the parts of the drum. \n\nEvery beat indicates which stick you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. \n\nOur goal is to make players learn how to play drums.\n\nEach hit is strongly supported by playing the sound of the drum of the song and visual effects to emphasize the rhythm.\n", "short_description": "GrooVR is a unique VR rhythm game where your goal is to hit the beats (represented by small plates) as they are coming at the parts of the drum. \n\nEvery beat indicates which stick you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. \n\nOur goal is to make players learn how to play drums.\n\nEach hit is strongly supported by playing the sound of the drum of the song and visual effects to emphasize the rhythm.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinity-dreams.vercel.app/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Infinity Dreams Labs", "support_website_url": null, "website_url": "https://infinity-dreams.vercel.app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
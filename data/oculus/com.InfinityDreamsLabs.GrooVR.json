_nc_sid=6e7a0a&_nc_ohc=jILIqCGXQBEQ7kNvwGAYSl-&_nc_oc=AdpWzkkJiMa7Qx9RWwpUHuy2nDvjE9PvvqvzqJwmg2vNOr49afb5xFvoFziG_Mhf1cE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1IjEbL5oKtjlR82ZhbDL5lTE5C76S1gHxGlfFFqmSBA&oe=6AF876D3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx-9D8jxJq8Q7kNvwEMo-Ey&_nc_oc=AdoXb45hu_jUtvhqYKm_geEJWf8-688Ey-pEe4EAq5_2X2TLgAeV8Eun3PhTqp1ID6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi6Ug5I7pljSN3LR9MH6e2lPcSMC0PxjS1uh8YnSG50A&oe=6AF894FD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrDE9jn5oFUQ7kNvwGGzlV1&_nc_oc=AdqrsA7iESEHwVq2VZAFV0QS4MMLqx8pz5dmx97yCEAHa9kRcfL4XeATstnesPPR4Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTss0YDmsgRFXKPJSn81KhPakrwCHQooK7en5MTYoGX_A&oe=6AF89A98"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87Sc1D6atwUQ7kNvwEBnOPX&_nc_oc=Adrl0O5FM_eu2l9Mar2msOE_4C0IIYTJPw5idHNm1h5pzFDgpYcZ_1N3xJyPxzMxin8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTX9M-Sn2b45PenBfazB0ArB-8B0uo_Qxe3pT1RivhVg&oe=6AF8A5C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNWqy0wR1LIQ7kNvwHdi-Xm&_nc_oc=AdpiW-Ekc3f4HLz9l3vPrW9rS5lh6QES7Bx1puyPl0zGS8GaGDo1jQOs2WgHx6hXnoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYOAcJ__vj6YfIrui3N2Swlj65s01RTl6fVs5QdeXk-w&oe=6AF88D17"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
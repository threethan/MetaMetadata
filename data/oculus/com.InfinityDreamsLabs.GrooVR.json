_nc_sid=6e7a0a&_nc_ohc=hbbOtQz1_N0Q7kNvwGJSbJO&_nc_oc=AdqHimx8e9ChM7SEwUCGeTmLfeWCROa1MGPxHY2ougFEr0IXwWr6GXMuyTUI1CfVW1M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6HSJVQb6mi4ujVL8NnqOdHW1WR89fcEzvhZEW5xzhtQ&oe=6ADCC753"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5YkhOUwsDQQ7kNvwFU4v-B&_nc_oc=AdrGMzplRhqXl0Sklb45RiDWddk2urpDrwHAuSgnjbnOyJrZ34gi04K0ZNw4dVYHINM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0fvUgBuog-I1Or-iqJRy4qiJo05dBJVq_h5GpArD9hw&oe=6ADCAD3D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkpeE5gUUvwQ7kNvwHeYVxe&_nc_oc=AdrACzL9Y3fKt_0PnOh3OYc4a0aj434aBCzIewe0l5ol1IDGueUUOCWzLkgwK4XtzD8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtI6PHEgW4BW7TvZXjSTicrlurxJ40Sq9H79RIowq67w&oe=6ADCB2D8"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ7aH45dpoYQ7kNvwGIOMmr&_nc_oc=AdqjNlDMG1Vc544CFJOcm005HjDojtRvsS54xkN-xSKhko8uajWzAAMh_4Vk4RQzjp4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpH151JRkXJU6rUgVH0WDUbnoWf_QTuKa4PdTEumz1eg&oe=6ADCBE01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIP0qutFcUMQ7kNvwHI9kIn&_nc_oc=AdpS9_JxVu8v6UKPRb6oetpZ72LkFpBb1HSCZ4iYF-NGMR2HNlq071duoawYfmN4jtE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmWF-GLYu2hC6InkUDMOyWhH8HJiqtspaNALgh2Q7C0Q&oe=6ADCA557"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
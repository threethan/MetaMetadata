_nc_sid=6e7a0a&_nc_ohc=jILIqCGXQBEQ7kNvwHN28mm&_nc_oc=Adry5UVKNitvHYXbU9ndU5ZBHf4CLlgnBRkg4f_lX0ssrD_KEMHG_xEf0rGPifVuz-Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm9DSeuJ6hfd4YeK5uTcqQvIG9miN_G5mhO_8AT1NWxw&oe=6AF9C853"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx-9D8jxJq8Q7kNvwHv8MS_&_nc_oc=AdpMlLMqfo6u9lZrbWkBKlTOVjlQuWLVvpzEUnWBteRjYcZZsxgXD1j0AFbD2iuGhug&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnzfUWEWZr--OPsWafX-qkyO_-2_2HLizmlK5rFhNXVA&oe=6AF9E67D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrDE9jn5oFUQ7kNvwHvoNoh&_nc_oc=AdoHJmad2DFpxDKPOAyUbhnC25oTTB7yhCxCOkdMmsB5We2fumlIu6G10T1jMmEah9Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDkNH27DA1B3b_NoV_ggctHDc_SPnZArnnaWWl8w1Q1Q&oe=6AF9EC18"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87Sc1D6atwUQ7kNvwFHMf33&_nc_oc=Ado576UpAkecH-LLm7a8-uyqzT8DSgBb7xR9Ql77UAxF6BmewGKnolJmwM3vqyAOeo0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2hPnsa9cXVShRYxW_S34n1VAu6vOuXZN8gK6kQL0jOg&oe=6AF9BF01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNWqy0wR1LIQ7kNvwHvLDz4&_nc_oc=Adrfor_K1pf5FZmWkaYGYeXpsVZ-Nc2DCZy9edL9j1aRNHTfZYq9oljdyOA6v83r_6c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOGaB0RElHe4qTwLbP_rfALJ8wxj4N-gxszLaXucxWoQ&oe=6AF9DE97"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
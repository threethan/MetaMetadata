, "id": "4249367498460560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982445_4249367501793893_2946959581537283578_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZvHqN5mzccQ7kNvwHBIhwZ&_nc_oc=AdraZbI9hC3BGKdnRuMYZ9YL-TUaiFX2vyuVvd95d7ENTwWXvTB35Qy55MSSrXO00l8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREpouKUMW_FXVfA63Crbj61allliYyuqj7_EmHV3zNYg&oe=6AE74616"}, {"file_name": "Screenshots 1.png", "id": "1029347187868523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974649_1029347191201856_1702021506251304605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-LousZnfMkQ7kNvwG-6SFO&_nc_oc=AdoUd_vj5SWokgn7YNHggBqoVgYFA2Bjd38esiw-cBSrvwWP-Vzpt0TXSwTOV6GkFZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUQ-oLmikNPmMXuWbd1ODXdMw8EFQy7Ct7Ch1DPNwF1w&oe=6AE74E49"}, {"file_name": "Screenshots 5.png", "id": "546937099673884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984471_546937103007217_311446915470168227_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYjc3B7AyOUQ7kNvwHelU9f&_nc_oc=AdpXA6BY3e4a81IG7gtLpjeBRmKSg5kCOlilSjLawcN9NXWm3ivVfp7He-gXKdnq3bc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw58QZ8WgrVABmlZXeUBgi9IQtDcR1qxjcXFTERKxhVQ&oe=6AE76A22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GrooVR - Air Drumming (Demo)", "keywords": [], "long_description": "GrooVR is a unique VR rhythm game where your goal is to hit the beats (represented by small plates) as they are coming at the parts of the drum. \n\nEvery beat indicates which stick you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. \n\nOur goal is to make players learn how to play drums.\n\nEach hit is strongly supported by playing the sound of the drum of the song and visual effects to emphasize the rhythm.\n", "short_description": "GrooVR is a unique VR rhythm game where your goal is to hit the beats (represented by small plates) as they are coming at the parts of the drum. \n\nEvery beat indicates which stick you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. \n\nOur goal is to make players learn how to play drums.\n\nEach hit is strongly supported by playing the sound of the drum of the song and visual effects to emphasize the rhythm.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinity-dreams.vercel.app/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Infinity Dreams Labs", "support_website_url": null, "website_url": "https://infinity-dreams.vercel.app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485879986276226"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1374662971317842"}, {"status": "PUBLISHED", "id": "988454054286081"}, {"status": "CANCELLED", "id": "1597138025544452"}, {"status": "PUBLISHED", "id": "675051575206396"}, {"status": "PUBLISHED", "id": "957952872993616"}, {"status": "PUBLISHED", "id": "626087083250339"}, {"status": "PUBLISHED", "id": "560687143497621"}, {"status": "PUBLISHED", "id": "1452594755451016"}, {"status": "PUBLISHED", "id": "269835001257948"}, {"status": "PUBLISHED", "id": "69437257560
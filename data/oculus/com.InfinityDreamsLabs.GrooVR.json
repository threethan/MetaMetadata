_nc_sid=6e7a0a&_nc_ohc=Vy1-M5jufw0Q7kNvwFp7E5d&_nc_oc=Adrx7lXzjcXduHRUWZOVSJM9-OKoWHyrhxZOI7pgJ33nFyzkgEhfcHv0E2alqFrI7fo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMnA4oV5xA9-5xZjxvq2BXpAxSri-MqL73katCUHuBjA&oe=6AE0BBD3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lW_tQUOFtwQ7kNvwGt-ta1&_nc_oc=AdoFp1ffdxOUub--d8I9GAtNWZSc_g3m3UGZZPsminam9ZSUArldgz4xzFFagAUCAUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPziW-R1xTYe9eHXJUmV4_Zs4RuGUencUH3rbY6TyFNzA&oe=6AE0A1BD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCA_e-zY2b8Q7kNvwFZhfBN&_nc_oc=Adqtj4VEzRgafwgPk3iH89Z5IAUtxXCZY319VjZ0a78tuAErmTZlfpzXYCfeLiSC9_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJzPGgPs98m94FZf89QbqRWMouxj2no87BmiOJUL9wjw&oe=6AE0A758"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8akP_t14ZsQ7kNvwEJVeBs&_nc_oc=AdrRNAYX9zv9psMsTqkhRRCiC5PDDAHEQO75AMBNtQqPcDe3HezNTON-Q8JfPUCBX-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp0FiQJHoc1GqmRvYmXrrWReT6TTLhCbUF40beIsMEvQ&oe=6AE0B281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3qEOs3nLdEQ7kNvwG_My3m&_nc_oc=AdrnZYiXyaGRiOs2xeAHbdKTUYRPdaFT3fwwoLg2dIMsxVNzqhH9b39F86327uBBV4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDPLdEgVYjCewJg6i-oaDEZG3eWSJ2JqVOp6Jk4dM38Q&oe=6AE099D7"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
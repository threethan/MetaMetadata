_nc_sid=6e7a0a&_nc_ohc=mqQ7FV7yhvUQ7kNvwETIg4j&_nc_oc=Adp2OytLVP1Mo-NBq__CeMR1F_AELQOLwxw2cO2-UkGS5zuU70FphJfKc5d-1JKQ68M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjfLRlQ7sPYf9Mq9FPvJ7qCCwc-WVdQMC3S1C0A5Ccow&oe=6AEDEAD3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBQVzOA1XmsQ7kNvwFtllf-&_nc_oc=AdqIS-d62f3KuswcrrJfz9d7A4MxirNeKz0sUDYFbIibszcwxT3TnyodDL2S8VM7qGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr4GgRRc4BM6P92nCnVpuMX_auwGhBzg9tBrmCP_M9aA&oe=6AEE08FD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNqnZG9cbLoQ7kNvwG_ddwM&_nc_oc=AdonPIlRrwfBvSdaG9DgDRxrE-r6RQoW6WqzwFDvDE-pBuVmx6r_wCasa8kcnjVEdQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFGPOHe3jQf4V8G4PjDJeFWhTuKGGMGrrA1SdqyS-lPQ&oe=6AEDD658"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM5PrC7ftTgQ7kNvwFWHUc1&_nc_oc=Adpusu2E3GLdur680kQHCt6qs78-2riwdKckH8M2CjGPVhZKvvVk8NDo4c6OK78CsEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5dQ7NYhuofJ-ZaWbOVXRhnvwQXZnMQkPrVyXVVzcHiA&oe=6AEDE181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzVPYOfnlLoQ7kNvwFkAjqj&_nc_oc=AdqVFx_b5YiW-4yWFIF_1yBDDfGuF1EzkPwwoRrDOxKnV1TF_cNFMr1Xny922ddrKy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwBlFb25x1edZbEGcEyR6t_0gdTQub9gqypkBgnLJX_g&oe=6AEE0117"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
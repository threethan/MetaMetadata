_nc_sid=6e7a0a&_nc_ohc=JmAkm76SvbsQ7kNvwGOwS0w&_nc_oc=AdrsoFmT7Y96OKR92LBOu94hHi2_e5F5ugDyj30YdmGLlri4wpKu8tFt1VObbOoN9lM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbME1A0DolFiUl1mPvJopHTd_zCv2Ckbj2YGkRBAex_Q&oe=6AE8A4D3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6j60lAx9rAcQ7kNvwFbM8KH&_nc_oc=Adow9IwxkOtmzuIeFH4geKdQlpayYuo98NSILArJqxGkzoivFL5Hr4Ptilg4Sut7TWo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQywFF0tDeAk6XQyETVNEbSHNq8CMhhquxJpEwfeByRmA&oe=6AE8C2FD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=197SvRaKDBkQ7kNvwGwuHYY&_nc_oc=Adq_wO5VQx9DPLqVBCSWHJ-NiOXBKMyT8_twMHB_ZGiqr3Qvp5AqFELqVbJgOJ-YVKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQti1ILKWm4xrxEyQWyA2RNU96Thnsf5v-YArRASEFRWw&oe=6AE89058"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otWoEY3cDVMQ7kNvwGL7Pmc&_nc_oc=AdpkSGm8BtII69CYPg-CH5eqRQWp1DadgywJWQm74v1Y7-nyQGz2-5tJyaipeReUQMw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpBg7nVXumfWnoKKRvmPKBqOrcIDYBs5ddysBaHOy0fw&oe=6AE89B81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=navgFiwwAJsQ7kNvwF-OzXs&_nc_oc=Adqz0R1dO6gGZANguSgFDSfY9qQdSQvpPgvdOTbfPz6xEqFznIaE9ScKV6bHqGb6tEw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYWjM73W485JBvIs4Qs0fCKBYbSHMyyflynvE_CAGK-A&oe=6AE8BB17"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
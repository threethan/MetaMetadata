_nc_sid=6e7a0a&_nc_ohc=Vy1-M5jufw0Q7kNvwG_J71h&_nc_oc=AdrcjNS6TRSHe6jSspJ2C2BEyX1POjY_VRPcznOKWPh1b1Ma3o9pvKzeXKHDU9cho7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPROh7i0sfmNIrHu0NUYJFnMiqApIp0y5e0T-n3HLPY1Q&oe=6ADF6A53"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5YkhOUwsDQQ7kNvwEYuofj&_nc_oc=AdqvNTJJsJifsYgL5TW99vlT6yvNje1EMmqp8SVraZ2L17hwhwQdJ-UVnb0oWgYEJOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyKpnd45AEx4pQdKXiC8xrLkGRH7Twcu_mC14eRK7oOA&oe=6ADF503D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkpeE5gUUvwQ7kNvwEYe2Ml&_nc_oc=AdrEN6d0nRLLf4sKeQxfYCdskZdy8WJCFF2u2O8UGz9Kz9a4OBJyZi5Xd2OpoPyQ0TE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDhr6A1x_Z5sx3jdurRRS48pbID2Zgy994_iNacbUs9g&oe=6ADF55D8"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8akP_t14ZsQ7kNvwE_0F0n&_nc_oc=AdqnZWuhkPh34Wq0xYZk-4_lrUMF-9ftS3E5dxRZv_xO6ytRcf8HfT_qBe9WqqNIaiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk7nEdquzLFXiOcECERv-9ekBi7SR3FL2WyqCW6ofVPA&oe=6ADF6101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3qEOs3nLdEQ7kNvwEXdjA9&_nc_oc=AdrbMC8xWC0R6Nh824cYFk7hTIC8J_6yhEnM-aDH0NrkbNrY6WOneKOnMMIv-uhE0oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2CAHLifxlyZnUfWzztGnt5Qd6CmVAGuUJX2-Ur-GxyA&oe=6ADF4857"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
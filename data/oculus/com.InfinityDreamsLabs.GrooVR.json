_nc_sid=6e7a0a&_nc_ohc=or7NekVAzRYQ7kNvwFN4Fxi&_nc_oc=Adr42up2Z2rRRlsSfG754ojInQG4EY-zAivs0LjcjXBUKMQomGAc9FWdU6OkdCDR9c8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV53tuHdtFRYomSTOzt3D-7Ao6rPkOKwvQYEvbeDGEFA&oe=6AE601D3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvec7hRXaTcQ7kNvwG5-DPr&_nc_oc=AdqWaTW3MzWJ-k49ng5HnXJcITgWEYGHBJl8gE5zXzYwrENvxc0_cmo461rgqyvlq4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoIrf-633XSi3JgiFMR0suabcb7Q_BPJg4D4gRRx6rng&oe=6AE5E7BD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvf4shkuqzcQ7kNvwG2mIHp&_nc_oc=AdqS3K3TfxKgnYWB9QlRWRn_x3GLesi1KhuQwR_v1Ao37cV2dCOKXGe0BIR3npjkd9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5mU4hKXs0ZkXbA_im5NFFqT2vxEtSQ5UtHtAZAB6cwA&oe=6AE5ED58"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otWoEY3cDVMQ7kNvwH2KJTM&_nc_oc=AdpPBG897t1o3ZUb-F-IRwSnH0GJ2TJ2Ep_Sgm9oxe42yFKPa4bkj-Kgt5pepRrmWpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPktHQTaKHmRzz9skQREoxWyfPcRcXSs8FGicVZ5oMdg&oe=6AE5F881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vY4JDolMzgQ7kNvwGAYDG3&_nc_oc=AdoZKqhgIz2Jr8mPSJiFZugnRyuR8prAc_u3iQAvRYarsFgUro-PXX7_phl2UL8sqSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaFoBfGAULI6zvpJfoyEcxm4s2gRlC3e7701R_VBcLAw&oe=6AE5DFD7"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
_nc_sid=6e7a0a&_nc_ohc=Vy1-M5jufw0Q7kNvwGOSlGw&_nc_oc=Adr8WkqpjT2LENOwQ9tgzFwODmZqGlxPehwenJUya_pCgziruxOZ_rEhuvicRwrg0iI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPgE9wVRpy6_Xga0nISUqE2k1OR43JOHzg_CyNh9Bzzw&oe=6AE20D53"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lW_tQUOFtwQ7kNvwFlKkH2&_nc_oc=Ado--6t3y_Hnxwuv7uiS0kfm6ZCXg61wohUgWLyHbN4Ce_ZnGsT_ezpIzT7pne2c7pI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ0ALdgjuP4Iyz8vuLj7TfuzjjWJ891gUR-OO8FnCPpw&oe=6AE1F33D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCA_e-zY2b8Q7kNvwGsG-GK&_nc_oc=AdoEuSOkceXMw3k8KzPymCvucZH_ud82CmP1YVPEzjnodYPMESl_rQbDYBJbywl274Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5FcBimfa8bvSQ5z3UciYoAYIhUDMiVXdwif5VLsomVg&oe=6AE1F8D8"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvVU19gyyM0Q7kNvwHeUxg9&_nc_oc=Adpiz463vSPZWXQtrwmYVtYQ9hfv-OCQlbn6pHtw_b22HFDeOv7cMiMkrIExpUSI-I0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlgIKSxgiZHXw_Zqd3ANlp498dGYIoxoWGqWix9AQDCg&oe=6AE20401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3qEOs3nLdEQ7kNvwGBro-0&_nc_oc=Adrd_5g9FUCENw3ix_6DklNAvPXn1dkjaq_ZbtSRKc_mBA2f25mPeZkpap0cilMJDgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlvEZ20IEQ6SzRDHiq3wNpCYaOI7ykqLC_XSOf9qLxEg&oe=6AE1EB57"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
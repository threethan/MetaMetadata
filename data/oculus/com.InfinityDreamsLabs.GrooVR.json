_nc_sid=6e7a0a&_nc_ohc=bzSwPka0sD4Q7kNvwFSA06_&_nc_oc=AdpyQBXtapO6pEY-ZDP4wvPC8rwvc68c6DWRAjMYcEEY8KKNcr568GuJSdU_APHrWAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZLi3jtAGnatoEl5dOY16ZkvF2LwLtMe6BbJcRwRmhog&oe=6AEF3C53"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBQVzOA1XmsQ7kNvwE9c1SZ&_nc_oc=AdooQ8zwJNoUvf2R3m0bCOmgbC5iofr5gXfT_U-Sk-vsoodlINWl8ibi1PcpkNNkzs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuOTRM6BPChYuoC4s5VBoXZK_eGGreZi2DOnXZGiCPsQ&oe=6AEF5A7D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNqnZG9cbLoQ7kNvwEmzADh&_nc_oc=AdpxNt93Mo_LiP7C9alQJVi_cF53cbLIsPbycgnzEAp8W3sLTkwM_tQWEVJ15xreuPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZalDnH7cUnnImjOeQEy9bRRoLwLd5YN7pvmb407bD0w&oe=6AEF6018"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM5PrC7ftTgQ7kNvwGpGmqx&_nc_oc=AdptrPvHKebk7QBNmhlwwudgFth_dVo9TnAfG0kxlV2f6XigryZ-H1pkJNxu0iw73mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8BgKk4a9QSsypnvlFPRXJZOe_nAn1W95M8n6Ik8XM0g&oe=6AEF3301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZdvTWGmveoQ7kNvwHdvtJZ&_nc_oc=Adq4sTfS-YLdkP7zEsRWMnRavoauQsxr1syi6H4IjIRWrGiYh7WMADFlD3JYaAKZQkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-q9l44LEjE7XibRSqPz5xZeYrsqgF8k9bmNLDfRkCPA&oe=6AEF5297"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
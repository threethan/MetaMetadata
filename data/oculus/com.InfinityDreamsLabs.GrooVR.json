_nc_sid=6e7a0a&_nc_ohc=mqQ7FV7yhvUQ7kNvwF3sVzP&_nc_oc=AdrgwryMRAlm7M7JUo51a4Jl2P0n-hLZx7r-joHtRi98kGzHwh2WmZMRABPmLtnBovc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhf25ZOVI3lEUyHcY-VwfNVaP9-U7QkMGp3lBLgP8jfQ&oe=6AEB47D3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6j60lAx9rAcQ7kNvwHGjcNv&_nc_oc=AdohEhiyrXayPfU-07TfOJlzcBdLt-mvAn9b1aTbXKVpPBDNqLas9mCackQqgm3E-U0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw1nk6gSfrFmv8ACfDsUhUj7_Y91RhdT2W_qLLebgvvg&oe=6AEB2DBD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=197SvRaKDBkQ7kNvwGKsq0K&_nc_oc=AdqlVdMRV4f6pxC5UuVpcPoZ_KqXoYZQF-4hiO28k7oMb3Z7484s9Na3SOd_n8rFOGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7ScE_fxS9dQXw-wl0fbIDrlrQFBboO-ZUj9Gl4KsOgg&oe=6AEB3358"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyOfTRFQEHEQ7kNvwHmNTGG&_nc_oc=Adqy3sr_u3ZUnOaobyj0jOvgYN1D_k8tjGIrcIshZrzKlOIT_00F5NCgDtGfs3jwyFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN1h-kfuxsDdSZLNXQar6Oia3PGSrYZZEn4dEa2IWvjg&oe=6AEB3E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzVPYOfnlLoQ7kNvwEyaHOo&_nc_oc=AdqgI5GPQWmdsNYCzZTs-j1EO1Ro3JSCwv44IkSG3nTXSuFFzSsLx1CZo2vTX1qRFq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD4baUiW9VyhprFRBPLdSbyG7yzzfX1_bZkdvm4yzuIw&oe=6AEB5E17"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
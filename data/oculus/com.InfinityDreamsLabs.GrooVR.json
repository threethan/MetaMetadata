_nc_sid=6e7a0a&_nc_ohc=IUUhbcsZjC0Q7kNvwERbtTO&_nc_oc=AdqYV7fNYmwPHhm1jggqxpezRFhUhl8MTKFDB9r03X40qOdiRbSH5YXlKTNrZBlTjKE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEq4Hw31GjOk_iFdw9NsDGpABNw_iqmUnthBP-oCkXiA&oe=6AD38CD3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiO2kBNaqHsQ7kNvwEOZv6U&_nc_oc=Adr0trIhLpZalQBvVRmkrT4cD0CV1s5ZF4k3LBBzdqnpChAQT65Wu7JQmkMMDDGWoco&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb6S-e7g8Ikhydv1dwFJvY9O4cFKk1XfCx4RHIUGFwBQ&oe=6AD3AAFD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO_QUCb3wtEQ7kNvwHxqJU5&_nc_oc=AdpfVvLG2yLrC3033PFjeH2TwG82LEwtOxkjyLijwZhikyrh4lGi_wjwie8aADZkfUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNAtbi6xqni2voZyEScP5uTsFrC31p2XEFW1oTNwNh3g&oe=6AD3B098"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdu8k8dQDSwQ7kNvwHokqrr&_nc_oc=AdoLeOkchLGCiQs-fQwKNOBZKccdJr62eOcjQCEvdDz0TXui8UryuTaIvziLdRnCfaA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPpKMokUN5-VMdZVTTkHSYs7QDou8Piwem_ghbEOdWeQ&oe=6AD3BBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB7mTfGYKGYQ7kNvwFH2oua&_nc_oc=Adrbiv249Cu310bA0l8DHdcHFG4CcDEKerFuLBh-C6WAUKFIsEM8svLmtI1l3d8SbgA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbSN10-V80_CQwShsdwKKYmgOgAtw9OjONjYhvm8ssMA&oe=6AD3A317"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
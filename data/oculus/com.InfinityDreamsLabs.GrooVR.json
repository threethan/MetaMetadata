_nc_sid=6e7a0a&_nc_ohc=bzSwPka0sD4Q7kNvwEYURH3&_nc_oc=AdpA6RRqQZ13VGzgsqdiu5iquHG8dq-aQ2nOSxXcLa18FJ8dOh2kHg0phy77sqHJvjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT88i1Qbf0msz1sfNpdXuQkcjVjI82yn1gbTbTvEccw6A&oe=6AF08DD3"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6hzwy9HrYwQ7kNvwGf-GkH&_nc_oc=AdqoQydORLEkM0o3CNXfSGwCTDNlR_V6_8MuEhc4RKMdCjGJiwu06TZ8tbMik7RWeu4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX373b2dh4VIHnw4uVLXhgoi0WpvGdwpeOF0EujRsBaQ&oe=6AF0ABFD"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYnNJVcaOKUQ7kNvwEN_Bdi&_nc_oc=AdoUj9XzCdFmlmCD-UvTfCMF6bkGPWU5YpMoY7ty6ji0j6tofinMVPx_3SN0XKzTSNk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6g2MC5fsiWXlcAt8iF2ZScTYu816yZqPGQeKXijwCgw&oe=6AF0B198"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPZv4qFiVhsQ7kNvwGVp6GL&_nc_oc=AdrkTebaH3GnUye7AM73tN-QVTEYnkt_73oiXFe7Q5rvQIN2ohAUP9JKYi5XEg7jLRw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcLIsTlVzOICGoqPdarLDw1RoUMt5yGCYWr_iFNx9I0w&oe=6AF08481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZdvTWGmveoQ7kNvwHH_loM&_nc_oc=Adp8767JZxT2JzHnwznkHgrNKYnn9Y83yzw0LTCzEZveVtfolQa_DzYbhDTp4aVg2RI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Dua32oEh2hf1lSP9whci6whhDO6oKVa4sifw5Gga-g&oe=6AF0A417"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
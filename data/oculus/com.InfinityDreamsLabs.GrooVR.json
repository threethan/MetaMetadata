_nc_sid=6e7a0a&_nc_ohc=JmAkm76SvbsQ7kNvwElDo0V&_nc_oc=AdoGhdfdsEuAZh4n6MYbVGp_FBdg4WGpW3w_RQ4-HMb9DfJeCGHW5EdzQpP6jYT677U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAOsK9mmwVwXcW4ekmW4jQtelyPzC-_ZlkkYYnXHkqVg&oe=6AE9F653"}, {"file_name": "1.png", "id": "1603676654571055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1603676657904388_239852431079812665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6j60lAx9rAcQ7kNvwEYPgHH&_nc_oc=AdojjMyoxhghPGHFJiiOBu7tsJSJ3710VxTo3S-MZOhy8_OYR80QxXx885JuHyKx3To&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWIoYQkQ9wjj3shFJE50a4B6GwQqdu6K3qnbxqVlHyRw&oe=6AE9DC3D"}, {"file_name": "2.png", "id": "1802084520825355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1802084524158688_7234562000264903961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=197SvRaKDBkQ7kNvwGH_J3H&_nc_oc=AdqYINQzUoNxG3sKeGUafBBygt2xU9jAu6r7WqgLZX0vJ7zWbDG4cAI8R6mNlZyvA1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Hf9s18jEnTN-Wl0lvbHAJP_mN08-qRRL2XTdx1CE3A&oe=6AE9E1D8"}, {"file_name": "5.png", "id": "2371873136552800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_2371873139886133_1249301193130667489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyOfTRFQEHEQ7kNvwFKjyyf&_nc_oc=AdrDyu2ujwR5weZbYluy-P4cZroTpVyquspxRjJie98ISExYvfk-IA7TXMy53dWLZq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKCxTgnCN0M1B3bHNA5YL-iREFZoZ3TAsTbHKmNisJBQ&oe=6AE9ED01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt - Landscape.png", "id": "1061575105192761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572937_1061575108526094_3091268314292878287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=navgFiwwAJsQ7kNvwHC3OAA&_nc_oc=AdpFypBQf6wENOCUMyeM0QkFAxNdz0DPbiLvuE5GDQVjEeMFNSJYAlYZTWmv6g30D6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1577w_rFhxcNRJgFNBH3eXeFEGuRFNIv7l9nWk5XdOw&oe=6AEA0C97"}, "display_name": "GrooVR: Air Drumming", "keywords": [], "long_description": "Unleash your inner musician with GrooVR: Air Drumming, a virtual reality rhythm game built around expressive, physical drumming.\n\nPlay 17 songs included with the game, then expand your library with additional albums available as downloadable content. Choose Solo, Practice, Campaign, or Tutorial and progress from beginner-friendly 4/4 lessons to Expert charts.\n\nFeel every strike with force-responsive drum volume and haptics. Customize your drum kit and stick angle, balance music, drums, and cymbals independently, and use Practice controls to slow songs down or repeat difficult sections. BPM, measure, combo, and achievement feedback help you read patterns and improve.\n\nPerform across Sunset City, Hurricane Station, Memory Alley, and Basement, or bring the kit into your own space with Real World mixed reality.\n\nWhether you are learning your first groove or chasing leaderboard scores, GrooVR gives you a flexible, energetic way to drum in VR.", "short_description": "Unleash your inner musician in GrooVR, a VR drumming game with 17 songs included and additional albums available as DLC. Customize your kit and sticks, choose your difficulty, train in Practice and Tutorial, or perform in Solo and Campaign across virtual and mixed reality stages."}]}, "developer_name": "Coradini Design", "developer_privacy_policy_url": "https://groovr.com.br/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Coradini Design", "support_website_url": null, "website_url": "http://groovr.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "i
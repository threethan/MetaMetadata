": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984467_516535342898049_301673776289574558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWsD7CGTHY4Q7kNvwH8NDAC&_nc_oc=Adrr4os5HQVqzZ7sTbq-5ZUmEV4y34YIzS3TzXjFQngtNOBu67cx-EhdbZvlLCn_Juc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiOdXsHLDAz72xKBavMunRp46K8yO9k4UoR-F0yc1TBQ&oe=6A85A10A"}, {"file_name": "Screenshots 4.png", "id": "2610125395960217", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974767_2610125399293550_4239908028570259345_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG1UnoS6XpQQ7kNvwH27qG-&_nc_oc=AdoC01NLvafbgxeyhpUDVb5QQxY-QqdboUTM6G8V73Olp_JLh-qffc3ARrctpEsCuYg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWf1Be0wxwinjn2eDWnkuJoOfkVt3Ot9wHVEEPsOmTlQ&oe=6A8596E5"}, {"file_name": "Screenshots 2.png", "id": "4249367498460560", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982445_4249367501793893_2946959581537283578_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbkP2ydivsQQ7kNvwFbKjzB&_nc_oc=AdrPFz9dqjYVkstg1vF3CoYfwNktbW8ej0jzFqesYtEI1C_TxvwTrJ0v-zMEIMiShWc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiyOPeZ6gecyAa0HMYdGpSHGpKhXlKtxTcnd4fBOLHXw&oe=6A857ED6"}, {"file_name": "Screenshots 1.png", "id": "1029347187868523", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974649_1029347191201856_1702021506251304605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAX_JwKfIF0Q7kNvwECV8ni&_nc_oc=AdrKpgffZvJ4zZjaCwfp_iOMxA_oQyFBkTE-GN2OVVTkVGDyLvcuWu8H5pA3K5fIFEE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3zO1WPm-CModjB0d6L6l_7YFOJhob7i7EaJ3GIQMK2Q&oe=6A858709"}, {"file_name": "Screenshots 5.png", "id": "546937099673884", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984471_546937103007217_311446915470168227_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPIHrYigH8cQ7kNvwEnPUmq&_nc_oc=Adr_-rrFDt8kTz2zOO2IVWt98effT0CpxEY88F2HsqdQG7DFHbY1lZLLiOd_MVfzY6k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIB_8L7Tz3wPJLML8b7IyWAoMKF1lASJGvHvDuWRv1PA&oe=6A85A2E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GrooVR - Air Drumming (Demo)", "keywords": [], "long_description": "GrooVR is a unique VR rhythm game where your goal is to hit the beats (represented by small plates) as they are coming at the parts of the drum. \n\nEvery beat indicates which stick you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. \n\nOur goal is to make players learn how to play drums.\n\nEach hit is strongly supported by playing the sound of the drum of the song and visual effects to emphasize the rhythm.\n", "short_description": "GrooVR is a unique VR rhythm game where your goal is to hit the beats (represented by small plates) as they are coming at the parts of the drum. \n\nEvery beat indicates which stick you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. \n\nOur goal is to make players learn how to play drums.\n\nEach hit is strongly supported by playing the sound of the drum of the song and visual effects to emphasize the rhythm.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinity-dreams.vercel.app/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Infinity Dreams Labs", "support_website_url": null, "website_url": "https://infinity-dreams.vercel.app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
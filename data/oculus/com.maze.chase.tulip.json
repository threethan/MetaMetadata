Qa2odNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09u9S1WHvmf9WQimZaM-8SI0jsbFf_tOHSABc_QoBvCg&oe=69F497A8"}, {"file_name": "1.png", "id": "1716570442462877", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630190_1716570445796210_2795259132919415138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_Uok-bj0GkQ7kNvwEdWO3S&_nc_oc=AdrrXpNKXvAco0_4eS-RYc2yf7CGbondEJSbmVH3xdfoTy-vzKZss35AzQ_0WLcIFCA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uGfhEQMuLbvSe1MXVpiW4zOx0rnUlr_HreO_t6959GA&oe=69F4968F"}, {"file_name": "2.png", "id": "989386773199679", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/43997708_989386776533012_2421143110191010987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYOmVJvATeMQ7kNvwFB2cwu&_nc_oc=Adq785Wn3WE-eRbor636Xdy_8QqPRMzqQuG8odmS8Lw6301cAIqXaz6SOw1P3G-SN8o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lo73Ki7RIfimo1dDOtjkTilhgkuOtqE7BxsPmeXS_Tg&oe=69F4B50D"}, {"file_name": "5.png", "id": "1073288160354193", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974465_1073288163687526_7977361456438608329_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIG6-Nb0xXQQ7kNvwESLSts&_nc_oc=Adom_bcFVv-BstsflRvMN6HwV6dh9pDku7Wsi0tMPvjBsyom5uAFIT5o-Wg-wCyCWqQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xFCa1xGb5t35gkmWC8Vdz5H9DbDhdvFbxgX3H5R4hcg&oe=69F4C3CE"}, {"file_name": "4.png", "id": "995016182382727", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001728_995016185716060_4927435051730892228_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa-QD9YMfFoQ7kNvwGg1Ugr&_nc_oc=Adq5OvTPZCBlX5EEDNYUDkD8gNP6vZtTg7FPIWCb70eZuzVHr7GP8MEpJKCpAyEIyw0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34mfBJvI1WDGcNY21FzCzCM6zKuWQTYCOnCoh_WaBNAg&oe=69F4C0E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maze Chase - Running & Walking Game", "keywords": ["MazeGame", "Maze", "Adventure", "Challenging", "Running"], "long_description": "Maze Chase Game takes players on an exciting journey through a wide variety of immersive environments as they navigate their way through increasingly complex mazes. This single-player game is all about speed and strategy, challenging you to solve intricate mazes before time runs out.\n\nEach level offers a different themed environment, from lush forests filled with twisting paths and towering trees, to the icy challenges of snow-covered mazes, where slippery routes test your precision. The desert mazes add a layer of difficulty with endless dunes and deceptive mirages, while the rain-soaked environments introduce wet, muddy pathways that slow you down, forcing you to think on your feet.\n\nAs you progress through the game, each maze becomes more difficult, introducing dead-ends, hidden passages, and time limits that keep you on edge. Players must focus on finding the most efficient routes while managing the clock, with the ultimate goal of beating their best times and unlocking new levels.\n\nWith Maze Chase, it\u2019s not just about solving the puzzle\u2014it\u2019s about embracing the thrill of the chase in dynamic, ever-changing environments.", "short_description": "Maze Chase is a running game where players must navigate through a series of mazes set in various challenging environments like forests, snowfields, deserts, and rain-soaked landscapes. Race against time to find the exit while avoiding dead ends and tricky obstacles. With each level, the mazes become more complex and exciting game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
file_name": "5.png", "id": "1073288160354193", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974465_1073288163687526_7977361456438608329_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kylwrCywHAQ7kNvwG1kbxL&_nc_oc=AdoqFIFjpKzVW-wb1_pC5el2XkKLuRNd7gqdk6HipL5-YdtmvSFNCMB6zPUeHKP_Vjo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSrnjgkvBMS9b9HhCk1pVyGP6c448pZBZUWg4Ou3Q_-g&oe=6AE3634E"}, {"file_name": "4.png", "id": "995016182382727", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001728_995016185716060_4927435051730892228_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6daZy2rlBAEQ7kNvwG-GpAQ&_nc_oc=AdoA6ozxKyTR6x0AW_Q1a2afffuXGtlFI-vFPohKmuASbqgNyu3mL2iq9SxFHRWWpPM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe6gF2_sF4h_2uTOU1cAm8uPa2_I_R338zmclwLFl0wQ&oe=6AE36066"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maze Chase - Running & Walking Game", "keywords": ["MazeGame", "Maze", "Adventure", "Challenging", "Running"], "long_description": "Maze Chase Game takes players on an exciting journey through a wide variety of immersive environments as they navigate their way through increasingly complex mazes. This single-player game is all about speed and strategy, challenging you to solve intricate mazes before time runs out.\n\nEach level offers a different themed environment, from lush forests filled with twisting paths and towering trees, to the icy challenges of snow-covered mazes, where slippery routes test your precision. The desert mazes add a layer of difficulty with endless dunes and deceptive mirages, while the rain-soaked environments introduce wet, muddy pathways that slow you down, forcing you to think on your feet.\n\nAs you progress through the game, each maze becomes more difficult, introducing dead-ends, hidden passages, and time limits that keep you on edge. Players must focus on finding the most efficient routes while managing the clock, with the ultimate goal of beating their best times and unlocking new levels.\n\nWith Maze Chase, it\u2019s not just about solving the puzzle\u2014it\u2019s about embracing the thrill of the chase in dynamic, ever-changing environments.", "short_description": "Maze Chase is a running game where players must navigate through a series of mazes set in various challenging environments like forests, snowfields, deserts, and rain-soaked landscapes. Race against time to find the exit while avoiding dead ends and tricky obstacles. With each level, the mazes become more complex and exciting game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8483847758328778"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974527_735161445466605_1998531603247620489_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjTycR7DNIEQ7kNvwGs_hyR&_nc_oc=Adrgl0KOOxCkp3XmI40KFoe6XCYlnVkuBV99p8EAWlVxPj-d-ZtrlVYGEsrG7cXBeKw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZOJuo97Yg1OpKL6z2tO9ZzvywOvLRB1DZ38j-6wPsSg&oe=6AE34503"}, 
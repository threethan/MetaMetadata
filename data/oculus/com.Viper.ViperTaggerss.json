_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci0oVF6JHu0Q7kNvwFxZWDn&_nc_oc=AdoCO9cjV35CVADVHwxnGc8Dr-fhMrLiWSXnlniKe9XiTxUMyn9-3-NYvLzmKHY522A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbYdtTjEb8uJlw6msdQbComi3ma8gn-36-Jw0-fZ6GwQ&oe=6A8D78B3"}, {"file_name": "ss3.png", "id": "1242975570848549", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623384_1242975574181882_587156997281512971_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YatLt-YBJ9gQ7kNvwGuucDk&_nc_oc=Adqt2QBweqljBlbDjTabXibbtQAiJ6dk2Q21KTmYF0iE6wQaR3vIXen41ZB3ysV-DzQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6AxilxD0ppmHJfM6HbPQ5x2uzsx_NsXop7fcr2LbZaA&oe=6A8D8A85"}, {"file_name": "ss5.png", "id": "2195500034249272", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822817_2195500037582605_6292304862913688686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvlsLsRJqqQQ7kNvwE4dud_&_nc_oc=Adr6LvpFojr6Nkxgmyjai43AWAvmYJLy_AAQxwsyTOOvd_zeKZ1synoaEV2s636wxgo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKvrjxjSIaXCe_HUgRdKQFW3mqK5SYigwZJ7JNACmYoQ&oe=6A8D7CE8"}, {"file_name": "ss4.png", "id": "807821672108142", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823893_807821675441475_2287887798923175931_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20VXFw9xyxYQ7kNvwGdt9Hw&_nc_oc=AdrhbPglu2blFwbPJHNK4JOpszZaty-owqGCPoKbt8ZyI77l26lq22hagN_M9NeO_M0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdxws36HzguPf5wR5OPlJ3_R41HNQ6YArYIILcTgVf6g&oe=6A8D7E6D"}, {"file_name": "2560x1440 (2).png", "id": "807837258515267", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499311611_807837261848600_3478855420754324649_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEnvWR0pYHAQ7kNvwECNVpv&_nc_oc=AdqPBXh2LcfyY5XBo_YhxDC9bZFOtvN3yTgSTupM5Bj1jqBhyoCXIzqMGxusoYmfP4k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjHifBs5qrc-qx92XtkdROdRrnJmloO4VsiBZ1CgltJg&oe=6A8D8A1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ViperTaggerss", "keywords": [], "long_description": "Viper Taggerss is an adrenaline-fueled multiplayer tag experience that puts your reflexes and strategy to the test. Step into fast-paced arenas where the goal is simple\u2014don\u2019t get tagged! But in the world of Viper Taggerss, nothing stays simple for long.\n\nRun, jump, climb, and dodge your way through chaotic matches where every second counts. Whether you\u2019re the hunter striking with viper-like speed or the runner desperately trying to escape, the tension never lets up. Quick thinking and sharp movement are the keys to survival.\n\nWith smooth controls, dynamic arenas, and an energetic community, Viper Taggerss delivers endless replayability. Will you outsmart your friends and prove yourself as the ultimate tagger, or will you get caught slipping?\n\nGet ready to move fast, play hard, and strike like a viper.", "short_description": "Viper Taggerss is a fast-paced multiplayer VR experience where players tag, dodge, and outmaneuver opponents in dynamic arenas. Use speed, strategy, and precision to become the ultimate Viper in this action-packed virtual playground."}]}, "developer_name": "ViperTags", "developer_privacy_policy_url": "https://sites.google.com/view/vipertaggers/home", "developer_terms_of_service_url": null, "publisher_name": "ViperTagStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/vipertaggerss/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
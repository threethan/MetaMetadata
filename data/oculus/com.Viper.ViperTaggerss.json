B1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ViperTaggerss", "keywords": [], "long_description": "Viper Taggerss is an adrenaline-fueled multiplayer tag experience that puts your reflexes and strategy to the test. Step into fast-paced arenas where the goal is simple\u2014don\u2019t get tagged! But in the world of Viper Taggerss, nothing stays simple for long.\n\nRun, jump, climb, and dodge your way through chaotic matches where every second counts. Whether you\u2019re the hunter striking with viper-like speed or the runner desperately trying to escape, the tension never lets up. Quick thinking and sharp movement are the keys to survival.\n\nWith smooth controls, dynamic arenas, and an energetic community, Viper Taggerss delivers endless replayability. Will you outsmart your friends and prove yourself as the ultimate tagger, or will you get caught slipping?\n\nGet ready to move fast, play hard, and strike like a viper.", "short_description": "Viper Taggerss is a fast-paced multiplayer VR experience where players tag, dodge, and outmaneuver opponents in dynamic arenas. Use speed, strategy, and precision to become the ultimate Viper in this action-packed virtual playground."}]}, "developer_name": "ViperTags", "developer_privacy_policy_url": "https://sites.google.com/view/vipertaggers/home", "developer_terms_of_service_url": null, "publisher_name": "ViperTagStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/vipertaggerss/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
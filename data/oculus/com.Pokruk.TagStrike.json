5/38982672_840206204604820_8416682217873643039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4D3Zgqbs5sQ7kNvwE2W03I&_nc_oc=AdkXNIWPEA6Q5u-iIMc7Njs3Tp9tV3as9Xdc7G36fDeBwhaCeIoUr0Pjn1-SdJHpOYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsr9EI-VoxQy3FQeExu-s-v2ChhMbHFJX78mD0jh-vLpg&oe=699AEB7C"}, {"file_name": "SampleScene_1140p_07.10.2024_03-04-05.png", "id": "1071094230877614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75241696_1071094234210947_6179605932710018871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcgC9FYxSMUQ7kNvwHB1AtT&_nc_oc=AdnD0kCxwmix9rQOJHLnPYqEhTqJxjSaCfz7vAKbgmYFHUFnQ_98lRrYvcrSfzlPYXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuiM1xjltcY1AF8eOLQLcQXV8wfL08cl8Arxg6LvnUmmg&oe=699B14AE"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G53BgSbGLZoQ7kNvwF6-kZP&_nc_oc=AdkH9YihpoYVnU9RArLkNpUKuq6CdTtOmGMqQ-zGAjvEzdEWOBo06P-a3QcjWsPR8sM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuostVOFIPBY2lGR1o0J2916v0_3AFws-86RhtGpujecA&oe=699AF3C3"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucHboPhEw6gQ7kNvwHHbAsW&_nc_oc=Adn4yKQ1aQX0eoCqBymaNRg2fGCXLwmzyAHfBPWavfLsuTYCv_g0sMfuXkhx_-GcY38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu1oxIbD4C8IiIgvsfkq9hUsMDCt3dOBxAPpYid0_-mig&oe=699B0D48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.io/pragmate/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
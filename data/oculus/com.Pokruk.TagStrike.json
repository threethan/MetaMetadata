_sid=6e7a0a&_nc_ohc=VZb3kEaJZ_UQ7kNvwEMJsfY&_nc_oc=AdmV880Je9FBGoqCNZ_Vjb1_vmmDfk_3u4js2UTsXKQRLkJvD3ArH0thtIlu4j_5jmk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft1yqLIAeLOpzGhZJDGAaStIujqdZ3I_hF5oc-r2vxXVw&oe=69A1AC2E"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b4JhfgMI6QQ7kNvwFpQkFx&_nc_oc=Adkg7fDdwh1-VineTQqc4iZy3sbQq6MQX7VZo2zfsgDC4FD-H9s8GYGzDD5ARwkY6ZM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvkllnv7AbTBKEkoS-BjQkImGKAoj8_U5G7WUAzkvoBMw&oe=69A18B43"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ__03LHzmUQ7kNvwF-acHZ&_nc_oc=AdlS787pqGiBXbJ3UApGb4Iz0Dit2KvD0uNMvfzUy_ngeduLGp2d_odyVXNmQx54Y3s&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afv91mTpfVpdKn9ZqkrUUskN1UG64W4WVuL_YlKysXgvqQ&oe=69A1A4C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.io/pragmate/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8444607972286431"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "8571934192873229"}]}, "baseline_offer": {"id": "8571934192873229"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732482000, "status": "PUBLISHED", "id": "8571934192873229"}]}, "liveChannel": {"nodes": [{"
5/38982672_840206204604820_8416682217873643039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4D3Zgqbs5sQ7kNvwHQs9rM&_nc_oc=Adl2719a-ZB16wkwU04b6UfThZq22y9rIG2JN_9fXkR3Eei2WUH-f8bNddZWYDSrdaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvb2PYPKd4rxpo_DenmGbZ6iYHFkZ7gCyr5cF1Dt17jyw&oe=699999FC"}, {"file_name": "SampleScene_1140p_07.10.2024_03-04-05.png", "id": "1071094230877614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241696_1071094234210947_6179605932710018871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcgC9FYxSMUQ7kNvwEl-wvK&_nc_oc=Adl7Jxgzikb8dR3WRVao9MEcWoIryC9knuC228w01A4GGJNEvhIoXPcWuW8hjI0r868&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslRhv6JD23Oz-AzMYucjfMK_ROf26M0CvPgdnVNt73ag&oe=6999C32E"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1TuAIHeFf4Q7kNvwEmPZxF&_nc_oc=AdmDdv2TOpFKvTpVvILdB0LmS_B0HazjuJAL9nm4KDVzyDwEAm3XkEdElNRdbuWY7EE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswTTxEEtdzreRxIGoHCq81jjBUN9sNiL0COH3xDqt8mA&oe=6999A243"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5jVkUKyP2UQ7kNvwGBNjfu&_nc_oc=AdmuoaAkhtwkLKgmLJMHhsmxLkgCnZXguBacsMdqEwYPEs_a8sezb6wBPimjlkvdVtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1wDAjPkr-GrJAwKwYeirV5uFqJonjkt3F5I2g7zMvbw&oe=6999BBC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.io/pragmate/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
06201271487", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982672_840206204604820_8416682217873643039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHJuuGtLKN8Q7kNvwHWGztR&_nc_oc=Adl2BLu0SFQ9CfXPxkpt1Q2nm-YPQf7YoF-zqFRE-g1ZTZFgtnSq2XON2krrgdKE5UY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZnQWkzE6TBJ8o1yqEYLGXvjgHAX3ILkPWz_vhNAQqlA&oe=69B3F7FC"}, {"file_name": "SampleScene_1140p_07.10.2024_03-04-05.png", "id": "1071094230877614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75241696_1071094234210947_6179605932710018871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl6HB5hR8wkQ7kNvwF5ijcq&_nc_oc=AdnD8iYxe645mZY7uCwOnXZ39M0U3rgH30zVeuYzVmA567P-H40XkprnjxQQri3WxIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzm-UtReuoQMZWwjR2DcqXNKWBvvYFFlo-oKH53CC6Ogg&oe=69B4212E"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XQXC6Qwae0Q7kNvwEwV8CH&_nc_oc=Adk7Ns2D-6VPdfiTIOusD_DCwi2nH88_4c0v4DsYKT1CKOepKWiat7cbf6GJ3j3LMm4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydLC6ODtdU4qHqsY1AdGCJEZtadYM02DCXYT2oPOHcVQ&oe=69B40043"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFnnVgnCW70Q7kNvwHF_Jxz&_nc_oc=Adn23b3Yw1q4-asVVJx46oyPeDhipLxep6l8bP8w676cNAm5uzUpGgqQhDnq5KTgPbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhPwUra-4LIRKQzxIwphHadTI-kDpmyGJjXfgi7ku9Cg&oe=69B419C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.io/pragmate/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", 
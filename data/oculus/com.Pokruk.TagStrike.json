yGdude5WuBPpKdaC4DSR98P9Fbl0lp2kduBQGz6A-nME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsinehKfMaCpeWs6xpQv6Qe7npPnD269Ieh13JYDvigQ&oe=6B09A715"}, {"file_name": "SampleScene_1140p_07.10.2024_02-06-50.png", "id": "840206201271487", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982672_840206204604820_8416682217873643039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAoitWhpS10Q7kNvwG_2RNL&_nc_oc=AdoXsdLf23Xd21a4ixdPvtPnLSVxfc7lH9kb_lIrg_n6cwXNwbHyvcBPze6KgKWIn48&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1vhlhFe4WCkGJ1qmciHjPaX7nQIjnPeThH5nzw-UvCg&oe=6B09A4BC"}, {"file_name": "SampleScene_1140p_07.10.2024_03-04-05.png", "id": "1071094230877614", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75241696_1071094234210947_6179605932710018871_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgFUPknfaSAQ7kNvwGsKbpu&_nc_oc=Adq97bMuc8lWRswPO2jzAeaZ7Z1kkFMnqsNesUw-SMqpGEwaNLZAErZ8hGONUC_jBHo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe8uRZ606L92_11aS6yS5cRwgHhHpw52L6mGkx1rwlhg&oe=6B09CDEE"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaXUmSOnPBYQ7kNvwGVJoIl&_nc_oc=AdrCChUVMY5KofuXXha5eOcAtez-bl1NX7s5XX4W5bchSP2gL50RlyQe7tzWSNkoRZA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDtpqxCrD2FcXft7_k3iJcvHS56HaT2gRceMsKSNL5Sw&oe=6B09AD03"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBLUgo-AHCUQ7kNvwEOgCY4&_nc_oc=AdqjWEVpN-cstmD_qICGW_OTpoDGHeOUoW-bC404B_tCCNzdNeaBkeFlMm374RjpgoA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzS6OoXsNVX6VlTNw6fbSzSdvdaIcaCscj2nQrvciMdw&oe=6B09C688"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.
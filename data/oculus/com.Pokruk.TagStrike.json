OHFCwYYCmR-zutJh6oBYsRSRbg8_pOYG6iEQMJck0Sts&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTorDaxTHGCFSD36wlxvdmi63ka9i8TOorARXhHk-ebOQ&oe=6AFB2695"}, {"file_name": "SampleScene_1140p_07.10.2024_02-06-50.png", "id": "840206201271487", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982672_840206204604820_8416682217873643039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQuL1DDmOAMQ7kNvwFroabo&_nc_oc=AdroOcEiJ8baBytBsDiwiCu2iJagqvbPs7GcJOEH3uTHeh1YhqWY5iD6yMz5xFrnt9g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_He7qfXri3qGBCr2U9cvrw-C5aQItDKIZN4SVxn-_fg&oe=6AFB243C"}, {"file_name": "SampleScene_1140p_07.10.2024_03-04-05.png", "id": "1071094230877614", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75241696_1071094234210947_6179605932710018871_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3uvVFid1sgQ7kNvwGE0gym&_nc_oc=AdouEQRmx8WfrsaKkJt4UD6xQUeFmDwNWu2st0XDkfO5iNdSTusSJ61ldG6upMgcEW8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQMBukA46dM25IWv-dz2txoBpQ8V3d0LqHq-ulEdOVZw&oe=6AFB4D6E"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KavRFPvW078Q7kNvwEbrJXG&_nc_oc=Adp5qunN6J5yYr0LFPIx9XKNYCIJO1yzbEERJJZw1CgLIwYBfgzUsuwk1VNisXx2ey0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqKac511pQvIvLc4B6mlZ729DIs_gvcCtSMqp3BT26zA&oe=6AFB2C83"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yq7voC5EekQ7kNvwFfyDMV&_nc_oc=AdofI_MEo7xZF-j9ocGIa47buMQWzUQgf1G8nK7IqNRVRJVp8k2bjEBc_I52rtiQgY4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvvGOzZnrhL4VMbhqj--XWR-V9PQ3BCDcQjO0_I9It-A&oe=6AFB4608"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.
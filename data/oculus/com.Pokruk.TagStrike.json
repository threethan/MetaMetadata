10.2024_02-06-50.png", "id": "840206201271487", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982672_840206204604820_8416682217873643039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vljmCPa5v8MQ7kNvwG7ZcFw&_nc_oc=AdpnUf5h-H1XZtYrf1nnqj9_pgXiEgc6VTIBceygfNcYXQfF99hnmOlPXqoSRIScCDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS8UTBkSTqMvlDT-ry-UDDWJPKJm45xc3MKGKKStAxqQ&oe=6A5B667C"}, {"file_name": "SampleScene_1140p_07.10.2024_03-04-05.png", "id": "1071094230877614", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241696_1071094234210947_6179605932710018871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYpNBGNsdCkQ7kNvwGySZEC&_nc_oc=AdoAyAvKgRJhQP7euNYg_HrPqiSHJWldNwzdsCmS9S2g85NbYTS1PO0t7-JcOWjCCNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZqd058_TiwnsAwxEOdmOC2E8ovv6ETvCbOOxZrySNzg&oe=6A5B8FAE"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYNj9DMMbEEQ7kNvwGm3DG2&_nc_oc=Adoo9WRlmL6IeFQRb1y_Zuc-Pofypam2-kIViFc_GhlciGq1sJ4T-3HM6RF3ZRUtvEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh73wcuiGI13waW6Il1PpxCrZqoFVpJnIqcvV3VP5cLA&oe=6A5B6EC3"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd594oNvrcEQ7kNvwGs5y4T&_nc_oc=AdrK5XzhIIOaE9VY_M00-kBE6eUfu92M58tw55XjGhWN4i1e3or5Q-x2Or8bPvIpBC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIWnz4Xc6DiaxDkk4MNGPEoNh6XbltEFIvq47ClbIdcQ&oe=6A5B8848"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.io/pragmate/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
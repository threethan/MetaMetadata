I7EW5oi8ueQVMP4xFdVeKlLAJcQJwhcJLDj9rcwrjxB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6N1BglLAOsax-feSK2vpAHCRqc8jyD4IxwLV6stDPYQ&oe=6B0EED15"}, {"file_name": "SampleScene_1140p_07.10.2024_02-06-50.png", "id": "840206201271487", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_840206204604820_8416682217873643039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Xu-PugtbkoQ7kNvwEETvV9&_nc_oc=AdqXlJUxulCnXcjH4sIb9sbxEq-cPFjU7YdA2vAJTnNYFcJj8Ss96jF2Mjlm7XsEMoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7FPJwzg1dV88Domv1Q_c5wlZvQwv_9x-uJuuthKcoyw&oe=6B0EEABC"}, {"file_name": "SampleScene_1140p_07.10.2024_03-04-05.png", "id": "1071094230877614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241696_1071094234210947_6179605932710018871_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_TGSPhYduIQ7kNvwG88hSR&_nc_oc=Adqi6ejpiRw5KcsT6hBUx_kg_tKEuiATz2K4_X7DGpnDrtOw2cXqsC0G5ArFoAepzWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOAi3qSxhsCGglLWYepCCntWWsW7o1PmqRVBvYNrFMfw&oe=6B0F13EE"}, {"file_name": "SampleScene_1140p_07.10.2024_01-53-44.png", "id": "8812333712161116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_8812333732161114_5929764519272345193_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO0_uOL7jh4Q7kNvwEL-56M&_nc_oc=Adq_XlTvls2udhyklha-U0vjKf9T3P3VHJL0wqlKYOd8MhLqeeR46lX7FNLzl9WbAj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXo2oRYdvqhICbnDIEDXrbdDabwxMXU37aZIm04ORoaJg&oe=6B0EF303"}, {"file_name": "SampleScene_1140p_07.10.2024_02-03-20.png", "id": "935497668399341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003258_935497675066007_1339601587580827491_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHxRrid3WTEQ7kNvwFyfN9f&_nc_oc=AdrFL4M5XBVi1tweJNbTJOfjmz0USiu8pVZvTacIMqWqUebXIArArZl-Cuo1exuQv4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtrzlDFX-nfQ3AwHrVoaainzT01r2dT0Udrz1PNcSjeA&oe=6B0F0C88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Strike", "keywords": [], "long_description": "# Welcome to **Tag Strike**!\n\nUnlike other games, **Tag Strike** is built on dedicated servers, which opens up a wide range of benefits and opportunities for both players and server hosts.\n\n### Immediate Benefits:\n\n- **Less Lag**: With dedicated servers, players experience significantly lower latency. Unlike other games, where performance can drop when many players join a lobby, **Tag Strike** ensures stable FPS and smooth gameplay, even with dozens of players.\n\n- **Perfectly Recreated Physics**: We\u2019ve carefully replicated the familiar physics from other similar games, so players can immediately feel comfortable with the movement mechanics they\u2019ve come to love.\n\n- **Automatic Round Timekeeping**: Our game features automatic time tracking and round counters, providing a seamless and organized gaming experience.\n\n- **Unlimited Player Capacity**: With our server-based architecture, there is essentially no limit to the number of players a server can handle. This allows for massive meetups and in-game events with large numbers of participants, something that peer-to-peer networks often struggle with.\n\nWith **Tag Strike**, you get a smoother, more customizable, and fairer multiplayer experience. Stay tuned for more updates as we continue to develop the game and add even more exciting features!\n", "short_description": "The unique game with hands only locomotion\nHere you can hold massive \"scrims\", as the limit of players on one server is unlimited"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pokruk.github.io/pragmate/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pokruk", "support_website_url": null, "website_url": "https://pokruk.github.
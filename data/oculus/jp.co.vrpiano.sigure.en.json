ng?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdTXv_DxQc4Q7kNvwEVzS9_&_nc_oc=AdqfV7954FqdAA6ntiAl6rV2LvVlsdFTWimc7a-1HDcyHLsh65-x-8AN2JHGLdUrYRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-Mz7ArcSWaU9nXC07bt6TkrNyhBqOt50k9xa6LvkadQ&oe=6A983DA2"}, "display_name": "Sigure: VR Piano Game", "keywords": ["piano", "sigure", "anime", "jpop", "game"], "long_description": "Sigure: VR Piano Game lets you play anime, J-POP, and classical songs on your own digital piano \u2014 no sheet music or lessons required.\n\nFollow the falling notes displayed above your keys, and even beginners can play intuitively. \n\nEnjoy your favorite anime and J-POP songs, perform freely, and aim for high scores just like in a rhythm game.\n\n[Song List]\nhttps://vrpiano.co.jp/en/english/music/\n\nAbout 30 songs are included at installation.\nAdditional songs can be purchased individually.\n\nOver 200 extra songs are available, with new titles added monthly.\n\n[Practice Mode]\n\nIf a section is difficult, use Practice Mode to improve at your own pace.\n\nStay Notes: Notes pause until you press the right key.\n\nSpeed Control: Start slow, increase gradually.\n\nLoop Practice: Focus on tricky parts.\n\nOne-Hand Mode: Auto accompaniment makes solo practice fun.\n\n[Step-Up Program]\n\nTo help beginners learn effectively, Sigure offers a step-by-step course called \u201cStep-Up 30.\u201d\n\nSupervised by an experienced piano teacher for adult beginners, this program guides you from finger basics to smooth playing, helping you build confidence through short, rewarding steps.\n\nWhether you\u2019ve never played piano or gave up years ago, Sigure helps you rediscover the joy of playing.\n\nFeel the notes appear above your real piano and watch your skills grow naturally\u2014through fun, immersive rhythm gameplay.\n\nRequirements:\nMeta Quest 3 / 3s headset, a digital piano, and a MIDI cable.", "short_description": "Play your favorite anime and J-POP songs on a real piano in VR!\n\nFollow the falling notes and enjoy an intuitive rhythm game experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpiano.co.jp/en/game-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": "https://vrpiano.co.jp/en/sigure-toiawase/", "website_url": "https://vrpiano.co.jp/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25781631908129340"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "747368828095203"}]}, "baseline_offer": {"id": "747368828095203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770944400, "status": "PUBLISHED", "id": "747368828095203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26265312379761288", "version": "1.0.25"}, "id": "823503240071213", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24956367593989113", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26265312379761288"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "823503240071213"}]}, "change_l
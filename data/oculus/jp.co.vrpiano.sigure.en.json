ttps://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620921_879894377760007_7071106815287762940_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpS5LmJGfK0Q7kNvwH2aEI0&_nc_oc=AdpHMawEJk-hOUod3zY-Dj9TOkHkQw35NNOlypceCNbVNj8jlCIUahNFDFitZfUb7E8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDDdVfb-CbT8s3btpqswLMg5oMcF_6VQDOqfZLp3omuA&oe=69C130D6"}, {"file_name": "menu.png", "id": "2042680629851616", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618064_2042680633184949_1118520588357468876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQck8I2LJp8Q7kNvwF873kc&_nc_oc=AdoFgd8dNRdmefyQqQNBE3R7Ebv-lGKl9tnqzb-34ozyWFXd3KCNvTaFLBiCDq7mM4U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx42llQfMoGNrzC5U4lnw90u8FsUG7iCcD5sllcb-6wEA&oe=69C12263"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1560.png", "id": "2697852091615893", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619836_2697852094949226_6752485802006163972_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBab0jrkjqYQ7kNvwEq5apW&_nc_oc=Adrh3TaN4v6ktgo9fupV9W_ywqC9Nue03F1luUdi1Bqwo6BHjED4p_iq4KRnEfzc0fI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbTdrPlZLULuf6xuOb3cO14Zjjsan1_N7mu60GRyHCRw&oe=69C120E2"}, "display_name": "Sigure: VR Piano Game", "keywords": ["piano", "sigure", "anime", "jpop", "game"], "long_description": "Sigure: VR Piano Game lets you play anime, J-POP, and classical songs on your own digital piano \u2014 no sheet music or lessons required.\n\nFollow the falling notes displayed above your keys, and even beginners can play intuitively. \n\nEnjoy your favorite anime and J-POP songs, perform freely, and aim for high scores just like in a rhythm game.\n\n[Song List]\nhttps://vrpiano.co.jp/en/english/music/\n\nAbout 30 songs are included at installation.\nAdditional songs can be purchased individually.\n\nOver 200 extra songs are available, with new titles added monthly.\n\n[Practice Mode]\n\nIf a section is difficult, use Practice Mode to improve at your own pace.\n\nStay Notes: Notes pause until you press the right key.\n\nSpeed Control: Start slow, increase gradually.\n\nLoop Practice: Focus on tricky parts.\n\nOne-Hand Mode: Auto accompaniment makes solo practice fun.\n\n[Step-Up Program]\n\nTo help beginners learn effectively, Sigure offers a step-by-step course called \u201cStep-Up 30.\u201d\n\nSupervised by an experienced piano teacher for adult beginners, this program guides you from finger basics to smooth playing, helping you build confidence through short, rewarding steps.\n\nWhether you\u2019ve never played piano or gave up years ago, Sigure helps you rediscover the joy of playing.\n\nFeel the notes appear above your real piano and watch your skills grow naturally\u2014through fun, immersive rhythm gameplay.\n\nRequirements:\nMeta Quest 3 / 3s headset, a digital piano, and a MIDI cable.", "short_description": "Play your favorite anime and J-POP songs on a real piano in VR!\n\nFollow the falling notes and enjoy an intuitive rhythm game experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpiano.co.jp/en/game-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": "https://vrpiano.co.jp/en/sigure-toiawase/", "website_url": "https://vrpiano.co.jp/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "use
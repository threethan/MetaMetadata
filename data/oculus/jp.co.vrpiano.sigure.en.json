_F9gVv95leoAyVxyp2HdmuFQ&oe=6ACCE950"}, {"file_name": "Srank.png", "id": "2031565670962666", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_2031565674295999_1096416045510083694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_PxTgBPXqYQ7kNvwFdx2Dr&_nc_oc=Ado_rsk7XSjB6r8M7GQ92-PFRUWrM0mM-LZXgyE9zzRxuLffqRTbSy8JVDjuHdLKM0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONXAZpXJQREJBlipp9iOf2PWBBRnMPgSlo7edde9JeAQ&oe=6ACCE1B9"}, {"file_name": "handmenu.png", "id": "2024960091616274", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831580_2024960094949607_3799123927494954738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4Dqluc8e1EQ7kNvwHUy1Fu&_nc_oc=AdphkLiuViFeXjLmJTMIfda9NTmMBsTdj3apBo9nydayxdDQGiJoUTY6J2x_cVeuMw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3IBFjHQP6aj2zJS7sWzj44ukroBTtdz3QaAvrPHesow&oe=6ACD054C"}, {"file_name": "arranger2560.png", "id": "879894374426674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_879894377760007_7071106815287762940_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hj3tdoKrASIQ7kNvwH1kfqz&_nc_oc=AdoddGS9Iu_gqP323mO4RjGCFDXoP3nj6qisleziIlQyz9fKL5WS8K867ScaJ-gBAM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0N3G32OeeZXo9KeMMa_9SiGbHBGe4a0Lb4Oc6k2hkDg&oe=6ACD0996"}, {"file_name": "menu.png", "id": "2042680629851616", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_2042680633184949_1118520588357468876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr1oyGafPzYQ7kNvwHdsDHX&_nc_oc=AdpOQLa3bQ07TyvVtzDtOh3YYesSjXAjqwbYCxlWoPkzdtV05qg2oD4VHYZiSzb1L-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRKPMkDSsP4BIhPgW8qdiXicraLdn_6oS9bzoRVx1pHw&oe=6ACCFB23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1560.png", "id": "2697852091615893", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619836_2697852094949226_6752485802006163972_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL9j8-DtB6IQ7kNvwGbdXkk&_nc_oc=AdpD_m9TNAkpSh0vTMI2y0z3fkNu-lEEmt7EDbi4D0Qu1Ko_Jm-BjtYvpm-dEMVfc98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhGi498OHeA5a3gzE5iD5z_Oi7FesMrumG5lJ-DDcblA&oe=6ACCF9A2"}, "display_name": "Sigure: VR Piano Game", "keywords": ["piano", "sigure", "anime", "jpop", "game"], "long_description": "Sigure: VR Piano Game lets you play anime, J-POP, and classical songs on your own digital piano \u2014 no sheet music or lessons required.\n\nFollow the falling notes displayed above your keys, and even beginners can play intuitively. \n\nEnjoy your favorite anime and J-POP songs, perform freely, and aim for high scores just like in a rhythm game.\n\n[Song List]\nhttps://vrpiano.co.jp/en/english/music/\n\nAbout 30 songs are included at installation.\nAdditional songs can be purchased individually.\n\nOver 200 extra songs are available, with new titles added monthly.\n\n[Practice Mode]\n\nIf a section is difficult, use Practice Mode to improve at your own pace.\n\nStay Notes: Notes pause until you press the right key.\n\nSpeed Control: Start slow, increase gradually.\n\nLoop Practice: Focus on tricky parts.\n\nOne-Hand Mode: Auto accompaniment makes solo practice fun.\n\n[Step-Up Program]\n\nTo help beginners learn effectively, Sigure offers a step-by-step course called \u201cStep-Up 30.\u201d\n\nSupervised by an experienced piano teacher for adult beginners, this program guides you from finger basics to smooth playing, helping you build confidence through short, rewarding steps.\n\nWhether you\u2019ve never played piano or gave up years ago, Sigure helps you rediscover the joy of playing.\n\nFeel the notes appear above your real piano and watch your skills grow naturally\u2014through fun, immersive rhythm gameplay.\n\nRequirements:\nMeta Quest 3 / 3s headset, a digital piano, and a MIDI cable.", "short_description": "Play your favorite anime and J-POP songs on a real piano in VR!\n\nFollow the falling notes and enjoy an intuitive rhythm game experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpiano.co.jp/en/game-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": "https://vrpiano.co.jp/en/sigure-toiawase/", "website_url": "https://vrpiano.co.jp/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25781631908129340"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "747368828095203"}]}, "baseline_offer": {"id": "747368828095203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770944400, "status": "PUBLISHED", "id": "747368828095203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26265312379761288", "version": "1.0.25"}, "id": "823503240071213", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24956367593989113", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26265312379761288"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "823503240071213"}]}, "change_l
n.com&_nc_ss=7f30f&oh=00_AQUDKR4e9_uuRntSCEWzrNlaZG_aPBlNopqpJKph6opqaw&oe=6B105BED"}, {"file_name": "MainlyMonkey_Custom..._01.04.2024_16-59-06.png", "id": "966236537757371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575356_966236541090704_7060230171801901049_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRi_gCK6kycQ7kNvwEeBqpW&_nc_oc=AdpMbHZWAt3pjL5e9FBGr-beEOtIPCPzXSnReI9rtk6yEmVaM1sQc_IEoUGaebnGpy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPa-M2W7_8Pr0_fNVXm_UJ_-13mtav-uGw9ea7DHSBug&oe=6B103A19"}, {"file_name": "MainlyMonkey_Custom..._01.04.2024_16-59-23.png", "id": "404459338990088", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569448_404459342323421_8862532095845458246_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDPTl4aVWpIQ7kNvwEZSC4m&_nc_oc=Adp4BFBSOuv6hVd3q5YqIjWfpkOG3gUz0WwAkXilJZryo9sD1WU5a9FkdHc2p_B5GbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4Z6bPotg61J8opkSbz2eICbD0jZVBgiBCX5HEx3W7TA&oe=6B10385B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2.0.png", "id": "788822639382373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982478_788822642715706_3307117894535482169_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eVSHlo4Ok4Q7kNvwHY60ni&_nc_oc=Adrd_As7Bd24H0z6G7YH5tDn0ChkQN78R2pnPxkEr-l8n3L_dOjbSopC3OBLmK2Tt4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6hH8eKEwX7w-DIBxwr9dJ0ij_V7VBOT_Nre2O4ILshQ&oe=6B103B10"}, "display_name": "MainlyMonkey's", "keywords": [], "long_description": "This is MainlyMonkeys, In this game using your hands are the key to play. Inside the game you have a option to play with others or with specific friend's. There are many maps to come, there is a boss fight to be seen sooner or later, There is P.V.P, Zero Gravity, Lil Place, Shop, and the MM EL. Here you can customize your character and even collect secretly hidden items and achievements. In the MM EL or as its told... Anyways the MM EL did create a few cool thing's. in Lil Place you turn small because of TROBITES which makes the map fun to play in. In Zero Gravity you have NG(nogravity) Which means once you enter you can fly, jump, or even hop around the ZeroG map. In P.V.P you are given boxing gloves to fight with.", "short_description": "In MainlyMonkeys you move with your hands and can explore the game and secrets that beholds in it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url": null, "website_url": "https://sites.google.com/view/mainlymonkeys-official-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7386276251438562"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1078608090110952"}]}, "baseline_offer": {"id": "1078608090110952"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712336160, "status": "PUBLISHED", "id": "1078608090110952"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9566423143423851", "version": "1.4.1"}, "id": "996719978638898", "channel_name": "LIVE"}]}, "is_for_oculus
all. Not only that there are also much more to this game, Play tag and find new friends. but remember If you do encounter a bad Monkey that is Toxic, Abusing Glitches, Report them! That's it for these for now You must discover what's more to come beyond the Monkey World Now.", "short_description": "Welcome to MainlyMonkey's! Here use both hands to discover what's beyond the Monkey World!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url": null, "website_url": "https://sites.google.com/view/mainlymonkeys-official-site/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7851823518217164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404389_889103803052578_1835659892095016846_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTVZmNsCXi4Q7kNvwEDQvEs&_nc_oc=AdrMxKj7OAXeEiQfxB0yNqZ4hfNZFetnTqFwaei6WaEanaUKXwiuDvcjk4hkGF5jvw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1saXtOQEnU6dTPIgdnYtzL_PwA3v0LJsPjGQvKgAJ54w&oe=69F09D84"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MainlyMonkey's", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332
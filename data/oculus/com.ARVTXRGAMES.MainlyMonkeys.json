n.com&_nc_ss=7f20f&oh=00_AQQEySqSmBM4AqNeH36h9Pm7aSofJMUzxw-tDZPq3EhzFQ&oe=6AFB43ED"}, {"file_name": "MainlyMonkey_Custom..._01.04.2024_16-59-06.png", "id": "966236537757371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57575356_966236541090704_7060230171801901049_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGQQFU7SLEoQ7kNvwEJv-34&_nc_oc=Adot5dp-nhxALEJ002e3PnEeZQXweRxKjvKlI3JYQZ9wHtg_WJA6oCS6r0f_qDtpOmQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzm1_wl1ahAKqNc3J75lAzpLMnDPH6CmSOuiuvXM_wfw&oe=6AFB2219"}, {"file_name": "MainlyMonkey_Custom..._01.04.2024_16-59-23.png", "id": "404459338990088", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569448_404459342323421_8862532095845458246_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_mJ8xvZ8wYQ7kNvwGYuICN&_nc_oc=AdrkJmUP1Xh7yWl0egJavKnPzkrjlrEY3NYwoos8M4_jXZgSy2X-GNyAe2-LfrgfT1Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRltrsMLYE2BJGdFe3967mAQuo1g8yffLu6ahmrrfLhwA&oe=6AFB205B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2.0.png", "id": "788822639382373", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982478_788822642715706_3307117894535482169_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO2tJ8VF0aQQ7kNvwHqrBAF&_nc_oc=AdpEtqXrBlfibmYyBPC8kJEeRNqyePBnZH19SdPHQq8v8-NS3mxBnOyMtOSMFAmXrfc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd8tyKKPsErvd2nHo2bhIC6z1L08Vs--VLpD-j9jrOZA&oe=6AFB2310"}, "display_name": "MainlyMonkey's", "keywords": [], "long_description": "This is MainlyMonkeys, In this game using your hands are the key to play. Inside the game you have a option to play with others or with specific friend's. There are many maps to come, there is a boss fight to be seen sooner or later, There is P.V.P, Zero Gravity, Lil Place, Shop, and the MM EL. Here you can customize your character and even collect secretly hidden items and achievements. In the MM EL or as its told... Anyways the MM EL did create a few cool thing's. in Lil Place you turn small because of TROBITES which makes the map fun to play in. In Zero Gravity you have NG(nogravity) Which means once you enter you can fly, jump, or even hop around the ZeroG map. In P.V.P you are given boxing gloves to fight with.", "short_description": "In MainlyMonkeys you move with your hands and can explore the game and secrets that beholds in it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url": null, "website_url": "https://sites.google.com/view/mainlymonkeys-official-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7386276251438562"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1078608090110952"}]}, "baseline_offer": {"id": "1078608090110952"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712336160, "status": "PUBLISHED", "id": "1078608090110952"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9566423143423851", "version": "1.4.1"}, "id": "996719978638898", "channel_name": "LIVE"}]}, "is_for_oculus
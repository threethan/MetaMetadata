.com&_nc_ss=7f20f&oh=00_AQL-jdcxdNr7HlEi9TkNffH9SzXar31CpuPzBgfmqZh4Kw&oe=6ABBDE69"}, {"file_name": "migrated_image.png", "id": "211381516845342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162720_383313398731222_5655231924529004544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA3Lls8YRU0Q7kNvwFvIt3i&_nc_oc=Adq0ZGDSJhfPF4SjSyPy2XKKHHfJvujK1cVznC9w2uQU2NCW8JLJTvfX7fkKBB0eBR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWmUA3Ylw9XfV3LdzQ0dm6eQaYkN3rJIBPKAPBN-P08w&oe=6ABBB37F"}, {"file_name": "migrated_image.png", "id": "202440577836732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1069877326483172_7847448790788210688_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PI5NVq_LVdgQ7kNvwEDYZL5&_nc_oc=AdozjbblwO9_XK9_uNSv1UKHyCDLzgObpX0L24huIBZSroMwEDARNkeVGmNlgWkmdsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUDkPAOqR79c7MDaYUCxMjNxHOw-jflUIaoAeZ9EnJNg&oe=6ABBD6D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArtLandscapeV1.png", "id": "435477323484171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_435477326817504_5334215906933342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvKMCMLO97EQ7kNvwG42Y-s&_nc_oc=AdqdHStVPj9UGb22xOW9QDi38zeiPiCNPKauMAouUJBUGl5Dw5YRX7QkvfLx1l9ec0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8lRPI2tsZ8nTcLRvDF74FGkdogXHDyKI5em5SJbxovA&oe=6ABBB6CE"}, "display_name": "The Beacon - Sustainable Apartments", "keywords": ["apartmentforsale", "houseforsale", "ecofriendlybuilding", "lumieredevelopments", "hemelhempstead"], "long_description": "The Beacon App will take you through the distinctive features of your exterior and communal rooms of The Beacon. This app will help you gauge the quality of your new home or house built by using sustainability technologies and newer design elements from Lumiere Developments.\n\nUSER-FRIENDLY KEY FEATURES TO ENHANCE YOUR PROPERTY VIEW EXPERIENCE\n* Live-In Tours: 360-degree view of your preferred property from the comfort of your house. \n* E-Models: 3D visualization of the property to assist in selection and decision-making process.\n* Sky Views: Aerial view of the property to help build the context of the surroundings around the project. \n* Street Views: Tour the Beacon with 3D navigation street panorama view.\n* Roof Top Views: A real-time rooftop view at the beacon to understand and feels fresh while making a decision on buying a flat.\n* Locality Virtual Tours: Envision the locality and surroundings through The Beacon App.", "short_description": "The Beacon Offers Luxurious Sustainable Living Apartments in Hemel Hempstead, UK"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thebeacondevelopment.co.uk/", "developer_terms_of_service_url": "https://www.thebeacondevelopment.co.uk/", "publisher_name": "Lumiere Developments Limited", "support_website_url": null, "website_url": "https://www.thebeacondevelopment.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "NARRATIVE", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1095190504388955"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "149491568929517"}]}, "baseline_offer": {"id": "149491568929517"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1498064400, "status": "PUBLISHED", "id": "149491568929517"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typenam
4_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRr3PfEu8V0Q7kNvwEPHR10&_nc_oc=Adovq-k9GRx1oAlVEv6HXhuuq8VuBAwnBb8hwOqYM5dIIy9XhGoNvbhwBbzkTG81Tl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSib3WlSn-J6dbQMi0FJ1orHL1SQ2okp0WRBS9UsobFA&oe=6A60BFB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (40).png", "id": "1445469383878324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619704_1445469387211657_2217406904161496139_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaa80ZMkibAQ7kNvwGKzq_o&_nc_oc=AdoRI6nZbU6GPmleJI3598g2l95R0t3APz1U1YVOMeoVRTjmB6Y0wquigyVTjHgHGzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmD1GGy4NgRba3jUOWYSxEWwZXTmxagW289GEsUzNN6g&oe=6A60D1FF"}, "display_name": "Don't Touch the Floor", "keywords": ["climb", "up", "climber", "lava", "donttouchthefloor"], "long_description": "Don\u2019t Touch the Floor is a high-intensity single-player VR parkour experience where the ground is completely covered in deadly lava. There are no enemies. No weapons. No shortcuts. Just you, your movement skills, and a massive 4-kilometer physics-driven obstacle course standing between survival and failure.\n\nBuilt with full physics-based mechanics, every action matters. Grab ledges with precision, swing across gaps using ropes, wall-jump between structures, balance on unstable objects, and chain movements together using real momentum. Your body control and timing determine whether you land safely\u2014or fall into the lava below.\n\nThe course pushes you constantly forward with dynamic obstacles, moving platforms, collapsing structures, tight jumps, and long aerial transfers that demand confidence and skill. Mastering the movement system is the key. The better your control, the smoother and faster you flow.\n\nThere are no easy wins here. One mistake can cost you progress. Every section challenges your reflexes, coordination, and nerves. Whether you play to improve your speed, perfect your parkour lines, or simply survive longer each run, the challenge keeps pulling you back for \u201cone more try.\u201d\n\nDo you have the balance, focus, and control to conquer all 4 kilometers without touching the floor?\n\nStep in. Stay sharp. And whatever you do\u2026 don\u2019t touch the floor. \ud83d\udd25", "short_description": "Don\u2019t Touch the Floor is a full-physics parkour challenge where the floor is pure lava. Climb, swing, jump, and balance your way across a massive 4 km level. One mistake and you fall. Precision, momentum, and skill are everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/69bf28e5-0bed-4455-8efd-ed23f2a71894", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26494295090232471"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1466619561790677"}]}, "baseline_offer": {"id": "1466619561790677"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773279660, "status": "PUBLISHED", "id": "1466619561790677"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
dn.com&_nc_ss=7f20f&oh=00_AQC8_UUUIRISNWS89IuXh6bHPwwy2GwWtptMl4EdjTNjJg&oe=6A60CB66"}, {"file_name": "New Project (45).png", "id": "750171204608454", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618093_750171207941787_3644436536360214880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4eEVIj2VHkQ7kNvwEgHvf4&_nc_oc=Adqp8DJMQYYun2f4HjVLKnJROUJhOFKZyZFhxUt2MkSEiWN2wK29g37NbMrMxR_sJIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkyVU1S9i44hcSEu3iCvQBrhsamEgvVGX-BtgYLsHXWQ&oe=6A60CD17"}]}, "id": "1626719795108757", "locale": "en_US", "screenshots": [{"file_name": "New Project (49).png", "id": "3336214376554794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_3336214379888127_4873077735447529046_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbcaqBrcSDAQ7kNvwGVWBMs&_nc_oc=AdqdQzB7CRPD79HU5jkZYDzAtkIyAwhS48783euwqUm4Qw3uCN-CFmrgzoOd_R9i8ic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTU4536hPuAEY0dqxpsYTpn-A6imYxcfnZR-AqkiWrFg&oe=6A60B404"}, {"file_name": "New Project (48).png", "id": "1313467623954846", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822107_1313467627288179_2485286411225391566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1nslZs_VAgQ7kNvwGZWDii&_nc_oc=AdoaquabarTFTOY-Ng7WiKV-KGWcfMxbWXELE6AdD_rl_pSVsmvROQ8DV3cCpLAMzgI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHtULbt0dGiAC5FvvrCmbN4_DjA9gBSSh5Hco_-3qg_Q&oe=6A60CBF6"}, {"file_name": "New Project (50).png", "id": "25795882333439151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618512_25795882336772484_499030195391069322_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H73l3jOWgb0Q7kNvwETa84T&_nc_oc=AdpdTz31AR6CRhCuUDISXawazVHqrZhkHU01LSknrVOxdeV0HHDxrnKsa5wzwMRGPqs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTIC-80BFB5YAUASxtk3MDAfDOhVu9z_lZrIIh_OFFEg&oe=6A60A5C8"}, {"file_name": "New Project (47).png", "id": "1454640226365631", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619533_1454640229698964_8835489152004593436_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC6t4HWGseUQ7kNvwEEVBxL&_nc_oc=AdrHnNIFduMy_gnHiTlNpqT7BnzEvRxLJinRrZA7n9xKGDNyYCNZHX0l3JGtooshOBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAckaeDMCS3EwO7ylO6BdphWQMXs8aCX5F_ppojx1XUdQ&oe=6A60D391"}, {"file_name": "New Project (46).png", "id": "922725840347699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_922725843681032_1176622967455094714_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRr3PfEu8V0Q7kNvwEPHR10&_nc_oc=Adovq-k9GRx1oAlVEv6HXhuuq8VuBAwnBb8hwOqYM5dIIy9XhGoNvbhwBbzkTG81Tl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSib3WlSn-J6dbQMi0FJ1orHL1SQ2okp0WRBS9UsobFA&oe=6A60BFB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dtf.png", "id": "2018603835748278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_2018603842414944_3442323777115073474_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh926bq9h0cQ7kNvwHn6Msq&_nc_oc=AdqdBWN1BIj_rwha2bXzjnDZ3bChdoHwYloFHrMKx2RAVl9R1jSfFaruJtWB5nf4j1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFZgBetAYsd6bi4nOmcSR38oB1BgH0ZiTDVfwy0FY6Bg&oe=6A60B74A"}, "display_name": "Don't Touch the Floor", "keywords": ["climb", "up", "climber", "lava", "donttouchthefloor"], "long_description": "Don\u2019t Touch the Floor is a high-intensity single-player VR parkour experience where the ground is completely covered in deadly lava. There are no enemies. No weapons. No shortcuts. Just you, your movement skills, and a massive 4-kilometer physics-driven obstacle course standing between survival and failure.\n\nBuilt with full physics-based mechanics, every action matters. Grab ledges with precision, swing across gaps using ropes, wall-jump between structures, balance on unstable objects, and chain movements together using real momentum. Your body control and timing determine whether you land safely\u2014or fall into the lava below.\n\nThe course pushes you constantly forward with dynamic obstacles, moving platforms, collapsing structures, tight jumps, and long aerial transfers that demand confidence and skill. Mastering the movement system is the key. The better your control, the smoother and faster you flow.\n\nThere are no easy wins here. One mistake can cost you progress. Every section challenges your reflexes, coordination, and nerves. Whether you play to improve your speed, perfect your parkour lines, or simply survive longer each run, the challenge keeps pulling you back for \u201cone more try.\u201d\n\nDo you have the balance, focus, and control to conquer all 4 kilometers without touching the floor?\n\nStep in. Stay sharp. And whatever you do\u2026 don\u2019t touch the floor. \ud83d\udd25", "short_description": "Don\u2019t Touch the Floor is a full-physics parkour challenge where the floor is pure lava. Climb, swing, jump, and balance your way across a massive 4 km level. One mistake and you fall. Precision, momentum, and skill are everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/69bf28e5-0bed-4455-8efd-ed23f2a71894", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
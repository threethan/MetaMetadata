38982534_214056032878450_1438401478191480832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pern0GWxuE4Q7kNvwEu2Kvu&_nc_oc=AdrVmVsXIJnwIJC80jDxGfdQK2HKnLeEVeoWyAI8JGc3umyr4dVtTBeIeZsFaeOJKxg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HaOaitNqxVQc8fbp6q6RXoVq8iMW7ORWpruGDZAdGug&oe=6A4673CB"}, {"file_name": "migrated_image.png", "id": "139314820819180", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982690_2275901685763033_2134455083750916096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfoKVEfNGwkQ7kNvwH1SHv8&_nc_oc=AdpTcETDAflI3y4l-kGhOQ1O9DaDU69NKyg4d-bYPdnXKYegGEb7u1QWMvMrfLXULnk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E3Y7hWzJU23o749wyEEDN1s5Ml_Peu7g36IZ7THji1Q&oe=6A468BF6"}, {"file_name": "migrated_image.png", "id": "205740824070377", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003279_525830377914634_4213073299141296128_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwy1tWTo2FwQ7kNvwHQHLU6&_nc_oc=AdrhvMY8gP5mIl-6t6-P3EKX-RsPbApkfhai6UDjSUkSoIDpeJVhsi6KK9TEJsSIOsk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ax3kqPWRW8O4BAReAH7NeJ-gq4lyBNERFuF8mymD6Wg&oe=6A468CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jtgTT4", "id": "227622721458821", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974657_227622724792154_1333951219332284416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqalXvHWUa8Q7kNvwFjJdew&_nc_oc=AdrR3vCwxjLKtG2RJLnzsj_GbF1OlFgk8aibMPYRVthEP-d0fHWwV8D8rhyp6xxzanU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ecfxh2jLEmlZ5NaByu9qDfKfJpxP-tTy15Jv5DoBa1A&oe=6A466D3B"}, "display_name": "EQQO", "keywords": ["Adventure", "Narrative", "Story", "Poetic", "Puzzle"], "long_description": "Inspired by ancient Ethiopian legends, Eqqo is a poetic narrative puzzle game, an initiatory adventure, and a love song to nature. It\u2019s the improbable epic of two foreign creatures one to the other... A child who can't see, and an Egg, as fragile as it is vital.\n\nLook at Eqqo's world through the eyes of his mother, who will guide him while telling his story. Help him use the powers of the Egg to advance through mysterious rooms and awaken the Temple's sleeping mechanisms... Foil ancient traps... And repel the dark forces that want to seize the Egg!\n\nEqqo\u2019s walkthrough represents more than five hours of gameplay, a compelling story, original musics recorded with philharmonic orchestra and complete voice acting.", "short_description": "A new poetic adventure in virtual reality from the creators of Dark Days.\n\nEqqo\u2019s walkthrough represents more than five hours of gameplay, a compelling story, original musics recorded with philharmonic orchestra and complete voice acting."}]}, "developer_name": "Parallel Studio", "developer_privacy_policy_url": "http://www.parallel-studio.com/PrivacyPolicy_EQQO.html", "developer_terms_of_service_url": "http://parallel-studio.com/", "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "http://parallel-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "ko", "zh_CN", "it", "de", "es_AR"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "227716692803268"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PUBLISHED", "id": "649590475452947"}, {"status": "PUBLISHED", "id": "2434595786803326"}, {"status": "PUBLISHED", "id": "303977487634490"}, {"status": "PUBL
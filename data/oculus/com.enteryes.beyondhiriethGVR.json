rative the player must pilot their ship through hostile environments and destroy targets to progress to the next level of enlightenment. In this VR experience immersive gameplay is rewarded with innovative immersive cut scenes that push the boundaries of visual storytelling.", "short_description": "Beyond Hirieth merges space shooter gameplay with a sci fi thriller narrative."}]}, "developer_name": "Willem Kokke, Kris Kelly", "developer_privacy_policy_url": "http://www.enteryes.com/privacy-policy", "developer_terms_of_service_url": "http://www.enteryes.com/terms-of-service", "publisher_name": "Enter Yes LTD", "support_website_url": null, "website_url": "http://www.enteryes.com/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "EXPLORATION", "NARRATIVE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361121258836808"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386356_160920087964765_3092685287038386176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kf-UOwuemAQ7kNvwHZJ5EK&_nc_oc=AdqphKOJdx9TeqTCA1MLhoDb7grpMj08gfnqonhC1lsJ_JSJrSnIohvGGOCv5RSLNs4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GTclGjG5E9WiXEK6-_FBv8FNfIkzjUuARSrLN-oKIIA&oe=69F1EA7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beyond Hirieth", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518022095, "lastRevis
_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92_c6LDcRuQQ7kNvwEBC-z8&_nc_oc=AdroOPgwjEue39vGrxUza6Z6PXy2aA1bFC94O5p_vB9wrReSGCIAREGTQ1mkNsdRK8Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7BNUT1YgIKZpDTymLf7-Y37S-BQukjdjQh7NGEDg9jg&oe=6AFC62B8"}, {"file_name": "migrated_image.png", "id": "963729607418375", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410407_1636380023067007_5694089996894470144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtwK-T9eI98Q7kNvwEW_qML&_nc_oc=AdoAC_XvA44sYp7pMJL5i6-Gu3s3gF2zdoFJh_vMuGZi719agjU5cst2zJVUM1AUp9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTusBk2QoHDaDANAMzOKShlo978bBcwn921sW8X9_14sg&oe=6AFC6EBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beyond Hirieth", "keywords": ["Beyond", "Hirieth", "Starfox", "Rtype", "Shooter"], "long_description": "Beyond Hirieth brings together award winning graphics, exciting Sci Fi shooter gameplay and an emotionally driven narrative across VR and mobile platforms.\n\nMarta seeks enlightenment from The Teacher. He promises her an eternal life and the opportunity to return to her most cherished memories.  With a Starfox style gameplay and 12 Monkeys inspired narrative the player must pilot their ship through hostile environments and destroy targets to progress to the next level of enlightenment. In this VR experience immersive gameplay is rewarded with innovative immersive cut scenes that push the boundaries of visual storytelling.", "short_description": "Beyond Hirieth merges space shooter gameplay with a sci fi thriller narrative."}]}, "developer_name": "Willem Kokke, Kris Kelly", "developer_privacy_policy_url": "http://www.enteryes.com/privacy-policy", "developer_terms_of_service_url": "http://www.enteryes.com/terms-of-service", "publisher_name": "Enter Yes LTD", "support_website_url": null, "website_url": "http://www.enteryes.com/", "categor
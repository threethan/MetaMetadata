NvwFkk_Pj&_nc_oc=Adp9V3DHsU0F3AgYRPgO9-ZqbJgU7hXACi1rqevkl9aBdVJD9BPz9OkpGR5xRt39-hQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OkWM54Yer0pFNW_AynkOzu74QPuPn0HLyowmUa9Ec9A&oe=6A280985"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Or4-iqfrzcQ7kNvwFubTzo&_nc_oc=Adoe8d45an6H86t8tmLHOyA05NJJdWJugLbhyY3Kn_UelFYcSUzUssvDRzkYspf1XGE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LRBm31t7bj2STIDMr3m9Rt1qyKkzbvtfJY8Xxea4F2Q&oe=6A2835CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbu8IO2imjEQ7kNvwF5XT0C&_nc_oc=Ado-UB03ZE1g9OWhgU2H-5mh45e7ndhVKxpNJcCqy_6kih-NgEE5Gi6ALrmQ6Hy4HoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FC2ow92ev2EXb6AIZDcWq7dwjk9wzA4L6t-ooyau4aw&oe=6A283046"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXE1rfouji4Q7kNvwGT_m4y&_nc_oc=AdrWqQB847tK6yEk2qqqITdAr25btOFJjnkN0Jd9LUn-0S5TeuuQ3rtRMF8UrARuy0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S5JIWuD0Drgc6NGyGuK3YWro-_WPpIjgIiSx0fPanUQ&oe=6A283746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2fLJROSTzgQ7kNvwHuwTlX&_nc_oc=Adoz--dvIjercZledMEUkFkSqhJt_mZ0nxCKv5lw__BF5hL0X8bfS2ukH831httYRbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99XKaFhd_NKuVZf3iLj_KpaOCNsdzjuq40zOW5RxFbYg&oe=6A2831D2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
NvwEbBS6j&_nc_oc=AdrKLubHUYDALpYswRNs7pwygsCs33zIvGKj35u4KWqtPpBJdtJXp0hiIqaj4TaPXn8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0y1dWo6segV61-l5rQ7OwvuGNasyLcvUL2fydYtJEcaQ&oe=69EF5905"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cSHxviqnBoQ7kNvwH0Noe_&_nc_oc=AdpatCOKFsuR9NlYQLI7i2oeC0QMGYuMhKSpqGchXMF7P0XKMFXkFULJPOjImPFrEYI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rzYznuJbUM7UQhqlzABcE6znYeHR0hEgBGoblyhUZXg&oe=69EF854E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3S6rzJ5EDIQ7kNvwHk-mSK&_nc_oc=AdpPklBlTP7AyOVEbI7uJV-Zai3j-eMsgiIDcC58jIhn0q9vFzDvU5pCHhtbyXa7eA0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UuTpVAVREZw0Oco-5zLw9WokldEOyu-WGGLAUjJ7Udg&oe=69EF7FC6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0jsNWtc8koQ7kNvwG98NoK&_nc_oc=Adoa7IJ4Ki68-111BbgsKBLw1-wb6xGKUM-TMiCI0SG4nnYbbmV6v7gkdyBYE_0W12k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eK9tYxfjzev3tFfgZwlI5Jkt7qJQ09OTm78DwFxHowQ&oe=69EF4E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7Pioc9E6ZQQ7kNvwHk5mdK&_nc_oc=Adol_Zc6iaCQlZThXOo7RttlQ-jRqucgvmOa4L_7Ny0RriStdTFWyFpD8A6fzebjbEs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-n8d-u4tCdiN3xN9fU3fZ-fR4OpAuSfc39EjHKZPUzA&oe=69EF8152"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
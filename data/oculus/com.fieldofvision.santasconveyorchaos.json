.com/v/t64.5771-25/57569428_703943925121575_652310630171394909_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRAJaLSJ01IQ7kNvwFU11jo&_nc_oc=AdrP8R5m9lvWMRRY3_TW5ValXkBmRUi-5EdqR4zug9UDtFEQxKQl128aQOkYIGTFt88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjU560ILWxA2gnDrIkuiCYPEYTNfgTqzG3Wg5bxLSXwQ&oe=6ABA6005"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5BSNgRrDyQQ7kNvwHQ2f4U&_nc_oc=Adqt8EACmkCi-L-EN3jIbWh9BOar-6XirF_QuL4V2yMMXpLTL9R_HH4FL9gR9UOMfcc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnglftSOpFGoKPParFgKma9gcekrLkzFUbuGVAS4xwlA&oe=6ABA8C4E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TA9k5sNJupMQ7kNvwFGuuQl&_nc_oc=AdoNEtiU3WKEaxxFw5Tn3VKPKb4MWIxy9ST-4bSqZ0K0_9Qrwnoc93RK2maxURsuy8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_rGJteFo-Sfu46oxdKZCFFBrGpgxyPkn_2bd7Q4N7wA&oe=6ABA86C6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J10R3mIfjZwQ7kNvwF9YQEd&_nc_oc=Adpk-G-0gueLl8zs6wGYXgWaIIG59cQPCftuFhjaDGZXO08ZDQDuchz4Z5-2F3BU-eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVhDLorJ13OrzYMNnmEDeRNqEBS9VhuF-T1BFH9n_WDw&oe=6ABA8DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIxqtVE7mKUQ7kNvwHzFv45&_nc_oc=AdqCP4obe1V790xmZ7DdY9zuQBYe6RjiofyxJy9z9Wy8_UiObeO212qUG3deQpZHgzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhvF-z0rET1yiseLQS-UQ6oFc4DY-kgAW8yRrVVMdJQQ&oe=6ABA8852"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
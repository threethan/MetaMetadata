NvwEbne_W&_nc_oc=AdrXNYDC_iuaHvuPkI56P6J0LwFrCJ_WtkswHAjnGLc35nCLekpDGgycWN_EVaK_Tcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7peqAtmIekBVx9g9xZ3X9xXeAI4AO6QRXZ5J14PyK-TA&oe=6A0B0885"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju_o37KmG58Q7kNvwFl8oxI&_nc_oc=AdqxvAMHLw9NIHf_X3L8nMSsz-wRf7CAmuZc0lV7GBPJItBkBZMw1bsh1_NcBmlbOjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NCN3xYo9GzM_wjbQuznbVllQfiuS8cCMefcz1q1Syxw&oe=6A0B34CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Urek-Ju0XoMQ7kNvwEPDEAZ&_nc_oc=AdqlOmQmjW3LhhCn2t-FeBixtxP4qd6RO32fFycIsPmViJGpQx1piwgO4oPUuGYqisM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56tCKtYchI_DBL_yEOfIk8j6x83FE36Lyp-xM91MVsMg&oe=6A0B2F46"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzshNyRUHb8Q7kNvwHQp0_K&_nc_oc=Adr42XiE3r-_q78EomeS8sEDGILTp1a8Q06vFsmeEa6TGMT23HGL3IlAHxUYd91-9A0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KUTrTOTzvfOn3bYz8z9NKbtpYUsFh2orYhzfWK2dL2g&oe=6A0AFE06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IEyoEdIFKoQ7kNvwEgZR7Y&_nc_oc=AdpqXXc0QoISnIBF1JsgGxUmL98QTlagO6j03LIBqx86Mjy2YYj8-LxPswDtjsJVrrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44HiFXhj1OTLhwfpli8Q6rIvXhf0OJDZbl0tlqM-p9mA&oe=6A0B30D2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
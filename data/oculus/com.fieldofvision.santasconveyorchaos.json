NvwGsKwXK&_nc_oc=AdoaOrG4KMzbmhlCoG1HA59uW08qkXCE59QT0iZK4FR_rWJWG5A94A-SwmHi0O3XjNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KPLM6JLRjOKsp_HVEMmTPypfnC-e3vFq8etZviBqtUw&oe=6A3AB6C5"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAblHrg1mmUQ7kNvwH05E1a&_nc_oc=AdrNp1mGHPX0suQMf1uF35luZsiBOHdGxJF1FF53wlJtRTY7bEOg4PolwsDTIMX6kKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hsrVhX2izHc7jeJhLhxDDjJiGGsz0xfZy95GuLFTwIw&oe=6A3AAACE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFn1Mu0rf24Q7kNvwEF7UkW&_nc_oc=AdqprE4xLGRgISi11UkfqeKRVDhj16o0fv2riqEzaD5zmzk4MZEUj6RvqvMMnbGilbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_juZtUxelP1SFEHBPFMOc6ConCOtGBMcbt2YLpmRpipw&oe=6A3AA546"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMeAt4BIhgYQ7kNvwFpg89u&_nc_oc=AdqMzV1u9NBMqdrM9IMbndSWhnt5_DaMLeBTZH8uTLAUiXxwhGxcHWm6Yoao669bqWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wriBaJJ19ePI5eosunOaOGHQDFrnj0kYdjLj_DY-DhA&oe=6A3AAC46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv4A5iYPZvgQ7kNvwGb5X5N&_nc_oc=Adpb4w_PIGzhDBSgl_bcscHQxPYyZ7YdwU6LIOz-I_oy3ZCk0dkAJ-vXzcaef0-JlAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OxXhXGeC3VSJ1S6h72EZSD4Q-Rtk98yL6gaUZKJdIlA&oe=6A3AA6D2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
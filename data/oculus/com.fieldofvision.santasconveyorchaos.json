NvwEavNeY&_nc_oc=AdpKXteFw-NIVKTqeGR_N5aiF7NxuYGhclrtuFQUuCWFJxIGW6Zag_4zr1X3qlFAzEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cDb3xfswJXvQe-WEHT7XhTzPXwAynXAlJybKeC8-fOQ&oe=69E8C185"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcEtOSa15IQQ7kNvwEoIKJZ&_nc_oc=AdqfRYLVNwb-NTAebDF_ij24-_xNLuIwV_mbet-DLyNnHm-7UhoFi1wON6pQLow6w4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ld2zk6Xd-ZoC3i8G0wPGx6ohzRbzffm9DM0k9jsfJUg&oe=69E8B58E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psFRQfvQUx8Q7kNvwHu3auw&_nc_oc=AdqFDNNqT7igl29thkPsKFrrS4DkTu95zvFzL1U29DZuhs_AXra1PFjrhlXTBdO-Y4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mjZOy8cymVFX4yDSsWws33pZR7EunboI0QJrSfmRGLA&oe=69E8B006"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_hxiV9M4VsQ7kNvwFah-Yw&_nc_oc=Adrt_1I4gLwH9TZ0qfZtUP9AXuupxtucBWjPBsOmiM6O-d1aOfLhtNflCJCffjbcjMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18-ExFf5COWElpmjrwayc91ziMB4OY1kY2mYI9UGQk0Q&oe=69E8B706"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F15zJiuyozMQ7kNvwFXshPV&_nc_oc=AdqNSBMDBxhjC-eLGwN4ClyKw8WtN38ZFr43M8lbVT2WY2SLVU9lbCNTZ2ISK7Xyeqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x5TD3Sa9I8bLQHoegOqtG2ZbPPb0CdJCRRWrXO4BP6A&oe=69E8B192"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
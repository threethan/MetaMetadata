NvwHYGgm7&_nc_oc=Adon_vHomehDD7AET-0RrLnRwZPbxrUTras1TugCb75f_EoI872AM0h9wL3pM83EkwQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dc16fUYEj5G3v-rq0S-eNPcx8yQtiB4DFLGR48WjASQ&oe=69E77005"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcEtOSa15IQQ7kNvwE55kwU&_nc_oc=Adpxnn6ccFY4dZzfjv4MBq7uO-TkvKvoRY3X32xuMlvoBYw7PTgHJsLUHfqOGstq4Z4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KQo1woeQA-9O-_xQlLc8au0c4aNUyyitK-jVm2ZmW2g&oe=69E7640E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psFRQfvQUx8Q7kNvwGTABSp&_nc_oc=Adpp4Tou0a-2BQO98ggBuhGqy-9SFShyDeSFd2z6TqQW5HfDiw0SRwuhCZbKs_K7VGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WRGJugbIiwY5HUctUEP3CzTejnQgGt72x6H33Ive5OA&oe=69E75E86"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOmnmwj__iAQ7kNvwHPur0S&_nc_oc=AdqItRCUJsbY9qcVftLS1Ql6Kk8kM2-dMI_8SBmRkSL5ink1xx6jv11Br79x8Hc4vss&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NxfU8ff4yXDDVXAAXYWiNOFPIPeYI1NmpJsaBHx0EnQ&oe=69E76586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F15zJiuyozMQ7kNvwFjL4w4&_nc_oc=AdpkiFE_87JqG3CfE3JUx8QfHBGOKzXNWmNUR_slhgRBhGkD3DyNTYfhTSPX7EMOpYg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R_CAkc0EpUXsxEg7gixaazH6oSYBTWBXzLM1Ki4P7aA&oe=69E76012"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
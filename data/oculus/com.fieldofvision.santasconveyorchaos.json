g?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt88cJ-m58IQ7kNvwEw4V7H&_nc_oc=AdrBsKXE6HyanCbI_ccj58uRb2JzjPpV12_f3ih-0v0Ww-Dbe_cXbubodGGbAAEvtXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH-0jkTyePPXuyo5qPAgru5Ad-kAdHg4i5RGqq0-cm3A&oe=6AA56EC6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B5ghWUUzhsQ7kNvwF7LvR8&_nc_oc=AdrkHUolqP2nm_5Yyn1EvPsjMBkdJc5awphRtnMeBc4-N5D_HVcJYB1cu4HCyjo98sc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9H8N5RfzQhNySpJeQQIvsY8Yq5FE8WVIF6utuUjfFqQ&oe=6AA575C6"}, {"file_name": "3.png", "id": "3640364926252956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974482_3640364929586289_8992655601525010842_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mSs-R5ow-4Q7kNvwF5Or-N&_nc_oc=AdoejabLL7hFoJTY7u-gPl5h2AF2A6dsssCvM23u6LgFxLHesNceTHsqyrvK8K1cnf4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRFJELuhUZxVixiGhiVuo-qGoBtD5LA3OTR27PfRRYDA&oe=6AA55CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZAGBfRphP0Q7kNvwEN4PlW&_nc_oc=AdpOX0tqZLaEf0HPOnibqKuSsAxNDFOL_FSpOpgjqUToj_aL9el7P-lnNTo-HfS047w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICFEjHjLsLNrreiBfxNyFT2FyDV6XuINU_mxMfS25_Fw&oe=6AA57052"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place \u2014 right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room \u2014 let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place \u2014 right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6691893047573117"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3870098399890768"}]}, "baseline_offer": {"id": "3870098399890768"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701360000, "status": "PUBLISHED", "id":
.com&_nc_ss=7a30f&oh=00_Af1Hq9O5YM32skbejDq1SoUaVCJ_Wrx10Sxzu3ojxNHCzQ&oe=69E22A05"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KWBBaJRli4Q7kNvwHul84c&_nc_oc=Adotlkg8sBSVTuzPg5-kgSH3hyUsnvJOu8Zjg0onwy_V_LC4raayHiCRW7lBTFYePsA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LSMPf-nFFOZJoj1L5JyMaNa61HDzWv7ncGjdhCYjP8Q&oe=69E21E0E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNxY1RoN7uUQ7kNvwGIZAPI&_nc_oc=AdrQQq1Yvb28UNmeH8OPRHAntD3B4RYko6kI5MHplQ55T1DL3VxpZaeMBKP9Klp7G2E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gOJ19NoJ1qc3PiBzIISx22w8Nf41jmAGno0WqjcnDEg&oe=69E250C6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5trtKYH6144Q7kNvwFQ_sft&_nc_oc=Ado55ihyXhKIuZSOujeMQ22JcGow44gV1QDnjBo-dbEFUeUIAe5OV5-dwyax6KmFAeA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q-ZwemOT4ygeO5TNdLVr3a-FKfvSh50iiHFEhdbVmnA&oe=69E21F86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIR66nBF1WcQ7kNvwHnw1Ve&_nc_oc=AdroCsyvG_Zc0BcvbGaK7b2VIHKgiNXsd-Ihq7XS6fhtwq9X5VhhjE_UqpPPA6A0MFo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af183_iARNqh1ouw4mcFx_uuZ6Bpj4t5F1YniBMLviNQcA&oe=69E21A12"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
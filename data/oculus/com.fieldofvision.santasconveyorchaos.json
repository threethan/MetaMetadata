T61sgQ7kNvwF2Uk16&_nc_oc=Adqaf3w2djOAQYQGLwKuwHk-DlLrfdLBdUnMJJc2d23Qa0NdFK-ysxslxLYCYhWG77Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DU-eNsxOSxxl6LH7hWEKGy812k83P8JmbzOVVYn9fmA&oe=6A465C05"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms_dJjacyK0Q7kNvwFqRzh0&_nc_oc=Adrdbl3ata8bl4kaFSbJVkznagQtk25q3E-GLpjPLzCLUrAvqC7XTrBSG6Y1yfUMaJQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BVuZk6J1KHckBTPdmNJ7K3Ea4IYIDXtAoprl7Sn3Sww&oe=6A46884E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlsuDCASkFAQ7kNvwHe-ZMd&_nc_oc=AdoRzfUIuAgneQxKvdhSYumKGcaAazKkQ_hO1zTW4k9G2_EMUxrG89Xm71F0RpSK-nk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A3IAeoWXJlg6qsfWchDaoNu_LSw7pooD7kud2CP_Ogw&oe=6A4682C6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9-BTsgfAvoQ7kNvwFN8r0k&_nc_oc=AdoJomkEG1FCb3QhdEY3lT9k2ohbJLgGsooCYREDJXDmDpSwo2l5Q8jP6P9srO-4QvI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wCxrD1Yzmv44c33DHcmQ4nPzlJf8DniecGz0o-og0Mg&oe=6A4689C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5INmUXAJ9gQ7kNvwEHdrhb&_nc_oc=AdrOWgXihcG8x7N0sb6mYVRoDUoZFFlcU1JRtcgGFvT5A4Y8BdH1_AEwtLBD12b-1R8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8afI6e6UK_CWk_bh__ERchdghwG2ifR8aVE_JLdLZJKQ&oe=6A468452"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
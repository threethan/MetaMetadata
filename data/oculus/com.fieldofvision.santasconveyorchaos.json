NvwFbwVAE&_nc_oc=Adpt7r_MfYaH1ESvyXhra8tp1xDFFO-fc2uaDFnBeUlfwgN3zlKr2Hgk5VnHifypirE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57rfTTr5-wHj2ECkYX2UGju6IOsdhRnMHGt-mQ7532eQ&oe=6A086585"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJuruR-sCr4Q7kNvwEKbC48&_nc_oc=AdolLwhUez11VzsIxdlL4X_TDtYDHRUoK6imOpOEGFp2_pJ1oAOJ71Fj42OEq5DM2KU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IEvTW3oy8IqU38I7jmGQ0MU0An33cCxKyHagq_R74OA&oe=6A0891CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hko-JWaFvnQQ7kNvwGPu-mz&_nc_oc=AdouxNTy0gG5Wnzni1yf9qZj11v0asPTna1zSAgi3N_ebW8UWyeyK0q-67L5FfzAhQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U8SZWv19aSRJXAJ5L3m30azrxt4MahX70ZjkouDo_DQ&oe=6A088C46"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzshNyRUHb8Q7kNvwHURYtS&_nc_oc=Adp2baxlb7eta5OjBkfmfdaJTrf5aW0TXdnkhF_ZKNvJJtHKP9hJkxFhwDGWZ8gBUr8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47ryJiPyrKhNR3a-v03Mn6p_59ZmemxnH5ElBq08ljXA&oe=6A089346"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd8I7UyQ-pUQ7kNvwEh3GGg&_nc_oc=AdqWjNGuDbLU07g5PjiSc4E0j8eHgPkyxPvTBaDMPNWJzfYE9EFlm5fSenh8NpuhF28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kI7JFSXIHJYYvl9Y3B2gDD-R819HTv3lrCLHKAcgfoA&oe=6A088DD2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
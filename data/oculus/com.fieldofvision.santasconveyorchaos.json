scdn.com/v/t64.5771-25/57569428_703943925121575_652310630171394909_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQS9aM6q3xUQ7kNvwFM2Yna&_nc_oc=AdrSnJrTpePY-7GklqtDGLLt37HcStWbY7Iz_QqhtK_iuDxCqvseoufX9v9yI0YczYQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA8Pxza2BEuV99teCbRhClnfsHXYIKOTAsJc9ZoEVksw&oe=6A85A405"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PhPJjEOH7YQ7kNvwF8rf1c&_nc_oc=AdoBjITvM3JGU3U8GG-TMYv0XqDAAczrT_5BcSmxi4k20p16z3iThZNokjn7LueMSmo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbLrLxiU6VUUvUraXWEuUV0wfspvqTFSAU-DuofdgJrA&oe=6A85980E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDFY3Jyai98Q7kNvwG-eva_&_nc_oc=AdphKakywdtcw7Bh9KoGZD9U3N4qxtHdxgqjBg9MTXdlNmtB0jnmDatC6vKmgttznAA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeyPVa13UO6PGmaf_tifJFRh8YXuRox7vxwTXPsApVFA&oe=6A859286"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0OEN-6tAJwQ7kNvwGJB9VR&_nc_oc=Adpqft8HLAmN8bAiOkp3HlISbRVORPNLwOUTr5EBb9uOMEX1GreQKtp4G0BOzGk1BUU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0VoBWbMoh7Q3N2mWZBWdB3WY6VPeAnXgx0YoFymXAnA&oe=6A859986"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0h07prpqMYQ7kNvwE36His&_nc_oc=AdoFLbCYbJPX64RsY9ay7Y89AHH4Ff_NFM6rqpAFN6UT4bTcgKR1WA47Z9jBzjMV9ZI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuSH83_yCOVgO2UCkvGE8kr2wsvKdXBE1l6bfcJtCXQw&oe=6A859412"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommend
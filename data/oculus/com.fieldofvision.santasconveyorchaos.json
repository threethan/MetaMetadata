NvwHqvQxL&_nc_oc=AdryeCPDNQFwyEbCH3doJt0gu3jA6r2KssP8mXoxTEWyMXs7PJu8WEt2dRHigtK856o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sp8Bz9yJHtxxrDZtyTuJACyDNLoiBcInpiVsNLVWo2w&oe=6A159485"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sH8HpgFDmk0Q7kNvwGiiHSU&_nc_oc=AdrWGqWwA2SWUmcQwE44sWjYG9VqPmyeJ0Kpq0JBW64htPNuCf4IF0XPHdjoCI3xp2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DLy8b0_ofmxNkNJ6aI6fnPrTHrWwGpkK3TrEvS_SaFw&oe=6A15C0CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvvRDdTGecEQ7kNvwHHZst-&_nc_oc=AdpfTRiOJpv88Jwn9ZkcYsV01nRTaWq-podoJGDtvmepRosOhhlbrskpj5oCEmVcquo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CVVFVdbO9j3pfv9QS0LRElGsa3Fe4Icgm76POD-YW9A&oe=6A15BB46"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDwjYo2p0xEQ7kNvwFR-weZ&_nc_oc=AdoGU1wTnnVZlOHMS4Iy-lgZmYHSqAHz0LZVhT3VKS2MnGkclM7_fMYhOYUCtcfrutk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YYH9e-28oBZTmJVsS1A7w2mAAUmNndM78v3gcmokthg&oe=6A15C246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uZQjcwpankQ7kNvwE7sf64&_nc_oc=Adqd2xGlx7BpLZG-paHPEJioVYypuFySl7Vlj-2dvCcJeIrUqFpnI7bmA85cST8yjN8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v-F78FV5QHkmTjc9kYyYxSEZrn4NMAk4mpae1Mu17_Q&oe=6A15BCD2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
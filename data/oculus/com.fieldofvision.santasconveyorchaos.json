NvwH1Vxp5&_nc_oc=AdrpDflXQDgiHPZ13lW7WtOCXDDt7wga0TpzHcz0muoOhBbcohVsWOGMj8LYXjq3J3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vEdh7aQz71fitPaV8GXK5B342_DSfuEucaRMyPJmtgg&oe=6A144305"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hC1B0pefuUEQ7kNvwFg3OvO&_nc_oc=AdoQ-Zy2lHFv6NGS8hNUwwdW9aguUClv8TvO9i6y8_0oII1IeHNunye-v7kGJiQBF0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44xU3yedxZk0mHqU-VFqYYP5qtzNnDAzRyb9oktM_OKw&oe=6A146F4E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvvRDdTGecEQ7kNvwFXQd_x&_nc_oc=Ado0hEM6PriN4bwfb1gZeNFa7xooWVpeDL9zte4b0ceWTt-0X8nMwZ-GCcQqj5xIRLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JDtW0N-eRRP7Y5jiZ40tt-7HlilPhCzEMXF3iOgClNg&oe=6A1469C6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDwjYo2p0xEQ7kNvwGlsn28&_nc_oc=Adosb8-qAzgKnyy6jMpeU6y1V4KwLHLNfod8dmEG1KZH_fqQd7SpvBPdeOH4iW2xctY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DLh9PqDxfkaoVnSRvjp-xP7iFPqOzpMl47QZk9urWWA&oe=6A1470C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uZQjcwpankQ7kNvwHqKDPB&_nc_oc=AdrWx63mTIF2-mBeWRdeznEj0qlE3C_nPEIZF4I0_p-_A53eE3QrA_2kTqPJeYtrnhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LEoLIwPCmXZvFglSa4CRTQsq5L8aE0TOz-mi20Zv5lA&oe=6A146B52"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
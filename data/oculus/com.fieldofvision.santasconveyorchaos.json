NvwGo0zg2&_nc_oc=AdoGM7RO14KoQDR2zqFsuCh0g0hnSA1t8FnEb0XmT70YLNg2-wlg8Mk-P_o-ffw4Fyg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sDjY4pk83c-XDEZbooxs68j3QfmvvGNOyBJdJAeeHDg&oe=6A1ADA85"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp80JEyjhRgQ7kNvwEl9HNs&_nc_oc=AdrQfzZiwdg7_0LWAetk3yYMMYI8jGgPgpcAjKODh2b4g6LBtSnwEhNVA2PuHiTD7Ao&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GlulnpLDbxStvlrmy2w4Ub4aFAXqhjycOhNmHcQwccg&oe=6A1B06CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gK8YQP8-vQQ7kNvwF_ehFa&_nc_oc=AdqhO3MUHDEA5pLcjg0uKBN2pbwFmB_IS_kJlTqMtHXEfP3kaBmsaUNuiwyDvygaAgU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qvC0w1zbNwb42G_SMlfO5enJsLlza50r60aMtarhwRw&oe=6A1B0146"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPrH_t0kfOYQ7kNvwHcRSY4&_nc_oc=Adqj1Xo7FK8ztx8Q6k3vF-qBjQ8eSCI_ub_AanOF0W_cwX0uJUd-f5jppkBn5jWnZOI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_xQ9JzgTFSV57eRxV4ytp0ytiVxMRhD3fex50li9tOA&oe=6A1B0846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu2nToC6PLgQ7kNvwFzn8Zv&_nc_oc=Adp1BkxodGTskSEVxBi4VmjgdbyYB9DZPIZYChak0zHrMjbM_6iIVfYvegA2oiWPNbw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RjoEChPz6bGjrO-7x5Gp16eViEC8EnBk2_RNP5ceMqg&oe=6A1B02D2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
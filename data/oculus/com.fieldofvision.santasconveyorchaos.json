_pYCYl35i7vYwHX4AbDr4uuV1DXLd5aA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UnnMOur7wXGQwr7xj4IfF29AcJstVouotcPkLQaKpgw&oe=69F1FC05"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YghaUHlev-0Q7kNvwHnsrWp&_nc_oc=AdqgwDOjRfsg8f_tdaKmzk76MSJ2LKC6QaLoJgcgsGWSGVJ4I7ZrWYVbwTm_VGN7wqo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af00kPvCfUlHuR8ukn9IpjLe64SoQRzIihlXCvDpPRixtg&oe=69F1F00E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3S6rzJ5EDIQ7kNvwG45FdU&_nc_oc=Adohg2-KmlOm_zLVGox0RLo1WvlRAbrvEXcNGS9xaLe0yGRy1vq0FhF33UehzjaUA6E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1gEdpg-a-LisBil9toGZwaw7UAxLih9wEMjYb4frbGVg&oe=69F1EA86"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLoo7cfr5oIQ7kNvwGNLAla&_nc_oc=AdqU78sno8KbOduLpzSv8E1dKqKo4wzWr7N-k-KXig2T52M3uQIK99Avgl4qeUD4EBk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0RIIBtGStD-_McDIqD9cw5LlUvQSu1rCJO4_Hy28Djbw&oe=69F1F186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7Pioc9E6ZQQ7kNvwF0jASJ&_nc_oc=Ado1vIHOlYVgGXtSvRpxd3MYaaukDkQETjCN4b_mCb2E13N7kugmD1BV_gYE38MrKDY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZySji1XTqrLt0C8Lw9Lw6jMhDEq8WLOm2SBzj0vGKpA&oe=69F1EC12"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracki
NvwHFjRCw&_nc_oc=Adp6hVkhoIKVORVk75jSZFIcFOu0xLlyNo3vnePPuUli-FiyD17jMAKtdCWh8cpfRHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8J4tjFI3D6bzXlowNuhGLPCI5hgv64IqkVZpQS637LA&oe=6A64AE85"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yeac9qwuAgIQ7kNvwEOJp7M&_nc_oc=Adqgw0BYTF-vef3UZHZWyQI1fEp-nkA2893yjrtWD2flkuks0MoOYzQ50zA-EJ1S0F4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD3x-a9JYnS0zf0-Msb71p0tZGld2LXQaLjuvHNm613Q&oe=6A64A28E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbRze4jOQCUQ7kNvwGyuF67&_nc_oc=AdqMzdjM7E-a0wRYkUP3gxjaaavS-HVb_tAkN88pOgCb-dVrzGysYbZyrM-lx9xE-SU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHv1drHR_OddF_QbfPBjLy-JtYE5P-5ZHBqx-lnTxmiQ&oe=6A64D546"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YrZ8V8389EQ7kNvwHh--af&_nc_oc=AdqY5_LfTcxyePjB2kutgy86xzNVZD_oL84lfK5L7wUOQSk4ZQgulBM1ddMC1t59T0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAoaBif3mHJCPCnys-CxWSOeMrehiYx1kTsUUh_9Wl8g&oe=6A64A406"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWzddY6rXBgQ7kNvwGarl4_&_nc_oc=AdrLQf0TN8GiUA6kU7Repoe6Ehvm6mN6KE7eDHacqoKpSLBKmEnB1texuGTQRa4KK3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl0WSKzgwKT-akOH7LgA-EuKR4QO-x8KB3eAgmrIaJPA&oe=6A649E92"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
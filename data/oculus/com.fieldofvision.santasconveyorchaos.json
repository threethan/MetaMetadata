.com&_nc_ss=7a30f&oh=00_Af04B3RG8CivqupCD2PJ5inPdQWIslcHYf6ebPsURDlvww&oe=69DE3585"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKkWhmOyM7wQ7kNvwE7f0fq&_nc_oc=Ado79Fh04lZBNxSOqCyUsDZrb-_VAC_PXL_RxXpEM9E8MxfAk87GCb-8IyxpPitii_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P9M_t1L-TuDeYKhCAZXfJWoW7qouztQl9ldWg4rdpUg&oe=69DE298E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRcsdxZrIzAQ7kNvwHveeKX&_nc_oc=AdoX7jiA0BG53dJHxc87f18Uu8aLFmpIfQ9dZAX1_zrlgM8Amy-XKGfO5ac6b0199og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fcDjK_DW7hborScTEOsOD3wFf7mB9tSUG9hn_B2gZKA&oe=69DE2406"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5kpYd9JfLQQ7kNvwEah9Dg&_nc_oc=Adr00CezH-Tsex_b9LzbwrVx8kIbam4U4jvOx9_-CiZtgZyondsljGxZQgT5iVOh2R0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I0ZUcT1nZZ5RNVuBG4Etz6oSYqNRPAXsdcd6J_D_LmQ&oe=69DE2B06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmVphsGCHgQQ7kNvwHyIQ1q&_nc_oc=AdoOZfqMMgVUydgH0fIF2OQLhGsG_1mOtq1cFEJYMEJtG4nEdL9u7C2sbS-sKuIBAjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cDPhPqZfrkHV58nmXkEqrkME9ehlVO0xEPhAQ0GXOog&oe=69DE2592"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
NvwHIS-IQ&_nc_oc=AdpCnn-RKDHGgl3cMC880pVI0BBjoiHFEh1ZAK1J0GvKK2db-5FKMxvB_0dSOYFJW-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-HX8W-PtD09cfLpTvq6ZOxHbMwpA7HjvPFTCCmDyVow&oe=6A3813C5"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DNeHjkr2NIQ7kNvwHTL0HO&_nc_oc=Ado_iBwh42NcY7X_rsGgW9Iqty9c9EkQWFwUUjM5TkasoaugJphpoDzlJO80UN_ELCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SF6gCvqwr8eIITdQ5yYwvCkP8h-mjjRaJ21s7UbEyYw&oe=6A3807CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ4UBd196IsQ7kNvwERJQBa&_nc_oc=AdqMBAH6vsesuljXUDNtVp3T9-OqK8DgMK6LHom9bN9LYamVmEykoJo-8wQBYnAW-g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xbwddzqmUKOvkc9uVZspWJV3U-B2ff5IYI8TDnROeag&oe=6A380246"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMeAt4BIhgYQ7kNvwE_3b4j&_nc_oc=Adrp5b2seu45C2hNQqmH4XTyA8eUB5QJqBC_PzDy1B7qYSqjWJP-TuvSaSKbS7vsYKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pIm0s0-C_nkdbWrYvADBu4ktxKpmpBc5abkhszFypbQ&oe=6A380946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb0Xge2dEzcQ7kNvwFTvSXa&_nc_oc=Adp55atlh1k5akuhB8UFVFW3rcWvycFVz6-q00EeVBRWLFGdDVvsFY9wL1Qj0hXrjUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6VyhDILhjKhuho_NfuomPaTTlSKLqOBW1DCCmmDHz7w&oe=6A3803D2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
NvwFC0y2J&_nc_oc=Adpjk_SEItOc7HzDVBbRnxZH8qUs_qsSyvsPivFw2E0rPV1OKBT1pN-86CxSSNSwP4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdtJK9zfexoS0pG790D4o62SXSzK9-JV2_vmvGNCwzQw&oe=6AF1F745"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBNDaITphYMQ7kNvwFwK8hE&_nc_oc=AdqvFM5e5_bR-BPUXhCiqvflkwNFgKZar6MKTAZuPPcND68vJpp5c1SxHHbqfEtLxyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJb8Vp0ujQyhk71OxjCka-s_9V9QuJ7sm6jHMHBflvaQ&oe=6AF1EB4E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN5H0aDXFGAQ7kNvwFiDtC3&_nc_oc=AdoYM7nKXCgCGQ6jLyIkLZ6iJ4T1yCaTRt6HcOy5Z1PJVxOsvgtPRwvBqFUIGcmdexw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb9FhSCv_vSapQytynPQhELNjiqVK4opzitJSw0__Rbg&oe=6AF1E5C6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PsPy9sHxokQ7kNvwGS9c2O&_nc_oc=AdqtFByYYhpaQB2VL-0tCSHZ6wZwcJgAVIzx00cN6QRcIKZILcsh6XdPr6wD-0I7_H0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsfHBZ9N6hXH-8U92tNkbPdUU_VPAr7vD7ax0Mk2ph1Q&oe=6AF1ECC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT_ozVUPq-YQ7kNvwHeSPHf&_nc_oc=AdqhiQOa0Xh_sZY6oezAErm9fubUMUvo-FQIa2IF-QwzDWaDapTqLjsfii6g-eOrtwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY91cqXJPKeWFNHY3jR-5q6yQhN64s0P-wwIqRbXIelw&oe=6AF1E752"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
.com&_nc_ss=7a30f&oh=00_Af1n53AHB7Mh4DsqyLyUx7TptgdQyv3d3AkgUMZA3ftRmg&oe=69D4FB05"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGeiZh6qhjYQ7kNvwFl1RHv&_nc_oc=AdpovVHqLkCsbFwgiV3t-b2hObCegik3796bLDIsiGkdOhF3F8IVoAgymCST9p2Gbak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iUbrQk4tgt-Lfz_fWaZAHLCdh_tgd434ggVEVRGL6oQ&oe=69D4EF0E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_9SPcEsIgwQ7kNvwFYC5Gp&_nc_oc=AdowcDOCSjGUF_ykmCYwcbmFFt7ZRajuTXTtl12ehQmNeo5SwZOhAQfudmogk1d-xT8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tn3fideFZrbZXD9ncYrU1POcySxL_slLEiDjdJnFC4A&oe=69D4E986"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfOBkEBfJ4oQ7kNvwEqgghn&_nc_oc=AdpJ1HL9YUD2b3maYGPYsKiZHEIh_KMHbIOrh2Lr13SjW4b3JZyOHbO2w0wU7JTuKWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F9fH1RyWXD15wgxXfB2ghZU2HGbLolnLc0HUprVlpzw&oe=69D4F086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY4RjSxZwR0Q7kNvwEBhGOR&_nc_oc=Ado2tigVH80Xc3BZonL4ShZXMpanfRvqnAImRLVsY-VjHxPXyBpKeeqX7qZpEEQ7gbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27m8bve4_0D5-nnyed1J2bEpfbxKJy3bjh8IJ3w-u28A&oe=69D4EB12"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
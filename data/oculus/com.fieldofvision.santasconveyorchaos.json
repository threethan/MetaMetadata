NvwHbPnq1&_nc_oc=AdpWNVptWbO6uT2NPKuHbkh3VfS62KRMZQ1LWG0KswPCartCEFLW7jZKkm5YVnPNq1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DKRW4dQ5reUmvKikQhlp8T15U557IQwYxlzzh_ZxIIA&oe=6A1D7D85"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WcCN_dIxYEQ7kNvwG9N6cX&_nc_oc=AdrsJRlqRKkuWeqEAA602BrM1BeXdgxksN-U5RTSL8yLk7fzlMfQc0WMF86qaq0jZ8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VoafyIx7SUy0uc804fgG7TZtRwURDLfg8K-Ni6difzw&oe=6A1DA9CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gK8YQP8-vQQ7kNvwHnif6i&_nc_oc=AdpLtibAjB38l3MsOB9-aGYlAZMixWLHKtZjBhl7l6DGbpMjJoYJ_TGaNiUYOMkXsoE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wpaLtPo-Zv4AwxAMqQYW65SCGYVDmPl-SUWFZsA5H1g&oe=6A1DA446"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye3_pJb3imAQ7kNvwGcYaKD&_nc_oc=AdoaOfeYWtMKf0rgxME6E9FUoIcwOZAB7ADeOcjVXyq3SfsV5_yvU3-3bTF1W8iqdKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67ZkfX7EBchmp8AQ1lhIP278fMNX-oifnZFmE6ofOatA&oe=6A1DAB46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu2nToC6PLgQ7kNvwHp_fQQ&_nc_oc=Adp9vviy6Fp-7KeW0UrQdBcs5u3a8xZwtOEMC-_noj6WW1gTBcduhq9TsMdpRde3FPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af567rCj9yRIuZsuphJOreWxJ0_Ft8ABe9fQ2tCTdc21mA&oe=6A1DA5D2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
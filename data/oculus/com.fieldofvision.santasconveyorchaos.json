NvwGrB9a1&_nc_oc=AdqbAGtuEDwiXsm8cLFJR2gY9EyMPXKlymaiaTcpaXTCgvlVbWKvNDG_7xDG0P1rUHQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1eRmJXlzWPN-OCFaKYwhKKpRyVTTxc7qmrnQzL4TorA&oe=6A660005"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yeac9qwuAgIQ7kNvwHL6ij1&_nc_oc=AdqdwgrTvhpFz8VDwzhhwZF18cNggY-v6Z-F8ZISt0qUpLIiDg0gDEhqneJAJUv9k7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhMlMRzJuYcKJYYYI8-l5U6FOt6qJWpGVlDL5rh7j6Fw&oe=6A65F40E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYmkjSo_DXsQ7kNvwGnaOu2&_nc_oc=Adrp-0tEgk-Evi5Yj4Z5RJBlCDXhx6S_wytN9tj33iMn6t3dhG3FOCM6HGbs2DSfg38&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhg4xolCDMxQ4FbHZOwNF5E82DEJaq4jIYfBTiQry4vA&oe=6A65EE86"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YrZ8V8389EQ7kNvwEQ7cMu&_nc_oc=AdpjX0qm5xEBV2deUAmKBTcRl9vtChwQ7TtTgye0BTylb9xB4-iruWqWyoQGNBf3PcY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApwzidIEzTvGBt-4UkAPL76_0k9rsDaKxNZU2ZCGuisw&oe=6A65F586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sva9UjQaqdIQ7kNvwFgTR_P&_nc_oc=AdrnYpXCZSEJlNn-b7MTYPJXBIoxvdOF1TL2sBb7K-B4sicccbLBfuFi6KCGPoIhxO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9sJ-ljA2n7DFOT3wzft0KjI0BauJ2aHu3BIND5L4H8Q&oe=6A65F012"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
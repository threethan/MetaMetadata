NvwG9XdUn&_nc_oc=AdpvHgmEKal3VT08oaF_Pri2tlmPjPWzlVLxbRQcke-1OCqxJvLrR6e2phOsZoqDea8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_olqIcWqhN7w1_wOgUoJ6d7rzP8Np0vfGHXm-3vAb9XA&oe=6A47AD85"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms_dJjacyK0Q7kNvwEMrK_4&_nc_oc=Adp4XhVqPosvvEYwzA7vvHkUUVDQ0QgUEqXLtn5pl-lNsSaB4idzgrKNXF5LwYsHu4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_He35NAX4j4hzaWG78BrFXHH4GAQSnBXS6LvSSlGBhLw&oe=6A47D9CE"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlsuDCASkFAQ7kNvwET7yTl&_nc_oc=Adpsd_c0irkqZRnqg2vCGmArRjXBCYSbykc2Vs3twaJqLqp_F7UqFEexT8DVpOw3On0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PR_t5OIkonBMvk9jxhXkmXZxONlaoWBCeo8bCbvtPMQ&oe=6A47D446"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRbbV0CJUCYQ7kNvwEF1Vu3&_nc_oc=Ado5Ew3gLZfvArmmC0cUpAkNR4LUpuoTxzwopyowRXlBMRNvXg1EQ43yf5-5Xjfr4C4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kUVgq2WDlcm_K_ecvVoN-4OK8K2K35oLV-k5wSwyRqw&oe=6A47DB46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5INmUXAJ9gQ7kNvwF0UkPD&_nc_oc=AdoMZyA12WYgMLgiy9wRlngf133clREfuHWNsUTS0Rp-1-ukO9efxzUvKFsZpkehVIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zyU6yxjf-hPr8_cpa2MdGtU03o7iqvFFptM_Bw1zSaQ&oe=6A47D5D2"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
NvwGbjPOR&_nc_oc=AdqSgahcsCWp1KvZrbN7e5o-nVgPm2XII9izLwdfuOJ__Wer8YztrBHqMy_DO1lDF_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7e6gI31jsgpx54z67QlDXtyWte26NIRcVC1GZGOFoew&oe=6A6B4605"}, {"file_name": "2.png", "id": "715886480411764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_715886483745097_6140034638423637002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbjXl3jeRfMQ7kNvwEZ5cpc&_nc_oc=Adpchwle68EEub8_IizHM1xjgn06vjLVfOgwgMmzxnvUvmApNPkIbjVfFGaK3DFiuGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtlenOprZ7hEytL6Ew4oGzVewgxS0L0bzXJY2FDKHUGg&oe=6A6B3A0E"}, {"file_name": "4.png", "id": "276349348724802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974535_276349352058135_2519417495507060160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5h7PDloYNsQ7kNvwE-TIGA&_nc_oc=AdqDEELd0wRN2wtebtrHkP09I3MqKjH9GVSyO4YQ0tpoLickfOgzq-P25eu-cGajHjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiXxZ6DAlQbuYxlB1kNhTaCH-lasrfff-bGe8xzIs5BQ&oe=6A6B6CC6"}, {"file_name": "1.png", "id": "1392236998308413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1392237001641746_5442523511094641796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMQYOXsqxGoQ7kNvwF9_QSZ&_nc_oc=AdrluLEGlsdAYygkTg9XcKyIbhQr6zmSEIimGe-YL-V_MX7wzERI1qOeayELm4aHyYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBdaYU1vOVLSrOmtDMSANv15YEw0CTz0KnoYkb8BU3WA&oe=6A6B3B86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "7185582884799521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982623_7185582888132854_5357891611076837602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrIwm_EM8S8Q7kNvwHYhujM&_nc_oc=Adpv1mmnpUfOy3xWbed_HFsxQMW3lHU7nxfzyiqalgKukwH5ewFmxF35yVf6IijXyK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiWDhlTxGxleGthkknwuA4hhWWheRU_gVsWLf3dgg1mA&oe=6A6B6E52"}, "display_name": "Santa's Conveyor Chaos", "keywords": [], "long_description": "December event is live! Read post below for details.\n\nHo Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!\n\nYou'll grab gifts from moving belts and pack them as fast as you can. It's simple: gifts come in, you pack them up, and together we make sure Christmas is ready to go!\n\nThe game is easy to play but can get pretty zippy, like reindeer on a gingerbread sugar rush. But hey, that's part of the fun! It's all about quick hands, a sharp eye, and a heart full of holiday spirit.\n\nNo scores, no timers, just you saving the day one gift at a time. There's also a personal gift shop for you to treat yourself to some home decoration, like a lovely Christmas tree! So, what do you say? Grab your Quest and make some room,  let's see those present-packing skills in action!\n\nCheers and chuckles,\nSanta \ud83c\udf85\u2728", "short_description": "Ho Ho Ho! It's Santa here, and I've got a big Christmas challenge for you! My workshop's a bit of a mess, and presents are popping out all over the place, right into your house!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
kaUI3mCAe4JPP4jTATDTuYTQG_ddjfoeG_jvRdGg&oe=6AAD519E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q9GTUUXXb0Q7kNvwHkbdTp&_nc_oc=Adp16tqqH4ZWrNsOoh-0Wg8hKWSco1J0pS0oO1LxXl_Vlqvq502Hjj-oMHFRfaJFp7g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ4jbYnCqWGmf53t-63gvgBD0GnzneWFGgls52JrJIBw&oe=6AAD3F05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXCeEqdvDNEQ7kNvwH8T2rs&_nc_oc=AdqXsyfv1BAkbXwH50Gtu-D1WJXGStFJyOFkFxwWmBABLn643PtmRvc4PLzKC1aH0uQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2CHJkEXU1doJ6KRlwAaZowxAboo2V85Jfxlu0Vk4CQA&oe=6AAD2FC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K09GSdC-troQ7kNvwEQfrV7&_nc_oc=AdrW24LPpmX-Ptu2JmsD-h1_PonjhdJxd1DhG53zpg-8MJAE12UMpQESVnsHaQvaCCo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVR4PU-56gvbXnTs5PbKe8Wtd0UpkKNKRrWrr9ZBS6zw&oe=6AAD5249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtPWXw3i-uMQ7kNvwG7KZsF&_nc_oc=AdrI8IoHiVb1BRHVet99YVQkO79OPie8KoxDQBl2IBWEEB0tCaFTPW1mbm_m44CjsX0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUTE2eTwiYOstGz9GYB4_tE-h8JEIOisfOc_eHup0GXA&oe=6AAD4256"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxRQnw74I-8Q7kNvwH39UpL&_nc_oc=AdplbJdmna6q8ZHLcyw9p4xocW_E4sxL8ql5f_eN4r_fsAQ1d5FD6Evra_T02gMayHk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOEW1uAiUFcnyYJgRnL5_3CGJI
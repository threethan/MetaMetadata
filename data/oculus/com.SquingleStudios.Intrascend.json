Zyw3Dgg_19tMidp3svTUseKgefcuEU4Xc5SbceDg&oe=6AD23B9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm7KWcdeE8oQ7kNvwH7jnHi&_nc_oc=AdpvDnjp_L-smqFFGwJ0D5TDTDV1x9cUmcStDugtxfdAE9bDI6ZXgR1WTGAEdHeEkwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEpI4f9M5snOTUe63_IYaqE6GMvtsMhU2L_MNlAMAuMQ&oe=6AD22905"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNXZv18FQzgQ7kNvwGszyPO&_nc_oc=Adp67bJHbBY7_sg2tSiRuBAJ6QsZkj-7Df7WNI3H2JLj4Fu3CCCSynYZv-7HlZH2R6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpBBmhEszfNlGqNdyFQ-0_-QjExaf7qXKM9QfrynAMnA&oe=6AD25200"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYTHW3xAcKMQ7kNvwFEO6nC&_nc_oc=AdptsrEu3s8-rISnNmcHGakM5p4dC1EU5dOarSp5HWdFiXdwq9Eq6nIu0OPBHZbnPcQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIuiXdlA1JlRCeXzo1jSzrwxSkkILtGJ4QCy_S716cpg&oe=6AD23C49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6C3kMUVODsQ7kNvwEyhJJ8&_nc_oc=Adp_nonKfXFijkBEOwQzc6LPbIUJkYzxOU7sfm9xncyNjrRXz2bp6Iq4Tt-X-p9PoLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFKOtYttlvHGOcosswl4QeCYsKjSREjI5KcKoUzk4u5w&oe=6AD22C56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tFP8sMgVXQQ7kNvwFsRaRL&_nc_oc=Adq3zOUiUyOM9mHjtOtp9aDJQ8Pm1GUHKl3tuyxQqyAD_E9_f4n6DiZpcMBk50_czzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD7kUFBt1bfhLPM_SPJZV8XKp4
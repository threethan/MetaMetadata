xqTMnoRJ3DNpiq-zhacqLR7uGsfo4QQjsb4K9G5A&oe=6ABFC69E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxpx82WrYNUQ7kNvwGOE8x7&_nc_oc=AdqSl2nerK58M1djtubAWebMePZN1T6xFwM_ugbuhKduIE6Wm-QeGcP_YLTgcY65skg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe4t-jb3U9nJATqg19btgPaIwDgB-CQpvuW-kY0yDrEA&oe=6ABFB405"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSXPfq9TV2cQ7kNvwFpBO8b&_nc_oc=AdpV85UNDDtzt4gLzycqXBShsJ3-UIpoCY71qWqbxkM3RATPQtDK-KtdXcKVVrvKR9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlRsOgy-Myys1wIp6_sfbP6HCCSt7Mif8VROsJofVqeQ&oe=6ABFDD00"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgab9mO3Y8MQ7kNvwG7I6BO&_nc_oc=Adrg5qrQKlDkjqeqvE6OuifnUoTCakGpjZUoadUkVD9_boisbuO19XW_WKx74LzYhF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP72k4F-v8nBoxgyIkq1AKD1IOBBKrzBq7ILSdDYOJZUQ&oe=6ABFC749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGTTMhdjoboQ7kNvwE6bDiK&_nc_oc=AdrfYQoDFRPjBc--I8luVAk2m_UrompBEP01FV9lKsIkX0PQwcFZaSP-VWEWZuRMwNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdNfRMD77RqJLIhKGODWRb4qMLQIZV-QKp3tbI7sJd4Q&oe=6ABFB756"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAZsbevkr9YQ7kNvwEyDjdt&_nc_oc=AdrKM7psL3lojxSE75mi0fGLtRTzn3H1jhb2ONC7PMRmR2UQrJB4nxTKCLDrXGZ_Qi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_BVmAtLUPKewm-aeIOgJ-QVcC
JFDTfKdYVizh_OCwlJy-GGh3_RQq3ZzDBDGgA1sQ&oe=69EA339E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUV-G0pzMwEQ7kNvwE8SIz5&_nc_oc=AdpXJnJISRS6WV9ITtUjAmYdzyNZaGlMs0zuAHoFuh02dtqQdpSN5H0VofflPakAnUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3p1hQzHoONR2aiQrFPgkX3E-CMW1lxirsnMDlLq5IlzQ&oe=69EA2105"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am8f3ApjLZEQ7kNvwFoA1Vs&_nc_oc=AdpZIvsfUqQieaYWemI4VIr0Sesdy2RSkqoQzS6eQYAu4fU7z1sQVLbOegeZhVYNL6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jchUoG43o74NEPlcSuQg7kSe0sd4I1_wo_Q_O-Nla6g&oe=69EA11C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arBOlx2ml54Q7kNvwGr0e6w&_nc_oc=Adr6uJH6Av_n-ELK8RgTPGF0lgRc6ZjXRXzh39kQnTRmqV1uHhRb0MP4_Od-XeJ-N08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af192_80t-ad27kX7iOWtJThRe6CLa21McoSWTAWxv0J4g&oe=69EA3449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjvzQs_-xRoQ7kNvwFRTprw&_nc_oc=AdpqC3LJxKkJuvngDx6DuFlVzcBxnlpUIimNUnJsHFrLgZ9v6_eDb0YEAz3Tsr7_5RY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zOHC_ZpZOj97QG_AGeh0iNDcmD6gKo2oD-EXzET5uMA&oe=69EA2456"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFpVL8dSZIcQ7kNvwEuOnKC&_nc_oc=AdqT7-ma7AX3slaMu5XB_jEY1Sjd5MFOUVyrXOKPKPaXdz-spjJxbTCNdh7fXCjfE0k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W2Wh79340-iwAM1j30VD9hc4o
Nc8vI8s_6dcdU8siLzc6WZSsmjHFgWy9TR6gjjmg&oe=6A86DDDE"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-Lw1vZyVAQQ7kNvwGMpVfE&_nc_oc=AdqK8eUu-xOVNDaFgnLwwVB1Se_jHa5Cb-OCxPWnAGPXehtm90lZi0vydDg-T4BMOu4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUmghwhvC91aYwk2EWHFDSRucHYBE1iDF1H69pMa3n2g&oe=6A870385"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aW1FCI-VxIQ7kNvwE6fk3Q&_nc_oc=AdoQEUPxymeXdUXFRclhTs9xlP5pvZoxv0wxgsVuegzLTy7ZmCsA7pNMTeIIf6qdxyI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIVPdmPKRsWUkSsLvV0IyvcKfMYSWs5LrosUR8pr0f-Q&oe=6A86F440"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWX3FePPOR8Q7kNvwGaJRcX&_nc_oc=AdpwpY2jts2R3WzWkQsH1ylM8_FNEjkZyzhK9cuf8Hh3-2jSXlZcfvcRTdwU3tbkOUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED7hHZCvVxrOkxYAjDUHPxcVNhfYI4u3yoCfwQNO2EKw&oe=6A86DE89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aYARoSIcMUQ7kNvwEN7q0T&_nc_oc=Adoqtb4Uy8eU9206QftGM0A9fZX8uwAuIAs2_xmsHRvNIPcWlN6Iu_Aau2XmfWUwv2w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrGBA7gNQZbByc1LYZJwm4sBh0SQ9miau8FbZX-k4fEQ&oe=6A86CE96"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur6ty0KQA8YQ7kNvwEx1s2A&_nc_oc=AdoIv9wxE8zfRPGLKoAmcNmN8c08y_DUd2nzVS0xEZZbnpgpJeSaW4O-K8kMBs-eiCs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxkzm5bpNbKH4PHiW9QX86TO4E
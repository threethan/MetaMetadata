oPGHXf0B-u5gJJHgkTGkRnXtpJn3-5dbZt9MGXaw&oe=6AA1741E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVHj6ugt650Q7kNvwH-Gbtn&_nc_oc=AdrOr0CmpF2w657pbmUcnsgTrZQ1Zw56XJqWgx-XEdN64FuFtCO-O7a4DbBtLHhDiWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ3QCariXmAuo79kz3OBGVgLeD7GsTJIv7awJYpwR3vQ&oe=6AA16185"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbEaHEKpyvoQ7kNvwEQA0Ea&_nc_oc=Adpijf1GkHT2pFh1b8DdgfYnONgijJA6DCSUcZHKWdnVcGEMHjJ9ZEnpRkpBXO1Qxg8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1njsyNUqTicSxhhF_xQyGXWqonHaM1LzBfVlVSARvYw&oe=6AA15240"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGJKOFYGvRcQ7kNvwFgy_FT&_nc_oc=AdoFt0a3FPg6CfaO_xxVHWlbUnz1fZSz6qskODCzz0EjH95T1qlNOwIDXaHXrG_vfk8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGmYjcxwXXsABDD4RE9y75tPbjq42wWGuwuEmacnyx_Q&oe=6AA174C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BV00G6hcw4Q7kNvwGv6U4S&_nc_oc=AdpsA7xhMPX9V7VF3XyF293aHlPX8dRkAlZTz6XmQ0Ms85tRUkjI1psmYj3_936OF-M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvOp8BWXaRffHdoM-Yfwb_Pu73BM_MNbO3Pki0KR-YzA&oe=6AA164D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ia1kwm_LPsQ7kNvwF_2Dtr&_nc_oc=AdoXFeDULvOCj6TYHWtC2BpTlRD7xjTH9FQXZFGgHre3ajhpv-_LUovSgA2A0MBF6m4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHSKlULbSLhR9UWwZKqH6K5YBB
-ACzOt46c9hNaigM0CxWy75aQ5PU-bfB-xIa-GXA&oe=69D2789E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M03UHQ8ZzsoQ7kNvwFs16c_&_nc_oc=AdrZEWybsEmmj1vcvHqRCnP-ymP8ToSaqmyHNjLtJiFVBPd19OEPw6QZMJrEst8xmow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b6lLX-gGhd_KbJPQXc6Wgq81s0_hY0yWnJMAqrtpO9A&oe=69D26605"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBfs74239a4Q7kNvwHnOxPh&_nc_oc=AdoXlfcjvnyS2Ery-46xO-aC3_bywu2N8MDGnOAq1elu_QPynrv7Cwkm3bukvH28MpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IVAqXagm1Q0i1H2YPWUS5TnaoR4TTX3fTUssFRaAr0w&oe=69D256C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGpVl5f2PDEQ7kNvwEVTZTT&_nc_oc=Adp2VtW3pfUFJyaF6gb5PEWwHI89ZSNi9mch1DN0SVVEiWQbQxbO-bR_hMX6r6NnUwQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_TBTeaDscf6JPOpFiVit02NbmW7KDjpq2CYTOLPbfGQ&oe=69D27949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSaLlII0xMwQ7kNvwE-56Om&_nc_oc=AdqvVEQCmEHzAO-MBij77O4waEgaTJD-D0JfCo4m4iFd07wuBNQ0H7bUFUWD0j_Au3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YqQ2J3IFAUNneqIaR8pRnrjj6g167kJzXH3uCb8Uilg&oe=69D26956"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bRFLLgUtGwQ7kNvwEnN5Of&_nc_oc=Adrb4cHA40JkfwGSjn3fiLq_NzbZqYSU11xOmHXv1AG-kDdN1FkRI6a0427QmSOkoBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zC0llKxV4OF6jb1IY8Ktd0D6Z
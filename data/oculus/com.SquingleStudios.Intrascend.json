6H9dZrJQ9MoizGCuOMHTihUpHIJaldn96F5f1plA&oe=69F7629E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_XcOKqx2WkQ7kNvwHtKx2n&_nc_oc=AdrNklE8EwQCibG5CGnSP3kL7ZuRldJqPUDlvPxMtjU1c2gMtlDSWYYVOjPgGV_Eghc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZhzStubKFld6GeUQKI8yDRlCSLro5wDsmcE8UHhVGcA&oe=69F75005"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikacF5Itl_gQ7kNvwHY88nz&_nc_oc=Adr_xmYHr_MiVYgtev8a78sYDbhtP2dryOPqTSlFtkW7hjXiBg95ETlrBPUL1Bfm5LI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Gys-M1FmIcy-nAplq0xEMWSLkvziJ4XK5VXKKKJTNXw&oe=69F740C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i97G7Z9oWHYQ7kNvwHAbrK5&_nc_oc=AdqxgDTDWDmAjL16Alx9jrNLxcNa8NekiMJ0R09o1PFGHJxFvcvT6RciptwnWcPRVRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dLvhlfT4tWpRKe8gdz4COaUscwlQl41lOnx2rKnHNzg&oe=69F76349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akY6T88vrFYQ7kNvwF6lpGc&_nc_oc=Adqs4u29v7Vl8VV_PskhHRUOrB8aMBmfnRs30h5lrxPfGrquoKYlzzRzriwEohlXAaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xltkL8fQCB6bpk8k7S-oeWxgFLuuHkXmRN3U7PF5Uzw&oe=69F75356"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCV_10iwP7IQ7kNvwFvhQpi&_nc_oc=AdopJGM_z7EAp1f0AZeXKkTDv1Aujqt7f-bGXSeR-G_AYdSMSNNx5lz3XDdWQu47X8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bR2XAfbjdhaScgLZ5oMFNoh7z
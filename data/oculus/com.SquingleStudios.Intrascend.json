.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_aREF-oeJwQ7kNvwF-spSE&_nc_oc=AdqmdJSwHXogYd8WvtJamO6uZkFUetuiChCvnWQq-mEz49Fm94548tXpi41H505Z-Pg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XnVhl2ceDg0hMydZw0WOAI7kF74ynFupsw1IwMZmbxA&oe=69FDFAC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BA9-YVzg3G4Q7kNvwGRSFd8&_nc_oc=AdrYL5j7MhBYx354R4cfIORTMR22qh7NqTwn0nfMdY6yfo60EHn4ZHFqUsWIUunVg1o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QBebIxpS-ZMw14blqdcJ7hBkLMYqCs7DuIC7pJao_jg&oe=69FDEAD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://squingle.com/privacy-policy-intrascend", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
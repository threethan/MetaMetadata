6JG85U0nAlFGC9SNhrLccN4Zkh_pOEc9S75cOVUA&oe=6A21929E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sveafwOW0cAQ7kNvwH6IO7K&_nc_oc=AdoZQYEzU9y7lznJZhumPGlDhbRdxcnP-UV8S-TErRdEnSZOoF9jppYjZFLXjuH8yjM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PD2nR0YMQqstJw85BPTsJ9qFgdwFWcsLZ7FjwgUm3cA&oe=6A218005"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8ZXpdlBf6cQ7kNvwGp9RzN&_nc_oc=Adpmfbayujppa_W55AXVKspYcVZTXEGbrUkBmgkxKg4WN8cnHZw1l2KjvwFGPbX0N9Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fDS7exWvnBAQFTWH-etiMgnNJsa20pZd24hcYHvfkAA&oe=6A2170C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNpdGOgJQpMQ7kNvwGjzxNm&_nc_oc=AdqGj2GC1KM6K9L0iejWA6T-L8LXhcfEI3E6_7ni5D2R74IOUdSz-0iqvUSTK6YUAL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cIGtmxNpjQzMVQgLNeU4OA-KF8VUVkqabrvMnguFQIA&oe=6A219349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su9lbMJ-H0IQ7kNvwFym4fw&_nc_oc=AdpO9BcenGACn7FE4Xmu188hULXSw8e_EAXqOK5ObKhVa9vPjIdYdSneGDUSE1wYY7A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V751T4vkC4wGsq6V7L3RtcPpDdx-TQdCzjCqqwjnyxw&oe=6A218356"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCdU6Pv0k8AQ7kNvwEZcLXq&_nc_oc=AdozzjbBszTpGDHcHm44bJdy8i6Ylyig0h-gz_CqhTMfhgsOYmyb6P_h2zzvFBHiQIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pEQSPadARI-CjLbl2I0vFsBDJ
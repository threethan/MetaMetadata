e12YSHv3-vs2poZq0Vd0ecS0J6aStrns7shKVc-w&oe=6A940CDE"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFEiGLMg04MQ7kNvwEH2E9z&_nc_oc=AdpFJdOFzckVd5YiPhHygzQy061htKxl3S3B_aIN1IDTtaoSmHKChyM3qfHTE4Wx7vQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiAR82pi0eA3tMz_hYYkSy9P_Hvo0-CEFktrE9lrPAxA&oe=6A93FA45"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s68Gbwg_9QkQ7kNvwF8DNvX&_nc_oc=Adr76wi7y_qMeFk8e66PhsYYeAoHq9FARmpim08xugQgzhEsDMlzj_axifLzZ0nu6VM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET7Ic1sdj2aHTYGdiQyrmV-WV_ZrynegU3GKyL4gDRcQ&oe=6A942340"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oddf9FvW4sQ7kNvwHxAS7C&_nc_oc=Adph_d1YYb1hepOLffh4iKhliti_Pm6fIayIMYAe8l49YMelvUOYhKhnsgZej_bSZu8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5ZchXd3wBjqiaLKkpgljr924tZcXmTTw1vmduWIyoPg&oe=6A940D89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLHV62U3CikQ7kNvwG3_Zbu&_nc_oc=Adooq0chngnHhTlwOUnhf-5378ESg3VS8ZMVunKiuHEw6jOEEHWJQxUGxBCPLZ_Frt8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Rn4143YUWED2JCAYNhTJMXGlW-7Nvnv7xVpeT-T2NA&oe=6A93FD96"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bHNHAJcO4gQ7kNvwFLyd_y&_nc_oc=AdpeSDZ4NSGy7EM9tzITlzdMApsTfNdKjc-RHP-zeaFeY3_mzBzbYMeXzLd08YxyRkQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFynQ-_P0BBS9JzU4e9PJlI7Amc
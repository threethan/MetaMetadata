iyZ1ZQ4cX3kQFZMupSb8F793Fu1Sc0Dx4HuMCqag&oe=6A82E95E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZsbo1zJ14kQ7kNvwEj_wFj&_nc_oc=AdphRd8oLAnUEl2wj_iRrxldw0kCf-pbJd6-vx_Xq7B0xZmGHxJBZ4mWqnfpJv2yThc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyH3RuI74OxD4BiJ6r2h8SlQ67gMimHvwBY2ZhwcjiCQ&oe=6A830F05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbkeLXef8n0Q7kNvwFfBcNj&_nc_oc=Adp88SifCrqaRoBOu7YrdgecQpU_dSYWzm0WmecqnDBwA5BShZJcEmTHvZaA9G5m-fQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyC-EPGhbNDS9K3QjFDRiCoyZd2cGWrIaK0_LBVSTNEQ&oe=6A82FFC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw9mi1Wn5ecQ7kNvwF9sv8_&_nc_oc=Adq09106lRbQ2a-P2uQCnYuwpEmE58evPPaFPHTppXnVnOAbiV9ARcFXxWlYr2OZu8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI3UfjBCOzSzbLVTXTLkuYGgmWXSWy7bQH5b5e5fFY6w&oe=6A82EA09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx3VLcGWkPoQ7kNvwEpkw6w&_nc_oc=Adp3WLPQeiil4E9ilPk_8tdiCqYKQcB9GM7NyTOCc2ll4bIFC27uRpnoo4eHAO3t7Pk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXqKNxK2WMjIcx1DljM9yP4UAE5XsFKeuA5JJDMefcNw&oe=6A831256"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM146nDO5iAQ7kNvwGz_CJN&_nc_oc=Adr2Vw7QH9tUkiFlOZwitAyN5sjsdrjzzzp__wRFeAj5hbUpyu5xgmlUyyNp_ddxOhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLoeEyk4NP-f_7fILj8GJ7yAms
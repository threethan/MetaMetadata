ebqE-FnD3OSSyt4PnsXanefeE9sGAulGO2etr4Cg&oe=6ACBA41E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To9cVwhs5-MQ7kNvwE6WOpU&_nc_oc=AdqUdzg1OkdcXdb4Kbp0Xkqm8NhLkP6BRCPhKU2qb7BbWaSynUmTAYDqLwuJHhpJr60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWEKQeyakrnnogvnlo6JPwTk2oNlhILp4nmA875EQEQA&oe=6ACB9185"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztXr8VqahUgQ7kNvwG36RRl&_nc_oc=Adq89ZHl-BMU47AzKsHLgXIWXiBHnSgnUnAfLuKsjnZzu7HE4tnI_aRHz5U2iwT99Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfzuk7RUQ4gavSxzBdU1EpXl177qwvGA54efmNuzIk5g&oe=6ACBBA80"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvsFffKxn1cQ7kNvwEZjNAN&_nc_oc=AdrcFD5ximxJ7qRFEe0mNLUEtb_-_qFc3_nQ9T5GeWjHIBIevfZ6kmcYEiCyTKcMY8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6hCrXYdxjnbQt9mbUiUHi81U1iLbqVcicdtuA9NXoFw&oe=6ACBA4C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvcDzN7GeesQ7kNvwHba_ca&_nc_oc=Ado-yOqOIUDiiAAPI_vSFrmph8JNI7Bn5yPsYSVgMZjbcagVKvjGyXnW2bpkVR8Z6DE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOcZSePcNSsxEIMSPILbtPsOrubEa1kBvrV6b2X3RR-Q&oe=6ACB94D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6Wb7IjrUaAQ7kNvwEuUsbc&_nc_oc=Adq5Uh7gU3bt3K82Hn3j2tZ8dHexGKoW4KI1Bwl2T7EbnkbmcUfH_fT9l5tP2_Ar5Tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtk0k417pq6ej8clASii0u2WYC
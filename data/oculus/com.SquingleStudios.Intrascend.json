lebf3E62w37zOg1nsIyaA4l8K0oTBVv9s3vD_jVA&oe=6AB3E91E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G1TDXQpONYQ7kNvwFYqn5a&_nc_oc=AdrN0AkfIn9NrGnejMs0dBzJ3tXZKIYQyx9xbXMx-_InGvHobuqFtyQSIFVRdv8lD20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZJcyp2-9e3Yqj26Fyuy9-uJ0TjgG8loocaaSfaVuTEg&oe=6AB3D685"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceorfOYxRqgQ7kNvwEVFxDP&_nc_oc=AdpZqEBQfgSxbf7hX3HgSaGM29hfh_VjM67V3Gu-w9tAvYPPigAG3FXbv0WTDMSBj5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVOe_r3FkxE3YPKYkd7jNAPKOAbxBPIYScUW_dmGY2TQ&oe=6AB3C740"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCUTwBKUxR4Q7kNvwFR-CcS&_nc_oc=Adqqiz1jD56XFWz_D9j2oNnODYLQ38shbxxCVQuHKQ22-iMAfEiCGxlP4Ahw_eUrzHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP1kENyjapRxPI9bYJKX6lMhk3yL6m-eUaEvUsLh9wZw&oe=6AB3E9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rW1CC1J5wEQ7kNvwFilCnz&_nc_oc=AdpKBvf7RhNVc9e1rpoIiqwRTKwvy4y9CgvNgP9U6liItaQDxdfwJZjtXrjEkDv-qVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmYTTGuPZZRmLISRSaL4C8PyJJ6bN_gFpTHJMsZRuAFQ&oe=6AB3D9D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSL11MgSfs8Q7kNvwFRg-L5&_nc_oc=Adrq4uQxJio4k1Uap9E75DSrJhZiX7al__x9CU_VWDA5Jt9332P8-nRnMuWPdiXTwXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl6S4q4Po72bWkY57pw_zJTjko
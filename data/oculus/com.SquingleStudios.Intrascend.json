xtjkV5dFNHH4bukHHWuc5bFUwT1841_jNHEfn2wg&oe=69E63F1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAZSoRLacWIQ7kNvwF8WwJy&_nc_oc=Adod9fDf0axDoAEvgPK4h0b8UY-9rQZMC769Wue43KxSb-EQN1VX5X5aZfzPmZHiUsw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NDOwII2tlmwqwpoVRoS_958pnlJ-3aBmg8HMiyQCDfA&oe=69E62C85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzJ7wrrsj0wQ7kNvwH8eMLQ&_nc_oc=Adr_pGwUZQKTq7_yMdlbGcOnCxQfU3wfpaait6Hw1GSv1Ww8PAlgpJeFi0qzw5YSCbU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0crQ9InWdKg-PT51ndEe8Ifdn0LUU7_5Vkd3jph-MmKg&oe=69E61D40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xy9zEM_el6sQ7kNvwHwsAb0&_nc_oc=Adodf1dm_Vyf1EDfsvmyfdYYH3g155fQAVQaNi101pBEKIR_qAnd9Q6tDLvZysluVI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x9bwFYJNdjAsVMh92YxTpB05RMmj7jwUCorSv643mGA&oe=69E63FC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUXlUakJJTgQ7kNvwFApKOu&_nc_oc=AdpqR5iWFH0d5aJMWFD1GlADR8TVmzjH5puy28TYxuikxsEJe8hn6hyBKeLqy2qKiuI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o6BlF2f15qkEPlgKtXy2ZQhcd4w6e3zsddaAwCEvakQ&oe=69E62FD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JipQJhEkHAkQ7kNvwEaBm61&_nc_oc=AdqIJ7d1lOztUBEH3twUQs2YBE2KALr2rim89QU9JV-h_RHma3UEppuTbmfYKG3CVy4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TrEHDWTLj9B5gWrgEMuhc6COZ
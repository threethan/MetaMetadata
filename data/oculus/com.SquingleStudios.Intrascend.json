hoUspY2ZKTAnIEMucvqLjAN6BPesR1FA8xPBTUog&oe=6A51089E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vef-CHIGUIoQ7kNvwGbIgD3&_nc_oc=Adp5IuEJ-OKSOIRY5ndmkiXyrUvc_i_Ve1dhKxHwrBisO74JU_s2jX8w-z-akgR1YU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx_geZ8QNsmbArHmAixJ4wFkDuECrjB6Moy2-hkwfv5Q&oe=6A50F605"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsd0LQ4u57UQ7kNvwHYGAY5&_nc_oc=AdqM3mRQ-aNc-aciw0dnFL5l8YB47Fa27JX2x-Dv4EJOhaBcVVon_QCcRdA8801ycdY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6Z3NiVwTvHzuQe-p0-l3JRJYcBMnZEmlxe1fWVaCCmw&oe=6A50E6C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQMIApsCztsQ7kNvwHBgfEo&_nc_oc=AdoUEtMJTjc-8FJW8umFs1M-H_TXsdLC_z7L79aGTuiNpk-oSIkj5XFpiET33rJfCi8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0-NtbNk4jWNXv4aZhVJa8ienPm5MypaiuzhnfCaNH1A&oe=6A510949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqulrOO5LksQ7kNvwH_up8n&_nc_oc=AdpL3-SOLKr7vuMf2tM85ZCLCIBJqypk9MPGvkdG5TJuLPQeuewgb6z89DF9f2El6zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYLy4pZ6D4TQclxSCd32RseZ2TT6lRRUGN9DFTjznJsg&oe=6A50F956"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCaVZ9-xOfoQ7kNvwFAQLV5&_nc_oc=AdrwCOC_bXBnWuA_VmBDL40gXrJa9wsJBqtYZkE-3pmVphFhgC-FPWqDlQQCns45Mp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDskj9WGHuvAj-4kfvvtwN5Kzm8
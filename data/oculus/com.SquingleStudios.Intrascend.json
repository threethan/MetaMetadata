wDD673g0Q6jq4H1FTT9u_qtWNIIjsxEjPi7_LWjw&oe=6ACF989E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVN2t31CkFoQ7kNvwHs9EN9&_nc_oc=Adoitk8zpUelEDJBhcjRZRDPcsAMJbYeI_wgCISYczeN4dvJyoHY5si-oErGmW-aPgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnnhgItyV_RnwwQa5ZMFdPXtoCiyG_IJW4EOgM765DuQ&oe=6ACF8605"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIG_wMORrkcQ7kNvwHRGFLG&_nc_oc=Adp9WIn5u3qVzmKIZDScf2BK2BQEjBmh_fPCQJIQ6OCRGEoyGuYhgcc6dP8QbCXr6Fw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzMoXOb3JFKPl_noDTx2yKWE7gsbBVfY3jZ84piNk_2g&oe=6ACFAF00"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U3ia9lC6W4Q7kNvwFwGBxa&_nc_oc=Adrt6Zx0oiYNjuxx_XJ1IXeuh-owrFaE4zfpMnTWV-_0tTkLateoX5R07N-EFXPDENo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN80SDzM3GTvytXy69aJCyc5P3zS5xvc94-g8Ljq0ro-w&oe=6ACF9949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JaKyI8N-tMQ7kNvwH9WDU9&_nc_oc=Adp8S-dhP4zlMEw2xJTFhP2mnD0bPYSilKeWl9FA0ZwUQZ-ZBEwmpES1ZvLEk0N6ZBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnV67sYNC6QklAxasm3Mz1Pz76rUkoo0ec2IspzhuRug&oe=6ACF8956"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tFP8sMgVXQQ7kNvwE7cl7L&_nc_oc=AdrkQugfL8eDY1Nndk05wyFzPpuw2HmEdGBeapaug1rje3UnPAu72xk2WQIEFuxYG34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLSxqei-RlkDl5GsY-Jf5Kkg43
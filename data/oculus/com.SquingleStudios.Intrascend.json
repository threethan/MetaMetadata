uluscdn.com&_nc_ss=7f20f&oh=00_AQTqFKbC18SpU86_hGs7nnyTkFJCMuQMkKX1huJO8ueBJw&oe=6B0328C5"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGGNfiy0Mq4Q7kNvwHo_m-e&_nc_oc=AdpRtrRvhYCgEcMBFwKODwb6n-Z2EE30z1lH2tRf2rwPLW_dqTH6bAUzVdh3AYbUg_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd5626t9JZa-EA-gznhmFuHslYTS5O9sh1phW44PHz4w&oe=6B031980"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHMN68y6WksQ7kNvwECHTUO&_nc_oc=AdpE13KLBmduu5d47T9Aer-_Z2vWraTzow1EOT0q_bSPeZKYrL6dOlHhb1GTA7XCUaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxzUhdRX77R78PEGHkLjT2myQ7WdpmZ5EksK7bJlsPzw&oe=6B0303C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5RWCUtnjssQ7kNvwGuaPH3&_nc_oc=AdozHMf8XwoUWFJMOwUKdWVE3Zw2wU8dmUrc7RXurq9287mVTL2evhZ2LFnMYuO247M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAgo7k5PdOZrtU6N4VKWwlHr_az2soRS5nF47d1qfP7Q&oe=6B032C16"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://squingle.com/privacy-policy-intrascend", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3310702755812169"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "816520792792190"}]}, "baseline_offer": {"id": "816520792792190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668455940, "status": "PUBLISHED", "id": "816520792792190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5584205878281533", "version": "2.04"}, "id": "480711707211537", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5573389716029816", "is_concept": false, "latest_released_b
HhqyVIXxTrfBJkEdi7aiob6Hz4Mr1TayNLAZmNNA&oe=6AA5689E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlOwZLuyUWQQ7kNvwHNDaua&_nc_oc=AdrTI6mJ1MCa9Mrb9Qulx6qUiz9QoveqxPjhWemw8HMsK-rRQNCH7L9an5gm9RTgHic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMDNDhRhBBmoBfWMAOr4nfQPviBHkjwS5J-4Q2uSTJPQ&oe=6AA55605"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RET5SAn1ZOoQ7kNvwHpJLpO&_nc_oc=Adp09qSMzvKHiLFmhwXGrukF4YicLsuihpgI-QLZPMiFQtA6LQp35om4WqLF01ETmbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId2y8D4gtvmZgjGEBF9kYFVnd8q70UoS1JicttbuaSYg&oe=6AA546C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls7StoJ--tEQ7kNvwEhfTyW&_nc_oc=AdrJsyJwqfLm7XXHZijYJiBLdhaKYa4afWaLnCKWjTnpJqilUPjLmOaagx43Y7nsG4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwJETBuuFP1IA6lPiWIhSG6mk5dkEN8Qoq2zoVY7qwbA&oe=6AA56949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCcfH2CtySEQ7kNvwEhgnn4&_nc_oc=AdoI2PwvvQnYyJ_-rS9SCGFF9vuNNWL8oiS8b-2gJFXMeHj7UNMUj70BLcZsgCwLTIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwbiGL5487l6XlzebI4j9jYFFjCryI8hyV_z__HD7UqA&oe=6AA55956"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVB2bYmfmesQ7kNvwEkf-QR&_nc_oc=AdrvfAe9Truia1lz6gut2NqDTVMlsyDAJSDO4OoCo_3o1TF2fpJIWJ8ERPe8PBL27VE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcgzclzwB1j6NYTJ2WpoCmYd74
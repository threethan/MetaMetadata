.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ks_iNLVnRj0Q7kNvwEssfRj&_nc_oc=AdqYH1ImhVjOJHozegQYGpT_By6vqEhgKFgS2aZgvkgYnvJ2jdlB9B0m55rTzeTmmOQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7M_l9D6XbP6Jz09dKxzn2Cjz7J3a_9f8SZszDXwyEqg&oe=6A9ADD49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2mPm9pGWdcQ7kNvwHd0fgw&_nc_oc=AdpxQGtVi-7FbsrD5rAxgZeEC83ifqVhT8PkEStkAkDRiAPXoAVprqonlB9zhCBSyvY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGx_JJZL8QeuBq1FXLUVXXNBbUyn29o6-TDKpXujWArg&oe=6A9ACD56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://squingle.com/privacy-policy-intrascend", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
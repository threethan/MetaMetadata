nFFNLek9C3_3i2q4mMAzSAHJNHkZfLD3c0k0j2rYBRNl91K5Rx73qbiz2rPRPYMw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwY5D5IndkkRIbUqxnxzfBX6QbHnMTF_bClEi2vO-54g&oe=6AFB4316"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-
hAWC67VjMBTX2G1FyNFgL4dUgH99KJPYynA9bgnA&oe=6A08861E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCWMI8e3LO0Q7kNvwEfmvJP&_nc_oc=Adr0rlpN6d-zjJArEV3PTQkLCplnzI07VhkLW4DsNR4VUhjuNL25KbeWO_3NL6Yob0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fl-SzJubRjkbbxFw7nNv104evHbmrnRVG7uEIA8J2jA&oe=6A087385"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW0zpL4Z2P8Q7kNvwEqO8rE&_nc_oc=Ado7Map3BGrE83z9VlnOMgmt6FWM3fyqrsdKV1m0LDfa6g27DbHpi1__RHvHoXpAptk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af685w6QWGYZvvRqWKDgBM7irXFG6BPrV1bAa4JtLmiwJQ&oe=6A086440"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_WyQt7oFboQ7kNvwH7XyWy&_nc_oc=Adpcu33BAmU_d9ue44-dMkKt3GUe0G3Wbl9v5AxBq3lXMFZDYRI-M3WcWJHw0OsVaE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gqbCiIcE4c0im0CgRCc7EGBIDMjM3gQI5G_3GS0gMuw&oe=6A0886C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApgeBFQ77pUQ7kNvwFG5FCf&_nc_oc=AdouCQW2YDZJt5k1q2O2MNDff0rsF8gmFpjGBJrfSvwExHYLI6IYLQyJp8cuh-vgoUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T7vra_TDOAhX_Sxii8kGOcaSwIwpgFmlgUj8K8Mruiw&oe=6A0876D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnjI8ijQJhkQ7kNvwEbTnIq&_nc_oc=AdpuoYRlUyNzHb4QE2m5PpeGrgTptI3qIraP8AJ3k8ZB_XFOz3Ax6U-W-RHptS02nUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CidPimczpdUHlkAq-SAuo1uKC
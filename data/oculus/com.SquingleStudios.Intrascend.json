cFSMst74oOY-NyyM8pSS80pkNRyyCzryFOsEC6bg&oe=6A53AB9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vef-CHIGUIoQ7kNvwGwPAnh&_nc_oc=AdrG4OafaMADAHS8gEF26uOyWVbdlxW0-F0FC88JelNeArhcU8tpyWSbH1FsAlPWWtA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDXscdYLvNVyg0XsfWAcjKbOeEag0_49vjh58_NivkYA&oe=6A539905"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsd0LQ4u57UQ7kNvwEo9y9e&_nc_oc=AdqEjpyYC0HisSu-1FIZuSBAXTsCzbEw2eJz7CxYzZ2af5-vPgIFgMS8x2JTg79Sr3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3UJpowdV0ThDVQNGe0jjoBoGC8zY28RhD1NkyCtG0bA&oe=6A5389C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HEgosdTToEQ7kNvwFfGGU3&_nc_oc=AdpxgqKf-d-6gXCHC2CPwRLKsM4DBpEZTst0CmBZ2_FcZJsEF0yCz4FYgpHj0vs3haE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrMZ9kB9MAlYpCxFaQkk1LQnaNE9DfStRA4h3VQp3RHQ&oe=6A53AC49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzQr8-DzmUQ7kNvwGxwP1q&_nc_oc=Ado_TeOsk52RSCEsqqGa5ejL3rFyqjGMOmgnLtUlR7wI_SMe1PnCdzJWEMcDRy06UiY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW2a8Na9KQuukUiKFKxlJKglZKtQY8xN8nFLgAhNp6iQ&oe=6A539C56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCaVZ9-xOfoQ7kNvwG1e77C&_nc_oc=AdoKFz0pQAxQgZisCIMY4_jL89G8QKhtQAZ4FQZbAZ2EzRNLc4jRuRpQI-f0V8eKsWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgt5Sln3r51MzwNuFVsF4xR0uk
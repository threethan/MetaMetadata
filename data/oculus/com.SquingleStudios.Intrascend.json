pOryRlInSwwVW9d7D56l1sUiRU9n-8XWoY2nAULA&oe=6ABD239E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3fcqMtnO1wQ7kNvwHItGYN&_nc_oc=AdrpvNKhSrlV0il8s9Bg3t-Rv19RED4heu9J4d3Li3yfCqVU1eNbmFXeMVDy8RVKd1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6Yuxovq08ZwZ1HWKEIXwxNBZiOf03kYNJL2KssI65NA&oe=6ABD1105"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TH3Fz5d8AAQ7kNvwGBzs7O&_nc_oc=AdqIMKwrDkr4A8oGM07eTn0NnNIGo1r670ScF9f1xPg47d_ha9p6VC5OxCgfnso9IuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWMIup2P0vWOs8zNt-sqdV64LbxsYytxjP9gc3p0DQ4A&oe=6ABD01C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHXtHUYFPfIQ7kNvwHGDN68&_nc_oc=AdoxUC-azyp3jQpKNiAARQhcPjOePyk09vGZKSjebhgs7gyRQBRsf0bYh294QV6A5j8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_QK8ngFaFybAlcxmglHXnc1hF0p3c87NOBmp2ZXelNw&oe=6ABD2449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BK_rlD-NIMQ7kNvwGT-JKn&_nc_oc=AdqLWcCgG5RHuyXnu_TUcQcY9Yu1puBxFCWPfwB7msetFstQLabnwexrnl1u1XEsn24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEVtA8NvuyZcLYHwRhSKPoUrIzL5gQdHMhrvEapeIhQA&oe=6ABD1456"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr6CdSI-Ce8Q7kNvwGrZh9Y&_nc_oc=AdoB7JCPwCUFAQqq9tFDRfd-lnuCxKf59dSSUvkkSwEq59VTqFLObLQYttcvf0lrcbA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXJIQohhYYvTAN4_oAJXMxqzB_
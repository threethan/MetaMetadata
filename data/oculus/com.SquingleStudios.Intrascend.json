o3rBE0PDcPfMiFFKl0_UGN0fYIiVzqcg67R-rwGQ&oe=6AE4B09E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aI0jr5BLKyQQ7kNvwEs8QDK&_nc_oc=AdpB7OqqOySqc4GcPNsDLJCVKK-Vk4y3yScUMShISkF-iXjOu06aD8DvtiV9AzsirbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuaLxuhkgxtubNnDZz_WGfkAzhVf6k6LWhX-FJC3xOmA&oe=6AE49E05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_Pn7pdPjZUQ7kNvwEx0sLQ&_nc_oc=AdpdoTO1FLRJVgs2i3dcORPqcsho8nyEUlMT0RvqGofDDWuf4tapWil3LG3BWsxbn1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwBsrUALIp0FARUmLxoTUzBF7qAdVxS38kAQPoNtL5bg&oe=6AE48EC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnyJEgz-veYQ7kNvwEVnn_Z&_nc_oc=AdrBW3ORPCnVe9Ipzx3IgrZ2ogELC3VeK9kEffN1KCZH8E5khkZs65M0p8_uhpJDl28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9zIctIOngI87GxdtT0FP0ELLT7ZQrDTZTIuBMsZ5F-g&oe=6AE4B149"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPvKa6e2eyIQ7kNvwFjRL4h&_nc_oc=AdrMJfU_gAlsh1Cue8b9wlJzq1wpn2YfCT6Wagse6UYq0ghS93r0fWFOgy0vQie--K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsVg1e34hiGHoUgyF1IKQDWN_hEXI_nhDpEYHPUho0mg&oe=6AE4A156"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOMBP6TqfOMQ7kNvwHsDbGs&_nc_oc=Adq_9mYRQUwTBJaWM54R_K9Sj7XaMn4nZehrvbvR_ZDEwAqeLaP4XBmW-gqXwUaHhhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYJ2ZCySLkm_2aq5-lZN4b6jEs
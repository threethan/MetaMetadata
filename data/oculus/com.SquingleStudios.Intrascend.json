BjzoTY4N87H1PEvZIngrFDNtpYw5HhzgtELOrwJA&oe=6A009D1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ovzTCqKyHMQ7kNvwEWyD4a&_nc_oc=AdqjGNktcdyvSUmtkoDRtobNlokdE2QPJXKAowgu7eS6UIgY9jR-rmCqLNmgPsM_uxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I8IECMJbB0Hb8GPdSxt4nv9jEeLfKbIqcfaGUBSOJ2w&oe=6A008A85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaxnx0-JrJMQ7kNvwECaxev&_nc_oc=Adr_kCQEoJoX79vFo4TstPPb0oOgbSfCMWs1_KITn9o6EFPfutKouapZSrKIQ2WA6vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RzovJEk5k7c_MiTgEqVNycwVI5f5aAsINByb8X1_eEQ&oe=6A007B40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MpYrNJZa3MQ7kNvwFV64QT&_nc_oc=AdoKhzdb8D0HGodlcQGcOY97ImqAXbg9k1wO163ueq8wbew85ExxJGldzHaclUvMubc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63oSkJFd9IOY_w95ATVSpul_NEjM9MVxZdprwey6cIjw&oe=6A009DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uphvic5ALjYQ7kNvwG4Ztrq&_nc_oc=AdrFNeP8sO9bp3VEWFNEd-sn8mJR5t7gmlZjb0H_KToaGYUqSlgVIh1JGv1nYG8J3RM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S4c7LAsYGqwnIZAzODU55HzZcRQtvj6b8eMuQhuw5TA&oe=6A008DD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOVzRj9U7dcQ7kNvwFCIX5k&_nc_oc=Adqy09VyZFTNFno0RJZ7cB5uRsCdIfYjcjQJGVzJ66Ta7i36NLnEpmbTR1NCjKl6vjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QiY22B8J3P7zTslLYJWLFg9_i
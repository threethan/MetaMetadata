uluscdn.com&_nc_ss=7f20f&oh=00_AQSOOvL0YMaXPwx7SI7kG6QX8C3eRUHCaAbsKhR3pQkYWg&oe=6AFC9145"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sfhCwG0qxIQ7kNvwH47XKg&_nc_oc=AdpiU2L478ogpm5SbXKlwZGURk3ZvjHYAx88LNx37RpWTTPL76OgbbgWaqUOeFmTAUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSozYWMwsvJ_Tur6sTXhblclmtT34cq3dtacyDzCUgCLw&oe=6AFC8200"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcNecUgY3hkQ7kNvwFx7lmk&_nc_oc=AdqVdM77qVjJLI8oDuEsKtO_PkQ9AKtPGDG7tjJZz-lxT99GAY7YwAXGALEqjwN299s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6nguGAthUMcmCklR6rZTs5MYqlQzV11ICScF4WLyEJA&oe=6AFC6C49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEsmcARCv64Q7kNvwHYccHj&_nc_oc=Adp1Ed8R889SMj6cgV6RZ4Rkd67uNo1Fl-H0H1HxZ3Q54QNR_hL03k6dDDwSanYe65Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUXE6Jm7J_10YYd37y6BS5caTmLF-ICpyQwBWRr9po7w&oe=6AFC9496"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://squingle.com/privacy-policy-intrascend", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3310702755812169"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "816520792792190"}]}, "baseline_offer": {"id": "816520792792190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668455940, "status": "PUBLISHED", "id": "816520792792190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5584205878281533", "version": "2.04"}, "id": "480711707211537", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5573389716029816", "is_concept": false, "latest_released_b
V43Nqsn-enevLWTJDBgLR_-65c_Y79vk8MRo_ZcA&oe=6A26D89E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAeC71LR1O8Q7kNvwES_JCJ&_nc_oc=AdpdtEF9K8Suh4Kd3F_zpAgb9e2Uo01MsSkwqS-BR_352un4ntQqvtlB4OD-6wJMKic&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eDpRtqSfYnrTvnBh0aZKmK7V4hBA7jgqAep2dmYQMPA&oe=6A26C605"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hlww9gSaUoQ7kNvwEnAqxY&_nc_oc=AdrBUEPz0SVNCqSMwr6OcSFGJ9kmg4yhwoifoFd8eJ5UMEe16w-Ocy2MiT-wtdd5RQM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AClGnVWPOgcoRlst0g1tZ85YHw9c40UGwajRpoUctDQ&oe=6A26EF00"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z-t_ktnlfMQ7kNvwH8JZYw&_nc_oc=AdqW2i0PN1-XmVWwN7TVCfvXFBRR6iSHbKAV4uFXZjCVFSGOjvL1UBHeb0FnVOxerrE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n5713AFmupo8LFKnwOV2ekVkPJDl6XjFpMVD9zJ5lqg&oe=6A26D949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HPRAMEGdboQ7kNvwHPbBV-&_nc_oc=AdpWHXYIYvgYcCkhd5hnmzrVl8FvD5ctF62B8sejytLP33tWjIp8F1C_udBH-8WKqNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z9swRqk6ih73uwdKKSSL-m97vQXbNDBak-i9JTNBUQg&oe=6A26C956"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkw2WOVOuk0Q7kNvwFK8Vey&_nc_oc=AdoE1ZKNX56oPO-PbH_5OX6vtQHIt_NSHFqdUtjfZAeKX3fgah8hRFJgfflbGcRQ23g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yf_IVpuk3atQmcaPcxk8EYoGY
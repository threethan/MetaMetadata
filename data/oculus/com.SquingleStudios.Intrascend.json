mF57BaUvCDj9RboBSg2XbRLDXQ0Fl7aW3VKKU4Bg&oe=69F8B41E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_XcOKqx2WkQ7kNvwGgDP0O&_nc_oc=AdpheNPRIl12f6xzfCV2ED1GI6ck3H-EewUTX3jyDVLsZYZrK-dUpBZqVBthn7iCurQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Be-9rUaRV1pwmJJpULszluDO6ZJ240I1fiq_5C5lRSA&oe=69F8A185"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikacF5Itl_gQ7kNvwGzWSf7&_nc_oc=AdrmLbYZOpwah9SdCHxjQTeyZqjgUB27Pvu0SJBwxKR9uAelkkdUsmXuf7ddQ7t34kk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ISqh-G_bzeXJWeUyRBTATJzrmkyFJOdP-mKvCFxU4pA&oe=69F89240"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7Ndc4zUf3kQ7kNvwFSpeID&_nc_oc=AdqzXDBK79rXwaShKGXCz3Hvq-Du89s4PNiYHWqkDfyam3_qbfrjXXNjeSZbdHMfIzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fWO-X15TRG9x_shoRgNZzzLocLHlyfy3Vv0jikAQycA&oe=69F8B4C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfGsd3UReb0Q7kNvwG2HWPO&_nc_oc=AdrKOKq1KWz7osQmPwzhIGgtiESIpRnz8lC_MzFqmZTVIwP9ChCLKCGCwT7OrYxNmDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15OCQmXYRmT54ZcuVb9_b1Z8S2nu-cqtbu2F6lJQDdrw&oe=69F8A4D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCV_10iwP7IQ7kNvwF26Uwa&_nc_oc=AdpjCoqL_a9KZwbbpkLwdnuw-gxMQjVdvbyhdXkk1otVkMsMKnv_m7PcKV9Up9lBsbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eCzzaYvrXZF0-jq3zWQumsFuM
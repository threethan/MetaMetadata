2JcVj1rceBb_bbELYKDrPt7pMxpXijQeQ92-RKaA&oe=69CBA8DE"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OQkxfMD5UIQ7kNvwFT0qwr&_nc_oc=AdrSJmbmeeIl87KNMQ-RR67Zr22GCIqGuWFR5zl3GNPRULEgHCl3kcX-GSwpEC5z-6g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMY8252kc2X0mZFdLycksp5kPHzzRVhVOdE0ClKseEXw&oe=69CBCE85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrrJ1zG9SPcQ7kNvwElo7Yk&_nc_oc=AdrE3q2qRLBvswEt8iupga_RZyp8-HrdOxiKgpXVJeOcSyYzwBVDP4RxeIqNHlnFwrI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAyT2lenWV5X5z-XDC_1LkZEqYbE7DUTafEVGz1n-wbA&oe=69CBBF40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUhOl6fo7uUQ7kNvwHfnK1_&_nc_oc=AdoICUOJycbt-LIi36bn9D0WXiQL_6K5mgCZ--KZOvr4xUNQ98x2wWixIxAWkMdWvLs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhC9L6y66RUcVILriTq7ai6AyFRT6OQwwqeVaTs9GZyA&oe=69CBA989"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI_2IaNFJIcQ7kNvwHndkjW&_nc_oc=AdrmyhZ2vJXC3CuTh-HffFXC1GowryfiEsWeEDpVvPTN5Pz7o7OgBLVKCU0tvY9x1lY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZwhNAV-zUPy7y5CszWsXy-wumWJzlenK6IT17FbhCMg&oe=69CBD1D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnIeglJijs0Q7kNvwE7FOQL&_nc_oc=AdoiXtjr6voM3LVpYnhd8KQit5YjQlBeBQ9OYVoR6rGaeQCsPZ-Gg2vbrDfBc4I82Bo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkQ7SHE1_Mq_XKAbMxbGEW-o5l
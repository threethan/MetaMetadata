0ObltW5oIRN8b9k914ZrRVFEOtdrKUBHZIRKyPRg&oe=69C3BFDE"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj7MgK-9zjUQ7kNvwFYdfKX&_nc_oc=AdrISEspFxDbwmqRhfeg5tNgYhSkwoHg1EcPD4ZppJD-ICk-bLPe1ZuKKrbteeEzjzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxh5ejyCK1CmSHyV7Wf_2F88PuAsVaGWgq2GaEBS6HxpA&oe=69C3E585"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwTj8_odjakQ7kNvwHdQ04A&_nc_oc=AdrjspzX13e6Kf6TlDsfmGuaMMaWIKSnJvuj2_OpNiSx9KhZvxrKzjYmchq14j6ZrEs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfythIHr7doBL_bEXuuOwddstgLR8shzBB7eJf59f0fkyg&oe=69C3D640"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Hhbup11ucQ7kNvwEbPpmd&_nc_oc=AdpLo7MEP9cL8NtfsVvlv2BCqPZm43KPBqwVsPeWiHDofrRMFTCYfWJIixKrn2Hgl84&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtUccCV_pNB2aIJ_POir91jVimLNsZajHlEP0MP5yzaA&oe=69C3C089"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjd9uMt4iMMQ7kNvwESFXKh&_nc_oc=Adq3e6-NexFR57L4ImFAxuJyS_mS5CWWmlA1c15xtQAmvWM0WjyGj32bWbP8JCoVJzg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE87nfYiNo1HByZnbn1FegHpvKshizcvg2F8WkxnooXA&oe=69C3E8D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu0J54yzwOgQ7kNvwEBR2CF&_nc_oc=AdoGBGDTC6DgQfl6SNs_NVowbsF1OZYP2LigNQpJ5EB9xQGP5rYnpPMRZuUpNBuxg6w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywQS_47Ge2-BouB0KtA5JNc_ym
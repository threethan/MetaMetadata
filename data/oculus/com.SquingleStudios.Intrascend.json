B4jLnlUrmC7L7pGWDIYWotQP_0ydTrXZ9CJi5-AA&oe=69F4BF9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPSNkxuUAZIQ7kNvwFW06S0&_nc_oc=Adq1H2gIw8N3q9bgFiRCklmafEm0CTDZidtYL5sPlEQFGDlEOqlXDfyCQnb7gttGcmY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0LdY8wwaxj103xN7Wda67ivUZyTuXbphs2Mlsgdbfc1w&oe=69F4AD05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiC17chlSmIQ7kNvwH6YFol&_nc_oc=Adq1_yIc8onZpV2AyFdytALMKn0aY6xzJtV6q_1aDaH1Gdc1utUgNOBF8eQt3L0qqdk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29ProTQvBTtvD1RfKE2KZpdbIK714i2FU8E_XGlw09HQ&oe=69F49DC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i97G7Z9oWHYQ7kNvwHLdktn&_nc_oc=Adp8qlYbc2Dyl0o8SlPNF8jHwQR-lyAH9dImYn5NcTGUo0ESmwIjItheUdQgmoI1XTs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ECTK3WfD5v_Nx0F5YsPXevpYESGi7lR49MSbG29n2UA&oe=69F4C049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akY6T88vrFYQ7kNvwEIJvqF&_nc_oc=Adp7Z4gRckoi8o-cVwm-QlNfLcU-EuSW4GGHlJQtnXz7UlZsXG2hJTpFJ3qBScLYNHE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nN-CWG6u8a41YhAdMQ5M-QwXXN8VVtZ1VcjEu6VdGvg&oe=69F4B056"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z44T7SxVcL0Q7kNvwGV6YBu&_nc_oc=AdrMY1K8sAXVHFu4RQOhD57LwClFjtBV-LltwumWqLjywsB3Hx2uUbeCDtt8jxOrbk0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04ONp3w51Qeif4Ya1z85ary0z8
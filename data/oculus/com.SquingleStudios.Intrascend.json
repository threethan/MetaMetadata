Z0kDDX6dVLEKxdabj9BHESkOS1-Jc-pnXJVNGfSQ&oe=6ADE191E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDd-Oe71RlUQ7kNvwEVjjLn&_nc_oc=Adrz23m8oOIbPHeE_3lCPvSxBPLFhrZpx7k3vWcuAv7CPss7o20Up2McmGChzXejsLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN247n8xralwFbBLApnNJ5MzhL5rm-iPrB0Yk2RvDVGLg&oe=6ADE0685"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShW3tm4KB5kQ7kNvwFNYGOe&_nc_oc=AdodCEcteHcdV2t5GO1h0xHjgqLxRxyA5weCutNCVnzCKgvPTvatB7V6-I5C0zSGcRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA7M9yqCX_yGfiz6US8WZCNgjSpBfguA3PHV2KonF1pA&oe=6ADDF740"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA0ftspqYLEQ7kNvwFTdoyh&_nc_oc=AdrGR0la7ex5t-e-ZiFtUnliU0-9pZ_x6GgB-95zHW2-XNLf0zwpjRyN7tlUC0iiKvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI0Aa5qrWtDhz0pat8tx4EER0xlo2Um6vHW0b1IfIjOg&oe=6ADE19C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zmatc7Q2fiAQ7kNvwGjxWUM&_nc_oc=AdrcGp0n-MEA2Hq4H9_mHh-yA_Hwdr5SJyucMw_pKz6imIXOMHN96A_YN-NDBNpIdZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq2IhvniQqpGP_WTEvlgrUWe0onAgGmUo3QjdZJ19T3Q&oe=6ADE09D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je9alrYbTY4Q7kNvwH1JtDD&_nc_oc=AdoQLpQwdKRW8sZ6Q9ZbfMVDZ6hizHreBKpFJR45rf2_R93l4B7u_hJobLLqWrrz1QU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYTrvn04jbaBoJcU83wfY4AJJn
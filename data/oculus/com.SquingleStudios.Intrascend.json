d30BIZ0ZNDDTTTaq8U_r6bQ3NBXtLMfmgNEIcxIQ&oe=6AE8A51E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fexNNDI90U8Q7kNvwHqgwJL&_nc_oc=Adpe3Ax4VrH8m3YemqNRxCHj36WkfxPKW8p5MyqooFm6CHjp46f-wbg4QcvnP5_I6R0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS49g-7B34JGujMFUQX9xXTZznaQRX35FukjsiAjz9w1Q&oe=6AE89285"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10GiRvURVF0Q7kNvwGJxwfI&_nc_oc=Adrksl9a1k8qVnYznZCj2GIKPgt8qISOpbdet60tILgeEpSxvJmhuKWDim_SL5mfdic&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSfrQbyXE9Akg50-Jlan1DHSnONco9Cf6yTCAs4uvMIQ&oe=6AE8BB80"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDqbuy834pkQ7kNvwGS-rKJ&_nc_oc=Adp3965tlhqGo2vtQjpZ4vGsL1wnWWVKvfzhapqBRKs8eC-8OKKeC5a8G4oCJAceyxg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpyIZ6tLiswt-0ypJeY-9I1YoeZBt5bETMvmNRSdVeGg&oe=6AE8A5C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE0Qt9q2EfAQ7kNvwFIfN5V&_nc_oc=Adp1AAjk6wWWoEGjBqMbKhalu0Jg8LSfpAc9w215VIBAUq5QqGHtuigFSgEy9SYGBlI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7d6t0d438v_nBl80Unszpy85ytsm_bvjdBwVnTWDbng&oe=6AE895D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mrKtO9cZpoQ7kNvwHWj-Dy&_nc_oc=AdrjkkGQR6bx7vFF185hPOVWuu7EqFG8ahLvERYLTPFTHsjSOGbXqy4V47-ipOX0F7Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfD2_mg9rifho4zvBZMA_hxdnR
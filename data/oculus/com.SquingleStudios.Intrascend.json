NIP76939WUQXen2fDhogYC1qo_synJ_Xf61Qi5kQ&oe=6A2D701E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-PiGuzdCCoQ7kNvwEpft53&_nc_oc=Adr5tpASGIjrNvK57Q2-ZdJFbDL_OV35lqn2EXOcVUn6CoJdeTPmEoSprswwEl-MxFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-721Fe_h3ekRWyGWf7VfAi8yegYqvk36_WvtYzeDYGsw&oe=6A2D5D85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nr--piAy4cQ7kNvwEpNBT9&_nc_oc=AdqwW1StKiu1YfMBIjvMModb_GGsOBALNulc04oN_fBVZkz4N0601RCy5DglpGlBF_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dNWAHGNKuTzI24eY1jJuOJ50SCHQfepPFcW8CZn9_sw&oe=6A2D4E40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RenIvDtEK0Q7kNvwEBCYlu&_nc_oc=Ado6n4yQk158n24WYoOvwsX827DAxGpP4yUObAAw6gxsjozLz0DXVvKMbdRspwDeor0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iG2Vn-YefJz_9_QYA5M14Kw9KGtSwHG4RnOFaus0Sug&oe=6A2D70C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPjlqbtDrWIQ7kNvwH0nQ_F&_nc_oc=AdpmtadYqd_CF4NrusOadygRyt7hr6swhMJKS3sfl7aS-l08Y_D9K-KrtACEu1wJPkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RUi1pEElOLCJ8PjqMtkIwM0z4kyTOQnyx-i-WYJ7O_Q&oe=6A2D60D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XExUBCjNRUoQ7kNvwESPt4Z&_nc_oc=AdrYhT5t89y_DFEMMwWAVI8VgO7omtD1WujGOR6dNm4Vpwa-GHeMaUbRbKxICVM80VA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eyNQxElr8wKUAH5LoOqb1JQhT
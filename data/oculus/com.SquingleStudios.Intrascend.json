ZmVpIrI9PWEazxBlmyWUOJAhhlSM2JO4VXCKBnlA&oe=6A525A1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vef-CHIGUIoQ7kNvwEl4Jmx&_nc_oc=AdoQPLxqxp91GGwSbYLKKaKJS8g_d4zMs9kfxFpNwJ3tV6SKD6pgxtWUeuZIA-w1fYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRI1xEBjy_tckR8rMLH-8qVxa1nvxoZLBOxVsOaZCHIQ&oe=6A524785"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsd0LQ4u57UQ7kNvwFNTnBd&_nc_oc=AdoDEkV1w6NXbXrNcCB_G0uzeYZNMRH-mj5r-6KwCQ6ROxtHCEzp2RJG01urvSg_Sgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYNPJObZWuui6SLwGh42WkgbJCCJyOz3t-r2o6fVK8SA&oe=6A523840"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQMIApsCztsQ7kNvwHS2dk_&_nc_oc=Adqi8ja-LLSWyDCNYdRVr3btMFVxDQU98TyNtD6cmCX39Ts9vT3aPsaSLVLP3PGZzMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA04P4g9zKEN57mkgscFzqIuERXqbXI3SQ8OZowXbwdqg&oe=6A525AC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqulrOO5LksQ7kNvwGOkR6a&_nc_oc=AdoMK_JCVGK_G4jIRrxd4T7S7fXATo36DJkEcIRp1qm8PNUvV5ILV7Ao4Bn375t5v_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA6n_GcrDWOjoNi42fqHPE9GGGNSQuFCOWgBCFlbS9pQ&oe=6A524AD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCaVZ9-xOfoQ7kNvwF-oIYz&_nc_oc=AdrZAZq3C42czlxfMJkftBAvABjYF-cZFde8jLLnzj7S3UdwOaOrvzU1COmQo44BTIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVy-imIsxp5jhk4dZULaNdtRw7
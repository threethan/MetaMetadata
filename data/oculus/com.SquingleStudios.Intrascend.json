-v5WeEE7IZCRTlgrPXGBS1hx9wZkez-l-OXFIYuA&oe=6A9C2E1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDXtdxtOAUAQ7kNvwHqoKkU&_nc_oc=AdocIMW867M9wq467tyqXWIfCmHx_Q-cLb81IUtcE5dmjxjBbLg2EmsMaZAQFy7ilE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKueVLouaMKz-5LNaXeArmOIgV59r4brMbJ3jKwYbC62w&oe=6A9C1B85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3QTQ0Swm2gQ7kNvwEshQeR&_nc_oc=AdoYSQ9weePeJFwq-OChrkLMccKwOPln3r7QyDrqEUsfDRgSlH4oWNUuXqYhOmLadhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII4CLJl1C5SJcxWFvhBty5e0uI1QKIlunxr5MzUmJwRg&oe=6A9C0C40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ks_iNLVnRj0Q7kNvwHN78OM&_nc_oc=Adr8mAxE6ONqomZ-l_N7TMwicTfUY2HmeoyLIRdVnTm0X7wnfHeRYWyLfmL8xuyNJ2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIck_Rjd6WaGjrHxkoIPhPXZwdsXfl6PWVV8maNS3DTCw&oe=6A9C2EC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2mPm9pGWdcQ7kNvwEhvnWK&_nc_oc=AdqmECUJ8LzKAM8pthNFYdB5oXfi-EHhlXVN7hscof3d1O7zNBnBS_Pfi6NOdcadsPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIN4XzcEwZehhgG2JORuFkFVbOrKleBscGGQEi9HYI0A&oe=6A9C1ED6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG26bOClhc8Q7kNvwEh6JK9&_nc_oc=AdpJgVXaY-NNxx0Vzwj1h48H678czvIwoY1KJZdLNJXj-nBzq288G6CfMQZAhDHz7EQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEsVc9q3S5skNYamOoDmtSN_LJ
Oq6sAr2l4ooHxyH8Bj78eW53gY4mAAZRSg-kr8eQ&oe=6AF5D41E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDaKxekW0fkQ7kNvwHCk0gO&_nc_oc=Adq2q9tycRAnj2vzvYvX1xQaWdqr-y1zpi-4-H3_N-MinozHnTCSpoaJUS5iO-cB480&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi04spFY6WgF7pYjpwvxQcdyzW5zSD_rY5mW0Wjhqivw&oe=6AF5C185"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhxHMUISKYwQ7kNvwGyHA3Y&_nc_oc=Adpu3S0o2oP3kJ_uWwi475oBiHp37HdpKDAgWXHQj7KH4oeUkyy0IJMEhBp-FSFM-zA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCJ1o-C6trZd8EOGvoxDoa8-BzybfLedhI-KLh4jHSFw&oe=6AF5EA80"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBmgjh9SXngQ7kNvwF5wjgY&_nc_oc=Adp5JIN1U2fHsolRcgDc3wF7uNpVWCk0qAlzUO8GtKh-7SZxbwOZGfFAqotSANKKspE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCyGtpcP4gOt9moYSBJiaLL7Sv_v3_4NwtCs18zIO8KA&oe=6AF5D4C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBqf7F6PUWMQ7kNvwF4VD7Z&_nc_oc=Adpb3xj_bIwSSgfdOYYVwjEMOJQCUbq7Oln8pfpOpAPYTwXX66Wf4fxaHkkdN2yON14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY1UsjIs4vbSluBBn0BKdMSNlPCDS4aI7ZDHEFkWlRUg&oe=6AF5C4D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4m9HliVj2wQ7kNvwHt47h8&_nc_oc=Adozmuuk4sXR8KP3_GmRVqNO9k2vCXSfzNW7abMkwRVmzAwuNYUVI2Y41M5UI93-rMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN3PN8V7sL36c1-3RcP3bcoN-q
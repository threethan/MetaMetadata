BxHvyg3HRUZlHIRC1qfvc34pqupcN-mtuOuiEt_g&oe=6AE20D9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZLx7ctzBiUQ7kNvwFvO0YE&_nc_oc=AdoiCMLSg8Jx00y9sgZtKbTWUsAsyJ18acTKNL4sFr69MpjRVog37l5n_NpzqKA9aq0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZWjJsiAV9Iv1nO4eyM5fKb1mq1WZhKuaQBBYExs-MHA&oe=6AE1FB05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdEm6Ct_alQQ7kNvwGnTEUC&_nc_oc=AdoNo0g7pUbfHu7k5ja88swi9KViSxkgavZ7koh9u7KqKeKf7jRJskKapiXxH5EAQGU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdUCGgDbkWMhHEiDIU6CTfcYpVJycJfuaHB7xXMXLM4Q&oe=6AE1EBC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnyJEgz-veYQ7kNvwFK2il-&_nc_oc=Adr_iONx781SGdDEg8ckW55txxbGsKWOrnaNYSotIn9jxA40DavD0DXVzkv8DLU9OtM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9rIg7jQhT9NnQ2GJb-Qep2t9Z0iCs2Ey5nd0UxErtGg&oe=6AE20E49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPvKa6e2eyIQ7kNvwF1BlNl&_nc_oc=Adr6M81xeX8ta8EtZDBuWe0oHzfWuaLHbWHTLrlxTuKMFFS0AI6KF9Ivvu9VZk93iwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3OV10rLLA751QZwLn8Yq4el8DCy5oArBGSTtofA2fzw&oe=6AE1FE56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qAMqBBuxcEQ7kNvwEhbqVW&_nc_oc=Ado5lH3dFEFSSIvBGuKxYZCzOHIqJ4eZ7Yj6NJdVlePaCb8X8GS_XwRXW45ulsM4h9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdaep69bi9MBRsXD3qeUtuQx19
3F0J26Oj0zkmAHHzdG26We6dMYYCh4BagX-pOEOA&oe=6A54FD1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFIWXfG7BNQQ7kNvwFU8you&_nc_oc=AdrnShQNREyG4q_DQV9ZEm546-YBl4uJ8_-iHYa_sTSGCP6ZyIsQW-gIpSX_idEwadQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOZhu0dPk6xdD8BowdY6bNHEQjJnS4PkBlUHusS-_Mxg&oe=6A54EA85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9VUtRgvJPUQ7kNvwEvmOL3&_nc_oc=AdpTPFe6NpAuAErozI4qZsxa3FMQVvAr84fWvThKoUyCGsFLVtBSgGxPBW7iXEIHiR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB6LCWTV2StBl_B8w_UbvefpIj88k_H9Ez3sBmARXvcw&oe=6A54DB40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HEgosdTToEQ7kNvwGqrwsi&_nc_oc=AdqaH9TZ8TFv7XMI8NM5kLyk5Bs-yOFL_H8fIT16S99ko_izmXmgywcbaednITyZ-Jo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaiQ4DKTmuFCmYusZ4CCDoxt4zDt0pK8Vo-CFiieKCUw&oe=6A54FDC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzQr8-DzmUQ7kNvwEK0FsG&_nc_oc=Ado69X9kNhS-OzrllQJUac80djkBxm12MKWJ70cSk27uFkvULi-I74kUjLvK5362D0k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3bDr_kbhJmegCTQJ408wM6LyXe0eXDQ6bYlG9mCRhYw&oe=6A54EDD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiIK76O6X7EQ7kNvwHUx9db&_nc_oc=Adqq2di6MUgBJ7lFsOefcx3DGA4IUgCK5kMY2JIWFD5K2yxQ4_Pn4vQO3-k9Wy_9SD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcoDN4lVFN7juJCtiS65CggZFP
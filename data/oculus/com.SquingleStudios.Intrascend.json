mJ3FA33Jw-ueb7dj2DzXG7pfKdCi0sLATTY27vTQ&oe=6A07349E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCWMI8e3LO0Q7kNvwFXlkJM&_nc_oc=AdoUdTJcHSNn5wGlGOqs-2xGlf6aRxBbFOquLpcvHR4rrKS7WMp7vNoKyQ1iQy2uTFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o6Y_1V5dwfR5Wtey6TgyFOm7Aor72_UzNBm_yBnK3jQ&oe=6A072205"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW0zpL4Z2P8Q7kNvwF3Mt3d&_nc_oc=AdqZ9_2Uih-cDnhqKqW1kDRIWRFXVNAjzxrSMHhLwRLQo1N87pC-NZ8NkuMPYjbBH5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J4QNOdUcHTUlg6AQdzxxXz09Gq3vsOle2WxnruwxG_A&oe=6A0712C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpKnLdxFyJYQ7kNvwE_YtR5&_nc_oc=AdqjhQIq0k4_5eOKXFdqGgdOrSYfncDiEA8vNXeoXiAQHV0yJr2rrH0xH2-wOzIUS5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LzU6kMxqwEeh-Af5m4uKsNimLDF1MtLh1HD-dWPOrKw&oe=6A073549"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9NXrjLT5U0Q7kNvwEeoi5A&_nc_oc=AdrD-yOrks4bEHC2UQM9x1_nLxCtqVRRZuTOZUFo0ojrX4_pdHegOUzSrZK8y0cxcMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zehmxqg3_jrUba4uG2jqTh1HtL1g6uHroehmyASaMFw&oe=6A072556"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnjI8ijQJhkQ7kNvwHvfYMI&_nc_oc=AdosLH84lEE2p26ZpHAuhq9LLBBLKHHlQSeUL2eJZBZr6_qqwMh5Ppww3NTwgtQv8sA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af446pnt1W-LutiemNoyPMXZDssN
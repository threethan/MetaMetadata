ALTHN77Idc1goHQf1ADmeg6Sni-6YV3gzzeye3Ig&oe=6AF1DF9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ukAuw6QuQYQ7kNvwEHVbJb&_nc_oc=AdqzZ7Nwd7IfS2dxAsAuYz_Fk9fBXYasw3kqp_BH0yCOEyUtsm0rB5HYu8NaKFFLfWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg5fO0hxSl9JiSJQXoH8wxhsqLRFRN4Ibn11xWpEkoXw&oe=6AF20545"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqElSuvJ-RQQ7kNvwGiwpCl&_nc_oc=AdoJ_DtjlNMtb6OPD3FPTb9lKMMmi2p8Pgn9RvULfxXy7dkQw7p1xZ7tiOcC5eXOg8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_tnyk2dg-CgKyo2oTwmUbPnJtUSN9-WUYeMkmt6jM5A&oe=6AF1F600"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eefSn5bCI0IQ7kNvwGiVjwi&_nc_oc=Adr5LnQzP0skQ7cZTqG43G3Ci-6-L4V9SR941Tg_9PbPM8wUixO1OFOesBzzbuXI1Zs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlPX9lMFzpYSvsgonrGXbTGTnULheQeraJFadWs9mP-A&oe=6AF1E049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpeBZOTDHCgQ7kNvwGxiOhZ&_nc_oc=AdqcQotXuKFpctVVYqkWNEx7ygE-cmfppRw-aiyr0QVqVunKrbpWL6ezE-l6cKxxWT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSLODg4c7InL5mWp1diZW4xryO3QTlw1DPWF2Cg9b_WA&oe=6AF20896"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjYxVOIYsC0Q7kNvwG-bRpf&_nc_oc=AdoVjDBqD7MoSLbYzQIgTSd0BKfRv3Wc7MnBSRdHOlRnTdlqrBEVF7-ww2XcK0Z4X5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5v4sX3nn6YX38QDR7NkzyMBFw
yqakekdnCJ1T-arFP7tSo1tjd4ED8RwdaUBkJtIw&oe=69FDFA1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ovzTCqKyHMQ7kNvwGLvzjs&_nc_oc=AdrMMHhbSU7LE-x3bFhMu7-s_bLz4OX5nIHH4nlQoVmcGPvotAZXA0A-t-n-UZrgv8Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B9Zkesgs4Wjc_GHnPENdjxQT22a0VlK821PBO1zy4uA&oe=69FDE785"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaxnx0-JrJMQ7kNvwGE8smA&_nc_oc=AdoUXV3kiAGj5XdF5UrfIgfjwG-RbcX_eMWnY4gz01Rp87UDPG9jBCNgQZJQasJc9yg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HkYxx4ZTNFZPtm50DaOiYMqmXcFSvUCIjnlWyxa-O5Q&oe=69FDD840"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_aREF-oeJwQ7kNvwF-spSE&_nc_oc=AdqmdJSwHXogYd8WvtJamO6uZkFUetuiChCvnWQq-mEz49Fm94548tXpi41H505Z-Pg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XnVhl2ceDg0hMydZw0WOAI7kF74ynFupsw1IwMZmbxA&oe=69FDFAC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BA9-YVzg3G4Q7kNvwGRSFd8&_nc_oc=AdrYL5j7MhBYx354R4cfIORTMR22qh7NqTwn0nfMdY6yfo60EHn4ZHFqUsWIUunVg1o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QBebIxpS-ZMw14blqdcJ7hBkLMYqCs7DuIC7pJao_jg&oe=69FDEAD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOVzRj9U7dcQ7kNvwGGZHzq&_nc_oc=Adov--0YAZblJjO1bymS9khNEHTUPIoaN0UbAl2NSG60a-8ULP4NijcnVxU_OklcpQY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z2Xz2rbxR0p1RVlXs2iqSBLOU
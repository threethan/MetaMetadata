tsKMZfEzPxU2k7Z2bxcuBcpJ6l0wB0EDnJuIs78w&oe=6AE9F69E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fexNNDI90U8Q7kNvwGLVZrs&_nc_oc=Adre9avhKdymH4mWVYo0JRQWQOGjYuTQwlldSA2jD93DOHpCmp2i50A93ufCT_K8N9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpXN2fogvnfYhNBB9pnph3UTjiCj-5LlU0mGGbcm73qw&oe=6AE9E405"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmUmWJcsQZwQ7kNvwF-A73N&_nc_oc=AdqE7VW0eiQLU9m_62rIx6yQZk4sYysJcaHSSRqZlUse9Qts0gk5sMZCaoG2RV4yHQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIlUY7JFBpJqDYfqXtuSs52UW2pnU8aiZImu2LLzGp-Q&oe=6AEA0D00"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6LFgSW9AlMQ7kNvwEOu9Iy&_nc_oc=AdqWh8dXhTDTF9H6IeTgZH8z9lB3PlmfFFR9I9T9tV8gF5XalG3kvdkIG0Eps-jUSuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuaQ_72xRkHNDS_vfVsK4kElB0vI9Eq96MunzHw8JLzQ&oe=6AE9F749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELCi7aphn3MQ7kNvwGqdiC8&_nc_oc=AdoV0C0kgDnIGX7LEOOQAAT3Mn9zLRZg1MwNaMtrsvoPahFEmMIKEFaM8KRd84kLY8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPGoiPf_-Dxln41oqYAMxGArOYF1BKBGQtFZ1TVrMFpw&oe=6AE9E756"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mrKtO9cZpoQ7kNvwENld1g&_nc_oc=AdqCRhKw1xGEhHuJCZ0XhSvOIiXjQU25XmLMW3fECxRNl5oUzCpEEWp9vY92rmZgPXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgWmE_zSdvYcm2gECwMk-h1YSo
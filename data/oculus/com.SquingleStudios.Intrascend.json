UzV2TMyiY9fpftet5HFDSe4XnvkLm7FNaWHY5pAQ&oe=6ADF6A9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZLx7ctzBiUQ7kNvwHeXLTr&_nc_oc=AdrkQJx9Sl_ZGP9Q2ymZggclxYBsb61OdqnXWEUkwv3x2Wq9rUeuhoXu4ys0dRXbyu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOobNs4yHQeS9gnxsU7F2u-4rJrc4ebZsMqhpzG1NIZaQ&oe=6ADF5805"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdEm6Ct_alQQ7kNvwHo9fwg&_nc_oc=Adrn91tr1VN8mV76wAtIyP_X1WuaXd_O7y5M6gOTvmX_AJgXrocyQz_4eZSgs-zfR-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpB9mtrGwYuBONwQO9jxaqmXTNYyAz3LLYftu8WCnacA&oe=6ADF48C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA0ftspqYLEQ7kNvwGDKlXn&_nc_oc=AdrPxRONH5pNXwg-oCerUKAQWy3xw6k4bLeahts8xsriia2FlK1FiBTuqFiHrkWlgD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9x1PBGMtYKx_yKzBEj8a7frb_2CK8y5uM_deLl1sXZg&oe=6ADF6B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zmatc7Q2fiAQ7kNvwH8j3qB&_nc_oc=AdqSMPCiTXHN4few5OaQSUzNxiPNHdMcYM046vvO36s-osihj8XDbi8YRk1p4DB9X_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPP3QWtFcYk0A8iWxJxeKd6dCp6b_uZa_JXBlfkoHv-A&oe=6ADF5B56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qAMqBBuxcEQ7kNvwEd3b3K&_nc_oc=Adq9QwVA_uXsCZOGHMZcnhS6G0BUMwqGeb78eYYiguTzQV_p2j6kN6T1ISyMTz7BbE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSZ1XpceyLQF8LnMvWdJgVnHXW
h7HE1KvzCiqdC8ZjKPuluSp_wMIWV24SflwgfrVg&oe=6ADCC79E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDd-Oe71RlUQ7kNvwGBaVsj&_nc_oc=AdpYJDS1LxUm_PHXjSIOqruTG3O_M6GH3OdyNpGrQOTdf4Tz7SvqlHTJNKoaIl0XtfE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF-05yplYb_1BXtab7fpULDja3G95_edPyxngVbf1c9A&oe=6ADCB505"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShW3tm4KB5kQ7kNvwH-BSq-&_nc_oc=AdrcUTXOISBGeiJciap1LrNQxn9qV9jLD76vxKm1Bsp-L8F_CVkyHwaqBv-SjR_AEDo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuHBxN28tQfmd2kFjaZzQVtrHmyOXBaissGVd8KWno_Q&oe=6ADCA5C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQtZRECCXFQQ7kNvwEzjwpD&_nc_oc=Adrgyq_oLVVej-xClXROFwhOhs4lPazZHKVKHz7YK-FwS0lqaRtG4InM5_XVX1pGiLw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt6GKxH4p7nzfoL6TkbaLBKsBWqH1sq5lxeG6UIr0Xog&oe=6ADCC849"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PNNimtkuIMQ7kNvwG7DtvY&_nc_oc=AdpN8Jf_fGwFeElqHiXBR70cIF-dmmr3lVjuUE02W3Hg-TGuw91E033vOdzIa0p2KIM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC89AMwnM-yoMduI7pPS9VXibToZKZiM6led8NHufC9Q&oe=6ADCB856"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je9alrYbTY4Q7kNvwHGLbT1&_nc_oc=AdrGplg5RgGO1XDZByDdNMUx13OpB0EKxdJ2ZSdG_M3R-x17tseS0MnrTnX-AVxwKvE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0jEjfQAQ2-NDsRzU9k4Ux_kFW
MvR5FXZJrmkHQOuPP4mka9Y3GqKQTCDyRDujd4Vw&oe=6A5CE61E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTdiOa2ALicQ7kNvwEXqxS7&_nc_oc=Adr0gDuJU5nggNc0ukfn4Q6BDwkhprjLTmTylL1g9NlMLegobYq1oIxQR3BK0fwWo50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw-b7p0lQ2-4bNhkelL3xbWx9oZqdISk2qfCCWDtXUXw&oe=6A5CD385"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_z3PnHCxdoQ7kNvwG1cC3q&_nc_oc=Adq0fUrSNzXvv5rDgb-2H7w5rjNsTRgY15zVYzMOwxnA_2oI6gnoUjyW2PRu56WUJMU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFxYgtkBI-1MzgzMYqNi0AftQ6Ac-sYGsBqPfJF1i_-w&oe=6A5CC440"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW3TQHypkMsQ7kNvwFarCcD&_nc_oc=AdpzYbszFsIl-AbYlJC_F4fVkgh2qGLQ4wjkne07ZFoK4AvIGciT8t2r3iOmlD0MLEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAbV9Bd0KKEKA0Dg-YCEEm4bEjmZn-zkLdXdpi-Exi9Q&oe=6A5CE6C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b890NUjtLIQ7kNvwGpeFar&_nc_oc=AdoVnzgJv1ScVu2qfUtq6JMcQlCL3_c3guemLyJx9Fk0JwmPWSNUCphWfcK-EWvcr44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVAGJ4ZC4aGjhrur68uuAr18184hd71Zvj8b45QgncyQ&oe=6A5CD6D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Spfaqu4i0Q7kNvwHtJkDN&_nc_oc=Adr51Qlgldhs5feDmojhqRXXsLOOypmoXHxRMn2dTW20JiSwyi6HU8HnJpChrYsz4XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzuV7DPHSiw5wg11CFHn3jIkck
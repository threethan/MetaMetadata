vPmiBakiL1xeVK9AkQhuUd2PnYKbIZY3xL1JN2tA&oe=6A8AD25E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x7b2kie44kQ7kNvwFhIi16&_nc_oc=Ado-EeEmYJ4T81BfKZNRrCZWJrookYjzwYwUy3Q20PF6PZNJCSd1-BQ7jBy04C6_IcI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvwTQ5vSEwGmOTCJsYg_1iGSBYV5LJEhDwItPmTIFV-w&oe=6A8AF805"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuYVDiLJa3kQ7kNvwHY8RTZ&_nc_oc=Adr0XhNhakSVmEZm8iqz2ODh4zVIQN6nCUTvg5V4Zg82tmOehYOjQ6o_Lwa7Jxr1UNU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExquRAmjJn2IQBLT_6FReI2UdU2WYISWmgfnETpRxfOA&oe=6A8AE8C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AwmLy7RbP8Q7kNvwETdLXM&_nc_oc=AdoV5k7JtoPtHWoH0fE62P6DUmbycbVge-MP-uWV7O31FDPHl07CYn9nxRjcqHTlxlI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaLJMt-FUFUigYlpR-f78by1uxdmUP3r6YNVkRzkwN2Q&oe=6A8AD309"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd3P8whEO8oQ7kNvwEtg6H5&_nc_oc=AdqrmYPjy7CHH7NOvD1nH9buRdeqWXN93SilTkmWXywFS_5qi224mtHaQnovSXbF9Iw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrCNk0ZnKLAVkuvyUufGuEDMHgwIOKFfXUUWD2ToheQA&oe=6A8AC316"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frAgcQ07cEEQ7kNvwEx_KX8&_nc_oc=Adq8wal81jnQmX1rcxdZcQStS0QS-NMLA8yrT6I-LOWT4IB1kNOEtEjGCt6kfy1eyN8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0UV7JFRlf0EfxpXNCEm0dIGO1
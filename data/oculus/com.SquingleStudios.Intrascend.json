QtkCqIstdjak2YFzWVBpeGa0HlGt1Zpk_K1hw4Dg&oe=6A58F19E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yMP-WmcZ4AQ7kNvwG1j-WA&_nc_oc=AdqMENroO7gsMu5PqG_f_zqFvWumlHx1UvTuue5wDEWHBPhrr0yCo-TkwysRFIyJ_Q0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtdM_SlvHa3G6_Rm_kSY__qLx738v1AVFtxnVBDopGGA&oe=6A58DF05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q022I-xnqM0Q7kNvwGtapVG&_nc_oc=Adry270FP5RVGWXeqog1JFM8GAAliEkVaJ5CJAbkg-8goMm85B5RPhp7iPEqQqZ6FZg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyG786XEBc4L2fXF-y59OW7hw6UBmM4zU4neAas_2fvg&oe=6A58CFC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad4FKBdghyAQ7kNvwEZnAR8&_nc_oc=Adquv59tCfonjYRqamGVGSLHowS3hljesBKljquD1pgMP4b_wrfV6xYTXxE5iidiXhI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUQCL3qfqY0FjFR3LYwPpxvQixDYe-n9yasdbVKZXZMw&oe=6A58F249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riHo1C-1-7gQ7kNvwG0hOad&_nc_oc=AdrK2NuArB9o6mduHowEJ3UxGXtaAhEhw-NW_NV5f3x4VmgA152G5b8lmfkgRwLgP9o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIav2YmIgsa52asw0w28Go1KlQDfblLV5aZb1phvclSA&oe=6A58E256"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6U4MG1zGwesQ7kNvwGbEVoI&_nc_oc=Adq4mdiofoL2h0lAIQMAEudshfDe7O4kf0K_DSMygfpE4QdftoH3Pjbc1lNbcgu5_AI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC23ilyYVTDH8YTV8qN7zcNoD5o
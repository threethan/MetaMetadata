fHeBf4osH9dF0OUu_fcLvV3BdqGaax695V5VH_8g&oe=6A8197DE"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZsbo1zJ14kQ7kNvwFCdJBR&_nc_oc=AdoOnRyFyjKC-VtBQ-oHeSQnJnb51YBSENBpJ3RQaUBgwFlj_UQELh4o4-V49Q5jVtY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjPKvJ8OgvQMxA9099Az3LU45Dx2jnU64XRlhMwPt_iw&oe=6A81BD85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbkeLXef8n0Q7kNvwFoPWwp&_nc_oc=Adp65psFpZhRQKxxV-F4feO7Cb9tJyoEQCkpjF4BVXZb4EUJzmsIEmO-fpqkkDM_G6o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyakj6FT43BZBqp4oLqXAudvjIYI6JIiVEMo9E4VwaXw&oe=6A81AE40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PF8XWvL4JuwQ7kNvwF8RUsd&_nc_oc=AdoJBDNSvhnqVPqkI0-nyKqqZ16VZXKzjG--HqBF102bI1AKcQ1Ykg_qSy5YpPgGmAk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTITIyjVwykMI8QXz85JG8ZT1wd1K8KQd1ZSbwcNLQ7w&oe=6A819889"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5o7BZzOrZsQ7kNvwHWI_cd&_nc_oc=AdowINR5LPbQt28yJGCm1mEK_gYqwcGKpSfzx8WSLeusXGbTxkk7N4TA2PoqexeudSw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiiCFfFQqN5OkoZtUPfT1OfGON_yb59tjb0jHv06DoNw&oe=6A81C0D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM146nDO5iAQ7kNvwH7Qxqy&_nc_oc=AdqsZKEBGRQp_v1FNRfY3UXq816ouXPO1OU8awqQuwu7UqnbGvDaTuLkwmmLNpvq01s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8rpQw2j-vohMSABWAJTpGkTzz
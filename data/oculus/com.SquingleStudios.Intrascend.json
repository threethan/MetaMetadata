-kPwwGWYgWGTh2wKuxh6S0KzsSDp8pnsdCkWPkmg&oe=6AF9C89E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgbzGGFsT3MQ7kNvwGaQXLm&_nc_oc=AdrubsIuHgOyVbVuTwLnOfGwDv2As04h3ym86KrY29QA-pODAbvbraH2-SKv85TYrjk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ16C1t10fP0ZaQOJDzXyGQTvFNnbgR7U4t0-slHFTVNw&oe=6AF9B605"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sfhCwG0qxIQ7kNvwHbodde&_nc_oc=Adooi03NZHGmNVjVeSHSB3CDT3pDloEmCXnVnAC5oLycKoKSk4Lm9xwyMsc_JRKvPSg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2nqELEF5yMCrUk72ErlbKYqMIANztUxj4uoxUPjdLEQ&oe=6AF9DF00"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcNecUgY3hkQ7kNvwFBeecW&_nc_oc=AdqhuBHDZsvTJ5swNzWChWJd4e1TkFKj7xl0Ua34Qe_nKdo354iO8OuVoRO8t1lJ9WQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp0o42ty30jDWaE2na_akHM4GT0WWZU-HNQPJtpo7M1w&oe=6AF9C949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEsmcARCv64Q7kNvwFaSPDg&_nc_oc=AdqJLVm9rsYth1bNyzWOEnJnnwzKvCvFykAJji9QlRlqoY9TQjYTWerxNIgk3fcIz9Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKGHl8PS9Soc6ydiYgznrqqDAIj7fKXD4I-YJZ2s3cWQ&oe=6AF9B956"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1PFrfxcnhkQ7kNvwGKEEUK&_nc_oc=AdolG8diZKd9jVivtvu8CYYyTE0LWC35XwRnsGc3IWT3bV7ZZC90R4fvadrFUSZKXfE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVrUPlB2NZyDaZZEUPUEFr9HNu
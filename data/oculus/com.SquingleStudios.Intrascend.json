7dTIXZojZPiI14TnSibdoYHIY4lEBaxgh00w95Cg&oe=6A452B1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yul-k0hCGw0Q7kNvwEDJziT&_nc_oc=AdqT4HdC5HU-R-KuvaU1wltyGHRfT5W-BmxIM-L5LWs-NXDLi3uDmxgf-HVomXSibos&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jlqyKLoqxJM20TiwnPQD1NBNw-LbMicSvEwxH4A6syQ&oe=6A451885"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOEVxzaQyO4Q7kNvwFpax_H&_nc_oc=AdpNdnONw9gY8lybjSdn_xSB44vT8jP7vBAFO6YITUCjvtQqmA6ql0VyJN8xRvvhO_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dqGJMdb3gujK6qk7uWjtdcuWOqgA4mWR7HLQM6GUjUQ&oe=6A450940"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTPnxnHTyjIQ7kNvwECLX6V&_nc_oc=Adq5-k-ahKR0GldxnLR6k-Yqq-HaP4QraJaT-HtDl_7rWkl_i5JS1IOd4slOvamF5s8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_62dYNYoJBr30Ol-xadxw-f48lYV1O8KiuG3weQfWx8g&oe=6A452BC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv20RF_wb0gQ7kNvwGrFway&_nc_oc=AdrSjssDToOwsqXu0aOqAKmmuB5MSob2lXRey-HYtfqf4Blnvb_2WuLwC4NGVyA4bWg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KiUk9t_eIzsLM-MSFxP1IJDrKDQa5_e9gx5WftpyTIw&oe=6A451BD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAwNRWTpRJ4Q7kNvwF6sPc_&_nc_oc=AdqMkEsZw1xfCR2VEGcGDVsxm8jSJTjoI4dM4kPOuC3H2PihJRuK5NaaCNmjL5JyRBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TSgaFTnfQrs3CDEO-j7dtae-m
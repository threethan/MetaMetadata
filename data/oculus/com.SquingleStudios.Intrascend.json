BR2GX52HPQn1xcipel-d7mPXEPo5bvbZxuRCHbTw&oe=6AEC999E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDee1vml0U8Q7kNvwFHttla&_nc_oc=AdpyVR6y0YpocF7uvcVAJ4oTNdzvrIrTNTrYW3P5Xa9aI4282rObS_fmoQLnqSqPIeE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrV7MkMgRGR2bF19Rzc1lg9moaHu-qy3RQ6rGK2M4kTQ&oe=6AEC8705"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmUmWJcsQZwQ7kNvwH2D9LU&_nc_oc=AdpecqwXbnCch2pockWAOmfr-VhJhdl3HCE5vRKTYzfoHnk3PzXMW1y7GO5IJgIe9AU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr2AiCx5oobqkEfMekIJ_2RUXXRrNmruUysx-toNbI7g&oe=6AECB000"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6LFgSW9AlMQ7kNvwGDnfoU&_nc_oc=AdqCBsldpjK8-SUuXP1zUe_MmdHKVVmJzIaGN7hbiNRuzX_-cg5YSPE0NpPIs4HZaAs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuX65tjX5IkX5yWRWHKeGgy3tM8iWnajBzNfTdhG2Xww&oe=6AEC9A49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELCi7aphn3MQ7kNvwFS-GGE&_nc_oc=AdqOjy-LmLo7tQ6EukfpSFlWzDPa9y1s1pXXae_AKP58Od4KAwZCFhVu6_gELJT5T3E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLAt_jTn458hbv_yDegc3pMld40VmacuIa9UD-aqWAYQ&oe=6AEC8A56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIkcUIdetccQ7kNvwGyUq-a&_nc_oc=Adre-u-e3zDOZNUCVM1zSal1rWePLCETEqqK2_bOGF8V5CuQTCDxrwKRkc_JB0z6OsE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpq3lT7hcko7hc7bSXwM03R5UE
SDuj_LYqxJYk01inEpVlxoQE_PVf7YNFoJ_djdCQ&oe=6A31649E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6zDf_hAd-AQ7kNvwHf7cbX&_nc_oc=Adpyo1WQHB73cg0H8ovxcFZYjAryTR77lJwVr7vUmVLiEfNLsUtFYda91NatghIN1aM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cYNkq6rDO8UkOXimGb9jIEEBB8uXZ9SB_kAge202VFA&oe=6A315205"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRKVFeIv9v8Q7kNvwGBymBp&_nc_oc=AdrPRAsalYhhDDvOSqBP5w_hQ6jUf6gAVrAtYpsVNpTigXaqQcqgyXEApBrCFkn2dZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fLul8aYNPqFs5qRJcnKMYzUUWOFImvlvYgfEMB_5J6g&oe=6A317B00"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz6ODuT9-wYQ7kNvwEIwwOr&_nc_oc=AdpnxuxtE7ntd0ShuAgxBPf3AjKl5Aj3Hr1PNLGP7w3lrdUrApWodHn_iI7IKNjh2qA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hUVQqFampeVBabef6mI3t7lmPBdnbe1DANop8GUyndg&oe=6A316549"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i8qqUyHQ-0Q7kNvwGanMM5&_nc_oc=Adr654hhhtj_ZpMBB5pOkR9TxuCQH9nyp-6GY_t8_I9TcTUYUBkDZanG15TeA00H6pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GEGsFM2RNMR5pqrVssj8lmASsoE4XrroY6obCjeomOA&oe=6A315556"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80aoH5ZYEsYQ7kNvwHu_TqS&_nc_oc=Adpqt0qIXXqDcftLDqW8bkYll8RUH5V5bEk5mgeaHIfGTCHnyDgrz8XVdCb7goX8ixI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dOwnnk_DTjtt7ocpMPaqBPq7o
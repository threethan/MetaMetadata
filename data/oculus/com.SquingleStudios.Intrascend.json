oJY4XVSl-dheSiwnTkga3SNGTo-9_aI8BrCj0a6w&oe=6A7C51DE"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q4ypIBNpUkQ7kNvwFl2lY1&_nc_oc=AdpNL6ScLQq7feQJfkrofqHNv6C_TfTke0MuygPfAG8REGhBR1KOim8GLqIfE9Dv1D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUUc5i-ZGDNlFIO1ioh5UF-Xhs1cUGFNQ9iFdRnCvdNg&oe=6A7C7785"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zgVu23aPAsQ7kNvwHh1T90&_nc_oc=AdoJy3yxMqp0TdwDZoypKsIAwmKvunW8cvZGQXl5cDEhyCQRHYEk0akOLUilOE27_Lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0HOFPiZN8L3Nj5_UYpNJW30mrbFH58qGKEANouPWLYg&oe=6A7C6840"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPAIsAZwTdIQ7kNvwFO7xpr&_nc_oc=Ado0WSitpC9Gg93KJF2VaQJ-VqzWGZBoib9jlufog8erGz4VWA8jNSgb7sawwdyOxhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHOaNSDsHONAJsOJnvkXj5wxYk5VPt8MeHyWcEUyJHDg&oe=6A7C5289"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLjitoAU8N0Q7kNvwG5lG1O&_nc_oc=AdoIG2fWciNDe30RJ_LOtfv6SfKFlP-ZnCRDBdtQwE_hh0ybWK0D8WDeZhFEnvq9pmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu8uJNscXUJoaRBpe1-6T2gTdy1gMzEigcksB7-Kf8sQ&oe=6A7C7AD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVNL099DOy0Q7kNvwGVl7H6&_nc_oc=AdqULQCfGk_aX2SWVJ_t16y_g-VfHDMGfn9ICc5-EPp2gzmLq_kMxfFEscKdkqNO-eM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEnr58Vivt4bymWNbb4zj2_ULL
wNqqlH3jGuf7D-VZG50PJnKyEXCuTuRh-68wj9_A&oe=6A3FE51E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXn_znnhJ9sQ7kNvwGHgRER&_nc_oc=Adq0cNfYU5zTHygT-YRN1jSQuFVS1I69Fui79ftejmI6gflCHOjfhszuJxpxfPnRYhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93ENqWSbvaf7Erjs4YNjuS_ksmCZJtaljWyF_8WjfZ5w&oe=6A3FD285"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcp3UItrabIQ7kNvwHaSU53&_nc_oc=AdoiULNcJmkn3rJgCfnGYihsGMw9AsSvk4LSNxZONunNIL03Pag3mxLerhWpH3ugdRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UfsVdARVUdo9eX_fNpN_IUgBs13huDLYlHTLWf9W0QQ&oe=6A3FC340"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWXiYY3V7DQQ7kNvwGKKF4l&_nc_oc=Adra5SDOnOBSRfmPhOAm5E1qgjvVGYRz0Jd_ep6mbXHio2N_kwgL4eEmk73Kex1N-F8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h3vfMLEpvrNZrNVvS67XvdQdx2tt68TFIbqNOMex3tA&oe=6A3FE5C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDLYEW7nav0Q7kNvwEgfJEV&_nc_oc=Adokg9kUZneoUKMTplr8KPCLD_mA1gt9m-Af5qvOLzo9Oqji0QGAJt8Uz92nTAc2Qr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ie3_e6nhwF4A9XOfoWXqFkVB7mpW_IL--9Cyv7FtscA&oe=6A3FD5D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOoHSA8a9j0Q7kNvwFzWS8S&_nc_oc=AdqDedq-_sv47rYbLQ2kgLicp8ZzghtTx6YqaoXrPtYgHHcz21P0qqwS2Xs14yOapUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QLesThaDSuSM1QiZ7Y4toCbjQ
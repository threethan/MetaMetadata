X0jOsC0Krpzu-y1IBRk_3I4i98DUU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2GWAxWg99hhVG44WvlI5tWWIoU1clLcIwLpV8Jpzjv5A&oe=69F1E509"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UcAG71BTjMQ7kNvwFM5nRF&_nc_oc=AdqarSM5TIzzEYmQT5CRZYp0Q7VvNPWvw4v-Dv2sKNp9niKeI1zhPuXaeAaIhPJH4Fc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1Wo6jIFFWzhwZQe5c2IkY-HHsna_IkUUapaqXtv3U_DQ&oe=69F20D56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://squingle.com/privacy-policy-intrascend", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
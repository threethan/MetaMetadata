G_x3mgocuMW5B7AmgLgmyJQ0GL2EKspxHf1NsNqw&oe=6A64CF1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdzZAczcCrUQ7kNvwHbpRos&_nc_oc=AdpyCF_uoPhTbx6RnPiiXLSSB3GQwe-kvGWeIcgA6a_Eo_20b51JDfE9PsU5-2DbLqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV3VDP73Lvq_pXtjcprFAYLnn8-8YVPfRetiqkM67eSw&oe=6A64BC85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTRwPUnSgtkQ7kNvwHVxgD_&_nc_oc=AdrWr2BFRb5SnDfvKimWbVnqShVaSTzYjJ7eKgz0DfAjinXRafjHj4dhWmuxKdXgZVY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_OfmW_Z0rjAGiRwiiffeL62_i_5W04YfinDHtiLMCnw&oe=6A64AD40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJQJmq7Hb0MQ7kNvwE9Ggtx&_nc_oc=Adq89PF9P8THCjlvG95P8HT2suZWpfAb3hDbvEPNVRAe8JWCOm79cQyZNTn10cf6450&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkR2IPKtvuV2-heyg9ixM07K3nCfDUFhYXJXBghz0bAg&oe=6A64CFC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5lpHAHf0JQQ7kNvwFlQCoS&_nc_oc=Adq0WUe9ZEqDXcIFOtvmNtaMS_6t-UetxZhXb24JoZH1fwNlsH6Rb6vx-tc999dkxCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlXAP-zoAMwnWWgPm6hCV2WccADeuOf3lSlHiGYifBww&oe=6A64BFD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C_iOd2XqkkQ7kNvwGagND9&_nc_oc=Adr1Au5GF0T5HR87pdD88wJDQb8oec9laYvdtqhr3Bh5NIvt-w0V-653WBGH868CriU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz7Us-SVCPF56hINBlVOPG_Boc
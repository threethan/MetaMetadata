y_eJqKfu2auvsfkIcPeYwBDz1WBtsYWWISjChMfA&oe=69C5115E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj7MgK-9zjUQ7kNvwEGBNcs&_nc_oc=AdoS3dGSbOZ-oGq4g_RkLe8kfhwOm_nR7na-b4DMFcOyBCuJqM05-fPRyUPjlI3peaw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe9MwY65gt5tFlNV0OhpKLAeYN0FUJA89AHX4QnVQfmQ&oe=69C53705"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwTj8_odjakQ7kNvwFLgvuk&_nc_oc=Adr64x2EvYQRElVRRxqUzan12qapxLAE2zTNM62TsqgPBfpc46_Y0t6B6sEvDL4HFac&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylWigG-N2ODt9OIXzPruku4vsCJ_L9EI2I92vkzDFelg&oe=69C527C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OynVvq5I6IcQ7kNvwEnCWlV&_nc_oc=Adqi3wOfP3c23IU6gHSAseOjjj_q_UnD10M7gnUif1taFxKPnGaXSjMHHg_zD8xypBQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw31T8IYwSruFXHVKDlg07hNaHgB3cnmdH0dbnAJbYjuw&oe=69C51209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqHDUDNQEz0Q7kNvwEmVGAh&_nc_oc=Adod65jq2L-vQ6BHX76GqKCXB2LhmvGt4Sv3AZ7q98bu8v-fWtpT-JPF-UMTwtp0JF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUbtBSA6kMvrzylIhaBk1xoEVIKUaibbhRZZFCFY7Z7A&oe=69C53A56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu0J54yzwOgQ7kNvwFM3M6f&_nc_oc=Adq6hXMytgq9DPhre4iGCvCZXv4OVnPsSiNVewU9jLWoiLZOZfObXsGe_difYvzUW3E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzW2R0Kf0iqKKS6z9-FrkCnqk7
z2sTRYUT6hXy4i4vDbx_Tfp9-hZEOIjcradsUI7A&oe=6A41369E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swR6Z1zsIJYQ7kNvwHwQdXA&_nc_oc=Adptk7vc2AdGNgQGyX65PAfoXuBh8ZyeNxtham-Fv_CmYc-jhCHlYefOfQ7QzDuUboU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PgF3_jvYi16bd3BNud7-QtjKj6rKRtzR_uyDoOPwGzg&oe=6A412405"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDYIp9JUxMUQ7kNvwHI7i6S&_nc_oc=AdofiDx7kWtvMMe9HA0D95NqwiPg8oIUV-XqKDMn2OPDdi6kQJVuwqz-IRNwf04hqYM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ea9LAR8BC71cuCjaSSZb1HEnWmnnhxKno6eLLu4rAfQ&oe=6A4114C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWXiYY3V7DQQ7kNvwFlN4bZ&_nc_oc=Adq5W3dgvHBe-iPcBs8A518u-3SNxfuWaJjgmiBE1YTuE1zgjo7tLZgHdU-LuoJw_PY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8N5hmolDlPPZlLLS316uWd_FDzntJWZ6l1PXbN3cM7g&oe=6A413749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDLYEW7nav0Q7kNvwH04HVk&_nc_oc=AdpP7sUMAkv6Xgb3AhU_WAYMieiNpT0fExmEgULNqFRwrAK5YjH1NSpsVR5EYo_xol4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IFOk_ieDRyqs9kQBPFYWj57Tu7H28oN_rvv6ud93oJg&oe=6A412756"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrwKffFAfCgQ7kNvwHChcLk&_nc_oc=AdpEUlRoNO0w4rBTlhsxe_3ZtCDpxWuuftsnpIqERudKA9kLpBI-bnpNuaDG9uBQ1dk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I1qj49bAehMVA_oSVz7peowXr
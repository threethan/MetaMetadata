oa_EnxRLphU4WEw1mhyzs8GMdzAjvzLmC-y2a43A&oe=6AE35F1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aI0jr5BLKyQQ7kNvwEFLV76&_nc_oc=AdpZcdG43T4S1aZvIFNFebqYjkGkdkdYo5eGsGszg8ksQeFEo9RG8FihR2iGmNrJCYA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFx-pMBuFgfKCGCzl6i8s_IFeZp3UmOPZLrFHtcyvqZw&oe=6AE34C85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_Pn7pdPjZUQ7kNvwFLWA8Y&_nc_oc=Adqpr7097rkdP-c6bgeVpqiyjLkz9E4DsOJWrREUqggRkxtzKoTj0KgGjTrVLJS_4E8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7hA2r0QEqWBAhZ6iWpAR5uFxYqKrW_-hiQbD5h9ekaA&oe=6AE33D40"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnyJEgz-veYQ7kNvwEA9Mdy&_nc_oc=Ado6Fw5kquUE-zE1GyyBha1Aa1AwJ4WisTQ6jiLiBPuxwsajVWCzSJqfem8Vh69tSPU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLFN0SUpsMJCHHcVKYSgVDU1N3DC63AFD9GGnNtZXQbA&oe=6AE35FC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPvKa6e2eyIQ7kNvwF-78TJ&_nc_oc=AdrqS7Xch_q4ujIgpGG2iJbL0KUYBZiJQGb13eHyqGYX8xE6hhOxrOqfeuKG_EtFSxI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxC-Y5zoczrx53cwXRA_1vDhvelhCO5ryKgr1UOM5XBA&oe=6AE34FD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOMBP6TqfOMQ7kNvwFXjvV2&_nc_oc=AdrGubPzckgcWyuUmuo5Ik3ROQvizDejqXw5BuyZkcSZZiWTmTq2wy07uYBGjM11imw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg70EBElFvh39mcWT4LzS_56or
gbk3WFV-P9Jb2NCt_rZLlhOlZJ_Gwja1zr4oz9_w&oe=6A4D141E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAnJjT7e2XEQ7kNvwFFe3X7&_nc_oc=Adrf1z1vGzRaf5p1zP9scQyLCH4H4b_Hkt0sXZCivaCGmjyE5ZK6HL17nrU047hOy0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgqMZz3Lr-_8H3uPCH4ebXov6HsP60TMAQtIj8TkuO4g&oe=6A4D0185"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw9W1oKnE5oQ7kNvwF5RSIR&_nc_oc=AdqFP9rz3wk7C8p4v-ex9K0OHwUYYQDncJtAgEfGCIwcdKYf9fLA3HtP-jYiMsTv_kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkvnjFbt8LZxJtq4RpQXwQksm9WaAh_adyLBytIMn2eA&oe=6A4CF240"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V945M0K7qjcQ7kNvwEjgcAC&_nc_oc=Adqa-90iN4Vwy3yWRp6cHkwONvFnaCHY_khMEdqz7kv7Io3eGkm9ZqYjGsMDpulcht0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDscifxLQqd47el8ccXVWGA-4fY5IdgcjbaNMzflcW8LA&oe=6A4D14C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNeQT2rhSjMQ7kNvwEBAQJX&_nc_oc=AdpLD2ymr1vJZVDZw063rw0RfIItaKToXpoYfWnz7TRmoR234zBRi6v8FGJS_C05hAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP2sOd8uMDe3s66kRDkJEomAHPUDbIjUUtGFBUxwApBw&oe=6A4D04D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9Avtanw56sQ7kNvwHevQI7&_nc_oc=AdoE5vH0fsFqVVoMk0O2230miE7kPNECEUWOq-7LCMJSu36lIPBdwbpsPBU7LYB0Ovc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQSTVKgcCDNVQ9LWgz_LHIg98H
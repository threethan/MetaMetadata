ftpjNGGtovutbNfx_zvf3yuw9qwr9ZK9Ev7YDJSw&oe=6A5F891E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTdiOa2ALicQ7kNvwFiAojj&_nc_oc=Adq_Br12qXGsnJ87abaNzGJ1Op7v1Ou50_PW9-JY1u4NnikUbqBQpxnwMznLPwdzPjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqxzxZz3ND89KTMW0a0-Ty8nx6ahqWxstdnu2s6YmZPQ&oe=6A5F7685"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_z3PnHCxdoQ7kNvwGfD-tV&_nc_oc=AdqvwjRGPi-47L40o9Rup3XPjZ3qm7Z8wb1v74Z5z99mNoyXNnY-ChwH9VPldbG7OPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7jM8Jv-c0iB-L3jvkK7sJxlp5kEs19g4UuYEZ-ofQIQ&oe=6A5F6740"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHrM4wynKmoQ7kNvwFqK9lD&_nc_oc=AdpAa2HQEYWGYS_NV3g81ZiB5S_vOjQctPTHqV948KNXx0y9ZVivNwwPKMg8dH0f42w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgfXZyqQyhPlTCylT1K257En7mwtN23tpAv5qmvhyE8Q&oe=6A5F89C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq2tPCuurcIQ7kNvwEFd9Ls&_nc_oc=AdppvaZB4dyi3JeK60dRDCQftSWn6CY2pq2V4IMYdRBBJo2dG2Q3ByTR8aUu6e2D7NI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGJD50ceVkEtNWidrIgXwqhTz8Kn4O95mLZP86SKHOMQ&oe=6A5F79D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Spfaqu4i0Q7kNvwFZsxqU&_nc_oc=Ado74K0mltKh8jjMX2pfqUn52qdX_48qBfGcBkAm0imQATfpaAztUlyyfOPi_9DO6zg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV9XIMuK8KwHSDVfLJX_WNRuK7
uluscdn.com&_nc_ss=7f20f&oh=00_AQTC5vdvrB3vugjWRf_qzqVtx_2gIZh_DhHGp2Igr5JpyQ&oe=6AFDE2C5"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxGN4yQqYYEQ7kNvwEjJgz5&_nc_oc=AdpAzeIYV0Ti6edqzgMeX4rPCKicWNvY2wsZer9AYre_qvujPvg5Y1MW9ygyJft_mqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpu9KC7EL4PkgaHoT1UqisMDA3Lt8OGiszxoijeEDI6g&oe=6AFDD380"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB6McImCaRUQ7kNvwE6eKbU&_nc_oc=Adq41Osb8esZo-EWxAy9K6hHcw_1e9S6EJw-YTQoLpaFgttetKZqA6LDMMivQAZ7kQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf-c3IvhcPGz_k5VCTwvZpwXxh2WDEjvK6JQFQiKqZrg&oe=6AFDBDC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9qNyXmKMg8Q7kNvwEpbUH_&_nc_oc=AdreNAbSoaSspzqMPJXQrp30jMD8yC0HTSWWC6tvdkymS5WSCOC4YLPHkIX9h_cHSuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShMJVfgSB9_79h5advLb5c4y6sm1RPFc8QDukFZRUyXg&oe=6AFDADD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://squingle.com/privacy-policy-intrascend", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3310702755812169"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "816520792792190"}]}, "baseline_offer": {"id": "816520792792190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668455940, "status": "PUBLISHED", "id": "816520792792190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5584205878281533", "version": "2.04"}, "id": "480711707211537", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5573389716029816", "is_concept": false, "latest_released_b
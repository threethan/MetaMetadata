5gqNY6AuNKzfN2wQMcMkz_50RDyoG2oqArIHrfxA&oe=6A43D99E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swR6Z1zsIJYQ7kNvwH0I3r6&_nc_oc=AdrGhrGz4oeGK5ahgWWIlvZehqXBWf4yJPXJ-SP2-1_dcVmdzTmccyA3GElYfFwpEGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93wK9qjJ9jxEfakiAzOvBqhLMjohCQXV2YTdd1_bKhRg&oe=6A43C705"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDYIp9JUxMUQ7kNvwG4lyWe&_nc_oc=Adoc0hey3Y2IeYJw4v78ljgD02oF_7EfAuieccyBhVHzwCFfigZbKQP1yutzn3nlZi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rm8O-4O8Cpu7YR6XWytroDqczxOvp5K6OqKZsVKfa2g&oe=6A43B7C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTPnxnHTyjIQ7kNvwGYoNTZ&_nc_oc=AdoDL9vvU0kEXIquSHlXHrtVzjKYZxGuyo_1hlxYh1spfwcoUMcU_dewCycNYXJ6ZRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-atcp54BPYPh-erUlGHEFR2FIraS5VAaBCE7QFhdFDBg&oe=6A43DA49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv20RF_wb0gQ7kNvwHM030T&_nc_oc=Ado2mFTOC7EeQ5iRR83s0CJu_0tKQ_qSDm_74D_eNkE-FIImKc8l9uSdFLqWOthfX7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jwzTZTPoahvKxLbzAH5VcAi7CawezVKDYNwximFCneg&oe=6A43CA56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrwKffFAfCgQ7kNvwFZBdd9&_nc_oc=AdosUGbHztoUGu42HEuL9HpCmM5ehs2kZnWI0wcTOgY5DN30JCKmi_0ppm4LPfpfAHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FgNhXf4ddeZaH8d1jdZu6bnwr
kkp815mxmZbZ2dMYhbZ6HmKrM9_7FnJV2cIUbMEg&oe=69E24A9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jvh7PEBYAkQ7kNvwFqd-7F&_nc_oc=Adqe_R1ipXXKq0Pla1-jBBIsZ19xZBDQWrklM7iefWlE8PLaywqNsP282EYauA_USG0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eYu5-VkidfnFRjg93SobahrqJ3nVVkBguNrhK-im4TQ&oe=69E23805"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vQMdehCHfAQ7kNvwFFlrKw&_nc_oc=AdrdE_aVHZsz60zHddpCXAs0S5G2fdOMYrVqYHLL-WaeXhVu5OzZhlnlWtnrSdEXgHw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gIfP8LEsTYFV7MOTR8MdHkibnwwGop2QtLi0CmqeInA&oe=69E228C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbupbsxpwfcQ7kNvwEs9d31&_nc_oc=AdoAXiZSTR-qsC-E2jrbvX5QaPtWEHhjkbr6uNG2AEeWs24rQMzx0ZloH4XrGqj9PP0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aeygEHeiBNJuO6XRN5pl8yuzPpri_rr60p-itLuBWTg&oe=69E24B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQashoB0uuIQ7kNvwFOkj2b&_nc_oc=Adr-erOZqs8EN3wqrTmQkSP1P-yyt7_ChOnO2EKTiQc9dPdMoRgh7fDsrYnKe__-WDE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YzD8d9vdeLuuEnhsc5iy9l8sz2G37WQyYBQt3Doe_VQ&oe=69E23B56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE6hMz_kw2UQ7kNvwHikN6V&_nc_oc=Adr49m-IKDCsC3Lk2YXdbzQWGOre3IBQ6j3zRGVCxyQ0Zqp8OQRbV33-gVNFZwmZg_8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pt9yv6eHj_Dt9Xswss6yJPDNq
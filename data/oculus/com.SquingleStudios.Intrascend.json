gmejunA1QC4ZRwsALYXxoy8h9yPP-kJrFhoRov-Q&oe=6A30131E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-PiGuzdCCoQ7kNvwFIckv3&_nc_oc=Adrho1Z5b2Luq7Y65-qZzJ1uvJkp7pUP1qondeiNrUuyLT-viDEz0CWrAOibz5Vt1Ds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RN4HspFGLGv_P3iTFtHveIndCq7lPjf4ajisaO2uUMw&oe=6A300085"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRKVFeIv9v8Q7kNvwGWq_mw&_nc_oc=AdoKYDLbnLQ77PCHsvTY6l1KUporz0-c_B_9NmmYxMJ-2tnwHy9F20PDgiR6oozFJRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DszQevLvJzh6Yf3-mR5faqJmukbregblWCcPzYPxwcg&oe=6A2FF140"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz6ODuT9-wYQ7kNvwFa2lGf&_nc_oc=AdqMejOoe0peBFBllWJNeHTBQMjEo3e6NAZ07RibFzLXA-T1tOW897yqFd8M1gSTZv8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zSTmAzkuodKjFx7OGaupKuZZ62Q3BO9utTk1zMePx0w&oe=6A3013C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i8qqUyHQ-0Q7kNvwGfa1DH&_nc_oc=AdotX8WEHY_GoQpGaKhCtSKOEgKZWgZRTIIkWNN5k7R5Hbcul_QF2vqEoZW-HVLpZ4E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9yWanopwt_9Ii5ImNHKHXeGAkW3cPeZlzHGg2N8epNw&oe=6A3003D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XExUBCjNRUoQ7kNvwGF3MEi&_nc_oc=AdqyKWu5T59AVyKFQHx3lgyzrtE3b4MotZhLvVwVDWHuYyimHl5MYbJZvRTcIknDwLA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95Th3vqusSvn3ItjWfmI6KqEr8
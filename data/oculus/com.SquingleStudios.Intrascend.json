_Iw4xzpsrFcDQJtzEfHka1aBRMIUjYHdJf08VtbA&oe=69D7865E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcjR6RP2X18Q7kNvwGNCK3w&_nc_oc=AdoEMVnBADr1D8kD8gjlqy1ODHWMu2wdBQthc7m1za2Uq7huk9FjBVw0eWqCq7CChos&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S_KORLiMwxlVeYgVPsRd103-PGGh5wQBY-Gnm_-Chxw&oe=69D7AC05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjhEa90EWgYQ7kNvwEK0kBu&_nc_oc=Adr95_10cMGMXN_hjfZFFEeMTTKyKzPBFeozkF7Yt-MOs9c6hC8f0CcmmdEMJ-TfmVw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03AqAuQtIbzUrNgMtmZ6L6KCt3smlpgC_4sEnaPUGqwg&oe=69D79CC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMFuF2JXyrUQ7kNvwHUp9QW&_nc_oc=AdofpDl-RpnqFM5-ez_MzG4EdurgcoJObWFyf7YcRbFtQ1wW0tYeV5L2Koz9liocIOU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fwJl4J2GaT4myBt2m-tAwzG3aSVixPhU5oD8Nz_xpKg&oe=69D78709"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFZbCJ-w6RUQ7kNvwGf_amI&_nc_oc=AdqOhp5FBTVfz7xNNC5Q334g4aUDdKtckv4XHn5HbbyySw0jtfSSSQsLFXondycROLc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SXIglD1GruWoHrQFnZnGgMFQrBOSERIl0UV--VvqQgA&oe=69D7AF56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQy9tVa-dhIQ7kNvwG1estg&_nc_oc=AdolBZVEtaMi_zrMBuUKB-lZSGlLZOwj6yMAOpURiKW7j7_xkdY_xOkITAvCPhabcGc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GxQ8udRBArMDhUivUiQo2Efb3
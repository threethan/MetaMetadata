8KzlAuiEBHZdZhcbz8_1hem9TM0cMVBxKA8qb21g&oe=6ACCF59E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To9cVwhs5-MQ7kNvwHTNjB4&_nc_oc=AdpDDtEjlGersZf47uAz47nkeQ_pn6KEH0fMvhavJTx0K6eVgGyN_PErcAg448xzIQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaKC-VO08MJrqhpikviTWUvmoi_a4RiHfemylC8RvREg&oe=6ACCE305"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztXr8VqahUgQ7kNvwEvM3XM&_nc_oc=AdosQ6zZLdMheZ7FZ6BFKro4PFgPrpmQeC3V8j1Tlm2hmxpISFcML2BZk9S0N3XXKF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0ov-EW6c9wuHrxM55N7tAdK05-pL_9S2zlEwVGkD7kw&oe=6ACD0C00"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvsFffKxn1cQ7kNvwHkWkoc&_nc_oc=AdplKpOhDzm_5BnlkPxKiBlOatHu3Ab0Rhv8_qPYol8G_3O14B-0AV_hl9dn_ZBtkus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvoSar9FgMUlxKcT4hC3Xfc7u5_blwUhrCr1wjyovNOA&oe=6ACCF649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvcDzN7GeesQ7kNvwGt0zrp&_nc_oc=AdpAbGT7xNblDTvYEvJXjiWjo33F36fqgOSXa4dhwh3X2huUPN9xrkNklpuuEd8nstA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0fXnvSF1Nw6MhYBCKg4Z539KsnMLK2d_oF7GmfYGTQQ&oe=6ACCE656"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6Wb7IjrUaAQ7kNvwFDeIrI&_nc_oc=Ado4fYY3salCg_kyqj5wPNMMTshldQznTnu6XnGFqfEHv_sSo35aKwS1vnpHa1VGft8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBHiCi1YccTgb3CoaurQTpfPRu
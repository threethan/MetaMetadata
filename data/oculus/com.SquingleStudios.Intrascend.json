6oOvBzf_-ghoKWeYrR1T8ldNEcEUWqSSyjnohLRA&oe=6AB7DD9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDOeRTY2hFsQ7kNvwHuJeW-&_nc_oc=AdrDJukEdFcBFOmw0r3vPbUAancbWhh2AsfRA-Yrn44fD22UmEQ9YZjSG7kzg14V4yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSDR8YmET-Z3UgwWXZh8d_XCCKxiyDD1fTcp02YsrK9A&oe=6AB7CB05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LFat7UlYhUQ7kNvwG77Z12&_nc_oc=AdoLO8yUqt0wUBEtHCFG9WbnjDa8XoXFTFJaWcLx1Xf0044KsESR3oZsdH9-A4BAjEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOeVn5bhavWle-cD-6OVC8J2enpyOvJ8zdG2uXXuiXFQ&oe=6AB7BBC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAiwn1TXUsYQ7kNvwHGoevX&_nc_oc=AdrDsYWvZw5zzmVkQCDxAtBuUGOGiD_3_Pbn_Xq83wioIrW23m9qYRIlA2vs2RALpvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdB_nRHBuyRLvHGHw2cC1EKhz1yrmkyze-hahqpnpOqA&oe=6AB7DE49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F12lRLxDpHcQ7kNvwGIvuRA&_nc_oc=AdrU1mLT2QI5enmiBBhkSWndhSL2dPiUn-r505crWHuWTPikLrDAtB1yQ2NJoBBhQ-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICMelxTUuV9nnwalgjcfVo9V93cA5oTiYqVPcJbc7-hA&oe=6AB7CE56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml3-UQDMaSkQ7kNvwGomrNJ&_nc_oc=AdpVCigJaMM9Uj8XuGP5fS5oFnlA3IG2YX896_KiXx6UiVoUcG2E-0DXFKQkW91NxFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJULvoR0Gle3NgJlH3BJr3AjOIU
274RIBTNIaBqzOsyTjqIpEI9up5RtcblGd_48kiA&oe=6AC9011E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue2kb3CffbEQ7kNvwEIBJ6I&_nc_oc=AdrF01X0GFRXxuCHQ-h0M0uAFhEgOvU7OOOWlS8hk1wtq0Dehf8oyDfkw47e7PJhRvI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9rMW3OD-DT2yqbLCLJNZW7jPGSKcoZA7XVRMq3f5drQ&oe=6AC8EE85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng6iPgNLvGcQ7kNvwHVVRBj&_nc_oc=AdohO3Byv56VCCsT4oEBKjU1pUQWfpc4Dv2QBHPn9tf07t9xK9I2LcEYprwc5yDvOjs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVdx1uJx3BBnx2mhn-MEig7QwMmLLtvSHEm9u1izSPZw&oe=6AC91780"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A3CjTltHnoQ7kNvwHKUMmW&_nc_oc=Ado-3YD6NmucrlB4K_Bd5YXWWxh46u4Mce3kyJr_nR8lxmnhYLlo6kWQz_JqUcsRi_s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZBIMrgX5FWgGLO98cFXOGniHSWUfJZzXej3vyIGmmyw&oe=6AC901C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkcoS_ZUEeYQ7kNvwEvGQkH&_nc_oc=AdomlAcoDr28mesKC893CY8BYEy-FkihfBkV4fR1U9E9DL3vM1gIFpcbh1ca6YraPew&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONPvKZ53CEZkNyzS81_rBoRLN4xoUzlc-ZtBTe2cipYw&oe=6AC8F1D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI3LWs-dKX8Q7kNvwHGszQP&_nc_oc=Adpj0sw14qfs54ocMQrMV8unPcU-YsgYFxpDOAKBwdi5QBipeABM4tOpskQwYTjkkc8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR3CYKtIkpzuRVO7oGr3mRyf-f
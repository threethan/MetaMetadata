Lg2ieB63OPwyS8OVZYO4hbw6tk0oH8gDYXaelHmg&oe=6A19A99E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq7vZQVp5qQQ7kNvwGF6-RV&_nc_oc=AdpLSQYb1ZIyJzSefVEkFX44QL_DL1UHMa3HMsFGkRvEkZnH99YZaRkq2Pefhb5FNBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iKbf2fUS2wuKjImplbnxumfmHf3Hlny5GrKUvx6edcg&oe=6A199705"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TzJHUlDgvwQ7kNvwF2iona&_nc_oc=AdpU-siJXq_Up-j72AdCoREFJgZWE5in3MmdP64Uu_KyrRIsc8__iGFnHUH8ppOhS48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DZQdicrTVuB1tlMj7Es_S8fDilsrgw3Ed84tPA0eNcw&oe=6A1987C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XerZTAABucwQ7kNvwGSJF8g&_nc_oc=AdqXEmJ81Dsi1XUmwW7q8avajPvmpuokNpS5qXHoGVwwt4PQQ0A4af93v6SUeKRkh0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q2jJACa4sXrpbCAtmHgbV1txl1SwVrDxVNWdPTmYF1Q&oe=6A19AA49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4Npd83FXZ4Q7kNvwHCkl8_&_nc_oc=AdrFZtGUx69lUlEbnsApQFwPmaHzm_sF_XxZLMIgzwvWbMoSM3YNKPpJn1_KKSfJG0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dv1iKq7kLDHnTdH4G9k5IxgVUHts-hUHP7Q1rn9F5xA&oe=6A199A56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6Q5x4rj3x8Q7kNvwEXPZr9&_nc_oc=AdpabpUlbWGQqsho5208_4CyO_00OZMUapdRX-I-mLjfpJvrMwo1u5pYNF_2bsa0pX4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PCbbojwOjeoWVm89-ivkOtCJf
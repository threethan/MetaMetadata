_iweaTb4Q67PiqO2KrAEIvA3FAy1DDxMmKHM3RfA&oe=6AC1181E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxpx82WrYNUQ7kNvwEuIVkj&_nc_oc=AdqIMbImmDrD0eqZrtlIZMUUTlxVbYfG0jf5hX5fQvz271b2kywI7Fb_cDaY-WhuLPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt7i0HpiLPYnD0jIkhGnpLYgUjLVmiQqyEE_xedbYuPg&oe=6AC10585"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSXPfq9TV2cQ7kNvwEx40FF&_nc_oc=AdqtaGSJbeAEK_UGFUJbjo6IxY-ZxxzILUzoMQZJd6rtvajNIWk0tKviyvRzrQNnySU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLD4d_Eyxngr5g-DmEy98D24YGDEbrQR879_ArWEDH8Q&oe=6AC12E80"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgab9mO3Y8MQ7kNvwFq008q&_nc_oc=AdpAgLDPgEx5gGArNekMOKYdJxVy-Q3MM-kNuffA8KJYZgUSSDSxr7-lTIYY3Fo_tXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGbim1pAyCWfEa_6AGPQMx-oFLCumXWf81B9Sh6NkSeA&oe=6AC118C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGTTMhdjoboQ7kNvwEmvukq&_nc_oc=Adp14Lh5R2YCvWZ6xd7dZPzLxdDweVBTiJR6CvTkel1MR-yk-HnRS4jBkG4t7_2nLGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFxmxAYoPaU2AoNEbbyLs3qXZI43LKaSkZqkyKpmHPOQ&oe=6AC108D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAZsbevkr9YQ7kNvwFITBAU&_nc_oc=AdpU2iUbu8In_DZH3pWznDTtl0Kj0L7B7EUlLfB-FE5DdS4UmJHQg11OZsylqHtQteM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz0cig8Fy2CyyYyv5opgR3iiXb
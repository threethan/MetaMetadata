otD1Q4uDpM-bsbwb00yRAmwH8PAzwNxycS6tzMYQ&oe=69ECD69E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUV-G0pzMwEQ7kNvwFiEgcX&_nc_oc=Adrh8XYXTEBHU-pbE_u1Cv1bbiuW3GzKVeXTpnojdBPTXcFddcHdCvxMJ2jIqkhzhDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OuLJ8DmcOwr7BSrjzzJPwGPwF95r8OvP--wXdNRDgcg&oe=69ECC405"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am8f3ApjLZEQ7kNvwE-hEW5&_nc_oc=Adp86iS5sjR5Ob-m1zSiefeotURHLHAjOpsB9Poy2om6hUw1FJTisvIoN-47bU5YfVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m-_u9k_TjVoKebd61DpwuwRXxJWDIPNJtFqrseNGI4w&oe=69ECB4C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7jzzOL5X2MQ7kNvwEUjXkX&_nc_oc=AdruWD3pPNa3Va8otp6CRc9kCvz-sfYteBZhfGMuBnxFNFGWeZo5a_VX-YcdxP0Mf24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_WArxA4Exj2VsUL03_oKpQlADplv6ewy2932zqXkE-Q&oe=69EC9F09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPdrT56Ge6IQ7kNvwEn7jGE&_nc_oc=Ado8g2k4bs4Qabu9S0A3d6n3cuC_CHID03V9QIuUTenzbM6IXN9CLWr-Kfg7ib6Ytv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EzQBJDNFXFAPKEIHpYJE6kYG2NHFcHaBzAjqEu43OuA&oe=69ECC756"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFpVL8dSZIcQ7kNvwFVFl6W&_nc_oc=Adrwcmm-c94Q2hA3LNRD7z3gPejqXoV1IF_HoGwtQECYolT1-OYIm-IXi_B9PeHmXE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gssBa68P7q4ivJAn_t0cEbW_p
Hh_KTFrJWwa-2rgxGlQ_U_3XzGh2xbLnHopLm_Ig&oe=6A564E9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFIWXfG7BNQQ7kNvwG8NBUU&_nc_oc=AdrBPp6RnCJXFQwmPdJ0xC5TI2vh7PUY4DyuL40MxDkHZLlIJgch0Dfan6mfjDjYLwk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNIed930dYbyt1XT3SALfQBUVx5bV3ZSlxFrvkXI1rbA&oe=6A563C05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9VUtRgvJPUQ7kNvwHAbWql&_nc_oc=AdpOtKi1M0gAsCf9Bp0KK5UJLDTfIpMwHLoL1S_0O7dNlN0kTf8xGlaaNCYgLDLofMk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYGrEeTyK2BX0R7T8YeuAlIfeH0PmAQC5pvvXt1sozAw&oe=6A562CC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HEgosdTToEQ7kNvwEI1cwT&_nc_oc=Adrn3LyAHLIf2k82vpbJHQdjwe78B0BDjNzLmQ8vw9iGVhoGTSzU4hVKUTq2DyuED6c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpq9kXKyUeXbSHLwQVUd3Nh1CkdDgomYRd8fDKE5XrRQ&oe=6A564F49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzQr8-DzmUQ7kNvwFSTF6A&_nc_oc=AdpwKnIGsUrX4Xm2NLyrHZ9iLIfhsFzohmL9y8VAgcjgMqwlxMtxdPE5bx0wqTHVtlo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvFpYlFcNM9-lN5F7qoLq00W6nwvXXVozMO9TJ5plRng&oe=6A563F56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiIK76O6X7EQ7kNvwEfjfGR&_nc_oc=Adp53FkYMTjQHWaNS6gMt6W7qD2Rd2AnX2lWLbsNO2iZB1fFIb-Y5AKM9H4txFgW_GI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRh-BM2riS7CPjh8NP59cNiud_
hSWFrVCJOcBbUwqviKJ4D9GmoUaIfKPCPyb2yOPw&oe=6A9D7F9E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDXtdxtOAUAQ7kNvwGaAcvu&_nc_oc=Adr3QFhR7ymS_NSdX3uXBQrjfRDO6vxaGRSLtGbgN_13aL1PeSbmy8m2fa8YQcvc4-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUSktvhwAD1f-u3P_MCAavgXAbwhr9mLKx8n18tIjvHQ&oe=6A9D6D05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3QTQ0Swm2gQ7kNvwGbaZ64&_nc_oc=Adoyoa6ZhB0_QLltP9wEEZBVoeG2CRw7z5L1CP-PJdW6aKoEWnNUUxyrNuapez5NJPE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBzFgOOtHe7UvX4PCdTrjLV7n22od8tIhEORSUmo9ABQ&oe=6A9D5DC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ks_iNLVnRj0Q7kNvwE_SHgH&_nc_oc=AdrZ-Q_IoUaRHSZuZFg4X5ogRRclOaO4uXRIa19WxFUurj7lVRPJulv3KPMfnYDu0ZI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZSA0b_x-yWb7m5QygwiFMENqXtr8JrhFg_EqyAGOCqQ&oe=6A9D8049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2mPm9pGWdcQ7kNvwFxJ-ct&_nc_oc=Ado8ocL60Ln_N_ctjk9RKsqrfBgk5Eyib14DH0giOmwWpw_KywuNvV84FvwXpxYmnSo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8HuhBLddGo_3uhZa8zggiU1-fWH4eNxQnGR7xH2coQg&oe=6A9D7056"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG26bOClhc8Q7kNvwG6a3pr&_nc_oc=AdpmDvfAnDpkC1YWWVsAZOaaEi7pUnBQLmIOYmfECe4yIhxdDJJFxw6WjEgB7R_FdtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgyV0-XumXHNHyF-O3ZWmGdrls
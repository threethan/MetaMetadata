z5GgRry6gl4Vy9nEMat9x8WggzVjhWaBfiWbqVrQ&oe=6AC2699E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxpx82WrYNUQ7kNvwFpY2rL&_nc_oc=Adprlbbuu_Cw8gCr-sB2lklMz4JAi3okcnBm-pjT4Y1PX0GOFx2WJmdP8RmqQWnzi0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-C3RmaUPX-WEEgrqKAdHt6_auqOstyJfREYSJJcNjXQ&oe=6AC25705"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGOwBF44nsUQ7kNvwFyfXs5&_nc_oc=AdrsBqMvN8M3Tcg9Efv8xqZP6K4nqu1Ncvi6yLQHFIxuinabGKqiTgW12n-4FecacjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpaT43HCQ1aMxnded-phAOW-xswOzFAb_FVZpWWc9vew&oe=6AC28000"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRm-ooPk0boQ7kNvwFjCdBx&_nc_oc=AdrZtYIKHeRNfDFFacPtFyEyK_dmnsjef5gesoY3jqbAzMAj_pUO-ZCwniPTHlcj5n4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCF6M-jQxSl7O5YYPR1eAl-ldaDejfRCK4bWxESc8JWA&oe=6AC26A49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hXlD99kqLwQ7kNvwEFer39&_nc_oc=AdqxuzfinnW3ztgF2TElXP7_jNtclLWela4qPtg1oAFzNcP2cB5GNwCEpqS2jBwxdH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_yFKTccNw2F-JQc0Ag6kOyN8xNBtQk_5MbHuTrIvWSQ&oe=6AC25A56"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAZsbevkr9YQ7kNvwHI0Sjm&_nc_oc=AdqZKWCheJV2mIjZc1lh9287Ay3-3dZbeRKWa_qPvKFCUX5PCOWGSz8Ir-cl1CFFLpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDZxxMcNpqbz8xIianBnXKyw6l
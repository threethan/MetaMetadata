Mu8OrbOz3my_jQYMpNW7BtHk3wg4oSO8uuhO5lTw&oe=6AA0229E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVHj6ugt650Q7kNvwH-c8DS&_nc_oc=AdrfqA0jJhXQaYjhw98tY8Y8GNWj2VDiZm222yYudEfYBpYJPgiwmq8HQTHKtJCasjE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXgixdCX3JTjgwDKk4OYJmxi39vBk-NCfkfG38hXVhPg&oe=6AA01005"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbEaHEKpyvoQ7kNvwEJ1_LK&_nc_oc=Adq5g8WTS6uSa3fd60jMMYZ_MVPDvMQSB-kWU-tVkIFw1P6gc0hCUaNHYZmSCu3p5GQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOQubArPz_lrQ3OsNexgK4fv7XwOJSRrqG70aDkFm8Xg&oe=6AA000C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGJKOFYGvRcQ7kNvwESEC4a&_nc_oc=AdrbouF6ebI5xxkmDeOaDxfzYMN-z4hwR_cRRe2pHq2_8ydEoQx3iPaMBzSOlEuObnY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYzgF9Jb49419xMsB8qeXcn4aSLqIfDPL6EpiOEMUUsw&oe=6AA02349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BV00G6hcw4Q7kNvwGRE9jB&_nc_oc=AdqhrwKrvsPh5oUBR0eaQnEKoKWQ90tLUq6yueI5PWV12MWiKfLlvmoFhpkHEWx77jc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSV2wVxLlFBNlAteTvNxqGcox-UvsYEXBK9VEGbThf6w&oe=6AA01356"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ia1kwm_LPsQ7kNvwGRyyQa&_nc_oc=AdqvC1L6eDONsNa1Ym4Gf4lIiBbYZegNO_CNvP--oBrKwVpUqj3466qtFuB_cjp9Shc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz9lJLRdmT72538R99hX4ZLS6_
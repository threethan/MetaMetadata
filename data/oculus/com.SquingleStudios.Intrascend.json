8t6d-5vFOwQoaGFJl1D0Y1u4eBZCVPgQUqfDeVSQ&oe=69FB571E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7bm0IclnAsQ7kNvwFsR4rT&_nc_oc=AdptqQBC6NqrgvfENP7pc1ZsqqjoNRKYyA4Rq51tjIgz93UQr2mDiQpC4nC7oWBEaWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GQi006eurnbnVjgKqm41uvMFjFhv2gd_RbzAirOQ96A&oe=69FB4485"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj-GNcXpZ40Q7kNvwE_XJZ5&_nc_oc=Adoxw1oO2PvheTg7CcW3eId4nZ5g50Yle1qF3cmDX2JT0C4UhX5Ra5E_vbXrLOIFpyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kXz1zGlQy4O5LiRi8rbmOII457I-pad-LCfY9dQ8F3Q&oe=69FB3540"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7Ndc4zUf3kQ7kNvwHxurvE&_nc_oc=AdqhgK1Dj5EnsNvhUa0lRGCRjnIMQityDDMcSvnAAkg3Jo83ioYkutdZgShG1Vy7-aU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72GDeygXq5DOfRX_ksJEbHNpz0m4MEsiwoit552FQ8JA&oe=69FB57C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfGsd3UReb0Q7kNvwFVFRCQ&_nc_oc=AdoxOv45K-nxzJ95LKvZhpQpY2TkVDOCzbqmWrUNchr_38c4_50XSRR6CLkm5lwnxT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AyX91npald9I94MRds8XT8fHY7A4QRecIY7UB0Lz1Cw&oe=69FB47D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAZNND9wB68Q7kNvwH-B-Hp&_nc_oc=AdoPtBDK9hAYxODtArR05pQ5IKklsLXftf_EoVJpGyqsKE4O7D9izGpxEiazV8T2Rqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t2IyuoIe-ooOSNSyDsVhYYcx5
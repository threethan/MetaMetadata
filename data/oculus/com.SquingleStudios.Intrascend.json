-Nrb-OA1_kx6gfNmctM7qv-8Mov100hFNLt1Fj2g&oe=6A4FB71E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAnJjT7e2XEQ7kNvwHrDQzU&_nc_oc=AdplgmkS06Q7sMA3YvdGwhAoHJ7ai32AZbl3tyNPOarmiu2lBpADdRo99YJL3eq6cJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu-9YkYwO8pwK_Di8xi6aZfC_QORawAs6ojBa1KaWl0w&oe=6A4FA485"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw9W1oKnE5oQ7kNvwGpt75G&_nc_oc=AdqVTHya6kBUZnzllfWiXbIbjHK5IvPnKsmGUAD1InHUpEmONf9iEVn25FQBF2sZyBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfQRjF4XDou8GJH9aJ60cgFY4dUZbmHaa-9zSExBJ8Og&oe=6A4F9540"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQMIApsCztsQ7kNvwETBrYl&_nc_oc=AdoozQsa3ZJWBXK-eRx_OOiHE5Ap_7f1PK2ScKR28cVGbrhE3QyRZw7Yona0_vDg7fI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy3vd2e9wOGFzjtNfYeDbgjwgw3l304cwzPHDs_v26FA&oe=6A4FB7C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqulrOO5LksQ7kNvwG6xOLu&_nc_oc=AdoNfNU2leUxu-mYHSJ3TrBdusNNqxLuDJmL6ZM0Ki5lyQlm7OBe2XpDKMR_TT1eC7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN9BWGArjSe4F7iQeTcBkFP6X4amKJOd0_coHfBPGJDA&oe=6A4FA7D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9Avtanw56sQ7kNvwFjWwzR&_nc_oc=AdpmKfB1C-Wz19SRqrBeyNfWVclLOV2pxxQgW0_RvatIL56FuEQemmT_4RfQOthva3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkynUw9K8PcrHTmGiGS5srUJ9n
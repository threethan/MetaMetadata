sGNmH3oIplDbLX4-gBQYn80-CP9aHqk5gjRy0D9A&oe=6AD38D1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm7KWcdeE8oQ7kNvwEPP_cm&_nc_oc=Adpo19MWolMSrvSa7l7-hFHkpvJCTDWfRGzcPT-Hk6_z_jo77FUZqE4LhiKYX6S5_HE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0hDB8J0-lT8B6i6ri-98oAkPBJy54C7f_86PZ703dVw&oe=6AD3B2C5"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNXZv18FQzgQ7kNvwEeKOdt&_nc_oc=AdqE3FZMRW9_FTA5pptQKz5lDiXkVV2vDHTIS90wjr7ve9EqKnWNQKPuqLPd5PeW28U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHyHvCWRmBRFEvasv6dvMVfM5rx6M36-4oDILqgZUMjA&oe=6AD3A380"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYTHW3xAcKMQ7kNvwH2zwLP&_nc_oc=Adoz76nM1ZuDOT2hFz09XicJQzjqqisz85h4JKn6yX7dK6EaeOCE_LXCDqgggcongmg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVCi21M2ZcbikZpa0xXlqIAx9QMRga3YkQwYf2lramuA&oe=6AD38DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6C3kMUVODsQ7kNvwFdLN7j&_nc_oc=Adqe5r7MYVyBa2OkeqkQyTsqXL50s7xFahNnNNoFSIWoFHDklQgirc67hjeQRkJVWms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjuBi6lDE9ZE-JsxXQb64VR8fM-do0ZiB44k5awEWmuA&oe=6AD3B616"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sh4YWGR2UvEQ7kNvwEKZlxk&_nc_oc=Adqt1-c5ShOQxQmo_Xjo_ZlXjStfkzJsjZTS1StP3hZJnMZEDUeOhD-2NpD8Cekd5-Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH0tGWFu90l54bxlweKzJZML4l
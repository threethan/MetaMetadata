YuTYSvmRF60Isn-Isx5Lv9IGAwDOsubgZqZxfk8A&oe=6A282A1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAeC71LR1O8Q7kNvwGsVfu0&_nc_oc=Adr6JmlNAutmftMrDG-IFDJTtbFTGDiJuaLjzugJ4xPRCuRqFDpgsCwgS9xLsiNOlQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tQFEvcnt5lAzfLcF31fI2hAdfBf6fSOVft-g9EpCjpw&oe=6A281785"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hlww9gSaUoQ7kNvwGtZjc5&_nc_oc=AdojQ2FBXKWv-xohAI3yZsbPQVW7smfUTAQ6g-pDrtOenU0v3lQ0AKCThUGONiqE4fQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fQZQrEVScuA1LOe2lRXxw7ENRb4AFNkCUqOmX2hwnRw&oe=6A280840"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UigA1S-TEfsQ7kNvwFgBJBt&_nc_oc=AdqQyTfTFKeH6Sbt6u9Gghp0G8tflNy4jqxK25Gy_Yyq1LBT3JOxLCLB-2bQ5q-TfKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zCOAL6X0bHnpv9wUVbBg6a6ks71yOOdLtWh5dfzDnSg&oe=6A282AC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FyoPPVTBWkQ7kNvwEqHi4E&_nc_oc=Adr-hDfmFhG2BCOiVCpx3IMYVJrG5mb4jnzuuiANYN_8v89Wmb9aUwUfCf9dirl4t6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iX-dq4VYg7eQtTVlk7ewaxiKA0opkvAV1qJL6P1IW8Q&oe=6A281AD6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkw2WOVOuk0Q7kNvwFvIRdU&_nc_oc=Adqm3p2jjgc5s_wFP0-6RT-Ge3CKTTkpTfkruIckHxqK1P_JjYNORxLAHKbklH8V88M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XCcX8Rvjo8yMZ3XWzDZF-KO7J
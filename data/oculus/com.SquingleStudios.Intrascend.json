sYTekMaPM9XbzYj7vxTzvy-g-tnikd1PjlW0Zufg&oe=6A2EC19E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-PiGuzdCCoQ7kNvwETHMVp&_nc_oc=Adqm9GFBv1N1Rjuu44e4VFbX8TRUOH4MDEw_XZ1YcYIiMpDdnPQMnZZv_O_lSDBnyq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QS-K9ug6_JJrQIRUdEDl07V9K1jOLe80UFnkUJOdOdA&oe=6A2EAF05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nr--piAy4cQ7kNvwF4Bil1&_nc_oc=Ado2nKDbykpQbJ5yYv_KdOKSXYnrGDzCEXRPa-jDOaUHxXI9Dq09PhoMeI4VA7xgJ1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cnobmThp3YAtJhTc5NkkKAFmTWasOhuDlUvY6u_E3cQ&oe=6A2E9FC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RenIvDtEK0Q7kNvwG3COuk&_nc_oc=AdqJs3smI2FGZUg3x_0qTYGCOvdyIgUCc6V_NqAfLY0tAhNnE9zb2K3SiwoVA-grktg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pEJYnlcF9-q64Ha7SM8zE4tsj5xroG2J4AL7F0tnP0Q&oe=6A2EC249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPjlqbtDrWIQ7kNvwF3JqcS&_nc_oc=AdpnpENUgr-cVZPOHitbepyVTar7rY9QWSd71t79SbwS_XGaaBzR1b2Xnx52xa9Tsos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hSoTRjyCbzcdNlZScSxY40bt2GzkhG-Na50cVY8xzwA&oe=6A2EB256"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XExUBCjNRUoQ7kNvwFNfhEJ&_nc_oc=Adoqmd0r-0sdPo5OiDpppnIHF2W53rg8hU2KVOd577E96lEvfijF3g-ExxX6HoDs8c8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J7MLT_BWXsI_dJnjYV1TVloq1
LTJBvJl0I-hOatj5oFxqVF76eepEqKkVRN9kRzsQ&oe=6AF08E1E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6Mtfz9_mkAQ7kNvwEIg6Kc&_nc_oc=Adr8iwCOS35eTLsOQnurQhQdiei4caVyzKb4VqkJk8WND3F0GExGdPKr8RDGxtT4aNI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGTf-SfVmwAHIrieGpOF-fnktqBfAechJasn9KB3sXNQ&oe=6AF07B85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubtlhv1zy8IQ7kNvwESzJDa&_nc_oc=AdongKSSqBX1Nr6MH-5oqJ0aOCYsK7GBxoLaMzU6cbcK7jHzFgItHEjRpgCbC_3vhbk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnib3MqAYX1qB4wqyR0CkoPf4BymLT9tykmW3k_BWSOQ&oe=6AF0A480"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jldQf0J2vZwQ7kNvwFEwMqE&_nc_oc=AdpwOw82Ea2PZnLFkB96gqtSJwZVMlHb4IQ_w0W-cLDLzjvdJLFzNqfwWC9vWOGeAZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8xC-mHWchFwzOZRCid-rrLBLog5okmygOSFnXBAUaTg&oe=6AF08EC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHNiwe3uQI8Q7kNvwH-MfEO&_nc_oc=AdpNtI15dfRq-STfIk7yoP0v5S7PDdlcab21TZJ_Mcw7H4BD-OmYB9f5h5KHoSabDGU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBJV1FtsglIj8Tw7U-FyGA59-C59AJAcoga4EEMKM4xg&oe=6AF07ED6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjYxVOIYsC0Q7kNvwGF1Do5&_nc_oc=Adqsud9807TWyIazSsPzH0FaQxdmLQIbNJ6Ge2X0XFbTtfiIQbfrvUgcZKc3h8ZBt7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMfeiiBmDPnJfaAaiXZKKNrkpW
OEbPO6FpaQXs48fQq6dScfIy7GJon3m5k06FQcjQ&oe=6A75F29E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuobnsZ4syAQ7kNvwHxg4FF&_nc_oc=AdrAW30kvGUEoz0CROyd7E5rFgLQhrv_ivypw4qJfNofUFqQXpyEPcIOYkIFiYkjYCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH5aqCyL-d7YvZhz0cfJSvzdG4kEcOpvvMuNU7QjY9TQ&oe=6A75E005"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQEi4FPt2r4Q7kNvwF66RYk&_nc_oc=Adqvogg3WlsVoFeSuCVFfkD-RHsHgZ59_B-SN7hj9awMmnA9Cq4H38S8LwDFusbLX-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDv7QHMF7uUI-B3MgM6yFfDCcOmsolTnLcR_XMenGMcg&oe=6A75D0C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHRTD6DJK2sQ7kNvwEohKLw&_nc_oc=AdoEEa7UZpHqFYd_JX_0rBMcocX67OS8v1kwXlg287PdnkbqusMWBk3hwPbdvFE3V4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSPmo4ydWcYaYe6sEYNZcX8lxWKYQZn3wZBv2iRdZGIg&oe=6A75F349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11IwO8lqZvoQ7kNvwG7zPvb&_nc_oc=AdrvwysTlSOsF3-o_bmYHDIKbP_-2luUV0Mb5NcFMAP-s0gjQEyjF620T1MI2vcuyIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpJTMNhALlsVHQwQlH_BtpAIXhE_y9NYAapliOp43Ayg&oe=6A75E356"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb8GzP7sfo0Q7kNvwG3YNP4&_nc_oc=Adq7Ujw4DOX20U_ouFcRMi0CeHTvi4oRXdSfLwy-7gcIZxauq8ggK26-kbSnG61YvoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUdET_LwK4wpPkMA2CXf4zxleZ
7BgmYIgmYiOc9Zd4k6w1Q-BfrRHWzQvOSC9ujU3g&oe=6A3D421E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXn_znnhJ9sQ7kNvwFSRoiq&_nc_oc=AdpVy6VYBRT6Bm8fQUNi0kUSjKqtDdoVVqBLbyJOpvSgddx57lzQezDj5whnEoDDE1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZHYzQxs8q53UuCTOAm1yRiBCFd0DhKN45OWvqlv58gQ&oe=6A3D2F85"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcp3UItrabIQ7kNvwG-U9lw&_nc_oc=AdoATVjdodwCmmaAdtGeYWA2FSPNIt2PdnWKGXtaObAk4w6-VUitqnGBWVpS5Azi-ew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vex_Dv_me5HahmzK8xCrZSJaiQl7Vq76P9zy3MD-xmg&oe=6A3D5880"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FcBIMupUOwQ7kNvwH0l_O4&_nc_oc=AdpuKYQdJaXHUZC5eP0GKlU_v17peqBY7rczIa-BrD9hG26lNmlekqkYxVuqacW9TQo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-SN2taqIDTAQGRlIdWFSoTUL1X2NsXdxBLtglEG2qkQ&oe=6A3D42C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEUSfaUxAf0Q7kNvwFgb1iN&_nc_oc=AdqTj7ggCUENJuALUlLz6QqseUDVaODF3mdEc7IXtMkZ0w95GKXx8CQCy5XvKdCsu98&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vco_mtJWM-31jnX2TvUspxUyOppGmqM_8pdbnexdqVQ&oe=6A3D32D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOoHSA8a9j0Q7kNvwGfx-PW&_nc_oc=AdpW9svzPLIA5ajxwaBylSOQzQg-hg8KO84meIVNZ87ZoTFJggPsgBDWblDiWeU3E84&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z6vfnZ15zud2-bz3HA5duPBeZ
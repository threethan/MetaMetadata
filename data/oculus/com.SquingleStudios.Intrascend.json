odSDB-QGhXjAvpgPIa-1fa6U2q0b0CrbFx8-tExQ&oe=6A66209E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdzZAczcCrUQ7kNvwGo0MkE&_nc_oc=AdrD4albhTSXLN2eANkAjkqY1MaupB8xMA28Z7IzKg0RwXc_vTkjEL678biDttiOfl8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfOcY5cH8153i_JQlY5oYOBV_fyFtVG0jDDs47P0Lnqw&oe=6A660E05"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTRwPUnSgtkQ7kNvwFG8sBA&_nc_oc=Adovmmk0AQCt01-KYUxQjSKgfYe5ikr9KNYbtZuYjqPE4i7T48iBFFiiyIB6dlkEjOk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg0o3eXsFnma6jxnAdIkP9ZnM3L6UzuRckfMT4gr9O3g&oe=6A65FEC0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJQJmq7Hb0MQ7kNvwGkNqYu&_nc_oc=AdrghndLzQWqskE8xZK0i2YNEtJvSbOE8NeR4T5cGAlOtBc-sp5kL3t9VLM7NcuvMtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7tZ6m9M_pcnh0SyLfZmP0RDVMgch_jFJs0zK0fZOXgQ&oe=6A662149"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5lpHAHf0JQQ7kNvwGz9ImB&_nc_oc=AdrBcM5xFAv2WH_oDzbiN3f7wsrwHO7Sdya-hwtKjtB7FHXR1j2hq6MVqckKipl_Pdw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz2w-PioIINYRfpN64HttDI-mLKrd-x_slJy8UDi_WmA&oe=6A661156"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C_iOd2XqkkQ7kNvwGd2vKm&_nc_oc=AdoJxoz6j6L0ON1SfGmtDysxWhNcSgWZ0rEkeZbX0RzZYeCvbuYT-lB01inEzM6oFDw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDi_cgtzuscyUSTHoGL8IX1jd4
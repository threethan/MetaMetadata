mpxDwkdYQYKcnG73SXpVALgMIwex-Oh8AQDOlrVQ&oe=6AF4829E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ukAuw6QuQYQ7kNvwGUri9f&_nc_oc=AdqkBpyGlJ7Ju4E7tdbaPNSW81uEVNsmGZVv1ZGqPOgiMXoig-oQg9EwHWmqjiPitoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrGigCdo7vDc4swiGB_Qu1O29gee7lfaeRqKd1q0amBg&oe=6AF47005"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqElSuvJ-RQQ7kNvwFtO6A9&_nc_oc=Adr_x1yhOooifPZRe7UGkHZ-pkMZttVvUdkJxBg-c0uuUrEouZBAPW2-3Jy8UzRU2h4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh3qZ7PCYfm_L_waMwPiFy95lgp-rMe8p2bIJhynJfcw&oe=6AF49900"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eefSn5bCI0IQ7kNvwFLYF7z&_nc_oc=Adod26bmtKMrzYh6_pvB27dxZQmgGA3294gTXtPW6MUkJRLMvASmBZv_TLYM-aKFcQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOFws1oa-sBakWCD80voNia1M1vgmbbr-Vr0BpBjLGaw&oe=6AF48349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpeBZOTDHCgQ7kNvwGZV_Od&_nc_oc=Adow2wOL7RyjgJih2mBXSAQJMw-G8zQN1mVEBkli74eiZeLvH1RrBu3qwpTApYqKlH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgrJo0YH3dBSt1FWXSenLnbV4X6bHzW-RXnN0aJ3-Ksg&oe=6AF47356"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4m9HliVj2wQ7kNvwG1lBHJ&_nc_oc=AdrMJd4qncLrTHg1JxIOJIhtOV2VGegL-9kYCEbEU-BN5wb7z5SCudGYIkqb-troAbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFclJfy9fmdlxnsjWFW2GRR9YL
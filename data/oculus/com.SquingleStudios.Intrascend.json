nsSOGF0Sto9NBWDQOaudNaEhTJA5MBB1P-5UY8ng&oe=69CE4BDE"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8de746PY35MQ7kNvwG31c_D&_nc_oc=AdpCPAW525waKNz8QBCdBz0_Tw3ihWoAdWB8C1wwCp_CHpNZ1t234pW-P30Ib3fxF9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhA82HNH-4IIjPvPWfxYYJ01VgJmvLtm4Rbo1Jn38pkw&oe=69CE7185"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9rExJg08w0Q7kNvwHUrB2g&_nc_oc=Adp7oeq88QWRM9v1dwx2tNR0NW6gpopUoiyCKyGLqukYdtky9mYOhK3f_dr__z1X4Ls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwL0boiJPFErbLokUKpSB9bF7ESdxBjA7HUNaDRd3UZvA&oe=69CE6240"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVfeZ_-E9BEQ7kNvwFhQjta&_nc_oc=AdrEJWgeq6r6JXf4qcTTMCzpiiUMULvQHVvO6rhDYwIOrhNLUQ8xI3XDmR8W1GVLYkY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwPEEbEoDhYCGD6MTLOUZid9ExuPHgNwUh_Yb-53HBxw&oe=69CE4C89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BObRoo-qlQEQ7kNvwEc4VTZ&_nc_oc=Adqhh6ogoDRXpYAReFKk8TbtPhhc9_jdaYhB_FxsZj6e2NKXycj5TJGTiOa73CjKzWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGofhhRsx_DB9hnGoaBYiYEeUEbm0GA0es-Umvwp3fCQ&oe=69CE74D6"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOBG8QlaR44Q7kNvwE2kgJM&_nc_oc=AdouVF-BqmBN-gDI7UBG_6GhaU51pTANOTYX9GKuMvi3pGwmQqIy2yYuvlxrQdVmyIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKFYooPyK0SDEXI2ssevDBeXRb
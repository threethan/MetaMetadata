QLKM1UL2FgheiS2-CnwPtV6CIsz-27482f3i3DQg&oe=6AF8771E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDaKxekW0fkQ7kNvwFufq-U&_nc_oc=Ado4VK1J-uhDOH2wi3OdIYE7aT-31qihSCmXVknnRQbrDyRQ761IYKPrbz_pEon_erQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiH-3ABy5uLoAi0QAWjQA-Bf-8hJk1ulWGC_COW-Pa_A&oe=6AF89CC5"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhxHMUISKYwQ7kNvwEZvJgE&_nc_oc=AdqZdC3ma15knVSUgFTlVYDhwCaWDL0ib0ZYbKQFdElMcNCz7QewBCXHHX8Gdz-Wvks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR--nZH5fNQy4xe6Vo3FYHQg1PGPSZJXvwtRmPAHd22aA&oe=6AF88D80"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBmgjh9SXngQ7kNvwFiKDyO&_nc_oc=AdozSkC1A-F6iW4mXFY46brmIGNIAtggQBOgxaToHs0Ep6NED75ReFjgRsUHUGbVxPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq0nO4zqzXXj7kzy79C1qaYAglr1WZ-QiuYqvyMjKPLA&oe=6AF877C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBqf7F6PUWMQ7kNvwHpg3zz&_nc_oc=Adpjn8Q0xx8ORahVlKLEb-ufM2vKeC8jAcsLAjbuMPBUFNElE_iVMTvbdMtnatOMkZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZK8biKhyumQPFY8duRyTyL_jlesDO0ZOUIyRjHMRTrQ&oe=6AF8A016"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1PFrfxcnhkQ7kNvwE-aOA6&_nc_oc=Adpj21YJeB7VkIGAxxgQFtvTMPtVUYKdRq_RjpQffeuoxuCp2YDvH1n43jembkjryxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzJsV52m310N4cIB1v82mejCy1
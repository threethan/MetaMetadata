YlaV0npcMvUYMmFSJFLlZinhiUuxQP1UJXVeCbzw&oe=6A98399E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeJxWQzUfJIQ7kNvwFb9cPC&_nc_oc=Adp6nfvbeNK5OFwbwkzt-vdN0yNLfHgM1FZdB-NAaOm8jTuoGzi2b7POrCOD-OUbv5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlPBDz-jpdJXbcvmvchGQoLridSbgyKy6q_nQEjMGjyg&oe=6A985F45"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLYKEWgaqNEQ7kNvwFRXB4g&_nc_oc=AdqKHYaIYY4PQzgzxI5AcL31Puok2-W4bzdgdfahrw2Jf44Oz6twspJ4dxMZs6AKfAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWoLrExXOJx_eOqMaW-qztq2jX7Alr1lUoLC_QOosdMA&oe=6A985000"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hcGsmoph5gQ7kNvwGSAr0X&_nc_oc=AdpwqFf6lnCSKf9bFZdXgsJdVZJcjlk1lUDmEFZ4w_0Kfp6OT03sKLAVMMdXXkXode4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF0L9-j3G1eJDsJXmNctASGEW04lFyx9jJCudA-8cjPA&oe=6A983A49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6DuQO-5wAcQ7kNvwFLOYeE&_nc_oc=Adpgwsh7uqdRD1dJcgoiY7TnDGdew1pjix_xqR4lnZP8OIoFDcNqCDd2aUSPkmygyIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKInW6Q2ZdVCQWpk3oyE_wdLDsJmZg2fsiQGa2TGmj4sw&oe=6A986296"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h-3-qG0KQgQ7kNvwFzk6Ox&_nc_oc=AdoNjVX5OH5OZNLzSRh18OxUz9AODx9amtOk4vzTRgbRPdjAhdN8Yk77v6GOZsXs0SA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbvPZksylo9lIewptxmN1pbimK
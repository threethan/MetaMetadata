az7T315sV8sfprYz4csV49yHBNtGaaJxg2rNlLsg&oe=69C26E5E"}, {"file_name": "screen1.png", "id": "3300079343537386", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974720_3300079346870719_4625911462182417372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj7MgK-9zjUQ7kNvwGfCdOs&_nc_oc=Adoy31F0y9vNpHSXnPwkvXM3CQj8fS_4MmKmhob8rwuiURYiOCGRoRRQ1TJb4PY2_FQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2evi9g5gUkiAzzq7wlqSNKH4pjMSb-HsUd1_I1K9YPg&oe=69C29405"}, {"file_name": "screen6.png", "id": "2344822752358648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974818_2344822755691981_5462452795860726888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwTj8_odjakQ7kNvwHK61a0&_nc_oc=AdomQ4es_MOI4GQZnDwG_lC3a_C82LAP55ifPK0ebHTcJwptdMBcv_T6L88cemKjOXc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfaF8iPU8z-oYE5_8U640yh6yIAozbLki8SfqPNA8_0A&oe=69C284C0"}, {"file_name": "screen7.png", "id": "797334801383715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_797334804717048_2188930191308734894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Hhbup11ucQ7kNvwHP7qxq&_nc_oc=Ado9JzOVJWo4xcBX4u571QaOtF-vekK92bbMN7bZBJE1W9Dtp0BC3cLpkXAMkxr789E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzkbj_crvufBmNX2NCleVay7uGDvOBZR5gwVFrFMsFnOQ&oe=69C26F09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_hero.png", "id": "524583369574837", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982586_524583372908170_6237143439072518941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjd9uMt4iMMQ7kNvwH5RQ3c&_nc_oc=Adpz2rQ9EFVhduhmrglp_lP23mFm3IS_ux62dgndyrHu-zFPxtJ53GVP6R3jhwxTr7g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq_c4sodrlhglLSC9kpZUYc-_FEQm_VoNENzlW0DHsJw&oe=69C29756"}, "display_name": "Intrascend", "keywords": [], "long_description": "INTRASCEND is a psychedelic VR game with similarities to Super Hexagon. \n\nSimple and addictive, the game puts players into a trance as they dive deeper and deeper into the infinite fractal geometry of Intrascend. \n\nTraverse an infinite series of expanding psychedelic geometry, orbiting around to avoid collision using your head or joysticks.\n\nOriginally released for the DK2 in 2016 by Ben Roberts, the game has been updated and ported to standalone VR, with new head-rotation control. \n\n", "short_description": "Dive through infinitely expanding psychedelic geometry, orbiting around to avoid colliding. Hypnotic, trance-inducing, addictive - how deep into the rabbit hole will you get?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.benjaminoutram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squingle Studios", "support_website_url": null, "website_url": "https://www.benjaminoutram.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8688862657815824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031500_1283791705718228_1502563989266591499_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu0J54yzwOgQ7kNvwF3zKR5&_nc_oc=AdrZXwj_HhPjbgHw7eRzTTu3rOAGa0RylqdLH3Eute-4pOfIJro_E65qZGft4Oczqs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4PeRAoWyKrf7NFbiIti8025iO
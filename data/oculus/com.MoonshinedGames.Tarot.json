er_thumbnail": {"file_name": "Cover Landscape (1).png", "id": "686276461078661", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818877_686276464411994_417426488460471839_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHu4MwaAGFYQ7kNvwE-U5TH&_nc_oc=Adrk_GL0r913f8vSIoPA1fraljD1VPRYr_QMD7oX2hNtUS78SvY77bo7nuQQ43hDJdQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkPG2vSjxgEUqN2TzcFJUSmiGtsq07RLTRO2CzEflIAQ&oe=6AFF03D7"}, "display_name": "Tarot", "keywords": ["roguelite", "roguelike", "shooter", "action", "survival"], "long_description": "**Your Fate Isn\u2019t Written - It\u2019s Fought...**\n\nTarot is an action-packed VR roguelite in which you battle against hordes of creatures and demons using special Tarot cards. Each card gives a unique weapon and powerful discard ability, enabling you to increase your chances of survival by levelling up and combining cards for the ultimate beast-slaying build. Spend points earned to grow stronger for each new run and discover hidden secrets hidden throughout each stage to unlock new special cards, new lore and a hidden journey into the abyss...", "short_description": "Tarot is an action-packed VR roguelite in which you battle against hordes of creatures and demons using special Tarot cards. Each card gives a unique weapon and powerful discard ability, enabling you to increase your chances of survival by levelling up and combining cards for the ultimate beast-slaying build. Can you discover all the secrets and journey into the abyss for the ultimate battle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://moonshinedgames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Moonshined Games", "support_website_url": null, "website_url": "https://moonshinedgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
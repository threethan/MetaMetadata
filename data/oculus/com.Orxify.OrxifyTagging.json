scription": "I recently came across a game called Monkey Questing, which is similar to Gorilla Tag. It's a fast-paced game that involves players moving around and tagging each other. It's a fun and engaging game that requires quick reflexes and strategic thinking. If you enjoy Gorilla Tag, you might also want to check out Monkey Questingfor a similar gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12F93nKCcfO554EFyzPzryLEw9iJf85DweOhx-MQUtVM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "probablyyfixroatem", "support_website_url": null, "website_url": "https://docs.google.com/document/d/12F93nKCcfO554EFyzPzryLEw9iJf85DweOhx-MQUtVM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10032280163467090"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25020724047529456", "version": "1.1.79"}, "id": "1381902255858689", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__
sSVW7a8DsmTvyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRFq7jiJfejZTzrlVa2EaaWeIYepuP_h_OFu0RnzxdqA&oe=6AD246F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Questing", "keywords": [], "long_description": "Welcome To Monkey Questing!! Monkey Questing is a really fun and casual game you can hang with friends and much more there is a tag gamemode that allows you to tag people and do much more. This experience is protected by our wonderful mod team that helps keep this game safe from toxic people! Thank you", "short_description": "I recently came across a game called Monkey Questing, which is similar to Gorilla Tag. It's a fast-paced game that involves players moving around and tagging each other. It's a fun and engaging game that requires quick reflexes and strategic thinking. If you enjoy Gorilla Tag, you might also want to check out Monkey Questingfor a similar gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12F93nKCcfO554EFyzPzryLEw9iJf85DweOhx-MQUtVM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "probablyyfixroatem", "support_website_url": null, "website_url": "https://docs.google.com/document/d/12F93nKCcfO554EFyzPzryLEw9iJf85DweOhx-MQUtVM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_mode
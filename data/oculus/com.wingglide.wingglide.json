ovuOmoRYpdjuCIPbAeEhHn9HJ5iBjD9lxo7Zaqc8N9gy5jNa_CmmXe-Io&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFwZvMerlxvwayeDwGIrFkYDrOLFFNf1nKAjPJALppfQ&oe=6B0C796E"}, {"file_name": "01_skylark_home_isle_golden.png", "id": "2256640798532930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628875_2256640801866263_790728024293670021_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkxEBndD_Z0Q7kNvwGniWGr&_nc_oc=Adqwg3nGSCpArDEd1I2ZkF3_Vkpt8_iw3XebQRl79qXXpsFB1i7QF31QAL246PZ41ew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmAYG-vwtKNmsqiGpQsxhvjo8jxXzIxr4GVVd6O-7h4g&oe=6B0C6463"}, {"file_name": "08_hauler_cockpit.png", "id": "1450788936386086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622153_1450788939719419_8200823569447247473_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMLd7pAQ_5AQ7kNvwGek2wi&_nc_oc=Adp6WtTtAuNky42gmNvQeZr-vc9ty6NTGWCpS-Q5_hkMf5g21ZfpG5cBmyA1QGLmQR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXeNCZog3U95PU6Ho3FW5QEUn0LlFUe1X2dcwEzPUelw&oe=6B0C739A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1829786861633737", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1829786864967070_6401244890663215299_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gAIj3JKn00Q7kNvwHItYcc&_nc_oc=AdoR11S2tCtqudTB6dH6fS9nl_vLsUt0oHrXKlEtEM7juL6EZAATKfCrViCzJKqmmGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSf2vPosLKbg3wb-d227j5vH6zXEIZNV9uBzvWQ0X60bw&oe=6B0C74BE"}, "display_name": "WingGlide: VR Flight Adventure", "keywords": ["flying", "plane", "flightsimulator", "pilot", "cockpit"], "long_description": "The Skyreach is a scatter of islands floating above a sea of cloud, and you're its new courier pilot.\n\nClimb into a hand-built cockpit, flip the master switch, press START and feel the engine catch. Then carry the mail, the medicine and the wedding cake to short strips on windswept rocks, lakes in the clouds, mountain ledges, and an island cut off by a storm for years.\n\nSeven planes, from a vintage taildragger to a twin-engine freighter and a floatplane\nReal cockpits: grab the yoke, stick and throttle; every switch works\nHand tracking: fly with your own gloved hands, no controllers needed\n86 jobs in five regions: mail runs, fragile cargo, passengers, airdrops, photo flights and weather runs\nSkyreach Radio: two hours of island talk radio, with four serial stories, phone-ins and gossip\nUpgrade your planes, rise through the ranks, and light the beacons to open new skies\nMake the cockpit yours with trinkets you place by hand\nDusk flights with runway lights and a glowing panel\nOptional world leaderboards for stars, deliveries and the smoothest landing\nComfort settings: seated play, smooth air, soft fades, vignette, subtitles, and left-handed controls\n\nGreat for the whole family. No ads, no in-app purchases, no chat.", "short_description": " Fly the post across a sky of floating islands. Real interactive cockpits, real hands, cosy skies."}]}, "developer_name": "Wingpost studio", "developer_privacy_policy_url": "https://wingpostvr.com/privacy.html", "developer_terms_of_service_url": "https://wingpostvr.com/terms.html", "publisher_name": "Wingpost studio", "support_website_url": null, "website_url": "https://wingpostvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
channel_name": "LIVE", "id": "2701550473649190"}]}, "change_log": "You can now hear the other planes flying around the islands.", "created_date": 1795326374, "id": "1494369870419542", "version": "1.0.4", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1466989846490878", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1502916799564849"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2701550473649190"}]}, "change_log": "WingGlide now remembers the plane you flew last.\r\n One-time, optional rating prompt from Meta after a while of play.\r\nSkylark parking brake moved clear of the frame.\r\nCrosswind landings now scrub briefly before the tyres grip.", "created_date": 1795276189, "id": "1493361017187094", "version": "1.0.3", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
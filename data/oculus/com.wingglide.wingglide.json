esmdg6HWCmxaDOnUpGfcnKsYDyUt2RVCFs62p2QDddkhpZE4JUALV_d6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcBq9YhDgvl2Mpxc5kxdOWMwug6rj5bDjRjWMj5NVaiA&oe=6B0F1C6E"}, {"file_name": "01_skylark_home_isle_golden.png", "id": "2256640798532930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628875_2256640801866263_790728024293670021_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NbqoAYE1XIQ7kNvwFthQb0&_nc_oc=AdoefrVBFI0jx3pnv9826cQXkbgzSkr9yU0kS4kCyoCQzg7hBwPHdnI89_v-m2kpcSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBLcIOu--zEATBPyftq1llXKhRXQICJLJgC71WCWJDvQ&oe=6B0F0763"}, {"file_name": "08_hauler_cockpit.png", "id": "1450788936386086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622153_1450788939719419_8200823569447247473_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOUPcyq4_RMQ7kNvwEYvOdt&_nc_oc=AdrZGu1zYjKcH-GteSdjnjlk7nhar6qME6aD1C2yM2Nk4RXTrMD3woItt8wzeYHVLuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgk0dQJnDwUo7ts48C3q2DnOrBGpNswHWHzgwdtBgw7w&oe=6B0F169A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1829786861633737", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1829786864967070_6401244890663215299_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gAIj3JKn00Q7kNvwFZWueU&_nc_oc=Adrw4XUkWLVXkBZ1AeNSg8-bLcv3Kf8wH4UzlJgYLBo-1Gav7_aSan6yYXGuM8ttJts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVE2EG47sgJAQWRkbuSbh6pzWxonE4tUy9MmIbJ3si2oQ&oe=6B0F17BE"}, "display_name": "WingGlide: VR Flight Adventure", "keywords": ["flying", "plane", "flightsimulator", "pilot", "cockpit"], "long_description": "The Skyreach is a scatter of islands floating above a sea of cloud, and you're its new courier pilot.\n\nClimb into a hand-built cockpit, flip the master switch, press START and feel the engine catch. Then carry the mail, the medicine and the wedding cake to short strips on windswept rocks, lakes in the clouds, mountain ledges, and an island cut off by a storm for years.\n\nSeven planes, from a vintage taildragger to a twin-engine freighter and a floatplane\nReal cockpits: grab the yoke, stick and throttle; every switch works\nHand tracking: fly with your own gloved hands, no controllers needed\n86 jobs in five regions: mail runs, fragile cargo, passengers, airdrops, photo flights and weather runs\nSkyreach Radio: two hours of island talk radio, with four serial stories, phone-ins and gossip\nUpgrade your planes, rise through the ranks, and light the beacons to open new skies\nMake the cockpit yours with trinkets you place by hand\nDusk flights with runway lights and a glowing panel\nOptional world leaderboards for stars, deliveries and the smoothest landing\nComfort settings: seated play, smooth air, soft fades, vignette, subtitles, and left-handed controls\n\nGreat for the whole family. No ads, no in-app purchases, no chat.", "short_description": " Fly the post across a sky of floating islands. Real interactive cockpits, real hands, cosy skies."}]}, "developer_name": "Wingpost studio", "developer_privacy_policy_url": "https://wingpostvr.com/privacy.html", "developer_terms_of_service_url": "https://wingpostvr.com/terms.html", "publisher_name": "Wingpost studio", "support_website_url": null, "website_url": "https://wingpostvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1466989859824210"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1901574107668565"}]}, "baseline_offer": {"id": "1901574107668565"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794873060, "status": "PUBLISHED", "id": "1901574107668565"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1502916799564849", "version": "1.3.0"}, "id": "2701550473649190", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1466989846490878", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1502916799564849"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2701550473649190"}]}, "change_log": "The clipboard opens on your jobs, with tabs for everything else and a tab for each region.\r\nOne click picks a job, then START JOB or CANCEL.\r\nNan talks you through the controls with a yellow ring and a buzz in your hand. One press of SKIP TUTORIAL skips it all.\r\nFlown before? Skip straight to the skies.\r\nAdjust your seat any time with B. Better default seat position.\r\nFewer words on screen, and the guidance line sits higher, out of your view.\r\nHIDE / SHOW buttons for the clipboard and map.", "created_date": 1795708360, "id": "1502916799564849", "version": "1.3.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidB
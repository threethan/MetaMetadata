uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623585_2045320849512241_1762935090391243047_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QobCWJNRrP8Q7kNvwGu4ECk&_nc_oc=AdqHA8Ca9uPxZleGOQob2TR0_kMbkIx-RyKVtCmQCBwc3zCeWH4tkx1nYLfe5VjZdSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLEoQiQFgz1UpOauM_ZEfR-r-HiuVOJvdsBR_IzyDctg&oe=6B0F0286"}, {"file_name": "08_hauler_cockpit.png", "id": "1450788936386086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622153_1450788939719419_8200823569447247473_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOUPcyq4_RMQ7kNvwEYvOdt&_nc_oc=AdrZGu1zYjKcH-GteSdjnjlk7nhar6qME6aD1C2yM2Nk4RXTrMD3woItt8wzeYHVLuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgk0dQJnDwUo7ts48C3q2DnOrBGpNswHWHzgwdtBgw7w&oe=6B0F169A"}, {"file_name": "10_hauler_bank.png", "id": "1808701900354359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839670_1808701903687692_6774918247322223985_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-OVTY_yKWwQ7kNvwGJurCy&_nc_oc=Adr4L12ftR__iZlhKBhUy_g5ffZ-nJzUdjE9uQBIoc9ht7ZBLzUKSycx5IpsYIYb8lI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0L8ZUhnlBcH4t8TMbOhN7tIkDK3TN_zQMlkkDuk9_pA&oe=6B0EEAFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 Landscape cover 2560x1440.png", "id": "1805993010451842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839671_1805993013785175_149431532310392719_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M80ZfRzesqgQ7kNvwHNHE00&_nc_oc=AdqIbSlr17VUeW4BhMoCgKX9AbxcQ9EomW4yhIJ2q6mqYyNB3XsyNgMamaHZ0C04um8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUOw-ciXyK84L-b40qrylmaURV7vOZvwbiNZ-9JUCJbNw&oe=6B0F0002"}, "display_name": "WingGlide: VR Flight Adventure", "keywords": ["flying", "plane", "flightsimulator", "pilot", "cockpit"], "long_description": "The Skyreach is a scatter of islands floating above a sea of cloud, and you're its new courier pilot.\n\nClimb into a hand-built cockpit, flip the master switch, press START and feel the engine catch. Then carry the mail, the medicine and the wedding cake to short strips on windswept rocks, lakes in the clouds, mountain ledges, and an island cut off by a storm for years.\n\nSeven planes, from a vintage taildragger to a twin-engine freighter and a floatplane\nReal cockpits: grab the yoke, stick and throttle; every switch works\nHand tracking: fly with your own gloved hands, no controllers needed\n86 jobs in five regions: mail runs, fragile cargo, passengers, airdrops, photo flights and weather runs\nSkyreach Radio: two hours of island talk radio, with four serial stories, phone-ins and gossip\nUpgrade your planes, rise through the ranks, and light the beacons to open new skies\nMake the cockpit yours with trinkets you place by hand\nDusk flights with runway lights and a glowing panel\nOptional world leaderboards for stars, deliveries and the smoothest landing\nComfort settings: seated play, smooth air, soft fades, vignette, subtitles, and left-handed controls\n\nGreat for the whole family. No ads, no in-app purchases, no chat.", "short_description": " Fly the post across a sky of floating islands. Real interactive cockpits, real hands, cosy skies."}]}, "developer_name": "Wingpost studios", "developer_privacy_policy_url": "https://wingglidevr.com/privacy.html", "developer_terms_of_service_url": "https://wingglidevr.com/terms.html", "publisher_name": "Wingpost studios", "support_website_url": null, "website_url": "https://wingglidevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
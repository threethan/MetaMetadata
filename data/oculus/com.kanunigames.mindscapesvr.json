20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbQyorNgHEMQ7kNvwEI28C2&_nc_oc=AdqkuXxtEkMa5MJ8Yley9zcDANSA4vMS7eZmj0S02DVWgxTRupG1wl2F-u2jup_bGYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_CH4M26NZnh-_pXLAhYw1qYazXPrATgEbrltQNcQZfg&oe=6A1DAD43"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNfOWkmS_aQQ7kNvwGlF93N&_nc_oc=Adrj0Bw6dL-IfN_PARS7oWYkTeIOZXMvC8wB06fkCURN5P6AJE5PSHwpHq-HbDMQ3_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QoUtS2bynKs2Tq_MMTuP5u3Lt86DJX16oAobKrJRgFQ&oe=6A1D7C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-PvmzI_LsMQ7kNvwGARxeZ&_nc_oc=AdqDqIZxGco_yNYZfRqCmnjzScJ6sMYS04RlhVju_Xt2Lvf5pkUN7u8UrbV89OKzW1g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A-W8TOOOnspoXivVEUZLI8iZcQsda7ytA5-YLU4RUdg&oe=6A1D7E6D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsUs979aa3YQ7kNvwHbqy0x&_nc_oc=Adq5wnL-r7kbS-mcflr8-6FQLEgLeT51dOgE_1heyKzuRwJLKerpqAeRguqp3H2dqGc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv5ZNTchDyDKMDOFGyCj1iJn0EhHUcDEwm5FecWdD75g&oe=69C27D83"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhMp7D_wwfwQ7kNvwEOWan6&_nc_oc=Adq5FZLVWEqohKO2d0N41FmVvTKpE4iw6Z2qnyU2ALyBhVq-_4n9NYJzkxgZLTFAz3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxLQKlaLzQo4Xexp8MDlhJVWRNTP7iu89npUMy28Lzcg&oe=69C284A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOhucoHMZGcQ7kNvwHRqAxd&_nc_oc=AdrkvL607yyD3xyEiZi8Z-AEadjCj4xz-UMUFXZE0bjdfmiyl4gUZlzulVflsN8ezYM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1FfqFZM3NkZ6KE11-dWtkwSpjsodPDtFw0hMvjK2Dnw&oe=69C286ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
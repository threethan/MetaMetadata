20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UguOap5Lms4Q7kNvwHmVJCj&_nc_oc=AdoPgGbHYW0te02ADlGr-4gPoLAiBw1KNVmPaiwn6kcnXNwlDvFVkek0itP5C3KHRx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92A3XF775_p0vrHJ6Txtwrkv9l9GCGs5I5nRHCKy7WAw&oe=6A380B43"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHrkeZ2mRSAQ7kNvwFCa4Xm&_nc_oc=Adr5kgsMKMTKjbi0u3FHb5oxLufUpNBWCk4XobObyMqwk_DfRB1vkvOrK6OCm3FAIc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QdFzWm5Q5JPJxxuY96LG2VHSfo5scJOH0c20gruqeyw&oe=6A381268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25lw4IUIc6cQ7kNvwHYeLI-&_nc_oc=AdoP9xBNeAi5Im7kDeLZCkrdPbITfToDUEQ6dq58Ueeg_GOO91MC-1xJncwcAvYgyAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9btW2tColzh_0CkfeVgvMYb42So-UZXAc_yiN4-8Ga1g&oe=6A3814AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
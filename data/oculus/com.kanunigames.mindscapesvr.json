e7a0a&_nc_ohc=k9Fi82NpKbcQ7kNvwH-I0dI&_nc_oc=Adq8fpyCzkLRBDgcDbWOEuQhh_1YKLNv1tYfYynNtSnQHHQaIcDoxTPcysk5boHOZaw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKqc3xDqPLxends-4y4sBzF4_lHf_n5F9oPuInt7L53g&oe=6AFB2943"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QxVScrBrQEQ7kNvwFW1lx1&_nc_oc=AdrV5zhrsgZhGd7JLeH-5TD06iHDAF4NTZifhE_guyXsxFaHzAF8PgrwS5MEuuCLy44&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWx7VZiDB7jeYV--VGNW3rMTtuGdCsIAQsGoaExWCvGg&oe=6AFB3068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7a9kRcNpYIQ7kNvwGIUEyf&_nc_oc=AdpdI-BY5TiCclnbxIf_LW3kF3wKp8kftHhkZ2SkPZrNieZeUPhwYvo5ugYXb4VOXf0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgeyimaXwlF85Hb2R807JEX1GSDkbAxArCwQidlQ-sug&oe=6AFB32AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
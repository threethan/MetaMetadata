20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOo2jUZJaLAQ7kNvwHjk4b3&_nc_oc=AdrpHygltHv5UV2BWlmZ98qPeWTPKzbTKDO5AD2dVHrpG6m8K5GjyciOnFQOe7B0qAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q-YPvrRRGh0dLRtc5c1Jexf1JQ7IVXh2raO1wmTjWog&oe=6A007403"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj4xbraul80Q7kNvwFKPz-T&_nc_oc=Ado_UNSQJBPvAX0goabUwmVAVMkYIrxDUbitKjAm7VepdILLpuLJQxH6ioSTaCuFTug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U1sz1EhoIbmcjBVPf110okXU_otxGvKd5L_1SPOyBTA&oe=6A007B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVERuRf-gr4Q7kNvwFqji2f&_nc_oc=AdqNXUBjUS3Y3xHy733_mhu9EvVc5aN4TayK003UbHIFDOLnpsnrCmNw_JyjH2l0c4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XjoK7a1T6HeNeh0oF1JxDJlM1g0CWB5-2Y8U5hBiuFg&oe=6A007D6D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
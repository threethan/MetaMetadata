e7a0a&_nc_ohc=k9Fi82NpKbcQ7kNvwGOXlDp&_nc_oc=Adq_hoVcEEgLShExPEVWtUdFr1Se1PazuubL9TRfSi8rzaZVARtoPR49CGkjnmKqBCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDhW1ccPOr5coCIwUZaWAjZT9yicoPhRra5czLplEJlw&oe=6AFDCC43"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0M3pWW7_P0Q7kNvwEB5eTl&_nc_oc=Adrf1WfFaAcu4-deYyrV8ZHxodLoo5ZASvoKCIeZB1hHoyJlJ4D1Ct8QDM0rWtFcI2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHIyYz9X4vzr180Wb494PCMzDJffUVxqbBPhz7jHms7g&oe=6AFDD368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Bp6OnaRKoQ7kNvwE8Yaqd&_nc_oc=AdqukYqpmQIu-Xe6DGtcTPjpgq3QlOFlJ_pOvirXDWHlCaIzf51panVu2O_enrxbmDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUTARk718YectUO4RhY3CVOrCaCqHFqLMW0pwN2nS2Nw&oe=6AFDD5AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpC-LwCrj4sQ7kNvwFy5Wg9&_nc_oc=AdphdW4sblS12OG_4_W_2J8KOW6ew_Dbbl3c-siZU06ozCM1DtdqpVeL8S3DcK9NE_E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylTrt7NO3Kqe8rIHfonE8gQ1tHn06GJnsaebPAPAf0aA&oe=69C7C383"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I4a4TpfcC4Q7kNvwFGwbpl&_nc_oc=Adrgs_9m04-dhR4Z3awsszlMv6NWFX5oq5LsCiPfsWaQuJHU1hkPnT4jmfIQqpfmNhE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwp5_muy_rv4Eq_OT0co8v8byxFEBmfjwyYKFdL3KqQZw&oe=69C7CAA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-J9Eyuppu0Q7kNvwHvi0QC&_nc_oc=AdrrO0N-AEf5nMbBiRb7UyZMAgRPUR38sjlKntwUisZhuLkWw72THCuD6GbdgXILHHE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiFo6WrP8GEoiGOrZwaaGqWVnleoJcvFCNA4w_mtq-4g&oe=69C7CCED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
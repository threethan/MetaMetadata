20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSBamprC76oQ7kNvwG_r471&_nc_oc=Ado9NAZ3XGeTlnZFP23aWo8PBg_CzVNz5a29P_R-tjeGIkiA1ucYCr18fcxb2XrZXrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cXQzeVRM3FEUGE9ysxnddGXf-NIX2XwEzWWHrkOpDQA&oe=6A085D03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjuLF1qA33gQ7kNvwHrW11k&_nc_oc=Adp_aRffPVVxYdnygYOE3yFqMUpDS9LyOmd4stHQ3DovPi1LGL1wxcV8RuI-86qxZko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6beCkLjljK-oUw0F82Vy_JGfTeBYxj2hGrS1MZua6zoA&oe=6A086428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X62XL6L3easQ7kNvwEeWtDj&_nc_oc=Adrz19uWgW1XQfPKkTw_rcTcZDfHIAd6M4wmELSLwRdsT6wRGjmffv5XgL2V3Upw7Xs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T02q_qDZxwOGfdcY9Mbsyp1GeO6VW5oY4--KpeJ8R0w&oe=6A08666D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
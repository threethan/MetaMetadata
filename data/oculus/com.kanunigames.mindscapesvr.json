e7a0a&_nc_ohc=Mi9FQHNHWeEQ7kNvwFnluv6&_nc_oc=AdoUodlSUEACIs0Xwp85PKWCDZMey36MP5c75TnQY3aYRUqPRSeP1eJc_nlb9m7_LUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYnzBQdwJBIjxbiT7rZdaVu9eAkcJeOKnMNQVW_ZvjWw&oe=6B01C0C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVCxWzv67F8Q7kNvwENlZig&_nc_oc=AdrcJq8WHW2qZ2tctbBfuCevloJs0oDzRqnRg1nZz4EhVv796FMY5O1jOM1hQ8N8lMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL9XnAS4SJg_4jL0g5lak4Ut-xtDBaqRWRHRrt_4YqnQ&oe=6B01C7E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9Okek7DF3QQ7kNvwG1lntd&_nc_oc=AdpAM9EvB11fYn4Qcw03fQJxRBQsb9o3EwjPB6lSuNW5LXlCwMmVNPbdcV2qO1sU8TQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKaRNLXxZigBBaugm613nrJuv-qotZPayQwuTTjSYzfA&oe=6B01CA2D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
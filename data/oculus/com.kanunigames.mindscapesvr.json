20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbQyorNgHEMQ7kNvwFGL8Qn&_nc_oc=Adqq8l-gQkrbFKL3PznAA5mL8JaMIHs90b1NZLYob5xIyx252CdYH2VDhlRdyb52JyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tqE41bOfaAIrBQDmKzI2NUzfVGXWsgjiSfdSc0J7Zzg&oe=6A1EFEC3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNfOWkmS_aQQ7kNvwFxCiLX&_nc_oc=AdpkLwWNlchRQyQ2-Uxl9jbGgs_VBvRslb4ZDUXQ5EHceWtxg5EdPPlnhdgb9kde2dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SJIMcynWpF-aT-XF_E4xbnVMzYNR81z7ryWEEKhVsXg&oe=6A1ECDA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-PvmzI_LsMQ7kNvwGSRLkS&_nc_oc=AdocjNZi0KJalG8Z2K7C5N45sOyPwXQhm_epfNHe10o2jkycZrqDQnxo732WpQhx4gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T-Da23HsPKTgjNZ7hu8gAMrHiU6Z2nTVGkj1y3g_KyQ&oe=6A1ECFED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
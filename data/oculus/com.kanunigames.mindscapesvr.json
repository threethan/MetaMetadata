20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqY1oloWMXIQ7kNvwE1jepg&_nc_oc=Ado42Nvy9IxstcR-OheL60xQCtGPY2XJZI5Uv0DDAKyPfNjBjYeOPwCxQsbGKCnN2H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K5qUzM0LMQ8VD_uMdizQfRPsUGDNZxDOWqDYP9Vymwg&oe=6A2ED0C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwn-OegH4GUQ7kNvwFP3KKG&_nc_oc=AdopOudMg5PzwMFXb7UgQvj_kqrm_kOcemfHgBS02-kpDdyPTnIqVdTjRt1IeM8QNoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TZUUZFUVZRzrx7zbc6wotUnXEyHF6YuI4rb1vb1iVTA&oe=6A2E9FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kep6gT18784Q7kNvwE4Dwed&_nc_oc=Adq_kiQ3_aJXKVZfImikIw7yvl3rqUVPP36SgOmw_pcvC21ZnXngam8DTW2CEXruRMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WpW7NpSJnkXpFPOe3fsuMrRYniYUpYunvab_-uSkyOw&oe=6A2EA1ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkXuUz0_4XMQ7kNvwFdLuqD&_nc_oc=AdrKwOZcwR79kcJhfL5BhcxoJo5p4Skp-1vqbe2xWYnKz9XVBAEkLResD8kTReMyYhM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eKkLBQZKjCHBoLv-3cLBAme0vLDBDVvDONzWhs_NLfg&oe=6A2444C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlNslz_3PdMQ7kNvwG3u3_i&_nc_oc=AdpipXKqh37d3XdpRO5Smyvv7AwUKNUvdJVzAJ0oavwi72-N0wrGEuF-TWCM7B9Xw2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V-wz7iMUdtcml1QyvYot6WbWMvLgKilLJXcVPDzMNqw&oe=6A2413A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NghIq_69QuwQ7kNvwFX4kgZ&_nc_oc=Adol3qmuCH0O70L8deE05GsSWfS3XVDGz5uivkkfWHI0H3iBI3byAWoxe-evgjUBFhI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uKQ8xCLzPHKCpdB7nS50GBgBw6KV2wJO2Y8pt2bdhhw&oe=6A2415ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
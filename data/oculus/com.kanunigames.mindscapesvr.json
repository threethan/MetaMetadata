20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSBamprC76oQ7kNvwH3Lumk&_nc_oc=AdrP9ByJi34PEUOiLN4o3wVmk5waO0cXfGdPQj6i9GJ1Zg44-2zXiX6xziZIeTXNRJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59cXjBBYtJN1fsgmJwtXb0VzXc_zGP1FdTJvrQsWTX3g&oe=6A070B83"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piKz8efSiaYQ7kNvwHB7E3t&_nc_oc=Adp56RqvSxOWOn8reZvApqZafVVOvBrEu92NO1lGSB9eF4-EDixJuwi8jorgtlPTlZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gP_L6YLZSW__sJd1Q_K1yFnBcxyQJK8N1KsnmlP7KoA&oe=6A0712A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5aGbZq8IRcQ7kNvwHylEhA&_nc_oc=AdpH7-C6ReWg4Zpb3grVMZZsgeEkv8WSia4JgVOksRftb8zoxrfWberMpvmtZ_A-duY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D70ClI6bNSdxLD1DTq1lOf8aQ2s_zukKEeNAnHcYZEA&oe=6A0714ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
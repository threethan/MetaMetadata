20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTx8qIOIlE8Q7kNvwFF5cOC&_nc_oc=AdrnJjGJPf77lQam633nBtxROzSsjkhaRF4LFcji-BQyc_ZucBY053DYAhDfAOJP0wU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3toWj99zXQoMZbeRbY1KwGA9g0_j67UFat1VNGeWQPjQ&oe=69DF7E83"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYkYU6lXzCIQ7kNvwGhmZ_I&_nc_oc=Ado7CGO-6s8DuVYX8u1E78Hb7nnQUodUDLro-BMAN9H-bucAE3M9QI-6WtSM3M66gcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12e2oN5wm0XYpddjl3o_Cno4dXq9ASneArb-_zLgu5jA&oe=69DF85A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI-lywUxqusQ7kNvwGJIu6f&_nc_oc=AdoNT4WJa2jNkM5K-d5PVY-PfTQIzllMD9NLtJ4lCmFi71k89HNlaHVaJ2mdPpSiJog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35GOrsb2S8X2hnt1MS5Q2WSDt4nEIpoyKO5s4jRdbViA&oe=69DF87ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
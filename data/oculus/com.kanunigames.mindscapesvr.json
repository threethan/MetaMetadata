e7a0a&_nc_ohc=Mi9FQHNHWeEQ7kNvwELShzE&_nc_oc=Ado-5fvhKfZve1eXxutQcbeCzvLdTAf9rt_pqXGikipbj3Mi0eKZ18eLFy-loAOUv44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8xVOci084ulzwseR1jGilz8vI9dVBehENySjYVJ_WnA&oe=6B006F43"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0M3pWW7_P0Q7kNvwHmywhH&_nc_oc=AdotF7PdNjAnFVahCDKX05VDSvb4FhhvscXLxJI0zTtlY8gBhOVdQmauulpBqnPfjAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUq-33jI_kqZ_QvefrNJ-HJ2kuEJL5ZO94mFebzNbWNg&oe=6B007668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Bp6OnaRKoQ7kNvwGzDk2J&_nc_oc=AdozT-90GOwA6u0faWSJ4DYcXQa0pna0kXt1gBjPaDFfi9o7kj8rTz0q1nTrqCSrkCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEuWoMSmLswoasAMh69002MXOd4MXn9W4UcxD6SL_Cqg&oe=6B0078AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
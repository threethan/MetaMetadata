20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DX2kAm6pP4Q7kNvwHtEnK0&_nc_oc=Adq5M3nvJ4cIGrCwT17dbR3iFVkIxc-b49HsSMuenll082-Rvy4kjAX2MmyNCzoRGGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CG6AMklElYp0m0dQsbfHCl_mZmKPo7pgQ6VfFFIKCLQ&oe=6A3173C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTAf1Y9yAhQQ7kNvwH2OIFw&_nc_oc=Adq6o2jB6WiRKbd7kVGP1Gv4luESMDWG-ZfuG2dStbfzpb5RqFRAqOqYNHXo7xrfAg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N8HTnO524u_EAfYgsm4Fj1c9fjNPrVW5j2UR2lCL4hg&oe=6A3142A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cyrQTkjNKQQ7kNvwHpdzLR&_nc_oc=AdoWBgnBSny-J2J_FAKLgddPK7eALk9SUqNXlArEDjD111_GVCnYeGqUioMNZKH75eU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CBm5NKjIUeJTPWfJw7Hw9aMwbAjMegzBwCOHEYYBN4Q&oe=6A3144ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8twlSx-xYsQ7kNvwEKxQRu&_nc_oc=AdpOt4eJIgvN81C4M5iYyKksj5qNccMOXD2D8EXO9fRLn4jNB3Z-Yn_10wsALBxl71g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz42d4Rlzjf_bj739vAppLk1DGVEzh6v9jVGtbZwEoijg&oe=69CA6683"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E911ZGWAbIQ7kNvwEZP4ju&_nc_oc=AdrCEh26I5IeBpAJDiYEBRtCsmtyMFo4WxKI0Sk4ZYXDBfZboHDryyDJ7Gm-arnHi04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwqc6FN4XTyEwdN6yPaNeWGOJGUvX8Z8fnqWS7llrHi_A&oe=69CA6DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1IMu-GhqEEQ7kNvwEoiWrs&_nc_oc=AdoEeddVIT6fQW6zm8IJPZMjJs5a_-27RRPMOL_4HlZYnleoPS9vD3Pod8RUu2aVkgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-HcWRpSU6yor3jThg-o7XAYAiIufQXa7JM9A2bpmwHQ&oe=69CA6FED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
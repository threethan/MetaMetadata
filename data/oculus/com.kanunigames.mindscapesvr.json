20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WHDFE6VTC0Q7kNvwEmMetN&_nc_oc=AdrRLtBzdm8btUPNiMHQg1qK2Yg9eAQFwo4HSp5fp0bKQALfVzsvWfScbA7GjeKeB3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57wM9RchtWieuB-s14ytYj0PSivtMSBWARSnwM_KepYQ&oe=6A01C583"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj4xbraul80Q7kNvwEVJQ8K&_nc_oc=AdrgkoKFhwHfXGLYNYCuvde6x41WPMGLa4GOC8Q9mIdkF6jwtsaBhqAnUwd8HOSWZgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vaew0zlJW5NiokULJwbZme1mTDkPimivwdbBGiEklRQ&oe=6A01CCA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVERuRf-gr4Q7kNvwF_m-0m&_nc_oc=Adr-pA9v5M-5byIh9UnJq-aWsG5KU7HKLI97HmB2DWqCoX2K2wQTVgOMrsPxj6x0BCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fCsnSWsQ1z0UDa4xJJYcO9hC2o_xB-WXuD711d-fiWg&oe=6A01CEED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
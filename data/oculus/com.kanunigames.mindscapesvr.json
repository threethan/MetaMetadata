20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-XCx0AzfWkQ7kNvwEOPl7h&_nc_oc=AdohVgr5mZY2OQrJBhi1BHgX0nt7Wh67eLLQoKbrFV18JmMtsVZkD5HFvcoG55Uf7lw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t_O4SDrmcClvaFIyzH3oIlMDl1TdE8CrbyOiv4cG2VA&oe=69FC7F83"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdq-N4RjwdIQ7kNvwElb5Cc&_nc_oc=AdqKAibZHCk9vJZBAhmNDj6M9LanbJLohCe4AL_-6D_iuRqlzYMGWY68AVetQIrIOOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IPiGMnYNtKcQ4zCdfKsb4oM6BfyaYm4eVw6NkWH_a-w&oe=69FC86A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HNYDDsg6l8Q7kNvwGw_PPm&_nc_oc=AdrMbiSEWqXwcvrusoSqqUOU4VZjMiV0VFNycxpijCtovKq3U8o6niZrWrZ0trIlpzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c14StjnS5_ewvNE3BCNHyPEa4WAtAENDpyUM3C6-cIA&oe=69FC88ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
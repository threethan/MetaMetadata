20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPZF28q-UuUQ7kNvwE7-0Yn&_nc_oc=AdqMlJEX0pIXKFSSAzbueuCPwsrFibp3bajlmaXxdU2wSnyJ_znYBwKhy_b7PsLH49A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NhprzzDyifcrpxn_RwM8On7lB5woStCbrth9-P8rpyQ&oe=6A15C443"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngp38AN3VKwQ7kNvwFUvPmI&_nc_oc=AdoQL9QvXb9mMLcUKV9Wr4_l2nRv1VFFNli50hHlTwVWEddrt6gFtDv0__f_jLQDWjk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wk2I16R0tvUmyLivOcvGH6HusngLa97-jFPTnosOWzA&oe=6A159328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daw1BJygx7MQ7kNvwE4gazX&_nc_oc=AdpJlXJ2F5IzA7nweGd9wfiSeQAjI0ip320a5zgzaOZbW069lS_u_S-b9Fszj7gn_-E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xZGvPqIoUV_cvnm0Q0FBakR43ao3OWN_ZrEbcHJ4G5w&oe=6A15956D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
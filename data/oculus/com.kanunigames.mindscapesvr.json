20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyfy5a9x6K0Q7kNvwEy1ZIe&_nc_oc=AdqtUxVnQfiDxaZCIWss_agCENr7lD9_A9-yO2yNBqP6NMI2B5Bz27hqGZ4vm183BsQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZOBXjAFMIKJzuMGci2yau2qkC8fVh5yJmljARRe7Lyw&oe=69E76783"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGMLKwrM0EUQ7kNvwHtTyQ_&_nc_oc=AdrNW-e20pmie4R72vLVCx34OA5FAQpc73pMPQPTjq8b3qq5Ltaq1jOf3sO-F6um14k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kmSHows8RlsEOFw8WOcj0uFRicw0cWjJtKpuyMaqNHQ&oe=69E76EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_4JfPeVvFEQ7kNvwG-g3QX&_nc_oc=Adq5GkJdblcBOuqt0cWFTcM0PmryEfuUSQQrgnsJwmlpqosB5srD1EqogKqW-ptzI3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x_nUPFWVipaUYPEO6PfAFysWk3pTrdtxVAmN4ZCpS4w&oe=69E770ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
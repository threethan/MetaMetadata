20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbbyMp27oAoQ7kNvwH7HRZg&_nc_oc=Adp5SPbwKh0gAs2T35eO64PevESEysfqUdEciSSRaaBq0PJ_2Sw7U33g2CIjAaPk1Vs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ys-Pkl9dzkbA40nW_rKuejGp3nBjtyf6uJ0gFAljW_w&oe=6A09AE83"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjuLF1qA33gQ7kNvwH7Q4WN&_nc_oc=AdpjXsS4TGenDOzxyY84jsFME9CsH4Xgdntyp-5sp2mYFtBhZsfLkb_kYHYH6ZPUAmE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vDXmL5zeHNug0o69C_6sBRSVWXVg2NjbJ_DM_IeP_Iw&oe=6A09B5A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X62XL6L3easQ7kNvwFIMFb7&_nc_oc=AdpcvJh7_qPMxzI-HWtAImbKH-OH1SUL3xJMMyYE16u4xXfnV3hTqlDuR7vgZu4bC6g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-MqaA1Djcz9iJAEnecLkDPssdly9Ytup0Mv_e6B4OtA&oe=6A09B7ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
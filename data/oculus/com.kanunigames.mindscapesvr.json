e7a0a&_nc_ohc=eOW-bsV4L8wQ7kNvwHmPISY&_nc_oc=AdqlKP9GhAJ0fGyMA0cH-uq8K8LNT5fcICR8O8KCBVlwFO4a3ZAIwuqjR-c2mOoh7k0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLEfOshDCkKoe9UDszWp61J2yV8yVxeesLRydZ6tyTLQ&oe=6B09A9C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjz5bZ4_ANUQ7kNvwHTWiZ2&_nc_oc=Adr0UclAJW3A0PBMzLvGliNXh2zHB4VkWjzR3C5qUV6NyxZv_Qcb5fnTGTxfULsVEwc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuAq-HzUdifwID_ELh6z-08RWrWe1Ml6y5ukD0wLd6uQ&oe=6B09B0E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7xwRrWtrMIQ7kNvwFq0KCx&_nc_oc=AdoqYfKG-L_hr7WQo26XlSa8_GRcbTsTd0qQjYpqUGL-VsJLI3t8C0ghaEloJqkd_H4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ97eqKvnENz9k7LdF7IaaUttdqBIH5lJWEwoR4A2AoJw&oe=6B09B32D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
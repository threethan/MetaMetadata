20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyfy5a9x6K0Q7kNvwGQcgFM&_nc_oc=Adq0m0chwRQSoVYN-_8Jbzp9PudFFzi6XmCwUl1i2Yssk08OCYftqXQTY4CfVFQ0KRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nkGkH3elQO4K0UBL7_SK6SZAEB7Z6uJxvn-Cy0NGdRA&oe=69E8B903"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxOE8m6RQ6AQ7kNvwHmXzi8&_nc_oc=AdrhQlNAvVUohpVIy-ChUPI1CIuMyYIdmglijS9Zw8tAGZip5JH7_VYZ_pLfXE6XRqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15xM3ocBse5PCFo6a8RsPq3vBNDzfg8XK8Llhaw_lVNg&oe=69E8C028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV1P-_JJI-kQ7kNvwGv9OQj&_nc_oc=AdrNP2adBvtttmv-n4zHDgLGCAl16oqnTrKzCNR0YAxkcJCDquHV38Zh6q0Les6j9Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j9d--t2osYM2vb4L4aAMbFgL4N3XWkJ0RP5YWvuHFVg&oe=69E8C26D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
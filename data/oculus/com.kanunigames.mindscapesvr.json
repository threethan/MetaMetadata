20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8twlSx-xYsQ7kNvwFi4FKK&_nc_oc=AdpJQusbzQSCAIePtXTmVE_bHezMcZkah5jiVbKjzVfqLVj6ownoG7HbNb5FO8MU3qE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwktRBNDanQutprqB1q7nLBNpIfwM-Q4AZzNlIiBVvnTQ&oe=69CD0983"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwrtIyNI04oQ7kNvwG_l_ka&_nc_oc=Adq54YpvAR3mCi_EIJUkoX-gRrXqWmvNNsRi7eGPMHgjPOl0Z43s90yNy2fGCOpuh0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzc0bGkk7noP2GoJY3q4NW0-EY9mDhALFfD62xvxrUZ0Q&oe=69CD10A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqcuqzM1UOgQ7kNvwGujHjc&_nc_oc=Adp5AvYLV6p0nPJPUQCX8CLK-vAZE3ERxp4CqQctFKDn8CWYntElT6mVYqK7d8u0eK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkF6j0h7v_FHBadzMkATW4Mxa69dMfR7ryJC_RtQSHlA&oe=69CD12ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
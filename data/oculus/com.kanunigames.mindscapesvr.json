20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPV3BidL_J4Q7kNvwF6ZFUb&_nc_oc=AdqSFPs_680Uh0t_zWkTl5KzoPpvnE95EQ7TBWby5s15SGfVDWHjdXBoCutWtubhdVQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VveEf4fL-uyYdS9i9mVP6zqjWsUARwcxzZHCnECavgQ&oe=69F34503"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJPDACyMHMIQ7kNvwF3nycV&_nc_oc=Adr2mn0uguDWCUQpvE7Ya6FLDobZw4zR39-RiGQU6nY7OCLTQIIy-K8MuiIja-k0_1o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jqEA088zyrJSVU9A5Wxo1hoj7OYU0xeehYUNjSyhI8g&oe=69F34C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=140hoo9lNioQ7kNvwEdpB6B&_nc_oc=AdrV2mAJU66iKvUYqXBvXSClQuY6-LcOJqM45VN8kp8qnzPlKfV2DU4c54STerAVm6U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sqNNLMl_uYkG4DOm-2vv7tUsYjFuA0rhwun-m2gPVLw&oe=69F34E6D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WtuwtCpZzkQ7kNvwFCp99M&_nc_oc=AdrkOsbFv6L1kL9dJMgNS1ifWYmBuRT2jRLad_q1HPXNPLm0J3IcAiotxolq_EvTylM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hQW4VXduizItapl62Kde7dLvtVU4JoqqOyc9k8bmwJw&oe=6A107E43"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaYBqLMQ5K0Q7kNvwHDGqpg&_nc_oc=AdpHQnG-Z98XVjfW5Z3jYgW46FxQYIBdySRDDul0q6VvV1tla0-EEBIdS-7p2XRHsoU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L_yXgloDrKIN8ZGRzHlEIgidQrqTpa-EUDd07gFoUIg&oe=6A104D28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2X9Qik-I2IQ7kNvwFHUsLm&_nc_oc=AdpjTOM2z0B4WiV8XGRI_dVlVXqTYGh3pAWszx7Bs3PQCuwJZHNmKKVpckJoHVARdS0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kHXvkXiudoIeWVcAnZ5gzOvNKLUOba3p9IgqFoHtOlA&oe=6A104F6D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
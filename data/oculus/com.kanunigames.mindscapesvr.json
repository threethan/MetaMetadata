20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXwunzNgE28Q7kNvwHJB0To&_nc_oc=AdqnUyGy6dIkqfTCmZ3Zoync6Cj6JmSQWJmfa_jRti9WaYsk8C7uMNcsuXDdwDZZDRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2AKjUlyw3TjzCBkznJcRchrzURsSvERB0pE9nM5Vu1Q&oe=69CE5B03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwrtIyNI04oQ7kNvwEe8CF4&_nc_oc=AdrV7cifWgOC-KsMDKMybqsh-K-6dm-k3iGNSiEtLoTM0iet0XeLyrp2jAtNGVTYAuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyFVywo01iZ9cBbHQlTARwFkMxQYgqceitYTUJGUt3VQ&oe=69CE6228"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqcuqzM1UOgQ7kNvwGhoks-&_nc_oc=AdpxvDjwIsPF6InV1TmArvqaIQUNxbuY1Pdmiav0bva8n2QE1CbwjCwr4YX2CzdsNw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTKF7BJvyrxqiOb_BXAm1zGtt5z37izJeHGJJ4_OIAww&oe=69CE646D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
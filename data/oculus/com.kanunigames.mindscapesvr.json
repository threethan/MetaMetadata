e7a0a&_nc_ohc=MJqy5dAPIaYQ7kNvwHeJvuk&_nc_oc=Adr0l30yQFm4i67HUCg3UnvlLZmEvnPuEMM74tmy2_m7E9-obc7aXxNKsxEpey0b5a4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4z0sIUGmLuPUff05ZL0rVTNfqQm80nxgrgMX3HuJoDA&oe=6B0B3383"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjz5bZ4_ANUQ7kNvwH6yTUe&_nc_oc=AdozhQ86sMC43FCetF_2U8paiiFidkEAH1bi-E-orwsYpLyQg7ufuBbXIArXxcAwrFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYMHdurz3n7H8abX1X_rFkHQQUBoZvRWx-N48ZtwE3yA&oe=6B0B3AA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7xwRrWtrMIQ7kNvwEcbM7p&_nc_oc=AdrarJKiCG1P6oU1Ik5no8uJ3gRIOVoLAtu7BW8J68W-FucapSqSjer-KAz9CAaArj4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFJOPq6A_N8_156uHwAQLquWIqhq7wC6jfL0DymNZN_g&oe=6B0B3CED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTUFZP3LzjwQ7kNvwGnIhr2&_nc_oc=Ado1R7lJmjLFPe5RRNquZuJZAOiIGrcY76Le9Qeo7MpI9hWJ_emzvt0ipZj2-5XNbr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90Kp5ZLq6-bSqLkEzOVwDAiUAlgJSlYJyp8ZkbXxc_XQ&oe=6A3BFFC3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z2qatS36ToQ7kNvwFB6Y2R&_nc_oc=Adp4JQb0eH1EpXtJz7-_lcok3B-mxnW7VX4jQGS1Ravaf_GWWpVczb8L7LiFbaSexec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WKpqOQibpPl4rFAoRgDqTS_pnt2Jf1sAgptOw7Hp76Q&oe=6A3BCEA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aHUHXnDK6cQ7kNvwF5vRxA&_nc_oc=AdrR0uw6yBzcT5-f8VzfbVSegNU5413INXYXaGgL7PlEAmTyXNvxdBSPsEh21dLCov0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yFWigC1pjv9jrNfR640wnb_25myhKw3P1lRHeuMC0Yw&oe=6A3BD0ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
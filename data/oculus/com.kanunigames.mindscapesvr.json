": "3884240828478281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrMHXPO2NQ8Q7kNvwF641ZP&_nc_oc=AdpNrZ0Til2Yc1qOhPKbABzrWhoj1z4xwPfudLuE6_sBy40FapMYyAV8KRLLdHXiU0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBFT3i9xfJi8j_BkIKFiD_qkkCA4sb9YtUnVZhksbtvw&oe=6AE21CC3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho-YIOEdT3MQ7kNvwFjwxos&_nc_oc=Adruw7GBqBy1bMdLb7NEkMxEsEmLHxC2CftWWQcC6x1cJiS-OimC5b7fYJUmBd3zATc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1N-vNNZDbTxPOSSL_-mmz8DrT69K2wBzFvEd-veaDuA&oe=6AE1EBA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxegU9q2vDoQ7kNvwH036D5&_nc_oc=AdrGAzGHdT62AAGxMkd36htE_1apdnJis1TysLKife8nEZFONoTdHv4EfcZEBnIM_sM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3ZPew-bq8R_PN27T8MCbrI3x60B0XnDmED5YQ4pNu0Q&oe=6AE1EDED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "short_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/kanuni-games-meta-horizon-and/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "KANUNI GAMES OYUN YAZILIM VE PAZARLAMA", "support_website_url": null, "website_url": "https://www.kanunigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28318785284457008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43997713_479130177788651_1774975227775546923_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYlYX7mKG5kQ7kNvwGtQL6y&_nc_oc=AdpfBbQpU3FaHevfOwOVARnHtAjj-KKGU0g1BYXKYLfOekGwaMOuROsW0d-qIo-DbLs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgArk4bE89vu4qlTc1zvs4WEdzGZ-i-eDrwJGpOFLhkQ&oe=6AE1EBB0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindscapes VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
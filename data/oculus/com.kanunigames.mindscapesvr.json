e7a0a&_nc_ohc=b4N5G4cSdE8Q7kNvwEmL4YR&_nc_oc=Adr0tOBuhRAnHQlEIN7vMLoTIi5y2nBJbSCgbmZBg1Cy-Sj8_PttV0x2IaZdew2kyZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVRIjv4iWRSk6PmleUi5QJXISwELAa8UDItVabgjg8sA&oe=6B05B543"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsxyir0c3zwQ7kNvwGTt-Lt&_nc_oc=AdoVWuPDjzy0NPJ3gmUdsCz1jIFcn_Cmk-N-autDSJ9_fnRDCAaOZ5aF8GgEpJ1M5XI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwfcmn0KFDg6w7o-VFS0FOWYev13GE5vzQXndO2MqRcw&oe=6B05BC68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FnAvB2TmnAQ7kNvwHOSeqx&_nc_oc=Adq8A4cGw3Rs79bfsPsnTX8SOuB5AoFXrb3HZH0HjGURoKoNrbPMlxvGJ3RUvE1Kw5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTknzfn81ahicXxrMwX-lN509y8TgBb6oD9hD6IY1WZJw&oe=6B05BEAD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
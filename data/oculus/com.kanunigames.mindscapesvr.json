20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-XCx0AzfWkQ7kNvwHcwkCo&_nc_oc=AdpzxfLxkBFWgN1asjkRM6Fzn_6k1lL9mYoxpr9LEMCKAUJzO_1ca1pDYt18xQh3vtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jafEIRpUoOezWp9oPG8SBK5QDP4Fobq2Qw7i8cCspMA&oe=69F9DC83"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1c37jAXZK0Q7kNvwEYxkDM&_nc_oc=Adqn0JaaTnmV_UXkRBTo56JiAKBLcWsU7v4SQPfsqpWnZ2AYq9OpLNGAEkygzzf76xY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59hO8QqmiqM7Icovm3NEYyAyuIxyF2_JHwMJfgbG1mMw&oe=69F9E3A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBeWTBrBn5oQ7kNvwEv6FfG&_nc_oc=AdrG2qmnQ_DOh4FYthXTsLZeBQ5a6s8o8iiQNljTdYNUBTJ7BzZQ-RQLX05tEsbkfwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ok27OJzshsArO68O3nkDEz-6PEXax1Y9a009PqXomsA&oe=69F9E5ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOo2jUZJaLAQ7kNvwFrHdKp&_nc_oc=Adr5IOf0VuAed3L9vnE2Jpd6K9z6FmspDJEludfsAIRvfyEQK2ywfsgcDI3o90vdprI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af411vehtUTuiuOfedg9rtiMah6lO-ocnhpcwhSgZ7LdWQ&oe=69FF2283"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdq-N4RjwdIQ7kNvwEJsjnz&_nc_oc=AdqTOqjEZ1WaqmiiEWPh-1LWoB4iO8IBy47oPoiKbFZdW6vP308wVQZxd_V-IZdN72k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vbo_B_cSoSRTzgvlNU3WT91MvJUiu8SPlWCbXaRRTQQ&oe=69FF29A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HNYDDsg6l8Q7kNvwEiw5Gq&_nc_oc=AdqkOSPReJtJX_5nZeATs0oDXx72lbSoUFjGhq30hTTQTnSDAEEvZ0l7mb2jgUQnFzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-XXrycwOya1KO2jrw2a2oCKXZRJ0GEhjvWqkOKY8Zwg&oe=69FF2BED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvrLb8z5TRcQ7kNvwFCotu2&_nc_oc=Adr_lJMbNO_ug6w9nKOH8UjPaJ1SkIF371CNYJk9flr09Ovxdu5KaQ1YxkA8wpLsSU0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O3MW0wPLOSmorkat4pgHyIfmFJ0c9gLrcrEoxAECNQw&oe=69D79583"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2SsDeYq-5gQ7kNvwFONxy5&_nc_oc=AdqAwCIOQuMzF9o-XVT0ZrOZdgPsO2xOfE5IB-ZwBbj4FXxxurY9l2yoLQuMjxb31Nw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VAX6Re1dJhoGznbQBN_Z-WHJyeQy7O8jts3gv-U7YGQ&oe=69D79CA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zeowm_GGsAQ7kNvwExpNCA&_nc_oc=AdodCR5XIPwt7h8MpfsXTE5QmjOXvuCJwa9EObbI4VZxmJEddjRyQTwK_NHl_i12mnY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fz-j_edvmvkWN2P7MxCnfyuw55hXLQYXYra8edA3LLw&oe=69D79EED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
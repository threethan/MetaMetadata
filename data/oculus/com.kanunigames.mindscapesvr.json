20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXwunzNgE28Q7kNvwGRLnX7&_nc_oc=Adr3rK_XK_ljJcvug4E70OK8Kph8IoShCTrlAlxy2_uF7Ux0No5DGTiEkppfOou3g8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwICAjTtRJgyZuFxO8h-AZkM7jf4pogFIYt_ipe0Lg3_g&oe=69D0FE03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPFQThUfXsoQ7kNvwH422go&_nc_oc=Adoe13aaY5tUL5moCZdCncY77qLdi9nlUq7C1iR1hjFGgIBUH4AYyLV4n1_52D7QVHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDnY1qx_GnwhIuKsIgQqChLGKDFx-X93rbWsIkCrETyA&oe=69D10528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlSHvJic9DQQ7kNvwGJcIgM&_nc_oc=AdrqDNkrVuwAP_FjVAgFjC_k6v0uVP0rocuy9X9OV_azXcTuXhF8Hu72tPsjIdKBtt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyBBorTz2kMiYSExz6QqMASk-_EO36gXe2-2trzBN5UA&oe=69D1076D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
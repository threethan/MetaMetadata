9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-W-qrOFeG0Q7kNvwGQ33oJ&_nc_oc=Adme4SSWOW7idQ583Vlgo678iBYfCFcq1Gzue7LsQqSmHfvl3LEtOnPeMdv3DRHn1gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIPJVTDgP307zQJgepSz-kMIUjBQUGMTLlFCUDVOBrGw&oe=69B16A36"}, {"file_name": "1.png", "id": "397645879935703", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75416840_397645883269036_5906608356058859329_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUw2YlcowNIQ7kNvwFRkSSv&_nc_oc=AdkBqTReHMs0K_RFH8DF3qMc1AGLkqyOo109LQmbTMOmKfdegwrZiXrwclJlD_09WKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzp-jpqASiy97bZP3SKwa4gZi6_CVNK14TqVpF4e47QGA&oe=69B14C7D"}, {"file_name": "2.png", "id": "3884240828478281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd4Rm5LHplcQ7kNvwHMavjH&_nc_oc=AdltnVXN2zpmm2a1PKejSQIVm6ULoV7SQnhEUMA74bQWowuIR6PIsIyedWhDumMf7H0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhnUhGQsyqEoNw2R87ijJ1BuNqzAUoyE91R7VWy7b0Yw&oe=69B15A03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uTc-IqbdA4Q7kNvwHheZZa&_nc_oc=Adlz7QpA97wzBcPqOr9jJJV4qopU8MLyFkFAaOa-Ox3ucATJ7WkdKU0BuRQolDYtLg4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqmk-r7ffnH8VK0aqlzxDvX-rrSEn_ydy_AKxk6mbo4w&oe=69B16128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sosifLlCV0Q7kNvwF7K-J-&_nc_oc=Adn105kXTqNqg4NJRoTsU9zhw5ExYjt2onaMAjk2cJpWbo-Xm2yRDBR_prwSNmDW3xY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKcoZrNzaunTFPMHTrQOsSDiJOeEjfwzeLE6FiBXBPwA&oe=69B1636D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "short_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://kanunigames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "KANUNI GAMES OYUN YAZILIM VE PAZARLAMA", "support_website_url": null, "website_url": "https://www.kanunigames.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7503369266425247"}, "review_messages
": "3884240828478281", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974820_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-faQWb7URwQ7kNvwF_C_Hz&_nc_oc=AdpU8m4Cj56cv7CeVfFUXI6Lf9JSf3qeoxlq-76Dq_Ijopr3lPIWGnwJnpzcNttIlyk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP-vjRD-rngm8RWkqnEf5DVjveJKPI1EhVRupf41ZxEg&oe=6ADCD6C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3wQHa7U6-MQ7kNvwGdP9_V&_nc_oc=AdqKAibWtcow8lcvCMLqy-r53Zp-pBxA-knVO7e_9VNjAf27iCdcuq8ax__nc1pTp-k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPopQH-cBNKO7vsDD-l7FeYY_DSmEBmv4wGwx21fNApNQ&oe=6ADCA5A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOPP0ya1YnoQ7kNvwGHtaAF&_nc_oc=Adov0aEbt7HUU9TpnWDfhXV6A3jl_1_PsDipxGah0r4KJQRsryl4u1sO8cxSDN_xw50&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdQI-7PZlLBgwIji9GDBPysPz8INaOTgZCEqL9FA7YBQ&oe=6ADCA7ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "short_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/kanuni-games-meta-horizon-and/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "KANUNI GAMES OYUN YAZILIM VE PAZARLAMA", "support_website_url": null, "website_url": "https://www.kanunigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28318785284457008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/43997713_479130177788651_1774975227775546923_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y5c_0C658MQ7kNvwFdW9Uk&_nc_oc=Adqk9F8K_6v3M8OcS0NkGXrZJYL6gmNOIIs76dH6I0OE5VevofhXNINYkN6roCoYIaQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN8ZzLi3ns-zyUu37MKfOpoC1HZuJp0FwzgeQ9tiSkNA&oe=6ADCA5B0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindscapes VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
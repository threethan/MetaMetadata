20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTx8qIOIlE8Q7kNvwHO9O3W&_nc_oc=AdrgaiHdZhxbepfBcUdD33QnpWOI5jveU6AG1oEl4e8LmrzQHTQMUv4UIYB4SrmVAgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SoKb9I8lfiYNTx2vSiW3X7_vYuEBvhP6X8FbEbBO64A&oe=69E0D003"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O14pEDPw8kQ7kNvwH15w5M&_nc_oc=AdrIK_8cGb8xG_5UU6VroCVwyG_QxOrMLcvWaRnT6Lwm1OWdLtp-D6F7BlEISHtTwb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xsLhNsYED8z4nmcYsmId2savE3uxSqUOtZY5LKrAd8Q&oe=69E0D728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcyUo_LxMlwQ7kNvwFy4M-g&_nc_oc=AdrU-pW-mRIVjYX3Lzzw4DUP0WYbsd938msisTv0CwhX6KCkDwfTXG7XT3_1o9Ag7PM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e5MuaWCXolCOU2AcTU3g6YQKgxL7XeAM7-NphXZCTYQ&oe=69E0D96D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
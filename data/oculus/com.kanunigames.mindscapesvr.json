20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRS8wsRKgdoQ7kNvwGIeVOv&_nc_oc=Adp7QMJ6SQaIrjdSWbc4YDNZkMZZQyWtI8qt7z3K-O4F7kclQiEd_smTUvsCR0sDRj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EZ5iU5eplWorZaimpOKaBIi1NLPE2ODiG9Pp4g_KHOQ&oe=6A43E8C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0YCDcfZTPwQ7kNvwGHPYGL&_nc_oc=AdpQFBAjSUbIk_5n8oqynmsOCY_veBL1rBZldQZmGk5wrzz9MIHUbxJ8hjwiGX-jIbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_8Ly-BFtTJRnEUTsW0kD8ybCvcNOLKelaVO3GOPKVPQ&oe=6A43B7A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyvDN88RDegQ7kNvwEoRdG-&_nc_oc=Adqcx71KKUw6HI3zeWBBhbkVHsUSs8UpwwnaW1b1ZaHLFiEB9lWGovmzAvOGfpJOlMU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FFdXnOAXsKHR5ev_AJsOM6n13GW3RmDJtIFp-ho0uoA&oe=6A43B9ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
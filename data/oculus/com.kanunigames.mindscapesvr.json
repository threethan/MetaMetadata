20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPZF28q-UuUQ7kNvwGA12TR&_nc_oc=AdqphCwT3gRwq5EDAMz-Y1YUvdyBUwQpAgjU1nc9C9cCJID3wNGyBBKbd3kZXnE3fy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wSictgwg7IiNE_D1G8ETTcWWzTWBiMimArm1CxXEqpw&oe=6A16DD83"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngp38AN3VKwQ7kNvwFDfEXv&_nc_oc=AdqajiPfVIH_iImYBURAzQ6aQoAv16YicC5pecQfVxxKx9Go_aIY3nSt8KyhbNoDRQE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QYg4g0nlLbb1cPLu3AzzEYbKcRj6-CrhZdnJ_Ys6pRw&oe=6A16E4A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daw1BJygx7MQ7kNvwFUsdjQ&_nc_oc=Adq6Q1ZAV91PPchoT6N1lDLm5M6GdvbGmug6auA0Y4RxoDGUxDyf2YVLr8Gt0IWaM2I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73TwL2sLtySu0gePb7KoJfGREzTrUa_4vXIMCjhScAdA&oe=6A16E6ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
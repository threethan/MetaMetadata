20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UguOap5Lms4Q7kNvwEe27VY&_nc_oc=AdqEnr3MF3fEkG_MShoziJv2nzALmvJkB4SlcKvQqAMmRZ8Os04OIoPU4rTPXmOEn2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jYfljqX8mB4yPvxGr_tSp3Hpztt-LcJJuyhWU57qriA&oe=6A356843"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl0rgQyq7HkQ7kNvwHxtG0R&_nc_oc=AdqP7zN9EW2F1xCA8bAzP84Ne4gcU21NRYbVkbqZjIuuHlA5GAITVyizStxiA3GTTp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FB6jBuzhnqv-wbXB1TOPRpvdWPqs1I0n533u4XIl_Rw&oe=6A356F68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEyueai0euUQ7kNvwGtmLkm&_nc_oc=AdrnNOUnpzmTlvtBURb1GXgOE6LnzsMHtV2desY77eyvNJlUyv4z9CNVsJOSYl8AGY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uWpDH-_QqwAwwa6mmPOZ1uDseyKO4iotwEDHSGD4rXg&oe=6A3571AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
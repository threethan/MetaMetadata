e7a0a&_nc_ohc=MJqy5dAPIaYQ7kNvwHUBDF6&_nc_oc=AdpewjEuIKsaHpama0wbgJ42SHjokdbUABYiy68GxOnbW75Y-v5eUzOS10LXn-7GUJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9AtZN3Q11Rs_gADMY8TmNSvI-XN40IMyiBLjfNu8uUA&oe=6B0D9E43"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GTT9Mg8ORwQ7kNvwG0Xjxx&_nc_oc=AdqclgQMbbMka65rZkN9Yp_2EHIvm3ExuV95Aht3EQsk6BKbL8PZP7-NwxdJC_iy3lA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGqbKJBLl1zA6xnG5EmKaQfHPiCwI5QsgUJ5l6SvyMng&oe=6B0DA568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBlfb8OtCoAQ7kNvwH6qkYY&_nc_oc=AdpfafionuMYwxPfin0EJe2FMveEfSP_45f-3AZFyd3oCJ7kflrPH9ULpBw4CJPfkMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2dlHrgAhYeIUjBW8lYh2Z-6CH8PL_PdnZbk8rGIH7pA&oe=6B0DA7AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
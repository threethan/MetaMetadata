20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-F2cn3zFLcQ7kNvwGTY9P9&_nc_oc=AdpDOc2wsJfdd6ZrMWBMylmTqHyh5Q6OVZCfmMMlBnARF_LKE8XQV2jaTaopx0jw9qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t7RyN9tRDUS_dl8wkx47DZOaCnPuEHPmdRmS2t9-Rww&oe=6A1472C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngp38AN3VKwQ7kNvwG_58HG&_nc_oc=AdqBWOffFKyNCCyFHZy4-WWhU3k3UMktXv5pOiDsmUAL1lp8OtZKmx3QJJJWEdSJ8QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43nii6CKLXrjwyo9MN32q6hO4dez2HNns12zFWVTVqbA&oe=6A1479E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daw1BJygx7MQ7kNvwEt9KOR&_nc_oc=AdqVplzL2x2WtMFeNZYyx6PpiLFtUDrYJEcbCxonWdxdWyLRn-8913x_p90EpmxafWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6maRjFsktxlOKz9TzBKaqVf0kSgasy-SDyCFALo5IHHw&oe=6A1443ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
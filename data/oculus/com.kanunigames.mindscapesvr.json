20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTUFZP3LzjwQ7kNvwE6U2G1&_nc_oc=Adp3wnVhni3LLbHXD32WlWqvsCUVfuXX1DcUP_X-fcPiYN7QfxerOjQyV1PIBqSsyFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mdI016brbqhHQ43lztA6fArdmyCi03sw5md-3apB2ww&oe=6A3AAE43"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHrkeZ2mRSAQ7kNvwGbSaNi&_nc_oc=AdqfQRnGIR3CZOTCRBY76pP4ndZrapy98N8ICysAbAYTrqUxTzvLgX9FpZH2p7Z25yw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZNOICHIAsd_AD1KuU4P1G-RYAH5BQx1LLhYnzQor6Aw&oe=6A3AB568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25lw4IUIc6cQ7kNvwF8ETFB&_nc_oc=Adphfncy3lBIuGwRZYV4OHqL3W7rqiAlvQONvoxU5bvPTf-z3aZLDMsJmXHDm6Gp5so&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WjSBq7MYmEMMzrAQBJm3EAfBKfmzyuqCem3fl_Fu5sA&oe=6A3AB7AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVvmzcBssrIQ7kNvwFjVDv_&_nc_oc=AdqZ53rt1yxCqyYZpzWnh-AxoqiBapIyI1d2oUqGtg46WOQRNt4EAwDIIyn4vvbI3I4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cdyrLk3fhwB2NIhN8Y7m2rtsVaepYE5Ds_nnbgln-9g&oe=6A283943"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67apK2Y-LTQQ7kNvwFTeYiF&_nc_oc=Adpybhop8ACsFqmXFYsGObtKlQhI3YrgT-uHy8FugbDYWevbDREs_zbles1ABM5S25c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_61MOpn4AKDgm2t7O9CTvt8ELNOofri0b8xQK898d3qA&oe=6A280828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNcM6duVSM0Q7kNvwHF7B7Q&_nc_oc=Adq5oM1MO0FOy5QrM64c-FPxt6WrBjyeJ6QAl4pifWwLSWhMwQr1OmhF2pejisDbxE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wl93o6oUeZzrJnzis3aiWxz5bnF-vKG5nygv5QbiWtg&oe=6A280A6D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_yXdKD9r78Q7kNvwESe3TC&_nc_oc=AdqwEu7t7zVYSNP-vzWe3I4r5Rs1_t5CLyjp_EVdFzP7lAsssAQXGy-aSdIh3IcExVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35JS8Glws6dN4hmRbYSBvcGHyudZbcqF98oobmgGle4A&oe=69E37303"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O14pEDPw8kQ7kNvwHfalZK&_nc_oc=AdrQCThVSeaJJgO4vKrZT0phVDeD-BW8swRUxIJmztd7ICW7oztYF3YW5fpFwDeCmYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fF-NBKHFv66mUNrb8VUi_eMCCwHtAw-HeXIZTYXLDbw&oe=69E37A28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcyUo_LxMlwQ7kNvwHeZWp-&_nc_oc=Adr1S-XNsEbdLHEdC_GzFUCb5nYUx6oeDFMy8p7CRutdqCG-n_VodHMhpGEx8__Dt5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sEaVyFWD46lF2WAS4iJprq2UdR6RsfFqJUuyKEBPisA&oe=69E37C6D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGRe0Jh_ReMQ7kNvwEyNTXT&_nc_oc=AdoR4xcwmRqkdcfg8K3r8-fYN1rFUiUUMbr8fuonG1mpXTSDMvF9Q4KMnxv8G-geYgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WyLTlAk8KBtOuKbgDguzTg38bm1XBwlH6pLsS9ZMQrw&oe=69DB8A03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPMsCRuQUHUQ7kNvwG3O2YS&_nc_oc=AdrjVUJbj24xWaSZbOBV9leguUNs_MuUtFd9jOZt_AQDELWDJ18KhEc_RxYLYHIw_mY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R9HaX7CuV2oJv_qLjrz2sAkh84JrdI3GrvxeV89ryNg&oe=69DB9128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRJJVrV--AcQ7kNvwHW4JrX&_nc_oc=AdoJMGFvJ_f-daMQ3tqEB1bYp4HMpiKU6MqmcX0N3GllLW-7FTmuNqlTfzX5GcNQV7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EgPRpEdkL4z9bLVg1AAQ5bqQ-BHSJ3nFpH1K4T6BLow&oe=69DB936D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
oh=00_Af1n0-QwIW94I7Y68kHbl4tTRsmEPgfX1uV6gkO-PrQY8Q&oe=69F1F383"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJPDACyMHMIQ7kNvwHG5TjB&_nc_oc=AdpJxORex71P0l_kwg9dv47TaX0xdQehQ_B5wTHScSAL7z6pKPPRjp4expAIgcZrb7I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0TaD6RC2b5BRJJ8nHfdE4tK4CbckLTBtJhS3aK_LYrdQ&oe=69F1FAA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=140hoo9lNioQ7kNvwFWIv40&_nc_oc=Adqoce4d7ZQPafvzn5iyGeUOT2CdQZtbi_UMnquKjpxFXpyr_XAGCbV2qBM8HHuOVa0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3WlhLsSWXxvOWik0z61pC9mAzIwArxLYMaMh8w7uo11w&oe=69F1FCED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "short_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. "}]}, "developer_name": null, "dev
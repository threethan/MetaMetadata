20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGFEI8ohyhIQ7kNvwEiviyX&_nc_oc=AdrDRVLdZw2pve4HGv0vTIdY67isFy27Od62a65XKpaPuk1_045YN8WuEAWHkJPFZVk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yV7hAiF95GMrWnQPp10GZYbnlDIsTFVHBfBSFcyQSjw&oe=69EF5083"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_P0nbzqhoAQ7kNvwEdUFms&_nc_oc=AdrV2TppYpMATg5xh6IIylf9hKBcUck4a5HXEhPDjn67RgAwQMzSX5V7cefHRVgPy-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Jzu_JeQWzNAZsbXrvnyBSUKC7k_wmWKHnzgGIS9MYFA&oe=69EF57A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cHYrlBNQ00Q7kNvwHqxD_w&_nc_oc=AdqA-npfVvtJwcP0fc9NiFIe8cSn0xYZ9I6ERMJfapE5B6a8JyxBEjnR7tWbx6r9YGc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04cKk2ArdaROj2waSF99GiRMYvJUQqYe0YArAWLaI0Lw&oe=69EF59ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
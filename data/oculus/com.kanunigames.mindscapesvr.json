20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSBamprC76oQ7kNvwEVZOdC&_nc_oc=AdqT86qj4ffR9bMlPWu01EgqbShXRlJtDfcaUDm1i5kBV6MoJ7UY1fyMKAVH0ITcQaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q-BGx9qrTNoaiDSfsfM0jePARB2EgD5E5Xkd2Q1DCDA&oe=6A05BA03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piKz8efSiaYQ7kNvwFpZOrA&_nc_oc=Adrnm63EDw66zKzZ8zMFimD7u8xR8YLu_psTAsQEitmu070Vpl1YDKXmIxqU7BLqjB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51XBNsUWVPXATuWp97A3ZsoQK4qCpxJ_q0EdWxuyE9-w&oe=6A05C128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5aGbZq8IRcQ7kNvwFNmBcH&_nc_oc=Adon8Bft4Nd4avdUzk6ByJoTE2VEsBJyww5fiKSha2-mtW_iuS_YqiwdITJEolkWW_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w7sJSivnj039v-EdQB7eaoT3ezRlg3PmTKBN2ZEFj8g&oe=6A05C36D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
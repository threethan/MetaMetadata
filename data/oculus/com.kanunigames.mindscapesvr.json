20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WtuwtCpZzkQ7kNvwF53hH4&_nc_oc=Ado3anzY2Zg6i9XyJHAhCPsQrN8exyjp7OKz7bESEQ7TPDS_Zh1CbUwYjatwK05kGE8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TdcGTiyB-FFilneySfPZmSyiD3htr-sxgkJJG-aVLLQ&oe=6A0EF483"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoz5inSH9r0Q7kNvwGoZN5S&_nc_oc=AdoP-TimNXT-j6BgPJq6Lgl7vBpdOYm-ejrpKTTfhdjnOC9NWupyCBRRIh2kvuKSK3g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UO2cZGKA4dUU-RQozgsKCAVkkWhki9TzNEExkvDDM3Q&oe=6A0EFBA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3Dbt1kuvJcQ7kNvwH5zhUt&_nc_oc=AdolHzsgDpnOvABXGZFNSHRpifUZAzqdxnustFvxnhOxZThjVMDNCXpG6bD9WqpNINA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jogQgJYCVDr9qNd6RQzJ6zqqTlJm-1RpmDViRVVNB8g&oe=6A0EFDED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqY1oloWMXIQ7kNvwHv_4iE&_nc_oc=Adq6WoWyH-ZqqmdXlQ2Lcy7lE53sn6_eyHu2n6UA0qW7M-FOK2mUkj9c2PAdPJ-4LkY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jG6yij6v2B5OdvMD072403GUaMNBJ94muE5HIcwHSGw&oe=6A302243"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTAf1Y9yAhQQ7kNvwFcdh2n&_nc_oc=AdokkGTWwgBwT_64WJvEsLksKrFvayvfVGdIA9IATm0FTVReN6fMy5c7XV1_DZxGASs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94Rjq8PZldhX0NONWS44KrvKFIPBRacMsNxhlzuy9h7w&oe=6A302968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cyrQTkjNKQQ7kNvwHSjxJL&_nc_oc=AdqrsW3VuTHMuDoZLEmpakzmspOfnOTXKTj-6toyudOPWFAy7b8uCcRD7oK5gd_zuN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ajZ5Vu7FnQNUZEDPpWKsHevAAddN2y-xk5g67PDk_hw&oe=6A2FF36D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
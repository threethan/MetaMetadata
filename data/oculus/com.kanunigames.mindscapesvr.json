e7a0a&_nc_ohc=eOW-bsV4L8wQ7kNvwEzCegF&_nc_oc=AdrotE8lzby8yslHYPTlvw3cdAYZRHMAnXs2djEmQ7I7fHVg365-wACKQmtMPOo2Kws&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoWxRCKONLtuTjEkLUu-fNeNXjI-0FpilPXgswFQpaYQ&oe=6B085843"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsxyir0c3zwQ7kNvwEHsY-S&_nc_oc=Adp4vzLoeCqAkZvtuHUjmILA_r0I6pVY4OGmlhM8hn5rUJpOtdq0UgpWPK0JgyW3CL4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe-Si7P7IOBe1yTNP-cFsbmlZcNIZEd8gZdDjPWxeGfw&oe=6B085F68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FnAvB2TmnAQ7kNvwGT8rt3&_nc_oc=Adqih1sei2WlJzfGzaXI-uNPgJRjphHUicl7wM1vLDzsXTBAjujguWskPDyIPWZzCRI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZSvYw0kGI73WZOTiSnN1Uc-IglctibbmhKJbu9zFr4g&oe=6B0861AD"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
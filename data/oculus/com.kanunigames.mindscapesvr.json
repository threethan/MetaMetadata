20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK5NlpnGlaEQ7kNvwH5lz8y&_nc_oc=AdpLa3mQUkMWprt4I0H7qNVPS7gOcrT4MJGyqMg1uSe4dh9s4olP7qxP_IQttiU00M4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTt9q3DtrQj0nPg0MvO7HTpa2J2oU6lKcJmIG9sle81w&oe=6A4A8043"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYjY9NGcpg0Q7kNvwFv_z--&_nc_oc=AdpNP4fM_TqnIxReZS_oaMekvZez5l-LMEGKKiPtrQsHfR0vWBxEF1wJOrZ08N6ug1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoAT56IgW4kWWziCHPtjh1aRKFBcr_1x44DH_JOr3Vpg&oe=6A4A4F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD-wIBgn4JIQ7kNvwG9PpRh&_nc_oc=AdrP_liYkl1Juv7VGL6RPoGSnFgl58et7EQv3uHLXU5AJueFR1UGcK0xI6IT4jrIW_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAVtldT267GfByJaQBwZfNe9uaOTSPIm99thPwuSC6lQ&oe=6A4A516D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
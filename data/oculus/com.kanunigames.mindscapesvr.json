20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DX2kAm6pP4Q7kNvwGS_G81&_nc_oc=Adq5Dhh3F1fr8Ckxwl_0ynUE74q_zhCcU3J7klmmnCb-UbzoRNh50he0c5-WF4ynYbk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tVrNmBJsUIzc42oMMvVTWai2OoKWWMth6CQin3if4vA&oe=6A3416C3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl0rgQyq7HkQ7kNvwEIxILQ&_nc_oc=AdoGrLY1eIxaSLgvgtc7zjvLBQtTJtAGtbd1IodQBIx3CBMgoFSUhJlX8akvtz3aLyU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KHIpg6U4OTaZ51_ytlv_mn6JzMbBM7zpa_GDGoZPFWQ&oe=6A341DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEyueai0euUQ7kNvwGN8WYu&_nc_oc=AdqrmHukDLxPSnSprJLf-JbAB3yR_a-OfanAtm-VFPgzYQeTuENluPcQl3G0yXdHlbo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-md4N-FBUs9_QOppe0WY8pzspk10XqHhYfFmBFT_G70Q&oe=6A34202D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
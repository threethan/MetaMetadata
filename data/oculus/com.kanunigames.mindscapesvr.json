e7a0a&_nc_ohc=k9Fi82NpKbcQ7kNvwEL8k7-&_nc_oc=AdoLVxLldCyUnNrYvkz8x_d_1N9n_nJp0L5vD37F9vj9--sPuT0vs_GoJOqri3fti6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5SdDfweD9WPDYtUKigE4lkR9raqj9waHN-c1_rDgwdg&oe=6AFC7AC3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QxVScrBrQEQ7kNvwEDRA7f&_nc_oc=Adp3GRp1dQkvmx6DCU9kRwcHKn_ZSQWmiDpnwwdoBRzmbomYoYA1DWbQYjfLU0sr8Sk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxoujyHUdnc-BkCZzQwdNmgnlMMPXO5TTq2lJP_Ba41A&oe=6AFC81E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7a9kRcNpYIQ7kNvwEvfLU9&_nc_oc=AdpacHb0khb2YiXflAJKPILdXhPR6eMguqKiaP-6k83h4i5Gg2DaVLHyWo8dyH-a9tI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwo4BfHXQ0Hb0ObfwHpYvbDpEf8JUBM2mPeIIyp6qROA&oe=6AFC842D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "sho
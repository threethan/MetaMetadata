1-25/38974820_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-F2cn3zFLcQ7kNvwHSs9Sn&_nc_oc=AdqRsJKceI_Du3mVIsb9racqqfyyhQIzFkE3KMnSycbZDy6BphYz9veGmsRtSiB92Dw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hwXoIrIQjqSdJZV4KRFa3wXRzHCtoJcHALG7nC9EcWA&oe=6A11CFC3"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaYBqLMQ5K0Q7kNvwHFfPk3&_nc_oc=AdoDf5MGfTG9jpQh2cVDYk9BUhZT6m4yWBiwufcRKo-Ne-A7tAxOUejYPTmGhq0aa6Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46MLruP7qxHjc8I1vUSbif_MTDNbual9MJbAwmoc5l7w&oe=6A119EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2X9Qik-I2IQ7kNvwGVevyv&_nc_oc=AdqfRL6Y5NGxuHALqMHAjYtEiekV3dflfPDq-xSgCBgts15Yhjky5FII7PjPxS8qcY0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45lTHOdoMrcbElU16llX4X7f15KRxlA2S_C8uysvQ7XA&oe=6A11A0ED"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "short_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://kanunigames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "KANUNI GAMES OYUN YAZILIM VE PAZARLAMA", "support_website_url": null, "website_url": "https://www.kanunigames.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7503369266425247"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "402768882723337"}]}, "baseline_offer": {"id": "402768882723337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715711160, "status": "PUBLISHED", "id": "402768882723337"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7503394806422693", "version": "0.1"}, "id": "1088178485606760", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7503369233091917", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "75
": "3884240828478281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM9QGVlvkhUQ7kNvwFLyyT1&_nc_oc=Adp4YkRl8FQffBKAxxi29oqEYTbJC4Zika3H5OPW9ZXjg0_lkXSiWROHlQZuiOGB1Ao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPFqs-scv0RTTk7eOggTZ2DfLv4Dg_cd1tlRIafWRCgQ&oe=6AE61143"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77a3886Qkc8Q7kNvwHUKpMg&_nc_oc=AdoXXqyFl1K57k4gu3Xd2XbKoIOzJiqRFtopf62hi0ts1v8XposfvsBJ6RUTTFxUl3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb3KX3Rl0fuP6ysFz8YSbRgTYsDzk91HsLz18o7NEiiw&oe=6AE5E028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNSfq2g0W-YQ7kNvwFXqFB3&_nc_oc=AdoZ812KoHbb0X-eTYlE5DeQqQjcypKBouzBWuu2Qu6xPDJ07d8wFGb7-HLizjcvJsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU5pvCoFrqUG93ayh0CZY7k1WgyOWJgYPQAFS_imAFNQ&oe=6AE5E26D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in a virtual world.", "short_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/kanuni-games-meta-horizon-and/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "KANUNI GAMES OYUN YAZILIM VE PAZARLAMA", "support_website_url": null, "website_url": "https://www.kanunigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28318785284457008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/43997713_479130177788651_1774975227775546923_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbATxmkRloAQ7kNvwHx55hk&_nc_oc=AdqJLW7avjyT7nd9ek4cz6fC4RimTAbPIHk3DVmB-o-UMwx9Qq0--AtUrN27VE3dkl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUx1hxKSKTIrMTiASWrmOWo34ls2RnO6TIjk-dWLQ1NQ&oe=6AE5E030"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindscapes VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
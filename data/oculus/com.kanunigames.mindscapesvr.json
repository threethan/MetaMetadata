20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTx8qIOIlE8Q7kNvwE-mXyc&_nc_oc=AdodO9dehe91OWP1f8kxKJozs0qINyx-Zc60zSk_05DMEDMQyRxNwgbcXI6iz72l9Pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17XX9kqtC-F8lXiXHMDYgxBCgyD-MM9gLPlqhZaJvYGQ&oe=69DE2D03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYkYU6lXzCIQ7kNvwGnTMZd&_nc_oc=Adp-V9V96dBBkiWtMVRR92SWuysxZRuah08UoY6gjtGzLGUgkEZzkuS4hRMEBzmHLAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UhEMtsqALVBnx7efE0qzt5Q45mCgWuKUoWlHNJH7P4Q&oe=69DE3428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI-lywUxqusQ7kNvwFL6qWJ&_nc_oc=AdqyWrCykFi1WdxuhiWNWc4cjWGRp4QRoG99PatZHIBCB1FeO2tZ5i7PgaO7Usfqt2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Buy7prk652Dq1y0fChltUobj5nOoO8mlbIu3oShCOwQ&oe=69DE366D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
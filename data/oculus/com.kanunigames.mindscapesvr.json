20_3884240831811614_5082812230737072158_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-XCx0AzfWkQ7kNvwHHlUS1&_nc_oc=Adr0wbBy1gyikndj4oly7w3XsRLLcnXIhetGu0iq4Q-vSSXQYMHz4GHIcJH5b9HESAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z0dRB66fd0sNIraHObvqMHOuIC7S5OCuh7z6_Ffo_zA&oe=69FB2E03"}, {"file_name": "3.png", "id": "432335502742353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_432335506075686_658855420320446679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1c37jAXZK0Q7kNvwGiuGUZ&_nc_oc=AdoIrsGdTCVqIQ6fg26K9d_Lbd833ObAx2uR5DwkeHE9eOTjdSE-LUgLSmQ1rMe3-4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eoq3nSdK8bGmN43Fh1yjt-CRUwI5tMBR7Li3nSFPCvQ&oe=69FB3528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapes.png", "id": "980651206426248", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_980651209759581_7319636075069757775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBeWTBrBn5oQ7kNvwGlT5kW&_nc_oc=AdrDT2VPcwam4UmCjytODFtyZl-KIPhX9LmEi542nJBRbxaMuXjr8tt-Wn1TL2ptgqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TG3TnziKLW51ECH64eK8LatWMd9rvqW2mGANlvkmhGw&oe=69FB376D"}, "display_name": "Mindscapes VR", "keywords": [], "long_description": "\"MindScapes VR\" invites you to challenge your mental boundaries through an immersive virtual reality puzzle experience. This unique VR game tests your cognitive skills across five distinct games. In the 'Find 10' game, you must quickly identify pairs of numbers that sum up to ten. The 'Pixel Game' sharpens your visual skills as you meticulously recreate a pixelated image. 'Face Recognition Game' enhances your memory by matching familiar faces with their names. In 'Ball Sort', you refine your problem-solving abilities by grouping same-colored balls into a single capsule. \"MindScapes VR\" offers both fun and educational brain workouts, allowing you to enjoy the thrill of solving puzzles in 
_2925569147666169_7478769903994509157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0QiA45MhPIQ7kNvwEoGctv&_nc_oc=Adoma5PIdwcSdgj--Tnu6uSqFQt_PaljkHxpT2yoHNefJlRWGoTnHKbqqcEbhHQdWNQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6qgKAW7zK1XZqR3-9VKVqUTS54hRWhGN6WcpHRLU0Uw&oe=6A2425EE"}, {"file_name": "VReps Basketball Playbook_0064.png", "id": "468009544579039", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75236138_468009547912372_3259227384223439699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlwh7tMiQ4AQ7kNvwFAFu2G&_nc_oc=AdpYgyhmaEa1BRj6154QYM7JlJWiXPC5aRpCy8DdVPCGONNeD38Kp3lSXyH3eCSTX2A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bSb2BXO_Hp-2Rj1P2NUirChEDwv7P7qZ337yTWtolkQ&oe=6A243E36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VReps Basketball", "keywords": ["vreps", "basketball", "trainer", "hooplab", "training"], "long_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Remove tedious walk-throughs from practice and allow players to take the initiative and study decision-making on their own.\n\nExperience plays and reads from the perspective of any player on the court, or roam freely to explore the play from any angle. Interact with your plays and reads in a whole new way, and move from X\u2019s and O\u2019s to a 3D simulation.\n\nEither use VReps to create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started.", "short_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Allow players to take the initiative and study decision-making outside of practice\n\nVReps's experts can create create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get start
dn.com&_nc_ss=7f20f&oh=00_AQRaTh7Dgb3TrA_mVbGhisct2obF35rJpC3-acTG2H2vEQ&oe=6B086F64"}, {"file_name": "VReps Basketball Playbook_0099.png", "id": "2925569144332836", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222937_2925569147666169_7478769903994509157_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grCs4aDTvjsQ7kNvwEbE13r&_nc_oc=AdrUzihHsWHt9yNkUCmyzYzjAofPaqV4Wew-BEUCGOrSZHT_6eLeX1brBi0wORyITTg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWs0teCNW1IaWMIXbSsYHYu7doe_MI49tLqLJsFSZRiw&oe=6B0871AE"}, {"file_name": "VReps Basketball Playbook_0064.png", "id": "468009544579039", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75236138_468009547912372_3259227384223439699_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmuVVe-yCOcQ7kNvwHseP3N&_nc_oc=Adp48mu0_rt5sn2ICtGaYmdBqt8q8OjLQojrFxV2RHYIYPUAAc85-qdjO_uBxV_bUbQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeUpO5oTgM9Q_CDu8EfYua3SuMXyhz30BvU8ppNHQe-Q&oe=6B0851B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VReps Basketball", "keywords": ["vreps", "basketball", "trainer", "hooplab", "training"], "long_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Remove tedious walk-throughs from practice and allow players to take the initiative and study decision-making on their own.\n\nExperience plays and reads from the perspective of any player on the court, or roam freely to explore the play from any angle. Interact with your plays and reads in a whole new way, and move from X\u2019s and O\u2019s to a 3D simulation.\n\nEither use VReps to create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started.", "short_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Allow players to take the initiative and study decision-making outside of practice\n\nVReps's experts can create create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreps.tech/en/legal/privacy", "developer_terms_of_service_url": "https://vreps.tech/en/legal/terms", "publisher_name": "Virtual Repetitions LLC", "support_website_url": null, "website_url": "https://vreps.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SPORTS", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35686982217613694"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974526_1082004326875314_2500174206853471563_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlSMWRmcrY0Q7kNvwFbMtlp&_nc_oc=Adq14AvXCDcXxFQ_3e0idc3tHJ87O4wyUWHAUocH9kHqy1EcKNmEcep0Hb05eKLD290&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT41JbR1Wg3Jm_VIeS9vICo8iisETDbThcy-htI2iz0Hw&oe=6B0853AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VReps Basketball", "platform": "ANDROID_6DOF", "context_category": {"context_category":
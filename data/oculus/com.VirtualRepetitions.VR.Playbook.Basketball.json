dn.com&_nc_ss=7f20f&oh=00_AQQ2I5yRB9uNgtwDbLt9aDwGaYotFE_fERaPjpoklfplfg&oe=6B09C0E4"}, {"file_name": "VReps Basketball Playbook_0099.png", "id": "2925569144332836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222937_2925569147666169_7478769903994509157_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRpAqMcXRzcQ7kNvwFz57pf&_nc_oc=AdqsJ3EQ1DSeYsaAS_pMZmHMFTz72Ii3UgZDPRTuBnQKmi-3224Vg6j5NZpzVCtusqo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDJtsFgPjlrOIL5VTTAmcq1kpkMs6oU17Re33LaRgysQ&oe=6B09C32E"}, {"file_name": "VReps Basketball Playbook_0064.png", "id": "468009544579039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75236138_468009547912372_3259227384223439699_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmuVVe-yCOcQ7kNvwHank2C&_nc_oc=AdoTMjbPWtJDALefZfbtlmBSD3EwEQKsSvgbnVq4lpYT93FQdl_4GAL4sxOibxY14QA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNiesP7byvTh6SrYm1EWKXb-ZUqzPGXkHlsNM_Sfo0Bg&oe=6B09A336"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VReps Basketball", "keywords": ["vreps", "basketball", "trainer", "hooplab", "training"], "long_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Remove tedious walk-throughs from practice and allow players to take the initiative and study decision-making on their own.\n\nExperience plays and reads from the perspective of any player on the court, or roam freely to explore the play from any angle. Interact with your plays and reads in a whole new way, and move from X\u2019s and O\u2019s to a 3D simulation.\n\nEither use VReps to create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started.", "short_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Allow players to take the initiative and study decision-making outside of practice\n\nVReps's experts can create create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreps.tech/en/legal/privacy", "developer_terms_of_service_url": "https://vreps.tech/en/legal/terms", "publisher_name": "Virtual Repetitions LLC", "support_website_url": null, "website_url": "https://vreps.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SPORTS", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35686982217613694"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_1082004326875314_2500174206853471563_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlSMWRmcrY0Q7kNvwELjjB9&_nc_oc=Ado54Hc62l1brAKjnAcRSEr_fjnyHLAGWMW6_uXYHtZ4V7JATkiQNgOE-6IUBQS3s4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3RnT_TmkF2ZD769jBMVSpq3gIMs0ycD8sgPptMY5fFQ&oe=6B09A52E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VReps Basketball", "platform": "ANDROID_6DOF", "context_category": {"context_category":
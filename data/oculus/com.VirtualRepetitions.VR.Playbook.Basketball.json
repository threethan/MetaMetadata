_2925569147666169_7478769903994509157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcgaCKBiMvYQ7kNvwFiq1Bx&_nc_oc=Ado_hKgAnO53eBM0OFFoiMMX2Xgd1h1dhDZPSapqxZwU7_iSKiJlA7lNodsS5WkKS30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECeGDc9ZWXItpkaI2R1voiN_hr1umOyS7R_yF47hUHzQ&oe=6A8311EE"}, {"file_name": "VReps Basketball Playbook_0064.png", "id": "468009544579039", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236138_468009547912372_3259227384223439699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m28Xn_PQA40Q7kNvwGN9kvg&_nc_oc=AdobdjoogruRuBq0YJgPPGnx_AxCM2I-xiKmxGHBS8expoyffY7mtloNmrrkAuJ2Xvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ_lydO7HPwyRDK_pIzMwyZwaJd6cckVsj8Q7J3mhudA&oe=6A82F1F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VReps Basketball", "keywords": ["vreps", "basketball", "trainer", "hooplab", "training"], "long_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Remove tedious walk-throughs from practice and allow players to take the initiative and study decision-making on their own.\n\nExperience plays and reads from the perspective of any player on the court, or roam freely to explore the play from any angle. Interact with your plays and reads in a whole new way, and move from X\u2019s and O\u2019s to a 3D simulation.\n\nEither use VReps to create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started.", "short_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Allow players to take the initiative and study decision-making outside of practice\n\nVReps's experts can create create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get start
.5771-25/75230052_1316221642086721_2574414443352628371_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SlFu6KTXEoQ7kNvwGBXwPK&_nc_oc=Adpg4DNOtRfvJ4SwZRRW28OJh4voNmPWsTEYYK4AO0BwuQ7--yC1xEKy3ATYQMWbZms&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eI5q6GIOrSeiffmcCj2-mYiCUjTKs5KZV8qe_ugh-5Q&oe=6A11AEA4"}, {"file_name": "VReps Basketball Playbook_0099.png", "id": "2925569144332836", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75222937_2925569147666169_7478769903994509157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mclZ9j4B2lkQ7kNvwFCgIAc&_nc_oc=Adq1ndxavgUAbd00ZeReICoGpAKwdC3ZSEPBAs7QZilr9rhvlOPux3nqJP6_zYLyz9M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZFsk3acki51WrttWDzYGGOt2ejrcemeLZBeliZo9yZg&oe=6A11B0EE"}, {"file_name": "VReps Basketball Playbook_0064.png", "id": "468009544579039", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75236138_468009547912372_3259227384223439699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYhy_iK8stEQ7kNvwGTl-Zo&_nc_oc=AdpvCWvtqa8XBp9ku3zDlvRp0C0v5jJT59kGlDJatAD49i7IUbh_qLm0_bdvB36oO0U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kqnw2d8aS_ajbXdx8WvvzNLC8OVza7VkZLU8T_elRKw&oe=6A11C936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VReps Basketball", "keywords": ["vreps", "basketball", "trainer", "hooplab", "training"], "long_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Remove tedious walk-throughs from practice and allow players to take the initiative and study decision-making on their own.\n\nExperience plays and reads from the perspective of any player on the court, or roam freely to explore the play from any angle. Interact with your plays and reads in a whole new way, and move from X\u2019s and O\u2019s to a 3D simulation.\n\nEither use VReps to create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started.", "short_description": "Welcome to VReps Basketball - an immersive experience revolutionizing player development. Allow players to take the initiative and study decision-making outside of practice\n\nVReps's experts can create create custom content that reflects your basketball philosophy, or choose from our library of pre-built content. Visit https://vreps.us/player-development/ to get started."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreps.us/privacy/", "developer_terms_of_service_url": "https://www.vreps.us/terms/", "publisher_name": "Virtual Repetitions LLC", "support_website_url": "https://help.vreps.us/", "website_url": "https://www.vreps.us/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SPORTS", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27537322052579792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974526_1082004326875314_2500174206853471563_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKF0tkL0dBIQ7kNvwEg-7Br&_nc_oc=Adpc6YAlmcNW1uEmSA98hcOxrIvt-QMcdExf2pd4ErnmY6vJ10785WiWIr_c3To3D0w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79y4y64ARWzl0K0Ys9UsbuuoMl
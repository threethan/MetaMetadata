F2EaeS&_nc_oc=Adquzm4CGSof1HEt7JvTOucKRfDrtIp8DpTDldJgD8_ldLBD-t6qtfYzk0CLqdcPPUs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv4Ezj7wgiZm1Oa3fg-PsNsAGtY_t2Q-J6oGF71LeJXQ&oe=6A85907E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zcqi74z6gPsQ7kNvwEAcqzB&_nc_oc=AdrV3-tkEZYYzwPyUfuZj4b4fZpzHU0vsG1FUXUW8839YAv3VxXRVVZhscBZHn8vAdY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYAp3KP_K_rXzjosgfw_4mLQX8KJ4HTymrCTVpF0FMFg&oe=6A85A17C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPjULVfUEPgQ7kNvwFNMsjp&_nc_oc=Adqw1y5Ue7xnyflYe8OSZTWC-15gdryW5nzVwXDBm6Z0azC-OJelsODC2jzJXkH8ntg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1Ygg3YdrirGIpudzMFXsDHVzbTjKcILhOz4KG536Iww&oe=6A8587C7"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3uSd0r9OIIQ7kNvwEidtKY&_nc_oc=Adr39KqH2DtG3WB3iZ5x1NJlz-qwRPy7X6bxWwBmWJN-fp3jm_eldfZsyOt4GKq0VCc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK0141we1LkQ501oeuK4tlxXxjabCiBgcWvqHxuEKmOA&oe=6A85ABD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VfrcI1ExUIQ7kNvwGbWOL0&_nc_oc=AdoDXtuB99jdaE-16VPsTuBYAjAbtwixJKsBR6fn9LQloESnlcdh6luAL9Szlig3s-0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiBFFDuoLZFpM6Qt5uJsHm0Js19JfpLftL5CGS2xnEQQ&oe=6A858024"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase o
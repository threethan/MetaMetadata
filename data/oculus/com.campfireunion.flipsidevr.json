&_nc_oc=Adp7xw72P60gBrGXS1cKOeGPykIugsLPZMjJW1qUk4QqO0PTIswlkNPpcZHt5-359DE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Avi_s0J96zO6SP_aVInrNSf2o6YjY-aQlrAbo9bSDaA&oe=6A3168BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49XngjXL3jMQ7kNvwEO0njW&_nc_oc=Adot0z6XcRyuIKp4Ny-vY5t9urwBClJ1scS8zV3UFrmB6rX3TTkQ3QRwYReDSJL2cf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eyVcNctMSozG_BitMoRLovi08e_01eQ1yIo-VBQ3rcQ&oe=6A3179BC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74-R1s888KMQ7kNvwEMWJID&_nc_oc=Adob3rvIXay18ZX7e_X_iTBH3wfxS9o3iHe4mW8iM9qT94iEq-lg3t5xt20HyQj8SHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__1fVY3aTKph6CTl5a4klahGug7mzc6MOK_t7UsF6xMg&oe=6A316007"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FynG61WUgsAQ7kNvwELzVck&_nc_oc=AdohE5D9mEpP2NpUBGG3s6MwJAGECGhhrVSEucv1i3dzVFpgV61cFpsAf_R-_Jx_rio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0vHhEVY0YSCV5HY5zIfbNEcrGPv1EUmArWJgXRv9_NQ&oe=6A314BD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C411F71DyI8Q7kNvwFsb2Vy&_nc_oc=AdqqllS4LN6-zNAWMDyoBASmQfcOloS3rJWFsJHzKmFmjg-Q3rq-EIw67iWlN-uez_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v5h1STlBSEdT3PgvPf_6NoFwP6oBiyyAaHlsXAz1bEA&oe=6A315864"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
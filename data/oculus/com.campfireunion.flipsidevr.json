&_nc_oc=AdqfFVbCHMVKI3v9ZObXiTlDnjozj9Dhczsz6T23ku6JBQW3gohrES6fSyNbHQkzRjI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04z4IZqC9Wzh765CkrZwReqvyVsOLA8UgB98YMOe_M2g&oe=69E24EBE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPDRFwAibPYQ7kNvwE0CUBv&_nc_oc=Adram6XMIBpA_cO62pom8dhvdC8ZhHAHlw0paA8K7PArFI4im3SX0S_2OW4Py25thB0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ofNNTHtZ9MdN1yG6HBFkAXdk2IJ652BKgkgibg56qQA&oe=69E2277C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEIKQ4HbLugQ7kNvwE9lg9p&_nc_oc=AdqNIv8ce8nISvdfWDP_AzFDAj3GKAWiYCcfzvaHIUWqeoNC56Yxinp4w1PeD5dZDTE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VzAuqPshENF00s9s3qLvFVviYayhzX5jm0-HoiMAL-A&oe=69E24607"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcsyMRKZeooQ7kNvwEgMsrO&_nc_oc=AdpRAQ95rF3Uvm6-VWnK_T_twKLG-f_zfCkxX3_-aOWdtOnCa9XweKxHKVikWO6bugo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m6M8tQT5vRe28ik4xXrNpJqghZlSLJppBc4eo6af6eg&oe=69E231D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbV5bIUd7xAQ7kNvwF_NDEd&_nc_oc=AdpUjN3vuktHTB7itI_G6TvR5EdfMxvMedjL7BRKbfUmoctroQMvM7hS6x9-ItF1sx4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KwCyBqbGunah9B16jzgYd6zXg1wQhjKwSOcwm2SLLHg&oe=69E23E64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=AdqsVEuhtDjkXIJL2svdeCG7qs6L4NgVQ10iBmtAGQtq_SRRigwy3wolHDxB--944nQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInq51kckcZ3Xzuf6ptXwQNm6DplIL5w-JM9OViMhzWKA&oe=6AAC043E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4W0sSQxUeQQ7kNvwGGOO1C&_nc_oc=AdriyP525349edQ8L3shZNwZm0xVUjDACDprTODRzRKo-zqVvRPfPf9Lw23ywAAQLe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMC5QRz5CPOxW6DgKC-Mli_j2KRMZAsETQzVDCn4McJg&oe=6AABDCFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7nF5NcXd2MQ7kNvwHd7rqw&_nc_oc=AdoY0s3rVswPHUQz6SsxLulWh9ZP6NuNI7XRHKfXLJB1U4p-4F1rozHlz2p_ok2MJN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIe4p6nbUrCjDRqQ84FBmfVCz-FBA9mbjvVXC1IUgP1Q&oe=6AABFB87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRS4pRFNlBwQ7kNvwFL2BFa&_nc_oc=AdpXh2vFO7PUUJiWHWmAnhNGzInSK_Ko7Nan6aaEN-_aNcbglkQajG9lDDYYcZqrRTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHgZPfixks3axVRL065junLMXPzlF0xvkzifOA4M1eIw&oe=6AABE755"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG4ipfTdpB8Q7kNvwEbN-dM&_nc_oc=AdpbHkjf5uxg1Wrg3YU6J1Wh7fLArRQeOvUKrffRmaofRJwlU7GIkQUxV03YNLJRnxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7VqNnh1ELkzDCRhV54hg1en0oBSyMe7tNB-3jAycWAw&oe=6AABF3E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
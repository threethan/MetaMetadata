&_nc_oc=Adr8IUF2afJuFoAh3OYiacxxEgt_sekv_QCiC2o7XYPwtcx_VE92mBVQdFxJ3MSTlbA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw-ruqUvbBuFunCik4LYcq9R6VmyG21_wAr0Gi1hEB4Q&oe=6A82ED7E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zcqi74z6gPsQ7kNvwHopz7i&_nc_oc=Adp5IAc6TT5i6BtTEYDDC29zv_nSsKeODsIYil_0Hg0zwm-4IBbAtKKZ5Xzn620tRWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcjo_NzsZ-M2m2-zk2m8VCeYlsAYOCHSvlXQmvahvriQ&oe=6A82FE7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeMbYxxisvYQ7kNvwFO3q8U&_nc_oc=Adrapbw7d8h9vOpCa4bznfC6WODwrscgUBmRpJt78sywHMf77ji-ijQqsLJKOip6Ero&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3NKoib6FALK8XeyDjeBQo__0Iytx83BYTFv-Q1hMNmg&oe=6A82E4C7"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIqT_ZZZADIQ7kNvwHfcOKe&_nc_oc=Adobor5PbSRwzWsy2WmJ1m-iLoeASLdQU_SYZB1ZI1LQ_qrclJxIFauA2NRjPq0inMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOAme1xN_6BdTj6jfdoveZOzc290K2isTGAzhlCYT6Jg&oe=6A8308D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9YFmkSzkbIQ7kNvwFgupFH&_nc_oc=AdpPp8UBNwgy7XpQPzaSLDReHoODU4fzcfuQIk3HilxdTYoQWocBac1RWsQZQaX0MBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLSAR-hTogROGm2do8ICD99g78tIav3-4O5SBZ2rZT1A&oe=6A831564"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
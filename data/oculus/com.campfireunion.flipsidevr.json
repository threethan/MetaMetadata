&_nc_oc=AdoHXEQHkbKGdN0iaUM86M_hGcUCDp6SZeM9jxi8fb5AyP5TBPSk9GcFDLOOQWwIh9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k1Rqen4RpaWKzoZ3ZkoCCLfrLNFTmIs_8bHKs7vPyhg&oe=69D4E77E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlQBa1Lhn9sQ7kNvwF-E670&_nc_oc=Adr0lvVdL7z_SuLDdoBLPI15Lqj3sCqP4lpIuCIjgRciPkdzglmWnQzaSf80dqVReTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mP9Adj4NFGpDo_gTHTuwu8vbxMs9NkIZA_j4cCzcQHg&oe=69D4F87C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60gFh1kbYzoQ7kNvwEjfaKp&_nc_oc=AdpgXxq9XEd0p8mtX6GZIatL7UVnde_Z8ccBtkEvpTd-9eFCbfoMjNgcSpjmwgU5UEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JNabAtgC_RtH25M9FlA6vgaMVscJJeiuiyMqMvGPrPA&oe=69D51707"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHaDA9huKDsQ7kNvwEi8lGx&_nc_oc=Ado51rUK4NpXYILj-e0YM-IRuyUl7K-2ZF4rz6x9lu5j977-zBMriXRM2Q01km3jEXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uKoDheMjFBh_m2XbU_14KUf6ethyzoT7r3azy9jnYag&oe=69D502D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg3nSRIYbV4Q7kNvwHlvXr1&_nc_oc=AdpB8wVAoFahIWV14yRztSpbL7WsjOC9AVXRBqgT4L4HQY_gmdFBRZWn3uB2PmcKa50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e5e2SSC02LNaZY0s56L35yGcTIA5VNDmEI1h0_HWB3g&oe=69D50F64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
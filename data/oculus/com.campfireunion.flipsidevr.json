&_nc_oc=AdoYNpGTCS4NxYPJA_OPsraIEIClQFggqq1pmXhCsK68euwS7G-2DluPflzRo2EI8n8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ij7r6aIycFO2snUpY9OOfwa7jczk8C0QJkhlBajC10w&oe=69FB5B3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okAx8ytHAiMQ7kNvwGr-Mg4&_nc_oc=AdrbN7JPAoaEiAMY-hGlRHyFrHmgpja3akKooBZxJXgapA3Zlet-oadT1_vLwWS6h_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-17X11MN07lfFlvHKTRe7bSXD0Ihg3FF4IPmnffA-4w&oe=69FB33FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgIgriNQBPIQ7kNvwEpFGXR&_nc_oc=AdqzESEn9YadC_mYLouMLXMMSz8wfYndILdembM-B4SGq6YniDUXQ0FnqxNXaB3_gq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U9xKLjNIKNqstQnD5BJr0rKAry72ThVbNS7D4qUXNOA&oe=69FB5287"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt0zhHHAx0gQ7kNvwEw2FkG&_nc_oc=AdobmWfDffQ3ajwg1m4Ug18rPSwBgiOBGQzn5TnMTCy9AWBwkckI3SwTiL0gg6SQdh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ud3WuTto3wwr2tTeitFIYBrA22wTo6ubkz66Av-4dXg&oe=69FB3E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bU3PQFDq7oQ7kNvwEagury&_nc_oc=AdoZ3RodwxU1jrT9T20cjvjDq0jYoxUO4iiZY9wmITVa2dwN0QmEVoNRlAPRyFsKi0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vSjNGA-czXPgUX1NOedxoiP2EFg1_fWM61PRHONZjDw&oe=69FB4AE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
5G-yjyLnNEeoLe4riQ&oe=69F0CF3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQiNjX2-ED4Q7kNvwHrwAFp&_nc_oc=AdotaGAHcQr4zRwXCJOswpw3gtrlQvf_BBPJ3Rcv0BjmeWh8zu8-c7vnogxjMtg7JuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1luIHsW3_kVEzMKJAe3RIARBiziGI1wSjh55frtKF3TQ&oe=69F0A7FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afVKx_2_8RYQ7kNvwEcwf5Z&_nc_oc=AdrVbeBvLOiL-YJLyhf6iXVikmm10zYscKsPR1KSJ6Lb9nt3do7ZooaRVKL2ivxnQOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2pvN7x2ydkoxPljfLpvp1DWKMGvugLVUMiQtGFpbo9dA&oe=69F0C687"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1GmVG-8CzoQ7kNvwGsoPIs&_nc_oc=AdoWlmqeWws7Cqn0yysmlU_nqUgdPUw4uHsPkLpYDOBf3rSJT1v-Ri8eKgk6L_WxL1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3zRYLQ1usp6M61FFW5an5dAHtVbvnt2fUYzh28cGn-AQ&oe=69F0B255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAoNjGr_Py4Q7kNvwGnLo8d&_nc_oc=AdoG8SCzG_Yw3jfLHAPPggteF-tqrZt8oMXLpFFrdUrnBCxem8YVW1Iou3SkoTbquFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2nMBjTDaQJzrh4F444YUqHWmVl4oVbrfZ-lU1Gryz8UQ&oe=69F0BEE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_nam
vwEcl6g2&_nc_oc=AdoHNgiT5S7ORuvIVGloyrTnhuns3QSb_P83rSGq1E2URp0c5ocZzrQWFtnES6UV4GI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OCPSlB4Z8SedsTrgQc2mFN3Q5_S1J5BJhIymWDBichQ&oe=6A36AEBE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_e4uGBHR-AQ7kNvwFx0QU4&_nc_oc=AdrBCYqNvk-oRVwggndGPx8GwHbo3M2VMvKaGzH1WsSA7_jfdUyaKiByfKbjiO_tsuA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OyUmFGkebIH05jWcXay1ZGDzK3qavtuG2Io1X2NjSAA&oe=6A36BFBC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8usDOOSIq7MQ7kNvwGUVrY5&_nc_oc=Adr_Eq3AtPMgn7Ni4qWQ6HX_TEBVbSZO5jjzsdeijEPVho4VZf962E3gjPOnuxlMcdM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BuPxFKOttOJZZdnk6jHTq67_o3ShLZ7AZyD5vbY8Bag&oe=6A36A607"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIakUZZmLdIQ7kNvwH1gVpe&_nc_oc=AdrS5Fh04D_WRtDs81nohdCSacZHPjNxE36XGXQlD4wV6TJznz1aSnjOTyhOoHnvmcE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fo9HxuTUQBtkrY5Fc6Slz4NPHHPh0M8U6j_8d3DQLdQ&oe=6A3691D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DqlgVlg0GAQ7kNvwGra8_D&_nc_oc=AdpIyfjEymakM_TfPrbdSAJ9wJKTU7D9JkdNXjdWjT2mKQ376TrWzMxVKhbaiSQIUj8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-whenEUR5d_UWDaA_7Rm8NFy3dGlSfKbyuQdGfXw7xNg&oe=6A369E64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of su
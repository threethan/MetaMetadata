W_7vw59eTxI-VCc7Ew&oe=69A17CFE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48sjERwvLJsQ7kNvwE5fRMP&_nc_oc=Adl45SCLtmSoxDdANLHgKOhPXPT35HdkbznEYwVRyWY6O10tir6l-HyMNP2f0xGZITk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsTU1etNKwiB3EoAH6b42wnp9FxVj9xvh5p-l0_-tNpog&oe=69A18DFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CIEkZ7RZBYQ7kNvwG7ANfS&_nc_oc=AdmAqBDxi7S24KD0tD02_pFAMfI4vjWbLxM9qny1RODLJOhqn8gxIqFBNsPeW7B4BFw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftkbycSRatyPiNPKRywDMGbW9FEZUo0OwQaej6BWR6L1Q&oe=69A1AC87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFOA93HRumYQ7kNvwFw-6BH&_nc_oc=Adl6tJ_lKen-MvjsoxQBHHackw7BweieM5TpmonhyzoOELMgR9IWxi4pbP3EBv5MxRM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftUMW9XiLVNA5v1gGQAn3JiCSWzrMYRCZPD8AtQWe0pYA&oe=69A19855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yf4PNrXqaMQ7kNvwF1M7ij&_nc_oc=AdlKmWoFK4_Pc5ydaA5fWlVH7PJuJbaodp6aazviJDj4wBqlMH8sph5eoe_oR_rJTvU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftX3TfizUz4aYu9Fc3lmXJlb1mrO9je505xIt9vmnsGjw&oe=69A1A4E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_nam
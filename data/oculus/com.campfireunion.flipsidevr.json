vwEf4lGx&_nc_oc=AdpBiG_XpXm3zlmUCjsDxUPYjiRKn-bkffKhAn1nPnuG4dVRr0flG11YedhVTcYu4Bg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI1zNdpC9rs1xNx2YQ7Uof51qIhziQhh3e9bAg3_s36A&oe=6AA41B3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzxzWD5yO8YQ7kNvwGADSRS&_nc_oc=Adpcx0Zlno5X5TiMfn1ycyLHot421ik8SS6efUXGZh7usLDJyoMPzeO3K2J1_g6JpzQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRiaezBpVgGSYFGk_fmnQ08NF2bU1AYRasvLuSPueURg&oe=6AA3F3FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiGDv_V8cC8Q7kNvwGqFbuj&_nc_oc=AdrMVcZs8NMPXzgVty9jkNYDDUxKfrC_zl1wuOyc2PK2JcV_0VSYeeV2ahtz9wMnbWc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUBNeX8v0zaM5sdigAj7xf6gaOjCHukEManSP5ZZwFlA&oe=6AA41287"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s353d_Yx_CAQ7kNvwF4QGNO&_nc_oc=Adp4I8AcI13_vffY_aI_z6ix6reaOwfeXjWEpnLuLLKnZZLsLDEVLY6og3sQ_3SW9qo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHL35NnoUj1i4ccZjVI3y_rWT8f8plqSy6o3FahsQNbQ&oe=6AA3FE55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITfj0E8J3_kQ7kNvwGnrbMY&_nc_oc=Adrskl3Ni-Z_WT_4CZAQwluHVfcGTymWdHTJLdmOkSBtkaodNKrDTDYN8eBZ3mK-XyY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKeSQdplq95WcRRCGkDO5B3flMWdKkUVIyxYRQcIJWNQ&oe=6AA40AE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of su
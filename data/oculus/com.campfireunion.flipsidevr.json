&_nc_oc=AdoNSvjWnZZ6U_qr696bNp2seZres-yBu-xacdE1io9GG1EZYuRf7Im1kWOA4BY7cec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtalcHw-di0_xd9KoLvpuRQEx8h9uY5ofr0NYHkZuoaw&oe=6A4FBB3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgBgutjcjqYQ7kNvwEF0QVG&_nc_oc=Adpi6Mh_JxVfvNUfV8tY6Oia-kntlUqqWy5Qz_1WdDfSAgiQm9S3jdbt9jpqfR3PznQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA186jLRqujYcis2Oq5Csv1lNRYwfFaKqj9U1nFciUDcg&oe=6A4F93FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4gzS-5nDWYQ7kNvwErMBZT&_nc_oc=AdpQFBEWmojEAyg6nvNXSd0ixtKc4oUj2APL5eX62UxUsCHhYZv3ZQ7fFCoQM7Vox4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsIwxixCFR9pi64riTQhmNPleJN-MNMEbOMyACMbAaqw&oe=6A4FB287"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoyQeGr0FaQQ7kNvwGDQyso&_nc_oc=Adq9AiRiXM4PC66mX5DXgBrEC5pYkKop4Dl8gGDyl6-8bo1k-z2Ff4f9--wo91HMg0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Kr2Wf18W5uA-biOQ7s98cHbIzppI4mVMHI37hGnQnw&oe=6A4F9E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNmrf8zFwOAQ7kNvwF0k37u&_nc_oc=Adqv4C6WT8alRBb4f4u3QecT1xYFkrgSfXfzy5BRjmhMB6Y81poMgI3bCHIqin5ryFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfCgoD3WRGeRX5atDk46JvFuw0OIQN0dMpFQGwkz1OKw&oe=6A4FAAE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
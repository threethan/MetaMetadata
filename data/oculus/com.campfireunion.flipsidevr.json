&_nc_oc=AdpTow34kv8YGu00XosUasjFYfIi6WiN1_MBhhUiqVgjVfZ_VkXbsWRn45LOZlDJOvE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PkgVmNOM3_z5YSlUB9puE-7fETRFZga77Ql7bKOcgmA&oe=6A32BA3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49XngjXL3jMQ7kNvwHfZYVk&_nc_oc=Adrh9r4eahXrQ1RHS1BdsTK-C8FVu37UPNcAvci2vgDE5Ux9gdfOCaAlpBmaC-npi4Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HJlGgASx0IDYs285EA0R1abqJIce-S9lyowPSO1JxlA&oe=6A3292FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74-R1s888KMQ7kNvwE3dUEE&_nc_oc=AdrSQFMymJzV_k_KV18pd-i2fPDM7ww0Z7DRZo0qdfermlmq8MFhvX1BakKAQAGCxY0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86ENtXsolfpAU0swZrQhFfhr3Mgseah0yDHBHRzmQOdQ&oe=6A32B187"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FynG61WUgsAQ7kNvwHtwic2&_nc_oc=Adq6x94HwLopcpfv4S1u4y5OUOO7A56SxdGZ4qrvt2Ue44iG6hpXYg43gv-oBPzZjw8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ea2fnu4xXdCVnC7_C7jIA7kZf42sZ1wsoE-Acxy9TZw&oe=6A329D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C411F71DyI8Q7kNvwGXcEG9&_nc_oc=AdpzG__eDyYSiyBcHKe9CxrWvSok412futIbosOWzxhFnHuukVcx9OhYe-TveFQsvbw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y6FUZDfEbUYaSK7bSkMOp1-0mg57j_4xWYSAKyQDniQ&oe=6A32A9E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
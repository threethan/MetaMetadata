&_nc_oc=AdoayvHGnCoMnDFcn6IkEklU3JMttxL32HOiOd1Gi12_8dVBR5bZ_dNl6Q2tv24qj7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI4bnkl5RhpYfpIvuG1YKMskAHtjjQboloPjqFmYUMLw&oe=69C909FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObF_QbO4bRQQ7kNvwE34v4h&_nc_oc=AdrDUHfU8W9VT881FS72tGHUU3-yiwb8rG95SdCdZz0eQoSznMEKJAnyRMFsr_eIskE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAGKG9g-zba98vKfZUCO0O2BkT0nFY2icyTD_t2_PLmQ&oe=69C91AFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hHUC9Pkpo8Q7kNvwHDRTAq&_nc_oc=AdprMSDP1_ob40SspMOXlXbw9sfTFhY2oaizbbmdvQGvZ2RtM7bHAjesjH2qPLFKLqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcTxHFPLx_n6HhSRbn9UYO_PN_N7ecHuidEASj8oie8Q&oe=69C93987"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J1AmKJnmVYQ7kNvwHMT4q0&_nc_oc=AdpCBElMnZTnoN-Rh61ViPnvYd8IiMRCVh7UKVO2q4I1fiNgl4PCUnR5BwZiyq9y87w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-nfqiZAGXqyqDrmdpKii28vVCeS0FcuedINA_Clfyng&oe=69C92555"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHHjSROD9jYQ7kNvwE5cP7Z&_nc_oc=AdqbE96VIEuSk0KOMkItPgRw-fU8uzO7SKrKi2LT-FsWqriq_g__J_FCiEHzmg4wyps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8NQ2CmgGOV-nJP2pJc_PvAB2VUufWOZkwHQOleRKbMw&oe=69C931E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
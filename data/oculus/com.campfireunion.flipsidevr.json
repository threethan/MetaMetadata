-2DHGkX0YxYx06wtcqeb7qxAcqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwIOitqQt5zvxuEIz-Y2qWFYUm5_Drw2mJ7pYMUsdvsbQ&oe=69BFCF7E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3MlqvlclY0Q7kNvwEIwA1K&_nc_oc=AdnUgaflVlpXjnQx2UoHDc78pK4_sBrEGPqv_oOCr_I-1GiqRRp2BjMssH_ekCXcHk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjMTrtbRxTXxGIIZIRf31t-7ObNtR8SqwK4_y18O7Eqw&oe=69BFE07C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHJgfIJCnUYQ7kNvwGm1k5C&_nc_oc=Adlbg57U96LfpP-Fq5NIhqwgJ6CZBEHaBh3h9B9zuHzpgcRmaBoJ7GKr0IqpG8CQum0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEMGyBArYVkYxrdTzKTDzXi_a1A2AREsR64DSJYnOU9w&oe=69BFFF07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwxGFcLFOr4Q7kNvwF1n4L6&_nc_oc=AdnAMxOXZCz1uhUZvL4-ALT2Qmi4HOgtnkq5Jh6afIzxxUauuSGlH8I-3dLZpDrnuYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw78k8kmpG9wMLemF6S4Zso46Hi-22KYTLYN7GvTgJJXg&oe=69BFEAD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xYKMe-WLFkQ7kNvwFMXC1l&_nc_oc=Adn4FPRFicqAcUjJ2LbCCM7aS5TSSjPXwDECdL4k7lnaQdLxwsWQlFKpcRCygfUmqO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz50Y0DPGwFlJsCtd9Mlvm03QiE0eH9JlfaS_d3rC6EGQ&oe=69BFF764"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "
vwHQsmg1&_nc_oc=AdqQb8Pf-hdHDQckwylK2hsKg3qa9m0Fs2spO8ZZD2aA8C_LVH_R_8h7d6sCXcQueHo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFBt_PdPnW833cxrJ_Gn0-OAEMnP2aqbto9vSj9Nf0WQ&oe=6AA9613E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK3VQMiovAgQ7kNvwGi2vTD&_nc_oc=AdqiXzVhV4lnTybdLMlBBfC949OOSKbSA7o7CGwjEp4Qz-KffvZh_V0wgnnm04OP1po&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQxBviP4uNyZLqBbgBIph17NJhjKyd2-0MBJOUIawBnA&oe=6AA939FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsTqGHu3p2UQ7kNvwHkFbq9&_nc_oc=AdpvEMEy-NmLrcS4el-nIX1zoNPZwdr5kHpYeuKVIUAkvNBcDDsx331h-KlSQGY5Fz0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWeA1ExlHy2FzucKKXy8CxcmhjkqBUZl-3NJzFR-9_GA&oe=6AA95887"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRS4pRFNlBwQ7kNvwEYp5zL&_nc_oc=Adob6KxFqrc5l-i9IZhPAxcMaPyE_32gOwxEUXzQJfs7Uby9Q3IPtFh8-vlPG0_pRoo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAYkcCg7qny6YrrlgRAVjMskaZ5NTkQeNnrDm-o2h4QA&oe=6AA94455"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IfzOGjkVMsQ7kNvwFTEIVr&_nc_oc=AdrP7w-mWf1uHUu3RsBBtzYsJUVgXsLmsbQR5PrQJACiNePkaaSYk4JsIBZ35izGiQU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsn7CWlhszOd_yXzbpXrdE28RsRxc1DTrHZZJ-xTDa2Q&oe=6AA950E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of su
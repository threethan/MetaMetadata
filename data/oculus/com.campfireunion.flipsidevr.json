&_nc_oc=AdqrUaGZ5-MttLPyA91KB5b3OKgEdlVcGxZrBSEygSbwfnB7oz9xgMc30wSsTKY3-_4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jQmLjZgWtzsjW21oeGHfYbp5P4sL1AAqjYHUJCuXLCA&oe=6A09DBBE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBbLtOuetOUQ7kNvwHT-VJL&_nc_oc=Adofs9onYA68PBrF3Cf-EhdGWnnnbqQN3_ESe8iTwI2VZLMcONdZVTq_5bDi6cm44hg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cB-8d6h29zuJ0rKEHGR_WSYkdylp9cq3xegMf6lLkSw&oe=6A09B47C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLPm2ZrXTG8Q7kNvwGi27CQ&_nc_oc=Adpih3sja3bqK1_pkqzp6rwgsbvqjIDBpPDwopV9L2NoeAzwIhyNxKcsm-uKXJKcO_g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mV8xkn7qdrmiEna96EP_GM9WYkccIpSm4cMEElmKf0w&oe=6A09D307"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4S3QPen5H8Q7kNvwGtRwSh&_nc_oc=AdoDV1A7V29ojwCM9tlNoPrcQc2WPOTokFa4ngON_LehHI1w9JuaT5RwDYduUXHmgxo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jRYDBFujFfstJA5Lq-HymNPhaSAyZVtlgNWHVNCppnw&oe=6A09BED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHqc4rfxjs8Q7kNvwEjU-fO&_nc_oc=AdpB6vOxVymEpMf3NDN_Rl8ETY3nFgbvRTfdztdpzbRG6TzGaCbQNec4Z4ATvpoN39E&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jx3W4II44LGZgT6hCi2kCE-1KVBAxz3uEUp_2BexArg&oe=6A09CB64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
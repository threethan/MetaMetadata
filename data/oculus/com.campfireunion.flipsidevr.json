&_nc_oc=Adp0b0ybmoG3nNHg2pyQzkihYVlQR8KN6PaymnL5neP0tcFMnmGLw3EFEUIy9R4Mypw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lx7GjoRzAw8G6MY6qgKF2Gb26uVB-kmCHfDi318jNtQ&oe=6A2439BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEbyCjqD6CYQ7kNvwFBfPvS&_nc_oc=AdosNDE5HL_jKnuOOsO1GcXisgSoFM_yckN3CFhSak8V8y8G9_EAh6kvAu12p8W9YQs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vKHKK6JSTF-y2VfiKu9a8AC0n4KcAg3nZfyL8yZg7ZA&oe=6A244ABC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhBhAsVqGlwQ7kNvwH833se&_nc_oc=AdqerlF_p1YiLhN9Fh4HsijGYa82-_aJTjNTX8Iv2pjBOBFTGcDhWC2FI2Exy5eQEyo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ucedcluzocwSyzaOOePLF798h0usOLyBaHA1bH9SVTQ&oe=6A243107"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR8f99ljBk0Q7kNvwGCan3F&_nc_oc=AdotpGQGbRhWG37fZ2nftKoqVoa-xbCiEFlUiyRK4yJuhrxwOIyAnn1ni5q7AHp2sG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nS5rwN6oTBNXm9GVLfteYLW798L4gzID0hLLq9BPxrw&oe=6A241CD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6waxzZ2_POAQ7kNvwHlkYOP&_nc_oc=Adp6fDt0UELwgUzLyFWkbf8VfmVqF-sK8VzAUrxTO3MR7MTBXuOFkpkeW8hkT-PpQfM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JrCHV3qT4p12ayelLMFbajQyKmGixIWAfrltQqquhUg&oe=6A242964"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=AdoFBxTGxToDdK_fnGgtaGWcdmV18cXvGIq2KMMx9y_ddE7D0vkDtm8RSErQpFcaqWE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YLWPPm-K1peMy9tG5phre-_6t5IRVNn27FSkJ0LSapw&oe=6A1AFF3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9NetdFYFG0Q7kNvwFXgx9F&_nc_oc=AdovKXeaLYFAhrYAHkJr-wGwdjmlyCpHY_I1u2_4OEfcHaAcblXqshYU4hhe8wTFFdQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WiG4reSM-BvnavYFPN_0JoUENwDmkoW4c6jvQsl-qTg&oe=6A1AD7FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vawKn5PiemcQ7kNvwFb-cEN&_nc_oc=AdqCQprDL1siUWmifAoaYlbrAYSKRcl-LuhBFcjuqawLGPsz-kIQexjip4ncT1-vbCI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dRfpextMIE-dqSBxbo6DQS2tVFMshxZWRXQ1WVIj1Cw&oe=6A1AF687"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYjz2e80C4MQ7kNvwFy7-Ho&_nc_oc=AdrwvSy5zVHo2oabVWc9GAY6ea-cMrFIK9CCObgRO4vM2voZMXHciyMO1NtUCyuHTwo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MhpR_xUwcXauV8hO3wgfglIjX6Lwq3Lpj1_gszYCXfQ&oe=6A1AE255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwjg_jrLxzsQ7kNvwGOrLPo&_nc_oc=Adr9iHMa3WUDbAOtQiwq_LLJD4KmQX_iH4pLBXIWxWcdmQkPJLyLbGuFINfvYh3KUDU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rzJIoK92txHerEf8NlZ4bqCla_5kS6klQEmLryyRNxQ&oe=6A1AEEE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
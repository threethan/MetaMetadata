vwGb4grN&_nc_oc=AdorsTntHDXUqiXgHGafM1HQvdb4q4rFXzw_IhUBa9GYo_2wwloMDb4-qsq_UmpV-Yc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu17ePbWazsqspr-IL53Siu30AGGqSgE9tFpPGXsY7TQ&oe=6A7DA77E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNk_0cYiuv8Q7kNvwF9vAKH&_nc_oc=AdoSNLKMHrJ6AhSp9SnKe5d6TOtRmiQy4WJthAUuE46Kmpx1lRHDcaXXS32g3i41NbU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmHApgdr2jkf-gATszrCkkkbGmw4XR11ETMpsd4qqhGQ&oe=6A7DB87C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfY_-vdpQKkQ7kNvwE9qiin&_nc_oc=AdoV_5uBdy0k_UgMEz2T_8KLDCOslLz0jiXB8q-mi6dkOkSQqEA9qO7gGWX__3u3rFQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBeXDNvaOrHBjCgJjkxJ16pmrCKNXOxyZgAGY9h9rg6A&oe=6A7D9EC7"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i_UmRQKBC4Q7kNvwHiBntU&_nc_oc=Adp4-11Lix9I1lrRCkgr17tvfdL1JyfkeS-Hh7osbQdgqBIaSgxqmCotKKndLq8DhyY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEcw0CE3c-BA4x_wKYNJBuGvYXzIFj0ajqkdbojb1jyA&oe=6A7DC2D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue4-itvdwD4Q7kNvwGf4NxY&_nc_oc=AdrhSVi8LcWAX5arVv9elNzPDKcgbsoyHw3m-s4XuC3mO9vp4m8AurCQUunz09Bi7bI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTq1tnhD84Y5u-OzvJfg1ly8Ta0MODmQOXp2hTcNkfng&oe=6A7DCF64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of su
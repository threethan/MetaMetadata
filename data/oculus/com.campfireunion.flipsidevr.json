&_nc_oc=Adq8Cx3Q2ksoBPiXPYeE4AOsOkpNMH0j9w4i_2QcDjTG3OM-MD35YHX8gUoZBIC0Fj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_5onNhmmpxCs0WySEyHFjABKT9uGyLFz99GfDx3hv7Q&oe=6A770FFE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX1ox8BxbKwQ7kNvwE6QKrT&_nc_oc=AdotKaWo4VDGWLwKLqq2dW1rHtBg96ozxzrolzqaiT3XvA0lNYySj7KuP-487r3TbNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiL5UOnHtsmE3OGluNvA7YX2PDxEf_OwsYy8E434GddA&oe=6A7720FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWzDU0fEbx0Q7kNvwE9b2kD&_nc_oc=Adq4Wlab-FeMz4Cqp7yilc5mtN6vPkdlAXGEHkbGiRKboUDzfkNwnhrU6HOm6hCdhqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoGr-CJT9ibgIkEm9FKt2twUrIwKiL5xubpPuYSfW7Kg&oe=6A773F87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c23mzRXDNu0Q7kNvwHGfbXS&_nc_oc=AdpWZhth9vuQreUmVvc-9lTRJ1AFOTObsCEIZHn4uTKW3Purd7JOYcSIzZ6pPhXSj3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMbcQr-5d_XSlu6akg0-OdbffYJjxjqHVRCMyyRK2xqg&oe=6A772B55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MZ1yBYDVoYQ7kNvwGfD7lW&_nc_oc=Adqy4F4s9GZFA2ZHmD6SyAUZftHGyxTHe2TRCDOVClqq0odX_heAoe0LObx7NORSehc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO3Ezu4-3k1-WJCxQiHDl_Dbq_DXz8zgdn6T-UfPokCw&oe=6A7737E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
W4oOgr6RmTyAhjMggbe7zaEBIQa32HkNj7s&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQQXdGSt2BVj6shm-S59OuKt7pFduFyxNGP-dFbxFkjg&oe=69AAB77E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxtRE7xrRIYQ7kNvwEDopqK&_nc_oc=AdlFHGkbttK7c-MVjjOXXdyTbKH9z5hQ989m7e0Uqn481gLHxGFfKcoi5PMePNogNWo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUlhNuUKGTxwUEujagqkVsK9_zttjDzYqGvAbDWgDKeQ&oe=69AAC87C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAYRDcQNa9QQ7kNvwFHNSVJ&_nc_oc=AdneSY7amhZ-EYiji0yYh2FgYmOoPmq5hQhrAXWYc1b4JE8-lD38YdTzKno-eB7zgWE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFRQ_ryNkVh8HmQFlK5Gr34KhnsYiB-mMNokronS-zxA&oe=69AAE707"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR1-bVIUc00Q7kNvwF7ix5Y&_nc_oc=AdkMzO__aUBv-VK6oN8W5Yw19bLaEc79GX5uF-l8ErVCeacTATz0UrY79b12Ezc6QhQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afzv_wRV3fBqOXkikLnTa-07J-8IoE3E6rGNAdxBWP56ig&oe=69AAD2D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d1gsNc1AvUQ7kNvwEz63eE&_nc_oc=AdkaX1kSzrM4CZJJy1Vqsyr0nIAq4SwuIjVQXjiEME8aBqC0ryAdQW3KzS5-gIPSG9A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzYee-sD5iSDxqmLXfWOsGvZW8c0ZNjytLmiSMp5wA-BQ&oe=69AADF64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_name": "Flipside XR", "support_website_url": "https://www.flipsidexr.com/support", "website_url": "https://www.flipsidexr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7236881516436233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393793_1828830854586440_7841579564797124270_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8GCsKyKpv0Q7kNvwGjmA3m&_nc_oc=AdmgRVFDWsMNMW-RmmSRomj3dbtC11gCyRMJSDFarbLOLDQFjouT4lpi6o_UbXl3VGE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnRV72OmPWm8EmEnj3hJNC8ax5Y7Mq_b4L2zmUwSqeoA&oe=69AAE1CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flipside", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1677780000, "lastRevision": {"nodes": [{"id": "4991857
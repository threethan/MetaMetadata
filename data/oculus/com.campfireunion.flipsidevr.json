&_nc_oc=Ado1r8RVloISo-coM8xLfnHI8LHwbmgXGmS7NxmeT0ncDlO3rMctWgGuBhHqBrM-bHA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-WU2KG7yQBrMw8i0Vxj4FGyPJebs574Xn4Ik7Ngqi-Q&oe=6AB29BBE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PPOlM3IiaIQ7kNvwGuJtnc&_nc_oc=Adqirpcmoq1dTxoO6fxwJojUu66ULdO1KsUxNbyhYo8-tfyUjeBcd54dd_k8cVJSFNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIou9YdWrp1HHVDAe7DAmbKEIr7X6V6TAgUUusRK-B5IQ&oe=6AB2747C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY8utRkQcQYQ7kNvwGHnIjb&_nc_oc=Adr5P6C6-SqPjF1uYGPDmEl4iibLUdMhV-f9Cg0OcKUx9MnjKw-JxVqx-SPZ6F-Cup0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4oV_JpddJreoDC1k7gMcSjMxy3s4EKJozSkPywqVulg&oe=6AB29307"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5zCxxDht9EQ7kNvwHMPurf&_nc_oc=AdoD3M0f8bC-ORyeBTqDlA2ix3QJ8ZnivJxUK4qQzdaFFyJV6kc_4ldY4WvnzA2Rp9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXwu4O55bFalKvCd2elj5tXBAEkeeVVvYSNM9Fxfb-aQ&oe=6AB27ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2T_-Ew9SScQ7kNvwHO4i1g&_nc_oc=Adqw21Yabj6G2Cs9FDPPimb3IL9dxSkFXth1H8HMkzOKNnsOJpQiY0RFgXPvAtxUbn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh8TD3BIOuIs7f3_yJ0eg_-j9YMMqDPUuUrRi24qNu0A&oe=6AB28B64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
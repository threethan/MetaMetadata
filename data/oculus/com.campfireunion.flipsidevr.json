&_nc_oc=AdqaO5O4AlXEqtzHMKkp36-odGi0-0nC4HNnLoTsZGBYelrRVXvbG0XJ2S0uvol_Dxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_WSvP7oJJQ6VAUUQPiNsVTLJ6L7wcG6UBC_2_NVf_0Q&oe=6AC7B3BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo6KpnLSFhMQ7kNvwHmZv8L&_nc_oc=Adqzk-L-Itx--LEerwiRVoNLKigtJxgxrdqSyAYDedG9A9jP-6-zkWXaB1uHa-Lyq3E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVtQVr-6mUJcFzNiVU8KYYabYjHKAp4Q-J6x_nisKDiw&oe=6AC7C4BC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYyeDfcK748Q7kNvwE540PW&_nc_oc=Adrss_KK8pMcGO4Is8cQ_2A-ybL04OyU-9c2ZpQSBBvOlLRhtLbUae5UiziDijR3flM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAw92VDjMFVy5Mhd-JbxTpF_hZ5ZyYIJIPQOc1-fBzzg&oe=6AC7AB07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4znaREAJo2gQ7kNvwEFJTHb&_nc_oc=AdrLlAssDCshEM7ht16tMUhIrhj6NLZxotDQgeynxA-gSEwh0I-dJoo2bbsqmdRErvw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPucuQ--6JOxzAdd4iWwQlNgqsuU-kMiMVcKTpIWEORHA&oe=6AC7CF15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd6JBlnvOjMQ7kNvwExpfPi&_nc_oc=AdoLncDCLyLrBPWO4DovjcP_cA-wiyMYqg9onUPB3XG2S7_a58y20jBmVO6xIx1nwoI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLVwySgTJmrztXFshDIPTufLEVvwOyo7TUvDc2hC8P1w&oe=6AC7A364"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
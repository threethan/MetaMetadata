&_nc_oc=AdoQLNlyIcvK53FKKkyll7-blhfW_Id9xvcUQa1Ru3qUg4teYfyhUL-VS7dn0VZDZ3g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6od6cKCeFZRNYsG0aKQyWJ73Y9NDfxFr_I65ORXwQTPw&oe=6A0B2D3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBbLtOuetOUQ7kNvwHsyPq3&_nc_oc=AdoHhofuu5FmjDtUBdpDOyNINz7yCyJIaIYa99Iz0WeaXN9iSXrIlJqtdZB22CNKkYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4keP4hNGgic1bi-uMNTQCzsZbGbW5xAvYkkHGFXaISZQ&oe=6A0B05FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLPm2ZrXTG8Q7kNvwGjob79&_nc_oc=Adrwx5QuyFp_pW1Lb5_aNyikcm-FIYABiclYLz1tMtVaNDLIxShVI5bhZcZ9vk_DC_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pfwcZi153S2BdGCh2A3AZdo51sbVxNk-3I7zduiw5hQ&oe=6A0B2487"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoQyUlUO_b4Q7kNvwGXb9CF&_nc_oc=AdpwWa6GWVA-EvQ9_u537u0mRf72d3glVpW6XkRJ8U_Ih6nvBWEK_9QNKAYbDLVf07M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yTISAKK1GomN9ja6GohVgwhk3-Y8J9RBc_0hUH6lEaQ&oe=6A0B1055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHqc4rfxjs8Q7kNvwHr_UNV&_nc_oc=AdolFQAIhLfH2bCUfmKOvT-BYBS0bM5Z7iTSBG4jT3Jy6M2nL1pkXGZxjDUXtxfyUcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60mPUkTxerVFobXbCOUGVeGDtFEjsTzj63u3zfVXq6Zg&oe=6A0B1CE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
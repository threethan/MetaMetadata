&_nc_oc=AdqQFwDEg172UtntFBR7OEL0dee31FYsZv8NsLOkCnr5BBzzWVR0h5z9Z07_UL95jWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUKSp8TcZW5A0RhV1IEj2Vew4l5KNDie4-jKO8Jpp1GA&oe=6AE4B4BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayK0m3LDY94Q7kNvwHAulNx&_nc_oc=Ado3vNYzr1FL8XXYO4hIiMpOf8_0oMJKOoNmqmuFTX-ZZvPDaWSkKWw-MtpBOQJPCWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMADnve558JdEyJEHZdNh4LsgmlVKXsTX8B-JO4FF3WXA&oe=6AE48D7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rT_iDSdYxUQ7kNvwFDaf0r&_nc_oc=Adp8MW6fdau4QCde13mxphXmee8Hoa94K-5yQBfFMiJAiopf-D5KC9Hs59-tRdggXoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEOSRsVRJaCrqSvTt0vYf80UqajTvOVGqzRSYAyzsIpg&oe=6AE4AC07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_AfxD-kljcQ7kNvwG8DNLE&_nc_oc=Adp8RgZdOCY91wQyquFQW58PmsKhn7qKmBXlFOBK7YtIHTL2knNoZ3Adc59os1yLi-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8De_LBtWcGxbBNxZMMG1OJwtdo6CkqTdB5SxggtbmEA&oe=6AE497D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuOV1r2XUbwQ7kNvwH2gq7Q&_nc_oc=AdqttQ4joEW7QNwvY7pEg2Dl9gB_S29mIaoC_ixeonfmf_6yQfwGsiZYU30oOOeQIoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKCDi4yqNQajZhMKTCOalCcTTwqV4kU9vG_2eLFE1mOw&oe=6AE4A464"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
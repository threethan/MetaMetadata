PeW7zBDNhLSZJkjxAw&oe=69A2CE7E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48sjERwvLJsQ7kNvwGYrTHF&_nc_oc=AdmL4edQaIrGzhjaUBjX2v1Xv7mfY_AuGI61zZnHvtRV7eYCuNX0Ko8XEAeV7ZOel00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuS4nE13baPWnrHCFtoDGDoUXGsu15YMV7EU52EbACoFQ&oe=69A2DF7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CIEkZ7RZBYQ7kNvwFdXy83&_nc_oc=AdlWhW-Onp0vu65jaOrLbLtpjk_0X9s7MswQSbpkFWkXDDJuiqfMjNYOLLBzOKW9PeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afskf7CLXh9E20Jj7pRgZ45oONxfNPp-FLyMrbcLC5xbew&oe=69A2FE07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFOA93HRumYQ7kNvwE-81Rw&_nc_oc=Adll7sDZ467u2oX-r92NEbhY1HYh54G4xfPxy-N2nW89s11N6ehWZqKrN14VEDCDevU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuuL0dhk-pqekU1NSh25igQf6e2MQ0dprezQ7DaG2XM5g&oe=69A2E9D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f69rb6MEEoQ7kNvwEEdz25&_nc_oc=Adly4q2RDPjit7N9-bKZTjR4EkR_GbtBL1v3NLP5YX1t9nVB6I-vmCOkAgYdARGUR6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLv6hikv4VJKO_VnmPlsGHjsrJQpzEMgjsiIP91DSNSQ&oe=69A2F664"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_nam
&_nc_oc=AdpRjuU3szQdyYxZWCdzTkh8BFlL89u0lH7_9rxdwADf5gLkwkC29kzA7CpZqdl5Gms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLvhZHfXvUNbusKJLxa58dTNP2JGaRs4s_yMhDwKg4Mg&oe=6AAFF8BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15UPFtelXb4Q7kNvwFEbGy7&_nc_oc=Adoq31kyBXuWuBysmdu5HAsekm5zqBfv9VUc7hlV-tBSGTF98cbupwZEF3nU4rd1MfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmq2wn_B0nWn0YZjoo5yLvsYYk9Gk3nq8DASQ7PmCI2w&oe=6AAFD17C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY8utRkQcQYQ7kNvwFGI2pf&_nc_oc=AdoNGeMnmR9eulezJZH2aqe9-HhoGrQOa8tcw3TOxfIFidgkDX1rSrJ0YiQ2SFxWmBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTF_ZH7f3P8HqecMXr2KlUH3-AEx7lFiqs7EIahlfW6w&oe=6AAFF007"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5zCxxDht9EQ7kNvwFWSXwB&_nc_oc=Adr8NfGR2t9ZRPSbvCyCfgeZa4Ms_DUXbI07nURSFPvRZOhbyRqZCVuKJ6HHJaSAD7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJJfkHQVUb2A7PtrKmM2fcUNNJ69_XF89QCH63MV_Ing&oe=6AAFDBD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHMd33k9qI4Q7kNvwGB9jd6&_nc_oc=Adob92-GVIasLhPBxqsk_7avxFG86_gV8CKe9h0Zl2gp8Mba6erSe8YHrizmnKYxyMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpqJ7JSscs2Dod0Tb6ISfjUgwg96X-L7Ilk-xQWJGzNw&oe=6AAFE864"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=Adpjlm_4SCu2qZvvt0_OEn441ngPuRMNhMs3wioiJ9JaR9iAWezP_Gc9EoO8vhxiVec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90rqPkHB1cYk8yCDba903JwUgUn1fJtnpL1QFLfznzZA&oe=6A428C3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq4iauAyyUIQ7kNvwEMmYDl&_nc_oc=Adp6hXJhJkGYaq6QwRrO7SqmbLBO8OiX2UMveFp4iq7ghaNCPSBctl6r2WTI_uIFz5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RrjQI0oZ4K-D7-zySzZBm5NercLMGtXcBpVjIUMlwwA&oe=6A4264FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DhRRu1us5EQ7kNvwFSCDoe&_nc_oc=Adr97AmD78iTXEnp0BGZfwhqHSAYopwcyDkNtMNuewloN1RPpS6B6C2B5oSu0vMIwas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dwYIkeSVP_FsHPKODwWVjjeewM0aekrnUHbq6IGgtwg&oe=6A428387"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLvidaHsZa0Q7kNvwEjzXzF&_nc_oc=AdqICaCL9KsTldxR6gOk0h3-2Bei000Y4Ahk3vqIi0MJURb1lWxsJ7-IoLetuqxlUGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Tl80n5YWnj3RfnOmNiX5S50cvuDZ3L3SztgOxXb-PQ&oe=6A426F55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWIrFqljhIYQ7kNvwG_d4CF&_nc_oc=Ado1t_0W6eU7G1dW5PzcHENK3_PZY-Lm7_P6-plOULMpVeC20AQ-Phe-sOpFjindYYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9JdnHUbT4KTyamEYBu81pmyb-i3AuXhruITTx4hCNlQ&oe=6A427BE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
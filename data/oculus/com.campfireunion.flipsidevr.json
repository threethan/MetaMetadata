&_nc_oc=AdqElhTfH7qnnqmssFlNiReEclBri9LphlJrEMYkj35lZkxQE2Lne3XS3miK4tLVidM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfE3Bwwf0g7ZpcI6vjrMQXElDW-6j2kA8sHxNRPpltXw&oe=6A9AE0BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg17JRYcDJcQ7kNvwGklwje&_nc_oc=AdoJmF_baT08taFeev6ieGBz7YByp92-gIWUhMKefXownw9XiYb2RWT9n1RFzIo92lk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDXm5DCgv9Dg3DRobkML9yVS1Gs7DB92y5OimFH-Nb1Q&oe=6A9AF1BC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vKjRodZ3TYQ7kNvwGZGT1V&_nc_oc=AdqXJku-caRUZZHlX5j3QOkKAXnDD8GSos6bI5wV9ka9NS3Arxhci6OvJJGjwqQ-Ank&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfLchMalyTqkcmJjFTTrYg8oFBZ3U9zqFubDrR8NqPvg&oe=6A9AD807"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avrdR6ra3woQ7kNvwGeIxU_&_nc_oc=Adrs5wdXBHKwTCoC7ZggneAEz7a25MJWcsWy1SONeb54XWtdtqizSBV_WgeYR22ZXqo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFQlnFOeomg0m0WEjyPtneJ3FrA0SGDRkL2ULFDxpHvQ&oe=6A9AC3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UROjQkqgNMYQ7kNvwGJdK0f&_nc_oc=AdpqbTL5hlBR4BZNtDxJI8IX1Ijfd3hk4TToUn5iCa2kpdoh6Fyfp35G2TwuNM9AtNs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3IBkfE3-2ogdG7WYSNgamKoFqn8lhn-3huhcj2WPdlA&oe=6A9AD064"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
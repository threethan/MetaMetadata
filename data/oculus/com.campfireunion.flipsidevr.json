&_nc_oc=AdrPzZfE3AMKnmzadqcw63sCWcG66QFUPBfn34S63jflkOOxhuYJEFK0wmUbFeGgNhY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKRqjIwe8M3FLvGMghyis_eL7yKYvuT6wMRIPLvSd-zA&oe=69CFA17E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnr5aKJMEVAQ7kNvwGuMZlX&_nc_oc=Adoz7BY5y3tzZmcUKGY3D2bAxuLepbpezUHrF8G6q_KPUGBNYqRrh2Y41kKW7XpQj5Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLlX-o2ociDD7svAQhl7SmVhvQbmXqKojB5ymkf9aP6g&oe=69CFB27C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpMQ-JoICEYQ7kNvwFlfrtS&_nc_oc=Adq8y4cR3zR6bGT1NiFX8xYFE7kdadC8jmwtJy8sITOLQpCP-0tK--XkVFjzzT_dcgw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdQA_YZfus4zW5IUCtJdhOTk-PqXfyHa2dayLDBv8qpA&oe=69CFD107"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uxOZr-pLuwQ7kNvwEnm_4R&_nc_oc=AdoZa-STpyUcM9PG9o2ZUNNBZuOTgUrrRVzcHSQUaI4j8toL4BPexdQ0AEpIrN4pClA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsmuZ7lnqoVZNJ4hBIUmcBPbdncpk2gp81BiCz_K2_Vw&oe=69CFBCD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AustJro9TWsQ7kNvwERmSll&_nc_oc=Adr0VLjpZHRAttwSwQLVBAD6KRs0pi2mosNr1-eDICxW9D_gXN8VxhGAsnhYktVg7fk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWqmqnEGBLVGmg7H7NdSmymIhfbBRBydSvIx99VeVP2g&oe=69CFC964"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
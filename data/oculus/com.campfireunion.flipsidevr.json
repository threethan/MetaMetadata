&_nc_oc=AdqHQDQc4upGScQDN4_Afa4HJo2DLvIqCHYyNnujQBOoM0alE4Yc7eGpOaV4Ztz0Pqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3beBUnz7Pn_GEtGVUxCAerWCOATyAk1_zAUOEC6RXX_Q&oe=69EB893E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUuskyDUbacQ7kNvwHOsXEc&_nc_oc=Adr3VMdRvulSIZvX3oc5nCt8AVrrrRC-ZweeAFK1mbBMsURkncCqyB05CTgDwIQH1_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af215M80dGwBX3i1BoVrcL8GUhwCUFepqQRn2zl57gW6cA&oe=69EB61FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVHFJ3h2eIAQ7kNvwEyQpGP&_nc_oc=Adr-jFprO6GWQW_gRA-xpGd5hHBM9D6cjZSKelTkqvFQ4t1e-zc-ICXPoohTOyDlcvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af078qVvN-ERdv5p5wwLTBCexmF1RdfIsrTVpuv7muRHWw&oe=69EB8087"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrHJf6JuR9gQ7kNvwE9hpMX&_nc_oc=AdoypIxYTrRiGA6khx8Xa4gWPHCvc2hLnAa639BAdVJKyaw9mOjO0I1IOIyrAiJ0hlM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mxKq9BeICypmKoqfkY_l8toFHR2R4sWABKM7ZZyu68g&oe=69EB6C55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiJqeT_vHQUQ7kNvwFbbeep&_nc_oc=AdrqCle0IQ1BSAtZ14aCXFmL4aCVCOeCUK668_OivhuAp5-9UI1FkFMaDbg7maI3RuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3n19itu3FnPYYBxbAw7a3Z_Blee8EZjgGQl0jLbmSXOA&oe=69EB78E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=AdpyRg7SmTbYmB2aYPQI8L6LDc6D9aOBjM9bu2qsMDBep4ZVgAE0ovnkk1zVIaM0lx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9Zwnrovw-BmsaOuACTaLKunXrNs5fZfMPooTEK--msw&oe=6A74A53E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlA6E9Pzf2IQ7kNvwELdvmj&_nc_oc=Adoa_kbyONHXcqMmpg_fDC0IMODRS1Pq5yJ0HE2oiSGy03_r2dsMwFYFa3DYqpAl7AA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK_Ii-gD14AuQKS56t5JxCdkPHI8e4RMgWx6NdktLzyA&oe=6A747DFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWzDU0fEbx0Q7kNvwF3hFEt&_nc_oc=AdpHE0B3IIvZyns73SWyL_ROw4Xi2jfU5MLP-N7OkkpdRe1xl4qupnBF9xxrBbhR5w8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHypHFs8XwQ2muO7KvF47IuAjf96qsEEC3W2N8lvG_B7w&oe=6A749C87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIR-ACaItPMQ7kNvwGShoTp&_nc_oc=Adrb47XUETUEafCe_IyJ9nwCpU6OrFn5z1uNx9S10hQw04mFvGpxHk64gE55eX1i1DY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDhXA2yGsu7vPiCr2xUc61TQP8-Go13nsCONe_ExCyyA&oe=6A748855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MZ1yBYDVoYQ7kNvwHN2yLQ&_nc_oc=AdqYS1xdxjRQqEBRlCv98RET93LHJBwNHGQDCo4UR8nal45ITSaB5Y2KUWtue9xVu-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNcV0EPmDB2uHP_Ra3L7_8yytdmv3SG5ZwiHLS01GalQ&oe=6A7494E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
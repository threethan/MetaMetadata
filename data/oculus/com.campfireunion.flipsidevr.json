&_nc_oc=Adpy5J1TOcZt0aoSesU30V52pJtXZrvvDgcFJ-vnl3Nu62doh6fHlQvijSAZux3rJA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR6uc2WX_EWdFrFHjJf9YCj4XgjFh0j4j9b1LswsJRGA&oe=6AF5D83E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddH42iJA9XUQ7kNvwGImaqY&_nc_oc=Adr_ayk_Sx4emLb_iuoyK9lP5dPteDUnopr_hX9DuG6HCUx1qd4r0bOAztBRck22KdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrGVcgt1IHD5a0jE3t6JfTu9c8gOAj0s5H-Gf0H5zFBw&oe=6AF5E93C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6FvGtfwkvsQ7kNvwGK76WM&_nc_oc=AdpYRFAWUTp3mcKo8e_ugIV6XGTpWi8oUNPa3kY6RHFHe6kGS9if8Oj_kibGR2_DYhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEvxdiDJwEOIX-ja9_viwbiyx2Ryhwl_Hqvmeqw5I7dQ&oe=6AF5CF87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bQouWTyAXQQ7kNvwFESzjm&_nc_oc=AdqyYVGvcVPY9peCXKJiFnxR_S0voahhRgJFRyRnCXkzm-neAOoaP8lklTq6Tk5NxK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpDFW4gEDolIr6HONaftimjo0p4q3lO1bZjNAmKJMnow&oe=6AF5F395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNktBZGX_DwQ7kNvwFr2UcS&_nc_oc=AdpT_-c0EQcHec7i7R8fB0_ZxRW5namIZ36_JDIGBphPJwt8Omjie45rVKI0lRVeqLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmCYlgzpMckQfQUJ3JQjOvATZIWw_j3N4kjNCJHlVcqw&oe=6AF5C7E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
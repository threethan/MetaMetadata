&_nc_oc=Adrm7H9j-MXsGsL8wPN7Ye5h2Kepeh0glhawoolVY1ZsL9_8KrtMu8TE-WJt5qfMsY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxTkUcnETo1gi0iUwKID-psCCLCnBJDUHjV5khy94txg&oe=6AB7E1BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK7VRDHHVtUQ7kNvwHwfhrd&_nc_oc=AdrxLktuEiF7pwDVAXOF_Ngu-2ITkuh-jOZ0wizda12J_LFsJL0jAhX1rrU-c9yHsAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq51Uv3Wh808dveX6PWOv22KWelmCbR50OGN2kNyEAKA&oe=6AB7BA7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLH3xB3qxJMQ7kNvwGN1ez9&_nc_oc=Adq1pgnhqqekBHuiQAk7JZwYtNE4Ahh23hNAsBFc1yxJ4jqBg-VbMDrDKG9CIEi4P9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdGiRdadHVPhlyy3YGVY17_aI1Fr3IaYWXz31M4gxZlA&oe=6AB7D907"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcGnVi-crz0Q7kNvwEx7ggi&_nc_oc=Adq8FSS2lFGNKiFFC4lkNAbR6BTyimCA_u96epUwKqp_gjKlM1vnssITGBe-JUizzoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxW8qSs8el7v75Hqf6v20Ug9PqylltML5wf3T8R3GHQg&oe=6AB7C4D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2qzN5FFi-0Q7kNvwHomENs&_nc_oc=Adq3vF2xlrCLpzCRC8N2aMZwPwTk5qnMcsvfRb5YeAlkb4fFywDj2-sjAH6JYQ6o68I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ybBIwk79FlGR8wvHvbitPdG1YL0hbAc80T7vdoBk4A&oe=6AB7D164"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
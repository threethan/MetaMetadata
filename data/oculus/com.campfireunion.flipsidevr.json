&_nc_oc=Adp3n8dSydWREPzmEELbKLGTHdd3rMBdfips7SajDxpPSaxV8j8-hxXT9ApgzERl7YA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MQ-0arh-JLT0ffb35bHwykwixAC7Is8regh9xx1Y5Zg&oe=6A38003E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjqbhS9j8DgQ7kNvwFWDJSO&_nc_oc=Adre4vHEFOnp6hDYqB-0l_5to4qtsoXEmeapj__FOYWrGmWFb2qp2g9G3vouLt3P6MI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f3FeAawx2yMLr1MfVzs_C6y2O_-JMroHAHy824THXWA&oe=6A38113C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8usDOOSIq7MQ7kNvwESY0MJ&_nc_oc=Adov86jiB6-zFWnSfZ8KuLDz8LyMDxVq68WEOIC2uircCCj_Pcq3hjJz4tL-JCKuxk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nIJgkh5bRzBuu6MlekDGDQGW-Q12jQK9zVvPoU6IGEw&oe=6A37F787"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIakUZZmLdIQ7kNvwGF0Blw&_nc_oc=AdpJyNuKCwzR7XAW_3WGOwhBzozNGfRhxR843DaI3HVjIYIDpWYlDP0xPoVZ8LEnp_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3ENjdyHEnhLUqffB1JtjZ_26FbJUBRclUPk1UTUQ1Ag&oe=6A37E355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb1hUvZuCvYQ7kNvwFU8_2j&_nc_oc=Adq43FlQOsRm66YCpFH83wUyQuRjIQFZWMnXJHabOFyOCMmZUFk_eB5JmkFR_eOVIoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FCtr8Ij2pV775ZBf1KekNKO51GWh_5Qhk_19PDO_lhw&oe=6A37EFE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=Ado1oa9kGRnTBlrVHodzt-jJE_gVEE1bHXEAeoa8K7A0fDFRBQkQBIfOOxOavP97f5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kY-Y8Suk2NEMrUO1GnnrHqSpxyNTZf4kKAV3vDomTqA&oe=69D27CBE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MWzjHBtOxwQ7kNvwHFAQNc&_nc_oc=AdotHxAAlZE3kjrYIEM3nsFXy8O-jFP55KJI0FZlfVUjtvWP9qah2nOglI5D1ZPaty4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zgX7Li8y8kF0B4IaQWLlMIwZtO-jgFH2cSz9lxojP7A&oe=69D2557C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60gFh1kbYzoQ7kNvwH2P_oc&_nc_oc=AdoTNap2gaJJ3__wjvNCCtdLX9PmATGmZmzqddOSrnutxEBAJqQk_wcmIACGbJGFQT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v0Ml_ZgsiqreRrE0S0ZgEfwRi1pgtXX3VK5wn7RNbRA&oe=69D27407"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uxOZr-pLuwQ7kNvwGdzbJ9&_nc_oc=AdoVX3e73IVUFPniaJLxond1iK4TpE8Ko-bY6YL-07gFpBjkxawO76xj_hFBO4zAOQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HzfDAyKhfrHONxgJ3HNgfhRAqaNwkZHb5-ir-fsj_xQ&oe=69D25FD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg3nSRIYbV4Q7kNvwEs03eQ&_nc_oc=AdqdKnxeXqsekZpV3izahEw50iW43V_zIB29yqzh5KlCx5H9TbcsS_hUYq0sHYIVGjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yTXDvwlErOSYTgxHeZQpdvQCaoFA4MpKxR-oUAmiuvA&oe=69D26C64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
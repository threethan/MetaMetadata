&_nc_oc=AdobKRL_ytvmOj-E9IsUhb6aLSVFA-1OZfiUjmiABE3KcdUiOdAAGTVV2XRl6D5BE7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkw8qxUt2UBKAGFAymy1-8RuloDVqdpvRl6uZ6SD83cg&oe=6A95D2FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzKzc6cMDm8Q7kNvwG3eCAT&_nc_oc=Adp4fVb3qs8hTFpxSZdOlEfFB1Mlc_ZxbXEmxnnSS0tGWPpZRaffS3s_2owh9r45Swo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHpI4_hDCL3Dqs08dBaUd4UewMHi9T4fz2IfUsR00IYA&oe=6A95E3FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PJvl2uxYgoQ7kNvwE7jjKA&_nc_oc=AdqKbYhoVgmiqRJfObmMLd5j3lQ5jxH9bCK60zkKXJH8DCqhyMKcMlb7gAv-kShoMIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFm7volH8cJ8BM6pS0p2AEsXXbRqVgplWH5YHyL7tCtQ&oe=6A95CA47"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KngSyUoFlgcQ7kNvwFU4iKB&_nc_oc=AdroI1eqR19XsuL8JQzrL3ow9IsDkAmu7PFXAW3xq7lEuvjlJi1c-nmoOmeyHVrabrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlfbm11MqfLmdVyq0h-ncGtRVU5P5uxKoQbT7L20n-Sw&oe=6A95B615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I23MnBqxQCwQ7kNvwGtc0Bw&_nc_oc=AdoDDjAQY_NQeJqnSloMxs6QSkBd-e_EUYWUQ8l8o7W0vomXtU423tYYGftYbTooefQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI-kk5pleKY2Yeek1KFv2393aPat_1kIM2apazJr3Wgw&oe=6A95C2A4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=AdqE53WjQGOXpRZynE9QjtgBH8jouO0jMEefJ1kajjpD2EGEEk-lAKywPWsJa2kjLVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgRRVI1r50iT_I1n7l4hKe2kKhs-AOYG8PBl6tpo_bbw&oe=6A75F6BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlA6E9Pzf2IQ7kNvwH6SVnJ&_nc_oc=AdpI92-VjLB3orsdw9s8CtfOQTBFwxGVFdLLxGhTN1EU7-lg8MtGmpuHbfUCcY7etR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhcblD5WX9FusPeWvPuErXkJ0RPeS-JnkQsyCaGixPcw&oe=6A75CF7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWzDU0fEbx0Q7kNvwFdIzrd&_nc_oc=Ado1GKE9d0-kShUNdA2ixceKlAv8eeyxYd74GeCGgf9livFg9sgg9q6ZXm7O9tFizYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeBSj0EPagJRaDUF-6sPjcLZHNDccIyOfol2cw0qkhUg&oe=6A75EE07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c23mzRXDNu0Q7kNvwEtCVFe&_nc_oc=AdovPRnZM2WdoN36GaVcw4A1sud3aHQzfnVgn62M02gvoHDeq87yx5h3Bv4M2_cPLYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUBx2hiGvozdvztJSNGp52Inyz596PlYhwgfDLnYeTuw&oe=6A75D9D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MZ1yBYDVoYQ7kNvwFuhPWq&_nc_oc=AdqrRZ3-ye6G8Eic8JC07C0Jkmc-uBj9WnqCR38yls65g44zG0rZcI0E4JMyTuAzUxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd7HTigL_LZ6iAQuvU6wXGsDG2m9irZnN-yfI-ZGrd-A&oe=6A75E664"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=Adq0kvGnZDf5qQBjca2_g_fMaafvwD9lyTIv0DjIcTqqkOld0fNC52petXwwf4gF55k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqwjLRhseqkUivusZTF3-GCQXGLMscpYkWy1q5X90lrg&oe=6A4E69BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zrmtdh5Mp9kQ7kNvwFig6ys&_nc_oc=Adr2IcHOdugA0isjpWoidDjdRjwpLihlQ1I7stIgKS1bmDphmE8pLw0i0XXFz-ua5DU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXHydahJOYz5zJKdjbudUpIkt03r72HfJqiH-jKg7aIg&oe=6A4E427C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4gzS-5nDWYQ7kNvwHHiz2o&_nc_oc=AdoNs231ZdpNoGFZTrxwGOIkOTzQRyZ7Jq-t6BrfnyZG_WXOpUARouqI5av2U2gr_mo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKck1_LSmiitN17FdCBbb42Nu-t7bvCNmrRPXV4vGDow&oe=6A4E6107"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoyQeGr0FaQQ7kNvwGlu8p-&_nc_oc=AdrGKjYFevF6l8YGRnSPBodGSXrKmtRsiEvjHDSghHV0_5jQy4nygWKle9iDdbFLEyM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE0Iir0cZdd_QYtKmbh1XsX9Fa6GR_1PZfGvwLl7S5TA&oe=6A4E4CD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNmrf8zFwOAQ7kNvwG9q1ea&_nc_oc=AdpzbFmsd7igpyK0dpl5ouJfH8zCfF3a_2LTPPP5_UINxPTFHd8zzqITL68SwqdAgWw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAixkiSiF9dyfuCBhvp6CT_hQkRnlfMUDyU5QxqdyQ8wA&oe=6A4E5964"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
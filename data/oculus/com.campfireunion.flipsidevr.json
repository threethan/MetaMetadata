&_nc_oc=AdrrBy4jHYz2ICt1nXEsoQ4HAJuWsipPN-ZJZdhoW8T5LuBNVGSaqPPl64tP_H5meWY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lVkwHY6byDudcX1qayDFrVp5-kw0jq9Ql7my9Ml4YXg&oe=6A413ABE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq4iauAyyUIQ7kNvwEH-iQ-&_nc_oc=AdpklTD3MxjxKunzUOhQyMS9B8cOjaGHBGTl0yFCFvdx3mZnJk_HOfWgeMeS41cxkqE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cLAcQd0SOOO_Tv8-vX6TWWgMgIbl6PlxjRJL8FU8SyA&oe=6A41137C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DhRRu1us5EQ7kNvwEhHKlC&_nc_oc=Adq6Z6c8V7Osf-ZXTuerSdaxpkB-p-nw_S7lpVzVxv3gOHBGEVmQeeoLPh1gjxZ3hps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0ur2Vc0SiNUeDItNjY6NKQCqmBtCggeqJyL_lyc85zw&oe=6A413207"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pHVTOpNyWEQ7kNvwE0_kzJ&_nc_oc=AdoNRL17n7xUdHfY_EH-XprxylOdEHS5rMQfLs1pA42nehWWmOpXtFEGH-iBwxu2aOA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UzJmaeEO6MK49qDDMtvtwPCa3oMFFi7djZX6ejVQGlA&oe=6A411DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWIrFqljhIYQ7kNvwFX3Ixt&_nc_oc=Adq3EMVJAuc5rz7Z9efpx7Iaj96fy5R4No4OTjiHeK-VcouEsd8ShVhgLU6Mx8E6Mm8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zY0YVMZWf1Ue7NI-cCWiF2eRFpemerPKmQ4lkzwwTTw&oe=6A412A64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=AdoBdVbiW6vLD25kAC6C-xpXPbTDP5OVDQLWISO9pbCYqJeyeq5GDUXswJTUKFqvjro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ANbwUDvdKKduAr5LxndIF6PmR0BMOvh_m-NZQWoqpPQ&oe=69FA09BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okAx8ytHAiMQ7kNvwEWM1Wk&_nc_oc=AdqxZg2AhiSqROF5xFc09sz71v3ITF9pSTMgfZo8Taqvy8gmXlgVnWtZZjqctTKs-1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mmDTnceYOOzpUxQR9pLhzZWQOjT_PpM_N9u_-1OGzog&oe=69F9E27C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgIgriNQBPIQ7kNvwHiCoJF&_nc_oc=AdofC_B9EhCnfHydOlkH7-Pxhw6o1JUVzJrwcBx_N9c_N8UJlJd5QimKYHk4naGYrIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JTPNEZY7kEYfIMv3fh_IRwJ31_6XHSUOXo9plhdhcZw&oe=69FA0107"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jw6njli9J8Q7kNvwGlzYq0&_nc_oc=AdpJ6A-tu-9kzc3J7P_p57Bqz2459F3ZBy5mVlj8dVJ7Ykq5vEUfPqzA5HYbvw20VxE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ifhZvsSQOZnLlI6AixfeFZ8ftUQibXStk8tVIpUj9PA&oe=69F9ECD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bU3PQFDq7oQ7kNvwEI4yMW&_nc_oc=AdrVimAAqrHYj9Pu516v15GCk6o4VuVQAKSYxAVK1RXYizL26BYfDL__Z3m-uruAOa0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GFZsaA_rqLFRI-a8_vSh7nNGr3VIrn4IgSubP1i9_7A&oe=69F9F964"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
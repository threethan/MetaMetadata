&_nc_oc=AdrSjhhsDBu7EY4yrkoRdGS-W_hviMe2LRDPxhU-VZyC8UgXMeomMbnWgaD-PsJs0Fc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WMf1O8okCJQKHvvQCpYioJVjeNDZrvMK4iYZjsbgqWQ&oe=69FDFE3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuWbyONSNGsQ7kNvwFLE3eO&_nc_oc=AdrUdHl8GhtwjXIjtV7sbYSDKsWHQRlwnogxV48gkPLzOeQzoqe5vbxS1EFKzw_lzOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xx9q7k4HHaineugCeCrs52GVbu0mXGbpiaVy_4m1fjw&oe=69FDD6FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNENfLDz-k4Q7kNvwGYyals&_nc_oc=AdotS9Bqduz05QAm7Jhew_Yb9lTmAFjpW2oQRj4O-wqocfWFiosPLCTQE0ARfEB8UnE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kgSyZg98tXX2moObH_DIacXGAV4_Hlq9OZ6eguo6r4w&oe=69FDF587"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt0zhHHAx0gQ7kNvwFgioQS&_nc_oc=AdqJMM8Bxs8VUsxsHf3HtqsHUrZRZ_tF8JLQ9HHtbzhunxwoNGKv8PbP83eMUCr_Mj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VVK2X7HFFP4Ycrj4bPdyywMFi4c5_JO0Ad4o3_GaVow&oe=69FDE155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBpSgbpLUWIQ7kNvwGZTXny&_nc_oc=Adpo8Xc07Ku-XE4fWUzEb8CDC74fzHz1UCKKYZGsF8zLRfywt7PHkJmb-k-C-3G4IZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ih2SL7lOkFN5e04V5TKl-Agewz5xZzjy_s5C8elcSRQ&oe=69FDEDE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=Ado23sZs2FsVjhpuzXsAMVaO3XEEESBWt1VGxPuwhuRboH4NkBF2LMcp64osa060jag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFMhrpXAsiLoIH3QxNvtxfTo_OgZKiGDfA7fUs0W1uzw&oe=6A8984FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8ZvmcIfShEQ7kNvwGfJbci&_nc_oc=AdplDI-1WkvCQyfNb_bQPP4yH5mpNImtT5h2G5Qe0gg_2BnH9jT6I2vh2mbTXG-H3Uk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkITFpP0NmS-kEzD8RFfgumPoJ6Fv05Rr0t7GBRXELeg&oe=6A8995FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOPfWxRjboAQ7kNvwHHyeMf&_nc_oc=AdoLVdA2BcfGbi45OFBJPTfoOoSVDSTtbCz_-HXZYWYeXaTbyYFGNmAsbDxkidXUAl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj9agxxWWMuesQWkCBhMv0JspYqpStS8xMWAY6rGgEsg&oe=6A897C47"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzZ_8nidfroQ7kNvwEaDEKA&_nc_oc=AdpgKDhccRHCMaFAQ2CZDGIAeE4Y55AEbK_UvYONRIQl4sAN4vOlZOq1NAB4zZYaca8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXAKY3tFI2OSWEFajAnur1vOVh_eOK60r5_UwEuv5rAA&oe=6A89A055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bgAko4VXGQQ7kNvwGlCFxE&_nc_oc=AdpGJbbjhT7s9W379e6oQZtBg_qZpMMfz8_8UJjfYfxwL9vXJzp4NRV5pt2Z_K1XbXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7GMxvatvzIa7GtiPaL6RmpF50X-RhvfnplfaFRv8QiA&oe=6A8974A4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
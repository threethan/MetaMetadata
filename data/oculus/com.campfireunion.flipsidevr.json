&_nc_oc=Adr39i29z6p3rijiVAbz8ynroIDKP3l-fK8qf1MKQgrmV0Wp-nSE0qm1DkO1GkOYhRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcV66Z-BIJdVtdaByRCHHGg-uUFQEbFOxuclL3KpGNlQ&oe=6AE0C03E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov6-P7C1hXMQ7kNvwEsArrT&_nc_oc=Ado-e1KXWW-7go7D0-L_i9YG7h3uNuQwdaFEp7mwKcNxLus__7uBJlz2h_gdD8WjDZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHo64jGUlhL86xd-np8ku2gC-1EIdD8a6wejCFmw3tcw&oe=6AE098FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB7ez88gcAUQ7kNvwF9WiSD&_nc_oc=AdoyzapESuDjiLHdKujdahwn5TDEctA9kKGQ9LpwzriaitAa4iXhNCCwoz8wyUocrYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqvze_33eRnSshzxdc5K-QWRFGOFEFXhVyNApRWl1CDw&oe=6AE0B787"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU5pIx19vjwQ7kNvwHHnOBj&_nc_oc=Adr_dp28k5-wecHvTuFb3uQJXr-TiqW4bOVKef7HYBixh6kac7gx2-it8aINtM1fl-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwzugLGzBZWLR_wg0pFNHLiNeO1dWvyyTxzcA02rFnnw&oe=6AE0A355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJIXaDdggjYQ7kNvwGJG0Gj&_nc_oc=AdpEiR-nDeiaENhVLADiTpCmVrArdk3eXDjMDv-DqgPA0ZQJrAo0zullgzcCQlmu1go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz5QLrk2UliIQqhgQPZW0bsbu5SPtbBZ3K51MEYiEgqg&oe=6AE0AFE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
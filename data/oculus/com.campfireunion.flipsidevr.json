&_nc_oc=Adp7cSrq7xJSC5BxCxHBC0hWYIFT4vIWkWrHEGUsGn95z88Fc5UPm45J7ejrkSphHl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gfFMaZut7CHN5ErVnqzUNUnEKDy2C5MGGhN4lCfi4LQ&oe=6A088A3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBbLtOuetOUQ7kNvwGh89ER&_nc_oc=Adrg6TRJPj93rmSby6JJJkQzpajKPaM7umIdoJMulCnPsVocxtNBDdXFYPKD9KPKY9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68RJe5WzvatJz6s1nl3sNok5ugSTygRAEIw0wfhzNRPA&oe=6A0862FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBXQcMf5hGQQ7kNvwGErCpw&_nc_oc=Ado9XC4LTeQJ-WZ_yykIpCTC80Hh2VtLoR--sVdWQ-dHcY7mBQVyHn4GFOoueEuPIvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uBx_ZyseGWofu0z7oJvikOaRLNPAuhcvDx2gvPWhQvA&oe=6A088187"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4S3QPen5H8Q7kNvwEeto-3&_nc_oc=AdrnnJIbiSSVkTBpFFpktiluhzrrmi4rUMJyf2yAB-DQao0VUq4IG8nyi2d4YfUFc0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SuomvD4XkjMa7w4THg7YtlVyb8cF0PEoWArldJd_rPw&oe=6A086D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTd-9uLrBysQ7kNvwHkjU8n&_nc_oc=AdqWijB1oQsXvZ50HSBCW4MPK6Wh87l51mIdMRRKnrEn5wGDnOesO3mhrJOEhKb2hk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UXB1BP-CVYiKOP4ASmkYh89CVCZ8VcL0OLbw2NXBUqQ&oe=6A0879E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
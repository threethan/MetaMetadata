vwEioVOp&_nc_oc=AdpLUcx9rtXPe6pFXGqMbzvdoLMRJUTRczwvukTXAPFsuF20n0A4A3KqOtKb2s0HxAY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVsPDo2uEytu0j_iRTprqq21D5gOGcwgWX9-7iSj3vSQ&oe=6AAEA73E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15UPFtelXb4Q7kNvwE92s02&_nc_oc=Adr5GvXX24lMDYleUDOAf9WSsQIYcZVyxScOSdQEXjOZuJ4yfCvWREBkwq5RsyZ39oQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLKh9YZ0V8d_HBe9Mw4Sp27H5YY1YMNhC2LhrNLB_UZg&oe=6AAE7FFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7nF5NcXd2MQ7kNvwGXdd-R&_nc_oc=AdozKSOMaDd5FquEhLF_ver8OBgpw0Sj2lvOob7P_IhShxUSvNurQ72unOWiEQ8-_H8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt8pVJ1In6atk9Zf_IcNoADaYv_3M--TQyS6hhZZAORA&oe=6AAE9E87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gddROk4a0dAQ7kNvwG7KoDa&_nc_oc=AdpwLyvcFROgiIKmx-WkWQbweocMt7XddlEJiS1NanLjCeYzVvgiHAE0wymeQkWa6QE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIriUpnu5Q9Bfiurr23k75319qEdtPlaJYu8mGy--hrwg&oe=6AAE8A55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHMd33k9qI4Q7kNvwHILrTA&_nc_oc=AdqBgK0qK-Ga5VsqFx_KNuKV4eNeCj6kYc23Re7U7rHlOIX6Q7qZET-CMh5g15Z_iTQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzW8v2O6lpTFdR296_vl-1QSKufk9qF2GoNh2xuBkGcQ&oe=6AAE96E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of su
&_nc_oc=AdoB7chgpF75QYaZLmcDhxujWPaC63PoAAdLBkWaT1MrSidTNIt6ykCuKc8MKWOVGss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bs-wlsXYwiI6rHOxrgLVJlVST1Q9QMU15xCeCSRVm9w&oe=69DF737E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqlyM8-kZlwQ7kNvwHxfgqv&_nc_oc=AdqDDjob6zpPKpKHilvZfGi_Z5yL1XjbEawxQDj1Klfvxy1QE2gd09AecKkFbN6X9fg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LfKK--C-QwPT5qy4kJeCH41aCCRQYuINEQrRn5oriQA&oe=69DF847C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-sFRIYBqtQQ7kNvwFqRBrT&_nc_oc=AdpzFNLftK5o3knts3VEqPuVt0CNeXP9eD967sp69CEBTj2zeGVF1WUMuo-HjqgWY9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C9a0H51RTPTumWlFuSEGOxADtQq1puvLMkxbpI8eo_w&oe=69DFA307"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcsyMRKZeooQ7kNvwEpvO_7&_nc_oc=AdrLr3tbPZ730v1Gtdoix2c2BFi6Bs1Eu332-RyRY4lkKOyWiPt4i9Fo25sceBiFMMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ULzRMe15w09OoIyfSvusrx3tBdKJcolH6TCHywrqbyg&oe=69DF8ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE9mFm8t4f0Q7kNvwH-h3i4&_nc_oc=AdqEE6UgmFOKZx66AjNuLw3j6AWA-n5UMTI_yrpM9Gmkde8pY4-pFud9MyPqsQqUwZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L-7f2HUk9sAhzEKExG_9oGggt7hyAyC34r-gBwFAMdw&oe=69DF9B64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
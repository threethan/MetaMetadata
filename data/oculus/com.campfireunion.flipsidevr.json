&_nc_oc=AdoCK-3_LF_THTvi51Ks-x9w45_TFa7ALSiOdZuMXFrlRAsxDjfdxwfSItEditXoW54&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGerZgvAyZLskm86TmpJb-Tg8fJSCWRNMG6r_4vt8Wzw&oe=6AD0EE3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N07YKW_T7x4Q7kNvwHWC_FE&_nc_oc=AdrW4NmupzHbRgTVtOXpOMeh5O58GPN9pThM5molupromPk3Pmr8wq2xhKggwjkduec&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1gPOTzdAKyT-UnkT86qcWn0C3AOLhShjraB-vLBUr2Q&oe=6AD0FF3C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9WJbCUn5_gQ7kNvwFf2m5f&_nc_oc=AdpC8ecZMFUV4NUhsbFmLDERSEWMImlVepl5Mhg6fMoUEn6xUufGlc-nl6hIgxNNIU4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7bU2zgXimEg7IUNk4GPRzH9jns8z1K40YQzUG6yLOpA&oe=6AD0E587"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V4vQh25B4gQ7kNvwHGjMu2&_nc_oc=AdpM4tKcfhwwXXtrfDTEpY6H5Fc7Y6DUJsWni4gejRmjYBRWS3K8pnu7fixA2t3IW70&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUqoCbrUKtD8UBgzipOh6VKubdc_D8dGqlR1A1OshTHQ&oe=6AD0D155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTmPgOXZ43wQ7kNvwHaYQSO&_nc_oc=Adr1AwAql8ARYNQJxvWNz1vfW25KDXRE1nOwB_ox3S_-MQGRrefRbgJAzWDY1bLYHso&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9rX86T2iKEZWxb2VUjqJRPCbGxyGbaFKALtyPm0kd_g&oe=6AD0DDE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=Adpq4Llii_DZtIPlO6emBeDt7upOwcJnw6yIWUPgjKjMj5ueoQLFmQndXzzTzCAdWNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk5Ie-hxRrGl3GkTQvPyPm6XrXv_1IBP9wnPIbBS_vOA&oe=6A5E037E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82K2abJuAb4Q7kNvwHTnOuz&_nc_oc=Adq55XNq082j1NKuIhRAr9byaqUJjir98DT1bjaoM8bQjNIZ0q2mUroTDkx4t03A1vc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByrNG0Dm11dty3I0baTG7hSGLn7aLj4CNiM-uelLqB1w&oe=6A5E147C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OP394nkD3QQ7kNvwEWSPa_&_nc_oc=AdqiAY7QCGKF81shzDOyxkqb5M3FACrytUPf0F9j3duIV2Ith9Uj-z37Pxz5dt3XpAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdPM3_e0pLL-n_nD_ITkV-iQHw-1vh9njid1VrlWGutA&oe=6A5E3307"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zdvav2-TwREQ7kNvwGoB4U_&_nc_oc=AdqM4zPs7tSUpubCdOv8eXxuaYYAkksZjo_ui-7j4hnSbF9WkeqAhC6qmrQAQuCy-K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzJmFGXFZBen6NODnB4yIeRa2kNZvcEfiVKQ6Ow4UTGg&oe=6A5E1ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB0M0P8nfTgQ7kNvwGz2CvP&_nc_oc=AdriGP2rPJA9u3rmEcFbhReEHJ9RYW7q2xYn6ntTp_rpVfWMgDvOKnCSrmIcQ-WztvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUORm67N1iNLQHjIgv7lnXXFwQJi8vJ1n-Kd3ZOJsfPA&oe=6A5E2B64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
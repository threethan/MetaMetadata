FgD11eanZ0poO2tgJhneeuUF1eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxolHxEBwKpcR2hw89mKaPWNUBZP1F48_0TPnYo9cIU0g&oe=69B2A07E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qODSwU5jIJQQ7kNvwHaFV5A&_nc_oc=AdngSR0Ab4_akAWeth3yVmOiUzIxCgaRvC8RJ3yn4s6qgcD78n-cw16i2_uS8YVB0LY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTL8AeGJEZSK81at6Dp4JKZ2zqYVtGt5_h2POmFZhbjA&oe=69B2B17C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wtGxd9cdL4Q7kNvwHjFsRy&_nc_oc=AdkYAVEcOTtIbAlrkeza2VP9Vl5SfSAlgI5mEkhM6AkR9W9INL8ZwHZJB27L8IEsnbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfydVhfWOfzLTL9JgwKSf6kHj6mrEilR_HQa3TU9QqOOSQ&oe=69B2D007"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpEl_TM9r48Q7kNvwEF1iOR&_nc_oc=AdnKRmrSD9FjJyw8tZzMrTMFaoJ18DG-YEZuFsRDF7XxuvB9_6A9bq8cU35fUOJtquk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeXgIBwZFr3UmTj5RiHUCJXHwIy_hnbaePAOZ4LoD-mQ&oe=69B2BBD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpKTLN9MjWsQ7kNvwF7hyGx&_nc_oc=Adk3KaZ0XcJrjzqJlUgK_XkRZ4gdKYHnY_2GTnmqIoe0hZ8hme6FUaZgAlgOVgKm1DM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMVO51tjXzlr4ZMUNHslu-QLbLEV55Ws-tjqxTQ8fHpA&oe=69B2C864"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "
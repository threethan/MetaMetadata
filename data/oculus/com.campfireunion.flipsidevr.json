Xz5nPP5uPYr62bA_tRXM947vQyc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy32uV9jiFe14Ov8jnsFuQmcpYv8cuvunMciy17bpkzQ&oe=69C120FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52RhuplAkpAQ7kNvwHOEGrd&_nc_oc=Adrt_jmOk63ijGuAc7PLiH8CAvBWUMwEWLct1b7EnIevKQD9UMeseYAQFTXdrVKBW80&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfznaEVDqrQAj0LaGTNNPP74nkTTJocSmSHrBJua-jRoyw&oe=69C131FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHJgfIJCnUYQ7kNvwEMKHuP&_nc_oc=AdoyfVaJPtr19CtGrru6wrR4hxhmWqYIdamG855vZn6Xh6AHI13SdsnBXC197HB5RGw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxFwwXtKd2Hs9Fl0izGnGffBr4TVXVxmKkEfOFu5N6vDw&oe=69C15087"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwxGFcLFOr4Q7kNvwGdydIg&_nc_oc=AdoDF2UgGk0MnGrYMiEOq78l2qNWk0X51_11r9ZJemJn15s9gcb2Don99-5k2DsxkNM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcY9rAGj_FNCCtpqjmtKRTth3Y-NEgwRAehQGdsz8uJg&oe=69C13C55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xYKMe-WLFkQ7kNvwGSFxEL&_nc_oc=AdqOZeDHOjtPSwCjOFYtUXjrSg0tyMycuOBbKDVCapgEQJdb2Zln_LPklSF_YVBlyCA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzua9q77CjtruGtyxb2Xb2V0ASsBx_Szv-NNgMKjbljAQ&oe=69C148E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "
VxltMmiBT5LUT9iELg&oe=699993FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryBTQG9g3_sQ7kNvwG6NMno&_nc_oc=AdkPpZWiKRDsb5wZ3OimVCi1niXyrPQEHX1FV2nRjjiJ2_O7C77tYqSIGFoSeLkDcxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsfm7HrM9Ij3T3pHPxPlFRzYvg2ajeWi4QYK6Ym-9vYaw&oe=6999A4FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rIpIw8u_5IQ7kNvwHqVw3-&_nc_oc=Adlezpo0W9cev4mttOyGtnTYNnggCUkWG2_WkKVk3wyS8RHtJICMy_wt0MInZmBuxjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBXQM_2DUMH-byhJLOcorqa4a7dWBlGP7eZTT7AR1inA&oe=6999C387"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xpxjnyFTnMQ7kNvwFf-2_7&_nc_oc=AdmAcnOJuNhOtgPAElczy9EHDEjMaNI7Dps6tgAZJ66PiOuvlghqi-IbR1JqcA72rG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJ9uZUzR1lLqhZqkkUEOcAZcSRhqdcz5qKfnPQyMKWeA&oe=6999AF55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySrqoLXuFb0Q7kNvwFTPz6X&_nc_oc=AdnhNhidsXDcJkmfxVXlg7UTDahla4EGzrgJOXnNbazQqnWcrR2hQRV_YE2MA3T7yRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOHQB8VkJXsoBT0mYpTLHyxmaPw_i5uQ9_4Et-2Q8Vqw&oe=6999BBE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_nam
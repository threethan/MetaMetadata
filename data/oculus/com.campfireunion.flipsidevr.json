&_nc_oc=AdoX82v7DaMJypnx7vw8sguiVE_jvjJ8UwMt3plmsMjsF-1Dh63Yr3dPEAGxFtvW69w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ja33cuKd25IcxGk5jiso83GxLFbi9qrDbz6Je5FHQ_w&oe=69EA37BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUuskyDUbacQ7kNvwHOSZVe&_nc_oc=AdplnqmATH1YcySSTr4N5UacZ6l3QRGUy8wzaFjpP6MBzXwcwVnC2VRg92wgVwTOqbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37y3Tnedr4qMmktJcP3fTZ3usueqBFwh1TVlO98obA6g&oe=69EA107C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVHFJ3h2eIAQ7kNvwFpHkpe&_nc_oc=Adrt0TRNgtkdHEDESXnF10TjisoebmlRQm2DX2CCHJbQAEiW8qmksaief0A25lITZww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h-FdbNi5tKwNgroaXjIgl2Zbrd4lXM3O4yhUkMG0O3g&oe=69EA2F07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynw_DJLA6voQ7kNvwE5TLte&_nc_oc=AdqYmzt_Ht2k9SZHrWA4VYV20LTNSZUz_eE8xusLL37JvOYiqW-CRcavIuzdor-R9NQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YZDqREJq1lMFPqpJ5rwPGHFG10w4hg5URz1aiqUjDig&oe=69EA1AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiJqeT_vHQUQ7kNvwFlfzWr&_nc_oc=AdpZhpgA2Pi7KALkN-894p6YmHPEbkh_2aI_RpkssFt4DjL2hQ9toaVr5ycWfhLQb1U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_b-ZOVb5tPrMmoZtXrQWcMHztgQakxfcjBfs1t41sow&oe=69EA2764"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=AdomL6QMB-PK0r3Kux-c4xTsnMwaSHAhrIORlkaw94idY4z2FfL2Ban_1wscPRjxgKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM8YciGK3GpsCys47ITzgsLWo48OViUv4_lW3dEPa3RQ&oe=6AF486BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZf0QlnnQFcQ7kNvwFjqIHy&_nc_oc=AdoijP4shFseFgsZbCkzKlxdt5aG4Qh3BUErNfi2BRoXAntmjm2e3Z5XsiywnBIl3yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn7_3FCkXfL6zYejSoIitc7_1emhppPzYN0n2nMdNwzw&oe=6AF497BC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6FvGtfwkvsQ7kNvwFohIdW&_nc_oc=AdoY-bwus7HxzChw0kxmz2ed7S7yOtR-42fps8ptmgOYYnkzBOlN4tuf4O6AtXl1ou8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlPpSAwACB8oTu1Xl4thsEVTIXSrr0pFWiM4nZxOuRAg&oe=6AF47E07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bQouWTyAXQQ7kNvwHnOKwU&_nc_oc=AdoZ8zpG5rq6Au3BhpNMieEqY1w0vw0G2wlysRS905MPeXnsPLgT6h1k4oE5El4jGsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9YyeGWd2WnDzVcCFuN4_vGhWSOZ2hQCrzh6JmVtHgzA&oe=6AF4A215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSL-nK0-UQ0Q7kNvwEY5QVs&_nc_oc=AdozWcKsHUz32gUb_jJVCPVc9wrtRlzAUhwWzlE3c5CJNNYVMDzuNjAWf0_N1kswtLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPGxUc_tWRoPS4UerD3adsVAx2uvuTMRa8BtC2eGWfDQ&oe=6AF47664"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
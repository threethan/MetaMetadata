&_nc_oc=AdoydS68lRQ4v6cefnP9IaGS6Ui9lEnzuIzeKm4CsKiDIuEkljxZjxxvyyey0tX_4Mw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECIBRvGYGKiwMz8cnRohWfMCHXVodtqbFanz86ds1XYw&oe=6A916DFE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9Xwb5GbtF4Q7kNvwFUS4SN&_nc_oc=Ado2rKiSCw5_J7VoTU7RnPfG7FPFkJOeN6FbTlwBxPiphrCMizvRbQFkfgPjgy_kxR0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdZMIKLX06rIcdhqrCIRISMVIQWYdSgbRSwK4u-3oMhA&oe=6A917EFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFGkhcgM3KQQ7kNvwFx9nwg&_nc_oc=Adp0JH5G8WQJy4T5FaOZN95j5EGfeKq7v6X1I_8VL5c-ZbZs81EFJQxTbSFlSCKw7To&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaG3i98wfK7m8pFIpJG8Ri_Xi1hHoP_ifYZeXa4etrow&oe=6A916547"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCW7gqOIWpEQ7kNvwHvyWH6&_nc_oc=Ado4wt2c3ftzQrCEzJ39SHBf-0Z3lf87o3E8TdmC9WGdteslLB57FqInXzOzgtIhSqE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJjzTJR8rgzYSlKH5yDdv26aLj8YrEG7pgeaHonGeHLA&oe=6A918955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuZiIpyIpaIQ7kNvwGG1HPR&_nc_oc=AdqfJkDaGD2rNNKhVvkBYsugatmj9Du0j16BxIeqjWX6f3ryH2pvAdUsLC5sf06wvMU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-0BpEgop2DAD1tdsT4npo4oFy8ZX8cnmBydfbpQIJiA&oe=6A915DA4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
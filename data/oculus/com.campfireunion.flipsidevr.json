vwEbYSwk&_nc_oc=AdqdEMvGPMtI0GxZ-zUInNpTvTzKgi7VYAuOXzOXTHskf1JHblmBr7T0HCkQXd5JbDw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60lJCg6vZx0Ce2fKEw_oZm_DZo3iK3vGUrMhs_f7rgSQ&oe=6A11C4BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwvSgCqDYn8Q7kNvwGKHHh2&_nc_oc=Adr9n0E3HfDO21iU1vG4itIcniX9_KyMpUvOJVQkmDtEGgB_I8geJKHOr-H3V39vMqc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CU38hLRsMrOJCaZVT7zgPZZ6IYRI5dAo2HMlt1BQtzg&oe=6A119D7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbMnlvaSizAQ7kNvwEgRBRi&_nc_oc=Ado3OA2vpsnHVAjMJtGuQM-AW4GQzbkn5oXsy-ge3L-Zj7cVfNIjqDCgdjSTgrfLqC4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oz2ym3oNYDz-QvKmgo4eeToOcbkpe4NWUE9dBJTX2yg&oe=6A11BC07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWAJ-6-FTucQ7kNvwFv2rhH&_nc_oc=AdpkLTLAUYNzhymD41Qn5RmtcJdgUZxdMn16PxQX9gftI69TRR7EXsX3qkGc1Fh9m40&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zEslgPx6-_JTCvKN1WONxWwOkUzU1eiKhtweUqIU9jQ&oe=6A11A7D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCdRWu8WRjsQ7kNvwHEGC63&_nc_oc=AdqMBlj3hh66G6PLb_8GLsGfhiwghgomZHmdZPksk6PErV72wCJDvB3aNAd9oWKvMFE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o4NrMYMU-13AK0E2g7y71zck4Gwm4AVnzuxXAoOeRfg&oe=6A11B464"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of su
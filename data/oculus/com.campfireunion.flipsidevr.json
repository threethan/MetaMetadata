&_nc_oc=Adp70mBA-8qRw-L-yQWtML3UwfsvA5MUYtUhLqOx7AdwhPRl2Z7-3-BHbru9ZbPviys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdD3k5Q1qzPo1cjQ7X2z6qf0MUo8MxnO9qfi3zntIOaA&oe=6A6CBC3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGwIqvDPBncQ7kNvwGwJEKB&_nc_oc=AdpLO8le3hn92KHS2r824bIyUI9Gk8_zQcccxNJcSGVf7CcDOb22XdiO-vSkv2ZRgR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB78B-Kqyv5uY141a2RXPdLpDvaLrDnTgdiacekYNyZTA&oe=6A6C94FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1euWobP9f-wQ7kNvwH8DV1R&_nc_oc=AdrL5lZnr-NuEJxIJRHgjkpSsmu4t1ub7eEpS2T6wmjcC9jFBXYXSUFG2ax_rnTj4vA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVAJEnfNaJiyKBufZYjijH889_-f88GtmEKZ1A4CO3WA&oe=6A6CB387"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvd1WVK7HEEQ7kNvwH3FVWK&_nc_oc=AdqqgwyW27V0AyAjWRxHUOVfui7uIU5kzhu0g_v3ca-nA2OSzfcrBUldtsWTu4hhgRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHHS3G6BObQOrMOp3yxLupNem1B4ycChHI-1hWMrEKIg&oe=6A6C9F55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHkaBE1de58Q7kNvwFLuD90&_nc_oc=Adp1-BS0f-sL5ITL5zq3F_7Fe5KyOP8TwwBY7yHq0U-knKVT0SpSLMZEEiKmxznNpAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJEwQ-_wDKlo2db2U3YeOmA0kgDog9NDgAILechyh2Ww&oe=6A6CABE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
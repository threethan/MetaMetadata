&_nc_oc=AdocoVtey1-7PYN4nXkaJXbIBH1JSHau3aI2lBmwlJaY57Kegu5DvQtXihxXLFiWEa4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZeGZRtnXze6k7GH-3h2qJIPQpc205wEY2UlWtBqga4g&oe=69CCFE7E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnr5aKJMEVAQ7kNvwHHNAq4&_nc_oc=Adrpsc0L4dqyaR91udipy0DGmtlcTh55CD2bliT59rQLIQ1Q1sCN405IF4ecYv_oQOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrHv8m9t019er9C6poZ8SW3ReLL-qAzEKgw4lBaymdKg&oe=69CD0F7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p55I9hUVZb8Q7kNvwEXX8gf&_nc_oc=AdpAGBP6yeXgZlToif3AhLAB_9Uon0ohBjYdIZ2hWtYzLZcu2K8d4NMYzmD1-17LplA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeIdZ9Gw_V4-UqawVu4OzzOwqmu0YtQ-TBUxhgaqhibA&oe=69CD2E07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ5lUTm6FdoQ7kNvwHZyFG-&_nc_oc=AdpS23TdWr2VjJ547DmJumBYSKuFM9jKktSmkXiFM0RFf8nurYHriBwrrL3De-Kvgz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxuh7aJJuwSXmOFluSCEI2NmTu9kMiTUfFijqhXt1UlYQ&oe=69CD19D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLaomIUhtAUQ7kNvwFUrz5S&_nc_oc=AdpKC11Y7yiS1plqpSm65X2T4Z5zTFaa8rREOuKuO-SSv7BR4pKE-o7LjZBOofTy6rw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaduvdDnIJnWBH7L7qTlJqx3410RneiOWXBdoUeY24lw&oe=69CD2664"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
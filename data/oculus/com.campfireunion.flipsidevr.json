&_nc_oc=AdrEJ412ElguRlKdaSSeEZ4YUmaqnMhIgwEibZx8GELMDbd2_zmxTXhqcOCNac17g3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1gqN5AOPPgiPqcGxK_ZjAQ0kAQiWE0ehcMf94E96opg&oe=6AEF40BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHCoXtFQOV8Q7kNvwEVTg75&_nc_oc=AdoMO9-MQv51j5JgfL-hS1Yp3inAaQUZjKJA6qn6QM-DSIYIqalV2dDMADJY8BJq7do&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmUtdweyymkrQSF650KQNNMDCbwecZHRSLczW1yDlnxw&oe=6AEF51BC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoH8N_5FMQ0Q7kNvwElKcw3&_nc_oc=Adp1Q8G_4SRimneAc0kHeheaWcf8sbRkCgmviU4_PMaumV0frbW36lUVZfQKquAZv2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-MIOCz5nOy7siyacGiyseU5pMIVy0j9wxF7eielWvOw&oe=6AEF3807"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPCXiJyajtkQ7kNvwHKUatP&_nc_oc=AdqtANaBFWnIr0m_YX473huSOKkearQ5yrBwr_N9bNWLcvv15RClAokeNC7-34Jt-dI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkcR1BQLwqc6ZsE50AIHzmuSfkld5UJzGOgBlgW-Z-mQ&oe=6AEF5C15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=662uy7lJOzEQ7kNvwErWLQW&_nc_oc=AdpebnTw7rFlzizIXOk4bfubs8y5kOcqOWREfY-AIenu5V0n8MZEB2mqSEjl6lC7s48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_abLZmTLs2tk7pahWRINzPc7OzxL9GcUw-LaAmmdD_Q&oe=6AEF3064"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
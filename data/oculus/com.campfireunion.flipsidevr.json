vwEa1rNz&_nc_oc=AdqRbqVPrCRvkiZ8HUDGzlvHJANxaCQwrGode4EAI83pkXKVgVoybhRJDMbf4AeFqS0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UVziMpeRDEtU-yiFHYm4YjVDF4L11P7ucXr1TkaDSGQ&oe=6A22E83E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujbU78UaPRsQ7kNvwGCGOPU&_nc_oc=Adp7Sxfsi1NFzI1OZebhEQYvSLqplvkHIRiBVkwIYXLjY2arkZ9PXaUiooz5PGt5EbE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uchhhUnRzvBiSxRn8Hi2hCNJ-lXU_XEKNPTWWPDmNAQ&oe=6A22F93C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhBhAsVqGlwQ7kNvwGxvdYh&_nc_oc=AdpeOJS1MO1LRSvnJ8UPjWlEpY7nYCtbIFQDCqXPzhb4HbTU68sl0g8wX4P_ekX9qgI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e6VJG6B9TeUrNxAoKYACcphJnsYtVgZJi6zc-ivjoBw&oe=6A22DF87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR8f99ljBk0Q7kNvwF5LPTB&_nc_oc=AdpD_nl8saYXwtdK4Ljo4lg7_lC1LuelyBMPfvGxeXFAXGdzWsIW8U_pmPt2wEyYIDk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_53hUIbVXYkSYn6MesImKHu-5KXI0gtHknCgFlZRcm_w&oe=6A22CB55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoQqagPRaooQ7kNvwEsnjaZ&_nc_oc=AdpiGwDu-ZSa6YAZ7b-NxKLlGXIfay9XgVFoXhF-kZQWW9ZT2MUH0iUrsvuR2A3Kyrg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dIEVVREbM0HXOcjjH9zmBEucXmZR3wsbGJIgZJGTG_w&oe=6A22D7E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of su
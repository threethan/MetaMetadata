&_nc_oc=AdqS3ghzp02M6JE501aBeNV52aOskKe-q71_LwZCsUwvAUGTRa2fwwedeGmPpHUG7i0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdCkVQPBXSOcQehGLt6DUvfvZqwniL56H3J1YpXSXcEg&oe=6A7C55FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNk_0cYiuv8Q7kNvwEjTfyF&_nc_oc=AdqOWtPSWTsgw5hpUc_O5205ofs7YXuCLVMQbsq0YzHTLJCafr-L4A7AY9KDQFIPn1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOXDWg6uwNisAIaaFmre5x-Ku2Ow4nbkkr27vl82Ud_Q&oe=6A7C66FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vieXLCjVY0Q7kNvwFK41Ze&_nc_oc=AdrA6g94rhc6kIA_dbuVQIt2m4y7bHgus33ZcnDe0fmc2SZCmhX-cICZNvd8O9_HLDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG_RvfeFEl5EKOCmGn3sr46cm7mMPM4_Abd3veNeDB4A&oe=6A7C4D47"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFuC_uM2QaUQ7kNvwHn0VB_&_nc_oc=AdrlADJLC4fbuMcQZUuTFEeZaOvFFCvtDOZhYlBBSegiMeqgpZcGMf4yEH1ZssqmmkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj3uwk9EBx-VpLJdw8q8hfyQD2uCDuFckQpmSTROPoQw&oe=6A7C7155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue4-itvdwD4Q7kNvwH8YAzs&_nc_oc=Ado2qAuIa0EVfuuQnURF0e7KEuVr4wYC8CuY7ynV-CXi8iGQxrfftwLOZtJpJExFsBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcLDIh_K3CDkF0dGjTgEFpGVSUFCSVGM072J0zxfOjXg&oe=6A7C7DE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
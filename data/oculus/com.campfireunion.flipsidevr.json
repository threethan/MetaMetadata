&_nc_oc=AdqXCeYdH2TPEx1zaos12I2LkBMqZDlQkl1tc8lE4XODm01QrHkB8fi6CY5JS4-G_WU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S8m4ziroj10ZeNLZW2Zd9o-KuFR4U9kmZnlgjX3XUjw&oe=6A30173E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49XngjXL3jMQ7kNvwGHhxxo&_nc_oc=AdpXnyGO6fVCQ_LgIvhzu0SqsAAhn_FI1n0OF-idcEbScm2xlSyHAlKDtwSWzxLzL10&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6hw_IwHcD0vkeaPKgnEiolT1dIV4YiYjm70fxSnwO2A&oe=6A30283C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRQAeND5WC0Q7kNvwH0o5ZL&_nc_oc=Adr37U1PpfKxTUSAxc_nprBm_tr8omj44sZas9x7Ba1yth6IXCcIOph8xhVeP1VhyxA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DPsIevOxf6W1K3F5U76kmgdJgAfcTEb40qTVsgStlyg&oe=6A300E87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjnaZTfiHYkQ7kNvwFlHuzh&_nc_oc=AdoXYiQKMdFP7TIrZlml8T-MsKQr2Dajxxc-te_kW9_OvLIZoEuXiw4LrUfgvb1bxuA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wjPdvkBBLFAOK8cPrm2jcD9_TCR2dASbUzpVmEJwplA&oe=6A2FFA55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C411F71DyI8Q7kNvwHJYPqO&_nc_oc=AdrSVTPdSBTXMsDdh4Bc_drkxfnLp9z3lBrF51zk3GsuS471-5c6Ft6BAemHYDR2LjQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q7t5y0rI6R02Iwx71gZfRv6F9l2V2FVBdCYlCWO1Y3w&oe=6A3006E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
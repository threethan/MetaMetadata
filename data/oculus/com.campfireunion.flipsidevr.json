&_nc_oc=Ado7TCcCWLwDwCb9CiLfZziqjkaFvf7G1QWOfTGDtGlaKnY93falahljKVQ6b4mr29k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvYMNB1XmcDR0MBFfT0NGlkCPjmrkV0_cMl2iiSmlU1w&oe=6AB9333E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK7VRDHHVtUQ7kNvwHIdwqk&_nc_oc=Adqikrr1C00bged18vuM9VLHUB0-x-ZwyfNepZz059az0hKpNSzMPCma7CHvpeXaTmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ-FmCZeWaSmsZANnD-suM9g11bQ3LRGvrirGM3skGlQ&oe=6AB90BFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLH3xB3qxJMQ7kNvwEW6eFo&_nc_oc=AdrKNnNJvI2SL6-l-dez9WO4ss_ATy9R-GHo5IpfynOHZJoR4jIZJkt4AWWNbfy-RZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuwc19c0I2V-YHDQmxQzDTuYU17Qc8HO1-eWjcxA-itw&oe=6AB92A87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YCS_hIE95sQ7kNvwEmozkq&_nc_oc=AdoD6REHw3Edrsr6kqv2COmX-ukFA6k70jo8DrjgdJJgknuolLH0EgIGF4GgwJKF9qA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT5xZ54t9JNlAKPd7JvNRRa7vDzy2b7BZ-o63suKf1rA&oe=6AB91655"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2qzN5FFi-0Q7kNvwGtIh9j&_nc_oc=AdqpHeeohaLizhksiP0Ih-cOvgoVUkG3q2wBsfs4HhNPvyZuEadIR3_rZGP3KywaC_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3PumUZbr1O04BOPxNRXmBvlp00IzvaaNNFJ9jl_rXHA&oe=6AB922E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
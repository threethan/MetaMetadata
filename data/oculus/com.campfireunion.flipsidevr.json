&_nc_oc=AdrO2_bVbjhm5WGtMbvlYNOynObwTOTJP2c3HCWhJB6QnrshDDU6i15WNOr64NY186w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS-c2WM7ptOCpdBNFH_1FFnLhMLAyEXMkItu-h7WRqUA&oe=6ACE4B3E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N07YKW_T7x4Q7kNvwE3YEMM&_nc_oc=AdoOYpbzh4stC3QpzTKJQ_jpszMQcIhiK9aqP2dCoxXIQsFKCtdhORni2I3Bpzgf0d4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHBPxDAwZ3E3wmMG_mGJu4kwmDTN4cnCSlDdZ_5E3zFA&oe=6ACE5C3C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMiJk9RoHswQ7kNvwEVor6P&_nc_oc=Adopo20EE30S-1metBt7h3RT2VgC0RytzAIyBT2cFfOJJnx1Ds633sZPDTjOVoFlWaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNylEvzyyxl5_xBTU8Vjn5Dyko_uy892ETLvTHHcKlsxw&oe=6ACE4287"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Vw_2YFmXoQ7kNvwFlkFBZ&_nc_oc=Adqxiyrg-IBE07nOdSg2uRK8Z_qbD4aO-2V3nOwUlM51vncs48eRQwWinuUx5Tk9wjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjc0YhkfvkCki_gy1q0dYeM3FB3kdc_CzZQa9BBwA66g&oe=6ACE6695"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTmPgOXZ43wQ7kNvwGFWJJn&_nc_oc=AdpsAhLTR7asbnvbommybKecqBn0ifsQQtcc4wc-R9nlK5qYps5AatExuMOx2RrDIAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKV76f760shl_eSeHRWqnHurJ3CREVI48ZHsF3lZI9AQ&oe=6ACE3AE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
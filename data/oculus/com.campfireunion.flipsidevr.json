8NXktQfdAcz8vsWfGg&oe=69A6C2FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeBlbtViebQQ7kNvwF3uFUC&_nc_oc=AdlLXOluKhqvG16i0gggBOmmhozsrIcoXeVR3G918qDupj8uUpzFQLTjRaovq0vUEwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsz0Krgbc64aHaLyL7kK40tNdA3oDGyOxuKDiIMlKAOyA&oe=69A6D3FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ecw55Ds3AwgQ7kNvwFIHpj-&_nc_oc=AdmcjwaotMEKw1DfOMwwuoK-47iez1-DRuZjiRvfDWVKgaOP_5mYRg4NRsI1-XJbK7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftH_f0p_Fr0rADEkvIrqpJRTSfUnJTtwoIRstrW8DkAlA&oe=69A6BA47"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uh9FfFMYiuEQ7kNvwE1hzSK&_nc_oc=AdnYz9O-94gxB-myF1i4TWAQgVGjj8UXDV6tWSOfRUqwmp0Kg0ePqhZNHlb0g9aNURE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-79Dd_-eecmeZt6QdmavIPHVLdDbuDWSjYSyGe-KTBg&oe=69A6DE55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0qtSy6W6t8Q7kNvwF1pwe3&_nc_oc=AdlTK933l4MsEQuKu9KfkCwnxG92OE_3g2_LC4NClkx6qCrDEQiwECPkL8wRj3px7hM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvL37n9hnHogtDFl1cb9dFVJzVl5Kyx7U8tzFke6A25xQ&oe=69A6EAE4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_nam
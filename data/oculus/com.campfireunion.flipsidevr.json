&_nc_oc=AdoJUauXJu5d_HVcXqZbJ9ernslQ4eOu1IFhe5-HqDqPVKt42bgB5kM_la85eAHJsds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GkVBkNQMbWW3EOyQaeTyBuy0E5-HyOYm2Mxw8ob2z3Q&oe=6A01F2BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErRDsggEUI4Q7kNvwHsJlg_&_nc_oc=AdoZ40wzblJjMq_zjTNF35SZxbxselEDejuYLzAZ4S-ca3yPDcBC1MscQzpztf1EAmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EofiN61jM5I5POMrc7udxB2UI4oBnPuM4mWwPubkS5Q&oe=6A01CB7C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2rLsuNMcbIQ7kNvwH_mbhs&_nc_oc=AdrICau8LYMetca3T3ToKHzHGyKiYJDY7g9Qck3XnNGzC0voP1-yg8JvHH6lSgywcwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zup8yGFmAG3J4PmaWgLGHh1AggpFWaI2YVI8qH_sHVQ&oe=6A01EA07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ai8rNvK_18Q7kNvwET6ZD1&_nc_oc=AdoneEu75rrqCdlq635rxzgbZnOhj1lQ-EhhdS9T0rz54Syq-0yfsbHlBX03z9pWFew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JlfPIVvjSfHBFJcdp4xucIHOP3uHvmie3Pba2NJXlRQ&oe=6A01D5D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOv7VCgp57kQ7kNvwG5RzcT&_nc_oc=AdrCtdvA2vxPwMBIP1HwwHJiSJqEgY5Tncy3CoNWjzNV8imaYh_L32mmlA24DXi1m9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i8wOyIvC0GarSKgs5ORWMvGZks2g5M7NTow005GaC3A&oe=6A01E264"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
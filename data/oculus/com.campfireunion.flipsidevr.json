rDkNzDAs-DcPlHRGLnaSJWJ22TI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqJz9Pz44Gb94YULhH6ifDD4ghw8rhb2Mb1wLjyFPZjw&oe=69B3F1FE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qODSwU5jIJQQ7kNvwFulLDl&_nc_oc=AdmDcDHoBUBKCa1NiOYoKNZYkpW85Z53GxXaKwA9Mlo4__A8YI63a7YB0nke3Zo-aFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwI66aXeA8w1AqPqZh_MPY-FzgUpEQAXmYvfO26an5h7g&oe=69B402FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s86wzTr3GEQ7kNvwEjuF5R&_nc_oc=Adlv0SlSXLyk6S-2Ve0w1dUVK9UNvU2PIcn8MHZ0-r46xYY3IFuBjZnlY7ZN87_WrB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3zwSqrIKfEYBldU9lXfjbjPMt0WoTZOIOnQ06ZOFnmA&oe=69B42187"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiAx_cIvglYQ7kNvwErcM3C&_nc_oc=Adl0mAfakw2FZ757DIZX6KIYpPkQtnTv0T0bR3Tf098JnB_d8jgapoAMRm8FVjnHckk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZAe1jDm54zQyldZiu1KSyxN7ITPGV5lChvlkc1qVKnQ&oe=69B40D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpKTLN9MjWsQ7kNvwFjchy9&_nc_oc=AdmjEZJDpefhDm4Cf_xOmGauwRHDeT8W97_ob-uZcnHv_geq_MlD5MSWfRedZQgECSg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx-vtz9R2d29DSF_WCbj8gitwh0wII5f01rdDV-GIDBUw&oe=69B419E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "
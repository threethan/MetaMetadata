npu5XeO2NcoOCr9dlQ&oe=699D887E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCgTLvohXrgQ7kNvwFuPcqg&_nc_oc=AdkTTR2lIASzi-5XdSudOySBJLw8gup0fEezd2TXJyh_mlVeIjkU5TVueQM2Lp4-MOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMkJj68J9vTnAKbrE2VY0ZpnTvqg83ZNTOaRutvy1Xug&oe=699D997C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeQ9JpE7hocQ7kNvwHG6Csw&_nc_oc=AdlXMvwIV2ZDDi6o-ti2VF_1wgo8UoYJeoBhWGkqhJTWUyX765i5xQLSBsEgYpptQfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBBJjT1PIGFtc6otzhd8RS4T3s20ZVxUW1U0yFav1Vwg&oe=699DB807"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqGAxXD4zKwQ7kNvwFgMzOV&_nc_oc=Adk1DtdwBRIv5JpXsGwp-_xEKeBJ7eujOSadr2EE3WY5hCgqh9qGXNSZg2AYB_Tm_Ak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1tEVDroUUId47xhyAXPo44-jPM1WcsgJsP_EFIiPQ6w&oe=699DA3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKZ3an_pis0Q7kNvwGjQrE7&_nc_oc=AdkSPgf8hF9yu_8Jr52qc4N5PnAP8rrDhWUJFP-0EY04_hcz15Ml7geZk2hKutRuKBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCyhAasSMJuaEYtFteCK5ux1349QzFHZhiHhKaleo-GQ&oe=699DB064"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_nam
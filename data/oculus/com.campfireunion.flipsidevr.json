&_nc_oc=Adq4rkKhVhiEzLpQyHgddFEYu0EKG45TdEesIuntKdy8Az9C9-icltfLO2GjEttsnYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjmNwSAqEHxEwykknPxIHWLXRJ6K1v0lBsGQz62CVeqA&oe=6ABFCABE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyehS-qwdMQQ7kNvwEUL5bZ&_nc_oc=AdompjyuFPatMeQ28kiEyzazjTniFj_AzL2JfXf3-nPqQWuN6g7fMgGBEABy8dhiRts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPseqYN7MEdnFxb3DVcA54qA1gLl1OhwXcwwTtEZ7ltYQ&oe=6ABFDBBC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW6U-secnCoQ7kNvwFEijAD&_nc_oc=AdqxRC6GZv-ZgxRaUtKB-mB0aNLaKgV2Y3jW2e8V2yEmm0X5BwMoyJ916kpldys_58Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM95QP0Vz-5uQ67PziA3Th-MnFSSy7sO9XzinoG2yfD-g&oe=6ABFC207"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3Om2Re66fEQ7kNvwHKcdQr&_nc_oc=AdqTty4DE5QTSn_vKBL3Sanb43zY3iDXd9vMEoKA6U2QBatfxFSDhWZAJem4WjvdQG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJd-hu5lmHsyR0PjrAB6aPKxSzX_nzE_YUGSrbKSZwPA&oe=6ABFADD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v191G7o1Y6oQ7kNvwFjnkfJ&_nc_oc=Adpn2AwbRQHQrjRZ82jRDkTKzXsxhbVjNlYrJlym5it9fY1HFUT9lnRh_-WPJqytBq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMESS2Vc0ah5E8F6VfGMlTwI7t4RlFZxVTg6ZqdGBctiA&oe=6ABFBA64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
&_nc_oc=AdrSQNehbcv_QJW4QSJmT0XW1NGK4Vvrnhe0r1crWl8QojmmOf8uMRUOqsekI6eJRvI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65ulGBI8YeSHixBxR6JKVfvM9RYTGh3mt2DNfSvo7rsg&oe=6A13163E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwvSgCqDYn8Q7kNvwHavspX&_nc_oc=Ado59gnMRbvxEI_aNwwQluXCoiyHhR2-bjuGTH33Nha6AZSBlFKq85DzdD38rgOdwFY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vaJ5U_AIzhWOpfM1Cq8UaxclpID_yQGSxpvm0dDBuqA&oe=6A12EEFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbMnlvaSizAQ7kNvwGcjZHf&_nc_oc=AdrDTlc0HZsnlzbRHditpHb3xEES_WF4u7ovM4pO8gzqhcWW3mOFk93GQH8ys_QCCos&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5doFRUNjzodjv5n-gCAf8vMTWssZDVMDUKz_k7KvCJdA&oe=6A130D87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH93FOtZVakQ7kNvwGcMMtS&_nc_oc=AdqaftFQ4Jhqz7nm5J-pwRXAblYQQrmJpxzCosYZjfsdkRpo3MGUsKRYt4A30J72_cU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71oD-u0eiJLhC1t1ryhcz1GD5IjlTi28adpDJs284Cyg&oe=6A12F955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCdRWu8WRjsQ7kNvwHMCbeD&_nc_oc=AdrDhLPOyFWBFheDinM0V_WtTravL2VqDkCH6JaCkwFNrgloslOKAKJq_cGd7y58zE8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bntFGQUXq7BFUfUMfRGN3IhYEpEAtWKcULuWgPO7jMw&oe=6A1305E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
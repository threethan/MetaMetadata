-78trjmZRu2ErmMFyw&oe=69A41FFE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48sjERwvLJsQ7kNvwHZCAw7&_nc_oc=AdlzHIzTWgY7xvXiU7OoLQ3tCFbJ2QiI3-Mo94o3Fa22RPETNi8QbP6g64JDKWzc3BI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvn--1Mei7S7fw7EFBImI8gyr_Pg47q4kqWujfhrhRUDA&oe=69A430FC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ecw55Ds3AwgQ7kNvwGXKU3u&_nc_oc=Adlm5zqa1izAF2S67x1OJTRpOc8Uavgf4MftmxRbBgm9avT1F9sLiFYubJ4zYwh4Z6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu1p8dSDh5dE3XQ3Qb1o05HQne_MK1N69FXaDahdbhKnA&oe=69A44F87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uh9FfFMYiuEQ7kNvwGftJFf&_nc_oc=AdnknWOZlOJypjfe8FURaw_HTOtRSNvEoNg6qvAR4WBs3HIYVb64ueFw_bnRDxTh8Vk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsbtd8DxwYHMlrrNOg1vVURwpcdMZfptyjJACxHFIwNNA&oe=69A43B55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f69rb6MEEoQ7kNvwEMFwz_&_nc_oc=Adkxu6J4zbEt4MCsSJxOWWVLCdUSzunFZxwki5z883xKdNdgSyEw-9ElkUCGthaordQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuqyv48MRdXwNdX7Kjage75pmBAlag5TwIWsCzaZsAVhA&oe=69A447E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\nDownload Flipside today!"}]}, "developer_name": "Flipside XR", "developer_privacy_policy_url": "https://www.flipsidexr.com/privacy", "developer_terms_of_service_url": "https://www.flipsidexr.com/terms", "publisher_nam
&_nc_oc=Adq588YwnnngPcE8t2COXsMtd3dcgA8ALRJPr5BSDJg4DHNVZ6zpmVuMRwAn3YUjZHM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JQMKCAQQSdyS-VX2INznLhxR_nySwXKCjvuz4kV566g&oe=6A3AA33E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjqbhS9j8DgQ7kNvwFuPBAf&_nc_oc=AdoS7-o9T-AUf3SZSgCo6jnD4_TKj9V7V848ijSRzicSC8iKljyAwsMrRiT7JTqz2HM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-LXreRnOiegI5qYVn2fcnk5mmKh0hvOqlAVdm1Wgh6w&oe=6A3AB43C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgGmDdQ-oIEQ7kNvwFphsBz&_nc_oc=AdrltxquWHBLluZUnFoDewVAwfDf4H-3Q4jKsqJFi7Ic-CEMQj25TyH16-py8DayyVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PHBcMVuHf9lmoy0JDKmamZoUiiIc8Ek6wBhF8uoupKA&oe=6A3A9A87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C3JhJTUu6UQ7kNvwFmxngO&_nc_oc=Adrn-lVn2KLWByH8dqY1Swmw0xXHQENRdLKAogbtzivlqEFDBaval48X339CcMrji6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8abzjO_RXMubXWpSoO97ZUKHXZ_op5RAFWEAilzPhktA&oe=6A3A8655"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb1hUvZuCvYQ7kNvwFiawv1&_nc_oc=Adp1hQq6Mza__yJSdPauDVOXt_1n-nODNa4HMqwMK_aEvcbJMhgnmU07NKN1adrgc5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CAxuLbzKK6qwp0jiPOSonIIs6lqGlNNG6EInc_V9dBQ&oe=6A3A92E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
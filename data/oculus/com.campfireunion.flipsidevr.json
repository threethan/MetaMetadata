&_nc_oc=AdovV17SiE5r515ziwpm-t4t1H3zPSqDrP7zBPPVUNSW8vrTmSoP4z0yt5PSZDY0ILw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UykaCGJCsp0NbaezxBB8rltidVhUD_lkzdfBTkP1vCg&oe=6A2D743E"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2JGE8vtEXsQ7kNvwFevkb2&_nc_oc=Adqct66oiW8BLNTg3OmlMC5mR-dBRYKSWhdrSMG4A5WFVThQ5pFxa0XnC6Mgrvqkhxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GJcfkF83R7q41o4HTGVqaWwy5S_AlQmBlyaBOoTCTAQ&oe=6A2D4CFC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRQAeND5WC0Q7kNvwEspOdR&_nc_oc=Adrd9fpgHlCtTMgVxS11s4hKZfzJvESn9a__Hjj1ux-SAiKmBk4n58gb-x4MRB03vrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_51i0KQ0-m-3hr8EwoSb_R4NgCih-yXnskWZcfflqMxg&oe=6A2D6B87"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiM4GIAv0OIQ7kNvwEissbr&_nc_oc=AdrusXvtKSGcd8rPqwo3w6kR5xCGpMWtuhCEg1Zzn8cVvpCDgeLw8Sml_4p_DNuiujU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dxYjlY0Fi0tI0zRnp1EV1kEbFAIYV-nBmusJXtjDUiQ&oe=6A2D5755"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae7kSUbY3KkQ7kNvwFBYzWj&_nc_oc=Adr91sU5SLqUrna0GrlbpOrI_vxOz8mlENcxynrW6q2GoO3emHZRjvU2Rb51LACibMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LUDbglwYsU1o2BHx8-bhpriEP4rd1bFyTTELEg29KiQ&oe=6A2D63E4"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
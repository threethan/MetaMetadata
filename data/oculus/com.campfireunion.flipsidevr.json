&_nc_oc=AdoN4Xmx5mFkqCAEc__Vczwr-Cx8d8j_Mb4RSBQmQpacuEqLDUu-Ox4YMt_yWz8rUOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMssbYxaET2xWjlB2yYdnY42sZX0yfWBxKNxyLI2i2PIg&oe=6ACA56BE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GFzk6_8JL4Q7kNvwFgw4i6&_nc_oc=AdoF_f6owMsdyZ1G0y67e5kndvjvVyVbuRJtw_bXExX-VFW_cf9dm33zk_TwPoOKHIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWy3Bg-1NqJ3wt6DzP4wtb2Njph7av8v94-8wOTV-NPg&oe=6ACA67BC"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYyeDfcK748Q7kNvwFPiFvr&_nc_oc=AdqBH2wQLop-DnHd-af9ypzc8CYGy0u4pYQq36GBYNEW65US-M-8tq1lENhSQOjy3oM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKjUIO7k42cogNiThQL_n3gW_5ohgZz7wUpCJdA61F-A&oe=6ACA4E07"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4znaREAJo2gQ7kNvwE0n41s&_nc_oc=AdpIwULbQuajV8hpyfKIJ3YCv9ND9aTgZZtyEYItdvgWl4a0UrCJ-5etn6wHVSS3_w8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe5fkoVbBr1J-QG8NIt3uldXrywMUFaZreZIa7ZLp3RQ&oe=6ACA7215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBYWb_cstGkQ7kNvwFcX7h-&_nc_oc=Adq5wsTIrZihT-kE-n9RdqR8gS4w0em7Ef_qva-sBDsVm9oZRWmWpHCduzWPBGLngo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMlU9ThljVEI88WVq1X2DqL5qjz_H1m22-WxB4ywHo3A&oe=6ACA4664"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
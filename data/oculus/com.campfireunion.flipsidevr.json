&_nc_oc=AdrhF0cqGadTKtdcgcfCZwWSQW4QiPEgCbb6HVYufH2TNYZLKQpAmUEJ9RlJH2O43l4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67EwJaaIE_mlKQorPd_GBJ15dk0rau2_b4T2YQyA7uxQ&oe=69FCACBE"}, {"file_name": "FS_Screenshot-3.png", "id": "1157916768541329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566684_1157916771874662_3154846063092592377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuWbyONSNGsQ7kNvwGO6xff&_nc_oc=Ado1ZR4m5OSjc6B8h1KQlO0V5J01LLuWDmh1QeYW8514wY6Lg_nILHiiYVSYLAkFpNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vyvWO7vJHcLDbD8_SHZtNryskV0pI42bSOVO_7v2UYA&oe=69FC857C"}, {"file_name": "Flipside-Meta_Screenshot-4.png", "id": "503354952327839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394163_503354955661172_3675385292904393650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgIgriNQBPIQ7kNvwETARkc&_nc_oc=AdrzKHyBynSKABtx_jImnrslRlINjGS2jKfCkIrtmdk3BKR0VPLHsax7-seDcUdw_ik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4orgtVBBvgt8_69BqtkLbYz6V2Gi1rwvdUP5X0z37PCw&oe=69FCA407"}, {"file_name": "FS_Screenshot-5.png", "id": "377927191539358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035465_377927194872691_2692247835418631299_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt0zhHHAx0gQ7kNvwHVCQo-&_nc_oc=AdoSGuwyEXthxQTdk4EE_GYRQCp6vCUpjho7IteYHZbXLSr2fOzUjk-_lZ3EGvqUKGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EDmfZwbTJMQl_Q_rpzpptquIH41NPvCGD64bSgwxaug&oe=69FC8FD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FS_Cover-Landscape.png", "id": "948055656716612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_948055660049945_3697445677810051434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bU3PQFDq7oQ7kNvwGhMj_K&_nc_oc=Adpd_zatSoXlCY6DWsOFHn_eHVZODS6ni09HpdzxHybJOkhBjs9SQM6w5j0hYozS4mc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-9lX7tw97BF2tstd1bymhpBi_29-sqJxD6nPw2jwZWw&oe=69FC9C64"}, "display_name": "Flipside", "keywords": ["animation", "mocap", "recording", "metaverse", "social"], "long_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.\n\n# Highlights:\n\n- Browse, watch, like, share and subscribe to other Flipside creators\n- Remix other creators' posts, where you can replace characters with yourself\n- Send direct messages to connect with your friends and share content\n- Record full 3D spatial recordings, including motion capture, voice, props, music and more\n- An ever-growing catalog of built-in characters, props and sets\n- Generate custom characters with built-in Ready Player Me integration\n- Generate teleprompter scripts and custom sets using AI tools\n- Show tools including cameras, camera switcher, teleprompters, slideshow, and more\n- Audio controller to add music and special effects, including a built-in audio library or import your own\n- Use our companion Flipside Broadcaster app for PC to capture 2D content for other social platforms\n- Use our Flipside Creator Tools plugin for Unity to import your own custom characters, props, and sets\n- And too many features to list them all\n\nDownload Flipside today!", "short_description": "Flipside is the metaverse social media platform for next-gen creators and their fans.\n\nWatch a steady stream of spatial content, which you can like, subscribe, share, and even remix. Connect with friends over multiplayer and watch together!\n\nNext-gen creators make spatial recordings using Flipside\u2019s built-in virtual TV studio, then share them to your channel and build a fanbase of subscribers.
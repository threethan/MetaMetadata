_thumbnail": {"file_name": "Landscape.png", "id": "1113381322507169", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974909_1113381329173835_4683781815905223101_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFSZL9HMp8MQ7kNvwHEZ5jz&_nc_oc=AdnqvQ9_h0V4r3Su6pBCYgxmLRsxOZa2Go9tmsG3UXktnAhjCBzidjJ0nSTQ_eE9rVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs0ORXCOKtkwxxRBOSDklBNF3UjbKjHDcokYg7Yg5fdKg&oe=699EFF23"}, "display_name": "Sep's Diner (DEMO)", "keywords": [], "long_description": "THIS IS A DEMO VERSION OF SEP'S DINER. FULL GAME INCLUDES 54 LEVELS, MORE RECIPES AND CO-OP MULTIPLAYER!\n\nWelcome to Sep's Diner, the new restaurant of which YOU are the Chef! Will it really become the best burger in town? It's up to you!\nLevel after level, your experience will increase as well as the number of your gourmet customers. They are in a hurry, so make it quick to satisfy them before they leave!\nImpatient, they won't let you make a mistake... Be precise to make the best possible profit!\n\nIncluding a brand new Dessert restaurant: Sep's Donut!\n\nGame Features :\n\u00b7 2 restaurants\n\u00b7 3 game modes included: Timed, Relaxed, Multiplayer\n\u00b7 27 levels included per restaurant\n\u00b7 Co-op multiplayer up to 4 players\n\u00b7 Intense and thrilling levels!\n\u00b7 Immersive audio ambiance\n\u00b7 Impatient customers with fun voices\n\u00b7 Beautiful scenery and colored lights\n\u00b7 More than 30 different combinations for burgers recipes!\n\u00b7 Pancakes, donuts, waffles, cupcakes, ice-creams and milkshakes in the Dessert caf\u00e9!", "short_description": "(DEMO VERSION) Welcome to Sep\u2019s Diner, the new burger restaurant of which YOU are the Chef! Will it really become the best burger in town? It\u2019s up to you now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://voxel.scale1portal.com/privacy-policy", "developer_terms_of_service_url": "https://voxel.scale1portal.com/terms-and-conditions", "publisher_name": "SCALE-1 PORTAL", "support_website_url": "https://voxel.scale1portal.com/sepsdiner/#contact", "website_url": "https://voxel.scale1portal.com/sepsdiner", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330463672326815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982555_496642988411098_1126936305476111606_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6ffJZDCotkQ7kNvwE2GiWK&_nc_oc=Adnf7fFNwdAz5hUT9O9YUatm-6f0qKvEv99tfOBu2pqTrQR7j9uFgAoYhAB3PWXvK-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftvLozC5FEHdfr6TmX0eeX57YjQKqb9o5SDareZu276og&oe=699EFE0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sep's Diner (DEMO)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1623696627, "lastRevision": {"nodes": [{"id": "456193162314934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3788022564630097", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "320976122685531"}, "iarc_email": null, "msrp": null, "tra
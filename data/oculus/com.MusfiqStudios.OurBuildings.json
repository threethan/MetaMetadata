&_nc_ohc=t4VmmDosDzUQ7kNvwHPKhU9&_nc_oc=AdqRv01pFbjkZ38MXcP0-eYD6KbvSRSQKFvsggq4To24iRTMCPPreQ9r2yvcju6LEt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZuJB1KbVdRTb7TvWMfuDHKme-6EgL6QKUf26ELINWpQ&oe=6AFC82B3"}, {"file_name": "SS 5.png", "id": "1243293590945540", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618297_1243293594278873_4055376442234721171_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USrRva08_4EQ7kNvwEYhVSH&_nc_oc=AdqVVzEcTaawJHeJyLRPhLkighawqxmgbZPt-ibbziRtkRFe6OahJRVm_VHFcCFEm-0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR16QrmR3hmw15Fxkn3KrsZExcMeSJDnWnR_Om3K78BVg&oe=6AFC680E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Our Buildings", "keywords": [], "long_description": "Our Buildings is a Virtual Reality platform designed to help users visualize and experience houses or buildings in a realistic and immersive way, even before they are physically built. Using Meta Quest 2, 3, and 3s, users can enter, walk through, and interact with buildings as if they were real.\n\nUsers can manually open doors by grabbing door handles, use physical keys or RFID cards, access automatic doors, and operate fully functional elevators that move users between floors realistically instead of simple teleportation.\n\nThe app also features an interactive furniture system, allowing users to spawn, move, and arrange interior objects such as tables, chairs, cabinets, and more. Our Buildings supports custom buildings for individuals or companies, with secure access through passwords or restricted entry.\n\nOur Buildings is ideal for property visualization, architectural presentations, building simulations, education, and professional use\u2014delivering a complete and immersive VR building experience.", "short_description": "Our Buildings is a VR application that helps visualize your dream building in an immersive way. Users can explore houses or buildings, open doors manually, use keys or RFID cards, operate elevators, and place furniture interactively. Ideal for building visualization, presentations, and simulations on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/da03482e-d5f4-4d1a-9720-6198e3759668", "developer_terms_of_service_url": null, "publisher_name": "Musfiq Studios", "support_website_url": null, "website_url": "https://ourbuildings.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32970253792589358"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1070718015179860"}]}, "baseline_offer": {"id": "1070718015179860"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767527220, "status": "PUBLISHED", "id": "1070718015179860"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39794658420148827", "version": "1.0.5"}, "id": "1846809355942082", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32879622504985821", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "397
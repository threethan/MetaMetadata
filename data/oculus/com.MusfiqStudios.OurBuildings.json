75087713_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9W8Zjsm0LIQ7kNvwGs7SK-&_nc_oc=AdoTDc5rsvoWB18w61bLksNL4Yen2p-GQcYcBvkuqTbAlehTawhh_70vctwTvk_24Go&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOMxHn9wC8BFtkxfEm_kAlEvTpD60Sbk3v7kfwDhKzbA&oe=6AFC698A"}, {"file_name": "SS5.png", "id": "2644382662686620", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823259_2644382666019953_438475806630170076_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxMZXRaIFYEQ7kNvwEgvnM5&_nc_oc=AdqPnndWXIbI4nwk9rtlA8lQqcpjDMGMAVCynVLR0EGfy3QAUNa8m1t_2ke-oe6falc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl5aqnl2ZtskaWpBVq3OH40IXIfM9BSNG-Vsh1ak1VLA&oe=6AFC61CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAMELAN RUSH (2560 x 1440 px).png", "id": "1527290899220260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1527290902553593_9009168621564908927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WPqizqGS7YQ7kNvwFNuk11&_nc_oc=AdqJxstAu7ZhgOS8u-l_m2AIyz-lkOAIhy-5G7baRbxX6Rz0Q0shIAarr7PocaU9NII&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdORqJA7iXrnaQ8Evh5Eh_oVK2pr2179TXBhccrmzSMw&oe=6AFC8ADC"}, "display_name": "Gamelan Rush", "keywords": [], "long_description": "GAMELAN RUSH is a multiplatform rhythm game designed to introduce and promote Indonesian gamelan culture through interactive digital experiences. Combining music, technology, and cultural exploration, the game offers an engaging way to experience the sounds and rhythms of traditional Indonesian gamelan music.\n\nGAMELAN RUSH is developed in two platform versions:\n1. Extended Reality (VR/MR): An immersive experience that allows players to interact directly with virtual gamelan instruments in an extended reality environment.\n2. Windows PC: A desktop version featuring keyboard controls and computer vision interaction.\n\nThis version, available on Meta Horizon Store, is specifically designed for VR and MR experiences.\n\nExperience Gamelan in Virtual Reality\n\nStep into an immersive environment and explore traditional Indonesian gamelan instruments. Strike virtual instruments, follow the beat, and experience how each instrument produces its own distinctive sound.\nThrough interactive gameplay, players can:\n1. Explore and interact with virtual gamelan instruments.\n2. Strike instruments and experience their unique musical sounds.\n3. Follow rhythms and develop a sense of timing and coordination.\n4. Discover the diversity of traditional Indonesian gamelan music.\n5. Experience Indonesian cultural heritage in an engaging digital environment.\n\nPlay, Learn, and Explore Indonesian Culture with Gamelan Rush!", "short_description": "GAMELAN RUSH is a multiplatform rhythm game designed to introduce and promote Indonesian gamelan culture through interactive digital experiences. The game is available in two versions: Extended Reality (VR/MR) and Windows PC. This version, available on Meta Horizon Store, is specifically designed for VR and MR experiences. Strike virtual gamelan instruments, follow the beat, and discover the unique sounds and rhythms of traditional Indonesian gamelan music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/7755c2dd-845d-4011-a459-4bf1666065bd", "developer_terms_of_service_url": null, "publisher_name": "Musfiq Studios", "support_website_url": null, "website_url": "https://gamelanrush.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOV
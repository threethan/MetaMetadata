/v/t64.5771-25/38984471_522596266282941_1951726101621154762_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZFkEqoI9_MQ7kNvwHN4Z7h&_nc_oc=Adp-SJfJZFKvp-ndXYZykPFlY59dzct5p4ouC_GFy9JjPIqUxjqLyQ94BDnRsjbM048&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Cf6gJteLXf1vLnAKkaer8xHzDtF2QQOnVjbRmBxDxA&oe=6B031ED3"}, "display_name": "RealTennis", "keywords": [], "long_description": "Welcome to the realistic tennis in the virtual world.\nJoin our realistic tennis with your friends in the virtual world.\nYou can play tennis on a variety of courts including grass, clay, and hard courts.\nPractice real-life tennis with your virtual opponent!\nDepending on the court and stadium, the feeling of enjoying tennis also feels different.\nAchieve the best trophy score with the points you get every time you win a match against your friends!\nYou can also play with friends on various platforms", "short_description": "You can freely enjoy tennis anywhere through VR.\nGet trophies based on the Winning Points you get for every win.\nPractice swing at the training ground, compete with bots, and raise your ranking score with pvp competitions with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraum.me/realtennis/Privacy%20Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Immersivecast", "support_website_url": null, "website_url": "https://vraum.me/realtennis", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_
EWY7xENgPA&oe=6B0C6C5D"}, {"file_name": "5_hole_out.png", "id": "2668017683700833", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623179_2668017687034166_3604389182331673396_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoFHHYU_7X4Q7kNvwHIaytB&_nc_oc=Ado1cIzykCIeen6GVD-7uIpmTv-dqpAS_JOkVUjLGl7-UY8CyvGcoBAGLl9JdDuIMcQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6s6NWPD7XXkIEEq4iCW-DeGoXGr0dcGsCYBdwnrb_xg&oe=6B0C6A4E"}, {"file_name": "1_tee_drive.png", "id": "1660192388809033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624583_1660192392142366_2035609047947002258_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3phhkWiXbIQ7kNvwGp232N&_nc_oc=Adq5qq-NQ0_09J_t07qI55nYUQx0kmL5cND6CDDZgqmKlq2uWbdV26FHMOaDOwif8kw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTiT5_2emwQI6g8fmLLCZl9l7M9OF4IzJe3n5FfIdOehA&oe=6B0C741C"}, {"file_name": "4_putt.png", "id": "1040858265672425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626808_1040858272339091_780931590985384525_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-Nw7CcuWT4Q7kNvwGb1Afa&_nc_oc=AdoRr2zoGn6M0I7m4jPtSGP-jXYOO-vP-atCYfIV4aNrnsHV52QjyLd9D6Bg_5gbFEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzGWg52TiSdlM57DZZC1zX5BecZRD9rsJK08f7KKEfdQ&oe=6B0C50DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Golf Simulator: Pro Tour", "keywords": ["Golf", "Simulator", "Sports", "Putting", "Swing"], "long_description": "Step onto the course in a realistic VR golf simulator where your real swing shapes every shot. Play 45 holes across five courses, sharpen your game at the driving range, master putting and chipping, and build your career against AI golfers\u2014all for one price.\n\n**REALISTIC GOLF PHYSICS**\nClub speed, swing path, face angle, attack angle and strike location all affect ball flight. Shape draws and fades, hit hooks and slices, and see thin or fat strikes play out. Spin, wind, bounce, roll, rough, bunkers and sloped greens make every shot matter. Ball flight is tuned against real tour launch-monitor averages.\n\n**A COMPLETE GOLF GAME**\n\u2022 5 courses, 45 holes and 9-hole rounds\n\u2022 Driving range with 50\u2013300 yard targets, swing replay and detailed launch-monitor data\n\u2022 Short-game practice for chips, pitches and putts\n\u2022 Golf challenges: Closest to the Pin, Long Drive, Target Zones, Putting Ladder and Up and Down\n\u2022 Up to 3 AI opponents across 4 skill levels\n\u2022 Golf career mode with 3 tours, 9 events, XP and club sets earned through play\n\n**MADE FOR VR**\nPlay standing or seated. Choose left- or right-handed play, snap or smooth turning, teleport movement and comfort settings.\n\nWhether you enjoy pro golf, golf tours, realistic golf games, golf simulator practice or golf challenges, discover a deeper single-player golf experience built around your swing.\n\n**ONE PURCHASE. NO ADS. NO IN-APP PURCHASES.**\nNo paid club unlocks, energy timers or loot boxes. Everything unlocks through play.", "short_description": "Play a realistic VR golf simulator with 45 holes across five courses, real swing physics, driving range, putting practice, AI rivals and career mode. One purchase, no ads or in-app purchases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
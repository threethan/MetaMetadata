uluscdn.com&_nc_ss=7f20f&oh=00_AQSrHRV8gVOXlTYQhQfBvxAEWORDtEGeLF51LV17qqaT3w&oe=6AFC650A"}, {"file_name": "SampleScene_1440p_29.09.2026_16-27-58.png", "id": "1809470240208551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1809470243541884_8089674114448903111_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e36Xg5IAkoQ7kNvwHUf0nI&_nc_oc=Ado4wsqYdHP-a5sK9E28jNCHU9-zGCmSg69iVi7y3TLlbkwVTIZRLL_KD0D8qe4TcL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9LyztlAM5NI0qVaReM6UIwi65qK04S6eE0rexTIT_Cw&oe=6AFC726B"}, {"file_name": "SampleScene_1440p_29.09.2026_16-28-30.png", "id": "3159694527573468", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596068480_3159694530906801_6028987456838822018_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMLNtGqeMo4Q7kNvwFuTkNk&_nc_oc=AdqXxiXTZVMYSdqwYyaSyrN45KSpKSHgBD3J7z4iiBZLRmKT1a0Om6AZ9oJ03fxcgms&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxHUQesDPcz_YDbK8Es4hdGu8CvWa53k7Y5B3Zd4Nfmw&oe=6AFC734E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Redux: The Lab", "keywords": [], "long_description": "Step into the dark.\nPrimal Redux is an atmospheric indie VR horror experience built to test your nerves. Explore chilling corridors, master the shadows with advanced lighting and bloom, and survive the dark using immersive local proximity voice chat.\n\nWhether you're braving the facility alone or communicating with friends in real-time spatial audio, every sound matters, and danger is always close behind.\n\nKey Features:\n\nImmersive Proximity Voice Chat: Talk, whisper, or scream\u2014spatial audio ensures the entity (and other players) hear everything you do.\n\nAtmospheric Horror: Explore a haunting, finely-tuned environment packed with moody lighting, refraction effects, and suspense.\n\nDynamic Community Hub: Experience an interactive start menu that highlights community supporters directly in-game.\n\nSeasonal Updates: Regular content drops, starting with our massive Halloween event bringing unique cosmetics and eerie new environmental touches.", "short_description": "Dive into the dark in Primal Redux, a terrifying VR indie horror experience featuring immersive proximity voice chat and chilling atmospheres."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primalreduxstudio.vercel.app/#legal", "developer_terms_of_service_url": null, "publisher_name": "Almond", "support_website_url": null, "website_url": "https://primalreduxstudio.vercel.app/#", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1292821687256173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_1118944333804615_5033684070608184033_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhrFNKgVOkYQ7kNvwEFoqJF&_nc_oc=Adr48vB9bH860AJKoQQRzUkGUEgByE7C1RtBPmUxs96aUR4uXgF-_MzPhucAdrSyQ0Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0ah59BzHbJ2O-_HRLjbUd8cNDiRqVnpMB30Kn2ziWnA&oe=6AFC83FA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Primal Redux: The Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260
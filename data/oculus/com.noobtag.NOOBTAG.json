8ZE4oKCyQgwKD250YG7ADbtg9DN9Nol-hAyiVvIGw&oe=69C13FC2"}, {"file_name": "PG3.png", "id": "1764157287664506", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031652_1764157290997839_2904149391920793820_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmubjqU2IxAQ7kNvwFEVRkC&_nc_oc=AdrFzyrOi8SgyplZLm2dE7M7itPx2YgHb9sE1tc4hp-V075ji6TuV-SEbp1vB_eq2ro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmOAxLWBBF-teu0p5RR5XST7G4f90RK2Lwe67-s048BA&oe=69C143AE"}, {"file_name": "PG3.png", "id": "582654657631310", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75476754_582654660964643_4434502572358229781_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXqunw2QRnUQ7kNvwHlmsff&_nc_oc=Adr-yGujPRdvLWTOINyGOkUC77hlrs9VDi_9lnImzTLP9fALRxVdEz7P6_ejH1V95vg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxgzCKaBlUZdsjdVFfsTTw7lK_09N-0s7pa2weoWAtnA&oe=69C139DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "522502563875293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974853_522502567208626_844379953235666878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHdqHqWq63oQ7kNvwGclnn_&_nc_oc=Adqkkn9UUCM7is8kEihLOtHvY2Ni9iDXNb5GmjoZ1onNNhvuDxutQ4D438Pea-jK5aI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfEiN2CltfUdppTtfsEfnz3MGCK0yazorp2Nno304q4A&oe=69C11FEF"}, "display_name": "Gost Tag", "keywords": [], "long_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.\n\nGost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.", "short_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches."}]}, "developer_name": "Laxyen", "developer_privacy_policy_url": "https://sites.google.com/view/noobswingers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Laxyendoh", "support_website_url": null, "website_url": "https://sites.google.com/view/noobswingers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8774363542650852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3
764157287664506", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031652_1764157290997839_2904149391920793820_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT-V7yVl0TYQ7kNvwFrhZIr&_nc_oc=Adn7qh8t6z2r120GJRCBbSty8knkUggS3qGs9dyUeYeCBXqh-sjpXQVe5IPiRGXpP6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsX9HrJLkAKmD8v_YCEtmGALaLT3n-P1hu-Cs8ehNwcAQ&oe=699DAB2E"}, {"file_name": "PG3.png", "id": "582654657631310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476754_582654660964643_4434502572358229781_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeWhlye04bsQ7kNvwFcK_SY&_nc_oc=AdkzuyeGA27ZE6vaKUivfSXr9SCwVgWLqd4pvngaWJwcRncaBZ1yuNBS7zEoI_43JB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuva2UIBcUowQBM6Ca18P8YRuP3BovPqtUq_I8vw82bHg&oe=699DA15D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "522502563875293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_522502567208626_844379953235666878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY_7LBegrloQ7kNvwGdSN-V&_nc_oc=Adnvp8PBZerivKPyez6V1GBXKDNrK1aYyp3yQAO9CTYYI1mUADOVQf9aCtXrHxQh0YE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvRuYOZHT6M3r0Q9ocautAG3Ewhi-HjQqp8GzF1HY8ykw&oe=699D876F"}, "display_name": "Gost Tag", "keywords": [], "long_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.\n\nGost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.", "short_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches."}]}, "developer_name": "Laxyen", "developer_privacy_policy_url": "https://sites.google.com/view/noobswingers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Laxyendoh", "support_website_url": null, "website_url": "https://sites.google.com/view/noobswingers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8774363542650852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569443_911591720829715_7551809538906105078_n.png?stp=dst-png_s360x360&_nc_cat=101&cc
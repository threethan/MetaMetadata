OOXpFRQ0YsoiaJD4bLOoXlBScFniuA408XhtpQTDg&oe=69B956C2"}, {"file_name": "PG3.png", "id": "1764157287664506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031652_1764157290997839_2904149391920793820_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywzcpA2dVf0Q7kNvwFTr22n&_nc_oc=AdmxivKNSF6xN8XmnfmPrjddE1BDCKFa405pKWSc1mw-i5GTvW-m-9wXyiy6MurKamw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysIw9R9ozeUEn5zdPN8Vq5d9w_e_5pBspVKqZTqEKU9Q&oe=69B95AAE"}, {"file_name": "PG3.png", "id": "582654657631310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476754_582654660964643_4434502572358229781_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG3-hW8BHBYQ7kNvwEla0OH&_nc_oc=AdlFjvs56tQNbW33J7j2Ty6lGB_TsG23TJElzonkPUGV6Jm_gEQjS91-4yGLoI2ojqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfTB0bpbnLPocSHqNqQUG0JczTHKojGJsX5yItGI86jw&oe=69B950DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "522502563875293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_522502567208626_844379953235666878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9bVvOCWjzkQ7kNvwFsRXYt&_nc_oc=AdluXVYL6YHJNKz9K9IqoLlgv4s8tAFm7iWGJNbgiEJz8CFb_n4PsQDnmSIO56vFH8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzfp7_crs3LmrWongUhCGcWZ931G8Lysb46sWnd5UK6aA&oe=69B936EF"}, "display_name": "Gost Tag", "keywords": [], "long_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.\n\nGost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.", "short_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches."}]}, "developer_name": "Laxyen", "developer_privacy_policy_url": "https://sites.google.com/view/noobswingers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Laxyendoh", "support_website_url": null, "website_url": "https://sites.google.com/view/noobswingers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8774363542650852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5
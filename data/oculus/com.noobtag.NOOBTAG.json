764157287664506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031652_1764157290997839_2904149391920793820_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-Pr7jyHj-kQ7kNvwGPjDSY&_nc_oc=AdnR7IJ8Po1Tgri4EZEqAp-LdejUuBsuuXUA18IEQP4fRLYqoDnPkOtKZpO6Nq4EuOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs5IRnByMth05CC2h1rdPWBaJguLxVnzpAKc94VK5K8Nw&oe=6998652E"}, {"file_name": "PG3.png", "id": "582654657631310", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476754_582654660964643_4434502572358229781_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljzjRSVReScQ7kNvwH5oNym&_nc_oc=Adm7F9onOYXOUpoy61nRRtrDDS9w1Su7kaAAqeu9AarJkFUsTr6tVVsxuSY8bQPUk2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfshUAoqedvI2dqfYvuBkB9izeHszL0vzKOynY7dGrFHUA&oe=69985B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "522502563875293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_522502567208626_844379953235666878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftIQ89vltt0Q7kNvwGy_RCo&_nc_oc=Adkg2nuCGs9G63gb2vDk5UkaVscLhjXw_Ib5NltKogYWDf9rDwk0kdv9yXphS1IUJ7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvZRHt48F2HqlG9IhzJYyAILbpe0fdxg3amjOIAdkztsg&oe=6998416F"}, "display_name": "Gost Tag", "keywords": [], "long_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.\n\nGost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches.", "short_description": "Gost Tag is an exhilarating VR game inspired by the popular Gorilla Tag. Dive into a vibrant, open-world environment where you embody agile creatures, using your arms to swing, climb, and tag your friends in a thrilling game of tag. The unique hand-based locomotion system offers an immersive experience, allowing you to navigate the world with fluid, natural movements.\n\nIn Gost Tag, you can explore various game modes, from casual social hangouts to intense competitive matches."}]}, "developer_name": "Laxyen", "developer_privacy_policy_url": "https://sites.google.com/view/noobswingers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Laxyendoh", "support_website_url": null, "website_url": "https://sites.google.com/view/noobswingers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8774363542650852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569443_911591720829715_7551809538906105078_n.png?stp=dst-png_s360x360&_nc_cat=101&cc
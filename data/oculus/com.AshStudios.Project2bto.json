.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDmHg0HfccgSSxBMdj8m9Q1z_tPWzPEOZzj6xjlnsA6A&oe=6AEB5BED"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icRUkuO-mj8Q7kNvwGhcTWY&_nc_oc=AdrU34hLvTt7u9pL6-fyhmq11oJt_p7Q1MdC53is1i6PZy3ZqdsgneG2duQRbbWLaog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZAbBkXC1a3klJgSrGLTKnUF6ACXkNyBcO5sUPPa11ow&oe=6AEB2B32"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BInkgIx3R3sQ7kNvwGHsJ3z&_nc_oc=Adq2CKwYsC_cjKNNQQSl-MbaoG7DrJDLTlVrP_Vqkd947iqNvh69xFQ7jvZldAlcaow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfJxuZ1VastpV5MvzjOAOaohx76cOReRVO5I7iksrI4Q&oe=6AEB4054"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M9Hgtj84DEQ7kNvwF8U0zE&_nc_oc=Adqp1eblXwo32ZaikgJ-CqMCeMgwuBByNiX49zJrYgiWzBN0-H4IRby3t6rjFULdieE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyfayCDM4_Ph_HwokMTAzfLle1EOn00YCToY1r6Oqmzw&oe=6AEB5B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_txqacpov8cQ7kNvwE1aDy7&_nc_oc=Ado4zyW1qhv1C1ACmV7icbQQBWviVQL1p-4htII46ieFeJriKCUskG9-VTMTLnh9TJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhn7QwC-b8N75Ai2waYhVuAHcfstNSPw5KzL08eo0nLA&oe=6AEB4AB9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
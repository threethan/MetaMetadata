.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20KR1DdhQRSx9efmKt9TS1mrnjmsW1nXjZpo9Toiglsg&oe=69DE31AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYX0DyZDd1UQ7kNvwGHO8Bp&_nc_oc=AdrFD6s3Zxqy2QuHrc1cgtV15zMkQtdk2FTfX34muModcmDnPYEQqV-fOTPwkSx7O0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sCyyk_8rbzAYKgjYjnSF9Up6vD5ZZqrzE4KmreXCJOg&oe=69DE3932"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsZrAjaq41gQ7kNvwHSQzQi&_nc_oc=AdodKnUm2lD3C2Rxx9N24Zfk6jMLNicOojpaibsz4cWZBZhtFxLdAnjnceubfIJe_ZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wzhY89Ptq-u4CV9bJFhKwgFXzM4WzOId22Waqh3msjA&oe=69DE4E54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9p2DakrxtUQ7kNvwEAuKbl&_nc_oc=AdqsFIBDx-eh9i9CB8oVFeJ5PDJj-DRZUQu-4yfuAy1YSJWuewy5PPzmv6ZbvtzqIko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S3icFv9RAOR3RcPRnyk2npLzzMjLxR4hWrCR0AHwe2Q&oe=69DE30DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5DRBVwwu74Q7kNvwEXBOnQ&_nc_oc=AdpVjuddTbL0czMEB6Hswez3PaRun2iKPpYLbIcZ63tL5tEiiTya44CTj_TqUky0Zhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2stEiZnviYEWVwsCc92vylN4YrGk9pjeNC2ISlXT9upg&oe=69DE2079"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
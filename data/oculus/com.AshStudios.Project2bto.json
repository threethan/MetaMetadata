.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0L-rG6Mcru8TMJjICkXcdxJO_km9H1ICxYAWy-tgAcQg&oe=69F5ECAD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEQumazUIQ8Q7kNvwFYB1bq&_nc_oc=AdqwMuGNcksc_XCE7ER7QJNPwXSito_YioKGHsG1zkjTd9fNqU8o58ndBuUZksck4P0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zBXoybmlXpUEQHaNSWGYonquWGbEN38fYhk-a6JXMVw&oe=69F5F432"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aS_WSIdx94Q7kNvwFJT90K&_nc_oc=AdqOSrYz5o_VgOEV70d_ysYMZShCRDKZJ4aYof77jlS5E7VrYx_Au0DVLceRB-kHgqw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o-B4sKU9ls1Sf_HNarhqy0JQoNqpcbVOhrRnAvitWGg&oe=69F60954"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UWKc4w2_ngQ7kNvwEGtivf&_nc_oc=AdqT3lMv-1z3GUm2MGwfOZwY0vi67FCyW-aKVMcaaxFq0zGj9Ds2CKtSlEkuSGjZoZY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2j3szixr6bjO0vackictf4dr4eABdgIx2CDDAc7LWa-g&oe=69F5EBDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yTWEwVUej4Q7kNvwEf76Xi&_nc_oc=AdqIsBiInmWPe3WcV7A2NuIPpQ1ZjxStKqjWSGlZmCu8TdIGNRZp9xiDQucKyhyehyk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HQt8pdym-lIwRXpMPtfqkcLqEOAARA2zosCXQc5FP_w&oe=69F613B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzmaXgYQmIsjcuOPg0MJaxvn_Mz0mpBSB_Mrqt8M8zRQ&oe=6AAD2D2D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPoYh0mYxFwQ7kNvwHSRqRS&_nc_oc=AdqzJ-p4A_zYk45ni982Pp-Bh9_oVDy0roLEC6zMxLcv0d20ZyUvqxoXQ9BLblZv69k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuqXTrJgKIC-tJsTVZnF0l8BKma947QurpMJvIB1gY_Q&oe=6AAD34B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oJ6J31OohMQ7kNvwGzNYsw&_nc_oc=AdoTB-cec6Jf3ah8QaHQPm-R_EEhH3XqPVU3zn930pvBcLdnEo1bS2k4Lzcy8PTIrNY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4c93cEoK2xez_gH53HPLQ-Mv2QRTlJzB0r41oH1knbg&oe=6AAD49D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15pCkhFV960Q7kNvwFq6Oqe&_nc_oc=AdoTmMA1AJebKhtgN4lsMS5gt94-VEXStZsSLsa1nAndZBMbUTBrpCW-BZ6AJWfgIbk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAXb6cM2pJErWUltXO-76ta7mOaXw6BBJY-isWmqeyUQ&oe=6AAD2C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBlWFYSzvlIQ7kNvwGfg7K4&_nc_oc=AdqWola_pnr0Eh23hUQX3DC8xcDzazCI1ZxW2ekJ_2ZyO3U1YkB4X5zqHCDV8piFTQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX4Fuv2dbkIbbwVQf1cMJMbyWbYdlQIGN9A9TFMZTvLQ&oe=6AAD5439"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
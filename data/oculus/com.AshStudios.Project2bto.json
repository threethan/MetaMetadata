.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLGpodKQx00hUATtNh3NlXOjGCIj--v_kZvOUUzrRHCw&oe=6ADCA32D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etUGf1w53hAQ7kNvwFHVccT&_nc_oc=AdqcIMHYFfdEiVtYAmK02tzz9dbneeysl8GEaoP8eeJ_pwhNJgJtr_8H6cLh9xNDDDA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX6StEQkiv5ksZ8B4wPVI02oSr0XLsIkiPpo5864-i6A&oe=6ADCAAB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dyRaq5NnAwQ7kNvwGQXY9-&_nc_oc=Ado_PRzKiKbzdgQL2pMsKs_E84tL1aUPUrUJhHn7h0x0QTx2GB42bRY0AJNZn7KjP34&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPneJammkxSvnnvJNch6EoTyc0XWI_mFHTQN4hkuUC35Q&oe=6ADCBFD4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjthugVh9GoQ7kNvwHnQ-XS&_nc_oc=AdoKNAT9La55rxFfjMLCVIGMwpsK0u_5gtf-v9N0I_1THwmfpOUM72bYrf2jCWpEaJA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHAYIcD0X2xWAq2kQUCyNuXYiHv9rDk98QfpDuMJ49Ng&oe=6ADCA25B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xD4qAbdklXcQ7kNvwEUHHeT&_nc_oc=AdpSCjkO6E57HtFh2FSfVxkNm8N37lz71kkgMs821EFbXiqXzRU_usRch9ZmuOJwzBk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTm1YA1F9eFJUXGiR0agV_sNpxLUwnXJLkjGeprUB7Lg&oe=6ADCCA39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
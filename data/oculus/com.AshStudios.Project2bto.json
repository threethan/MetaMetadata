.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o5JnohViawiBwLs_gJfupygaDPkb7yOqsq-LN9D0oGw&oe=6A3AB2ED"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17-8Pv1lPBEQ7kNvwEywZzn&_nc_oc=AdrUPgooOUIRxYQ2KAwkQGOfjGgpYhPIqVlGNTa7IB7xBcjerAgErmvnVDzyXPemAMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wPboqTmtdzoOmZqDmUumPjFqevfoNHI5-mN-HLpJF5g&oe=6A3ABA72"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KfAolzFmK0Q7kNvwGtWh3j&_nc_oc=AdrdDFZohUvbRjp7pKZCjrghrwBvrrvBAMxcEvQCQ3qObPwz1h9-nwtlfZQQ2zKd7NI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B4fsyHim9RIblIC_TVRXJcuSv3dkQEGAxfeyoE6fhxw&oe=6A3A9754"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwKaDiZ7vqIQ7kNvwH6p1Zq&_nc_oc=AdqP6cVGsZtxNRzFvtB42k_1R7FnsBY2TSuPPeL4XeXFvzJh3dOIOxS1hq5-06cPQW0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af918czAVEf1xm7Aq6Pr7L3E4fntP7nh8s78FQwlcCtnZw&oe=6A3AB21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0XwZ4WbeCQQ7kNvwHzQ-82&_nc_oc=Adq81gn2X-7lZFFPNu-mizjysvfRQ_ekCtL22uatwf1VVBVZ5m9elX4xmcPOZsbbrQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0OAReIaNEgeBmYqDlMnZ3eWmqlU9SgCNvpCkThOrcNQ&oe=6A3AA1B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
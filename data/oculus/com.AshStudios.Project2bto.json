.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZReVABBtz_sxBbNYr2Vdy86ET4T-wY3EGt87Vo9t8Tw&oe=6A69F0AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SB8-nG-AJgQ7kNvwHJzePH&_nc_oc=AdqwH4ypKoQHJi-yQTn1B41EJ0XftRKVvcB6WwBzBWXT5xtfV5vzRVMDWQlptMpHTxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvzdco8_MJp0RyoIETCT_Jb5cjavzTxN4rjS0ggr1BMQ&oe=6A69F832"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0-bHbNfvysQ7kNvwGzKNfH&_nc_oc=AdrdGSy0pdHGCRPQ3trM7PrrQl3IawaSFcT8A_UoC0V6gw1zlMXr99mmOdD4TLXzOTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Xi6dYZBsFS3E5g-fmexdeFObt7TxHPCI7sZ0cpV8Ng&oe=6A6A0D54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95s9EY5puTAQ7kNvwGPotI7&_nc_oc=AdofprI-JP1LHl9JFEsjHSHT0G6Cf98MoslPyGowmhYDZAzWrofljxgRb3xEw_7S410&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXRPvHxezsXtCnniPYpOPLLnKwhDlCTbST0jYq5_se0w&oe=6A69EFDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIB4PjZv-ZgQ7kNvwGoGM-G&_nc_oc=Ado5dxXjroi1fkg3pTSs8FY-zNFdaoHZvO0QgN2oIpr7Y7YV30mGiz0sAS_ElWJafQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB60hnuHuIi4Swv1utNe_HZGfrJpSVujRDnpSpAO70e-g&oe=6A69DF79"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv2gKSj-IvFiN92E2QqGQnvdf9FSyIw5Gh-nhMhllsVw&oe=6ABD376D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLXVUq2tpykQ7kNvwFL6Dzh&_nc_oc=Ado0ggi2oSEwT6cBzF6uWQeIyd-YaVtCrFnhH2SNFfJ3KhO4LECc-LC3j6uXDPoLIWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH2tEOkP1I-g_UdFKgMowa1cPRJ117y--1D_rZBCpmVw&oe=6ABD06B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZgbiwwWiCgQ7kNvwHFidYv&_nc_oc=AdpOQpTyalH_-AevLLioxqIsWRo9Mpl2ULMp4cIdF-XcTkE1-YYREfW08KFWBWa_EEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBxX96AdArl9gm0n-SKOZrhf3dG6VKSEUabrHn-c0dqQ&oe=6ABD1BD4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QSse-qcc6YQ7kNvwE4pnyl&_nc_oc=AdrwnnIT-MO-kOJqpTla19Enxfc6Zq4ApDxv9a96NeF3OR9c5fvu8BCtg8bu6B578yU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8C2MCtp8rt8ZRuDPZ9Q8Y-8m2v7oWft-eNbeI2Ym3Yw&oe=6ABD369B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqKJNHbRF6MQ7kNvwGMTPbW&_nc_oc=AdpPuxscdj6i8pDURe93Fw3c3cimPXNOnsis-hvkHWqInGkvjCdrUuLfqaJCjU-aiok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWBN91cU47FICzqkiaqlSdG6Xi4NC_Jy_jmWL1kEpZDA&oe=6ABD2639"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
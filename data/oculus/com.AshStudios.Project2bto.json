.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ky_zjFqL_5h-FMUMo1uW3cWRN1GFqte1u1WWFMp-gFA&oe=69FB32AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9ZbW2Fp6LAQ7kNvwHkswAc&_nc_oc=Adq0nLahyTNxOmzI6pK30ZDCPpWlSLE4MwuuCnVsjrSl5jeq1gwAxrqCqwn1sI2vgro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mn_UcXCfZc2oGOk9brR7W0l2lzxJhsNVvvqq0BP1zmg&oe=69FB3A32"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51RDHBlFokQQ7kNvwHQOE8g&_nc_oc=Adr7ywuanvZfwgibZQwQ1_Uxp09DX8iOACcT5iOfxYXCRTAaXzFXHpNXB4SQGwa8QuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dEOsCr7-aP-ZEBBQoAqHazfZUUQ__WMafQN8Bct4egA&oe=69FB4F54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LhTJtlRO70Q7kNvwG8_r1W&_nc_oc=Adqn2tbt3wAN80Q5tJEK2agLDP01A7BjS2omF9xOpehWEaAYPDRB-8KCqjU4mFqdSVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NC-BGX1WJDXG35lRicglHuCF0LhtumtxHLbwVyoY3EA&oe=69FB31DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WenbjMmQRUQQ7kNvwHRF7-4&_nc_oc=AdokEL_eRh9pIiVcJI_E86TUj04gTrSin36mSCAZXDAeGd-TaJV8jil_Dr34zetbwyc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rupILQcdYiN9FJXhV-E8xh2ZwXfSHSQJfXIi_5LiV2A&oe=69FB59B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
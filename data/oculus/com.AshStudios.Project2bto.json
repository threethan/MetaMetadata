.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS87-jiDyHHJNtJO0dN8dRdseQhEArJgzDF4cKNv9-bPg&oe=6AF344ED"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLoEdubl73oQ7kNvwHg99fP&_nc_oc=AdpffC1p-4-eMeii82PwpnZSf1ImfahtSPFsFaTOyv2rfCw8tWo46HsqPIdlV4J5W4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQejsyO9561bBoQ611NMoKDTsyW0wz3KbqlXrYnpsPRnQ&oe=6AF34C72"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpX9afXXf7AQ7kNvwGMcHKQ&_nc_oc=AdoR14BrO6biY2PYIfgtFhAKtbyGgRtaZRzJg7srxxsKx39XVwvBj5Q3yD2ADGSEQF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQakhOj-GVcPmEOPJqvFgZlsSi6fyqWi-4omp8B2S4ZOg&oe=6AF32954"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB6opUHWDAcQ7kNvwEJLQsn&_nc_oc=AdpmjD_XYKQW9sNExYpJBCc0P78WQQQe38WkxULiKtjroNv11a5RUYJ_aGHO3S6eWOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS08wLMAN3-YpJMGLveRHFp8BZ0o09ZnI3sWyvefnuKow&oe=6AF3441B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAQJfxS1jj4Q7kNvwG8L3s9&_nc_oc=Adq5pzBdDAM8OymitUvlUYWgjgw619jx5e833kDHBGL0ibBMBop2vAQdLY6fSX9I5qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbizO1aXli8Jjfqw74IX9C19dSrRe2xPBjUbZsFwk9Xw&oe=6AF333B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
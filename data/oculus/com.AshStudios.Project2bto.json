.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXYmKI3dDYiwIa69bugPH9_4uYbzRKavZz1DOOrzKwjQ&oe=69CBBCAD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vlkUlX6kZsQ7kNvwFX3lSy&_nc_oc=AdrUsUb0J66F4Niqoa2JL4K7pspnqx_B4C0j23gamBPVbm4BrFK9F7WfYPB53EobLKg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2p9yWCDkeH9khHjdaVpAzsiQ_pZBxN6aA62WvVusAHw&oe=69CBC432"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1qSI_cIuPMQ7kNvwFicPT7&_nc_oc=Adqc4OD_vaYrFuBGqZkV5Rq3e4N8oS-REO82VNKiRfWPOOU7pKvE7KxKmHnYq3UtO8g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8XhY-L6SyoQT4WO6H5QWoNxPASjiUeKngN4LGirwm1w&oe=69CBD954"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-CbKZ4NqwMQ7kNvwFTQE0p&_nc_oc=Adpfno6yxt9WIyhkhwC5HQB2WJuhaTA83E3nsQNdXAcsvMSXZuTtRe70d8TnlJycS-4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyztU2rDxWQicWQHJJ8Iku2fgM4WQ0iABCq4h60GkmdQg&oe=69CBBBDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNN2LWUtyfoQ7kNvwEqs3iq&_nc_oc=AdoK1Xbv77Webc5-f2VzeL-Bbvu2T1IudZAvCp2Or2_RMyrafOG0C5RweYr-j_eJJ-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8LqotjoTUlJwcjHZkkyOFozb8jslkfQPCpG9cm9hhVA&oe=69CBAB79"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
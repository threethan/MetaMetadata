.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSAf-kROj0mGEqppWHJBxlKRILdzC7Rs7-aFE9TccRAw&oe=6A50E42D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlZmzTq0ShoQ7kNvwFpgSSh&_nc_oc=AdqcUlwPlhKrqh0hIjDqIMLFDEQJGO_gpz9iaAhTBmJ6Iqw11npNjwfhONqWmDtxJ4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJgA8xRfwE5ZJDc0XNUnfTDW34hu2lrq3mU2CJjnNo5Q&oe=6A50EBB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_4yTRvaFfkQ7kNvwFkrdiy&_nc_oc=AdrCaYdhBOP8JDk-Vh4poVkoZhRfwgRecZ9l4AXwM2cf9mJteXv_N7MmEMsX2GKFdHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT98D4f7RJlugIGBFYDZ8JK0n5PBKoMnhsUN7upCfISg&oe=6A5100D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8ZVACep-IQQ7kNvwGIbDHe&_nc_oc=Adr8Qb9Uk_xhN1KpKGphYYVwNdBvFSzQDYyrHESC_hfydug7KrNFFbHJmaAnwbPrbpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJJAQsFn4Co3_S7U3q7ugztCN7NYpLKTw6koEPkrkcRg&oe=6A50E35B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpBL4neO5WwQ7kNvwES0CMh&_nc_oc=AdoMVwtQNUqmACNTeE7a9wQgy8ZYFfofkUnH9aFasrwfvZ29_QBocJ10_gTdKKhL4Cg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiW4HOGzbzRu3mbYN6Kar7aE3GzQlkLpNNkIHHLC5W9w&oe=6A510B39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
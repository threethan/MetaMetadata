.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_6olbIMfl_iFLGiM_U-Y3A3itc5SDgqCiT1a0wiHD4w&oe=69E0D4AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXBuY-eUH40Q7kNvwEhqZ0c&_nc_oc=AdqfQt9dk_GTANqqRD5tAb-GSvE2p1wR8Mmmx16n2lTPVv3qvPIIrhURHEGy_7xFq8U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U4EWTscq0SjdwQ6REWxC9x-88G4ikLGNt6ApgevJF3w&oe=69E0DC32"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsZrAjaq41gQ7kNvwFHcyqq&_nc_oc=AdrLjjBAnwcNNezSVQ5SEC8JFpm41huulIhIha2lhwIDYNbbWhvUQPvvBk3KLyUQaZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w8lNmbV7M8r1kF7AffjgtocQkxJgURHU-f7KBYqy3oQ&oe=69E0F154"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Gf0QUZvjzUQ7kNvwF2KCDL&_nc_oc=Adri6TNYaE_StGzCwF4DHiMFKYs56ih41f6cuC3LPHYOuwysTMK7HDltAevIy-76Sb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CqKKZRHRcEdnG3VVhHGZEHt2dP5zqnVeiVyax9T_oHg&oe=69E0D3DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5DRBVwwu74Q7kNvwGfZaVl&_nc_oc=Adp6jMvB2zo_I2eUP7KUHfCsDIuoqA03yiuUlVQm9XCTT6Eb1_1SDMNeJUv93suiREM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tce4lcrApnBX0WWc6vEKrOYvgLu1VD5cCNljCHD2QEg&oe=69E0FBB9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7goxEDDS0qJOaouuGd4Tihf0uAYUuMNtbuOMJMwxp8w&oe=6AE8B8ED"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK2o2fHD47YQ7kNvwHPfjOh&_nc_oc=AdqZIcVJeQcyaNkIozFAucLLn567u22t97F_o-uTaMD0bdD1_RdzUWLNwpZ5gY5brkM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlV42zPTiZwRvKXrNh2bNm0QwEx9n8zN4C2xuOm3YI6Q&oe=6AE8C072"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaXLunQ0r9AQ7kNvwFA0K3S&_nc_oc=AdprXKJampVVY3OiL2-2ArVZpsZ7QHWU8j9QTfxDLU95SnO496ZAktfs80571cXIiL8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7zVSew7ddqdbw4nAkc9v_zByHPGW0xdnaapEuuHngmQ&oe=6AE89D54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2AbK9c2VX4Q7kNvwEozFyk&_nc_oc=AdrcWDSSXLuzDB5onwHLOgXLBuhoEvC9XVfKto7SL6xj41i17Dj6eGG_CwhjwBwlxnU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCVrfvQtsqLfo59H5eqfjZ5EkQ8RJ1RM4DvgULSY9_nw&oe=6AE8B81B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIzNrNOsn-EQ7kNvwGJ7XXD&_nc_oc=AdouHnw0tcT117GKoIOfQSf2tkaeBOo5BWEIC47U6S-zuP38uM5brdensJyPxjrqhdc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPCiKXQfyw2pg3nHghKZRPuxfzwqb9RczcNd-qoAL6yg&oe=6AE8A7B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
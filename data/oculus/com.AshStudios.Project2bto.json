.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ17qfo7u1TpajbyRiq8qWO5zIeWq3lSTqGQ3ijmDMNQ&oe=69C676AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-zqmFk86XYQ7kNvwG1idLJ&_nc_oc=AdpWwqWlUpf9ja9AhED4QXQABchR_PC6tRcRoZOI_GzSrY-t-HBUWRYWNF5rw-Rm3EM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHtgvx_D3orgHyMbqzosOQHbd0a9KHD1g74ds5R-AclQ&oe=69C67E32"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCru96t_884Q7kNvwERtx8A&_nc_oc=AdroJJZgMOX7ytgC_wM6oeDrg8AVV4B-Hnt9cbwN_CIAx-1qJqmLInDAEhUPUyp-IB4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdRE4N3FyzjehDFPWa7FWxqpXm7gMum7UkcXKxbldmTQ&oe=69C69354"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73dCGgR05JgQ7kNvwHIiqBf&_nc_oc=AdpsqGm7aICwN2KA6Bg0gdB5IAGg7Uev-clVB4zlH39kWskG2m3upLzmEzO4kyNPvNU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygmq4ARrE5AsSbC9lGbznClRuFKW8272hlmk2S9UF--A&oe=69C675DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afs_d3QdZToQ7kNvwFrTHaW&_nc_oc=Ado74-IuV6iUC4MMb_kA0VoS1TN9Od4pz7vEmw-vzeH6JqDw7L5Yq2LAem8AalqixjA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCY7kkjrPLauqtB1UplgKKh5UmLFqLOlLON1FA_CxPgQ&oe=69C66579"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
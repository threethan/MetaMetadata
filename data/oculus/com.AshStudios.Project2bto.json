.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zGUmLgoZxkuzEGGqKn6wUvMlFRh5esQ7NblM_dtlRsA&oe=6A3291AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgPW7CRkyzcQ7kNvwEYfoE5&_nc_oc=AdoykcROy17-JiX4LRYCwZtfXdZuQHZwuVrQLqnk55rzh-2rjs27nVrnu4YfXGJpY7A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gGjnlpNMZ-3AJVI8WLGrwwF3CYSV8FHzW91Pr5Cct4w&oe=6A329932"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAdnBC4tRbkQ7kNvwHTbxJi&_nc_oc=AdqmC_Ar_EnT2-jrnz0Oh8nr-DGesf9VfHl8wjhJOig1pBaM4ASQ9cwS3g_SJGchehY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tWTvRHtYnTh8MOOkRldeDs5p1i7DLJT0Klyk3ZgXJhA&oe=6A32AE54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OigMljq3WOMQ7kNvwGjMQ6Q&_nc_oc=AdrXmop44mRxSaznWFtX4TP4EOrmSy7dO4bJ_i4pFGp_AmbsNuJvpORHbKSrINE1dzU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yvTHJ-o2J8J_kkAdAeBDKKsbSSPHkXowM_f5LkvHWGw&oe=6A3290DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSyfRM6-kecQ7kNvwHDBvx-&_nc_oc=Adq92027KnzLLgvqj1ryOFtrQCKpAB_R3UKAjvxthXZp4sRLHs1Jfbu6i11Zmqe60zc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95Jcr_EnspWVyrp24Jt2kOedUuRrr22m0sxnRD_M4WZA&oe=6A32B8B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
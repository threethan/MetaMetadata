.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UrlwJKknKBSd1wO9-GKaVFaL0GqDvYmpSoC2dpTfkZw&oe=6A259AED"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5Olm0VbPrwQ7kNvwFy79CE&_nc_oc=AdqAiOk5mav6gEFk2X6fRpOPCcfBiRUBgnWzEczMqNJQBvVizMVYUAPBUAfJHoEn05Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S5OfMrH9W4fPwhklVs66-jkh-9nDa1C19A8sgQxsUrg&oe=6A25A272"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlvrulUPel4Q7kNvwESJgk2&_nc_oc=Adri4mfCfvIoN551iLD62t2THUb6y7znUxWWMeQ52sU5efBdmB1uTWdcig0Q-dXgUhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-bLgQ_49NZLZtXIofY9X7MCbHY__WqWaa3MtT6X0tkA&oe=6A257F54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI1cvlQQCjQQ7kNvwEzaxsX&_nc_oc=AdquzRF-jwqYOnOl2vRduDzjOYZ7PCjo2rOw5whHsbqgSF4te9EL5WD6q5lVDM0yocM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TnAFByvpike9ma4Sie8RRVLauhlgAmjvlPyAmyHryEQ&oe=6A259A1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aQz0ZaVJRYQ7kNvwFIrjJh&_nc_oc=AdpfY1B2r0sv2FZ5iI3CnTjWjLsC8oS7IF90ngRzPIcqMhi1SPuqLv5ARFJnCBc6pMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rByK_s8RJM-t_-Jxgx9M2QG9wguDmMJgf1c7DVdRiSw&oe=6A2589B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
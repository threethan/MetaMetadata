.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrVNExq6RLzMOnfOBJB6Weyh7NOlikstLJpEwdRM9NaQ&oe=6AA5442D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kr_PPpzDIcQ7kNvwEeiSeE&_nc_oc=Ado9ZjMdk4rVNSMB4wB0L3DXlo8vYcXi2dc0Eb0u220NxTLWk0hg8R51ZqWpi9OUYBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEg1TckP0l-9n1g9ZbPrsf5rmsVJEFE0olYH9IsoZ6RA&oe=6AA54BB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybNkYn2N4ScQ7kNvwHw2m4y&_nc_oc=Ado8v3ujRhCXgO3p3FPMPBReNzYANIk--mIeOlv6ojmJKgJwnd-Cx0VtvyhvRRnARPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDkeAKlc8NYe9Api65s10qNCBc6TFRjKj4rTKkwEtH5Q&oe=6AA560D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kWE_YQNOgYQ7kNvwHx5osu&_nc_oc=AdrWa_GL21d_uRvFgsJ8-NpHXDi0JvFY7ZbgGZdufFfzDefv0AMumUAguhKPDDZmXgo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8jFkhag0aHOfr-cizKYK-JKsDaYvItRsq6Ok9cujo9g&oe=6AA5435B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIEKxiG4YW4Q7kNvwEkElPJ&_nc_oc=AdrYcYwo2h2x0ZauIp8j4mZGey1JF29HZ1kvQMMdsUrB_M1dM6w2KIvcAK90aD4GCJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3RI8gDKiWkxsjqoc7iSs55a8P2FlYVw5J0XwWF7RphQ&oe=6AA56B39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGgRD4CBqzFcDfkWweNNHb0CcuSyPQZ9irfuUoWaXz2A&oe=6AD24F6D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySHotxEZioUQ7kNvwGJ1oCW&_nc_oc=Adri52c_9sx7dB6IG0WDYO_hLtBw4GhnzI4dqerOSLnVYUZa5tFgg51q9H8SsF_SLAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg-PiogxduBJU-jeG6CcnuBiYS2RF2O30_FO6CRetZPg&oe=6AD256F2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW2jzm7IbOcQ7kNvwEBJ8Ex&_nc_oc=AdoyXbGH2YfUlrlLPi89Lg2vTdK__XkOTMemIEYnOeVj9qBl-_Ck-umoGOn4Kkhqfgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJQAuHwIUxqmite2KD1_2JITBTpx9P3fl8F_YWcsqSvA&oe=6AD233D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DrpqwdHqCYQ7kNvwH2542N&_nc_oc=Adqf454p4sWTagB7VCnRWPu2pRVbrXiwsas-p4ZjDJtX97_k-L8WXrRLGQxzVhe3rKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXcX-Eh_PTxh_Q6YqTLV--PEKn2YoiqxBiMoNPvET4rQ&oe=6AD24E9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXuPK-I5KxQQ7kNvwEB95Dj&_nc_oc=Adr-KpJcrHkm2hznr1JEBHZoLbUen-96YEBYAjAUPKl4qdIkc5-Tx4wIgLFGxIhsSgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBrVAiEpOcywmtI2eZzNXO8SmN-OV_ocvXO0_EaBkGOw&oe=6AD23E39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
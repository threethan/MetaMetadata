.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kxBCU3CTCQPbAUjmorGXWrC17vM1KfqUhHAYTIxn7XQ&oe=6A3BCC2D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqj1SIC-kNwQ7kNvwFKsXeV&_nc_oc=AdpdkeLuxGBb21_AteCLd2IRY5kgwK0fk27MTUnVqtLmLY_0N9T9Kcx0j7qIPnaWYoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q6iae3B3qWBn3xf9IO3nng8SF8_N4yqEyokuPLHSKJg&oe=6A3BD3B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KfAolzFmK0Q7kNvwE1voN2&_nc_oc=Adosn5R29QvBc0T8O_rLmKTBO1PafM4S7FTkjfe6LU-kZlCNVtCOpqaBnXjj2l2KSXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NO4zSDpFDsLDLCQk8AA8jKfEu7R44KGBVX6NrnPwE8w&oe=6A3BE8D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwM0-w389SMQ7kNvwHtPhta&_nc_oc=Adq8SUNoyXaVNFObn6ZoMvdA8AtE9Vl9IQ3v9enLjaO0M9gIPqE9aDZ-qNgcJ6WUAwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af913VHyXOCO1F-Oi-o6NxAFFX5sU94xtT4G8q0KQHzVbA&oe=6A3BCB5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0XwZ4WbeCQQ7kNvwFcvD00&_nc_oc=AdpknE_o3ev9TyYLe0EDRvg0pCYAjaPHwaQ6gEEYv4gr2Rgm7tWNg7HF1CBRZiicSwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xn4Xiz6dziXJB2dRJd7Qrut_MFTWjexPlU2xoNUx29Q&oe=6A3BF339"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
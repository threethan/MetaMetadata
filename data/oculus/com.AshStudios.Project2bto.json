.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJB4MROzBJyXi7gMcvQWfJ6jT49XL1w7mkDdkK7vdLgA&oe=69C2822D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztGlrlNS0b4Q7kNvwHXDI0I&_nc_oc=Adpr7iBKPAFMFq0S52sDRuoRtIvVv9TgURtBX3Nes366G0Hv-KegVIEDAjkh63IufEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5fIjwKITazeIbZuGQNxP6l8urBQ8E6AeOhDWzL08uNQ&oe=69C289B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5KN8_H6QtAQ7kNvwFm0nao&_nc_oc=AdqLGelDvxNcYIKla4wr0uQjbl4fw_xqkqPG98CdT3Wfx6r6bXbLqDzHX-qRFz7Ot_w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8-v34Sm0oqEgKpTIpZiVuQbun9DMF79qKs0xHhtpAEg&oe=69C29ED4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laDY0q0laRgQ7kNvwFtk32T&_nc_oc=AdpJ_tMdbj8wn5lhYbLJJ4fr2d59pHjm-xbpxtIHdKiGSpRDy_-YEF1_IZ9Hm_xsgTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC_6PsgD6pyLiedsRpMVlRaIZYTCgaKkTHNkJxHSqC4Q&oe=69C2815B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9rREGk2OssQ7kNvwFme9I1&_nc_oc=AdqEYeDo7sqo_eScSkDp8jnxl-qgzU7BtOGRGFgjQY4T8FvASwo5ky2HzwqdjGjcd-Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPiJREtaPl_OR658HOAZXOcTBIKMrWz1QjFrkiVxOjxA&oe=69C270F9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
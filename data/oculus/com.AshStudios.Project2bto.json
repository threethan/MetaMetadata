.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GORCwm5va6sMZphsY-VX5UVvG0rq-JVowK1GmchgRSw&oe=6A43B52D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HZ8OGWq0S8Q7kNvwHg96Th&_nc_oc=Ado5yzasVfwF2CjrtjL-grmqU9020Q35JhY0sfrZKrj9t-6YKyTq4F_3xX1BlBBPIYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L9AJS_Sr3qIgDAbKSMn2jIBafe5iQM_zRjHihkc8S5w&oe=6A43BCB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZZoT3F7H9IQ7kNvwH1EoTx&_nc_oc=Adr0sLZ5BG0652dIU3h-lxxZ1dP5CKjaAkJPFUZpm-pjRClJ-pXAWV7i_LwC_KmpARc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jOvXm8hIlDTjEHxcTPGY8c59rXudOSzXhbTLV372wFg&oe=6A43D1D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA34KzeS_uMQ7kNvwH4lBlm&_nc_oc=AdraAwfuiEWoj-Iepal4FnF-_3uvkdA__2zcdBBFXaxKY7v0LHT0bHrpVup1jBfttX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99Ttm2yUYNpbHnJBTbtdzr3ORTe1a71ocSur4xLOuPFA&oe=6A43B45B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8PpwQoWCf8Q7kNvwHFWeEJ&_nc_oc=AdqwWRrRXHZLeoBikViPDqlcwpidewxa4IYCVIxvqNVizpGl_sF6HUsYXBgoqO2dhRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q0SYv1AQTdicbqrbWnyAxIfuSIUNUs5CDGt8xvyyu4g&oe=6A43DC39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
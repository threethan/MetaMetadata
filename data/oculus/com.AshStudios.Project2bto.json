.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0wsgdvsHwuxnpgcSQnYCMw4eyj9r-344iqXXlrHPbwg&oe=6A984D6D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzzW8_zC0cYQ7kNvwHPlT9i&_nc_oc=AdoHCWx6WNBMVaJgJlDZYz7xPlLwgOSItmCDMGqZfORQFn8-i7yUsHtHpUgmHj3hLN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxkBr6th253hqs_aT3BA9rvY533uLglBwI3I18i0vZdQ&oe=6A9854F2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGAO0IpcVNEQ7kNvwGUJ26V&_nc_oc=AdqYuN9TLi8O-iO-FhNhhZCB2qJr0TWEQDaNfAHDWaiWjkk8jCzA7HI56YWQOxPXlQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9on7cjwrljqNXa0mN17P70hoGBoeL46Xtru5sRJvoDQ&oe=6A986A14"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdxFp0x8E3MQ7kNvwHMdSbQ&_nc_oc=AdpU4lCCfLV_bg8fDG9JLdgwH6zgs-S7uOxLaqMC_-cTn0GEs8H1lDS0drV9PC8Lhuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3keE8Z_u644G1cE900L_NgE80gEzQtAhsUhFtnJpIug&oe=6A984C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPLAy-3gLJgQ7kNvwGJwMjh&_nc_oc=AdqC7bu-Ix21FxskBQGZxIoB3dsrXS96GuXVRyBhMyPPFqDokWFycBY40Ix-ABD0QuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU3_hZ9vHhGxNLT0vqC3c2U1zItGCLxrLaXlzz500T7A&oe=6A983C39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
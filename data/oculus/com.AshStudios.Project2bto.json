.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ql-yCNkF3tkfFNrSElr6WivZHWHW2AL9an5AaTnQtbw&oe=69F9E12D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9ZbW2Fp6LAQ7kNvwGPym7p&_nc_oc=AdqIWr8EhREOV13xSDVDfKifQybitkm_jXwz3wY_glM1ck3S59I08xbqVrOxrak9Tp8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NSoUK50wp5RV6RWKoqPcexV5IIyF0O4lzuYL0M47v4A&oe=69F9E8B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51RDHBlFokQQ7kNvwHqpRH2&_nc_oc=AdqZAC7ilzVEYduB_nHZsRvYE-3zX6oTwC8YFRjaq1HqBZA-mUXuEbtvvv660RzvstM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60B-N2lmKXxDPAPcIl0DFH-vJxEjG0DUcFdiDclLaEAw&oe=69F9FDD4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LhTJtlRO70Q7kNvwE3ErnB&_nc_oc=Adqk6lyPW5eFmOkbkj_Lqbn4Qyp9zT6kK_1Dh49Q442K_TEJLyH58on1bBmelcrTUyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OMWxSVGto-qKhEBANQlK27L5BjNwPcNI3w2kqN7xSJw&oe=69F9E05B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WenbjMmQRUQQ7kNvwF0jH2C&_nc_oc=Adq5XME5nwdE3L83yijLh-OTSkT2wHTz-0gLh6yKJaDJx4g9Fng5LqGABlxWTMvOmUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G2AfAnOZfyNsPoFa0CUDIDTlUhcp6aNRe1mB11zmPnw&oe=69FA0839"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pEG6eNX1CLGgTZlv2Iv7cAI6wMgOs8dgykJzWM6kxvQ&oe=6A0DA7AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMdBzuuyyV4Q7kNvwEQUnNU&_nc_oc=Adp1wVzzLwhb0HnhniPV99CmKoThRptlEATh0R_YY_3ki-zr4XjcYS3VKskajVHvxfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VDPt5T6IsBQW7o_JDiq_S-oUpcLdWLU_uALIe_mN-qw&oe=6A0DAF32"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fok86N2VIqsQ7kNvwFL0ygr&_nc_oc=AdqoxvzH5r-tdqCZ1HSFVZZTlCRdEMvjHf9zNC9vBO0Bl3KKQY3lK98nOOg_wsyO3Yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cmdr7YkolUurU45TPmJV8YnI1fjuYjrPePp7XgQwzgg&oe=6A0DC454"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxFu0shRheEQ7kNvwGcpxlD&_nc_oc=AdpmD-ik5UT3R2ybQemK9235YjdC4xnyv9kdKDrv0f761hno1P8EDH1s6Nk6PSGrjwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l4mfCb-QKD9VDu5nshiBqrTqXFiaOrKlbMxXx7YQXgg&oe=6A0DA6DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW0R-_g-_SQQ7kNvwHr1IpZ&_nc_oc=AdoF_pwfsFz6LfPrTlIpp8RjzVrJYPslqvwI4pU7p_x8dv7qrvy7ru9SVNG7vHN6_xM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZBGc7P59GihVZr-21kJbbrPpaNZwCmJ_U0obGyWdREQ&oe=6A0DCEB9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
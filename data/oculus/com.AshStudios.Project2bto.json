.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAB9SKCBMj7g3jYCHyQhB7PaHHdEpbbTYPsTtg8HxbmA&oe=6AF9DC6D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chRB1pV_1Q0Q7kNvwEcX9nE&_nc_oc=Ado4XNtPbV-AIXSvLSe9XBS9U06TatVxDPT1k8p-vhr-g9Pn3nPnHCaz4ixCnnx5dqw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThYoHGmpwcPDmxwui44c5VwMQXhAYj0xGkjbyYhI7Jbw&oe=6AF9E3F2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibcz_bU96U8Q7kNvwG5DydB&_nc_oc=AdowbE6JxSG8UHCRZlAxBw5ZPwtn07tYyxPiH6Cc1kooNjkOdM8poEXk7-MmbXlCG0o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS1d0bodrGmp1BCNX2KQjQcEYzNvWF7yPFLF72heAOHg&oe=6AF9C0D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_ck9N7Wty4Q7kNvwE3HRoc&_nc_oc=AdpEVj0rDqsqyTI1-MnVXOyzFXowjlSLIveF14RvLL75CplE4fdbOcqqAkZL89hR_fs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7pjY4sI07iptqqJsaN8Eznr5xNr90Dd3CWw6pcgCrdw&oe=6AF9DB9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41V9r4WELcwQ7kNvwGquUxU&_nc_oc=AdpjisuhwCIldVJ58Mj5sHQpDtelMp9sAD7QENXxHAm7MF-SPOxHPy5XYjMTXlmT4bs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoQFjVLAu-5QjuJrkLl4rP5LkiZdaOuVlICIkd7e2New&oe=6AF9CB39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG76VBc_kmxNTCLtXoYDGlyb2hvSbLxDXgYElX0zRWSZg&oe=6A9420AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CCx7vpDg7oQ7kNvwFWAWJq&_nc_oc=AdrN-U4d6NSPkRtgQbAESVUwWbR-1UvQmdlmcHxnDEu5vtT3lTUnYD_gJQdAqbL4mYk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLuwgB3DZiZqqCUK5ZIya5_fENDduuM4BD7a3ZDCFDOg&oe=6A942832"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f-Oo_9n35kQ7kNvwE4ck61&_nc_oc=Adq0-4Wz8-zoMFk5ITRl3fsskMqxTdvP7C8Oewqf6N0hWvGcsqPBSKeURhj_SNYsnn8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAjz7V39KS7-TRNwOsuVnasa1XQE2pMerifF-hU4owfw&oe=6A940514"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnkYsNJzcrMQ7kNvwG3Itpu&_nc_oc=AdpkVR5YCwgwm31BKKQqf2a_o5EWbqu59I6QNGes2RCtl4uM_FHj1L00WiwoT-FEpHY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKlxVcHqNBmd2VteNRhL_6iTspiiamU5Y0jke1LuSIhQ&oe=6A941FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDLqnf-t2xkQ7kNvwGIAe21&_nc_oc=Adry4WMk9NWXAaYdAQi0knDaKHtWzQ-a3nuvyreOzZgauPC4BpbkUbVreRbOO75CYc0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtXI61L7MVwA9ujeBgxs_Z28GjC-11-f9hK4Z6Bwky-Q&oe=6A940F79"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vhVNR-JxbbQRvk55cBGCNAFMoSoyPE8WZrAzSVv6lpw&oe=6A09B32D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMfB1cGLHvgQ7kNvwFglqZP&_nc_oc=Adr2NOCGlhvF8ubUx_ktIo4ZrvCSofYDSqCMWM-ERgmmyjRGRe3mrCHSP1MyuT8uodw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47N3c8HAXRCfM6C988OEYQGcZI8SkwkemDIhBLFP7A1A&oe=6A09BAB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHM5czlPidAQ7kNvwFDtqZY&_nc_oc=AdoRF3CBmzUBUI3pyd8ppw3tSze5O15lld64nvrfZ8eT14FFXgZq0RFiZVNwSSfR2oY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PvhFF2909wRWr3HHRRzAvK0Za-h1JCI2leH0vp-35aw&oe=6A09CFD4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPCwCXybEJMQ7kNvwFzpcMP&_nc_oc=AdrmgempGVPJRISMfgUTIHDaHNnlg0nrD_g44a2DCp8sHVBFuA4ogbTpcudG7GF6d8Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pNtdj9l3za3hj9Qt-oXt0wu6rqVRguOgZK62O_Wii9g&oe=6A09B25B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UX_zwH4zuoQ7kNvwFCle0g&_nc_oc=AdqBq0zv92QB87vJB0Qe_paJsjroM_w8_VUMfPIIFMqP0efulBT3dC744u20mQACTh0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wl7BJkEn1bA2GUGau0rhZPsmo3w7B-ojvHPVK8icwww&oe=6A09DA39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
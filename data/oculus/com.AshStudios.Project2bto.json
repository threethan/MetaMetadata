.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfwEtFWVkE7y4MHdSrtyTjONnQgOHN3xGT9vVLxhhRDQ&oe=6ABE88ED"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PG6SpkcyuEQ7kNvwGmccgz&_nc_oc=AdqbjUu6vG0nxEs_YRVfVSHSSMZinhY-wrFQ9ISkgE7WJutvOOKSXOQTMVQtj2PRoQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHsyzrCX4EoTIF62LDg8DA3yEMEMl5JyXFWLcZODzLRg&oe=6ABE5832"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZgbiwwWiCgQ7kNvwHs_RrA&_nc_oc=AdoM23KJTRlWM8L5hvwVju71yMGBR0GOg7LbC0ikdh77HNHF7njEgVBSx5TscgzhaJk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLslTUPPKY0DBZqINRw5HXHiOnjJ2exDU7ptbJa9dLGcA&oe=6ABE6D54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRC__7VJkiYQ7kNvwEBRxPs&_nc_oc=AdpchafLp37iXbJBguwu04G0HT9-bW63tTImgOr6eWdtP5Tkm4F1agccNIVDb-rhMQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMId7Aw7HmfhFCs-mtecjTVYKr6aRki7qvovd82_Rcvw&oe=6ABE881B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqKJNHbRF6MQ7kNvwEuITGr&_nc_oc=AdqcDCl5iShZQ21GBcXVca3FrYPAwZZzGQfEhmlQWYV7rB2105pERB1Wje9dobZUH78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbQuiMg30O4-NRVjdmzDpic6tskfzZdPA50eUFYFHLqA&oe=6ABE77B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-SIpPsK8AqrQoerAibotKcxQ3bvbrHt6LdJrLj34PMQ&oe=6A902C2D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLuqrRG9L-QQ7kNvwEvomap&_nc_oc=AdrWL3RBdrKo_-JLWNNS9h9NNNsJz9_IqdiE7ydchpJLt9Qh3fFsiCG1M2RPYI63WI8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEodS1mBVvvQh0t-TcYPjsH96kKkLX2CQ4S-6hl-uHK2g&oe=6A9033B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z31n3k9iGD4Q7kNvwHM00Py&_nc_oc=Adpvn0ub_AAsRe8Ve903Ju1hH4_JZ86LZvIVPf1E3mwxAMHjKdtyXVRgwxBtZUGwFmw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL_l8J9BcruuY4v_odaT-75wdPLYSASvzwzqAdRsNHWg&oe=6A901094"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZqhW4dq5EsQ7kNvwFiDWu7&_nc_oc=AdpQjY95IJASyp2h36X1Yh6Dhx0HEnUkR7h3hSTSPfS74OHTVRnWtbqRMo6BEj1YXhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEadHa2ekZ_Ktfvdo5dUCxxJPlF6XBQ1PACqJwYC4xLcQ&oe=6A902B5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnM85B0BVs0Q7kNvwG9c9tv&_nc_oc=AdrufqSEVtaWbFpv41bFYUmKJL0f6RRamSVqKL0LHHTVkQkikEYZZvJZTvhg1Xca3L4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNX9P1cZs7Ey9r4lNFOoY52YAtVAIH8YuOFxuLaB0OTg&oe=6A901AF9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
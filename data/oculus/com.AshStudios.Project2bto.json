.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFri-9M3sBbhchitloos3pfC9n5KDRbXpALnWWOA-faJg&oe=6A8AE62D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BetBsbRULWAQ7kNvwECleFa&_nc_oc=AdoMLvbFyhJeyU1qqDfWXo4W5RN1fKWPrIWrOwCNhcn0JWETXJzt3gLmqYeQ4bdaTVw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxA5ACy99ekRgr3w5HXXF_6R7ekQz2O4zCoqfud4A8jg&oe=6A8AEDB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr0oZTuSkUAQ7kNvwFved3-&_nc_oc=AdoRU_tSf72EHvvTeUYLxOXMH9Sx2ykx5f6jnOH-hQc4qYdPRUNqOPE7MgNVJ9h9J_o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe8ID1kaxNFAQBJm7JK9yRLS1vpHKGC6goLRwgg84cYA&oe=6A8ACA94"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ1rwejCAXcQ7kNvwEOxpHg&_nc_oc=AdpJF60Xe-jVyTtEv6T5bRCrGuXRuwfEydzS-Y36jdkfFRjc7kFyXpY3C_y1RNqE3ns&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyhBzkmIoCj0aC0FrEbTQ-LKhjymJ53LiYf6Pt8DHfjg&oe=6A8AE55B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs3-vyr3JTcQ7kNvwHv-6GD&_nc_oc=AdpmD4v7mHdVLqpZ7i0ADqaehXiRPSA8EHakEO5un_Feob6Grsnae6YFtF8S6kSzcxE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFX3nw27qzi9uUTVqJxXjSje4ROkFBWGSjAHvdD4LsNQ&oe=6A8AD4F9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
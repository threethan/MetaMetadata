.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKMA1li7yKU0t-u7rd6jGN-DCbanx-Ymw9WiW_wwbUyw&oe=6A9FFE2D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka-NR7drh-QQ7kNvwEHYcXU&_nc_oc=AdpQLSW5JlyJ4Ho6rj2rXFKo1tGFVq1Hz8o7PPWpUBQ-g9Mghv2h6yQnNGqi2XHL0ys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAzc9dxTNHqyJXOLfLRbuvCXJlwt24wx_ZP5wWNKqCtg&oe=6AA005B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv5ZxquXTA8Q7kNvwE0Gu_F&_nc_oc=AdpQO_ATJgqtomkb1-qvN_6IyUamFnNtsPx1LNM_07XpDI3czbLCBkcI0VKBLgMsmm8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ99sEuw1hRFArDq7YYMAvd2fokp2mlVWgTuwe6KKhjUw&oe=6AA01AD4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSLauA2iTIMQ7kNvwFG2Ozt&_nc_oc=AdopddlgZxZJxUaxXFEGJDUDIJByg1DvWOH98ozj92Rly1nopKf7svCRcRpWCyV-7Jg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWVGX941dS083CN3SQC4PFUKWv4BIwZRjBEZAHYNkgTg&oe=6A9FFD5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMJEN0wdQiAQ7kNvwE4S0jv&_nc_oc=AdrirWs0ZXUj9QyRvtYhF9dcK1WH-PPV8x7ewWFTGJ-PaNUhe_UFyx651fWLFoMdvmo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFXLMRGIwGTz7qmSPpp9IlfDLXYr5jfBQM-bsf9OaJ3A&oe=6AA02539"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
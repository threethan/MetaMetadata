.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgSk6CqjWdteAtHCcocQ64CwLUiuETusglyriPYuo0ag&oe=6A97342D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzzW8_zC0cYQ7kNvwG6uhEq&_nc_oc=Adp6vlmJnpdnQMvGKda6K7YZf0iN4YoNo2ialA56N4KHQwxy9_W3GINPqfoQHR_a5QQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8_x_TcnHsCRKQRY2rSIVUDntI4HqBJVEdaNmw6uNDGw&oe=6A973BB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VetOMOofgjQQ7kNvwFLMlI4&_nc_oc=AdrydnTz0OxKfKaJGy23gXNK9Aig-nnijv1oC3vHai8Ny3iZ43m1GwfwyzMx1ZzlpOI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuNMj2zHnsg0VkBytfImK1KCrUwPXjRzCQiJqcp232Dw&oe=6A9750D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdxFp0x8E3MQ7kNvwEm2GVl&_nc_oc=AdorqHqowaFLsxnQ-xYGY6alFd2tK-KzXgxuLC2mn8pDih5Lf7xinSZS2aBsvTTJdCw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGmfEwS3AghXdohaf97IU0Bzm5Sa9BJksM12KyR0NDEg&oe=6A97335B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDLqnf-t2xkQ7kNvwE5u-sP&_nc_oc=AdqIRZTJsGbvQXgw0Qoh5JD2g_tVReJ4O4h5nFFPJdH4Vx2cXeX09riVYwzG5z2qcEI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHASoSre829g0fO34zvQ33JOUZE8MyUz1IfUNO__kxoMg&oe=6A9722F9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5-fGxkhNIKY0nlMngIV5oYHX9l6lHAeK1LFuo7ThaUw&oe=6AA3F2AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kr_PPpzDIcQ7kNvwFcgh-F&_nc_oc=AdrogldXn3SmdvDL8hG4948Pqcp8aszbkTkRZlxhTFynZCKJtOlteW9aTMQi4Z_vgjo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFLpwOZERCDrW66j-LtAUGuGoFBYPh80MupdxI0crJ5Q&oe=6AA3FA32"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybNkYn2N4ScQ7kNvwF6Ar0R&_nc_oc=AdpIlxg4CokDb3u1ww1mdRS5eY0bihgt8wfdSYdIH0pQGtQpZxlK4qAqgQtgrDL1C-Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXYI2xkjSyVAx0XkV2oH9CK5Yv6CiB6kffJJl4NUpc0A&oe=6AA40F54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kWE_YQNOgYQ7kNvwFqXUAf&_nc_oc=AdosftkRoJ6hwCk_I1PsnRtr-xMNN2qFjaYLndIc9j6KueOSn4Oy6xFo0NZqv4GjzF0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8QR2a4GzwUenQOXeOg_Sopz2AblGI4DIw_qqWCbLOYg&oe=6AA3F1DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIEKxiG4YW4Q7kNvwHn8zvQ&_nc_oc=AdrDPUw_CVv4dWmLsm5UMoqzjjV7EgZA5CxE8synBBd9rVH_QAtyja8QkEws0wWnGAo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQk8aMSS7HGlmDrqoCZjevPYhUwWb7cZwJ4VJ6Rmh-TQ&oe=6AA419B9"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTAB
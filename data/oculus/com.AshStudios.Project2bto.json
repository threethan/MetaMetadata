.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaNdw_nUhjTdLPdxZA8CNvuG7FgDzRFiZ15_WgJQTRbg&oe=6A9D5B2D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyf_QtkvniQQ7kNvwHAGdjx&_nc_oc=Ado5xwaXrCITXU5BuLsIwxkJoLcmCuwDaxYcwFZkMnxB64hkv_uJ4My4QHbKHhnBwHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH5WtuiDalw7tOUN8NoIEiwiTxFJYoMzm8aGBddA_oOg&oe=6A9D62B2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5cQ_ZGNsWQQ7kNvwEzu9fm&_nc_oc=AdonFgIk56QDt_QEpPlryNLbYeXNkzP_p96nEkGbFqG3eEsMh2czvQBGhmMZYuz_L5U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoBrmwky_7J6VFoJg7xWU5Mwd4lfWUBjSY9I-mdjHCVA&oe=6A9D77D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg-VLWWGzk0Q7kNvwEfhoj8&_nc_oc=Adpfqy4dCfXZW9RmnwiPwwaPXa9QJ7CNPY6Zs-Hh2XJ-9L0f9LUn3D0kVpsYv6MUBWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhWzKgLKvC70eGrMd2LSjeKNnbSQ264-Hr-bbdwU_NgA&oe=6A9D5A5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ece1ExQWFCcQ7kNvwEzob5b&_nc_oc=AdrbgLkk0I7jlH4FH856gEjP59KrC87yh8k6KTpxp5nbRuhTCCuCCf-7RO8gZ6ypUd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5oLVbkzQqcJTB6gEbVXK1_Hq7o1lX3bteHmRzON6UVQ&oe=6A9D8239"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
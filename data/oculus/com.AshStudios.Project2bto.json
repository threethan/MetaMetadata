.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwxh19rvPhKw5v8IuhYxuqdQ7jOgEXRsuPfAkHZBtALLw&oe=69D102AD"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdBU89rd53wQ7kNvwEPXfQ7&_nc_oc=AdpfsciqSUDOxnbI0Qy7F9Zpds87IeKO6BwI37_scXVfEOyMItJWZgVMrfwUwqxP1I0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8pVaAgiv3A2khjLK-YMXOYAvN6S4DdZuKYvqqVbTWDw&oe=69D10A32"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kDuB2hE03oQ7kNvwGBt_gh&_nc_oc=AdoSBdXTa7qsvbbsBcx-s1bLwb05B3guIh3LgJTOPCO8SWBcCgTLchqFrINYcSk-Y3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_VQd9IcvnSy-wG59CLcUym6nebXQXg0zldqZSl681Fg&oe=69D11F54"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEDujYJjPH0Q7kNvwFSGo4l&_nc_oc=AdrXyGec7gQLmc16qCoHcN-JYz9rw8dgyUkkGepv3pvdlM9d07iTeNkQSyZNf776fgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuinfKzxWjZSuAJJ7qbaQo1n3EsauKafN4mpCmxTChyg&oe=69D101DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5k0Ks6j7hkQ7kNvwEgRF2H&_nc_oc=AdoJQ6IfqJFNe3BJGYFCWf4tFqrbfVTwwY1vA1RmpOh70nTZRdQVdui_Zn4VkjBzNgM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQjbfLWu9BBEZfekNU3w9DI33t14JNqghewe-dW1T1yA&oe=69D0F179"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
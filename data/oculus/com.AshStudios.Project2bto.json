.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R5v64FtDjjmh80Vim8gwAY-hU4tD6HHqLtVTKj27Hbg&oe=6A26EC6D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5Olm0VbPrwQ7kNvwGNcFfM&_nc_oc=AdqkMthJa5utgwX7PG0xjcQ-xSZC3g6nMAFq0k9-bjOWacvg5Ssss9j5Rj9e5Nd3TUM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IWqCuXan-iPVY8Xi9905sAEzEE79Xd8QUqwASAT8Prg&oe=6A26BBB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlvrulUPel4Q7kNvwGLdJ6M&_nc_oc=AdoiuW_pONwWso30e1Gv9GuFRyZ1YHlUuhLjKtlhJYiuGFYsv39Qkb9Kx-kyrNtkXuU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TKI0rUGg2si8J7PVZoLv2XbTbByBOUabdkuTNoA1L0Q&oe=6A26D0D4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI1cvlQQCjQQ7kNvwHp-_01&_nc_oc=Adr22GGl3_P09B98iW5aFdpVmzSaOxxeaQhJIvGPSnaTndLq07m8LXzTuECSFWbCSx0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c3r4J9__7kstMMyjCUyjOcBEYHEw1aO-zSFdUBMq9aA&oe=6A26EB9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aQz0ZaVJRYQ7kNvwGIEq88&_nc_oc=AdrDrmC7_4RjP7mnGQD6DZXuWRWgsGhlHavrB7Mtqp-qnUlkW-UEX2-7OXVjaDH7idg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ngcEdB-eq9t0pEUCEdAHK3jWSlHeVAvdmGGReOicOAg&oe=6A26DB39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
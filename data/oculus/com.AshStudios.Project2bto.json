.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSTiB9EtrOQMcQy6K9cwH8p2SqHc6mhAVRtyLuu1Qonw&oe=6AB2732D"}, {"file_name": "2560 1440.png", "id": "865158561609873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_865158564943206_3039687670885157174_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZxmKAgL-fcQ7kNvwGs7bC7&_nc_oc=AdpmmsnSZMcYxgYaBqkyoY8OfETaCha2iUTDNNnBwipWTsS0gZvjM-uyf29oejilYGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa0Hauy2BZlyQR8QKd10y5E6dxRzmAP33B5nPe1yqouw&oe=6AB27AB2"}, {"file_name": "2560 1440.png", "id": "921692919690953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75388630_921692923024286_1397563986481519451_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTKxYIJrLFIQ7kNvwEE_7aF&_nc_oc=AdptE3-YDobLBdk8O6ZGiE8USU4jdTHabCyu4g-KsswYTitnPXjsO6T6gRAi4uGzYSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIuHRZpXrx4_gwa5FDVC76SCZ8of3OrXJ_rF-nBfAz-g&oe=6AB28FD4"}, {"file_name": "2560 1440.png", "id": "1214728906626153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_1214728909959486_5640181462421353944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k76Ztia3MJkQ7kNvwF_77Io&_nc_oc=Adodd_sQxpGKOoFsxuh7Bce700X4rkzOLWrYtMb_3cwbbtZdoPJX0PBmWCnYg3a_f5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKydpkfzvsq25tVlvxp17HNv2P5j0kD1oCnj5R0oeLbCA&oe=6AB2725B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "2514107282132999", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580056_2514107285466332_578651576974335053_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4iBYGP8VtkQ7kNvwFdAsjc&_nc_oc=AdoCd6w5h20IXpQw4OiQ5DIKzBz7J4P5sbvBQiRkywHeTy8uNvhqwii7hjomflAxNpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXJGPi7meAtc8i2jS4WCTxtYb4KHeV7LFRtb4St9DY5w&oe=6AB29A39"}, "display_name": "Project 2bto", "keywords": ["gorilla", "tag", "project", "2bto", "monkey"], "long_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to catch them. Scale trees and cliffs to evade capture or hunt down your prey. Enjoy the freedom of a virtual jungle, either with random players or in private rooms with friends. With low stakes, you can relax, chat, or invent your own games. The movement system is intuitive yet challenging to master, and you can play across platforms with PC users.\n\nDiscover six diverse levels, each featuring unique terrains and obstacles for endless fun.\n\nCheck out our City store, offering a rotating selection of items to purchase, play with, and wear to showcase your true monke spirit.\n\nTransform into a Gorilla.", "short_description": "Embrace your primal side.\n\nExperience running, climbing, and jumping in VR with a revolutionary locomotion system that relies solely on your hand and arm movements. No buttons, no joysticks, no teleportation. Propel yourself off surfaces to jump and use both hands to grip and climb.\n\nExplore four distinct game modes: classic Tag for up to three players, infection mode for groups of four or more, and The Hunt where you track a unique target.\n\nFlee from other gorillas or outmaneuver your peers to "}]}, "developer_name": "Ash", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-2bto/home", "developer_terms_of_service_url": null, "publisher_name": "Ash", "support_website_url": null, "website_url": "https://sites.google.com/view/project-2bto/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfor
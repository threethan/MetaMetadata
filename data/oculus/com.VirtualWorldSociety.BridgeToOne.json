n.com/v/t64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV-Pjo7SVI4Q7kNvwH9vUAL&_nc_oc=AdpnbTVsvUuoEqtdO5J5BZSpYj4DSpNDlM1Q3-JPUNq7Pbkt0kBXcb1bsUm-ptX0l5I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj98ayxP-jeZaPAUcTxSt11dVs6T1O0_OU1TV0gBHv5g&oe=6A8EC2D0"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHgEFuW1nVsQ7kNvwFCKdKX&_nc_oc=Adrx6So-uoGWZxdIxTQVS7yUnM5eeSfsXj63MXDhBaI8nMULzNFvGqiGNc6jWEKkeQM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGndV8LWS6DDENOIY-f--NEUWlDrZd5J7K-8FDMxzwsoA&oe=6A8EF221"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj3vkdoJbJEQ7kNvwEeBR6G&_nc_oc=AdpOpxZz_nlvMmvhaMLA0x2sjmfG6g-hTNjkazQMk6vIBV7rzSLFpAIWgdgZRL0-QGI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd3sM1WBLrB1SFrbG_-e1G39jPkNpVSW2XZi3oDzXOmA&oe=6A8ED811"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TbGvtC_qksQ7kNvwH8947D&_nc_oc=AdpnhjohFSAjI5npzH1xAYNIL6sJBgMVb205MWi3K6gxcw4-7dxYNukjNjRSbGieQPg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFniiG4u6be29gjMQNdldEMUJGu0UhpnghBa-QlB1gtQ&oe=6A8EDE32"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-gy5N3ttFcQ7kNvwEJ8n6E&_nc_oc=AdpWAmXU5rqQYSukyndtsZMfPMDJGu-vnXh04aHWg2zYX1jAtmbTDrYan3UMKK-hATM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUQBF8mcQkDxJfcb_VRyx1fP0O0eTiR2qIJ37UZwDVoQ&oe=6A8EBC6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107
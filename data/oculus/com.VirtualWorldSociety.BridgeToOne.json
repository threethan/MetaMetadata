64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckbQn8mexLEQ7kNvwHjVaHK&_nc_oc=Adqhbyaiqld3KYznPGAzO-H6LNu-RIhBG77ObgJpIhAL9lAcJPB9isVbXL5949eDf80&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1EJL0iE7PnI0jqtuyoYBxHrJHu4e3bTXLwq36q-kDgQ&oe=6AA17010"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3z_5E4W3DAQ7kNvwF7kRr-&_nc_oc=AdoVsCjn29hyCgeY5O3cxMDgPjqt5Qz48P5EdIiuN-fbr-DTZeuhL-OyrdrqquzzqkI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoyC8IlJkQpKokUXHCcDdWoc6pis5kEGuJMxw2LuRlIw&oe=6AA16721"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-eW62duUuwQ7kNvwH7qen7&_nc_oc=AdrsP3v654PKVOL56xBeM7Ll8yzBR9A4E8cRXzjGtcyrhIX7qDhWglU93eIPiuy-4M8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG0s9tQCR-cGoy_RYGtInZqwq79DjtNsqVZ0UBAjpXlA&oe=6AA14D11"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHBDBiA9Pf0Q7kNvwH_Y-p0&_nc_oc=AdqSJavgbhB5F4r8AkckhnGf9PKnXMZhBDHdiwhI_ydfITLTJl7UJaPu2UU5apYOQis&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKynf0jNgRo4uS9-vCZIQwwxGOxgS_2Iuqpcn5rqiCuKQ&oe=6AA15332"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjjCC43JUaAQ7kNvwG0iHEp&_nc_oc=AdoLKpsWib23aZoD-68fRtQNYo_A08VZl2Y63yeSEiqzUIFmtYmk_c2et8lhpnhTaLA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPjqHzUaKWlDJKe1MVKgEcyQwmo99RxwoJFlOghznBZQ&oe=6AA169AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
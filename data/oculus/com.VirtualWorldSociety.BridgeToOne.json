64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uIGmS2_cdUQ7kNvwGQ46_E&_nc_oc=AdoPIXphMX0xgAXaDIKdjrRhd4Ffx-Y-dc051SbLl9rrM6_zhL3o4vfsuLnWmFF9Cb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtLENcbV3XDzN5oylThBB6zUCxvx1g6mM1DbitScsnyg&oe=6AC11410"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td2qZYg4zpsQ7kNvwEFBkC9&_nc_oc=Adq_BAqCk4OxZQKQGx0l_8C-I2Nld7ppWUMn5-aXtNayxVR138WInyARHwdFwSoaZQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcBfMVgWuWp_AL9ilflIkiLA7e5eBr0N7uF4_dctfxjQ&oe=6AC10B21"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0qg3QXcnJoQ7kNvwF68zpB&_nc_oc=AdqIlzQfF6q2cnma7DW57JfXd7rK2dIDkmnAtOyWMnlHxONOHhF6Pd-MmtoykWb9oVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyAR0BwnuHPk-fs0LMphhzjcGudTayu_c-jWTvd_ssOg&oe=6AC12951"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFNJaYnPESIQ7kNvwGf0Olt&_nc_oc=AdoPKSOM0-csF172WQ1AF3s0df2RALplffbuauINbraQQzYuFFyVC7q8Rnhgq-7GD9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxIEfH7bYd1buExpvkwKa51w_HltyC9gQp5jMVELZWKA&oe=6AC12F72"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UInMQkj7_oYQ7kNvwHa_E8c&_nc_oc=AdqcNzSy36sb4UnXujJ7gHAOct8SOGUZblffKSaBBPtij2DMVM-C8hbsgzlOQxiweMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJddLfCfZbrl5K-Q9nNz4IpzwNYPbQXGkz8JTfjy-jJQ&oe=6AC10DAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
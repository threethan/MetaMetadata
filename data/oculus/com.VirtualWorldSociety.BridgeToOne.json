64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjmCGihtShwQ7kNvwH2FQtH&_nc_oc=AdqACKngdjOobBWJZ9LEjN7vqRYuNh-F7eq5aujvvxvpxksbTP7icFwwCGUuNRYx2pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_yELnzOUKU7JulenlRXRY4lo-JHmTrvVoHpOfdSlaZQ&oe=6AB53690"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfcdr1gpaJgQ7kNvwGkjBc6&_nc_oc=AdovoBSYy9FrD0lae3zTtTcIIjaNiFynCLcbQvX89Lm-7BqRIL7p0bv5MjBp39xxOO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGZcorBsDibiMDXcIUwJuJgnKFJ4ObWJqzEOvFiZTB2w&oe=6AB52DA1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTbgbAQ3lV0Q7kNvwFOm1LE&_nc_oc=AdrYdkqP51K8DULRgjMZNKa5E7nZbI5P19JBXs34V8j5AihOshB8B1o6OWr8wCrMy50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeFvISiZwkSLYmrhAzuh_uHehuaKtFpJ_J0kvncerDTA&oe=6AB54BD1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L82cMvlXIIQ7kNvwHkTwBh&_nc_oc=AdqaQmGyVdIVChzMHYZ6XuVPMj5nbcjiLbidqNNWdAB7j05-A95Ya925_dek4eRsShc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZrCKcoKsHf4dqLxlJY_8wxKP9oY8LpFBSjUSuOSyWPA&oe=6AB519B2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZuSTQPcrdUQ7kNvwGbpA6-&_nc_oc=AdpFiKkDAKSrthRcWm9BUNvsDBIIa5cGIE42l7SfpIRC5r2VvEvOvTVMjK-jlpaKhqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvNAx5YtEc_deGFVM-LVCfN9ARAfnn6ohvycr4hrni8Q&oe=6AB5302B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckbQn8mexLEQ7kNvwGDyUUW&_nc_oc=AdqV6OqCIFBWLkwqxEmUlLXkEQhd2zZ0zzLSOhGjn2ogfyTW4t-UsOewdmCEZ2FRdvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOhXqTIMp859sWks7jE-8gnJTybtgPlIDnbo5hXxonBQ&oe=6AA2C190"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3z_5E4W3DAQ7kNvwE2td2g&_nc_oc=AdoAah2zWS1IdsvdFtTv59AYm7Ae3j4BLrnJCZDRtS45u0r_nFaM8fqXuysxSibox1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxP0kQAwUcQPqr7BYi4w3plJo5dn-FMwmCmZ0vazvsbQ&oe=6AA2B8A1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-eW62duUuwQ7kNvwFJwmWh&_nc_oc=AdrLoRq-GmMPHF7Q-jOzm0C8FPfLVtO9rwvg0oXSpZ5UH5e6_vJ3uiFRkMAXWxEXD20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0aUxI-drUR4D7xt0zx5gys6v8uCeXCNhAdYHgH5mNGw&oe=6AA29E91"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHBDBiA9Pf0Q7kNvwEGml8Y&_nc_oc=Adq2ak-0nXRoTRNr36lSw6y3zFEX9gB7U7CVl-jr1dNWRGe0Zx7KeIWsC8bH4kByCg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3AMHui6Dm6Fx49mqR9UM5oLT1ZZOZ6OkEY8qYN8VbGQ&oe=6AA2A4B2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjjCC43JUaAQ7kNvwFVhnPK&_nc_oc=AdozLP8FkY9k58mNSPmUeaJiza7_s9GnvVDbPBf7zAtc460Y42py67dsPpb_v6ytcbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1XOG0nqSspzLi0_L22Wf6WpuQZF5PoDvryVqmKoKPDw&oe=6AA2BB2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
te", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
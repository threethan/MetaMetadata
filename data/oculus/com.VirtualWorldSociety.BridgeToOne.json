64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqaStx7vp1cQ7kNvwEZ8skb&_nc_oc=AdoqT_0oPqiGutCUPUk8bMAWHEfHL5AX8oU1eJoA1o_u8fI7UPcQNyAs2CPq-tu-Tjo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxHHiTXTOrSJHTRUkjfeDUW-icTij-qjfBsdPleMnqSA&oe=6AB29390"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAkUq4wzJ90Q7kNvwEQiuJA&_nc_oc=Ado800YYMmBKrAu47KC954DXbPIcxiuMYtcWjNEMjEBGlpmfekoONwQanJxwqQtxxZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlJrwgfjq-OCEd1dymdyTWCdrhPgkrn2egLid5HI3y7w&oe=6AB28AA1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0w42Xf-8eAQ7kNvwHhK9Td&_nc_oc=AdoYAdWT7oq278T3ej7feiRt8sCSsaoZzn-HgwFRTHVu18GG-1wyDpEpnjxFVaCWW7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbzX0YazoJGK0JDna9l3ZjF8grWs76drypkRLsRY4Zpw&oe=6AB2A8D1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jldhryimnKoQ7kNvwF7Ua9M&_nc_oc=AdqHkkcFmuILIQ8jo50KwGtkaMIkfPI0OriCsLlosSHnUWw-DxSK7Oe5iUt36t7a9zY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY_24Sg5oiojrWpsc9debd_8I2TGB80fD60c40QNfjbg&oe=6AB276B2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKd_L05PACYQ7kNvwGtHJkT&_nc_oc=Adp1s_VEjIxpNhG33WSpory5UycLks8ymwavPBk3c6gMyFfDbvkx3Vu-KFX5q1dQhIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrjSOvLFCPDLbrFJSCxZ_hyuzfTvh0U0Pa49tG04W1wg&oe=6AB28D2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0EsW04646YQ7kNvwGEcZG8&_nc_oc=Adrwt_27YLyABVGHi1vNO4ZSBFIgGc6_vNfx8LUdMqawmxp9MHqaWL6c88xdqXMA19g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxbvIjxXu5TzryBcMyVbmf3EFYle-2K7K4dkBTL7AUiw&oe=6AF5D010"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSgc984zsygQ7kNvwGL-8cV&_nc_oc=AdoiBmuVpJfpH7pGjCpAe1cbcFgV0D6OChChHvF5X6Kki3AZIrMOtwbhEEs5CUpeUhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQXkhpiR5jE0blfTwHaBps2kspMwHlrlDNrdAX0_IVxQ&oe=6AF5C721"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ef3nr3dEKEQ7kNvwE0jCbL&_nc_oc=AdrhHg8p34-AQfS1u0n6YyY559Io2MTdS0JxHUTmRXn6tElU8tANvqs1Wt9ov1PXwWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDTPTrCqDJRxqrGIakgTvTH1ntMveQS2o6ROplj5B-hg&oe=6AF5E551"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjJdPptfESoQ7kNvwH9BzPy&_nc_oc=AdquZY6BT4GWkvks6TIVfJX6jj8_fV4e7i88HtI0ryssfEjN3ao8UeqBQQ8KosRUG6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5wPUR_8WtYMxV1T8x1UxXmB-Z4Y6POfLnNuivp_FDbA&oe=6AF5EB72"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2oXbK2mPVIQ7kNvwHoNnX6&_nc_oc=AdqxbYFaSisb1N3BQ4ZtL9o74VOcEaqSyp1EvLhI2whhM2KQWQuE_uQJPZtjdK7AOVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnxQlp0XXLAEbOUf2r6cPBbeTy94pbUyhew2GcYGyVfg&oe=6AF5C9AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
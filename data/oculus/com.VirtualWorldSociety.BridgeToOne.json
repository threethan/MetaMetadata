64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hes80AOqi0Q7kNvwGOfXYt&_nc_oc=AdrmzwwXI1eldPe5Xstw_ekZUlGPFim2raZrBDLadEcMR2-ABZ8z40hVDg7u6sw-P4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT0MMI8hGrFKD-A-eoHRjTgOMn512dpLD7i3OdkOcOcg&oe=6AC3B710"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P21F1uAAtc8Q7kNvwGYaEhq&_nc_oc=Adr9MACLre1VW4by1HR_9cyREXFTM3UCeek-orpLu40unUMrFEor39Xj9OjghFuicGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhRbgDYFk3bCOFPegWESQs784hMKLl-_RZchmdVy90JA&oe=6AC3AE21"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0qg3QXcnJoQ7kNvwHNb32X&_nc_oc=AdoFSzBn_Ya-vctQe6GicaViA1QKdIGzUV2scLXJcT1KE9qL2kwv1QzlGk47xZP8QbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgU61xAQVTL_xxXZJOwsKjjKoCbS5iQzCNn9K-EG85IA&oe=6AC3CC51"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUhVF1y-o-QQ7kNvwFDv4ZE&_nc_oc=AdqdzKY0CV6E8Jg6KSIoRbenCGFaDiuSCvHcUflLVGdS5zmIrqUg9cmZ56UqBXbBs3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzM-L_Jtlgnf95R29B5dUN_YMhRGzgRlq8w84Gf1qNcQ&oe=6AC3D272"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1pMLC4w7KQQ7kNvwHm00tJ&_nc_oc=AdroGVcJWgQ1RQuEDUzNVxBj6_SSHStR7Zaq-Lovw3xSLs2WUk057DuJ_Ox5wVoGAQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-4xKJWIVHQ66ODG669MyxmiyOy-8g-LTJ5gckkcHOmg&oe=6AC3B0AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31ue5aCqhtkQ7kNvwHz4PAR&_nc_oc=AdqRLSaWr-1QUGjmz_S9MoSg7oc5AKX3jPj8oZm5VCiqNQLxQ5odmMxfASHSOMgrOfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL28H3sFCOxeO-qwOFiDxBs0yLMfee7GrpdgyTQZ8JDVA&oe=6AA6B610"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzfC9ioezkAQ7kNvwECD911&_nc_oc=AdqyHUwtklqzHjk9GwNuckihZDO5ObT7XKdHQrsmf4qC0rI8X0_uuoPKsprHetSrNjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_NM_1jiTm6EGEY9KxbMEoEDIxNNWFQIt5hX8zoCuVvw&oe=6AA6AD21"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ysjIfTBvZ0Q7kNvwGViwSX&_nc_oc=Ado6-49en-zivkuvomTby_UPsgY7tlS3u1tq_3hDahzclwl3xx4I-9EkYxTtNHc63hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjRw-oJM7J8E8kHGufuqfzM9ksVjNGYV-LkBCjjg-5Jw&oe=6AA69311"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK338VyWjKoQ7kNvwHtSBeA&_nc_oc=AdpkUlFLfoXXg9M6GPIW1dPpZu7dMyIjYI4OyQ4ypKUURBgRVGMnkTn62-L2GR5o-K4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo-43zUWyQDFXWxg-amP4KeDiD1aAOzm_BJQwCzNeZLA&oe=6AA69932"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bUQ6gNYXp0Q7kNvwEp8HCF&_nc_oc=AdrpSTw9PUwvA3di-YMozWLuZskkPbuskIs7X_dCKFBs-3FcHR9SdXxL01xiJbrFvXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKcRueO8lZauokPT2mg5lFFPbA1HAhYiExwE2NuEaxBQ&oe=6AA6AFAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
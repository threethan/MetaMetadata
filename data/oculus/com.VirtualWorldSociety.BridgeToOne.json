64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uIGmS2_cdUQ7kNvwFJ9n56&_nc_oc=AdoGTWNkAwf8ZlTkbk2BdKoEVEDu8h4myadSSM6_iubJ1jSdYmDi1z6z72aAxcWLS6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtLZ4t9ScJdCMcINfOgGD-0O8xF2KkBBTspPYcxUKuLg&oe=6ABFC290"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td2qZYg4zpsQ7kNvwFB46iK&_nc_oc=AdqksT_JjI5kBGQw8T_l7epf8YUz0HdrHVw-6jEZh1FjCo7NGYm8-i4iyQe2Dc8uvgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMesMqUAmuHRE-4j6nlH5fC2j0t0JR1ytEfaoTghBoyCA&oe=6ABFB9A1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpMGtu9lM1oQ7kNvwECcfrv&_nc_oc=Ado3ytX4bapanvXjSfbSZLhWIHUiciBeF8uBJuKi_nfh5_pOU6VREa2YvmS-TNPew90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0gJreLdb7U1H770LRMbxwol0T-wv5VggqG8HDS5OjIw&oe=6ABFD7D1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFNJaYnPESIQ7kNvwFRs5AE&_nc_oc=AdraCNAKGh5R8AL3veT-z5CBjX5wr_pBIXYZYk2Dn-wmPUMH95fFRicoy6xJspo56gI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcpzR9xtKF57CYFg87kq7A7QPOHLEnlDghEyCXlRxbRA&oe=6ABFDDF2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UInMQkj7_oYQ7kNvwEB2YQ4&_nc_oc=AdrS6ww4MbkUT_g3TP-C3NifeyUV16V_QQmckFCr1xOwfnrLyyPNOGed8gZrd0l7YFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKVyUGiZHWa8oQbftyYuPwplAuSN7wgWgFu23-2aE_7w&oe=6ABFBC2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2nfBOVCPsQQ7kNvwEV8QjA&_nc_oc=AdokfDEJZD6AMuWmELtrqGGGaU_qdlkwFaMrj5SXxohOIl9xL7lI_devIECyMBn-oRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhJMyK6kCPES5--u69e75xS2CJs5ggZwadZx16w3O9qA&oe=6A95CAD0"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwoioWQFLIMQ7kNvwHcFHwA&_nc_oc=Adr5LhFF96rP4EQJp1YWlXGuVTOP8Jur7Aq4GSJP866dMunDX44zzgslX-XXAd8cGs4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHid_iw6aWAaYhmeTBIraB_AekYYf-Vte0KHYaK37q5Ww&oe=6A95C1E1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6CY-YhM0IwQ7kNvwFBG0nB&_nc_oc=AdoYIX4ic7_9C2HNgAGnalZAEJdY6i9udG3qhjUWck7yJ0adtaUOhXj2Xm94TXpopKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe6pDpbnW7cR0l-nwYPNdi52i9ImEY2PU2WKg_oo3j0w&oe=6A95E011"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV8AehB1SmYQ7kNvwGvfI4K&_nc_oc=Adp1q_BJmv8xFXcODXVmR9v_AfEnWjnvzA9YAKUEIh8ZnJaLKmzcqBPjdJFhfSUf5N8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9U3dbJzRwEIFFX3SElR1St5vduueCZO8xKhYN1fh1bg&oe=6A95ADF2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jicvf2BVITkQ7kNvwE1QM6-&_nc_oc=Ado0jbQZeCPowvT0zgmxEj58K4N-OYfeS8u8jJ-3aXafAMv3T14iztgX1bq-TlY6AsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDVjAd8PnhrfpX0W6r3HyXJ5J3HbSQLIfGHqAGR7qV9g&oe=6A95C46B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
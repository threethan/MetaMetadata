64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs7j2dzHi-8Q7kNvwHiKYP_&_nc_oc=AdpmQ_4-ckosFUuPuFjxPBZUC9eXc6f82r7a2Mjhgg9dErJiXclyKXK-OZZoSpRWgdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMe-p-SJHzGPBT3JAN0hj1nGf9jzmSfao8_oc7VRLhxQ&oe=6AEF3890"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzJXP9U7uRUQ7kNvwFELQ6v&_nc_oc=AdotwB9GBSQX339o5YgrpIGrCQGww801HAoVyOizp38xshmdYQO3xxnQ4ajAbpHZ-Ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIRj43HGi9r5_-YH8IItRf3WXHcw4NZ4YniSCon5oziA&oe=6AEF2FA1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrGwK2iEFgEQ7kNvwFnIqtJ&_nc_oc=AdqXCU4je2qwyCQXrT7iuTZ2ZKoz0493u99kMoJ0jdd_yelXsCWJmvKbID72eUlL4Pc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnM4Y79ituH9Md0Y9X4nQN4ATv5JqWeVlVzFGUcxdkLw&oe=6AEF4DD1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2Ahj4wUoUYQ7kNvwEbZNC4&_nc_oc=AdpBiDyDW99BcZ3XzEOaiTqZSxe1olhGZ3jAW0LzLLMTbfR0cyep2U4H9sxVNvO6mxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYRY2KCLK05tVBq1_5QTMKB9jM0aQ3LY2qXfhiPT-pTg&oe=6AEF53F2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmztOV6OI64Q7kNvwGwhZdx&_nc_oc=AdqOkrab9eEiCXOGoIxvaQGz4IlYqoUbtH5b66b_4dHUT9fBbEEAPmVAOdr5WTKrnzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFuM_xZblk2YEHN9UCugjPBaF8Cmj5_M9lAw7bj4CN5Q&oe=6AEF322B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
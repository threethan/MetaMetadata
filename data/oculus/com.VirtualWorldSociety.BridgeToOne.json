64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SrLGK0wPPgQ7kNvwE-3Zho&_nc_oc=AdrdksSArV4hZsGuIpiJFiA6F-Fh1XHP5YW1X1fpkWyCHkj4v2isGdK0zw-CYc92e_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiCD998mC2W0hKZYZUTcyFihCeNYT3ThkbCcPQBPGsXA&oe=6A9ECD10"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5Y1xwJhjGwQ7kNvwF9iiKF&_nc_oc=Adr_WVwpv3CU7oWjJdpkLE-ueeiKnZPNoWbfsYI6HWAOiYldO4OCmEcQWsxD7KqUBZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdWMYk62vMWhYR3UbB_pb-8Ls9qD99qeAKyPVu0BkxRA&oe=6A9EC421"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ndqIMf31PwQ7kNvwF2pEQw&_nc_oc=Ado67QOeTGy0yqCipQZTkT652LFKBfoBH_JRBQHuuVpVgLR9fyl7YsKyQS4qLcycsUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI13MgfaJI1haXRR1VF71RV-ofzXs2Uo0L5duqYE-f-tQ&oe=6A9EAA11"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZv26Ico_T8Q7kNvwHNuUgo&_nc_oc=AdpWL2-ez0PaGUee4vydF9WvnfBbqJgaMoHGSvxYpHkLf-0qMRjj2lWM3xn5tDzPF-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4PEraFY2iyEZVzz9_yeivBKViA-FjdFsB3VyxQtOBPQ&oe=6A9EB032"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_x9x2-CW_AQ7kNvwHc7B8x&_nc_oc=AdpD93S3JqjB7J18QZsFMcOnnLoLLz5GSOTbi4_gxMiTV9x4hDHPAn6aBudYUOakZa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHsFHTsaFH-K92NbWPV1hAPZR7ot86KOI8X_J2RAqjOQ&oe=6A9EC6AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNgoswKRVYgQ7kNvwGGNzx8&_nc_oc=AdrzmFV29OE2o8vGVD28Ei53fkC8yvdzrRjLHQ1Sa0xGx_gQ2pJgwBH8R_uOOQ5jTk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4vSDJGL48cqfVKScD9Hu9_jnBQ2ropGS6mdb70oi7Xw&oe=6ABD1F90"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJDsayMza1gQ7kNvwHJ_klF&_nc_oc=AdpYweLqAFEocljOuaLqs-zph_cAYzfuP2D5wSNHcxgDK30ubDUrLXfOYjYIOY18JC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFtzpP7_ZJWQUOSV3sl9twv-TbG-iOkEaw_6Bm8Ujt7Q&oe=6ABD16A1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpMGtu9lM1oQ7kNvwE0XnZS&_nc_oc=AdqhwhyQ-Mw-JjsHAnaq_ZW7jx4Eu5CI__fkQonrbZLZ3O_o4Nrr9907relYw6TUUvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZwFgBxOWFEENuYYZdyEBjJtOLkqeMmqBmfJEgpzGHgg&oe=6ABD34D1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6KeeTDwrmEQ7kNvwHIJpJf&_nc_oc=Adr3dgbR4_DJ9o6PVftAX9U9SFOyOdWYFxkUeUV8N2m7uULSdwXGXzsM9TikTysE8E8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHsMK2sqCH7OAXaxa6LQhZ_gY7Zh7hlvOIeJUzF43DqA&oe=6ABD02B2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw_zgBtiGSQQ7kNvwEn1TQw&_nc_oc=AdoRlohkfopVRnxukir41gVB_iiCAtPLsu5NYdfHV2HuICTHb5jzWhyMZ0B0Cl6AoV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDzbBZ-QQD-9HmQsCqv-7Bm1ZwPvbHMqIHLguhu6k7BQ&oe=6ABD192B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
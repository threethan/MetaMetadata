64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNgoswKRVYgQ7kNvwENkpdd&_nc_oc=Ado7D_mA00AuTNTHn3NiDPBri8iDBzDR2ChNj66Y6oVJSepP9MFc9wogCmnI5eXQnjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5Y019SeS208MsqSHOi0OWsH3ybBT2wLqsdkHRYP_Cqw&oe=6ABBCE10"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJDsayMza1gQ7kNvwFBTnf6&_nc_oc=AdqIFgaITJZUbs_0baMvNZIIjx6xD7iCbduWKn1qRWbx_l9gAKqeYPcB-yIaXsIYuTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOmoKDL97PEYyOjHveLMMhl59XuJfnQdIVnsb-Fz475Q&oe=6ABBC521"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fMp4hVNcfUQ7kNvwEuQC-P&_nc_oc=AdrOywY5PQY0M6GA1UzUtofMYDZqKKVx8DY3PiVpwj09b3rnve6WD96yrLxgRos_W3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfs--JjcxmAPxm1r11TUQkRSz9OSFGIgHDxfcuD3AFFQ&oe=6ABBE351"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6KeeTDwrmEQ7kNvwEKFbZb&_nc_oc=Adr1YjTzNsS5CJa9AHuRs0prYxXEzwrq1F7GuzRP7NtqJM1jlxXuwfQbcPdSRs1FCmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2Ax2UyPSKqe69MvmQNod_Om1WopvDAZbNcRt35Z1uqg&oe=6ABBB132"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw_zgBtiGSQQ7kNvwEEBM6p&_nc_oc=Adof2Rj3rAqNRBd6qFlY6SPGCXo292wDaCnbcSUnV8fErn4RF2Hyha4PX2ChqOiSrA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbs71v25V5o13Wod6vvL_Ou9rKRfsEk19CDOo_-sH9IA&oe=6ABBC7AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfO6S5ckFWAQ7kNvwEydjCm&_nc_oc=AdoFJzHD1kU1dQ9bSGXnNF30ybtyJ5oGUKXgWtNsqARUgb3MqvsaNJl6q-g6mp70HSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGJS06HGIbNguST0W6OHpaT-tSPjZsvYt8nFqOpPfi9w&oe=6AEB4410"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygy8VyVEldEQ7kNvwF4eRo9&_nc_oc=AdrI54CBNvqhOXUVBRFYtafyvC-D33PYD9W7MiMbnbQgfv3WUtnwe5Epjfbhih2Q4fQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV8Onrvusa2gMC3U5MLoZttaSDWrpxDm6E1OhlmYzvsA&oe=6AEB3B21"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwI92h40BuQQ7kNvwG6ZMFP&_nc_oc=AdrQAkCeeAdPa5l0cVRabjS3DAyfbCKx7I99xqtiPFY-8XSiCRyMwiBHJFd_Wu8v_sE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkKACs3bgU1irFUwB4ih_NX9WzgASz5fUxnIuDw7XNSg&oe=6AEB5951"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_NOq7qDB1YQ7kNvwFf_bGE&_nc_oc=Adqr688UZw8FZ0DfDHcSeQDy1zHaxwRRQ8WCCjClstJVLtaWXBq5HdqT80Qk7x65Kzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXZ2rfneqQh7QBkKy8yilv9m7cbtBei0aOAImIyDCaNA&oe=6AEB5F72"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB3Fgc_Fj1EQ7kNvwEfP2JY&_nc_oc=AdpjpG8P0YVmCzINB8wth61wT6bTBjwenh_0JWJ5MPir9VeviXQRCs_enKqY_B4pWok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2hXb99pe8Y0hW-F0yM_AtHARQvE0ijYa1JREknGldtA&oe=6AEB3DAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
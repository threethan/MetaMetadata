om/v/t64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31ue5aCqhtkQ7kNvwF_eHp_&_nc_oc=Adoy8_DEh4yuGqN9R1L23XdfzDbgdO5VnX41r8i6T51XYSLg0Jtz7UVMPedBZX9XDVg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkcyIwTkQeFrGRbjw921Tn4ed8G79uLx7MupElPr2iuw&oe=6AA41310"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzfC9ioezkAQ7kNvwHtGLZN&_nc_oc=Adr8pKat6aH-M8c2y8ewSRvpaBSX-JaRoj1eKXytnkej-IbQNbJnNmLj0n_cL1fR1-0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4wyrW6E7mnT3XsejFeEByVZX_J2Sn4iItGm87bW3OtA&oe=6AA40A21"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-eW62duUuwQ7kNvwFgJMph&_nc_oc=AdrtF9T_0xc2mP5QdKgpHlIh4oPzkCgAWeQKmA8igbsfKOCC3vWKSJBe7jUhETIqjgU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK08lFq7lLKDyPr11FczmM_eH-74wTVYeGtR86Uh8Io-w&oe=6AA3F011"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK338VyWjKoQ7kNvwF39eUU&_nc_oc=AdrBZVoogcbOpgdWMyJf0CZTcMm70mLRSvqP3Yw9RYkv6J-99Ee8RnGzJ3sYIUg5Vck&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfbX-SWXo_xTU4-wcnK8oCVCtrViXVNP81Bp3U3uGG0g&oe=6AA3F632"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bUQ6gNYXp0Q7kNvwGbYIxT&_nc_oc=Adp-WIABuzojGxtaaxcXTADlE6ZHQRavZCpES1ZBdMpsaFVf9fQqzZrYUs5FAg0Lc78&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8dLbnjGz3_bi-5D9NRqx58Hfs4o6TpCaJjQhpPbGJwA&oe=6AA40CAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "104310754736248
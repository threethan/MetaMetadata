64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjmCGihtShwQ7kNvwHJ6S1v&_nc_oc=AdpobCevn4tv8iw7uRe7-HY9qOvVo1DAvzPJMgrStT4tolChkEzSY8BxVThAaAQ4MOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCaUjriPXSsHKDk_5bDHVcm6ZCnfTuNcd4iTv5s46-oA&oe=6AB3E510"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfcdr1gpaJgQ7kNvwF_DBL_&_nc_oc=Ado3ZX44VgB78u3Yct8is1CyVrQRKCGLelI5A6Omle-MwnoBBZeqk4LgZdsTO7Q7rLU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg36i6U3mmlamjjffVkQEJJVVnSfFJCnUaHEj44yvM_A&oe=6AB3DC21"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0w42Xf-8eAQ7kNvwESqJpy&_nc_oc=AdpTqTNPs6qAM9YMzy0QIBoec0ElPnCq5Xt6AIawg3_EmZx6VEidPoIl9Dm8O0rkkgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUZNKtQDE_xPcut8bWtV5KxAM8E09OyHgYcKFvtqnmjA&oe=6AB3C211"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L82cMvlXIIQ7kNvwGI3nDi&_nc_oc=AdoMW3xbOCczOAjSf2r5dGKI8xiLWUbJqbI8SxfL5lNl8Pf_R57Sw1QVHAXHsbDa_c8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLViuf6MhXjrWZt6YooNBTzM8C2g2A1pSygIJLXSdDZmw&oe=6AB3C832"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZuSTQPcrdUQ7kNvwGThmJF&_nc_oc=AdrC16BUquZHxBfKEJSid0zJ4SX9kO3Sx7pcrA-fpOcd3GaEt1xoDrnAvAH7YQrsiTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMcCMsL4oz-Dwibk7YYra7fWMY5XU02-rk_g738Tmmpw&oe=6AB3DEAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
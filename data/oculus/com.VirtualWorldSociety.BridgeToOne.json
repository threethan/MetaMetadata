64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rioVq6xbUnoQ7kNvwFCCCSw&_nc_oc=AdoVVksc6MNlRWrF89_fHhk21IS8SyfDo2qjZwwFkoQ-LHe6WqO8L44T6HFVLVgYBTk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnC39v7ZvX-2lakadMzWFSVyqcrmc5MPBYdeKDAvrJhg&oe=6A9165D0"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3FMSzQ-oXQQ7kNvwHRH_Fc&_nc_oc=Ado6IBHxvD_IEnlyZdtqzfzQgHByOmYgenyO2WdbwSs08BqdcLV3C20czPFzMp8gmSI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETKFG3otp-vW2VgrYL0zr9yg2NPAvGpJp7jT6eMAWzKw&oe=6A915CE1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S_FQvYdY0IQ7kNvwG0JJ4P&_nc_oc=Ado7TLbM9re6vifE5ACwyUTXG9ivh8UZ8igCbPEE8xw9gqU27i-MyWn5LBvRAgihG5U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBo2FRq8Q6R3QyUHDNrxiZyfY_8RGH97cHoPZTCWPOAA&oe=6A917B11"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRateIJsWmUQ7kNvwFfVNsZ&_nc_oc=AdpffYMYmMNtwVAVMA71M22x0BBJ0Az6_pQVSytx22NkAyusLkGLOXxB8oXbOv-CT4w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzKtFbjSj9rUuACVA0qOCGMXr2v7rg_zZgp8ZUaASzCQ&oe=6A918132"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG25bPY3vYAQ7kNvwHPgO6e&_nc_oc=AdqNn5tYAkaaYCdEP1V0FhlBoyaF4vLPMIH3kmO023BN6KFRan3wBGe_JTWO9upI8S4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZx09a9lAz6ehvi026heLUg0OgqpXXJ3Xc8oOVZDpPlw&oe=6A915F6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpJrhKDN604Q7kNvwEzXnSA&_nc_oc=AdpoN3_TlDOAMShIXefrei-xWSX57EutFrw4z2T8_iPoh7o8Ak89Ns7ARuzRxKoFByo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_GEjha67ppMb72KmuUk4XniVtb-MMViS2kLASHh7C3g&oe=6AE9F290"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTqSCKLvPUwQ7kNvwEnl9-n&_nc_oc=AdptvvLHygMs741VnnsnLhxRL7Kb3tBVd6tSRR40BoxP8lf9hmZMwNKHT741j4Gk42Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj0EcAQiyO9uk5PBmSctg68dSrnckGlxueDsYWqEvvcA&oe=6AE9E9A1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwI92h40BuQQ7kNvwE2TPcI&_nc_oc=Adoa-9gENXP5THitba-NcqHi8Tc4hJJM-5attZEKqlWwETJa0lw51nDtGzEufKY5pDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5bWGz-jgE3QKoU0r4EklanDxW0RUtPi1QBX-2igJ8ZA&oe=6AEA07D1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVH8gWp3kZ4Q7kNvwEOYovB&_nc_oc=Adq3-Id7xg_zaw3wXVXRfM7iqqUUCiZQ7_84r5QIOjDLJ5LhSrxVEtQXyZwvgDLRR78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgQsJvxH7F76ecv0YA0Q8ONUqueMCQd6m1HGy-sFNMXQ&oe=6AEA0DF2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn9GN7Fz61kQ7kNvwF8Mp28&_nc_oc=AdqXg7R5242nAP1_LFFDiqDNueoyP3Lt20-iFpuA0kFHzQEcZjTeVsSoXiov6NmNMOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo9J026Ph_n5yHnGxWX_MklQKj2B0suWq3nwyBShjfRQ&oe=6AE9EC2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
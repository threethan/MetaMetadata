64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNx-8B-PjzYQ7kNvwEkAODu&_nc_oc=AdpelxB41JBHOuLeZr3FIC9goSLVfECtkNbk9uKrwwHyJj0Px0MkA-NZyhfNppQcYY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlvswTNgGCUBXZ0GEQWFcngTMY0VpGJjsOX9LQGireVA&oe=6AB7D990"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya3gRbSTQy0Q7kNvwGd9O_x&_nc_oc=AdqAYQBY4ipYRXMOTXCLCYmNoeHNmxS9Y3D27Ax4Zac_dxBjFkyom1Qd845mZ-NOTeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFCxVBgAU66Z8JonVeS_Is85mI-tNCCRuy-z5iunS1og&oe=6AB7D0A1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTbgbAQ3lV0Q7kNvwGiC70I&_nc_oc=AdqfZD0wXeCb7YNWMgXzo6UHIdgapEZlShPsyErudoE3IWccLiV3nFFmkmSYN0zEydo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmqo87j7qGcPwvFtVRC50PNxPlsT2DmPAazk87wvPDVA&oe=6AB7EED1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TK2NmYAWpv8Q7kNvwFKqJ0o&_nc_oc=AdogXXO4Na7nsD3VKmpeWuNHrwuN3UsyhL4835wZWl4Qf4mzvovqYPmdSDrOjX_DbLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgODiuO2exD9yaD4MapVywtxw9KlzPuc0tz9paU8C_yQ&oe=6AB7BCB2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu-_1Vfnf6kQ7kNvwFq3lZZ&_nc_oc=Ado33MAGwZAwY_wiycmgX2CBW0DSKjPYdoJzUGkknTR6vdhJhyVGtAYLPVwjAKI2vDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBkt8iZgxa45xiWOTVHTaFsOODrgS00EkAX_3hkQz2oQ&oe=6AB7D32B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
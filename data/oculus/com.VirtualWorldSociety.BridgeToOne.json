64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiFPHiHBYV0Q7kNvwHrToz6&_nc_oc=Ado0vggdCnoGEI3YJVOZjAV-w59LQZlx89cJUNNFExgkyzFWKlcQtzdb_-Rr2t9ptQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZKkfyXqGjLRb5YSSXgwh3dLGCozPqTD9JL-9mJ-u1-w&oe=6AF9C490"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kdLf8W6FOwQ7kNvwELjlmG&_nc_oc=AdoZPAk2VwATXJYAHg_9fIyDIO9ffNKht3FjEMIczadJ2Dq4w1JdVUtODV66mVPDd4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmF4QQ8gHVH8mWC9_Ju5b-Bs3MW6rgVDmykSLIySXxHQ&oe=6AF9BBA1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAoLvMLLYO8Q7kNvwHFNBZd&_nc_oc=AdosbmfbUqt-y7V6BL8IrNWuf7jSbywJfGXBkDznvomEftzCyBr_uD0KIIHZHW3B-0w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW0yWGgASPeQg5sC-936nJc6TsApRU6L3rJsed6ooImg&oe=6AF9D9D1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMYgwAtkA2IQ7kNvwED_cyy&_nc_oc=Adp_T9d0mSlcymRDy44vZIUDHNuv66yhUU9NW4-HStTtX6EAN-Fo8_LXcce2awzVJb4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwuymArH7WG799_wvld3rb4AIex-MCJfw_pp0VhXKRaA&oe=6AF9DFF2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WWY05dxX28Q7kNvwH0G0y2&_nc_oc=AdphmS8LEkgaXSlVBTVqiuYoukww79jWIUdUPY4GhnDFpJYruD6o_ZM-KmMb-ORhtZw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVkzC00hhh9rFSrKSihuwrNIS8GEkiPETKVDqvsMwXpg&oe=6AF9BE2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
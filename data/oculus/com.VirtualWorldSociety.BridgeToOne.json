om/v/t64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vjcdRdFZyAQ7kNvwH97ro_&_nc_oc=Ado5nuBc0Y_XfggSFTT-mPADrqC3FWCpmmf2b1ZBRGZ9jsvJ60O6MACEAUAVgzslyq0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyJPnURJAjTIADCELVOW3XZhWrxhZxVMVEYNM0n8eHBQ&oe=6AA95910"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO7qkSlyTKEQ7kNvwFy-bJg&_nc_oc=Adrn88IiL3ZtN0DJ9ZMpICGsizUFBctwxWiZqEJEaKHmXkF26j2swgem5Zh5VS5I9Jo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG2Jbm7VZ5-gNOyri3lwiRJdHomxaCoCM03lUHquf2tw&oe=6AA95021"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RL6qB2iqRAQ7kNvwEDjld-&_nc_oc=AdrMb5V-aeporVRY-oc9p1kPdnnACUmbict0rNjHfkhMaZeW051BdGrCEn7ragVn81I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKFLq7lxwHPDPmHPBQARMHz8k21pfRZW-Lj8tGL65tqw&oe=6AA93611"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4tmOqnewUYQ7kNvwH5FSeF&_nc_oc=AdoKDRCTcp_CSo_qTJFsul8VSWMc6yZts24GuyxQcFbbxMmd5i1d38dtzNSXdtIvylo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwM3isxp86aE_L77JkTrs97ar88qXeO1buuB2y1qurpQ&oe=6AA93C32"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuOK88vUsVcQ7kNvwG-b6ej&_nc_oc=AdpYDWI5YyKqK2DR1jVMDezrIafQzvG9Htm1zUolK5GY9u9SglSKoSWt6NkH6yCm9D4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO3WL01PdZc8RV0wNpTDtDtyxym07QoFqWA13uItihcA&oe=6AA952AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "104310754736248
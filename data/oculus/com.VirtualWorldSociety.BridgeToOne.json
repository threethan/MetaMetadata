64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHil2qtJQLgQ7kNvwFExArv&_nc_oc=Adqsf-vyA5pP-83pWeQ-sd1jWT3hyGxSMbI65oy6lJP4jT5Rz4ziOLMj3lCvqsVP2qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3uyEPEhOIDd5_Z_gTrElHDc-2YnfjT68pEDoPQQQ6ag&oe=6AABFC10"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beUy-qsSPOoQ7kNvwH6Z4E2&_nc_oc=Adr_HGqfLAX2N1AYSP9WH0OCZnlpsJaTmrbwI8JdlR0QguU0mU9gTPWOIsS_Ld1906I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeDOi1W1uLW1pTw8A7y4Sw6KiqpleDLTwRy8tlHac9VA&oe=6AABF321"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RL6qB2iqRAQ7kNvwGWWoyw&_nc_oc=AdrR8wbyzFhKiBoBjCbWKSL1Dpg3Us6l939D57HeUIGa223bFmNHD41ngx4ivaRd-cY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIg-fl6ThYbmqbH3YoSoiwHE7_ECmbcG6QTk5eOZmdag&oe=6AAC1151"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHSNvD63fkcQ7kNvwGdMHoz&_nc_oc=AdpFAkv_5L_3cJyOK3t_eeDVYvNrjQAFCB4x-6p2vJbffhdmhlN2KLi_nRbKDn4jAjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF2Gz9Ah1LBqZoBXnTAEprM7OGelepSVHd7TbgQEHsfA&oe=6AABDF32"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJktwM7qgLoQ7kNvwH-Q-M1&_nc_oc=Adpk2i6VSUfsz57s3nPI_pu6JdUR9ayCKb7cgxgsFwMrvYEUiYaJeGmi_t8sTmleTNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzU-JGR5rSBhkynwNX-zlKarzXOdjuF2-bXggvsTxcsw&oe=6AABF5AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvQGLSFRxNwQ7kNvwH0I6qc&_nc_oc=AdrwXNG7QHoDUDLWqthPRNqbZUYHhye74HRo2PDf3SOhiTQfCm8zm2VINsWlo_PnxN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU7YBv94iK8Re_paddv0ISKSsQt37LJUY4jcZgMbduOA&oe=6A998710"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO4Or5NvwUwQ7kNvwHYoExR&_nc_oc=AdrYTrGTs2PoPflN4bha4ZSQHTDO87pYdqRUZ_fEx3ZGUDhnXT-FP5RmH62xI6vQ7GM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeH0wXpz4QkYQcIF67o5xeT53efVF8h-eAUbxtmoGtBg&oe=6A997E21"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcZPoGjxPpoQ7kNvwHkpOMf&_nc_oc=Adp7f0nn7X1D3Q3UIb01IZM_bUXvrRmgxoOov0cv2gfHwgNOfXDIY6ueO5is12UZ2As&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdblYcEbDnxwZhrLF1hNyL2d2IpUZJQJOfpk4vSbJR4A&oe=6A999C51"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lRGE46nhn8Q7kNvwG2GI48&_nc_oc=AdqPeuoHBCPdtEYR60MWwN7STiOPWS7SQG-ttPcza5c-LXrr9O8p_R4_OE-T1VTtzNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1WB_mQ0QfOqRiDZjdhCO2g9Bp38lQRJfYGKxvHFaF9A&oe=6A99A272"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYAs_qgM9iQQ7kNvwEenK4b&_nc_oc=Ado_OMypqlTobuZGa1DV6T3zj9M7y44KGTO8EkeR3StW9s9fYJBg-0Qxd1M4byaMf88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqSxVgAF8NsntGFDs9-FlJfwRGzGqGyNe15uOm8YWxlQ&oe=6A9980AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
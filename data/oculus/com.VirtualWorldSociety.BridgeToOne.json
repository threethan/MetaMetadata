64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqaStx7vp1cQ7kNvwEyV4pE&_nc_oc=AdreOL_5WdcqgmG4WGJ4tPl-CteOLRPAJtV73apgwl4sNf_4Y6kPvoqI7dSRv_kPK3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJXhNWz0T23IQrJ_6CUzOF8zYKzqWBWqciZSzSKTKpdw&oe=6AAFF090"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAkUq4wzJ90Q7kNvwFt8D8O&_nc_oc=AdpOWkUtltBMpDSprtFockDtcIfb4vK3NZMD5GZm0XDeBrYXegyBimyCfXW8p4tYlq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1EHHkMr3ArrWZLD5gqt1vPbtQqOBWYLHcBtGDgPpszg&oe=6AAFE7A1"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdreAMksFPkQ7kNvwF37cDC&_nc_oc=AdoSgy4Ah0pgxDZ2h3Si4KD32pyLxvh6IYWkWe9eeT9bM1wWXYvOSWl88sn4IMMG-WA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITEMXsAmdvWDzAsWYAOsyH6oIj2u3VfjhamujuHHa22w&oe=6AB005D1"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jldhryimnKoQ7kNvwHOy58y&_nc_oc=AdrIVT-6ohggnrjrsECEp8IQQXovVASMii3TE1pPK84XsgyfT7kUtf0EHEEaVhoUAOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiiL21BOMPJOkOIHJ1TVQN9XFJoPM2MjDd2_yxTLArKA&oe=6AAFD3B2"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKd_L05PACYQ7kNvwFeimPq&_nc_oc=Adri9xnw9UZpO8ANmGvIR-yQ5wqp5RwP8QEjAxBiq7oeBcu3iv8geBmJ8IEqAHRSRrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCa7vQC9M5Bzc7cjeqAT4P8etTfhuIHUvFBwtQBOvUPA&oe=6AAFEA2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
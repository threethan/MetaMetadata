64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SrLGK0wPPgQ7kNvwHF7LOq&_nc_oc=AdrvPiGHnPmo2V5vu03cRFF9ORD_SpaRttkkZyFrdhvzojmMUh96uqgKMsDMN-nIs4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzAWHylzob8WY0dnCZ_3LBuiOzPlPUNDrIzVi2gcEWiw&oe=6A9C2A10"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5Y1xwJhjGwQ7kNvwH9SAsn&_nc_oc=Adq9VHFXWfTb8p5RksZ57yN2D2rfOFIwurBvmjvebTgonNAfseKSbbJQfqvnLtaOJnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYpI2XnRxsQAy1J4sAbC4iJyH9O9v3yKqoxrJoI6zHzg&oe=6A9C2121"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcZPoGjxPpoQ7kNvwFrgy9h&_nc_oc=AdqCQDaOoBckeT9sw_CFCegZi3gPGrwPnzhEO647jIzQGtAottzIXD8HIPABrhuQ2hE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs7yu5D10B7ECzdVoWbTNKFxlXl1CpGvf4KYjHXiDFAw&oe=6A9C3F51"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZv26Ico_T8Q7kNvwFl0bNu&_nc_oc=AdoTPukWl992Q_9wo904M60mf4p_AUZUtEQkeQIIrcMZ-jtgQ2WJBueO9-gWwb-Om1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbMdtKJGpIZ-INa8xjbE8-x1E1PTW6spPlUS6nu5SI0A&oe=6A9C0D32"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_x9x2-CW_AQ7kNvwHrKe6_&_nc_oc=AdoC8r016djgvL0oTPjez3wUYHLQs_2FF0wHnhDPwM0EGBQ7HlWTO1iszBvqcFwBBVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0S2vprHff-qYmWipmqZ5-LxNrXGWYBu5PjSkQ7kO9JQ&oe=6A9C23AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
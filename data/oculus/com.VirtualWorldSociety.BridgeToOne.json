64.5771-25/654944867_1002489272707428_988458451664475422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOOpB0dMElcQ7kNvwGVkevK&_nc_oc=Adpg2IelvSGhaU3MGTim2pnOVSgKrAkA3Ceio7-axw1X0Cd4eq6vGN9qk_66MdYNI3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvtJl7sSLtWwYCHtAyRACKus9tgOcbHcyg3-3YRSVoiQ&oe=6AE5FE10"}, {"file_name": "Screenshot4.png", "id": "1525445635808560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1525445639141893_1867349095980221923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6IEVxZaEZ4Q7kNvwHtGeSL&_nc_oc=AdpxBfRqeG3SIaq1_bynmq7X8QRFiESdwwhug0ytT3ypw1c-Rblc5vwMyK6EgAoyxjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-yJ7Jf3BZHi4zawC8KrUPOKAOME7iSlLxgpZnjwLONQ&oe=6AE5F521"}, {"file_name": "Screenshot2.png", "id": "2061999304689376", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673554902_2061999308022709_1356439841018501266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUdV-f7tMGcQ7kNvwH_7Sfw&_nc_oc=Adq1HEoN4d5Hvu5BFBhilLBKIKVjos_U4gDT9SoCbkZ3JvxDha8ZfV-qZjawr0NDQXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvMZNQyqX6uAUxeJ2TLt-YCRyoNm_oxW7uSwwZV4WoHw&oe=6AE61351"}, {"file_name": "Screenshot3.png", "id": "1317569140485851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1317569143819184_2032372704905053837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upnE7Qr4ugoQ7kNvwGg9il4&_nc_oc=Adrj9FtQI8tQ6SxsvHQiXNP6ah8VSt1Wa64COfW7BRCI-WCaskCtnVxDSaJapiHgr7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVAzUb24bS7Yb1zM3thre-ZKWypq0PHHrEGRWJNoxkQg&oe=6AE5E132"}, {"file_name": "Screenshot5.png", "id": "1334999902070550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1334999905403883_7825560239183096548_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgLuSnN6scMQ7kNvwHB2JaZ&_nc_oc=Adqtr6iw4WYmPUsx6HOKzv7kRorDRF0iMhGiLnVc5ceRA2rQE9idl0OM_nO6Lk-5mJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJY4S420m8MUEqmvqm9fdszQIKFiuWTZ7wO2welseqdg&oe=6AE5F7AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Bridge To One", "keywords": ["future", "climate", "education", "storytelling", "experience"], "long_description": "Bridge To One is an immersive XR narrative experience that places you in the space between possible futures. In this 12-minute journey, you witness three paths humanity could take in the age of advanced AI: escalating conflict, deep social division, or a cooperative abundant future rooted in shared intelligence, restored nature, and global alignment.\n\nThrough symbolic interaction, emotional storytelling, spatial audio, and personal reflection, Bridge To One asks a simple question: what future will we help create?\n\nThis is not a traditional game. It is a short seated experience designed to inspire reflection, conversation, and action around AI, cooperation, ecology, and human responsibility.\n\nYou will move through a guided narrative, encounter contrasting visions of the future, reflect on the people you care about, and make a personal pledge toward building a better world.\n\nThis matches the design doc\u2019s core structure: a personalized 12-minute Quest 3 XR journey contrasting war, bifurcation, and abundance, ending with reflection and a pledge.", "short_description": "A 12-minute XR journey through three possible futures shaped by AI, human choice, nature, and global cooperation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualworldsociety.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual World Society", "support_website_url": null, "website_url": "https://virtualworldsociety.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "1043107547362485"}], "e
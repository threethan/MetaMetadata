z&_nc_oc=Adn9p-UD_ShCk04DLeQSTLh67k-KFZbxDxytDA-6_T86HGrG7eWtq4d0DQz0CJLk9tM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQbRh6hTggFPuK5aML_9K51hreOsLnsnyruXVADOpkTQ&oe=69B80EC9"}, {"file_name": "Screenshot2.png", "id": "350417259296743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035330_350417262630076_6427657377949399763_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya2r097U_Z4Q7kNvwF2Cyp_&_nc_oc=AdmnVyBaT_rWoTPRuXw80Tju3t6-gjIMgZCUoTFy3hM2N10a65wgh7qU5OJovYDKR8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6-bdjya3qL0x9hyGf3ZSTDW980fwa75ZgumYp5ngQHA&oe=69B80700"}, {"file_name": "Screenshot1.png", "id": "297290731358211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974893_297290734691544_6215860292990628931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nheIj1NT7lwQ7kNvwFQE2xv&_nc_oc=AdlsRM-2ZRdWux1d4iRayTzv93mAyqV3Iq4a1jsogg_hUDjOJN8GdcGVW5yksdbrCT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjXgEcovR7o-wK9AbTbzT-25ZjeyUPzQmgmigQMKGgBQ&oe=69B7EC9D"}, {"file_name": "Screenshot5.png", "id": "294735778406481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_294735781739814_4601886414751003638_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W8m9rWeDAoQ7kNvwGr3fhM&_nc_oc=Adk6HRvTjAQ_UwK8RMqEUrcPedK7mKDqF3wjV1A7SvRQ25S26i-U77Worpo0iyhxTww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfypMa59PxJtrsLGy9rGJ80dUlLyg1YH-adYiCTX88mFTA&oe=69B7FF8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OLC VR", "keywords": ["learning", "education", "360video", "development", "energy"], "long_description": "Real Learning in a Virtual World: Taking learning to the next level through the World Bank Group (WBG) - Open Learning Campus (OLC)  VR app. \n \nWBG-OLC's immersive learning powers storytelling through bite-sized 360 stories, virtual tours, and visualizations and takes you inside the world of some of the most crucial challanges of global development. \n \nExperience next-generation interactive learning by getting a peek into the most pressing challenges - climate change, education, gender, urban development, international trade, public health, and more. Also available are on-demand resources, expert talks, data visualization, and other online courses through the Open Learning Campus (OLC) Platform.\n \nWhether you are a policymaker, development practitioner, or are curious to learn more, the WBG-OLC VR app is a place to virtually experience real-world challenges.", "short_description": "WBG-OLC's immersive learning powers storytelling through bite-sized 360 stories, virtual tours, and visualizations and takes you inside the world of some of the most crucial challenges of global development.\n\nExperience next-generation interactive learning by getting a peek into the most pressing challenges - climate change, education, gender, urban development, international trade, public health, and more."}]}, "developer_name": "Visyon360", "developer_privacy_policy_url": "https://www.worldbank.org/en/about/legal/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "World Bank Group VR", "support_website_url": "https://olc.worldbank.org/", "website_url": "https://olc.worldbank.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "347185933728807"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculus
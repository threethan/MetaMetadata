trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-05 004008.png", "id": "575001451976401", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_575001455309734_5483927448556820728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTz9RqJyH04Q7kNvwEsXnDp&_nc_oc=Adocy4JcUL1SCxL5eQ1ONXdzwTtJ_YIGhlENWXIci_cRqHhNFlmtlALx1V5cAIv8tKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JD7iIpU5MburAb2ME1VCuCOJnOsYsyQr5vXvrD4GLXQ&oe=6A186B09"}, "display_name": "Casino Management", "keywords": ["arcadeidle", "idle", "fun", "Casino", "Comfort"], "long_description": "\"Casino Management\" is an engaging arcade idle game that puts you in charge of running a world-class casino. Unlike traditional games, there's no gambling here\u2014your focus is entirely on management and strategy. Begin by designing and constructing your casino, choosing from a variety of attractions like slot machines, dining areas, and luxury lounges. Manage staff, optimize resources, and plan upgrades to create the ultimate entertainment destination.\n\nKeep your guests happy by offering a flawless experience, from glamorous interiors to top-notch customer service. Balance your budget wisely, invest in improvements, and make data-driven decisions to ensure your casino thrives. The game offers a perfect blend of creativity and strategy, with exciting challenges that test your management skills.\n\nWhether you\u2019re customizing layouts, expanding your facilities, or unlocking new features, \"Casino Management\" delivers endless fun. Build, innovate, and rise to the top as the ultimate casino tycoon!", "short_description": "Step into the role of a visionary casino manager in \"Casino Management,\" a thrilling arcade idle game where strategy meets fun. Build, expand, and optimize your casino to attract guests and grow your business empire. Design stunning layouts, manage staff, and create a luxurious experience for your visitors. With no gambling involved, this game focuses on the art of management and decision-making, offering an exciting challenge for players of all ages. Start building your dream casino today!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/casino-management", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9222419947802211"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1486137119876203"}, {"status": "PUBLISHED", "id": "856549630516503"}, {"status": "PUBLISHED", "id": "2902473773291051"}, {"status": "CANCELLED", "id": "2214407165681453"}, {"status": "PUBLISHED", "id": "2201186867004494"}, {"status": "PUBLISHED", "id": "1064959729000797"}, {"status": "PUBLISHED", "id": "1209828540563476"}, {"status": "PUBLISHED", "id": "1124940358687607"}]}, "baseline_offer": {"id": "1064959729000797"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600, "status": "PUBLISHED", "id": "1486137119876203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9265990456778493", "version": "1.0"}, "id":
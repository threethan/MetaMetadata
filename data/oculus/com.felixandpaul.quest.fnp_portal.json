&oe=6AFDD1AD"}, {"file_name": "zOn81J.png", "id": "1934556393341514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982648_1934556396674847_6237525203765690368_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiYuxoek_pQQ7kNvwEg4oxZ&_nc_oc=AdolYZdSPPcSV1-uJ68NgwRD_eOXYcFAb1_fiXlW3oGC4X9ewcOp4Kn9E9gmBOEJ2MU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1xG_Fl7kdRa5H3C9VCBeQbWDNXzbcUr64gVtb3L1FPQ&oe=6AFDE1F2"}, {"file_name": "w8vizm.png", "id": "620755195316029", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035425_620755201982695_4278093314386821120_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74dySdfh6g0Q7kNvwFL3omb&_nc_oc=AdoAhlzK-_QszExxRgmGyQK7ljTUHa3MLFF2kg82xRLBlP-_wOW2bQWZxJkhAFHXEIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCpoSHQI5H18_uKEU2R3IDvKlxOhTgLO4D8DGWYYFolw&oe=6AFDDA3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/N4Ven0", "id": "1675268115955159", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488378_1675268119288492_5314520591368192000_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enkbxSy4kv4Q7kNvwFaGdMy&_nc_oc=Ado9aQ-1pN2PZ8wENOQnVFnCQHQOQsTZ-DM6OWktWXA--fdh9FaX6tRHoJD4B-RwrFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3uM2e00nuWu3tr8FYZaxEUhABnVaklzoVn_XhAp4tvw&oe=6AFDDCFC"}, "display_name": "Felix & Paul Studios", "keywords": ["Obama", "Felix", "Music", "Narrative", "Movie"], "long_description": "Explore the vast and varied cinematic virtual reality worlds of EMMY award-winning Felix & Paul Studios.\n\nGo from awe-inspiring romps through Jurassic World, feeling the presence and close proximity of a dinosaur, to a first-hand tour of The White House guided by President Barack Obama and First Lady Michelle Obama. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences as black Americans traveling through the US. Or, step into the studio for an exclusive and intimate musical performance by Patrick Watson.\n\nStart now and watch this space blossom with more and more of Felix & Paul Studios\u2019 award-winning work featuring top franchises, leaders and performers from around the world.", "short_description": "Explore the vast and varied cinematic virtual reality worlds of EMMY award-winning Felix & Paul Studios.\n\nGo from awe-inspiring romps through Jurassic World, to a first-hand tour of The White House. Join the patrons at historic Ben's Chili Bowl or step into Patrick Watson\u2019s studio for an exclusive and intimate musical performance. \n\nStart now and see the portal grow with more Felix & Paul Studios\u2019 award-winning work featuring top franchises, leaders and performers from around the world."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7183920261729499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/390313
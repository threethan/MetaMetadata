nd tour of The White House. Join the patrons at historic Ben's Chili Bowl or step into Patrick Watson\u2019s studio for an exclusive and intimate musical performance. \n\nStart now and see the portal grow with more Felix & Paul Studios\u2019 award-winning work featuring top franchises, leaders and performers from around the world."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7183920261729499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031325_602957787110598_6939301591254040576_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0tKwXLPjzIQ7kNvwFeNdL-&_nc_oc=AdmoS-zLKX3kW-LRFoCEaGX5NY8zDkczFGAr4cdrzqob9_O3cR94L6mqAUtjWV7Ohp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft2godz27bWcd3i6PFSHxtC3JFVzU8zYajmSIqcYnj_gA&oe=699872AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Felix & Paul Studios", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS"
qnpN1kL6kdYfT8DrqRzihE7h7x43EqPXyCDpu-3vsb4o8Wq9vna8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGoKyBGt8crK_Ag33YJzZhGDQs1iC6OVQ6jyCiJUJVig&oe=6AF081E0"}, {"file_name": "04_saturn_lit_2560x1440.png", "id": "1235952865414482", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654936547_1235952868747815_9117348846474267667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIiG27DOz60Q7kNvwE2mfuU&_nc_oc=Adp5Pbs4fQPP_0hYPsHDUhCJ3HctJqwUhGNQOmgDI4R2Fbngml9d4KYCtcDi-4AmeoA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8nXCrzh51tVY23rxUUYGoNcuYDo2VEHv2n9Nj6t20SA&oe=6AF096CE"}, {"file_name": "12_apollo11_2560x1440.png", "id": "1591679702438390", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301236_1591679712438389_2472340688792476457_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUFFKPHAQ3kQ7kNvwFCCAcf&_nc_oc=AdoJOscQYGVDc9SeqNGfzn_8nxLY2CNuiRQUlZx-3xqRSSlZk87Yq6qFB1pWHmH4BFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkDWGW31CDrVp7IsVq9ETFOzcAqZGHSWLlmqWhjhQtpQ&oe=6AF0964B"}, {"file_name": "01_j_pillars_2560x1440.png", "id": "1164913249817578", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292712_1164913253150911_1118174818925234647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9eqxsEZ3eQQ7kNvwFGosO0&_nc_oc=AdoCV4CnDa6HXy5AICFzN1e4irMKjM83mFJ1rBwd17-gpGpCWJ-VoYW5zSWto3ID7OA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW2YdpId0j1mq7iBSgGtPzR4y3TrCuNR1qDfxHhvnOaA&oe=6AF0AFBE"}, {"file_name": "05_aurora_2560x1440.png", "id": "974730588331356", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/737543484_974730591664689_3322785179079767736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjTDctedqekQ7kNvwFLME_v&_nc_oc=Adp4AZHOkuErUly3IOszt710twNhDabRo7OGk1Ibc9VB8sdoTMQPE8LGng8ZfT-_da4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9_6VMTOnDB8atQSuYdgZv_icv1FqPN3Y4yGQYHREZ0A&oe=6AF0A54A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpaceWise: The Real Solar Syst", "keywords": ["space", "education", "planets", "astronomy", "science"], "long_description": "How far away is Mars, really?\n\nJOURNEYS\nEight narrated chapters with subtitles, voiced by a natural-sounding, computer-generated British narrator. Stand under the real night sky at a mountaintop observatory, visit Hubble and Webb, watch a real solar flare, see the Pillars of Creation and fall into a spinning black hole. Every scene says what is a real image and what is a model or a picture.\n\nEXPLORE\nThe Sun, all eight planets, Pluto, Ceres and 13 moons at their true sizes and distances, where they are today. Over 41,000 real asteroids, real space weather and the aurora, and all 88 constellations. Fly real transfer orbits. Walk where Apollo 11 landed and in Jezero Crater.\n\nIN YOUR ROOM\nMixed reality: a model of the planets on your table. Hold one in your hand. Its sizes and distances are shrunk, and it says so.\n\nSCIENCE LAB\nDrop a hammer and a feather on the Moon, weigh yourself on other worlds and race light to every planet: ten experiments with real numbers.\n\nFOR FAMILIES AND CLASSROOMS\n- Four reading depths, from quick facts to expert science, so the whole family can learn together\n- Up to six explorers\n- 37 missions, quizzes, 45 badges and a logbook\n- Every fact shows its source\n- Linked to the English National Curriculum\n\nCOMFORTABLE AND SAFE\nTeleport, snap turn, seated or standing play and break reminders. No ads, no chat, no in-app purchases, no accounts and no data collected. Works offline; live NOAA and NASA data only if a grown-up allows it.", "short_description": "The real solar system at its true size and in true time, with eight narrated Journeys. Stand under a real mountaintop night sky, watch a real solar flare and fall into a spinning black hole. Explore every planet where it is today, real asteroids and all 88 constellations, or put a model of the planets in your room. Four reading depths go from quick facts to expert science, so the whole family can learn together. For ages 10 and up. No ads, no chat, no in-app purchases and no data collected."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dhl84.github.io/spacewise/privacy.html", "developer_terms_of_service_url": "https://dhl84.github.io/spacewise/terms.html", "publisher_name": "David Lee", "support_website_url": "https://dhl84.github.io/spacewise/support.html", "website_url": "https://dhl84.github.io/spacewise/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1422848440902412"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1568373537937883"}]}, "baseline_offer": {"id": "1568373537937883"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793691900, "status": "PUBLISHED", "id": "1568373537937883"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1477047518815837", "version": "0.1.0"}, "id": "1124228443357217", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1422848437569079", "is_concept": false, "latest_released_bin
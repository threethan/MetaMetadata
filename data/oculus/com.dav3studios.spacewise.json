ntent-lga3-3.oculuscdn.com/v/t64.5771-25/499292712_1164913253150911_1118174818925234647_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O5MnSVnSvAQ7kNvwEaNq1r&_nc_oc=Ado6QL0y4jEp5I4ru5HUKQX7Z23Cl6hJW0QClZ0S1wCJofIs9QSDyJRt4VknWjXd2LU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR-Lm_KPXu1HNjEOXzzZZzRKFuVxhbncn_yh95MPd4JQ&oe=6AFB3BBE"}, {"file_name": "05_aurora_2560x1440.png", "id": "974730588331356", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/737543484_974730591664689_3322785179079767736_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zElCOEIv3sQ7kNvwHRl5X0&_nc_oc=Adrnz8Wm5RMfFAmlyjXIFxxK03qSMRFAkl1UN2_PRMRTziXwS6Jm6xn-Wm_sh38Appc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO4GGLlETdblCUG8gLOklaOgyNhiGvtV73VTTpV790GA&oe=6AFB314A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpaceWise: The Real Solar Syst", "keywords": ["space", "education", "planets", "astronomy", "science"], "long_description": "How far away is Mars, really?\n\nJOURNEYS\nEight narrated chapters with subtitles, voiced by a natural-sounding, computer-generated British narrator. Stand under the real night sky at a mountaintop observatory, visit Hubble and Webb, watch a real solar flare, see the Pillars of Creation and fall into a spinning black hole. Every scene says what is a real image and what is a model or a picture.\n\nEXPLORE\nThe Sun, all eight planets, Pluto, Ceres and 13 moons at their true sizes and distances, where they are today. Over 41,000 real asteroids, real space weather and the aurora, and all 88 constellations. Fly real transfer orbits. Walk where Apollo 11 landed and in Jezero Crater.\n\nIN YOUR ROOM\nMixed reality: a model of the planets on your table. Hold one in your hand. Its sizes and distances are shrunk, and it says so.\n\nSCIENCE LAB\nDrop a hammer and a feather on the Moon, weigh yourself on other worlds and race light to every planet: ten experiments with real numbers.\n\nFOR FAMILIES AND CLASSROOMS\n- Four reading depths, from quick facts to expert science, so the whole family can learn together\n- Up to six explorers\n- 37 missions, quizzes, 45 badges and a logbook\n- Every fact shows its source\n- Linked to the English National Curriculum\n\nCOMFORTABLE AND SAFE\nTeleport, snap turn, seated or standing play and break reminders. No ads, no chat, no in-app purchases, no accounts and no data collected. Works offline; live NOAA and NASA data only if a grown-up allows it.", "short_description": "The real solar system at its true size and in true time, with eight narrated Journeys. Stand under a real mountaintop night sky, watch a real solar flare and fall into a spinning black hole. Explore every planet where it is today, real asteroids and all 88 constellations, or put a model of the planets in your room. Four reading depths go from quick facts to expert science, so the whole family can learn together. For ages 10 and up. No ads, no chat, no in-app purchases and no data collected."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dhl84.github.io/spacewise/privacy.html", "developer_terms_of_service_url": "https://dhl84.github.io/spacewise/terms.html", "publisher_name": "David Lee", "support_website_url": "https://dhl84.github.io/spacewise/support.html", "website_url": "https://dhl84.github.io/spacewise/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1422848440902412"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1568373537937883"}]}, "baseline_offer": {"id": "1568373537937883"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793691900, "status": "PUBLISHED", "id": "1568373537937883"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1485928417927747", "version": "0.2.1"}, "id": "1124228443357217", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1422848437569079", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1485928417927747"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1124228443357217"}]}, "change_log": "Version code 15 (0.2.1): Two new places on Mars: stand beside Curiosity on the slopes of Mount Sharp on its 5,000th day, and beside Viking 1, the first lander to work on Mars, each with its own real descent. Run time backwards: watch an eclipse or the planets go back in time. Stand inside an eclipse with the real hills of the place around you. The ring glide now stops where Saturn's sunny side is in view. Missions are sorted by place, and the badge wall shows your badges, the ones to find and the Journeys badges. Two new missions. Version code 14 (0.2.0): New Journey, Out to the Edge: one continuous flight from Earth orbit to the afterglow of the Big Bang, with real stars, real galaxies and NASA's WMAP map. Choose any date from 3000 BC to AD 3000. Find every eclipse, watch it from space or stand inside it, and see when the next one is near you. Ring glide at Saturn on Cassini's real path, Galileo's view of Jupiter's four big moons, and the astronaut's view of Earth. Saturn's rings show about four times more detail. School mode with a teacher PIN, and kiosk mode for museums. Eight new missions. Version code 13: the app shows its first frame about 2 s after launch and runs at a steady 72 Hz. Version code 12: a steady frame rate near the Earth (in space the automatic picture quality stays at Smoothest). Version code 11: the hand help card closes with a pinch, menus stay still while you aim at them, and only one voice speaks at a time with no repeated or stacked lines. Version code 10: steady frame rate in trips between planets (no warm-up or pipeline stalls, no quality change mid-trip). Version code 9: the privacy text names the Meta user ID and age group, Live space data stays off on child accounts, and one trigger press does one thing. All include the version code 8 Title screen and Quit buttons.", "created_date": 1793806242, "id": "1485928417927747", "version": "0.2.1", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1422848437569079", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1485928417927747"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1124228443357217"}]}, "change_log": "Version code 13: the app shows its first frame about 2 s after launch and runs at a steady 72 Hz. Version code 12: a steady frame rate near the Earth (in space the automatic picture quality stays at Smoothest). Version code 11: the hand help card closes with a pinch, menus stay still while you aim at them, and only one voice speaks at a time with no repeated or stacked lines. Version co
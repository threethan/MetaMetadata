B435t39WctkWa08OubNO_XEuezdOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8j74jYLjhtDlAqYWYIvDLO3PHuEELKm9_ypllBZbTTA&oe=69AC3097"}, {"file_name": "Still 2024-12-10 102019_1.1.7.png", "id": "595941376154432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294243_595941379487765_6137775615663483712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zULqaCh7NsIQ7kNvwE-GdS2&_nc_oc=AdlkC7Fxoy7ulaIsbVRV6IZ2lAflIryNR3ZvxWR1Ipsz1UsGXlKMMuIHjMF_yWzQWJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoU3AUDPS_cZ_70lRMe9EYVoW5LGkTnOcVEyI3gVhCEA&oe=69AC1CBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1259790035305391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003253_1259790038638724_2762260966024881223_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2alxyVbHFR4Q7kNvwGIC78m&_nc_oc=Adm5U71es76HWs_VA2loooHmQ8IL8PxjX-tFP-mxe2WGtxsXzyUqT-bqtM25vLPH16A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnQAXe2B7V5YfqT7Tf6vY8OPts5RDBhNbxHPSevx1hsQ&oe=69AC0A57"}, "display_name": "Neptune Beach Ball", "keywords": ["Fitness", "Exercise", "Action", "Racket", "Arcade"], "long_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. \n\nAlternate forehand and backhand strokes to build your multiplier and charge your special. Use the trigger to discharge your special and dispatch hard-to-reach critters. \n\nComplete 5 waves to reach a challenge stage where you increase your remaining time. \n**Compete on the online leaderboard and fight for the top spot!**\n\nChoose between two game modes:\n# Chains\nCritters melt as your ball slices through them like a hot knife through butter. Fun specials like magnet balls, multi-balls, and oversized balls keep the gameplay spicy, but watch out for mines that restock critters.\n# Waves\nIn this challenging mode, critters get close and personal. Cut through them as they bob and weave 
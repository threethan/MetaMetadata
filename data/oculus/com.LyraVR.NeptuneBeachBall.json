leYHmg6xMmg1D7dAERfBaWMiRcC6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzO-Am5Pf1eWXjX2HQDVX54HcLpj_RWZlsVCtwkWKa-FA&oe=69BC0297"}, {"file_name": "Still 2024-12-10 102019_1.1.7.png", "id": "595941376154432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294243_595941379487765_6137775615663483712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoK-sySAfRYQ7kNvwGFVicp&_nc_oc=AdlwvR5e9w73fYrXeLX5trovcSHWfZ0owCXgrujjR_JN_Mf-yPf8cwqoPYrpjC_sou0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyy3Z5VSfmTdI0tDAWpinmEHT6Nuc8vgLBi9X8iayyEgQ&oe=69BBEEBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1259790035305391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003253_1259790038638724_2762260966024881223_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmqtMdsxN78Q7kNvwFgyguQ&_nc_oc=AdmCN-CjutiF58Jckvhu5DXT9zI96Zmq2uJvQMb8QRlRo51A_7ekXlyD4BlCu_oY1sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXBYZZ9AS5j9C-rp7p8bUPY8ZrovcxaAVG2vo41p5v-g&oe=69BBDC57"}, "display_name": "Neptune Beach Ball", "keywords": ["Fitness", "Exercise", "Action", "Racket", "Arcade"], "long_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. \n\nAlternate forehand and backhand strokes to build your multiplier and charge your special. Use the trigger to discharge your special and dispatch hard-to-reach critters. \n\nComplete 5 waves to reach a challenge stage where you increase your remaining time. \n**Compete on the online leaderboard and fight for the top spot!**\n\nChoose between two game modes:\n# Chains\nCritters melt as your ball slices through them like a hot knife through butter. Fun specials like magnet balls, multi-balls, and oversized balls keep the gameplay spicy, but watch out for mines that restock critters.\n# Waves\nIn this challenging mode, critters get close and personal. Cut through them as they bob and weave 
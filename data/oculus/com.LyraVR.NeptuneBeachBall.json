Ts-478OuFKlUFYw&oe=6AFB4DF7"}, {"file_name": "Still 2024-12-10 102019_1.1.4.png", "id": "555907483898279", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982539_555907490564945_7004951581837481914_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_XFEDz8uncQ7kNvwG4RDQV&_nc_oc=Adq3TXyFvXG5Aq-ElHhpx1f_k3K7RggX0xgtu7WW3ft438Z7t1k5UYxy0x2LOT7rUhA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgzOWLno61DIvQnQo4aS_SK2yqmqB36gROJg81uThcug&oe=6AFB45D7"}, {"file_name": "Still 2024-12-10 102019_1.1.7.png", "id": "595941376154432", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75294243_595941379487765_6137775615663483712_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2bi95NozP8Q7kNvwFLcFVl&_nc_oc=AdoNNEpNsQcteQfL1tsgegTLSjh7EfjoUk9F17ZJQo_zUMf8QSKuw7hi9pfD4USzo9s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwCITkK5QfAaKyo01fYEgRApyLGGG-xHcCfBEtH5Nuyg&oe=6AFB31FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1259790035305391", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003253_1259790038638724_2762260966024881223_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=082-oMmxsycQ7kNvwGG1P_h&_nc_oc=AdqzHMt7OxSqRFqRBfWGAn1ArbsGAFDfaBe3SrOKLJXMzgMYoiS9nXw9rCGVIab9thE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqyDO_bIkud_9FEUou5O-rUNXCfFOxpyxrEzu0Xf6-hg&oe=6AFB1F97"}, "display_name": "Neptune Beach Ball", "keywords": ["Fitness", "Exercise", "Action", "Racket", "Arcade"], "long_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. \n\nAlternate forehand and backhand strokes to build your multiplier and charge your special. Use the trigger to discharge your special and dispatch hard-to-reach critters. \n\nComplete 5 waves to reach a challenge stage where you increase your remaining time. \n**Compete on the online leaderboard and fight for the top spot!**\n\nChoose between two game modes:\n# Chains\nCritters melt as your ball slices through them like a hot knife through butter. Fun specials like magnet balls, multi-balls, and oversized balls keep the gameplay spicy, but watch out for mines that restock critters.\n# Waves\nIn this challenging mode, critters get close and personal. Cut through them as they bob and weave and use your special to blow up hard-to-reach critters before time runs out.", "short_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. "}]}, "developer_name": "Jean Marais", "developer_privacy_policy_url": "https://lyravr.com/privacy-policy2/", "developer_terms_of_service_url": null, "publisher_name": "LyraVR", "support_website_url": null, "website_url": "http://neptunebeachball.moshang.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9074058819374347"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1265075868035759"}]}, "baseline_offer": {"id": "1265075868035759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735142400, "status": "PUBLISHED", "id": "1265075868035759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9229529777160583", "version": "1.
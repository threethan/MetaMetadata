5i3rflU7n_ot8cLW-uFXPvP3PjhxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPyrj8Mo15oSTbNJrf2gCBTzlei1paDy6b7cnWBqrCBA&oe=69BFF717"}, {"file_name": "Still 2024-12-10 102019_1.1.7.png", "id": "595941376154432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294243_595941379487765_6137775615663483712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_WQEfDZh_EQ7kNvwH0HDP9&_nc_oc=AdkQQXBwODgUkFiRUlhzZ7IhZ9DrpMnS-2kvipvYYWrlcUmlB3uSskXkQM0XyLfr2eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFZEWULcYrExvvi0uhSGGmhOVmgbDtQsSI7QTNhvBTcA&oe=69BFE33F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1259790035305391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003253_1259790038638724_2762260966024881223_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpoeoOPt2JQQ7kNvwHEmyOl&_nc_oc=AdkBy1dErh1wOMAqs3aun4Paznqe9ca47w1yaD8xf6AzCUWOXAdUFjlxmwYZwZy4oZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy93nrfNorBBVPqU3UYp0hHyUmLwm51Rr0QjVoflerqJQ&oe=69BFD0D7"}, "display_name": "Neptune Beach Ball", "keywords": ["Fitness", "Exercise", "Action", "Racket", "Arcade"], "long_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. \n\nAlternate forehand and backhand strokes to build your multiplier and charge your special. Use the trigger to discharge your special and dispatch hard-to-reach critters. \n\nComplete 5 waves to reach a challenge stage where you increase your remaining time. \n**Compete on the online leaderboard and fight for the top spot!**\n\nChoose between two game modes:\n# Chains\nCritters melt as your ball slices through them like a hot knife through butter. Fun specials like magnet balls, multi-balls, and oversized balls keep the gameplay spicy, but watch out for mines that restock critters.\n# Waves\nIn this challenging mode, critters get close and personal. Cut through them as they bob and weave 
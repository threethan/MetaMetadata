snXs7uc4IpZqtwA&oe=6B0DC2F7"}, {"file_name": "Still 2024-12-10 102019_1.1.4.png", "id": "555907483898279", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982539_555907490564945_7004951581837481914_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJAqV2-WIN4Q7kNvwHUPFRT&_nc_oc=AdrYTZMQIU2mprtapiN_c3zsrUXGHHsRnDZO1-jACwzSbcPvL0FBIqD_z4Y44poBZL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtvrT46macObeslvC5xYoQZpUoZylmsdIYfAgy6fElTg&oe=6B0DBAD7"}, {"file_name": "Still 2024-12-10 102019_1.1.7.png", "id": "595941376154432", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294243_595941379487765_6137775615663483712_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INTNGX7PbiAQ7kNvwGz5bA6&_nc_oc=AdqNfzvcRL70rkaRhe9Pv51MxakOMegUCe8OWn0CToA9Dt_bX38YBkDCWyceA-NfWj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrLCHXyTXJS_5O7PtOi77115BQAO8Hyxx7PaSN1iM9-g&oe=6B0DA6FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1259790035305391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003253_1259790038638724_2762260966024881223_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQldiaL8k40Q7kNvwFX173G&_nc_oc=AdrvABgCFGt26_lgeMcgl__CFzdRYMql1ZVGWVMNREKBodTkaW-m1c3ms_04DZKk5M8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmRO8oii-fjK8xK4oRBLvyu3s6HybxtI66JEenBsconQ&oe=6B0DCCD7"}, "display_name": "Neptune Beach Ball", "keywords": ["Fitness", "Exercise", "Action", "Racket", "Arcade"], "long_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. \n\nAlternate forehand and backhand strokes to build your multiplier and charge your special. Use the trigger to discharge your special and dispatch hard-to-reach critters. \n\nComplete 5 waves to reach a challenge stage where you increase your remaining time. \n**Compete on the online leaderboard and fight for the top spot!**\n\nChoose between two game modes:\n# Chains\nCritters melt as your ball slices through them like a hot knife through butter. Fun specials like magnet balls, multi-balls, and oversized balls keep the gameplay spicy, but watch out for mines that restock critters.\n# Waves\nIn this challenging mode, critters get close and personal. Cut through them as they bob and weave and use your special to blow up hard-to-reach critters before time runs out.", "short_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. "}]}, "developer_name": "Jean Marais", "developer_privacy_policy_url": "https://lyravr.com/privacy-policy2/", "developer_terms_of_service_url": null, "publisher_name": "LyraVR", "support_website_url": null, "website_url": "http://neptunebeachball.moshang.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9074058819374347"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1265075868035759"}]}, "baseline_offer": {"id": "1265075868035759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735142400, "status": "PUBLISHED", "id": "1265075868035759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9229529777160583", "version": "1.
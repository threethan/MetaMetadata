YOaxSReSMo4fwa94LCPHQiFOU2dmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzK0c4oVehxvbH81vmC0jQ1Slg9T2VijcgIiWURFrhN7g&oe=69B95F97"}, {"file_name": "Still 2024-12-10 102019_1.1.7.png", "id": "595941376154432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294243_595941379487765_6137775615663483712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8-jmHbrFWsQ7kNvwEW3xjb&_nc_oc=AdmIt8JmGtN-XLDpxKcuhbVo7950_YrNp-H0ey5PZPnjYA78Z4Q0CyHLrOfiMbfnhcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGtDL0k_ne4e-VqBtGcXdwr9lPaE5EYbJ5ST6t0j0yuw&oe=69B94BBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1259790035305391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003253_1259790038638724_2762260966024881223_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmqtMdsxN78Q7kNvwF-xjQY&_nc_oc=AdlDG0Av-pDjt2YLn3RLSEH1yNOLmqMXoc8qqj1MZ0qMg5D4-6GgUSmsu4rcKZLYlFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0s6PZ-npg-H2OhUprUVQaHo0aReSjmPDcLEyRKpCALg&oe=69B93957"}, "display_name": "Neptune Beach Ball", "keywords": ["Fitness", "Exercise", "Action", "Racket", "Arcade"], "long_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. \n\nAlternate forehand and backhand strokes to build your multiplier and charge your special. Use the trigger to discharge your special and dispatch hard-to-reach critters. \n\nComplete 5 waves to reach a challenge stage where you increase your remaining time. \n**Compete on the online leaderboard and fight for the top spot!**\n\nChoose between two game modes:\n# Chains\nCritters melt as your ball slices through them like a hot knife through butter. Fun specials like magnet balls, multi-balls, and oversized balls keep the gameplay spicy, but watch out for mines that restock critters.\n# Waves\nIn this challenging mode, critters get close and personal. Cut through them as they bob and weave and use your special to blow up hard-to-reach critters before time runs out.", "short_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. "}]}, "developer_name": "Jean Marais", "developer_privacy_policy_url": "https://lyravr.com/privacy-policy2/", "developer_terms_of_service_url": null, "publisher_name": "LyraVR", "support_website_url": null, "website_url": "http://neptunebeachball.moshang.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9074058819374347"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1265075868035759"}]}, "baseline_offer": {"id": "1265075868035759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735142400, "status": "PUBLISHED", "id": "1265075868035759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9229529777160583", "version": "1.11"}, "id": "503748718945792", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8431379850308917", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9229529777160583"}, "release_status": "RELEASED"}, "binary_release_
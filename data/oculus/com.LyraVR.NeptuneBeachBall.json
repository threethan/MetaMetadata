se and personal. Cut through them as they bob and weave and use your special to blow up hard-to-reach critters before time runs out.", "short_description": "Wade through waves of sea critters in this fast-paced, heart-pumping VR racket game. "}]}, "developer_name": "Jean Marais", "developer_privacy_policy_url": "https://lyravr.com/privacy-policy2/", "developer_terms_of_service_url": null, "publisher_name": "LyraVR", "support_website_url": null, "website_url": "http://neptunebeachball.moshang.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9074058819374347"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1265075868035759"}]}, "baseline_offer": {"id": "1265075868035759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735142400, "status": "PUBLISHED", "id": "1265075868035759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9229529777160583", "version": "1.11"}, "id": "503748718945792", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8431379850308917", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "92295297771
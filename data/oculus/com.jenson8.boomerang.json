970158982761", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031656_786970165649427_8986820393854438245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwCfdKKHfSoQ7kNvwHwm-g-&_nc_oc=Adq-FRgrDvYuepejUTj1eMopYUlkQF9juyLAc1u-VKdtjiHnubSIGYLiWzPVomWofDA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyvHbpcVPjHorCiq_zn2WrIRY-s59ywdl6spRaUSX48g&oe=6A7DAAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoomerangTrailerCover.png", "id": "1539235793158695", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75361346_1539235796492028_8491299428386087457_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXdJJ5qbMgYQ7kNvwEYGe-G&_nc_oc=AdoQI8U908dW9ceP9m81RnaR1PMiHeriiLCEVv_eF6gh1-Gq7TdrD3UTBj5SKGIzt0M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYa8h_Tk82oWXumP5E7fel84mi9n0Ja98GCjrr4zaQaw&oe=6A7DA0AD"}, "display_name": "Boomerang", "keywords": [], "long_description": "Boomerang is a multiplayer experience for leadership and team development workshops that places team members in a post-apocalyptic environment where they must work together to save the world. The experience offers an engaging way to look at teamwork, ethics and risk-taking decisions, social inclusion, and individual and group task contributions.\n\nBoomerang is a licensed virtual reality leadership development experience and requires an account and prior authorization from Jenson8 in order to access.", "short_description": "Boomerang is a multiplayer experience for leadership and team development workshops. It is a licensed product from Jenson8 and requires an account and prior authorization to access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.jenson8.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Jenson8 ltd", "support_website_url": null, "website_url": "https://jenson8.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
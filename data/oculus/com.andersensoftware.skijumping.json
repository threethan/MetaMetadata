run.png", "id": "1503071437921553", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1503071441254886_3501220749848459595_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH4ciW-WF2MQ7kNvwG_D6Dz&_nc_oc=AdrYOgFcsn1uQjaw2UoYOnW9P6rHH3XB0FYfZKb309ncz_mC6o8fJxdo_6APdZ6y2GU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SoKuqhg0hmTF0caGJ3P1MhL_kir8EA-p---xrns5fxQ&oe=6A08913D"}, {"file_name": "screenshot_3_jump.png", "id": "4144358122492090", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304305_4144358125825423_5074787648522725732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUYIg08QxAUQ7kNvwEaLqTh&_nc_oc=AdqTYT4xIyMUmQ3ajJCHSTB--Qw07N2cOznBXFq4dcmzC3zgVkOlUF3kIIfwfV-yWK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mSnmLkoIuojLKgr8jIxCpV38C_K55CzGEoh1UzqtWtQ&oe=6A087C26"}, {"file_name": "screenshot_4_landing.png", "id": "1572976860569536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820518_1572976863902869_5765024943006918241_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CklNr5ysMFMQ7kNvwHL2dgF&_nc_oc=AdpgbzxrWQVl-kUQztEvjwiL12nErvDeBGEJ5KyLu1sJieowaa24E2RjOwQL0E72Qcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E2NeMCOiXWoics7f5gI6-hGf-l1H7RqaajNTuysVWHw&oe=6A087410"}, {"file_name": "screenshot_5_final_results.png", "id": "920391987180875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821707_920391990514208_641393619096207996_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNEo50AO6YYQ7kNvwHO05oR&_nc_oc=AdpzcvTf9IEiIH46ADTn2ISXBfQ8RZziLySe_fr6HCfAsp5YNPJjxN_r19ka1eehDIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EH9cNMhOdJH17qirhvxZQmrP8nStpb5ELQSzyRHX2rQ&oe=6A085FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumbnail.png", "id": "893170606736392", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_893170610069725_1716474698428805692_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Toxxq1nJ7rUQ7kNvwFhlFjY&_nc_oc=Adro1Zdfan5pRWlmQ7_ueVl3WBOnBo51ZK4U6opWiMytw528Yb81C2VufmNdII_KqNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af742LCs1PPcKwoyQN5QV6yVAmtShFA7WseOwDdO7bs1_A&oe=6A0870D5"}, "display_name": "Ski Jumping", "keywords": ["Ski", "Jumping", "Winter", "Sports", "Simulation"], "long_description": "\n**Become a Ski Jumping Legend.**\nStep onto the start bar, feel the wind, and launch yourself into the air at over 90 km/h. Ski Jumping VR puts you in the boots of a professional jumper tackling a massive K120 large hill.\n\n**Pure Physics-Based Gameplay**\nGone are the days of simple button presses. In this immersive VR simulation, your body is the controller.\n\n*   **Crouch** deeply to minimize drag on the inrun.\n*   **Time** your jump perfectly at the takeoff table.\n\nCrouch deeply to minimize drag on the inrun.\nTime your jump perfectly at the takeoff table.\nControl your flight by positioning your hands to catch the wind.\nAdjust your V-style angle to maximize lift and distance.\nFeatures:\n\nRealistic Aerodynamics: Feel the difference between a perfect flight and a stalled crash.\nImmersive VR Atmosphere: detailed stadium, cheering crowds, and dynamic audio.\nPass-and-Play Multiplayer: Compete with friends locally to see who can set the longest distance.\nGlobal Standards: Authentic judging system based on distance and style points.\nPut on your headset, look down the steep ramp, and ask yourself: Are you ready to fly?\n\n{890563309999347}", "short_description": "Experience the thrill of professional ski jumping in VR! Master the aerodynamic V-style, feel the height of the K120 hill, and stick the perfect telemark landing. Features realistic physics, immersive atmosphere, and high-score leaderboards. Can you beat the hill record?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://andersensoftware.no/skijumping/privacypolicy.html", "developer_terms_of_service_url
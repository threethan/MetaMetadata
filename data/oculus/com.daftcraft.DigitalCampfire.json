iSv_UQh_rhr-U2Uoz2FHGq_v1aANE9ICg635NoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qKQ8Mq2PJA_JmDOjm7rsdzivP4aK_hIBBWV9mlCa2CA&oe=6A296343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRC8sV0wRE4Q7kNvwFd-yqC&_nc_oc=AdohBVU6yUqc8BVULFVYVF2nBeGI0rUe4K1fPNtRexENDyzURSbqk10PDsiU6q7HlSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F4fhJR0JuBxtoUnsuGplMMaiWFzbvD0fxcnpCGe3QYA&oe=6A297C84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbDPiqQEP2oQ7kNvwGj-jc8&_nc_oc=AdrrapC94Mbgq9ZQ68_lA0StQ9CO9QpaVcuFyXMcYffqqKheCOtihqXTQzZffxFXRa0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DC0QweNyRYrz5PtiilEyeNVYPKRY6jxu4NalEa4IsWA&oe=6A297F08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPtQZ8i_0wcQ7kNvwF5IXoq&_nc_oc=Adpk-Kb3SJSxIbwGIt-ahb_a_src6A7aZ6ndicX8QgPFYUZ39D3zg9Ox_w7nxeyPdE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84rHr3ed6KsfvChsinvMIf-U3uvjr2HGCPSlyLjJtboA&oe=6A297DDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATLKkRPpHgAQ7kNvwHqqM9S&_nc_oc=AdqX-t9uC3aCjbfWYiAvsW8chfrJIVkQK1HRci9u0sNR-AJRBG3SMjrM8DNJiHa8yiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lLV2JZrhXdA2_7fZr5CkubqFxAgQ3Bi6ggt3kOLcIHw&oe=6A29824D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsedQeo11y0Q7kNvwGnNmrf&_nc_oc=AdpF3wzFBEBzT4VOCzce-s5A0x9StvW6Rk0so1tkl8vPwKvAykcubd8RVD0vlqK1Ggk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vvBnbpbnYM3G_KFNav8ZOtqEVVpgKpEhkagx45pdtGA&oe=6A295F6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
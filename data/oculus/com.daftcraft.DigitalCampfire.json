t-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9v0Kao70YwQ7kNvwHz5X6W&_nc_oc=Adl9jWamm6nYv42sWgQVsYk-y6GpOZDMag8kR3o1KuNV5YmOxWt_gCj3G-VwSXTOMpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkzYy3Ke4xgP1aJAg_TwbqNM-jK78vtrN2-jbRWNnDeg&oe=69B80243"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6uYbseC-Z4Q7kNvwEVNKwp&_nc_oc=AdmqUSK9XsnI5YN_V0fFXLxuHJTttlFaSBAEeV7hMVt4tKJhkgTlguYDOoM4x4H9Rhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzL4Ph91D8qGBHQiCTwXvP8qlW-BTzK_MZNADMN7bsUdQ&oe=69B808D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_TNh5tLMWgQ7kNvwEFl4C4&_nc_oc=AdkcnDkJ4HZijR5bI5UvaZVEWhiGWbmIMGo7z7VUthRVBSBk1phUfJmgUtymywOt9Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAN3xTBFJTS6uTazf7lhNmo9fKa2PwOQqBwKEyGUwtiw&oe=69B7F7BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2hsHx8z8H0Q7kNvwFH7Iry&_nc_oc=Admuj9LVBXbTOF7pP1mUGwOyxJIxAJd45N5UQrGRUq5jlw_v4bzqOtTF4MjtnnzXOx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxEPYnG49FjdYgqYcMFfPk3yWmaY3Vtq2pDUXhVW_K_bw&oe=69B7E49E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSmyecLTBvwQ7kNvwFojlH_&_nc_oc=Adn-VgC16rXYzw5bBDlL_LsSSpeHNuwluO0PFCU2SzpxgqCnNFdmotUPLp23h_a2boc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxqQ8zoxehcJKDEj4Wnh4UIowfrVIptcw5YFW9f-8FV5A&oe=69B7E90D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Prz8NFG038Q7kNvwF4wXGb&_nc_oc=AdkZDy5REan1rKJ-N0RT7iIa1tJiiY6R8H9fiSRmcziU5yJF-5hYThJOX6Tgx41Jaz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpuTIoIXvwUEob
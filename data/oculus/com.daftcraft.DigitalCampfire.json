2CluCCqZVejW3FmdeTR2Sbo-o01zOAG4IkYkQpk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLhNAdMpsGLMlsnMR54Xua6zZh8d0DdJ8HKpwjygipwg&oe=69C3DFC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXWqkCstCe8Q7kNvwGNhgOL&_nc_oc=Adp1vZ2iYsUqJynjLbC3TOtfVeVbDvqzEiPmBQMSNObcmputuGNh_Z_9nLEyV6qbV7U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8ojKQevPujCefvshlFQPIj8aOqPJbxTn1o7KbvpcaGg&oe=69C3C0C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiYDGxi3U5MQ7kNvwHxW605&_nc_oc=AdpOJccvfy2X0OIgq_igsVTEE3nHPTOPEgCHtUgzQC2OHjTBq0fL9OoMdNr7KxnZPS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7p7Wm9hUrzDX1DQ3a1hwsO6CsB5UUiRk-hK6GHzID0g&oe=69C3C348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxtCVseHRiQQ7kNvwERTYv5&_nc_oc=AdrOeHHx-G_BHuQEPtlyvzU0yEA-oyEbiGi04o93Ti6yMhMhudIN2Izl8Yc9rJVyJk4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwtto8jsf4GTzkW-K1UHcU0J3Mzep8GUzPyMxPSXAhIPw&oe=69C3C21E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MU8qQ0ObehwQ7kNvwGL9o_2&_nc_oc=AdrTAvr8-XyDk0XkiP2zP_hV0OnqNnqZG6E_raMj69UOIsrP7YGiZUTNY_zhAevrtRg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKwjuxnsXgbskR41lCrX5Nk56F4zeYHJnDVMJS3-KHUA&oe=69C3C68D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43x5o_0ohn8Q7kNvwF7gYmE&_nc_oc=AdqRzydMOlKBR3D-dH5WlbghIAV2MsSMYkPRtVhQc1zY_tr2WY6D4xXMLgPg5HNBWEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3f3wCc5z4dsKFtftieb0g8EURzeGV5Cb-mQ1s9MXKpQ&oe=69C3DBEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
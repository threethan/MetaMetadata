4j9k7skBb0j5VVhoauJd-i1ZhnXiyqkBeRGbUszc_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvsjWmGriMJ6rIK_4ojrcy88yhLlQwCOMCTSwnDhvPLQ&oe=6AFF16C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqo4k7hnAgsQ7kNvwGBjbMm&_nc_oc=AdrZySjdmME-YxQDE07VI-CZTe88e3bAU4WDFZ3O-8CuUm2lLd1YzT0PI_HTFGQb4lg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoiBAClnwR2Ejr03fGBOUMdU0Fk67VciPBkiqD8h-cWQ&oe=6AFF2E83"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OX_KjM220h0Q7kNvwHzWXd3&_nc_oc=AdrRWZMQkujN-NXgAJztBzuCPVS1YHPA7wYNbOrek7n7Rvrj7HRHZo3fgQze1R3zq1g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ_JfJypUlGEJYbS9neAdNqJUOT7PbEbkZvfX4yG6PRw&oe=6AFF3513"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6e_h7Z9-3QQ7kNvwFYPbQ8&_nc_oc=AdoC9zWeEkCvNBWpqJ8vhhFcpJQJYp4b2nsyKGKdb4PXe8d0p0K1lkJ87L4vrpepqLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTmbHC2QX-gAohnd_-ux1IQaHYof2FWcGB9RhXmujTbQ&oe=6AFF23FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IsnP9foLIEQ7kNvwGQ9WX3&_nc_oc=Adoay2MShTB6sJSmgnB6x6gySLSvAUdCOFBLwOIKwDe0JzO-jT8XV47FIC0VJFXt8TU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT5dRO6ee2uCN_qE_wlRwOqOI1-A2EYHSoNHJMr-H7lg&oe=6AFF10DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXtSvS6O4PcQ7kNvwFWpxif&_nc_oc=Adqt_xLYFpqk53eivwjT9B4H8HxFDoswg3zvxUhImJ1Kbl_sSdyO3mI0JSh6cF3_P6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3WFHLsux28y8vJ73MAKhTk-CL8AthH0-1Ni9EShMxQw&oe=6AFF154D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
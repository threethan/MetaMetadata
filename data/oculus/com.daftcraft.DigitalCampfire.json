DCCJD8paTjiz5MzBn678HQVQF2JLknNucxQzfZySfE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsjb3hJcfWAGcZDdTcAZGmOKeAnL8HzKn1tgxwGBAATA&oe=6B0B2C84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v4xMvABjTUQ7kNvwFs1Tde&_nc_oc=AdqLZzBxvlKU5TY7HJK1l28hASlPH-6QGPAXvcpqaDvgAZwqWyC3BPl2GcR3E3HK5V0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7EMWd1kTQ9g5XF-i2HRM26irqf4QerwPiBcl7-Hb6mQ&oe=6B0B0C03"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPEiYi0-V9oQ7kNvwEiIs_4&_nc_oc=AdoH1q_8jPXnK_YkfuVHcMe0Firx4B0IKZZCg_R2r-4uFA1I__4EmxKZ7Kc6jwjwFo4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTCZJ4Ftj8N8QXbq1dDx1O8FmSMExyxjopGI4Z3hvzpOA&oe=6B0B1293"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzsnrx1Y1EEQ7kNvwHXXXQZ&_nc_oc=AdpiiJXEv31quDV2RBeITDJ44bs3KND7pBxtTR8uDEFBXGDdqtiuCIg0Mqm7BKVtwFg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTGd-Yi36ABcIV6XMGixKry__j6zwq0Q5yJGdwowIA-Q&oe=6B0B39BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0FXX3mm7D4Q7kNvwHgZFKk&_nc_oc=AdoMEmbRQnbsso0q7QHj3xAyPLmt37Z1ONG7hiq97h1fibblQn0hxUMcXMo-FrF__uE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEet9bAqqGIVtjycNVRsrfU2IhCkYjNQPU2BQrBsWBDg&oe=6B0B269E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC46G2T6PVYQ7kNvwGSBer_&_nc_oc=Adrtil9qCYqdpQfX_iUHPSkMEj3tjpg6fswSbX6PfgUDdF2zNu_wqvLDU7HXEXmfWuQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrTd2x3XwiWt6XbMFpA3kvMJMzZxsiRrcnfhyV92jO9A&oe=6B0B2B0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
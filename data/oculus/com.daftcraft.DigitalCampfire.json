8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDkx9BewiP8Q7kNvwHmN6ai&_nc_oc=AdrW7D8RL0ev-PZx1EBJ95SSmYGwdHQsXenUgQsDxxZN0pzopYUObPi4koNkR04Z6R8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxB0Inz2bx325tW-mPYcKhzk4Xrv1EvEi3n-3P-vfn4Kw&oe=69C925C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0kO34KwrlcQ7kNvwHaTKLZ&_nc_oc=AdrFlj-7NbnsAbZ2kcTaGjC1unAXOU_t41ejWeVghRP5u7iogE4-IkfhopbtZ9kQg-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbbF7U4Ur0qtSSvGRk7g8ZHn2wwGhJuTWuwwsfl0OciQ&oe=69C92C53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaYK3EzN-yIQ7kNvwHTwSsF&_nc_oc=AdpwtyWDPTsWFo1_O1U9xtaW58S3o08auqxhi1WuS-_LFytebhZ_f8_1H0SgyMtEZxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymhqQHxkiJGCJfxOLQbS22kjBgVXFDq1jcmy_GDa-Zxg&oe=69C91B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXzJ1GVMx0UQ7kNvwFi8mjU&_nc_oc=AdoTor5njd15CKw2l0zhwHclJtF68eTKQhHurVzEzC4buSz1QuS02GtyLNSjFQhaFXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwISnxIQk5CGwz4ekLXK4JnJYztbdn7V2vvnu7kTfxJLQ&oe=69C9081E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-CPAZ9eizIQ7kNvwFumnnW&_nc_oc=AdoIITBhbrXCW7Yzk8AXvApVqSTADqe6MLWoSEgCeRSILGhlxj2lM6GEORf5YYjSSIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyOWByDoa9a3Y6yg3UfWQYn9vxoIK_qDeXj-rEpN4dTA&oe=69C90C8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgiUZbZMdKcQ7kNvwEIueU_&_nc_oc=AdrhMH6aO4HWi_WYr8Eo3_-XnKDk2Kltsg_ez1JYlQa2Inixkx6dZu1FP7t9MhVJd00&_nc_zt=3&_nc_ht=scont
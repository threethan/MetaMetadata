8618161382", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKBjglIqe74Q7kNvwFj3dYU&_nc_oc=AdoZWKNKQ8aC-C3MAfCXr1rma3eAlGJRa6ASOTqyPjecIWZg3Tam2vLXl5RQgZR31YE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgW1IJ2rx0UUG_Ia45y8OPpJTf_4-3ps8MhCMah9dXJQ&oe=6AE5E9C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8HKSMN-2ywQ7kNvwHbS_fW&_nc_oc=AdrIBNZrr24nC25k4Bu_RDwQAAw8-dh6iZZDrgYtqJb4tUJW9_gRwwsIhl3YKMMLxvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWOHrC4K8J6OiASjVlVVaeQ9AyM-Tq6qCKDTUWjjUklA&oe=6AE5F053"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-V3V3MwnwIQ7kNvwF-ERk2&_nc_oc=AdqUpBnWXCLwbpHQgYs5WOYaCamk7svyTq1h9bUGyPeuUPFPrw5UX0hzCqEEzPLtqjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHPF800DMl_809gAxgYoKBPsiSCnWqoBqEi5dLM9N4bQ&oe=6AE6177B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKGW2FoHIjgQ7kNvwFsi3O8&_nc_oc=AdqggT8gal2L_TSi7xZ_K0XwyI4cbMrhoA2k3YqqJ6UwCcGp8C7fod8lN2hptGRU_0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn5kvlz_g7H2R6YDnCZnAruzQK2PXVXhoBUABPF9MpGg&oe=6AE6045E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVKjkZYZhTsQ7kNvwGVQWd1&_nc_oc=AdoMJyv83cLE_58IpVM0_Oe3n9lSUnSEeyLAPYPlXWuNPCCW1c2Hbk-NHjdKrtE_a3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2O08h92JlPoCOSSth67tncYz4AAhJK8vO5Ec8PTN48A&oe=6AE608CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxOB83MpYJkQ7kNvwEb7_gy&_nc_oc=AdozLgzJCzGboLjJb16cBOjSO4R_zjCx_she7GwM99TcqIxE20bPBR1xVrGGzjDULqU&_nc_zt=3&_nc_ht=scont
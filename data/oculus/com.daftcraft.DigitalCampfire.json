ZSHedE0WQXOr5pJNWuWUAKjiNXXy4jDb9xui024&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIdE9yqMzy8bP6hdHEdXRcRed0r6AnScaTIg4KS40huQ&oe=6AB12DC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7x4GQCPeHQQ7kNvwELk2rq&_nc_oc=AdqBs1zPia9JM7S072tXn64jLVaTRiP9RBycR-9_v94TwJtP6jO6E0HYATDtNrrMT5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL6nNb3cAYRmtlAEBoiqBYfF41g_FR3D_hWyODXQI21A&oe=6AB14704"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-EAodgbFg0Q7kNvwGmV2LP&_nc_oc=Adoe0GM-cJtOrM9K8Yz4c6FxH2Tk-95J8fRc0JrEnyGa-GETUWgCGWfRvnrSXAW06OA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkRMVeMJynOYgbMPaCCM19IygATK9-wKd3xHiHIYHB1A&oe=6AB14988"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIjptynbMVYQ7kNvwElDWed&_nc_oc=AdqbxyzjYU2UWzWVS0dmnUjAP1o5iljywb72K7f5CbGFzMwRXo7xepvQSGTxSmXZFeQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_pUbK_xIztrNY3kZGLOcvlHcxoMeHahmazMsu46t3_A&oe=6AB1485E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfDuH_WJ6qcQ7kNvwHkLBGt&_nc_oc=AdpKuv4YL4OnfqvPlQnzrBhIgWkvmTwOn5sCg3VS99fqqJrmFiRtQ21RpuM6M1sTxXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCzOqgENfvgsvC4Hu2lPrZ18ZGsuGgavkxrHp8ZUtrdQ&oe=6AB14CCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owmhx-RC1M0Q7kNvwFj9e8I&_nc_oc=AdrsScU5lyjBwi_HxuOrJvF50nCV_HZ856za33ij0ch9tAOae7K9JgNVWg8mVsFM4y8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILKGqMhMIYWOkP5iMeG-n6ITkf5wzAZhAETtzdaStDdA&oe=6AB129EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guZVbbCcS5UQ7kNvwGptJbS&_nc_oc=Adqw35qAw2CmmJKARDzsA3i7q1StLW5jTEXmvY_2Hh3E7A_GzDBKovAgAHFSYb7TZIw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo9ZGuEGhCWFo3NDJ2_IKMTADbVCkueV9jNvQYWrM71A&oe=6A806643"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOet_xvmGXQQ7kNvwFg5Zyb&_nc_oc=Adp0L0fzV7MSQWypzgY6cBsoyRH1x1I6-H8ddjZZTqPEoYIOXLMVHm0cl5DXrdz42Xo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOtuPK_HVlNZYgPYvL8k4q1Fz9_SjWGBaxBU0kEIYtNw&oe=6A806CD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm-tKZfG_GAQ7kNvwHDhunz&_nc_oc=Adq90X87rk8M1Ck10sdKDSDTbl4D3FpO1amFo3OyDLKR6bG3O6qAcsXYjfj94vOIugk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHBej1UT80FKzBoKXB8Vdrv2yeP16ZjfPFJhn3APIAUw&oe=6A805BBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apioGTIjzXUQ7kNvwGh44sh&_nc_oc=Adq7Cbb8xuOj67mBCfzL7ru92Yn8wgsYyEJciZJZoVKe6zDUq98RNW_xsn9T_P9HR2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKKGWgJc5X3GZp3yck13H8GK9WOUfTTy4SBDLUwMkkMg&oe=6A80489E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVQ3VZBYEbcQ7kNvwFsmbSh&_nc_oc=AdpC8PnwjCxTKfEkc38vRflUJsMoSAnBKCa1iYfIZxVZwqYcqAWWRa4056p7BhgIIZ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGncixMCuifY6wqpxGmHvivDnCUKmWzfOxfMY9jF8Hg3A&oe=6A804D0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFjEb5t4GR4Q7kNvwEBWyy6&_nc_oc=AdrtKvPy0STbw1c3AXt2DYTJ1oQPlvyNVtWiEyoJTI4JpEjHbC123MsGRbGkLgvZpGI&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4cIGIjJ5kEQ7kNvwFCpXl7&_nc_oc=AdrDXifZi6QdNV9LtccXL80OyZydiSv_UQh_rhr-U2Uoz2FHGq_v1aANE9ICg635NoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qKQ8Mq2PJA_JmDOjm7rsdzivP4aK_hIBBWV9mlCa2CA&oe=6A296343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwFjk41xEpsQ7kNvwFE8Wh8&_nc_oc=AdrBq2joeir3Vm5h6Y23U-wO9p7_RlOgvetfs0pb64o1iZyGAven4qr4mc3kkyptYCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qi43hiHvLkhh9EtPF0yrDadnOMLvTs8JWuO8mDpTp3A&oe=6A2969D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2OKF-q0e-EQ7kNvwEPols9&_nc_oc=AdpnvyYwAcAEsO37k8zvYLwkNL8AHUy7D1s3o5ekAinK6geXCuaxayExq2_ggEASvfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qn23fdLnpeykWNAwQ3bSaWrgEAOZ1KOFL2V8AsUYXYQ&oe=6A2958BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPtQZ8i_0wcQ7kNvwF5IXoq&_nc_oc=Adpk-Kb3SJSxIbwGIt-ahb_a_src6A7aZ6ndicX8QgPFYUZ39D3zg9Ox_w7nxeyPdE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84rHr3ed6KsfvChsinvMIf-U3uvjr2HGCPSlyLjJtboA&oe=6A297DDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATLKkRPpHgAQ7kNvwHqqM9S&_nc_oc=AdqX-t9uC3aCjbfWYiAvsW8chfrJIVkQK1HRci9u0sNR-AJRBG3SMjrM8DNJiHa8yiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lLV2JZrhXdA2_7fZr5CkubqFxAgQ3Bi6ggt3kOLcIHw&oe=6A29824D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsedQeo11y0Q7kNvwGnNmrf&_nc_oc=AdpF3wzFBEBzT4VOCzce-s5A0x9StvW6Rk0so1tkl8vPwKvAykcubd8RVD0vlqK1Ggk&_nc_zt=3&_nc_ht=scont
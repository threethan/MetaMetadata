ywbhSm5WsuO7Dj3b4rOVRZmytG8KqBJHiMQ69-Ypb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTBe4U9Z3N-y8S2ZTCbnirz_grJ9-AeXgyixjnpx0Zng&oe=6AFC73C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd7HCkdPvkUQ7kNvwEOZVRz&_nc_oc=AdplFvoq9UlNBeqx72cVOsH7kw2D7Z-ySaD5H3V-b9gL0ccPuiIRVaacS-6CWZ3fpBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0BYGjAHohGN7t8WAG8XqC_iYtDNiosi4ZzSUpvdsRkw&oe=6AFC8B83"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQTaqbtSfSMQ7kNvwHWK3XU&_nc_oc=AdomvHog09GbD6urnZa-5B-P-h49rjSRWEzJ6J1X4JGIohT3CWz2dxVYBpmLTpMDRcg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGZVSmwAjb4aLvF8_K-hQ5xHmRYcuoRK-qIUUsLcrlGQ&oe=6AFC9213"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVf2qKuxzdMQ7kNvwGETEjl&_nc_oc=AdqCYzAf6CsahegTEoIambTwkocLTY-SLzlgln0OY67NtX9DK63mnp5WYGlxOOG8v0U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkHyLpVOiRrmSlKp-2gSv_NKT9Euyp-_1xH_rAPF6M0Q&oe=6AFC80FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dC6tlHqLhwQ7kNvwF2A_MB&_nc_oc=Ado3ik_HY6cM5Ajp7HCk0qFshHGmiD_ejpBQ-UVGsbNQlfzDiLlLcu_xT8h_-6TD4Go&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyyKAvzuYWnAwkdEKo3y1L84_wdVHL7Y19GEaiztFVjA&oe=6AFC6DDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZgHDb8nO8cQ7kNvwElBZVu&_nc_oc=Adrnz4yUf8yDDwjtIZfLn6E1IWmMgKHTht1x33lWn9_wJsiKCuHIa39DlNFNPiS6drw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4EJd3dF_RlicCZcvlM7gVyrf68LUuweULjJgM-eue9A&oe=6AFC724D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
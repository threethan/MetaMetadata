WCx8CFZoqTBp4hP0YmPT172np9Knvr5IqQXCbDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oVnUnLQ-AMoBc3dhDzlRPdB3-tD-XL_baKcbqbrr6mg&oe=6A0DB3C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxkSnSN31dEQ7kNvwH2mfxB&_nc_oc=AdrpHDh2ca4jROA2WjLnzQsS9qUJ1ogReE1QO-TERe9WahMeYcAiUTmJB31HhC4Z2ws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZW6HC1bk1T0860Yfv90TkbldIu3xS4jaIA2Mf6MtdXQ&oe=6A0DCD04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no9oemdI96oQ7kNvwGTiiEG&_nc_oc=AdrRX9L-u_8sYjJMN_rIvos9m1Z1WYW3MKVgh51_4IAdWX0NzumV0pr2gP4Z0M0NAYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xt17YH69nWM--iX0juWjO-Wtzxj4jyfQ9L79w88fg4g&oe=6A0DCF88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69PcmcCn7tAQ7kNvwE7jZZ7&_nc_oc=AdrdCkTt3017tD2jY0q1t55da6JJYeEbXWW0Y5HEMgIsgYeESkZ9kJ0QmjRhpBamOOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53LF0ioRa_7GjIDCjO-yByk-jwWpIKlTJ2S2Q4K9-tdg&oe=6A0DCE5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YavrOWIBqgYQ7kNvwH7B4zF&_nc_oc=Adrdoi-PNx607oE3XgeM5cHd4ivdJ7-1pi3HfYG4KWFQ3uLaGfqRTORb7TkPF_cF5iA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CYyf7T1szAuaccB-dDbdeQCBszoLCxHzBNmgnWAeHZQ&oe=6A0DD2CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2sAMzYMBAEQ7kNvwGdQ12L&_nc_oc=AdqAucRVfi40LWiXitKZHrR7twoHtV_m3aJgWlusxa1Pxd2p9do5KNnCOktC4JYGYh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KxU8XovDzIW_O1hJxlF4wao1AxlSSgnk6Seb28D5_cA&oe=6A0DAFEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
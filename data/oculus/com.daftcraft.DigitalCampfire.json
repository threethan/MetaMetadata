t-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Anx7Vwx3yHgQ7kNvwFSs_AK&_nc_oc=AdkEYLGb0h1yrAVH_Bs-8ScqWrOe9pq6p2AQs61Xe72Q_F-fKQYQchq0upE5UnUCjgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4zWyZ8Yf7GR0E48SlVUSBZ7D0exLxT2Ajf9KRqRQmwg&oe=69BBF6C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2_oNOnNjVQQ7kNvwFUs19C&_nc_oc=Adk818kuFDf_lTQyVFoW0EkihfGR_fOuMo0xUdzl_YfBNMeK4ZBkzEq7Czp1diRw7Jk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxL6lkCeZBj_-TxtY53FRuNnAFJYEC7trXCpCxPKfpSQ&oe=69BBFD53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lepoFs78DqsQ7kNvwGlXLeI&_nc_oc=Adli_xW4uBzw4S5gvXNx8giaBTGq7ImD1xEJG2FwgEkrCOlmkaN8aTs1NWk51Zxqd7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0t9K19T9TxYkaJL3cO2rJ4cYuXoX23BWsdIAFyJl1_A&oe=69BBEC3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mWW0RT1vQcQ7kNvwHXRwNG&_nc_oc=Adl5GsNor1TS0TBLyWn044YfxUv6iHklIG-q2F5rmKO8O7QYRudUE2oJCiZ77CQmVy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxV1RePODu7oGn34kv6F3wc2itzJIDl-QyS5pBxnGdWQ&oe=69BBD91E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yBezi16eFUQ7kNvwHwZCLk&_nc_oc=AdkpWSj38uZxQNM1EcgNHKaIAUIbdEYtib0-Fl3bZbP2hvsO4iFgMfEu1hTZvE1Ekj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytX8Xypw2frXDzq_7zPtXJWyDhlhXdHDfwEjQqzTEY4g&oe=69BBDD8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FMzDJMFOx4Q7kNvwHRJD9K&_nc_oc=Adlp-ahH4CSrE4ANbu95ZmMP-aF9yRx3m0rZ9bPHQMhThcbwtC_Mp7KGskbKfb_NWug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy13eEHobFukgm7
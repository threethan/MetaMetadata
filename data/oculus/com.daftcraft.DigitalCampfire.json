lWDHLAIaHeiO54gAbXkCLvIK6PWaKoJaxftDNZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASx_Q4s4uwPfu7bSm4Q6FR3GTPzx1ltNO2WtloAmeMGw&oe=6A636543"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bORrVmSpfo4Q7kNvwHAQ6k6&_nc_oc=AdroOI3q3-q3YuOrXQ2A0rs1TQ1dC2pIiVQHxHtk7FpFp6kbAfLE6DUhCozywstlP_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIq9B4eFtQVeQtDnbk_D4Lr2xN8vwB9BBlGzbM82dR1g&oe=6A637E84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46bGDm2-uK4Q7kNvwEZMALH&_nc_oc=Adq6c8ONlOnCAcqjF-laYEjYoJheOYg6US4uN03K1tbqbFmLt-V0482b8Z3cmUjcRe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPA25EixbyzDcU33ukhVQ_5MgWJ4Zi4foGdfDyyfb34g&oe=6A638108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmA0FSdk7x0Q7kNvwGimITw&_nc_oc=AdqmMcwNh8fjkKPCX5MOyjGeC4CHNkHowFAC617TPK_sBNkGixkoNvQYbaYqG-PHqgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApB6E02rRpfmJfHXbSVGIM4XjUiVEM1Wk2W2-Ar9r3Gw&oe=6A637FDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m7D2-2ec54Q7kNvwEnFChZ&_nc_oc=AdqTZm3jDWQxWP8QuxWJloKTmbE7p_kSuMjCtPq3l3ewHg4bvCw075ZVI-8qfiDIBHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV2iiahDy0nDdJ27wkptpzxcunkmvv7AavZZ4P7WChDA&oe=6A63844D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBvHSIBRZiYQ7kNvwG3_heU&_nc_oc=AdrXJw-j1FcWvP7cJRTVYOZifb7ihuX3pyldwEI8GkdC6Dz09gIysRO1RvrDhvhZdCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk2CPwj2h5xDnIi0XaRdN4nDec4EUpip_9xGgosnZSVQ&oe=6A63616F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
mKRWe5plbG-Uh_dD9uWE8dBKTLF28_rddIjE500&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx9NpRDf1HxBwHFHUS7cVxH5_zoF8gVqDGLMTtzEPNWg&oe=6A7488C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFP2MUYeZcAQ7kNvwEX9KU5&_nc_oc=AdqNPFSuNOHKUOylEEvSsnBcgjKuSJewbahaA7Sq5hJxnxBGRdoqJ-bQAbzzg0sKALo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgm483TRJk5oHkxQWYmtOXiK46-Twm9kGRepweB8teHg&oe=6A74A204"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cjlObNtA44Q7kNvwEdjtwP&_nc_oc=Adrr53RnEffgtHh0He935PXj8oX03ogPopm6sFXNjZ1IslPYKCnaGz7qgGSsq8Edy_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH--4ev0yZQvy-3J_o6X08FxtST4k0841wXa3qaSDgfg&oe=6A74A488"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rSeVwl4aTsQ7kNvwFeY9c3&_nc_oc=Ado-dpBauheqExMxaKGILqMmAIC8wU-vCthOIi7bqQgjWXdmlB6cl8GrCUVgD0T1y-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtboBBGqnJ6TlHkWMtmeIM3ZDd2u020pPmgSPxLpyOHw&oe=6A74A35E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Z4-ub8yuQQ7kNvwGXJ0Ma&_nc_oc=AdoJclQ5DauARZ4Db8j-4dqeaovBN4fjY4Axs5EDk9yhApFNfRuQgwCc-jQ-Hpsd2MI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt6-ihx0yHILLWsJ8AzEHzxRK6CPyRwKSN005mM_8Ziw&oe=6A74A7CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foz8HjasM6EQ7kNvwE2_mB6&_nc_oc=AdqlQb-GOAQcZeoBB04XX6VdGgIst7WfUcMfs2b2jKdtDOLoSjgmIIeIvoZNXk0LtJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYRoaucs-NLAfF3ERlXuopm58fuQ2391sW88sn5c6z-w&oe=6A7484EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
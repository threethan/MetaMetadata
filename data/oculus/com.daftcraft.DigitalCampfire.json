_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0X7f-G1fM4Q7kNvwEIXu0C&_nc_oc=Admt1zNTZXfY5PSOpW9uCylOBOPNPjb_Lr2QZcKjt7DxGJpc5I-F_9sog071Tc020lM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afur-LCv0aWL-tHY9pNWN8mmH4d7utrZIoHbmIzKgTT8ZA&oe=69A43BC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74i6ousHRcwQ7kNvwGg9e-R&_nc_oc=Adksq_1ESRAra1mEKvDPHT_2bJ7RF7M64ljvHhPDDrA8OBPRoUdQSEoN3rIyxrlximU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvnBsMFKHDI_h4ZZirfP9ZnfWk8FJg3vECK3-L_4xMKGw&oe=69A44253"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucdOmIpH8ucQ7kNvwHHbpGT&_nc_oc=AdlXaH2qu9yAXRMvIsLEdTk4nMm8y8hN-NTJce6wOOGIZ0vUz5sOwXpQ4QENe72VqB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsic8eZwNnc9I66pHP-z0tWkKsSaNAZ1QueEBV8iwfQEQ&oe=69A4313B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shAsABQJB8IQ7kNvwFy0BfK&_nc_oc=AdmkAjkiW5NwnvTs0AF6nLslW7n7SGhIDMvv6NkWCajJWjvxgfNaI31nCGe1cPvZhkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvbumQkon3iGo70Ymkl4Q33hjiLXvPX4OilaKG_mnu0gA&oe=69A41E1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-oa7hSCRZsQ7kNvwEFq716&_nc_oc=AdlB8-OpHwStXRbF4AlJoDlvMPRbhBeB89ppxFPSvn9E5WyXW04ijFgqnzqv1l57YgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft61KzX2C9BvsQIJKJbnbuOAJXn6sKhAbioafG0ZtOU2w&oe=69A4228D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONqy2JrtVXcQ7kNvwF6YBfP&_nc_oc=AdkQQjoLkHEH9VY0vdvPM4M9rTtmMh7egNSz6QMJ4FHHWAYiD7svs-UZp3bhv-LiIME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvFmBJk5zUQhy7OKdRgxvrdg5mJ8TlCo5EY8oJQe_vXAg&oe=69A437EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
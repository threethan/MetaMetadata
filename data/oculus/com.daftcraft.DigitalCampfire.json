_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsTrZmVA-QkQ7kNvwH05H49&_nc_oc=AdmSw8rwFpYkbT3DARBrQiHPiMbRsPiGuxbX9I7s5NpRS0Hw0RG-FPudw7Zh5Qf9TxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGGKi9dUoIkNjv52qB4zi5amVJoZXz1x_gcfiVHwFhLg&oe=6999AFC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NeNlmRbS3kQ7kNvwFAA-sd&_nc_oc=AdlWztIo88g-PL589qZHWOa95UZMalcnmtcgxE4D1fM1c39K_uQPnmTGR2hmdbbBS7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjqmyN3DCdaO-EXISr3pBLZA11ST5wFpZ0Eibs-ByazA&oe=6999B653"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgX0ZS2KYnQQ7kNvwFADAbl&_nc_oc=AdnKb4k2v6ZnAgctDdKda9UGcGZLICA0rhlb2P5Bk9f-YAMvRtkyJGQw-tBA23gr7Qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTTDwWGLQPi2H4PfyGLIsw4aYwAkFeTaiHab78Bk_isw&oe=6999A53B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozG0Zwf7FdsQ7kNvwHZVYVA&_nc_oc=AdkdCYJFwlesoP-9eg5MBqxBhRWY5ivQ2YBmwH8dVvvOIE8-eTUbRSG5Rc0jva7KRGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvv8XOfVwP5Pn6jGGamxPD67pJXCCvgYQFW0rR0Szln6A&oe=6999921E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW0saUzpPjgQ7kNvwEuVv5N&_nc_oc=AdkjOTdZngiYTBW2MSm8r_MYmI_oa7PKOM8HzIBZzJNEnL_VskdaWr-mrbA3nEKn7xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuW9F893GvviufYoHrWsn-GNKdntZToCLdKrsPYc_5-TQ&oe=6999968D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnFZ34BQShIQ7kNvwEpKOOG&_nc_oc=Adk5chsyK-swQ0kqnp6h7myupnZhkVbEt3Y_7IxIVGO2oCoMfTXPKy6dTCFOLAaLeDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvByNBTic8rn7fhdHVrI2jaK0OEh-MIE2R8AT2WWXq8vw&oe=6999ABEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
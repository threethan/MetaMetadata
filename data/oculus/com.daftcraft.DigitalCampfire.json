52oInwTch9KqQjPuqC1q5NWSAu-LEpzugdhGj28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWOQrwCXTgvNIQEP23Tl82Cc7A6EsPtUYaTjSyidzeNQ&oe=69D10EC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3u4QSzKQJYQ7kNvwHqJinq&_nc_oc=AdqpjD9j6eAQbL2SQhtplo4m9dTg6TH0iqMyJ_eIQNH9Doykp6Cqe_rD83-k2efu6Wk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytiMclmEIwnLE6KjAMabCTYwuEn28ixxajQC8VYD4GJQ&oe=69D0EFC4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7rLtnEqGKEQ7kNvwF_-Kxm&_nc_oc=AdqeB9d0WDkVwce2hNDtMwJLvinHocPSUQoAHe53Ps7cAS68h9Pu6qdWewK8LdV8-WU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzi4AbY3-c79Rgo_RJsuYzd10kwnA_Ce_bEdgE_zchVdA&oe=69D0F248"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0vvf1MabDcQ7kNvwHYr9DD&_nc_oc=AdrKBMmOTDcOGzNCWFyqY2z3Ye9B8AKF3WFH84UzjEgB6-dfGtQdn9VlKSuWtEcTtg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvCAoURyxU6BgMXl2jJCKZvuDAjIKeSKA3nx90CgiJcA&oe=69D0F11E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W49peRHbQW4Q7kNvwFGILma&_nc_oc=Adpte9KWYZkRGSF6cRrjhQf8m-vQYQ7QCJJSj1ld4fGIlD4liOGPRulQvqOXxoxPP4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxG0ouHtohsL3doL2r4b_mmJd4bYET_QAxgtqu1P1ni6g&oe=69D0F58D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UyD1jdbfWoQ7kNvwGVNIAW&_nc_oc=Adrgto9xAD2GZmMNVxLboGLDFBbmBpo9V4AoLBq2yNV_L8sbUeM3i56fTDa81-V_7eU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwn0o3bXEFITvF3gWw_eETqbj_O_4WcCQYyQuPQKEfuGQ&oe=69D10AEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
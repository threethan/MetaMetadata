qfkTlnY9q8eySk4diOR401hA6bFV7NRBAVH2PJU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJlCfPqZxfm4jB13hi7C0cdf2CTjtDZ_eDVbrSZXmZgw&oe=6AC79743"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH3HBUpQr4kQ7kNvwEe0V2V&_nc_oc=Adrgpg-IYfLYr2oJtJJBzrBVs1BjxzccPhhiUnXrY5DPDnrVQl2M3WTOcHDTsnQGCc4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBEHxesaiCzIvPwN9BAg1x2lJrqEZE-o1gLHTV3VKp-w&oe=6AC7B084"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjscITsaC5wQ7kNvwHdGWR_&_nc_oc=Adrx3RcyqYt8G-EttSC-IdSHPt-H2rKtbAfGvQBmEozvQIYung47fwefr5xHRgvPZ3U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbmFUSJjpQuzlzDHnPuYHd20_GSBSjP7o2n6hswHa8Fg&oe=6AC7B308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqbdfOZjn34Q7kNvwGCXkyF&_nc_oc=AdrE4EsSWj54qdXrPm5l0s2p2UXbJ6RBpSqPmrjM1MK9yfgzntrdCWL7x5pKUZ3cL2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUcLff7H6iNqYu4GKLpmzx5T2z1F5FyIZHGGFXKJ7WQg&oe=6AC7B1DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igSqIIy8n5QQ7kNvwHiAk9q&_nc_oc=AdqpXbT38gG8KYVIQjeYZ8atuZRR4nQTCLOQnwkGJlcwP9Za3D3_9x6wsnZZzgMaWX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzFfMalqYP2RAa_z89u6eE4RBr9fccd_C2ET8swkxQgQ&oe=6AC7B64D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs7nhwGgxJ0Q7kNvwGEQahV&_nc_oc=Adoxc1niwj6A6d6RL2rqQut8DrbTXC_wC2QkrlHPbX6a1Dd9L1NNVh0x4y0z_G2_epo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4OadpHWPnKPUqvykJJxcrthdc1MQ-td4LVtQHxsgqEQ&oe=6AC7CBAF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
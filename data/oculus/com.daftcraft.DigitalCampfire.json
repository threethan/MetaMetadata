rIXkWXmyHKd8beH5vX5HU2lPQW1XwblO-IEA5natvY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwkIRgWjLMHIxtgwcYbYIHgftw2-uAo3MTzwWS9DCr4w&oe=6B085144"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bwq3kbaejzIQ7kNvwHmod_e&_nc_oc=Ador_DtXOkx4bv7D4rQu--Z0kIZfpd28b8TFyBhZebiIgbCoEVE3dMWSK29BK9AIcq0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVyJJazNSJaN4Fg3BAXfPZY6C8fwQQnE7A_Me7-486TA&oe=6B086903"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq32uDZ4bswQ7kNvwHXGgYI&_nc_oc=Adp1pLqNwLJ2S1h0RIuh8Dy3BJqzelCPsci_c8GiIdY4TL5rYbzd0efFSDRgMA0QBko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8yTI5bg8u6aTLWcuZ0xBlMlG5Bu_eCq-RBxK8FSwMWQ&oe=6B086F93"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7mnZIWuMUsQ7kNvwGKKAJm&_nc_oc=AdrS7r4ft73_1YjlNaeqAGMWauzjo72tr8kWTrsWvrKCZF5VsTl-0wQEWzcE0baxVXI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdrfm59Y3wY_jVRd7vxl4uWY98vnqFv6VpImJkPbHJUg&oe=6B085E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTmaaRGpVioQ7kNvwGSgeci&_nc_oc=AdpYQQlVx8NvK0Vg_M7WE_pGLlRhCbu7aZnt6MafCO4VRVqoTLl89ralVTH4psY5S-c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5JLFpDp7OJYJm79xfGGy8LmXq0VSeJ1K9_VAD-wl31A&oe=6B084B5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F64DcPH199UQ7kNvwGZYmzj&_nc_oc=AdpEj4mv83-hFxIFnUFlxpZ4iy7fWhODLuJ89EnZceTAGiHFYXunXRvQKRgFoYcLlv8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3k56gUUPjcRuiZacFSiWsxLo97cR66FndXLGgLciy3A&oe=6B084FCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
DIqbKoQgHiifH2B5jgSn5dtAlfbpRnwOX_nTIIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMihRWxDFwZkzs0XwVLKCjEzosm-HK6ULVKBl3qE1xd3A&oe=6ACBC403"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o_-AraCH9cQ7kNvwGpdo9s&_nc_oc=AdrH-meO6Dt6Lp8G6w5ESm8G2XVqRnq_OyOMNBOtDzecJ-AHZ189jhHrWrG_S790l8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzJS9Twy_EjeliHrKQ4MoXbzKIMXf8ImJvQdKu_R1Gmg&oe=6ACBA504"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LI41WS-CEQQ7kNvwHA9rgi&_nc_oc=AdqC9aK7l9DYWuAyGJKsJo7hCB7WZLYHjEwolvlVzI8_SDrQ9R8fnO8EKPc3ocB7O84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIJnWcq0LZxaflwGg2lp38GaBAFJJAkgMR_BtMhARrqQ&oe=6ACBA788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdiqfmaLoAgQ7kNvwEyz7wf&_nc_oc=AdoMx5zIVMPz-JoSZKhrO_xE2drGjxZnJp3zgxxZpT9la0zwzWCXqZjHVmT_VMtcslE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLy8p9htBIdf97ZBl93OmOT4vLpRq0__UW6enbeuyJSA&oe=6ACBA65E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EJapexh6S4Q7kNvwFOANEM&_nc_oc=Adp6vp-a7V__wDdvewuZtT1WjhTu9iaBSUCpqbksIQPTemX4M7jvsJJcmoMAOF1s6hE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIvtNy7tel63UiUjvG8XjyXLHdUomSMMRz46HnHfjTvg&oe=6ACBAACD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBE4UgLBJXQQ7kNvwEbDt9l&_nc_oc=Adqc5lwhuTCkJ92Sg95cu8Xk_W8_dQfMNQMIsZSfWUAkmnmoeTTD4DLnQ7BO7UZGz5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdEC6tHrrbBLULWoWHsknExk7yEr9VfxAVwz_TzIc_6g&oe=6ACBC02F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
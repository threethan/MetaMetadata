8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrE6cum2WLAQ7kNvwHpU0HZ&_nc_oc=AdoxNjys5oq_VxMNg1SxRjT6Hdu93KKW9Rpq1BYzeDV1Ua_vL3h-jTf0u15Aifk3bZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QkZRLy3zDp2th5hnzjeY8jwvKi7qKfA2Zwy6F67AyCQ&oe=69DB9AC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRJrP7U_2ZwQ7kNvwE29kEx&_nc_oc=Adr29qPMmSL9XhtAdliykUbSH93AoIOmady3DiX4EXAFGxlt5JEzTKZbpMWbr3iCl1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hmlry0_9bQsIOxYQW6Bscaxc7yF3qBqKVvFqNeh3Qtg&oe=69DBA153"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbO88wvRMsoQ7kNvwHSQXh7&_nc_oc=AdoJubN3wMI4HAxhzNATtQNSbnNd_97oDtD3HCBy1TeWGc8Cap9AYv6fSRDpDhnZ0Gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07OA73qyXE5dfIv0CpDd4U9_IjT9R-Lb50ZYDIOc00bQ&oe=69DB903B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gphRgwuvf_EQ7kNvwF-37Io&_nc_oc=AdrZ_KFW4HJjF8yiVIHkkd5tqqx_1URtNj77e18GpFc-A8eI6QMQI6tua5vvvEJ1M7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SjtqkCp56vNIafKoSBCPHf5L-P6YRSoB6R5_PrzM9mw&oe=69DB7D1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaZoQWVyuDwQ7kNvwEZSgRZ&_nc_oc=Adre_ujKVxSHv12p1blopFXa67IhDhr6B8Eph9HT3Z1f5TIaBp1sQUFEd035LjuVioM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I1joA7MB3QWwTCBuDXe1F6dGIP7HHtGMh9fERjogV-w&oe=69DB818D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGIMx0UJAREQ7kNvwHyGYf2&_nc_oc=Adq0dMjcIgT0ls0XNvn-zenNDHU7gqGF0_YiEJbvr5hudkcvk6O5Z855A3RXgBPU8vA&_nc_zt=3&_nc_ht=scont
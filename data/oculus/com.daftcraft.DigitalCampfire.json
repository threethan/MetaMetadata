_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FZp-uc7t4MQ7kNvwFPbJSA&_nc_oc=AdkRPjOA509EeKqBjAAn-Md1NtrZZuomfzhIdtNtSo43ePbdaT1X-o33ShZzX0PDB-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWPfXa9PPp9vDCtTgrG-VqDp0vydhfe12feGT7hpOegg&oe=69A04743"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmjtnEkkos4Q7kNvwEci3gi&_nc_oc=Admnkhp33dZvc30pWbow3nUJ4jLwQcz7D_kQigZ-2ASkFBbJwtj6CI0JePqo6O5p-Oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEhCmBYAWzSj23ASGF29PPpxB7YGAVoiOUe7dY5aDeLQ&oe=69A04DD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkHH5W_k80IQ7kNvwH6feSp&_nc_oc=Adm5SAxGR2KiwwCWs39oAU9PDZIao7Ctmv_h_AWFFXoRHz3jMnubH4YN0c-Hx25tscc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvB7FVsC6yspRlyjs7w9PPUVPiX8tHpGyNx0NANdb6-0g&oe=69A03CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI0ogU4XIc0Q7kNvwEiKi7S&_nc_oc=AdmWWpsKmpx2VzkyQwA-3DlohAgSmP_cr8tlI5UvrNzaut7VOWp4S32Ikjz5r_gPVg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftns47Hhw9e2DUtmImdWnbhyhr4vpasiphXRmi2gz5tOw&oe=69A0299E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzUBSPpBG_YQ7kNvwEfdgOA&_nc_oc=AdnhAGqwfWI5NJX6ME4-iXwTIaGP_W5FlBeRpSufg1BVPNXoy4dT_8IkQnlRXIexy7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnIe5wFMw5LIH-zYNmWi3xJh-ELB0r0IeW4WbW-X_qeg&oe=69A02E0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEO1yqgLeRUQ7kNvwExxtBh&_nc_oc=AdmJI0e8FkqsDZc1AT44xrlCQi-Z4bicljEt8cMcO9z4i0p0rIOewlg7Fjb1P6urQ5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaBX-S4KnOLvVDuabKhXops3sN3dlnjTW-TPXAT5X7ZQ&oe=69A0436F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
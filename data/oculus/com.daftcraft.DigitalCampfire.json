_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0X7f-G1fM4Q7kNvwH0WQis&_nc_oc=AdlAcQ1mlSMxL1xcYKVQutuMzv0wX-GWWuVh5D0d-Gdv2VOKDWVtkhqMKpEqTszpLWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsytx_zry2uMvAI4uKAp6zRX0KR_iRHckp4UOub327HYA&oe=69A6DEC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOHcv3LrmhEQ7kNvwExtENZ&_nc_oc=AdmszALOeNLneuzt1z7Z-klOy3E_q3W00XOd7p2jbuA8VIwfmpWzKo2Kwj9paSK7rV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9gcs94N_yzp3rpOqUt96wqwTqwjULxQdaf608s75BVQ&oe=69A6E553"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WsWrCA5GeUQ7kNvwGZR0Zv&_nc_oc=AdneSbTEbLjvFPXph7fkLp2dacn37Qz3brWgaVRqbgdkbyalkZxh33LvLEytcz0sX1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftoW6V_vEa-BXTrPFf8upJojg68djIG0i6lZYSMxFvajQ&oe=69A6D43B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2J9IeOdBL4Q7kNvwHe1CrB&_nc_oc=AdnHWC69xY0UnD3_H320-ZYPHYhTZPd-0qWahSfOjeAKYuvnxnBKbzlQqS5hFNsVwmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsw2o267Tx_YE3QpyfTFNOmexN2qCwdKI60wdQLIO56Yw&oe=69A6C11E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJjMIHvm7fsQ7kNvwFX0Dbq&_nc_oc=AdkoxyRXYLA7mNzaRxhX-4nB1fEECu4zghrQZDd4uT6ziyR9aHO6e-Pb8WgiuSj97QU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGuoc4Ym4t9OFmC11vZntgPV91JgD9BAi0FdlTXn3aeg&oe=69A6C58D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONqy2JrtVXcQ7kNvwEFY6Dh&_nc_oc=AdlIiR6JTJ7ZiAQZqvX060KvcdbddLlrNGNb-5RkjfMzGgrI3UO4JW9Fs61-2GVX6YA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2ipdJj04AKRQz4jJoPy3viZPtDrcRLMaOcf56u8_Olg&oe=69A6DAEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
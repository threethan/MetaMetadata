8618161382", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKBjglIqe74Q7kNvwFLVRwz&_nc_oc=AdrYhAIyVSGzSMj_WpD4SQsZH1pFSCpjLDp9FGf_02CxgC--A1WyUBjoTKGGBzYSJUU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQxQzUA0GOLZx6yX2AWYvN-hgUMeOWMHPTgbO4u94eOQ&oe=6AE346C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8HKSMN-2ywQ7kNvwGPx8OC&_nc_oc=AdqNn_MxH94rVN6GCZd4Q8JCQI4HAfUiRQ0dpmy1nf0Y33M3XoepA9Z7dTkCsqUZ_6s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl5HOpi90LcJS3K3a9MKztYCksP4297oZalaUQ6j2UwA&oe=6AE34D53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-V3V3MwnwIQ7kNvwFyPnyu&_nc_oc=AdrZLzrYd-3K8bWe09nyugTKTe9KXw0XMT30IdSE7TsqGkD902W_wJgTVHbAsK1Hngk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNergrc3YDmlZ2PdGUOVgAk_RGVWmsEyyH9odu0kpQ7iQ&oe=6AE33C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKGW2FoHIjgQ7kNvwEc3cqM&_nc_oc=AdoE8WWo-Wm9WGQnZdrTDcez1LlWDtcN4PzYFi6GidNRAuEips_89WEtBf0duWFsrpk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlQpWH8TIQVxFKFbw4y4xpHnLxNwNrJGKo4ahjbN-J0Q&oe=6AE3615E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTn4yrngvA4Q7kNvwFD0AZF&_nc_oc=AdqxQAPF8K0eRWh-EGto_zIqQV_LExl2RWSayuC3rxBKTZKSb8b74pj8kZ7U--_5-Os&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJzqSzhso343VZ0hF-cwtlRLXEY0Ob_qRA0_HlfCcEDA&oe=6AE365CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk45OQd0dYsQ7kNvwEsimsc&_nc_oc=AdqwlnO4cBdnGUoovmZokxZ-QMANZIobm-3_PrmczCXkySQNyBuZd8hYqGsE8FvzlUk&_nc_zt=3&_nc_ht=scont
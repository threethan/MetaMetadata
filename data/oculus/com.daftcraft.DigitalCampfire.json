8618161382", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2_h5W5eByEQ7kNvwFyEWBq&_nc_oc=AdopqvMCoGf8q3vyh4qcFVHebTj1MUfX5L1hw-q_hhx7pbvzPjWUnOsiCDAw7yKPJ48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL7je6FQHmRNO4tNs94S9Lg94WOb4Rqp7f52vzwRiQXg&oe=6ADCAF43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGRVgOKnoVAQ7kNvwF6Zwfk&_nc_oc=Adoc5igrsUG0ZgtuxyjmC7Jq3jaV0tD-Zps40ekx9YEpnlPPpJF5OdOKw4WTbrXp4pM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjBxiUJ_DiCqQt65tDlP9jBUTfsW34tq-yf_1zcFPI2g&oe=6ADCB5D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf_BZvmbmdEQ7kNvwHtUKe-&_nc_oc=Adr6bgr4Qv6jgY6rkosrpt2_QDZVWno5QDZoOgnQsBx_NeHYvw09ra76L_T0vWhUED0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2IaXvt3q-7AERggxAnYVXqk0APQw5TiRuQATDMF10NQ&oe=6ADCA4BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QppALs2XdZQQ7kNvwFkFmB2&_nc_oc=AdqXeMqTs5jGWvDmVt6JRSX6uA_INBIDXYTy8Wvc9sVo5EAmOpuoTHDGezMjj-KHqj4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzQHMAeQZaMJYNR7b94RttARopPJcAzonlSKUMMupnpw&oe=6ADCC9DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipGifBOo0TQQ7kNvwGmENKG&_nc_oc=AdoTtr-iz7EhrnMRcKL7ZsaS9LaeJSwL9FrzUlm3KJzruwgHmgsl2pJUrAbmGZi4yDo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7EIQFizf3RULVkEGVm8Kmm2RRqGkgYAi1j0weo_xvIQ&oe=6ADCCE4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMfqs0UjWcIQ7kNvwGslgfM&_nc_oc=AdpKyfTRbhvvVpxp9A55pNooYH3bH4ATirQM7-h0rpJ_qtg-Mk2ABiAUCO3Kgm8dzY4&_nc_zt=3&_nc_ht=scont
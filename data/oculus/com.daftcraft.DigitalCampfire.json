8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHlqCAzd3hIQ7kNvwFEw2l8&_nc_oc=AdrQZMX3sGwgBJA4Mffa0R74M2sxL1V_73rtmcZwAw6fWjmeAMXut00ZH8CS7zPTtjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK6orA_O8_qq_9yjNW_kwIwZq-XiNF4iluIFuDHR-T5g&oe=6ABBB9C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCL83l9fVgoQ7kNvwFCiZIg&_nc_oc=AdqGCMQk1re-zaBClHfECpKMT1bWbcQ1ftTGtViK522eX214ecfS3dY9Cy-_ggjrJp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwWqjFTmQyTU_rNyoSgNYySqwv9df-mGCVz-UrWFceuw&oe=6ABBC053"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUkMugooePsQ7kNvwFant4b&_nc_oc=AdqgX5rXmL16W6rr1xQDts6QYplLIqS0AcqXD31cMJ-UNi71UTfU77MVmnfFOwoz5D4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0U1qo7Pwj4e6UgbsGn9HYtNMYqroKT0Ei0ILFaD5Dsw&oe=6ABBAF3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f-uEiSHAQAQ7kNvwFoV2wd&_nc_oc=Adr_agF_Mi_wpb_RpVm12V4Y7lnhVDBxVETNI9HaBf6xewLg_1WJI2z4z6SQMHET774&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq23xrux4HMdQ782qu33BXhvDmb6vzQZiyNHWAqxXHsw&oe=6ABBD45E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXh76CyaKM0Q7kNvwHBlMps&_nc_oc=AdrwON-hc6Aap7B0iBMkoP2rSk2OFVgVxN-9KWGdJlIGg5R2kkOuyiTm9owEYFuPhRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO5YSAQhriK3bZsXOv-xC8tiItLIixxjsfLzoTWAXVqQ&oe=6ABBD8CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABecuVS-hoUQ7kNvwELbJik&_nc_oc=AdpDeV3RYggQsHwGMbOBTu40gbNWsKnxyoll4dLsnBw_3sqUrwXe8rGu8IM910R0nG0&_nc_zt=3&_nc_ht=scont
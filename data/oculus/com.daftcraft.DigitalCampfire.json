IlPkiQnp2-CDfV56vwMrdt8KS6zisZpS-fen1WU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K52V_7iFBKK0oxwsA_UCZFUL-2yAOrwQcCs2G5sVmkw&oe=6A4512C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-Hv86ICdlUQ7kNvwGmMzDP&_nc_oc=AdrkfrAb6PttWmH8MhynEjYY_oBGQjOo6waOg3xjlRRZ9621kRUj1oNcaHSYgOp-ND8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ceOHAaDvEt1HsaiIexH_J-UriTe_o5ACcoBafstBwiQ&oe=6A452C04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx_sy9qqqDYQ7kNvwHmz-8l&_nc_oc=AdqhQavti6N4KQ7s7TGXTWXTGNpltg9voi1kNnyecnSkEVKisyRk5-N2-cyFCu88hHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93aIQ9UqxVIs45gO0m8D5X51hiZrxYfEbr4wLwDjHqEw&oe=6A452E88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DYvxZ_c_V8Q7kNvwFDlln8&_nc_oc=Adr52Ggbg1QhbJcw7LmPGW5wLHSWA5kKcoRmtBdGonewMdiXocBeYaO6QZ20zhjd0wA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ULOaOLAOe0J2oSW6Siq6-3b62VVnR3IC3-NnZ5jJorw&oe=6A452D5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu7q4cfm8R4Q7kNvwH-kaDZ&_nc_oc=AdqqfsnGlQ0BMVi1ajS8lX6wbworFZN7wDpggv7TXOvC-Krk6YuiTOwsWGMw0h2lpgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UuL1c1wrcTXo-wDH8zo9ZPoIhrICBtUIDTRC21IVbLQ&oe=6A4531CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8WJpDKNt04Q7kNvwFXn8b2&_nc_oc=AdrAzgsoRJuEt6fOC3RxGflLo_rP1azsBgAkSoZ1abEpt9PiUVWPUJTI0rD9ngVXpl4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qIbgul495bkuiFuuD40s9hBYzSy_mG0yLnIpJ_ycSzg&oe=6A450EEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
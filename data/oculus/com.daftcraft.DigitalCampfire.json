t-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9v0Kao70YwQ7kNvwHJBsOE&_nc_oc=AdnoOlsWbad05siR-aofVDKtKCautxuKzEA2LSDUDV2Q2EVYeohb0lp3jJVIMK6IlMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGxZBl7E6PAVmQKvgkQJggYk6I_h_28LiE0jIlPW8Jfw&oe=69B953C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6uYbseC-Z4Q7kNvwE88hwP&_nc_oc=AdmWtvden9SRppRxXz42NrVcXMaXBv9vzW9v8H9yRyazLhGgAroWBbcQMdjvQRcuvxA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEDzq4eVmiWD3IWmR0wj_DPsg1nAlz85_uyIqOpjFUzw&oe=69B95A53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_TNh5tLMWgQ7kNvwHHM2Dw&_nc_oc=Admwbw_RYirBf9ckj0Mjv3iKnYIUKvkYBb96313f0bidVl5MUz6rIBb9Awlw9dmL2Fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfweVqCkuhToxnb5q2E7pzMD6kdsXyHNBsiI0mAOGXhs-A&oe=69B9493B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2hsHx8z8H0Q7kNvwEuA5U0&_nc_oc=AdnpOPWcGcuMeCRyPf9viyBdg3gBbMM5kJ0hFRg1OupxTk1bEyePaDGQmZxw67nAjj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdgM7h0gTs7ZMhAwEdllSM4CQf9DQQv7XozyWfFCG9oQ&oe=69B9361E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yBezi16eFUQ7kNvwEgkhf3&_nc_oc=AdlH7ORhSpncqMEZNPXTFh8UdDYbRUThk8OoPO-JSZFB8Pc3s7KnXhzA7RcnD-He1h0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNH5_V9QY4CmKIMinw6C6dkoVo4lM0A2gC6NczoxTrqg&oe=69B93A8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Prz8NFG038Q7kNvwEqWOeP&_nc_oc=AdlDpwYSf7nmPv6IcZmSUbpROsTOOOcmtMZpMrPfCbXnw9WS3JMMH5Jn8b452wIc1g0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvxNZwcGlJyaNy
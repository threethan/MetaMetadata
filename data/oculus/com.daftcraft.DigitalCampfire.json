8618161382", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKrqjL_e5IIQ7kNvwErdc8G&_nc_oc=AdrdRPsIE4otdVImu1r_0p2Sr3tHyGj31ocYcHCl7FvqU1g5VG83nxhF5sHViRgxXf4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZqWe9K8Tk1LhUXdHQrNBxa5b7wFEwCxREIoWIHMLsyQ&oe=6A4E4D43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBrBR1yLI70Q7kNvwE3Dgyk&_nc_oc=Adp27CvXWj3I2BBYgv-U7okX9URRTfXap_W3OlRr9nqzDKDby8UwY64LvjaDtlfzTNs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_FI7UtOLGYqnIsVa5Aq9LLH_NeWstPEq-gCBibQihow&oe=6A4E53D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJEB6AoWmmoQ7kNvwE56DW8&_nc_oc=Adr3eV8lTgYX658-M_bwQ15hybrjSK9YkoA2CEYCnjal-MKalneBqvkT4pn0Z6a-Jyk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCI0oMfCxZI1J0EHkbshM96UWW2LD8a782Ft5sUu8dbg&oe=6A4E42BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKkTv-oS2VwQ7kNvwHSaqf-&_nc_oc=AdoUnsxfApXw8WdRkhaeh4TBcA06smgkswZzwb8W2GZvB1jwOKZWiBs2URYh5VYrr4Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB552Wt820yB3RVN4kVnmqofFHnXvLw5Yr_ugQ6o004Mg&oe=6A4E67DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZuQ2YhoI8MQ7kNvwEC591m&_nc_oc=AdqpNelQH1TrzYqHT6bnxly7f-Qb6DvocGSEXGEblSwuivKoJ_7-8aAVkHscOnKU4qk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHLYTP_rGD_Ox7SqFAds6nvIbvdK6g6g53FsV52Eo3Gg&oe=6A4E6C4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLbemZMaG8kQ7kNvwE_GKMK&_nc_oc=Ado2iDDESJHK4l5_5Y8DaAfioyTKobX3pmizw4ZoLcaNbTqTxM0FtIWfTcgM9-B8Qj0&_nc_zt=3&_nc_ht=scont
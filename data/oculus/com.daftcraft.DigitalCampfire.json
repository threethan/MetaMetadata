PTQ27AYWylGDsjWZhCG4zSu18Md6djORqqNyjR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTynSAUz6wRgQMHnpp9Vhcor3khzpjXZ14uPaMzn_pcIQ&oe=6AF1FF83"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKhD52Z8DYAQ7kNvwF67F1M&_nc_oc=AdpDTnD_VRLldKF3gtt9wKfOUrg2Q-I7G2knQsRza39Z80p5ruu4gvdXDYA93MxIjxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7nj5vU4DitO8RmsjRuO8vW0IN6Fdm8CabSifq0aZD1w&oe=6AF1E084"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIomxvudTskQ7kNvwEr3ql1&_nc_oc=AdrkjcUa-JUqMtzgDaRSbV7TXJ8kN2UoQCrvoGNlg2rodl8A9FN5oj76zOhC-UJ_38g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp2DMKwc-4w88Yint3qvJrt7_K6OgRJSAjmJzWL2sfiQ&oe=6AF1E308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5dmmOInYN4Q7kNvwHSN2Mk&_nc_oc=AdqpPYUn6Dsu0LcPgYojO7G-IXeaw5s71Vx0qq6jAhuFO9C2bKL5gOVm8sR8R899lc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGmkNxXcd1zG1S0B1UcvtwTli0r7yHX1F0wGDiyRlj3Q&oe=6AF1E1DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcxpPs5h5CwQ7kNvwFMGf1s&_nc_oc=AdqAaU508jKPypcuaNoh6ppY5V-79FVxdwMNeajIdRuDbqUi8Ut7xs7xEO1ahNqaquM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTudpkgFlApi_QThZOlf3Ph7ZtJiW46gTQJKe2fyFdP_Q&oe=6AF1E64D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYP74fcc0gMQ7kNvwFqsfiN&_nc_oc=AdphvEf1SNyaZWH2FxnsCSR3ra29M4-AYEKKdiPSsHANDeZedozqVaLsB5qrFtAPzFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3d5ltpE4xSwibZVugoyBn2D_OEWRhftoNS2ax8xmkiQ&oe=6AF1FBAF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxAYaEKDEgcQ7kNvwGX7GmN&_nc_oc=AdpG64J2ttn0bkw2feo6NgeDyuGKfjfsxQQiVTvYikgnmSQmQ8WXlOCFnACqr3YpjBw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU64r6bRAQMgc0-Tj17rCLKFW5jnDFJJXE-LtJigJ3gQ&oe=6A92DB43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T5Q7wo-lY8Q7kNvwEdCPNb&_nc_oc=AdoB0S-F7fN2AAVfZrQtBxgqdonx5est54CgYm9lUfBF0tKk2XwKHUyhzQpXs-GxgDA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF70XfVTA8NaGC0jQjR8jPWcE_CA5xWE0NBAJb7afzx0A&oe=6A92A993"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20WCXTZB3AUQ7kNvwF1AD9a&_nc_oc=AdqbYKiGNHN09MdAAib9IfQeNkQwih96z6eZYRuHeerhDYkvSVzv_VMimPdKxrydKd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb3jLbEq95FnxD-LnjV_1ql_04DHk91HbXe2d0IqFJwQ&oe=6A92D0BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IskrA1wJvIMQ7kNvwG8K2Eh&_nc_oc=Ado5FUVv42g44_v9Tljxe8tMa-yeyWgGSfnr1TnXUz6Mo_Lehc8OkhVT8YNihyIwWHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyYSTgaafLrLlIlkIqv5JGY9rX5m8xOWLnGwu6zVbP3g&oe=6A92BD9E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYqQja3_XvUQ7kNvwGTa5Oq&_nc_oc=AdoqAaHbhJKz0lEBnyb8B1GTMOxJy6AlHVK680fa32-BL86MQnJujds5ysd1uBYjjv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH958U4mn2MTmpAofRspLFl61c_zsAPC4cFEZX7DT5jYA&oe=6A92C20D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBri8Io6xSQQ7kNvwEoruVB&_nc_oc=AdpDdPXoGDd7EFthiUTwXHXfGzqxoiG9tTObOA4___CyboiHBwLyUsUyRKNxnHBxdEg&_nc_zt=3&_nc_ht=scont
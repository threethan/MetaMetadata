GCNdlIXO-BMEtuLyDBtodRZpA4DsCvhgsmVdzM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhIPmWt6RF0_ltu9uyXSV_o-Rtp_mcZKmOrJCIyVCBaw&oe=6A7C71C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE8Q0elT2x8Q7kNvwGQALmn&_nc_oc=AdqLZ3MeaTLe4iAudIICMGwhDwcWz6nLdbhOP2mez7a5CL21u6o_13CWe3ebQLzVLf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-NxQ3EqtkTQntVaDCAgisaInexF1J5SrC7Zjj8lTa5A&oe=6A7C52C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feYZJu6ZRwYQ7kNvwFHs6MZ&_nc_oc=Adp8pyjl7v-H7bJxKC3KjtzBsmQNc_hD8jzQbn4nuZuqcfTFdghEdjkZZPQmKKLoW9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGui56gBck66HobMtgcpux6KAD-pLFj_T2j4nmBmzh16g&oe=6A7C5548"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCG88dgM5RcQ7kNvwGDvW3k&_nc_oc=AdqxU5eh-70tCWnKwjuVeC0nHXEpc4DeHjSiOjcPgqVcozY8-l17WVuIU775DHL7F-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWnS_3YfSJW5kQ5A2LfRa3Qx7XeDtzh7RHVfJkTHxTyg&oe=6A7C541E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX4goTZnBRsQ7kNvwHLQebQ&_nc_oc=AdqCH0mTO1iG5Nl9sCDIBrmtsW0Ybn4xo6IxoS0cVcastt4znRTrQkwoL549oIR5QoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0dhi6bbTZHagDNoB-aSwdzMSEmI_-mZ-pMhluEiUcUQ&oe=6A7C588D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkuygYEmS6wQ7kNvwG5uoxw&_nc_oc=Adqr7mUlIh546GZkh-mI9HZQw062rAz-q3NOVxHYbCe8mibDbNvhCzfj8jvxZBUn2E0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlSvqKavYqqMvCV_goj8nf2445ZZPYcN2SLdid7V_3yA&oe=6A7C6DEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
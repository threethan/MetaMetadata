MigFOQNVx_P-B2qT3ZSdjZE0s1Fav7HhXuG1WedUf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrMZD_7BlXGLfHGMNLLk-_DXG7qFJfA484HAEFsluT6Q&oe=6AFDC544"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd7HCkdPvkUQ7kNvwG8nlM7&_nc_oc=Adq5COSktakTdOD3f7W-cR3-rs9HE8sHymg-Dnd9RCQauth6Z8fdEglhubiR5ik3kR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRo4T29ccHt5IMaV2S3AKcX-R5ZUINxBiZDwZ488NyvA&oe=6AFDDD03"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQTaqbtSfSMQ7kNvwE6ZeWE&_nc_oc=AdodWjfdcBOS7xX9PkIP3GKTjQwPuhk_ISg75XWXl3nkfkjZjYAfhCH5j8O1NAzcQp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh3KxlXsjBWLmNIjJLIFOTEaSKXVgDclv9acBoSfs5xw&oe=6AFDE393"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVf2qKuxzdMQ7kNvwFqmr0z&_nc_oc=Adr5ZCbbAxGWRRN7XGDrLQM-mqcFXlCsgn_MvATjx7t2o6raegsQKo7_OEBNUoPGK9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9UMq6w5bT-tITwnHtrV09lyl4xQwbPSUFtEtgTD534g&oe=6AFDD27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dC6tlHqLhwQ7kNvwG9jXOy&_nc_oc=AdoNzZh7AfzKW-cdbRclEukg1R_Tm-ysGW6yw-hAWt0J80rq5z-YZCEFLXjuiPMptos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDv91SeMWtbwLMyxxpdzZX6Az-UzclSEtTrw5hqSLmDg&oe=6AFDBF5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXtSvS6O4PcQ7kNvwHK12Ys&_nc_oc=AdrI-3MDYzFVfrdRbKHHrp9baXl-hwfF4fexowLqIllQJOAPxW66ZhoOo7eGb49djh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXTwmS4lnQogE363mnOlTAtZBEDhgczf8rL9io6dMVYA&oe=6AFDC3CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
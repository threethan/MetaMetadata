8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4cIGIjJ5kEQ7kNvwGv1vNl&_nc_oc=Adofoi2xBWnOuIGOw8U2VCd9gMmKZp4H2om7uz-NWnsxsMKAnmwsRlr9WdOZv1FWY6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kmB5_OFwwEybmRhMR52-ifIMgdPSgt4ij6dJgj3PlnA&oe=6A2AB4C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwFjk41xEpsQ7kNvwFuP7UM&_nc_oc=AdrjZn6p8T7dUZpsuPuDOhqJSZWIMjAcPseTN1l4mJZ81YtWQ4jCkTosjIDj9qapYHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V1LrNsKCzE2DeRgVlgDv9TXJVGXI4Q6Cgfos3_Ya0AQ&oe=6A2ABB53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2OKF-q0e-EQ7kNvwFvWYIV&_nc_oc=AdqzIboLldDr0a4zNAPEEeV8E9NDbIl-1DvyMQaf9vNZkJsttdIDGVlA0WPJvQ6h054&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PJSTEofqpOOxSv8XY6GQyyZ2Ug53Ek0u7CW3hlaU7bA&oe=6A2AE27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPtQZ8i_0wcQ7kNvwGmmNjz&_nc_oc=AdrrxJWdoWe0781MjoXWByQfhSGdkKEIy_hkgcY1yKKRpu0kxPTO-epEttprqIiazRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RDVCKIgYraQ16CKcgqFZvT-RNeOiKiGVdv4RLtws_sA&oe=6A2ACF5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATLKkRPpHgAQ7kNvwGKWFmb&_nc_oc=Adr11TKMq-yIwUkRX4Pv8VFBLEMs9oivwLO5B2J6ISZiADBpiLCmMUpVSDLhirsCYuI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LW1qG41SlMPFT5PAX7sfdYquXgPuUA6-b7IRwCVhGrA&oe=6A2AD3CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcbvT9IQE98Q7kNvwHNLtVf&_nc_oc=AdoKi9glAPb2uO43VGrgEKpwjtUXyZsidcuHdSiJyeHGQ8Qey5eGCbfS6JrtcktVrhM&_nc_zt=3&_nc_ht=scont
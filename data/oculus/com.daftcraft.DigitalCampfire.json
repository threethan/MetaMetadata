8618161382", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrE6cum2WLAQ7kNvwHbyiUq&_nc_oc=AdoAuqVyzLEsH1OY3SGHlrcgRDbF2ZMY0E0HXdlsti0HjLq-iH-NcbUZ3PMpspwP-O8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JG4I1VAyZxJkTx5ZRp5bRiZdHxKeaVwisStPpdKhj7g&oe=69DE3DC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0T-sqZU34EQ7kNvwFGuggP&_nc_oc=Adr81IAOOOrRJbGWRbFj7-JGz5hZ23rBAfBdCG5atfmqHb8xMf0l1qKR6hEb8oGz2RI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QtRYmNjNwZhOoaoBOAs9sVqjUUsnKxMaOl-oAxs2R2w&oe=69DE4453"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko7UjrqJcOsQ7kNvwGQC34P&_nc_oc=AdqcMW4wGeUwl9BEXJmkMRMiBZdgNMEk-7BsTwAOPbXhda3SaLPUW-_ne7ygKMj4Jk0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07sGE9BWdNHh8YPHiGymGmuBpxnvLuO7qP8d7lKGNJ4A&oe=69DE333B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0g2RAPqRSYQ7kNvwFNiwcl&_nc_oc=Adom3ECCtMzHPmZuP0QPDc6k15GUJZUCjG0dGMKpULPYJYqF66eD-5WozBc2CqcEnDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zrbJtb7QyurpFPA6IsZ_lKt4eayJrEq56oCgXsM-eFg&oe=69DE201E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADAaPIvGrSgQ7kNvwEwXt-h&_nc_oc=AdrQFcZR9h7xkZHcLbB1CxLS6bghDL551W0uX790Le8PEF9Q_HuYJDB2BAkmfR2ZrLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uwHmRhMY1cEoEMluIocGjwYtGaWuJbArOgRf7VoyxSQ&oe=69DE248D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGIMx0UJAREQ7kNvwHN6Obo&_nc_oc=Ado4Q8ewlmBjSSDI4a8tAcgYkyP--OqA7tu23eNYmtAmDhIcKioqdlAUpry7JyCyS8Y&_nc_zt=3&_nc_ht=scont
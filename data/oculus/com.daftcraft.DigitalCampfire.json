Etiop7mWOh1FLC7TffQJSkplSytUTAxaxB09iUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv3h4I-0aFwjz8Xep7sJVuzfbo5oYI4nPXIo3wWxVVkg&oe=6A5F70C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKUm30zK87sQ7kNvwEWjMhP&_nc_oc=AdqZf3CS7t5JagZf0XMKoqPl9R7h5NNhPA6Xmst2fYB-6KqexMcNYfaqgqfvkN-eZZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2SkZTOCXZPoZlUZk0XaqyDGKZHZJ3cJKjfdO6skOFkQ&oe=6A5F8A04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJAPhxMu6usQ7kNvwENhxAj&_nc_oc=AdrU-5AEm7FM_qUKrGgOvbureKPSo_d8OZbhGEb1XKxWmxg1UthEH09eCJI7uSdXY0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeyEnDSC0taj_yT1W5ze78m4I7zu8okoCI1ni_xHnKzQ&oe=6A5F5448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVknimpY9wUQ7kNvwGdLvAX&_nc_oc=Adrv8rf0r3UfReoSVOuGJvu4Ju6hlufSSZBduV86nw-gqm2bb3nzMkiieJTXnvCRdUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJCqqSWkmK--LnMMZl-eIGtC0Bb4B0Tv7XLUvuwtsEqQ&oe=6A5F8B5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1GsaZgZTjgQ7kNvwFkc_iA&_nc_oc=AdpDTfVxvPIdugqqK6g3RyhvKHmmVidO6v9-OrUYUSFuIenvkCD4O7jvWyFwtiIAMo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw9W7HPJ78QgXSCV0hFriTvtorv46BuRDrA1DVoJNl1w&oe=6A5F578D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH0OvyX_Tp4Q7kNvwGdNX9v&_nc_oc=Adr_B5JZf3uQ6VTDQCKd4VtwAqR9xliX8WbZgLJ8K3ryMOPCRDcZeP_hRM7T93o0dnc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxkEPmBPbUg4mby7sBMBvIMAzpxkE6S57MjyUZWQtB5Q&oe=6A5F6CEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
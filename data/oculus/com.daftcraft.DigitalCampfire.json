8618161382", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7amEJnrwk_wQ7kNvwHXT2Ua&_nc_oc=AdpJQWkFp9Tb3ibEJebBcbo7sBnNWPaO-uTijb4B7lNwG3KsSG4LKg4y2joThVYwaIg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYKIS5qJ4i0eAoGKOwIXkea491MbNqMCiDpnlxz23xlg&oe=6A81B7C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOet_xvmGXQQ7kNvwGyimbD&_nc_oc=AdpfGpCVWCIHQFiQ75ZFxSSHDS1NW8BupyVsjDcC5e683seLgCc_uUjXZjzy2rFIU0o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER-xSTeOLG9AIjLNcX1HwJPdSQWgCMBMY4yYyd8BiONw&oe=6A81BE53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm-tKZfG_GAQ7kNvwGKAevY&_nc_oc=Adqb0LsuDoGFyfXCdIy6eC7k5Z9K8d5Uq6P7ofJJS4OW5R-VrmfeiPkNAv5BzRRwKqw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpd5ZKA7UdwciLkEpbrp8AV-PMHfBcTWfVfAfAjc13kQ&oe=6A81AD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apioGTIjzXUQ7kNvwFdUP1d&_nc_oc=AdqVaEjhtvRlAbDnnKttQzBC6dkxRCgvcTX6bfqofFUR8qID4jf6ge51cQKOrylYUNk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPMdwdjiOEFmdo69khKsiP8O_AUjxTN_rGf1qUc9nJnw&oe=6A819A1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVQ3VZBYEbcQ7kNvwHXFlUg&_nc_oc=AdqM6BVL559aFz7QUpMrs9845trU3lKkzOEaB2dXZ271fz1Dvt25PPANiT5Q1nNciJI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQgjWnQtq-BfOt42hBh9BVi3wJIuaFr_12hnScuVTl0Q&oe=6A819E8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT3dZdUfsRQQ7kNvwHvp2eE&_nc_oc=AdrtPuI6J_MdHBqpLS9zL8IkyxDpHoOJL987bhF2wAoeK0egNOa2WlNv-y1X_jLPdkQ&_nc_zt=3&_nc_ht=scont
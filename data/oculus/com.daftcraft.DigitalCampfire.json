8618161382", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QytKsTYSvJwQ7kNvwHZQpQD&_nc_oc=Adpm6Lysa-IlBJ1a6Uoy5j0U__NL5FjRpMKv7vso4BoBea9ssZg-69pgjBXr8equLzY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iBhku6V54wS8bbVCG2uZp-6x_pxkuMOmunxj9sI6Q3A&oe=6A2FFAC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7JEsWJv6fwQ7kNvwHa1SDk&_nc_oc=Adr7VlFTn2YbpTmd7QbP5b5Sf_hStYOoCCTbpZDIDBoogAE11J9IUvKiF0kts9TAj_E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AdtOtjQ3s43Pvi6APQ6jpFJ0hfZ5-YNVfxMLeFISpzg&oe=6A300153"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awMbVO91jPAQ7kNvwGtsMwG&_nc_oc=Adp4mMhyQddHBwwDfdR3b8MgcMv8daavnpugZzvf9nCf5SGh9hqtDbIrNL9zbuIVbZ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KPhIOvO2OgjULNiSb9CZP-j2qr8ZkbOfNrII65zWFEw&oe=6A2FF03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzR3IbngO0gQ7kNvwFaRkpz&_nc_oc=AdpZcRVvrJzn8Pb0NoZ7gigMWSMxVmzWgO_-_Sf1vOgZKoF_YH3H4hzqCJPiiwNjOJk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j0N2fr9fPnHgJYQ61GbYd2uALRwpogxzMjYbV0zvCqA&oe=6A30155E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC8hm1CWsUsQ7kNvwEsDiog&_nc_oc=AdpxI-snu8LFVbcO1TGV6jtoLkVwYhtLwDAZ27HjGNQ-Co8svkePeqn_5oNlWVhbpuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qEAWifAQ8yLc_3V-u_67OSsr3QlzJUaJpBJoX-_ZqXQ&oe=6A3019CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyvcvATBTe8Q7kNvwEMIa1C&_nc_oc=AdpHoc_Nr7e7qmPHl375O4EGyPfGk4fiGanV9l1Kx8pEYqAlo3KEiuXddbhh1aPDl6M&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDkx9BewiP8Q7kNvwFXfxnz&_nc_oc=Adqzxbqi11eDgYIB2j7NOT-rpb3pCIKY7dERq-b8yAQDq4zTHb3eNCO89YJiTctW2KY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycufVR4VUOyakvWxRAxZXq_uuUgnHUJWzyEEzMMVGcQg&oe=69C7D443"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0kO34KwrlcQ7kNvwH-dPwa&_nc_oc=Adr0tkd7eoBywUweODuDB0marQu96EDwCU4V0XVoE18Mr7B5Xkviw3hQVEIltlOdqv0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxtksji7W194uggCkOv3AxH7iIo09m_-9MVKhqdO0Wb3Q&oe=69C7DAD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaYK3EzN-yIQ7kNvwFWsvWV&_nc_oc=AdrTnBid190ItGWOXpDPd2Jhvf-UUzo0e74nLKfiBl3U1OjZfT50FA4o3-p78oxV1YM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpUvkC7ZqxBoZi6lFArx0Q0z4uOv7MxxERQLwQgsWcBw&oe=69C7C9BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXzJ1GVMx0UQ7kNvwHeq4RL&_nc_oc=Adq-c6FpQaW4Bjvf4qHBbIPc4hxAelGUCXVkblVUaKSNEIMkSUq8ZCfZ3abLPYGZccE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXWesgTRmcxeWbjYOuwn-ZmOZA5CtuSAOrW4_AyO0UNA&oe=69C7B69E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD1aWFBS8WgQ7kNvwGYWQOg&_nc_oc=AdoNOTxRKcmT83pP_Xv7qMcFWAMHmQsiBPjcarEubWLm0BJ77_wO0inXMYC2LZdEP2M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afytw0JDn5eYDuaNHFXv3-WcU5xG1Dc07Q-TZBa1gMTc5Q&oe=69C7BB0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgiUZbZMdKcQ7kNvwH21kSh&_nc_oc=Adr4MWxEZQK1YsP1-er3r_ZEmV0pOkbVyFwJAnMEzHnSNHSKshRoqovJypjCeT6YcOw&_nc_zt=3&_nc_ht=scont
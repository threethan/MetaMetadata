EQq0aPy0R2-KOqBvKaHPmVFfAggh5dWQEd6KjXY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p-yUQkZ4i69v-85EIvxQmfHKOsPseklJeeIngd1DExg&oe=6A1C3443"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj_bdIPwtmkQ7kNvwE6CEvz&_nc_oc=AdrUE9QNIqP4qKUoVtsLibK083Yr8Re5n1mO6vi815XYYySUDhVWJt-oINSQQJPMQ0I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RMEbIEqYOZlxaZBwk7FefNvRofvC71oxccb24p8VdXw&oe=6A1C4D84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLCBmjj_pPYQ7kNvwF_LkB-&_nc_oc=AdppD3QEij9PrWsNP6mBnIdvzODaS0MB2hE7rS2I0F6m-ymYpeI9YdCNJ5GwjcJtYnQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PLbG-iImj8LmCHunhYbsTc1u13qGvZcf2xjpLoQN2ig&oe=6A1C5008"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSMIwu59x8cQ7kNvwExynIh&_nc_oc=AdqvIVACECw2_4_20Jp5UBB8PhLbaRH00xqSP0hs-ZYG8ja8BW8pURJYqEdf0xT0G5s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44df_q_vktrp3w5qMe8bhEefZBbXSNpZS4H3aPJDpJcg&oe=6A1C4EDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk0feB9J8yYQ7kNvwHyfGtk&_nc_oc=AdqtzUrzWSkstIUhOaj91KpkJLq65TT85FRsvtH-P4DyQh3YjZvbLiCJLZmCl0n2-9M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rPn-tWnBKVFoKWg2jE6cUC_xkpYXHA0l7dgNgrrNPtw&oe=6A1C534D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o0e2-x9miwQ7kNvwGvm8KD&_nc_oc=AdrxoWeXhrMEY5Ri1FGYcka7H0-QJACmrK7pbmLZuUefKv_4NwVB96Y_xRgHcGgqt4Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7flIAqqKl8mOosyUpVpzBIzIsURa2BuHcufLrKK_TL4Q&oe=6A1C306F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxlGPUHwYGYQ7kNvwFzukrr&_nc_oc=Adq3c5KisO4fwPyzNH20k4UyauvbqPUQ3aQFm-82jL4WgL2coQXB4lmp5UoAQbBX12g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lbZPtzN-XZzrUnSMav0i9iM_t9gmLLjrkZGJY3oNlyQ&oe=6A217A43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0x4zWDwcp0Q7kNvwE7GE1M&_nc_oc=AdrZQfkgWLEEjSlN6TULWDh8fiVSzqMA4oUUclAYrOiK_i3Ymowrk2HZDPUZvkz5YeY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EE5Pcy-parG_0_nz7hnxsk33ttOIl1n6KOt4ZAUVwyg&oe=6A2180D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta85_niaan0Q7kNvwGNiik1&_nc_oc=AdovJBxgvMGb7QE2At2jN-AQtYfjaurp9DX9L2ZuQNHgNeGn6xIKj-8no_DNA1R2qX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lX99KiND8rq67_SMf_WF9SMSOiBgBaKtAgFukYaL2SQ&oe=6A216FBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_XmAvAofoYQ7kNvwFitpyX&_nc_oc=Ado6Ju0Tz0oZWF8XsDCvwKNJ3A3oObB9NYLH0RQOQGRDqJl4rn7CAUr-mjAuHZIfgK4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X77KgaGZPg8Ugn6tAi0ViGab6_H5enOKyxbIaUJyYFQ&oe=6A2194DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWjvKGK85x8Q7kNvwFVrpnc&_nc_oc=AdrUknQ5VacZxG5yB9tT4AlAd630QvFrEtyxr6JzieMWhUK9aF8ZOraZIuwNGgmJp04&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yPzp2ZNNvOxm0pJCFB998-j_xMWk0Ro7vY0Q04zONyQ&oe=6A21994D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf9lvqjWk6EQ7kNvwGyoS_e&_nc_oc=Adqc0A0oMge0mMwVUw1T0rHhYkWSt51P2MU0IEvKU9B8TY5hURoQ7A29RM_Ba_dpXNk&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBNqH3LUlrgQ7kNvwFSJlCF&_nc_oc=AdpCXw_sqz6n1dTWPqjWMLq5DRn8Gw7t2CrvOSqBZlpNT326OgRcCcvnpUIAvmpK5BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wa_Bz0JOJsSYziNcikLHBRiWBnI-IZ1mIj0c-LUTJEg&oe=69E383C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwC_VTeln_4Q7kNvwGRYSRo&_nc_oc=AdoDRI2WFGknBcHrara8YhzLm5RK_hNfqKi1FK9MD1Zjxazhn8LaJgPkw0FoK7JZ6B0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WUuxX7t2y6mtHGFqE-skyEY5En39_CwLQoueYWcNDEw&oe=69E38A53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VT5sPvrUoZEQ7kNvwG3QLTv&_nc_oc=Ado2_UKah1uRv62O0FRnfISxgp_h1kL0nV2iOlIVZc1EuvYA9a9d1OJN605WpY5tp3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_0I1eqgbfaQSje4Kcv9OvxCEpIt4w8qYN2hG1DFMO8g&oe=69E3793B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=817zGtlNOkAQ7kNvwE0bwSm&_nc_oc=Adpg3pMs8WIg_s8B2mK7YRMA2gmALqU8norQCNJGAimQIA5e5aYD0zx3ntFn_CzUSho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vohO1cKF_eyzTCg2VANRzdPWLDUVsa7uUiGpIt-BBhw&oe=69E3661E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrDe0B4UDhUQ7kNvwGBeiZU&_nc_oc=Adqv_rnCqZ3NyVnJOQqowFZt31Rs4lhqDjaDnJkynSYBaAjVYIgQjnIawzYxwBImKSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24WLf22H4lrTR7BGnu7RndBaHrnwSz2xjsVN3Hn5VG4A&oe=69E36A8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsuwKQ4toeEQ7kNvwFwviPa&_nc_oc=Adoule-s4g1-2nWeFU9po3wzBotPNawJ2bulDnO59c7XQqiMsbkloRaeRKSTR5LygqU&_nc_zt=3&_nc_ht=scont
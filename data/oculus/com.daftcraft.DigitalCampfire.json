Xn6zsv5Yk2Xx41cAXuUdrY83UB3Mw7msEH4sqbk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzsye1H3d0n-dej9cJ70Xo1Roc-hboZGyZMGzQL299JbA&oe=69C682C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXWqkCstCe8Q7kNvwHizyua&_nc_oc=AdpkKO6IOsnwFK6i4i81dr6JbCMgK2CRT77gjOigb4tA-58kM7xPDWZ2SIenA0lHjLs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwh3Dj2wE_3JIGucFI1I5c2glpT8ud33KXpdRCYu9wgNA&oe=69C663C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiYDGxi3U5MQ7kNvwG1ClO4&_nc_oc=Adpo0a7HNTgt2WWFMebwp1iASrdTQTNKuiQ5Y_U2PYCmywnS3FnlW_-M_7x1PFaPHO8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKf9rbs9yU63gFZXAWbl00wcjE2stuSq87VyDRAgu9bA&oe=69C66648"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXzJ1GVMx0UQ7kNvwE0ocpN&_nc_oc=Adom6t9InzuXNve9a0lZlawJCYb_Cl-rBxL4Oi7WRXmYFx6hTS6EK8pBb9deEIKZ_0o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-RzbB6h1QG9EJiVIMbCafD8dXIZxckcoXIcrnOlXsAg&oe=69C6651E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD1aWFBS8WgQ7kNvwGsBbxh&_nc_oc=AdrAu-c1dzGxnoO1QkzgvFQwOszVGr4nVm_lNXcp65i3YAYpggPw5zTcmMKkmsbKi-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXGF2nlUOFdQVXD1_Gr01zDG6JRnQcqduXN_7qfRc3HA&oe=69C6698D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43x5o_0ohn8Q7kNvwE_QCuY&_nc_oc=Adqbb_ON0Q_Cgsfq2-psOblqf6Yayvs9hh3ZooEioNk58egrSHRpoYqyWJGpjmwyOOA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwl-8QhrlesXAGoc46r5mbFihJcAXJdbijNxy_XqAxKtQ&oe=69C67EEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
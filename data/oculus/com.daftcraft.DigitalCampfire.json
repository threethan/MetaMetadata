8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct4CZLBf_hkQ7kNvwEEy3lE&_nc_oc=AdoB4URAc2KSvfyf5GWvazlLDrB6mKRWe5plbG-Uh_dD9uWE8dBKTLF28_rddIjE500&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx9NpRDf1HxBwHFHUS7cVxH5_zoF8gVqDGLMTtzEPNWg&oe=6A7488C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nmqd3bKGn-QQ7kNvwFxe9WL&_nc_oc=Adqe0H8poGLtv_hZXxEPL20zuf_blDDlqqUegw9lb82krPex9ACYWsDlFE9EO2LRzNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX9NnPfQKmfZfYeOAxvalJWb9F1jGD5ZDgrkIntit4nQ&oe=6A748F53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ywG8_MZpkwQ7kNvwFxlSTT&_nc_oc=Adpr7JwRVMlj9QiIh_ylNGCVxOtLamSe_rE54uakTQCtTGVpgwBn79xYkx74GErjVBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf3jA1yR-ey6BQcdOrGzgQKFZ1X3ZKjlQ-HEBvXXhUVQ&oe=6A747E3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rSeVwl4aTsQ7kNvwFeY9c3&_nc_oc=Ado-dpBauheqExMxaKGILqMmAIC8wU-vCthOIi7bqQgjWXdmlB6cl8GrCUVgD0T1y-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtboBBGqnJ6TlHkWMtmeIM3ZDd2u020pPmgSPxLpyOHw&oe=6A74A35E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Z4-ub8yuQQ7kNvwGXJ0Ma&_nc_oc=AdoJclQ5DauARZ4Db8j-4dqeaovBN4fjY4Axs5EDk9yhApFNfRuQgwCc-jQ-Hpsd2MI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt6-ihx0yHILLWsJ8AzEHzxRK6CPyRwKSN005mM_8Ziw&oe=6A74A7CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foz8HjasM6EQ7kNvwE2_mB6&_nc_oc=AdqlQb-GOAQcZeoBB04XX6VdGgIst7WfUcMfs2b2jKdtDOLoSjgmIIeIvoZNXk0LtJ4&_nc_zt=3&_nc_ht=scont
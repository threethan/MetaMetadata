YjwW_ua4aWQe8QvNySPerRk14_C1q2VkqTS7AmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TirXNS-f4vvg1rMF3FTwJcXWdF2LLLJOO4F4G90s2yQ&oe=6A0B10C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxkSnSN31dEQ7kNvwHGKOwA&_nc_oc=Adq3Iq-T_53yAO8sCEDT2RIdU2oDhmtGeh9n_jFL5x7euSl-6-aWPOknMZjdTR2O68Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B0t7-5r1fzunMWgc9RGSuQZBwNI7JZUwjU4shbJt2nA&oe=6A0B2A04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no9oemdI96oQ7kNvwGRdoUf&_nc_oc=AdpdrMaOFXAFA9yavSFbd50ntgqywSBuO2501ue5N-xMcjROSZiiE8h6VAyKB3zk3NE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oXUetp4onHMahWzMYSoq6_v64_3lK1Rh59p780cUBNw&oe=6A0B2C88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2tHMTqAmSYQ7kNvwGw1Zy9&_nc_oc=AdrZamrWZVaNedLQhLNCWNUuzxihiQrjYiFbTr9nwWOyTMSWbFUjb-Nl0VbnbpMSz_8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lutUovf82Dqp8EbK0zzm7uuM0HQF0Fwyb9rpWzwEhvg&oe=6A0B2B5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pdPFyyGuH0Q7kNvwH1zqdc&_nc_oc=AdoCZ7rRU0ZLkxR_ijRNGPqDVIHQMIFfAvGNkdMRVKNR3FYlnSJ486oPkm7jS_KU25w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sGb9p1LIQQgw3ldgha5IdEHvEgLQjZZqtt_fP2rdWoQ&oe=6A0B2FCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2sAMzYMBAEQ7kNvwHtSG6K&_nc_oc=AdpGK44TLEG3gkiJmAFbg0SNkmxGxWO_CrtaJ0BJKs4FzpG5V1XXOIEwEBhoMXn_1Ac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IDUhJ8ko5lMK5WusYFg7Fj2MFeotzI4AidBApp7iUQQ&oe=6A0B0CEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
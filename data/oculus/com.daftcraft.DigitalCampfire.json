Dif&_nc_oc=Adr_kWA0nOFJcqLMo_ZYKZZT03pbaq2ncduiKtmV_m8N_W4ZdcU2D_bH79nnT-zFQdQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9wajHfYTyntCqyy9nW4I8sMGtdVng27iByyvPz9GBAQ&oe=6AA3FEC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM850rd5efYQ7kNvwE9hPn8&_nc_oc=AdrEn0CETvxSoyN_pHWMf986VzeWnC4u1XvuEfCa3qVPpCUQL7rLUuymPDL4Je74qdY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsE-rCv1JtYCmRfeu33qIDDr9qObUCIfbHfGq_0aTUxw&oe=6AA41804"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAI89EPvHTsQ7kNvwFfgAOU&_nc_oc=AdrYy5FPrmnaQwJi2iefX1fhF-2jvZ-EJvxApczWTQEkTMP4DRqWHnYwrFS9M-7m7wk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHwUe26PNFontdY4PRXSI7FuoPqls7FNgB3cxeg4LFSA&oe=6AA41A88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYcyyycgrZkQ7kNvwGdmX7f&_nc_oc=AdqK1rzX6bac_fihd0DnTaKCYfNm8fie0RUqCYXakZj0TKYGNWYP2_AdE_q1uypCI-k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGR_Ucc20hfuZlHPU5tneGrih2TSh2AdTE6GZGF5c_rw&oe=6AA4195E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xof7s4kTMKcQ7kNvwEqpLOl&_nc_oc=Ado4bAxg7y7_QnhkPyEjOTRbtUutjeAOv7U0VHM6py-RINajkbVHJRWXb12alQXuXlU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAuSXZYtfT7fGBDIG3SDKQYvKp1jjcjJ5r4Ty1AfG8lQ&oe=6AA41DCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRh7sybiZCoQ7kNvwE3W7CY&_nc_oc=AdqkCCP8S3wUkHMtpRlyVEeg_T_sjTe6o8wukQIjpes2lGder70868dihzNBWpEabsg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtU3YHSZgdqwDnWR2FIA21i_Ba9vvhP1LHjiLjAeb1Qw&oe=6AA3FAEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_
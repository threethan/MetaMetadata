8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xxYJ025hygQ7kNvwFexlb-&_nc_oc=AdrngowllMjURoezlzToQkLaSyhbca4PWBhzoQhS3q0GKjJCNMaLhHhYUJsp5dJWtao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SIxpc6hlrpbERCGzmOl-Dsi0h6TncXvqJHSGgF0nBGw&oe=69D50343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0cFRt85I0MQ7kNvwHB-PgI&_nc_oc=AdoY7udtizcnhSGU0_o3l22np3kgs7PFhw04L_aE2M3hUZGTRUCCnJWMTuiy4DBzSuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K9FuhvPzTghaM3hfMp8CplzRvzWJgsGB5sZv_Q2IzFw&oe=69D509D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgyzaUuP93cQ7kNvwHxuBaN&_nc_oc=AdoFPiI9EXhdqCuNPbwb6FvZqPL8muVnt8qYP0MwkYa0ninsYHyZ9UKjjD9YFe9jj0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39sI5ahsHmAXLBpGiDozd5H5DZrGDjpjPprckHgYqeYg&oe=69D4F8BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgjrObr9zfsQ7kNvwFKGlT8&_nc_oc=Adr3EjeopJazbNA9BhlclwgeqQWgA3Mv4mivmVOhGsdHo2qrlFjKdwJzVJS2ipEBqnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rPtWZ7pb-jEqTLZfaCrUwvBNH1BE1AjX9ZOrn_jXENg&oe=69D4E59E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-zGrESfeE4Q7kNvwG3H61Z&_nc_oc=AdqPkBRHAlQg_JFbFycEFoYq5R3WTJPIztpaLHUY-XJjtnagKgQ_kxPd1vmN7qBURMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_hCBuoZVRnUAvK_yhjWelPNyFr5RYILuCqg0_jBg6qg&oe=69D4EA0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvHD-1uz0OsQ7kNvwG0epxK&_nc_oc=Adq2yefBWYFR1x36FQIi_w0MN96SOvL-ElgtrRKHPIVQMuL8GOMalMQ1-IKG5j338r4&_nc_zt=3&_nc_ht=scont
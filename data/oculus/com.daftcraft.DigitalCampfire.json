8618161382", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kac0cqckvJQQ7kNvwFbbEAC&_nc_oc=AdoLWegs83plaruOBj4pbbB0n25AM0opA9wGMnZnxGWobGyIrRlwn5OtqpNKEb78jDI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zI3k06cM7DdIbfOoigcCNpTKhbU911CPDgOk6JpY7rw&oe=69E626C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhyxDQ2XPpwQ7kNvwHx3QXs&_nc_oc=AdrzwyRtIXqb73GJXDJCdSz8CRTFVwbRV-jqGgjxaARqhqvVpzTx-QKyI8Spk52lksA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NHf53L9bNwqTpo175idiz2577_6Qt6TgsF-yDvqJCKw&oe=69E62D53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BoDImaXvo8Q7kNvwHZZU9t&_nc_oc=Adr6UVYgs41kbRsSTW2EXU9I0gZlo5GktCGtM90Bo8YVCG4DteEAUmrqA5GHBGhEccE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e9uw49el-fPpt4yJEa0FQ6FH4RIwXYDicPxpb79cYbw&oe=69E61C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2URjXtQFSEQ7kNvwHkf-oS&_nc_oc=AdoJ50ryCfjSVmNOISVM9XWUYs59_7dErZrIpdPByMdVJpHmyZgnxZp0rmJmwXVn2uY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JTyHW82trflvzCZ8SXg4fuSbISFZCzB2YaiGfbDTxTQ&oe=69E6415E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X05_musSmooQ7kNvwERC9HD&_nc_oc=Adq0Z_4wOszKfzup3iMFatEIZ1VJkSFiGLEf3ee8s-sLHx6D5aL14IO8WldJnsFwY8E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DSN5tQNeu_OIVWjHBCdcHIwMINSlgDK9coCOrOnH2ew&oe=69E645CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsuwKQ4toeEQ7kNvwG4OEvq&_nc_oc=Adq7kQo1bjLY_unrww7HcFCaEKCQVOEtRO5judbR3vnhIVS_hQbyGrIbDYN7Xp26mM8&_nc_zt=3&_nc_ht=scont
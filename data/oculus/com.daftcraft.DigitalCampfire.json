SVoEaM8oIs4Iov4FaEcgK7L9-Dsu6N7Ga-IHL5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ogeGF80SD7zIiPFJf3MuoseqA1DxfLyXqfjYJJV3IJA&oe=69FF3343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuIfPscAhHgQ7kNvwH6eewO&_nc_oc=AdqqZiVBMAwyw_l3_FQA4S0BScEfGgFEq_RI-PqRlhASuR6Zp4n0JEyUiBchotwPQnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gwpv6vXc2s0oy3GxWo-Yj77169zbVcC4ipOmhMoVLxw&oe=69FF4C84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G21pYAdS0EAQ7kNvwGUzM8P&_nc_oc=AdrkZ9cphjKpDlsLBuazb86LRvx70zmtrV2GHNSrMsbL48wqHYBRAfKrHX6zxxIF-fU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4318pKLb_98MQaphoYbs1_3ZLkXvOfrQ7xnj94CgHqZQ&oe=69FF4F08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9TxQWNNNpsQ7kNvwEybkjp&_nc_oc=AdrCKOEFbAo4VDfPnHENfJ-rcQuYiJIflaW3dhsdJhnHikcI7zjJHmr9BaO_aO05JoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74BWdwN6Pb7tP8_KPe9HVzZRt2e77HH_iRqRGa7HE1UQ&oe=69FF4DDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M9NWa3s1ioQ7kNvwGb9oeo&_nc_oc=AdqmVFLn7b3OHpxA7U3AhW2QCeq0t2NW4Pc3migaJ-UGqfFGy2SRlxzhxuOVelyRvnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OUu62rl6oWVZCgYRLHoFdom-SCmlPUQhlLoV7E8N3_Q&oe=69FF524D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zd5f1liQeoQ7kNvwE0KTGc&_nc_oc=AdqwDHpm8nI7L5HcQ7FQPszXIO5GqYWOR2rPouu8q_u08ovIHSRYipOQaslSo_ZjhxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i5qb1oyGQCcju1UqWlXkEiidpfnwLIvkNCzHWk6dR8A&oe=69FF2F6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
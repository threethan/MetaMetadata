_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FZp-uc7t4MQ7kNvwGEvGCs&_nc_oc=AdloDVBbeuWpwbqoC-pDU98geWpVk8vB-7IX_JCcOZdwmGw4_S4eagipwxothEoieEY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftVfmZgHjOMbtqrDE9SMmOTQR3-s9J2HvpFDVVk4EPUaw&oe=69A198C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmjtnEkkos4Q7kNvwFDZrgR&_nc_oc=AdlD-160aP1P5HFiIgfOtG3pmqtuNJ6PAwK-j4ZtaWpshjHmPq3eiVa9vTvCptr4SkU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvehlCmek7OSpeDZVe6WvBwdKoPanBXKNUIAgMnMJiL6A&oe=69A19F53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkHH5W_k80IQ7kNvwEg3Bqv&_nc_oc=AdlCFW_pr8izyht0WJSr-rwVS2c9bd0RG0dJcLnxEx-y3xA5VTVKGLQjBIXaqQm8Lx4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsIySEyprJ31KFQ2XrIqN7CkAdgQdCzSC1oXLMSSh6K6w&oe=69A18E3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI0ogU4XIc0Q7kNvwEewGcL&_nc_oc=AdmXYskLY97f4Sbo-aaTKRQERAkvi9D83P7a6Ez_xn3_5lplWH0masHpI71BfjLmCqM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsJ5DtQ47eec-z66plkWhJO-IKkON_pYW0kfvT2igOrQg&oe=69A17B1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-oa7hSCRZsQ7kNvwEuXOQ8&_nc_oc=AdkVmcdxuEimJHYdAklxkzyARib-lCmuTMdtHYl9TSN9T6wmMPksxQjgp5gjaLfM1qA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs3jN6yAlWxMmFDniQQQyB1Ax3ZVIRJgOADbVhv67jWng&oe=69A17F8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEO1yqgLeRUQ7kNvwGi5OV7&_nc_oc=AdnA_8Tnvuo4M2-hBnnQKtksDzrBjx7xeShZhL4ghz1Tbkis8c4N61IQy1R9csVDpCs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs_rxLHNM1NDndcHQrij3IMlA0JL6hnq668-68q6_1E2A&oe=69A194EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
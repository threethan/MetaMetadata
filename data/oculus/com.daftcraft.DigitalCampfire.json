qPUQ3aQFm-82jL4WgL2coQXB4lmp5UoAQbBX12g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lbZPtzN-XZzrUnSMav0i9iM_t9gmLLjrkZGJY3oNlyQ&oe=6A217A43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvqnSQFpuBIQ7kNvwEqaXLM&_nc_oc=AdpfwoB82kavd-nJcZs-brLlXEutm1QVNfk-QVNs9T9JiEw87gAbHPy1yfSkpqqWgX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_slgg63u646l1aa6CVLRyZmoa2eb6unrDED_UD3kgUw&oe=6A219384"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q21VzpivbaYQ7kNvwHh4M82&_nc_oc=AdqQCm50rFpg7BdpUob7-NMwo2Fym_hLJYUARGXIrfpUU0LkrNFqHQEsRjc8PuzVKYE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5Qp7KDyzt4V3ovemDuCen85AS5l_qmdjrxn7sMtVj3Q&oe=6A219608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_XmAvAofoYQ7kNvwFitpyX&_nc_oc=Ado6Ju0Tz0oZWF8XsDCvwKNJ3A3oObB9NYLH0RQOQGRDqJl4rn7CAUr-mjAuHZIfgK4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X77KgaGZPg8Ugn6tAi0ViGab6_H5enOKyxbIaUJyYFQ&oe=6A2194DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWjvKGK85x8Q7kNvwFVrpnc&_nc_oc=AdrUknQ5VacZxG5yB9tT4AlAd630QvFrEtyxr6JzieMWhUK9aF8ZOraZIuwNGgmJp04&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yPzp2ZNNvOxm0pJCFB998-j_xMWk0Ro7vY0Q04zONyQ&oe=6A21994D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf9lvqjWk6EQ7kNvwGyoS_e&_nc_oc=Adqc0A0oMge0mMwVUw1T0rHhYkWSt51P2MU0IEvKU9B8TY5hURoQ7A29RM_Ba_dpXNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B4ouHxlk3dZJitMR-qNwNyF7J0cR0CnQI3_1Ww1BGkQ&oe=6A21766F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjHurRgXg6IQ7kNvwHWCXsN&_nc_oc=Adpemj7q185tPlqhSxS288VNH6w_GXpRO7rCPqm_oNSJg1mAJ9qGSKGRv5xEjtce9Tg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU3SHqSnc6qnl5BkgmzYh-H9v4u95Mz3BozFVKplzH1w&oe=6ADF5243"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xgFiQK8SooQ7kNvwGbBKC_&_nc_oc=AdpOuoU9E4p5SnDY027-dooR0ydeSnbikITl-GSDyVyxxxxi3JLdeAU_ve_isQ40dRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr6ll2ssTtOn-FxKLx4svxjOIW0f61DveT9gb6awcevQ&oe=6ADF58D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7S89NsE7scQ7kNvwHhcEk6&_nc_oc=AdpGYf_cVpIoPxwALy8Mo4lstlRRC4sK_VpX_rKV5Q-i_7swFvZ94RU4lTqyPEth4k8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2ZKHrH0f2lwIzND9bcDSzLqvjdO7ow4Wqkkdeshbfhw&oe=6ADF47BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxS5IAyCe-gQ7kNvwFYR3GB&_nc_oc=Adqo2aYHorZc7Q5UKVMdtSfeVTVTz00jskuvDOXT5VhrFaei7WubfPzhFX2DoRkMI10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrt6m0ZilRUP3L57mhp78ESjJV7O7cdJ8a3vcj_y8ipQ&oe=6ADF6CDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGhYwkYjFdcQ7kNvwEiosqm&_nc_oc=AdpOXjnhLw2SAOMN7XJ_MjtjTrrO8ZMuhtvkkNYO2noqEu1w0MY-Er9CRaMdwFxUjsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4NxqoexyZqYkxZSELGisBx-1z9G2px4IDtM8upAfdZg&oe=6ADF714D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMfqs0UjWcIQ7kNvwHgXzS0&_nc_oc=AdqVMUNoWYW5pa0nQ8EF5_17s9A_BRQoWaA0qyQHNXzH0QfCtRXHRh2RmHrRZs-ZfaM&_nc_zt=3&_nc_ht=scont
EAcQfANTlAKNqTMDKaK9e2d0qGtGJCUim4meoEk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50CintpQ-42fs2F8_1ngB-d7a4ARh-Z-uKOTuFSPCmkw&oe=6A1AE2C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj_bdIPwtmkQ7kNvwH7ZA45&_nc_oc=AdoJjxHi9BNwfu5EuWNFJuSmISBw4tzj06Ds9n5Hz_BagoJeggOw4gSgGfGkH5TfKCg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7maYZy8jfrBQQjCcicdkU1oLQilSENGS2gFnR7S1Em4A&oe=6A1AFC04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLCBmjj_pPYQ7kNvwH8u12t&_nc_oc=AdpjBhKnu0IvF9BpjlmmjbE-P9B9TxyS5ZmERFwPtLsm_PiV20dVcvMwNypPkjyPZzg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p6DtSKKT-8Tezf-Dv7WCdHpVvdtwdlJSIcGdmsGx9YQ&oe=6A1AFE88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSMIwu59x8cQ7kNvwGIYjZf&_nc_oc=Adq4YlrgigoQenxmAVshmAyWHDHJNsbqLKilwuZftOTmbUzdh3HL9WKMuoFc88FZRcQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UTxCiIx36eJVdMQpJmHClZnejQmQVZAqUvpOEiftoXA&oe=6A1AFD5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aspBEEerosQ7kNvwHRNpC8&_nc_oc=AdrrEY84nIF3uiE-K6BqjXPBer4uMzXic6F_BNIDwaJbn5hpAM9mJUYxF6eduuz_IHo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UySzhEYlSuTox3PJjcj97xOI8526CViq1DRpipdHqCA&oe=6A1B01CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o0e2-x9miwQ7kNvwGMvFGA&_nc_oc=Adopzjx0wsAIcUsF-G9Ffxf_bLDBLmeCVzJ7jWJv6ZoBFZzlP3FbncITJgllvsBj8HE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ydmo7cw9J7AuVDc-qcuUxcgLYIJ2BMi-OJyeMDtDQpg&oe=6A1ADEEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
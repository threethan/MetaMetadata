zcp05swlGxMd0ZVodnYFlfHsnHIXZH9dr97PKXw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hSQka9OWKSUy8M-6g69h-MbfSH11GvdlZvi5iI_c_rw&oe=6A241D43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAuN-gbO5-MQ7kNvwEe3Fta&_nc_oc=AdqlrNa4Nz3jSwHEj2dsRAPZZwhhq_9VZuqYP7LYdYW38-FsmCJt2ZNPUOsjjbcasUI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FLatvTtjzX7kuHr1E9ARBJU0rfeP6MchB-6WaBD68Hw&oe=6A243684"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7joi4JRQYVYQ7kNvwEYrn2F&_nc_oc=AdoAaYFSkJlybc8eYdKJVgC2VDPdEuWkD1Hw2W91lFGNXlYV7O1PpFCGNT9BYPByJrM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8jQFvHlbRZHMJ4E1mxotisJxYDAEbZY-b-It8D5C3kg&oe=6A243908"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_XmAvAofoYQ7kNvwFCRGXY&_nc_oc=AdrJA2IIheyScu7esnsDtmZDdls_jdYez_0HRfuF74ypisofz6idXGMIXHT8n9Qd834&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gRnULh65GzlAPMxozmrosQwmk4p2YWM1kgTnZ4mBJZQ&oe=6A2437DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8htDOtY89ecQ7kNvwF8aNtq&_nc_oc=Adr8aet7-VWO-E_fNmjxxj8VzSu-GAppM0wj70tBxlazTPxRiAOmZrT6oH2iIBO0fZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WeA4gYUKmaGUQ0jeoCvYYJpCSP181VL2MuRUbQ1PyRQ&oe=6A243C4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhkyayvrhXcQ7kNvwFQ0LxO&_nc_oc=Ados8QVGNtljDqiwvSWIjXFC-xGiMOa1Adr0mPzd8Zx-TFZLmYDDkZaSGeL9sviMBuI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-23piJylfx9wgKO0l-PsaHV_K9TKune244b7LIZS6icw&oe=6A24196F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
M0opA9wGMnZnxGWobGyIrRlwn5OtqpNKEb78jDI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zI3k06cM7DdIbfOoigcCNpTKhbU911CPDgOk6JpY7rw&oe=69E626C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwplhFEcQAMQ7kNvwFSJMfn&_nc_oc=AdoDpvuFNZ_v2NAGrzeCmrBfE_E-dhd_ZPDg1tHBX3kF8_yp9gFIr3zBU3Fp0LgqOmU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-qanA4o5eyhIQHNGLbVIKyZnW1RyQeq0eUfKWLU-BRQ&oe=69E64004"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Wa56ULDQsQ7kNvwGiuyq0&_nc_oc=AdoMQmowkrsdeq4CXNro2yeDgyr9qspUYu9ymvEDSocwmtRQIWe3Xm5RPBJ2KsJJiAY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20fn6jnWoAAUpnlr-heLJrVbiqXACQ5IcBWq8T990VDQ&oe=69E64288"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2URjXtQFSEQ7kNvwHkf-oS&_nc_oc=AdoJ50ryCfjSVmNOISVM9XWUYs59_7dErZrIpdPByMdVJpHmyZgnxZp0rmJmwXVn2uY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JTyHW82trflvzCZ8SXg4fuSbISFZCzB2YaiGfbDTxTQ&oe=69E6415E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X05_musSmooQ7kNvwERC9HD&_nc_oc=Adq0Z_4wOszKfzup3iMFatEIZ1VJkSFiGLEf3ee8s-sLHx6D5aL14IO8WldJnsFwY8E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DSN5tQNeu_OIVWjHBCdcHIwMINSlgDK9coCOrOnH2ew&oe=69E645CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsuwKQ4toeEQ7kNvwG4OEvq&_nc_oc=Adq7kQo1bjLY_unrww7HcFCaEKCQVOEtRO5judbR3vnhIVS_hQbyGrIbDYN7Xp26mM8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pFhR_cxc4BvtK02kp0k9QYWv0nVwuYsHn-5d5dHQtgQ&oe=69E622EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
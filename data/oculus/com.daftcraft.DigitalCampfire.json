8618161382", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpNn-iY8FgAQ7kNvwGfGLtp&_nc_oc=AdrbIJNAhI7KZFOYnJjvOUixd5MqBdqtf-8VS1two2Vf-UXas-cad49dnh7ooEDX1M8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME_MmpuycEi5aER6kewRFZY4QJeStWgRQmrc8eiVa7SA&oe=6AC8E8C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fMICz46CHQQ7kNvwFQt0QH&_nc_oc=AdrcNGVcyV0p2j2OU24ujzvqTCWOeQVSicChRUkB431gSpbo-OkYwmzHectljXfuKOY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC4zUrrkOa_P9d4x6G6Ie_qp6LLeo1rAHi2Abr0Xo9pw&oe=6AC8EF53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBD96bT-EjkQ7kNvwGe_WqG&_nc_oc=AdpU88NixtrUQFU-oFwFgrkpFz9EqqGCi21TmzWl-OMTb5cZgwdX0Nxc7azf2VrdXno&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmM5qd6vdqoT-DGFdC3T2-2Tnv90-PMi1s9yjK9--xrA&oe=6AC9167B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqbdfOZjn34Q7kNvwFLIMXN&_nc_oc=AdrUL-7WQ2_ti_IPPWDjBS5dJy_o_7rWqaTXCP4hEBfZkoj2cKtUGPGGi4YcAxaIjpY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsbsw-o2YCG6kTleUVWm94zgNEnG7tQbjbx_R5vSPamw&oe=6AC9035E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igSqIIy8n5QQ7kNvwHCAzBM&_nc_oc=Adr5TeHB20P5QIPjxIScmZiKjgCchJ6WSqVU6dSiliptyaHEvwPR8dfIAvWZLaetADo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxnOKzB6he6-J99e_-wRXgCp_Y7StDF6-T-LL99GH-Nw&oe=6AC907CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBE4UgLBJXQQ7kNvwEeM3My&_nc_oc=AdqxG0CwVLJkfPTpoV3sLZRMq30mekRn9j6cgtCvfU_RpVh14ksXHZizRnleRtRIodk&_nc_zt=3&_nc_ht=scont
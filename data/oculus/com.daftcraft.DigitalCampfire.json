8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSAMRAD_WLQQ7kNvwF8FEjm&_nc_oc=AdpOZOurWS3c9covI1whEdsGyZZoKuKRZm_SZoZXXarsUFnjJ5EcCAfHmKkwa3_yp50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEL2xz-_xLT3xAOsGVhrMYcF7dTASbvCNyPTM3GB9OFA&oe=6AC3A2C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQRLn5OCMxAQ7kNvwF9WMIw&_nc_oc=AdrJcfQKdxH4ADv77orEo2rpjzBeeRrtbjCGvkuf5iHzAXAbUGZRJd2ItcdHVGxLqFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyHowC9OAufCKnhFFUONeiH5px93weXuLs9Up6wm6eTg&oe=6AC3A953"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5CCEVYVh-8Q7kNvwFNwhRU&_nc_oc=AdoQVa9fVBAsY79ZpOGEipcFfb0yCLxOkMMZ7KgSZ2MliUnLXbQ0DEILuT8szugzW3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsYv-6cRQh_dM4uCvoEOaY_EwicEZNhKPoriA097YZXA&oe=6AC3D07B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2WHd3qn6ZoQ7kNvwGveXS7&_nc_oc=Ado_Uh6bj_OLY8GwZWVDuRriA5e0muJgmuoqqzqSczQvXluORECln_zsGTU4ljUp4ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh0w-nqHvTuEDAASScuy50d0lwc7oGijd9a6UtRL045g&oe=6AC3BD5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_C8bYHER-YQ7kNvwFeA83d&_nc_oc=AdpjhyvWkyF_PCkGkHG0sQ_nXqC1vCoDvXpGC0HfHxVaowBZKuQm8YV6T-f71s7jAog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC6zav8VfVmi19QAce0dX5CrOWPQkeu1DSHzhNf02Enw&oe=6AC3C1CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrSW_JolByUQ7kNvwHBU3Dn&_nc_oc=Adp8z3CMQ80NFgzs-r8iyum84Aea2UUzIIo2jkSgQaJArRik1_txFdIfs5iF4nGfWKk&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWQk6rDGUwEQ7kNvwGjwXXa&_nc_oc=AdrBlDXUboJKlPVaUtpF4K-Xg7rxHoRWcPnna2od_NMDj6iYpcYKGLEi76yZCqATmRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN0zmXpDaYluV1U811oVf8KVX2WP-neEX0CwHDFWYtnA&oe=6A709443"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWTA1YQBedwQ7kNvwH0VZCA&_nc_oc=AdrC747J5uw-ejP07Jz0mkmx67-LCOExzqepajJg9YmPDHPm4vf4f5EO4Qk1vyrzaC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeGjLj1IgCGtC_PnpaTuAuyJPIYWxhDQ8lUsQexy3Nlw&oe=6A709AD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaGfaT9V5zYQ7kNvwGoSOCb&_nc_oc=Adrou15U1mVUMz22GtFoDGUzfoegCv7QERWSpxP5iJFukxNcspPEnm2d2UWMmmLVO8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-yTCSX5PXONS4wNaqHCLASnkuHYyTW8rLEEvYEevqKQ&oe=6A7089BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVQLk8-lUrwQ7kNvwHPHgbJ&_nc_oc=AdpbJfK2d6ojO1HPAkfdqskYwk89y1YP-AM1weA1SQh-stnXQC0mEtvQgn3kD3nrh0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-NWur_KoSENEGZ4TPYFeo0sy9e3MVGFmme1RVNu22-w&oe=6A70769E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=croYG4DfleoQ7kNvwExCtCu&_nc_oc=Adq9u6x6hX5tV2Znu7F1_BPjPTtfaTLKCTLJ9IGT7EZo2LExt0xGHdON4pG5GOh-GZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQuWwn2h3CzRVH5LOvnNimQF6VETQlXXzqeQSaQTC2dA&oe=6A707B0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI6RQl_m5_kQ7kNvwGutV6Q&_nc_oc=AdrDm6kFgVFUxXxq1OsFAkaMD1TWvjSzXeI2gHUu_F7aZyET4n21PNKIyjnFTi_5A4M&_nc_zt=3&_nc_ht=scont
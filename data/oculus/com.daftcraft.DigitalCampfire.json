cD4ckdzuLpWxvZq475vg-JruMIGbUGySW0kpTOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jL1-750oHRTmetOVE6vVTxhL3F9X1XwGk1PyczQ3KOQ&oe=69E4D543"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwplhFEcQAMQ7kNvwEoHwpO&_nc_oc=AdreHcehHRPUYptDAT4Fc-g0s0K8I637V5bimJJMAPSjZaKJyOrGAkadTzCc8HmVMwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d0K7T4o5gPNria7Iz50jdUpCQjp5I47jDomuy8ncjyQ&oe=69E4B644"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Wa56ULDQsQ7kNvwFZGk6w&_nc_oc=AdogXt7USAPjjcIE4_SHfff_oQZl6q48IT9VdpX-XCWZ2M7QcDEWQKQ1mLP4ES6sTXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27COe5Bh2f1vKxqzrmoE2AkWuIPbndGnU-JRDyAvyT0w&oe=69E4B8C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=817zGtlNOkAQ7kNvwHD2whm&_nc_oc=AdoHFHggMQyvTuy0km09dbez4IMIMZ2yC42bi-r35DospEvB4vu855rZ6zexJNhbRAo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vpO6ZVYK0Wr1_418ZlJBkkkCiw3GOC1HBAclGRT7ABQ&oe=69E4B79E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X05_musSmooQ7kNvwFkn3Av&_nc_oc=Adrml--zzgH5vzfM_N_wzqAYLfXtmqUgRnu_9hOe6VQSddWUHf9LosIuEuXhGrlEyHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C_drYov2EaV4zKRynnHn1ec-zGBP8NisIC9D-RGBv_Q&oe=69E4BC0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsuwKQ4toeEQ7kNvwHdCHe1&_nc_oc=AdrJOj5jQdmqklM4cZpvfXoo-TR6FPF6XU9shSrT-fQdf8q_Y4PY41UPQbiped-gq_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xcNWF5uskj8gHmCyEj5uBji3jDFlW5HLM6aa1cvkOdQ&oe=69E4D16F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
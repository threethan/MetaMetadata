17mWe3wTgdsUcMXcNOlpa3tUTuGLIYL0xFqjD70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcmgvgij_Kw0YiXBh9Yg8GmCNfKrl45sU-5NBWRqNPsw&oe=6A4A58C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW_rAChbz6cQ7kNvwGhi5Eh&_nc_oc=Adpzu9tmrAm1FqvGXojqPMZb1qlcPBhaEJaCh4oFeZcU3l704Ud1t3lCIfJ_LXJHBZ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASwT-6nQpva7qh4Se9zXXdfUWltZZKseXwq4gfZsVeNw&oe=6A4A7204"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWjJ178A__gQ7kNvwGFTcCE&_nc_oc=AdoL3r8hjOEuPb0ihoT7CF-R6czb8ZZTG_GbtorkFU55C9lr6uXP8l_CUleP3dJ5wrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZtefgPnUZesABivDOkHR6fYaNlArQ8f6SuVgejM3tuA&oe=6A4A7488"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOXpm189PHQQ7kNvwGugPOA&_nc_oc=Adoqfav7yNLXPJXbRBZ0YO9-iXpvJVinrvB1mthA9QsicE7r87zaP8MU2O7-1XhRj0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-aZm80BbvH9P_kdoPYpZz3vYZo0irjdKHLIgNBxQKVA&oe=6A4A735E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YJToR0Y36AQ7kNvwFJr5KD&_nc_oc=AdoHghi3Y5dQx7K3FbNgBjTxsZlaAWs0dHhh9Mtq20y4c4vA6iJNY2H99jOV6Y_EApw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd0IghvjhpKk8I9MgXKbVTYpHv0hsPU4JMQhL8Qfnt3g&oe=6A4A77CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBi2InWDQVIQ7kNvwE3xAay&_nc_oc=AdqZuGdg4XxoFK7Y0_UgxhMNypmnBKFjuqc8UmZoIocmcDE4UUHlK_r_uYjvrxe5nqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8SwxO9fIX7SyZJ9eRaaTjg4WOE6IfjO70DIsyaFgS8w&oe=6A4A54EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
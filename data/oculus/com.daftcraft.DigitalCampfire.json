8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rugPoSYICVwQ7kNvwH9Aht8&_nc_oc=Adr8v5rMcefPSOdgickk3F-EoNIFG_DU_uUWHiwnyinZqHPDO8WO3Hdiczb6GsQETIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbNwI5KnUiFn_DnueWlAIve0ZYh4HbqUFp12UUoLftnw&oe=6AC0FFC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wcgXnKDy3EQ7kNvwEk2xzW&_nc_oc=AdrvP_hIWuCZLjGWFhvC5NjQCzUmQC4h9Bmb5dTUV9JHYWKcwrBMp9txTtZBYXcAIEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcxbTZeZ-Ojdh17TB8nUdD1bO84C5SOGt7hmNxg7sSDg&oe=6AC10653"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtsYbNW4ve0Q7kNvwEIRZRc&_nc_oc=AdoxOmih5xatbuOp2kA8GfZWdRD6Wk6gQDjIEx-WbwrSv8Yof4z3r-uPpRcGNKAV4sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5iuSf_2uEXz1OX351YinJTD4wHigVbJe5XYRFu--Png&oe=6AC12D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyGcKZZpfsMQ7kNvwHv-F8x&_nc_oc=Ado0D2opE0dMXGcEc3TpvIKTV04Y92Dh9uWWpPmK1wcCn4oIg7X0HjzF3bHIc2B630c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOA-QUFiM2pAr3pD1_QkNSu7y6MKHkuOHF9aQB_i7ubA&oe=6AC11A5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO7Rt4Fmyn0Q7kNvwE72Ila&_nc_oc=Adp0d-THDaRLodtouyLymIqYLuhnN6gn4uBPYrMmWas8rq4uGJO5crQEHk6UUMiUJOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgjrCJUDLPrZ2Sbo_rq27O0WEMEhwoWs-idHPGqWTRMw&oe=6AC11ECD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrSW_JolByUQ7kNvwEPQC_j&_nc_oc=AdphfPdyA1XGqSYC0tr9vGDW4I8BZD8DFsAsBGDWbJ37RPFUL3hW99pOglyfHZ5c20I&_nc_zt=3&_nc_ht=scont
XNWR4mtPoQSPEzi57U_YHTyN1Lbz2lmtlx9uZ2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJr-BYCDrV2cbYPPhD20BaApMORpcNFf5Z4nd3lV2nBg&oe=6AF5F403"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBif0ldwis0Q7kNvwHQFWtC&_nc_oc=AdpOCRQGqluDQ5MksuOpvkbK4tv-sXf_SAwYOf9Kzfeig5E-BfhVl-euQ1Jt63MLVTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTReQWzrss2xAh5Klsp6qEGyyGrISRIxIuba45fHGc-qw&oe=6AF5D504"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoR91CfFy2cQ7kNvwG88RNq&_nc_oc=Ado4fm6-QpdO1XuAOLAcxQZrVYkMhES4-ohjwp3NgYQUEzJSwxc-0TgN3sdcBUu-xYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRepT_qhwcE40ERPvY-YtwxrYq3t1KSN90LESQJSeV6g&oe=6AF5D788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IYSQ-ctllgQ7kNvwGzk6kP&_nc_oc=Adorct1eGTxztdBKv5pHqYqzgCEiI8SGMpq3xkk98A6XGcFX6NrGi7ozj22XNw11nns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaSVxEKdRAVVw-gZrNwwO0mstMC-7tLfNS6zSGLERGdg&oe=6AF5D65E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2D0RVHVMhIQ7kNvwH7JoPd&_nc_oc=AdoHj3KgnZVkHGW1DyzjhCgNMOjXo6HGhOfHNvKO3ilr_Voyxzpv9KU7SbMMlgcFvhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWKbOrMKllDcMMufAd-K005c8Ly01OBzYnCaIPZwhU0Q&oe=6AF5DACD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbvbH2PZbDYQ7kNvwGYkJ3S&_nc_oc=AdptW7GzV2BJ9CcH0TDY-fuRLW6J1EPil_w13AdCph71mBk6-mqXsJRaDciq0-dckAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjGb1aJ9lUOOtOh0SLz57H43ciJgFudKNUyg5yJ3PRuQ&oe=6AF5F02F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
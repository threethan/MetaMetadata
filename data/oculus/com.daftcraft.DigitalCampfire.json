8618161382", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpNn-iY8FgAQ7kNvwFP-QiM&_nc_oc=Ado9SmOImyURrChICOBOaet5MYUQqfkTlnY9q8eySk4diOR401hA6bFV7NRBAVH2PJU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJlCfPqZxfm4jB13hi7C0cdf2CTjtDZ_eDVbrSZXmZgw&oe=6AC79743"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fMICz46CHQQ7kNvwH0b1YO&_nc_oc=AdqZxBQstbdAfEhoEkaT_fb45gt2XIEsz5fGUGy0FiAP6cjt-SUDIS4ynguc5VLolVI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSlma5xicRO6Rxz0zr0MkFPTeWWtH5MxTL2jTYkQozDQ&oe=6AC79DD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBD96bT-EjkQ7kNvwEOJ8nf&_nc_oc=AdpwE-hVnNPNuwkS2eiQ_igElndQCYIDxeOUEo5dEJWlOnObTnvv3PhJUkJokZKJPYs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9uXBXEEpRb6v9u5gM_liZJwYMXWndI83m2vzvdxmUDg&oe=6AC7C4FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqbdfOZjn34Q7kNvwGCXkyF&_nc_oc=AdrE4EsSWj54qdXrPm5l0s2p2UXbJ6RBpSqPmrjM1MK9yfgzntrdCWL7x5pKUZ3cL2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUcLff7H6iNqYu4GKLpmzx5T2z1F5FyIZHGGFXKJ7WQg&oe=6AC7B1DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igSqIIy8n5QQ7kNvwHiAk9q&_nc_oc=AdqpXbT38gG8KYVIQjeYZ8atuZRR4nQTCLOQnwkGJlcwP9Za3D3_9x6wsnZZzgMaWX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzFfMalqYP2RAa_z89u6eE4RBr9fccd_C2ET8swkxQgQ&oe=6AC7B64D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs7nhwGgxJ0Q7kNvwGEQahV&_nc_oc=Adoxc1niwj6A6d6RL2rqQut8DrbTXC_wC2QkrlHPbX6a1Dd9L1NNVh0x4y0z_G2_epo&_nc_zt=3&_nc_ht=scont
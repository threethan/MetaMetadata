geLO2EZoGVFlvnWqeVhgDrDVV2eFnVi74G33VJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QMqLGw7ycTpSrrU7VrVs9y6W8yykvexL0PD1bQGkGBA&oe=6A071C43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0coRIkN9eyIQ7kNvwGBM2hw&_nc_oc=AdpHeV3R2FwvbTl8mixNeB6dMITPBO325BNovUnCwtdlDmLGg_20SnI3-BoYFZKMFXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XRzkvZiyy_O2EnOLKiAsow9ozTwFM4vIsnD9id7C5ZQ&oe=6A073584"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pD6ktZHGY8IQ7kNvwHkhVoE&_nc_oc=AdoWtS-xyzfaznNRjJBaRCgcGZ9GUSKxGAkYIqV1iYCIILSeQz7oSL9NJtbCWjj5Wi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ck9cw5LwMVqwONF6LRhzc447AzaXhGsRMT66ThJCsZg&oe=6A073808"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDjQVMS0Vc8Q7kNvwHCmdUH&_nc_oc=AdouolQibqgqJAfqDQXaSPdBBkBH9KmXIOh5gqeQecsXYLipp_e-Tl7Aw05kmkvL58M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oLX0qTPNlQpCzVmgl9DEcHm7avr_8HA2HPwUiRXXtOQ&oe=6A0736DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxIKw_92-voQ7kNvwGOaq5b&_nc_oc=AdpI_R1s306QhhsnLMoOGDP0BZkd9N5Xk0jTclA2Q7GUs6d2WqbG9ZwPGYWOo7QLcsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ogberqe72BrDo3ZhVuekKTjejborDXcAaJuwu0I4m_A&oe=6A073B4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBw83W-1RAMQ7kNvwGQkuuZ&_nc_oc=AdrJmhFH8NrI0zfXECSkFBThcfXqEWr78MXckbQrv8kCQazZAkPib_YC1eqHisWkBAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46YhUnWyCN5FIaKT5JSEaBFaVjd7yaglAu4o7B2V_12Q&oe=6A07186F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
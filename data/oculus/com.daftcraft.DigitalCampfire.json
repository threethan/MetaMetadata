M39&_nc_oc=AdptQBoiv4L5kPLGig9_1rjIWalOPjTeGjvnFjR6vobYpL9ilsek4jh5IgY4EuAcAFQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInenlMVeptm1ha2L8CVj6QXp-94RbgO5MlDf69aFr-BQ&oe=6AAE8AC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyWEky5D8ZwQ7kNvwEUoOO_&_nc_oc=AdpZcpDDzgT23EyG2ULOql8LdEeXKuuklpBl4fWMf2KDyX3DtdpWBlhiw0RqHv1FTwk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPt4yHSPz_KsW8dCPU8dFZdLXpSEQukHEqkED2DDrQIg&oe=6AAEA404"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGblJOdwED0Q7kNvwG0aRDI&_nc_oc=Adq5OZu3L6isC4UeHyixkPbPj5WqHzlLX7-o0ufjJFtQSeNZOVhp6bYIt-mI5oMPjUY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0Fxpb3CUyA3m_3Y_3kHZNiio0pOPZWtOr8IOjvjVNEg&oe=6AAEA688"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3WSs8c0T48Q7kNvwF1mJH4&_nc_oc=AdpNExAQMDcQ4TMB8JUsnQns65eSjbRCz8wfNlUcLWBmQINeuy8AB0ZV__nmbfg5oHs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdZcyIjIKN7ZlOUkUVqrHeUFIrpgeJj8jwX0Kv_1NlPg&oe=6AAEA55E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfDuH_WJ6qcQ7kNvwFlv2xu&_nc_oc=AdrAyzc-CeMhjZYNMyT4cYET7Qb6rbPjuxm2ODKcT0ekLHOM-1oeRWYdRTGJxhB9UGY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYUfJRBTzyctqb3bbFIcEKKnXq3tUoIVa4yPt6-Fp-Yw&oe=6AAEA9CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eKx71ETXaoQ7kNvwFNcsY9&_nc_oc=AdoQJ3IkhYqMtRdPod8a6g9xmFxLamKIk11RmMeJA9RtC6rdOw2_afwqEnBy7EPkcJo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDZuANmflEEqDNehfQ1y82QCdvduc-MfRQAZj16rADoA&oe=6AAE86EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwoVfaWFY9AQ7kNvwHLKZhj&_nc_oc=Adq1HdwjFDEJXEhv7GFDi4habx23G_PhH1bz2y0PX2LL3hmDTNcOjqDs1lst6Whg8q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0POiNLXrLtU0znEo3Sy6gav6H4l6WFaTN2qjE89lDAA&oe=6AEB2FC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoIC-xSTkQMQ7kNvwGh6b8S&_nc_oc=AdoBLAgJM2hblh3ORgeCPrv1L3FpLp4Tj_8gB1tBFG5cRofwtYru5IuAANC_kv3koB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7-42gkR-QugSWAWi-oPnb7xyaT1MotyIJeuRM1p6j9A&oe=6AEB3653"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P15W4gPBHDEQ7kNvwEdmacO&_nc_oc=AdqolaOjJ03YJAPsQxpXAnIpdEBHVB6ASnb8BwUEkIgMM7MZEw2gwwFNR0C1TMBn8wM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdCoF_t3SP7roMTPD83gRFe3sKD_PSGY02eJUK7MwESg&oe=6AEB5D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdBGwxLjEPsQ7kNvwG1o6nN&_nc_oc=AdrhHZg0hN1pZbMhKLPKGgYkBab9ZqYFHxRfWM1XW9TaJ7JZGW0JiMRii-R3TCjf8lM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuKwUJlOFzBljEaLZIxDKmlsimD1hXoSV7BIBc9T14Cw&oe=6AEB4A5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vzj-HmYivUUQ7kNvwHsGQQ2&_nc_oc=Ado5he6hAUG-zTBrh-A0Q_P42mCHo80PGtVvg7C_R2JVMNGl9VXRKOzqfWGlmEkMWd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWa27pNFQERWK5fP4dyrOWvlljO_rcVpl2KaVxsyue3Q&oe=6AEB4ECD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S-50LIdeDwQ7kNvwH9gCmL&_nc_oc=AdqbojfbeYpF-_WAAr0OSf81xNhLI9gVdQAT3T5MvC8HgcGZjtIx3pL6WUJUvxI2GCE&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSrPDGoK5JUQ7kNvwE8WAgS&_nc_oc=AdpvsYzU_iRMbwiwawLyKwWFOn16C9_mB-l4ABwMbKGlf3VCKWeY-78Up60SGPQpo5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sP-BQmaZUuj3mph9brtyOjjaCzaSyob9Xye3NdG95wQ&oe=6A3FCCC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDV4wcTTYEEQ7kNvwENROx6&_nc_oc=AdoQjv1jPTp_Gs0g1MsV1MtW7I0vmYTpKIlwEYnFtbgOLDewLhduBsf6uc_S-jMMkUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Cjjdei_upHsaZDY3X7eTIWAEv7C5oovqC1_CbG85azQ&oe=6A3FD353"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0xsqbDjP80Q7kNvwGk4CJo&_nc_oc=Adow3awM9I5XBsPKTXGmwK6K5UEANWtI0okL5Zuw8W_FX0UevEei_ctqxbp5Bnl5L24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ykC23l_nCk52jdzG8c0182neJCimrzA8O8A6GSm21fw&oe=6A3FC23B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59SpKD3TsdwQ7kNvwG_xx-Q&_nc_oc=AdrAscQjTJY-IcxJ3GSib68tfDqCzuFfudNavE8rk7Sj2nnp9ziMd-BqYroC2JaT9_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jT4WQD9XwpKJH275c8oQhs8f-x9wDdZ9VH518wDpWyg&oe=6A3FE75E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq7sFd9a3YMQ7kNvwEn5KcN&_nc_oc=AdqimlEqewC0rXFYMmnGkAmAgkLpMzoib_SE7ug9i_E_hZBq_ONC6GZuAU4D9lPKjA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NgMGUlSlpMv4P91eGZqtCvGTtGYTkMdXVmgOeYmRuIA&oe=6A3FEBCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxfsSBjkVQgQ7kNvwG9f4dI&_nc_oc=Adqircie7rFJCWcmJmamH7uoTCOc0bkmNzvXWQW0717HNJWJa04GbghN1R-3XXNVQik&_nc_zt=3&_nc_ht=scont
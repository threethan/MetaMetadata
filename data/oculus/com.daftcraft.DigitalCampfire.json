8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHlqCAzd3hIQ7kNvwE3IxDd&_nc_oc=Adqu-_8cC-gQcmwSiVnJInQsZvufVdMYc53uiqJMgcvRxXk5o3zEvBV08w8B0WHbeyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgopCy08n0A_9BT80o_f2DhRmObsF3c1hmm3Ii7ao1fA&oe=6ABE5CC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCL83l9fVgoQ7kNvwHG1z9_&_nc_oc=AdpbMurpSIlnkOpbzKbFZwuQNeLYoAEReLOfFZy58vzkFnhRWzLzKihlpdtO93JQZUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSpIQq4qyvpIcf8bRwr_NjE0Q9a9zHT8DZFWTyTkovLw&oe=6ABE6353"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUkMugooePsQ7kNvwGUVelB&_nc_oc=AdqIil15L6uydL_dQbKRJGnK5QYyOrU2PWY1ouPwMk6PuGrledvLd72IHPEALLc6GN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUcWGtkYcukeKpg0-dFyiVHVl6A4UCcQxPFpe5dinx-g&oe=6ABE8A7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f-uEiSHAQAQ7kNvwELP7Xx&_nc_oc=Adr8fyEM4cqai8jSnZWU4XjVrlTFvFzoy3ekYqkB6IL6ZRy1qw-Ep3yNENn__qP3SB8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTgEPilkzfOm6uQm9aycIGwO5s5du9XzcPOsQzPETFrQ&oe=6ABE775E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO7Rt4Fmyn0Q7kNvwFwB4jv&_nc_oc=AdrwvDKVtr1JAqPpQQ6b7xBZbb3_76M893KPFkEBMQ7CkaUZUc7mx3jn-pO6KsYKGhk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4NyZiFD5zyq0913Nlvm6nbOz-HZTrt5raO_eK3IYtvw&oe=6ABE7BCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPHfWNRP0AgQ7kNvwGtlBtj&_nc_oc=Adqq0VZicFaBFJN31Oi9s2Y7za-J54-7AMnUjYDW4-5dsrOsyQSEAfXJPoXhBpKLObQ&_nc_zt=3&_nc_ht=scont
hs_dMlc9qhlQ4iWfLMXzaXp0wc4_9x1hgBDTtTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsVbnICPXrEJO43LNzjzeOzwoSBAfJShxjFNIOiXZRtw&oe=6A89A0C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgxXgrlp39gQ7kNvwHU4Y7M&_nc_oc=Ado9jKQJr7pjfUENRUa8jnAv_UG5o209LfRv-A8D3jztWNROvQY3h97vUlDoEg7KDQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoqG3IuN0Jyp1z1xzwSHe2ZYI7M4zgBM2Vd8J8_n5yKg&oe=6A8981C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2C6wiYwVpLcQ7kNvwEtpitg&_nc_oc=AdoVHmMQTGj01_UipEZYjMbKTJtbMpVhM0-II3GVGhVXYwEixDfHtnjMKXA4Rw9pUOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExuA9__nv3LC4BOg2BE9LdBXX8PKm6xEQyICK2O96gcQ&oe=6A898448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ-lZfVzDLMQ7kNvwEkfOgj&_nc_oc=AdppxfWck5J0U-mzQ5HR7BiNy_gsRewudSr2dEj9a6HLlX22fh5yzeDKGjJfCvwD-Jk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfV3SjuBV4Pc0fVHV6cT04kvPLZ0wgrEQ7BVH_RaMuxA&oe=6A89831E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50QmcVgnP3sQ7kNvwHAL7NJ&_nc_oc=AdoxQrvmt4cmwVmUqkTtyho0EWDbBQ2jIoS4p-XcLbPWiay5pHvE3XyAf7b8S6QKDEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOXXPBPaeqaLonBcGTithlOpGiTjsp5vQGJTJCnKyyqg&oe=6A89878D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlkXnYxRtcsQ7kNvwHtagYB&_nc_oc=AdqZxec0Y3gM8idLmWwWtTv6WI8eToB-1Mcv92PYyws9bzz9NNY1pEXFBCxJpe2kjjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1iVSj1hTonT1lJPuNYyToaq65GIUu1GYoeEdNJ-KzJQ&oe=6A899CEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
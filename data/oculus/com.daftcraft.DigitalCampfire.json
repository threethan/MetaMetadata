_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsTrZmVA-QkQ7kNvwGGYAld&_nc_oc=AdnaI9DDojmI0t3Sbw48_mht1Uffby6DeGoMzHqbY1A3n2ig9ZQoAdDFZVO4osczgBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuARR2X3HVgRPppawoYHcRusZeFcvN7VufvowQ3M0RF3A&oe=69985E43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NeNlmRbS3kQ7kNvwFn59uq&_nc_oc=Adn4l-q8kT4Ad-29-ME2qBCYgHtwpPz2ak0qS7oRZolU3bziquK-6C5ynPT_iKuo02I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftxhRKKHBWMKyycV8fnj8eJ3ehGVfu6ottYa9RiFxgCwQ&oe=699864D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgX0ZS2KYnQQ7kNvwHMPJ6K&_nc_oc=Adn9Ft-igWqS_Mzu3i22CoNzYgw9ZcPbNZYyzgJq9dwe0eGqqDXsOL31dSa1Xi5Y1rs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu4pU6uKk9Ug9kzvkBYo3HZ_aYq1bswKTOIk2mh3egIwg&oe=699853BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozG0Zwf7FdsQ7kNvwFtJ-l3&_nc_oc=Adl5gXwJOpvrVcG7kjb45-Q4ni3OQ-N3y_ZOjksSSwVuWvgsqaVkcqSDLTrO5ytCeQA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu3z9B5Q6JDX0savWcH644fk52ODmKsI_zpj2gh_nQS9Q&oe=6998409E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI5vRT7hAwgQ7kNvwFvQH3b&_nc_oc=AdlWB3Or3c4Uc1EO2-Gtw5gMRRsiMx15eIURoldY3NccKLwzq3b6Zbfk-9_-pLwH1Jk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsxp5kj3nXWiatiXl3xTKVSrtMHiBdy8xs4K4PAlqHc5w&oe=6998450D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnFZ34BQShIQ7kNvwGp5904&_nc_oc=Adkvuyxo20LqrJ-ImzexB5nkQSyBOlBEby48rMIuM76VZhS3QvNFf_Rs28YtbI5o6kQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuZZmsi3PafQal_YHHco9xBhsdJVrpVCf5mF7gvS2oU6w&oe=69985A6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
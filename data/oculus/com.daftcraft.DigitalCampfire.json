nuClVOBvdYX7Nb0tDAqRtKiAn8oiPJ85xZdMjYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12G6TXlGzHk_A17tgDegvtrseTJFcVUtF_RUer1HDfxQ&oe=69D654C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lnIC7nLfo4Q7kNvwEdjfrO&_nc_oc=AdrSSy-nP4cJBkQs7CzxC9KQcwO_j4LeFshjA4zjmuPC6TUtQyjI-gG3MKbaJRJmNs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JyxWpB6pZLpaPl9N9R5C6BI4s2USvzrOqUYBlOu7Gvg&oe=69D635C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-nJNgLCbwMQ7kNvwGdsTuQ&_nc_oc=AdoABcu99hTQfnxVCUAU9Sdm0rjAdsFSH8F3IyZIXRUGtzNALKXk0IdH5ZNkL9qVrW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZUiN7_-912LvHX8Yo_myO_bQcLwV-CB9lpKCdmr5u4Q&oe=69D63848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPfJ1w4YLf0Q7kNvwFqZ7sM&_nc_oc=AdoBArZlyl5xdcgn80ZolX2R_FCXy5nstKz9h7INHK6juG2xbgicnuc9CL6i4jvzoQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0esH_jy_Yc1X_54MdqApw3nnVswgufzSUIth1Yqw6cqA&oe=69D6371E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-zGrESfeE4Q7kNvwGef0Au&_nc_oc=AdoJdPGiCJOcvBh9U0KYlgh3f34sLKVCEesbKzcHXnH3_XKVYJITN-xn358GJwHmA5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27o-iZFXx73XLFJsfBbfdfl264ukROTdIZYyD-g9Rq8g&oe=69D63B8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvHD-1uz0OsQ7kNvwFtEeli&_nc_oc=AdoDfQrY6qWk0C7c3Csc_HIHk24kVG9tYxN03g0N3WoPdWhGfFsSZvPNutqjfCYsNIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cHs8X93HHq6x9BeAn1HY2imk2L3nFKhlSMw42Ug0sQQ&oe=69D650EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
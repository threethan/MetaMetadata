0yunt63Rfe7SvpF8rD6YT8xSHiFQFqTn4Mwdxz0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFo9N9TTtykDTxfXEB9HM3x20JQFQsM82y_b1hd2Dk2w&oe=6A54E4C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FMlX1B0r6oQ7kNvwGocrTc&_nc_oc=Adp1KQybwIJe4lBx1CZUftgPz64ulwtcMsKT87nFumRxN9od9sgkj6evAiZj-fmrl6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ07N8fOyyJVSJNKXERFIvcauysXUJBt7VkeFhOKNT3w&oe=6A54FE04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4i9HShF4ucQ7kNvwGOitIT&_nc_oc=AdodoiIJVISI-Y8lhfR4Ghq2TIZTKp4un9b0QEMByPxE-TiiSJ1foyZRHDW0BhEwOZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe5_tjc1tAW2gSUsIpgqzDZop9ltcX-mIzABxVUIrHhw&oe=6A550088"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klRMe3CJNCUQ7kNvwHWhSm-&_nc_oc=AdozTWZXvf7ep6JjRKL3zcj8FHkOhHZiiBFIgFRu75TJ2ORyC5BN2iFA8sHlnbCbDuk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVBzQcI_KJxp34J-AcIwJtHXJMHhdNJq1eAXuiPEJLug&oe=6A54FF5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMbRxnQ1OAcQ7kNvwGrjc5f&_nc_oc=Adrv4m6tql8WqFwqPUOSmAWgKeHtlX09A54I2ty5YJxqzLzFDlXalduflqXGSfGfa_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfIbMy-QpwBupuqwxrjBXMQGA0iSmpCs6dTdfoYhKbrA&oe=6A5503CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBgxNZ3WliUQ7kNvwGLpNDW&_nc_oc=AdpBJvdPlb6gPH5KRLJSj7NPbCR_GuB3UFKH_2RMw_3NxtdsK17D9Sw3Fb0w1idigrQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBtIOPhNyAJ0N4mNZu68cY8qdXC-vsXm3NiBJam9kqIw&oe=6A54E0EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
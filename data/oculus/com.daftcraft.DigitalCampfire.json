xNF9fEHrvGy3dOtHf-N5JViPMSsMkNFMO9yxKjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4f_A3I1W4zfOfrmaW0WEYnOdX6j7ygShIs74rauJy8w&oe=6A787D43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9ImB8_DhqQQ7kNvwFkHRVd&_nc_oc=AdrIJqpzXtjq8zvM1Ag9nhM8qqowfLS2ugz7kptMYeIXVXyLHtaz7ee7MPR_OC5xjvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeDLuHhyPMN7z0rE2kpEqb-RiT-ArpYu1v8t_Y0DMQ2w&oe=6A789684"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QYINj_D8pEQ7kNvwF-RK-a&_nc_oc=Ado0bXh_oT0jXWJdPYP1IC4x6zLa96_hXE3ZWDUAOz3c5XGDmkG0Z-xy2__9EC0azaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFodMPU1GMWwdsOMzSxDM9pkw58y_PdjnZQR1a7X_E3zg&oe=6A789908"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltb-q94r_3cQ7kNvwGTQrql&_nc_oc=AdqCNP6BxPD37X1LHoIkFg08b2chGYSRHaByQ1ZJo4NxjJ4RuQkLFrvRaB8kp8aSpIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpQDXSFh-6kZQSMxTk05m2Pzg9Qo1IuCvIHAWaJvFplA&oe=6A7897DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mglGXrp7CM8Q7kNvwEYSYkc&_nc_oc=AdrPnwu8Y5GZudKPtC1TdKAMQXYJLuu-RJTX7Y4wRHFkejSbK_MtdisTkTj1d6Vm13k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP3ofkKHqgPXFPOL-cs-7ZOr10B9iS_MvmSY6sRHeqLQ&oe=6A789C4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1ZZ1eYrTUAQ7kNvwE-RAcc&_nc_oc=AdraQTe272bmkNxZ4r24g5CNUUUtcuAksYoKSUiMXwjNxMbcKeo6bNdZnOWkzWEeEhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGz9DBYshxjQnMM-JM4hIqFqtsryZ10MpzOv20PqCfUw&oe=6A78796F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKBjglIqe74Q7kNvwEXNjT1&_nc_oc=Adpi1hj-F0aCG1b_Gn__eM8h5Z-bPT3uEXNIDJ82VlcCea4epeyY3gPUxUFSqQHNvnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO-9xsmhc9BQTdpmdV2IOsEEiIVyRWqc1k4lvOw4LwFw&oe=6AE49843"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8HKSMN-2ywQ7kNvwGuyZk9&_nc_oc=AdqRMTVujcR8EuOqlfrfbnwPDlg1YT5bPGNIIaSKFtzLtcN6lVMEb0sBYlZVebqI1hM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9rANjHHwJxe7WZ7oi0bGmoWH8CbjsbdwoFrshKq5U2g&oe=6AE49ED3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-V3V3MwnwIQ7kNvwFASA_k&_nc_oc=Adqvtmc91OvtHGUhh5VOiq1zpS6OV8Ain4Y3DMsaCm4_jqNZTJUHo_HofuOR3Q7ia8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZSvrwfexBX3tWzDTw7xY_VbQE0NpJYX2d6x2UzK0Sog&oe=6AE48DBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKGW2FoHIjgQ7kNvwFEKmKq&_nc_oc=Ado1LrVGT_8m9WKiwm2Epvwb9Z_OHRPL0oactRxRtcFjZHwPflPldFlXPeSJdu1DaHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGwjXneOMELZIsn_D3U-9Gi9q6gqsAF3yIyIcGd_-FPg&oe=6AE4B2DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTn4yrngvA4Q7kNvwFnzmOe&_nc_oc=AdrnbOAPyZX2gG1nzW9tvl6IaJXDiKwz4GI7GkTLLr-MtIk5hPoQzoIVNaBBlndvjFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMscNDCymBQDD3XRTZkVuOyLWGZ9eU381LqZig9GRzMPA&oe=6AE4B74D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxOB83MpYJkQ7kNvwFmjgag&_nc_oc=AdrpzgfL91jhf5y1t69GaIdFG-4cXmPGlNemsn0ea3l8rT_HhcX0edjD8Rv06ieYuPU&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5Fpg_WXg1wQ7kNvwGSgay0&_nc_oc=AdrToz12P8UnbE8uWbB6cF-dzcrnWCx8CFZoqTBp4hP0YmPT172np9Knvr5IqQXCbDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oVnUnLQ-AMoBc3dhDzlRPdB3-tD-XL_baKcbqbrr6mg&oe=6A0DB3C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w87ZSLFMI9wQ7kNvwEHxSpN&_nc_oc=AdqrfG7bHADG1CrvmqgutnztRLZP3pkpdQ9XQ4xQ1ZlMT_2w7UGYHptoHIY_XEEk00Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4scttOh3VmPaliTf97ab_nUfg-SmOcGrtwBeahNXPjPg&oe=6A0DBA53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfKDWsbRScsQ7kNvwGrC4gg&_nc_oc=Adpa2ID49-ycxAyRsRelE4RjVzqzFQrKE8vBUK27N1ZCq9dUClMU_4DQM34HYA3P6eA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43K_UcipmDAXkpDigmNVZ2Zmc6ekeIFR-T1O6HPqo6Dw&oe=6A0DA93B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69PcmcCn7tAQ7kNvwE7jZZ7&_nc_oc=AdrdCkTt3017tD2jY0q1t55da6JJYeEbXWW0Y5HEMgIsgYeESkZ9kJ0QmjRhpBamOOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53LF0ioRa_7GjIDCjO-yByk-jwWpIKlTJ2S2Q4K9-tdg&oe=6A0DCE5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YavrOWIBqgYQ7kNvwH7B4zF&_nc_oc=Adrdoi-PNx607oE3XgeM5cHd4ivdJ7-1pi3HfYG4KWFQ3uLaGfqRTORb7TkPF_cF5iA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CYyf7T1szAuaccB-dDbdeQCBszoLCxHzBNmgnWAeHZQ&oe=6A0DD2CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2sAMzYMBAEQ7kNvwGdQ12L&_nc_oc=AdqAucRVfi40LWiXitKZHrR7twoHtV_m3aJgWlusxa1Pxd2p9do5KNnCOktC4JYGYh0&_nc_zt=3&_nc_ht=scont
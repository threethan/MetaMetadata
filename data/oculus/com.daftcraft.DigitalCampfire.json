rjDG4V-3y1DyR-vOQ40T2dmnMStk16GcbCxnuew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvLmf3UxWnjWgErlKntZwBidJi7JaKXjq2lZy18ea8Yw&oe=6A79CEC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE8Q0elT2x8Q7kNvwEuVsqz&_nc_oc=AdrITQGSFMWJAi-b4EJLkOUD3ukqDgoxmP7DhGS9BsbLK-NJciEGTmRB9DvqWEpZXc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8Fn35_izlHKyXJlFGyNb82jUc-pRoNsY9RpOd9c-zfQ&oe=6A79E804"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feYZJu6ZRwYQ7kNvwGuiLa5&_nc_oc=AdpQROSsW3k0EwmP_k1SCxMRN-CNWj2Ay2SffwBF84TeIJplapR0Vm7S-dcr6a1OUeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJCVLHyzE2vAfzl1JoWr28WEFBps7lsrZVL5h9F_bkxw&oe=6A79B248"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltb-q94r_3cQ7kNvwGzzLVr&_nc_oc=Adpf4yO8xpwXMRjssvY-aII-AkvdDz7NovLGvGXe73OOA97FOaapDDGzWuyImEk__48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIwX51tiU1WlIvOhgYtFTsLukaqxSsqvv79NKmg1MOdw&oe=6A79B11E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mglGXrp7CM8Q7kNvwEHf20d&_nc_oc=AdpqdA9s9igFSdTH8Hw8vu7M8eDfUH95KD0YMZprsYVWtqesxwQaMQqhXbIpDdyd8UY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUFp__SgdT2vxJdDoeTLrm11OroLttxjOfoOmVmrOHug&oe=6A79B58D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkuygYEmS6wQ7kNvwET9daN&_nc_oc=AdoZpN2kzvwsGKTPAHLZW26HI-U_8QUhB3KWm9a7SNeAS59lIbfqMyC2gfFQyL0NxD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcUlhPr4LS7NSRJtMbM7gIdc5-o8XZtnYvHQ4B9K8lmw&oe=6A79CAEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
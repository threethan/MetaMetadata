8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rugPoSYICVwQ7kNvwHlJVp5&_nc_oc=AdpludoaYfglaloJHkKAjILxUdefBSz433Tns4UGeM9_I4hq8AT47XtfdxCvMHS9qWA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG9vbsk99SmZ9Y3Q3HPTWFUojRQAPWhZCQnGN3cpnJ3A&oe=6AC25143"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wcgXnKDy3EQ7kNvwFD4rvQ&_nc_oc=AdqClpSB6438M_M_D0JBR6l2oS2HRNk939xR82keFzCRTtoZfaUvROadCVUzUFu_i1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcNtSKEUuy_egQP15J73dAghve6JXn7m51g3Wi2XLJFg&oe=6AC257D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtsYbNW4ve0Q7kNvwFm_tED&_nc_oc=AdoadqJMoYczNsqx2I20L_rAXdbQxrXOa4M4nK_kvTq-iUjv-tv-FOgwYnzq4BOz8Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr7XRXoqRBaeP4lcvtDOYYp5mbBKvh0Mm2ZwPin2Fttw&oe=6AC27EFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyGcKZZpfsMQ7kNvwErYOu2&_nc_oc=Adogfe43KJHfk6NINvA1TfkI6L7uxYQSvlPhUyGbz-1P1U4vii4OgY2cQ6rZIuGYhFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdF-dgFE1sZ-q8EFzm8MIkZOABajpFmM1jibQzROBQkA&oe=6AC26BDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_C8bYHER-YQ7kNvwErHsP5&_nc_oc=AdqqEU-l9wsyDy9D0Cd7J2PqsKMzM2Zul72sF3pnfIt0262uwhijaFn4gl64ofTQDwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6WnFhV9Xh44tkNPcU_wZ_iqE_OUIal2NK5F7IDBuwFQ&oe=6AC2704D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrSW_JolByUQ7kNvwGX28RD&_nc_oc=Adqp5fa8BcRVs0nWkn9L2Yr6FpyRDwOlSKTx9eEWVQ90YTyVAYNyDM5qk4hC3NzKAgM&_nc_zt=3&_nc_ht=scont
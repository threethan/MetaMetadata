YcOx9aWrFahXGIqECogClsO-0VzqdgZC-4AR9B0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17iC_UQQunbXT73awAraAP-fsZz-z0X3AiLogUatq5ag&oe=69EA1B43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6krW_c3IiR8Q7kNvwExQL5W&_nc_oc=AdprkgAhAkuXxCEmCpjozmPK8aarul0C2r6U9SHw3iAV9C3xPKB60BEsNOwbCXza5RY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37pNevhS3oBbwjBIM2GwkXvsBsw01p2uSem_r9bg0KYw&oe=69EA3484"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt21cEMippwQ7kNvwGSADMZ&_nc_oc=Adrn5tJOyNNv5qTqu3YyPpl0e_ItubVSjb-bXxcD0MyNPo_lBhyH7J355ce1qhdMnfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gHebuDWdaunduAX0Y2EVU6jiTPbZ65LPV89GDxBizeg&oe=69EA3708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XnpfEytu2wQ7kNvwGVyIaQ&_nc_oc=AdpZqGFHoCXAaxjD12_9dK_mfxCFNt3VaoDLRz3EvIqg-cZQ0aL_tytm4CvlQ7h0tsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AkRCbqJk6HBVRxqVBXhYIHnxhu5-3bqWfWW2ginsp1g&oe=69EA35DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGPWRPxy0wYQ7kNvwExog4X&_nc_oc=AdqTDpAJJZanYLkY-i4-_nO6NyJuEaumAfkkplus6_OrxjgEAVvYtRcfxR40OIsvZX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zkNuRHeo9mL3Z164TAD7bqJNQIKSgizZRJhTHatLCnA&oe=69EA3A4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CRLedhhOjMQ7kNvwFPVWbu&_nc_oc=AdrRaigNGdWXAaFDi4k4252SWwIb3rdr8mfeNvj3u-k1rVD9_F_Ih9lnHODyFaSX51E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27RXkKkNKN3IAq2Bo9P-O2pSE2pv463XxGXlhXf1RZXA&oe=69EA176F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tPNIOopxhAQ7kNvwFQKTka&_nc_oc=Adrd2TbRqLjHjTA0XXWHF3EGK5CVlQvaYby2gI7aR3yPYUcdvbwUI92bO-vhQ1JrgZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtEz0SnJq85sEy7byr-sjyCCgSZ2ODYkoPT1gARBd9Bw&oe=6AA2AD43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPD9_JtGj1QQ7kNvwEoymND&_nc_oc=AdrZ7kUsq4o-_94e-hE0Dh6qXo02bOAPiyuw0IVkikmJSUyaV0iI8Cm_3fGwDlDmiBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0ZhF_dSyxT4Dw7f7a68Ik2GK9MVr8bQmlayUPq3V3fw&oe=6AA2B3D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fEz2bVGRzAQ7kNvwEgSfd-&_nc_oc=Adr2D3kUCBQ6hRdrBq6MkgXxSevrKGyiHoVxy3VjBEzAF2UEsZhKI3pmcjIqVDQnPiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvQ-zuDao1MAC2pdZoogQ0UpcEKboREENMSeTkc06soQ&oe=6AA2A2BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qelap3krbxkQ7kNvwFsVad-&_nc_oc=Adr3D6orf2NZj9MVpavJg2oWjMv89HrJKW6JvlEQBo5nQJrOWJNy43T03ZE90T60u6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0TvoRQd2ybrAYOF1APNvY2doeVtIaZK9wWnEdjOKpAg&oe=6AA2C7DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xof7s4kTMKcQ7kNvwH10rsk&_nc_oc=AdrZLhcsulCFA-0X_8SsnEnBCyEcx7bFsKwtXhpxdhECrSe_agpB-JkQdcjQS8Jgk1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3NYYdRkwZAn54Egq7i35XNFv38ebmZUy14fhP9JW-6g&oe=6AA2CC4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRh7sybiZCoQ7kNvwGSL6JE&_nc_oc=AdpDUvzmiw8OWZ32_w3-rCZ0KuOyTD-s4gdBKe_sIeqwlj2h2Jl7d8-noPpTcD_2pQA&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTadeCsTSwgQ7kNvwFHGigr&_nc_oc=AdqQBlu8np96eTns-cFjrwEhVbd2iCz20pmL03aqvwauH_gotfvt_nvCkcryFWat8cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqDBtEKMbBwoTnWQjE5aM68hvFK65wmvck-zaimKaBGg&oe=69CE6BC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUiVe5AEEUAQ7kNvwFHBK7p&_nc_oc=Adpe7IInrjXioBgQv4sEiwCGynBLwm2E6U1YbkKkuW_04rs8fx1z4hOqwRF3LsRnTLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyxh78ngP-GsSuIqWterdC8J8-g8tItNM-lQP94VoxePw&oe=69CE7253"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqg0RLBNB8MQ7kNvwFPefdx&_nc_oc=AdqT7qOHXtyP-l60DK8krMX9KYzQcr7o3crEow-dM7O3kuDJfqLuWFdRjQe8rdeeZ20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoQzDhn3kkEzux9iORzIvYAnCE5I6_HnfiMWZqEFN6gw&oe=69CE613B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0vvf1MabDcQ7kNvwHYN_U6&_nc_oc=Adqc-lJhHBFf8jdBtRGPp7-kzZ8F3hTn0MewW-MQTpcI1iR8siqXPyFZwcsmKi2DEYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwezeE3O9fP4ldJMc_3R-SHfTssaDynEC-FqEsE6uSewQ&oe=69CE4E1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3i2yclCZooQ7kNvwFHlHDJ&_nc_oc=Adpkyv_vR6wNa-MuGG9euGdGMvpHwwKmfOMSfHVXixap1SjeUs9CXSLx05-dT7ciako&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSz7zWaMpVqyX25NHf4TJsUEwbmxDhy6FuwhXTY9-rLg&oe=69CE528D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7opVuLi2SyMQ7kNvwGpNSwh&_nc_oc=Adq005u-3bO6uF7LTjMRvlbwGLqoM_XMx5_NV9Z3qLJvcXKoFC59iR8AT34pMV50WZc&_nc_zt=3&_nc_ht=scont
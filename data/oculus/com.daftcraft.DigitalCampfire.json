8618161382", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuTV7A_R_rUQ7kNvwGe9Iuh&_nc_oc=AdoJkKoYzOPbWXhAScspVPLWfQhA52oInwTch9KqQjPuqC1q5NWSAu-LEpzugdhGj28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWOQrwCXTgvNIQEP23Tl82Cc7A6EsPtUYaTjSyidzeNQ&oe=69D10EC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUiVe5AEEUAQ7kNvwFKIXzY&_nc_oc=AdpkEJ7gRTQ0dDCaOn1_oxrFGv_TYQ8ouayMvJmKjvBYiWm_Tv5F6ykFAQquB-qamYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdFi65058SDMrJhobvWTrgC72RzujGhGA94cJ-G-cKIg&oe=69D11553"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqg0RLBNB8MQ7kNvwGuvvGC&_nc_oc=AdrdQ0gduT96aXKA5BUz37Fevxq54B_gkS8aDszlQrxuoi2348phztab_L2XaJeX9fg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTaXWvC68MeneA9NBj1KBIfhw-qze0sUESV2pU7RzgvA&oe=69D1043B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0vvf1MabDcQ7kNvwHYr9DD&_nc_oc=AdrKBMmOTDcOGzNCWFyqY2z3Ye9B8AKF3WFH84UzjEgB6-dfGtQdn9VlKSuWtEcTtg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvCAoURyxU6BgMXl2jJCKZvuDAjIKeSKA3nx90CgiJcA&oe=69D0F11E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W49peRHbQW4Q7kNvwFGILma&_nc_oc=Adpte9KWYZkRGSF6cRrjhQf8m-vQYQ7QCJJSj1ld4fGIlD4liOGPRulQvqOXxoxPP4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxG0ouHtohsL3doL2r4b_mmJd4bYET_QAxgtqu1P1ni6g&oe=69D0F58D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UyD1jdbfWoQ7kNvwGVNIAW&_nc_oc=Adrgto9xAD2GZmMNVxLboGLDFBbmBpo9V4AoLBq2yNV_L8sbUeM3i56fTDa81-V_7eU&_nc_zt=3&_nc_ht=scont
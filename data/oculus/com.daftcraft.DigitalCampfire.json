WIl&_nc_oc=AdqNvWpz2rh0m_uW2HJcE9-pcqqYTqK5XS4rFzJGhtR8rcMfDkhLn_DKqZwz02o62MU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKPNkbeNX1vHbxxRtarC5dPUHuLSNaiLnKKxHyR97l8w&oe=6A7DC343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5g9Ii9HS58Q7kNvwFIZsU-&_nc_oc=AdprotERk-_lMHW59hSCi20Lx4eGKZemUY19dUfoT--qkgiBbnLs3ULmJFuR9p6563U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZzV_LRr6pGG-Nx4qewUOKwEIawkD-AgJJKjdLCYnujg&oe=6A7DA444"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMLVWrOzgyAQ7kNvwELzd2v&_nc_oc=AdqJQ8kJkFnCu4Mph73v-VYa8mKzVV5bs0IGF-Wb8NZcIzXUgwVjZQIZN4nyfSYB0VA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHANVovCQKRWQIDOw-5cl452Az1eDQdoCYDZa90_PtLZw&oe=6A7DA6C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCG88dgM5RcQ7kNvwFVMOJI&_nc_oc=Adp2cmCqBbsNwhWXKEwBl6cbRga8aaID91W6Efh26-J1NfXK66cFpiQfz8mu2VPnfqQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBA7hCvWgFO795DusovBIHj3Nr6Hw5suRFXGxMU3wyWg&oe=6A7DA59E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX4goTZnBRsQ7kNvwGGICHs&_nc_oc=AdpbdqEFjwZFnuZvQtv2FyiCLmPOLcQd6oeidw_ioV2GSUqLm3hhoGAQ5jxkmEKTCf0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsZbOoaKawJxA7c8DJWafECiOdigGGnZT7cgg1039u0g&oe=6A7DAA0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFjEb5t4GR4Q7kNvwHgR4fl&_nc_oc=AdpJVakzUlKnEco8dhBzekJ7MFY5oJB4LVFxpIZ4BHdoBsTtFjNFJXK8ccJTt0dsZts&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpLokJG0ondHcTW8sOMfukqg-Gc3DANisJOOFvZNWIYw&oe=6A7DBF6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_
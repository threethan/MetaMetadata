8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0KZv8M9FwQQ7kNvwGb_iFK&_nc_oc=AdoY16UBJWcuOWPexjLLfpe-LYjdk4dUtBk2aoKF4J5BHo9I82h2AcqDExUaacE1dZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H7nAjXEvqIWac0-x63vLI5m3l0yUSnXdnUvv4s7nBbA&oe=6A1ED743"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-96lC_YprzEQ7kNvwHTUGsq&_nc_oc=AdpsX810XFmNllhRl4Yi_wFKRxG_YKXjf7boWjyuKLbXh5DnhrBn1xm1bBPePmqshoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IbHhE8jvjtDwloh_Ua04cU1oAjFe9YKOqyCdd7MICow&oe=6A1EDDD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3ms5Gk6XbMQ7kNvwFOzRZB&_nc_oc=AdpXZxV1z8Jg_Djq2LpTVjAXSRwzMyZfY_SECQuOkjjrjqVyofE2-6a7PSkNK0-fo6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fYOihJRBKQkBpMLWvUfRjIRqVEZr_boI_zLJz5yVpJg&oe=6A1ECCBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdXIHSUsNEQQ7kNvwGtjODT&_nc_oc=AdojG7i1SCglTZKJ5atoBaU4CrlZmuWXmeAPOJg4V99k4LWmtp-uu0okPtKAeQbZyJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jql92UQLYzKBQIuHmyDUv4RISd6yoFHVBfxAg1y83Fg&oe=6A1EF1DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk0feB9J8yYQ7kNvwEAtfPI&_nc_oc=AdoY5mYZYiSgnDgasvqEMwl5MJd34FgQp4pQx0elk5KVOecWGjWgE8X-htHVzTbvUw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-C44wNqMQCJz2cLikzB0qi6vh4iCm09V7DCzF9U2csQ&oe=6A1EF64D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf9lvqjWk6EQ7kNvwHJDFne&_nc_oc=AdoSfMp27PMklPZAIntkCSbhpQPX4qqdG4i0RjDQcataZYZSAjwDtMkppNxJBX0sJ_4&_nc_zt=3&_nc_ht=scont
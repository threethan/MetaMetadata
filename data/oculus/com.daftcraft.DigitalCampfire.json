8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53IvCQohrc8Q7kNvwH0jl1-&_nc_oc=Adrkspb3I1S-6mhK-xwpJKrJycTMCzXCZG2SY4dMLrXc_8ryl3nh0jlrwzKANqrAoXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFDdtL02zuZhlqa-DBXjojIZo2Y8OQYL-s_57V1lIAEg&oe=6AF89703"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YlrcGYr0o0Q7kNvwEXWqn9&_nc_oc=AdoMndLWDybNFy-8LTWqY7VTQo0Y_hPl6drL2ZyLXdDlVeU7F9GoFhPuqTf06gIlPDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNR4_NhLb8Tb1Ejqmz7lXvZdOjQNKX1DpEEvod7cllaQ&oe=6AF89D93"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7WGSGGlqecQ7kNvwH5yoQ0&_nc_oc=AdrD8oj6Gd6OZ3Y6OXQ35eSPUkDNIpjeMmE3w7lZRYJNBTTckrt-WRxddGLbvSHXlks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR12WQoncatUR2Sb0_cX_MhLhRjQooRIzBBPJHktCyZAg&oe=6AF88C7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz9cBSWFIhgQ7kNvwHQuKgK&_nc_oc=Adqa9c9hHck3WvGcTHKzF8TblGmu85-Tv3LmfVW9HbGbXTNviFD9_Us-UIqofhyi_Iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS47DTLGVInKs-yxFhSFdmCUc51wjlx7mbayLtYfNKKQ&oe=6AF8795E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2D0RVHVMhIQ7kNvwFAdqpQ&_nc_oc=AdrjkzVnA7zhQUkRL1ivoNB0EihnchbKCrFETOkC5oQKUqNULlvJmmD8F9dw_BP3Il0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS97wXX_u5ZRUcCfKyTz4d8XyaAsChUF3oLLvmWc3DN-w&oe=6AF87DCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsl1QIhzjlgQ7kNvwFV-hqz&_nc_oc=Adow32M0qT1XyBP1FMyRoeo_dji4Jud2BaecgL7T5fFq-1eLzcqCRppeLjAqddOPIe4&_nc_zt=3&_nc_ht=scont
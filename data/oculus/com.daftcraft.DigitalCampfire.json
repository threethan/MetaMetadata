8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7amEJnrwk_wQ7kNvwEhX3OL&_nc_oc=AdqAG8ZIrRErmuMg5tKgRMZQa6UFywRmaZNNhWa5vKubIaVoBo5FFfe2oyUjdJRimvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcWwnDKwJH1qqoFBPy4Hnhma2-BLbJF539WTQY5iqf_A&oe=6A845AC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7wxjBqP5yUQ7kNvwHtAXMb&_nc_oc=AdpWf2NWFuBIWrATy315qut65nocdb7TPmdj6d0VNbMcTjzZheEmg31qAVdehOAoG6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvoZTgGmcsJvpvzuHVPjq4Ao0O-TeEzWJIKtZLSIzNMA&oe=6A846153"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIX8X_xllgUQ7kNvwFtZ96X&_nc_oc=AdqYbudP38bjtJtk90AJmWfX9l3hHf6qyjIoJmsibL4m0A5atpcnBXU_sMZYnhcgE08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpvf2JRF1SPfNwLBaaMQVtRJV1BwlILFCxEab2dtBrLQ&oe=6A84503B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeYJkzyNl-YQ7kNvwHOaT8n&_nc_oc=AdpBCh7Ekq0_ivz7Ncqjg8b-wUC8PBBv70YrWEHU1y6NetjqwBw3FjiVXdYQKIWDcQg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_gn5WCo-c9OSPa_RF0rmXwY9iDGWAL22ejXntcW6LAg&oe=6A843D1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOreKJ1zywEQ7kNvwG_7f1a&_nc_oc=AdoJRLcvcIAqyP7IYJub3bonZMn_f89e-Uybc8GgXJDkDC_Bwj5kH6qjD3dedCc3ONU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8VPyd11sES_44pLKxN9rPh_LPv9z7Rhxanu-jdgQ9JA&oe=6A84418D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT3dZdUfsRQQ7kNvwEy0viH&_nc_oc=AdpzPjaQ8DSVb3GFEmbxENA37FiVDOEcUzPHHLHHCkI3x7rh8yz8njbvgy2RAj6utDY&_nc_zt=3&_nc_ht=scont
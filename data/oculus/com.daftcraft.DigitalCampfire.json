8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDkx9BewiP8Q7kNvwG12IuQ&_nc_oc=Adp_IBid6Nk_eguZpKw4qlsfkohtH8cQITAi6xq0qbILE_-7Y0mt9YpxaySGd0C6qgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFB3brCjzsH9HYcnZ5ovqCtiwvESD_wXM-FImUqzUFNQ&oe=69CA7743"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBhWLtZSlEYQ7kNvwECKWS-&_nc_oc=AdpRmrxa1EQuqR3frnuy0Vd6uw271WfiLh0ASzQql2gZVzRhIXT-QK1Gwh-g8MAHBpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznqcvUUN9kU3fwKvyA-6O2PhgI7WLFjMmjqA2wPwiJog&oe=69CA7DD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uplH6T2GxcQ7kNvwE12YWP&_nc_oc=Adp5To_qZyDd9AChxHGSHYKutHwpIpD7_uga3gLquGcBVI-S9UseIC12_vcD3leeuPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWTWFaz2v-dK45NFwGjyi3MbsSpW-EmbeBH7qwalT2kw&oe=69CA6CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU7IjFfdVqwQ7kNvwHi4IvA&_nc_oc=Adp_NdSpPxVKy3apwQadNZIqTvhXzp_C3bqV3wEo_EVLlVb835m5kQA0iphVOqIyy-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaOJbfKIonSGYogYeCc0cRXmtbSKjT4eNaai6leXQ3vA&oe=69CA599E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-CPAZ9eizIQ7kNvwENAb9f&_nc_oc=AdqAINFAr5DdV20IsHuGoKTJlB3jri6q24oXUlwB2ZNtOf_vAHwoLxjxfApp-MYwztM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZMc4xNit54EDHLjMuVJWn8d_mAogICiCHsf5XsjpwLw&oe=69CA5E0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgiUZbZMdKcQ7kNvwEkRI7k&_nc_oc=Adqc1_g1VK8GV9cTTUMyn-mDGR46Yh644uLhe3WVcnDmgnTc2-25NQ6034XFaBq4Dck&_nc_zt=3&_nc_ht=scont
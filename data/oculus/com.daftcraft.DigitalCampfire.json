8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVZsDnqyAYQQ7kNvwGyYgQ9&_nc_oc=AdpEprBNdgR8uc-S6XqzirUphcFBlWDHLAIaHeiO54gAbXkCLvIK6PWaKoJaxftDNZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASx_Q4s4uwPfu7bSm4Q6FR3GTPzx1ltNO2WtloAmeMGw&oe=6A636543"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovH0e-JvoRsQ7kNvwGyA41s&_nc_oc=AdriimknEGEZXWATCJbi8W6GPkUO74Ccvwe4GxxPnabtlTm-wZIn1ISROiTHBD7m2Sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAAXG5lFI5BfhvRJ18K6NO1Znm8qTvOpKB-ZBDf_C7Nw&oe=6A636BD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHgdMIvAtF4Q7kNvwG_hOGV&_nc_oc=Adr_QkCqBv-6M292-GKY09EImZqE_MMeLpjM5Uogxwry4CC4oP-qIr4e1OIKc1zimfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrFEqaHbD2AgcSc_B0dEFzwrHHiQD8bh8LrEy--OKbYw&oe=6A635ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmA0FSdk7x0Q7kNvwGimITw&_nc_oc=AdqmMcwNh8fjkKPCX5MOyjGeC4CHNkHowFAC617TPK_sBNkGixkoNvQYbaYqG-PHqgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApB6E02rRpfmJfHXbSVGIM4XjUiVEM1Wk2W2-Ar9r3Gw&oe=6A637FDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m7D2-2ec54Q7kNvwEnFChZ&_nc_oc=AdqTZm3jDWQxWP8QuxWJloKTmbE7p_kSuMjCtPq3l3ewHg4bvCw075ZVI-8qfiDIBHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV2iiahDy0nDdJ27wkptpzxcunkmvv7AavZZ4P7WChDA&oe=6A63844D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBvHSIBRZiYQ7kNvwG3_heU&_nc_oc=AdrXJw-j1FcWvP7cJRTVYOZifb7ihuX3pyldwEI8GkdC6Dz09gIysRO1RvrDhvhZdCg&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0ows2zX890Q7kNvwH7588F&_nc_oc=AdqAkpLKH9WAg8f5-0HTtKB_IC2F0MQJvi1L8XCM9zKp5qsOofUGX9mknCQRWJAQyoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3eCqQ9xM3_EjJo3MLo4KQorTfCy4UHpSgq8kJFQwTZQ&oe=6A5787C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ghAmEPR0wgQ7kNvwEeEzL0&_nc_oc=AdocD3jkm8Fj3SbTeodHjY44FE4_3rWFaMNg_ndFr0Pufgr2CNSNuoc7305LJg_I_x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUmdzyy2p1XxKkvTWv9fl-QZSABepMAkXcZvydfD3xIQ&oe=6A578E53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=731MZdieXU8Q7kNvwEEHwhL&_nc_oc=Adq8Ioz8qJFHXn31FRvZHdmYDBQ2QFGPSvIY8CrXi2IxFARZi_pttj8zVIkVJ3Os3BA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKIHWS2Nuvx6KfUuQVYlkvZFB0B4PWG8nNEPrXCZtOFA&oe=6A577D3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klRMe3CJNCUQ7kNvwGoEn0b&_nc_oc=AdqXgJGhpdXO3Y2khT3bnGW0Ar80xnrjie-7GewKOxi_n01dvx1NbHTneC8v6nQLVE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASbQifsun6LXlf-VKs9LFgNngz4uKkaREnQn7FtQlNrA&oe=6A576A1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S83UCLQtGdsQ7kNvwEjbPIT&_nc_oc=AdpWdzYDQ94iTITTz95huG7gWkiob3ua2LVmT5nNrKrwvpOqflSRUqW4Bw4dCdhty_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIFtjcC0JDkyzzqctWCm2MlMW8iZtZVGLSddp2IAHC2Q&oe=6A576E8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8azjjBYZhbIQ7kNvwELGEdu&_nc_oc=AdpBqCsxPF_L6XnxMwk_Kc__jOqZFMkWuuwtYivSHA5_1XAB744RIL18tRPpczUmYMw&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPV75EqvIfwQ7kNvwHJ01l9&_nc_oc=AdqVTLf0ao2oJtbUHhLMlSFhCj2tDZv-QVLcOxQF4uyDCHtqUa3HEJnoXTQaEglKeIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DfQOTA9zFgUcWwUb2nhNQ7H_zEvaCokm_BIa9KeQozw&oe=6A411E43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYV5PDrVi7gQ7kNvwGmJNsW&_nc_oc=AdomcZjnkvRJc0IRFi5qxJ8gcRkI9AEwiTvmQfv0EwXJVUr5EDGA0Nh1lWPxtwBTbho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e3D9-WWhnaxcfACmWf26JoEPH9ARFhUQttQ1NNkFZpg&oe=6A4124D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liuW003TrLsQ7kNvwF_X0Fv&_nc_oc=AdqKaNojQLOIvqJB2pjW90LdliGjOsWDyTNYqSpvIfW9-CONHpc6rYntw__PvKjAan4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lfajBsV6qqJuzCYH3EoASmDo-w0ICFa0W6HL6VvN7VQ&oe=6A4113BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2n--nmtSbgQ7kNvwFeXTZW&_nc_oc=AdqK7vZnks8lIhrXfJ_FLDozrSt3O5lwII0Kxi9qnWaTp2UhbhTxEuxTPKpE-U9vU6A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qXwZ7R8E3JHC9gK4kSbXGQZgAigO_IxP9oWm8N1dHLg&oe=6A4138DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq7sFd9a3YMQ7kNvwE2PiaO&_nc_oc=Adrt8m85Hi5sXv85tXCyw1fjIggM2Ad8XIC1Mbtaz63-amu495OHuq6rN4rNw5KzOis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mOhNzVdG0yFjt4if5sxfjigU3p_uVutWvRFfyNT8ulw&oe=6A413D4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxfsSBjkVQgQ7kNvwGaVSIk&_nc_oc=AdrLJ_5A56QYaWW5w2dSJp1v33fV0EiMdZiyJcY16Y-aWIYKnbByzIsXuaH2sKQZIWc&_nc_zt=3&_nc_ht=scont
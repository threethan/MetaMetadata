8618161382", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yl65HHP0CgQ7kNvwHry4Qx&_nc_oc=Adqzz1Q4OPZNT1oBlGzvXA92iTByKz-n5rG4QwHqSjlPk9HHFxDOtKSbSssQR1dqsr8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcd5fCbm9n1TzrQ6iEDxBj7S8oijnlYB8fgWuMQVOBfg&oe=6AD0D1C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOeMiW_G71wQ7kNvwEzofxR&_nc_oc=AdrVjcBtWRSMPIjMnZD1m64K12PIgkjSfEXYiduoqPOM50hl8z62N-PzFWroc2ya64U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH8-SVruJyurVfN909djpIKmSnppYKngRx2Y8tnxCmOQ&oe=6AD0D853"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74576hxYaksQ7kNvwEs5-LK&_nc_oc=AdocxuBED0Pt5TrkI9hcG9HUa_HQOeq6COESZwqJoePWtL-vNTvvgEdcWm74OJD8rYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXDatzo1QEs1XMAB2O6DSO1PVkfNTDXW-jM6mnnVx_KQ&oe=6AD0FF7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAp9n-1FmbgQ7kNvwEv0rAx&_nc_oc=Ado2HskbyqH26V4VTisuyz8DsVVtzLKrWYzwaD3IhvERDzY_Rr7Gs4pgzd8EidDvT_Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmsm5K6fhYvfn7Se7HBKITuDXyI4emr3Sp-9N2s0CtQQ&oe=6AD0EC5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygmEc8a26pkQ7kNvwGVzCC1&_nc_oc=AdrrFcLGPkqPMKJnFtEki6za4WTn9QUA_y6KoQPnhZB_4pnYmxSHEOU0v9HhocpDfNs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh-IuB23OlGtb-60E1GMlqUgYR1ivBQeONlqkC6ze4Jg&oe=6AD0F0CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6W0O2AKkkcQ7kNvwGoRbrp&_nc_oc=Adp9msht1N1wrxykvSKSs_J4lcfY1dSQOYWHslvk-ImfV-Cy81jkMT-ASuEtmcMii8E&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEeuy16vSsgQ7kNvwH_vUao&_nc_oc=Adq3aGduA1e_E9686L5HHP2m6YX7GCNdlIXO-BMEtuLyDBtodRZpA4DsCvhgsmVdzM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhIPmWt6RF0_ltu9uyXSV_o-Rtp_mcZKmOrJCIyVCBaw&oe=6A7C71C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_374OAJV4wQ7kNvwE_E4N4&_nc_oc=AdrAV1BxL9P3Nt84TfrA_g14pCNTmnUC915Er5vWGo7fi1NAhiCzthcWfV0uMgmgDUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcG6AXEEBV4pmt5Sr-VUX0fKblg1-1qqWAwtUo6gOPNQ&oe=6A7C7853"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrbBdUag5K0Q7kNvwF9hrvz&_nc_oc=AdrQFud6H7v_LzQMw5zagOOpBOeQlMP3B5li19nq8Q3_M2s2yjrPL11G-xVNsDdHHS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9RANihGcHDtJrZ89O-dgo7jzdX8A_rmL95LcCuVG0Yw&oe=6A7C673B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCG88dgM5RcQ7kNvwGDvW3k&_nc_oc=AdqxU5eh-70tCWnKwjuVeC0nHXEpc4DeHjSiOjcPgqVcozY8-l17WVuIU775DHL7F-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWnS_3YfSJW5kQ5A2LfRa3Qx7XeDtzh7RHVfJkTHxTyg&oe=6A7C541E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX4goTZnBRsQ7kNvwHLQebQ&_nc_oc=AdqCH0mTO1iG5Nl9sCDIBrmtsW0Ybn4xo6IxoS0cVcastt4znRTrQkwoL549oIR5QoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0dhi6bbTZHagDNoB-aSwdzMSEmI_-mZ-pMhluEiUcUQ&oe=6A7C588D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkuygYEmS6wQ7kNvwG5uoxw&_nc_oc=Adqr7mUlIh546GZkh-mI9HZQw062rAz-q3NOVxHYbCe8mibDbNvhCzfj8jvxZBUn2E0&_nc_zt=3&_nc_ht=scont
t-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-6NJo-Ydd4Q7kNvwGjTs0l&_nc_oc=AdkD8E4waAlp8dOpSnfqCyQmDJb4NPh3QboqtqbL3_iqzmeUyRTwvaJonwyDYp-r5VA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzINeTHdVnSo2IWqHuAlRMHUyrzVHQndIfPaAPHwTPFvw&oe=69BFEB43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9Q0mFryLIIQ7kNvwEqCrsv&_nc_oc=Admjl7syKbQHE1FSe5sNgRp_NvDsYII-SDSQVdnyEfCCoDZjuFupkUL-WJJCWM7_N44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWg7bo_LmLpeX2Kpsh6PocVlUrSDMGnmKW4UY9xemyOQ&oe=69BFF1D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1eowhZlc5cQ7kNvwHk_3mu&_nc_oc=AdmogVVVqSr-tHcNSAa3c7NwoaapKH40PxIYJ6lWeV6dlZn2sLnu4N4D4R8qPOqD4ng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXf_GAvVsJhXwJo4FbGJ02qzKvNev2x6N0Kd1qkQJKPw&oe=69BFE0BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Cp43qk5NjYQ7kNvwGIPm7x&_nc_oc=Adl7-COHTxHPEBgySRPXvR3GOjZlKyzqRPg-TrtG0UoTi50KZLvNNIuDxUTgO4hhtbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSoqWMoik-jzACidRQ0BCw1PTSHh3RZ9SimdGbapqnTA&oe=69BFCD9E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eVFrKBYEDYQ7kNvwECJ8Ao&_nc_oc=AdnM-4yPG-GFuTzLVOx6K6wbDeWIeRJIxPiC3nqSZ9Q0ZHsQrlpH9BUFRzOcppNNqkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwb8XLMj_F1UUtXjsI-Xm65zrRwr6GkEq1SfuN5enjxng&oe=69BFD20D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PE_Vv0zKBMQ7kNvwE39ovk&_nc_oc=AdmApAyrwA1Hu23gjI1Vz5RpBggrwTStBi7zWKitvwNhBy6Dm5VVFxhLIGeAEBhDgTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymOjG31hY6vJRZ
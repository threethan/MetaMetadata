t-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9v0Kao70YwQ7kNvwGpM8KG&_nc_oc=Adk7MisPMvp79vt9PbepuWIMIqxUS5xtZ54YUCItbnr3DGUnwa04BLadycMnl7LpXss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc87R3QRd1o4sEDf7Lz7y-VRftpLOaIAAEE7gtXrgv3A&oe=69BAA543"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2_oNOnNjVQQ7kNvwEt83f-&_nc_oc=AdmHRdxabmtYuYTejoYgfHVx-jCBqeNf-rJLIHcGluZ_UOLREnXHUdwQmvykji5oLfY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEpdWJ9PByN8neW4wkcfs3P4TtwzPdZT1K58bED08log&oe=69BAABD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lepoFs78DqsQ7kNvwFn6TxZ&_nc_oc=AdlHBNu-ujHZMwWt05hQgq4cZ6-dZq4GWCfrbGMxgXsQf7wL_RrPyETl-S2QaziD7ug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1_8bR8e2DBhICLMd12859dAp3Qr6qBI3H3ubWpHF8yw&oe=69BA9ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mWW0RT1vQcQ7kNvwEV0_L9&_nc_oc=AdlBh-FzCSvXyXqHjbdHwBifd_fDsuw90QUI6SZnZzAs-Z1Fc2LYozuRRKKWoPhs4tc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwgtq6jECl30xvbLbrh4ff_gVURp_ToSl2gRe0KwGdgtQ&oe=69BA879E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yBezi16eFUQ7kNvwE1opnl&_nc_oc=AdkZY3Ba8b0fNr8W8UmXw_y121Q2WhGg6nrT6JYBbLvqD2VsSLGXhWVd2EZSp2903qs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3kmv0ynqv4Dmwv1Fq_MNmmBRgd1TvRaLwoH9VcVcEyA&oe=69BA8C0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Prz8NFG038Q7kNvwGgI07U&_nc_oc=AdlWcqCrLen5Q8Mj1biRIIG9dL0jNvp0P_lzX6MXuQfthst7gaHYaG7TALa-F0yeXsk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAcgEjWHdbfapW
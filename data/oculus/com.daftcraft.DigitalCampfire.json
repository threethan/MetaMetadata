FbyI-dndZnc_1vzrFSMf75vVaFPPQrHlLtnQnz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sxGPQGe2uwERdG5wCq6W1OMBreLQPfJfY8RtZuVqXBg&oe=6A3E7B43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxHKA-Y8Aw4Q7kNvwEa7Hbk&_nc_oc=Adr7m_aEhIedvEZNTSoy9QPf79kCU6oU9UsEjh6F7eXygpNtj9t9fo3yw7_j3J_CvD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Na6qNPX-WbKR0aoGxDS59-g5Uu182G3YakUvJrDxHyA&oe=6A3E9484"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiCgu-Cz0-wQ7kNvwH3GkWs&_nc_oc=Ado6fTgw61_0Ya79sGzG1etfR1leVdhsYaPgpvnGBM0YKOBQ8sYj5E_IkiCmz9cglTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RzazkM1X9hV81NL1fyNk_uvXbwhcACJNwD5roTxp1Pw&oe=6A3E9708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59SpKD3TsdwQ7kNvwHFNd2t&_nc_oc=Adosfj1j_HM83vVU2H18h34C_3D4_sGMlDEYXuS1mS9MrFmVKkI46kRzvLgjyJEl46g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af947SV8SE3e3B7Mts5PMNgf68nkz0SDzSNx2Klr-AXGIw&oe=6A3E95DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-cmltU09zsQ7kNvwExMpDA&_nc_oc=AdrDErw22kFkEhDtoi8sXrHdPFi_2PI4slJ_ikxiS7mZkBUK-zmTdi-Muxj5kVw9fbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YjQNsij0CunQkVXusvYjPxkRJjrQQ-KnwxvQ_b1EB7A&oe=6A3E9A4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxfsSBjkVQgQ7kNvwGCHOEL&_nc_oc=Adqsl0ixCM61JUqvOf36aJukGJ8D8FvrezGAKue3NiQLa3gBbiVBpxIy8-X3JrrPcRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CcfJYwBzZUFiNFrZEwYJ5SbVPKdLdAvf6BmjQWVVJVA&oe=6A3EAFAF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
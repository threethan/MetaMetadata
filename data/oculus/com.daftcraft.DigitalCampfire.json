CzXCZG2SY4dMLrXc_8ryl3nh0jlrwzKANqrAoXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFDdtL02zuZhlqa-DBXjojIZo2Y8OQYL-s_57V1lIAEg&oe=6AF89703"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZVOou8dqx4Q7kNvwHMu52p&_nc_oc=AdpDGUOCdZb8cf6mV3BhyJxb_GIWWjp7mE8nnY92_vc_nZV1DrqFXSTiCzo-KM58Q8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHVqEzM4PqRUiGHa3qscvdFmKnu0ABW8C3mrIlFRuyoQ&oe=6AF87804"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbTFi2M-EXAQ7kNvwGz5nPR&_nc_oc=AdpsC5M9G4jpPOhFN-UDbosNKvRr2rzULWPpQ4IubIpC7mqXZKHFkBA19nL3paXBd2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWoDLTBOjJsrQvtpCBW7unxhxSzg5zI9u1NUU_kD4Fzg&oe=6AF87A88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz9cBSWFIhgQ7kNvwHQuKgK&_nc_oc=Adqa9c9hHck3WvGcTHKzF8TblGmu85-Tv3LmfVW9HbGbXTNviFD9_Us-UIqofhyi_Iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS47DTLGVInKs-yxFhSFdmCUc51wjlx7mbayLtYfNKKQ&oe=6AF8795E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2D0RVHVMhIQ7kNvwFAdqpQ&_nc_oc=AdrjkzVnA7zhQUkRL1ivoNB0EihnchbKCrFETOkC5oQKUqNULlvJmmD8F9dw_BP3Il0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS97wXX_u5ZRUcCfKyTz4d8XyaAsChUF3oLLvmWc3DN-w&oe=6AF87DCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsl1QIhzjlgQ7kNvwFV-hqz&_nc_oc=Adow32M0qT1XyBP1FMyRoeo_dji4Jud2BaecgL7T5fFq-1eLzcqCRppeLjAqddOPIe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVK7ADSdA363vDfFlMGTP2RNLsjjdQ7lAjo2TTLN7JsQ&oe=6AF8932F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
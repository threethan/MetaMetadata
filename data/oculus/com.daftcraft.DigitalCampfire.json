8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_KlGRdIrAUQ7kNvwFn0PH8&_nc_oc=AdqbKQcVYoit-155Hml0C0kCOYKZ2OlG72PXN8nL8uNIHPoktlHpnFicFdszYG208pc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVFrizO_h9blHPd0vWOGCnqVlilogXT0yI7xh4jGlxCw&oe=6A6B4E43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Fgmk18Ic94Q7kNvwHSLYCX&_nc_oc=AdoNscUIxCqr0ZqKwg_P9L_cLRJJfM3HZGJCD4yGtxbv9CvocSKqQoKJbZ9el1Usnt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrSG9IDMH89bPdh6NSgaKBU9TcPlm_czW1aZzyOAIcvw&oe=6A6B54D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgKkApjtpRcQ7kNvwEoU9JS&_nc_oc=AdqnejirY-prN_pZ4lkPVOlfHpi0nQu5bT9iuRc76ZC-Ux8ea1aOij0ue9cnYvvZseU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZVHEz9v_F2pFsaHAeV25s1GS3oeFZyu2vkmnoZJ4Rww&oe=6A6B43BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U9HrQo-b94Q7kNvwEvnn_d&_nc_oc=Adpp5RH4LMSGKn9rK4B3bhE-Oe2E6cMviBs5S0CCp0VLkFZB-NmxHq-q1fNOJxGta2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOEfrolsRnm_9dMObGwRw8I4i6OEWaRwhe_sj76ZjpdA&oe=6A6B68DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPv6pvgR670Q7kNvwETdRkb&_nc_oc=AdrQ36EucNgZ-6IMoh6X2uYwP251Gg14vE1-ZLSpy8_dp2bzUAj4cXBOsw6nS2TJDoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAexH0ibBCqT8S-gxXgMJBfwJiI1vQtiInQf338UIh9HQ&oe=6A6B6D4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml7Ihq9FR00Q7kNvwHaZQM_&_nc_oc=AdrR2XHi25mHQy5HRGp-b-vz-g2LAgaXtiDeT1r4cDxLAVzSIHpE_AIAoLqOuLqgqMc&_nc_zt=3&_nc_ht=scont
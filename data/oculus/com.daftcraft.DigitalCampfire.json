t-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDtigTYC2WIQ7kNvwFgtjty&_nc_oc=AdmY1el7BZZ4vbFeU-40jDnvZyIwU8cLTJ0tULg-ebQPMdu09ONvB2QP92KBQdOHsTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMkoKrPOvQqZU_o4wi8NfBv_iaFotyh0g0fjOqH9Yykg&oe=69B40DC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_INNUqXHE6sQ7kNvwFNeHK3&_nc_oc=AdlZWC77urE689ZT3ywZ_LKb4yuxhOGlo80thMk0VMl0a64f_d5QDMIZVSHcQ1wvMi8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz--y8flDsE96wrRDW_i8ygYdjXsaPE3N7uvCtZnw5Q2g&oe=69B41453"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN3MzvN1rx0Q7kNvwHj3Bpm&_nc_oc=Adno3YBsmdLz0MYCWM9yhqxM5K8qntBcJfbm7B84SNGlxJnY87gfBcsAmuwE62wELTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvmLe2RoUYoTNVtbtRLfibiHW55b_4n5vdVvkKBycfrw&oe=69B4033B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgIwfq98KbMQ7kNvwGP2XVH&_nc_oc=AdkXNtcAoj1beny3xhuxKysmypDAZY_LJPYk952yxzUu8fmtWlBx-JqlBNfblmvVtIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2qicSn7AoLkQ7GdeFvOOkNL247Hy2gPuGjek_FZEb7Q&oe=69B3F01E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxKxUR9i4TMQ7kNvwHiZDXy&_nc_oc=AdnfQGBwPRM55-y5qP7Cy6RjRgT9o9azbg0Th3QLt6J_BWo1aS6Dr4Jy3XA4CGc-by0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQAvNd-0DyezFW11k8cilfw0jvGNjdyR0lxNJRvFGiYA&oe=69B3F48D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1l-Pwrv4tAQ7kNvwE9WJXG&_nc_oc=AdmRf0BzahKzTYUvfmmZz_a1_91o-0w_map6FlQczca9UTCKMsxXtPx2uvM3VGkkl0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCxJQdQUxXOBej
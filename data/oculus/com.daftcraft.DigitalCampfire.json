vVT&_nc_oc=AdpCZJydHhaHABCbCyIDNqo8aUQ_k1RhSQgUtqQLlerDb8XGRXnNx-pyNeiQqLMQefY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qmmgIlr2Co0O4UkwgqmdcMOE7iBHXzjiAkONvbpapVw&oe=6A393543"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8esmufrkB8Q7kNvwHd7liZ&_nc_oc=Adoo68EaUlDDobizY6xPTmZKpHgffLC9JziwVlc6wdTHamTYZ5rvaPiBR0NfTljShVE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NtHDdLSfjlM1jXe5dMQJ7CVe4f1Q--2yjjgAt6EWuLA&oe=6A394E84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN2SUodYSYoQ7kNvwGAOgp9&_nc_oc=Adq1gpYkXCAVmhfTr560EgACLiQaZK7Pa57DiDEv2aRjnjqV0ISpdc-82IE1fsR6yvw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lgjy9W1vqxAM6fCD25Elx7QHt4oGuvfQit08wWkouwQ&oe=6A395108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8O2YczJCgwQ7kNvwH8xcMt&_nc_oc=AdrwwWvp89lMZyAsQtQWvN04HRh8iw19QSziPQf_yZl0CX3UEfuIjPvomfpe7UydlBQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mfosJUGwFHNwyKo-OQHOmeWBBl--vbkAxvk5Jsr_tVw&oe=6A394FDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4TUtxi_s3sQ7kNvwFjP0Nk&_nc_oc=Adpma4Jqp6yz4ROG_xw2Dh1N4blLlaXHz9Ue8NWTr3RR0GDWkPTCuEj5dIdufXnNHuQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ff2yFblImyCAEY_nxLwisQdW5IME65Mzt_ndxHcwNuA&oe=6A39544D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7rd_J9ixYwQ7kNvwFZs0D7&_nc_oc=AdoTgEPb9aWiyhTyYU7ck527KGPTBy0fYxv8L9K7dmGqG_3osMutiVwWXe6Q60bHaWY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95wTbwNGTnsxzi-ddwGFGR4SjTLbTduyqVeCP0fJ7T8A&oe=6A39316F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_
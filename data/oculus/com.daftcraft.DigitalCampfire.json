8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I18P0ngSx9oQ7kNvwEoBKh-&_nc_oc=AdpqG0twajxX0ddfFV2dNBD4RSuXX0WVDHvMnwqad18pA5nWToa8QNTXWltXne-3gOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbuYFe6mnh1LJJo4OjjUipKvFeT7q3GlgquaM3r1U3fQ&oe=6AB7C543"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPh9UJX9f9gQ7kNvwGKzQYS&_nc_oc=AdrDujHAvHuNoyQ251bjexaGoj3IFD7LWz9cLsJOmDuYYtqGLgc4GC_Ntvm3ZEZKwo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwkcNp_JBsdO3Iv33lPNiUU0tx8gCblaowSd5vbBWYlA&oe=6AB7CBD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgRxkqKKxKAQ7kNvwGevbl6&_nc_oc=AdqPTNEeKNUfIMYAelWCu6Aokml6b2Ru9v_K56C3Ycl2FGFL5VEkPpMA2lUrVBEtHI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN-T5sXLon2cS2BQTzKU-u3tiCi1E0WyJb6H3OmVlM_A&oe=6AB7BABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bvQVfEfzWQQ7kNvwGATyXB&_nc_oc=AdrlCzW2evrmmalsccG7dwCyrZhCns8JJXbWwES7hvz6-hVcqJxJFGokWVPIDYXYxLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ElXBzqC5__CbUZiZV9ae6pGVO7GahS-ketZ0PJSp1A&oe=6AB7DFDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Borre7I8FEIQ7kNvwEaZW2g&_nc_oc=AdrGlXR0YK1MnvkHXIth1icS7YsNHX7RpvTPROuHav26f0nnpQjyh1rSHGuqE1uK4Wk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF7e9TYUZ0DPZyEvQR4qL1jmLm7WrhP7jLdYnlpyPA-Q&oe=6AB7E44D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcyvBdx3FgIQ7kNvwFm6oGy&_nc_oc=Adp4rSr5tbYgrhoHVUYys9MYLp1_nhNh7x6kOGXJn1JcUXuGG2MeeOYUOx-15OTlnPY&_nc_zt=3&_nc_ht=scont
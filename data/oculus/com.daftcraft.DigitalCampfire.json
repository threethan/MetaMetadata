8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P1iEQkSRS4Q7kNvwHOr6oH&_nc_oc=AdosGre7StWBkQkc3z9o6IBSwtDeJ0Ktdm9YVbZ4x2NwGrgEv8suuQnrlb5oqv5bC8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBUtuXJ_mfTw_qhpxvphMHzFGcUouUigitwEuFEOqoxQ&oe=6A9EB8C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdhe8muU0wUQ7kNvwFWd777&_nc_oc=AdpdqvlsoNfODM4sndMGGJ6eFNXWyRCIldDzJyWd8_ROlhfEvE-p_IigZoZJAK3wFbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvB5iR0xnbvZ8w4CeWsgP5kPMQzZgw8aOxu1G_W3sOBg&oe=6A9EBF53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmho166DA3MQ7kNvwHSWlN1&_nc_oc=AdrD01npkxLlrN_GGTZqTRnBtbFLX-RX-wOzbP2EoOGTKGPVcVNvJUhO23UzFFNd0k8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYh-L9lIpHitc2hYzCZ1TlPSj6tMduAD4au-RqIJOPqA&oe=6A9EE67B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVuqYLpRhe4Q7kNvwGydwGe&_nc_oc=AdrIYZZCE5SdQllsjIVOqnT_LzDM4wilukZRFx6UmARryJaeN9-HJjIUUqkxkZGTq3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq1EFVeg-rSLNEoMakFNkukhafcpWA9gFmiUGNdlePSQ&oe=6A9ED35E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqFG6xxNr2YQ7kNvwHwV8Ef&_nc_oc=AdrEM_deeftlR__SBN3HJsqDuIVNqe6dJD8PSNxbTfwlJcLYtGpFMu3WpOExpWkqGG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK63Zdx-O7kbKhsFUISrNjgkDrnWUdDembMlNGfBo9k3Q&oe=6A9ED7CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9CV5BI0xpYQ7kNvwEwUE37&_nc_oc=Adq76rMQsMcQPBSxkYBJN4Je1jnEhBRxl6N-w4ApzcW0Rq0jWjFJAZmW_WifCHbAmb8&_nc_zt=3&_nc_ht=scont
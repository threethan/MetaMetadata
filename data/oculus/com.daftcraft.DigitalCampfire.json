kfMf-dU80IJIVCLeIy-FFjjV2XUZf3nXmfzGrHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZQlEYymJu6bMhCgOFsyvt3eS4jBSeGPSEdTxbrgTXvg&oe=69E0E0C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=689tPb32PrIQ7kNvwEDmkDM&_nc_oc=Adohy9YpoZPW_UZt6a5zppjW1qW9h6PzDiYtAn5LanwKEx7uPZX8PvdF7CNUwVMVcfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jEJLEuU8T_SzH3AVazFqu2ursff3Wrai-3bSjWFjF_w&oe=69E0FA04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBmOJwaFWcoQ7kNvwHAy0yN&_nc_oc=AdowbIk6_USgvOZMCELSvr0vEEBBKLkqT-g2gdtjegVQPYq7ZfJi0LlpA9dm9FIE9is&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0emZVrAywhc2A3k2ZaDhtwbpeofwPOakyYC_2x6o7dUw&oe=69E0FC88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0g2RAPqRSYQ7kNvwFsfLOw&_nc_oc=Adrp45lRH_pS4AYfwJ8ytT6JPt4v27CItf4D5zh_muqRj8uXHdSvddQ9YWSFlcoYXfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bLo25N_0HifszwTcVbqJbWZRbwMi_gkR-hSbkVwLuEQ&oe=69E0FB5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrDe0B4UDhUQ7kNvwG94oyO&_nc_oc=AdoqY9wDl55761GgCcC5iJd9nQQ2ffcxzltX3-BXI9Si316igAHE7fkyde2onVSToN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Cny3sjv7uSfInQLAbmrUqXJvcceWzW39lNquLm3TmCg&oe=69E0FFCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N6vRKnHshEQ7kNvwFdILR9&_nc_oc=Adob-pJhPka1lYe46r-jGQuk8h8ce6lIuLZ5aL7pq37TKXF8OtE5ihWEtCvVxCEBUTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VcupP4QOJ3fiF9eCQK6GZJpX6ueKClyerBICFlfuF7Q&oe=69E0DCEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
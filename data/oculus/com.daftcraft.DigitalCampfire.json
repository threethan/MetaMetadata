_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbs8oh_r_bwQ7kNvwFEn9gK&_nc_oc=AdrsDzaOgkE4rwC2lvXqRzwFzWCRqyJK5pqI0oI240SpibINOqUZzZnNwYQRP5s9gAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0e-RiF8SWbCUu7KmhgLcGLMWHr8-vbYII41YFCxbkTVA&oe=69F0B2C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzklJGv9kboQ7kNvwEY3aAR&_nc_oc=AdrdlOr3JDi43Uqd_w6yK67-MneaBjxVevKbROkiW5cGkyZqd457S4uLWJhJUyfoKIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1tQyH0wX1ZG11rNCuNOgvq64UNjXN5AWNtwMks-YIxEQ&oe=69F0B953"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPal8u4SHKEQ7kNvwHY3scs&_nc_oc=Adrv53_bKfhPWTkvi_Y1fnSMBPQpE5rR1qamB9MEkdeAJyLr-9_he7KcEVQkKTp0pwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1A1SsLld_Rmfjpy3yqni_C4XhU-ZlcUYsxo9QemtktbA&oe=69F0A83B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWpi6viQE0kQ7kNvwFshVnM&_nc_oc=AdrALNMf6DcL1HrT0yfYDdOnoC68581zJb2xhN-JzeFPn0d7i9v2ZMeoh5NXL4uWQgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0xZxk-IM_022zFtnqcLcoptACpucQ4xv2EVn4cCJuo3w&oe=69F0CD5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECrpqcybKsMQ7kNvwFSDIFe&_nc_oc=AdovbSipDOjOVhBsELvBh99a3CixYE778VZL-LiSmP8g9JWJC3dr0eWBdW2Esv5AUxo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3VGTHmJBmsklRLuMzCEkYNo68MiqLEZ7AOvitpuX0MSw&oe=69F0D1CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q5c5L1tfUcQ7kNvwGas4Gt&_nc_oc=AdpRy0-qtBVVvAgZDTU-geSZZj5Vwy_O1wwpirvUEBA70GjT1yvEMXxW1docpdXTIo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0nvQB9bFkjnYLw6zNkQihPMTQbNEMcSv1L_SZU25VKuQ&oe=69F0AEEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
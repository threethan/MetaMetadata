udhOvCVNq3Cfrl9LjqNXiGUz3N9II3dR9B9QgeY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LGmPQi7dWUyWqOhFM9Xxk7EEQtTy9UsIfRp0kaK5ROA&oe=6A1056C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX_vGFlaVAkQ7kNvwGhPSYE&_nc_oc=AdrywmTsqFcebmN-wusbM7mmCFmYZc5vWO6CJS-cWWnCjP3Z0r-BqQYH_HAWUCV2YRA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fytyGozSIuT5lZrT4F5nIrb0Hwul4Xdy1FY4jmq-IKw&oe=6A107004"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCMSrkw-O6QQ7kNvwFfEkjS&_nc_oc=Adrlk9s4QIBLP2qROLs3-WswynFJmmEy9h__yEpMpU1-YvlaeBy3Nl67O2yg16jp1C0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58bDNRWVSHURZfMdPPswcanfHnCpRfqOULhZjvLhi_zA&oe=6A107288"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69PcmcCn7tAQ7kNvwGqfh6o&_nc_oc=AdpODeT-ORpeU0TKb0ZDj2f1amadO5bs4TbysNLMpUgYj37Pp4-zoPwvS_FT2hnHwWc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q644QAsUIOD28XR4-KsaJ9rPs3zDpHdZYX43BPjjexw&oe=6A10715E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6EVQ2GbN_IQ7kNvwH521Lk&_nc_oc=Ado7JXMPsAZJ-M39rZiULji6Iap7mAV2wnmZkGDjYG4VxnKPHWdp1ZR95IAuON4qsDw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VznhD6-UY1Y2U-NSewCg-62ZIbR-lvdLq8XR1yxk3_w&oe=6A1075CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIMeA2bS240Q7kNvwE_6d5U&_nc_oc=AdosfqtoyDqb_qBq7zOZC0Kcp3hGNu1l8wZx1uwR7gUKWlEJX7sL8xVf016ncjLEy2Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BBEj0PvP9oh14jpLn9m-fkyGD1dtcjhpTLMk9bTdi_A&oe=6A1052EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
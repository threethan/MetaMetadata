8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeL2T9DBOtoQ7kNvwE-E2X3&_nc_oc=AdoLqtpNAAq-pqCuCVl7tspVRhsUT2Lp24VhtvQ66_UhpU494R6_p5VDpgxtTkOWZr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtA6jhHonWzVDpDbhiTQnNyRApFzZdt0iHKTOk-hCebw&oe=6AEF5C83"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpoLNrv4OqoQ7kNvwHcksV6&_nc_oc=AdpacHCJjVO_EtQT5Uaz7p5UdQIFF-ZdKwlkbGVaU_aTI5Ap2d5O68bciDoZU_ab-70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIkavHU5FLvpe0BsE-fxEkhmgnUsso7FXJtCMIdFRSRA&oe=6AEF6313"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSbdLBzgXvQQ7kNvwGkYX6C&_nc_oc=AdoadDgJH-fw6BgcLk6TqZ2WbFdaFBJKSf1dQjnKfMOP_cYZV6j5MjtkhSmF7UuUxUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD7pgEAPndPa874b3xjAlt-_D-PSaaTdYziftDt0qElg&oe=6AEF51FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5dmmOInYN4Q7kNvwHi5t8Y&_nc_oc=AdoGqssCwSoLB6zHfUnSiW826WnifXr3geHZ7jFaeCXG7j75rQjK2n15FhsxuHAns-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8zmFueDuo9O5req3u93yBPUWQv-FI7vQSGUbT2PzNQ&oe=6AEF3EDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxxSjqA5YQIQ7kNvwEkC_7f&_nc_oc=Adq5OcBXyHLk1MkW5T-W92WZEKyfEJV72ey5PUOamIdpq5omlnpNKJrmsJWmsksV4SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Zk2NkOHUkzrrjcT3nEk2lfwBxzRsX3A7YLbJ7QMzdQ&oe=6AEF434D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qApzswsvnGcQ7kNvwEVVdAo&_nc_oc=Adpe8CD1m1hY7XeAgTL2ZTHO-POKP9i4bpBJpdzlMuEUvNbN7mFZF0oM9WJOIKR2FdM&_nc_zt=3&_nc_ht=scont
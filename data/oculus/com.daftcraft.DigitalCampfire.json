t-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFqTDnBvR6AQ7kNvwEU5Ryi&_nc_oc=AdkyWbD2CdYWsWX5FksP83XK0Of1wVa1YsstaRsK6q-nNn2RXwWsYhoxDJufO9AM5zQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftus3D-7eO880bJkZFGzcvNOlLjrSR8_83OvV9E1_9S5g&oe=69A981C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOHcv3LrmhEQ7kNvwGomAhV&_nc_oc=Adn_Mitfiibz8HpO7qfWmcWC_ZPc6QDygBm4YfrWwDs6uBrxxbarwP57zGB8NVj4dWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfviJuv6vOsQbdyW_rKF2wCLCRuzJcLL5KaVMkx7PvAx7g&oe=69A98853"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WsWrCA5GeUQ7kNvwG09y05&_nc_oc=Adld8_SVameOexVO1Zqkj5I-kn37FD2laTpbpO88aNt9xNFJuAov2ZEmC9lFenXLeBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftMrZ-HrkIpcPX1rWUrrlQAX6idbcDhcBIQgfperBTFDA&oe=69A9773B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2J9IeOdBL4Q7kNvwGX919t&_nc_oc=AdljfAWYyvJs4ZFB6CHvYAcvhNehCcLrAOGsrWa22XUOJUdiGHC1JFj9f4D_MXhQ6Gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuvtc-TQID7DCdcLsGg1lJXKQoAPEl8uehfBPwSh-lFzw&oe=69A9641E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYACI0nTtrUQ7kNvwHP7NlG&_nc_oc=AdkjYyrQSfumEGRKoFDF791G3M-5x2ok6wYeq5t0Znk3J67BzMP2nkL0bMnY3ov4qnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvhNVDwrj4Nj93XlklvkfCeIqLlO-3AGkrEI5jen1cu8Q&oe=69A9688D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xs9TmyNAoK4Q7kNvwHV2LJ5&_nc_oc=AdkYdSlA1VxM4VEgfu_5QofnqtZ87Pbs-bORchBmuHAHzH9KouO4XpvV4jjvaYFOM3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjwYu7n3LgIZBZ
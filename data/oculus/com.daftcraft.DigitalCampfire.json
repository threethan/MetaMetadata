8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53IvCQohrc8Q7kNvwFGx3p2&_nc_oc=AdpFsFj1JcBgq8FeJ2nJxGfEDOx5bE6dCRnKpH8QFGDkFy13HP_MXAZsv1JqEkEmwW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnzymH5N_TTsZ0x8H4FOM3zWHr-sVpHsiYkv_IKcMkRg&oe=6AF74583"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YlrcGYr0o0Q7kNvwEDVVT3&_nc_oc=Ado3Zo2sKnWu7EJ1mRIHKHrHJdPLRqztUo5CWT_aYii3Nrlmn4VgGNo5Ar_ofDhcD-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjRlmPSQf3Vf4vbk8M56W8PNcAtGRqPJG9AmmFzMc2Pw&oe=6AF713D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7WGSGGlqecQ7kNvwEB6XK0&_nc_oc=AdqqgQOEowhiZY2IgL-bh2tMH24G15wi6xPa3Lp7xctaqrC5DM7BAa5vnFB1oxWGyWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxCpiURTOd8SvwknMhdAgznPCEdoyaGeVkssx7mvb0wQ&oe=6AF73AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz9cBSWFIhgQ7kNvwEgdkoS&_nc_oc=AdqTP5rI2rHfvSBrIkRyvaSAZRDtrH_e_ua1aHqUZ0ia61nTqzPZJp6t_3HA2QC1rEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9h6pPvwPC6Elll3i9_o0Gx735sln9twn6_Mf70z4cYg&oe=6AF727DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2D0RVHVMhIQ7kNvwFKSCtZ&_nc_oc=Adp89Z74sZZQVVsvC0DFObH1TKVUGz3XS17HiZ0SLhnOADpWUk_B0CkyJSLuCFeAnC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDT2z3CNzQMXHyLFOpnK3X03XcgnVzkIEGJbehLY1IkQ&oe=6AF72C4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbvbH2PZbDYQ7kNvwE_fd6N&_nc_oc=Adp8ht8ifVN8_rKHJqpzsT0PJCbLfg8FjPogszhGdH6navOpLPnmGCBH1Ah9TfNEirI&_nc_zt=3&_nc_ht=scont
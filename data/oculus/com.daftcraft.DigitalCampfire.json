8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnaeJITNi_wQ7kNvwHaSGot&_nc_oc=Adrz52dH60Se955CAKWYtkqTkyV7Zhirrp7vETL2obWwtEnEzAh1Xe1IXW6tZp55joY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40sTQqDytsBzkQWraOCfO9mUWjM4rVcrxAFyl_tA5qNw&oe=6A199143"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJ2uNhRwtFsQ7kNvwG7Ewwg&_nc_oc=Adrzg8gt-38OMKBUkbuR4u-ySwEr3w9axAMo9thcg5Rng5SNpTiUaX0JDS9THzLspH0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62cfJz-5Va_7l2oaXoaaStjSRFTX6IkpQ-oHWUPvDsxA&oe=6A1997D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nygu2h3eqqIQ7kNvwE7OrSf&_nc_oc=Adp2U7K-lupLs9Dud7hC3KKXbM1nPnJe2Vukxkykt7KTZ5ik52_7_D09sQ-hY7aiW9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RjywcHbiQI10NwlWZTMWEk7z-quCiQZ8i0vbHs72xAg&oe=6A19BEFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSMIwu59x8cQ7kNvwGOoVBy&_nc_oc=Ado2-Z1z1fmTRnt5CL0fVOSfqXVo1K1jv36WfWpBjwPifoEbqM70rQpxx1ZCbsoDBeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WUrakvgEsnWrvatKuLquJ46SAkOjAdFEhFGPASQX_Tg&oe=6A19ABDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aspBEEerosQ7kNvwG7alCs&_nc_oc=Adqq_scCnDnC32lCbc9sRErwjmKfoKRA3J8hrwcw9pJzfVBoYk4y54B8oRSF0RpuCRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epmafPQ96qkDrSJUL1lq-74sgEhqoWsmYb1Pf0bhp2Q&oe=6A19B04D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsPIg4Lz10cQ7kNvwF57jYh&_nc_oc=AdpkVc4MYOy9HX7wW8_ekatw_40GvjP9HeCBbZRxhBn73EWrhOYv858qHyfjNq_Uflo&_nc_zt=3&_nc_ht=scont
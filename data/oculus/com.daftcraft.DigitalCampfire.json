8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f97RKn2rIYoQ7kNvwFsPTM-&_nc_oc=AdoDHInD933o7q8ffMFPLDh314f7UyFGimrI_t8ZL3utefxVlDxmvz64XrQR-O9CRo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQpYSD78-0MZRVn3ojjpyBUZykFRSqoHAPsqwGuWvN1g&oe=6AABE7C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfIrC9T0jLoQ7kNvwH3MOyq&_nc_oc=AdqnFsAQR63v4G9flhpDIvM33vLb0mn2rN4ckUz3EOJHHlE5EMAiGaoFPLNEM10qCn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaHa8PWKgL7HaKK9cU-OvOLk9_eQwrvszpdWLXHK-8pg&oe=6AABEE53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctpSKdqOOFoQ7kNvwFxxs-E&_nc_oc=Adpj9SXu2zS8A_QX-cFoGXU8rb2eKBTSJ_Gb8pJTIOmAlx7dMBHeMIIUCWl7EM3jQtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVLyNRzjhy3ml6biBlUYnmIopxDRoz1A8lqSorAkMl_A&oe=6AABDD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3WSs8c0T48Q7kNvwGGtKMU&_nc_oc=AdqAaTjloSWp6Dj_g5V5-JUL08aLGyR3unH1PHfmnq1aSmFNQ-cFaQMESN5v4bq2GiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGRJf0jG63qYH4I4HUdSzXO2GLd9mPaeHHQ_ARW-P4_Q&oe=6AAC025E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXPNguhm924Q7kNvwE3Cvt4&_nc_oc=Adp7oNkkrVQD-613YyL1XCw5ib22nYsDp4GX1gvx-wHSb-u01oR4muqcfx4AeGFX6eY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtXZEoCli_Gh2iNRW9Jx1q0hLDBy6O5mJ5ZOYq9ty7mQ&oe=6AAC06CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOVPg12gdZ4Q7kNvwGa5SlV&_nc_oc=AdpBXt7tCqdiFNUH07arhpU_AMtm8P-7_4ZV0Y84oGHGtxgZSusff5Tl6G9mwD3g3t8&_nc_zt=3&_nc_ht=scont
DZv-QVLcOxQF4uyDCHtqUa3HEJnoXTQaEglKeIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DfQOTA9zFgUcWwUb2nhNQ7H_zEvaCokm_BIa9KeQozw&oe=6A411E43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxHKA-Y8Aw4Q7kNvwE6LDIX&_nc_oc=AdphgXP9eXpRnAJ3an5c2FaN78mZMhCIM8guzOiJ--DuEPpksbxNicvYxX_h_-81fBY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w633R7iPYyZJGK81Rm6YZvFBu1yGnUti0bNoM_mKOLw&oe=6A413784"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiCgu-Cz0-wQ7kNvwFPKPAX&_nc_oc=AdqZ4eL1e7S0OWiBT-IJ6KrUNAZVz5ogiE4QcQaj5zLsKdiNWtOuZ-mNkVvOOJT2LY8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YMopRGe7w-Mr_88JS1f-RWTh4MV-oN9FfZDsGTpVwsg&oe=6A413A08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2n--nmtSbgQ7kNvwFeXTZW&_nc_oc=AdqK7vZnks8lIhrXfJ_FLDozrSt3O5lwII0Kxi9qnWaTp2UhbhTxEuxTPKpE-U9vU6A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qXwZ7R8E3JHC9gK4kSbXGQZgAigO_IxP9oWm8N1dHLg&oe=6A4138DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq7sFd9a3YMQ7kNvwE2PiaO&_nc_oc=Adrt8m85Hi5sXv85tXCyw1fjIggM2Ad8XIC1Mbtaz63-amu495OHuq6rN4rNw5KzOis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mOhNzVdG0yFjt4if5sxfjigU3p_uVutWvRFfyNT8ulw&oe=6A413D4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxfsSBjkVQgQ7kNvwGaVSIk&_nc_oc=AdrLJ_5A56QYaWW5w2dSJp1v33fV0EiMdZiyJcY16Y-aWIYKnbByzIsXuaH2sKQZIWc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oqkb10eiHIoOBkRExWjcb8nkUKaotIv5rP_xIsj_sCg&oe=6A411A6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
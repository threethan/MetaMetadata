5FjRpMKv7vso4BoBea9ssZg-69pgjBXr8equLzY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iBhku6V54wS8bbVCG2uZp-6x_pxkuMOmunxj9sI6Q3A&oe=6A2FFAC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CU3Wf_Cc98Q7kNvwFYNOJl&_nc_oc=Adqq596dIlKzs9Fd3UjIA6hW4I0hu0GFoPnuqXSWexp3o7Nuttbn6rrpPW8fIRZT9Eg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LuZOdrFQMwVRbhPoB9PJ2qnqDAiKdSONkRz7RKLPR1g&oe=6A301404"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L1tctBOrzAQ7kNvwGGLnSf&_nc_oc=AdpHXIQ-kwRnZeyZotcaw3dNi6W0aS7c7GiBaeC_2p9liY1Z1wkFy1ji5vB1x9msA68&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vggtqiu0fMN5joz_-AS_CuvEAIO_RLsRzF0m8d8XVQw&oe=6A301688"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzR3IbngO0gQ7kNvwFaRkpz&_nc_oc=AdpZcRVvrJzn8Pb0NoZ7gigMWSMxVmzWgO_-_Sf1vOgZKoF_YH3H4hzqCJPiiwNjOJk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j0N2fr9fPnHgJYQ61GbYd2uALRwpogxzMjYbV0zvCqA&oe=6A30155E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC8hm1CWsUsQ7kNvwEsDiog&_nc_oc=AdpxI-snu8LFVbcO1TGV6jtoLkVwYhtLwDAZ27HjGNQ-Co8svkePeqn_5oNlWVhbpuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qEAWifAQ8yLc_3V-u_67OSsr3QlzJUaJpBJoX-_ZqXQ&oe=6A3019CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyvcvATBTe8Q7kNvwEMIa1C&_nc_oc=AdpHoc_Nr7e7qmPHl375O4EGyPfGk4fiGanV9l1Kx8pEYqAlo3KEiuXddbhh1aPDl6M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JBPbXV33i-m0eec16MGVlleW9fX9A3OYBQsIYSXHlSQ&oe=6A2FF6EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
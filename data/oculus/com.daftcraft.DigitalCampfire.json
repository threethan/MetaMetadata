8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-s5Q6W85MAQ7kNvwEvB_MI&_nc_oc=AdoqAxDBioK57vnyQkobSzdjRyigYcOx9aWrFahXGIqECogClsO-0VzqdgZC-4AR9B0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17iC_UQQunbXT73awAraAP-fsZz-z0X3AiLogUatq5ag&oe=69EA1B43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL4WM3rH53IQ7kNvwEDFnsC&_nc_oc=AdrXRaw_Be7XWrgUhKu3DHrUqy8HtjlFCCvum5e9ptPxR8qNvt065wt1HvQc0sLRk8Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1akJHS7EDdMaV4ycyagRPF8pxUzh5FF6QJrPW5_KiKUw&oe=69EA21D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THDQX30_NGMQ7kNvwHZngXt&_nc_oc=Adpo4WRAn1251gCdJduWhrNUGikbbYF8LXI3yvky3U2PQZAYuDIr39fqKL6yXJ9GoPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kF3gwBdQmf9Qvc3CI9IN1ZWvJZx8UpicjfGFoVjKaZQ&oe=69EA10BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XnpfEytu2wQ7kNvwGVyIaQ&_nc_oc=AdpZqGFHoCXAaxjD12_9dK_mfxCFNt3VaoDLRz3EvIqg-cZQ0aL_tytm4CvlQ7h0tsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AkRCbqJk6HBVRxqVBXhYIHnxhu5-3bqWfWW2ginsp1g&oe=69EA35DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGPWRPxy0wYQ7kNvwExog4X&_nc_oc=AdqTDpAJJZanYLkY-i4-_nO6NyJuEaumAfkkplus6_OrxjgEAVvYtRcfxR40OIsvZX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zkNuRHeo9mL3Z164TAD7bqJNQIKSgizZRJhTHatLCnA&oe=69EA3A4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CRLedhhOjMQ7kNvwFPVWbu&_nc_oc=AdrRaigNGdWXAaFDi4k4252SWwIb3rdr8mfeNvj3u-k1rVD9_F_Ih9lnHODyFaSX51E&_nc_zt=3&_nc_ht=scont
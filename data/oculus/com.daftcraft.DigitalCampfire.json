8DiLWvBPfbcTZB_iMuU6qYSLdj6O_v_bP3c4DF_cnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHDEiG5BBo9LId2oMQruBcS_efxbq1bOV3W3YvYorqoA&oe=6B006844"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqo4k7hnAgsQ7kNvwEWzCA9&_nc_oc=AdrFKbXzsRgH0WMfr_OhJ4e8qnq2R_H2b4GSVvjLP9VwYuKRqGsIq-SFVUn2CkbVwms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV2cMuC-LBkB3llRU4vOfZk5ijliTR4AOxDiax33hiwA&oe=6B008003"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OX_KjM220h0Q7kNvwEWgI-F&_nc_oc=AdpzJW9hDoHc7YFtt4XnyjWO9WjRshoXkN4Qdn0t_2KXuKgsClYPTaoK2qWHeS1aSVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqQO6tuyForePoZe0M9SuKxBS7in2f11dqN8MMeluitQ&oe=6B008693"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6e_h7Z9-3QQ7kNvwHUi0Ue&_nc_oc=Ado5VDo4R4LYoxRdK4w5xTC7aJkXppljsbprtNBA32lHCfgrrrmpXKa0UEjmLh_vGUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDvIs-XRmF6DU9jUYHYcWEkd1XcgeWmAsJ8HMQ15c49A&oe=6B00757B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IsnP9foLIEQ7kNvwEhH59S&_nc_oc=AdovuHqa1_AC4REy3F9IA-VYqRryHg7nISrc8b4VUUrc7QbSTOi-IXdudPrSxqKffQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScBYdQcTh_m5OfnOTejyrbUjrLZCB0oD8i6QU-eFdw4Q&oe=6B00625E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXtSvS6O4PcQ7kNvwHOSt6x&_nc_oc=AdpBghbNpnC7vOivKbnaMDMWVF33n05rYUd9MVGfl61I-ckwu4lsqLvxDsENZwObS7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPXOeh6Tulu1vHUxN0x2hR437YqJaRaiP0uOIfKpL30w&oe=6B0066CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
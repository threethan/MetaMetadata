zSwL6Teufx9uQUXl3lVI9sX-gNBwaF-YSa8WI4A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqK9n1048e4kmg2h_iSx4wxdiCXFSYviLK4hIKo7mT6g&oe=6AA15BC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM850rd5efYQ7kNvwH01PhP&_nc_oc=AdrcU8WgzkrytzvP_iHXZksaj2azIzmpS3lAksWggz3K7a0BvXwgFuwuEhQsy9bnTq8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzR7Rav9AxHIJdcZY1gMR2m1n6T5l_MIfZAF_2kOp6wg&oe=6AA17504"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAI89EPvHTsQ7kNvwHJTPbI&_nc_oc=AdrXXgIIEsQKRCEGvaxRQFh15LtxuGj1tKJ47F-RjQfTiuLm8sCBUf6zakmt4i7cLSo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH3Tvf3LgYU0wtGcbWIcdtLewEe9sFYRKxVPhEh2ANNA&oe=6AA17788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qelap3krbxkQ7kNvwHGvhF7&_nc_oc=AdoHBxtQA_XwmhLvj_z_wDNycnoYDU5SNvYl7zUsgYOfbSE2MviVNQlqjVH6AU5lmGM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiX2MY5W2XlZQMNmwbS2IYbQP_AdOG0Fb23EWhCOazVQ&oe=6AA1765E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqFG6xxNr2YQ7kNvwETv0p6&_nc_oc=Adri-C2qz2C7r5Hfx5oNAmsKlfeZcs7jic4tWG2dTEBeAJftMOQc77bpEvI1q22eZ48&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaILJZEm8lgPFYVS5bKjmnADBm4Cyw5UHf86HA-erCMg&oe=6AA17ACD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRh7sybiZCoQ7kNvwFPCKpO&_nc_oc=Adorf-75cN5F-KJhad6TiNZkRKF-7JZVUDz6qS3IJTAhwQXyhNz81nOrkxvok1BufO8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQRaKO5VnrwpsSfz2wAwo_qHyfPdwIdbAinV0ZPCGPXQ&oe=6AA157EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
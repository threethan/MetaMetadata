MUfX5L1hw-q_hhx7pbvzPjWUnOsiCDAw7yKPJ48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL7je6FQHmRNO4tNs94S9Lg94WOb4Rqp7f52vzwRiQXg&oe=6ADCAF43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N8I6PNtdKUQ7kNvwF7YPb5&_nc_oc=AdrmlyUZYqI7KFXX4Ci9DkxDf4yyx9RcXULONJvLm0AUUPh1n6qf22nLBjqxmDtPQs4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4oLogw1LPwPf7IEphXtXEvN-33xg0IXB7mTRrxv_lkA&oe=6ADCC884"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ooj0rF7AIqwQ7kNvwH3wTpn&_nc_oc=AdpZBfEuItVWsfFKw_lOZlgTrmnYyIwB9jP1oLoNQIMAH0uB93u74w6q0sk3Wu14VSU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJFtl-Ic6VhI7q6SluDp3Vop3fhBtEl_9SvRbelzf6gw&oe=6ADCCB08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QppALs2XdZQQ7kNvwFkFmB2&_nc_oc=AdqXeMqTs5jGWvDmVt6JRSX6uA_INBIDXYTy8Wvc9sVo5EAmOpuoTHDGezMjj-KHqj4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzQHMAeQZaMJYNR7b94RttARopPJcAzonlSKUMMupnpw&oe=6ADCC9DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipGifBOo0TQQ7kNvwGmENKG&_nc_oc=AdoTtr-iz7EhrnMRcKL7ZsaS9LaeJSwL9FrzUlm3KJzruwgHmgsl2pJUrAbmGZi4yDo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7EIQFizf3RULVkEGVm8Kmm2RRqGkgYAi1j0weo_xvIQ&oe=6ADCCE4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMfqs0UjWcIQ7kNvwGslgfM&_nc_oc=AdpKyfTRbhvvVpxp9A55pNooYH3bH4ATirQM7-h0rpJ_qtg-Mk2ABiAUCO3Kgm8dzY4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNICThSuk3Pnzea4OlZ9E4zPmR8h8-ZcMZoMhv41fOtRQ&oe=6ADCAB6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
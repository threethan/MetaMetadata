t-ams2-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH59osmm9Q8Q7kNvwE8kpcY&_nc_oc=Adm2lzOMw2kPC60a3kfuP-f0stBOvtG09AXNJjQEZeoPvA7KLogZWsFKSD99JPEaby8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzavr87uV-o5hYEtDu_OkeCo_rVfOCy0IUJxqPur-QGUg&oe=69B01943"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIrEIvD-SsEQ7kNvwHAUP0O&_nc_oc=Adn_RcFB-Un8t4d-BIMdE0UOojxLWLiMn89yOykRm3AkFI0BZRfXysUgCTjHB7zMTW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR5V57lpv1QOHPSgUmegaxVlwDhD7FMZI2_YciofFVpw&oe=69B01FD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDV1mavz688Q7kNvwEuvey-&_nc_oc=Admu6YQsTpP3rHmFH_Rc8N0VZ4pye0LPqSH3HTy6Lj8Z_Eb_s4UwmvZzwH7MGBgT_b0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl8_X-bSCaKsx2Qt-D5GpnzsxFd_NIweKC9rpwDlGlWQ&oe=69B00EBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uocFDgGKXtEQ7kNvwGUNCMV&_nc_oc=Adk7glcOl2fK651qk9PD82DmrnlPx9rYO4ZMaqC5LNTvzhtBgeKzqfs3yLE_PDYhsFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxrfcYV0bfoBdcSoTaQgCc4XW8UEyKUKMcGKfAy3bKaw&oe=69AFFB9E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUcxGDKKw4wQ7kNvwEjhw2x&_nc_oc=Adn_GsgqVo-_zI21hmE-jqteAI_yvlOX7J_tUGDEB2k9Kod5A5taJ-9z7HXc4n-ZmpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1REwxf-H9u7lL8YavldexkmrYUwewrs1hSmbMwrmRdQ&oe=69B0000D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LnbuxLEO04Q7kNvwHOb1_f&_nc_oc=AdmfSlEwEPsdj1JRqs07Vn78F_JTo13eQAvgPOKIQWv6tJzITDbkneGeT1hrusesqLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv6kakIbyqfVmd
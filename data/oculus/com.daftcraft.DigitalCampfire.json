yg4bsdE8WAhW4JPmPV-NDM7TIDAy1okcQvijjls&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65cAkA3cnb4d4lriSvjLsqOWk-ct85mZcObmd5pb3O3g&oe=6A09BF43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0coRIkN9eyIQ7kNvwE4AJfU&_nc_oc=AdrQElQrPuJilFORkTMQf_j7QdnfSMmwnLvnksQmDmr5KDQtTHfdff-M5WFHSlsA9mo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7USg7f1pEoTR5ZnPhDpt4aUa_B5h0N4pFmsCivKpv3Bg&oe=6A09D884"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pD6ktZHGY8IQ7kNvwFpdfj_&_nc_oc=AdrqYSOTrG2y3k2SDCogRu_E82bq4h0s4fo1rfPQAk4siT_qKFounsjo-ljqiRAoIGg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pzwtQdE31PWi8XLaZB9vD7uEFb1Td5Vm_hbmjsRhx3g&oe=6A09DB08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2tHMTqAmSYQ7kNvwHykVzK&_nc_oc=AdoC6F11NCOtsPD0XH7ys4aW3iXwHjtdRss9XyYjxMFEt8SWWDIQjiVSmvargdqHZYs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R29pU0YL_D3iJFK46Zs-YxQH44Pm_9eCzy-4W9_fSQw&oe=6A09D9DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pdPFyyGuH0Q7kNvwFFSgpg&_nc_oc=AdqrBOYnoBaDc7xMGp_M5NDgl7qUqSkEzJdug052Xz__dgJ_YkkM_LjAWvo1mbQjrGQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pt96ZPRFLql7M5478CuxVR9YK-hO7ZSV3r4Mr-6f55g&oe=6A09DE4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBw83W-1RAMQ7kNvwFQ0YFx&_nc_oc=AdpUTslv7mtc5NgpZaN0wnw0aNmc4nfvSbgQ9EytONfCbyL9Jne3OpsHTkzFL3ofbts&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f4NGURHIBb3abCVLBTBH22bDosiT81iuqLnia33wpbA&oe=6A09BB6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
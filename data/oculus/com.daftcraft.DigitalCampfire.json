_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPmusNy6ZgIQ7kNvwHELTj4&_nc_oc=AdndqFlBLdegAp-TXSXwaiDT3Hiv3yp3_poFgvj6-Q5WU_6_q0CymJCJ8kncBeIVoU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsQOgESHCe0SaUgoC12z-psUyRdyHpjQ19XLyTuxyBU4w&oe=699C52C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwkgJGcP2_AQ7kNvwG_jz5F&_nc_oc=AdmRIIWFQwHJn6az06atc4hhTjyC3gtLe3_H1g_eE87shqaTXPTvZtAS1TugYhneP7o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvH9nF6ecNWnRsTxd5VnApNqcnWilS4o0WYzaIqi_7htw&oe=699C5953"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bq0yvqJca84Q7kNvwGL0Rga&_nc_oc=Adkbeln6nf0yEuQ9OGOc6XWNKWZIxHg5JtAUeFEVizYNGvxJjK19UF8sbOpwNIAzs-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftdphJmMrr7cK3rMFdOhxZwZ0ttTLz_PZvG1eqNQG33vg&oe=699C483B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0awu40hst4IQ7kNvwE-4ThO&_nc_oc=Adnvxc4y3NuDrwYFsQAgmljlxOXdKYfxAACohbJh94or-C7bDqqdrGoSBNp4paB1pNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvhWEz6NbD6ZilCUHVI6dAvGJ4GX98wL4p4B9D7qceCGA&oe=699C351E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW0saUzpPjgQ7kNvwH4IavZ&_nc_oc=Adn54yqh_aNXGp0yay97bQMDh550TJ3Sb-87tyEc9yARuDigxzpSMOGRwHrz2mFX5SQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu89i33SSJWdHAEVzAFvtr7wD2ndUEwoVTl-yZ_8YqNEA&oe=699C398D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBY_LtCojegQ7kNvwF_oO2i&_nc_oc=AdkrvCBnB2bQEstPyzIASL7BFOywNu_vvUcvsQGmlV6OdXzJjmcUga1GFl20z_NvZ-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftzVLHwRTWJH2UwtYjFPac-UTah8hbrb4Fmh4qbwvf3DQ&oe=699C4EEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
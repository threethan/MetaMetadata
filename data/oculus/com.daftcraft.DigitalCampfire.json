8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AZOEG-6nlwQ7kNvwHxZl4D&_nc_oc=Adp6PIjDK_Y8tZOBsO6RPOUmVDawSVoEaM8oIs4Iov4FaEcgK7L9-Dsu6N7Ga-IHL5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ogeGF80SD7zIiPFJf3MuoseqA1DxfLyXqfjYJJV3IJA&oe=69FF3343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bksnhAIB6yQQ7kNvwGFHzpe&_nc_oc=Adrk-mwlGrS3FdHqYi51aK9BZeBY_9tQL6NhYhBbuRYeHP5DjareoZMywXK88w6b7Ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af498ZeoKlC2WSvhZJs_3-HSZE6JGSxbxudqNE9tFuJkcw&oe=69FF39D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OEJGEbVV1AQ7kNvwHSqcxK&_nc_oc=AdpgY31ZHc7Jvd4JR1uKIYY2Xn0KYBTcNnHA0Qypc-DguCdQ0lQYQ2pjHe7IM6-kwLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76tr1RxOe_XIOKjT7rQD2siW7s17tGZEmdVHo8Nu9CPw&oe=69FF28BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9TxQWNNNpsQ7kNvwEybkjp&_nc_oc=AdrCKOEFbAo4VDfPnHENfJ-rcQuYiJIflaW3dhsdJhnHikcI7zjJHmr9BaO_aO05JoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74BWdwN6Pb7tP8_KPe9HVzZRt2e77HH_iRqRGa7HE1UQ&oe=69FF4DDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M9NWa3s1ioQ7kNvwGb9oeo&_nc_oc=AdqmVFLn7b3OHpxA7U3AhW2QCeq0t2NW4Pc3migaJ-UGqfFGy2SRlxzhxuOVelyRvnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OUu62rl6oWVZCgYRLHoFdom-SCmlPUQhlLoV7E8N3_Q&oe=69FF524D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zd5f1liQeoQ7kNvwE0KTGc&_nc_oc=AdqwDHpm8nI7L5HcQ7FQPszXIO5GqYWOR2rPouu8q_u08ovIHSRYipOQaslSo_ZjhxY&_nc_zt=3&_nc_ht=scont
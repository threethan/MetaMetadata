8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxo9pDzd_T4Q7kNvwEJF0du&_nc_oc=AdqavPAuZg2eE5lEOik7MpTMSK_3_YfWaplH5grj1rhiwavGuRE-gtXR0ZY8xE88v2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-3ZQMN5RA6lcI3JMdt4fzi_uClTUjCB6S38i5XHpLfg&oe=69F89BC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaf-VeIZjvIQ7kNvwGrYcII&_nc_oc=AdpWMRCwfcmZimq4jbRg1znX-c3Pp4fF4z3JSwa8OeyoAbiP7vDqEmK4iwl9r-2jUz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37_TbZvVuQNCMmO3zircEXH8pFq2a0KycEMkfpxdFO7Q&oe=69F8A253"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_el7dg7I6wQ7kNvwGJMD0U&_nc_oc=AdqtUKOHUz78tZIgIXpEm_AcxSSkBEtoZIJK3BdwCmskUWCXAE66nGdHck35PlBDxIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PZ7sNB69UsB8ZV7brOVgadMVVX2uPtSuvHEv0z3-Tyg&oe=69F8913B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrr6hSaVdyYQ7kNvwFyOBkp&_nc_oc=Adr9pLDUHMyFDkFhCs11ijmz0SYXhdhvEp3hawNrctd4xKovPNRm_dl_n9eAoum0sOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_EtEx7WO8f3-ONwPwLlKDfFlR2INRWPV9q3yQr1rm2A&oe=69F8B65E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3pXJRctGnwQ7kNvwHqVWC_&_nc_oc=AdoMvE8zSDCAx0MMbdUEXUwDeFUmA_wlP2mT-wbnYhvxO3wVF5D0k60WZHDt-sWMzh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Hexf6_AoFRAmMb5SGH2RbKdr00txIcqj-jH5-CYZVMQ&oe=69F8BACD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTPnG3fYJaUQ7kNvwFEhVQw&_nc_oc=AdquSt1PJs7C3q1ip6ALwQAfN4XmEDesyDgTyoFTfMrnt_Db8d8NhJ9hLm65AuAgc-0&_nc_zt=3&_nc_ht=scont
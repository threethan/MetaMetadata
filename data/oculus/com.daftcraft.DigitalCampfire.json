GUg&oe=69B01943"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIHbQG-pNPAQ7kNvwGVUxaa&_nc_oc=Adl2dl0VfvNS4i-gwFmAv0W_kYP5USGiwE2Sme8B7t7uOno40W58eAYgzpgxhtZfTDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjmxLlxxrQeEFAcC2FKm4jYpvXxwd0ikm_1rqpp0qEZA&oe=69AFFA44"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQW9QDSqtgQQ7kNvwGnopwZ&_nc_oc=Adk5cxEx96-dbvNX_S0tJNMiNwAFCD2NYnxelxmMFbrzYtnJzZf5d-s-6C_jp2SPI5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT1_m5225vyzgeVFOTs0266GcdMpCvdw6rXlBk2tduXA&oe=69AFFCC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uocFDgGKXtEQ7kNvwGUNCMV&_nc_oc=Adk7glcOl2fK651qk9PD82DmrnlPx9rYO4ZMaqC5LNTvzhtBgeKzqfs3yLE_PDYhsFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxrfcYV0bfoBdcSoTaQgCc4XW8UEyKUKMcGKfAy3bKaw&oe=69AFFB9E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUcxGDKKw4wQ7kNvwEjhw2x&_nc_oc=Adn_GsgqVo-_zI21hmE-jqteAI_yvlOX7J_tUGDEB2k9Kod5A5taJ-9z7HXc4n-ZmpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1REwxf-H9u7lL8YavldexkmrYUwewrs1hSmbMwrmRdQ&oe=69B0000D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LnbuxLEO04Q7kNvwHOb1_f&_nc_oc=AdmfSlEwEPsdj1JRqs07Vn78F_JTo13eQAvgPOKIQWv6tJzITDbkneGeT1hrusesqLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv6kakIbyqfVmdDpYoW7NX7C9-YM3omb7odNOYAV4SDA&oe=69B0156F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974857_1172877309855032_3159780346436681194_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDRFb9QhiOcQ7kNvwE6Kzeb&_
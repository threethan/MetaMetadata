365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbs8oh_r_bwQ7kNvwHXH6Tn&_nc_oc=AdpoLYRyrspU2RpWXLaN17QYqagJgFbop73FIUkggtZx0fgFvMx0BH7gKLuZw5cLI70&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0Ki1diwhc_3oQi_52A3gh9pd7jhmyZy0FjX9Gr9jufJg&oe=69F20443"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeclWn8AregQ7kNvwFQpWXx&_nc_oc=AdoLcD0PDyczDKzUM-bb5sFzJWxL08ZLvXI47P4akKeExIwg7dMzjW0RBljsYwgaMJk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af23Rx9vp_Hn4J7ruEkIId8Brn8t3sP67TJ8C58GshIalA&oe=69F20AD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02Ht7XVgCKYQ7kNvwH00V5G&_nc_oc=Adr4Lf2U6FFmz7jpj5arbP8x_Ga7VD6OUFWfPZi2G6djX68hpmt2MsH9YGQEaYe5YRA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gDKB7p8XU2Ck28obFA2utwaPexyh1kAoRRJZ6Pbkipg&oe=69F1F9BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYk2I7zQLEIQ7kNvwFTFL0O&_nc_oc=Adp5_nqmwhyGUf-wMsQ7umoEbXCh1Dtl2LtdOyWhKIsXS2wvNFQy78hXybYJW2Dw_o8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af02ECx7POVdGIg4gr7W8fqCxus_T9klHm6aR3i8v0cvvg&oe=69F1E69E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECrpqcybKsMQ7kNvwFk8nZ9&_nc_oc=AdqTWJCcTXOaEMCdd4WHKradHTpmn6-hhrXhXfRKQLlcaWHFNeiarC84JVscWHYp2F4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0wpW9oYgDgW7FkzpKnc693YtHam-GQTtPcmdtYtHSN5g&oe=69F1EB0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q5c5L1tfUcQ7kNvwEOaBZP&_nc_oc=AdocHXEfU0935J6Qjctrf8pU1I0IkloSqBGYaJ6Rs7sKaOiy-RoR4q1yQwqYPekzego&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0jkK1KX64D72mz33SNxAypvnBFnZOAB617eFYhausDFw&oe=69F2006F"}, {"file_name": "TemplateLandscape.png"
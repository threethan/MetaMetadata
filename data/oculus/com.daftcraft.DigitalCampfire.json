Jfw&oe=69B953C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU0y0gp8gicQ7kNvwEtNODN&_nc_oc=AdnrJvugdmI8c3jLZinV_xFX_Flq7JEBb0IODqjs576-w-4UO1M-uLuug8WHQXicN3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzytrSWIRKIWenhAmVJKL1Gu2OySNHLkd93HMFLELTUXA&oe=69B934C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nrLZjyv9uQQ7kNvwGj9UAY&_nc_oc=AdnTc5OzMLF5CMC_Vf523SiPXTxm515J6fGN1Ua5hEOZ31Sg-juTqKzeA_fUd8PtD5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0cyzWqXK2Bu4LF-Dy2tSx_m80SS8vB_luv5Q9LTVqMA&oe=69B93748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2hsHx8z8H0Q7kNvwEuA5U0&_nc_oc=AdnpOPWcGcuMeCRyPf9viyBdg3gBbMM5kJ0hFRg1OupxTk1bEyePaDGQmZxw67nAjj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdgM7h0gTs7ZMhAwEdllSM4CQf9DQQv7XozyWfFCG9oQ&oe=69B9361E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yBezi16eFUQ7kNvwEgkhf3&_nc_oc=AdlH7ORhSpncqMEZNPXTFh8UdDYbRUThk8OoPO-JSZFB8Pc3s7KnXhzA7RcnD-He1h0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNH5_V9QY4CmKIMinw6C6dkoVo4lM0A2gC6NczoxTrqg&oe=69B93A8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Prz8NFG038Q7kNvwEqWOeP&_nc_oc=AdlDpwYSf7nmPv6IcZmSUbpROsTOOOcmtMZpMrPfCbXnw9WS3JMMH5Jn8b452wIc1g0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvxNZwcGlJyaNykyn-o0NAPXqMNLOu3S-6fbPHfojmag&oe=69B94FEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_1172877309855032_3159780346436681194_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI6bZrwEnAwQ7kNvwGbqPo3&_
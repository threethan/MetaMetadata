i9PELtrxSWqNImHmjT2OmbcpwyIJ3em4XE1Gaxs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iznI1SpFarI_8kS5q0_fUDacO7JZYPijZI0lC9r48zA&oe=69D7A643"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGxKe61c8lMQ7kNvwF1ToAV&_nc_oc=Adreg8tgsqK9HL_rBvKdHs4VxJwBThr5XDNwwz9Lw-wx7qd-mWz_mf4sVHi8uzfA42o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ygubVC99LcbJkXdsBYpVgImvJ62nRK7xgHzlQXQTW5Q&oe=69D78744"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSVQnxEdPvQQ7kNvwG-hER7&_nc_oc=AdoyB6-YqTVEUzndLBEi67ci026HhPzorzBBVNKZlFU6LwkWyR4wEb78MnL62K3AzkE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ygdKeLuzGIe9EEBOec60x7Zw3BrHRKMR1ioZ108H9qQ&oe=69D789C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPfJ1w4YLf0Q7kNvwF_QExk&_nc_oc=AdqbFnjw0cJ6r2rD2YYrSZfXmfxEkKMKUoZ2JhUaRVoWLO9pNYwnFdpzmvWShaYH7rI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q5aarU38Cby0KJrctaANOvi4qze1BAd_tiU3UKtesHw&oe=69D7889E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-zGrESfeE4Q7kNvwE28dEf&_nc_oc=AdqIeniSGX62MV12o1YW1nMBxVA5h6nhv5yMTr6dEXKCpPKTPodwbCBZfl3uGio6l2U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02eUkSTfckydbUv2jdeH5iCDo1uo31_BYm3bffcHR5hw&oe=69D78D0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCht8ssjDaIQ7kNvwFTe86V&_nc_oc=AdqdlrwERHdXhsBGIrKnoamZC4qq5Zzbq4XZG2IYlLSc2INLXMpZtcaDlEuxs_ad93Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36l8JSW4guvQOoMFtR6Pl93qsdXLgrOc2yKDC6qjmgTA&oe=69D7A26F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
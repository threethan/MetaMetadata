-ew&oe=69AC24C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkveVmBSPcMQ7kNvwEAGno7&_nc_oc=AdlzZrywtWCsTMyuRK-etyAPDdb1HgXIF1LRNP0S9oXcf2zVcMaWbSLeu_Up0Vnu8Cg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnkU6MKdvcIl6nDQI7IC7SecXZ_Rqz00uFV9jtfMTd1A&oe=69AC05C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWh0suBWfaYQ7kNvwECRLwl&_nc_oc=AdnWi_nUPSaETQszorcRkDfAo7hQ9_BfiV12ejIocyead3XRZQCn4zkacBddYPuneaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFA8cwW6wR3T6hjATw_Pn3pF3VO46m9G2oF8qocNlURQ&oe=69AC0848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp1PL5dLUrgQ7kNvwGLK_G8&_nc_oc=AdmzWx3SAd7T21kdXaq2dXEUYbG6VThonrsyZCqYzxBu_2B9OPYlWxSstbOSCF9uJwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-4179jPG7e4hoT_u1Itr2uKiVx9TW7Isz2YMmdjSNsw&oe=69AC071E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYACI0nTtrUQ7kNvwE6K0Qa&_nc_oc=Adkifmv6zWya6kXHFEGelI4BR89VboNuoMxtnqqWOGUN_VWa6K9M8JdtpHufbO-zKfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzaIwxw1fM_JJ20hU53qhf5AvmbYyGZleWsXPjBryU0lQ&oe=69AC0B8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDPo4Y-z_4cQ7kNvwFK8bbo&_nc_oc=Adm2fCvDeuXZdFhGyjkWJnV9CuRfCww69yVam9pksaClvyinNyxe5MEcivjA4WbUUNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVNdhYcs6wkdugD5NANb3oDrZt3Vk9bmBbVb7qOqw_eg&oe=69AC20EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974857_1172877309855032_3159780346436681194_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqPFPTit-FgQ7kNvwEs9EaJ&_
NjuoK6rfb9hRRF6oMTu84u6Tqn8lG-IItWGlxMA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT10IJahtpog3A_1dgWPUg7iBuaUvrsw98ywFtizxozA&oe=6A9AC443"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk6VI851YFgQ7kNvwGp2-Ls&_nc_oc=AdpBHeLQT_efd3nA9ja7h4WKVuc-mxvdLpHe6u6PRZ3HpZD6bvKMF-8pKVFSjmOrD8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXaIhZfhJBZFG1UH_wgU31AqnDhi4js2cDQ5Ao1q51-Q&oe=6A9ADD84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NW6Bxwcy5wQ7kNvwE9YWTK&_nc_oc=Adqlv_FsgrGNKOKVE1wl84v4xX1_gdYmw1oQRiYLS5x3bEo3PEJ6VMZoUxWzu2gZT3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrZjphEKrON0sIvIFaSHciTvYQsXXQSu8ZL4_qi5uWjQ&oe=6A9AE008"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0cYlmJKxuwQ7kNvwHF7uZ9&_nc_oc=AdpTZIlgcOlBlhb4SlAjqyhjxprxkO2q2_P_rMhhxZtJ2Mpqf2xrt03uzLycfY5blFY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm1KEMAZ1mDLhanflxgKMZ-oCqrOY2cXT4Rl6V8LyUwQ&oe=6A9ADEDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B8jaUvUfHoQ7kNvwHC_PVx&_nc_oc=Ado27tvFV3D0MfbEruyfcQUqMgybraStpQlG_toCDFVqtDdZiJjoB9RVQuKMgEt7cBc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBDT7t82lHD9UzTQ9ISbdCU2G7HyjDTKpehGI5UgSGzw&oe=6A9AE34D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXJ7E0bLJqIQ7kNvwGZFMh2&_nc_oc=AdoqZYxHXTm-WjqJdtN-ARv0nSctPMXMKk2lzb9zObDaXIQFCZe1YQoJDlqZOyr0aA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCod6dBo1K9VgH8iOKpWRJ7awmMg1Fkxvo3Pyjs1KdJA&oe=6A9AC06F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
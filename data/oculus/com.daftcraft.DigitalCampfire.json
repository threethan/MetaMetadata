vWrUzqe31n435qHj0xbWLo8pib0ERQZv3UvsMgI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsY3QNycscoOKUBhNDmgQWmSpDZYAZS5dqiTbBwMCNgg&oe=6A660843"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyI-p9ZTzY0Q7kNvwGhqvRs&_nc_oc=Adp0I_CTozF8BNkyrWTABqnJsE13tIRbRA3tcmgP6atudmMYAVQ9ZijZDdcHelozMI4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlp9KxKY6bSuWvpH54d1-_S_w2akpK1IhDdjAVz5XjbQ&oe=6A662184"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OGL5dkIOZkQ7kNvwE8re35&_nc_oc=AdqTcPBoxTyVC4dcHb9yfeb1k5BZMMNzxOhi18kxNX4mcrRpGkjeaKpJ7xnzAQnrRTc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD16IwfyFNGK9tANv7q2HJuX3LxlxmC7Y3EDe4eIFVRqA&oe=6A662408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7l1w3KTpG4Q7kNvwEfNCQe&_nc_oc=Adr_i4wgXToP7gbe-cvira2Q9vKP1ngABnPRmerlOAYMWZIsH--gaCmev3W22Dbs9BU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh9R2G6rXqzV2WhsI4gBjabIgq1W_CW_rhm1F6IXxJ5Q&oe=6A6622DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m7D2-2ec54Q7kNvwGasREe&_nc_oc=AdpCFmZUbSMVjMRmtUNkk17hxocmXagcihobynKwSgMcGohE46Ha8k6OVqdT3-c0w4A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTQOnLGTZgxIxwPXlPP7Sj1GhfjzQx7Y3wg_xKgclj_w&oe=6A66274D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpvTDlxfeZ8Q7kNvwHOv56V&_nc_oc=AdqUvvbjCQW7t3QjATEdieGKKUcpr2zumcJvQ4eYMUQg78ktXGMVZ0MsBkqlQLHW0xk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqv5nLWjn4PrTW_pwYLJrjYXtCkQLfTUZc7TeBNd68zA&oe=6A66046F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
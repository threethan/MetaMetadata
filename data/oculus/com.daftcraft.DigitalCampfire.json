p-C4sgEuC9ydllSst4QlQSIG9YZ2GqOrTHbkaso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaFG7v6LADQG7UUD2PxZNqbFKPaqWozKJ-n2pOHQDQbw&oe=6A6759C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyI-p9ZTzY0Q7kNvwGgbpRQ&_nc_oc=AdpH-0pIexmI5QlNEBjDK8a1cNu8eS8g_ygarb5v7zTq0b_emHmfrseFvXXoYsz1gFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkH6YJB0zu9GkbJbFRTVEp1jMk5OxL-MH2p2d8kfgVUQ&oe=6A677304"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OGL5dkIOZkQ7kNvwFhPJoc&_nc_oc=AdonFuBjpTGCdNSMQdmv1K6LpPpRyr4kg5N6Dwk3sdILBGwIznZI5rVc5CspOyLl4go&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTAtltYi8j_d3vodFFz3feAnOmEz4JavbRfhhSK080Fg&oe=6A677588"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7l1w3KTpG4Q7kNvwHVzwOv&_nc_oc=AdpzmJZhiXKTJEdVPHsFppTum36wyo0qXfBkCUYWzKmW5-fqu3M6Py1BCE2ng95NLt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr2AsojzvDZtlkY3a-bA5yHTtMyH_q1Afana3iFcp-5Q&oe=6A67745E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgEs27TcV_MQ7kNvwH84nbR&_nc_oc=Adqggf34wMrsDSF-Fl_xgNGqwYQuD5KFoMX2x_DoxVg8lcmxE27Ygmj0ARuCwUIBr-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwhLpc40xykm1IuLW9gmvq3j7YVjwb0rm6uJAECZoeUA&oe=6A6778CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpvTDlxfeZ8Q7kNvwGwGeMw&_nc_oc=AdqC0ggfd41B2ldkP1aycXg-ubqn9oOQBHvHf44Ne2Ivm_NXNQ9T_tsvOSe52--VWes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVEI6ugnpy-n41vauzVxGTXPbjhqQAsj59fFcCP-YSdw&oe=6A6755EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
Zhirrp7vETL2obWwtEnEzAh1Xe1IXW6tZp55joY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40sTQqDytsBzkQWraOCfO9mUWjM4rVcrxAFyl_tA5qNw&oe=6A199143"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-zOW7PyDSYQ7kNvwH78lTy&_nc_oc=AdqeNcDnkW3xsuJDdUtKQP4oeqxhCzpfz4mNuJKN7Z0yPnLA--pmNH-4sW_v4ecS_-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fx5Chzo5p7nYQG26-yqZy7lI3dwSGM2ibOH6yQ6vo4g&oe=6A19AA84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE1X1yxgclUQ7kNvwH-mdOM&_nc_oc=AdofTIZBnBx03h2zos1Ay8jaMtmceitS3H3DSxX0EXfU95ysdwtHpQP5jKgY9kbJdCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A6GmvBePMiJC2m-aHweNQo7L7p8dOZ3dOZWLZOGnJ-A&oe=6A19AD08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSMIwu59x8cQ7kNvwGOoVBy&_nc_oc=Ado2-Z1z1fmTRnt5CL0fVOSfqXVo1K1jv36WfWpBjwPifoEbqM70rQpxx1ZCbsoDBeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WUrakvgEsnWrvatKuLquJ46SAkOjAdFEhFGPASQX_Tg&oe=6A19ABDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aspBEEerosQ7kNvwG7alCs&_nc_oc=Adqq_scCnDnC32lCbc9sRErwjmKfoKRA3J8hrwcw9pJzfVBoYk4y54B8oRSF0RpuCRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epmafPQ96qkDrSJUL1lq-74sgEhqoWsmYb1Pf0bhp2Q&oe=6A19B04D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsPIg4Lz10cQ7kNvwF57jYh&_nc_oc=AdpkVc4MYOy9HX7wW8_ekatw_40GvjP9HeCBbZRxhBn73EWrhOYv858qHyfjNq_Uflo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jtpwjFYknMQSRf2y9qZtD-FrNHsvYeja4qsk_CQoo4Q&oe=6A198D6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
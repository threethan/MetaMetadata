WPaO-uTijb4B7lNwG3KsSG4LKg4y2joThVYwaIg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYKIS5qJ4i0eAoGKOwIXkea491MbNqMCiDpnlxz23xlg&oe=6A81B7C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH-UjYs4Z50Q7kNvwH7MKtw&_nc_oc=Adrk8--v60J-YiaXqfq3Vv69OzM1uAGPKOnP2CQJK_gNM-9F_2OT8TfDqMNPORq-1b0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr9FNMvPuDZH9-Gbb6UODaYT9WlWUVhp7WLiEuSrw4VQ&oe=6A8198C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k10pCr7wiIMQ7kNvwHsYb-l&_nc_oc=AdoVLpVHtA9e8eSs9bcHiJc3yp4ReNgMhu5FuwvUXkbEo_ztfBpWsZEimirXZeq_Pu8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEekjW7o-538GnSI_mhN272VcXpHmqL248ze6U8-MfNrA&oe=6A819B48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apioGTIjzXUQ7kNvwFdUP1d&_nc_oc=AdqVaEjhtvRlAbDnnKttQzBC6dkxRCgvcTX6bfqofFUR8qID4jf6ge51cQKOrylYUNk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPMdwdjiOEFmdo69khKsiP8O_AUjxTN_rGf1qUc9nJnw&oe=6A819A1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVQ3VZBYEbcQ7kNvwHXFlUg&_nc_oc=AdqM6BVL559aFz7QUpMrs9845trU3lKkzOEaB2dXZ271fz1Dvt25PPANiT5Q1nNciJI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQgjWnQtq-BfOt42hBh9BVi3wJIuaFr_12hnScuVTl0Q&oe=6A819E8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT3dZdUfsRQQ7kNvwHvp2eE&_nc_oc=AdrtPuI6J_MdHBqpLS9zL8IkyxDpHoOJL987bhF2wAoeK0egNOa2WlNv-y1X_jLPdkQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH9L2qsYbohZVDaWxBPC-4Fc_M6mTdvf3q3aR9hGvltw&oe=6A81B3EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
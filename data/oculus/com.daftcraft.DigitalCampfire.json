8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c4AAx9grDAQ7kNvwFjGkRm&_nc_oc=AdpZwxBpVi434rJB3eEbtLRHaLE-XNWR4mtPoQSPEzi57U_YHTyN1Lbz2lmtlx9uZ2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJr-BYCDrV2cbYPPhD20BaApMORpcNFf5Z4nd3lV2nBg&oe=6AF5F403"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ammGGhmEn0cQ7kNvwEiVu6p&_nc_oc=AdoG_6c_NxR4tUrAIIL2CmZzeo4OdqWR12pe21Wp4i3nn4CrIrfLT-qKGhqrd7KBRq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyMU8Aht0yMA5GOs6K_Njni2bFZHL9YnLIJ6OSfmCmdA&oe=6AF5C253"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfUZvV4O31wQ7kNvwGtVDIT&_nc_oc=AdoDs7zFgNVgSgptztu_qf4A9iNbrPB-UOjnbUiY1oDNHm4bgNz_69McJZ0eK1hv3pI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwcMMTer9BuxcqxL4xxzTD4DCE7iVlXTxy8LBR35GULA&oe=6AF5E97B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IYSQ-ctllgQ7kNvwGzk6kP&_nc_oc=Adorct1eGTxztdBKv5pHqYqzgCEiI8SGMpq3xkk98A6XGcFX6NrGi7ozj22XNw11nns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaSVxEKdRAVVw-gZrNwwO0mstMC-7tLfNS6zSGLERGdg&oe=6AF5D65E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2D0RVHVMhIQ7kNvwH7JoPd&_nc_oc=AdoHj3KgnZVkHGW1DyzjhCgNMOjXo6HGhOfHNvKO3ilr_Voyxzpv9KU7SbMMlgcFvhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWKbOrMKllDcMMufAd-K005c8Ly01OBzYnCaIPZwhU0Q&oe=6AF5DACD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbvbH2PZbDYQ7kNvwGYkJ3S&_nc_oc=AdptW7GzV2BJ9CcH0TDY-fuRLW6J1EPil_w13AdCph71mBk6-mqXsJRaDciq0-dckAo&_nc_zt=3&_nc_ht=scont
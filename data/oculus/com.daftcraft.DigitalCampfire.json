Fvw&oe=69BFEB43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8Pcx5TRCcsQ7kNvwGWnu5B&_nc_oc=AdmisYOGLMOY1J_zFj81mJxoKOop3WSOMAq6HmuxGiogwonJqnDBm5793gAZdph_uRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfykpbOhqx2AoJhJx20s2SP6OYqzMz77fXYSiO_Ax2npVw&oe=69BFCC44"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5U3br77wY4Q7kNvwFdYWQp&_nc_oc=Adm7Qge4oT4JabHkeFN-2BHxRaBMwZxvfw_CjN0LmvWZRehRa860WJLLpfuaduUSXt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXr0kSYFueAJHiN3NimMtvgEw2FMj8HNOrR-zZria9-w&oe=69BFCEC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Cp43qk5NjYQ7kNvwGIPm7x&_nc_oc=Adl7-COHTxHPEBgySRPXvR3GOjZlKyzqRPg-TrtG0UoTi50KZLvNNIuDxUTgO4hhtbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSoqWMoik-jzACidRQ0BCw1PTSHh3RZ9SimdGbapqnTA&oe=69BFCD9E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eVFrKBYEDYQ7kNvwECJ8Ao&_nc_oc=AdnM-4yPG-GFuTzLVOx6K6wbDeWIeRJIxPiC3nqSZ9Q0ZHsQrlpH9BUFRzOcppNNqkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwb8XLMj_F1UUtXjsI-Xm65zrRwr6GkEq1SfuN5enjxng&oe=69BFD20D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PE_Vv0zKBMQ7kNvwE39ovk&_nc_oc=AdmApAyrwA1Hu23gjI1Vz5RpBggrwTStBi7zWKitvwNhBy6Dm5VVFxhLIGeAEBhDgTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymOjG31hY6vJRZUyAxl0a0UtqFmWtQChAaaDrPQWEskg&oe=69BFE76F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974857_1172877309855032_3159780346436681194_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kVNPZ7j2_IQ7kNvwGc1kt1&_
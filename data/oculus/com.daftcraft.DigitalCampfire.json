8618161382", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxlGPUHwYGYQ7kNvwGcDxAA&_nc_oc=AdqMCEKFCV5IxCuii9FeY4kJGvfGzcp05swlGxMd0ZVodnYFlfHsnHIXZH9dr97PKXw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hSQka9OWKSUy8M-6g69h-MbfSH11GvdlZvi5iI_c_rw&oe=6A241D43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0x4zWDwcp0Q7kNvwHhdjj8&_nc_oc=AdrMlS8ViHY156CW5W19LfrxEG05M2W-ouXIy4WyhRGKZrl1Q1lkkGRMXCM2BItys8Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N9jrInrXc0_hiYV8VbHwmbnP1ffxJCw5um2DUkjISrg&oe=6A2423D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta85_niaan0Q7kNvwHEPUfk&_nc_oc=AdqeAbnvF1cAxX9TF23lDj38OyVxlC7GGPmpms52wpRQus_cdOrftDCy_yPxfBLJGFI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p5949rY-88fsdaQzzacVqIajb3Aby6y_7wyAn2JD97A&oe=6A2412BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_XmAvAofoYQ7kNvwFCRGXY&_nc_oc=AdrJA2IIheyScu7esnsDtmZDdls_jdYez_0HRfuF74ypisofz6idXGMIXHT8n9Qd834&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gRnULh65GzlAPMxozmrosQwmk4p2YWM1kgTnZ4mBJZQ&oe=6A2437DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8htDOtY89ecQ7kNvwF8aNtq&_nc_oc=Adr8aet7-VWO-E_fNmjxxj8VzSu-GAppM0wj70tBxlazTPxRiAOmZrT6oH2iIBO0fZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WeA4gYUKmaGUQ0jeoCvYYJpCSP181VL2MuRUbQ1PyRQ&oe=6A243C4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhkyayvrhXcQ7kNvwFQ0LxO&_nc_oc=Ados8QVGNtljDqiwvSWIjXFC-xGiMOa1Adr0mPzd8Zx-TFZLmYDDkZaSGeL9sviMBuI&_nc_zt=3&_nc_ht=scont
ywRmaZNNhWa5vKubIaVoBo5FFfe2oyUjdJRimvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcWwnDKwJH1qqoFBPy4Hnhma2-BLbJF539WTQY5iqf_A&oe=6A845AC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH-UjYs4Z50Q7kNvwFAcjc2&_nc_oc=AdrQv2oEvx3mAhKalNqjvtLxWV5O5bzkw9t9HM58Rw2ptHWZIegdGpui6SO_74F2btU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPatfEfkk4HeAym2eIGmurbsWyezRKS2hYB3QKMc9qfA&oe=6A843BC4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k10pCr7wiIMQ7kNvwEhDNpr&_nc_oc=AdpgibW0tGW_9kT06afK5eNT70n8Oq7Y6OU1fnUQYHLEObTiQOeBRJ7uYYi0wsrgcOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPbhObjDP7bgQHTA4pQcUgIwxXGl14Vyc4-uUt-bXrxA&oe=6A843E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeYJkzyNl-YQ7kNvwHOaT8n&_nc_oc=AdpBCh7Ekq0_ivz7Ncqjg8b-wUC8PBBv70YrWEHU1y6NetjqwBw3FjiVXdYQKIWDcQg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_gn5WCo-c9OSPa_RF0rmXwY9iDGWAL22ejXntcW6LAg&oe=6A843D1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOreKJ1zywEQ7kNvwG_7f1a&_nc_oc=AdoJRLcvcIAqyP7IYJub3bonZMn_f89e-Uybc8GgXJDkDC_Bwj5kH6qjD3dedCc3ONU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8VPyd11sES_44pLKxN9rPh_LPv9z7Rhxanu-jdgQ9JA&oe=6A84418D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT3dZdUfsRQQ7kNvwEy0viH&_nc_oc=AdpzPjaQ8DSVb3GFEmbxENA37FiVDOEcUzPHHLHHCkI3x7rh8yz8njbvgy2RAj6utDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEXqXEGpLhf8VT05xPnTQ9eDYJJrTdDx6rPYBjRgjrIw&oe=6A8456EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
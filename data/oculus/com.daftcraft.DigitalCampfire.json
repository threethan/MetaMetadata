8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEeuy16vSsgQ7kNvwGV0UKz&_nc_oc=Adqw6k9LndO8f5QjwafmIBxsrAgkrjDG4V-3y1DyR-vOQ40T2dmnMStk16GcbCxnuew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvLmf3UxWnjWgErlKntZwBidJi7JaKXjq2lZy18ea8Yw&oe=6A79CEC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiSb5XaJgzMQ7kNvwFz9-B_&_nc_oc=Adpp5ROSap8IlfKXZ5UdHQ-zWqh3TkrufW3DgwWGFta_vnO90su79hnlz-Ej7FkvPH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqMSJHe8fp5zbqNfI3nlgnKGgoxe6iv-oIiLxQTRk0Xg&oe=6A79D553"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lA5rM724kQ7kNvwEaHeji&_nc_oc=AdoHqNI594WM_pQptvZcPNEeEJ5FPCS_Y2FczGDsfXFoKxZpXxmQHEriyWEftdgtO6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2nJwbhSHXznDvvP2xeZZo7eXwtlX_gKQvT5po3axv3Q&oe=6A79C43B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltb-q94r_3cQ7kNvwGzzLVr&_nc_oc=Adpf4yO8xpwXMRjssvY-aII-AkvdDz7NovLGvGXe73OOA97FOaapDDGzWuyImEk__48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIwX51tiU1WlIvOhgYtFTsLukaqxSsqvv79NKmg1MOdw&oe=6A79B11E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mglGXrp7CM8Q7kNvwEHf20d&_nc_oc=AdpqdA9s9igFSdTH8Hw8vu7M8eDfUH95KD0YMZprsYVWtqesxwQaMQqhXbIpDdyd8UY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUFp__SgdT2vxJdDoeTLrm11OroLttxjOfoOmVmrOHug&oe=6A79B58D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkuygYEmS6wQ7kNvwET9daN&_nc_oc=AdoZpN2kzvwsGKTPAHLZW26HI-U_8QUhB3KWm9a7SNeAS59lIbfqMyC2gfFQyL0NxD8&_nc_zt=3&_nc_ht=scont
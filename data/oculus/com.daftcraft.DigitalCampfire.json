lGJRa6ASOTqyPjecIWZg3Tam2vLXl5RQgZR31YE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgW1IJ2rx0UUG_Ia45y8OPpJTf_4-3ps8MhCMah9dXJQ&oe=6AE5E9C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFkv0r-BC8kQ7kNvwETZYH1&_nc_oc=AdoitzdWMX5idp4FLeW2EakqTFVEXiMWmDVjKhjNsuJ-gkL4KntuXVEYV2TlSei3nDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnSq2yNkXjgLUIQokOxTPKqAKLAPuq5BvkMusMT_AIvg&oe=6AE60304"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqBfZO_aaNsQ7kNvwEM4xt4&_nc_oc=Adp-5rBYRtH1p7Qx__lZvw-ZSYLelsaPmKqQ29dALfVpx9ICkV45Bly3SQkbREagxw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhNZHt6oFTKWRitFMZomQD3GPaEfo2-AnkckfRG1o38A&oe=6AE60588"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKGW2FoHIjgQ7kNvwFsi3O8&_nc_oc=AdqggT8gal2L_TSi7xZ_K0XwyI4cbMrhoA2k3YqqJ6UwCcGp8C7fod8lN2hptGRU_0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn5kvlz_g7H2R6YDnCZnAruzQK2PXVXhoBUABPF9MpGg&oe=6AE6045E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVKjkZYZhTsQ7kNvwGVQWd1&_nc_oc=AdoMJyv83cLE_58IpVM0_Oe3n9lSUnSEeyLAPYPlXWuNPCCW1c2Hbk-NHjdKrtE_a3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2O08h92JlPoCOSSth67tncYz4AAhJK8vO5Ec8PTN48A&oe=6AE608CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxOB83MpYJkQ7kNvwEb7_gy&_nc_oc=AdozLgzJCzGboLjJb16cBOjSO4R_zjCx_she7GwM99TcqIxE20bPBR1xVrGGzjDULqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6Kf8ogcBWrI_fu9ROkSMCpR0TK46HjyqEmvuPqaUv4w&oe=6AE5E5EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
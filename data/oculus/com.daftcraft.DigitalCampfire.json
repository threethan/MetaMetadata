8618161382", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdWMCO9A03MQ7kNvwGfNHNQ&_nc_oc=Adqc2--lz7iBOyJqfxabFGoBwpSqyg4bsdE8WAhW4JPmPV-NDM7TIDAy1okcQvijjls&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65cAkA3cnb4d4lriSvjLsqOWk-ct85mZcObmd5pb3O3g&oe=6A09BF43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE_2ljfiHLoQ7kNvwEW2xoD&_nc_oc=AdpNrLGL0A6Mjy4qmQwgo6gtcWQIcVVhXHWeJERTYDVjmW1H9v3eaB-42jdB9eIAKTU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J-JtUqaa0WcuEgc81vwxVJvA68Kfo66f0Y3nV-tSGSw&oe=6A09C5D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5wbA9lAXScQ7kNvwESiQ0z&_nc_oc=AdoEnw80r_YKWMR80wEDFXmABn2eXuE3UhSQDr3dQ92JXJPo413rXJJvXEUCAikS9tY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TlQ2Ifv6ZpFZTK1-q-Fab7ek8K0BGTpqqevgQfWBp1w&oe=6A09B4BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2tHMTqAmSYQ7kNvwHykVzK&_nc_oc=AdoC6F11NCOtsPD0XH7ys4aW3iXwHjtdRss9XyYjxMFEt8SWWDIQjiVSmvargdqHZYs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R29pU0YL_D3iJFK46Zs-YxQH44Pm_9eCzy-4W9_fSQw&oe=6A09D9DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pdPFyyGuH0Q7kNvwFFSgpg&_nc_oc=AdqrBOYnoBaDc7xMGp_M5NDgl7qUqSkEzJdug052Xz__dgJ_YkkM_LjAWvo1mbQjrGQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pt96ZPRFLql7M5478CuxVR9YK-hO7ZSV3r4Mr-6f55g&oe=6A09DE4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBw83W-1RAMQ7kNvwFQ0YFx&_nc_oc=AdpUTslv7mtc5NgpZaN0wnw0aNmc4nfvSbgQ9EytONfCbyL9Jne3OpsHTkzFL3ofbts&_nc_zt=3&_nc_ht=scont
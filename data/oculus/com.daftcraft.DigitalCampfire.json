AzMEXav6Zpf4iu5HM3pNchxwzakBxp8CeXFCIMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nt2x4hcMcvgkfb6422UIOjzrtU0aDmC9RDtOBUH9lJg&oe=69FB3EC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrLoJ97aBZoQ7kNvwHKOB83&_nc_oc=AdpCRnfAhy3IFfN709so6l7YrisCtU9mF77-7cDjuXFjZzY_A4izoBindNxmsyRT-AI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5djNVIEtL031k6D-QiS5GgD8AD2gjBG5ZVFulNqg4Jog&oe=69FB5804"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppg70EYZaicQ7kNvwEkz_VD&_nc_oc=Ado27AqzLPAcWHk7MthgRZs1aDBBy-ZGkp_Gs3Lv7olqu36bZ8fNAQTHmDPGIkLqoCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BeG8Min-fU8KlHFimRmVK4lLMjxeyps8ZB97QnBNa3Q&oe=69FB5A88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roOYYyMpaVUQ7kNvwE44gfO&_nc_oc=AdpfMi2M3tNreiiD7v-5Fs7p7WvVxzw4Y17iyO2smtDguUUA2pp3SQfzpof7l9R3yng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WUnwBERI7NI4CbBKngyeuyj5ok1j6EYDf05_mTJQX5Q&oe=69FB595E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3pXJRctGnwQ7kNvwEYqdr9&_nc_oc=AdpiT-z9xtPAXYOSkUuIuYdDAAb9FEd2dqQOzvNKHTNYUNgaEfl_YR8asnZRhSZvOYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Nxy2Pm3rlxKxvtaGZzS3H-8xcaFmh10xIbRGqk0iMXA&oe=69FB5DCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNRJBZksDyQQ7kNvwEY7FRA&_nc_oc=AdrDJ5OQFYJcOptNh5U2hX6jyMrxNafnP_s670A5YQoNwSJSkjcMKFCKJ0ttv1qIe7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qp0xoq38P5zwkOno3bHm0Ymk9Ry2mse1aWSho83vWqQ&oe=69FB3AEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
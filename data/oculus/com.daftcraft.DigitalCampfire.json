_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPmusNy6ZgIQ7kNvwFazdGx&_nc_oc=AdnLjf3sVYjmIpijEI-JaanmXOKCtfC8OxlIlkpg1SSK1Xk3Fh_F5DmuShWbyw6AKcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuIYN6XlKEhCXkDM8IaHD1KGkZo0y4nuGsFJlOIbnLRwQ&oe=699EF5C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmjtnEkkos4Q7kNvwHo3Rm3&_nc_oc=AdnYkFeHucrKEHMdvnWLis47gK-pKb5ROK-KAFtzZ77emDkkGcxk1fuT6Dl9nYYDu4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsg4Oe3JkSv0InddquNpOyXcu4qIqxfd5Qg9BDVOj-R3w&oe=699EFC53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkHH5W_k80IQ7kNvwHlPhBT&_nc_oc=AdlLgJpCuXG7Oz9S3FVMRNVBkw3G_s2IfeophX5XQnnZl60l2V4CxHqQYEfch7NwxEY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsKY53yrD9NIKUgL5Xis1KJaDTZI13JEQNTvjKUwF7E8g&oe=699EEB3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI0ogU4XIc0Q7kNvwEU9xfA&_nc_oc=AdmPOaWfCcy5UYp3qzM9H0UtRktzup5aVnQJFtdqOWLe8YS_BUyivyqP_0fwEl6Qyrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuR3bdcYH94nvADm-6wqKIrCTdZcUtav6RmclFdcSyGFQ&oe=699ED81E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzUBSPpBG_YQ7kNvwHnliQ-&_nc_oc=AdlAxkhtDLceIbnjGItpbgg7iVKHzkB7TXbDVPq-xpxgAXKt1GcgItV2iTQAOlBDCwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvzbiO-gaWwVCiqh3FY7PQMt98VTKX-lcPi7P2LkKuM4w&oe=699EDC8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBY_LtCojegQ7kNvwGwRynj&_nc_oc=Adk1xP7ykcajOe4rwuxXJJobQ96_F5mxXHDHprlnPg2j33gmF1_f3-vSlU-zBSBAXuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvz2aChEXoeLW84WyUem4gRsEbAFIz7lLQo-ZZ5_YJuJQ&oe=699EF1EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
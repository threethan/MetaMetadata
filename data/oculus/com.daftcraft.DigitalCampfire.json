k4dUtBk2aoKF4J5BHo9I82h2AcqDExUaacE1dZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H7nAjXEvqIWac0-x63vLI5m3l0yUSnXdnUvv4s7nBbA&oe=6A1ED743"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvqnSQFpuBIQ7kNvwEQN8CB&_nc_oc=AdrYDXTqvII16X8WkT_pnrz2r4JzXsGL7ymK8EmlbNGujEHTYalPXi4kvs521qqesOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w-wnm6h9DE_nKdQorUZXJjoNBq45lKTnuBnXBpLWWHA&oe=6A1EF084"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q21VzpivbaYQ7kNvwEc2VvE&_nc_oc=Adpzk8KG1E0x7vywfPUFeRlwMbQXpkX9wLvA8ckxyHhPJXJ5GZNN_t4tJD3_U8f7vaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u272Cu0VxMIjbd4hg_LU4KCP53GL74-3-QzWrA4TwoQ&oe=6A1EF308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdXIHSUsNEQQ7kNvwGtjODT&_nc_oc=AdojG7i1SCglTZKJ5atoBaU4CrlZmuWXmeAPOJg4V99k4LWmtp-uu0okPtKAeQbZyJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jql92UQLYzKBQIuHmyDUv4RISd6yoFHVBfxAg1y83Fg&oe=6A1EF1DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk0feB9J8yYQ7kNvwEAtfPI&_nc_oc=AdoY5mYZYiSgnDgasvqEMwl5MJd34FgQp4pQx0elk5KVOecWGjWgE8X-htHVzTbvUw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-C44wNqMQCJz2cLikzB0qi6vh4iCm09V7DCzF9U2csQ&oe=6A1EF64D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf9lvqjWk6EQ7kNvwHJDFne&_nc_oc=AdoSfMp27PMklPZAIntkCSbhpQPX4qqdG4i0RjDQcataZYZSAjwDtMkppNxJBX0sJ_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af477kUlD1TlDd-MMPBc3B6qrrsBhYqc3JfZ-WYThMNGRw&oe=6A1ED36F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
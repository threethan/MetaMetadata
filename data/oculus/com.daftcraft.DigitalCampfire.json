0MQJvi1L8XCM9zKp5qsOofUGX9mknCQRWJAQyoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3eCqQ9xM3_EjJo3MLo4KQorTfCy4UHpSgq8kJFQwTZQ&oe=6A5787C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkECn-os-a0Q7kNvwH_IZbZ&_nc_oc=Adobq0N_wu2eB0GAooWlekmDvTRySpLbpEN_G7VAVtl8-YjRujtU9kOJpLtZPmkm1tk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2ztAxHHAVP66s-lRvqvCbhPvFvMarFFzqeq_ssFmXcw&oe=6A57A104"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJDh0xNOh4gQ7kNvwGd4Syd&_nc_oc=Adq7FP6JPbbdWyyQGq4B-f7aKLdquaF3GQEgk4mSlOtXNzh9d1nK5bMSrkmEB9PMOE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5cml_ewWz29oYwFItfNDk_9V76H6ddJf4Gdp4HWgxEQ&oe=6A576B48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klRMe3CJNCUQ7kNvwGoEn0b&_nc_oc=AdqXgJGhpdXO3Y2khT3bnGW0Ar80xnrjie-7GewKOxi_n01dvx1NbHTneC8v6nQLVE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASbQifsun6LXlf-VKs9LFgNngz4uKkaREnQn7FtQlNrA&oe=6A576A1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S83UCLQtGdsQ7kNvwEjbPIT&_nc_oc=AdpWdzYDQ94iTITTz95huG7gWkiob3ua2LVmT5nNrKrwvpOqflSRUqW4Bw4dCdhty_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIFtjcC0JDkyzzqctWCm2MlMW8iZtZVGLSddp2IAHC2Q&oe=6A576E8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8azjjBYZhbIQ7kNvwELGEdu&_nc_oc=AdpBqCsxPF_L6XnxMwk_Kc__jOqZFMkWuuwtYivSHA5_1XAB744RIL18tRPpczUmYMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtzq1_qGXpSya9aqUiiXidLMv_rZDU5TWZoTnZKyb1dg&oe=6A5783EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FZp-uc7t4MQ7kNvwH9lzsN&_nc_oc=Adm-XD6bFleFo4Sn4R709C1kMzgeEfoTAOZvfcjl72ew7u3nNCN5SDBVHtglyksuVFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftA18-jspbzoGoSBRlWqDUkRpGivRuB89GBtNbPaZbHxw&oe=69A2EA43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74i6ousHRcwQ7kNvwEIVlms&_nc_oc=Admsw1Kpn5Q5k1Giv7Il6ywimsl_SQsM68BJ54r9zTJCVcWGQ9JyQf_kV5vfD12Ha8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwbiYluTqcMqUTrXtkzxzl1evlSXENCuKNhsffp2m2kg&oe=69A2F0D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucdOmIpH8ucQ7kNvwFb9NOg&_nc_oc=AdknOXMYPEVa8luBOXaSt6MW1BJPRmCVwAVIBxWs6HEIw7frQ24IV1nOjWnHjN3T3ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm9zMifgr6IDZBF1aeJX2Dwou_YNdoD64Vzda50RtmGg&oe=69A2DFBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shAsABQJB8IQ7kNvwHs5nXJ&_nc_oc=AdmJsJJx6Ql_UHHlGyVFLUF8NvbsWEH9JyWXVibVLG3vDslIT7VB1Bhh1tE0ZcY0ZZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfviK5hT_6jj9nyfDEFI6GGS9_tw6e1rol9CWPUaVpVmXg&oe=69A2CC9E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-oa7hSCRZsQ7kNvwEl8q6K&_nc_oc=Adnwm3Y5Or1hD6gvN53JuuhTJfbI5oUQkWTPJACZMbDBGUs9oEyLwjRtMslsna5hraY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsToXxHCavc5TpdkwFwe7Qj_wl9tGKEyo1qqMgoMhDnWA&oe=69A2D10D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEO1yqgLeRUQ7kNvwG0sF3V&_nc_oc=AdlQv0VuSwl0Ttz26Y6ki9bcTkdxKHwizpxsmKIfi8wsp3xAc6D3_wJRYwtcuQ_oMFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuOjGdRIHDnu2tgZ3uE2Ajh6CfUXX93RO16SU1DfTwUg&oe=69A2E66F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
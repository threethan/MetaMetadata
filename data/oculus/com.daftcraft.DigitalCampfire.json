t-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-6NJo-Ydd4Q7kNvwHXTanz&_nc_oc=AdqbqYO2l1rwJz4JLZNvK7tKERF7jFeGP_HCKhutWyGBWAcxGXAZ2eyWCLEDiWHCGWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-nhPI_vKIAPWvX6xzh0ZtySZVOej2ZFRtfKWR_SCWnQ&oe=69C13CC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9Q0mFryLIIQ7kNvwGyOTSf&_nc_oc=AdqCDeOyI0Mps3eDjtrV1fCfHIiUA26hXO-DA_iOB8JHxyUXyZ6q_3XwhpM3cBxfXBc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTqNIcsNuLitCtaiwOUtGXMx2u4f9ESH-yqakc29qyFw&oe=69C14353"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1eowhZlc5cQ7kNvwH70jjQ&_nc_oc=AdozHZZzm-l_8Q4WTPD5JosBU6EVJHr01lZFiaVMNes-QAC7zQRRaDACf3PN5JwzLYw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMpE1G4bKZrAXtDvJmC5HebBpMpAcaEaWoV1ue7LhxLQ&oe=69C1323B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Cp43qk5NjYQ7kNvwEJo7di&_nc_oc=AdrPkhZFh9oCwrsXtITYBERPmSEl-AB-1CxtjXlvs06C0vcg3sV7KuG3N3N34uDJlTg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCnDXhSdvhF2iVhYsZVdw3Nc4_YBzEzFCPQkIQkhPkHQ&oe=69C11F1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MU8qQ0ObehwQ7kNvwGW2xcr&_nc_oc=Adp8LRCkNV4HiUokhpYYrzHaOXBsT969dzzwYZpGZ-62p3LFAzIYIhSrSMrdeGxYENc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyI40tluW01s9dOU_e87_IaiOC6UnTAWs4tUex6Idn4XA&oe=69C1238D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PE_Vv0zKBMQ7kNvwG7LMlD&_nc_oc=AdpIKYKpk31AnuyZU-sufc01rr87hKAeDcLJvhUQpiZBErlh-MhymWKvweVjEtMjSnc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvnxmRwJR1v2kD
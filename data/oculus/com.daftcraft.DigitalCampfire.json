8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnyLjRHwzRQQ7kNvwG42BpC&_nc_oc=AdqsUJKygdYr-BjySHu-T03NjEPQDVLwOmbp8ZOeGJB7TVFvCxOQOSGDLTN__S-V4Ms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhHXTHMIigZVNjQiyg0YVf5hkqOef25e8sGGKPCi5syw&oe=6A733743"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWTA1YQBedwQ7kNvwF07vk9&_nc_oc=AdqAMuiXra8ecFcZc9Cg0HXa0WWgEmDdklNRvZ1VZqFonCBKuaKbAo_bX3Q6lrq-RC4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzcJHa__geaL6ZEzB4VIQK_OcfH6sSL5IBlZubqCOT4w&oe=6A733DD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaGfaT9V5zYQ7kNvwFsqDVl&_nc_oc=AdrrZFDZjohcTEv9S3Gln0-MlSpLWfVv0iGCjF9G4F5vQ0UUeBrMzobg7sdWYFPuT5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOMXm4ucZD2fTGgUKwaYIrT5exjyMBpLKn1vBeWnxXpw&oe=6A732CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVQLk8-lUrwQ7kNvwE1XXcc&_nc_oc=AdrLg5EPLVPDcX3JmEFtj8u3T-HDwLn47BQ3VovJwSBnWkAWvqiNtmDWKsBxLwnGe70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv-SGiX9gypMDbuJUXiCv7iic96FRcHBTZ9Av2c_bGTQ&oe=6A7351DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Z4-ub8yuQQ7kNvwFpETHy&_nc_oc=Adp1Qy1bH5LgFAwFp0U4uDwmtZKjaDZUDIyxXjI9q9isvQAfS8vm3PiwC89DkQlu4ew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIH-jM-e3KrxarBfgkH4x--muXgNepTNIBZLLZsw9tXg&oe=6A73564D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foz8HjasM6EQ7kNvwHt-d_q&_nc_oc=Adq0F3KAfpxnwRik4cWwmkENsdRVk3iGt0C2_P4oz9YQLoVxTwUM-w9xM5Nll9qM9-E&_nc_zt=3&_nc_ht=scont
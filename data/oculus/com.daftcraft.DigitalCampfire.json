wEEAv3P&_nc_oc=AdqjspvsrjPXrPIaLNXq_OTbqnFC8tfT8YE-xuamaEIT6h8yd-78ZhF3s12NZrAc_us&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETJji_fDNbJNBGPS2OKHH2rxkcx-xCi0niFPDyESxV6g&oe=6A8EE6C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEFgiMuh-cQ7kNvwGdcBwG&_nc_oc=AdqwrihQFL02_B4hhnkxidJlrUBwJafBgCoCZVFgNuVdQzLay8z9jKejiWSCOlvYgzk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkG4auFCxRdkfDAKG2uko6Y2_TpyhspDgFkBcfSdAomA&oe=6A8EC7C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3G_DBQ8KjsQ7kNvwGo307A&_nc_oc=AdqkzdeShYVTVOOiZGueHgdc-Zt1Hk7Ckunu3olyzPbwRDoeGRbfby8vlvlxKZb7eA4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ8iRpBlhSxu-pZL-RRi9Vz6TBwJbI75hzKHXakhyszg&oe=6A8ECA48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGjMdEFE3MwQ7kNvwGQXZ_G&_nc_oc=AdpByv-1F9Q4dfE_ZhtjSw7OumjOmT53Gk_PPf6V-wzgf-WFznMTp00ZXy437lgwWwc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF90unA4wsstaUaI9ZAGGeWOOYKqTkiO6tu4gup9VEY2g&oe=6A8EC91E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfKxrB_UAN4Q7kNvwHs9Awl&_nc_oc=AdrpbtMBCnsrd9yq9m4ikiMXq_bRHVQ6HC3RB3Nq3G-mYCMXcbU3Vm796fe8nnQ_ltY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBIgyVg4owKlA3gZ3c1FMVO-glrI6nw6tS_JOXjJymdw&oe=6A8ECD8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4cbcnN16n8Q7kNvwFIKAri&_nc_oc=AdrBPPr3zymV-7oxKVr35n298jiIW0Lvde68xizE-vBcA_6HCXfpQLpVXW2WqpLySUE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2bJJEM7FnkaiHG5780rMnoGPdnWARxnSzD5IuhXCZqA&oe=6A8EE2EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_
8618161382", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJpOzRmUuJoQ7kNvwHiBvL2&_nc_oc=Adrhsx99krZc-LapI5eUi6uRYKzI5plVsr64wJM53Blm8ceUvoPG5pGK8ZxecTnupnQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdljwzaCpWIipVUbsWdT054J8BBb94pmsS0n7Tjc6SRQ&oe=6A8AF243"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoNNgbNYfxYQ7kNvwElhwaS&_nc_oc=Adp4-Ao7t0Ope1FUbdMsCmEjI5pFHh6GFQpyOj72Zcn7OJsJMx5EyuqC0MiVRXfWeU8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc_3vAhuSIKOV87DueyNtVdjdNEEKf3xAgJhTprdkD4w&oe=6A8AC093"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMwwvqIX0lEQ7kNvwGrXUmR&_nc_oc=AdplXIH7AX5VYOkS-rUrW6MURj93-eEAU__k6XVRktf9RBUG9TzIrKRyAEmZFXQfkXM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-Yd0PLkuQQfGW6A2i0MZZdKp1iwecdrzrFZl6hzCqHw&oe=6A8AE7BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ-lZfVzDLMQ7kNvwEKfaYj&_nc_oc=Ado6nxgzQ1ZKp-OWfwZ5wTFH34YRGDLdaNvdD_PDYcWn-4o7aznZVO1BTuXqkQaiieo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9vBHb66warLMjq9xzKNRW0x06IDmrcQ1VWKLLAeJs1g&oe=6A8AD49E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go0tAT5C8JcQ7kNvwFEB-TU&_nc_oc=AdobaodhGchekaZzD3yg33OVV9H5ZJcR92IDg-IpuRorW1uPrIXygOskmMQV2Rs6UzI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvrlIf9XdCgzjzGdV3cV1ZuojhNS0zS72QYeD6BwkG9g&oe=6A8AD90D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlkXnYxRtcsQ7kNvwFjBZQr&_nc_oc=AdoiX6li1OfQR3sDXjPfNtwSemm9JpZ769BHtJUqIiBO906YIeb21Uor-3vKl2e2hU0&_nc_zt=3&_nc_ht=scont
8618161382", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5Fpg_WXg1wQ7kNvwG5aP99&_nc_oc=AdpqZs2QZe28IdsaJMAJt1wrPTQDudhOvCVNq3Cfrl9LjqNXiGUz3N9II3dR9B9QgeY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LGmPQi7dWUyWqOhFM9Xxk7EEQtTy9UsIfRp0kaK5ROA&oe=6A1056C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w87ZSLFMI9wQ7kNvwHDS3Vd&_nc_oc=AdoKa3snUdr3CCAIR1gJ8I2iIPbHhVXArRwipABrtdvx_jPkeEmkaNKpVk-wAfIPMCA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PLsB9h6DOfbm6qbS9Y0E0h6Ll5TVnP-Jllk5Lju2Asg&oe=6A105D53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfKDWsbRScsQ7kNvwGQSNkP&_nc_oc=AdoRgDll_oGy9iXFnyXoXR-6MkHR0EM1E116FPBYEcvneIIw56Ob1y1z20ictxE9pMs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O5YkdCUQicNR24aYk-mEqnPm7z7IBUcap8mxazgxgZQ&oe=6A104C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69PcmcCn7tAQ7kNvwGqfh6o&_nc_oc=AdpODeT-ORpeU0TKb0ZDj2f1amadO5bs4TbysNLMpUgYj37Pp4-zoPwvS_FT2hnHwWc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q644QAsUIOD28XR4-KsaJ9rPs3zDpHdZYX43BPjjexw&oe=6A10715E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6EVQ2GbN_IQ7kNvwH521Lk&_nc_oc=Ado7JXMPsAZJ-M39rZiULji6Iap7mAV2wnmZkGDjYG4VxnKPHWdp1ZR95IAuON4qsDw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VznhD6-UY1Y2U-NSewCg-62ZIbR-lvdLq8XR1yxk3_w&oe=6A1075CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIMeA2bS240Q7kNvwE_6d5U&_nc_oc=AdosfqtoyDqb_qBq7zOZC0Kcp3hGNu1l8wZx1uwR7gUKWlEJX7sL8xVf016ncjLEy2Y&_nc_zt=3&_nc_ht=scont
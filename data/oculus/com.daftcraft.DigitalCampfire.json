3KKW9Rpq1BYzeDV1Ua_vL3h-jTf0u15Aifk3bZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QkZRLy3zDp2th5hnzjeY8jwvKi7qKfA2Zwy6F67AyCQ&oe=69DB9AC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyS68yHRxJUQ7kNvwGoSRMj&_nc_oc=AdqAS0aXKjv4eOHxtn0zwkOEmEmPB1myuywiwhJz3urZYAYjPKaWpQ-mF2f5K2DoYYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r0y4ndoE4xK6oV7JMxYdd--iESyoiGH6J9KGmgcv0vA&oe=69DB7BC4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb60EEhEu8cQ7kNvwFwOW43&_nc_oc=AdoiccdCpotEb97DD6ZG2WqgWoZDTBQgKoEsyNzoT2NQB-VQj-APwxL14QFVUdk-Pdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tRNZLYSJP4V_I3CfVTfom24ivedpEDQOY_11PqmqtCw&oe=69DB7E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gphRgwuvf_EQ7kNvwF-37Io&_nc_oc=AdrZ_KFW4HJjF8yiVIHkkd5tqqx_1URtNj77e18GpFc-A8eI6QMQI6tua5vvvEJ1M7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SjtqkCp56vNIafKoSBCPHf5L-P6YRSoB6R5_PrzM9mw&oe=69DB7D1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaZoQWVyuDwQ7kNvwEZSgRZ&_nc_oc=Adre_ujKVxSHv12p1blopFXa67IhDhr6B8Eph9HT3Z1f5TIaBp1sQUFEd035LjuVioM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I1joA7MB3QWwTCBuDXe1F6dGIP7HHtGMh9fERjogV-w&oe=69DB818D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGIMx0UJAREQ7kNvwHyGYf2&_nc_oc=Adq0dMjcIgT0ls0XNvn-zenNDHU7gqGF0_YiEJbvr5hudkcvk6O5Z855A3RXgBPU8vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O7LTAdNhpBfuMnOyLTx5ylixJlHDa4EKAR6S60r6S0A&oe=69DB96EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
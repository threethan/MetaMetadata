044&_nc_oc=AdoowMf_-1LGz0IRTcGY9uzjJMmMMpjGTlBatv95xhjGk61bRgFaASL4E4SNrT62ywI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pm92vV9djTGbBjhFa4M39X2OTSKaSeN5PukbV_-Si2A&oe=6A230403"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAuN-gbO5-MQ7kNvwF0IZvL&_nc_oc=AdoHQNKYmoozDvbbXyZisS7RSeut3coxl5N0CsXCo1tH6NGIley5L-dZa4Sxr5DT5Dc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YgfEbMwjUlSY0lw5Vq-VJssA2z9IGLgWPmhxHJqKEkg&oe=6A22E504"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7joi4JRQYVYQ7kNvwEDI_dr&_nc_oc=Adr0FfVF7hf2W_qiDnZoRZ14hEdP4OE4kOA8zOIhx1o0xYAWyl2aoprMiygl6jYq_Aw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GVrt1sFm7I32M8VfHCUnbQr0_GHQAAbXZ7i8g0z0sMg&oe=6A22E788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_XmAvAofoYQ7kNvwFKc_4_&_nc_oc=AdqCHONgShFt3YTuAr1gQfFhV-BeYpTkYlU7og8WAmyA-uF2DxqDEYZ_xIK9HCN9Las&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lI47iFTSFVHJukMOhZVXodx3Py-I8dO-PleEeyQ-DmA&oe=6A22E65E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWjvKGK85x8Q7kNvwEeLFHE&_nc_oc=AdrL3L0EZUpA9uRiEyWrMf3Msd7-TlLATma2iKzrwYo01psr7H-T8dWp2P3tmTfGJn8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VmhYNCmjRggVVWwhZD4EJAAaSQpqkGljZ3lR5kpNGkQ&oe=6A22EACD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhkyayvrhXcQ7kNvwHwEPtK&_nc_oc=AdpU2SvKHNnyU2ZRDlMA3p2IbB7wTjeCAu-ZjauhHFzRqQHeq33mNQRzbqmW0NLXhgk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tZK8rTtDo9XBWm5mU6lxCE-6Y9DmPMC-evv1LG5IkKA&oe=6A23002F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_
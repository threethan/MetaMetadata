1-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zxkJJztZ8oQ7kNvwGKLlHc&_nc_oc=AdpERSc6CD1JK3qri_wb67T7NmuaafeZuCvZmkrwI7WSYkaJOM-id4wEakUbVI3N5F0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1J52CsS6Knnhq1p_QbfnI4EBO-lY_uYwMAfcSvGq6KQQ&oe=69F1E544"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NaCQtxFqDAQ7kNvwFukJoj&_nc_oc=Adqgxi7sYpwdCv3VvSnRqbfGm6qfYFU4fo-w_TQVWA8h7n5ei4zfVMJUnMx3vjTvA0s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0xk7QcTinBEApFmyl75rb6Cfsi27TqvWMhmOYPEKd2Iw&oe=69F1E7C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYk2I7zQLEIQ7kNvwFTFL0O&_nc_oc=Adp5_nqmwhyGUf-wMsQ7umoEbXCh1Dtl2LtdOyWhKIsXS2wvNFQy78hXybYJW2Dw_o8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af02ECx7POVdGIg4gr7W8fqCxus_T9klHm6aR3i8v0cvvg&oe=69F1E69E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to 
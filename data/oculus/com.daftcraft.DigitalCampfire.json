1pTu67Z93aWL5j1XbDqgT6w-Dqko0kkIeEKE3ZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXOJWGaScigH-wXmJdnqv68VwQA4Q6-X_uOAqHbraj3Q&oe=6A4F9EC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5SL_DzaD9sQ7kNvwHYlHuC&_nc_oc=Adp4bXYpAMdKiDkLUTtEiJRMNL4qHM9I49-2ZXoT_u_RK1VEPYUDYUkxsqtajs4Go18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQMkshDahizlq6u4mPtxcCp5qB9sOWNSxsdLwU473oWQ&oe=6A4FB804"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGB3-f6TUFMQ7kNvwEVOAq7&_nc_oc=AdqIoa7bFKhAr_eIfjflGe7O8wMeIhs2SXzdX-qMsX_sKVF7RbvkGXid8AmSKRdoMKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhfW51KDXCwzr0t2pQeQUKxgy8F-tyLFBpBiDgdWTYqg&oe=6A4FBA88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKkTv-oS2VwQ7kNvwHvACzq&_nc_oc=AdqWGVu5BEir1QnaYD8cH9Cx27xW-Z9W8_I9acWEm5S3RKBaV56w4hWZpbNzLOtJffI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOFZUSDZJfaj5-H6inmdp_TgvwLhjdG3wSi5CYlwzNAA&oe=6A4FB95E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jdRh0YHm3wQ7kNvwFQ5IDf&_nc_oc=Adq-Lbr13SsAqbOT1Ni7m8XsxRO4yJ4Z4eLPj0oNdnDwCFtKCS8XfGRmTiU9ceS6i70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMYTlJZP3h_0AUxJ9jEs6lNhQReQCagtQA7OG4J7lg8w&oe=6A4FBDCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLbemZMaG8kQ7kNvwGM_yhC&_nc_oc=Adp-QBt29YS_0BsufF-L9ShqFp_Y9u0xhy5agqw0_Cd45Jds_BCr1KZod4ROuN4a19A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG3R4qz57YQ--lbXuZI_r8dn1U6tL_2ekU7myd0fRzhg&oe=6A4F9AEF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
CIKY7dERq-b8yAQDq4zTHb3eNCO89YJiTctW2KY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycufVR4VUOyakvWxRAxZXq_uuUgnHUJWzyEEzMMVGcQg&oe=69C7D443"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ECZTogSlbwQ7kNvwH1vsmv&_nc_oc=AdoGeKDX0OKExPBqe6tGWwxxeQUDu-awwqpBL8vH5D2I8TdvdlEuY79sgVNLKNqtFs0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxA31Y-zqc2hrFFBZq5ugRO2cRtt5lWnX0cgZLudmzAIA&oe=69C7B544"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lL63iod-E8Q7kNvwFTJV_2&_nc_oc=AdpAIpacwGc1Mg27gdtIwui6fbp2qssRh7xGQeiCH-q0fRqU_gY3vdfsQ6uWR72kqfs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5sp1EuApli4_cNNgNgHKbPn_3mssSTjKjLIu8h3nZSQ&oe=69C7B7C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXzJ1GVMx0UQ7kNvwHeq4RL&_nc_oc=Adq-c6FpQaW4Bjvf4qHBbIPc4hxAelGUCXVkblVUaKSNEIMkSUq8ZCfZ3abLPYGZccE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXWesgTRmcxeWbjYOuwn-ZmOZA5CtuSAOrW4_AyO0UNA&oe=69C7B69E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD1aWFBS8WgQ7kNvwGYWQOg&_nc_oc=AdoNOTxRKcmT83pP_Xv7qMcFWAMHmQsiBPjcarEubWLm0BJ77_wO0inXMYC2LZdEP2M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afytw0JDn5eYDuaNHFXv3-WcU5xG1Dc07Q-TZBa1gMTc5Q&oe=69C7BB0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgiUZbZMdKcQ7kNvwH21kSh&_nc_oc=Adr4MWxEZQK1YsP1-er3r_ZEmV0pOkbVyFwJAnMEzHnSNHSKshRoqovJypjCeT6YcOw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUknTonixj_0XVvPoat82EwK87r4AFaFF4q-shKpGxog&oe=69C7D06F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpA4QHRYjMIQ7kNvwEH3Ldz&_nc_oc=AdqLWPkyzlKrG664pwgRdWzPNR6HfWaUoNzFWz9smAdy_mC5Du2ClktM9-eLTpEO_Ps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hLbiqgwRdxo8x4VEexhqH7HIyiFTLGXO8aC547U0_xw&oe=6A3A86C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts93A4smrYYQ7kNvwEiOkcu&_nc_oc=AdpoK6EhrLLfIIYbJigb_eEcqILUev66AdgX2cmzq0d6s71rvddwSLuA84RKlagCYn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TCAuQYgbgUykIzwIami7-MyBb9CXx21LMo82YwTWa8Q&oe=6A3A8D53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW8GamqFgtUQ7kNvwFsuPWD&_nc_oc=Adrq3E_rnrSIsO2XFXcJnFgumPy8SqDOwX-BXAr1Qp4OJChVuVNsGlwIoU4pbzOimiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-XCmlZiudHHXQZLihfWPjH-goSqohYGLywh5C6XiNBQ&oe=6A3AB47B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8O2YczJCgwQ7kNvwFeyeny&_nc_oc=AdooiVLeBLjp7ueLqx-ViwQCxib0a8xZ7WPlWv7PDzQ4oHX3KkNzdRLVPAHTdDIzmD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OtFbWwob4RBgI2SsFKD1r4_o-4vsQGcJ47miaxr_DlA&oe=6A3AA15E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4TUtxi_s3sQ7kNvwGL3iJU&_nc_oc=Adr9gizn0o5BQMh7oxCALrE9_9gKSzMMKIEgBm_2NQL-Kp3gw0KN-ziFYBTeXbsXaxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xRqXzWyi7BwRmstCkfbb0T8HSSGONtAvMzET_vjWglA&oe=6A3AA5CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-rG510UJhYQ7kNvwEuAEao&_nc_oc=AdprgWIPJOYhg3sqlwK0xhDN8vg07fMzM-J5ZIfuesPWn32mN9PdYq8DaWnO77KlT4A&_nc_zt=3&_nc_ht=scont
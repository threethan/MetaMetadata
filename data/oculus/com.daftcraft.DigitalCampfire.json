dHQsXenUgQsDxxZN0pzopYUObPi4koNkR04Z6R8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxB0Inz2bx325tW-mPYcKhzk4Xrv1EvEi3n-3P-vfn4Kw&oe=69C925C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ECZTogSlbwQ7kNvwEdkW2V&_nc_oc=AdoXX5-Wks7Y8Tzjh_r88GO_c8scJsmJMNqDE5kjV8aHtQZPFbpt2vpxRICt9qBOvYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygUmbDhZ8Ug_a9ZywMVlu9b8jgR8UhRIdFRg2HcziACg&oe=69C906C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lL63iod-E8Q7kNvwGwcocg&_nc_oc=AdpoEY_Rs9hUD2UVNdbt4KmdElzgqH0O30ew6w8LKSLXjqQI9uOBeTRRtDb_5Wbdf_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT7ZNoSROyZH8TDQxZfRCzsTr0jOI3d8hB07liLE3h9w&oe=69C90948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXzJ1GVMx0UQ7kNvwFi8mjU&_nc_oc=AdoTor5njd15CKw2l0zhwHclJtF68eTKQhHurVzEzC4buSz1QuS02GtyLNSjFQhaFXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwISnxIQk5CGwz4ekLXK4JnJYztbdn7V2vvnu7kTfxJLQ&oe=69C9081E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-CPAZ9eizIQ7kNvwFumnnW&_nc_oc=AdoIITBhbrXCW7Yzk8AXvApVqSTADqe6MLWoSEgCeRSILGhlxj2lM6GEORf5YYjSSIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyOWByDoa9a3Y6yg3UfWQYn9vxoIK_qDeXj-rEpN4dTA&oe=69C90C8D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgiUZbZMdKcQ7kNvwEIueU_&_nc_oc=AdrhMH6aO4HWi_WYr8Eo3_-XnKDk2Kltsg_ez1JYlQa2Inixkx6dZu1FP7t9MhVJd00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwR-isSQi3x3RNxcgRtJGfU27dRsfCYH1-RJhuQxsvOqw&oe=69C921EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
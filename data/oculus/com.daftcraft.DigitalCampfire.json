8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcNzW3zHzAQQ7kNvwFSbxgx&_nc_oc=AdpXgTDUxmx6CgbPdCSOVfLflg3WDIqbKoQgHiifH2B5jgSn5dtAlfbpRnwOX_nTIIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMihRWxDFwZkzs0XwVLKCjEzosm-HK6ULVKBl3qE1xd3A&oe=6ACBC403"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQVkIzK6SAMQ7kNvwFiFSIl&_nc_oc=AdrBgccn1jxnWdWPCN-Pn6MdgYPc1AjA--rRy3Kb0hk1Ft7-VcrMnGhWxOaxL8vSJOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0uBepSw0pdYIzBeNZGpTVDXo_Fh3-zYqyXN57bIbF0w&oe=6ACB9253"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGHL67PJyHsQ7kNvwH6Zmpb&_nc_oc=AdqYTeWHDvltY1LEl6MH1gcgVG3e1geDzOiI86P9lB_PGr7H4mAhE2nhZeiusCmJG7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbUifP-n3q5DIelGW9vvrilJ2NrEVrHDyH49JDilWOpw&oe=6ACBB97B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdiqfmaLoAgQ7kNvwEyz7wf&_nc_oc=AdoMx5zIVMPz-JoSZKhrO_xE2drGjxZnJp3zgxxZpT9la0zwzWCXqZjHVmT_VMtcslE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLy8p9htBIdf97ZBl93OmOT4vLpRq0__UW6enbeuyJSA&oe=6ACBA65E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EJapexh6S4Q7kNvwFOANEM&_nc_oc=Adp6vp-a7V__wDdvewuZtT1WjhTu9iaBSUCpqbksIQPTemX4M7jvsJJcmoMAOF1s6hE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIvtNy7tel63UiUjvG8XjyXLHdUomSMMRz46HnHfjTvg&oe=6ACBAACD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBE4UgLBJXQQ7kNvwEbDt9l&_nc_oc=Adqc5lwhuTCkJ92Sg95cu8Xk_W8_dQfMNQMIsZSfWUAkmnmoeTTD4DLnQ7BO7UZGz5E&_nc_zt=3&_nc_ht=scont
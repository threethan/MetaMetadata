zA5Y5LyOw3r0t76GXPSaaM91TUg53fvQFGkh_Rg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkuICmJpOv3Ik-DUUlRYN6ydiIxuEvQMeJ-aYnftu1wA&oe=6AA00A43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCn7yhXB-j0Q7kNvwEwkaaj&_nc_oc=AdoFhC3bxRh-aRJbGB3Vy4tWnEVmUQhDi6zH_2EMUcVRKo9f1xSvQZt_Vbej3nwprHg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqv71pmw9W68S7DYhN53V-DPgIVHK1cPRgUa1fMk7inQ&oe=6AA02384"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXAiX1LvGD4Q7kNvwGT6PA0&_nc_oc=AdobQzP3ydGppDPM1Bqcb8Z8SAtS3JZuVGILhE0lFR4_BurIvCa8OJ6k3EBUehG0Gmg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc0SiaH8igJ_TCg0JqKSE_xAcWt5iETEseLYdN6zNGsw&oe=6AA02608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qelap3krbxkQ7kNvwHM1UtK&_nc_oc=AdqhLtdNH-efsMc8gtNH01OBiZjK_t5sSZm9-OcK0CCdZnOx6cGO7WwIVHFkG8gGCzs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4mVZVuRdNt-eZz-pcEcV49_6mnWv_RloOYD6WNK3ImQ&oe=6AA024DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqFG6xxNr2YQ7kNvwF70QFs&_nc_oc=Adqs2KhMWD_GvpvFzanhj3sdr0vrq2S-g5uMbz1CEcMJibselrivSycbFUwYCwIXiFo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL56kt8eWfgRCDJXQZlaMGfHVyT_rxEm3dq8m49cTZMVw&oe=6AA0294D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9CV5BI0xpYQ7kNvwG2tjfP&_nc_oc=AdpCJVNRGaYFpAzX3AIHn2P2EerZ0H2C63kntxL2gdrD_TV-YqMy1pa4qtg0E-isD2k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGumfwOhNQqAm28wDnXXm7fKX2RKdvShkW1Q35AlrLjA&oe=6AA0066F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
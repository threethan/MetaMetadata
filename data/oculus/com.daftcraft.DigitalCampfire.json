lk-Qh2Tk1okr0cq6I5pkLoiXvX1OGyI8zcXt4iQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w28xhRbSuzlpfl2vftDA_njDc_ulIh1JIjDir3_V9rw&oe=6A144B43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQKQUnjgGJ4Q7kNvwGXLZcp&_nc_oc=Adrr7XNyipyUK9LOkeAzYvO-yImIlrRkHeqglPusDFX2FF3h7J9VeE62_XZf4bY_B9M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OcMP1QO0uILMwqYbSx5n7y9seeqvUsYA8NitpTXY7Zg&oe=6A146484"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sesbWJp8gaEQ7kNvwGZMy_k&_nc_oc=AdqbaYgU7FaQ26X3m9Wmi7dks9uBCZcuJP4rvXBcUT90ylynzOfudV3PZLlwap9JHSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_NJ73OuLHlgYZd1RmvZXvaN_aTCq7Qu1GUdBVHfIMxw&oe=6A146708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntqXJdzen7kQ7kNvwFrV8wb&_nc_oc=AdohvOma_S7iF6oHunKOiGwz4WKLrJRIHSMxY-9oZ3dG_erkGdk3g4chUHSP0xr4OTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EQzt5b690Mt86ebzNfLaEhgGL_1eHB8VfSYf5iIm6og&oe=6A1465DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWnfCLv_5r8Q7kNvwEJB2WD&_nc_oc=Ado4AtdX0Rr3pvqKJcbjz_kSDe3s1exMEdJIn6W3hnGkxv4Jgoy6RxIiFzYu8DBxtFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50YKUuZhATzTDt8tEshyyuEsnBeztzuRd-2aMqVEz3Fg&oe=6A146A4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re9Zad3pVecQ7kNvwFxCrdm&_nc_oc=AdpOtXHQ9vWrKKRg-UajtEg9Lhs6SlgWmFxriadSi42fbyNLJ_60o1LsiBu3AtAsWGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i9fcg7rrtDSwFWMC9o-6lfqQh46vZv7pGNOyd8qz3pg&oe=6A14476F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
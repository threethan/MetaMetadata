8618161382", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBNqH3LUlrgQ7kNvwEIafAV&_nc_oc=AdoVnCZ_lMtKUfz0-RbwSQTiu_y0kIoiQRfBG3uW4fKHln8xRIqFh_OYH77n5_muUfs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aA-dB19JoMbqvo9ALKeQ35bhjgblPMcHdo9aB40XnmA&oe=69E23243"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwC_VTeln_4Q7kNvwEqYCbR&_nc_oc=AdrmcEoifGCQs4DY3907vgvc5zSmWsCx2LfPDTCYaex3k4zYi6RROR-E_YYdpxcHngI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mzdIgXKBeGqnEtYTwXN1_Uj7xrnGH1xKwTHjepXDDDg&oe=69E238D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VT5sPvrUoZEQ7kNvwEv7ZOr&_nc_oc=AdpGAn180WwHnaFyb4YZEeY_9ZwMDn26i0F24d68yOiWBubT1I9QJ9xMXZZJ9CawtYM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fNHVChZbQuTX4QU0kl1YUgnt6RLmYpcna-gRTROOYOA&oe=69E227BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=817zGtlNOkAQ7kNvwF_kpv6&_nc_oc=AdrMvjSgj39RCVU7hVi1X4njSc7xOdLV4dYZFPR7_8g6ZdKuvMVvD3NNLm5lby-BWQQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VxN9-_NUKzEP-tO4z2DnVvsyOdKxWZj01GqQ2cXWW2Q&oe=69E24CDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrDe0B4UDhUQ7kNvwEfI81d&_nc_oc=AdrKmFTkclC2Key_sSqpulGTYvXPbNa-9QFF7VdZx_nRgCvl0Zv6NekgqqTckTqUV3Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KGoJKUP5KlnNcGXBcUDmt9wad00oYgfgfcID_JOofKQ&oe=69E2514D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N6vRKnHshEQ7kNvwHU11Jc&_nc_oc=AdqNjwgovOhZ1JFEuWXncD4Mb3Xfz4qxWMtleUKReiBJke299wTccCJLGgHSDBoaKao&_nc_zt=3&_nc_ht=scont
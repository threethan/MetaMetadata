8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xxYJ025hygQ7kNvwHdsiDi&_nc_oc=AdoXdhCiuOZCfe8YqH7x5sAt7EklqiOhskYyku87xnmFOFJWP0qBvRIB28LAsJWEhBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q7DbqMtBCrRb3y7OYL49K1IC21Z2s55XMjIyCJF95Dw&oe=69D3B1C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0cFRt85I0MQ7kNvwGAwxZJ&_nc_oc=AdprmNxDyr2EE7N4CY8llHX0sZvntyjUHzQa-28pWH0f4BcpFBzhgmgiMrVp6agqlQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iHCRHnPHvjGbjHR66JgnGkgJ2Hb11OP3nk7VMf-PYZg&oe=69D3B853"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgyzaUuP93cQ7kNvwHhMkRF&_nc_oc=Adpv9J9rHh-l-u5Vk5nFL85zoVu0naI6dwCnYVULozrnLi3XlfCs3yKzciaI9377xXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M3pRnuWHa56f0DdPQBo1yH_4SCFba8-STnvSiqBGZYA&oe=69D3A73B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgjrObr9zfsQ7kNvwGJqfhh&_nc_oc=AdrCSk5zv6Elxs8h7FlqQ_JHyORG7KYW1xXe5r6qaPx617L_Gn4qAUFg_fay7xeRydU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39rZ0-e4AAy9StcJoAjj8ob1Wo6l6y5X2Hn9k24PaG9w&oe=69D3941E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W49peRHbQW4Q7kNvwHrwwsk&_nc_oc=AdpTage3Nl-ncdX6eVKWmTZfpmjt9DTrRwnmmnyAJJX2obFsDytIs897p4FwIAeGdiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RB-K3Gelssf1LWb1XNpgK7qFQiNWpB89oMaZ9ySL-JQ&oe=69D3988D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvHD-1uz0OsQ7kNvwEjQzef&_nc_oc=AdqQDTS8wdXV9dsLJ9oG38byFSKGhWpCOvuIegY1plpWXDBkul4rB0m4HS5ZoXI3vU0&_nc_zt=3&_nc_ht=scont
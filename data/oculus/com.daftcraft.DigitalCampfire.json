8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjHurRgXg6IQ7kNvwGDZUdz&_nc_oc=Adr1Aawcip1kbYzIFYhc6JMiYrecGf2Oo-OHF5GaW5MJn3x7Gbm6RpVw2j1vdON5owo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA-2c3R1Klq9zaLpWEfAQ_earHKnO_h9S80vzkEDC49A&oe=6AE0A3C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xgFiQK8SooQ7kNvwFSY5H-&_nc_oc=AdpT6qYOMDdjgrf9M2Izb18kk9Up7BAJBBpP5TAat8Tqz4xZvxrYbyqg4-bsO9gRBTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmE5EI4m4y9hOzuUaCEjl52pQvNIOEJfHVaBaAcl2Rug&oe=6AE0AA53"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7S89NsE7scQ7kNvwEwKN7n&_nc_oc=Adptst39URwIQnkMoiGWpJcsm58jP5220OUiik-MFRUayGNMcxogJ34CnN8HNRqpZAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEljD2EmUm4Ys0X91nTXvOnrgpkiVJ95MKRbzHRx4pWQ&oe=6AE0993B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxS5IAyCe-gQ7kNvwF9oaOc&_nc_oc=AdqvB-h0Slzfz6lAXkx6aF1ZlCPT1A6CDWsbOXBQv_8cEP1xyDo0ItCLAnjfe4lbd20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx2ZbFk4o6Zv88RPdUWcUN35zCuR7zn8f6oVtPVaOc0w&oe=6AE0BE5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGhYwkYjFdcQ7kNvwFGHwWB&_nc_oc=AdpR0ABB5acl7u9Up2i4gllE6iLZzqngJXuyhUDVuSLdWBLNQ610BKpGpJ3vOV-RMdc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5QMMCZ9KpBwhbvlk-3BZoFZMsCOBm2_4iXTJWPQQJLg&oe=6AE0C2CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk45OQd0dYsQ7kNvwH2ghrD&_nc_oc=Adol6Ze0t3B35nJWVHZme7oICZGNgQqEB1NtatWsk-ysagSwEygmiMxRoD1xqeDbQ2c&_nc_zt=3&_nc_ht=scont
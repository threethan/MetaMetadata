IsGRvTMwrQ_8VHEFmD--gVLuGqvFfPS-_oL0ylI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6FC8Ru7LEPhl-rgz7UkJ42R8q_cAbisIhc8Au8Ga0aA&oe=6A4BAA43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW_rAChbz6cQ7kNvwHtwQyz&_nc_oc=AdridbYL02UZiIrr5CaTF4vroQzEFZuFptdPS1rMJyHX3Be-7j0IPbVuPlSporpNOM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHMRwBskr6CZu-meSpujxOIUUGJ7fKdBG8TWf4UnXKVQ&oe=6A4BC384"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWjJ178A__gQ7kNvwFs4yoz&_nc_oc=AdoGY_W8HQKxJrIJza0uILrnySPdrmpSBLzPdx5DvY9dpzzCOlJWSkMjsVocXfEAHVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQaKLykuvCopR504ZNObKnA9T4ekRbr3LO4r7AXFjh1g&oe=6A4BC608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOXpm189PHQQ7kNvwHuEmjs&_nc_oc=AdpQ0VHBQySnvM84Ogl81haNkhQKGDYuXt5klqgTI7Nepha8433XzZb4dmPk2XLaHO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqtpkLwAZcjrfY2-R4xb1ymv69v3-POEFVH1st5EYI8g&oe=6A4BC4DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZuQ2YhoI8MQ7kNvwGj6MHE&_nc_oc=AdrKkrstBTI7tP3Bj2esvxtfBHWtP3O1iffccGmv-9ujT9oBm470P7zFH8nK4jjEfCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNV2jyHO2s9zs8BTD-PlvyaDs6rzASAaYT_8FxZ_1ZMA&oe=6A4BC94D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBi2InWDQVIQ7kNvwFkJBXC&_nc_oc=Adpc2l4uHivANIvwSJp9yt845dptNWbmcVmCM6fqKylEirc_9mKngI3QyypBITes2wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRDklO7wIhw2eInenMZeAYAzZKvwjIEtTvAxquZcEUTA&oe=6A4BA66F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
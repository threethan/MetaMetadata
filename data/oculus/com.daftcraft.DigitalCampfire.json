yGj31ocYcHCl7FvqU1g5VG83nxhF5sHViRgxXf4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZqWe9K8Tk1LhUXdHQrNBxa5b7wFEwCxREIoWIHMLsyQ&oe=6A4E4D43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5SL_DzaD9sQ7kNvwHaVORN&_nc_oc=Adq0jbKB3XeG6vlDX55UZ79I_sfd7e_q2Mfh6U2iXUu-ZLWAotbVmWf1l54uR8sqcNA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnksIMvWUYbyZqAXaj-tMTd8wV7YZJlaKsAN8VdKoZMg&oe=6A4E6684"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGB3-f6TUFMQ7kNvwHmjOeF&_nc_oc=Adr-RJ6_L_k00qjY8Ky6qcH96EdH9fLgoWoJZsCPfTStqtkEq-7wV9_cYuJOO2fb_1U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKJo2IxOeDAXk7g7Qhr2I5_Az8s0cU_yLwwEWDybmN2A&oe=6A4E6908"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKkTv-oS2VwQ7kNvwHSaqf-&_nc_oc=AdoUnsxfApXw8WdRkhaeh4TBcA06smgkswZzwb8W2GZvB1jwOKZWiBs2URYh5VYrr4Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB552Wt820yB3RVN4kVnmqofFHnXvLw5Yr_ugQ6o004Mg&oe=6A4E67DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZuQ2YhoI8MQ7kNvwEC591m&_nc_oc=AdqpNelQH1TrzYqHT6bnxly7f-Qb6DvocGSEXGEblSwuivKoJ_7-8aAVkHscOnKU4qk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHLYTP_rGD_Ox7SqFAds6nvIbvdK6g6g53FsV52Eo3Gg&oe=6A4E6C4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLbemZMaG8kQ7kNvwE_GKMK&_nc_oc=Ado2iDDESJHK4l5_5Y8DaAfioyTKobX3pmizw4ZoLcaNbTqTxM0FtIWfTcgM9-B8Qj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsnVd0caSTp5CxvPoWWHtIfe51SZxuzi8ZCoiLx-RQfw&oe=6A4E496F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cranL3G06iYQ7kNvwHyq_Zr&_nc_oc=AdokQMtiNIs409Aqc82o9mtRngS3j7oC-j-3OxD7iGioJRPIGID47itkAyVsqcMcNNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaE9jUei-2WrH5OUaWXC8AkQZ4Nc7CssWChrVE5PHoGA&oe=6A5CCDC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt1BO753XokQ7kNvwFZd7o9&_nc_oc=AdoEfsXTEiske5Zru_dY8Fom4eTZDTlZI48h_YP1BwuGBgmUNAbdJd_JSGGTpc1N9m4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE1ljik8C1rFZscR6YJXiVaUBlbcOu9fMz-QGIbEvtMA&oe=6A5CD453"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNqE3ikCDJIQ7kNvwFYQr2e&_nc_oc=AdrDA9aiNDLRmmcjW5WB07ZIBTlJr2Sqj44haiKZV-f3Yzm4F2kCDf7tKv2SpKbBVko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh8ik8x6o4zJ81w7hQEO5kAz6Y7kknp24bILtK-PBBLw&oe=6A5CC33B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVknimpY9wUQ7kNvwGCIg0g&_nc_oc=Adr29pkl-ABgAbD08xlFMET4M8YUaCrBw2oMWatZbzetSbS99q5SgzOanXLbVMso6S0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUmh_gtYNuIZ9rJuY5BCUNo6RwWzzlu2dxW0jg22Q__Q&oe=6A5CB01E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhrssI7ERGEQ7kNvwFLaUPE&_nc_oc=Adqt0CYtR4vEnALFWx2a2XFqSyTvomrn3guhFOgi3T-YGTYOuF8wyX5PV5E8ou-5V4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl8lLo3BIYpGEN7QTEufnfIoi5Y8aGiOJAUyQ8zy1N7g&oe=6A5CB48D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7439wFTfFxEQ7kNvwGmxihH&_nc_oc=Adrr6EwD4QMzZA8ziZfmSLhT7qTzWZXXMr5h12xNAPtR7J_veZCUsbMOlC5W757AwRI&_nc_zt=3&_nc_ht=scont
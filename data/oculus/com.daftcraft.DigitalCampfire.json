yw-VJ2XCzz3BcF-BYIIuKzAGhDzGQNMtZ86rJi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-531XG6yI8QERQgq5Q_7XGpiWCITdVtfPFq0r6MomLw&oe=6A95B683"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED6yfP7WMR8Q7kNvwGtfMTc&_nc_oc=AdoWKxmpb8Oe63PV1l7vxXc6IbPgetDFNBi4vwBQgIg-jhKePc2vSYk--kGaIgUjK_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKc_VSviSeRYW0jn5Z7tS-gbPsvlEYof2LyB9bAsqL0Q&oe=6A95CFC4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OMwf3H1l84Q7kNvwEfFRoW&_nc_oc=Adpp3K88DqmTIN6BGcc0efud7yUOUdKPR7hdvL_v_GWtxWFeAqzqHiAyWyWSRquBJ2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8tpKsq6YEeLZaH4wybRfpEvYBt5Sk0QbXxSLTVM4gpA&oe=6A95D248"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fkxHlbzv60Q7kNvwExJAUf&_nc_oc=AdqgMniLOMkuWNnjm4-Ig6WxV0h5-bpN8s8v8W29cl03CYI6K_ONN6wtG4Fr22Pz4bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUSdZya0129ww6GxAPYTy9nfnK9BSGt94tkKKJ_YYQYg&oe=6A95D11E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYqQja3_XvUQ7kNvwGHWwL7&_nc_oc=Adr8SDedaAOXJZu3Lbq6JLCBDBntFnfrVwnpaDDRU1hjWM7PYZyEMI-gv-fbkwZPrTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX9E21zu9lSAszwLsTL9IveDjZgQrIOSHB8K4UQnKcZA&oe=6A95D58D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrzlDYiU1MYQ7kNvwGwSTDu&_nc_oc=Adpz6NDdECmER4u-cke4gKIhTmSe86RvzL38LoIXfdAOY7mfL_iCmgOH_vm7GuoKFMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvYh7H_0ULYBaBgbDRiHr9EU0Pkkl36FoVEBlOXnTxYQ&oe=6A95B2AF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
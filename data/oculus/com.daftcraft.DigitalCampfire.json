8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_SVmuPSs7EQ7kNvwHPbeNQ&_nc_oc=AdqBI1zwyNFAaflDz0-Z2K0GAHlKdpS8cfd4B2fmjDWSm7obNOofkHSwDcmnvq2Nlc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhg85o-ms-qz5R_aOQ4H_CK0Bw7k0z5x8gV23xzJKpRw&oe=6AB52243"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKlNyijtSJkQ7kNvwFlfsTb&_nc_oc=AdpqDE-rwlqPQYVqcXUVTX5d7bbIWku_E0oxvacZytOCmthOqqWeb7wLpTN_agrlW3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3S1S0JXRuVOJ7guA_IhUhhqj09z4DE5zyVFuwAky2qw&oe=6AB528D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuKEybASzKgQ7kNvwEC0IEd&_nc_oc=AdqO1D_B0_HGxv8_QOU10uioNzW1DjIgMZDEjGWkHh7TmHSdVbaGwqxNdh81515ty5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL172U6Fy9pIlGGvGevQBRPUeJIajt40MOAcxYmjehntA&oe=6AB517BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7l2-KgorcMQ7kNvwFQEP9T&_nc_oc=AdoouhaaQ8B7csMlSZPD9OFL-WcKbapIi0TLEU2YJLZjGkGcFVnS-UWQ-_h_28Yj01M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEqJlHCyTgT4goldMab66t9qpEeDsygUvRikBlnIting&oe=6AB53CDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcX9JprCplUQ7kNvwGbidgL&_nc_oc=AdoRaKMfKV7CeV28g5QWOoDj_DDOVkzjaPa0kLRRErVnv-Tiw9YjpXVkrqYigcMnveI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkDQklGvlyy5pKg7hqMaP-Sq1V0QUdbAWCdAzeCQ7hAA&oe=6AB5414D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcyvBdx3FgIQ7kNvwFRM-hc&_nc_oc=AdpxzTJvVYLeUZf3gTZVqszbGgsX-QO4F6AiAHBH7KiQKSUbw9FzMEQy3vDUi93IUuE&_nc_zt=3&_nc_ht=scont
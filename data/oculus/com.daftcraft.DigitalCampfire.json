X0WVDHvMnwqad18pA5nWToa8QNTXWltXne-3gOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbuYFe6mnh1LJJo4OjjUipKvFeT7q3GlgquaM3r1U3fQ&oe=6AB7C543"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdKi0rRkr1cQ7kNvwGB9yFk&_nc_oc=AdpmPZaEm1-KrcUGOM1dWuazQeljZGWapKK6tZ5KSyxzK7HRSk47M7T0S_xrvaYQU5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD7I3R9jLbyG8TJtwd9iwEwTNEskHv1rLWaThMLy_NjQ&oe=6AB7DE84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N4phTj5mekQ7kNvwHmpLnW&_nc_oc=AdptiFxUKRgG5IInYWSmA12WtvZZzO5kRE-Pui4kSfzELY4ml-OAeF_d-oxjj5FMATY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuhQQylTCKQbXFbYUOLzMpFEvrrcg9O5Y4UUJHsWj8PQ&oe=6AB7E108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bvQVfEfzWQQ7kNvwGATyXB&_nc_oc=AdrlCzW2evrmmalsccG7dwCyrZhCns8JJXbWwES7hvz6-hVcqJxJFGokWVPIDYXYxLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ElXBzqC5__CbUZiZV9ae6pGVO7GahS-ketZ0PJSp1A&oe=6AB7DFDE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Borre7I8FEIQ7kNvwEaZW2g&_nc_oc=AdrGlXR0YK1MnvkHXIth1icS7YsNHX7RpvTPROuHav26f0nnpQjyh1rSHGuqE1uK4Wk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF7e9TYUZ0DPZyEvQR4qL1jmLm7WrhP7jLdYnlpyPA-Q&oe=6AB7E44D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcyvBdx3FgIQ7kNvwFm6oGy&_nc_oc=Adp4rSr5tbYgrhoHVUYys9MYLp1_nhNh7x6kOGXJn1JcUXuGG2MeeOYUOx-15OTlnPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIORUBINgfD_sae6hoBVVhQkL2wIP1dF6NCl9OqT3VvMQ&oe=6AB7C16F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
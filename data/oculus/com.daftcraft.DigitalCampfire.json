8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHVWN6w3DsIQ7kNvwGUMQPI&_nc_oc=AdoHmRPDXwnAgswUTO91Kx8XtCZVDMgiNYp2AnQvCS7B65kKflhBTOveyllgyzWydzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81fMFUMj1dYEkyIhEGhuEqraf9nrySsBrcvP1QsALjJA&oe=6A3540C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WJsgaxoxz4Q7kNvwE6Y1l3&_nc_oc=AdqAgVlDimrlGQywCDhLKLCA3A3oQzROXwqYJ5KchbGZ_SPZiqbt_uCMKlxD7OL8A4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iK2pyJxtzfZT9Mm1YK8U3gTvXnX68Kpx8l0NJIOP5sQ&oe=6A354753"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VL2nWF2EhIQ7kNvwERelyL&_nc_oc=AdrJ-MqjacVwQoTzDIDsA2mph2LrIRCjXS6mlZ0gKUEPqO-1uLoyfpkbnLnE6NEbESk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wVALu7zDGbBllzzbE_p4JJ7WL9L5ep_Tr_Oz15Qn3NA&oe=6A356E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=di3msBr9yJUQ7kNvwEl2Dk8&_nc_oc=Adpx6aPl_aNSmaKQreoAfBO1lf1Okx19I07BWGCVPCPT5xrw4BiyVT5fgFfP8i7n4UM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K9pOP9R6tipvjEpy0-g5PkI_7oYA_Md3LluqN0UtKvQ&oe=6A355B5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEkiedfYFbgQ7kNvwEzUkAu&_nc_oc=AdrUSbUCyq0rcR21UZwxzAzTgGfxWrudsa0uL-UcPOqF3pzD3iazSeIVZ5puIFGHmMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zBl0-zQHDHsYIBVQcB47iirrvSYhx5uHGYnMVRz3-iw&oe=6A355FCD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h80FmPSf0RAQ7kNvwEvC0e5&_nc_oc=AdpryQrsuOsVZfjn4HV-rNK5BsZGhV26SL3ozj3xozRWkdSAaBPDeH1t3R_6QLoHyVA&_nc_zt=3&_nc_ht=scont
Z5GLgV_8wb9qonE6NQdjhKCxQZUqb4VubFvexak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRXCkw_J3HDPFF6_SusZzOcVnVfg9dlPTHJjXRRY7V0A&oe=6A86FDC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dm-t_tq6RAQ7kNvwHb5qRE&_nc_oc=AdqZoI3C6FTo2qiTjhwxRHhN74Hpe-lQSD0zHKlvcTUKWyIHR3mwzoU6yBVsWOcuNPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmpuyhr5rI5Z0RcBNlPtQY4VtJ9cGM1K973ok1qkkhZA&oe=6A86DEC4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhB3yTb7XNgQ7kNvwGLezmN&_nc_oc=AdqUH7SwwSri3E-SyLnjHWAbCmCzaMF561AuXqu1yT0B0dv3QhPECboyixKLnYur5Dk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPBlSqY47nuM7yBfeLWuKzWqPpwVIfOdxviwb6sMG9gg&oe=6A86E148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeYJkzyNl-YQ7kNvwGKTsKB&_nc_oc=Adq-yux0X4zLSx8bN198wla9bCt-Ohg8I149eEl5xVeaCIcKmsMSmsNQtp62YhgRiZo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGViRIYjXp2NfQDzdNwGqRjUKEOhdd94evpT3j19xbCDA&oe=6A86E01E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50QmcVgnP3sQ7kNvwGMO87z&_nc_oc=AdoniR4GLUSCBrC3dTiCP9OeffHaZQdafcTjn6lPiJc7qSCyUW_uG7sM54eqb0af5i0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKuct8zaQ_kXs0bMmnenmGH-KmlTqQ7L97dwnblYGxug&oe=6A86E48D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaZXQxeRRxoQ7kNvwFVPWQJ&_nc_oc=Adq5Dx0gjyMsOJo46CX2sHroMUccI4T36NOsAKV2u4QKEo9PQ9gemxoG028DHCdFYWA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrBIa4x8L8Ca-WNIi-Y_pStcylmd7tWt4WMugHvvbA2A&oe=6A86F9EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
UyFGimrI_t8ZL3utefxVlDxmvz64XrQR-O9CRo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQpYSD78-0MZRVn3ojjpyBUZykFRSqoHAPsqwGuWvN1g&oe=6AABE7C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euZ_6UskO6gQ7kNvwEQmtqt&_nc_oc=AdpWjOYFTA_oxyQmxVEZ0nv5yLZP56Q-pqCEmAeJlGoKru4kroBT6z6wszNXrLXUp9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwK5GVK9cJD2MCc9sFSbsx1xGEUYZzc8cYrWSlcpMk5A&oe=6AAC0104"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2VE6B2h-VkQ7kNvwFjDFJD&_nc_oc=AdoEvAvdcNUyv-wjrhaU0XnrDzcp75KHrjh12vUgr2lkbDbowcsh9GDzmZ3b2sW8ISM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOlYboS8KFw_VVzFBabnA4sEyTdBB44LSjUsxBNnYWVA&oe=6AAC0388"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3WSs8c0T48Q7kNvwGGtKMU&_nc_oc=AdqAaTjloSWp6Dj_g5V5-JUL08aLGyR3unH1PHfmnq1aSmFNQ-cFaQMESN5v4bq2GiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGRJf0jG63qYH4I4HUdSzXO2GLd9mPaeHHQ_ARW-P4_Q&oe=6AAC025E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXPNguhm924Q7kNvwE3Cvt4&_nc_oc=Adp7oNkkrVQD-613YyL1XCw5ib22nYsDp4GX1gvx-wHSb-u01oR4muqcfx4AeGFX6eY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtXZEoCli_Gh2iNRW9Jx1q0hLDBy6O5mJ5ZOYq9ty7mQ&oe=6AAC06CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOVPg12gdZ4Q7kNvwGa5SlV&_nc_oc=AdpBXt7tCqdiFNUH07arhpU_AMtm8P-7_4ZV0Y84oGHGtxgZSusff5Tl6G9mwD3g3t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdpDt-CJCjEZOsvn4MhaTLnxsDptAEAI59F9dQ7kfg7w&oe=6AABE3EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
2OlG72PXN8nL8uNIHPoktlHpnFicFdszYG208pc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVFrizO_h9blHPd0vWOGCnqVlilogXT0yI7xh4jGlxCw&oe=6A6B4E43"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTVpByZuXNkQ7kNvwGYAI67&_nc_oc=AdrykjQEvMaiqEZ8znNywu5xmCVaVss_1iLTq2v_mvBJu0bCHSLD00m3RYBgNs3jy9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmd861liHEam-LJn9qqo-ZtzuYKJ-EJJLskGDVj4rNgA&oe=6A6B6784"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5chRpVTVCEQ7kNvwEtoqWJ&_nc_oc=AdrW7HSWe5uofmIcKvUutyPuvn_pyqB1anvQXnwd6uGGyR9vJ4skltyvQtHcz50W5g8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxuyCDYP99TBJoY5IbdHYnk2iAqkRpZjvqK3xFbWGQPg&oe=6A6B6A08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U9HrQo-b94Q7kNvwEvnn_d&_nc_oc=Adpp5RH4LMSGKn9rK4B3bhE-Oe2E6cMviBs5S0CCp0VLkFZB-NmxHq-q1fNOJxGta2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOEfrolsRnm_9dMObGwRw8I4i6OEWaRwhe_sj76ZjpdA&oe=6A6B68DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPv6pvgR670Q7kNvwETdRkb&_nc_oc=AdrQ36EucNgZ-6IMoh6X2uYwP251Gg14vE1-ZLSpy8_dp2bzUAj4cXBOsw6nS2TJDoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAexH0ibBCqT8S-gxXgMJBfwJiI1vQtiInQf338UIh9HQ&oe=6A6B6D4D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml7Ihq9FR00Q7kNvwHaZQM_&_nc_oc=AdrR2XHi25mHQy5HRGp-b-vz-g2LAgaXtiDeT1r4cDxLAVzSIHpE_AIAoLqOuLqgqMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDETC0_mLB3U6fEumKb2QxlHBzxw_mOT1mjHYu-hhnvkw&oe=6A6B4A6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
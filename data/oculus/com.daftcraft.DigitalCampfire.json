8618161382", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-EGYrCaSxkQ7kNvwGtTuv3&_nc_oc=AdpQNV0gmrNbR7IexLV7xsHJovNQqsKqInnaPfj9TW99yeT111CztDUHtEbXNlq5m9I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWebIi9WqPZ7JqvYUuvP5nsWQL5YkUoP0JVSvafvEx8w&oe=69C53143"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIzUWoiU4vgQ7kNvwHNzO3h&_nc_oc=AdqLojESBQiJzLlwADElqLTyCfKlCcZVtS-ivlYQKEfjXabJeRBjc0BCvydPTrsjRbI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKVOZ5sUVtpkboiSFOVj-FM6bgrzfEj9KmY8GNlbmo7Q&oe=69C537D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Y58N_qKLuYQ7kNvwHMSzqs&_nc_oc=Adp52ON2bamUYn_Y-kis4Do-05MX1GQ3pCFeuqFzUl9lA8-89M8yUuGpau6Vd6OR0eI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjfK1p8HZr08EvukNxgVJQpcXQulnziMmRPT9_KowscA&oe=69C526BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxtCVseHRiQQ7kNvwGAvfvS&_nc_oc=AdqvEZtLkMWa2hATfGF8PNueXwizRD7HNDw__833EQrVdVDjdpUuPUI0DuZLhemH8pc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZgrYEiOMEhhN6W3PTboauHKhRzNpjDy1e2YR1vr3NRQ&oe=69C5139E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD1aWFBS8WgQ7kNvwFsoohM&_nc_oc=Adqe6qDaBAArPPELUXTKjde0FERzyducEEbcWCEPokDFGUvpb6nyK1i-VZyN6bz48ko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPFBg6SwIKTR9k8thvhLBuiLKZqke9wFHLa1AgJ7edQg&oe=69C5180D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43x5o_0ohn8Q7kNvwG8uoLI&_nc_oc=AdqEyHFmaAVYPUTr9YCosS8Bqnh0-DTUAndNt6HQXU8RVViic-ix9hpB8tRolOdfcq4&_nc_zt=3&_nc_ht=scont
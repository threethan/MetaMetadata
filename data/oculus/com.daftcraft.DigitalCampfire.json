/scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFqTDnBvR6AQ7kNvwEdyOIE&_nc_oc=AdlIhw9SaWeCGJKbDEqwM6El7oVpgIWro9x2INIm8aJHHEeJDsB5pq1FNCfQU1OELIE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIxa956V33SmoN1LFckNLu5yD1hA22yjc-DgybjMDQqg&oe=69AAD343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIMKtvqzx58Q7kNvwFk4jUy&_nc_oc=AdkrX2D96LDGFT1N6aRbZbGCQ9vDauJ8bkjNFB0ub4-n2kItXMl2LnrWrOoa5APwrxw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGoIkN02vRhOe-HgPyxVA-qOtxV6EQeH9yL4vZDH39Ow&oe=69AAD9D3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEYBBeMRyeAQ7kNvwFcwUJL&_nc_oc=AdmEG2lKZ24a6uCA99Ve94IlG786MwJRoUrEM4xe9MlRPXL7qEXTL_L8yUe07ZcYv_I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzijnHGBAzPkfXbHK1uM9iH5CUxasMi6yyTUc1lcuh4WA&oe=69AAC8BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp1PL5dLUrgQ7kNvwHLz08Y&_nc_oc=AdlGT629i7WEUbemzg2DuSeii6MR2AHK25U88Z0h6kIMC3mXRpOsJ1aZrceShFCIsxg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5z7pzOFNbJjSpnJbNVxdDT298TkcaP5HgE5HKxlj78w&oe=69AAB59E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYACI0nTtrUQ7kNvwHdRmlh&_nc_oc=Adk6h-isxEXldzFydO904CET2V18PeIpbk2QMFiotT4xgU3uU0e4GT5toWmVJdaSz4s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5UhgMpIDOpSjUl5Df_0IoDlOgduh0oOdyx0FJXAQBNw&oe=69AABA0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xs9TmyNAoK4Q7kNvwF7AOoN&_nc_oc=AdkIyD8oaZ4QZ-bgNeBDit5yNYHbYAkvX6wFb6WsH_GW3TjDdKtNLmRr2pZeDSlQGTw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_
G0AeEUrveX2lYUz_2ZksVOwy8StkZ7vzpn-Dha0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iW84AdLLQ-kXyxPmomXQND26bmOxSsKbz94LQ8CxRYg&oe=6A2C0643"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8KZGv3ilz4Q7kNvwEojZu8&_nc_oc=Adpph-fK4V6SoPK0bWH8jZhHUI2MJcDmsBt94TKBuk4XbDMZrZFQtvfZm3y1Z8wlmgU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96rI4MpeYc7ZmKmqaVCiM9eQP_Nm7zPAWc6p1UfPaCwA&oe=6A2C1F84"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mFurMQcyBQQ7kNvwGo_a25&_nc_oc=AdphjCCAV4E5rosBMQWfqG3Tbq3PyUSEsKV2insuoYT4PNkYO9QbwXBcGcoSrSpzWEg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZqEx_DJweilICApxwvcKyGE8QHGI626AX5VEmlqCylg&oe=6A2C2208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPtQZ8i_0wcQ7kNvwH3y_fM&_nc_oc=AdoQuTwSQreIjPbHFUzn2apLB20Q_dRsQJfT2lkKDVgoXb4ZBu-zr8pWf2sxy1W2Z7k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dL9IzJsOc6duoWg4ukQeDvI2RuRkDLHds1UEpVN12pg&oe=6A2C20DE"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR8DABlRbsUQ7kNvwFEOn4-&_nc_oc=AdoE-b9Ce14YDiQZe0SdOXqP931x8ekIKUFi8QXJcschKxMU4OLx8kHsn0LeR3tAi88&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eDBub4wSjAGUsAx4C8F0JRm5Dg-JhXFBkkUqYwUSMOg&oe=6A2C254D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcbvT9IQE98Q7kNvwGLlTbp&_nc_oc=AdpZcoQdAsbhtkcHkSRsBwBE2_aneupYEwFZ1AysiN-f5_fy2X09iFg_Hu2G6-_MHUs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-c4amBh2MSguCm59fqseaO6esCrFMcfnWNwMe94rEEg&oe=6A2C026F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
8618161382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qtBd0TxhUYQ7kNvwFlfvlT&_nc_oc=AdqFYaIQT0VbHaSZFWkxQZX31GXbEtiop7mWOh1FLC7TffQJSkplSytUTAxaxB09iUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv3h4I-0aFwjz8Xep7sJVuzfbo5oYI4nPXIo3wWxVVkg&oe=6A5F70C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt1BO753XokQ7kNvwFV9cjV&_nc_oc=AdqPHKfl0chZUBzzSHccv_-AqSQnPPks6wtkrXWRmXi9X-hRwSbDqwCa4hhAWAJiZjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPTankjzkDlr2kfLeB4e_xL4OMchu0GPFPJ38l-65g6w&oe=6A5F7753"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNqE3ikCDJIQ7kNvwHoQTrP&_nc_oc=AdopWRIBGw3UPb0_57GtSNg-S0I-W0U2Rz9RMLgJ-pdcwcXVuLSxqJ9qaSF8ZMzqNAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL17FIR-6656hbueYMOzRFkoZaldWdL1vdbhsi04iTpA&oe=6A5F663B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVknimpY9wUQ7kNvwGdLvAX&_nc_oc=Adrv8rf0r3UfReoSVOuGJvu4Ju6hlufSSZBduV86nw-gqm2bb3nzMkiieJTXnvCRdUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJCqqSWkmK--LnMMZl-eIGtC0Bb4B0Tv7XLUvuwtsEqQ&oe=6A5F8B5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1GsaZgZTjgQ7kNvwFkc_iA&_nc_oc=AdpDTfVxvPIdugqqK6g3RyhvKHmmVidO6v9-OrUYUSFuIenvkCD4O7jvWyFwtiIAMo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw9W7HPJ78QgXSCV0hFriTvtorv46BuRDrA1DVoJNl1w&oe=6A5F578D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH0OvyX_Tp4Q7kNvwGdNX9v&_nc_oc=Adr_B5JZf3uQ6VTDQCKd4VtwAqR9xliX8WbZgLJ8K3ryMOPCRDcZeP_hRM7T93o0dnc&_nc_zt=3&_nc_ht=scont
PqDOOk7xCO-CHOEQKLvDJybg1QJJIYXNsJ0buPRmOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnfsngaIyiIugL0Wdw14expmaxGfKpZCk1g5dD6JQPFQ&oe=6B01B9C4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqo4k7hnAgsQ7kNvwHDR9Bo&_nc_oc=Adqcq5hKbpyupakKqJ3a74bt5jMDMv-5NxH4VL3oUinMTaN_f-T3ENQPwOLWPUgYRHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq2FCXn5Xx2jqJsGI3hkB3fdT4GybK0FZYNDqGCrHaAQ&oe=6B01D183"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OX_KjM220h0Q7kNvwG-BJRA&_nc_oc=AdrGIZY433RzqyUSMQyFnnwULCWISTGqkks42eLKWjm2l1ZP5bHP65vJGwFAs5OInDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0F4uN9m-ImP0d7X3ZRK-R9FPiBg6tWD-cEon6Cv7RSA&oe=6B01D813"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6e_h7Z9-3QQ7kNvwGzpI1L&_nc_oc=Ado-lui34FucGIzrAVFEHjvB5DiP6aJzFJmtmRQQGpVyeWal4s11YimOApWmPNyj-zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS43y9AC1jsQdS0MALE52jmO_lk-KUj5jpxkDALlpFggw&oe=6B01C6FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IsnP9foLIEQ7kNvwGYOyh8&_nc_oc=AdpOzA1hhBIEe6Ij80Zd60FNFya2ufH-6K6CvrGGXJ7NetPIFg61XfAE1V_FxjeZhwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRogsDUdZrYUS16ciWInznmICFjZ50vA_1UFey4pcxZtw&oe=6B01EC1E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vngyd_sTMYQ7kNvwGz21Ak&_nc_oc=Adq5y5F1aaclQuOFs8lbrpoNxFr6SmsFOlTiW7mtyD4frT3p6P9pmgZJxBEUpZXIvgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOMJHYi6W7k5eZ6EmpbpSMi2S1Vzzd-ZXBb596NjFgqw&oe=6B01B84D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
dPOHzWhv1AhWcZKZ0XBlc8XdLALEW9KDRcwa2ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RBcH7xytGm7uymBajpjJ6m6tr5jNKX2DWBmfk85P-tg&oe=69DA4943"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGxKe61c8lMQ7kNvwEoke7T&_nc_oc=AdoYgD_5u_i2gPlA3uFP2Gp5513sd96ft2tfotB5E2jEPG3aDI8baM-GGYs3Zq-V0Co&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CXj_WgcT-09IRbQ7E--Uj_jppYI9zvw2ZdI3L5xvVMw&oe=69DA2A44"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSVQnxEdPvQQ7kNvwFD0gww&_nc_oc=Adpb6-pSsiOU7GbRmvRex_6Fd-_cDwHWvXrH-hyQsQEBMkK_T8NXRAeCBSPMQReGX_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xZjkBXCzpM-TnMTT6zpZzYBBrehMDRW7ya6k5_IpsoQ&oe=69DA2CC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gphRgwuvf_EQ7kNvwHtapLH&_nc_oc=Adq5pQeUufJa87shTo96aJmD2MY_xggYrAf0Tg5fKrRw7zg6s0TgVgiq5qAvvL9cbUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mslLkKxDKWXQFOjb9QOq5QFKE6cXhxscIaaXhe2GrBQ&oe=69DA2B9E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaZoQWVyuDwQ7kNvwEdWmJ6&_nc_oc=AdpwkP7Vapj9yc_aHVIwb6dN2AfZ5uV4m7PWMemtF_FRXLgqbVCjB5GqeR0I7DwGbQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ohUOxWuIGP1GxWZB2BJuuMrMuO9d0_NfoGFddZSPBZA&oe=69DA300D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCht8ssjDaIQ7kNvwGZGy9W&_nc_oc=AdolUnvU7MOdp7EL7kZSB7HJ_r-rECScumBIGqMJo35GK60OTh8fNgcCxn88OkVygLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ciXkFDJeBc88PNt3TeCDf6WETbMNPiAuwZ76RyT96ew&oe=69DA456F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
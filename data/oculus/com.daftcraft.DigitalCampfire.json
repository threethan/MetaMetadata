ca4PWBhzoQhS3q0GKjJCNMaLhHhYUJsp5dJWtao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SIxpc6hlrpbERCGzmOl-Dsi0h6TncXvqJHSGgF0nBGw&oe=69D50343"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lnIC7nLfo4Q7kNvwF9hVf_&_nc_oc=Ado9WZULmA9I1KOTY5q6D0K_O-Wtj8bwfAVDwkiox7PNaTHb-ub4gSNH3IPFrJ1Ajo4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09j-k3xSZIGKbnwsguSqUptqcMYuJ_Jf1SOHV1FDOorQ&oe=69D4E444"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-nJNgLCbwMQ7kNvwHxKIn9&_nc_oc=AdoS_s4qzGauD7YtI8pHYr3lYJ5mBbibSV1U34xMLz7wLccGXvV-zkKD62umrJXWR38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H4UUHq1wzqcwvny0QiO5tq4PSjsBW1mZN3yb9pAbPMg&oe=69D4E6C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgjrObr9zfsQ7kNvwFKGlT8&_nc_oc=Adr3EjeopJazbNA9BhlclwgeqQWgA3Mv4mivmVOhGsdHo2qrlFjKdwJzVJS2ipEBqnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rPtWZ7pb-jEqTLZfaCrUwvBNH1BE1AjX9ZOrn_jXENg&oe=69D4E59E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-zGrESfeE4Q7kNvwG3H61Z&_nc_oc=AdqPkBRHAlQg_JFbFycEFoYq5R3WTJPIztpaLHUY-XJjtnagKgQ_kxPd1vmN7qBURMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_hCBuoZVRnUAvK_yhjWelPNyFr5RYILuCqg0_jBg6qg&oe=69D4EA0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvHD-1uz0OsQ7kNvwG0epxK&_nc_oc=Adq2yefBWYFR1x36FQIi_w0MN96SOvL-ElgtrRKHPIVQMuL8GOMalMQ1-IKG5j338r4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lmV1ZOK7dCoFU9KuUQJhSwkDAA3XNmXfibgbQV0iF5g&oe=69D4FF6F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
evIh-my4pOUXuBmGConnvth5lh04DbS4iahZszE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BI4sUoDl1exH9CiNV4uTdMTdD2ne2-SqbpKvKj60tLg&oe=6A47B5C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1p3LFQvG8QQ7kNvwFPG3br&_nc_oc=AdoixqHcAABpg7r75RrrJdtm0_tSSTDnbDYlbcq-t9XnSM9X3GawYzRRpL3wspxacrQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eIpuLRk3lVrKpRABaPwBLJjw3cVvztJvqf9Kbxv0axw&oe=6A47CF04"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJgIzbY9HDoQ7kNvwG5Iq3J&_nc_oc=Adokz1vcDPN9Kox8I7nVjd13MHE1vC-m8_an52wr85oi69Aw7cUttJkDBRKpRkvhLwE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hlaX1CAl2T6Nyxaio-bRCWwy-Y-pFDJHeVot1FaNlGw&oe=6A47D188"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DYvxZ_c_V8Q7kNvwF55a7V&_nc_oc=Adpy7skQ8ZpOyweQzb-dZ-FRDfEvmCwQhbBX5qq5lX0PIsQcQqtSB6_zVOV2A1OoXFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90VFRSI3wbJZgLAu07YJO3M3MK84lsNljMcDhQV_ep-A&oe=6A47D05E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YJToR0Y36AQ7kNvwFh2koT&_nc_oc=AdphrYj2cjkIR3fQ8DhUoXEx60OPD76bawEk0VFqgdXJAxrO-cTNRMmbT8l8QfUcLJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t-fPIHHfdE7qYlhsy3Fc2KfiUfwnxHzHxKg2hPWyzbA&oe=6A47D4CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF2ZWy4tjGgQ7kNvwHlxn1y&_nc_oc=AdqSDy7I8I5SRigOgznXVzk8zuXppkykNytxB5m0_RLh-N7EzoO_5rfYxfwrQu-7FsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fkqhn2MjS0pw8b8PSnNXMy5nC4KxwhKccd8D7HGsRVg&oe=6A47B1EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
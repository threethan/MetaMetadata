O2SsNuHM7JWpi1Ka3XFeS4FxoXNw6VD874u9w2g730&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXnoStqgu5l6nvxn9EOz7i5BdE94Y4KRaO8t3OXLQCJg&oe=6AFB2244"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff13.png", "id": "694628618161382", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd7HCkdPvkUQ7kNvwHEikKu&_nc_oc=AdpIadmpzdgQhpDGH0UajS581e8Z2v-EuKzStj-WWY5HC9SjsIZXtUqftgF72muq2Hg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRASvPVxy8-6Sw_ktpZfRhvLLO6tfovKy-dqj4i9hjnog&oe=6AFB3A03"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQTaqbtSfSMQ7kNvwGnD70r&_nc_oc=Adp3-UsPN1VosK0NljzQVammlbGjf0qx7K1mf1XUQX5IimkLLsfNAONlaMUv6zLyFa0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx9TkE1i6I1zLmXwIW2pus2OgjytIRQ6GRv7VVsTo78Q&oe=6AFB4093"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVf2qKuxzdMQ7kNvwHSv789&_nc_oc=AdoCbRJ-iDIfHrNMn-rKhZBmnPROFflI1UssD8kyYQe-wPBLehhRVRGkT6jXBCuMF5c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqI_JyLHEhG9maW9_cTsUiX7ZoTGjiTm2pQrOT-caHaw&oe=6AFB2F7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dC6tlHqLhwQ7kNvwGBW4LZ&_nc_oc=AdqyEd3J8-Ie3J3Rydt7RnSHx343Tz9xtBJLPDpGLEFlZGxxsic0RjmnMGussejSOpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUkQiKEeZ3LHF-XaXQjhqP2ss4x29k3B9FG9Fi7iGf2Q&oe=6AFB1C5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZgHDb8nO8cQ7kNvwH12Brv&_nc_oc=Adr9VEWA7YgHDn9rFKB1pk9ooEITrIgw0uUannFtwoTIcYcDYc9-KTfIQHpo6GA1N44&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPVJFbyo3Ynt8YuKUDc4HQWdTlQrvjAsXQsEVtUIAIUg&oe=6AFB20CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u3
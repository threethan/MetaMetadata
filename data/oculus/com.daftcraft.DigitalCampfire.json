8618161382", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWQk6rDGUwEQ7kNvwHiahdX&_nc_oc=Adre0T4jzHnL78SOtIea-DW_OA4qKwloMtSaOYEs-ThsWuSaB_BU1mSmr-joV3p0R9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLn8x7NFoTef7aglDsx-vooGz3d9-uzgOvWVgwcMBNvw&oe=6A6C9FC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5-LtoUJB-sQ7kNvwGRow2r&_nc_oc=Adomf3L2DqRvolP_gKoT7iC_wKOtYPxThLiSTdubrhN1wVTOBoJMEVGoJwhRTUo8Z18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy9B5e_ZG8I95I931yPK52_RVqmXWLE0TLZvW-1ALVXA&oe=6A6CA653"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3cLlBvOCvQQ7kNvwHWQVCH&_nc_oc=AdqAvQvaDdslum-4Y6ZmWToEarccyVYInwGbnCYiF0a1lVp1NrebcpSLpzHjqTIfso0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC61hN1-1I_dyFNJ2uLJfwohE1MxODDcJw5g5bmD0Gh6A&oe=6A6C953B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5lbKMDPp0gQ7kNvwGriENX&_nc_oc=AdqNJo6Hz0hu6hUG7FCP9YWLk5kT_pT1ZT1FeEYCLuHCFujcoqyhlySWv6q7WaOLW7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeEKeN6uI1xr43ZlL7egF7HN3R2R0JG2xm7UNurosPlA&oe=6A6CBA5E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPv6pvgR670Q7kNvwFEK-i7&_nc_oc=AdqMpMR0v10nKIdRjtnpKkPKrrx8-EuBN88ycAN5t-tzmdjX0yIWQfsBfPEX43g09DY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC_hx9l9eA4OrGl5eBXGpIGxfBJefK2SmHGZeLgbRjoA&oe=6A6CBECD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml7Ihq9FR00Q7kNvwF8OhdG&_nc_oc=AdqvSqBFG66YT8_SRGsXJdtlAB07P2bfeJ6xBVbOYmAV_br-M4SDkUJE70NCSIFnALw&_nc_zt=3&_nc_ht=scont
_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPmusNy6ZgIQ7kNvwEXrgrf&_nc_oc=AdnsiAO681Q1lbml08d7UhavFmmQx69rOnfztQcJzHiPHKJOvmzXLGY5K2Td_vJ3Jsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFBKpaP0NogKMl3FTPpDEivN_IDI5rQaR5bimwWBIvyw&oe=699DA443"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwkgJGcP2_AQ7kNvwHhzDQf&_nc_oc=Adl9hKWuWRinj3B0pgTy0b6Zf-tB3nAX1zTJE0jsXYRPmiiCji_zVE-fLIhlGg4DxBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuc1cxGy_bvENYGdZv0RiTGLbLoSuclC-se3ym8UyMUFw&oe=699DAAD3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bq0yvqJca84Q7kNvwEyN18j&_nc_oc=AdneNKRAU7L1MQCgecCzYp4K6YTpipnhGxl5WAU0gM0ZEa8HdCL8Qov9s9mPA0a1GUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4aSpxvlexRI-NILmhNeo9GpJu-fQ268RxX4dRf2M0kw&oe=699D99BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0awu40hst4IQ7kNvwG2bgy5&_nc_oc=Adleid27iqyAqrVJqc2TPUzaVQU-hirEOaINifwuW3W7DgIv0K8lWdQpokrC3gYw4_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjV-ERf1kNx2ujFSTAUdhzHiFqK-RJahGLG4XKE4w83g&oe=699D869E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzUBSPpBG_YQ7kNvwEdC6kI&_nc_oc=AdljVFCT3k6bzSw8xhsB7_Zs04aaCShvKti9Q7SOtxXQyJJqB5rhyaaNRe178o3XZ28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvT1VerYsy-d1ntoGFvCy0qVFAwyaVGuT8UrmYKUC5q6w&oe=699D8B0D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBY_LtCojegQ7kNvwHUEn7V&_nc_oc=AdlegHMcJi-VZ0BlswVudJ8KIAmmU3ks2siK3IqBAcLA0eTTaXfaxsw_MWqTEa6ylX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv13mV0viaXzQpyye3uDqLX-e1NbJublpjonWfH5fNYKg&oe=699DA06F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_C
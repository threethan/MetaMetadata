LVCu6wfguWFAOkbMeAAx_P2iuX_J6bH-BZ7fhJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UAB9Eeg7efRcBTql_8Ne_wHzRcVJ9MoY1ZmxQaJaAmA&oe=6A0327C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPQ9uZPV-ckQ7kNvwHQnRLl&_nc_oc=AdpwqpfDwgsdVr2wWX1t7zclLyHSP31X-ud5qCZziIsJmdRCUfofe4ZmOzBL7_xUjKw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j_3_SjbyqeM_D1ysLyuJWnONuWIQNAqfNKhIzQW41HQ&oe=6A034104"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1E4O4g4ZdQQ7kNvwEmRIZX&_nc_oc=AdqV-lbM9rMKE_aLLPwFFxjFUN8bgiwAgA2Aa61np7rViVtL_HyTAW2ggQRdWUMICwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HrSXdkiAJau3LsQEOAUMIXaFCRpj3bzbZsRc-NgyV1A&oe=6A034388"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ2At_RGDzsQ7kNvwFk70EP&_nc_oc=Ado9tQjCDK70RbsH9z68JHWNQPwRpqXEjDOXDoFIAXevjO4cOSoOdXHztxsEoEk3zvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VVpcBSF4bChBEng3Cgmw6rD-oFeNWVnoC1YE9yrVLsA&oe=6A03425E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2YcfSTmdTwQ7kNvwGlZPDA&_nc_oc=AdqSaNePoXFv0W11MWILLHbSlOu8jBo4ChTao2kSEHaWGFkoE-aozCtV8aNlu3ll6B4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54wqPE7R2GliC3bNb_A-uQDemjjmBaeC4p_h3LMIJchQ&oe=6A0346CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IafxjMK2DrkQ7kNvwG8dv74&_nc_oc=AdqwBr9wlyJ9Wj7cb0FQDR3bxiEHyw1TFfWH88LiCDR6_xfpmXylXZ66RsDrN1y3Ky4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gTLGa8OOWMspx1nvyLBmxDsqkQWwlsuiHKEEaBxFKGg&oe=6A0323EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
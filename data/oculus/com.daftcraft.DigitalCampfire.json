2ZMY0E0HXdlsti0HjLq-iH-NcbUZ3PMpspwP-O8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JG4I1VAyZxJkTx5ZRp5bRiZdHxKeaVwisStPpdKhj7g&oe=69DE3DC3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyS68yHRxJUQ7kNvwGWoWHE&_nc_oc=Adohyjw-vp5ULRbjrh1War3jmx9gdfyytKEin_2w0vUToFYywIPV2Or-MMSUxfOGGGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2u-uhexTkbeOLljGBfNpb9b7tGk5e-A7fz3XSpUsvvLQ&oe=69DE1EC4"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb60EEhEu8cQ7kNvwG5ubHi&_nc_oc=AdriHgieXdqVh_l7q8bv4YnP29Uvbh3qPLJHND-qsbErKNDZZgvYE0Cf-_euBrAdi7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZbksguRnfR22J2KOn333sjeQrcKf3bBQz39sEKXcdGw&oe=69DE2148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0g2RAPqRSYQ7kNvwFNiwcl&_nc_oc=Adom3ECCtMzHPmZuP0QPDc6k15GUJZUCjG0dGMKpULPYJYqF66eD-5WozBc2CqcEnDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zrbJtb7QyurpFPA6IsZ_lKt4eayJrEq56oCgXsM-eFg&oe=69DE201E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADAaPIvGrSgQ7kNvwEwXt-h&_nc_oc=AdrQFcZR9h7xkZHcLbB1CxLS6bghDL551W0uX790Le8PEF9Q_HuYJDB2BAkmfR2ZrLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uwHmRhMY1cEoEMluIocGjwYtGaWuJbArOgRf7VoyxSQ&oe=69DE248D"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGIMx0UJAREQ7kNvwHN6Obo&_nc_oc=Ado4Q8ewlmBjSSDI4a8tAcgYkyP--OqA7tu23eNYmtAmDhIcKioqdlAUpry7JyCyS8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E3gSPTiklUQdJ_LgkN7Y15-1uDn1cgifphvLFII7EKA&oe=69DE39EF"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
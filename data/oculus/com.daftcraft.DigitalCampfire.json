8618161382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031365_694628624828048_7207905928164471739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltwQXLEhmcUQ7kNvwEVpWF6&_nc_oc=Ado9XRnH6PGynC4KYI5uLwhSZuEdp-C4sgEuC9ydllSst4QlQSIG9YZ2GqOrTHbkaso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaFG7v6LADQG7UUD2PxZNqbFKPaqWozKJ-n2pOHQDQbw&oe=6A6759C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "270487908181875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_270487911515208_4164082439201461975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG8y9l4x2KIQ7kNvwHXoxje&_nc_oc=AdpESBaK__ByxZr_sO2xc0uRxLgtbdOz2ewkas7NnUEm0o852ynFVzPPlr3Z4FKjRyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwjuPzEvjmZHu_ZKCy3IghI1vtClxSnm5SawdECdNLog&oe=6A676053"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "227959255938021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031483_227959259271354_9132655420635688492_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGzf7sWiF_QQ7kNvwEZ3yBO&_nc_oc=Adr1JajOO9T-XS-vNDs1OdAJm_aVm-blsUKjiP1NDo4Dsb2pd2isKRbsx6aQQF3SgZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8M48sCYHGcapWvtwIoVgccBRalOOfzQQTa_o4mBRe1w&oe=6A674F3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7l1w3KTpG4Q7kNvwHVzwOv&_nc_oc=AdpzmJZhiXKTJEdVPHsFppTum36wyo0qXfBkCUYWzKmW5-fqu3M6Py1BCE2ng95NLt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr2AsojzvDZtlkY3a-bA5yHTtMyH_q1Afana3iFcp-5Q&oe=6A67745E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgEs27TcV_MQ7kNvwH84nbR&_nc_oc=Adqggf34wMrsDSF-Fl_xgNGqwYQuD5KFoMX2x_DoxVg8lcmxE27Ygmj0ARuCwUIBr-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwhLpc40xykm1IuLW9gmvq3j7YVjwb0rm6uJAECZoeUA&oe=6A6778CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpvTDlxfeZ8Q7kNvwGwGeMw&_nc_oc=AdqC0ggfd41B2ldkP1aycXg-ubqn9oOQBHvHf44Ne2Ivm_NXNQ9T_tsvOSe52--VWes&_nc_zt=3&_nc_ht=scont
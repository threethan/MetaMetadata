M2SKTdej5kjEwmBoyj7wCCWRST1CMPtFXgnDSKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZf7ItRqKhxxvZy9hx1Ixjnu9drby60-XwxQDVlYmc4g&oe=6AF35103"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff15.png", "id": "624834208483289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031506_624834211816622_2109387924173311950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKhD52Z8DYAQ7kNvwFBPCpp&_nc_oc=AdrMLZ0etvxf3lUar5xe1-ef1lXG1IZem-P5zceBTCe1lPbpgMHlnpCM1ZxBmLWnpX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbTpQUXYpuoVMnKpnBVEvMiFpZo0w-UCXfdbUr_W9HbQ&oe=6AF33204"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\uff16.png", "id": "1237353566690056", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031351_1237353570023389_6271386357945776354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIomxvudTskQ7kNvwEEVVS8&_nc_oc=AdpY7bwaAn2oVd40PJ1HYgh7cv57jnFQbkDi_jFf91AEnLFrYuPi6AXeXKps1dpZXrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt8nYtbYQEJ2J4qPvCoorC7JXKp1wIN1qkEnhlPRLGDA&oe=6AF33488"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30cf\u3099\u30fc\u5199\u771f.png", "id": "922745501653731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572925_922745504987064_1064929762484899199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IYSQ-ctllgQ7kNvwFBN6Y9&_nc_oc=AdpI70kh9dYUwassreb4ubVaAjsboipBKS7PQEOtxt1u46kTjw2FQmP0IM8RKB3Hg4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQlUMdVBtjJpvbFkAiOsO1pqcLwf9y-RWLeHYlZBN_kg&oe=6AF3335E"}, "display_name": "Digital Campfire ", "keywords": [], "long_description": "\ud83c\udfd5Easy for VR beginners!\nThe functions are focused on a few, making it simple to operate. Even those who are not familiar with VR can immediately focus on communication.\n\n\ud83c\udfd5Small space for your acquaintances\nThis place can hold up to 10 people at the same time. This version is open-space as a demo version, but the regular version can be used closed. So, you can relax and enjoy conversation with your friends, families, or team mates.\n\n\ud83c\udfd5Bonding in a warm & cozy space\nMost of the time, it takes active engagements to create a bond. But maybe, sharing a starry sky and the crackling sound of firewoods could be enough for us to feel connection to the people next to you. Digital Campfire provides warm and comfortable space for every people!\n\n\u25a0 Spec List\n- 10 users at the same time (If there are more than 10 people in the room, the mode will switch to world browsing only. )\n- Voice chat with spacial audio\n- Full body avatar (2 types)\n- Cave & campfire world", "short_description": "Looking for VR communication app? Digital Campfire is where you can enjoy VR communication and campfire experiences! (*This app is a demo version.)"}, {"images": {"nodes": [{"file_name": "TemplatePortrait.png", "id": "1899961576849564", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001704_1899961580182897_2064927627623761242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcxpPs5h5CwQ7kNvwH9vDW-&_nc_oc=AdoXWlmJbDMftMDI_gXdQ0NQ50CLjzmQAj8U3Xqx-WoEOb9XFfNaOVNo33ipPYmGvYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_EOy3GISpztCkRdjzJJDu_UViOPI0v86Qi5m7NzLjhw&oe=6AF337CD"}, {"file_name": "TemplateLandscape\u306e\u30b3\u30d2\u309a\u30fc.png", "id": "1552058528459711", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031398_1552058531793044_2218360000003611892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYP74fcc0gMQ7kNvwE_fV14&_nc_oc=AdqAMPm1Q-tIG-zJKmMVQVoV6tnkw8RFBYPTF92og3cnsG3ttdg_87ckSSY_2I6mzps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAbEfMUZYAztStIC49PxQJQCTRS02iLj7bXDqKlNvpLA&oe=6AF34D2F"}, {"file_name": "TemplateLandscape.png", "id": "1172877306521699", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "http
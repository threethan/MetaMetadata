=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S18YPUryXKgSqs4UPdjpvm4r597NkXju4d4npi2CfbQ&oe=69D64C78"}, {"file_name": "SS_4.png", "id": "795281421717864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221325_795281425051197_6294724789789942102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m58j01Kqm0QQ7kNvwErlGD8&_nc_oc=AdpPjbyz8d7tEth997pPi4zav-85LpR_OIDjyCRBLXtLUawHgJUOljB1nvpkymAQqoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JmdLv8bzXGlikmVliNi-_WRvoxeRjahK12xcryDBKsw&oe=69D63F74"}, {"file_name": "SS_5.png", "id": "844417880260310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75542961_844417883593643_1000434146404476364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h09bnHGgKgMQ7kNvwFjDx6I&_nc_oc=Ado8s4HqOZxm9PiJQrCgFBCim9uWCVHgOQUbQfYb2YS9ef5be7Kt_olv4i3ecUuUQMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I3XZ6k90dSQ_RDXduMSv3Y-1GdLm0ym-_A49mVXBj9Q&oe=69D64C98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Farming Tractor", "keywords": [], "long_description": "\nFarming Tractor is a single player and adventure simultaneous game for VR game lovers. Take a chance for real life Driving and Farming in your own farm, grow plants, feed animals and many more farm activities in the VR platform. Drive the tractor in VR and park it properly, feed all animals and grow & harvest crops. Also watering plants and doing many more activities on the farm. Enjoy the music of chirping birds and animals with a real tractor voice. \n\nPlay tutorial for understanding gameplay. there are also two mode in game: \n- Only Driving mode: In this mode you can only experience driving a tractor. Drive and park correctly the Tractor.\n- Farming mode: In this mode drive tractor and also do Farming activities like grow-harvest crops, feed animals, watering crops and many more. \n\nFeatures: \n- Grow and harvest crops\n- Watering plants\n- Feed animals\n- Nature music in background\n- Unique and excellent graphics animations\n- Real tractor driving\n- Tutorial for understand game\n- Only", "short_description": "Experience Tractor Driving and Farming like your own Farm with full Enjoyment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vr-lmgamestudio-pplink/home", "developer_terms_of_service_url": null, "publisher_name": "Frontlink Technology", "support_website_url": null, "website_url": "https://frontlinktechnology.com/contact", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "945871366369351"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1233766822150787"}, {"status": "PUBLISHED", "id": "868395885798338"}, {"status": "PUBLISHED", "id": "1779134922786051"}, {"status": "PUBLISHED", "id": "857365286819919"}, {"status": "PUBLISHED", "id": "4071034496468505"}, {"status": "PUBLISHED", "id": "683623664386774"}, {"status": "CANCELLED", "id": "1799293860640924"}, {"status": "PUBLISHED", "id": "659337179941817"}, {"status": "PUBLISHED", "id": "1282908315836612"}, {"status": "PUBLISHED", "id": "703111777996290"}]}, "baseline_offer": {"id": "683623664386774"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1233766822150787"}]}, "liveChannel": {"nodes": [{"latest_supported_bin
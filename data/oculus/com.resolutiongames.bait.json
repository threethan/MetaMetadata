cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc7ep4vFYKQQ7kNvwF1su0e&_nc_oc=Ado3uDTD7gYBn2b43PL4nvJHbk2HivVzqxkYJttiGXz--DuWaqx1eow0V4q-oqmK4A0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OJ5oWQ6chRu25BsyW7sbEIqt89_yBoKS4uHf3yWzbpA&oe=69F4A4AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MyUXAc6HSgQ7kNvwFdS5t8&_nc_oc=Adq5OZVGC4j8Qcn_9YtbaMLN6xTqDfYmPu0Rr6e4nc3J1IanLapkNRcqjK1ll3qGL8A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MX2B9iYjDKMnTDuVSq5a39uHormn9dgDDM1tklmdLvQ&oe=69F4C345"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnCCDTmIUIUQ7kNvwH2MQqn&_nc_oc=Adrk3WO2mS3kasOuM6Gf5uCUGC2hbPa0-eEcGfGo9TkANn5rjeSA2Kg218J4jfDPjB4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rpQM06wn95BAte8S0nWrbpxq-x7siSb2uHKJqoTF-2Q&oe=69F4B921"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8YU16hD_94Q7kNvwGYCzm_&_nc_oc=Adr0iDdXBlF6iW5933CkmVUEG3TvMVtwgy2S6vI7z6bIRnrYy6ApMONlMN8bljU3UBQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hxag1H64GkZ-4a-Y_Up86UvgLXSieaNGMa2LRe7Wutw&oe=69F4BB90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j61qFiR4T_wQ7kNvwHfI4kU&_nc_oc=Adp773LX17ZKX8R9L9XCa0u__X1S74msh3VavCusgbpv3pjU-IxyDMf_2-YWLg8Xhk4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BM6_1jxMS_QzjBz-9Rcfw70SlRid9gmpd5VPHUEdkxQ&oe=69F49B73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
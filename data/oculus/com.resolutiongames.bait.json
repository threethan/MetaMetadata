cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3V3sbWHriMQ7kNvwGiDEPT&_nc_oc=AdoM9BM_8Qh6WuT6lTOksgPbhZ2e71SUZIa4TdbY04sWn_YTNOdP7wkvRBzx7EjdQE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_LYQprMO74mXBNPK-Jdbf5GykRmL9OwBrzF26_scNfw&oe=69EE0D2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ExLp2lREzAQ7kNvwHSLQUh&_nc_oc=Adr_SHcenHWQRwDOX0_uRuKEA6DJWWOcmfxUijIvz-EUrDHWhRUpsKWEPDt53QQHC10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XwHLyI816s-O16TLBbrw3FXJVl9ULEwh2b2K5lRviEA&oe=69EDF385"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0prT1vHVZsEQ7kNvwE8Auet&_nc_oc=AdqFdKbm4HzHzes4VYXuLwiiXYYEJP1EM0A6HVLNlZdLswoBS-cFdDio-8gzhVl1IWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oRGykKT4aSfV90bss5sjpB1H73IZYTibpbh5Aola5kQ&oe=69EE21A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf9lYFApbmAQ7kNvwE56jQS&_nc_oc=AdpP0fappuITvfV71FOq66DZrcVjFQDlRV6_9XrkC6RnYdDmw9_PsN5nut5ptqqy06E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f3ELI9nbeQVu7CIPW1kAUlqqv1b76XpzGYcsUxgGSpQ&oe=69EE2410"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8DeSIF5e8sQ7kNvwHlDDUc&_nc_oc=AdrW40FOgbToeayMFVL7jpHvBODQwC5G-aMp58C0DGXJUuIyrfJVDbhwji2gxr3BrV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08-f_SjvqLJOQ-0G-_yro_UQ1K2jDtuObGBe4N-DS57A&oe=69EE03F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
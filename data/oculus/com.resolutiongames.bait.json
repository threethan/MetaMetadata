cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pINSmbHhCTkQ7kNvwGsYQgI&_nc_oc=Adr1RHjiW0js5OEMOWuADZTCkRB_Mz4aqdE2AxFul-lABaxaJ0nm6c4b7UHwp2ggJvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3pxCumoMXRIsUgMhazDF4GlRE6kj3M8U5CwVxAbIbRQ&oe=6A47B32D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU5DNJtLLz4Q7kNvwFZsuwq&_nc_oc=AdqIdmJY82BBS-GoudUjQQyBPBec-UZzUggZL8z_9GWR3l__UDvSqvY2He9RxP45t9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_awCQRqXpc0taj22zKIx3WO_YkvVC5B6SNGA7cimZCag&oe=6A47D1C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqPi9bchwBsQ7kNvwGcDuOs&_nc_oc=AdotVbADOvKL9FcVpB8htSVooYnXWrsDg4l_kJdhXBQ_U08YUDmc1TIxhjk_BB3pHrw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ngz65jcW2zZtRnaEDajeLWfBCX4frJh_uB8oshFOpEQ&oe=6A47C7A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRO9XVEjc8gQ7kNvwEaLKQD&_nc_oc=AdqlaSKDx7vQjcmUKkEdszhsqgCRM1_u2WED-QcZjfmVp222hUUjoRURuYWh9meX6ZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BJos7ZWEg-o43uI1UVV0mcr4XreXoXni_d_R_DMSGmg&oe=6A47CA10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfKQJGocCcoQ7kNvwH5Pzit&_nc_oc=Ado0ZUNGcFJDF3oreTeOt2tQrTyg0-zfDAZ3k_puGmB8lSY4LF4l97xUw9lUcxnvLIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i4KgkjgoJCliFGwWky4doQoapUkpJmH-Qmi79Gt6sKA&oe=6A47E233"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
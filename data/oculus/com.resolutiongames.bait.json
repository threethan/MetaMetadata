cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNBAQ2kWuaUQ7kNvwE4xyvN&_nc_oc=Adp3nS_9fJGC6ObWCNH89iw4-fwnU99UVFDQFoj8IyHdeua83Gmse5R9q2NryqeKkPs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ93VwB8S7owU-vV6Wc6NrMSCaf4JhkdimGdrmLZ7hzg&oe=69C28BAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSo3_nDLDb0Q7kNvwHd65sa&_nc_oc=Adq_pU68ybBuvK-tyAtU3e0eCgwFXP9dySkHWPb8uyYKXdZRMwIyyVJeT_wlb697xTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQtpTDqm-w9mz85P-MoxZ8lypds4ls9UnvO0e9To4jBg&oe=69C27205"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7VtVwcLMqsQ7kNvwGIkBDd&_nc_oc=AdpDOblcz0Ot9VRMutbTX4RPLKRuDSODdbLF6olBfYeTp90Lyx29SXet2HChzmcfqeE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2MOPU0rIKnkTD_LNPJGT0gw-tGFBFp2GMNZ065mJBXQ&oe=69C2A021"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=878qZdrvLTIQ7kNvwE7dlE7&_nc_oc=AdrFRFoCTP39ZuE7tcq1fJvrfy2CG-sbgR6AneZY1TLTzyJDd8K7l9MmbsgEDY2_IJo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI7y8c2MYrfiVSGMbifq7vi65YC-fbVpKX3MJKw4ywCw&oe=69C2A290"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJOnigw9nf0Q7kNvwGQDXMc&_nc_oc=AdpQ3W9PEAc_Yqqmd8L1NErnoCPPRlkirZ-uCgFC5lUT0DOxb8LpfcJlWXak-hUKUCY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4iXXjIBfF3PROLK2TbnPcLaHCEEzmUsbV_zvRTFzWhA&oe=69C28273"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
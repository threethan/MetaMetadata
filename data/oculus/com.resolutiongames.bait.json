cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej1MvxtGAjYQ7kNvwEXCzSm&_nc_oc=AdpM91KcKAE9Ptve6JzS0yuNfrD-Axb8KtaKDYd7Uz-ipwWOzBjRZHkNp4s31ixQGq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoEn4CbItSdnrVHOO9a8G2ZzxLhgkmz3H5opJfHyT75w&oe=69CA74AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbCTpQQdXFAQ7kNvwE6M2Bp&_nc_oc=AdpGS0RqvPHbiqjrmj5Nc9sk_KlHnu38tX_TFkwAbqCayrnI40AvouYD7HM1Lups5BA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPectQoBd7EYBCxQe3fwIT6j4NMBaWMqWDTNX8IIa9pg&oe=69CA5B05"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keA_cyvk52oQ7kNvwHa47Tl&_nc_oc=Adrn49O2Dfim7p1rN4yrc6CPjyEj0iFs65aX8z8AuuePDglXURtbGSG8a9U6XcKlq_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYa34RHo616qHfltQzymIicCyDx4pUgXJPmOZvgKrSqQ&oe=69CA8921"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hmyj_lP_LEQ7kNvwEDepVj&_nc_oc=AdqUYLwFzO4Ku9XX6mJy3ipmKdK2psRcSRxW_UFUoPNaWDMXDNeqUvsKGQMV4tZcJ84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-hwxcgNQnjOM9Mj1BXeVFbihRBUpI17RdQcAUblHQ3Q&oe=69CA8B90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAdSpFDfP_sQ7kNvwEsQ71O&_nc_oc=AdpfsLVfGjtXYbu4iERxMiUaZ8hOBjRle8zrLr6jlTIsVUCGU-NWwkE7cyNtbbj2bSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKP7g_SaeHDLkvsbcBiLK18WJJfoT2hyn8j0CQ5LQxOA&oe=69CA6B73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
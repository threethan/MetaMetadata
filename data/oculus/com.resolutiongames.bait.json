cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSWfAnM3vwQ7kNvwFnXM0Z&_nc_oc=AdojKd41OSowaDLfN75w5Qm8hLbXPYaGfQkPKqfFuRGDLKqAc0qTEnS7pRn2a88Y6nU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaHoe-P6IIlGOpW4YNShulKfbM99HX7YF0hxMbO7hJTA&oe=69CBC62D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbCTpQQdXFAQ7kNvwG0qnbe&_nc_oc=AdqtzT-YkUg0E9rFBP4TrraQ9lKOBiKo0oBYmTwnk8IavdYvuR4I5TIEOBKiO2Y9hec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy93W1EG6pJWeGYrR86_yciIZUzvvhFUJpWVucJK0Srpw&oe=69CBAC85"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keA_cyvk52oQ7kNvwFak6LO&_nc_oc=AdrKBX7IdBl0j-YFAmENFntoqUMTB5FvSZx_3B3tqgJOltS_hjb33nHlhiYJtz0Hk14&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_2afsZr0qe3ImW9S9ocdsCJeuOx9k6lKtLa1rHXu23w&oe=69CBDAA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLUFfB_67hMQ7kNvwGQVacy&_nc_oc=AdpU9XdtNmkp62F47cUCIiqV3suhbq23mecvzzyRG-nzrQF4rLbGSQemX3xtKlQjMKo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzryrW-Ub32jvHRIpOsXWy_2sV4eHRli9y_xQAQARwZWw&oe=69CBDD10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAdSpFDfP_sQ7kNvwHT5Yu-&_nc_oc=AdrxYVPsA-0E5MfNXqv1mlRYd6jAvo_tUWxzwUUCIBg66DHTgeE0mm8gmvLIZBavRwM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdeMUjn-MFWSd08NXPhiQW9MEYwyNFzj1az4BAivo67g&oe=69CBBCF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3V3sbWHriMQ7kNvwGcG0NH&_nc_oc=AdqmmyAgkhvpkO8rn30YmAUN95QKO96LL2PSL7ByFvqXPpUQRi7ipPygPwzR8Nl7qW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1viEUOqnednzFVWKdAWvbX5R728Bc1rLPaccoZhzcd9Q&oe=69EB6A2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sax_qGvjnt0Q7kNvwHnBiND&_nc_oc=AdpunU8XaHN8nz8bwMsz5rT_RUlm8lpLf0QO9ms94YQfAWgXAsFhllaCl7PbF2dDRD0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zu_QmHH4zDVpeNj2WyfBELzddWaLJfETY9G-dP1eLJg&oe=69EB88C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s9gtPwOwFUQ7kNvwFGmM6L&_nc_oc=AdoxW5zR5M79FPaTtNonxeVQ-2H07sPogKPSXnKFUunrJuh6UKE2Tcu5E0fq6h8ao5g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xh_cNfLJJvKbTvk88gvAY-FiUiRPAGiKSSPro8YyORw&oe=69EB7EA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf9lYFApbmAQ7kNvwG9E1Qp&_nc_oc=AdrokURMEhtdIi9w3Dg_us-P3PFXl7JgWGddJER3mU1ScRUbtICBuoGCGK5P2S3h84c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c-DB-IGb0q-sfMyPacvGT1lRDWTmtjzsKc5kqLpDKWg&oe=69EB8110"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF0-_YPd5x0Q7kNvwHWnrZ3&_nc_oc=Adqs8BTe4MDhRCjkdqjG78MmRYfNdtptTE2E-IDiQBvWsUOdacHralxYwzgj-UF7AI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X2rQzPFeSqtnvhtDNAbPxUv4pMctw4mQohHrpCMnNjg&oe=69EB60F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
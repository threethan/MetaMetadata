cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVngW-UKe3EQ7kNvwFqSdec&_nc_oc=AdrDxEkpRQOmn0Nbtu3YlrkjOrWU7KAupwKc-cZJNffNqRpo52mRM_y8ot_tO4k4i8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yuBn3VIFys8XByHZVFtVCinY9TvGI3Q-0MGnZS7_c4Q&oe=6A2960AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW0fls9FUSQQ7kNvwFlKnF2&_nc_oc=AdrmfeRC6vyPffGA_hBjw86yVSCCDfsi2TyAappXg26mT1OMAiQBn4OhGW37MrWAj2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_1g0f8Bw4RhMdxWVoVIVwzyhMvM6k2YvHdMt1m2Aevg&oe=6A297F45"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UViME-UK3MQ7kNvwFKp_IA&_nc_oc=AdqtK8fhSqedZ9HF9Cktd4J9gt0aNi9ZFmRL3P_6JIKCVRMGwRZRDSmckwSu7dF5tMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kILsjWczInu5OyDfvXggDhSpbfSl-A2cCdmR72ZtKpA&oe=6A297521"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obt3ewgNTQIQ7kNvwFKHZxK&_nc_oc=Adq2FehnObDYocGTp1cV5yWDtakUMf8lmCtNSeowXxcNxxVUl3eFWzwOnhFvJXqHZUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A68Sml2gqmo4AeQ31EZ1qZoMPS_0FYqx2q2NhPwwjfA&oe=6A297790"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B16RNnBFn4Q7kNvwEKjtf9&_nc_oc=Adr-aBTfhoFOUCn4dnenMB7wzsGdCehe49PgKEPAqjLpvejBZbOAi_xSagoFD1xY1bY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_haRYGUGRmhj7hbR1y5nFQoVq-Ks05VCYl1rTQFSjoXw&oe=6A295773"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
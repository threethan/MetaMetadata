cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3V3sbWHriMQ7kNvwHWaBTA&_nc_oc=AdrlkJbYPWzz77hDAkZoqRumZmStqlFTZWXxDBgbHr1cid8J841RcMh4BFTyWFRjAJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af075rGaGcQNqPfmSw3diUMiFBX6Mk1JrDh7ffAy6dC47g&oe=69ECBBAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sax_qGvjnt0Q7kNvwHYXuVU&_nc_oc=AdoZH5GoXamsjxkNFq8NBT4VJtsj31P17IGoNYGq3CVjii8Y7L6gO6LuPFFx6rRfp0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y3iTOI4BUeCx_otUyA8r1cDQhX5VnNQf2TwaMQL-K8g&oe=69ECA205"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s9gtPwOwFUQ7kNvwGMp0vt&_nc_oc=AdoKSBRE7WPoXEZEzm5c599p0X0_kBwe-T8FOG356WE_195oHUCi51bKDMSfcgxmafE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19dPQckCzsfvsw4PwwScP7tmPXe_6GvzKGzCbGz_r-sA&oe=69ECD021"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf9lYFApbmAQ7kNvwEEFrEX&_nc_oc=Adq_mcIPbOM5uU1OLz_PpvLuYOBccMH0HKpOVYXALYm2wO-AVQqytC4BoXPYlDJYvlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z_7yU9xjXBbvFcul0QK9nebyMk8Fz_xIah84mlm6Wzg&oe=69ECD290"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8DeSIF5e8sQ7kNvwH6tUK_&_nc_oc=AdpMRSpNlvWarx-5STKyI_QYWP_--J90_jS_-QUo-Pdn2eJqeU4Xqax_1hSC4YdcRQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21svWNlaur9e52gFcCWtSVYW_PecL-3EaCcczSf_9gxQ&oe=69ECB273"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
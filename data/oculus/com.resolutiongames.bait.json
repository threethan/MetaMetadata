cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnitvOZ9tYYQ7kNvwH5jgxN&_nc_oc=AdpJONV0m2zaSErbQW9qC6uUvwW8il0faEFEd2fuQVx4RtaGtIdtj_FXpJy0FBvBmSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73K_Dwv1Bth2zMkSC855LqKNA9Su2AAbktZtV1eTMB6g&oe=6A1448AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBNPLC1BaJwQ7kNvwF_g0Ek&_nc_oc=Adr_JVJaP4Jis9ajUaf7p_eUmfWx_34OIVJJu7_gRM-oD9tqUK0lJvrx9oPQODteyRM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eTtW95ZyJjJBsi4f077yym_VNTdyNkXrzlGfVUfgFvg&oe=6A146745"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H0s8ueJmpcQ7kNvwFmSWob&_nc_oc=Adrb7qGS9VOsTQXPgLeYemkiePiD1Prxqut0ZKpdosMUTKxLy97NS_PFXkB2mbBCLhM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4njyTsKmENWqXiWJ9DW1Ue1y2qxFYhGTJFYWFWuqLLdQ&oe=6A145D21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9-AVh9ZpysQ7kNvwGbjPjY&_nc_oc=AdqMvlXF0vcs-QaTo1TZTSwlyZbV0bZVHnXrzVSeW0VZuGKIbN3YvIgiQ1qTCEIFLyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7imiZx4ktevOpre3sFwimu5z7hPhSvSWTjExX2WNupXQ&oe=6A145F90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOWMAMo1psMQ7kNvwH1OAt_&_nc_oc=AdrbwBKBe_iAcwzE1XahP0-XUGxXXaC45VLTnMdrE0qLEKKIDKfIlzxeZEe6XS1J9CQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MLVK-1vDX6jns9bSgxEyK_XnRJJjEI58ghsJBZCa2AA&oe=6A1477B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
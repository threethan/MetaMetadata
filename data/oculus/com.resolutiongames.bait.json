87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkqjROaJVY8Q7kNvwH3Dctm&_nc_oc=Adkgb1bjulxN4bCKa-Ol0ArYDzcF8ZWDp2d6NSeG-_z5ikDbUFBWevr5bmDalsAIYPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIgUO-Xu8bPia2XlBc3X2B0VqbDGi7d6C4_bste01qkQ&oe=69AC222D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKy2kC_2Xq8Q7kNvwHHUJD_&_nc_oc=AdnSJWRfXt24xzYORnv2JVSlGS0BEa-IjZ0Qzy2dtJ34jgFckRZEL697u6mlxjeDnlI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxc4mqAXWWAtkYt3lzeMaCcJGz_xl37xfoowfPozWSiJg&oe=69AC0885"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8-Kd7tGDIQQ7kNvwHq9Xxm&_nc_oc=AdlHzFiQPRxe5DQfpciAXKs7ozy14wzQ3bXDlVlJ0p2gpYsFoQwv022MBJsxtIq2FNY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQ3QRxTCslI4b9URcoPFfH61hS0_y5tBJBuLpA_SnMUw&oe=69AC36A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RxNPzXRMBkQ7kNvwGeT0o7&_nc_oc=AdmlSmELI4vg2mgvEVT4gQdkb6T6_f1iTtBBcaSddhcg0COJoxwlw3td2SQqSzYj9wo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2-WacivbsaD3NyVJDWn47TIWDPENusx36XSd7aONA_Q&oe=69AC3910"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSiWVSUilZAQ7kNvwGTiD-X&_nc_oc=Adk-unlqjk4mrJzt0lpG_skYtj7wLlQeEnbd4xDPfUYhGMGhOttrmTVikPdOJOxDwHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyv9DsWG5PSgC9EEWmIKBgyyM_l-5aJAWNlxeM2XuRInw&oe=69AC18F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
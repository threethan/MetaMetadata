cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciytE9qjLXEQ7kNvwFwIgl8&_nc_oc=Adqm1wz-tXuZpTzOvKVgsqYbIwmzwc8JfrR6HLpHqBVTGiLXD7dBDSwGL8TqsnUtbtE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zdDxLRHgJPYlQ_0pIo9sI3COUrjVAT4gQTpQ9o7rAaA&oe=6A2C03AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW0fls9FUSQQ7kNvwHM5dKd&_nc_oc=Adr9DE9nsjJfl3qVlozuklfcbBjjYTW7gZ1LjCOzes5Ia2_oBVv22Pq95Aa5JjAAYqM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99NMl8TrjjBiiIntJi4GD1Lr15ZWc2cMlwtUAyb9kWZw&oe=6A2C2245"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UViME-UK3MQ7kNvwE3uC_J&_nc_oc=AdqjFaSw4Pwc1Vjdn2xfiwxJoVg8j5g98dgUXcYF1vT8upIxjjYwgadPBB_4aq_-4LI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D0ULflwuKUNWrvIW2FY8sqf1SfQams6uryb8UeWQqjQ&oe=6A2C1821"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AHbHnNOZc0Q7kNvwHJ2PQU&_nc_oc=AdrMvs0lkGfQj9ZMcyFkX5_TL4JlWQ9YqYvJNS8EMrgyOojzU-hrBYkl_2Y6Hj-_qWw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WVXTUwp0sXfWV6hhMW2mVBMzluAlDOYohGaB1XgnZyA&oe=6A2C1A90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs-dB08zTdYQ7kNvwH8DN8R&_nc_oc=AdrGmhxcKcgOt_hmIpKHF0mooNqOwSctKrcOtODRqBw5CL37IbX0MmSqJDo4YBCDdxI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6imZo0aRo-a9ZtagBEA3ay9d6JEUhquCzAjT4T3t9ow&oe=6A2C32B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
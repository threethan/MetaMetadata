cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3dNGqkNyWIQ7kNvwGlF1Ss&_nc_oc=AdrdZKMRvF8-uVnWzJcS19PB-qrQxxF5ccpdjJxsJVs_Ghri72YgQxJTx-wx-NDX1Yc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zXteTTEtlxPaoCnaOV0Wsn_dN-dJODMJPVtmN4r27kA&oe=6A43BEAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHfxzmwqHPEQ7kNvwHHAf6G&_nc_oc=Adq_b6ZXIe5M_udP_DSkklTO_cWAhrAN4C7ZOpH1SsRF2LP3JB8czJANCGcvaAPTct4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93jAI8Tyo3gFdlOJ_Gjhjfj4Af_KhYVeoNgqP3mrV9aw&oe=6A43DD45"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdxuUk0qVzgQ7kNvwH078GF&_nc_oc=Adp1ZGwmi0LDXocuU8v9-2b9wucmltz7daP8orKKAw-gRrzW2Ome0lXFcBdExxftSD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zkKmttWZyPrCDHaAlxdyqRUs3YDgY7xCFIPRwTQz2rw&oe=6A43D321"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPHWFLB-3LwQ7kNvwGnKG-i&_nc_oc=AdobVaUZvs0x8nX5vOzR9rxzTXyrUDFFD6pgLn85Quy4fZR21eWPkToYZzRKjEXG1eE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gK0BliZZ0hdYi7P5o-7DK42rQ7eaZ2DnGryudlG0BGA&oe=6A43D590"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbLIvC3s7UQQ7kNvwFoqUzR&_nc_oc=AdqZU09h-v67Y6eXcJ17k5xcN9OL721tDSHMNCJ41RDZRhiVKlXYWjrtr-k9J-vgp7s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kBl6twmmgMSYbsHKh1cEfoC8EEP_NUObZm8Dc94Ifkw&oe=6A43EDB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
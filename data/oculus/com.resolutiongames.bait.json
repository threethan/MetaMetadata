cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CXYj6uSFCMQ7kNvwGqw8DZ&_nc_oc=AdouC9C_0jacKz33vTP00NzSZWHWBGZHmnO4zt2s5G1eviLbxsAsT6cd4XLSxSKi7HA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T2PkLbfQmDukXSo2LMvPhl-N6GTMrgsZHC8vnqjqHXA&oe=6A0B0E2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=batH-lVOyk8Q7kNvwHgSPkM&_nc_oc=AdqIuloL2WvadclmJLkfdZYvYd4idI2MAm7vdqKmcjqCDtgjRig0KrLsm-bTVcl2MiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44GU9POwgF6RZd9EZjqZ-YwLTscSeauFIknmq-3wkvXg&oe=6A0B2CC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfvOIP_YT9gQ7kNvwEkNiAl&_nc_oc=AdrXsDiqQMdpHtgtGtYUlPkPjYMS1F-Lw4WDi0LEgimO1ikma22Wa9n4SPetb6eUxDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YtcENaD9O2krssSXBozcb8MZYbifQMNo5wcwpRsXMLA&oe=6A0B22A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ypzd64huMk4Q7kNvwHmX2uB&_nc_oc=Adotto6QV6I6Itg_YW0jVo9x9Z2zBJF3MFrAmSfGgKUEdq0ZoIATXMgIYOpeg5JBYvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cdKNOIVeQz2CuXGYGVkbKaz2AVBMiWXat-BJ8cl2Owg&oe=6A0B2510"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmEOZOqYkE8Q7kNvwHXvMXL&_nc_oc=AdpTUoCUajJpRGPWKKiOCHnqGlIjhQiucngJDphxktIixuSHDdcdfRkPRHnxuxKHzRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7idRUq0I6lpiNlefnajDOIu4DWmTEordZaoJMzzS1cXA&oe=6A0B04F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iYKSqO940UQ7kNvwEiY3r-&_nc_oc=AdrRTsRkvb6sPI1LL9dUntUdY3uwyLOe-H6hTPmJU6h5TKtaOGdxyDMa_K_Gx_LbTQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SB2mmhUYwKdgQI5Nu_VKRPc0lh93xdw5nL3vWP8WkRw&oe=6A1ED4AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmHepyWslbYQ7kNvwHiqmek&_nc_oc=Adr1dNKSE1O5YLw6vQxkULpe02qLKgduXk0Y3D37rVI8HtACvZ7K3kmEg-HbD4NloXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gxkYlJ4HfVpEQ84gmFMgqUgqRhvxTer_SrmIGgZ-RUw&oe=6A1EF345"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQEvWZmhqWgQ7kNvwHnzFVy&_nc_oc=Ado66T-Uk7cmbl7WjbKdBA6ubh0bLygfDf7TUcvnu83vnyZ4JpvOmtc-6L3RbOODPFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69BFE0kgav0B37mFh3VXNBfUMqjVp5hEYTFgjnp6iLQQ&oe=6A1EE921"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWrozXCXqDoQ7kNvwHR15Hj&_nc_oc=AdoeOJFYZpuIY-rJ2c60DGTXEXmia-Z54p-X5dRRFl6cWZvSTQ1Bz6cvkXwbDQE-NqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54wgIZ5QnMdGrt7DO5VS1iZ6pxhfu-K6hFhIJgoF3BTw&oe=6A1EEB90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvlC2VnJdQ8Q7kNvwFWqAea&_nc_oc=AdoCHXTPeNWmNAuUJZwAN2-l-aHLFKVBcSPLlRrV25N7C_edSh-9PVqyuszSXQ4piSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LC--IB66or-bXWAO0kKtcMbLjuj1SdFSOiOrSWxipag&oe=6A1ECB73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
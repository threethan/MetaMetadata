87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNBAQ2kWuaUQ7kNvwF1GQ5g&_nc_oc=Adm_9Qrcoqp1TU1wp7oBKy_xcUoA43_yGkg1RbHtGTELjOc7ATCJhom84ulmRy2OlyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfzF8xOtOFg5qTCfGJYF4PBkA0aQeL3B71zHLSb3sU_Q&oe=69BFE8AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laaIHVLlR6oQ7kNvwFbIX8y&_nc_oc=AdnOjUMYfDXWLt4syUIKUEWoOx-EY_gaZARa3gjs_a8vcBMYh8KJQZTHPPDOJl15R7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxfhfVpLDsUBysVAtf1KrDX7UWiQk_EncukqnotPHKiQ&oe=69BFCF05"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2PA2XXVzskQ7kNvwFshZHP&_nc_oc=AdlTAXqhun3fV4epyPb0FQrOD3z7zlGciPQZ8ihBV3SsMeEf3I7TpRzoJS8h4YpQUb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYtuUOxWzhJm-JBZ6rGGxjmhZtnGjQVpVj842YZO5s4A&oe=69BFFD21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=878qZdrvLTIQ7kNvwFCwgX4&_nc_oc=AdmFBuDLQEmucv_NdgeDbaa66PJE3b_h2J9fXQqtEs0l552pc-SJ-eGcgwiU2amkCvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXALCf7vFh-llfZR_2mg1zdXsUeIJ1BquekvDe7tIVEg&oe=69BFFF90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMx-yDkdwsQQ7kNvwFtqJf-&_nc_oc=AdlnsnDuuKlVsrvZR-LrACh85_gRVvxGT8v5TYD2dm7j5ZgcznyLQQF-qqS879h8F60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0WRmvCv5M_FUtlWNN3FRFtiubkGMxF1j3qC1iReHdlA&oe=69BFDF73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
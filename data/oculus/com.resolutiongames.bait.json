cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXLjU3SXWV4Q7kNvwELg0l3&_nc_oc=Adq4zzVQskpHowGcDM1nQVXhOyX3QpgUy3_Hoy4jr0oiz01RXClLLIe3bSZJZqE2cio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J4kFHnB6ZEMee81C_g5XkR-jh5-LQgGP4hFRzEc0r8Q&oe=6A3FCA2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxDYiM4S5HgQ7kNvwHnSnNP&_nc_oc=Adqs33WFhqm0yfASzQbpcKpmHQmfKZdQjZvi3rJgWB5t0bDkYuHCSXjbAhZld7mZdgw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I7T8aR6ufjRqrLkHGL6Y4K9qbXmL1ZgnfAOsNVirbQQ&oe=6A3FE8C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGdmknDru1wQ7kNvwFBVI2a&_nc_oc=AdpEwDSrljJdu3GwhfqcNx3c4KAWSmtTdjx-yIrwGxnXLPOoo8y98IdYJyutQNfB8qI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aABF2YMYTOEgM-lFz4pHMC57BF14W4I7haNsT8Wmulg&oe=6A3FDEA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF61-rpDp6QQ7kNvwHZw9uw&_nc_oc=AdrmqAPQYEWUhjhjLzeNwoNeYHw6HFHOhxajzst5DLKy3gABRE5rHL4dlozICksOMyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uqkM6CGgqKq9Qt2-kXvr0ILrFL4sQcJOOQC2j_1Pecw&oe=6A3FE110"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXHAX5aIQRsQ7kNvwGhxTSS&_nc_oc=AdoVyvrRgggJUUBgd-HTrcUYbEtUn2bjN-Sv7ClcXOZo0c-gntNZjeuaSQg_VgaK7k8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CiGtSN--tOzJrDce3LUds4Bm9F3y25bJKIGCxXmqvPQ&oe=6A3FC0F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g423IhQzDE0Q7kNvwFw8aWO&_nc_oc=AdndGMVBqXa8lBgvIkTMmrbWjTGO9bOiVIGNW9KTuw-fF5cW9BKMynkyl_7PhLYhs_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVhiDkxSedOdNVe-pAFqG4c_HNKnoukH6NZppqwr1ssg&oe=69BBF42D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGVIl79H9dQQ7kNvwFI4fPy&_nc_oc=Adm7IUQD0VRfbLMyjCLJVnjyEWUysMEpU8b8h5iEGeuyWmyoFAY5Le4pc3frO88q6qs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyq_9BzXg5VWJEDBBq5pUiYUdCq54dSXHZU2j-C4NYZXQ&oe=69BBDA85"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo5uP_DuzqQQ7kNvwGGfBuq&_nc_oc=AdnS_NMKm620mTlo2XrIxGlbomoG0U9WhKF-aYHTqlLPAm7oZsD6iO8BcE3iWWCPsQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzj2pxvxzVOheYS3sES7HViPd3FbN4TH9XqTOy3ZnLszw&oe=69BC08A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PX0qmvl0DUQ7kNvwFVsGjY&_nc_oc=AdmgDg8t9zMiP-vHxgJx3EitxYTZOansDHyejeJaD2NuHpjbnxeJZdiVLLVidufsDKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkZbnTOjHhUshDqBWmgmHO02zexJQDkENzSHgM3fVBSw&oe=69BC0B10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYhSnqu-1xkQ7kNvwEuXHk8&_nc_oc=AdmSd8o0pgZTU5lJ4seOjS9cLwvM0owBL7V_-3AZ1-SzMBZ-PM4qJlqYSQdYleGdCyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyo4HPFSuJ9lZ6x-G-0T66DU4l7w_6l9SszLsvtRYI9sA&oe=69BBEAF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
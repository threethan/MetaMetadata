cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb8X4yHZGNgQ7kNvwFD5Z3P&_nc_oc=Adr9jmWI9VG58YDTas1oN0EMvE6dRrnSCdGGfOnKyUIC_h3al_QfP0qqlU9yVm9nD0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MZ1xjGQcwptzCjQDpmUXB5O-CwmKXhmVMOsP5zf8Mpg&oe=69D8F52D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqMXayVOyi0Q7kNvwE67FRC&_nc_oc=AdrFsxNieSkUbGimFnCt9gySnZ7INOJmoHnoBkqHW_t0n72owYO_OhliSgS2zECFXZ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zq9RueiicHCbArP7AIITqp5get4lnHdlaIn6YlaKBSQ&oe=69D8DB85"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOnFFgRt68MQ7kNvwHiDTeJ&_nc_oc=AdoexGyiqUPj7UqMApDV2-22lXBGssNV3OYYSVY1J1wnCSxu6nUwXqbe6UlVNlL0LOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zrqkboNzXCcBrxM3vx4N7bQDzq2cmgBuz18woK7tD4A&oe=69D909A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XJWd7IYgzgQ7kNvwFE0GQM&_nc_oc=AdrTjDa9GZJXvxYvbFpJ3pm-vqL-5HsNQsx2IU0BXz8sXGZ06oSxoPWfJ56xfGBddqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GwzUIfyphz3s0GVc-KbizyXmM2YoVHylENLWDa4EVFg&oe=69D90C10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVsfgpbd6wcQ7kNvwFfShqX&_nc_oc=AdrRBlmFU38LlYpYYjS14_nKu7ohLXw3SE0C73Rwqfr79Mr53YUP4CbcTKICAjc0Y4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FRMkNJdJ9lda6l9E5iVYFeQQc9tR19OQacmBZd6blKA&oe=69D8EBF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
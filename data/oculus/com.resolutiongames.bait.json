cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot5r9p0qw4QQ7kNvwEh4PIK&_nc_oc=Adq6GtJndP4q-mvrSure3U3eY5iE773sv5WApymFBSIVwLbD-JHFHgOknBsw1b_zHFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hG897-6r2DzGeOmXo2t5m5l3ydskfGa5deQoEOneZ5A&oe=6A086B2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXFTaz_gJP8Q7kNvwFrj_lQ&_nc_oc=Ado2TtOCbjyBCdOLSSHsiyuynhuUiKN3oxZc9S6YgF_085j_Y7Udelwqh-6VCx2lbLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rGV5eCzmumV-wv_NgdR3RZhtnYt5_PBJ3lD3KUhTgqw&oe=6A0889C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scCkVUdHCP4Q7kNvwH557Ha&_nc_oc=Adq9QGm8hxLn7hHygFcteZP9v4vsKmgmwL1zkmixJ8iLymZHVEM6ulqiOy3f0RaBuFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af692Jpaymz9plrWC1wWwDWRk2zhUPuHlB_Ki3_G3IKHHA&oe=6A087FA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlau4A03U7MQ7kNvwFWjn6K&_nc_oc=AdqhBqayh4PCAsVhk9HHVw9xMTrpV_HVZJE1SN9jovS87KyPolrHFtFFO54BXSc3xY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zVas_-m2yEEIE3yDwQYtbEaHiqjc2jbNqkFwnDnbK8g&oe=6A088210"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmEOZOqYkE8Q7kNvwHxG6l_&_nc_oc=AdoHFPVQ8KI7qg-_vydV-mIQ6OBsjChIhNXF1jSxj8oVfvvpypvN0TkAwe74oUoEpfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-dxStR58gH1e3YyujxoNz5jOlBbmlQU-ATimfGmd6PA&oe=6A0861F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
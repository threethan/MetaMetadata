cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AUR3h_Ecn8Q7kNvwHrBLjC&_nc_oc=Ado9jHKD-ZabpWOMG-2Jwf9BzBj0_Ma-hy2ib0iJtFJuq6sQvLCA1a2IFxRfSz6uBAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I0npOZonJR41Sps4h-8Ppa0xaRV9QYtGul7BMrozRag&oe=69FB3C2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOWZ80MhQvIQ7kNvwFqfWyg&_nc_oc=Adqu-OxhWgkDmgADEOZjB2Lk-GjRJKlLoLlkP6Rs580SQKGtf-nNx50Qjgr4-sPWSwo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af410AGahuyjw8loFrAYOltK_4i-QlLzW7bs-vQ5zTkyCg&oe=69FB5AC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0KiU1BN89MQ7kNvwGuAWTu&_nc_oc=AdqJ-WRlAfnoWs_X55RmCB1WUg6JOMQ3326G2ap02KHT_T6WSqnaY96t761UaHg15HE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53woo0m7N-NEDwfWdZ_PPbpiXMGltoGhIlSgvUXxw9jQ&oe=69FB50A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMaka4X9pb8Q7kNvwGtxG0d&_nc_oc=Adq8l_pcPKe93uFMTV64TVntSF510q508sttgJGZU0ZaZjtc4faRiggzRi28ViV5q10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RCeCQzjxta18_nE-X0b38vu1GrcTkkyZHhe-eP4FpOA&oe=69FB5310"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwC9fVqkNwIQ7kNvwFn0ZOW&_nc_oc=Adq8Cm12j-qPpbUs7muQnfTisTiYvOUNhC7F1bEfOFHEpSdgWiB5rBTExOCsruZ43z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Krrafw8tfeUOjmHIfK3pisw8lg3dsUnyvNFHu4SSaQg&oe=69FB32F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
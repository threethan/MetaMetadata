cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CXYj6uSFCMQ7kNvwFC1IOg&_nc_oc=Ado91tb3d8QLoKrEGhc-xxi0956igW91vWjlciDlkGla_Dh2SMfIRzCJB5xt3zLQYbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LIr1kZXAksj0-79mDGE6qcuzg3qcyvldiGcoc-e_tQw&oe=6A0DB12D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R55UknQYUtEQ7kNvwHB6XzB&_nc_oc=AdoeK0t_D1y2lKzvXQDZrgq7vNhL1GjZrY8s4QUO9ccMh5qpUw6aSKuGQEB0PTi3KJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M_30yIDR4Nm1YMT0QCOr75yovJRRKwUUXAM9TwtbmMw&oe=6A0DCFC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv4BaUjhYYgQ7kNvwGD8sZi&_nc_oc=AdpluY2Z90d0xWLGHxL05ZIlGJp3UFtI9uxFTomakrDTZiAYIDAV1vorXKqsd94QFo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zoyO1VaJjeCY_gHtxnmK7_zO3D9uH97XmTuaHjcha1w&oe=6A0DC5A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ypzd64huMk4Q7kNvwGTwIFc&_nc_oc=AdpS_RqAbTdpIcazTUukP1e8sejAw7uIvR-lLE5S9ONR-_SJyMLEAmLl1vDp6JXKxkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ENUF1VrcSYrqivVsiuJGGHXFN36FKg5x4RdebgKIPYQ&oe=6A0DC810"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaJBWZ4yDXAQ7kNvwGhho6N&_nc_oc=AdrmEd-hr4oVVQ72oaHUcOclqFGWp2oSU96i0bbXXN79HDG8LOE_EjPeoXIAG8uEDKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Jul0F-EpNg-flQ7sF3__Kw4zZ-f9fyT3qZoIJTi-xSg&oe=6A0DA7F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
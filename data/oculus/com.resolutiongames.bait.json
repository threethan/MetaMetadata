cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7U2udM3iYgQ7kNvwFh3NaS&_nc_oc=AdrmUItlDXYnVJxOxSZbQplDYAjWDWG9ggzVIYgxZgccqs5FFLfvV0XOag56b6pXG28&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFapubHSXMHrQZspUCo19PsK3Xk3iRZjO08cx6P06omA&oe=69CFBAAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5XhFpGaSWIQ7kNvwHlZ3rv&_nc_oc=AdrmHxOtpCo_G6PvqQIGtl6lkZWFxTpCYt7uxoX8U0V-__0CbjUqUdsDjO1d2oir02k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXOnXFifrDm_Mp1Bxuc0xnA7FyGocNV3AE1G0mzG-GAg&oe=69CFA105"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU0bajQQzlcQ7kNvwFDnfbL&_nc_oc=AdqqV1asbcA7C0sAM_Pwl-4nlRVuH4KKsGi2QUdSqlwq9AbLebmX6YTd8gzHTWXX2zM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgUn60AA_c8vfWKKa6wxG3t-NLHK2bwrniOOa9LrHSTA&oe=69CFCF21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4UPn8CnK04Q7kNvwE8rDLu&_nc_oc=AdoaBL4C7xrj0VLZ2NimzXnhr_mmqKA0Jm4h3gcIZArpaMAOeGcg9m_Z6k5v3Bjiqgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYiAaof5QxS2pxL3oE6WuUurbadIHbl5_rOw5wFubd1w&oe=69CFD190"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwCsXaJd71IQ7kNvwGCEuYg&_nc_oc=Adqd-aEHfSKQ3c6DOP2Ry8efvLxBU2lB7cA4YhSM8mxuIyJdv8wlssSJ5szvPyJDBX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUcVfpEdteNZ5xGEojkWLzPw45fvPfhAQU22XCYJNGaQ&oe=69CFB173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
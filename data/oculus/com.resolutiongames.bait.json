cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXToR5nvIIgQ7kNvwFPf86L&_nc_oc=AdpNKQ_3XM8xQWtO3uiotjmedPlnDiI8_yajX197ZjRCTmgQT69qUAvffta-WB_p_Y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K94BKm_g7JEyLCjF0s-zHSnpwm50B3jRd4vvQrIctXw&oe=69EA18AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sax_qGvjnt0Q7kNvwErHpep&_nc_oc=AdqyX1GNjnw2wcOzWuvyOsF6ibGzXcJskzOdTQDVvTao29KtOAj1Zwk_YCfv2pWn8hI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q0jFuE07wXWnt2dsSHtrCUVp8VFBqqU07AzK9IHYBlg&oe=69EA3745"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s9gtPwOwFUQ7kNvwGYpNiR&_nc_oc=Adows6QHcCG12vmJ4C1CEttyHF3xXd6s9sUnbUfAvaj5bbi2NM-NQoLiIvapePbBP10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Sdj_GQsTzm4_A0kyF6YD0-t7t7Y4MwWQFFS3aHY83xg&oe=69EA2D21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSeY4bK6hVwQ7kNvwHlcdOu&_nc_oc=Adr8TuBLwAypNuLqF0YeuYelQlQfvO-ubEj_9ng1xyhhgVm3HRkcTQA8wk694dF20HI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oP6W9HqzAHmGTzObhcCW0kMohxP9h9NZUnfstuTo5WQ&oe=69EA2F90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF0-_YPd5x0Q7kNvwHMG1zm&_nc_oc=AdpJU3JRghMsiXSY5kKMYGiiJXksiviASzvOQ1-IpNucNpHF5DAzvsX9_1tPXkmRJNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CcMW7xWbLMmLkVPKH23pijxXLA6hX3oGIceRnFNtZ3A&oe=69EA0F73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
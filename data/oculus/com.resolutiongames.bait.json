cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hi-UxbKzJwQ7kNvwHgjaf7&_nc_oc=AdpPjzoh7-bLI0Zqh97HWwMZW_VYiRW4Z-wahA4mfR-IjuqD6jLwmQBFGpQzLkPe4ZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pJ-x8eCK0eHzxZH0-YyHeLiuQgaq61PSfD17tkBjZXw&oe=69DE3B2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4LEClZFxYEQ7kNvwG93gP3&_nc_oc=AdpcuT4YTF3oWQvQokhWFlFZFprk1PY6JdC_TiG-kRs8DuJCLcTtLZgnh1_kdBeEN1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ymQSEVWZp3MHshWTZ9loHxrDy6gGuTrEZCswnFkxPKQ&oe=69DE2185"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xCnXHS7lFcQ7kNvwFdieGC&_nc_oc=AdqiNiWUY5FyVtVoMXyyaPUnq3YZX8EXh7fwCeKvOof9d2AKMPa-JWQJ-QKsqsn5W7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ch4fHYm1Vc04hpderppDJdZ5IweEZlh2G2I3go2bLgA&oe=69DE4FA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvqte62nzHoQ7kNvwHeg8ze&_nc_oc=AdqXFZKMcfQiCy2BieYgrkwvlHnEQ5KyKASu28FFMSKy-D2lnOTXsl7VKCEPicbA5iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m7TXKdALh2VjCs_HsrFQ1oQEglKsSMIGGP88rTI6G-w&oe=69DE5210"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwjQWtko2p4Q7kNvwGXPrLy&_nc_oc=AdoxCpRUxWKFGyG0Ie_EkWJPMJzGKR6z3QkLP5mVZ0YWbu72-sC8z06YHIONjm2bU7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kwSshk7mCk2VZ0Zno9JAlxnQ1dBQBYfPg2NfqLQi9jw&oe=69DE31F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
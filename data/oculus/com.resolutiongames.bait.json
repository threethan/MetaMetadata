cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxH6C95_nv8Q7kNvwHW4kii&_nc_oc=Adrfn7iiClINeqMgi59AXu-EaJ6XRVT3MTRGGiEqlA54_eyphhThZ46HYN7bPSgqH58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RUNQOAWZUZ1BlnDNWyKGCNqcCRIJngpf4I7PjTCsOKA&oe=6A37E12D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nvTWO9-jwkQ7kNvwGJP8bz&_nc_oc=AdqhfBjZQzPtIrnciotssMwKo1fKjjm_vRXNasGYEXQP9DGgLpgSHf7UhvRHcRk5EeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NjepWafob8V3aKA9Y3anJnszfsFLbtUdlbWdadsFtbQ&oe=6A37FFC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ppHiRcOvroQ7kNvwEpqdPo&_nc_oc=AdrzoI7v0BYzk4Y0gk1PMxuOi-YL7p_xegB0Jl2aOS2NEXKRfrkYTkd7LDEAIjP2i8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9omzlZL7GTrDIznpvf5G_5bi6g9Gwoy0vZC-qnv5SiVQ&oe=6A37F5A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UVCUm1MzjoQ7kNvwG14D5J&_nc_oc=Adrl0PhvOtFaczVrMPJLnjrrguKKvLtVwFdLpKyy2FO6sGcqKDwxj_4D6rP8wARPQQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JDmqpISwziLvL9YOIuMS7ZrUrZxSXxG3r7sDq0Hdtdw&oe=6A37F810"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6c5JvyX4nEQ7kNvwFO7B58&_nc_oc=AdqCM60dwZAj_BkLzRtfNu-tvinLnJU2jNacvtK1PBm9ACwOpOGvjODRoVOW-w0FI5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IymuFpP1ZGNIlvitDmfgk-8rgmiSgQoVuOms8APWrfg&oe=6A381033"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
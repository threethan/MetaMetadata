87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmXirvvk89YQ7kNvwE3POK5&_nc_oc=AdmSEAxu62_0wNcy9F4Vb4qgdgr4i8tH7_e2no2xKuLQreYYU1WpupAYU6vL93ZmGrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvxs06jGCnA1QgZBaJUDjl0tXrdYyjd4fgueeBNiNfENA&oe=69A97F2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGCIiDNloq8Q7kNvwFwBWa9&_nc_oc=Adk4olnnKnE5v22i_vtTfxYj_qf9yNgCCjnrNLcL5trBzBZIGGrtF61RjzMl7bwY8-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvW9QdZ5F5J20gddD8uv6BM_l9gspwR3o17k0Crk8cmXA&oe=69A96585"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZSWavTs8T0Q7kNvwEDS5x5&_nc_oc=AdnMmKWpqTYmQeLRNKQcRPfZthOfJmuZLmL4pILpSUKyr3VldnhQu4vbGD7NUF26J04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuzWwoTeDVr8mbL3BMZJEyJjm-9qb25aL6KoSUl_r98zA&oe=69A993A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whIeOxRxOgUQ7kNvwFuqnU6&_nc_oc=Adm6XRFp9nvQRlfNM8xOkx32Ne92IxlnoPRajrXSFSjNiL_i2TOorAxQsry2zvgzSqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfstXjvW6tnP08DVAbrEthU9CIffaQBV_kAHF9__J4RCkg&oe=69A99610"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSiWVSUilZAQ7kNvwFK7Hwl&_nc_oc=Adnlke6jA4SJ66viszL0lkjbHRhwdv9hHdmhdsVXbsInb3KMbWPhhD7fWcKcev53_rY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftaRUQ0yGSC1FQUg4MAVabgSl1MM1JqnMBKeKmAGkjgnQ&oe=69A975F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdVlIprs148Q7kNvwHfuedY&_nc_oc=AdmLW8-TH_OIkmEbMdp1TqHvbo3FOWAsnN9YA4QKa0SQawDu11yk_c5hPmjc6P40FeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAqBJRJ8Qn4DDbabwZPSQgnPnhBkkm1atiJeo3A_23Aw&oe=69B016AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8yvM1JcUEsQ7kNvwHZiH9x&_nc_oc=AdkHDYuvrykdnqeFjyzugOM0YKXMM0_yd1Pne3gR1wWg0nFO3GxoXBvhze3ogDuaVFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrM0LT_jVCToTry2nBcaXR4hvCx4YppT9lFYCbENHxIw&oe=69AFFD05"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckuykqna3iYQ7kNvwG767KL&_nc_oc=AdlVmuE60GWLRb91QSfTTgQvX7_ZUKuMLMu2GDfFMcJaMLbvVSjt7g9KF0J7zJfjnes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi469EEwzE49ttjcw3jblAr_FnyfPAdfunqg7DlAe_pg&oe=69B02B21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-amrhLtHDlwQ7kNvwHdSsNh&_nc_oc=AdlAFaciFCDwPInUl8Iy_0ftYI40q9al2BaMayMoGDfn7hGEGG0YEI4oxnU-TDw6V54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyR74IDeOq6FpeFWYxHq9l1V-irzFPpJnn_9LuyqsT4oA&oe=69AFF550"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaLeAX8Oj9QQ7kNvwFQo3AE&_nc_oc=AdmX8bQpsrf6Yk3e2SqMEDik_i35CJ9laYknyivx2T3QquH-Pe0SJ5Vnf2kernc7Rl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgDeG9H_Lfaq2X-yiXLfbl6TMO8OwaZ1J8LdOuikRA4A&oe=69B00D73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
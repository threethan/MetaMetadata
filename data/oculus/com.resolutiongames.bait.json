cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsiT70Vv4oYQ7kNvwF9bh6g&_nc_oc=AdoUtzzd0mVYCICUNte04FJUIkBwUOr1yItUAb1TIySIrV5tEf-026EKfeCsDmW9RAo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hgmbnAP4CWCM7hbozx1olNbfVXzBYLi7wZ00r_VNvmg&oe=6A329B2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNU7PQCyX8MQ7kNvwE2wuSq&_nc_oc=AdopLNS2sGijIZwajTCzOC6yWoGFARrQ1ieg9i7HuBSExGGFm37lS30UiUf5TpKgako&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_4uWkTnJk-cqfBIJNzmYJ18OVHo-7e3YyKqnGY186jA&oe=6A32B9C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L1TcsDhay8Q7kNvwHaPosl&_nc_oc=Adr7m-_x4jJNnmkpsuuty9GHnK0dbIw1AC3Q6usA3jZqqWKXsECHSBiNIODTAtJSnFo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bJgPc18mTqZo2Fi3bEcKowDRfQc2ObliC-DWHyuDEDA&oe=6A32AFA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3PXotQAbX8Q7kNvwFngCPt&_nc_oc=AdpJ_aPuEmlIidhV6WFDtHE0_L4d5YQO7ENKHVvHogYfi-UhM-f38Rwyr32hJVqdnRQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XXCjURW0MKT_s67yM_EMw80TFIzCnAUjx3-FQuiYxew&oe=6A32B210"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai9on1rsXmwQ7kNvwHLfVmJ&_nc_oc=Adq4hh5RszclToqzOKP_tLG6vseHbaKLndHBi3w-PVGUc31mr1inCyWc5aruF7nk588&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fnxAfbRvP7t0WecfKnvGTQyO7BtGNkBoBex03JjIuXQ&oe=6A3291F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
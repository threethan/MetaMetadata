cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVngW-UKe3EQ7kNvwH7tFaR&_nc_oc=AdpE6kYDPpHS87OD_-S7F7TFCs9eI3wcS09PFJC0JJwGObyc0BXtCe1O6oBO5YGFWzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ml1YiLU_KxeWt18AluvJf3hqr9Vdo2Sf660u72p6WFQ&oe=6A280F2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZb25j0VdUMQ7kNvwETAGY2&_nc_oc=Adow62i2xHUIiA1MfJqVUJphulQVy-MTeQrzA3m0XxBIZVM4Khyhk_YeWiky7D2q6f4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F2Lyo4I0a7iH_d1_XNtEfGvxcNLvUlD6CQ8pIii0ojQ&oe=6A282DC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYrdMw-etXwQ7kNvwFZOORg&_nc_oc=AdoYHJk1wBU_TLE47_ig_5Vu-x9cHfu_PB4jKxJfmAS9771zeODJXWaDWiw2MF1KQuU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T0v7I7QO9Lt-kQvFpSivZn985ISBgc61dAIwujVqepQ&oe=6A2823A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obt3ewgNTQIQ7kNvwFuPKmL&_nc_oc=AdrUEIQACE_TZ9WGZTGK6ubYqdBmdfOtfsF_xA1qm-O6gUsD-hs7287vmHHst-KYAFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dSZ67w0S4fRwMKB6eDzR9TaPIvnp6R3rBqu838XyzTA&oe=6A282610"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B16RNnBFn4Q7kNvwG5fsmn&_nc_oc=AdrqTQFs8uAqfdKSfvAOFwLv6ys87vv_ERLhdqRub34hk4_pHc4rSDuOVkW4VWK-CQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZK1OTPRyQabIqa88ya7pcYKYXJ24QtZFYFxWR8gpSkw&oe=6A2805F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
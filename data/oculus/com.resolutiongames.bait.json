cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7U2udM3iYgQ7kNvwGuKGqo&_nc_oc=AdrSwDxVCAVRSpAI9JdkifqPJ73YHTAc1l8oh_YwjumquWchVvMm_-PFpa-TlJ1H6_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KfdtlWqCJJhQY_ctHMzHh14kjSPy4pSrqj19JiocE1w&oe=69D25DAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgQLphfuC2oQ7kNvwHBG9Z2&_nc_oc=AdoTyDMJI10LVTpQAuVjAWCGJIsHPfHxDb_khjfH_r-AZDtVMYRxBdiM8ab2leNk10s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25liQwRfa8-YSte8C5J9QOMYJ5OXE6WC6qH4CdtXgTUw&oe=69D27C45"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1YzDsP6QoEQ7kNvwEFuv9P&_nc_oc=Adqueae-f5IXC1d6XEcBrMmF8EmwbyhTWwTOAdTzWa5BYrPRDUT2FRbxYm9GxNCOW0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G2A-B_mBwQfEgeL40com-mshVBf5t0m2-OF2Ah4-SRA&oe=69D27221"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4UPn8CnK04Q7kNvwHW23ck&_nc_oc=AdrxoORFqPxI_qOManTU6i-igxXoXCAbk3bxfeMybM0j1RpsqimKo4lfVpAKKavRBBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LJD4bNAix2IJu7Fp1DuNvmqD2aAl8L8nXO4jsLxqkOg&oe=69D27490"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n45ahYQFv5gQ7kNvwFh4SAW&_nc_oc=AdoXros5BVFErIEPbzlniX7LzaK0S8F7wUgrXUs3AErTKoeAQM4Tma0kNxMiqYUaFOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GvwRA5Z9Q5_hF9zwcO1dZqv8DX0Jb8xUgXW5_64MJ7w&oe=69D25473"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnitvOZ9tYYQ7kNvwExKv5u&_nc_oc=AdoMipntLwfW8y79-5ZJuht0mVTzzjUu_ZAtxfcDV-gSckn5nYvtPSnGLec26aOSwQw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gpjFyrqncIw2hHCNI3WgjUATb0wYTGmDXEq0QUC0b9w&oe=6A159A2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uza27mmoagQ7kNvwHe4CfX&_nc_oc=AdpfXpdMfWsjhOA8e_tLhToOcDh0UW3P1x8fIFDWJl5TwMCbO9dlnwQKUH-dk0q_0sE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gRShAvf27D780mopWaPmr3CcJxar8d5xo_D5GA47J_Q&oe=6A15B8C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vau0YAAWwA8Q7kNvwH42i4V&_nc_oc=AdpHbgPxM6E2zxTURIQsyIBRia5ShbAVDIRrf_h7K9I5Ypd9jlLf4CSp-uCvjR7em50&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L-92ny77JiBMq33Ci9lQqZWvwrENGjtYWuJ95Gjpjmw&oe=6A15AEA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9-AVh9ZpysQ7kNvwGPRoMj&_nc_oc=AdoSX8k3OmdNvrQz8NSrn0mSeu0AvNtTE20ICwYXet69XgqEgbBohL3bBBfJWzP3r8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cJRh7fce_8NqraIGELIJpFNIhwDhzmajIk7rub2GL9Q&oe=6A15B110"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOWMAMo1psMQ7kNvwE5qW3i&_nc_oc=AdqSUazB1i6fgE1cR5h7FSCTLbadpjJ7dR4N_mGrH2kNPpRoI1VmK_nGAW-x_kYW494&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LhiyIsS4vBVxn9VJsBiAMoqsa7UZP_A0Bt67jiy70yQ&oe=6A15C933"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
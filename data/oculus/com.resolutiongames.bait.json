87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0_gxJG2-tMQ7kNvwGIk2-o&_nc_oc=Adnep7146CbfUV0aSg0Qp6OTC_NnATe6S0pkYa-QfF5QliE9Os7q8G4Ywi8plzrQqXc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfypXo8htFn2rQ6lOMi1hvsHOWn0mneTJtnYwn_M7DDLoA&oe=69B9512D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbKJa7xGrtIQ7kNvwH7_0o2&_nc_oc=AdkbEAoGt1SDfkxjrNCK6WFdWFLlGMnPcqr3HsAF8SE-1Vd6x4DWSP92YW5ywm2zAHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzju9aHEwEN_AJ5ls_yBGH3jysicNGCGXDhSGTN9vBnnw&oe=69B93785"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vIu0ybph1gQ7kNvwF25ieA&_nc_oc=AdmTFI5vQH0kGtWdEVUOYVoH1xP794K3KHIsi4WIOLQJasU8rbZKxPagf7U8yJTXorI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcNO_rBxKFIeIYMJbTAsAc5PYrdBJQUNvc7GsM01SkXg&oe=69B965A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inrgu732noEQ7kNvwESo385&_nc_oc=Adks-0MSQSFEKKlrA_ALSnff03pThu6-A9SpqwhXzmYHd7f_55BA70VJZ_T0RGdGNKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBAH8ilv-BjaBCZFtPAwvubnowKN7TShc1GFAK49A99Q&oe=69B92FD0"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYhSnqu-1xkQ7kNvwGOPrMR&_nc_oc=AdmVPdKybRN--hjRwzUheHE2HIU21_sh3Auj7bey8FSupGCiVDSqAIPpH6S4LxVYCYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxw9kfEz0XDvC2Ui_YJzaG9PZOifZYCQMPqOa9dQKWcfg&oe=69B947F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M2UR6Zq3DcQ7kNvwFORUgC&_nc_oc=Ado43cWomhgDe7mcEbdayoklLIm0h1-TpOoC8PJk0VYCqWmVVURM3n-UlVtKHB766xw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S_njDHPZeInkuiWKrRnsk3PLu9D6pl618HK8s9fFsdQ&oe=6A16EBAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uza27mmoagQ7kNvwG4CxaJ&_nc_oc=AdqBsJe1w7aTXNXTbieq66mjuW1CSclfVpn_BlT_mVqRJW5FOIzMHIg69hqMKduilLU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KnOzJiaDc3aTFXwH4c7SJcoTyF9tKM1_eTK8ab_IpfQ&oe=6A170A45"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vau0YAAWwA8Q7kNvwEMxh8q&_nc_oc=Adr2EHRpjTuXmW1W18Y2F3k2vU1ELrYtXap-QBCFlGrdHKZbxOBozCE8syLn8qvFCC0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x551qa5ZBNFMQsf_o0yDKJzW663oMwgF9RvuGPNyUog&oe=6A170021"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVs17ncYcgAQ7kNvwEh3RI8&_nc_oc=AdpgjJmqinA7AgJ-tKrZQ3Juz1SfdR8AC27fyJe-1x301LzSFcyJPiFcIBJmozwIC30&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74en8TbrQJrMPcDgugWJttHHNFrDZZOShTRu-vCvssUA&oe=6A170290"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOWMAMo1psMQ7kNvwHozY7H&_nc_oc=AdoRYjXiF75gH6wdDh76FNY661hjX7zVImF-woBQA6wTfpWGcHOdJL-7LoGAN0Xbjkw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69GAvZrLP-fT2a440Gvg1-7TjJi5JJVmLIh9i9aNO_Qw&oe=6A16E273"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
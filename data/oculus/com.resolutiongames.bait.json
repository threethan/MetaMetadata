cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEqR71veEWIQ7kNvwGRmV5f&_nc_oc=AdoKpaq4QdidKeZUJgnsB-xfi-TtgpJrRzv7CDyWQxQSa-VzosaYK-cF566srwncxa4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jpyJo0zUJOlPa33NpjrRwFpQRTnKyvSm1RXloqVIQYA&oe=6A2FF82D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=th44ZLq5LF0Q7kNvwEc9tO5&_nc_oc=Adov-gHG832V7FUZJAbbQ3Aj3qDKLNHTFYffDtQ6X0eJAuSSH9itDS3Jv2zNzxqrqv8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E_oyC7UeID9Up9p-HKoKkklilunUgyEXPzF26VnHoMQ&oe=6A3016C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLh3ZLz7K4QQ7kNvwHELJXY&_nc_oc=AdoP3_wA0hCSGD0vY6Nggw4OqkABH2wbw-K-NxGT6W4fOtXsFJ-oy4LgCU9MdsKyAN0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DoDZ9ewAryfAMd5PDAXpdv7_byE1yBxzfJngdWYWEaA&oe=6A300CA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvlrCYLjTAsQ7kNvwGYnzlx&_nc_oc=AdoYeyxJAfq_fcu1wZMGEJyRGbu0etzodTx9Th5pAVuTZndr2PawmmgN7BI7MDRHVfs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZbbmtxR3LGaSoXp-9EP1ZVBxWcGAM1gWwiL3ZTtBhmA&oe=6A300F10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai9on1rsXmwQ7kNvwHvmMnz&_nc_oc=Adok0EDPPF53w5Cqm49M7Br11OQz-YBeODojb5h95Xl3s__l5mQmfwZGa9p7Sxyj7n0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-t46r-L43t4MJtYl8JPpqSKe7MnypqgbXLxrU3pZEGQ&oe=6A302733"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXToR5nvIIgQ7kNvwEC5lUd&_nc_oc=Adq-n79wqGR1NSvGWDmOsC3m01RzjQi_h7_4X9OitWJ4yv0owNCB7Jy9hWbDdRp4QnM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23fPL34Ntcwer9sBXjlLWNEXxQDtDYugXHzT8K3RCf9A&oe=69E775AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsq3AasxK34Q7kNvwHrREP3&_nc_oc=Ado86yXoYUBqURGVwv3mkAowmjOPEFoN3jwE4k4pe6vHpHJNVJ5jXoXAXM2p-8rSeLY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07Uhb8-aQwbVvaWxbLrFGcOw4Xv8YuANd9uNUPC1ZQKw&oe=69E75C05"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8XDngw97IIQ7kNvwG9esU_&_nc_oc=AdpfFpaoEsbAR314c0A3E-PH3a4e9v7fmfqea3Z537Csz6VxLWhDkWM4OpdfjH3bwQ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NgDVAGqwO8gQrgswtqr9PJGl0LNVWXT6QCN3L0961cA&oe=69E78A21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSeY4bK6hVwQ7kNvwHnVtZi&_nc_oc=AdpVexoZykkBvGBNfa6mxbsrlIQxV5Sy90NAlN8Sek_w-QVSv-sd9RVrSMDe2V0GNbQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YGccC1yJDUyXJBOlmtQ0wvM2TPRr9xyva2KSel5hFrA&oe=69E78C90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CushmS-4WIQ7kNvwE7nJEK&_nc_oc=Adptb8PqnmEclZdBy0awLKOQvl3Wl9B5i7I0lbhUi26GxAtMUdG9-q_6thif9lRS3Ao&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21KD5AnR0UCeFFg8tgCGgdpBlJ19kdhhDWB8i7FnZtQQ&oe=69E76C73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSlnrW3crcUQ7kNvwFQABdt&_nc_oc=AdpXM9utQaONPG-vPJA4l1L4XafsR32rQWJj1HtR_xLxp_WaVEyABBOxDUtO1Oh57k4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PJ0nr1rFOhFDZcc22QP1cAVwLURRS0zLQ6CfwmNzLlw&oe=69F747AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gTUCE1DHFoQ7kNvwH9f_0r&_nc_oc=AdqAfmkIfjFPudcaa_Adp5x9LeXzDNNKKWX8RN537ECtpeoGxAfHbn8OQdtjVY2nK98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jkPJti8yIat2Oyy9dhfs9EO2lsTrNl6mQtgkbpIcFsw&oe=69F76645"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRrISzxJnf0Q7kNvwGiMhRK&_nc_oc=AdqaNPDk1NJWch_qROvCTAQnFRAGKc2Ma2T-lyvfs2DiiLyTBUb8bKBF-0yaryuOhws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oRWz9OCQRogvP3x2PoD0zSWOymbykzpdZtroVQSUQQw&oe=69F75C21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4dFW76AM74Q7kNvwHwIvDO&_nc_oc=Adrhz5VLDKFxtem8WPDTTHBSK86y7BW8Q7pO3dgQ9GpLBIpWgIuRXKfwigTcKtKMQ1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bXcOJroadkPCLVApHOAwvKCOtKWzy38lQUICbTRNjbA&oe=69F75E90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j61qFiR4T_wQ7kNvwHbj83M&_nc_oc=Adqyfj8hlmuyasBCgBI1tqov_mxA1R6uM8zUqQxk_QkKkax9FtsfDUy2RXke0IeMH30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bEsqlM4y2xdUQh_aTxdww5KRZbGWvuKNMvmZ3Tof8SQ&oe=69F73E73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
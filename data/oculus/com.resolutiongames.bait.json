cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UU_jbBtAQMEQ7kNvwHb8vQf&_nc_oc=AdpNgFNpMIdrkC1_0JjJgE0PHDhO1aomUSU2uCv62Sy60A2zDy6uI5p24z0ztNo9nbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KgzuZ4YEyhV2KspJ6GtU61ftJugfT9-01-_dwRiZ3QA&oe=69E4D2AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHk1AqoqQA4Q7kNvwGjV-ZK&_nc_oc=Adpdt35hLojUTbGi0kR1BxuXwz2jQTX-hsb8o0lLAaNOnmN-lsAPlKBv5tEEGsrq_3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vt1Dhw5cftn2EHSkbo0vgDX8ZqjcvVr6e3Y4EdJ22SQ&oe=69E4B905"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwpAIAex9GIQ7kNvwGWc5Yc&_nc_oc=AdqmbbvW7RyENNXGdp_XB2ir74mA5-8gZHK52Hun6TveX9jbPi6JVkKQ0Se4OkqIr48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m9S55GgxFFhRg18y4DjA2oK_o0jvzfvBStDiGZJWKfg&oe=69E4E721"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYO-JiQnHSkQ7kNvwH54Ep_&_nc_oc=AdqtYHCb1bLYGDkt6Wp2MGQQxYM0y2yXN2_Pg4DKmRxp6pkZR2oxzY7WAidFoGxJ31Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n5rBk5uGr0kDzH9oFWCYrp5gYcUuGgKPE69dYX-hxXg&oe=69E4E990"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CushmS-4WIQ7kNvwGQixKT&_nc_oc=AdqU4LbnRHVLLwfd-aDMifcWvOp3ga8XDN9O-4m5X_gv7zkDw8qD7Ag97-NOt28uqRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TphLtwVzzYbClvcmbdqtfadXlG_friBZCjhOiHZEXYg&oe=69E4C973"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmXirvvk89YQ7kNvwFDOd20&_nc_oc=AdmQ3O2HY8AoxF8g-Es1cLLhd2dsk0h4UlSQyubAGLoKChsetUlVK9h-p_GMQP53gMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsAj4IzdgfFbIOTqSdTWhW5KKZUDYMu5KEnuwmeCSJJBg&oe=69A82DAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGCIiDNloq8Q7kNvwErjXKU&_nc_oc=AdmLDQO_ykzZni9dsJ0Fnt6Dg4Q2VMOU0zenOvoedxPIyuiX--IoKivXwcyT3Fet1G8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsxhftpZ60fKl5EmCrcAq-nCsqNxOnuV5ffjrQu35-dVQ&oe=69A81405"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZSWavTs8T0Q7kNvwHhUHWh&_nc_oc=AdkjQV4mm5mUZ2aDLn4iAh6RZYCJqj2Bhj6u8q-Hz9ypL4hrSr172nsmuIpQpKDgp3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfszB4J4b7xTecA7z-J6i3-VGHjbKtrh-4g39Xk0SCGcRg&oe=69A809E1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whIeOxRxOgUQ7kNvwH1gbe5&_nc_oc=Adkd8QpNJ8pF43zroHZ0Q-K8i4e2moyDR8_6C0OnHJ71dIVyR-1pCJ7NGkskYVp86lc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftgm8EX6Ir0caZUydG_JsJtv8FiQTHM4Z0JbA6IPayNkA&oe=69A80C50"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO5R2MGNxfsQ7kNvwFix-al&_nc_oc=AdkFC1_u3EX13NzkJtQEcfNM4P_DIX3zKlkWBqxOy5lhWtkpHU-F6kkrJ1Ikuv0RRak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftsXWQcppiAPvtTg5tl26ewU5I1F6aEAgdNt__DTMN9dQ&oe=69A82473"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0_gxJG2-tMQ7kNvwFcs8MS&_nc_oc=AdkuAlFXvuaKJAqeCL1J664bdllYFqtEf6ClO6oXFigB1OL1U2q7vU1QCUmOBPyxzrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0GuYnBYJnBqcBD98rd0FYT3z4kGj9SZp74Gltslqyug&oe=69B7FFAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbKJa7xGrtIQ7kNvwG6HIo8&_nc_oc=Admtrtufsq2LcHlmgLgWU5nmwjN3V3q2ZpQzXtku4gGFLCQwRh1EM8JFSxjY36FESfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBZlqLkXqdA7CxFdBVf07vV-PdsRLX8zmjox-PKagUkA&oe=69B7E605"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vIu0ybph1gQ7kNvwELQnu-&_nc_oc=AdlWRTwp2cIGSo920rb_I5Idjuw3o5oIQuebcW4OAzV6Z3rSlUlqXdIGiddcetrpnOc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzr9rmAFj79VOu1HclZV3sK3I9D-aSmFzWYCMDhWqV60Q&oe=69B81421"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inrgu732noEQ7kNvwFyXSiC&_nc_oc=AdmVZhdTnujDMkOISsRasoHw5ClTAqTVgXqtXty_l08sZvF0BEN6ekDZVB8vYs_3LyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLCaLLLfiZd6O7kuJZOksfNKb3e13X-jB-FYKUgJM1KA&oe=69B7DE50"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCnSpy0NGUsQ7kNvwFuggHx&_nc_oc=AdkyWn3zMtK9gDPy1dKfT8fxTNBjBWmS76nEsrB3tVATrZz0d8pZCX8ZVPoLl2witKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwIjhiOB9bdEn5Hbo3M7RkpTwDjAjXLOVUNprkIjzAFBg&oe=69B7F673"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
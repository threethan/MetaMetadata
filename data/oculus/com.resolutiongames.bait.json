cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSlnrW3crcUQ7kNvwEsErPo&_nc_oc=AdrGmpCJX6By5OSq05CO_PktEQ0dmtR3BFgXMfkeyMdj9_BKmymWuTtPbmt0Sf72rno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yNrJ7EuI3ZQ3B1sqZHVMNM_Nd7wZVmRmQ6qncdAtwVg&oe=69F9EAAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOWZ80MhQvIQ7kNvwGmOHcW&_nc_oc=Ado8Yj2rZXXaYcrskd8cIChEM4do7ZSOLotVOrhumx846kVERmLRdw24dDUNE-iaHsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DRjeKbgxKrLc82Ah_JC9-J9XAeHfXsfb9G-QiPueoEQ&oe=69FA0945"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0KiU1BN89MQ7kNvwEI-LTU&_nc_oc=AdrHcM1jjd5zLaeGd8R7FfMy1IapVmqlkoZ-hqBocFQyOqwwf3YCMVKi3DDV3jyZB6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44_iKYQsSAZJTRAVwp6Ud1rthlOIGhk7ufFW3lo7UwTA&oe=69F9FF21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4dFW76AM74Q7kNvwE_lhGZ&_nc_oc=AdrRmpgbLinbgN2nyO6YSEz_yEgp9C7_BYA5edKC4GUUQO2DtjihrOkyrSHMPDgAt94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4StBBmnU3cnXIYHcRzzjLn9poNm4gQQ1vO_zwpSHfLNA&oe=69FA0190"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwC9fVqkNwIQ7kNvwEx7htX&_nc_oc=Adp_MQuseVJJCAPe1-VaZOk3fosIE_AACBL65RD-lZDM1h1MRJYUw7bswEFO_J_YJmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sChL8411VqbtP3OVcxPwMFsgAbEs86GY9mZ3pHyLTaw&oe=69F9E173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
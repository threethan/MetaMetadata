cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXToR5nvIIgQ7kNvwFn8JM2&_nc_oc=Adpyt5dSZnsQgnZHXaPBqC2bCdXLxenJmdN1-cfLOJ8siQSUZJ8yrBwYcIEUuE-QVGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13XfBlCQXgi6nKb56HZJKbxF4WeCQjVdNS3jaTEPlrkQ&oe=69E8C72D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsq3AasxK34Q7kNvwE5j0q5&_nc_oc=AdrWg8qFj5e208eSjtkpcq35g2aVp9NZNMGhNxt8eJRg9edw-6LsxKNNarL88zqneKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D6KjA4M_29COngDBZyHBwU-uf6dCYm0DwmBfXks0Z8w&oe=69E8AD85"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8XDngw97IIQ7kNvwF8kvj9&_nc_oc=AdqJq4aiEB-AFhvD3HpoZY0MotmrKLVuB9MDLcbR-CC-5Lce-HllhMXXIb3d4kIE7Ck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oM899IRCgpHgIqrrHMvHTTCRXrhunk22k69utA-bgtQ&oe=69E8DBA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSeY4bK6hVwQ7kNvwGiwVOi&_nc_oc=Adrih2uB0tFeDC7PFa436CDvIVShZMuBnEF82mkwGCD6c3HD04QUel6hVyZtYd5U4DQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z9nd4Rocd4XZyuvqmnLuaPV4mw4uMkeRjYaSAtja7eg&oe=69E8DE10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF0-_YPd5x0Q7kNvwHE8OhY&_nc_oc=AdrZBWEGNXErSDqELbuVwwmPYRXbUD9EkF6WhAkq3oMBnyCYEUOKg3az9D_zKDtIgtM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SqQQfjV8iUJ_EA54fwcpmFTBD-fMzQKr9vjlFeB49Iw&oe=69E8BDF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
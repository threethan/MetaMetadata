cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAzliZdgRQEQ7kNvwF8Uhrn&_nc_oc=AdqAn4IIvwq3mPCoCSed2ErxspFqS1OULCvoEpNc7TYjfKTfCqzoOyPFJKaxXwaZS0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Mqrcbotd9I2PN4eT6nEZehSPk6XX2FVUyJE8xuHeZAw&oe=69DF8CAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4LEClZFxYEQ7kNvwHtkswf&_nc_oc=AdpVAm-YorYgQJ9ofQ9Y76C0wIWkIL0852UpMMa3DcrN1y0YwLdNDLVbT9Um7BJoJ7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16_jlmWauCbAw_0TMnIQnUqrqBSTlfPFW9L9KEdKqYGA&oe=69DF7305"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xCnXHS7lFcQ7kNvwHaAWQ4&_nc_oc=Adqr7hFHZT6otLVVSqnS9S0YnLJa0EqptbyxQ56Rv9ZO2VjA62DWbwAmS-ufi6emKuI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d5rRHseWNYMQf87KoQ1VLX0XroF1hJ5SIO9Z46YoPgA&oe=69DFA121"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hcMkTb4sYQQ7kNvwFB9LSD&_nc_oc=AdrXEIS6bMVGNCOnQV_4TQqUruxfifFcTjdIp4Yp9Yc0hO59TZ65GQztKhFgTW4RXcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zS3JClD_CCduIPB7zeELaoTw-RNF4No1Dqefp5h3erw&oe=69DFA390"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwjQWtko2p4Q7kNvwHoX7kw&_nc_oc=Adq5MaHHEkSac8NGMoIzOkB1rY_bTEsoj7r9zswQkS89WQfcSJoObkuUoSA6nntB-OI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22_XeW4oFRYhG3ueJg1C5UnoE1ErfvxkwkVlOxJxVh8Q&oe=69DF8373"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
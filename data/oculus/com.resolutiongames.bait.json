87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unzJgc-kEpgQ7kNvwEZqdEt&_nc_oc=Adk6xbzBpbXpgklxm89IYmivS7xw4N1E2kpnvoK0tO9kmn0j0qhkTJiDMhYXIzrfVtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyubSdx00csCK9KUSnED7IicJoOymyEnatVc9aYBgnHDw&oe=69B55CAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rbclaQmiXMQ7kNvwHG-OJa&_nc_oc=AdlFFQTZKz7KePsjXdQA2_gz_6JHMBke_9apKl98AnR2rBGtrEinjBUgMLzO6Y7EAcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxC8Qw4y0NXCg_mgtXjIc18aKBXxgXU-1D2wgAFvwiwQ&oe=69B54305"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmlppfqz2WIQ7kNvwE6geQd&_nc_oc=AdmL8nb3zooUDmNcD3qkIFhgw1WKH0nYC7OoB7xcZZKLW9Wi6RUgUSeTtsUwi1CDTQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz42Cow1xcJA9I2lX6mv0x9gj8TJajpX1noKAYllta08Q&oe=69B57121"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAs1M6r3CoMQ7kNvwG-m3rB&_nc_oc=Adl_JsYiieD55gB-uPc3fLQS_jL1TrCMcO6itnd37xpDsH6OYhUfHJx3xQqRXQUZiRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbCV4IUosA7qWFJwTETVJ4yNg21zVXM2TZHjwte0w76Q&oe=69B53B50"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCnSpy0NGUsQ7kNvwEZBe6Y&_nc_oc=AdlwZg_7JbuqAjqY4xlEQl6u0hdMOqBKlewijHr5DgpVq7MP7kf-qKAyRj5t-f__GaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxu-esyeU9R0gxVRPEXIxbE1KUHKuFNfZwy263-Nsv55Q&oe=69B55373"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
2138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmXirvvk89YQ7kNvwHFNQIr&_nc_oc=Adlj9Sj7KYhsBEd0J98hhZeZhLjeOtY42h1kTlNF47DX5s7xr7r6Fur46PQ31RQnqmY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY2_Nu_6MUeGx3srHjGFatgg5gnYFMxx2uT_x0xERwOw&oe=69AAD0AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKy2kC_2Xq8Q7kNvwHMn-1I&_nc_oc=AdmQ-G9JS_1puWmi15LVrpKVd4qlCJ_GGEQHa-nflXkA05fuKT0Ko9H7M1rXwtiTyfE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJD3Md8L0nqUu3YMoiGkVZM0wsD9hLGermD895P2csag&oe=69AAB705"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8-Kd7tGDIQQ7kNvwFScaG7&_nc_oc=AdmG_kvRFHkkcwFFE01IzvnxkOK7KhVejoyeIwxRxAGf7wZJ3XXP0wuJLncanUupxeU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkhRcuwQLM3Y7yXYZOcd0d6s_Nr_LA7FeVMJ4o9psb4Q&oe=69AAE521"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whIeOxRxOgUQ7kNvwHpPSLe&_nc_oc=Adl4ZeOYNFRBP4u8y1PxkuBLqX5gqPWOxtDSPOiNeEuRuJW1tQy6_Ok--42K6sBL8w0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfySUwG5JvSE5Dm1gGIxj8U0TgqbvpZnI40bmtmz6CWcQw&oe=69AAE790"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSiWVSUilZAQ7kNvwFJwsZ1&_nc_oc=AdkoORL0soTp-MGEe0fGZZpAumSuGEY8LKaKtsjzdvJbxk2-hoMqmNnmqXv-hwieWbE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx95dznl76_T7AYf18BIEUxKP1MWhnrIX0jmRdLsehafg&oe=69AAC773"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES",
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb8X4yHZGNgQ7kNvwF5h0ty&_nc_oc=AdoLsdKA3ppl9WE7stP1fb8XY1K4Np94dUAfkKtO4YrfSMlPfo_eZM6EGD0pO57Ke-4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QfHUkBTAV_7Gic1TeXRY1AWqLY29zqUmwHfjrurIzOA&oe=69D7A3AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqMXayVOyi0Q7kNvwGNEnUA&_nc_oc=AdqP57onops__wGikWUM39PAnIaj-rPpRabiTXyzHZXKXQjivCs6vD8dYufUVVMxRBo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lF7Hflnra4PIgCZpjJNuzZz1GcJPww6n47r4umSZxjQ&oe=69D78A05"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOnFFgRt68MQ7kNvwGpnZlm&_nc_oc=Adpm8NVn_1WPMX2TQgn7JqXlLlBvyOA46_psKVkZfObBIHTIljnyAPjwfCg-lZFMP8U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af031g6CkkrRdPpwvyAY_fVOx562rDC-dIIhSLHAQydrDw&oe=69D7B821"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XJWd7IYgzgQ7kNvwEb6qs9&_nc_oc=Adq2cCso9o3ONt1cn5eOzOVru3j_b0gAolZqcjJG4FJTvcfwcfcV0UOuFLZMPxHRP-4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YS_LXIPd82D-EuugZfYVKT5f7P1bDQ1TpALu003joGA&oe=69D7BA90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLSDs47YjBAQ7kNvwEx5vpQ&_nc_oc=Adqq2PST7RBKg2rD_dEsvuvtYVKY71uAGnCJmaH8uWEZzwP3lyyqm1wYv9czYz4246U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R-M_X4jTEXLEpJz5lr9_0H-heswqiuzDhLmFIJbfagg&oe=69D79A73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
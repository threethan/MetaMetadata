cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXU5kXzz1MkQ7kNvwGRRXMd&_nc_oc=AdqGPWtEZOO-QqtXdChbErRD2YMqO8CjcJjaFJLM6jwnPct0JaHg7LN1Z0ps4I_ZL0o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d8rmR91_wjjguIk_3Bkh1jklkJTap9kNa-3prp6q8Lg&oe=6A1C31AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOhPKRP25XEQ7kNvwF8Sy3b&_nc_oc=AdqSnLfHKCMY0ayiQqlafF_hNXcW-Cr2R8zzQtlQR0wwGzZMl8BHxycMIilhjWPwVbo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FFFTA9pv_QWrD1qYCk9fOO9pyVrcoiEhftJDcohxUoA&oe=6A1C5045"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SmkdkiJAusQ7kNvwFKisVZ&_nc_oc=Adr9XTle3kYxeiA91SxE1mwRxLiel6INyWU9WpnXuouHOtkAI5gohyY3UhZNZ4aAuNA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n1-PwpFIWczv_dwiw3m3XfetOP9OUcAvt_kM00XBF5A&oe=6A1C4621"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v57Tro-W4EcQ7kNvwH0H-Lg&_nc_oc=AdodDSh8mEpHyOm-rx_uiVGwBjqtizclW4aIgE0eWIPck-ZfLOj2XqUJA2Oepv2ZGDg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af608EayEX2LDTLADE4IHxkZ921M5YYJYh36yp-piX-LQg&oe=6A1C4890"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvlC2VnJdQ8Q7kNvwEZYEf4&_nc_oc=AdpLo_BjJNFvwIg7eInC4eCDqsVuAzO3hgsbY-u78rZWUNGkX0GpEaZ0deCpTUHWddc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L8X3O5FoCbPIp8GRBTizy4goTpCIdNGTFbx3jcrWfqQ&oe=6A1C60B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
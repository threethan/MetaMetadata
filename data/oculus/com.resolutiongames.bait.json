cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyPdpl8gby8Q7kNvwFJx-Xj&_nc_oc=Adq2WFZYVQCiIBlxA8cxA59VxRuWPziZRIBlVcQS8ZPxyVocLTOmVB35WudaAxxT60o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A-WHdvFOsn_EgeKlycYME5qOmqLygFPAHwEAwRVrOzg&oe=6A01D3AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMmN1kx7LtkQ7kNvwEdHiSH&_nc_oc=AdoVvXnQ0EmK6zlm7J2HJRqBsXMBX74nKc_aMqOBKVa-Uf78-CztlCeU2xkLCl5LmDo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RVg8J8TPTHr1dkI5KMic2FQbN0x74dhiS6v5IwoihPw&oe=6A01F245"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=104sm3UblV4Q7kNvwHt5WAp&_nc_oc=AdoJosOpMbeK3UAB91i9PNDTscTLNNm1njjwv5rj4M4b9VT-Fux2U0iJ6d9t3oUeEtQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62FY9nE9FeSXvajiMuBxBa-Cf4D6Jo8Hnywjb__uA7AA&oe=6A01E821"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRVrvzWpq_gQ7kNvwF6PUou&_nc_oc=AdqomrQgMb8PA_A4gtViQ2kzIAZ24bBIHEtQX6BVACmfXZKo2EuUGMyIGQQTiSVRxI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kPxx_ciih48JwX6HTH_LtFAAbr9NbND0EddoCjQGOzg&oe=6A01EA90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KqL7xz8g8UQ7kNvwHzQRd-&_nc_oc=AdrKvxoLLowbsfBVdrksDWZPyxc5hf510Iiew7S3hMRW9ttjI5-vrqVdOasr_YylrtQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WTyXxTi0ZyEoi082u0aFs30iX75g52FuV7WV4smFh2A&oe=6A01CA73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
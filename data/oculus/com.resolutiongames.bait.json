cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAzliZdgRQEQ7kNvwG1HQ6J&_nc_oc=AdqhwApokrnV9Umk3itvhd2ShzpUei4Uzuv3eqVyTFJBUtPEtvBDAhrXlF0vAIqtEIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WrbeA2FMlHENjFOMJZYTe-WC1G2Yo1G0ezodzYH3uUw&oe=69E0DE2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4LEClZFxYEQ7kNvwEMlBBn&_nc_oc=AdrJCaaYhARekZJU6Q7av3pWBICtfkfWyImIfykGXmPEF4efH1lliPDXgtpu2dbBFFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KJRkZ52IQ5lSDBhJen033o7Ynj7UHdEetWrSLJbvKVg&oe=69E0FCC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xCnXHS7lFcQ7kNvwGnymsa&_nc_oc=Adp83rN6IyIIF-eZ4-F6tlAt9Ltr_ye8QBoocnr7DZt8Rb040I16HVptaBL-1vmq76E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eK1Cp5zMb3WR7BaZmw2prvNj5AG6bME9j5xQ7r54O1A&oe=69E0F2A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hcMkTb4sYQQ7kNvwE7tNW3&_nc_oc=AdrpsLtgp-oqh4t8SiQZ2cInrg-uBt-PVaRHepeUPQhQ94S9-KGFaHV0YuCEy23ccHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00YpVrtKTYqrGIr7RBI0CMc68DMQsmTIVOzc6nSLHT8g&oe=69E0F510"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUHUGcf8nI4Q7kNvwE2JRGa&_nc_oc=AdrGKf-OuwYnfHw_LLIrQfiXtsxNZt4e0Hy8PfGuuwn9YaOTu4HAUMKnqLVDwmc6K2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VmeDEqiTot2rCfMH1kW35o6N96KwLc0q1NWqEeab3bA&oe=69E0D4F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
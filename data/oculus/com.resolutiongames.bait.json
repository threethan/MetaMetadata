cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CXYj6uSFCMQ7kNvwHY2QFs&_nc_oc=Adp8oKW68-xD0BBXg0DD8_nF9gYcmD2Ray8vfzkt9LvSutGDWsTWH9-a1cEhaO8p1hY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qmOSsRSZMZCbNerCPhbH3EIPdmzX-guK-cR0bJI2zYQ&oe=6A0C5FAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=batH-lVOyk8Q7kNvwG19Tz6&_nc_oc=AdpYHukuaJHj4otax3a-wS3VbExM-gCpwB5bNL7gaaNtPirYHGKLkxGJoNYS_zzH-hc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Qymo6aBB33LalEn9DP2frceXnbxsYGe6db1ZwJGzHQ&oe=6A0C7E45"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfvOIP_YT9gQ7kNvwH2JT5N&_nc_oc=AdoIfHX_sqr7Ak_78I6chjtQ_uyLegSIP0jprv1bIhwLriAe_exQY73Jc2-QFBMSzUg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tJpOYr2x5WPl14yQ2yCWMW7UsmZEaHo9SMGHaLyuc1Q&oe=6A0C7421"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ypzd64huMk4Q7kNvwHIbXgO&_nc_oc=AdpQnyTHh2aLISM8Z3uS_O0KGJrwEYRNN3yBj0bxSg1V05erL6s_degPLzzKkSghmGs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pidPniPyrvxG8xpsoqCT-shKZ3Nr9I1_MyAUQZX-rwg&oe=6A0C7690"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaJBWZ4yDXAQ7kNvwFLOS0V&_nc_oc=AdocraBGRr_i-cVQwwD4WAldzB8TSYbm9CbZvdVRuDcO_CyWQIB9Jzf29iXILErHWlU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VrVs0HDjyVG-Gf55UG74qtoeC8qMY5-D7Ry3VNLs38g&oe=6A0C5673"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
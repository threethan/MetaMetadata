87_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unzJgc-kEpgQ7kNvwFsoSU4&_nc_oc=AdlfE1s4Kgr8hq5FVWSd0ifr1fLjVC4hNHVldoSIyxI3iqQwEUMqiEP0Oxh8TjWIG6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0uVlNM8B-ff8swi78ByX6p0S25YiBVqlY4GkWXIOLJQ&oe=69B6AE2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbKJa7xGrtIQ7kNvwFpg6zD&_nc_oc=Adm1oH2RnB1G1E2yxX9QwY4vTQrP2_0uk_dYwX7V1-Hah0gqF5oxZdsM4pti0t2z0jM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXN4heqfN8QY_4Zd2EX2Shq6xJA253uvpP4gaGbB_FEw&oe=69B69485"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vIu0ybph1gQ7kNvwGNpy7G&_nc_oc=AdmjsUQvXOJJX4aD-qpSnq_hBmQ0kEU1yPpRFibHjr2QNaSyOajX6pDk_rK-SgM6LXY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVSYSVjkIFbTGmKpgGch5SPkFoQh-Me1Fc8udLknYqwg&oe=69B6C2A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAs1M6r3CoMQ7kNvwGGkR-U&_nc_oc=Adk5MA3NnAMX_I_KVSmTEvYcPv1p3_RiRFMrwlCZpYBx8eir7cqY_uzb9Bb7azgSfkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyji9LkF2Ukd0e0MS_OWjxWICnkJAKPk5TdmrfEgzdkNw&oe=69B6C510"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCnSpy0NGUsQ7kNvwG7w5pn&_nc_oc=AdkK3n5bQaATpS6K2XIN5S-wZ-6QG8gPKHizQikwV3LvReT0_X_YdZnh8i1cWd9PFgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRqEBNrTR_eD21dHSP1yL8C2Z5LBJll0e1KGrMCJwQmg&oe=69B6A4F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfor
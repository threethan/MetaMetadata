cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSWfAnM3vwQ7kNvwGjE7di&_nc_oc=AdrVQINWSkSwv4Gp7UPRfXZnAdtz1ZPWsYD6aRB_1CzPXb4eG8ZK4aKvVLNQTmH2cSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysSTGOs8ScQVAC6WHbC8UMbtXYrmVayoIGIxebUXtnkw&oe=69CD17AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbCTpQQdXFAQ7kNvwHfH9q9&_nc_oc=AdotWuDucpRxsXslSLwN6L3kF7My3s6a7bajQqL6UNQc8YWv9BnXqoKtqmGZKfUirhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpK41hWHzZrTeVWsXLvpUJz8igzB-JyRfTZ2-_uYWmjA&oe=69CCFE05"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keA_cyvk52oQ7kNvwEh_luK&_nc_oc=AdroDe0AGmgWvR8u5__EredosinYPY-Dnjcvi-B1oHUZF8Czz9aIjqoaCYEZnituZiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmQWJnMYj19pt5Vdl9aVT2oXfrBZinkyjNhw6A1Y-RAA&oe=69CD2C21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLUFfB_67hMQ7kNvwHAKtPD&_nc_oc=AdoKvZU-Mhaqqf2XiGY9q878veKHG7we3M6OaGGTfQvJqXNNGV4tor4U1jBZCj1g19Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBg4Dqnebg1Mi_Q_2Zyrr02vM0NVchtY2jKRXLxl1lPQ&oe=69CD2E90"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwCsXaJd71IQ7kNvwH9hZxi&_nc_oc=AdpQLLGKNF7zmwen3-m3btYFwRj-zj6p955dr5vP4Uknlo2dDo07yfRaByIM3efAh8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2s7ypmAionAnLk4H0GQo_0relCKvB1AoXJUHXLqBmIg&oe=69CD0E73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
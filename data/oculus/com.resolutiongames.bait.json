cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot5r9p0qw4QQ7kNvwEE0_HI&_nc_oc=AdpwpsrFqydIGQvDdVigBNwpK0CI1bg0tKPde3pl_VcdrBdnr13_UVBDSJ2pnnSnoGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O_ywjxUsA4DkMourk8CWE-A2jIFy_x83nEHD-TeldHA&oe=6A0719AD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXFTaz_gJP8Q7kNvwFKUlCz&_nc_oc=Adp2pnewheljM4NN2CkaHRHUc7v7AcDS5jcULCZYpp8NtLtAg8nQJEsQ1z19IqF52AY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vk8UL_t5b4pPdk5t9gatlZXI3Z5AHfzu8IfFQ9RcQWg&oe=6A073845"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scCkVUdHCP4Q7kNvwHqOKtv&_nc_oc=AdrIRdH82sUBChvqdyO4hMOJTDCvn0KJ5N37zAXV_Q0BtyZQBwMXEZUk3w8DSX9p7SY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nv2gz9O6Mxrz30-sP8iXWmxL1jcAibSlM4JBF5EJbdw&oe=6A072E21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlau4A03U7MQ7kNvwFslL9D&_nc_oc=AdoYxhrxmd21kQv04V_3MUD5BYqV8_2P4yO4hJmcYYn_upL2NFBfKsa0lIul20n0NAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jSxqU99lr5agPZBdgpt8BT0UPonBZQUQ_TJBXuOToUw&oe=6A073090"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5CnXi_R8HMQ7kNvwHzJDwS&_nc_oc=Adow1ZeeQxebY3qPnQxqWIhvq3c7S8o6dU9uQ5cKZsFDKCet5JrdTk_TxCYNdOZYXGs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-AZujlV-RpIiCAPJg5hWbhtyfdU-2NfU23xKvRIcClQ&oe=6A071073"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
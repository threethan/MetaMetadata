cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSWfAnM3vwQ7kNvwEpFaGZ&_nc_oc=AdpJ4thAMvjG12J1zOQH1ZTbP5RBok43FOWXntZOvaUuzIzHSrjOH3n2QXJzOJ5swhQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz_VL9-r3sKYMFutUrpCj251rl-zd0h_KeU-JaVEqcsA&oe=69CE692D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5XhFpGaSWIQ7kNvwE6Us6a&_nc_oc=Adq4SyBbQ3StY7OK5voA2ewSOI_7K4sbVOGaTGxRpDA_pxbUBbjxQmVDlpaldbyNX4c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBLJf2kC-KqbEAc8rETlVX2Dn2rg5PYQMur5TTXEUFYQ&oe=69CE4F85"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU0bajQQzlcQ7kNvwFCbq8L&_nc_oc=AdrdcW8KxDZI83hXrBTZ0bwBwVlak8IZ2_tK1oMs-7nS_QdXRJ63s-VJqW1fiZMPzJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQSd9W9LwcZ5sydRaIygyKCL4uCwMC9C9vmBhxZ7x4AA&oe=69CE7DA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLUFfB_67hMQ7kNvwFGsTCU&_nc_oc=Adps4tGPySFyud2mnY4PBymjzaNxAxjm37HfpAFocjOfAYi0AdD_lot9uKE63ZzdM2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxF2XJkXfd6DixDoS74uuTpestPJTFOCpoq41PzY_Hg2w&oe=69CE8010"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwCsXaJd71IQ7kNvwHAlZbF&_nc_oc=AdquCquHAGMCdefPqlUdkKFg2JpfjVRLiDAQ-11JZsWXPcXVJkbZOTnLmWtBrbCFoKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlpipWP8BlcEuyL5ql3oxT452vB94KfA9hhMkAOMNoKg&oe=69CE5FF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc7ep4vFYKQQ7kNvwEc05_X&_nc_oc=Adq42vNm94CNN_ZyIDCjceDEmV3Vy25nlkgBWkQVVL8EoOs0_VZvfWnbYdu_iNOArMs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tsWwhdVEWFZQBuFg9mV1ALO3dxyQ9nXLQUBEB2q0tqg&oe=69F5F62D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gTUCE1DHFoQ7kNvwG4dzw3&_nc_oc=AdoX7cx4kO6ufO9KWtGycbDzfdzQba3qSIYrLF8QhBn5c1EQzxRrARCfVjtKMnA69Jo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38xE14-CApUkNJcUKmJMJsiv-m_W3NQZZrkYfHsL12Pg&oe=69F614C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRrISzxJnf0Q7kNvwE6nXjE&_nc_oc=Adq18XJ4LuW0NcMAdFPgyP7HKWN4fbVHzLDGlglOayINs0cG0vT2vQDgd0U5oweJEDs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08iD8bXkgvZLMzTBcZDwEG3uJ2yuTxvd3yQtyk6zlk5A&oe=69F60AA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8YU16hD_94Q7kNvwERbS02&_nc_oc=AdrXhVQYrs08cCfOLIxLV8id__uEV8ZhUZdRD12oJ0BGgoOH9xqTt539EBUGtLJlWQU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dcAaMmrOziiqXINb9eXrjc_Q3X4X7RndUtNW_JJN5fg&oe=69F60D10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j61qFiR4T_wQ7kNvwFBLI_4&_nc_oc=Adr0an3YcigKsr9nHW3ow8kcByKrlTWDBk3PQjuJ2RMjHjhDrGgF2xcgdVwSjFyTp3I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1h1O7VdpF2LnREA-nvZG_v2S7oYIbHe1ugDB4nQPe5Wg&oe=69F5ECF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
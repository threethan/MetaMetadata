cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKbXqc5xL_8Q7kNvwFGvIwg&_nc_oc=AdppWycK3a3VJkH2-rTZD4xqMSZ7lEcEWtI5FoydZYNh-Yxp7G5Mq4BA2B8h5_hZsiE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D6khZGOxcOWo0vP3dPnZ-_Py-Ibt9NfbJ8FNRf35XvQ&oe=6A241AAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVZRz_MceNsQ7kNvwGO_ON1&_nc_oc=Adoa3Qpu5IwL0irPwBaC1ArpuuqDyy-dpBSTsc7fzE2yco9D9qUd2APZhJ0pfsqOAs0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lBV-OVWea51S4Wn-zmoIz725OkD8liIM_Mrkvlvvbiw&oe=6A243945"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9edZghgnUsQ7kNvwEZ5dEv&_nc_oc=AdoyRub2Bw5v11l2SBH12TZE780-uNIMS0tOK6UDPtuYw4uC1PDA0JIqvV1cTKFcLj0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NF1ukl58f9V3Quf1Lr9Yerh8MU2uzUs9thpOsglfI0g&oe=6A242F21"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuI6jBUAh0MQ7kNvwHp1bYX&_nc_oc=AdpwXtdan2fJFLj5rKHAXFTIwAjMTJshwrtMeQdhHEOw9ImTO_RGBq024qStjGGXJ3Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qzkjzUAvm8bOp6tfQ-W9P1KgsuS1elJiW1BlXV6pBHw&oe=6A243190"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOrgz6taV4gQ7kNvwFXeL2A&_nc_oc=Adp8BDO-LcGxL93kZnYOf3etpggnEaMtW_xo0IOsLlcvTQDZIAk7Bh4xd36mxE5o3js&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4ulsgp0WIMvfK-R_ngyeBR-jRixaRe2E6oxjckp5UiQ&oe=6A2449B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
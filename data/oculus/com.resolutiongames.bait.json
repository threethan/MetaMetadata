cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc7ep4vFYKQQ7kNvwHXKnyd&_nc_oc=Adr4NjB7qLJlzeta-IyfOWhzGKLuLjtSNQ6ivmfxH9MGlYioHXw6OXnliL6cqODh-j0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-tNjZYql2ftXuLTasjOWSagVQ6hZxsUiJ6ijMoAOmdQ&oe=69F3532D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MyUXAc6HSgQ7kNvwEBcvAa&_nc_oc=AdrFd0R50mmxWB4_K76nNbb4kQ7109heA_F8-ziV6bf3ueV5WEWkmg2iRPz5RD0_w3U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af187HhiX1uF5W2fa1BudP0DJ9rSREd7kLZeZgAs-Y34Uw&oe=69F371C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnCCDTmIUIUQ7kNvwH_ek9H&_nc_oc=AdriwWlYeQi1EYqMs7-Z07Q_VVhS1waq7PKG3VynzKohbzjUJURt_J7gJ82av7D-D2k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yFSkKD2brbkpbHBpt2lHUZgJxkjTzyonsrD3b_iFmFA&oe=69F367A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8YU16hD_94Q7kNvwH73We_&_nc_oc=AdqTugUPcSICPbXo9e34U-CdMwHlc__F1JdMrjlYYothIC8WKZX7hJHqRX6SSL5ul1w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UCV4pAxKERzFtClSswlgO6v1PykqUuCVnIKDyWaLOSQ&oe=69F36A10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lzGXg9_KmIQ7kNvwEQS2di&_nc_oc=AdoTnexyfpb1zkCuuywhtvGmfpE3N9ui_VGCVYR9VQ5VuvLCXShgjXidOSi3uoFCznw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tpL63Hmz1LB7iyq2PxXuyTJ9X4dy8CfzODyBqZNN4nA&oe=69F349F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
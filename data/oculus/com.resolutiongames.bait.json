cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAzliZdgRQEQ7kNvwHdJ2zR&_nc_oc=AdrhTsm0OZjX6rKrVKOigepdOYovYWejHSLrobQ5iV3vb0j7mVC7ogK5AP5klHmFh00&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZJRZrpy_iWLTHuBNQmbAFaDlrjf5s6UreL5-zsQwnpg&oe=69E22FAD"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHk1AqoqQA4Q7kNvwF3aOsV&_nc_oc=AdoGnpY6zq9RTJMHVyMjyakw-iATpDtU6UHUKjSyo87SkIM_S8NigquoVuTEBMvXTpk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P98-atHb6kIPrqldQZnsZJQLe8TxN8yEqZN43Rvuqtg&oe=69E24E45"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwpAIAex9GIQ7kNvwEKyTOw&_nc_oc=AdqP0FHZimk1aIbySb2BxdU6H3eiK1G1V0qb2Jrs9baqKZyeovUMATzD4eXze0PQEtA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vTRkrpyj7b-l06fAC-BJmpckCL2O2deNvbdF222imAg&oe=69E24421"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hcMkTb4sYQQ7kNvwE-f85z&_nc_oc=AdpcGMEvriAQR7E0zMeJ2kCFtEjbyEaWlvkA80YGbyU3NcJU4Giicww7a33uL4XBzZg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BquWV8-rZtY52FPnBXDf7EWwYrlJjqi6RmthBSMMupg&oe=69E24690"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUHUGcf8nI4Q7kNvwHWjheI&_nc_oc=Ado1ak58hEGTV3YbnMJvhS-lDVIcoUoKefxncoNMNBodDjx4tETOrzkrdB406gZ0aG4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k5Q9o8mKZJ3pRYsoBqSug3Lx9njH_OMqjXzBCDL6n8Q&oe=69E22673"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M2UR6Zq3DcQ7kNvwHjeDaT&_nc_oc=Adpv3nV4KgsKXvM_bxsjo2-ILLhWodILi6tC1aU9DqNf2AGYI8P_P1aZ9IMRDn88b14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61KZxaPrOH6jUkuAsuQ8CJDDUnXvJ5QPXBDs4goXHF7Q&oe=6A183D2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uza27mmoagQ7kNvwH8qifY&_nc_oc=AdrI8W0E1TN0U-ewbdGwok0hda7Qg0h98L5KOsVqHLxcIk_nnee1GHM_GNAIuoiDkhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43jMVrWnAQOE2PEJmTg3uOLDjgr1ZSNp-nMTiv8ATrBQ&oe=6A185BC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vau0YAAWwA8Q7kNvwGzlRPX&_nc_oc=AdrSodBYLpPVAoK4HXkLQAS0zn4bHcDFhqyCBycdN0Yi87aPnapwdy4SvmRAW06uyuY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YsmbOsB9_7z5ouJdhSkE8XTCjNGhO6U-KQ_CJzWM3MQ&oe=6A1851A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVs17ncYcgAQ7kNvwHkg3Pb&_nc_oc=AdreGDF3o2vddXjrtysIGay62yBztJJeY2863EiDdGocznshR6VL0j38pwYV3SvfvSQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KManjWzV_K_coIDar8fU6hVfUWAL6-a8aa5pm7ky46w&oe=6A185410"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D-eJSYBPyEQ7kNvwEy-qCl&_nc_oc=Adr-D-otUmJhPSnquRJj44oWveZWzzytG2YPd-T1Y5s6BfzEFDpXR2qD_82IBKCJ-4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vohNclVN3t23fvhAu0QIQU_jO__O16-Ck2q6N_Vs3Zw&oe=6A1833F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
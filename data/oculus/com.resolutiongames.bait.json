cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnitvOZ9tYYQ7kNvwHwrcBM&_nc_oc=Adoug_pEEU-vvdos2_MmjtZuyjRIOSuxOnNqdJmw_jMNb1JlRdHW5TGcEcLPhq2wK8o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fP0C9ZdittlquYqPQ5gE9r-G1WjzbFvQtlXkMSyl9eg&oe=6A12F72D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBNPLC1BaJwQ7kNvwH1894o&_nc_oc=AdrZKwMSLbPWUZingA_CH8CwmiuxwK31kd_Kyfxfu08y_LZH1IRyj5ZRaOF5LWIPcXA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G_HSCi1KgRpd6Nayq_NOkBXJPXn9gDbh7nDw7QjpVMw&oe=6A1315C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H0s8ueJmpcQ7kNvwEjzHQB&_nc_oc=AdrIaLdZXjMgfn4xkVXaCwDL6Mn7b8Z3Rvqh3leJjSFDlZUxqn8SFKZ20pJvVgK_jD4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40wz_ZU9pPtTckHNa5pYkkHCMQ0R2a1x1N0y0cdP7FpQ&oe=6A130BA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9-AVh9ZpysQ7kNvwEoAHJ0&_nc_oc=AdpOn1UVAYXMxdLSXUyoZO77RkOE7MoyLHyLL7PxjezzeVObZd4VHCRkfsA0loPXeus&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74D1OVLswsBv9vuprkVkDypwJWeMgVWOlpc9r8CDOrvQ&oe=6A130E10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9whf5-NMRUQ7kNvwH30tqX&_nc_oc=Adqv_buO3nA_QRM6lQhrYj2leJmQF_5IqPIXLi651GcWCWU_GzSTyWsQnyJWc9cnoFw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JIU-PIRMCjGPRynZtPf2HLoj2B93wBBiJxmTpkBb3ZA&oe=6A132633"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
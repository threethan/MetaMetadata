cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MfuCstdB4IQ7kNvwGUBUPH&_nc_oc=AdrKnENJyr0J-sXQCDAXLkCJAoN76LkQYm1_wQRnV2AKQPtSUxOn1yn44KQvaauNcBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25qg3WOS-ZXByyS6DFCi6GbUW149lFaiY_3I54uglixg&oe=69D3AF2D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgQLphfuC2oQ7kNvwE94qnk&_nc_oc=AdrTcZzQI8Q-59bEsK0z-CeCZz1Rsk4xAQAlK00CKMCdfBh6zZ1UW1w0vzdi7IXgcBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hmfaUxdILmuboCVj3JoZhno5Vgc--18yoJ_DNbflYQw&oe=69D39585"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1YzDsP6QoEQ7kNvwFVXx7g&_nc_oc=AdoCJhRqpHInKDbS6pxzcQfpvmTS582YDTqVCnhzAdIxIYxDnEupXXZcEI1roufFJbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tD--XmP4dKGBw3VKO8Jo6zolznmzH_4HK35-W2uNkyw&oe=69D3C3A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5biqwX5Na4Q7kNvwH_x8bl&_nc_oc=AdrYxHhvRMsUqa2YQDSBImZYDqDWFkIe1eztTEzEV-9W0dfORjPswwpicvZTNs7AuzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SObcVxixB_ihR3rEaFC96EtyO7_3t2sXQq4kuB7D3PA&oe=69D3C610"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n45ahYQFv5gQ7kNvwGbZ10l&_nc_oc=AdomqfBMxC75Ul4cSs0vVm0DdHjJ_7IlqFJGnzyCXgw4QcfcNzozMeMV03y8mfC9TVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rzv4I4Tj9veaLSBDnOpNcNnEQzp4CZSurDro_n1ZpuQ&oe=69D3A5F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKbXqc5xL_8Q7kNvwH6u8vO&_nc_oc=AdpNeX7k11n0Yy-oktmgnVZFjg11mIi39a-bWhdhu5S9pwlVHScn0K-Kdp0Wgt_z4V0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KPxxM938XtNplQIqaegMdIABTcynjMRcpqlN980bbUw&oe=6A25A46D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZb25j0VdUMQ7kNvwHCoV16&_nc_oc=AdpwcSmD8wqJ5djQWyO6mPKznXuLR9GuS7SpyKJgtdbRFyQvdT6E1I6g9lDDVxE9El4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BY7G_2t39aHsp1-tbab_450kAx3ZPKGSHFvktXM6DMA&oe=6A258AC5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYrdMw-etXwQ7kNvwF82GdD&_nc_oc=Ado6mwEyKBYA05jR7dHjQ72SA3m2kr-RQ4YamnwvG3MiTcpioPyiJuY2rhoJsPo9X4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4CJjZLGOuykLKKShjfGi8hKsrSJubU5I7HOFXO_XeYQ&oe=6A2580A1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuI6jBUAh0MQ7kNvwEA_P0x&_nc_oc=Adq0Q7-PvKl36CRrfUmx6Whq8qC_LOFgLpa5eh4uSidpycqE_x-HVtgAeHVvxU8KD1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nsTthpIpU_f_aCfMCmfiVG98fQwXXTy3Yik0W0hLRpQ&oe=6A258310"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOrgz6taV4gQ7kNvwFPIlQ9&_nc_oc=AdoNny_RpR6g6JNFL0Z6XnJb9ZYhCoHZdHOpgWfuiUTB1QsErneYjEB7LKkgHN848g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90viEMcrtytUYBwSnxwWL9ioiSmYXvEjTdxLOeBmmRsQ&oe=6A259B33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
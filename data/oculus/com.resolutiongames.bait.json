cdn.com/v/t64.5771-25/12138787_1758481961037969_506909599_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iYKSqO940UQ7kNvwGThdZA&_nc_oc=AdqS9qdp2CfhAd9cQ0ClUC0G5TPjBLshIAULxM19fQst0ggDIqU_prR6Bvnc2CBjkdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VDowZvRalY9SFYDdLwri6vU-4A0Wma_BCNOy6QCpwVQ&oe=6A20262D"}, {"file_name": "migrated_image.png", "id": "234024067991341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_581724998653514_1110136322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmHepyWslbYQ7kNvwGrv9f-&_nc_oc=AdrYoss2WHgzB-MGJr5sbJuuZEeP96ymPClXDbu6iNyeBuzoD-2l5XSusunN9k9E32o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gRkG0bQgySpTKwjJqTNNBRDNR9quVQabxTzNacPN7ow&oe=6A2044C5"}, {"file_name": "migrated_image.png", "id": "228851381823050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_221235488224464_1502163313_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQEvWZmhqWgQ7kNvwFeYrnq&_nc_oc=Adr5qCaDl9oUlosY-eXd6YM3uVNwKqVoqxk_cNb61TcTGi-vEEEHncq-f_bIf3ynmxk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rvlbrvf4rHeRXkAsxKaluVuvY1JzsEvVYvVTFA-sckw&oe=6A203AA1"}, {"file_name": "migrated_image.png", "id": "228563154863813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138833_432446190298708_515750356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWrozXCXqDoQ7kNvwEIIlCN&_nc_oc=Adr3-C36ZX-13dtFHxoDkaFbKSuLEEfvsMgYRSPy14HiPj4bGFd0TB2bzq7LZ1V6528&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FG8P3bXJ0HU_nB2COhXcunSrvUhMqPFrwbu8nGPRndA&oe=6A203D10"}, {"file_name": "migrated_image.png", "id": "203490957550276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138836_1541982866102630_1346682544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lU7F2Xw-8oQ7kNvwHY8A9j&_nc_oc=AdrXlhcQ1jXsqeyhlJj8KKKqkwjUFb9IXKaPErhz5RpMe1dEGBOa3yKAdVkgpdN1K5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75T4_4SbQSzCIfPt_KkUexbt_BMdj7bqljvv3biUd3Bw&oe=6A201CF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "fishing", "free", "game", "games", "lake", "ocean", "top"], "long_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 3 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.res
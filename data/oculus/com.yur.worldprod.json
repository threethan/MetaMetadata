creenshot.png", "id": "685969096461346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8Bf4gndbEEQ7kNvwEe5AwV&_nc_oc=AdnUeI-4xol7a8veNr152YVBvUjsyWb-vZcyqp2YJahOwGAb6oAn2YQyoDxJKsWXWXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPAJdf9N1abg8L1q_iKlrWToba2k-gJq8aHUkMpvStog&oe=69B4204A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46OL9bxN8UEQ7kNvwFIouO7&_nc_oc=Adnh_yylIDOwsCbECvdA-oZBTqB58bb-u-gu2Bjx4zmUtOKdr78DIHVNgUT229rJUys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4ulndG9L5dhKMSZ03t-_Y7XLUTVNzdSUgmzrcx8NuOQ&oe=69B404E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCaNKClByFkQ7kNvwFp9rYh&_nc_oc=AdnhNswMK7uVtaPam_VKmcYnN-Hw0qBd6ezAtL50EFGy8EfqcMKd_pQ699j-mjq4BK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuKlnOGJNwR4X6rPKfpwuKYYt6ub2P20lxzjDbcK1wqg&oe=69B41423"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR commu
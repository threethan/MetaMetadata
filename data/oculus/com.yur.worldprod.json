name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_dw4wVzZhwQ7kNvwFkQegG&_nc_oc=AdlhKeUgHLennonzJvvMSeS3VjqBkhnUYlqgTOSCUoRkAOJUU5aMGEmoQCZ0Grxyhu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuc8ZmTvlId9Mbdb9EBL4is_bewzqgDH0K_wnOQKsrSqQ&oe=699C56E1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDSau7HiqZUQ7kNvwGwslr_&_nc_oc=AdkdQzX-d4O9Zj3FALmuhvmbpShYfdBqBT41rksxI5V4eYpyPMPwap3FagipRUCLyJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuSmaIBWYQhXfMC8TDVktJXYjy4ITPWgzfP9sKmW-atlA&oe=699C654A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_kar45RElIQ7kNvwFa2R3U&_nc_oc=AdlBgRWMzkq9MAMypPEZO6qHcBDjg5oaaqhPKVMM6gxrT9ldOFtbepb-306pZebcTRo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft2GVJ6tzPoabteWvXUcO3cj9zoS1yngzYz7WZ08kzADg&oe=699C49E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAC8Vhvh3V0Q7kNvwH-kppc&_nc_oc=AdkFS_V8bRU2cplaB7-qq_4va42t6PgqAFXUomOiR0_eom3EngTlf2f7aK6_Wx5Z1fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvRFvhXzl4fY3qi-f00v2IGRsF1QeZ6f05GhtKsmYGGOw&oe=699C5923"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
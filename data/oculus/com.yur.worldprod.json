name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afiFFKXgTF8Q7kNvwEYZ5K5&_nc_oc=Adl_hKuHuO6Ef6yTXwAexj8Msc-CNFdSCANmf2sy-EFR0lb3_fVjUv1xol-XFWDu63I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgcL-49NDcgqKnHpPOmszWFBYSkchM8Yfhhv3ITorZ2A&oe=6999B3E1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuIlXbrOLT8Q7kNvwGJm-I4&_nc_oc=AdkmYDhXCwl6LDpZX_mX-p-SqppaJFbAEvvimlB2gkuTER8Z8eaEZWL6adBJdQSiRec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspAahZOL0j18uGlZmwv5X-bn0fi5A9550ugGRXMixc3Q&oe=6999C24A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IONtJx58aMQ7kNvwF0RWAA&_nc_oc=AdnwBy8G5SAIhrebfnvfgxTAu-npdfcyKDRj4RlbuguV8f2dGTx7_zofxhcmkhwXRQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQI3vBSXWPbbSJKgp7PaIjlorxEpXiEdE1mOsgFdmuuQ&oe=6999A6E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAC8Vhvh3V0Q7kNvwGUUYmF&_nc_oc=AdnxAMad9JVL9H4wfuPmqVnMQ27p4u9Ka2_C5JXjI240ih3cQ3_bFs-RViyWQZUl68I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8U9HEMNEJLH57NUII1FpiM7EPBNxlFy1B8OJdUvz0lg&oe=6999B623"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
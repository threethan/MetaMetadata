Woh6LmOo8CMY2utZfdxvLzQu80mv64ofQc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70n77_zu4PkNNGzv6G_4K5MkQLkmoOeIE0eAOZdAc0Fw&oe=6A1C4CAF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQkH_-KKGWMQ7kNvwHgepUe&_nc_oc=AdpkW2eS5jbo-o62AKw_lvqOo5DgJyMhulAGifvWohnfSNh3qh1cOG1Hg0hLmU5Vgw8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tF2TdcBvW11HYVwaanvSnrpI4G7QCaUUz10kKIxRr1g&oe=6A1C3861"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Mgl9IOJiLMQ7kNvwEgygbE&_nc_oc=Adpoy_g4E9TBJEDD1rTxaPofz05pfj5-WYoWKLVP-EmR0vxMGMEm-1JtsTORr3Zk_6g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pCzQE9omEmtjbcuW-2NVnwiZ1RrupoU7jSp4tkfjyXw&oe=6A1C46CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJilE6te9GMQ7kNvwFwjf-x&_nc_oc=AdraDiKCd7bqeoI-_SSMTU-0zJg9-DmfHDf37BVz2B6t5CjaJvnPXWXXs3JltfeQTFs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eRzSTbjB6D9lsKBLlDg5a7hD9UGpyaK8luCqRpgC3Zg&oe=6A1C2B66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NC_3MNTkYQQ7kNvwEsPJZj&_nc_oc=AdqjpRyZltJmclst3neMkj7FPY9mMkTrw2xQXaWnB7mL27EK503OEQlcOU_9-u0-fyQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nO_hV9v2M2nxJzCszxn2d9bzKZNehKIiX8RnlwnROQA&oe=6A1C3AA3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
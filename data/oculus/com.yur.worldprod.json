_D7KAFfZ1cBs5VRyRrtSK6BTyO8cxjEL6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hcn8MWayu7Bf26wqnbosAOrkFP1lZi5fG90SDM6UZ6A&oe=69D4E36F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzg2VYkF_sQQ7kNvwFewgVy&_nc_oc=Adplvw22wPR0BiWkpFLZwxsQo0SEBA6PtrGTZ1RvmB-pDiX9g2rLxgee7cO35-EOsm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZJzPl3x4XnZVdnLlyFP-LlpcL-8giw4A7MEZshndjig&oe=69D50761"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ia7QNCQVxsQ7kNvwHMSWQw&_nc_oc=AdqCig1RlSZ8wpOexryZpSKP5Wf6M14S01NRHYy_uaNNfT8dYeyg3jNZ56e0-4Mmyo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eK4stzppRzWPSg2g3LrQVa52_TH4x63_bG2njW_PVsA&oe=69D515CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtdLYj7Oa88Q7kNvwEgoeJo&_nc_oc=Adqtpu9xXsqHQf2DEZE8EWMylDaw6___l-z3qcXmXZGhd08mfxIN4-YxodSSqCiHwZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ykHOpYGudvenLrs6Lf8_WfTaEMJjTvBubm8ulMn6Kog&oe=69D4FA66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R832XNCCp3MQ7kNvwGJnfhr&_nc_oc=AdoPXEdXfMu6o3Uc1y82Oj1pwlREE83OerRa8d0jUNLNZ2grUU16qeN5o7oDRkpziaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G4VAHdF6E_Hb5eR8Ra0_GWU3P3Nm5waNu64K5fy9h1Q&oe=69D509A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
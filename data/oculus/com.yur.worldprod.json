name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhUU07Pk0zMQ7kNvwFmHhS_&_nc_oc=Adl6b4J-Gew_XRd7dBgztri4Qu7aBsrbLXmru1ZSNPUq6miXgtn1GYmWnNpIyBCLagM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs21P_lOoTxumJZpK0baL_bi4EXNAwr5CcSaEgc5-z0ng&oe=69A19CE1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_TKg_F7t70Q7kNvwGWADd3&_nc_oc=AdkmqZqE1moH7AknFySeL9UZNoNujGC6azeb7NFz-tt-nAC2ILvgprb9IHv67xzL6mw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuL1IyBLd6eknmL_YMouiKz0NtnSp-zuRKA1tTCe5qZHQ&oe=69A1AB4A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDgcOBXbWvEQ7kNvwFMwiMD&_nc_oc=Adk4S5Qp7YqEve9vOLZirVFlHYOv_qLHh9nmDhvXRejI1kQRS_RARwnjju5v5v7YOAw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu9SwqpZt9zTT6P24hxtVJtlc5bi5ei50i3aRl0PnlB-Q&oe=69A18FE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po8yfyfGZ1IQ7kNvwH63w4Z&_nc_oc=Adn6wwydCA1EQY_NS1AkEq6eVsmn9rlyt99MpRje26zXdr8Oolr_AaAau07CQZbl-Fo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvSgw_p1KWfbrpRHv0w4Fi8dwAnFu74BHJUjEefAFco2w&oe=69A19F23"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
NyaXCoRTdH-gbSptK-ol1aj0fvDwb1plkA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHo6s0U1opMKdq_8hP028Qn-snremqSkxUToWhkDck_Q&oe=6AAD51AF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZeXqpI_QcQQ7kNvwGTLnAn&_nc_oc=AdrB46JuL_xZh9MBtkNF-MM5D7QZ5n09HLbqj9JRdU5z_mNd1dIk0SghUdZkjlBYz2s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBHsJWCu2hNtmphRlOQjTangdXkUBvtBgAK_D_HGTywQ&oe=6AAD3D61"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZp_HeWuw4EQ7kNvwH064hM&_nc_oc=AdrRjf50EVmgucyT7SDjhbvSLJV-38Aq2ncdHRBIP5or8WdLi1Q0Bky1jmkQSWxFhvo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjKkKWUvCP5V174MbK0qvW42P68Do0Clm_e3RwDr4tuQ&oe=6AAD4BCA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPmjhfU85QEQ7kNvwFDsgX3&_nc_oc=Adp4-QHKeDIQcjrqJ9AG7Z3qyIBh9q_3by372rmUk6V1O6EHUwS7XJvDvY0Facvu450&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7SOqRn9nwFHBbpFHZpCnIXCGltfmImanGpcbB4Vbm1A&oe=6AAD3066"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyK4S0HS5g4Q7kNvwHDgtBQ&_nc_oc=AdpjG6Cz3TRYGG12c1f_HeNehNQx05xZlIyd0wsOJgSuDd0yUVgF5HfLIGcu3Ndum7c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpcZz3r1whGG7SjFQuztU5Wb6nUzmegOtp-FLCvYuhZA&oe=6AAD3FA3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
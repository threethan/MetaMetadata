Wa_JbFiOsblKQVMtP6onCNQ6RHQyA3rOG7FMG_IN1eN14&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE72eo1xrI5pNuH7cbcdQfHyi9bOoHu0SGOyFEthrN4hw&oe=6A858C6F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6tN7g88QdEQ7kNvwFDuZjQ&_nc_oc=AdpPopl9l34eFylRaH0cjRvqDQM16KzcksakVsfTQwzwL2mD69mldY6LWPH6pWsB_tI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqPuJTrsBX-4142wia2P-wGN3bf-bqHJx9YwV7FteRrA&oe=6A85B061"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvwj4Rms8tAQ7kNvwG90Tu0&_nc_oc=AdrKomG1kPYlRlKE225ML9PghZqfQBfWYayPX_mV0rtrk9RDuTwl3qmqwtBpVXRxj60&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzCTUpXWhpSlxHzD7dg41oHNIpX6LM5zg6Qw_gQFdr5g&oe=6A85868A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvebE6YCzfQQ7kNvwHFDztW&_nc_oc=AdpiS6a6z8IA5GjbMCVUS7o67fndQMPjiLIJPi4EaAvVz4dOq3COsDCOxoMEwgWVqlU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg0y-rKKcaQzG4OzWtj_1-vAKKvwlu6NaDGXmvNu--qA&oe=6A85A366"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdAy8Nw918QQ7kNvwFGLTvD&_nc_oc=Adq-4qs1iBFWi0yhVbAv0Vg4jtbQXFFqbmlhPrjW8onqQAlB_Xy4tZaFvmfcl7AIC6M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHzv--5e1w-zLXdla2jaHlg45Xb0-sarWMSQ40fUTk4w&oe=6A857A63"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
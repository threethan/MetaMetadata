ontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLz3Iwrzha2hTrFdJm4D_RV-l4nMWgVv_vshFpGvb3lw&oe=6A54E8E1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNeuhl8H4R8Q7kNvwEz1u_F&_nc_oc=AdrHh9ctkGyOnxam4cjM0mbDj9GSMp-W_gPBoyaz-dD1GP7mvvhadNLr0ned64RLbAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo80vC-DZDQxJED4I71gVJHt12G3Azvwav5WM8xucHVw&oe=6A54F74A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K_wzo_EH2IQ7kNvwEiCc2Z&_nc_oc=Ado4J2jtS5otjcjVtlRRg9syZBR9hEnScK9OJ5l6scd42lPilvKUZUng459-a9iUXa0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuzQ28Zr4-Av1qw4TsS_iWhRUXq1KYzh2rVY-15J0N7Q&oe=6A54DBE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chd5tXZYt4QQ7kNvwEGF5F6&_nc_oc=AdoMs_2Pzg8gdWBHy2l8laFz4DFrxJH91A84Joge3f7PIWZoYeX6-i6Gj1mEPLNBHas&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_mFYAmsytFfCL1UWfkr4PXczYVVnfXUeacjeujqS5sA&oe=6A54EB23"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3300475730279306"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1214180122531985"}]}, "baseline_offer": {"id": "1214180122531985"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1674756000, "status": "PUBLISHED", "id": "12
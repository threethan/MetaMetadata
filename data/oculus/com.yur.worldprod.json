BPsutpoTJxpeKUJ1HenE6g2JjJSu7cYzR8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DlbEOIyyESusWDEkDb0OBGAbt2TLZi9cDC79yV_-Emg&oe=69F36E2F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5N9u6t4T3DYQ7kNvwGp0-iF&_nc_oc=AdpJ9EBeaspO4oWdrnqBkeOjCofMglVoiW-uWrdwWi1zH-GZkNzDf9jJ4lSv2u99mPU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Grktor_gsXBed1B-RA8rqcM6ZN_U6AZ1_HMPL6xbyTQ&oe=69F359E1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf_S0fi5GqwQ7kNvwFHJ9Pt&_nc_oc=AdoV_FVe_IbHY79OC9No5PcuieiH0lMfwzkTg70_61bNBo6w2xEgDS4wv64xPAOQNa0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0s1f0NXG2KBJik_S-8c0iUw3po4u8DsSrxKTaxQJ2WbQ&oe=69F3684A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56c72MnKtrAQ7kNvwHhIxIT&_nc_oc=Adp1W_wU90cFDI_py4YLbGMv7WlmMqsWx5o2FM34fayDYI6DW1fuwSTirvY00QR8jtk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SQiTxoxlkeENZIR34MAq58FqDeQxLVs9Hh29qpeNnMQ&oe=69F34CE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXJWuJXOlgYQ7kNvwFFMkGH&_nc_oc=Adqa1AP0sveHIBfxg8fITVI6FSkYfdKmeE_lH7JYlmChQAv4amXEYklnqoCC9NMu0zc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eqNJLv5Svci0htDrLu9guJ4QLIg3B9fM9dNyk576l-g&oe=69F35C23"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
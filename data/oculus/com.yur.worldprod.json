ontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pjlEx7XZOJ6FCABJuLng___fXOvzvGVWvuC964_WciQ&oe=6A3A8AE1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7F7drU6_xk4Q7kNvwEPsZZ7&_nc_oc=Ado16XQWjcShqh5cFCPRvSFk85T8OlK0M1Ml3FrmbVnH3ehaNNSGfG8RHmjFTB4kZjg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82eIkPqhDQ2NkvLGw_tvMDTbImiCyj9JmwqDPNUhN94w&oe=6A3A994A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx1B3tXoIXwQ7kNvwFTZRVA&_nc_oc=Adpdhlj5wy66vYhnDo33Pg3U-yRB73Jn6EmDptDBo_d5tzGsFY6nBNRf7rECJotnFn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_peBVOTVeug32iS6WOOLEXrqzfV9AO7Y4vTg5yUHp1-Q&oe=6A3AB626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZlAz7A9ukMQ7kNvwGODOlm&_nc_oc=AdoTEdbplBqoU7foJ-cdJ717DGNaOTck9FziuMPC4ZCFWcoVQzVec4__noF_JG_M6K4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EfqHT_MruYGs1YorA2KCsDJV-JYvYMV7mWnUvgpp9aQ&oe=6A3A8D23"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3300475730279306"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1214180122531985"}]}, "baseline_offer": {"id": "1214180122531985"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1674756000, "status": "PUBLISHED", "id": "12
H78x5gcb0JIfVgNZGgbb3XxSB_wslXqTiY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMzq8x49UtEh7LU6wyWoLeYnqdXt-1xymsh8Uk7GjQeA&oe=6A9169EF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-WOc6oY1yoQ7kNvwH3NcVE&_nc_oc=Ado_La4qRdr2iQSQ040SJFv2pr5cwhUAGO6WBbz5-lyk5U9uvLtM-oAdm9gi-nKgCrE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp5sDgD8RrIcbkE6w9I2gI4TRmbjzzczvalIsoo-_6zg&oe=6A918DE1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVMoCE1Zv0oQ7kNvwFkX_2Z&_nc_oc=Adq8kbr37PNSkkC7b9nGVpjBsZiMr5ZuhYiQz5hgpcnHYwtmO-EDFzuVmleHzCmGLCI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL5yeFU0iRXuCbhFjmFsaVlj8oqnIgN3ljQ6Kw9mnkRg&oe=6A91640A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtlQ-7XYtLEQ7kNvwH7iC8b&_nc_oc=AdoaQ-3yghyiVooIr2Oya9BDQ3Dg2RvWUANbVLteNmybBAgtYipi62-wY4r2h-JtvU0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJOa33cO32CC3Cms8t0HcVZEstpvywoK5oXcmgDukj5g&oe=6A9180E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVq1UjLnNAAQ7kNvwHU3dyH&_nc_oc=Adq4UNwNe0YKI44CKjxRyPSNQyme6wamvKADODocCZse0hGahha0R0blMdxnmpR-asA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXGQ9ZCAIKsu2baQkb30KTiwhV10ibv9iS8OTXRCdXPA&oe=6A919023"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
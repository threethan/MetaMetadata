name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5N9u6t4T3DYQ7kNvwE_abSs&_nc_oc=AdqCImkVpEgG2VPijyPl9ekSoEix4r51Rl6xneeD0TexC2vYQLbdqlRSoODS2i08ol8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3lsrKigtFq1PyjcDVSDtwEKQuJ7VTBOnq84kYo8Xbvkg&oe=69F0B6E1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yDv9wbX4j0Q7kNvwG1zgDO&_nc_oc=AdqdxN05ZLV_F3Bo8p93i6C0-PrxfynOHWxYhN2xmCkfd3ZzZ-0ZoRgX_mFhQwnJls0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1SgSZy-kDwJL72ZJiJlaAJGN6dvTmZjTphb5MQQjeZcw&oe=69F0C54A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ByJcc1B7nYQ7kNvwGTFEBr&_nc_oc=Adr-2CQW3eK_L52hjvAawmhbCFz7S0F2QL5EAv_g80s8AaXtykxnp8xEFT1Hh99lwfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0l62Qrm0N5A-zakGDn4idNfGEQtnmCAGrRTzrwCkjtrA&oe=69F0A9E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXJWuJXOlgYQ7kNvwEZvC9I&_nc_oc=Adod7dEB4w-3QGs3RWJzeidhKkyaWzOOGIMSI66HtSUBlzzKGH0z0--_9VWmfiLtpN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3pcAKirNFJIhRcFy4cuJvjOrdIclGGMVXJ-qvi6JnRQw&oe=69F0B923"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
CCDqJXhlo4jUHn8DD18nJLqcG_HoU0PE2Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0l3WsP1taKdS56o5OH054ByLaOjD0Bs49ChYf8QhJl8w&oe=69F6112F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDX6ARtixB4Q7kNvwF-mZ0H&_nc_oc=AdraO95DNQTtTC50TBDQa8m_zuKXDyz6BfsoLlW_YMdtoJukGgh5JWxxvS9AdoOLLXw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NzHuO_TfLc5xrIq0BTuvOsIITLWEoDw1Y85v6rwHdaw&oe=69F5FCE1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf_S0fi5GqwQ7kNvwHVS-UM&_nc_oc=AdpBFMCy5WFesk7pzXQdT5Khy4UvizobhsXtDAd1IR411CF0W_vJeXfNcqVmBcmblgo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vKq-Uj2J7cCQEgAQWHCju1GVi57Dx-GFdqxs_kDckqw&oe=69F60B4A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWFL9mW21i0Q7kNvwG7k0bZ&_nc_oc=AdoH9fIgDPD9Mvje5zt9I7u4JA6QvNws0wdIX61hG_tilFWZvmkZ0ESsnwu5zXSsqKY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1j4uWkO_h6trdahKFAs0zUn404Y0X_mGgpCdrPuPWm9g&oe=69F5EFE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIvLYrR8A0cQ7kNvwGJrbQR&_nc_oc=AdqUEOHp6NKCzh6phGqELjyCLzw9dQsWfVboekQDtctJtyNlmpjMrUvSvWqQ7cpe3S8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SGR98OuviU0WJ1S2JprRiVRKXCurTfke1ADIkCgQDJg&oe=69F5FF23"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
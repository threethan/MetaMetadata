sh9FiaTuf6KuGgD1i7o5e9ZO9skoSI4pTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80_Ndf-kPQjDXFEvEcVwxzUyLKFs2qhtEppLQmGGzHkQ&oe=6A452B2F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxMSW5Ptae0Q7kNvwGt4qC9&_nc_oc=AdrphsY8ks-Uuk4-9Bb6GFSyp0yqd3nbAZdPTQytKGJzVfHrDKWgQzfnlMR6nm_mMMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yjpl3gBtcUbHnz8W4lNEHXT_eRWO2Wi4GP_QkIJuM1g&oe=6A4516E1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAEzON4I97kQ7kNvwFq-NwU&_nc_oc=AdrJaGCWqxXTp212lsJlN1xheVqKUO4PW5zaAu1oWJ9b6KF1_atQrWVK1FNhA2VDrqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gDNCuN-0rs98HFABhgMriXXU3onVmOSPaho826rk2-g&oe=6A45254A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsfHLZvr-S4Q7kNvwHKFFeW&_nc_oc=Adp85BgHYtG5NKYfJ95jfbQJp5xj4s7paaay3Xmt8XpIXTEHb5s_pLo9jf66Aq-v0M8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KhwXc6TLpz0WKUi6vXwVfaTm-OJxN3nDWMSEsn9T-xQ&oe=6A4509E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH6kouSxjLAQ7kNvwGyLTqW&_nc_oc=AdpJckS9gbu2AP7RnZujNSDhJs4HZtXWmp7S5ImTK3N6mXFUy4HhgjFJFmeLv1U5Edg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v92eHy7oUlfKhLoOqkRxf8E0PX3AYAiJ4858vDwN2nA&oe=6A451923"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
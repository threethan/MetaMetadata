MhJxjPKkXu41ehrbR6zQtZlcmR3ck3-wK8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14GMt4NNYsJnnCIltH-nM7hvM4gBzGYt1BG9L9pSy17g&oe=69E24AAF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXd_c6ET1RkQ7kNvwHzMLUU&_nc_oc=AdrKqXp3PI4KdkLzPVEGyO8WKRaPsfRHtnPM77Rqv_wFrVJGfM6aVtK24VpKkeUYpto&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FqK1Ki87rSZnhryVhjOTnXsDjhp5-7A9FsZ3j02jJgw&oe=69E23661"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FP_cFMd23oQ7kNvwFlumXm&_nc_oc=AdoEYDY0j51wY1XihSJizbXcP-gAnTQzXQE7nZLwLNyp6YYucz_hUN5X9OZTP0k8otU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JpY-KUzH9QOfdAxpufxu-nWv3T3oOxQYDt0JJqRDokw&oe=69E244CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mADpSoNSeHkQ7kNvwEhj2fR&_nc_oc=AdpWMIJku2Ng0Q_1DuddI-J35CDClzDVtP7tvdKwiZX_AQrpU9nfiZIDZ4Lmebrp6So&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ghDaztDTPaDzVDT5fkm3AOAfSRycEJdiYXRyLMC7SgA&oe=69E22966"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2NC_eynXEcQ7kNvwF3R0x4&_nc_oc=AdogLi5u5KlMmh9Vo-rDn6FGYahHEqt76DOVRJXax-5ipDTyFOrg1iZ0u_xlssNXOtA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09mauicOlF_zpMlV5ZrL5-jTSduQQzotgEttemVLtqdQ&oe=69E238A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
oc1ugTIRggV2NiDbDiHK2pO0-5n8LS_wJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsu_WLb_GufGlbxndTC-Mp2AawTO2YRZJEoEJs0iiOkQ&oe=6A53ABAF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnmoNmkaKgsQ7kNvwF8Cqbw&_nc_oc=AdqQ29AOBVDyUbDMQ00yhLI16mdp5xnm_xDfO9RErv8n2o3POHF7WmD1tXIgLJRk5hQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD44-zOPNdu6ZoMhDStfrUb3PeV0Df90aumK2cZe7ykUA&oe=6A539761"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNeuhl8H4R8Q7kNvwEDWA41&_nc_oc=Adoh5doTaSBbLDbuBROTIRwONL7a5iZlRjVMNv5rQRHEXq_yhhCxdSelEoVUKEbRRuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBgtAo5AgWBNULq273H-2mOvmHV01BHeoBatyR_X7Lhw&oe=6A53A5CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbFpmMjTktAQ7kNvwGlKoHp&_nc_oc=AdrH6vfOVrKb5RhuM1uBNlL9-xyKxQDdgECCk5Ud3q0c0VexjnZkzpmhHOwe4w_Y4eo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALXHSw31V6fMr98sl5Y7bj24tC55OownPSUdHvSSzUSQ&oe=6A538A66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chd5tXZYt4QQ7kNvwFlugJH&_nc_oc=AdoYXKBw6c0LNLWTKb-kVp_i_kDhh3aRE8w4b6byhV0dIcTudoXz_9b-F1LQs6IJdpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsmVVc56w-o_4cnRnBxKiXvGtm7dGX7-JiHHKHNsCB4Q&oe=6A5399A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
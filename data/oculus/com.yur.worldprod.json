sy1QzWOLuhzsknCgYDVCzURCfSTX9QrsOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNbj8AiPk-eVtEzzltfA1tlqBawrzF38e1tjxUXqv12g&oe=6ACF98AF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDkAvcInInoQ7kNvwH7H15l&_nc_oc=Adoy9G4xwlQO8azmugpoU2z3AJ7qlm081gtZ1ugItXfVbnl003T0UIBrOuxyO8E47jU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxsWN9q_0fFYiYRsw9SB-9SrsRDtIA3Z9VD8ekb5Fz6w&oe=6ACF8461"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8oNMnCu5w0Q7kNvwH3a6dK&_nc_oc=AdrRrT3j70FKqmo_gb8aaZ-5Twk9YEdCN90VdoVTmv3uvH-59A-brGSKqE7nwyvGQBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy5tEzmqjhv8hiQ07vp_HkNIWjT72hR56jTJ5t_T1QjA&oe=6ACF92CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz4s1LN5Rr4Q7kNvwHnlBgl&_nc_oc=AdpPkwppR_AUhJZwimoE9ixvtYwsIA7if2ttIhsPsbN5Sc_Xfa8y4hzB8yNfPQ10hp4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlRdaGWszLHhVoaQdJrRVvjVAT_1vHrHfJfsmQvxr-Bw&oe=6ACFAFA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zi8BVzYb5yUQ7kNvwHo3UUh&_nc_oc=AdrINTe0OA8tHIzBc_tt5vhgyZ3JvWtOhyfXpX_t-6sEhwrjEIvaWT6sw2lQmSTshu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvBtwcGqE_SmTgulolPpEZArYuTmwQNoOtEkcAxnbJ2w&oe=6ACF86A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
HCB4GGpBdgWuPPF9v38fAMUGdEXScXE3-g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FIjZc7M0g-d_fd-rfR6ugfU1ZXOhVqVXQddsXIXZawA&oe=6A32B62F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB1JopZM5tAQ7kNvwH8SUCb&_nc_oc=AdrGu7k2Lc5GYtTNIsxmC7Td85kD_uEbyhcnWznJdLfDOaD5bdEidc_pHVdudpjeihA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KBQf73H_L6jF9bypCs5I56kNfk-uwWsZt8VwVFkCfwg&oe=6A32A1E1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbx_DKrHPGsQ7kNvwH9-iZl&_nc_oc=Adru2Opgr7LfdckYG7bo691vgGQUqmJ2V3U3sfrtsODPOfwVjUKAL4BNsz1bEd2qI6o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HmI3R8FQ_emdsoSzkRPuLDmlRwBW1v290bA3W5v2K5Q&oe=6A32B04A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwJbgGm587AQ7kNvwEdFz3Y&_nc_oc=AdpR2Eyv-7Wx7AZYOj_hmMeOB_CnJ-wGy9DkPGpuWtQNMeOCh4l9RLjiROhb58uivs4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-noYsXJYOfMdcYFd3J_oiycpX8C8tQdIqbOTJUgnZQvg&oe=6A3294E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvIjmEg0YSkQ7kNvwGRsY2y&_nc_oc=Adpt-asb-Nul3zY4V8qBy87qAhL0d402KiaHQYTCQWm5mfO1rDXPGAPRq0xboomvgvI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82twJGmZLJiDmm6grA63_imz_GUyPnCkpGcj1FYPEn7Q&oe=6A32A423"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
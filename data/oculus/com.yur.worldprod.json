HSx6YzquFeC0nP2lnEMcGc0FUewLIm1XSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMZXD4WB5z3-63vfaSVVFMHG5KSfR1lyar9KvFAF2mWg&oe=6A90186F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-WOc6oY1yoQ7kNvwHEkV5O&_nc_oc=AdoDsAFWOXel7NzrHN0T44zMq58hdFV66dE2AFMviIlUuifyW6hEolNxkpsFevD2xP4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6u-p6Gr7DL1gZb9SpBgGsh4UO_7LH-JNVljFr1_UXDA&oe=6A903C61"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEhyIxqF1_gQ7kNvwEgwsXQ&_nc_oc=AdrVbJGq9k3CpsDjReFN2GRC2GnkN82T4FxK6hP32dTZeQ-dGbPWq0NPKoVPblhznss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERaT2VqgDiRII2JEvnf1BSo7gUjXjoU2EA3c0_i8DniA&oe=6A90128A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtlQ-7XYtLEQ7kNvwEwOdS7&_nc_oc=AdrY5GrHd_EkeAnvqKKaNPTm8fQKCI6yX--ZjuH6g4NyN8LP0kVtfQStrkTTgZCwVXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7tij2a480w8zu5Lrsp0aZ4uT8wCBd1DQezwQqIMEqdg&oe=6A902F66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVq1UjLnNAAQ7kNvwHhdYfD&_nc_oc=Adp_iNlrGVLY-4gICCNucLZgWyDKuyfBqazIA_7qDOcYfJ-vzuIqE88l57f2x9ztUs8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDyNz1VYhfVy6J5wRApQnVU_xvxcEwHvdvz_5M6ZY4BQ&oe=6A903EA3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
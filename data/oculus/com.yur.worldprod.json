om&_nc_ss=7f20f&oh=00_Af0YIouXPnE86-_X8ZzMZLrEr6yoBK1cuz6eks3AEBRitA&oe=69F1E46F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5N9u6t4T3DYQ7kNvwGWsgU3&_nc_oc=AdoQm-Ybp1TTRg-7gf_ZzEvjlC2_CsXCkVrwaYnjU3_hCw3WAUq_n4sdIJIJ6ePpxtA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af32Us23pmWxCewI88AdiImVwnveWdqk9MhpHvSsbr8zOw&oe=69F20861"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yDv9wbX4j0Q7kNvwH289Tv&_nc_oc=AdoYs7u_z08sPzmjoIX3pcz4FjA1Iqt02sEajVK2ZNgqgVkEdggh6SUt7Q3nCkLD1QQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2so1qB-zbkyrNjZQUcT77qHSJPEjSlYzZuerdAe4DUfg&oe=69F216CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56c72MnKtrAQ7kNvwFRi94E&_nc_oc=AdoovcRIYFPbcEMC8ZEkl6Rum4RF_nD3BQ7eYqjH2esDNYnv1XVV8zNuCmHOsM9Z3f0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0t_-XEYgRmVVoYKWyWkxSdbU8dnLg6-uoLnj3b_w-3lQ&oe=69F1FB66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXJWuJXOlgYQ7kNvwHp76Rl&_nc_oc=Adqhs_MQQ7Wpyz9u4eD_7pBY96eaKAjVeJMgpOl-5rtbAREAhvMpI2ccTdvUNrvVY48&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EB0GiuM7IgY-NOVBZAY8qKY3e0ZmgwGASCgA_Nwnh2Q&oe=69F20AA3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": 
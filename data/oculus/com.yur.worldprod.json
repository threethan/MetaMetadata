name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKPg1akJOqwQ7kNvwEDx4hx&_nc_oc=AdntxEKI6xndBZBBJiEvFsyLkfkh1GNVVJkjGTA9r3Xgo1lWuFegec9j_sroVWh4yCI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfstObw25N6U9CM3-uFraHCWzx4fWAOUZ8eJJvKMJvt4_g&oe=69A59161"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ekls1847MQ7kNvwGz3knM&_nc_oc=AdlXLTNa-uVbINjkRRyc6l52OHcF1tuCtrnyqpsxHmQBUQBZ2_mMUj35yCZpi4AARUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfscWajUk_zQDWEGdSj6w7NDMxMddjAIZ6X7211yI_T9lg&oe=69A59FCA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKdZMrEGqSoQ7kNvwEcXx8k&_nc_oc=AdlUzmCeeonGit4nrtw2gMMrHTlmEzZRQR-x_4Mxg_eLnCdrOraldT0xL51_yO60qCk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs3Tl_Wq9fgAT9iZQAAH-QXVtXURq8Y_GdGGT1UpewclA&oe=69A58466"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LTOW3jHAJ4Q7kNvwF5EFY7&_nc_oc=AdncyoI_oJLRtL6oTzHvkHwcCoCaTpnUe2X2RXrZMv-S3sy4cAKzw_kTElgJ-N2MIG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afuh6cZ2P_yKptrJrfwsqYFpfYWk4P_gkrMTQuSr9j2SKw&oe=69A593A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
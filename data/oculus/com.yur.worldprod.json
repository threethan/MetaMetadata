VGKGLbNL8wZzq8qwpAU-yV-YsWOSNsyqfs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIiUplEN3yY4MPhltpM_GITEPjkxMQbTVVCsYKlF8V7g&oe=6A5A432F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR0CL7K-j_4Q7kNvwFKWpak&_nc_oc=Adq7t1EKjJ8aWnV9jBHVeHquM01dAqS7T1GMUvjiEEjB-ZprexQ6jGobiELCw2Go4Ig&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbzLBW9vwp4emV9TQ1AOvj0zJTfjjVJfp1XuNGLhxc3A&oe=6A5A2EE1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3akuUabV-L0Q7kNvwGeE3EU&_nc_oc=Ado6GtbZ-bAeJj78q1m3gWsKUtGgtspxN7qAwjLcMb_7yYrQfSe8c-PRnKuEh-mqlnY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDAAUsNrk-wrZEuWhSH7RZq3NS8PDjTiDAUvjSt7YIew&oe=6A5A3D4A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFGhK4G8zH0Q7kNvwHaXiPq&_nc_oc=AdqTo-oGbKFPetc13qbTHNxVw-OsF3sa1SzI67alq_8m45AAkbFuxWFX_wIYqt6W7Vo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkwA3qahVdGtLIn_NybKrwwkHJxMfrsg5l-pHT3WH5ow&oe=6A5A21E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syMljNOBenoQ7kNvwGI_jJQ&_nc_oc=AdrJA3TUg4lnZdLA1-nUq7h0rFnHuMXbDfyJ8YJFEE9RDpoOTLXUM36o5QaMpb4Ya80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHPhbmBso_pGPxf2XGpNRz7qWaRYffMC9N8xhucOYDiQ&oe=6A5A3123"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
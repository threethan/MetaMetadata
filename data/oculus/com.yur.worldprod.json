wA0Uj3JXUiAqF2LQXyEOb9sC0XMdDbVzcb4Hfri8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iILSvWGdwUDITnj4b5NC6s7wxHj3oGLVUh70DpXa1jQ&oe=6A36AAAF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dyKGwUT8S0Q7kNvwEvqczA&_nc_oc=AdrSywGwvkG-icRodgoApUvFBc5O_caI8WwpEjDPhRdZ_juoG_Syf_V2MtDxY2J5MEI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af871gWWY6dW5kdx9rsUXr7njdfuNaYDUrWL9uV-Hbq3pg&oe=6A369661"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnRWEhKwwDsQ7kNvwG-4tzv&_nc_oc=AdpJqZ9NYJf7ajjCD0v-Kp7N79u5SGJw1w7fqspRdV0IHO9XQH0IlhE2IwoK7QRkiV8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eMhsZ-wrwvV0Atfte5x9OPO4DQZhJ-yWVvZIFz2_Jog&oe=6A36A4CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5x3Na5uu_v4Q7kNvwH40CWR&_nc_oc=AdoVEt3NeYVaPIZoArt0tN_5ClkdZdf2CUu-U2T8Lb_oNZwCTuV5pEPIowjiVnz33UI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zLX_jcqYAKpqNxaPt5ZRpe8kfhwm3kgbNCMikIN53hQ&oe=6A36C1A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGt6YBgZUdMQ7kNvwEv-5Tt&_nc_oc=AdrLiZ4WVDutctkr5gDZoJ3qtU74zNoM4gazePImzLO3opdwru01ny7-iRjFWnOcUWc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zWOyNLebP2bdP9ys6rMA3YPBPndglbyd6F44avxTi9Q&oe=6A3698A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
RjhwYmvgiW6K5fq1LETJYQlLci3FmzHQwU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n-FJ5OYRmnRzPFXsWyTt19GMpGlN9KM7I6a2XOcl2QA&oe=6A1706AF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsZjmtWv5rYQ7kNvwEQAS6r&_nc_oc=AdrKDyp7vf2DSID8xofr4AnjwBlIW2JRi500pECPrMdeLl6IP9XUJS5ffBbjhEtb-7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mMsgjElezohdLAMlgRR2EMJmnwi_nNdCBNx24uuKjaw&oe=6A16F261"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5na8tklc-7QQ7kNvwEMMDsx&_nc_oc=Adqg2FiGpBDFhMuCpr7_g15wCLJOQZGaK6O4aUAsOp6STRLCsTFcbcD70X0OpyZSHJU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y6w0ZrsR4U1NP2v3UOCQq3ALvYALGRI5x6HmaKL2qlQ&oe=6A1700CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nfWgLZv_8QQ7kNvwG7u4zd&_nc_oc=Adq_JlNJf2zsD6SIZlFI-YFiFCF1RJwKa_PBdoCbRiikY3RgjeYIo7vvswHVZhVetx4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k-xzLAf5ZRrJs_wnzWe6dSsMoO9O0mkg5qRl48v_zew&oe=6A16E566"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_aO7Sm0LGAQ7kNvwFZ9lAw&_nc_oc=AdogvGB-MJeNt39HAh30Fc_pkJzN5WFzuew9MhtGo45ykMR6Eajt2DzwbO3K8tLqwcg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IG34Erf1qF3UXU_9ZoBegqQ21XEK_1iLFKDPpaQ_pXg&oe=6A16F4A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
jDpMKENOnEUbS8hgayaoSGZrzNJ5K1h3i0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5oTifPuXRWjFbswrPdtL1cOfB0ljgOLtMA3i-QftMmw&oe=6A491FAF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfHEEo1hcLkQ7kNvwELVKQZ&_nc_oc=AdrrpUfQaSewFmSIGla-IVW6rao7b-M1EGDUP_ZMdMgWCr41ivQpvwbI4pYmnsZcWco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7az5by7n-C6wgIq8y4ybtjPN_Cyw6U2-oPPeSFFMICA&oe=6A490B61"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_-nqKqpGiMQ7kNvwF3eyVw&_nc_oc=AdoHGGqnGs30lsv7Kfpr4HgFX3e_lRr5k7zQ-N_9Aq47XBseH8QUQEuRHjDEtHRPA8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Uib1Nd8nm5h5uvam9yEoEN_gzZQPo5orB4s6RRf9ww&oe=6A4919CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvKFWa46AlUQ7kNvwEe5Ntc&_nc_oc=AdqqqOjRbRYF5qwtiAH7IhSnNU4zcPp3Bz3GLzKEI0SizK_JuFkFPYFkyjKzVqgh3OU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRAYIQxJvvKk1CJj1zRyG59YOmzA-5K_tT4PkJkyG2xw&oe=6A48FE66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKDMKfE_-PEQ7kNvwHs0BHy&_nc_oc=AdpbHaI6vvd898k_0JgKvNEf6W9u0eFSaKXjOZw3_ZxNMz7CA9t1EFjH1usMNE-_FMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByNwfNgeley-SpJ4-l41Fs2vdT---te6c-6Gxq_6lwPg&oe=6A490DA3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
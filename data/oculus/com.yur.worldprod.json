name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKPg1akJOqwQ7kNvwFbUJvR&_nc_oc=Adn_m_svgBfvJaRdQ3nr8QgeaazMUMtGFXNjUP7A5jCNDKhbECcWxiCIcmkpmYfCDJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs73XdoekZEGYKGwmvYhsMoOoj9Xf1uIJY8q8wuhz4FIg&oe=69A43FE1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ekls1847MQ7kNvwEoHCwu&_nc_oc=AdlC39KbTUcDtsrsdO9W3skRPJh1_cqKcNSY1ZTxNZeu_K0ZBlZsRT88vYWF3ifwYsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv9oPXA85mLdIYU6659LxcIYC0g9KIJ5jnDzegZ3HHEEg&oe=69A44E4A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKdZMrEGqSoQ7kNvwE-uEfk&_nc_oc=AdllVJcUO4rUXq3DDtjvmxjP3L-mxAQtE6jKxbeLCB2yZyGw-0A9nZbxPDkaoIUudys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvsQJhnxfLVR2IoFGBN8mvuYQHjq9edSb-I8C74aL9VEg&oe=69A432E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po8yfyfGZ1IQ7kNvwGLlUTZ&_nc_oc=AdkJ7Y218quTLugAGTIwGuBT1iudxRICFdr_Xl1FoZv-pNwIORH0DQigH02tG9pwMmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsIHKP_046sBW_1IxyDEkPQc_YlYHXdieBXFXUyxITtlw&oe=69A44223"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
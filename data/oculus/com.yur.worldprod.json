ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_-bz3XDmPxES30dI8VjzkVobcJ2_d06MR7lXv-ngjFg&oe=69A8106F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKH_gcrB6bMQ7kNvwEgIrZz&_nc_oc=AdmIAQWmHu5rfPD7mI6CF0dbcl18Aub8YQMxJhf08dQMDH3f46kiIT64P6_og630if8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuV_o9ye9OtTfndpNn0C0mkwy7PLXqzA0WCa81gEw5RCA&oe=69A83461"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hjjtrkUWZ4Q7kNvwF6y4wm&_nc_oc=AdlKhYnNDq0oAb3apVz2u7sbZ0zEMwwbv70pzLUSJ4r6V0Z-pywk0xnM_VizEdfFjRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0X3xWnSsRc-1ybG6WX0ptxhPDPYVu-3Oj1KH-xMkbrA&oe=69A80A8A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8vJaAuJ6r4Q7kNvwHXO2rW&_nc_oc=AdneW7PoY8zZCBXpTK-4tXo3jV1NzwrByrJs7nxo_GKx4ROFtZXi52Eq4gf8Nu5Brg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftebxa0HEkzEfuu_cE1j4bF2NmpYYoAJLCu44jvs9NSIg&oe=69A82766"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LTOW3jHAJ4Q7kNvwHkmf7i&_nc_oc=AdkMGkAPedjWjUY9Z5l8iho_cBK0XcdGzeObQz53Wyno9fyYMb979x2H3Y58OwMjgus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwrSXydd8T-yyZfkWy4wrONEiU4ANwofgHmcOleuT3pQ&oe=69A836A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS
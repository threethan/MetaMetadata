IkDxKVtpZdfpSYhnZ_H6ESz9KXHxSPuXJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpA5dFlQlwKVpVLqXL6bYlwbvuXd0oLmCMpFXdi8DnSA&oe=6A5108AF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk2jjud67B8Q7kNvwHQqaWf&_nc_oc=Adpd4x3bKjFkVxKQq0T5jxjkaAmkv3kinOa54FrgE4hXGO34kMPyL705Pa6H4kz8OZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI1mXJXzUMObcWOgSTCiMWWPy8bd1sC1j3U2SLMLKLug&oe=6A50F461"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WESzki741aoQ7kNvwELb4JO&_nc_oc=AdpKnrE0UHR9XPQsaiJjp6UWB2Hp5LpEPJ5pwXoPalMBjfijOyQ7XwqiPnJOQdqCLFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqvraxwK1gLLk8ZwcbWVJqG5VvZXAu0-BLA0k1AY5apA&oe=6A5102CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbFpmMjTktAQ7kNvwG0VZwL&_nc_oc=AdrO4ssJ6h5tAPMV0cmec_PIIIZo63kCAw4JZlu1-2CLKOPcS9PJyS1HwIFMWziXF_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1dksmMkXvKbw1cz52sXuAn3iQROk2p1TefcvU_sJPpQ&oe=6A50E766"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEOP9QSkW9MQ7kNvwFKTksQ&_nc_oc=Adr0fxLmCFtXz3KbMbdlDsWD8C-WB5dwuHgT14khTh2q-xjd5sA9YmUDLa4i3DGR2OM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv0Q2w97ZChBFPjkJzYUi0TqLH66G4G1pWFsdfliEWBQ&oe=6A50F6A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
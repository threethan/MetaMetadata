ukWMfWaQXunj34LopZOx3eQGp4R0cj6X28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tCD185TB6yRrVJvxeSGNBxPe_2EhvWS63B9ERBuMa0g&oe=69F8B42F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrSQOcENLcUQ7kNvwFIofGh&_nc_oc=AdpkfkP4_A4sHKLwYtNipAwRrItvgwW4xBK3rlF3SyPWTPGxTOqPz-xo4un-Ki5M5bE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kfQ5bRfY3sqAr6t6xdUlGhU5p0FTpbr9Fi4_N-UC1Fg&oe=69F89FE1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFVqVR0CLp0Q7kNvwElv9Ym&_nc_oc=Adpqkyc0jRZV4Hx0sGcbBRsr4XERgDswx9D2KhSWbIqeUObXWjNtX3rQMeBr0w6mHw0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3e3mGAcSYK2OcC70c507p6lKHDlGorAyMsklebwp4smA&oe=69F8AE4A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWFL9mW21i0Q7kNvwFvyTwi&_nc_oc=Adp0UBm0BVCwsQ04c__wIumfXHLPQXHOKVVf9vnODBpNQkjV_0-vvjx7T52kSYD4Zuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18qNMisoL3s4dwWpxtFOy9Uuaw4Z8ZuI1BGQfFcv5npw&oe=69F892E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNt22BDO3GAQ7kNvwH8YN61&_nc_oc=AdrGRXpLUVYg_Gt6CQYpUxtvTGCst0sMKwcMrcM9_bPVecbnX7zZ87fKOejzWPqVQPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2F3Hi8PNJN2zdNWM_5JHgMn2KMiZaHO-aD9saghqHUMA&oe=69F8A223"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
9RG_e5U9Y_hv4QXcBr5RyQhvO2c9w27Gn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjb1k6U6ucaH-dXk61bihPj2clLqsWcjL9550DgCsqOw&oe=6A9839AF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBZv_VeoJDoQ7kNvwE_vfb1&_nc_oc=AdqLyu5eeVhNdGy3S5Wv036gaBOpGOFQDhsb0FLFe2ZQlw-6rps5Y7QitnlmWKPN3uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7_hb4pxJYzLbAADzf6g-iNDbPs-oqvaVjLOmFkcL6cg&oe=6A985DA1"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h30JvAvD5WoQ7kNvwFGrMPV&_nc_oc=AdpnCM8Zz_vl-doHwNG_Fp9OuBIALffgqc3NlqdVFmWdCw6nFHoVu2KmZuzn5rkQrCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ4JH5UsD2Mx8lLuxgGQoIZeeKlY82JVAuOr7JaShvMw&oe=6A986C0A"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THs8xrw9AaoQ7kNvwHR-H86&_nc_oc=Adqgo7V3Hh_o8U2D91eXf7pDVg5mUpFW2zsqw_TOt0OoxcbUFZhEBNvDJKmW1tZ2ZGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFnc37X6WCNNvDkA8yYUb2k0fJErVDBBBaFE1g1TnG4Q&oe=6A9850A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-btbLU9aNE8Q7kNvwF9oM-e&_nc_oc=Adq9956GGx62oTsrEK76Q2A7vLIIZbGEdRzkkh4oA609q9hFfHtmDNjLJvjToegT_XA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjYrEgqEvFbkr2paVZb-tmvEpSHoRrposhHHLA4ME_gA&oe=6A985FE3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
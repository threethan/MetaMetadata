0fEC8iZp6gSjB11EjlW0o0ncgnjq_45Y5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B268k72FEn4tNqD7Yz-9D1TznZnfTDU7UL0h58aD6tw&oe=69FF4BAF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhRqK8otjbUQ7kNvwE-BJll&_nc_oc=Adpjap82fn_PjE9y1jCF4F_j66Y_Jxtm58yB0UbLAH6xSvPEkKU_opNMzk0BmuAyDRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ubKAxuC-uQEMsHA2VVOVBhwii15QOmq07B4mkQuNi9A&oe=69FF3761"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLIt037YJb4Q7kNvwGGhp1v&_nc_oc=AdpJuc9ymRqyuAVXOqCbkU6jcxupYdk2SXvQ08yotcChAeO7RbyNi8kGEN7RVj2xtiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KLnoU49425EscigwSsMjpHYs0ZwCPunLC4z3nROGlUw&oe=69FF45CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvPrZCVwF-4Q7kNvwGF_Yd4&_nc_oc=AdrSKt9iNuuluUk7hHL7hfWqsSP_EFZ3c-mCPb0utdADKmvEZqb7X4aPifX-DeYueNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RDq6fAKlM0PJhwXv3iMunigOHvTx3x0dgOW1Jig4M-w&oe=69FF2A66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_neP3FTFLoQ7kNvwERIEp9&_nc_oc=AdpHX3fp2LO5M1ap6VaEXMLHm3MKgiuUTFwzxGj5JdQ8ty1FY6n6HISeDTs6kBRT1No&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ceGICgOys-RLpzDawEvLmmCFy0Y9OjG5NU-kP-hoaeA&oe=69FF39A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
W-Zk_b6fk2OkUDF3VU1w8uHZTpucAvWByE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0patzfelTN4KG1PYQVVT7PjPVFSkrNOFyuLhBLl9eX7Q&oe=69D278AF"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzg2VYkF_sQQ7kNvwEbGuSs&_nc_oc=Adq62HiiFhYfKCCMR1G5NWTfPyV6amOWvGBuPS6cO7UNW8OO4jMtNkXnHwTo2g8eWiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YnE-zfUmbM6KFMJLxrDZfTxrJ7XB_qWEs0_Jftf33yg&oe=69D26461"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGiTsUtAx8sQ7kNvwGJuyUd&_nc_oc=AdqzxMrwTZ7ITOphTmGGrXdHWCgvZmYjcEKpDmxVT8m3YOKYsfUKv3gARLxkE5xV6j4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xYyDwlD9xBUtMlGfj2vloNsm6-AIAWqrEEmiKXrGZLA&oe=69D272CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtdLYj7Oa88Q7kNvwF2PVzQ&_nc_oc=AdpBHxjSfMwD_Qhw2Qq5GcZYAaR8VsOvYGUFjSV3KcBP7rA3Oq8n_HqRU9dd5Ckc8HY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b243NOfKb1qlDs5tphbGwRmOes34Wi4D4wnSKLzLwxQ&oe=69D25766"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBwX6viBGVcQ7kNvwHgwpG7&_nc_oc=AdoWsDxhfT2GnxQzct3Vt4H2p1VM9jprtwzgxJXo3d2nqKIoIuM7H2GthijP-aqK4fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SyVAMIWeXwBVbc6DsIrtgTsK4YDn0Fgzwmz91oRBpKQ&oe=69D266A3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTCBwC-08Lu0o691VWkX-y_zs1XrIdtXIoVnuKIVts6g&oe=69BA856F"}, {"file_name": "ri-screenshot.png", "id": "5731551040231240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031642_5731551046897906_6380836623900757597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0tnD1jBsswQ7kNvwFcz6kt&_nc_oc=AdmzvM55Kp3J_ge7mls4u79XfXB9E_xzuwqtEeZ9dzoVTE3beEc9OAAjuAOkmwMY0GA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy2-1pDEGGVzUx1YMHuGUq8YKUQay_7l5vhdrpioiwpsg&oe=69BAA961"}, {"file_name": "me-screenshot.png", "id": "685969096461346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_685969099794679_1268590225315203750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytf-USue3yoQ7kNvwHgKmiI&_nc_oc=AdmXSEFbL_D8FqFGnlI68toGFyetjEpMTkKKZw7H8DC_d9y1c-P5h0NNVq3g1pdpK7M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwta7bTE0Ry0HOVVZDucDbFF9DUVZ2qRmLjeUDs_WEx0Q&oe=69BAB7CA"}, {"file_name": "ne-screenshot.png", "id": "835952674297749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031565_835952677631082_1091110132884763473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hjD1SLfesIQ7kNvwHV5nqI&_nc_oc=AdnZtEe9-QsbubCzihNb7RcYwlr5D_8aSoWzg5f3zCI4W5E2vkHfRXfZ85M8EqGbrv4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2OrZnBZFEYhXS8jSNw8qcR2yUf5Lvq6qnj5Dfy58HWA&oe=69BA9C66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Oculus-Launch-Page.png", "id": "3363025077319235", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974491_3363025080652568_2428765954005482018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g44xoOliQE4Q7kNvwFKCwcd&_nc_oc=AdmzD-OUIN9ToiUC5rnV0TtUjhPixp7W20R1M2xjOux9Cy_7AgeI0gWbUPFsR5zh-fM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-oFp0yJfAri9p5PT7R1Y3YY6d6ZVz-w7LxihxZpZWuw&oe=69BAABA3"}, "display_name": "YUR World", "keywords": [], "long_description": "YUR World makes fitness a game. Ignite your imagination and heart rate. Explore new worlds, compete, and map your progress. With YUR's wellness community by your side, you'll never go it alone. Enjoy the journey, not just the destination. \n\nTrack your progress in-game with YUR's virtual watch. A quick glance at your wrist tells you your squat count and calorie burn in real time. Connect to YUR's mobile app to view all of your VR and real life workouts in one place. Get even more detailed wellness insights from YUR's dashboard. Compete against your friends and the YUR community in head-to-head fitness battles and monthly fitness challenges. There\u2019s nothing wrong with a little competition to fuel the fire. \n\nThink you have good reflexes? Work up a sweat and keep your mind sharp with Reaction. Only hit the targets that light up in front of you. In Swap, cool down and concentrate on connecting objects in a row. Barriers will fly towards you to keep you on your toes. In Oddity, wield weapons to destroy the walls around you.\n\nJoin our community at yur.chat! Check out https://yur.wiki/ for quick support or email support@yur.energy", "short_description": "Make Fitness A Game\u2122"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yur.energy/privacy-policy", "developer_terms_of_service_url": "https://www.yur.energy/terms", "publisher_name": "YUR", "support_website_url": "https://yur.chat/", "website_url": "https://yur.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS
9"}, {"file_name": "Screenshot_2.png", "id": "25776283515377528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_25776283528710860_4147799499404818735_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9AWNpvIOhsQ7kNvwHV7V3s&_nc_oc=Ado4TNB8l467xL3wpR7kjcZxXQYsdMXH16gc4IUplf-i0SvKEZRunkLi61S1_oz-6HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYZ0R5ywfT3kOH_DdARht42gIPZ4UW1crOoRKgBcoo3w&oe=6AF74769"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite Sniper 3D Gun Shooting Ops", "keywords": ["VrSniper3D", "GunShootingGame", "EliteSniperMission", "SniperShooter", "SniperShootingOps"], "long_description": "Step into the world of Elite Snipers in Elite Sniper 3D Gun Shooting Ops, the ultimate 3D shooting game! Take on high-risk missions, eliminate enemies with precision headshots, and master the art of stealth combat.\nUpgrade your sniper rifles, assault guns, and tactical gear to dominate challenging missions. Experience realistic shooting mechanics, stunning 3D graphics, and immersive sound effects that make every shot count.\nAre you ready to prove your sniping skills, complete covert operations, and become the ultimate Elite Sniper? Take aim, fire, and conquer in Elite Sniper 3D Gun Shooting Ops!", "short_description": "Elite Sniper 3D Gun Shooting Ops \u2013 Intense 3D sniper action with stealth missions, precision headshots, and realistic gun combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription
rsive sound effects that make every shot count.\nAre you ready to prove your sniping skills, complete covert operations, and become the ultimate Elite Sniper? Take aim, fire, and conquer in Elite Sniper 3D Gun Shooting Ops!", "short_description": "Elite Sniper 3D Gun Shooting Ops \u2013 Intense 3D sniper action with stealth missions, precision headshots, and realistic gun combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26328831496759862"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823296_773649525697749_2749467106792344063_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcElbSkah_IQ7kNvwFjVG1k&_nc_oc=AdmUgpZZI21P8rPNnTT-s6tIuwnSP4cDfawhOc0E3VsQCdGpCWVyMp1BUXI8BCLyVz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhU-aBNNeSYVbpdh7HDRoz6awrn3tF18ZNEli7Jg-QpQ&oe=69BE991D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Elite Sniper 3D Gun Shooting Ops", "platform": "ANDROID_6DOF"
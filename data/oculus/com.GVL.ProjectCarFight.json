b=1-7&_nc_sid=6e7a0a&_nc_ohc=YwUHhwJG2UAQ7kNvwH0tnI-&_nc_oc=AdquTRDDuyCdK8XDaC6P9ahlofxKrgUftWCEZlt0lt42g8am4pAiArTG8wkIzoLM1QQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIJFpQ5IHmu00A-Q9S7YhTTPy29Rg--eGRyfNXu1Ylig&oe=6B09CE76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoN_New_CoverArt(Landscape) Xavier Grubb.png", "id": "1328472141773776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392105_1328472145107109_1490934121128312609_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7W8aLDaOnwQ7kNvwHcaSLA&_nc_oc=Adq4tBCmuX8iwk19M9jKNv1uYgpBvQUe3hwQaB0OS1BFRVkAW7ilnkAGkHzSdOdYSRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7RVJPSVjHwaq3zra1jPWpzFlW_bp-lCSvLsRh5hCxiA&oe=6B09B78B"}, "display_name": "Battle of Nowhere", "keywords": ["Zombie", "Shooter", "Survival", "Action", "FPS"], "long_description": "Free demo is available https://www.meta.com/experiences/6411035082333525/\n\n\ud83d\udc80 Battle of Nowhere \u2013 Fast-Paced Zombie Mayhem! \ud83d\udd25\n\nThe world is overrun, and survival is all that matters. In Battle of Nowhere, speed, skill, and firepower decide your fate. Blast through relentless zombie hordes, upgrade your arsenal, and fight your way to the top of the leaderboards.\n\n\ud83d\udd2b Arcade-Style Action \u2013 Fast, intense, and addictively satisfying gunplay.\n\ud83c\udfc6 Leaderboard Competition \u2013 The faster you clear a level, the higher you rank.\n\ud83d\udca3 Explosive Upgrades \u2013 Unlock powerful weapons, grenades, and deadly enhancements.\n\u26a1 Non-Stop Progression \u2013 Earn Survivor Credits to upgrade and dominate.\n\nHow long can you survive? Lock. Load. Fight. \ud83d\udd25\n\nJoin our discord at https://discord.gg/tsj9j78Bm9 to tell us what you like/dislike about our game, and what you want us to add.", "short_description": "\ud83d\udc80 Battle of Nowhere \u2013 Fast-Paced Zombie Mayhem! \ud83d\udd25\n\nBlast through
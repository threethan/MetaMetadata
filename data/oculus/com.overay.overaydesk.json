7A&_nc_oc=AdoVVwdFJ6aOSUeRkc3TK6R8T9HXhjmpNXvonqhSAspmAYzKUfoNHfsNBRIHItVaZbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzjAz5g05WCtLQm-stFzFODE0AQOIdpXJXy0O3MVRkww&oe=6AFDC3E3"}, "display_name": "OVERAY DESK", "keywords": ["Productivity", "MultiMonitor", "Monitor", "Note", "Drawing"], "long_description": "# Your PC, Expanded in XR\nSet up your monitors, then work, play, and stay in your space.\n\nConnect your Windows PC and bring your setup into XR, where everything stays in front of you and works just like your desktop.\n\n\n\n{2372957293209068}\n\n# \ud83d\udcbb Up to 5 virtual monitors\n\u2022 Place monitors anywhere with no physical limits\n\n\n\n\n{966084972615222}\n\n# \ud83d\ude80 Quick and easy setup\n\u2022 Start with ready to use layouts and adjust freely\n\n\n\n{929012546602691}\n\n# \u2728 More than just screens\n\u2022 Draw, play, and interact while using your PC\n\n\nNew features and experiences arrive with every update.\n\nDiscover what\u2019s next in your space.\n\n", "short_description": "Expand your PC into virtual space with OVERAY DESK and create a multi monitor workspace with essential tools."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327922843566635"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "4353168641566459"}, {"status": "PUBLISHED", "id": "2093400734910634"}, {"status": "PUBLISHED", "id": "2038510786739688"}, {"status": "PUBLISHED", "id": "770482036077706"}, {"status": "PUBLISHED", "id": "1666691677837828"}]}, "baseline_offer": {"id": "1666691677837828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "4353168641566459"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28916608001364760", "version": "2.6.0"}, "id": "1998147421123397", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916608001364760"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- Monitor layout is now unified under SnapGrid. Display Board has been removed, and your existing layouts and presets are converted to SnapGrid automatically.\n- Added Curve mode to SnapGrid, letting you arrange connected monitors in a curve around you.\n- Added 15-degree snapping to the monitor rotation handle.\n- Monitors now snap when resized to match the height or width of a connected monitor.\n \nImprovements\n- Improved the placement and orientation of the menu between monitors for better visibility.\n \nFixes\n- Fixed an issue where the PC could not reconnect after waking from sleep mode.\n- Fixed an issue where the Space background music volume reset when the app restarted.\n- Fixed an issue on Quest 3 where a hand briefly appeared in front of your view when hand tracking was lost.\n- Fixed an issue where image proportions broke when creating an image note.\n- Fixed an issue where monitor groups were misaligned when placed on the PC. Corner-touching arrangements and misalignment after resolution or rotation changes have also been fixed.", "created_date": 1793938567, "id": "28916608001364760", "version": "2.6.0", "version_code": 54, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916608001364760"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Fixes\n- Fixed an issue where monitors would not appear when connecting to a different PC.\n- Fixed an issue where hands appeared overlapping parts of the view in Mixed mode.", "created_date": 1792556467, "id": "28694480433577519", "version": "2.5.3", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916608001364760"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- Renewed the Overay map with a new sky and lighting, and objects on the desk now respond to the space's day/night lighting.\n- Added a floating clock widget. You can turn it on from the Labs tab in the Desk panel.\n\nImprovements\n- Added a Labs tab to the Desk panel, and moved the Web Browser toggle there.\n\nFixes\n- Fixed an issue where virtual keyboard input could be dropped, or stop responding during rapid repeated input.\n- Fixed an issue where selecting a teleport spot on the minimap would occasionally not move you there.\n- Fixed an issue where the main menu overlapped the desk and was hidden when entering the Overay map.\n- Fixed an issue where placeholder text briefly appeared on the app's startup screen.", "created_date": 1791881791, "id": "28585774347781462", "version": "2.5.2", "version_code": 52, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916608001364760"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Fixes\n- Fixed an issue where space objects and background music remained active in Reality mode.\n- Optimized space graphics resources and refined the minimap and teleport spot markers.", "created_date": 1790576106, "id": "28387628224262743", "version": "2.5.1", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916608001364760"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- VR microphone is now also supported when connected to a Windows PC.\n- Added two new spaces: Ocean Bay and Cyberpunk City.\n- Renewed four existing spaces: Office, Bubble, Forest Cabin, and Cozy Cafe.\n- Added the ability to move all monitors at once. Long-press a monitor to move the entire layout together.\n- Notes now support text formatting and custom fonts. Edits made in the PC note editor appear as-is in VR.\n \nImprovements\n- Changed how custom 360 images are managed. Upload images from the Custom tab on your PC, and view or delete them directly in VR.\n- Added background music for Ocean Bay and replaced the background music for Forest Cabin.", "created_date": 1789976552, "id": "28296107486748151", "version": "2.5.0", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
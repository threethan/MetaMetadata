11670046347_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ygonAnc-IQQ7kNvwEuCe8c&_nc_oc=AdomWrC-Hufb0NriEepVkhaToKjQUeMQi3rWjC_zSWTGwBt6_AACiIEAoKGiLUovKMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEAgx5uTnnIKvbmvw0cYRwn-F6Ci_5gyukn17ckhwMHg&oe=6ACA6BD7"}, {"file_name": "3-note.png", "id": "1357667119892527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_1357667126559193_7331378202814575905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATyX7Vql1zoQ7kNvwHgUfza&_nc_oc=AdrID4445TbZlBVVpEOCwZszzCkh8Dgjp4PzY4JTBSt56UmfXKWfNzulxoOiph2weh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcu4VFoY3d1MXDtWVKDg_PRK2NwpU4dGYmv5O7XmhiYQ&oe=6ACA6806"}, {"file_name": "4-xrpen.png", "id": "1406382801246072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_1406382807912738_7106055393132190720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLy_pXABGsEQ7kNvwHGkIHr&_nc_oc=Adqn3nv9L8x_vwKKB9UlEOU-57cMamEwO-ilokolX6jT8uSc76UXh63y0vnbKTkcZ7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ3fybY5A_kQO_gA_TIAY8CtkarFp0bp16odnX7KtmDA&oe=6ACA6972"}, {"file_name": "5-reality mode.png", "id": "977957885291760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_977957888625093_1325662196954794876_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAw1etZ6mAoQ7kNvwE1F27y&_nc_oc=AdqIF_OLMwW2L39GMQf27fO1v1_SeYoNZmjJH_4IO4KoT0v0I0ZEZfndeD1QCeHXl-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCnAR7C7LP-rwR5fmPLht7KBe4JHd3PDhN0e2E5TEwEA&oe=6ACA5FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OverayDesk_B-Landscape.png", "id": "3089965384527342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613072098_3089965387860675_9196440148487262605_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8X3-EqweKQQ7kNvwG1p5eB&_nc_oc=AdoiColi0lSuBV1DtHktD4Vp19wZ-QHe67JnNFrCv5B_APHrPGm4Dxb1UYABcy5jkW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCiTh2vN-QpKWMaZ4Ob7NSqVaBJN2y90vrsn_P7nMYmQ&oe=6ACA5A12"}, "display_name": "OVERAY DESK", "keywords": ["Productivity", "MultiMonitor", "Monitor", "VirtualDesktop", "RemoteDesktop"], "long_description": "# One Mac or PC. Up to 5 Virtual Monitors in XR.\n\nConnect your Mac or PC and build a personal XR setup with multiple screens without adding more physical monitors.\n\n\u2705 Supports macOS and Windows\n\n\ud83d\udcbb Up to 5 virtual monitors\n\n\ud83d\udcb3 Pay once. No subscription.\n\n\u2014\n\n# \ud83d\udcbb Build Your Multi-Screen Setup\n\nArrange up to five screens around you and return to the same layout in your next session.\n\n{2309814203168725}\n\n\u2014\n\n# \u2728 More Than Just Screens\n\nKeep useful tools nearby without leaving your XR space.\n\n\u2022 Web Browser\n\n\u2022 Notes and Pomodoro Timer\n\n\u2022 XR Pen for drawing in your space\n\n{1032264606230871}\n\n\u2014\n\n# \ud83d\ude80 Get Started in Minutes\n\n1. Download the Host app for macOS or Windows at desk.overay.com\n\n2. Pair your headset and computer\n\n3. Start with a ready-to-use layout or build your own\n\nFor a standard wireless connection, keep your computer and headset on the same network.\n\n\u2014\n\n# \ud83d\udcac Need Help?\n\nRunning into an issue? Join our Discord and our team will help you get connected.\n\n\u2192 https://discord.com/invite/hgKnEHfwkr", "short_description": "One Mac or PC. Up to five screens around you. Build and save your personal XR setup with OVERAY DESK."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_categ
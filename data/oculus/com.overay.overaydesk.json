7kNvwGAqr2A&_nc_oc=Adr8gW4-a_limw1MUEJJ_l5xzrv4-8eRY_Xw8Mv7tV-IV-svTPCzGjqtvWmLA6tLPOg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92YhFOEcXJlyuctR6X6Wa3O_nBu9m6_x149OVbj_xEWw&oe=6A2C2563"}, "display_name": "OVERAY DESK", "keywords": ["Productivity", "MultiMonitor", "Monitor", "Note", "Drawing"], "long_description": "# Your PC, Expanded in XR\nSet up your monitors, then work, play, and stay in your space.\n\nConnect your Windows PC and bring your setup into XR, where everything stays in front of you and works just like your desktop.\n\n\n\n{2372957293209068}\n\n# \ud83d\udcbb Up to 5 virtual monitors\n\u2022 Place monitors anywhere with no physical limits\n\n\n\n\n{966084972615222}\n\n# \ud83d\ude80 Quick and easy setup\n\u2022 Start with ready to use layouts and adjust freely\n\n\n\n{929012546602691}\n\n# \u2728 More than just screens\n\u2022 Draw, play, and interact while using your PC\n\n\nNew features and experiences arrive with every update.\n\nDiscover what\u2019s next in your space.\n\n", "short_description": "Expand your PC into virtual space with OVERAY DESK and create a multi monitor workspace with essential tools."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ivs-XdP8xIAQ7kNvwEWfFqN&_nc_oc=AdrQzCb0-tvbjNWoty4lBfWxBFgW6laYXp26DTYwfvsxnIdfXjFuDAhapJQRSZD2a3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdCoLK2lEI9hyP53Svrh0BprOpuWNMNvOm2ehVy4kuUw&oe=6B0C56D7"}, {"file_name": "3-note.png", "id": "2803112643388442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_2803112646721775_3288867033174146107_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB6Y-eNA628Q7kNvwFduubW&_nc_oc=Adq14YhfnSg_TEJX02MdiymqCrgB9QMCFJdULI2lIstFmuZsOApZUG22qiu5XpGBamc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTFTVONomHOEIBjLQ3N7wB4jN_sYBZ85YKN_3OxszZPw&oe=6B0C589B"}, {"file_name": "4-xrpen.png", "id": "1406382801246072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_1406382807912738_7106055393132190720_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v51D3JWuvNkQ7kNvwEUWw2m&_nc_oc=AdrSsLNBus_jJZY_NcX5RtE49sci9wqG-B7SFk6FPZu5LeSLhWOLCjGuSAnCVvV7lcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUfbHDDbEQcZ9TFkU0Yzi6fpoHc-c_sp1nH6eTZX9Ecg&oe=6B0C5472"}, {"file_name": "5-reality mode.png", "id": "2021771375400790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_2021771378734123_7167764843138473193_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GK7IVERh-JsQ7kNvwHB9cVZ&_nc_oc=AdoP8Wnylh4F9cMwSwOtV22BZkTk_IJDWw2zHN__yS3nJoclBf2gIBJYQVTuvppXIHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxKCIMGDFa9g1VW9ASH59BsYFzTDDyke-s5e8KAduoqQ&oe=6B0C6135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover.png", "id": "1233993885171306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619681_1233993888504639_3466696507057096576_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBcltiIQym0Q7kNvwH0FwSa&_nc_oc=AdpMgC39tb0g9GlXOKSytPijDgC1gAENvpfFM4jb0Bt99M3mmOGEfcmqjqdE5dgs-S0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPZU0oko2xHeU6voieBIjd_kK0aN9o_P7Z7U1ck5PEiA&oe=6B0C7CA3"}, "display_name": "OVERAY DESK", "keywords": ["Productivity", "MultiMonitor", "Monitor", "Note", "Drawing"], "long_description": "# Your PC, Expanded in XR\nSet up your monitors, then work, play, and stay in your space.\n\nConnect your Windows PC and bring your setup into XR, where everything stays in front of you and works just like your desktop.\n\n\n\n{2372957293209068}\n\n# \ud83d\udcbb Up to 5 virtual monitors\n\u2022 Place monitors anywhere with no physical limits\n\n\n\n\n{966084972615222}\n\n# \ud83d\ude80 Quick and easy setup\n\u2022 Start with ready to use layouts and adjust freely\n\n\n\n{929012546602691}\n\n# \u2728 More than just screens\n\u2022 Draw, play, and interact while using your PC\n\n\nNew features and experiences arrive with every update.\n\nDiscover what\u2019s next in your space.\n\n", "short_description": "Expand your PC into virtual space with OVERAY DESK and create a multi monitor workspace with essential tools."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327922843566635"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1597320868322369"}, {"status": "PUBLISHED", "id": "4353168641566459"}, {"status": "PUBLISHED", "id": "2093400734910634"}, {"status": "PUBLISHED", "id": "2038510786739688"}, {"status": "PUBLISHED", "id": "770482036077706"}, {"status": "PUBLISHED", "id": "1666691677837828"}]}, "baseline_offer": {"id": "1666691677837828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1597320868322369"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29155347054157519", "version": "3.0.0"}, "id": "1998147421123397", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29155347054157519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- Monitor controls have been completely redesigned. Without shrinking your monitors, hover over one to bring up its border menu and Control panel, and edit each monitor or group individually. You can grab a monitor by its border and move it at any time, and adjust rotation, curvature, resolution, and grouping all in one place.\n- Monitor changes now apply instantly, and monitors that did not change stay on screen, so you spend less time waiting for changes to take effect.\n- Added Focus (Do Not Disturb) mode to the hand menu, letting you choose between Ray, Touch, and Locked.\n- The PC Host app has been redesigned.\n- The PC connection flow has been reworked. You now connect through your account and can link directly from your list of registered PCs.\n- You can now connect to a PC that isn't on the same network. (Connection may not be possible in some network environments.)\n- On macOS, you can adjust screen sharpness directly and check the result in a preview.\n \nImprovements\n- Input now handles one hand at a time, so your other hand won't interfere with what you're doing.\n- The back of a monitor is now shown as a solid black surface instead of passthrough.\n- Improved text and background aliasing in the UI on Galaxy XR.\n- Settings Panel > Preferences has been split into General and Monitor tabs, with new monitor control options added. (Move All Monitors, Rotation Snapping, Facing Assist)\n- Ending a PC-VR connection now restores your monitor windows to the position and size they had before connecting.\n- On macOS, image quality is maintained even while the screen is static.\n \nFixes\n- Fixed monitors shooting upward when raised above your head, and spinning when brought near your head.\n- Fixed the hand mesh cutting off abruptly at the center boundary in Mixed mode.\n- Fixed layouts reverting to their previous arrangement when applying failed.\n- Fixed the Layouter arrangement not matching the VR arrangement for some monitor presets.", "created_date": 1795439505, "id": "29155347054157519", "version": "3.0.0", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29155347054157519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- Monitor layout is now unified under SnapGrid. Display Board has been removed, and your existing layouts and presets are converted to SnapGrid automatically.\n- Added Curve mode to SnapGrid, letting you arrange connected monitors in a curve around you.\n- Added 15-degree snapping to the monitor rotation handle.\n- Monitors now snap when resized to match the height or width of a connected monitor.\n \nImprovements\n- Improved the placement and orientation of the menu between monitors for better visibility.\n \nFixes\n- Fixed an issue where the PC could not reconnect after waking from sleep mode.\n- Fixed an issue where the Space background music volume reset when the app restarted.\n- Fixed an issue on Quest 3 where a hand briefly appeared in front of your view when hand tracking was lost.\n- Fixed an issue where image proportions broke when creating an image note.\n- Fixed an issue where monitor groups were misaligned when placed on the PC. Corner-touching arrangements and misalignment after resolution or rotation changes have also been fixed.", "created_date": 1793938567, "id": "28916608001364760", "version": "2.6.0", "version_code": 54, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29155347054157519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Fixes\n- Fixed an issue where monitors would not appear when connecting to a different PC.\n- Fixed an issue where hands appeared overlapping parts of the view in Mixed mode.", "created_date": 1792556467, "id": "28694480433577519", "version": "2.5.3", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29155347054157519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- Renewed the Overay map with a new sky and lighting, and objects on the desk now respond to the space's day/night lighting.\n- Added a floating clock widget. You can turn it on from the Labs tab in the Desk panel.\n\nImprovements\n- Added a Labs tab to the Desk panel, and moved the Web Browser toggle there.\n\nFixes\n- Fixed an issue where virtual keyboard input could be dropped, or stop responding during rapid repeated input.\n- Fixed an issue where selecting a teleport spot on the minimap would occasionally not move you there.\n- Fixed an issue where the main menu overlapped the desk and was hidden when entering the Overay map.\n- Fixed an issue where placeholder text briefly appeared on the app's startup screen.", "created_date": 1791881791, "id": "28585774347781462", "version": "2.5.2", "version_code": 52, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29155347054157519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Fixes\n- Fixed an issue where space objects and background music remained active in Reality mode.\n- Optimized space graphics resources and refined the minimap and teleport spot markers.", "created_date": 1790576106, "id": "28387628224262743", "version": "2.5.1", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
X0l-Wa1UMs_BM60Ehwg&oe=6A7C6B17"}, {"file_name": "3-note.png", "id": "1357667119892527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1357667126559193_7331378202814575905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mp04BDZxBIQ7kNvwF4Clxv&_nc_oc=Adq3iqXbMpmKr0cfCVJx-DWyHxEclfQnKcTJxastWvfaUt2bpNqMN0pH_ieNJm_Q0dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvaAumenNZJVQlloLsv9zSbA6ZkRrw2I87e3iqjM1sqg&oe=6A7C6746"}, {"file_name": "4-xrpen.png", "id": "1406382801246072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_1406382807912738_7106055393132190720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RboPK_QOLcQQ7kNvwFqbaos&_nc_oc=AdqL8IPkrSZClaxim5YSY8KJbfRuH-aSahJQffyzWQb340H35p1BEa5TUFbfbTbycjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE4h3hmx2k9sq6wZFzswOpvnz-MPMDKgIXPj-g5TJ6BQ&oe=6A7C68B2"}, {"file_name": "5-reality mode.png", "id": "977957885291760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_977957888625093_1325662196954794876_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhzFKv6_tyEQ7kNvwEkbRDK&_nc_oc=AdrRMprGJUM8UZ1bbxOVnHcjMvjmw-Qp9UgsFS_QOYWQwIg0DRcoqX8sPvHep1-AKDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVEoaCR6nbK3JCbok8MOyoBVSYMhRHxR33KrpXQgUcrA&oe=6A7C5F13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OverayDesk_B-Landscape.png", "id": "3089965384527342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/613072098_3089965387860675_9196440148487262605_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajb0LbecfkcQ7kNvwHKxSNR&_nc_oc=Adr_o-u-_xYktVzFXsXr8xv_NmhLjbfNgC_zFOAcTJHwoPKSygnO-TqAS1F4BuoTzmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZVRyv5XHEFVBnyJvOklcsQzsKePuYSlDQDGcYFqkz5g&oe=6A7C5952"}, "display_name": "OVERAY DESK", "keywords": ["Productivity", "MultiMonitor", "Monitor", "VirtualDesktop", "RemoteDesktop"], "long_description": "# One Mac or PC. Up to 5 Virtual Monitors in XR.\n\nConnect your Mac or PC and build a personal XR setup with multiple screens without adding more physical monitors.\n\n\u2705 Supports macOS and Windows\n\n\ud83d\udcbb Up to 5 virtual monitors\n\n\ud83d\udcb3 Pay once. No subscription.\n\n\u2014\n\n# \ud83d\udcbb Build Your Multi-Screen Setup\n\nArrange up to five screens around you and return to the same layout in your next session.\n\n{2309814203168725}\n\n\u2014\n\n# \u2728 More Than Just Screens\n\nKeep useful tools nearby without leaving your XR space.\n\n\u2022 Web Browser\n\n\u2022 Notes and Pomodoro Timer\n\n\u2022 XR Pen for drawing in your space\n\n{1032264606230871}\n\n\u2014\n\n# \ud83d\ude80 Get Started in Minutes\n\n1. Download the Host app for macOS or Windows at desk.overay.com\n\n2. Pair your headset and computer\n\n3. Start with a ready-to-use layout or build your own\n\nFor a standard wireless connection, keep your computer and headset on the same network.\n\n\u2014\n\n# \ud83d\udcac Need Help?\n\nRunning into an issue? Join our Discord and our team will help you get connected.\n\n\u2192 https://discord.com/invite/hgKnEHfwkr", "short_description": "One Mac or PC. Up to five screens around you. Build and save your personal XR setup with OVERAY DESK."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "p
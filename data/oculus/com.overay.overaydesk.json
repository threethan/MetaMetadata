ere with no physical limits\n\n\n\n\n{966084972615222}\n\n# \ud83d\ude80 Quick and easy setup\n\u2022 Start with ready to use layouts and adjust freely\n\n\n\n{929012546602691}\n\n# \u2728 More than just screens\n\u2022 Draw, play, and interact while using your PC\n\n\nNew features and experiences arrive with every update.\n\nDiscover what\u2019s next in your space.\n\n", "short_description": "Expand your PC into virtual space with OVERAY DESK and create a multi monitor workspace with essential tools."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327922843566635"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "4353168641566459"}, {"status": "PUBLISHED", "id": "2093400734910634"}, {"status": "PUBLISHED", "id": "2038510786739688"}, {"status": "PUBLISHED", "id": "770482036077706"}, {"status": "PUBLISHED", "id": "1666691677837828"}]}, "baseline_offer": {"id": "1666691677837828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "4353168641566459"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28387628224262743", "version": "2.5.1"}, "id": "1998147421123397", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28387628224262743"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Fixes\n- Fixed an issue where space objects and background music remained active in Reality mode.\n- Optimized space graphics resources and refined the minimap and teleport spot markers.", "created_date": 1790576106, "id": "28387628224262743", "version": "2.5.1", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28387628224262743"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- VR microphone is now also supported when connected to a Windows PC.\n- Added two new spaces: Ocean Bay and Cyberpunk City.\n- Renewed four existing spaces: Office, Bubble, Forest Cabin, and Cozy Cafe.\n- Added the ability to move all monitors at once. Long-press a monitor to move the entire layout together.\n- Notes now support text formatting and custom fonts. Edits made in the PC note editor appear as-is in VR.\n \nImprovements\n- Changed how custom 360 images are managed. Upload images from the Custom tab on your PC, and view or delete them directly in VR.\n- Added background music for Ocean Bay and replaced the background music for Forest Cabin.", "created_date": 1789976552, "id": "28296107486748151", "version": "2.5.0", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28387628224262743"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Feature\n- VR microphone support. Your headset's microphone is passed through to your PC, ready to use for meetings, calls, and recording.\n  (Currently available when connected to a macOS PC. Windows support is coming soon.)\n- Added object placement, letting you position objects wherever you want.\n\nImprovements\n- Moving a monitor in 3D space now updates the Layouter tab automatically.\n- Added an exit button to the Extend Panel in the main menu.\n- Improved resource management so memory usage and performance stay stable after long browser sessions.\n\nFixes\n- Fixed an issue where a network error during a PC connection would prevent reconnecting afterward.\n- Fixed an issue where monitors would disappear from view when a layout failed to apply.\n- Fixed an issue where the display state would not recover after connecting or disconnecting a monitor.\n- Fixed an issue where the cursor could break or fail to appear in certain situations.\n- Fixed an issue where the virtual keyboard would open automatically on page load without any user input.", "created_date": 1787823777, "id": "27965349123157324", "version": "2.4.0", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28387628224262743"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "v2.3.1\n\nFix:\nlogging issues", "created_date": 1785835271, "id": "27680048145020758", "version": "2.3.1", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28387628224262743"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Now Available on macOS\nStream your Mac screen directly to VR.\n \nImprovements\n- Improved browser rendering for sharper text and smoother scrolling. (Meta, GXR)\n- Updated the WebRTC streaming engine for better image quality and connection stability.\n- Improved sleep mode transition logic when taking off the headset while connected.\n- Added support for direct connection by entering the VR's IP address on the PC Host.\n \nFixes\n- Improved overall stability of the PC Host and VR applications.\n- Prevented the PC screen from turning off during streaming.\n- Fixed an issue where the audio device would change when modifying the layout during PC streaming.", "created_date": 1785401181, "id": "27622580147434225", "version": "2.3.0", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
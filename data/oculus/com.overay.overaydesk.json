ntent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_1406382807912738_7106055393132190720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RboPK_QOLcQQ7kNvwFqbaos&_nc_oc=AdqL8IPkrSZClaxim5YSY8KJbfRuH-aSahJQffyzWQb340H35p1BEa5TUFbfbTbycjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE4h3hmx2k9sq6wZFzswOpvnz-MPMDKgIXPj-g5TJ6BQ&oe=6A7C68B2"}, {"file_name": "5-reality mode.png", "id": "2021771375400790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619668_2021771378734123_7167764843138473193_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TTRNK8gK0EQ7kNvwEGr5Wq&_nc_oc=AdpCDF-_u4iTOMHGC4iSH0n8wPKYJ6AdHr-eodqwY9YcB_JmbZKXpKIX4OgADPXNOns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6z86_Q11GkgWEx0RxkyPsKuqT236XtWM5Trhy3FPQ_Q&oe=6A7C7575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover.png", "id": "1233993885171306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619681_1233993888504639_3466696507057096576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4WourLE0XsQ7kNvwFLdvyc&_nc_oc=AdqRJwVwnvTmBj6Y3KWxQnEcw2Ho3dom6pm9msjs8rrUBvwrTV8xMsjNZ9bYTiM97is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmhuAYu7EYr6nDGiRN71lr7Ty_PXPQpR_iQ1jDPnJd9g&oe=6A7C58A3"}, "display_name": "OVERAY DESK", "keywords": ["Productivity", "MultiMonitor", "Monitor", "Note", "Drawing"], "long_description": "# Your PC, Expanded in XR\nSet up your monitors, then work, play, and stay in your space.\n\nConnect your Windows PC and bring your setup into XR, where everything stays in front of you and works just like your desktop.\n\n\n\n{2372957293209068}\n\n# \ud83d\udcbb Up to 5 virtual monitors\n\u2022 Place monitors anywhere with no physical limits\n\n\n\n\n{966084972615222}\n\n# \ud83d\ude80 Quick and easy setup\n\u2022 Start with ready to use layouts and adjust freely\n\n\n\n{929012546602691}\n\n# \u2728 More than just screens\n\u2022 Draw, play, and interact while using your PC\n\n\nNew features and experiences arrive with every update.\n\nDiscover what\u2019s next in your space.\n\n", "short_description": "Expand your PC into virtual space with OVERAY DESK and create a multi monitor workspace with essential tools."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327922843566635"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2093400734910634"}, {"status": "PUBLISHED", "id": "2038510786739688"}, {"status": "PUBLISHED", "id": "770482036077706"}, {"status": "PUBLISHED", "id": "1666691677837828"}]}, "baseline_offer": {"id": "1666691677837828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786474800, "status": "PUBLISHED", "id": "2093400734910634"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27680048145020758", "version": "2.3.1"}, "id": "1998147421123397", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27680048145020758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "v2.3.1\n\nFix:\nlogging issues", "created_date": 1785835271, "id": "27680048145020758", "version": "2.3.1", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27680048145020758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "Now Available on macOS\nStream your Mac screen directly to VR.\n \nImprovements\n- Improved browser rendering for sharper text and smoother scrolling. (Meta, GXR)\n- Updated the WebRTC streaming engine for better image quality and connection stability.\n- Improved sleep mode transition logic when taking off the headset while connected.\n- Added support for direct connection by entering the VR's IP address on the PC Host.\n \nFixes\n- Improved overall stability of the PC Host and VR applications.\n- Prevented the PC screen from turning off during streaming.\n- Fixed an issue where the audio device would change when modifying the layout during PC streaming.", "created_date": 1785401181, "id": "27622580147434225", "version": "2.3.0", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27680048145020758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "New Features\nAdded Web Browser(beta)\n- Browse the web directly in VR without a PC connection\n- Freely adjust window position and size, with state restoration support\n- Bluetooth keyboard and mouse support\n- Access Browser from Main Menu - Expand > Browser\n \nImprovements\n- Improved the status indicators for the Display Board / Snap Grid toggle button for better clarity.\n \nFixes\n- Optimized GalaxyXR passthrough camera behavior by activating the AR camera only when passthrough or camera features are actually needed, reducing heat generation and battery consumption.", "created_date": 1782904536, "id": "27306559649036278", "version": "2.2.0", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27680048145020758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": "New Features\n- PC Connection from VR \u2014 You can now directly connect to your registered PC from inside VR, making remote connection faster and more seamless.\n- Bluetooth Keyboard & Mouse Support \u2014 Use a Bluetooth keyboard and mouse paired to your headset to directly control your PC inside VR.\n \nImprovements\n- Screen Height Adjustment \u2014 You can now adjust screen height based on your camera\u2019s eye-level for a more natural view.\n- Simplified Monitor Layout Application \u2014 Quick Apply is now enabled by default for faster setup.\n- Improved Menu Accessibility \u2014 The PC Link button has been moved to the main menu for easier access, and disconnecting can now be done simply by tapping the connected card.\n- Settings Reorganization \u2014 The Sharpness setting has been moved from the main VR settings panel to PC Host > Settings for more detailed control.\n \nFixes\n- Sub-monitor Detach Issue \u2014 Fixed an issue where Snap Grid was not properly updated when detaching sub-monitors.\n- Menu Behavior \u2014 Resolved an issue where the main menu would unintentionally close while the monitor panel was open.\n- Stability Improvements \u2014 Fixed crashes and memory leaks occurring on app exit, and improved overall stability related to input handling and layout rendering.", "created_date": 1781245441, "id": "27078103615215217", "version": "2.1.0", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327922833566636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27680048145020758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1998147421123397"}]}, "change_log": null, "created_date": 1776131921, "id": "26365695196456066", "version": "2.0.0", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
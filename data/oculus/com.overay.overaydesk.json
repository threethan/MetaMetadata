036680626117440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839661_1036680629450773_5120901433454487599_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSbV73yaU1oQ7kNvwFYEf64&_nc_oc=Adrh6ufGPkykswlkEpsbhHU8AXoPgi__mDPoNac61c2NmZyJEag4CbA7siMFTXQPMFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8cGXjHYglvjzZSvqtQ3k9vd9jTLFu4L_yhOwsYueDJQ&oe=6B10628F"}, "display_name": "OVERAY DESK", "keywords": ["Productivity", "MultiMonitor", "VirtualMonitor", "RemoteDesktop", "VRWorkspace"], "long_description": "# Turn Your Computer into a Personal XR Workspace\n\nCreate up to 5 virtual monitors and freely adjust their size and position. Enjoy more space for work, creativity, and entertainment without adding physical monitors.\n\nTo connect your computer, download OVERAY PC Host at **https://desk.overay.com**\n\n{1137281079186839}\n\n# Your Workspace, Your Way\n\n- **Up to 5 Virtual Monitors:** Freely adjust the size and position of each monitor to build your ideal workspace.\n- **Custom Layouts:** Create and save different monitor layouts for different tasks, and pick up right where you left off.\n- **Flexible Environments:** Work in mixed reality or immerse yourself in virtual spaces.\n\n\u2014\n# More Than Just Monitors\n\nEnhance your workspace with built-in tools designed for everyday productivity and creativity.\n\n- **Web Browser:** Keep information and resources within reach.\n- **Spatial Notes:** Capture and organize your ideas in XR.\n- **XR Pen:** Sketch ideas and draw directly in your XR space.\n\n{1010250404837479}\n\n# Get Started in About 3 Minutes\n\n1. Download and install OVERAY PC Host\n2. Create your account and sign in\n3. Pair your devices and choose a preset layout or create your own\n\nAvailable for Windows and macOS, with Linux support coming soon.\n\nDownload PC Host: https://desk.overay.com\n\n# Pay once. No subscription required.\n\u2014\n# Need Help?\n\nJoin our Discord community to get support, share feedback, and suggest new features directly to the OVERAY team.\nhttps://discord.com/invite/hgKnEHfwkr", "short_description": "Connect your PC and create your own XR workspace with up to 5 virtual monitors."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://desk.overay.com/en/docs/privacy", "developer_terms_of_service_url": "https://desk.overay.com/en/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://desk.overay.com/en/faq", "website_url": "https://desk.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29165411023151122"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839718_1900794757555922_2935144578557594130_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moeI5pN3VNIQ7kNvwFkgrtZ&_nc_oc=AdrtL4hUDyIKBl17SwVpZdqeBq6xOXb2C740cmdALPnQbyGX9WZ4BSYv_rVreqMRVqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSxi0Q01d9IgUFNdfZv4uadRST3GK079iyNG1AYJhjcQ&oe=6B105502"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OVERAY DESK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [
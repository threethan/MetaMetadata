c_ohc=cWPCDqbuvDcQ7kNvwG65iGN&_nc_oc=AdnZ0v6WabgC2sfcOKxSkcvuvAi7gAG6hI1w1c-jJ4fq4_Ihe-CUZlf0SY1gOPbCWUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_7xTD9t4xgWiP_GUUdDKrtW4eal-SKi_HgjsjwEAd8Q&oe=69B7EE23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "529152312168508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_529152315501841_7945050178568466841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpZFtJACcUoQ7kNvwE7cLwT&_nc_oc=AdmUu3rP88g2k1F2hZB7P-De4TQmKBgFxqjNz4bZwJd_e4_ykh79Itpbm4haWyoy8hQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy20EIcH7-Z62xEFLrDP5OUoilDP9pBp6YQ7-6wt3gKWw&oe=69B7F912"}, "display_name": "Space Station 51", "keywords": [], "long_description": "Welcome to the lab!  Space Station 51 is your own private space station home away from everybody.\n\nYou have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on.\n\nYour test dummy is a lifeless, non-feeling, non-sentient hunk of metal designed for testing weaponry.  \n\nEvery wack, hit, gunshot or sword wound you deal to your dummy results in credits for your job well done.  Use your hard earned cash to unlock the station's premium weapons and mini-games.  \n\nSpace Chamber 51 brings you:\n\n* An unlockable test arsenal\n\n* Earned mini-games to keep you motivated to perform test\n\n* Interactable items  to be found around the station for testing\n\n* Dual-wield your weapons of choice and use them how you want\n\nStep into the Space Station and start testing!", "short_description": "You have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on. Test the weapon- get rewarded.  Simulated stress relief is guaranteed!"}]}, "developer_name": "John Ray", "developer
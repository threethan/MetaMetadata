=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvEQTIDH_CMQ7kNvwEb6Z25&_nc_oc=AdkS1VkkqeC4JwMJq63FDBI7BAtuQaCc9bYHI5tFcrvrO6Qz73XK3nxmRhg9wKYsyLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfupRlSOEFVDS72Iyu4mDCYvhIUcxKdIleCtCBKFlxvepQ&oe=69A058E6"}, {"file_name": "2.png", "id": "1100918933791452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_1100918937124785_7973577930005576594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIn8LyqE870Q7kNvwE5uYOu&_nc_oc=AdlJDZZD322pqfCU7vXPq7ajtJwqH58TFzplXW3w2hZaZQwrrKATUvp6Dy9mTxaLJUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNEO4VFKuub2wFsPSnNEXcqSJiVT_owIpY__mk3xgX7w&oe=69A03323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "529152312168508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974629_529152315501841_7945050178568466841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INoX7VOfd_UQ7kNvwFKV41Y&_nc_oc=AdmVrHnZx2xe_A_8KDmzFS2-zRBWWsXT4Cxvpi2iZQo4D2fPzIgPOD3TB_xRAFrj5jY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuw44wP3axjb1BhwkoDzy2sWFRQRSggJ-mg5OZPGIVuSQ&oe=69A03E12"}, "display_name": "Space Station 51", "keywords": ["space", "robot", "alien", "shooting", "asteroid"], "long_description": "Welcome to Space Station 51, your private space station where innovation meets action. Assigned to this high-tech lab, you\u2019re equipped with an arsenal of new weapons to test on your Robotic Dummy. From guns and blades to anything you can get your hands on, unleash your creativity and precision.\n\nTest Your Arsenal: Use a variety of weapons to inflict damage and earn credits.\n\nUnlock Premium Gear: Spend your hard-earned credits to unlock top-tier weapons and exciting mini-games.\n\nInteractive Environment: Discover and test interactable items around the station.\n\nDual-Wield Freedom: Equip and use weapons in both hands for maximum impact.\n\nStep into Space Station 51 and start your weapon testing adventure today!", "short_description": "You have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on. Test the weapon- get rewarded.  Simulated stress relief is guaranteed!"}]}, "developer_name": "John Ray", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/space-station-51-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7683819988388891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1219864495695404_4872198366473797799_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtvTEN6gP8gQ7kNvwFzPO_Y&_nc_oc=AdkBgW3ILd0e2eV9sBa2u-_EBYn1hTPQiVqSqdbS0NHmO31WzQHy9avv-BVCYl6_FPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afule-82fjyfJxELi2oFxaLZg7sKUVE6U7xjl9dybZsD4g&oe=69A03D26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Station 51", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
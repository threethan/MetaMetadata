=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM-H0yWEQxUQ7kNvwH3gqrF&_nc_oc=Admue0Wv94qTiTCSUre1P52c25MIx_yBn9aLl-B1iI_p6hk2UrHSuzJMEP1UzX4POwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8cpzfzDxD5Dkg2nAQI4kPoRuEN98zTde4SkV6YAt1UA&oe=6999C166"}, {"file_name": "2.png", "id": "1100918933791452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_1100918937124785_7973577930005576594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7K9uZ8B52AQ7kNvwGzXYXz&_nc_oc=AdnIjJYP7XAi4AQq6aOzOsU-Fs3LQwL9l7Jgd76P9TfeQM5idO6X5WOX6QP46g4Z1lk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs_KYe0x7dC4Bbcdp1gTeTqVoj16lEUFCAcEzy3k0vdwg&oe=69999BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "529152312168508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974629_529152315501841_7945050178568466841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kieLjgZhiMQ7kNvwGzb65l&_nc_oc=AdlxK1r_uXby5SDtYe6ang7aKvY897pPyYwamfvBCyUBabEfK2c-NICryOWSKbVF_xQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftKYn5n5PoDNupjWVszxfOtc4HSryK9pXvaw4TLwHZnPQ&oe=6999A692"}, "display_name": "Space Station 51", "keywords": ["space", "robot", "alien", "shooting", "asteroid"], "long_description": "Welcome to Space Station 51, your private space station where innovation meets action. Assigned to this high-tech lab, you\u2019re equipped with an arsenal of new weapons to test on your Robotic Dummy. From guns and blades to anything you can get your hands on, unleash your creativity and precision.\n\nTest Your Arsenal: Use a variety of weapons to inflict damage and earn credits.\n\nUnlock Premium Gear: Spend your hard-earned credits to unlock top-tier weapons and exciting mini-games.\n\nInteractive Environment: Discover and test interactable items around the station.\n\nDual-Wield Freedom: Equip and use weapons in both hands for maximum impact.\n\nStep into Space Station 51 and start your weapon testing adventure today!", "short_description": "You have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on. Test the weapon- get rewarded.  Simulated stress relief is guaranteed!"}]}, "developer_name": "John Ray", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/space-station-51-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7683819988388891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1219864495695404_4872198366473797799_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBL6t7iy3mEQ7kNvwHiji4f&_nc_oc=AdlHaD3pT743pS1_wJPkApNG1rAO_rBXQ3MFv7BYJuL4eLxplfFLZX7rUwo5y85xvE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfutPjOoKdEavaNd76NlceljLclghEiFRMA5OdgjgTNGqw&oe=6999A5A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Station 51", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
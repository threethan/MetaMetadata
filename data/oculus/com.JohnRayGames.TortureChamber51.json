=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IZTI7dp6NQQ7kNvwHyY5s-&_nc_oc=Adlnz0bWv_KbbUSS5LCzeKK49f1dzwjKed-weleO41WdSZIC0urrc3vURjVAECVfdic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsz8yfRO5PpUSqZ9UoFL1_PUyTKr-oDTj7H9_VZg5Gptg&oe=699C6466"}, {"file_name": "2.png", "id": "1100918933791452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_1100918937124785_7973577930005576594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6SGJGJzgj4Q7kNvwHv0r_q&_nc_oc=Adm8QkJJAlyJAbHZqKk916_NK6FNTurtsc9bZpm_RyGcJaBBMyHgTS_8LhdwYYFgcOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvLZ6-M4-rfPvTeF9gHzPgzcwLK9o8JT3uLS04f_IRwqQ&oe=699C3EA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "529152312168508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_529152315501841_7945050178568466841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGYgCr-fkRkQ7kNvwER5Ib9&_nc_oc=Adm8YclVCoi-8jLyy3MVRCGFwEMQ7bu9pSSKLwdjDkaj0U3DtksrkW1YLijPOBlAbAA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfunOW1Xz_Yd3svKYfk-7q0aKPdoOb7I2hOSwQzxGnlAXw&oe=699C4992"}, "display_name": "Space Station 51", "keywords": ["space", "robot", "alien", "shooting", "asteroid"], "long_description": "Welcome to Space Station 51, your private space station where innovation meets action. Assigned to this high-tech lab, you\u2019re equipped with an arsenal of new weapons to test on your Robotic Dummy. From guns and blades to anything you can get your hands on, unleash your creativity and precision.\n\nTest Your Arsenal: Use a variety of weapons to inflict damage and earn credits.\n\nUnlock Premium Gear: Spend your hard-earned credits to unlock top-tier weapons and exciting mini-games.\n\nInteractive Environment: Discover and test interactable items around the station.\n\nDual-Wield Freedom: Equip and use weapons in both hands for maximum impact.\n\nStep into Space Station 51 and start your weapon testing adventure today!", "short_description": "You have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on. Test the weapon- get rewarded.  Simulated stress relief is guaranteed!"}]}, "developer_name": "John Ray", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/space-station-51-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7683819988388891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035353_1219864495695404_4872198366473797799_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUzgk47YGucQ7kNvwFU8ykO&_nc_oc=Adn8bbJpT_R0j8u1_0r_2oYEAvnBpY10WP4ZGpi2Vmxv0uaJ6M-yNWtDkETug2bfR4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftk_b-NgVFhUn0niPYMapYi1gjZiXkZGymliPVxZ3-rPw&oe=699C48A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Station 51", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
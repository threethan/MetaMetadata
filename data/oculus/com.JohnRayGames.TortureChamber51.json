64.5771-25/75294237_1100918937124785_7973577930005576594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAm0_oh3InIQ7kNvwGdfyPc&_nc_oc=AdpLHcW_EEN8ZfcVbI4ANCM0pfJLRh-XUayZKKK5wfmvlbZgwljDiARJRk0J-9IVuko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByxRM6acvdqUUJj6Gve68DEjaDYnzREjf9FxPjWRMLiA&oe=6A64A2A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "529152312168508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_529152315501841_7945050178568466841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQXMonTX3sQQ7kNvwEF-xX7&_nc_oc=Adpmw2ZybYeeotLNwaurBBke_8d2X0xbZIJSdi8i2L1nXRgb84iaA4V4OxLoZrpdfao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNTHjte5NIuZ5iPzkw1P-7O-FA-WfMrarJP6Q3lAdnng&oe=6A64AD92"}, "display_name": "Space Station 51", "keywords": [], "long_description": "Welcome to the lab!  Space Station 51 is your own private space station home away from everybody.\n\nYou have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on.\n\nYour test dummy is a lifeless, non-feeling, non-sentient hunk of metal designed for testing weaponry.  \n\nEvery wack, hit, gunshot or sword wound you deal to your dummy results in credits for your job well done.  Use your hard earned cash to unlock the station's premium weapons and mini-games.  \n\nSpace Chamber 51 brings you:\n\n* An unlockable test arsenal\n\n* Earned mini-games to keep you motivated to perform test\n\n* Interactable items  to be found around the station for testing\n\n* Dual-wield your weapons of choice and use them how you want\n\nStep into the Space Station and start testing!", "short_description": "You have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on. Test the weapon- get rewarded.  Simulated stress relief is guaranteed!"}]}, "developer_name": "John Ray", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/space-station-51-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2211758615655990"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1904832136792083"}, {"status": "PUBLISHED", "id": "696792710047916"}, {"status": "PUBLISHED", "id": "1087095976634861"}, {"status": "PUBLISHED", "id": "675384545085436"}, {"status": "PUBLISHED", "id": "1594005734579168"}, {"status": "PUBLISHED", "id": "2427713860900855"}, {"status": "PUBLISHED", "id": "3241354052671705"}, {"status": "PUBLISHED", "id": "461648880207205"}, {"status": "PUBLISHED", "id": "470538132349666"}, {"status": "PUBLISHED", "id": "604609198038896"}]}, "baseline_offer": {"id": "470538132349666"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "1904832136792083"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5303572543080
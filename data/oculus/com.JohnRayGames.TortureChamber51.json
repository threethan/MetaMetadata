001454616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_533478004787949_3787636826720209303_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta3MYu6bIEwQ7kNvwESF5XN&_nc_oc=AdrYTndmHefPbnYeuRcipxvEHxxwppIAkICqgrNgCpcpt4BEfXNjau1itc-KG1Dfj8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OnIdZ7fzrgmXkhbtDI5D9E_jaSUM2L20MJmGZwTXDKw&oe=69F75BE6"}, {"file_name": "2.png", "id": "1100918933791452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_1100918937124785_7973577930005576594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LwLmirzk84Q7kNvwEDbshl&_nc_oc=Adpkj0rc1lAVOs402ydcsEv6pzpmEemRyri7Esy69cvKll90gzS0heVBfD6CTv30Yzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZDoFpZn7M8RCoiLHUYmKfs3Vyb_SYatXnl_V4MjarkQ&oe=69F73623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "529152312168508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_529152315501841_7945050178568466841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5I7gQKUEZEQ7kNvwG1-H8q&_nc_oc=AdpnJLp6mHDk2w0x4dGdSIRGbRhgKkkJgUKC-jxUZe2pr7rpTlHv7i5-6q0oY_NSA1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QVtwmjLSkWkCNLTvAZGP5n-vl4ctftY2UMiMBgtkumg&oe=69F74112"}, "display_name": "Space Station 51", "keywords": ["space", "robot", "alien", "shooting", "asteroid"], "long_description": "Welcome to Space Station 51, your private space station where innovation meets action. Assigned to this high-tech lab, you\u2019re equipped with an arsenal of new weapons to test on your Robotic Dummy. From guns and blades to anything you can get your hands on, unleash your creativity and precision.\n\nTest Your Arsenal: Use a variety of weapons to inflict damage and earn credits.\n\nUnlock Premium Gear: Spend your hard-earned credits to unlock top-tier weapons and exciting mini-games.\n\nInteractive Environment: Discover and test interactable items around the station.\n\nDual-Wield Freedom: Equip and use weapons in both hands for maximum impact.\n\nStep into Space Station 51 and start your weapon testing adventure today!", "short_description": "You have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on. Test the weapon- get rewarded.  Simulated stress relief is guaranteed!"}]}, "developer_name": "John Ray", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/space-station-51-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7683819988388891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035353_1219864495695404_4872198366473797799_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTF7fEPJYmoQ7kNvwEJ4X-Z&_nc_oc=AdoBLuEeZtxVi_XT1-_0soOT98rWSiLxh9gBdrPDxuYt7ByB4G4oSG_8ofN4jC6d2_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TG0PpfvDpvQbJ8gEnUrOcAtHWBOrhUkb8xObSMdnwpw&oe=69F74026"}, "is_concept": false, "is_tes
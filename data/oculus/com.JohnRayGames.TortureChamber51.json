=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM-H0yWEQxUQ7kNvwGig7QK&_nc_oc=AdnIU9iYnnJvyrfdz6W5E2Zr_RxNwdj4bHZuS8k1zaooXLWGZyG7NgkCNk9giwkdllg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsmhW5MBaOIncBY5bOV5dEsWN3kdIvUk6SyA9vj6JF72Q&oe=69986FE6"}, {"file_name": "2.png", "id": "1100918933791452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294237_1100918937124785_7973577930005576594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7K9uZ8B52AQ7kNvwGbCIeu&_nc_oc=AdkDRQIu5V_Uc4oYu7Q6w01RJ3FlpBmk-iRfNbXk6eZuD6CwgE0Xm8FD1102to7C06A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvFvf4YnhGR-FAp6USSA1dVxVzdZBuOJW4t_miWHSGyww&oe=69984A23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "529152312168508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_529152315501841_7945050178568466841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kieLjgZhiMQ7kNvwE9pA15&_nc_oc=Adl6ICjAOVD0K6iG5eMGjNtq96ebsRzn61sXlRI1VnkOzo0KAi68ql_fZai_TDTxFZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfspadeKX9wrMjf5kFHl-IaZCpZIMLPewlkhjvC9DzBiFQ&oe=69985512"}, "display_name": "Space Station 51", "keywords": ["space", "robot", "alien", "shooting", "asteroid"], "long_description": "Welcome to Space Station 51, your private space station where innovation meets action. Assigned to this high-tech lab, you\u2019re equipped with an arsenal of new weapons to test on your Robotic Dummy. From guns and blades to anything you can get your hands on, unleash your creativity and precision.\n\nTest Your Arsenal: Use a variety of weapons to inflict damage and earn credits.\n\nUnlock Premium Gear: Spend your hard-earned credits to unlock top-tier weapons and exciting mini-games.\n\nInteractive Environment: Discover and test interactable items around the station.\n\nDual-Wield Freedom: Equip and use weapons in both hands for maximum impact.\n\nStep into Space Station 51 and start your weapon testing adventure today!", "short_description": "You have been assigned to Space Station 51.  Backed by an arsenal of new weapons, you must test them on your Robotic Dummy.  Use  guns, blades and anything you can get your hands on. Test the weapon- get rewarded.  Simulated stress relief is guaranteed!"}]}, "developer_name": "John Ray", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/space-station-51-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7683819988388891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1219864495695404_4872198366473797799_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBL6t7iy3mEQ7kNvwGGUkGI&_nc_oc=AdmlOUgUH-24mA8rSP-BY3LHwGHXQsfNxooOtFC32hPE9c2rspCtutHnmWMfiNgsCsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuG0uepNj--Tofe9QTqfL9ooPb_ZJ9Yy-0TxxyaIcBMHg&oe=69985426"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Station 51", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
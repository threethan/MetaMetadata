0a&_nc_ohc=1v89rbkmeskQ7kNvwGF8-kI&_nc_oc=AdnlLZc6sW5Y1IohXXqjXCxrDtZADtW9xVGa_S3eMX2TEEDCVIbZFo-Iw4NbJg9rz6Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkWXwJUVdibUb7mpmBVk4txScbt_RTtrSN_n5x6ORd7g&oe=69AAB80B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz6OMlwypQUQ7kNvwEbNohL&_nc_oc=AdnDAa62VUCwhBnUL6IwOXrE13q559U5gV_picUt4YVGTsXooM3ackNfT9PoFyFEUGo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1zaZ3QfG671TayPtPhY3vqwPFOJVQKxRlM4_qNK0tOA&oe=69AAB10B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzFLD7eKJpwQ7kNvwHH_FAx&_nc_oc=AdkALQGzeQpLLmG-ILXQN3CPXq9ZJ1JT1QBnawU41d6_aC0ixXIN3qS1S3fVsz11emA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxav-pqYsRD8McAaDRdYGA1vAEPyiISspfufYpsg8-SIg&oe=69AAE452"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ncqGqymx8MQ7kNvwG5hy0t&_nc_oc=AdnUSdq1mhs8yL_1PxMxmjzallrMI-jix5quRHvG4JmdDogcy3T1CRFAf-kLj4XCPLQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afx72ERPouEY2gtxfkvjXTle3Yg_pgCMfB5_N0okQn_S9Q&oe=69AAC1D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EMULATED: Pylons", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1506032437, "la
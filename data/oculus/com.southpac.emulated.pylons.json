t7OlKGDHlHNkgbPx3HCaYuA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv_w8wd9AOY9BcXK3ZZ2fCehX_l8eqz0i2fjfL0m1m-YQ&oe=69A17D8B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ql3lMWWJV4Q7kNvwE6FaRR&_nc_oc=AdnUhXNv8JjdQ4QTSVMAospvPg8juINY1qXBZdFdm8nCUyY9OcX8spAYgv6fGhFvMVs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuZZndubOJoE2cHw_zBg8Cj3WWsN_bTAe5pGtlNEo-yCg&oe=69A1768B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K7tzoWx-x8Q7kNvwH1262t&_nc_oc=Adnt_3MsR1VQGuIkD51VpALSrLaZ0MxyKu65dhYJM0CFoQTaCNE5dElvWFlkVO1SSQ0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsWcMOWLzJ5mvYmeG1vGIvKaDeHKPSCD8AZ8e_SEcvWBg&oe=69A1A9D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrycclfBFC8Q7kNvwFC4JYI&_nc_oc=AdlrPGEpxLk9YbP8TWwTpOn7KQZuGeT7QQS9vzUeYTDSI3miUQA9Oa70kECFDWJJ8kU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftynEtJ99UoWEzOwZ01TiaAZ-5vak41_QRv1PDrhX22Qg&oe=69A18757"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EMULATED: Pylons", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1506032437, "lastRevision": {"nodes": [{"id": "1417869454995323", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_met
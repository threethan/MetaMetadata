nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQkSScgS3BcQ7kNvwF4o-MP&_nc_oc=Adqb4qGkCEvcNLvBf84H8cKxSgxqWhc_OwrHCpt6H4RHMVEEMCr_JasrHTIb5Dy3Syc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ6OhtBez36YUEQd8cj20XOFhAUOQM-BsCDqxYJqGRUA&oe=6AD391CB"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOmPuQo9zvMQ7kNvwGDzDT9&_nc_oc=AdpcA_ZfJgVJRRhlBhqG4FY254PkfzeSU-6ii2Ota1xrv3OSkhZ5p1DdPFX1Vo3dlQw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6YEkIWsyKlpwzM0xSsa583dNQ96rLJDtvtWogboVRMA&oe=6AD38ACB"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvWxRFvB7s0Q7kNvwEVZYrm&_nc_oc=Ado3XRcQF8QZHavKHsmjmagmkJmQUIHSQml4-IZvldWbdbe3PDFjBqexLeJV3H4hNy0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1D0F0Pi5RwIImBUZE_-cJegicUCZc1Jmx0ulT_SN4UA&oe=6AD385D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyZE8iqL6rIQ7kNvwGcci-9&_nc_oc=AdqLPlDk5XagsBXOtEYo7B2RmYsfGP6JvOOgqCGeFX06grbXWbLY7kM2jA9LEMrp6S8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw2IeZiITDBiYaUMoAxd_Ejwkn2FZFJ0dyBUFLMiNF5Q&oe=6AD39B97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EMULATED: Pylons", "platform": "ANDROID", "context_category": null, "context_
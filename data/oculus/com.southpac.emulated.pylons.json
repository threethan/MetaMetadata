c_ohc=PLv_JuBC_YQQ7kNvwGZkQoL&_nc_oc=AdksS7VRdI2jEwwA_mlFfANazmjRPbushJRG4ceoOp-nQnwv2XW28j3ALwkSxV-JBIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdU_u6c0cWg7Eo6T8_mgDfU4ut7grlb0B1vX6gJDAn_Q&oe=69BFD00B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QYvauj6hA0Q7kNvwFXloI_&_nc_oc=Adm3q35qQs2DxxzRotGE2VEoic_dY_N-hOLcV3eol0fF72kck_PdrTmaPYYhQ0QUspA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_ZjRH72zjT0ibrELyF6GxQZ3njEE2stA6fIWB21kVMQ&oe=69C0014B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo1vz4KNgkkQ7kNvwGqhNai&_nc_oc=Adk3DXV6B3QorChh3C4HhiwdYI8bxcXV6pi9gEOx3uiKJ-c3sEA-ws9goyQqthd-m3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2OrsQgv1OQ7hwgClm1EUnF68LTvjbx5RSzDFP0xsx4A&oe=69BFFC52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFXxTR2NMD4Q7kNvwH-GplY&_nc_oc=AdkCFaOVGcv8zXqtCawKB86EWJ8YlI_thwsGC2P_KE_-8OOqUj08oV2deF4Va_wR4qI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwuu0Bg5F1ispuM_dEJEIGPFrphGiAMJxzSzfvDx4PL_g&oe=69BFD9D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EMULATED: Pylons", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1506032437, "lastRevisi
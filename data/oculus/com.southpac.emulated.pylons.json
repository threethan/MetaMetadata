QT4fXJc9LcEuTZk9r9QxRMsXrXQ1AFqF3ISdSIXWbeMrg&oe=6B0B3E43"}, {"file_name": "migrated_image.png", "id": "822905421540142", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162693_483036728727653_4844737983359746048_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9dfn85p04gQ7kNvwGaT2QT&_nc_oc=Adp6uw3bm2b3Cy3C8dbrA0b3J0PzMF7LCKIUIETnK9uyizYwM4lGGQv468NSbAUpTmA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNO2dc9aIXttw9atGmnYqq9ppICEarYy7I9yEcD8O7bw&oe=6B0B290B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlFEa3aTUIAQ7kNvwGet6qQ&_nc_oc=AdqdTL2GFFhfIe_fNfVY_l-DQ9-MBBktzW4FAul3YT83IBF0KV-8yeYElh_YBwzFErA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6bCOmbK4EIDFvc10ZpQb3x0OVfW5qNuqwjDAhs_m4JA&oe=6B0B220B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGGCUHdKh6AQ7kNvwGc7joR&_nc_oc=AdpwoEHXdiQ4KvUKhP7MITrL_B1m7ceEKH1_oH8ff3JB4pNbXUY5yRaiALt51kBXLQE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxb5fUrlDy7tcGwVyKa7bypQ5RVtuHdr0smBkWoxpQ4A&oe=6B0B1D12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arUYtn9GxvYQ7kNvwFaKD1Q&_nc_oc=AdpUwF-fQpO91K9BEppBy
nTxGHvAtbi5rF_O6XVHSczg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv6dlLMPs3mfs0HyemnyfUbTz0wzyDljJVOMo2n7K7L-A&oe=6998430B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMX1OtT57jMQ7kNvwGpTs7z&_nc_oc=AdkfNYzPM2ye0ars14q8hY2g11r5HD82dCiGtPH0eD9bhxmM02nSEZ4uFXLIny7FzzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftGMQeA0PIMjYC7aSB7UsyhhLvv5NGNnZedWzAqCeos3w&oe=69983C0B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ1ekmTYAccQ7kNvwEp3hlR&_nc_oc=Adn-mZLblAb7reaU3uu8DBbbM8twdJb1SxXIlYdxCs6eOsQODdznSs3JiRKxFVIQW5k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuJ0-kra6blxxWRNe7zV6of3Qm82eSswJGkDOnvxyrU8w&oe=69986F52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMXZILJ0C4gQ7kNvwHDWcgO&_nc_oc=Adme6yt1zlXY9zTUnd3HYGV5BldbfnIPPpw9w45MLJZwgWabUx5sP-bybdkvVWS26R0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftFzd9ah6QWGg08iVs0Z9S_wXyV3_qMRNDv613iAXGv4g&oe=69984CD7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EMULATED: Pylons", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1506032437, "lastRevision": {"nodes": [{"id": "1417869454995323", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_met
QQdIbyEAysHi5s8gDdLqjvPbWdpEBBfbppcDwBj01dmVw&oe=6AFF2883"}, {"file_name": "migrated_image.png", "id": "822905421540142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162693_483036728727653_4844737983359746048_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsHzf0fK_zwQ7kNvwEaJaYZ&_nc_oc=AdqJkO6Py0uddqO2CG-gaVvXh8Oe-RgsndAhW6trXQ8BNQETo9CVL0yt5F-cwUYs25I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjkvkLVZFv_LNYk5SKp6RxW95MxJrLWK65lbacJlR5kQ&oe=6AFF134B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAGi7ZnLqXgQ7kNvwHk99-9&_nc_oc=AdpGU9F9-1DZIaPLkUKV3mM-VP4oeSrmur8-rE28VJICea4w8IzaGrysL1COjGfmJt4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX9PUrgfGDg9oM5jeNEq7TDBxocR8ehnJEvRCVzpzpiw&oe=6AFF0C4B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZKxLPodOlUQ7kNvwHR63c4&_nc_oc=AdoxSsEhW1y7-Q5vC8uraXtC2zc8ZwhmOrwa29acb7a_2GNaCZbhtnNtJxLTIFAbTfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCcTPoVUNR2ELcBbeWnNLDrlBM5qcwiSVZkOd5bnTRJQ&oe=6AFF0752"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfvvyULw0XgQ7kNvwGR8OFJ&_nc_oc=AdrIN6gRu3aTQFZXYOUMf
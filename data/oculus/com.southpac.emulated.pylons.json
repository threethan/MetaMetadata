INMNY_wRZk8E6XqCxId6TIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2e12nPHKhgS1WmMbNBYyMUUmh3BKKHYrBiI3LR6mQ73Q&oe=69F0CFCB"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MchXW7XKxfwQ7kNvwE6TXfi&_nc_oc=AdqWu1aU0m9yxC-ne19eGdgOwqwgLQmMYkeQW1x9mtdT7hVFPK8PwGB3AW1Sx__yu7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1E1w-Zzi8YhO_SYnHat2DT83iVtEmUsmV9qD1jGoyAOA&oe=69F0C8CB"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8sHwX3cojcQ7kNvwE_N8DR&_nc_oc=AdrEgpzJguDWxJNWkpdJfWHYs6a9_HZXxjzZNL0PwXJ8HmIHTiPgpkl5am8riNj1xeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2sR-Q_kwHDJiptfyi03oCPSPeXrNeuN9J81pV76kprWg&oe=69F0C3D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luuxiOHuGoAQ7kNvwGkRz5C&_nc_oc=Adp0UYlVROghOdO6ZJmFYxhv_z_QPbN7edlIvlPpNjmvDJCrNJwsExagHRYrMX1eQ4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0jKR31A7vrdnxh62E_W-n879U7gFyELmYlMYLb_hLRSQ&oe=69F0A157"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EMULATED: Pylons", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1506032437, "lastRevision": {"nodes": [{"id": "1417869454995323", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_met
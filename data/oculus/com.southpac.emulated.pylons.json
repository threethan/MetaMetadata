nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVdwYJrnhvoQ7kNvwHOIYyY&_nc_oc=AdrzWxE87IRi5l7UjTBjLirXJEobk9lmjjQAE7ayCTQt69Ff-7GvIp3syxX46d7q8Fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0qveC3PLT3NgA3PSfECRKEhMUU0ijz4mUsGLLl8mipw&oe=6A843F8B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kb-RD27mCkAQ7kNvwE9Ji8-&_nc_oc=Adrk0zEh2kNEDSCkZNowPQ8M5u1oWKmnvkE8915iozxWV1AgjL08dsQp6ibv22Q261w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3llEhjpNIcTkQ8kZfjDnaqqHLn5tQuzehEP9FBMQx3A&oe=6A84388B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXt1s88Z-4cQ7kNvwFpFr99&_nc_oc=AdpOP4N0_POSLn5TI1i-3bSU_PqXrgaAzlU9nNfTYcSpvI8wUOoyrZSikXi5TSFdDzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQbZAP4zS_nAleCReej5pNDU5msUXk4M70kkq152fLQw&oe=6A843392"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL0mxV1RNvwQ7kNvwG5D8PA&_nc_oc=AdpSjxCQ8y8TJGUw5kazeY3JmeOnvX5TtmklBaK7IMbRoboaNg8Mtj_p9_IUK8XxIhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-f8Nt1QkLCzH8-_hwV5TO9Dc4FndorCJMnqdxyA1Dfg&oe=6A844957"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EMULATED: Pylons", "platform": "ANDROID", "context_category": null, "context_
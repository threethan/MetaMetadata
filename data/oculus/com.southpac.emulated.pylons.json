QWd0gTEZRSPszOVotWy71AWFUgR_g6NhnpLyO7sNkFaEg&oe=6B0EFA83"}, {"file_name": "migrated_image.png", "id": "822905421540142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162693_483036728727653_4844737983359746048_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoCSuuD6wQEQ7kNvwFda9sp&_nc_oc=Adr8WwhMFYaSiRKkR4IKYqw3HhbYRjuqQDeuGvaNAMnc-_Zh8qjhy8XpPo3_c62R5iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxe2cqoKoD8CXZqFYjASJNtZyuxUyyx-XdN3yqI8wmqA&oe=6B0F1D8B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af-rwehSAdwQ7kNvwFs5PyN&_nc_oc=AdrHV8cgmvtndix83kuGoA84bad8Z5OQFQB8m20fNz3b_XMy6swnLbQet534pHDbLLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKK2cw7vM0e3oV-aJhZQYYSJaZoRFy--2Z2ffjo3-2Rw&oe=6B0F168B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJn1O7RPjNUQ7kNvwEBB156&_nc_oc=AdpHNoaKIlConaZqvrIvjn4CBoFbh4HiPQMVGWQp7AlLDGAr0i-5RDpnqO59B5lSHrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9vr21WHCq6sGUHKkS7rQa36WniQv9TJ3eQqO9A0l0bQ&oe=6B0F1192"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujOBW3yLjgIQ7kNvwGsstiz&_nc_oc=AdqNv470zXabqtsSAJUVU
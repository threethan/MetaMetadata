QSkexO2qF6-lgx27zDDqyffDkZ8BzeFJJBfNJs4kyBzsA&oe=6B0C5783"}, {"file_name": "migrated_image.png", "id": "822905421540142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162693_483036728727653_4844737983359746048_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9dfn85p04gQ7kNvwHuu_fk&_nc_oc=Adqkp_dxTgnk8GNmq-kVKDuMPiA6NqurnGV94Q_dwy4stD8dVo2x-v3Ol07uoTdRBvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsNodK5sQqQI_rjrWrFkdww5iLF-KMOUQG1x4hhPVgQA&oe=6B0C7A8B"}, {"file_name": "migrated_image.png", "id": "516721375709083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162737_524124021261288_7288675504083697664_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af-rwehSAdwQ7kNvwH7qh7O&_nc_oc=Adru2a3R1MKMVl98WMT9H-a4tXFig3J4o_5HRttz99md72Dc5YIQbWAzzR18mKSQYyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVF_HM-hj_OhqapPci-89Cx_zo_zWlZXV1Hr50Itz95A&oe=6B0C738B"}, {"file_name": "migrated_image.png", "id": "237553050714826", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1943929049155425_6645432090546405376_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGGCUHdKh6AQ7kNvwEE8Rvi&_nc_oc=AdpVfYWRinmO7c840wcGLoKVZYS1lafPW6HVulF-5zt5D65u9Fwfl_8iR6e0WIVfRdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTH9yk5P58HMSoACwoXJSHmBOuOSHVQ1Cukx3xaePRjXg&oe=6B0C6E92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMULATED: Pylons", "keywords": ["fps", "cyberpunk", "shooter", "gamepad", "walking"], "long_description": "EMULATED: Pylons is a true old school First Person Shooter where you can free roam the map to complete missions as an Anti Virus Unit operative in cyberspace.\n\nMake sure that you have a gamepad before you download! \nFor more information about gamepads see http://emulated.southpac.co/controllers/\n\nGame is set in the future when humanity exists in a cyberspace. As an operative you are assigned a mission to capture communication pylons in a city infested by Vektorbots.\n\nIncludes 6 missions with unique maps + Training mission. \n\nFeatures:\n- Story driven game\n- Advanced, futuristic shooting\n- 9 types of weapons with different characteristics\n- Elements of quest\n- Cyberpunk style graphics and environment\n- Most remote bluetooth controllers supported\n\nEMULATED: Pylons is the first of the EMULATED game series.\n\nThis game uses Southpac's VR FPS engine that minimizes the cybersicknes so you can finally walk and jump without teleporting.", "short_description": "Cyberpunk First Person Shooter. Get emulated into the system core, defeat Vektorbots and capture communication pylons. Gamepad required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emulated.southpac.co/privacy-policy/", "developer_terms_of_service_url": "http://emulated.southpac.co/terms-of-service/", "publisher_name": "Southpac Interactive", "support_website_url": null, "website_url": "http://emulated.southpac.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627485141808381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162685_729079680610484_5196083969078067200_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujOBW3yLjgIQ7kNvwEUcTGc&_nc_oc=AdoWxKzp4q1AZDMnOc27P
6214863617_7663053068415459144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti_gaNizB-cQ7kNvwH5DYP_&_nc_oc=AdojBsUQ0sDPe0z-CnYJlIWdOc5YRcd7XDGI8cO8FNbzFzqGw6AWZP6nZ8K7do3teY4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpuZi1VFVRp3MJTM_Ci-NUoyan0lrnwNc-ixys8yfLDQ&oe=6A974D74"}, {"file_name": "Screenshot 2026-02-27 165344.png", "id": "1397816935359935", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819854_1397816938693268_2556645303977089359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfzsIwoY1LQQ7kNvwFKCiCQ&_nc_oc=Adr4SkBWs9vQCvVA2GLIqeBkfkumXCcnTmSoYJZpmh8QAUhy5Jmzm6DQ_OZ8q2jC4pA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPEV-jxRZlUu12zT399J5c_baruxIVRSjp8yU0OxRPUw&oe=6A974EF5"}, {"file_name": "Screenshot 2026-02-27 163718 (1).png", "id": "4209527075969146", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820387_4209527082635812_4618394607162013029_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQopGxn1CHIQ7kNvwHzncgk&_nc_oc=AdoP8yQD7scTLWa1eOZXACEhYcydaUSPfgb6SNjfVY1Olxi9a591uLNCiI6CD6HkQOw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX8dPUv5R-6pJAR7eQKFiocAS9ubkRzov-vQCHS18pIA&oe=6A97231A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RNG God's", "keywords": [], "long_description": "RNG God's is a VR experience unlike anything else \u2014 where skill means nothing and luck means everything. Make your way down the hall, press the button, and see what the RNG Gods have in store for you. No two runs are ever the same.\nEvery press of the button is a new surprise. Roll for cool cosmetics, powerful upgrades, and discover what fate has decided for you this time. The best part? It costs you nothing to roll \u2014 just pure RNG fun.\nPush your luck further with 10 rebirths, unlock upgrades, and collect cosmetics as you go. The more you play, the more you discover \u2014 but remember, it's all in the hands of the RNG Gods.\nFeatures:\n\n10 rebirths to unlock\nUpgrades and progression system\nCool cosmetics to collect\nPure RNG based gameplay\nEndless replay ability\nImmersive VR environment\nFree to roll \u2014 no spending required\n\nAre you ready to test your luck? The RNG Gods are waiting.", "short_description": "RNG God's is a VR experience where luck is everything. Make your way down the hall, press the button. With 10 rebirths, upgrades, and endless replay ability, every run is different. Do you have what it takes to please the RNG Gods?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/3c78e84a-648b-4c7e-a2ba-ecb9ac6aea0c", "developer_terms_of_service_url": null, "publisher_name": "Chillzz games", "support_website_url": null, "website_url": "https://www.termsfeed.com/live/3c78e84a-648b-4c7e-a2ba-ecb9ac6aea0c", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26592121277061950"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1851689888815449"}]}, "baseline_offer": {"id": "1851689888815449"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772711820, "status": "PUBLISHED", "id": "1851689888815449"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28139369299003799", "version": "1.7"}, "id": "212174488533932
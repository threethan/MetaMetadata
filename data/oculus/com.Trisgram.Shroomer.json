64.5771-25/491819239_1625496715469154_339381389256163841_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsxG0KuW5woQ7kNvwFSFh56&_nc_oc=Adq-VFoQO9XjE0yDUnozqVmD9b1Eepfzp4vGYYv159P7DLXXw3CmkbqQTst1gSX7Q68&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDQ2X-7TPXDki2cVqNRp1XPEyVtG9F7f_oaawTeFxdSA&oe=6A882CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview-img-trailer.png", "id": "1842310973831070", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819854_1842310977164403_4806666514605608146_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIUpsEDK8jAQ7kNvwF4ctGm&_nc_oc=AdoE_2UKMlzNzg_aylLlRjPcu0gR7gsex_EUDh-3UiqBN7Jar4r5ilqdfMOXYjWx5ZM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU32LdpWjpZV1rd_-JYo3CWGxEqbHsVlSCBEOvugW9VA&oe=6A884B26"}, "display_name": "Shroomer - Demo", "keywords": [], "long_description": "In this open world VR fantasy,  you take on the role of Shroomer - a mystical mushroom forager, entrusted by the kingdom to manage a secret enchanted forest.\n\nYour mission is to gather rare and powerful fungi and vegetation, process them into useful elixirs, and fulfill tasks for the kingdom and its people. However, the forest is full of danger\u2014some mushrooms are not just poisonous but volatile, capable of exploding, releasing toxic spores, or reacting unpredictably.\n\nTo survive, you must carefully identify, harvest, and handle each mushroom with the right approach, using tools, knowledge, and alchemy. As you explore deeper, you uncover hidden stories, ancient magic, and challenges that test your skill and bravery. Will you master the art of shroomcraft or will the magic forest claim you?", "short_description": "In this open world VR fantasy,  you take on the role of Shroomer - a mystical mushroom forager, entrusted by the kingdom to manage a secret enchanted forest.\n\nYour mission is to gather rare and powerful fungi and vegetation, process them into useful elixirs, and fulfill tasks for the kingdom and its people. \nYou must handle each mushroom with the right approach, using tools, knowledge, and alchemy. Will you master the art of shroomcraft or will the magic forest claim you?"}]}, "developer_name": "Trisgram", "developer_privacy_policy_url": "https://games.trisgram.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trisgram", "support_website_url": null, "website_url": "https://trisgram.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24588036477559730"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1183804400323561"}]}, "baseline_offer": {"id": "1183804400323561"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764163200, "status": "PUBLISHED", "id": "1183804400323561"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24597478653282179", "version": "0.4.0"}, "id": "805851375746883", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24588036447559733", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2459747865328
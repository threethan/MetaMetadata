ywords": ["experiment", "biology", "cell", "science", "contentsda"], "long_description": "1. add distilled water to a small beaker and add the agar-agar powder\n2. place the agar-agar solution on a hotplate and heat it up\n3. add the phenolphthalein solution to the heated beaker\n4. turn off the hotplate and allow the beaker to cool, the solution will solidify and form agar lumps (umu)\nThe phenolphthalein-soaked agar balls in front of you can be likened to cells of different sizes\n5. place the agar balls in a solution of sodium hydroxide\n6. take out the agar balls that have changed color one by one\n7. cut the agar balls with a knife\n8. observe the agar agar that has turned red\n\n<Result\n- The larger the piece, the less substance was absorbed in the center \n- The larger the cells, the less efficient the exchange of substances is\n- As the agar piece grows larger: the rate of increase in volume is greater than the rate of increase in surface area, reducing the efficiency of mass exchange", "short_description": "Witness the marvel of life's replication. Observe how cells divide and multiply, a fundamental process in biology that drives growth and reproduction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
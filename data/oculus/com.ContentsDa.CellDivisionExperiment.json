36710686138_1566752386643916901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXlaZGysiEUQ7kNvwFwSat0&_nc_oc=AdpFCZRd5LPtfjNst1FDrzs5vWa0NGNhvZfMGWs9UA0TOAZWsXb57yS73cXXywG33gA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEK2h0jqqPPgucPidQjvLen9xLTMt71V7ZyGRYrFS2Fw&oe=69C13CE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cell Division_Landscape.png", "id": "390501136858850", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254876_390501140192183_4573046377847380108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCe8KYxICsoQ7kNvwETsi4S&_nc_oc=AdoOtBU-WErZIIZQq9xRs8q7NMsq06-PuIuVLpbb7_tR8q9Kv8c4UFMRTtVoCH6tkLg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOPSuIPlTKz6lfJc43lsnIZdWHmb9tS1I4nA_HIeFDxQ&oe=69C14BFB"}, "display_name": "Cell Division Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "biology", "cell", "science", "contentsda"], "long_description": "1. add distilled water to a small beaker and add the agar-agar powder\n2. place the agar-agar solution on a hotplate and heat it up\n3. add the phenolphthalein solution to the heated beaker\n4. turn off the hotplate and allow the beaker to cool, the solution will solidify and form agar lumps (umu)\nThe phenolphthalein-soaked agar balls in front of you can be likened to cells of different sizes\n5. place the agar balls in a solution of sodium hydroxide\n6. take out the agar balls that have changed color one by one\n7. cut the agar balls with a knife\n8. observe the agar agar that has turned red\n\n<Result\n- The larger the piece, the less substance was absorbed in the center \n- The larger the cells, the less efficient the exchange of substances is\n- As the agar piece grows larger: the rate of increase in volume is greater than the rate of increase in surface area, reducing the efficiency of mass exchange", "short_description": "Witness the marvel of life's replication. Observe how cells divide and multiply, a fundamental process in biology that drives growth and reproduction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9833178723366970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003286_1178241726547687_5969242109803340523_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-frAf8SvRQQ7kNvwFgKFDS&_nc_oc=AdrO7GGJGa36BJfRPYyK0avr2R6xRXOq3FPSIyN8MDIKBRUtfSNDGLTKtIjGN-SK2I4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwE1NI5Ax7XFB1JaJqslou2jJM-hI48FteN8-Svc9ZdEQ&oe=69C151F2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cell Division Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1699914624, "lastRevision": {"nodes": [{"id": "7261710747180460
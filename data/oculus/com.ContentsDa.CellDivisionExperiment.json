hc=lX1BmoyTGwwQ7kNvwHEYxQc&_nc_oc=AdmAqJGRDxTkvW4oZ8VV9iRjDff511SY6RE1-xIw_Mvq-kWUvwXg8VoZGNU5iJPwAjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftsAemOkzIOnk0g0LYuAJIedAPivN-91_PYz37CQGSgnA&oe=69A837CB"}, {"file_name": "msedge_dDd66OjfzL.png", "id": "2429836707352805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393594_2429836710686138_1566752386643916901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gurdx7hHrSkQ7kNvwHo3LU2&_nc_oc=Adm6X-WNDMFRN4u7dWnq5r4Po0zF9Aor2KDgsTnlT_cKFsLH3yNjaIX28kSjO9MucyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsOYrX7lg7Vfetq_KutNqqQrZsmcu-d9P5RWqWu4cSVUw&oe=69A83066"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cell Division_Landscape.png", "id": "390501136858850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254876_390501140192183_4573046377847380108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHc7PKhTt-oQ7kNvwF7Wgog&_nc_oc=Adm5fqKxOrrGsJEBRTKs5GUUevabDi5odWeq2qYJiUKqxhkn72NtGDVd0IhM-ZoNmP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftmRZlwIwGvTkjw1fWOjDGrMJvk7AaMuNLeGGIfaTYvRw&oe=69A83F7B"}, "display_name": "Cell Division Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "biology", "cell", "science", "contentsda"], "long_description": "1. add distilled water to a small beaker and add the agar-agar powder\n2. place the agar-agar solution on a hotplate and heat it up\n3. add the phenolphthalein solution to the heated beaker\n4. turn off the hotplate and allow the beaker to cool, the solution will solidify and form agar lumps (umu)\nThe phenolphthalein-soaked agar balls in front of you can be likened to cells of different sizes\n5. place the agar balls in a solution of sodium hydroxide\n6. take out the agar balls that have changed color one by one\n7. cut the agar balls with a knife\n8. observe the agar agar that has turned red\n\n<Result\n- The larger the piece, the less substance was absorbed in the center \n- The larger the cells, the less efficient the exchange of substances is\n- As the agar piece grows larger: the rate of increase in volume is greater than the rate of increase in surface area, reducing the efficiency of mass exchange", "short_description": "Witness the marvel of life's replication. Observe how cells divide and multiply, a fundamental process in biology that drives growth and reproduction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9833178723366970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003286_1178241726547687_5969242109803340523_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkF_6OEvj5IQ7kNvwFYkHgX&_nc_oc=AdltKIR9Y4wakov5cnXgap9XzbwdfnVh5msZvOWP6q4JUgcaS4GYbP2L_RVCHJd7cno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft86nOS5MrU9Mlru1oC7KcZAM3hKMyJaycrdptbudQymw&oe=69A80D32"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cell Divisio
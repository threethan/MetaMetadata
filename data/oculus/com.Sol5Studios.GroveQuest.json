oe=69B7FD21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grove", "keywords": [], "long_description": "Attend Virtual Reality Support Groups with Grove! With Grove, you can find, join, create, and attend virtual reality support groups from the comfort of your home. This allows you to find the right group quicker, remain anonymous, and eliminate the need for transportation. At Grove, we hope that by creating a safe and communal environment, groups will be able to overcome their past traumas and experiences to enjoy a happier, healthier life.", "short_description": "Attend Virtual Reality Support Groups with Grove! With Grove, you can find, join, create, and attend virtual reality support groups from the comfort of your home. This allows you to find the right group quicker, remain anonymous, and eliminate the need for transportation. At Grove, we hope that by creating a safe and communal environment, groups will be able to overcome their past traumas and experiences to enjoy a happier, healthier life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.grovevr.com/privacy", "developer_terms_of_service_url": "https://www.grovevr.com/terms-of-use", "publisher_name": "Sol 5 Studios", "support_website_url": null, "website_url": "https://grovevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
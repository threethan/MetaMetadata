F8A5C0"}, {"file_name": "reach_tubetrouble.png", "id": "880303863224221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974923_880303866557554_7548382632520109569_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxDIRF-3dAMQ7kNvwHoayMU&_nc_oc=Adrea3gDyV1uzkQeiNk0gS90C9sxxNyDviwdEzWCfJabqSy60iuLTqmVysc31lZ62gQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwEfG0gD2q1xHwBJ2fdV5Toog1m98NoUiqwmUSufoZlg&oe=6AF87CE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReachAppCoverArt.png", "id": "732182794964501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569448_732182798297834_7468334677055046962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5HEjgZhBiIQ7kNvwExaqvO&_nc_oc=AdomlomC7sIm_r6gAUYBJHAwwYcrJYscXchSImpqaYM6PRl7b0fchlqVVVJuDw3T2rw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShaOVekrLFx10ndwxMqqelmpZs9CnaZh64rdkC6-lsiw&oe=6AF891ED"}, "display_name": "Reach Shoulder Health", "keywords": [], "long_description": "Shoulder pain, stiffness, or weakness? You're not alone! One out of three people will develop shoulder strength or mobility issues in their lifetime. If you\u2019re one of them, you know how profoundly shoulder problems can impact your everyday activities. \n\nMovement exercises done regularly can increase a shoulder's range of motion and strength. Reach is on a mission to create VR experiences that identify your shoulder limitations and recruit movement specific to your strengths and weaknesses, all within immersive VR environments like a quiet, starry evening or a fast-paced galactic battle!\n\nReach\u2019s Beta release includes a Firefly Assessment experience and two games. Each of these experiences tracks your motion progress and provides useful analysis to you in a web-based portal. And, don't forget to check back soon-- more Reach VR experiences are in development!\n\nGive Reach a try, and play your way to better shoulder health-- virtually!", "short_description": "Welcome to Reach, the VR app designed to help you build shoulder strength and mobility! The Reach system includes range of motion assessments, VR games that are algorithmically tailored to your shoulder\u2019s range of motion, and the Reach Portal, where you can view your goals and progress reports. Whether you're catching fireflies in a quiet forest or protecting intergalactic space from an onslaught of invaders, Reach will encourage you on your journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://reach-vr.com/terms/", "developer_terms_of_service_url": null, "publisher_name": "Triad Labs", "support_website_url": "http://reach-vr.com/support/", "website_url": "http://reach-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3305173619754342"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1925694928865602"}, {"status": "PUBLISHED", "id": "755446202553800"}]}, "baseline_offer": {"id": "755446202553800"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1925694928865602"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40116282571296138", "version": "1.00.312"}, "id": "439359598176608", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40116282571296138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "* Changes to the Reach main menu, survey logic, and Reach Dashboard linking to support Reach Total Mobility features.\n* Players may now continue playing beyond the daily suggested play time limit.\n* Suspended Reach AI Coach for maintenance.\n* Bug fixes and security updates.", "created_date": 1793808867, "id": "40116282571296138", "version": "1.00.312", "version_code": 326, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40116282571296138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "* Bullseye has a new, improved look! Summer, fall, and winter seasons come to the glade.\n* Bug fixes for Wordspace that make it easier to match letters.\n* New daily challenge types & bug fixes for challenge completions.", "created_date": 1790784072, "id": "39193602736897464", "version": "1.00.310", "version_code": 324, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40116282571296138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "* We made performance improvements to level maps across all games.\n* We added new daily challenges and challenges types to the rotation (starting October 1st), including new night mode and hidden echo challenges for Bullseye and new word length challenge types for Wordspace.\n* We reworked the replay and next mission flow for Space Gunner.\n* We updated the Unity platform version to bring security and stability enhancements.", "created_date": 1788963334, "id": "38654298510827892", "version": "1.00.305", "version_code": 319, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40116282571296138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "Bullseye has new modes and hundreds of new levels! \u201cAfter dark\u201d levels are indicated with an icon on the Bullseye level map. Use flashlights to illuminate your targets! Also, check out new hidden sequence levels designed to test your muscle memory. Listen and watch for targets, then repeat the sequence.\n\nWe\u2019ve also made improvements to the Reach AI Coach and platform updates behind the scenes bringing stability, performance, & security enhancements; additionally, we fixed a bug causing certain data upload operations to hang.", "created_date": 1785424466, "id": "37676128318644921", "version": "1.00.299", "version_code": 313, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40116282571296138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "* Our latest (4/8/26) update includes a news feature! Check the news panel for updates about Reach VR.\n* We\u2019ve made adjustments to the Reach AI Coach with the goal of shortening responses. To unlock the Reach AI Coach, please register for a Reach Dashboard account, then visit the settings panel to enable the Coach.\n* Added tutorial level indicators to level maps.\n* Fixed a bug that would sometimes prevent targets from spawning.\n* Made it easier to skip and replay the Space Gunner tutorial.\n* Increased target generation speed in Bullseye.\n* Fixed a bug that would cause some users to be sent to level 1 on the map progression on each load.", "created_date": 1775661265, "id": "35162716376652807", "version": "1.00.280", "version_code": 294, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
nc_ohc=og7NG53fst4Q7kNvwGQ33A6&_nc_oc=AdrbmmneuzkeXQYYOxNIDd5Lh0EUrKLqkoibc5kmz9kBhL-f0F9QboMJJ29n6dDfB50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RlHFWGCRBUKY7_NAoVpEOjtvQw1JmNP4sML4FPG13Mg&oe=6A073993"}, {"file_name": "reach_SGmenu.png", "id": "1244146662860070", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_1244146666193403_9053285987101141685_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub4xGyA-QSgQ7kNvwHoG7xE&_nc_oc=Adp8GS5vTlD1LMrRm3pxP9fwPnSAhwVdAvoEXR2RSzM4tOxixsQ8-jRTN6Y4mwTJwYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7339qe3DPLjdSGrjB7d4Ont5H_rWvaJCJZO-vrFJfWvw&oe=6A072B00"}, {"file_name": "reach_tubetrouble.png", "id": "880303863224221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974923_880303866557554_7548382632520109569_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNQyY4q5MhcQ7kNvwFz0QWS&_nc_oc=Adov15YgmTrvhRfPxqKav6D_dWeGhIK0Qi152TMooijSc0qvIhlXAlfJaLGt4CnTwu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I6HSP66QPmUxYCN9SjAluQXJS08TsWQEUcqCIJ8xx_g&oe=6A073A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReachAppCoverArt.png", "id": "732182794964501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569448_732182798297834_7468334677055046962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti6QJv47s9gQ7kNvwHBHMC-&_nc_oc=AdoG9n4UMaUVNfAS5kMHwUA3b-jZ9OT99EJOKSmvfv8pTxuS3pxnPE25Ss_Z22CEqCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tvRQsZ180E3N8NOnKFrWcVECjismiyRZ6qAFRyVJimA&oe=6A07172D"}, "display_name": "Reach Shoulder Health", "keywords": [], "long_description": "Shoulder pain, stiffness, or weakness? You're not alone! One out of three people will develop shoulder strength or mobility issues in their lifetime. If you\u2019re one of them, you know how profoundly shoulder problems can impact your everyday activities. \n\nMovement exercises done regularly can increase a shoulder's range of motion and strength. Reach is on a mission to create VR experiences that identify your shoulder limitations and recruit movement specific to your strengths and weaknesses, all within immersive VR environments like a quiet, starry evening or a fast-paced galactic battle!\n\nReach\u2019s Beta release includes a Firefly Assessment experience and two games. Each of these experiences tracks your motion progress and provides useful analysis to you in a web-based portal. And, don't forget to check back soon-- more Reach VR experiences are in development!\n\nGive Reach a try, and play your way to better shoulder health-- virtually!", "short_description": "Welcome to Reach, the VR app designed to help you build shoulder strength and mobility! The Reach system includes range of motion assessments, VR games that are algorithmically tailored to your shoulder\u2019s range of motion, and the Reach Portal, where you can view your goals and progress reports. Whether you're catching fireflies in a quiet forest or protecting intergalactic space from an onslaught of invaders, Reach will encourage you on your journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://reach-vr.com/terms/", "developer_terms_of_service_url": null, "publisher_name": "Triad Labs", "support_website_url": "http://reach-vr.com/support/", "website_url": "http://reach-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3305173619754342"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "755446202553800"}]}, "baseline_offer": {"id": "755446202553800"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1677771180, "status": "PUBLISHED", "id": "755446202553800"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35162716376652807", "version": "1.00.280"}, "id": "439359598176608", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35162716376652807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "* Our latest (4/8/26) update includes a news feature! Check the news panel for updates about Reach VR.\n* We\u2019ve made adjustments to the Reach AI Coach with the goal of shortening responses. To unlock the Reach AI Coach, please register for a Reach Dashboard account, then visit the settings panel to enable the Coach.\n* Added tutorial level indicators to level maps.\n* Fixed a bug that would sometimes prevent targets from spawning.\n* Made it easier to skip and replay the Space Gunner tutorial.\n* Increased target generation speed in Bullseye.\n* Fixed a bug that would cause some users to be sent to level 1 on the map progression on each load.", "created_date": 1775661265, "id": "35162716376652807", "version": "1.00.280", "version_code": 294, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35162716376652807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "This is a big one!\n\nThe latest update of Reach VR brings with it a new Reach AI Coach, which can identify patterns in your movement data, recommend specific games, and connect your playtime in Reach VR to your frozen shoulder progress. Upon launch, you\u2019ll be asked if you want to opt in to the Coach. If enabled, the Coach will be available on the right-most panel of the main menu screen. Just click on the avatar to get started.\n\nRate your Reach AI Coach interactions with a thumbs up or thumbs down and help us improve the Coach over time; we\u2019re looking forward to your feedback on this feature. If you wish to leave more detailed feedback, please contact the Reach team at: support@triadlabs.com.", "created_date": 1772576922, "id": "34466262886298163", "version": "1.00.274", "version_code": 289, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35162716376652807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "We\u2019ve addressed an issue with Tube Trouble that was causing some tubes to be impossible to complete.", "created_date": 1766005409, "id": "33222055877385543", "version": "1.00.262", "version_code": 277, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35162716376652807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1765991487, "id": "33219304770993987", "version": "1.00.261", "version_code": 276, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8275868042431005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35162716376652807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "439359598176608"}]}, "change_log": "We\u2019ve added subscriptions to the app. New users can try all Reach games for free; subscribe to unlock additional levels.\n\nNumerous bug fixes! Most notably, we\u2019ve improved the collision detection in Tube Trouble to avoid mistaken failures.\n\nNew levels and bug fixes for Bullseye have also been included.\n", "created_date": 1765382463, "id": "33108060328785099", "version": "1.00.259", "version_code": 274, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
20f&oh=00_Af5RlHFWGCRBUKY7_NAoVpEOjtvQw1JmNP4sML4FPG13Mg&oe=6A073993"}, {"file_name": "reach_SGmenu.png", "id": "1244146662860070", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_1244146666193403_9053285987101141685_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub4xGyA-QSgQ7kNvwHoG7xE&_nc_oc=Adp8GS5vTlD1LMrRm3pxP9fwPnSAhwVdAvoEXR2RSzM4tOxixsQ8-jRTN6Y4mwTJwYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7339qe3DPLjdSGrjB7d4Ont5H_rWvaJCJZO-vrFJfWvw&oe=6A072B00"}, {"file_name": "reach_tubetrouble.png", "id": "880303863224221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974923_880303866557554_7548382632520109569_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNQyY4q5MhcQ7kNvwFz0QWS&_nc_oc=Adov15YgmTrvhRfPxqKav6D_dWeGhIK0Qi152TMooijSc0qvIhlXAlfJaLGt4CnTwu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I6HSP66QPmUxYCN9SjAluQXJS08TsWQEUcqCIJ8xx_g&oe=6A073A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Reach VR thumbnail png v2.png", "id": "1065339672066261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298387_1065339675399594_206928004917100161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c80j6prQ4sQ7kNvwG8lJjc&_nc_oc=AdrFbr3vATLMXSW9XM91FqrTGvSrsnSjDnDR8b6_y8Jps50sUkm-Tq9xwt2mX83WpaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bnb4NQKXmpFoRoBVIB09LeKXvA1ZU5GJo2snsXCBXEw&oe=6A070DDE"}, "display_name": "Reach VR", "keywords": ["Shoulder", "Frozen", "Physical", "Exercise"], "long_description": "Frozen shoulder can make everyday movement feel frustrating and limiting. Reach VR offers an engaging, game-based way to explore shoulder movement through immersive virtual experiences designed around how you move.\n\nEvery journey begins by understanding your current movement range. Reach VR uses an interactive movement check to understand how your shoulder moves today. That information powers adaptive gameplay that responds to your unique movement patterns, ensuring each game adjusts dynamically as you play.\n\nForget repetitive drills. Reach VR transforms movement into immersive VR games that evolve with you. Each game uses sophisticated algorithms to scale difficulty in real time, encouraging comfortable exploration of movement while keeping challenges achievable and motivating.\n\nCatch glowing fireflies in a peaceful forest, reaching higher as the world responds to you. Step into space and defend against incoming threats, where every motion drives the action. These playful environments turn movement into something engaging, rewarding, and fun.\n\nTrack your progress visually with the Reach Dashboard. See movement trends over time, unlock milestones, and stay motivated by watching your gameplay evolve as your movement changes. Reach VR makes movement feel interactive, personalized, and empowering\u2014at your own pace.", "short_description": "Built for people dealing with shoulder stiffness like frozen shoulder, Reach VR turns movement into fun, interactive games. Each game adapts in real time to your personal movement limits using smart algorithms\u2014keeping challenges achievable and engaging. Explore immersive worlds, track progress visually, and play at your own pace as movement becomes more rewarding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://reach-vr.com/privacy-policy/", "developer_terms_of_service_url": "https://reach-vr.com/terms/", "publisher_name": "Triad Labs", "support_website_url": "http://reach-vr.com/support/", "website_url": "http://reach-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
YD5MLxbBvQ&oe=6AFC8E3B"}, {"file_name": "screenshot5.png", "id": "214468337319155", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57569478_214468340652488_5125276015757291457_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdIhx1KcjEgQ7kNvwEshH11&_nc_oc=AdoxrEYj3CrympNuu1IoY4zOMrcNrHIiCn0Zao9Q5JEkpdsRx4gDp9VKPES8YJ_nDqM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTybbdXkRXhtvd-3YaBSYX76mtgrZ9WPCaQEmOXVeZWQg&oe=6AFC6914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Speech Trainer", "keywords": [], "long_description": "Our stress-free virtual reality enables the playful acquisition of public speaking skills, whilst avoiding potential problems caused by stage fright or hesitation.\nThe self-organized learning process provided by the VR Speech Trainer accelerates the acquisition of new skills.\nThe communication challenges of everyday life can then be faced with confidence.\n\nReceive individualized, science-based feedback via state of the art AI-based analytics.\nDevelop your presentation skills and become a professional keynote speaker.\u200b\nAI- and Machine Learning-based training forms the foundation for our VR Speech Trainer.\nOur software tracks all aspects of your performance and realistically adjusts your virtual spectators\u2019 reactions in real time.", "short_description": "The Power of Public Speaking - The Virtual Reality Speech Trainer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trainer.vr-speech.com/data-security", "developer_terms_of_service_url": null, "publisher_name": "straightlabs", "support_website_url": null, "website_url": "https://vr-speech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "h
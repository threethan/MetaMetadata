t-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhtqlM8YowtZhPOwM2nUNbjPI9497fPhJZ9gpoXT2yAA&oe=69B3EB54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Speech Trainer", "keywords": [], "long_description": "Our stress-free virtual reality enables the playful acquisition of public speaking skills, whilst avoiding potential problems caused by stage fright or hesitation.\nThe self-organized learning process provided by the VR Speech Trainer accelerates the acquisition of new skills.\nThe communication challenges of everyday life can then be faced with confidence.\n\nReceive individualized, science-based feedback via state of the art AI-based analytics.\nDevelop your presentation skills and become a professional keynote speaker.\u200b\nAI- and Machine Learning-based training forms the foundation for our VR Speech Trainer.\nOur software tracks all aspects of your performance and realistically adjusts your virtual spectators\u2019 reactions in real time.", "short_description": "The Power of Public Speaking - The Virtual Reality Speech Trainer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trainer.vr-speech.com/data-security", "developer_terms_of_service_url": null, "publisher_name": "straightlabs", "support_website_url": null, "website_url": "https://vr-speech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
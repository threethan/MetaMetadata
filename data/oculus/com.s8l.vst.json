fFV2MyE4KrXw1A3p8rk_3g3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPRBOYwdHirPGAm9mOVAFdtnzPUxJLYe77TW380iASLA&oe=6AB29514"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Speech Trainer", "keywords": [], "long_description": "Our stress-free virtual reality enables the playful acquisition of public speaking skills, whilst avoiding potential problems caused by stage fright or hesitation.\nThe self-organized learning process provided by the VR Speech Trainer accelerates the acquisition of new skills.\nThe communication challenges of everyday life can then be faced with confidence.\n\nReceive individualized, science-based feedback via state of the art AI-based analytics.\nDevelop your presentation skills and become a professional keynote speaker.\u200b\nAI- and Machine Learning-based training forms the foundation for our VR Speech Trainer.\nOur software tracks all aspects of your performance and realistically adjusts your virtual spectators\u2019 reactions in real time.", "short_description": "The Power of Public Speaking - The Virtual Reality Speech Trainer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trainer.vr-speech.com/data-security", "developer_terms_of_service_url": null, "publisher_name": "straightlabs", "support_website_url": null, "website_url": "https://vr-speech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "882724532423380"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3054982494658132"}, {"status": "PUBLISHED", "id": "461564062248961"}]}, "baseline_offer": {"id": "3054982494658132"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744366620, "status": "PUBLISHED", "id": "3054982494658132"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9672477702777069", "version": "1.8"}, "id": "276016494333976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4620877591270464", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9672477702777069"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "276016494333976"}]}, "change_log": null, "created_date": 1739211605, "id": "9672477702777069", "version": "1.8", "version_code": 159, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4620877591270464", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9672477702777069"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "276016494333976"}]}, "change_log": "- General performance optimization\n- The user interface of the entire application has been updated\n- The mode selection in the options has been replaced by the \"Help system\" section: Instead of choosing between \"Trainin
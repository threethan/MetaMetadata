qgl4lFHoDfqi5VWi7L05c6QZvQ3SzJk9W1TNu2F_Nw&oe=69F61828"}, {"file_name": "04.png", "id": "820711187330824", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822327_820711190664157_2150738379921592873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd7yMkz5BzwQ7kNvwGUmaj9&_nc_oc=Adpsr2y7WX2bdY3CVXMM-dlPUH-reTOXlQFEVCyH8ED9Zl0HnHwvfQrDht2AotCh12k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UcaApleolEtFxpqAAG6G4uVMhGkxQ3k4hzeYOScCO2g&oe=69F60D85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quarantine Protocol: Infection Zone VR", "keywords": ["Zombies", "Infection", "Outbreak", "Quarantine", "Control"], "long_description": "Quarantine Protocol: Infection Zone VR plunges you into a hyper-realistic, post-apocalyptic world where a deadly virus threatens to consume humanity. As a frontline officer inside the quarantine zone, every choice you make \u2014 every test, every denial, every bullet fired \u2014 carries real consequences.\n\nBuilt for full VR immersion, this first-person outbreak simulator blends strategic management, tense decision-making, and psychological horror. Man checkpoints, inspect survivors, manage staff, and allocate scarce resources as you struggle to contain the infection and maintain order. The undead horde looms beyond the gates, and a single mistake could unleash chaos.\n\nFeel the weight of moral choices in real time \u2014 save the innocent or protect the mission. Upgrade your facilities, train personnel, and fortify your base against rising threats. Each action shapes the world around you in a consequence-driven narrative filled with tension, suspense, and human drama.\n\nWith its deeply atmospheric environments, tactile interactions, and a unique gameplay loop combining survival strategy, ethical decision-making, and immersive simulation, Quarantine Protocol: Infection Zone VR delivers a gripping and unforgettable Meta Horizon experience where every heartbeat matters \u2014 and every choice has a cost.", "short_description": "Experience the chaos of a viral outbreak like never before in Quarantine Protocol: Infection Zone VR. Step into a fully immersive first-person world where your decisions, reflexes, and ethics determine humanity\u2019s fate. Manage quarantine checkpoints, screen survivors, contain infections, and defend your base\u2014all in visceral, atmospheric virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24868698076159258"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1310739397347378"}]}, "baseline_offer": {"id": "1310739397347378"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763749500, "status": "PUBLISHED", "id": "1310739397347378"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25636497892712602", "version": "1.5"}, "id": "1319527769820911", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24137501455945594", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25636497892712602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1319527769820911"}]}, "change_log": null, "created_date": 1771423170, "id": "25636497892712602", "version": "1.5", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24137501455945594", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25636497892712602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1319527769820911"}]}, "change_log": null, "created_date": 1771256897, "id": "25619235414438850", "version": "1.4", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24137501455945594", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25636497892712602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1319527769820911"}]}, "change_log": "We\u2019ve been hard at work improving the experience. This update brings important system upgrades, smoother gameplay, and overall quality improvements.\n\n\ufffd Food, Medicine & Fuel System Updates\n\nImproved balance and behavior across the Food, Medicine, and Fuel systems\n\nMore consistent interactions and clearer feedback for players\n\nBackend optimizations for better reliability and performance\n\n\ufffd UI Improvements\n\nCleaner, more intuitive interface\n\nImproved readability and layout across menus\n\nSmoother transitions and interactions in VR\n\n\ufffd Ariel (Aerial) Mission Improvements\n\nEnhanced mission flow and objectives\n\nImproved stability and responsiveness during missions\n\nBug fixes to reduce interruptions and edge-case issues\n\n\ufffd Quality of Life Improvements\n\nGeneral performance optimizations\n\nReduced bugs and glitches across the app\n\nOverall smoother and more polished experience\n\nThank you for playing and supporting us! More updates coming soon. \ufffd", "created_date": 1769713518, "id": "25457586117270448", "version": "1.3", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24137501455945594", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25636497892712602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1319527769820911"}]}, "change_log": "\ufffd What\u2019s New\n\n     \ufffdImproved UI for clearer information and faster decision- \n          making.\n\n     \ufffdEnhanced VR UI interactions with smoother input and \n          better haptics.\n\n      \ufffd French language support added\n\n    \ufffd In-App Purchases now available\n\n    \ufffd Performance optimizations & bug fixes\n\nStay sharp. The outbreak won\u2019t wait. \ufffd\ufffd", "created_date": 1766490267, "id": "25150691924626537", "version": "1.2", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24137501455945594", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25636497892712602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1319527769820911"}]}, "change_log": null, "created_date": 1764079339, "id": "24927341013628297", "version": "1.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
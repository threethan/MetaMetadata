&oe=6B0EF0DD"}, {"file_name": "03-forbidden-city-1-2560x1440.png", "id": "1109929701394386", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593839439_1109929704727719_8614547045928088835_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8IZQrroArkQ7kNvwGd1hSD&_nc_oc=AdpKsImQNXyB8QM8UOmAgfQ_wskhN-hw8sohk1yNofXGIL9LOHPlnOm28EDGNmltqzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUw4IKMmmqqsJ3cr4F8cYAB6Fu2FOX7Wy2aORJygYYQfQ&oe=6B0EEB8C"}, {"file_name": "07-tibet-0-2560x1440.png", "id": "3026886964326254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619404_3026886970992920_3060880245232536331_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZND2X6zgZlMQ7kNvwFZ2LvO&_nc_oc=Adp4RBkrurHeiqFwy4W7rlSoUgSDx1fupkcgBllBMXWc2HcdN_mC3-zMt90AxCKAwig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXICTpBMOIRR4k3-2-Zt2nz1RJ3a2kobzREs78PnG1R8g&oe=6B0F1CB4"}, {"file_name": "04-shanghai-3-2560x1440.png", "id": "3209997509360312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_3209997512693645_375316043926808280_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHk6Fn0mBTkQ7kNvwFjgPEO&_nc_oc=Adqtjx5TdHPBHJyvtsfo4XxFpNpG3eI7Tlt_hnlLpD99gcVEw6JxiYFCqNEBJEUY15s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWT6M2Bg7Z-bLCUb_RsGr6dLgqhNexNTrRDdJcwUTLgA&oe=6B0F0A23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1908997630483792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628875_1908997637150458_6618120575747851613_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clXZ50aPiGgQ7kNvwE5pAK6&_nc_oc=AdrT97qtPN1X1vob_86rCh63-aY97_rNK1zXMx9Qg91rSl4_msWcoRFwOFEcVnXAx1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtGu_PBGg37XL-mHKPcWuI-aYuNzG2SIIG3899GNqLtA&oe=6B0F039A"}, "display_name": "Trip to China", "keywords": ["China", "travel", "panorama", "culture", "sightseeing"], "long_description": "Trip to China takes you to the places people dream of seeing, in full 360\u00b0 photographs you can look around in.\n\n57 journeys, 680 stops. Walk the Great Wall at Badaling as the sun goes down, cross the courtyards of the Forbidden City, look up at the Potala Palace in Lhasa, drift past the karst peaks of Guilin, stand under the three sacred snow mountains of Yading, and watch the Bund light up at night. Journeys cover cities, mountains, temples, grottoes, gardens, deserts and coasts, from Harbin's ice festival to the islands of Hainan.\n\nA guide at every stop. Each stop has spoken narration in English or Chinese. Labels float over mountains, buildings and rivers so you always know what you are looking at, and info cards tell the story behind them: the history, the people, the numbers.\n\nTravel your way. Follow a journey stop by stop, let it play on its own, or jump straight to the place you want from the map of China on the home screen. Change between day and night where a place has both, listen to the sounds of the place, and take photos to keep.\n\nMade for comfort. The view never moves by itself: no flying, no automatic turning, no camera motion. Moving between stops is a short fade to black. You can sit or stand, and use controllers or your hands.\n\nDownload what you want. Each journey is a separate download, so you only keep the places you want to visit. Download a journey from its page; delete it any time to free up space.\n\nLanguages: English and Simplified Chinese.", "short_description": "Visit China in 360\u00b0. 57 guided journeys and 680 stops: the Great Wall at sunset, the Forbidden City, the Potala Palace, the karst peaks of Guilin, the snow mountains of Yading, the Bund at night and more. At every stop a narrator tells you where you are, and labels and info cards explain what you see. Sit back, look around, and travel at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://triptochina.no996.fun/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Trip to China team", "support_website_url": "https://triptochina.no996.fun/support/", "website_url": "https://triptochina.no996.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323889180818727"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1818648345997808"}]}, "baseline_offer": {"id": "1818648345997808"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792474680, "status": "PUBLISHED", "id": "1818648345997808"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1390999430774368", "version": "0.1.6"}, "id": "1452831493424044", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1323889177485394", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1390999430774368"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795598363, "id": "1411036198770691", "version": "0.
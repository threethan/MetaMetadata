20", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620630_1457998282872953_5693268556789044774_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGrdthGWhRkQ7kNvwHjLXRL&_nc_oc=AdoZ0YNAYMvEdzvoPXOCsqXatyvrqrE325cuSmXjvu4sL06V7o_LbOVmLhc5H8C62a0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAkPN4hWYNuyxgyxlpBpALz-ICMq3NtS8mp-A9pRz75g&oe=6AFB1D0D"}, {"file_name": "06-yading-9-2560x1440.png", "id": "1583973432971312", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499627477_1583973436304645_8899935603581502668_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBcTirLrI38Q7kNvwF_DSRo&_nc_oc=AdosxjQjhPF64v3DmCcycWXhypBv9MrTaEStwBQChzMHvUResUX7zQzi2hHD_yI-xBo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlR6Aag9SN2L0yOfPX0LDxy2HpameIELyEo1n2yGCAxg&oe=6AFB2A5D"}, {"file_name": "03-forbidden-city-1-2560x1440.png", "id": "1109929701394386", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593839439_1109929704727719_8614547045928088835_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0ILKnuL-38Q7kNvwE8f-jk&_nc_oc=AdqQrSt6swqVhccCNNA-TqZT1a89XoHXNH80C9bezFqtqUKpK3H_gvpdOhl3AHy5E2g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6wOJDbyg-wAily4bOZAa2rT1K4LlP8WV777xSAdsVjA&oe=6AFB250C"}, {"file_name": "07-tibet-0-2560x1440.png", "id": "3026886964326254", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619404_3026886970992920_3060880245232536331_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TFeyi7KhbkQ7kNvwHCG5FI&_nc_oc=AdqJ9B8C3z0_A_VpP3x28djlktQCLAsXzIFY92jKenHkuo2BJu9T_Lxu5BfzGmFbatg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg_LnE1UX8gS_N6W8JeuvDjuGJO5f_mtZuHNyWaUozcQ&oe=6AFB1DF4"}, {"file_name": "04-shanghai-3-2560x1440.png", "id": "3209997509360312", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628456_3209997512693645_375316043926808280_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AVi9RPL31MQ7kNvwE_fdsh&_nc_oc=Adp--QfBRF-H9UBB1Qr9-RVLmbGsw5gf45uL2Uhc09CM2NulRLYjj7Mc7JtY-r1OXPM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNdDzS86m8LWn-7BborW0y091tWvSKP-ZKbhGOgf0CbQ&oe=6AFB43A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1908997630483792", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628875_1908997637150458_6618120575747851613_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY5Du0oWtCcQ7kNvwFOcMvn&_nc_oc=AdrNiC6uhJc7Lx3Xf44z1UuTTxwsbSJ_BQBUPgDCiMGQ8VQEH_m23XLCqLiMEYCwtHg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTBRjfF15HbHH-nKe8wv5yZqHE5qpMV9OGGcTKx_zZDg&oe=6AFB3D1A"}, "display_name": "Trip to China", "keywords": ["China", "travel", "panorama", "culture", "sightseeing"], "long_description": "Trip to China takes you to the places people dream of seeing, in full 360\u00b0 photographs you can look around in.\n\n57 journeys, 680 stops. Walk the Great Wall at Badaling as the sun goes down, cross the courtyards of the Forbidden City, look up at the Potala Palace in Lhasa, drift past the karst peaks of Guilin, stand under the three sacred snow mountains of Yading, and watch the Bund light up at night. Journeys cover cities, mountains, temples, grottoes, gardens, deserts and coasts, from Harbin's ice festival to the islands of Hainan.\n\nA guide at every stop. Each stop has spoken narration in English or Chinese. Labels float over mountains, buildings and rivers so you always know what you are looking at, and info cards tell the story behind them: the history, the people, the numbers.\n\nTravel your way. Follow a journey stop by stop, let it play on its own, or jump straight to the place you want from the map of China on the home screen. Change between day and night where a place has both, listen to the sounds of the place, and take photos to keep.\n\nMade for comfort. The view never moves by itself: no flying, no automatic turning, no camera motion. Moving between stops is a short fade to black. You can sit or stand, and use controllers or your hands.\n\nDownload what you want. Each journey is a separate download, so you only keep the places you want to visit. Download a journey from its page; delete it any time to free up space.\n\nLanguages: English and Simplified Chinese.", "short_description": "Visit China in 360\u00b0. 57 guided journeys and 680 stops: the Great Wall at sunset, the Forbidden City, the Potala Palace, the karst peaks of Guilin, the snow mountains of Yading, the Bund at night and more. At every stop a narrator tells you where you are, and labels and info cards explain what you see. Sit back, look around, and travel at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://triptochina.no996.fun/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Trip to China team", "support_website_url": "https://triptochina.no996.fun/support/", "website_url": "https://triptochina.no996.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323889180818727"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1818648345997808"}]
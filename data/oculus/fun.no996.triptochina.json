trailer_thumbnail": {"file_name": "cover-landscape-2560x1440-land.png", "id": "1515251783779046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620403_1515251787112379_3750962579419616058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd2mjhN-Uc4Q7kNvwHhWLhJ&_nc_oc=Adplu7XPvOGnQlRYVGHZRSLi5XKLxWQTlfE2eGwkqS7Z_emmDK_O3tSFs-hnjxuBTcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMfh4wS2TnNUGUt9s8mbhmHNyaF4pC5kyQ0saFg1Eq3A&oe=6B01DEA6"}, "display_name": "TriptoChina", "keywords": ["China", "travel", "panorama", "culture", "sightseeing"], "long_description": "TriptoChina takes you to the places people dream of seeing, in full 360\u00b0 photographs you can look around in.\n\n# 57 journeys, 680 stops\nFrom the Great Wall at Badaling to the Bund at night, from the Potala Palace to the karst peaks of Guilin and the snow mountains of Yading. Cities, mountains, temples, grottoes, gardens, deserts and coasts.\n\n# A guide at every stop\nEvery stop has spoken narration in English, Chinese, French or German. Labels float over mountains, buildings and rivers, and info cards tell the story behind them: the history, the people, the numbers.\n{4364068033842402}\n{29611067095153248}\n{2517861362041175}\n{1154278736938699}\n# Travel your way\nFollow a journey stop by stop, let it play on its own, or jump to any place from the map of China. Switch between day and night, listen to the sounds of the place, and take photos to keep.\n{1456130259992983}\n# Made for comfort\nThe view never moves by itself: no flying, no automatic turning. Moving between stops is a short fade to black. Sit or stand, with controllers or hands.\n{1681252560013188}\n# Download what you want\nEach journey is a separate download, so you only keep the places you want. Delete one any time to free up space.\n{1650452210162985}\nLanguages: English, Simplified Chinese, French and German.\n{2659183637863276}\n{2978263365840353}\n{1842646363742224}", "short_description": "Visit China in 360\u00b0. 57 guided journeys and 680 stops: the Great Wall at sunset, the Forbidden City, the Potala Palace, the karst peaks of Guilin, the snow mountains of Yading, the Bund at night and more. At every stop a narrator tells you where you are, and labels and info cards explain what you see. Sit back, look around, and travel at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://triptochina.no996.fun/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Trip to China team", "support_website_url": "https://triptochina.no996.fun/support/", "website_url": "https://triptochina.no996.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1384529734754671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619374_2332355627589001_332981287662948293_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jZfb_qzvOgQ7kNvwGflOAS&_nc_oc=Adq89K84L3rj2ExYxfYBMv6wURBoTMfjtBPaytJcycqk-fzbaIealMxn72YS_sGgFhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgALMDa4sV9z5XlyJ-E4-JLIZrjctdaTNLj7qN-h33NQ&oe=6B01EC09"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TriptoChina", "pla
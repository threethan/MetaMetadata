lS98Q_PHq7KnHBDCjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQLN2Dqlw2qq9CzKVPcxLhywklOwlQekQla1lyfRLUdw&oe=6B0DD097"}, {"file_name": "04-shanghai-3-2560x1440.png", "id": "1107991298887283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623551_1107991302220616_1486716563538925584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPJYjnOIc1YQ7kNvwFcJ8Pp&_nc_oc=AdrZTeuZCEyFBI0FgMajxRFWbm17kqAqP4TGIzOd7tOVWuHsgdeeSd-6MGERjmE4GlU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKM1xcFTRyVQCwvh7tmfiDQSX0iDpxaC1qX8lnTl0whA&oe=6B0DC226"}, {"file_name": "07-tibet-0-2560x1440.png", "id": "1805461607366490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622184_1805461610699823_6974658554110162862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXYkposxldMQ7kNvwHc8yTP&_nc_oc=AdrdESFVBihdvo_pmJRYNCWaE5hkADt4Pa-VL9opsxztc_csaOLMibwDMhx__VutMaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5oXRuyJMV1Iv-CINinFTQPMn1rEUEJ4FsnIfVASEKGw&oe=6B0DD21C"}, {"file_name": "08-macau-7-2560x1440.png", "id": "2035864220410866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_2035864223744199_6414949804779661645_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW0V49aVJZ4Q7kNvwFyMqc_&_nc_oc=AdqlB6XwKdik8r2_ashiQ6Z6ncOG4fkVJUxTU2Jz9BsZkueH_oExyEh63tTMvemF4uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyptbRlKXIWslFObHf42UJXda66y2D6jlocQFyqNtWsA&oe=6B0DA369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440-ridge.png", "id": "4399367250375280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842256_4399367253708613_6963876773481374096_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTb1I2cs7kcQ7kNvwGBWL-U&_nc_oc=AdrvFGncNsAFP147mn_W_8WAvOpUKUZZBWXfKAAQ2vpJWD_ZBjfUYfDb8HPLE-MpVss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQeGBl_2iVkBvscopzVxI13iTCm09LBLnZxH8TQ1Wue-w&oe=6B0DCA2B"}, "display_name": "TriptoChina", "keywords": ["China", "travel", "panorama", "culture", "sightseeing"], "long_description": "TriptoChina takes you to the places people dream of seeing, in full 360\u00b0 photographs you can look around in.\n\n# 57 journeys, 680 stops\nFrom the Great Wall at Badaling to the Bund at night, from the Potala Palace to the karst peaks of Guilin and the snow mountains of Yading. Cities, mountains, temples, grottoes, gardens, deserts and coasts.\n\n# A guide at every stop\nEvery stop has spoken narration in English, Chinese, French or German. Labels float over mountains, buildings and rivers, and info cards tell the story behind them: the history, the people, the numbers.\n{4364068033842402}\n{29611067095153248}\n{2517861362041175}\n{1154278736938699}\n# Travel your way\nFollow a journey stop by stop, let it play on its own, or jump to any place from the map of China. Switch between day and night, listen to the sounds of the place, and take photos to keep.\n{1456130259992983}\n# Made for comfort\nThe view never moves by itself: no flying, no automatic turning. Moving between stops is a short fade to black. Sit or stand, with controllers or hands.\n{1681252560013188}\n# Download what you want\nEach journey is a separate download, so you only keep the places you want. Delete one any time to free up space.\n{1650452210162985}\nLanguages: English, Simplified Chinese, French and German.\n{2659183637863276}\n{2978263365840353}\n{1842646363742224}", "short_description": "Visit China in 360\u00b0. 57 guided journeys and 680 stops: the Great Wall at sunset, the Forbidden City, the Potala Palace, the karst peaks of Guilin, the snow mountains of Yading, the Bund at night and more. At every stop a narrator tells you where you are, and labels and info cards explain what you see. Sit back, look around, and travel at your own pace."}]}, "develop
oedZ8VHwVYE_mJnpXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTwRNyxES7dtTJxuy8ph2YE2kTW0Qtc5NzDAzLt-jG6kQ&oe=6B0C7F17"}, {"file_name": "04-shanghai-3-2560x1440.png", "id": "1107991298887283", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623551_1107991302220616_1486716563538925584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbQPljymPyUQ7kNvwHbP0DW&_nc_oc=Adp7llhhC4OX0VxIpSxyWbAREWgFu1zzslNh7vySA0RktI1HyZa1a_StVPwA4b3N56w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYuOg4NraKliMnrmxh0dhko6smGpuCXyH8bXU2JUOThA&oe=6B0C70A6"}, {"file_name": "07-tibet-0-2560x1440.png", "id": "1805461607366490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622184_1805461610699823_6974658554110162862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXYkposxldMQ7kNvwHVplvG&_nc_oc=AdoPWnFcUIu18r55lVjjvw0XHXDRrJgPq28EPqozcZHnx52KuBxUTDBLpUXPAS90Vo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNi2vNphCSa9eZx49MIdrlvkhUgOE1lzTpo-EuspoFTg&oe=6B0C809C"}, {"file_name": "08-macau-7-2560x1440.png", "id": "2035864220410866", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_2035864223744199_6414949804779661645_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZnOzyNDV9UQ7kNvwEX9V2A&_nc_oc=AdoUAtXvNXwIWvHRUHmbcpcfe7O5fvCsD12hNqML1djAPnl7cNTbsG77GAkodvoa0uA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTv6mvAsjc9s4M9wHoCVhzQ6brP6_h2NuQ7pfWi31ajVg&oe=6B0C51E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440-ridge.png", "id": "4399367250375280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842256_4399367253708613_6963876773481374096_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTb1I2cs7kcQ7kNvwGpRQHn&_nc_oc=Adrhga2zE3quD6weR4ugR2m_JcqJByKJNbK-x3XMEHZrAG6WUysgQJlwVQDRSPnfr1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_8fih2CCxBacpQ_qilwF50qm-g4b4d8HF-zCLYAx41Q&oe=6B0C78AB"}, "display_name": "TriptoChina", "keywords": ["China", "travel", "panorama", "culture", "sightseeing"], "long_description": "TriptoChina takes you to the places people dream of seeing, in full 360\u00b0 photographs you can look around in.\n\n# 57 journeys, 680 stops\nFrom the Great Wall at Badaling to the Bund at night, from the Potala Palace to the karst peaks of Guilin and the snow mountains of Yading. Cities, mountains, temples, grottoes, gardens, deserts and coasts.\n\n# A guide at every stop\nEvery stop has spoken narration in English, Chinese, French or German. Labels float over mountains, buildings and rivers, and info cards tell the story behind them: the history, the people, the numbers.\n{4364068033842402}\n{29611067095153248}\n{2517861362041175}\n{1154278736938699}\n# Travel your way\nFollow a journey stop by stop, let it play on its own, or jump to any place from the map of China. Switch between day and night, listen to the sounds of the place, and take photos to keep.\n{1456130259992983}\n# Made for comfort\nThe view never moves by itself: no flying, no automatic turning. Moving between stops is a short fade to black. Sit or stand, with controllers or hands.\n{1681252560013188}\n# Download what you want\nEach journey is a separate download, so you only keep the places you want. Delete one any time to free up space.\n{1650452210162985}\nLanguages: English, Simplified Chinese, French and German.\n{2659183637863276}\n{2978263365840353}\n{1842646363742224}", "short_description": "Visit China in 360\u00b0. 57 guided journeys and 680 stops: the Great Wall at sunset, the Forbidden City, the Potala Palace, the karst peaks of Guilin, the snow mountains of Yading, the Bund at night and more. At every stop a narrator tells you where you are, and labels and info cards explain what you see. Sit back, look around, and travel at your own pace."}]}, "develop
ontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035346_1021366616238758_325124193092108605_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhDn1P3NeOYQ7kNvwE364DB&_nc_oc=Adpgnawd6GMg71uj_jK8PA4jTHaGXqkAPr1KVSnMubQGZndvo9Qh_l3ly2-UqfbQsnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcEBXz_8_FW-VGYHyypX1wafitr65Z8_DENrIBcacgJw&oe=6AF0847E"}, {"file_name": "SampleScene_Custom..._14.06.2024_00-59-00.png", "id": "8384651161562260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569484_8384651168228926_9020336027859524245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ITLhJUS5nYQ7kNvwHv-4ST&_nc_oc=AdqrMXzH1v7voNEatDh54gg8ZZntPsm6Q_sfQL1d6uAJBv14qV-qxrUVPg3xx96AXAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUfhLNOUAPkbLE-xUTvHserHlb5cqDfgpQj8C-ZRJ90w&oe=6AF084FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Happy", "keywords": [], "long_description": "Monke Happy is an awesome Gorilla Tag fangame that offers a lot of exciting gamemodes and maps for you to release your true monke.\n\nCustomize your gameplay with an array of free mods. Platforms, fly, and more!\n\nTest your speed in the Rising Lava mode. Lava rises and slowly engulfs the map.\n\nBreak the laws of physics in the Zero Gravity mode. Have fun as you float through the air.\n\nPersonalize your monke with a few items available in the in-game shop.\n\nFeel the spook in the Horror mode, with a creepy environment and a scary monster await.\n", "short_description": "Monke Happy is a Gorilla Tag fangame with FREE MODS, Rising Lava, Zero Gravity, Shop, and HORROR!"}]}, "developer_name": "duncemonkey", "developer_privacy_policy_url": "https://sites.google.com/view/monkehappy/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "duncemonkey", "support_website_url": null, "website_url": "https://sites.google.com/view/monkehappy/home", "category": null, "comfort_rating": null, "comfort_tags": [], "contex
5/39035346_1021366616238758_325124193092108605_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfizxh9bzv0Q7kNvwF0pqqc&_nc_oc=AdkoFG82ty7nxoKyAT2XdTipiYqOObefTh3dWt6yOORvQ3gQSjy0y43f9CjYgVyesAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxydxG_x4wZKhI0lERHGFz2NEYsnk5n8R73cQJbpUqXA&oe=69B9627E"}, {"file_name": "SampleScene_Custom..._14.06.2024_00-59-00.png", "id": "8384651161562260", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569484_8384651168228926_9020336027859524245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKR_qyz8KBMQ7kNvwEJvnD6&_nc_oc=AdlDxe-PjrMVCgtF8cwv8TsaheH4nHSI9k0p1WPP2DwNzet5S53q3qaq4yphTVv_-mY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfynS4HphN7_1UBBZ3nGp0Bcp7BovmdfkXLKOT8DFW0-cw&oe=69B962FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Happy", "keywords": [], "long_description": "Monke Happy is an awesome Gorilla Tag fangame that offers a lot of exciting gamemodes and maps for you to release your true monke.\n\nCustomize your gameplay with an array of free mods. Platforms, fly, and more!\n\nTest your speed in the Rising Lava mode. Lava rises and slowly engulfs the map.\n\nBreak the laws of physics in the Zero Gravity mode. Have fun as you float through the air.\n\nPersonalize your monke with a few items available in the in-game shop.\n\nFeel the spook in the Horror mode, with a creepy environment and a scary monster await.\n", "short_description": "Monke Happy is a Gorilla Tag fangame with FREE MODS, Rising Lava, Zero Gravity, Shop, and HORROR!"}]}, "developer_name": "duncemonkey", "developer_privacy_policy_url": "https://sites.google.com/view/monkehappy/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "duncemonkey", "support_website_url": null, "website_url": "https://sites.google.com/view/monkehappy/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
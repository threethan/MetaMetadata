5/39035346_1021366616238758_325124193092108605_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-wtkjnrCokQ7kNvwETKc6X&_nc_oc=AdlC_p3dNLoSVVrD4HukoI0WlV7T6dx4En7iBUdcxtp1OulPl6EYBTnLmBJLH7_ss-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyThHmRVqKrD2T4TKjbwfL87PI0d-MK500baPp1fbQRZA&oe=69AED67E"}, {"file_name": "SampleScene_Custom..._14.06.2024_00-59-00.png", "id": "8384651161562260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569484_8384651168228926_9020336027859524245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viYRK7BYH9sQ7kNvwFZ0e3U&_nc_oc=AdmflPbifiprzgUxsMVoURPSnRJDMdmdiNBTEhH1q7iA9yrSn_wLtG2iOypSIqxOy54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkjPkTRhNzwyIG4EuxukK_E4Idb8SlaxWIjTi-TUeKRg&oe=69AED6FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Happy", "keywords": [], "long_description": "Monke Happy is an awesome Gorilla Tag fangame that offers a lot of exciting gamemodes and maps for you to release your true monke.\n\nCustomize your gameplay with an array of free mods. Platforms, fly, and more!\n\nTest your speed in the Rising Lava mode. Lava rises and slowly engulfs the map.\n\nBreak the laws of physics in the Zero Gravity mode. Have fun as you float through the air.\n\nPersonalize your monke with a few items available in the in-game shop.\n\nFeel the spook in the Horror mode, with a creepy environment and a scary monster await.\n", "short_description": "Monke Happy is a Gorilla Tag fangame with FREE MODS, Rising Lava, Zero Gravity, Shop, and HORROR!"}]}, "developer_name": "duncemonkey", "developer_privacy_policy_url": "https://sites.google.com/view/monkehappy/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "duncemonkey", "support_website_url": null, "website_url": "https://sites.google.com/view/monkehappy/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
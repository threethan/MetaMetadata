ontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035346_1021366616238758_325124193092108605_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08oHyyIzVVIQ7kNvwFcSu4w&_nc_oc=Adqhb-L-geolWbkL1WquGIGqrwpoIkw7Ti8spc1FpORHwiJ5RoblSEeH1u77vDN6pr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYh-wK9-23zytZUggnbSGJUz6269LgIE2aUqIE2CVOXg&oe=6A8317FE"}, {"file_name": "SampleScene_Custom..._14.06.2024_00-59-00.png", "id": "8384651161562260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569484_8384651168228926_9020336027859524245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySAIlZw-pJMQ7kNvwEKJ7xJ&_nc_oc=Adq6B2xsdUuiRVc5oLtGkotUTbo44iy4WIywba18tvI3ZdLToPgx8uAxU8IerkMrGj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2YwXI9uyzZ0GsBkiLPD5vR6_cXkuEIOzpM5bF9AhMmw&oe=6A83187E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Happy", "keywords": [], "long_description": "Monke Happy is an awesome Gorilla Tag fangame that offers a lot of exciting gamemodes and maps for you to release your true monke.\n\nCustomize your gameplay with an array of free mods. Platforms, fly, and more!\n\nTest your speed in the Rising Lava mode. Lava rises and slowly engulfs the map.\n\nBreak the laws of physics in the Zero Gravity mode. Have fun as you float through the air.\n\nPersonalize your monke with a few items available in the in-game shop.\n\nFeel the spook in the Horror mode, with a creepy environment and a scary monster await.\n", "short_description": "Monke Happy is a Gorilla Tag fangame with FREE MODS, Rising Lava, Zero Gravity, Shop, and HORROR!"}]}, "developer_name": "duncemonkey", "developer_privacy_policy_url": "https://sites.google.com/view/monkehappy/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "duncemonkey", "support_website_url": null, "website_url": "https://sites.google.com/view/monkehappy/home", "category": null, "comfort_rating": null, "comfort_tags": [], "contex
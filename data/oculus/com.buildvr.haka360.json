logy to give the viewer the feeling of being on the field with the All Blacks and in the midst of the powerful M\u0101ori ritual.\n\nCheck out the bonus content and learn more about the haka, its history and what it means to the All Blacks.\n\nFollow @AIGRugby on Twitter and Instagram for latest news and join the conversation with the hashtag #Haka360.\n\nHaka 360\u00b0 \u00a9American International Group, Inc. All rights reserved.", "short_description": "The Haka 360\u02da Experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aig.com/privacy_3171_448852.html", "developer_terms_of_service_url": "http://www.haka360.com/terms", "publisher_name": "American International Group, Inc.", "support_website_url": null, "website_url": "http://www.haka360.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SPORTS", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "655941099159157"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "813913132046615", "version": "1.5"}, "id": "443948419147387", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1036229976435667", "is_concept": false, "latest_released_binary": {"__typename": "Andro
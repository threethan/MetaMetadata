925_2438537217155740066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-fgzfwpj_4Q7kNvwGnccMP&_nc_oc=Adl5i0txwY4fXM__XU8_GnGYT4XiQv63HrWShf6AykEnFA6KlGyl7wp9f1dCYc8z8kM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsEshx1k_leTQKFh_TEWYR1Lkb4ic108F1SRp2ZBDKUBg&oe=699C488E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "2814768052068158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031334_2814768055401491_779528788551400178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB7CASJXJ54Q7kNvwFm1XPQ&_nc_oc=AdkA6yLdaXOW9qqWyJLKXnizYxQST61-FDBzJvfTn-nwafeRjgHedUahGzwb_E3KcXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsn-lKg8eY05ml81C7G2omQ0W96FJ20GBH0HX7EXdsfxA&oe=699C6032"}, "display_name": "Virtual Goalie", "keywords": [], "long_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves.", "short_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vg-eula", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "conte
925_2438537217155740066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-fgzfwpj_4Q7kNvwHTNLVb&_nc_oc=AdmCyG0yhYK6KgYQkmy9cQqURyykndRdgNEDafvgt4N5gZZ18uBgZKLC5D1rQ37oizs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRjdxxNo-REDhESSUzFQVygu4UzMyJ7GHtytixoz2AzA&oe=6999A58E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "2814768052068158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031334_2814768055401491_779528788551400178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB7CASJXJ54Q7kNvwHt8id9&_nc_oc=AdmGW9zqEVF_1snGR9kDLWhOBDfB8wmWeHLmKQ1iu-qkNsUWAGeUfBDcLktFQasLUN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPpOvaTtSk07C5Z_YaXTciWOSP9A2_zZApqrN8lWOHyg&oe=6999BD32"}, "display_name": "Virtual Goalie", "keywords": [], "long_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves.", "short_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vg-eula", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "conte
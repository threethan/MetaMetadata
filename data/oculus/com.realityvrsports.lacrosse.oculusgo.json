925_2438537217155740066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIkxbqwerlkQ7kNvwGyOtLw&_nc_oc=AdkMJV2Qj_u39SabKYv8EYk1xGS5qtbrkfTl80GRlY3VA6qodG2hFrG6InJkWX9_kCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFKYeF-HBqFOtXjzjbI3y_ZvKImWu2KzXcLOpD5ZCiaA&oe=69A03D0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "2814768052068158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031334_2814768055401491_779528788551400178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z90GZRW7uJUQ7kNvwF62jll&_nc_oc=AdkDFMQ2L-kS4D0HWIuv9w-JQoX2N_ck3gnXsof5QFqf85gDq4bvOUc0sB2arRMeb2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI23UKZ0lFThv9BUzpRBF38sZhoZT9Bl4VOOnodIoVGQ&oe=69A054B2"}, "display_name": "Virtual Goalie", "keywords": [], "long_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves.", "short_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vg-eula", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "conte
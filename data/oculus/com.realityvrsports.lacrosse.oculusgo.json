925_2438537217155740066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D50nAfOwn7AQ7kNvwHGc72Y&_nc_oc=AdlWx93PpzA2TR-7b2YTxEFbhX2wpp0dKScvnqhEdPk9W36OBK3eN7LF5YvGmBlBiTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftVqzP9XGq3Vd8tee31ARMPMBrMOkHml3lj7bAWGvS1Cw&oe=6998540E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "2814768052068158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031334_2814768055401491_779528788551400178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwAa3-50DYUQ7kNvwEpfzXC&_nc_oc=AdnxTutPijWPDA7NvAplUSc0JDeyggweQuD6_l_Z2Enh1xPkTe6Y3htdX8Ib6i0YARc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsODn5CdbbsZA-3J4F_i6vloQ651Bk6BPX1ms83kJMuHg&oe=69986BB2"}, "display_name": "Virtual Goalie", "keywords": [], "long_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves.", "short_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vg-eula", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "conte
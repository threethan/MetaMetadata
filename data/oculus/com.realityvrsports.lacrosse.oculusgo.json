031334_2814768055401491_779528788551400178_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZienPuDuSDsQ7kNvwHHBBmM&_nc_oc=AdqcM_HByrOmMMBYYpfv2QjmU-oZQozdOUOvHAvBj11hSfbv_rym_b3Fs4z7fxUSwmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjDj7o-9kRcxwJwxmMH7S87nurN1jT1j1U1FZh6ReGvQ&oe=6B09C7F2"}, "display_name": "Virtual Goalie", "keywords": [], "long_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves.", "short_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vg-eula", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_
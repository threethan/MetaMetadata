925_2438537217155740066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIkxbqwerlkQ7kNvwF6Xd2P&_nc_oc=AdlcMdIZhzRh--fCgIfo4emFInWWlhvAvVaEPMksGhh7RbTcJX1rvbfvTT1l-pkZRcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv3AO3yqE86NpZ5OXceWYoIBLt0Erxsgzccf0wWntiv3Q&oe=699EEB8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "2814768052068158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031334_2814768055401491_779528788551400178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z90GZRW7uJUQ7kNvwH3SUtl&_nc_oc=AdnjdsVR1UFZC0n1R9mTNuC9EY5Q-r_ZXnSbdxCRMPWM7dg6ddTHFjHzyutIKWrW_M8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuIs0FuhmUz7mQFJGMWysDubTT0Qp5HfCtIBYxbiHclCg&oe=699F0332"}, "display_name": "Virtual Goalie", "keywords": [], "long_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves.", "short_description": "Lacrosse goalies need to see and react to shots constantly. Virtual Goalie drops you into an immersive virtual field of play.  Drills give you the opportunity to work on time and room shots, alley dodges, close fakes, pass-to-shoot scenarios and offense vs. defense simulations. Data is power. We track everything and our mobile app gives you feedback on shots and saves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vg-eula", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "conte
E2CcGZTg&oe=6B031AEC"}, {"file_name": "Arterial Line Placement_banner.00_00_14_06.Still004.png", "id": "1693932258628042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818885_1693932261961375_7400630987398944220_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCO7NRGTyBQQ7kNvwFjAVhA&_nc_oc=AdpqiuPoi72Svi9anGI_aGGbYhSaiDdzAbFlkJ5Q3peIb7-L_WKVPnkyNeGPDh94Nvo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn7aBURxgIAJP-Uxr3_ReOVg-ypjKzx9wBDJXpylRAwg&oe=6B030245"}, {"file_name": "Arterial Line Placement_banner.00_00_10_18.Still003 (1).png", "id": "938665181894060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_938665185227393_2002801451300649644_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFAVL3IVRVUQ7kNvwEONnA_&_nc_oc=AdrZt1it51Es4JS47G9Wz1HFLeoZxMdz7ed4ViHLS9DeimZHONPJ8Mju24aEn7e5PRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzv34_9ympQzi6e_1q8o2rtOiY01bMFPMF-2XNaJvNbg&oe=6B030CF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Line Placement", "keywords": ["Medvr", "VR", "Arterial", "Line", "Placement"], "long_description": "Arterial Line Placement is an immersive VR training experience designed to help medical students and healthcare professionals develop confidence and precision in arterial catheterization.\n\nThrough realistic, step-by-step simulation, users can practice identifying anatomical landmarks, performing needle insertion, and managing the procedure safely. The application provides an interactive learning environment where mistakes can be made without real-world consequences, enabling users to refine their technique and improve decision-making skills.\n\nIdeal for training, revision, or skill reinforcement, this simulation combines visual realism with guided learning to enhance procedural understanding and hands-on readiness in clinical settings.", "short_description": "Mast
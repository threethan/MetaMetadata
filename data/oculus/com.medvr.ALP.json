1IDR6N4w&oe=6B070F6C"}, {"file_name": "Arterial Line Placement_banner.00_00_14_06.Still004.png", "id": "1693932258628042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_1693932261961375_7400630987398944220_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIGjoDSrMxUQ7kNvwGbk0wx&_nc_oc=AdofJYVSf47w3TGsb8B4jP3ORFKhAkuzyN0VoIUcB-UWEOjXvrF49hcQOjvg0LPqNsA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzb9PGlhHZVNsI1vUt9s9eWFOO6Hmp6MzbSB0se2GjYw&oe=6B06F6C5"}, {"file_name": "Arterial Line Placement_banner.00_00_10_18.Still003 (1).png", "id": "938665181894060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_938665185227393_2002801451300649644_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQiJxVVc-zkQ7kNvwEOPN9h&_nc_oc=Adpvs1OCjMTjRelVGpaD9QUWRXpsa4v_W-vrUc3vCRTz6q4Tcqkc8Nxlqxlme1fPB8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSfXkZ0B7BzRAslW8pkwrt8pxy4WawHuL7Cibnai6r9w&oe=6B070170"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Line Placement", "keywords": ["Medvr", "VR", "Arterial", "Line", "Placement"], "long_description": "Arterial Line Placement is an immersive VR training experience designed to help medical students and healthcare professionals develop confidence and precision in arterial catheterization.\n\nThrough realistic, step-by-step simulation, users can practice identifying anatomical landmarks, performing needle insertion, and managing the procedure safely. The application provides an interactive learning environment where mistakes can be made without real-world consequences, enabling users to refine their technique and improve decision-making skills.\n\nIdeal for training, revision, or skill reinforcement, this simulation combines visual realism with guided learning to enhance procedural understanding and hands-on readiness in clinical settings.", "short_description": "Mast
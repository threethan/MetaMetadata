bOTqyllw&oe=6AFC836C"}, {"file_name": "Arterial Line Placement_banner.00_00_14_06.Still004.png", "id": "1693932258628042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1693932261961375_7400630987398944220_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q7tGYCI2EIQ7kNvwH_G-JY&_nc_oc=AdrZqNa-dz1pYqxabu7y5VYMiiKbxp6h9YxLcJ1MMTAVRq1sSuVmHctuGqAsZnKmPg8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJULV4teM7lP8wmFMj6P6hJ6X10zc-unNyrsfARSsZ0g&oe=6AFC6AC5"}, {"file_name": "Arterial Line Placement_banner.00_00_10_18.Still003 (1).png", "id": "938665181894060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_938665185227393_2002801451300649644_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb6_gxSJ1rAQ7kNvwHLQMhN&_nc_oc=Adpsd1E3i8eSkILFi9H4EmdYicNb-83s2Rg8Ic4kWrmDhdGOoXg0PNaIV3JD44VLz-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSvfYfffyFfH9OhsUwDBt8MJxhKuFhKGtzulT8wu3txA&oe=6AFC7570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Line Placement", "keywords": ["Medvr", "VR", "Arterial", "Line", "Placement"], "long_description": "Arterial Line Placement is an immersive VR training experience designed to help medical students and healthcare professionals develop confidence and precision in arterial catheterization.\n\nThrough realistic, step-by-step simulation, users can practice identifying anatomical landmarks, performing needle insertion, and managing the procedure safely. The application provides an interactive learning environment where mistakes can be made without real-world consequences, enabling users to refine their technique and improve decision-making skills.\n\nIdeal for training, revision, or skill reinforcement, this simulation combines visual realism with guided learning to enhance procedural understanding and hands-on readiness in clinical settings.", "short_description": "Mast
X9D-L4Hkw-oXTph5bwSgEd2fm7sEOJgmRSdYZscqg4M_N7Jk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YDdWtfamG6Tp-Ukz2OBqX_UptE2dNOlrVXysYdDTIyQ&oe=6A22DCAC"}, {"file_name": "Screenshot4FIX.png", "id": "1015900723805691", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391921_1015900727139024_106233498368230410_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEnDYlxVe0YQ7kNvwF_PUJj&_nc_oc=AdqqYfZlZAhgZe_5oYgNPl4GNoPswpNpHsqFhfimTc6skxWxkpSoN27AgzicqVdrPzY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qaeWIf3YBElK7dN6xKUbYc-Nb1z3ulduZAN4Z9k1yIw&oe=6A22CAFD"}, {"file_name": "Screenshot2FIX.png", "id": "1747262522496995", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391875_1747262525830328_4862247368230639872_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XSzBz6cKcQQ7kNvwF9gMG-&_nc_oc=AdotRvLINCEDeJSIuqtU8K6PMlOi6rRowNGT3h5sT0SHHHgwZXrD8r0sLx86fFDbsCg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cFsMByfm8O977lFj5G-h0xrU9oKkXxO4ETf5umD8fSg&oe=6A22C99D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenTag", "keywords": [], "long_description": "Step into a thrilling box puzzle game where you solve challenges through gorilla-inspired locomotion. In this unique experience, players navigate an intricate world of interconnected boxes not just with their minds, but with their arms! Mimicking the powerful and agile movements of a gorilla, you must swing, push, and climb using arm-powered controls to move through the puzzles.\n\nThe objective is to maneuver through various levels, tackling puzzles that require creative thinking and dynamic physical engagement. You might have to swing from one box to another, lift hidden panels, or rotate massive crates by bracing and pulling\u2014every motion immerses you deeper into the gorilla-like experience. As the puzzles grow in complexity, you'll master new techniques such as coordinated arm movements to unlock special mechanisms or timing your swings perfectly to traverse precarious obstacles.\n\nEach level boasts a distinctive theme, like dense jungle ruins where vines and ancient crates come alive or a futuristic metropolis where glowing neon boxes test your agility. The game\u2019s tactile mechanics and inventive puzzles keep players on their toes (or hands, in this case), offering a fresh and exhilarating way to solve problems. It's more than just a puzzle\u2014it's an adventure of strength, strategy, and swinging ingenuity. Ready to unleash your inner gorilla and tackle the challenge?\n\ninspired by gorilla tag and its locomotion systems.", "short_description": "Swing, climb, and push to solve puzzles in a unique box game with gorilla-like arm movement!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YkuKez9tDPLiXSZIzCtTpiRkFOs86Siu5Sf97QGnUlQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Infinite", "support_website_url": null, "website_url": "https://sites.google.com/view/talkingbenstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9379507298781932"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_bin
HAGM8arnyzPf6LH87sUBELmCn0QzyMN0-TzD9Kj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyHq_YazP8EsGsZXX36tDF9IzLjUFXOWm4iYbscZAgbA&oe=6AB3E1AC"}, {"file_name": "Screenshot4FIX.png", "id": "1015900723805691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391921_1015900727139024_106233498368230410_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boowYvRTQsoQ7kNvwEhVMxA&_nc_oc=AdrVmvxtf3kHIFwSxw1u6p_9r-RGsVcXTL9t3PD3r-I2aplR1Awt6fExlWdFlkXHkuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTMLZ60_x36vXZ3rt85hCObABSLOOqC8tuQSwSPZ3ooA&oe=6AB3CFFD"}, {"file_name": "Screenshot2FIX.png", "id": "1747262522496995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391875_1747262525830328_4862247368230639872_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5tLN77X_6EQ7kNvwHW96Yx&_nc_oc=AdrdOW9FyfO-V1wK2C3Npm1z8l_G5v87d9tIngP_gndiht_wMZQKR7riuqkHQe7Yzi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRKUSce5zkBcNFmxgTjnnBUKkqOjI8-Ok-O1VmeTaMtQ&oe=6AB3CE9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenTag", "keywords": [], "long_description": "Step into a thrilling box puzzle game where you solve challenges through gorilla-inspired locomotion. In this unique experience, players navigate an intricate world of interconnected boxes not just with their minds, but with their arms! Mimicking the powerful and agile movements of a gorilla, you must swing, push, and climb using arm-powered controls to move through the puzzles.\n\nThe objective is to maneuver through various levels, tackling puzzles that require creative thinking and dynamic physical engagement. You might have to swing from one box to another, lift hidden panels, or rotate massive crates by bracing and pulling\u2014every motion immerses you deeper into the gorilla-like experience. As the puzzles grow in complexity, you'll master new techniques such as coordinated arm movements to unlock special mechanisms or timing your swings perfectly to traverse precarious obstacles.\n\nEach level boasts a distinctive theme, like dense jungle ruins where vines and ancient crates come alive or a futuristic metropolis where glowing neon boxes test your agility. The game\u2019s tactile mechanics and inventive puzzles keep players on their toes (or hands, in this case), offering a fresh and exhilarating way to solve problems. It's more than just a puzzle\u2014it's an adventure of strength, strategy, and swinging ingenuity. Ready to unleash your inner gorilla and tackle the challenge?\n\ninspired by gorilla tag and its locomotion systems.", "short_description": "Swing, climb, and push to solve puzzles in a unique box game with gorilla-like arm movement!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YkuKez9tDPLiXSZIzCtTpiRkFOs86Siu5Sf97QGnUlQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Infinite", "support_website_url": null, "website_url": "https://sites.google.com/view/talkingbenstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9379507298781932"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__
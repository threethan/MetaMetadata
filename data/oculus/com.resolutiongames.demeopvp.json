_1254739848474987_5086793005295979524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeArOBoYtTcQ7kNvwEFQyUg&_nc_oc=AdpN5RZEO8Nr4PMqIyeDtx6joGEwb1yUNVl2btfEHB7Z2dVCxEXQ3rEgcH9R3Y0SzQA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYqJFRwC9lZCB-JwPfWLGXo-yJ-ynSJZyOmM3YT9hbWg&oe=6AEC9861"}, {"file_name": "Battles---Overview2.png", "id": "1210464476321351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1210464479654684_311058227055271208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So-x6KShBfwQ7kNvwE_g8aq&_nc_oc=Adr9L8wf_E9qgpAbJV5xY47PhkLXUBNDFKtuzxfN1uaHfxt6kvRWxQQS8yPIdr0KbpI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBRF-XDKQuzdGUym61ysmUBluiNSoJqj8IKfs_WEJWkg&oe=6AEC8F9F"}, {"file_name": "Battles---Place-units2.png", "id": "789704312284193", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031355_789704315617526_2792818596407696198_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34FE5nzIeKkQ7kNvwFagb_j&_nc_oc=Adp3UUM_zfypOGazgjmdeq0KPec9NAuXlfFUyrVsgI84sP8mqASXFzhIiO-p9XiC8IA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcfqP-JdKSguXsk-y5lhW6S7FCfUz4QC74oK74xC2wPg&oe=6AEC9F74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemeoBattles_Thumbnail.png", "id": "637664445068835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75557069_637664448402168_1933084965014661694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg_s69jkxeQQ7kNvwFZGYk8&_nc_oc=AdpPAcPXvaP0A-TOYdLDYJ6WGmk7lnyRMEXDYDgKMbsSU7QpWz5YRJ_uZo9dv-ljZ-0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWknooL1UwtDPOW3fUFWZAaRPl0uIO_fdYlCyD8fzrbQ&oe=6AECAEE5"}, "display_name": "Demeo Battles", "keywords": [], "long_description": "Welcome to the arena! Demeo Battles is a competitive turn-based strategy game for 1-4 players, featuring\u2026\n\n\u2022 Turn-based Tactics - Battle your opponents in dungeons, forests and more as you square off against your opponents in grid-based action combat\n\n\u2022 Monstrous Minions - Assemble an army of chaotic critters to fight alongside you \u2014 from rats and goblins to cave trolls to giant slimes, all with a mind of their own! \n\n\u2022 Teamwork FTW - Bring two champions to the battle in every match and leverage their synergies; control both heroes directly or partner up with another player to defeat competitors  cooperatively  \n\n\u2022 Classic Classes - Choose a champion that matches your favorite fantasy play style to unleash magic, melee mayhem and more\n\n\u2022 Bespoke Builds - Spend your coins wisely when you enter the arena to build a unique loadout in every game, choosing from a randomized selection of action cards and monsters\n\n\u2022 Speedy Strategy - Challenge yourself to battle after battle with average matches lasting just under 20 minutes  \n\nComing later this year, Demeo Battles is the next game for the Demeo Action Role Playing System. Wishlist today!\n", "short_description": "Demeo Battles is a competitive turn-based strategy game for 1-4 players. Choose your champion, assemble an army of monstrous minions, and team up with another champion in your quest for turn-based glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolution Games", "support_website_url": null, "website_url": "http://demeobattles.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
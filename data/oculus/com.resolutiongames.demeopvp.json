_1254739848474987_5086793005295979524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaC0gT7ZW-wQ7kNvwEYdgqX&_nc_oc=AdquUwQxpoQ5OehuwO7dRYLJTqnxPtwxUrgldgVo91vrirdznrcpj-i1vJMzGtlZ4R0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDcOf4ZF_YRqE6mOeCcV2MxG-N4rJUse8gj12Nm7T0WA&oe=6AA02161"}, {"file_name": "Battles---Overview2.png", "id": "1210464476321351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1210464479654684_311058227055271208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZukfeCrJ8a0Q7kNvwHG6B7r&_nc_oc=AdrkoG4nD_GahQoAiMf21MaJxPt8kpfREHbB3FHrodXITaXSVbGlXd_mlCnVpT0iC14&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITdTNIfxCNRhvx0vR0JrEHC0jyaJnHZRNdKwsr7oi14w&oe=6AA0189F"}, {"file_name": "Battles---Place-units2.png", "id": "789704312284193", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031355_789704315617526_2792818596407696198_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDpr_PrfoA8Q7kNvwG8Znfm&_nc_oc=Adr9RfRZ85A9CQwvr1KZd9NX4labe_57qJZCOcNEZoDckHrGpICIIXqQs9U4-4TCrIQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7ncadQTGWOJvb9dD7hz6r_KaApF2xioLaTliqFaONcg&oe=6AA02874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemeoBattles_Thumbnail.png", "id": "637664445068835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75557069_637664448402168_1933084965014661694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRw_DRyeqqgQ7kNvwFbNkrS&_nc_oc=AdqDKGnq3svI-w61JtFjqkKi5Tmk_v1y0mVgZujK0Et5Rxp17MkX6nNPeZIxpB00Tbo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7rAoJe9aTUXBD3vRfv1Hdthd0yEF1KyGNMxUFKSBdSw&oe=6A9FFFA5"}, "display_name": "Demeo Battles", "keywords": [], "long_description": "Welcome to the arena! Demeo Battles is a competitive turn-based strategy game for 1-4 players, featuring\u2026\n\n\u2022 Turn-based Tactics - Battle your opponents in dungeons, forests and more as you square off against your opponents in grid-based action combat\n\n\u2022 Monstrous Minions - Assemble an army of chaotic critters to fight alongside you \u2014 from rats and goblins to cave trolls to giant slimes, all with a mind of their own! \n\n\u2022 Teamwork FTW - Bring two champions to the battle in every match and leverage their synergies; control both heroes directly or partner up with another player to defeat competitors  cooperatively  \n\n\u2022 Classic Classes - Choose a champion that matches your favorite fantasy play style to unleash magic, melee mayhem and more\n\n\u2022 Bespoke Builds - Spend your coins wisely when you enter the arena to build a unique loadout in every game, choosing from a randomized selection of action cards and monsters\n\n\u2022 Speedy Strategy - Challenge yourself to battle after battle with average matches lasting just under 20 minutes  \n\nComing later this year, Demeo Battles is the next game for the Demeo Action Role Playing System. Wishlist today!\n", "short_description": "Demeo Battles is a competitive turn-based strategy game for 1-4 players. Choose your champion, assemble an army of monstrous minions, and team up with another champion in your quest for turn-based glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolution Games", "support_website_url": null, "website_url": "http://demeobattles.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
ohc=xGnoQ_xPbAYQ7kNvwHRJ4aI&_nc_oc=AdoiDx2m1DwaZHo-crYgkQ5TT-kd1ILv8Pncf0N0Ly5Jm6I2QK-Aabpq40psHHHsKwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQK7xS2iKbd8-A0n21IaWLP2BUULVWlIyPhtb5pPzr9xA&oe=6B0C78F7"}, {"file_name": "Battles---New-Card.png", "id": "1254739841808321", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982709_1254739848474987_5086793005295979524_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upkgVfy1Fl0Q7kNvwEpYg92&_nc_oc=Adpz2pfPCWNQAG7APbelilPwIpjccxlUz9s6nDKTCw7Gixt6fCXR1zHjPTMw4Q9bwgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTC_EnPpVVutZ_WU59z97eFPy1GSGEgNSTvJh8yiMyjtw&oe=6B0C74A1"}, {"file_name": "Battles---Overview2.png", "id": "1210464476321351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1210464479654684_311058227055271208_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWABi-keHYIQ7kNvwHKy_on&_nc_oc=AdpqJBJ-5dBFu2ND7Blhu5jwFlTUqIVuGfkwOn7mCpOg73xpSJigKBkI6m_onu5E3qw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQeC8YQhX2FHdaRJNza-NaiJPZ7L3o66jgNDOz1acYhZQ&oe=6B0C6BDF"}, {"file_name": "Battles---Place-units2.png", "id": "789704312284193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031355_789704315617526_2792818596407696198_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwQJV9UVlFYQ7kNvwHPU0Ku&_nc_oc=AdpoBshcH1ELW76aOzwcV-FWIiVIqKnmA_72UQ7nEzbIMd9HnP1T1P9D8k9k6IvPYcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXgqzuZEbLytWwFDeK5qfX-Z5FY9SagXBlxSQHhiilxA&oe=6B0C7BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemeoBattles_Thumbnail.png", "id": "637664445068835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75557069_637664448402168_1933084965014661694_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcXwFuepkb4Q7kNvwG7NPGA&_nc_oc=AdrzjAgYJ92xt8nXQRzrwxNK_KpYC3NQmjIjo6qcfbUo4b08_HYUMtDPpZwizgKVI7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnLi9kKcoEJnbLcf8DTeI_yKO_PPfqWSl4oMz0uGYpaw&oe=6B0C52E5"}, "display_name": "Demeo Battles", "keywords": [], "long_description": "Welcome to the arena! Demeo Battles is a competitive turn-based strategy game for 1-4 players, featuring\u2026\n\n\u2022 Turn-based Tactics - Battle your opponents in dungeons, forests and more as you square off against your opponents in grid-based action combat\n\n\u2022 Monstrous Minions - Assemble an army of chaotic critters to fight alongside you \u2014 from rats and goblins to cave trolls to giant slimes, all with a mind of their own! \n\n\u2022 Teamwork FTW - Bring two champions to the battle in every match and leverage their synergies; control both heroes directly or partner up with another player to defeat competitors  cooperatively  \n\n\u2022 Classic Classes - Choose a champion that matches your favorite fantasy play style to unleash magic, melee mayhem and more\n\n\u2022 Bespoke Builds - Spend your coins wisely when you enter the arena to build a unique loadout in every game, choosing from a randomized selection of action cards and monsters\n\n\u2022 Speedy Strategy - Challenge yourself to battle after battle with average matches lasting just under 20 minutes  \n\nComing later this year, Demeo Battles is the next game for the Demeo Action Role Playing System. Wishlist today!\n", "short_description": "Demeo Battles is a competitive turn-based strategy game for 1-4 players. Choose your champion, assemble an army of monstrous minions, and team up with another champion in your quest for turn-based glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolution Games", "support_website_url": null, "website_url": "http://demeobattles.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "
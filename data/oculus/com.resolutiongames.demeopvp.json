name": "Battles---Overview2.png", "id": "1210464476321351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1210464479654684_311058227055271208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvI4WckmoOQQ7kNvwHkFbKv&_nc_oc=Adnk5-IYJx3hL-YGf3Ek2lW0NmzR3PQ5jQDiGpceK7yRZ7P5WMqcw9l-J2VP0yVteaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMeHgCJSRaykfqbI-Sa8NmKoN9jW6caUaLYp_-EiKunQ&oe=69A0559F"}, {"file_name": "Battles---Place-units2.png", "id": "789704312284193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_789704315617526_2792818596407696198_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrCmBrUTxVQQ7kNvwHAmqvH&_nc_oc=AdmW_elmDh7MAW5bofx_0ZZNtqdDXUcvYfZPtZ63fHDKL-WPBYwKrWSAXAAow-eTRF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpMjWnwbv1nWPX3ihLXKgCKeMwCnZg7_zAgkOMrKGc6Q&oe=69A02D34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemeoBattles_Thumbnail.png", "id": "637664445068835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75557069_637664448402168_1933084965014661694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoKG1dxj5hcQ7kNvwEQHqsW&_nc_oc=Adk12Kpeymg1gJcglPa5rvaqxa0JjF3CySK4KrlJHYK44pf_zwzxaOixjgQrQ6jHU2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsbUjYhMKqTWHjf1mGFn-J7zPnpFRtKg6h9iiKJ_osICw&oe=69A03CA5"}, "display_name": "Demeo Battles", "keywords": [], "long_description": "Welcome to the arena! Demeo Battles is a competitive turn-based strategy game for 1-4 players, featuring\u2026\n\n\u2022 Turn-based Tactics - Battle your opponents in dungeons, forests and more as you square off against your opponents in grid-based action combat\n\n\u2022 Monstrous Minions - Assemble an army of chaotic critters to fight alongside you \u2014 from rats and goblins to cave trolls to giant slimes, all with a mind of their own! \n\n\u2022 Teamwork FTW - Bring two champions to the battle in every match and leverage their synergies; control both heroes directly or partner up with another player to defeat competitors  cooperatively  \n\n\u2022 Classic Classes - Choose a champion that matches your favorite fantasy play style to unleash magic, melee mayhem and more\n\n\u2022 Bespoke Builds - Spend your coins wisely when you enter the arena to build a unique loadout in every game, choosing from a randomized selection of action cards and monsters\n\n\u2022 Speedy Strategy - Challenge yourself to battle after battle with average matches lasting just under 20 minutes  \n\nComing later this year, Demeo Battles is the next game for the Demeo Action Role Playing System. Wishlist today!\n", "short_description": "Demeo Battles is a competitive turn-based strategy game for 1-4 players. Choose your champion, assemble an army of monstrous minions, and team up with another champion in your quest for turn-based glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolution Games", "support_website_url": null, "website_url": "http://demeobattles.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "3619581431595066"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "713950921579352"}, {"status": "PUBLISHED", "id": "1367615298187465"}, {"statu
hgQRFgfwk243GIAhnsBi6uOea98kcylOuP9t8mJPYY1dBG6iMS_tDRtLiOg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02b5G8o1zZ16kWFWVISqR57mS5uX9WNskMObr6D7nihQ&oe=69F60FE1"}, {"file_name": "Battles---Overview2.png", "id": "1210464476321351", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031355_1210464479654684_311058227055271208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FYXdaTP08AQ7kNvwHPvF4B&_nc_oc=Ado7qmAxMPZlK73x6KUhHqt48q4tOCK0G80niUSArxheWJXxdHdfGSEQPo9FCzZTlDM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af099Db1wsLbWE60fUeEGACOWtoAEHvwHhZJmquGA9ZcQA&oe=69F6071F"}, {"file_name": "Battles---Place-units2.png", "id": "789704312284193", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031355_789704315617526_2792818596407696198_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iNzVcqsMwgQ7kNvwHXLLSs&_nc_oc=AdqZekNFeOpRkeaA-SrqOSAIYEkVQjdIaX6IFZe333UkADYGPk7n_wba3koU3yCRJ-g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20Qq-R8BB6WUSd1mZwwyIXXh7P88xyyTDsudhc3aLGbg&oe=69F616F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemeoBattles_Thumbnail.png", "id": "637664445068835", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75557069_637664448402168_1933084965014661694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7nnSd4_7moQ7kNvwF738Tm&_nc_oc=AdqA4V4gyOQ-ubo2KbhK43AHauR6dylMghSF3KQJIq_XmO4tLu_qReSXd4ffP3FKWZI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31Hgk2NruXFk93KymSGNr3exbfGl6Kpfd5b5ocGTe0Pw&oe=69F5EE25"}, "display_name": "Demeo Battles", "keywords": [], "long_description": "Welcome to the arena! Demeo Battles is a competitive turn-based strategy game for 1-4 players, featuring\u2026\n\n\u2022 Turn-based Tactics - Battle your opponents in dungeons, forests and more as you square off against your opponents in grid-based action combat\n\n\u2022 Monstrous Minions - Assemble an army of chaotic critters to fight alongside you \u2014 from rats and goblins to cave trolls to giant slimes, all with a mind of their own! \n\n\u2022 Teamwork FTW - Bring two champions to the battle in every match and leverage their synergies; control both heroes directly or partner up with another player to defeat competitors  cooperatively  \n\n\u2022 Classic Classes - Choose a champion that matches your favorite fantasy play style to unleash magic, melee mayhem and more\n\n\u2022 Bespoke Builds - Spend your coins wisely when you enter the arena to build a unique loadout in every game, choosing from a randomized selection of action cards and monsters\n\n\u2022 Speedy Strategy - Challenge yourself to battle after battle with average matches lasting just under 20 minutes  \n\nComing later this year, Demeo Battles is the next game for the Demeo Action Role Playing System. Wishlist today!\n", "short_description": "Demeo Battles is a competitive turn-based strategy game for 1-4 players. Choose your champion, assemble an army of monstrous minions, and team up with another champion in your quest for turn-based glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolution Games", "support_website_url": null, "website_url": "http://demeobattles.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_mod
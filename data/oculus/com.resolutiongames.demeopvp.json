ohc=Ocig810iZhEQ7kNvwHYw6gO&_nc_oc=Adr5uOrkl0OHzgyQDlM0oM2Od8OEztMiSfsBDIJq0LMPhvnJuV-EGs2qOItVmsu2ToI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyk3OFU_cDagTGABwVILCarR5nHoENm1ADoNbOxdd3xw&oe=6B030637"}, {"file_name": "Battles---New-Card.png", "id": "1254739841808321", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982709_1254739848474987_5086793005295979524_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJvNSxrYsBYQ7kNvwE14fqe&_nc_oc=AdqACH6YmxBuER5H-Fo_QnWyodJqjmeKH3LggQrGXtmkDm-nIhCW9W8Lc9SNkC089nQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4lmUQr_3y4QDBdGevJiFMuwBlmOMrnAA2KSCkNj4D_g&oe=6B0301E1"}, {"file_name": "Battles---Overview2.png", "id": "1210464476321351", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1210464479654684_311058227055271208_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAyNbCmdVoIQ7kNvwFFQmxN&_nc_oc=AdrouJHXpVxdYccosDXSofkeIjyAcldQswNw2PediCL82I3FyD0CK2boQ1CeoEH_KWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjzFwyv0KwCEZcmy6-Ba_qrohEgbgHfNMbTzNWe9fB5w&oe=6B03315F"}, {"file_name": "Battles---Place-units2.png", "id": "789704312284193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031355_789704315617526_2792818596407696198_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tprv9MbMpUQ7kNvwEym7Cm&_nc_oc=AdquL82bS1rDQfanUmigIKAcZStxXewihkoBSC8O8elbppyKhSqqwVrY6AoFqDYCwkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5wwY5YV4VbOfIeY2w-1u854zDHktinjo6RhH05dTr9w&oe=6B0308F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemeoBattles_Thumbnail.png", "id": "637664445068835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75557069_637664448402168_1933084965014661694_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKlucEXPpmAQ7kNvwHvkRrL&_nc_oc=AdpJnv5-lw6SkwFtBUtbZBTv1zT6XQkJbsn4Ek4v38c_P6A3KgqKRhDdpGpPXzJ0wvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgVEB7tgs6qeqhgSPHYHhrKymH3n_WL6b2h518HIIasA&oe=6B031865"}, "display_name": "Demeo Battles", "keywords": [], "long_description": "Welcome to the arena! Demeo Battles is a competitive turn-based strategy game for 1-4 players, featuring\u2026\n\n\u2022 Turn-based Tactics - Battle your opponents in dungeons, forests and more as you square off against your opponents in grid-based action combat\n\n\u2022 Monstrous Minions - Assemble an army of chaotic critters to fight alongside you \u2014 from rats and goblins to cave trolls to giant slimes, all with a mind of their own! \n\n\u2022 Teamwork FTW - Bring two champions to the battle in every match and leverage their synergies; control both heroes directly or partner up with another player to defeat competitors  cooperatively  \n\n\u2022 Classic Classes - Choose a champion that matches your favorite fantasy play style to unleash magic, melee mayhem and more\n\n\u2022 Bespoke Builds - Spend your coins wisely when you enter the arena to build a unique loadout in every game, choosing from a randomized selection of action cards and monsters\n\n\u2022 Speedy Strategy - Challenge yourself to battle after battle with average matches lasting just under 20 minutes  \n\nComing later this year, Demeo Battles is the next game for the Demeo Action Role Playing System. Wishlist today!\n", "short_description": "Demeo Battles is a competitive turn-based strategy game for 1-4 players. Choose your champion, assemble an army of monstrous minions, and team up with another champion in your quest for turn-based glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolution Games", "support_website_url": null, "website_url": "http://demeobattles.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "
66779492_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9qmN83rCCwQ7kNvwHA-JQW&_nc_oc=Adoh-7rA7iBSZSYK3uqtmNqLvX9kJwzJxBMaKhjvmeAij6eKI3c01VthzAK9W901dAo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0pvxSOhlziDJPDr6wt9K_SB4Cwg7vJ0xb-FkElG_6QQ&oe=6B0F21AF"}, {"file_name": "4.png", "id": "2556136981576277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628893_2556136984909610_1399498264513055344_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW2FYWFeJg8Q7kNvwGqxhRV&_nc_oc=AdqoGT2SdGoksZrNaCSrZezrUORm-5pm-TGyRhkOzYM35_DrR-pAETfyp4dI3qdyAic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4wvp99SSZOZE3TjuISkYpaJZlTbvqU2D7M7Bt6yUB9w&oe=6B0F0EAB"}, {"file_name": "5.png", "id": "2163270944555130", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620599_2163270947888463_1703678922981080492_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a8PlHbX48AQ7kNvwH6GAH6&_nc_oc=AdqI6tBEXEH0qn7gEyxUh6JsGgI3oG_mQtIjJ1dkoz5mw_5hv4CuheeEpcbmdy8q8pQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0eBNHTGuuAFWd0cRFdqzPZW5l_BWrh5aq1z3zBk1zow&oe=6B0F21C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stunt Car Racing : Mega Ramp", "keywords": ["StuntCar", "CarStunt", "MegaRamps", "CarStuntGame", "RampChallenge"], "long_description": "Stunt Car Racing : Mega Ramp\n\nGet ready for an extreme VR driving experience in Stunt Car Racing: Mega Ramp!\n\nTake control of powerful stunt cars, accelerate across massive mega ramps, perform spectacular jumps and push your driving skills to the limit. Experience the excitement of high-speed car stunts as you take on challenging tracks, crazy obstacles and gravity-defying ramps.\n\nWhether you're racing at full speed or attempting daring aerial stunts, every ramp brings a new challenge.\n\nGAME FEATURES\n\nExtreme Stunt Car Racing: Drive powerful cars and experience exciting stunt gameplay.\n\nMassive Mega Ramps: Take on giant ramps and spectacular jumps.\n\nThrilling Car Stunts: Perform daring jumps and test your driving skills.\n\nChallenging Tracks: Navigate exciting tracks, obstacles and difficult ramp challenges.\n\nImmersive VR Driving: Experience the action from an immersive first-person perspective.\n\nHigh-Speed Action: Accelerate, steer and push your car to its limits.\n\nARE YOU READY FOR THE ULTIMATE RAMP CHALLENGE?\n\nGet behind the wheel, conquer massive mega ramps and prove your stunt driving skills.\n\nYour Car. Your Stunts. Your Challenge!", "short_description": "Drive extreme stunt cars, conquer massive mega ramps, perform crazy jumps and master thrilling racing challenges in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actionsimulationsgames.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Games", "support_website_url": null, "website_url": "https://actionsimulationsgames.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1363298576877613"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303606_1426179932525970_359632642293527287_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlge
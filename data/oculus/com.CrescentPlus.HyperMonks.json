jVkVJG-a2bhh3XEY2JFeb8g&oe=6AAA9F78"}, {"file_name": "shopping-fotor-20240705201828.png", "id": "1458546714769051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003240_1458546718102384_3513097691785504176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-_f5B3PYtwQ7kNvwFKvT93&_nc_oc=AdqZoJdbzJ86RgXTeaZknwwBhIck5XunMorA-CnMwbZJGjJ0SXJkNcBO1H2dI2zpsqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG7kLqkjcDm-m67KuABNW9lNnXNii6x-vL7XcYYlI2cA&oe=6AAA9F8A"}, {"file_name": "friends-fotor-20240705201915.png", "id": "1752136358927550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_1752136368927549_8295940168655449811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vvgpEOjtQ0Q7kNvwGGgc3t&_nc_oc=AdpPU637eGhHFLKORGmMNV--faFo3fPPQ2SOqex6Nqyy-TLW4_Umk6IjQNtvCR8XwUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJizuSk8MP5kuvh3QOBKllG5h9XMlv_8iQhA8Mczuu25g&oe=6AAAA27D"}, {"file_name": "explore-fotor-2024070520209.png", "id": "776027788027167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031497_776027791360500_5253653164185975759_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkYiOL3IRN0Q7kNvwGyp6Dv&_nc_oc=Adop0eWfyfQ4vp65zrgExY-abdd-pEHo_UuUHg1ol-2MV1dSUuNDu1lCr3IcHH4pu1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp9GLHmyF-g1By5TzEadco7qyxwnN3fQBenA6uLm9RAw&oe=6AAAA8E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hyper Monks 3", "keywords": [], "long_description": "Hyper Monks 3 is an immersive VR game that transports you to an underground Japanese metropolis set in the future. Play as a monkey navigating the vibrant and bustling world of HyperCity, a futuristic city inspired by Tokyo. Experience a variety of activities, from riding the metro transit to exploring the neon-lit streets, shopping in the expansive mall, or playing games in the lively arcade. When hunger strikes, indulge in delectable cuisine at local eateries like the Sushi Shop, Ramen Shop, and cozy cafes. Embrace the freedom to follow your own path and discover the way of the Hyper Monk in this dynamic and captivating virtual world.", "short_description": "Hyper Monks 3 is a thrilling VR game where you embody a monkey exploring a futuristic underground Japanese metropolis, HyperCity. Ride the metro, play arcade games, shop in a massive mall, and savor delicious cuisine from sushi to ramen. Discover your own path as you immerse yourself in this dynamic world full of adventure and surprises!"}]}, "developer_name": "HyperLabs", "developer_privacy_policy_url": "https://hypermonks-com.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Peeled", "support_website_url": null, "website_url": "https://hypermonks-com.webnode.page/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7379123228875141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_503835542087544_7005643315043885424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9y_lCH5Xn8Q7kNvwElES99&_nc_oc=Adr10lHNQ8DvXkhmwsO_NtDfR5gNSyumh9aOC58Dpvda9Wd3uRq4N79m4RBRwOxReSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9quex6OZBWU6OTj324TdP98Yyc8UjsWmtJo7rigEz1Q&oe=6AAA8F4D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
65fvoNwjp2tnJzWBvELrVFA&oe=6AE0ACF8"}, {"file_name": "shopping-fotor-20240705201828.png", "id": "1458546714769051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003240_1458546718102384_3513097691785504176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W72Jsge_eYQ7kNvwGNP0Y6&_nc_oc=AdrVZowyKRJTjuBu5cCfQULac9FLwcpTYyOelgm1386RCLK7QKWv0wn2BuMrUX-cCaw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp3rt_8SNgXEo6jBuZWMBG5r3GRxybtFFwmcnUJ0DQBw&oe=6AE0AD0A"}, {"file_name": "friends-fotor-20240705201915.png", "id": "1752136358927550", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031387_1752136368927549_8295940168655449811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3SEV52h4SwQ7kNvwHYLFrM&_nc_oc=AdrRKZS1fSv6m4dbErBF8tEF2i9WtqWl2sS6AsXrOteY17R3Xhtk9KBZIuBER9jGapk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvMMdZ9JISKIxNJPXFiny5dYW14MttYswajbaMhm17hQ&oe=6AE0AFFD"}, {"file_name": "explore-fotor-2024070520209.png", "id": "776027788027167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031497_776027791360500_5253653164185975759_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo27jG_xeqQQ7kNvwFzrHd5&_nc_oc=AdpcMCtv77WlqU1Rot4E4GcpuphtagTOqfpQF8z2XL4WVoKcTpGhMInBDJ_h_BNRhvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND8agpd0W6O6r3KHKK3QCy_3qBcvlLrokMLjES-p_5pw&oe=6AE0B665"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hyper Monks 3", "keywords": [], "long_description": "Hyper Monks 3 is an immersive VR game that transports you to an underground Japanese metropolis set in the future. Play as a monkey navigating the vibrant and bustling world of HyperCity, a futuristic city inspired by Tokyo. Experience a variety of activities, from riding the metro transit to exploring the neon-lit streets, shopping in the expansive mall, or playing games in the lively arcade. When hunger strikes, indulge in delectable cuisine at local eateries like the Sushi Shop, Ramen Shop, and cozy cafes. Embrace the freedom to follow your own path and discover the way of the Hyper Monk in this dynamic and captivating virtual world.", "short_description": "Hyper Monks 3 is a thrilling VR game where you embody a monkey exploring a futuristic underground Japanese metropolis, HyperCity. Ride the metro, play arcade games, shop in a massive mall, and savor delicious cuisine from sushi to ramen. Discover your own path as you immerse yourself in this dynamic world full of adventure and surprises!"}]}, "developer_name": "HyperLabs", "developer_privacy_policy_url": "https://hypermonks-com.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Peeled", "support_website_url": null, "website_url": "https://hypermonks-com.webnode.page/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7379123228875141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001728_503835542087544_7005643315043885424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z12UzKeZ7QQ7kNvwHWJDnE&_nc_oc=AdpCZZ-hdIQM0AvXZluh2_rvP939m7s2lAwKr2K6gQVcyrrv9_GOA9HUPEfD16BGyIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWOtITx1dz3MbZA17zqCaTnFrCNzglBhHEtO10QSo7ww&oe=6AE09CCD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
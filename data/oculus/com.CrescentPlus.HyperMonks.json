zCZsRHlkQLoRvrQAYEw391w&oe=6A86CEB8"}, {"file_name": "shopping-fotor-20240705201828.png", "id": "1458546714769051", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003240_1458546718102384_3513097691785504176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5bV08qF3JQQ7kNvwErTcrV&_nc_oc=AdrlO515d7E2EdUnqDSc7F7vtuPCERC7re1ioEaF3rcDHcY-Iyp57xHAGFDJ6Gjebvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvNRT4H_BzeRAQGjqaoBlwUMAdGLGI61BiwZwdESheNA&oe=6A86CECA"}, {"file_name": "friends-fotor-20240705201915.png", "id": "1752136358927550", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031387_1752136368927549_8295940168655449811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-3OC3YjbZQQ7kNvwFiXmQA&_nc_oc=AdotRwh3GFfY8JcboRi2imS1-BrPdV7TajrwiIL2sXVcblHKMDWPHhelOE7dkrWn85w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNYvUevJdB4q6xzu9YGTpV1s6oX7VzW52J8_m1Iaegtg&oe=6A86D1BD"}, {"file_name": "explore-fotor-2024070520209.png", "id": "776027788027167", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031497_776027791360500_5253653164185975759_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfvkvGVHvXIQ7kNvwFmHZUK&_nc_oc=AdqwO5SSw5BvHnR52KauTArmLJIF3adCwDMsPAt6-ObOY97Y6fAOz_MM1zewH4-YlqU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh_Q8lRa9QO_AQG27BIDiik1ztbcuvEn7mGU37EsU77A&oe=6A86D825"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hyper Monks 3", "keywords": [], "long_description": "Hyper Monks 3 is an immersive VR game that transports you to an underground Japanese metropolis set in the future. Play as a monkey navigating the vibrant and bustling world of HyperCity, a futuristic city inspired by Tokyo. Experience a variety of activities, from riding the metro transit to exploring the neon-lit streets, shopping in the expansive mall, or playing games in the lively arcade. When hunger strikes, indulge in delectable cuisine at local eateries like the Sushi Shop, Ramen Shop, and cozy cafes. Embrace the freedom to follow your own path and discover the way of the Hyper Monk in this dynamic and captivating virtual world.", "short_description": "Hyper Monks 3 is a thrilling VR game where you embody a monkey exploring a futuristic underground Japanese metropolis, HyperCity. Ride the metro, play arcade games, shop in a massive mall, and savor delicious cuisine from sushi to ramen. Discover your own path as you immerse yourself in this dynamic world full of adventure and surprises!"}]}, "developer_name": "HyperLabs", "developer_privacy_policy_url": "https://hypermonks-com.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Peeled", "support_website_url": null, "website_url": "https://hypermonks-com.webnode.page/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7379123228875141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001728_503835542087544_7005643315043885424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKPPW85kvNcQ7kNvwFKPZ0z&_nc_oc=AdrzP1CooGdOmPyL9CJfPK76YfG1kyjo5KqfrOh8o4sjrZezcAiqP3XAn_VFPYvxOdc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHymi49otx2YEgRLO9hDbcrpRUXX3xC07eh4we0tdTicg&oe=6A86F6CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
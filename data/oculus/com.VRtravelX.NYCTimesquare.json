OX&_nc_oc=Adq_-TOTB7yWyR44OiA-Te9N6Zo1XDBNQkh8M60L8ILOwQNSjGt4X8iMaWU8HSX3xx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkODOIjimm5u84Ff5Nb_FiKldE406ZuhLsdZ3zlsbrxg&oe=6B031D99"}, {"file_name": "Screen4.png", "id": "885534110236805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031517_885534113570138_4334129637526102135_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcOhfk-e4KwQ7kNvwGKuYYf&_nc_oc=Adq5NSLFXqCp6ujibtHbhf32D7gToDvOnFng7-g7aBj0am0N6cnCmi1vxJPrRMOSYH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvwywmBQpxXwyzMxtN6p4e93eDycbOZIMu4NcrwbiceA&oe=6B031BC2"}, {"file_name": "Screen5.png", "id": "1082702343325402", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031511_1082702346658735_4946577586307123906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JsLQRo9FDYQ7kNvwE_x6HD&_nc_oc=AdqiG1mxtpyLDnbKwQEcWB7521V366RYCvA9neskV2_2j7rT8yNq86NQdOzlQesB-gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK3vRnW4eJ6GOvbf-g1qiBPja0cLW0fQmAxdJq_M7u9A&oe=6B030A27"}, {"file_name": "Screen6.png", "id": "1705634746668376", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982709_1705634753335042_5497159140963386007_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-Im5isv3NcQ7kNvwEXcHpR&_nc_oc=AdrtpiCHxsk7-PZVU5-IcbkYNmJPzK4bq-hMgctmYG3RtxvKl77u2Xb1aiGcbFLee64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMCRLe4OzWWABIxMB8mklLIuoSHS5K3V1i6MLyy8BxOg&oe=6B0336C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NYC Times Square VR Travel Giant's View", "keywords": ["travel", "sightseeing", "timesquare", "newyork", "usa"], "long_description": "Discover the heart of New York City with a VR experience that immerses you in the iconic Times Square like never before. Witness the grandeur of massive digital billboards, the hustle and bustle of crowds, and the charm of yellow taxis from a towering perspective. By day, enjoy the bright lights and vibrant energy of the square, capturing the essence of this global landmark.\n\nAs night falls, Times Square transforms into a glowing wonderland of neon colors and mesmerizing displays. From the perspective of a giant, you can take in every detail, from the towering advertisements to the electric energy of the nightlife. Feel the pulse of the city without the stress of navigating crowds or dealing with high temperatures.\n\nThis experience is not a TV show or a documentary. It is as if you are truly there, right in the middle of the action. Available anytime, this virtual journey is perfect for anyone longing for the magic of Times Square from the comfort of home.\n\n#travel #tourist #sightseeing #vrtravel #newyork #usa #nyc #timesquare", "short_description": "Step into the iconic Times Square and experience its energy like never before. This VR journey lets you explore the square\u2019s vibrant atmosphere by day and its dazzling neon lights by night\u2014all from the perspective of a giant. Immerse yourself in the sounds and sights of this famous destination, stress-free and without crowds. Pause and continue at any time, bringing the magic of New York City right into your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/NYC-Times-Square-VR-Travel-Giant-View", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
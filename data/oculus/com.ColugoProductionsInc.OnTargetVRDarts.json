c_ohc=l-JaKaIFsg4Q7kNvwGu797t&_nc_oc=AdoBMczAcGwt6xFo7zORF3GlbEvGDgf9pReYogQ2fO9ZdkHpL1JP1ww26CzuUPd0BnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CBo3jepZE1kll0nZ3QVHsaj8gIUNwmtk3jevGM49S9g&oe=6A2D55D2"}, "display_name": "On Target VR Darts", "keywords": [], "long_description": "On Target VR Darts for Quest (App Lab)\n\nOn Target VR Darts is a realistic darts simulation. If you like competitive darts, this is the game for you. Play Cricket, 501, 301 and Around the world vs AI. Get the hang of things in Freethrow, or warm up in a quick round of Speed Darts. Gain achievements, fully customize your darts, play in three high quality environments and challenge players from around the world for top spot on our Leaderboards. \n\nMultiplayer integration is currently in development.\n\nWe'll be adding additional stats and Leaderboards, Single and Multiplayer Tournament modes, and custom home items soon.\n\nLooking forward to hearing your thoughts about the game! Reviews really help small Indie Developers like us make better games.", "short_description": "On Target VR Darts for Quest (App Lab)\n\nOn Target VR Darts is a realistic darts simulation. If you like competitive darts, this is the game for you. Play Cricket, 501, 301 and Around the world vs AI. Get the hang of things in Freethrow, or warm up in a quick round of Speed Darts. Gain achievements, fully customize your darts, play in three high quality environments and challenge players from around the world for top spot on our Leaderboards. \n\nMultiplayer integration is currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ontargetvr.com/privacy-policy/", "developer_terms_of_service_url": "https://ontargetvr.com/terms-of-service/", "publisher_name": "Colugo Productions Inc.", "support_website_url": "https://ontargetvr.com/forum/", "website_url": "https://ontargetvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_c
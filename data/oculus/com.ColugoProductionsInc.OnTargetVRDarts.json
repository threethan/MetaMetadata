.3_003.png", "id": "424495666116668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_424495669450001_1811683687081914997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgEH_AeziB0Q7kNvwGaM036&_nc_oc=AdpEugKNZMYadNtVDqEDli0qOb-KANV_Tp6f4mkDVaTlAyDAIXbfIkHapwZlNJtRqis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUANTAH4Z7G_n78q0he-3PYVU75OPZe5CiRBqne1YDGQ&oe=6AEE0B21"}, {"file_name": "screen02.png", "id": "213096570631188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974753_213096573964521_4154473785099266421_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHQ-Yj3MmfEQ7kNvwHYp169&_nc_oc=AdpUeq2Ak2GCUrjc_yEt9Yf0SvwQOAGUU3YF3vRkBPJx1CA8Uw9OYoofoAJ_h8XELBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCOZkRyeKFC318WGkyVf84KwerAG6lyURD5-de01RIoA&oe=6AEDDABF"}, {"file_name": "ot_5 Screenshots_v1.4.3_001.png", "id": "1415490905552721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_1415490912219387_1134285747698351694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb8PFG8BI7oQ7kNvwFHc1rZ&_nc_oc=Adq55AoF0-Shxv_lakxhhsOB4R_xjjrUZL53LnceBwNh2TM0NER_WbrL_pCcdwQDmvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzgndC2tbKdRhoLFsRDew5b1J9tGav0G7hSDuDXaj-rQ&oe=6AEDF661"}, {"file_name": "ot_5 Screenshots_v1.4.3_002.png", "id": "279420567599964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_279420570933297_930612309202747107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRbjAKsjPkwQ7kNvwG8sGEl&_nc_oc=Adpkbi9hPauxiwJdg-cSt6JC9iJxhFnFonGFetHzpz1u2Or5-n8fLl13PHhXVkq0TUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO3qCWvRHr4RAVsdUyyflrKHjPuO8BR6zCoSvO-N3psA&oe=6AEE0A61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main_comp_v143cover.png", "id": "3011212115856902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031379_3011212125856901_7312760783984654026_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvOmdIqgWd8Q7kNvwEjbbm8&_nc_oc=Adry0mFmeJH5GaD4UqPC5A2ZIpXegzL5mRa-gts6WMU8qi682soCqwl67n4GtwJ-GSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1b5MDn7IwFROp5CiYtKhE9Atc5XjyPPbYnJXxysdT3A&oe=6AEDF491"}, "display_name": "On Target VR Darts", "keywords": [], "long_description": "The ultimate darts simulation, featuring Meta Avatars and Multiplayer. 6 game modes including Cricket, along with 5 AAA quality rooms to play in. Experience the pinpoint accuracy of Quest while challenging your friends online in games of 501, 301, Cricket and Freethrow.\n\nShow off your fully customized darts by choosing from dozens of tips, barrels, shafts and flights. Create hundreds of combinations in our Dart Customization menu.\n\nSingle Player mode includes Cricket, 501, 301, and Around the world, all vs AI, as well as Freethrow and Speed Darts modes to get you warmed up. Gain achievements, and challenge players from around the world for top spot on one of our many Leaderboards.\n\nPlay in one of five beautifully rendered AAA quality scenes including the Black Hat Tavern, the Tournament Arena, Basement Rec Room, and a Brutalist Default Room that also has a Glow in the Dark theme.\n\nSee you in the Tavern!", "short_description": "Dive into the ultimate darts simulation on Quest, featuring Meta Avatars and an overhauled multiplayer system. \n\nEnjoy six different game modes, including Cricket, X01 and Around the World.\n\nPlay in one of five beautifully designed, AAA-quality rooms including The  Black Hat Tavern and Tournament Arena.\n\nChallenge friends worldwide and show off your customized darts with a variety of tips, barrels, shafts, and flights to choose from. Earn achievements and climb the global leaderboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://colugoproductions.com/index.php/otvrd/otvrd-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Colugo Productions Inc.", "
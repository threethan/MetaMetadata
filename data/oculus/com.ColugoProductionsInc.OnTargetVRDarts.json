7f30f&oh=00_AQT41Nd0zpZ4jsquhVz36BMOsqwgUR6GjZGfcIF71W6O8w&oe=6B0C5CE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main_comp_v143cover.png", "id": "3011212115856902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031379_3011212125856901_7312760783984654026_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsGM_JXI6S0Q7kNvwHId7XI&_nc_oc=AdqxvoH_Kgsw1rqxbxKxUw8mRWGm4IQOks_QN_et048i8L8-AbZDgo9LKrv_mtE2dhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8bvvN86sINOke7RLmzymVngMNTwv7X7pniYHY7HjNIA&oe=6B0C7F51"}, "display_name": "On Target VR Darts", "keywords": [], "long_description": "The ultimate darts simulation, featuring Meta Avatars and Multiplayer. 6 game modes including Cricket, along with 5 AAA quality rooms to play in. Experience the pinpoint accuracy of Quest while challenging your friends online in games of 501, 301, Cricket and Freethrow.\n\nShow off your fully customized darts by choosing from dozens of tips, barrels, shafts and flights. Create hundreds of combinations in our Dart Customization menu.\n\nSingle Player mode includes Cricket, 501, 301, and Around the world, all vs AI, as well as Freethrow and Speed Darts modes to get you warmed up. Gain achievements, and challenge players from around the world for top spot on one of our many Leaderboards.\n\nPlay in one of five beautifully rendered AAA quality scenes including the Black Hat Tavern, the Tournament Arena, Basement Rec Room, and a Brutalist Default Room that also has a Glow in the Dark theme.\n\nSee you in the Tavern!", "short_description": "Dive into the ultimate darts simulation on Quest, featuring Meta Avatars and an overhauled multiplayer system. \n\nEnjoy six different game modes, including Cricket, X01 and Around the World.\n\nPlay in one of five beautifully designed, AAA-quality rooms including The  Black Hat Tavern and Tournament Arena.\n\nChallenge friends worldwide and show off your customized darts with a variety of tips, barrels, shafts, and flights to choose from. Earn achievements and climb the global leaderboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://colugoproductions.com/index.php/otvrd/otvrd-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Colugo Productions Inc.", "support_website_url": null, "website_url": "https://colugoproductions.com/index.php/otvrd/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "fr", "es", "uk", "ja", "pl", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8201612146545294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982698_516226686701318_1526272247034150772_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHqonhmXejgQ7kNvwEeUIoq&_nc_oc=AdqofXjwJJeF1SAkVTH8K1Zaw7-lDok34JNbhZotuv7-L5Eii8ej-5WsmtXpitV2p2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_gBOyCeuwNCqR6cTKI-SsonR9lj5QFG61_8dZG0-i3Q&oe=6B0C6451"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "On Target VR Darts", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id"
{"file_name": "screen03.png", "id": "207513464551779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_207513467885112_4085125293784517036_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98TbjzQcz0oQ7kNvwHi1YfO&_nc_oc=AdpVdDV8W6clLBgGtIRi70fkPmfshqGIBqPvVLqImlZLvs9SWARdd0_Nm1rVS55oTsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWIFb5-rqERUXONCtO4BrioyheSWFSTl11J-YihzerNQ&oe=6AEDE901"}, {"file_name": "screen01.png", "id": "3004539209829508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031476_3004539213162841_5597535796311883612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnb-2hUeDEwQ7kNvwFpvXoe&_nc_oc=AdoZRWr_ZMf8p4_mwnZJOEskqiihftGJ_pLXP9KX5B5JtgwiTj581NGns2a4cA4NfL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzwcW8xkVF6VYhcD7cmh7DWe3ALoBM-culK7wht_k64A&oe=6AEDFA73"}, {"file_name": "screen02.png", "id": "213096570631188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974753_213096573964521_4154473785099266421_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHQ-Yj3MmfEQ7kNvwHYp169&_nc_oc=AdpUeq2Ak2GCUrjc_yEt9Yf0SvwQOAGUU3YF3vRkBPJx1CA8Uw9OYoofoAJ_h8XELBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCOZkRyeKFC318WGkyVf84KwerAG6lyURD5-de01RIoA&oe=6AEDDABF"}, {"file_name": "screen05.png", "id": "582169663192215", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974865_582169666525548_4763316584392280626_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gzKz0NE5xIQ7kNvwHtIStV&_nc_oc=Adr0t24iAAsLxtAxsnWZ3nti0iAWoOnUYdq99oLEg74LiFK1fUswF3khGOAQUPgj7u4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWZlbZMpKhCfEJrY1mrlp9D4NYT6nIVz6-MIiosTjB0Q&oe=6AEDEE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ot_Landscape.png", "id": "253340993177563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974689_253340996510896_5605650548517129404_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5WQn7bFFyYQ7kNvwHSvcOQ&_nc_oc=AdqOTTce3JIM-Oh4Cy2-sCTlXwCHWXNqyxxnyPuA3d6R1ng0PdQZykjXAeDrvkuAwCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh-E5NFKAswHVZ-QLtw6DySDxHy21lElX_TpMe1Hm7RA&oe=6AEE0912"}, "display_name": "On Target VR Darts", "keywords": [], "long_description": "On Target VR Darts for Quest (App Lab)\n\nOn Target VR Darts is a realistic darts simulation. If you like competitive darts, this is the game for you. Play Cricket, 501, 301 and Around the world vs AI. Get the hang of things in Freethrow, or warm up in a quick round of Speed Darts. Gain achievements, fully customize your darts, play in three high quality environments and challenge players from around the world for top spot on our Leaderboards. \n\nMultiplayer integration is currently in development.\n\nWe'll be adding additional stats and Leaderboards, Single and Multiplayer Tournament modes, and custom home items soon.\n\nLooking forward to hearing your thoughts about the game! Reviews really help small Indie Developers like us make better games.", "short_description": "On Target VR Darts for Quest (App Lab)\n\nOn Target VR Darts is a realistic darts simulation. If you like competitive darts, this is the game for you. Play Cricket, 501, 301 and Around the world vs AI. Get the hang of things in Freethrow, or warm up in a quick round of Speed Darts. Gain achievements, fully customize your darts, play in three high quality environments and challenge players from around the world for top spot on our Leaderboards. \n\nMultiplayer integration is currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ontargetvr.com/privacy-policy/", "developer_terms_of_service_url": "https://ontargetvr.com/terms-of-service/", "publisher_name": "Colugo Productions Inc.", "support_website_url": "https://ontargetvr.com/forum/", "website_url": "https://ontargetvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "uk", "ja", "pl", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "961206928103875"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1081240304076563"}, {"status": "PUBLISHED", "id": "707363622097753"}, {"status": "PUBLISHED", "id": "1150898720531804"}, {"status": "PUBLISHED", "id": "1020075910252205"}, {"status": "PUBLISHED", "id": "2397230050639868"}, {"status": "PUBLISHED", "id": "4274865272740990"}, {"status": "PUBLISHED", "id": "1944875685918076"}, {"status": "PUBLISHED", "id": "366448043160680"}, {"status": "PUBLISHED", "id": "224669219528707"}, {"status": "PUBLISHED", "id": "389013586139159"}, {"status": "PUBLISHED", "id": "2712294925745408"}, {"status": "PUBLISHED", "id": "502224858231542"}]}, "baseline_offer": {"id": "366448043160680"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1081240304076563"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29276407408639128", "version": "1.8.11"}, "id": "884455389010426", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29276407408639128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.8.11 (October 29, 2026)\n- New: Dart Cam now follows other players' darts in Online games.\n- New: Online - every player's Meta profile icon now shows in the player list.\n- New: Hands Mode has its own Throw Power and Dart Weight settings, separate from controllers (defaults: 8 and 15g).\n- New: Dart weight now affects throw speed with controllers (10g throws faster, 50g throws slower).\n- Improved: Dart Cam performance. It only updates while moving, which gives smoother frame rates.\n- Improved: Hands Mode throws keep the speed and direction of your flick, so darts no longer stall in your hand or drop short.\n- Improved: Hands Mode - you can open the wrist menu with your right hand while your left hand holds a dart.\n- Improved: Smoother frame rates, with less logging and fewer settings saves during play.\n- Improved: Rewrote the translations for every supported language, including menus, rules, the darts glossary and this changelog. Many more menu and lobby texts are now translated.\n- Fix: Hands Mode Customize menu was hidden behind the Main Menu. Back now returns to the previous menu.\n- Fix: Hands Mode wrist-pinch menu could open while holding a dart, flicker, or close the lobby and end-game menus.\n- Fix: Hands Mode throws could be too strong from tracking spikes or the controller Throw Power setting.\n- Fix: New installs default to right-hand throwing, and Settings no longer overrides the hand chosen during onboarding.\n- Fix: Menu Back button could get stuck with nowhere to go.\n- Fix: Cricket end-game Exit to Main button did nothing.\n- Fix: An error could appear when quitting the game.\n- Fix: Missing characters no longer show as empty boxes in Japanese, Korean and Chinese, and accented letters now use the game's font.\n- Fix: Online - remote players' misses were not counted on the scoreboard.\n- Fix: Online - a bust on the last dart could skip the next player's turn.\n- Fix: Online - Play Again could get stuck in a loop.\n- Fix: Online - first player sometimes received two sets of darts at game start.\n- Fix: Online - darts could stop appearing after an interrupted spawn.\n- Fix: Online - darts-thrown count now matches on every player's scoreboard.\n- Fix: Online - player numbers were wrong when spectators were in the session.\n- Fix: Online - Cricket now scores, closes numbers and picks the winner correctly in 3 and 4 player games.\n- Fix: Online - end-game screen now shows Player 3 and Player 4 names and scores, and the X01 end-game buttons in 3 and 4 player games.\n- Fix: Online - players leaving mid-game no longer stall the match. If the host leaves at any time, even in the waiting room, everyone returns safely to the Main Menu.\n- Fix: Online - Exit to Main now properly leaves the session for players who joined.\n- Fix: Online - turns now end as soon as the last dart scores, and late dart results no longer change the score.\n- Fix: Online - old player list no longer shows after leaving a session.\n- Fix: Online - player names now show in the player list as each player joins, not just at game start.\n- Fix: Online - long player names were cut off.\n- Fix: Online - a slow third dart could show up in the first dart's slot on the scoreboard.\n- Fix: Online - the turn marker never moved to Player 3.", "created_date": 1793300085, "id": "29276407408639128", "version": "1.8.11", "version_code": 1996, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29276407408639128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.8.10 (May 26, 2026)\n- Fix: Bullseye (25) issue and outer miss areas did not report a score and darts sink too far in to the board. This was a physics issue, problem solved.\n- Fix: Cricket AI Opponent won't throw darts when it's their turn.\n- Fix: Moving the Dartcam moves the AI dart on the 3rd throw.", "created_date": 1779822177, "id": "27296607129952509", "version": "1.8.10", "version_code": 1988, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29276407408639128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.8.9 (April 21, 2026)\n- Fix: Bullseye and Double Bull both score consistently now\n- Fix: X01 Double Out turned off, now allows players to win without doubling out in Single Player games, even checking out on 1\n- Fix: Enhanced scoring accuracy in all game modes. Fixed scores that reported wrong wedge for throws landing through 2 wedge colliders on an angle\n- V1 release of Hands Mode with controller like physics\n- All Hands game modes enabled with fully functioning menus (X01, ATW, Cricket)\n- New Hands Mode DartCam that allows users to pinch and point at the DartCam screen to pan and zoom the camera\n- New Dart Spawner can be grabbed and positioned for Left and Right Hand throwing without switching hands in the menu\n- New Settings menu options for Hands throw power and release angle", "created_date": 1776804395, "id": "26874835168796376", "version": "1.8.9", "version_code": 1980, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29276407408639128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776711631, "id": "26862763303336896", "version": "1.8.8", "version_code": 1967, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29276407408639128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.8.7 (January 19, 2026)\n- Optimized player preferences saving between sessions\n- Fixed Multiplayer X01 Bug where scores would reset 2 hands back", "created_date": 1768876461, "id": "25964781393135096", "version": "1.8.7", "version_code": 1907, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
.3_003.png", "id": "424495666116668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_424495669450001_1811683687081914997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMvrRqvQ4foQ7kNvwE5U0-5&_nc_oc=Adq_Oizz9Q79v4mzbPTcrKHnCAPZVy6J8_E8R0STBwFGgqUJMUnbEIEdqpx1FHicvvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9q-eHM9vQ8Yxl8-vuqXYmMVlOHFhXz-WnsfISWjxtrw&oe=6A2D57E1"}, {"file_name": "screen02.png", "id": "213096570631188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974753_213096573964521_4154473785099266421_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lagEtE_hbMoQ7kNvwGroHoZ&_nc_oc=AdpKAj9mC94lImmyPMGMF4KEEbrBYj1mOqq3nSRW3e49bXFiSQAWh-YtTR_WRMIyg2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82HfAqpfpTmJOj7En0Npxm6h9YrkNg3KTyntqPgqCDCw&oe=6A2D5FBF"}, {"file_name": "ot_5 Screenshots_v1.4.3_001.png", "id": "1415490905552721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_1415490912219387_1134285747698351694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzLjdWhidtwQ7kNvwGGo2y2&_nc_oc=AdohYCtLz7WfpBRRLknuqk_U7XyYAytJMtQoAmSa2lJLHIuEVzCwWJ4JXgwke6iqLGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l_1cy2ad_q503Qoz7jQ3XrZWiLbGGxbfHvxC0guQyKg&oe=6A2D7B61"}, {"file_name": "ot_5 Screenshots_v1.4.3_002.png", "id": "279420567599964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_279420570933297_930612309202747107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZOcF2sbtL4Q7kNvwFYvV_F&_nc_oc=AdqrvW0JYDYI614-X45zk3hGiqN9NOx3IwTE32gKdCOvT2baOMxBG4BgDVe-OQujdgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K_mJOJaAhMANPXrAnUJhWD1GWfX_283Qwzk2YnRiqBw&oe=6A2D5721"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main_comp_v143cover.png", "id": "3011212115856902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031379_3011212125856901_7312760783984654026_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ME0G5dzYrQQQ7kNvwG6Vh0l&_nc_oc=AdpWNgCqWi1pbZmibw13rMAm0ZF4Co07axN4TSbMMkEcNjv3tHHJdfXxhxQqXIxLX7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xQwQqBC9NRFlz0sydVGPdcGvq73ly4Yxt_fho7oFIlg&oe=6A2D7991"}, "display_name": "On Target VR Darts", "keywords": [], "long_description": "The ultimate darts simulation, featuring Meta Avatars and Multiplayer. 6 game modes including Cricket, along with 5 AAA quality rooms to play in. Experience the pinpoint accuracy of Quest while challenging your friends online in games of 501, 301, Cricket and Freethrow.\n\nShow off your fully customized darts by choosing from dozens of tips, barrels, shafts and flights. Create hundreds of combinations in our Dart Customization menu.\n\nSingle Player mode includes Cricket, 501, 301, and Around the world, all vs AI, as well as Freethrow and Speed Darts modes to get you warmed up. Gain achievements, and challenge players from around the world for top spot on one of our many Leaderboards.\n\nPlay in one of five beautifully rendered AAA quality scenes including the Black Hat Tavern, the Tournament Arena, Basement Rec Room, and a Brutalist Default Room that also has a Glow in the Dark theme.\n\nSee you in the Tavern!", "short_description": "Dive into the ultimate darts simulation on Quest, featuring Meta Avatars and an overhauled multiplayer system. \n\nEnjoy six different game modes, including Cricket, X01 and Around the World.\n\nPlay in one of five beautifully designed, AAA-quality rooms including The  Black Hat Tavern and Tournament Arena.\n\nChallenge friends worldwide and show off your customized darts with a variety of tips, barrels, shafts, and flights to choose from. Earn achievements and climb the global leaderboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://colugoproductions.com/index.php/otvrd/otvrd-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Colugo Productions Inc.", "
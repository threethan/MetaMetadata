JHGh52fjX86fhR-DXHJDXRuo8CDy4lRY3A&oe=6B0C5C1A"}]}, "id": "811298432794018", "locale": "en_US", "screenshots": [{"file_name": "screen04.png", "id": "342914787256562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_342914790589895_232960555400792315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm_o--WURBsQ7kNvwFI-iii&_nc_oc=AdpEuEYXMbbfMkqf468wbsdqXwmEsSWHYHCJAV4XccL408Z0uWg0Uke9OO9fBbAMCcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYMCEVgklDK-ZUexzR64VKHPu2PDmpI1oI7DIfC_jr3Q&oe=6B0C51D1"}, {"file_name": "screen03.png", "id": "207513464551779", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974861_207513467885112_4085125293784517036_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2NSI6FxdrsQ7kNvwGW-ICQ&_nc_oc=Adq0_eHu-O59FYzX9Zpddo9pylKz2hkYuZA52GUfNPWXBDH1CZKtewGUM83dyBuisGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRY-l4SaCh1jJrfh9hdqHSy9ID--IlI0kiCssBJLGSYxw&oe=6B0C73C1"}, {"file_name": "screen01.png", "id": "3004539209829508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031476_3004539213162841_5597535796311883612_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw_AFr9k-A4Q7kNvwGzQnuW&_nc_oc=AdpOZAQPONBh3n3Js95QJ_xqA94tSztiWOEQpf-2odLbiVJfFrJIJXytuawc2GBgkq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1zYb-FnYpZxoTXWKckf4OWomKbzVBh6L4z_znCvz6BQ&oe=6B0C4CF3"}, {"file_name": "screen02.png", "id": "213096570631188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974753_213096573964521_4154473785099266421_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pwIZSkzxxsQ7kNvwH-IfZ9&_nc_oc=Adq-1E573_-IaLIAkynIBtUwBFy6Oog3r1vtOOUUMF-W5M4xBko-oio3ZQuJt6bvJxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGBXakB0pXE7OR0FV9fCcha7nNMUwWINIx4lSiABATDw&oe=6B0C657F"}, {"file_name": "screen05.png", "id": "582169663192215", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974865_582169666525548_4763316584392280626_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zpU2cFlBGUQ7kNvwFwgpgn&_nc_oc=AdqagOO01Zr-Gm4lA_FxKeUpdlkcOCg_nARybfR03DY7WQeyI1vMmofosugAbXqcdaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTziEmcdCIDCRdohFs4B41jWR_vCO_qxZWz2qHYW7N8xg&oe=6B0C7910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ot_Landscape.png", "id": "253340993177563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974689_253340996510896_5605650548517129404_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe7Lu3hxVAgQ7kNvwFnpv03&_nc_oc=Adpdl_15JRcAdFqd2RgXDc6ondAbhYrl-Y2z5v-yhY3rikWvLJe3QlA0JS_NKZvxkAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdZplwP5kR43sXWdJbebo958q7s1lO_Azhi18uYY_Ckg&oe=6B0C5B92"}, "display_name": "On Target VR Darts", "keywords": [], "long_description": "On Target VR Darts for Quest (App Lab)\n\nOn Target VR Darts is a realistic darts simulation. If you like competitive darts, this is the game for you. Play Cricket, 501, 301 and Around the world vs AI. Get the hang of things in Freethrow, or warm up in a quick round of Speed Darts. Gain achievements, fully customize your darts, play in three high quality environments and challenge players from around the world for top spot on our Leaderboards. \n\nMultiplayer integration is currently in development.\n\nWe'll be adding additional stats and Leaderboards, Single and Multiplayer Tournament modes, and custom home items soon.\n\nLooking forward to hearing your thoughts about the game! Reviews really help small Indie Developers like us make better games.", "short_description": "On Target VR Darts for Quest (App Lab)\n\nOn Target VR Darts is a realistic darts simulation. If you like competitive darts, this is the game for you. Play Cricket, 501, 301 and Around the world vs AI. Get the hang of things in Freethrow, or warm up in a quick round of Speed Darts. Gain achievements, fully customize your darts, play in three high quality environments and challenge players from around the world for top spot on our Leaderboards. \n\nMultiplayer integration is currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ontargetvr.com/privacy-policy/", "developer_terms_of_service_url": "https://ontargetvr.com/terms-of-service/", "publisher_name": "Colugo Productions Inc.", "support_website_url": "https://ontargetvr.com/forum/", "website_url": "https://ontargetvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "uk", "ja", "pl", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "961206928103875"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PENDING", "id": "1703797878019324"}, {"status": "PUBLISHED", "id": "1658951275740187"}, {"status": "PUBLISHED", "id": "1081240304076563"}, {"status": "PUBLISHED", "id": "707363622097753"}, {"status": "PUBLISHED", "id": "1150898720531804"}, {"status": "PUBLISHED", "id": "1020075910252205"}, {"status": "PUBLISHED", "id": "2397230050639868"}, {"status": "PUBLISHED", "id": "4274865272740990"}, {"status": "PUBLISHED", "id": "1944875685918076"}, {"status": "PUBLISHED", "id": "366448043160680"}, {"status": "PUBLISHED", "id": "224669219528707"}, {"status": "PUBLISHED", "id": "389013586139159"}, {"status": "PUBLISHED", "id": "2712294925745408"}, {"status": "PUBLISHED", "id": "502224858231542"}]}, "baseline_offer": {"id": "366448043160680"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1703797878019324"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29618606157752583", "version": "1.9.3"}, "id": "884455389010426", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29618606157752583"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "On Target: VR Darts v1.9.3\n\nNEW\n- Board Colours (Settings > Extra): recolour the dartboard. Pick a preset or choose the colour of each part of the board, and save up to three of your own. Online, everyone sees the host's board colours.\n- Room Setup (Settings > Extra, in Passthrough with controllers): hang the board on a real wall of your room. Point at a wall, touch it with your controller, or let the game find a clear wall from your room scan. The board stays at regulation height and the throw line moves with it, 2.37 m in front.\n- Room Setup TVs: move the scores TV, dart cam TV and video TV onto any wall of your room, and put them back with one button.\n- Video Quality (Settings > Audio Video): choose the Quest 3 or Quest 2 graphics preset. The game picks the right one for your headset, and you can switch any time.\n- Sound: a soft whoosh the moment a dart leaves your hand.\n\nIMPROVED\n- Graphics: a new rendering engine.\n- Atmosphere: light beams and haze in the Tavern, haze in every venue, and light beams from the floor lights in Default and the stage lights in Tournament.\n\nCHANGED\n- Passthrough: no more teleport spots. You walk to the throw line in your own room. Passthrough is now Single Player only.", "created_date": 1795404317, "id": "29618606157752583", "version": "1.9.3", "version_code": 2060, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29618606157752583"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.9.2\n\nNEW\n- Practice: Free Throw is now Practice, with six new drills: Random Doubles, Random Triples, Bullseye, Checkout Combos, Around the Doubles and Bob's 27. Switch drill or restart from the in-game menu.\n- Bull Off: against the AI, a new Starting Player setting lets a bull off decide who throws first. One dart each at the bullseye, and the closest to the centre starts.\n- Achievements: all-new achievement icons.\n\nFIXES\n- X01: the checkout hint now shows the right darts for odd finishes.\n- Around the World: each player's next number now shows from the start of the game.", "created_date": 1794716246, "id": "29510897488523451", "version": "1.9.2", "version_code": 2055, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29618606157752583"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.9.1\n\n- New: Cross-play with Steam - Meta Quest and SteamVR players can now play online together in the same games. Steam players appear as Meta avatars matched to the character they picked.\n- New: Name tags above every player online, with their name and profile picture. Tags always turn to face you.\n- New: Online session list shows when a game is hosted on the other platform, e.g. \"(Steam)\".\n- New: Tournament - work your way through a bracket of AI opponents in Single Player.\n- New: AI opponents in the room - in every Single Player game against the AI, tournaments included, your opponent stands at the line and throws its own darts, taking turns with you.\n- New: Dart Grip - put your other hand on the white sphere above the dart and hold the grip button to move and turn it.\n- Improved: Messages below the board have a cleaner, rounded look.\n- Fix: Online - voice chat now starts reliably on Quest.\n- Fix: Online - when a player leaves, their avatar and name tag disappear right away instead of staying behind.", "created_date": 1794621157, "id": "29495823963364137", "version": "1.9.1", "version_code": 2052, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29618606157752583"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.8.16 (November 8, 2026)\n- Major Improvement: Controllers - reworked dart release, in Single Player and Online. The dart now leaves your hand the moment you ease off the trigger, instead of waiting until the trigger is almost fully released. Throw speed and direction now come from the peak of your throw, so holding on a touch too long no longer pulls the dart low, and every throw is far more consistent. The dart still only leaves when you let go of the trigger, so practice swings work as before.\n- Note: Throwing will feel different after this update, and throws may land higher than you're used to. You may need to adjust Throw Power and Dart Weight in Settings to get the right feel again.\n- New: X01 - Bust, Need a double to finish and Need a double to start now show below the board, for every player online.\n- New: X01 - your Double-In and Double-Out choices are now remembered.\n- Fix: Online X01 - turning Double-Out off now works, so you can finish on a single.\n- Fix: X01 - the AI now finishes the game with Double-Out off, and no longer throws an extra dart after it wins.\n- Fix: Cricket - points now show on the scoreboard right away, with no more floating \"0\".\n- Fix: Online Around the World - every player starts on 1, everyone sees each player's progress and next target, and the match now has its own end screen and leaderboard.\n- Fix: Online X01 - leaderboard wins and achievements now count when the match is won, not after every leg.\n- Fix: Online - in 3 and 4 player games, only the winner gets the win, and your first online win is now recorded.\n- Fix: A bust no longer counts an extra dart, and the \"Play 301\" achievement now unlocks against the AI.", "created_date": 1794244300, "id": "29431300099816524", "version": "1.8.16", "version_code": 2043, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4034169883289562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29618606157752583"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "884455389010426"}]}, "change_log": "v1.8.15 (November 6, 2026)\n- New: A new loading spinner between scenes.\n- Improved: Online - sharper picture. Multiplayer now renders at full resolution, the same as Single Player.\n- Fix: Online - when the other player leaves mid-match, the host now stays in the session with the player list, instead of a blank screen.\n- Fix: Online - players whose Meta avatar can't load now get a default avatar.\n\nv1.8.14 (November 5, 2026)\n- New: Hands and controllers now work together in Single Player. Put both controllers down to play with your hands, or pick them up to switch back, at any time. Hands Mode no longer has its own separate scenes.\n- New: Dart Grip (Settings - Extra). Adjust the position and rotation of the dart in your hand. Each hand keeps its own grip for controllers, the Hands character and hand tracking.\n- New: Hand Pose (Settings - Extra). While holding a dart with a controller, tap a finger joint with your other index finger and adjust it to shape your grip, for the Avatar and Hands characters.\n- New: Character setting (Settings - Extra). Show your avatar, floating hands, or nothing in the Passthrough scene.\n- New: Hands Mode - the dart turns amber, then red, when you pull it too close to your face, where hand tracking can drop.\n- New: Throw Power and Dart Weight now show whether they apply to hands or controllers.\n- New: The lobby now works with hand tracking, and you face the board on first launch.\n- Improved: Engine update, including security fixes.\n- Improved: Hands Mode throws now let go at the peak of your flick, even if tracking misses your fingers opening, for a cleaner flight to the board.\n- Improved: Hands Mode darts fly straighter, with much less sideways turn and twist on release.\n- Improved: Hands Mode - a dart you're holding still stays in place if hand tracking drops, instead of falling.\n- Improved: Hands Mode has new defaults: Throw Power 7.5 and 20g. Dart grips and hand poses have new defaults too.\n- Improved: Avatar fingers follow your tracked hands more closely, and the dark default avatar no longer shows while yours loads.\n- Fix: Lifetime darts thrown stopped counting up between scenes, which also held back the throw achievements.\n- Fix: Hit dot and its shadow were not showing on the board in some cases.\n- Fix: Dart Cam no longer zooms from the trigger and grip while a menu is open.\n- Fix: The hand pointer no longer shows in the Dart Cam, and is smaller.", "created_date": 1793994468, "id": "29391208237159044", "version": "1.8.15", "version_code": 2040, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
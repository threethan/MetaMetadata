r": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "1666634184972045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593854747_1666634188305378_3479299351745809053_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7loa1M5bTYQ7kNvwHZiFZJ&_nc_oc=AdrXXmIslHXwm7YlZyyfr2I9NXcQx1bHoM6VmToQEe4JY2_Gp-_H72pH4j1X6M0zhrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVC_1_YGtUHDtmqpw1pYGZttqE6nfxRef05YTqkLc6kvQ&oe=6B104BE8"}, "display_name": "MR BATTING QUEST 3", "keywords": [], "long_description": "MR BATTING QUEST 3 brings a virtual pitcher, bat, baseball, home plate, and strike zone into your real surroundings using mixed reality passthrough.\n\nSwing a controller-held bat and challenge yourself in 10-pitch sessions. Adjust the pitch type, speed, and time between pitches to suit your practice. Right- and left-handed batting are supported.\n\nThe pitching rubber is positioned 18.4404 metres (60 feet, 6 inches) from the rear point of home plate. The baseball features red seams, and bat contact is accompanied by wooden-bat impact sounds.\n\nDesigned for Meta Quest 3 and Quest 3S with Touch controllers. Play standing in a clear space and keep people, furniture, and pets outside your swing area. Virtual objects do not provide physical protection.", "short_description": "Bring batting practice into your room with mixed reality. Face an animated pitcher, swing your controller-held bat, and play a 10-pitch session with adjustable pitch types, speeds, and intervals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mr-batting-quest-3-privacy", "developer_terms_of_service_url": null, "publisher_name": "saitomakoto", "support_website_url": "https://sites.google.com/view/mr-batting-quest-3-privacy", "website_url": "https://sites.google.com/view/mr-batting-quest-3-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [
t=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGe9CZdwenixXJri8OJmMg-3vfv_CWsIdLGoOwS2OEwg&oe=6AEDD725"}, {"file_name": "3 (2).png", "id": "1668484375020843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1668484378354176_7962183292734934927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MNJ5gNbAhgQ7kNvwFmUtam&_nc_oc=Adp4rGn-zceuBOLogETsyG_c3bn-ZUEh8m9B3MbXOO3LVmh5jESxADNayTE9O3w2u1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJa02OeE-wXuANwQpdxkxwZ-884XIpw9R37dOqX1JI4A&oe=6AEDFB08"}, {"file_name": "5 (2).png", "id": "2158720661435114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654975915_2158720664768447_3652301282295472150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQPlsXui28cQ7kNvwHtcg-L&_nc_oc=AdpinctZmZK9tIwrCRRfuoxND4o1AoU0ThQ2Vj1gXlty3kSPpKj6tr7roJdIWgZMC58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJPWXgsTjjKL4cWXnx5He-Nk7QVDGs3ct_CFQ5FYBGSg&oe=6AEDDB91"}, {"file_name": "4_1_2560x1440.png", "id": "1088211797549723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1088211800883056_3180025934390551364_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpvM22E6j2QQ7kNvwGC1al9&_nc_oc=Adpf3aRqiW1D-2BVwp9F5to3bJHzrJ7LXsnxNyfA1e9DsWlpEWmeL-q_ch6R7CoYdcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4pcpQCfj6jb02-mntFdiN2T3XMj6k9mAvgdy2lafY_g&oe=6AEDE67F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sail logo5.png", "id": "356739772677881", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031340_356739776011214_4752399952396963553_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txV--2uy0SoQ7kNvwGatFvC&_nc_oc=AdohfEhbUVliHvA534gcCuWWudCsSePjGF20ctVMKfqqh6C3P3dvwhtSoIokSaCaHIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0r3Wzur2w3t92K43gULC5UgCilfQC42jXyCXmVUZ4Qw&oe=6AEDECCF"}, "display_name": "Sail Legacy", "keywords": [], "long_description": "Sail Legacy brings back the version of Sail the multiplayer VR pirate adventure, just the way players remember it.\n\nFight off skeleton raids dig up buried loot, battle rival ships and bring your haul back to port. Then brave Dead Mans Island, where pirates race to find the key and claim the chest before anyone can.\n\nCrew up with friends in a room using a room code or join a public port and meet pirates from around the world. Make your pirate your own with outfits from the shop, which changes every week and earn StarCoins from the challenge.\n\nFeatures:\n\n- Multiplayer crews with voice chat\n\n- Build. Customize your own ship\n\n- Ship-to-ship cannon battles\n\n- Dead Mans Island\n\nSail Legacy is the classic 1.35 version of Sail kept alive for the community.\n\nNOTICE. If you would still like to play Sail Single Player go to the release channels, on this app and click SINGLEPLAYER then your game will. You will be able to play single player again", "short_description": "Sail Legacy brings back the classic multiplayer VR pirate adventure. Build your ship, gather your crew and sail the open sea hunting treasure, fighting skeleton raids and battling rival ships. Brave Dead Man's Island, join a public port or play with friends using a private room code. Want single player? Go to the release channels on this app and pick SINGLEPLAYER."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saillegacy.net/privacypolicy", "developer_terms_of_service_url": "https://saillegacy.net/TOS", "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://saillegacy.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "ADVENTURE", "ACTION
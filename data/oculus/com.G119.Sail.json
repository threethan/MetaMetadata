t=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStJ1b09QN9zeEa3KBw72cIgviUOCIhrkzSJlLt933c3Q&oe=6AF89B65"}, {"file_name": "3 (2).png", "id": "1668484375020843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_1668484378354176_7962183292734934927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq1R6iQ-4PIQ7kNvwF-hCb2&_nc_oc=AdphZmIWlP9EiAJ4hGqtbAqp_-EY65PuV-I-s9F_yPGFA3BcZvIYw_K84zpoaoZmrdk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDIGg5s_WPOfiJ7fw27LSe-MwVtGucyNaGRB4boxoQYg&oe=6AF88708"}, {"file_name": "5 (2).png", "id": "2158720661435114", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654975915_2158720664768447_3652301282295472150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0b5oHn3P9wQ7kNvwGVAfls&_nc_oc=AdpUPM7j6y1quHs9f442h90b9hsoNUMtE2aWgq6n3oG-qnbOPwEg9TS2Vs4vZlrIDbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAuwbxLIveAJJ6h0W2ciIOx80IRkccTwx1tNJa_m6K1Q&oe=6AF89FD1"}, {"file_name": "4_1_2560x1440.png", "id": "1088211797549723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1088211800883056_3180025934390551364_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGFFwyyFuBAQ7kNvwEcCVSX&_nc_oc=Adrk0MUr-fVZeyFxdKPBknqksjmYHOoWKFGhuQ2QD2b21ujH1sJLi3KJqEjujejaBlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH5z90prDFrB9OTpy7uZEhaMjhZjAFQxRG9OpW5SaMrw&oe=6AF8AABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sail logo5.png", "id": "356739772677881", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031340_356739776011214_4752399952396963553_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIYVtnI-YB0Q7kNvwF4qLIF&_nc_oc=AdrERaaqjURYi3QZYwAPr-lc3gosl7DM1tFROqlfmxnnDjZwHbYNvAU6ahZLDqLdc34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSReO4SwsFmI09SWNbxAVp8sHHPKVwF3ZpNRDZLffDOsw&oe=6AF878CF"}, "display_name": "Sail Legacy", "keywords": [], "long_description": "Sail Legacy brings back the version of Sail the multiplayer VR pirate adventure, just the way players remember it.\n\nFight off skeleton raids dig up buried loot, battle rival ships and bring your haul back to port. Then brave Dead Mans Island, where pirates race to find the key and claim the chest before anyone can.\n\nCrew up with friends in a room using a room code or join a public port and meet pirates from around the world. Make your pirate your own with outfits from the shop, which changes every week and earn StarCoins from the challenge.\n\nFeatures:\n\n- Multiplayer crews with voice chat\n\n- Build. Customize your own ship\n\n- Ship-to-ship cannon battles\n\n- Dead Mans Island\n\nSail Legacy is the classic 1.35 version of Sail kept alive for the community.\n\nNOTICE. If you would still like to play Sail Single Player go to the release channels, on this app and click SINGLEPLAYER then your game will. You will be able to play single player again", "short_description": "Sail Legacy brings back the classic multiplayer VR pirate adventure. Build your ship, gather your crew and sail the open sea hunting treasure, fighting skeleton raids and battling rival ships. Brave Dead Man's Island, join a public port or play with friends using a private room code. Want single player? Go to the release channels on this app and pick SINGLEPLAYER."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saillegacy.net/privacypolicy", "developer_terms_of_service_url": "https://saillegacy.net/TOS", "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://saillegacy.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "ADVENTURE", "ACTION
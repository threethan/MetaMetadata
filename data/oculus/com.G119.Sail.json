t=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1BpL_C8ThMCbkVIzfFyd4ozegQPwIP7KB7Ph9A_6vag&oe=6AF35565"}, {"file_name": "3 (2).png", "id": "1668484375020843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1668484378354176_7962183292734934927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m5jO65v37oQ7kNvwEux_Rj&_nc_oc=Adrc2oipzxKqcN7zBLToImVn5tn9W5exXn9PO5pf2Yo_CDDUd2Mjya5lsd7cPk7eKLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRluB2C8e3a5iAIdVK4lx5DJZZKwMZb4SpSIt-Rwj17pw&oe=6AF34108"}, {"file_name": "5 (2).png", "id": "2158720661435114", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654975915_2158720664768447_3652301282295472150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHQvEiZW1LsQ7kNvwEheaWa&_nc_oc=AdokgM0Rfzqi8o2C-oqrbsWCviExN6s4COOun6tYtb-5kQAMEA3as1pfJevSnvWYobo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBI5LUxZOdOAMa945nkn1CdIPHSXCviQkQrSOEtg-erQ&oe=6AF359D1"}, {"file_name": "4_1_2560x1440.png", "id": "1088211797549723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1088211800883056_3180025934390551364_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsJWESs1O54Q7kNvwHkMF1k&_nc_oc=AdpGXALIabwbXtpMtl-HXSFAs8-xds8To2fySfQgX_psL0KiLRgG32IlN3eS6Bq3rOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa9lqcdx2sC5-u7EiYgRFgUmBW1Sm5fy4mmy7kEz9-NQ&oe=6AF32C7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sail logo5.png", "id": "356739772677881", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031340_356739776011214_4752399952396963553_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Mms-J0oNgEQ7kNvwHokhnM&_nc_oc=AdpPvD4UM-lzp4FDcdOsAy2eYNLspym4N2iMtW1w6nWlmKRU7L4vt8XfgiucpXuhfSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCpGHTMJ-DvOicGSTaxplNfWtPj6MX5EOx2TCnO3BkTQ&oe=6AF332CF"}, "display_name": "Sail Legacy", "keywords": [], "long_description": "Sail Legacy brings back the version of Sail the multiplayer VR pirate adventure, just the way players remember it.\n\nFight off skeleton raids dig up buried loot, battle rival ships and bring your haul back to port. Then brave Dead Mans Island, where pirates race to find the key and claim the chest before anyone can.\n\nCrew up with friends in a room using a room code or join a public port and meet pirates from around the world. Make your pirate your own with outfits from the shop, which changes every week and earn StarCoins from the challenge.\n\nFeatures:\n\n- Multiplayer crews with voice chat\n\n- Build. Customize your own ship\n\n- Ship-to-ship cannon battles\n\n- Dead Mans Island\n\nSail Legacy is the classic 1.35 version of Sail kept alive for the community.\n\nNOTICE. If you would still like to play Sail Single Player go to the release channels, on this app and click SINGLEPLAYER then your game will. You will be able to play single player again", "short_description": "Sail Legacy brings back the classic multiplayer VR pirate adventure. Build your ship, gather your crew and sail the open sea hunting treasure, fighting skeleton raids and battling rival ships. Brave Dead Man's Island, join a public port or play with friends using a private room code. Want single player? Go to the release channels on this app and pick SINGLEPLAYER."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saillegacy.net/privacypolicy", "developer_terms_of_service_url": "https://saillegacy.net/TOS", "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://saillegacy.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "ADVENTURE", "ACTION
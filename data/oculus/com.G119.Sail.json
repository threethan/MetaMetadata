RrlI0QCP3SsQ7kNvwF1vRYC&_nc_oc=AdrVc87p237_WMhd8Trph9k7q8NrtX4Uq31w2DePkaUalgvNJFX19DDJ2lLldw8AhnE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqVq6dOl4KGqGfAUPp4bBa1IqIY341q1PFtikrWQwl3Q&oe=6AFB1BCF"}, "display_name": "Sail Legacy", "keywords": [], "long_description": "Sail Legacy brings back the version of Sail the multiplayer VR pirate adventure, just the way players remember it.\n\nFight off skeleton raids dig up buried loot, battle rival ships and bring your haul back to port. Then brave Dead Mans Island, where pirates race to find the key and claim the chest before anyone can.\n\nCrew up with friends in a room using a room code or join a public port and meet pirates from around the world. Make your pirate your own with outfits from the shop, which changes every week and earn StarCoins from the challenge.\n\nFeatures:\n\n- Multiplayer crews with voice chat\n\n- Build. Customize your own ship\n\n- Ship-to-ship cannon battles\n\n- Dead Mans Island\n\nSail Legacy is the classic 1.35 version of Sail kept alive for the community.\n\nNOTICE. If you would still like to play Sail Single Player go to the release channels, on this app and click SINGLEPLAYER then your game will. You will be able to play single player again", "short_description": "Sail Legacy brings back the classic multiplayer VR pirate adventure. Build your ship, gather your crew and sail the open sea hunting treasure, fighting skeleton raids and battling rival ships. Brave Dead Man's Island, join a public port or play with friends using a private room code. Want single player? Go to the release channels on this app and pick SINGLEPLAYER."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saillegacy.net/privacypolicy", "developer_terms_of_service_url": "https://saillegacy.net/TOS", "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://saillegacy.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "29664612083124560"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/654862493_1838576230655743_431387777833226722_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WULzHOF7-JQQ7kNvwGBO85R&_nc_oc=AdrcDui-y6iWJEas6fng8TK32kAdcZF7Pq0u5MdeCHSZtQULeehUX101L6vrPxMw9VA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY0_1nY1RfzdejTKlMZryHOsx0rC9BkoozT-in5lmq8w&oe=6AFB428B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sail Legacy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1624992604, "lastRevision": {"nodes": [{"id": "419604055979813", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4092537967425323", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_c
t=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwtm38qC-cAmFdFK5gdlow2bJIoKuOLlaprxicRJPysg&oe=6AF9B4A5"}, {"file_name": "3 (2).png", "id": "1668484375020843", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831299_1668484378354176_7962183292734934927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OMdBWHBTfwQ7kNvwE1HOCU&_nc_oc=Adoz4Q860mtXZnSsk3RuHUGwstVkafcl7cV6rmOq6MGFXVC-VNOuVHF7tQPnAVcGlsQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7LWQGRm1xbEoaawBL_roXQvEGvMycCDg1JmnEruo4tA&oe=6AF9D888"}, {"file_name": "5 (2).png", "id": "2158720661435114", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/654975915_2158720664768447_3652301282295472150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Yc30Pms6iMQ7kNvwEfWO3f&_nc_oc=AdrWbFyn7d0eQRcS3wGQM_V1Njy65KqNWHq0ELGuR9TSKxp4nluEQneAMFHIP0Q7bSk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIgGMJfaPWgPh_uAJufHSl6vVwavD19aX_0i3ToXSpEw&oe=6AF9B911"}, {"file_name": "4_1_2560x1440.png", "id": "1088211797549723", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595119480_1088211800883056_3180025934390551364_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGFFwyyFuBAQ7kNvwE0PumR&_nc_oc=AdrkmfRyazWINZbzFWpPvqmHSyGzK8fl24FPZ43WqRRtnIJ0O_fGjD0V-TAKW-VFA0Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq_LbwVdNJEGCJaPN_1tMgouehnAWh9MAX4YHPt6eEsA&oe=6AF9C3FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sail logo5.png", "id": "356739772677881", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031340_356739776011214_4752399952396963553_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrlI0QCP3SsQ7kNvwFT2uPh&_nc_oc=AdrbsW7gp0iCwxfUJJi-I3uUzZDr1G9t6A-bnN-SLD_dLj2ZHOajw4MlPGI9JnufUpo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtxRPnsUREdRefQiDl4u6ItVlBuYB0dcVEhfBLIiL4WQ&oe=6AF9CA4F"}, "display_name": "Sail Legacy", "keywords": [], "long_description": "Sail Legacy brings back the version of Sail the multiplayer VR pirate adventure, just the way players remember it.\n\nFight off skeleton raids dig up buried loot, battle rival ships and bring your haul back to port. Then brave Dead Mans Island, where pirates race to find the key and claim the chest before anyone can.\n\nCrew up with friends in a room using a room code or join a public port and meet pirates from around the world. Make your pirate your own with outfits from the shop, which changes every week and earn StarCoins from the challenge.\n\nFeatures:\n\n- Multiplayer crews with voice chat\n\n- Build. Customize your own ship\n\n- Ship-to-ship cannon battles\n\n- Dead Mans Island\n\nSail Legacy is the classic 1.35 version of Sail kept alive for the community.\n\nNOTICE. If you would still like to play Sail Single Player go to the release channels, on this app and click SINGLEPLAYER then your game will. You will be able to play single player again", "short_description": "Sail Legacy brings back the classic multiplayer VR pirate adventure. Build your ship, gather your crew and sail the open sea hunting treasure, fighting skeleton raids and battling rival ships. Brave Dead Man's Island, join a public port or play with friends using a private room code. Want single player? Go to the release channels on this app and pick SINGLEPLAYER."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saillegacy.net/privacypolicy", "developer_terms_of_service_url": "https://saillegacy.net/TOS", "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://saillegacy.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "ADVENTURE", "ACTION
y0rnIbxuOspIsJ3pyUTIlkOEeBeP18lRVIKf8bACQuuYvcp4NxLAGCyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDffRg6AeGuErp5gH1KHvZIOusbQp11rIawojLNxSIhA&oe=69A059F9"}, {"file_name": "3.png", "id": "717122002732032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001672_717122006065365_6886394787173543160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tN4__0dtzvwQ7kNvwEoCmLq&_nc_oc=AdlbnVi9s4tYgYnPexM9xllj3yww72W-mjsGN92Tt417U6zWCzT-8LJvTlYgaGL0Z88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsznQyMJOlVpiHrvm-HBeh9cuz8Mj0-Knp32A8xB11j-w&oe=69A05991"}, {"file_name": "4.png", "id": "759226668767753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_759226672101086_4654991774101485944_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_zFG7UAIZgQ7kNvwH52WaK&_nc_oc=AdnNZaGMVQacut8B6MmgVMdIQEvPMhiiBOx2-rLJnk3UtGh2F6TpvOCiKFadNOqscPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNh3WGw1Uf8s2hr5rhb8h6_pVYSaYKOM1hFzn6pjuj6g&oe=69A055B4"}, {"file_name": "5.png", "id": "5125891664146319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303837_5125891667479652_8512781975491820540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm7BHx4gTGcQ7kNvwEnuzON&_nc_oc=AdknqQsnLNSkaWBtiz8iFUdSguov-uuhMfEbu51YsA0gP33UXGPphPc2zaJhNZTqQsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLwhZMmVIaS2PFXESDoGr3WbPy_GLKE7CAuN9-wFKvgg&oe=69A04FD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sail logo5.png", "id": "356739772677881", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_356739776011214_4752399952396963553_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHjY6vW-pbcQ7kNvwF8Gp-J&_nc_oc=AdmxuqH-nU7kpTVg0-scj_3aWIoJJ8pecFQgASannluyeBQYs6DmVMQoKhCYGCqGWtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKZ0UA9q61h3y1vPzL2WbLCh8GjB4EKNYf_K1oCBfjKw&oe=69A0290F"}, "display_name": "Sail Single Player", "keywords": [], "long_description": "UNLEASH your Inner Pirate in SAIL the Open World VR Pirate game!!!\n\nEarn your Pirate reputation through EPIC voyages where you'll test yourself by collecting as much treasure as possible and bringing it back safely to your Pirate hideout.\n\nBUT BE WARNED . . .\n\nYou're not the only Pirate seeking fortune on the seas.\n\nFight off Pirate enemies on land with your Pirate weapon of choice\n\n- OR -\n\n Battle them on the seas using your ship's cannons and VOICE COMMANDS!\n\nPut your plunder to good use and use your riches to equip yourself with the best weapons and ships a Pirate could ask for.\n\nWith an Open World filled with Treasure, Mysterious Islands and limitless possibilities there's only one question to ask . . .\n\nArrrrgh you ready to set SAIL ???\n\nPLEASE NOTE: This is game is Early Access so it is not perfect and still a work in progress. We appreciate any and all feedback so leave it in a review or JOIN THE DISCORD and let us know there!\n\nTHANK YOU FOR SUPPORTING SAIL!!!", "short_description": "Open World VR Pirate Game - FREE Single Player Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
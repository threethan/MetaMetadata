N8gbmuwWCSzTDKmPn49kA8lJJvrd2HKPRjx1JA&oe=6A43BC26"}, {"file_name": "CAC.png", "id": "1225173303047134", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_1225173306380467_5634314460854525785_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIGlvzjxg08Q7kNvwENE4YU&_nc_oc=AdoI0YM2PXqfvPIzbOskFzmzQ7WaE9Cp0DSa1C7HXqx9U_dLPml8onCtCkxnjgMjMDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zSPlUXA1AzWPRZHMjPBI71ZbMZsdZOB1wHMsjovLQ0w&oe=6A43D4F5"}, {"file_name": "HMV.png", "id": "1505936720474387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_1505936723807720_5585469162487842005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgP67IXR6lMQ7kNvwHHxHD2&_nc_oc=AdpXGxIAUCQgmP8Bt1hPgFGRJsN43IyEZmQ8p-QEyI7PJ3AKnSFrrHigpJidp8kb_Q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hzAtJpXTLVFeM8ugv_VOJwKzecVzIzie-ge6eVRY2jg&oe=6A43E04E"}, {"file_name": "WD.png", "id": "1149218387284471", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1149218390617804_6416505804691019054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkpi2GvmmJcQ7kNvwGLN_uK&_nc_oc=AdqT5JYVJ_tOZT15SzU5d8Y16DwjqA8QYog4ANNe2t-SUHypkFKS2rBEZYx-hizOR64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v51EDqfF6bvep8W5ZibwVioPQ_563tflTiGtC7hQW7A&oe=6A43EAD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sol Apes", "keywords": [], "long_description": "The Rhythm of the Reach\nForget everything you know about standard \"WASD\" movement. Sol Apes is a minimalist sandbox (Will be implemented soon) designed around a singular, high-fidelity experience: The Ultimate Bounce. While other games clutter your screen with objectives and combat, we\u2019ve dedicated every line of code to the sensation of momentum. Featuring a ground-up rebuild of traditional physics, our updated locomotion system transforms the environment into a reactive playground.\n\nKey Features:\n\nTactile Locomotion: Feel the weight, tension, and spring-loaded energy of a movement engine that prioritizes \"juice\" over everything else.\n\nThe \"Flow\" State: Experience a seamless transition between jumps, rebounds, and glides that rewards timing and intuition.\n\nMinimalist Immersion: With no menus to clutter your view and no enemies to distract your focus, the world exists solely to be interacted with through your movement.\n\nReactive Environments: Every surface is tuned to respond to your velocity, creating a satisfying, rubberized feedback loop that makes \"just moving around\" more addictive than a high-score chase.\n\nIt isn't about where you\u2019re going; it\u2019s about how it feels to get there. Stop playing the game\u2014start feeling the bounce.", "short_description": "Sol Apes brings a fresh take to VR tag. We\u2019ve replaced the standard movement with a completely new locomotion system that feels distinct from anything else out there. "}]}, "developer_name": "Ven And Depout", "developer_privacy_policy_url": "https://sol-apes.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Ven", "support_website_url": null, "website_url": "https://sol-apes.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25372066279131493"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status"
ophobiavr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ScriptyGT", "support_website_url": null, "website_url": "https://sites.google.com/view/thanatophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26071814139127195"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_2141595166653804_8239088574572609083_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR-GAljTe6UQ7kNvwGP8gal&_nc_oc=AdrPstrJhmokY7WRLeBPANLbCClg5fN5CyCbyG4CRMo-oGg3o3Fu84g9CmcArYkLskM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSIi_2ra26oGAMo6wB0-AcN0x3RBnw__6VTMuRudqK5Q&oe=6AF71CAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thanatophobia", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1766073960, "lastRevision": {"nodes": [{"id": "24346035991705027", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24346035978371695", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platfo
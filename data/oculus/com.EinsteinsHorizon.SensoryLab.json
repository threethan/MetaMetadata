5079455943_3841514058909456556_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4jS8U_JKf8Q7kNvwE1MKHr&_nc_oc=AdqcesfFoH_ECu7fe4ckA58gbSZUB54XOyNK13n8SHjFTNKFpi7hgsfANX4jtJvpYxA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkBU_kYr_ON06ezwvB-u5Qmj3hlmvUNXUJz9Q760cuKA&oe=6B083F4A"}]}, "id": "1366701808644496", "locale": "en_US", "screenshots": [{"file_name": "sensory_5.png", "id": "1066721185679990", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620444_1066721189013323_7543380095039303759_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrkyuH5QIDcQ7kNvwH-FwPw&_nc_oc=AdrzfLmyk6alnyl_NuKa7yEpev9Hg9M8hFnjxsAajHWN8Qv_0OFV5krCdvRPy0FGdmM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLcXE6pSmrzIUUOLft9l2vBzrTxanOqLEPpN89klQ3yA&oe=6B0852A6"}, {"file_name": "sensory_1.png", "id": "1039924875040048", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619485_1039924878373381_8071886162672136113_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHBXgQNbvLIQ7kNvwHk-MV3&_nc_oc=AdpmGiJj_Q8aGYks86Q7BymRmI7R7I7Hs0aA8HHBofOx6R8ov75FmpLzncBHW2c4N8c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSenz6sZtZHHolOeVSF750WvprM9_qkiI-a1xZNorix2Q&oe=6B085299"}, {"file_name": "sensory_2.png", "id": "1327884926114451", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623314_1327884929447784_8057340434550199608_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uqlBEkxrkYQ7kNvwHRA9ye&_nc_oc=Ado_ana5SeS97mHUqcebE-dsQemmkueM3xg1fFU4-_sR4yMcSJNxOKGFlOM-RoKBGzQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlpk2yJgvw72BmM9-AFdQGbqw6YaWmn8566t66LdYt9Q&oe=6B087022"}, {"file_name": "sensory_3.png", "id": "1876513263020382", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301473_1876513266353715_6626482439083993949_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LysdVvfAzPgQ7kNvwG_2XBs&_nc_oc=AdrmgqQehBSTmrBMKoM_hR9MGaDXAQhpms_-vZKf5RpUPCZ4uBZTP4mqEYI6agFJRR8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1qToBc44_Z6L0SpW5HMLZkReFdnFNu3wLAeVvZ2shNg&oe=6B08440E"}, {"file_name": "sensory_4.png", "id": "981512754672311", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620432_981512764672310_9100661385534627468_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPAz1JrPnkQQ7kNvwFUAHPW&_nc_oc=Adr-mQb7w4rX56vjRTvd1JB2j8bJ_zJdHPTxgUd1PxQ8NdgLUskzF6DFxeYi0f0f5wI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTdvYPoTsNXhABBzrFEHiwdnXubq7Q1ZqWJLuzC3cbAg&oe=6B083CF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "2072924130320554", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623443_2072924133653887_1469046441357198279_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q32Kq6D7ifoQ7kNvwEh8smD&_nc_oc=AdraoJXbnDuNwZ3-e2p-dZ1-k9T-TrjugD8laff3qB-70MXBpwsCB7ibhf0MSjWIwiw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1BstD1a07psCohU_R8PdXM0wxP5SBvnqv5ON7qVtp2w&oe=6B08431A"}, "display_name": "Anatomy Learning Labs: Sensory Lab", "keywords": ["anatomy", "eye", "sensation", "hearing", "learning"], "long_description": "Step into the Sensory Lab of the Anatomy Learning Labs series, where the systems of vision, hearing, smell, and taste come to life in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Sensory Lab teaches elementary, middle, and high school learners how sensory organs detect information and how the brain processes these signals into perception.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities.\n\n\u2022    Travel through medical imaging views that reveal the eye's structure, similar to a CT scanner.\n\n\u2022    Select any structure to hear Dr. Hana Sato, your virtual guide, identify it by name.\n\n\u2022    Use natural hand-tracking to grab, rotate, and closely inspect the brain's cortices, olfactory structures, eye, ear, tongue, and taste buds.\n\n\u2022    Explore cross-sectional anatomy of the head to discover how smell, taste, hearing, and vision connect to the brain.\n\n\u2022    Step into Mini Mode to shrink down and examine the microscopic structure of taste buds and sensory tissues.\n\n\u2022    Assemble the human eye in a guided 3D puzzle.\n\n\u2022    Test your knowledge through audio-guided quizzes and fast paced Knowledge Knockout game led by Dr. Sato.", "short_description": "Step into a sensory system lab and explore how the human body sees, hears, smells, and tastes in stunning 3D. Travel through medical imaging views, examine the eye, ear, tongue, and sensory regions of the brain using natural hand-tracking, and hear Dr. Hana Sato identify anatomical structures by name. Assemble the human eye in interactive 3D puzzles, test your knowledge with quizzes, and reinforce learning through engaging challenges designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [
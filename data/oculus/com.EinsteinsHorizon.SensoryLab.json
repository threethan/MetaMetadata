b=1-7&_nc_sid=6e7a0a&_nc_ohc=qb9y8k1n3zgQ7kNvwElVDiQ&_nc_oc=AdrYG4rP-sLhVtYFZXWiy4cJdhvXd5apHJiK3XXpB8JQ_rINJx-rtQaLyiKuP0lkmGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj0DdN7TGOnHP7P-WJYloKRVJFoq3D2RFi7QmAFRMgGg&oe=6B03364E"}, {"file_name": "sensory_4.png", "id": "981512754672311", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620432_981512764672310_9100661385534627468_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mno3XRVtHPYQ7kNvwGY93kV&_nc_oc=AdqQXvfVZxyOfZYWeeb1G3LsFt6kWkDrIzjoWLsS01e6iLzid9RwgOHR--QwbqNR4AE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNjJqwEddXXLXXnqlBpTcWg1ShObpUYCVIZumTJE3ieQ&oe=6B032F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "2072924130320554", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623443_2072924133653887_1469046441357198279_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z82wlryXEi0Q7kNvwERpwTD&_nc_oc=AdrrJIZ9c0gH1fXnam_HNrNzgkZWD-s45Qh5gTzlsXQGbQHsI8OEXauh_Bpi_auDU8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREoD0QMsV2tnz_6zr8RcvXBFRpw6N9Pf_kGHYbTMMNOg&oe=6B03355A"}, "display_name": "Anatomy Learning Labs: Sensory Lab", "keywords": ["anatomy", "eye", "sensation", "hearing", "learning"], "long_description": "Step into the Sensory Lab of the Anatomy Learning Labs series, where the systems of vision, hearing, smell, and taste come to life in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Sensory Lab teaches elementary, middle, and high school learners how sensory organs detect information and how the brain processes these signals into perception.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities.\n\n\u2022    Travel through medical imaging views that reveal the eye's structure, similar to a CT scanner.\n\n\u2022    Select any structure to hear Dr. Hana Sato, your virtual guide, identify it by name.\n\n\u2022    Use natural hand-tracking to grab, rotate, and closely inspect the brain's cortices, olfactory structures, eye, ear, tongue, and taste buds.\n\n\u2022    Explore cross-sectional anatomy of the head to discover how smell, taste, hearing, and vision connect to the brain.\n\n\u2022    Step into Mini Mode to shrink down and examine the microscopic structure of taste buds and sensory tissues.\n\n\u2022    Assemble the human eye in a guided 3D puzzle.\n\n\u2022    Test your knowledge through audio-guided quizzes and fast paced Knowledge Knockout game led by Dr. Sato.", "short_description": "Step into a sensory system lab and explore how the human body sees, hears, smells, and tastes in stunning 3D. Travel through medical imaging views, examine the eye, ear, tongue, and sensory regions of the brain using natural hand-tracking, and hear Dr. Hana Sato identify anatomical structures by name. Assemble the human eye in interactive 3D puzzles, test your knowledge with quizzes, and reinforce learning through engaging challenges designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [
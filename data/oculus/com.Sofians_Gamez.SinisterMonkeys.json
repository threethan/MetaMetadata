b=1-7&_nc_sid=6e7a0a&_nc_ohc=WLtvmJvnJiEQ7kNvwGCP7WS&_nc_oc=AdkY1CP4w4LhKDwE9mdEl290pSJCA_bYFGuG27IS9iLVUeKw9SI-_pqQeUNo4Vvm4j0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afwj68EugMugHz186JWkgpWyayQLoa2kpvsqtY_Rm8GZUQ&oe=69AAE20B"}, {"file_name": "gfadgfadagdfagfd (1).png", "id": "1477827330164783", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299789_1477827336831449_4383353662331199903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg85_N4tSoEQ7kNvwF0jh-t&_nc_oc=AdmY1ADKznhvaovQufE9QRApyM4vj6v0_I9BayOu7rBtrmVhj05dFdccwRUcifiijKU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwaX6B0T283tYHtcEqbncFwugsq7Uk-kE5QTlxh-kipQ&oe=69AADD1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sinister Monkeys", "keywords": ["Monkey", "Baboon", "Scary", "Ape", "Gorilla"], "long_description": "Sinister Monkeys\n\nWelcome to Sinister Monkeys, a psychological horror experience where every level pulls you deeper into madness.\n\nYou are a lone monkey\u2014trapped inside a decaying mineshaft overrun by shadows and echoes of failed experiments. Something hunts you in the dark\u2026 and it learns with every encounter.\n\nFace the terror alone, or team up with friends in co-op mode to survive what lurks beyond the next door. Each level is a test of instinct, courage, and sanity.\n\nUncover the truth. Escape the mineshaft.\nIf you can.", "short_description": "Sinister Monkeys\nDescend into Sinister Monkeys, a psychological horror where each level drags you deeper into madness. Trapped in a decaying mineshaft filled with shadows and failed experiments, something hunts you\u2014and it learns. Face the terror alone or with friends in co-op mode. Every step tests your instinct, courage, and sanity. Uncover the truth. Escape the mineshaft\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sinister-monkeys-vr/home", "developer_terms_of_service_url": null,
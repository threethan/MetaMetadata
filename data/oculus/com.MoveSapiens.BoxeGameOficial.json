=6e7a0a&_nc_ohc=wdKkZR9zKsEQ7kNvwEvs6EU&_nc_oc=Adqz9F_Bq2ngk1oxDj85nFibT7S8nqNZ2z7Y7MXIHVmcnYKFKvcbkNt0lHAlJeKH4Sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfBZAe9_RD6iEo_2nOYIxqHSLzQHHLKVeWTs2770ex5A&oe=6AD234A2"}, {"file_name": "movesapiensbattle.png", "id": "194179610438844", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036696_194179613772177_1573978079084844927_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXmeFsB_NM0Q7kNvwESQ_CW&_nc_oc=Ado4JDaeN4FeSiiIpUiN58V5e3npJ4A1S32_QywPCPrFn9ccA805TN2V6vin8VXUZg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3jowPxjFvzk4eE4_2RFy1xv3_qkQLsufCzSfbt4ERpw&oe=6AD2359E"}, {"file_name": "movesapiensdrone.png", "id": "764669845469577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_764669848802910_7366831044223632089_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tfZUprMSXcQ7kNvwFaUd9x&_nc_oc=AdoxGRZyKWm7rklVsK2H0nGSa98J-kbCVzNgzJ4b_wrD7i8oJUNbPGVW6QHI3ef2zB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVodlOX-e5rutoAGsDoAX_1R3LoGXkMnTiyH65aiZGKg&oe=6AD2494B"}, {"file_name": "movesapiensready.png", "id": "337520715646442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_337520718979775_5518724192048290935_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U13mhYUtCSIQ7kNvwFVtObt&_nc_oc=AdqXNy17SC1nK6EEtMpbqX63-rXW-fTNJluBf3dL4F9SgXfRQ11GwoFgqR2oTBYBsao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGPkXT7mybFyqc8svsZGaDoB2A32-DSVqdwYfDvyiJqA&oe=6AD22B35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YbdN_7Bi18Q7kNvwF-yB5u&_nc_oc=AdpfzunJ5u-m_4kHw3Rx0sHQ20xoOq6XhI47qGA7H3_ua52-zSiFd7LIdIV6lHJ_Ju4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHrvJ7McvFOXWb6ZUwaIQXUJp5Z-lRIBueiVCkf_gJNg&oe=6AD24DD2"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url": "https://www.instagram.com/movesapiens", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7307344169333163"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "381510010882569"}]}, "baseline_offer": {"id": "381510010882569"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1702913902, "status": "PUBLISHED", "id": "381510010882569"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8683703225030577", "version": "1.0"}, "id": "1693684374429751", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7202306709836910", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8683703225030577"}, "release_status": "RELEASED"}, "binary
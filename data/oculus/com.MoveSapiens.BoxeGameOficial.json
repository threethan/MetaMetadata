1-7&_nc_sid=6e7a0a&_nc_ohc=YVcSl3oodacQ7kNvwGEVLXR&_nc_oc=AdrE_UcYDosaEm2ZFgLrEFCfSVaH2CMjyNSCsPMv5foRGptf3G_7V09ZCA_NXN4ev5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyWI0QHTZgPR5o4bipgT9d_6-j6ebFR0C73UDnhduxqw&oe=6A5F6420"}, {"file_name": "foto7.png", "id": "1200958077910790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1200958081244123_917649329002123938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cu_np0C6gN4Q7kNvwGGLp38&_nc_oc=AdpmZfUzdX6z7QeEMObuG6jDr3fgX2jhLE_6ak0b_J8EZdJSOXtiVfM0gwInLuwBC9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIMxc9Jk4nTuHpIdQDADOt6c7CAuENo8ZAOFJ1JrfT1g&oe=6A5F71C7"}, {"file_name": "Foto8.png", "id": "1052062059604410", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_1052062062937743_918130921635033274_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caruOl_RRDkQ7kNvwF5uM4H&_nc_oc=Adr6qxGupjNxCxPsnT7sVY-C_hzgU1zmB9gL7_iRmEfunUJW4iIcO9o5CoM8UYDyEJw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH2z-qJCvXxgT3rNvkeWBx3qsei5UckEXaJ2pcn1cVNA&oe=6A5F8A0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGLMBk_v2H0Q7kNvwFfkfCC&_nc_oc=Adp4mJsSq0hqjs8K1xtvJ8rB8sCwQ8oQDwBn15smbuZmyaf7hq_g2Psctq73LaCmVxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs133l2jyffibanfkZVnG-t-hlWnHtjlfqJFRx4VNfmA&oe=6A5F6312"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url
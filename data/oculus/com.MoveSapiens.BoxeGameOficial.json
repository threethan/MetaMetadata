KmJ4dso7fi6yOV4u3nuvv1OMGd50orxr9oLdOwg&oe=6B0476A4"}, {"file_name": "foto6.png", "id": "1176312066910649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_1176312070243982_78269700638180420_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF4xm5UBzcsQ7kNvwED2jRW&_nc_oc=AdpBrxpQgBvLwVEONw6k7bq87zI2BctkTaoohYmd_XILaqnRWsmOjLYa4NMuD_KOwko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcm_kS0yo3jKPf8KJqy9s8DvCWdrb_T2vzkK5l0VdFTA&oe=6B0467E0"}, {"file_name": "foto7.png", "id": "1200958077910790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_1200958081244123_917649329002123938_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faZ8kM562sQQ7kNvwE0W9El&_nc_oc=Adp2KjtXWgBE75dZHoPf1KyDVXElK1zl6XvjYfmcnHFE5N4TFg6R_iNxtxL6hS47HJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1oKpSNVjQT9sLkk46TvNVWi_kMGsyVLcDgc6zF06Nlw&oe=6B047587"}, {"file_name": "Foto8.png", "id": "1052062059604410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_1052062062937743_918130921635033274_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZpU94Dp4xkQ7kNvwF-aJn6&_nc_oc=Adr3pSp0woilpGmc7W0vrfJdpywwWPQcv3nPjyXx4dVLR1LCuXa21XuRBEtnNhr1HRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2fnbOFvV2hbNSTaZ1-41A21D5c4VraSxNd_0w6iVf-g&oe=6B04558E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tf6N4w6-toQ7kNvwHSA7u3&_nc_oc=AdrSe6tt3gIKAczN8H2hf1k-uBKTOw1j9sjYA7zouWHlao1cTr3zFuVbgaxi-3-s_UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu7vkdBwZaG4Ow8bwk4VNKouDAp2wXxQQsJDjjtIBr_g&oe=6B0466D2"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url": "https://www.instagram.com/movesapiens", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8778580652209500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_766857752154497_83673424735597901_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IaUyX9K50kQ7kNvwEqW6sS&_nc_oc=AdrWS_1QxB480YzlWTeiq6uUH4kUuGJ310B-luWc3bbLzaUgqia3uduWgU9W14_GAOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlrag8H9pobPLlWmpG0YLiJDteYA9EhZqX2NzvBF6O1A&oe=6B04806B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Move Sapiens Ltda", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1702913902, "lastRevision": {"nodes": [{"id": "7202306739836907", "release_type": "SCHEDULED", "administration_status": "APPROVED
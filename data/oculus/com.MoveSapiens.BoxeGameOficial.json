1-7&_nc_sid=6e7a0a&_nc_ohc=2eIAw3VTz7QQ7kNvwHZumzW&_nc_oc=Adq8aONTMwl3Z8UayM525PppF9F87nT2KMpBp4y89MlvoL4QSub0Tda5pCTsBgXngZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA2LsvTLHtzvdk-Envi7hlY7fbrwIn40W2x8o0P5Dvag&oe=6AA543A0"}, {"file_name": "foto7.png", "id": "1200958077910790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_1200958081244123_917649329002123938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58906zG55qgQ7kNvwFsc4lH&_nc_oc=AdpoEMoF5PrxxV94NJSfIG8kcHbY1lrK2To1XCHwidM1WkUznDb75UXFf2lfJqJLk28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqlBO6w5ERCPYNsBUQS6cM6y12y9q3evnFD_GrebAB7A&oe=6AA55147"}, {"file_name": "Foto8.png", "id": "1052062059604410", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572954_1052062062937743_918130921635033274_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnocLy25NFMQ7kNvwElOWMY&_nc_oc=AdpmpzGaT8puxgA2oNpUq24vtFX_R-jNIpx3FeB9Hm966OBVhksWb8bOeOa1qf5K6D8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnzo7v9HyDr3ZyJkp1xoLG-3FsNqjGJN8W_uUH73IlsA&oe=6AA5698E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwvLi5rLxjAQ7kNvwFdAPeP&_nc_oc=AdrqfOmtD2AcwM2rZXBy_76bavyfXgeAaqt9rC4Oh3CgR797k3sysHh0Y0lQz7Cek-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRX6MbFyXHvRafCaCiVM4WU2D1fVBP2lqutdNOewfgeA&oe=6AA54292"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url
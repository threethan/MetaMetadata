mZK9MTomJxlv3teoc1AZjv4BWjh7CyH0x67244w&oe=6B0F02A4"}, {"file_name": "foto6.png", "id": "1176312066910649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_1176312070243982_78269700638180420_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6akODMCkCAQ7kNvwG_16Kp&_nc_oc=AdrFjO1bkUVl0SmBPgw1q6rbS7vQQIUkicCWXP266AqYV-c46nXVBnjJYbFR3FAuDP0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXY_LhoaOVfhAuVP-i7fuhox8VPGBj-Wma1NnhbtConQ&oe=6B0EF3E0"}, {"file_name": "foto7.png", "id": "1200958077910790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_1200958081244123_917649329002123938_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmmsdfb6ZssQ7kNvwHrQK7J&_nc_oc=Adpl7YMAhc0hzWofvENuJiFDHARUhABU2NPwUWjm9nXbFzU2CgS2yQxx0tkWbf5wYzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVvpQVzRW4NjyPK7_AcfQXfISXSCICM4FpIH7ucL6PtrQ&oe=6B0F0187"}, {"file_name": "Foto8.png", "id": "1052062059604410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_1052062062937743_918130921635033274_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s87JCSbQZbgQ7kNvwGv-4q3&_nc_oc=AdrLIw8FXfz_96Pw8-97g1lECCiGrMKZ34h7oqwT-sbRPbl9Nogqfa8m1N7jsMT28SI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_RTLWvnMLzclMpO8Y_o-rOhxcXFUqN6xreK4F6Kcz9Q&oe=6B0F19CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzf8BFXgW38Q7kNvwH4nDv2&_nc_oc=AdpMEhZE3HngBcdThJ_wRn1z6SRW2MdswUODpp_Bok7tRASoSCm8flekAvKRFQKDVrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxXe5HAUMD25RQh7XVcqxUBocuuc_iCwJKN6z3AfmgRA&oe=6B0EF2D2"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url": "https://www.instagram.com/movesapiens", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8778580652209500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221331_766857752154497_83673424735597901_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLpSf2283fEQ7kNvwFxUWwS&_nc_oc=AdoFlmmDrE3uG5zlaJ65lXZVIDUHTH6PRUPmbJC086SayoJjFP85xCtZMD2qJ04tI0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJt77S9a0FOaMr4M3aWSRaVyNbODwXlOuJhHh-wCAYKg&oe=6B0F0C6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Move Sapiens Ltda", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1702913902, "lastRevision": {"nodes": [{"id": "7202306739836907", "release_type": "SCHEDULED", "administration_status": "APPROVED
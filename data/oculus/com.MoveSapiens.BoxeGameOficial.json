1-7&_nc_sid=6e7a0a&_nc_ohc=m7Gxzz06uOMQ7kNvwH8xOeb&_nc_oc=AdqPjP23q7cE9VGDdMCurG_4WU4VtlSNoCB0U05_NU-k2wSooSXjdcl8stLe7K2erbI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa3cLzcfZeqhbcdHBxp_MNYHQ0HoywAFg7FrTpUeQsZA&oe=6AF0A160"}, {"file_name": "foto7.png", "id": "1200958077910790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_1200958081244123_917649329002123938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMPpbszm18Q7kNvwEZpEGI&_nc_oc=Ado-yfw7FZ8TTr2ypD2cyPD3MTIdpak_yQpHMJ8uuDjbNRfYIGMvVwn0o3Z2LsWnz7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtpNIoqRcWDt2MJUdvysBMARhYIrf5pnSazS2bNlc8fA&oe=6AF0AF07"}, {"file_name": "Foto8.png", "id": "1052062059604410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572954_1052062062937743_918130921635033274_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBLiPp7TroEQ7kNvwFmDKrr&_nc_oc=Adqq5ijXmkuVrQ4lUWrlEBGqDtkRVDNdoqgeKSGvb-5ev8SxIKgDuCIVI8DNdGsisFE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRMf3PPOeROqkyrihaDef-aH1NY12SfgcrEp6gyAP2cg&oe=6AF08F0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEmcwlIoJ50Q7kNvwH7xkAr&_nc_oc=AdpzW1NgVyVcijMycTQBcQJkqsUzEOW9zhGk3NgbjJ0oANbvV8xyAnEahx_T858pky0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrkWf7FwQ2wDONIiN4Rtkj5H1BrMrmdwtTFrk2BL1Raw&oe=6AF0A052"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url
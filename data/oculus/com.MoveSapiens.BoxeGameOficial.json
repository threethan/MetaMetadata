1-7&_nc_sid=6e7a0a&_nc_ohc=YUtkFHa71_UQ7kNvwGG0Gtp&_nc_oc=Adq36RZdx_XBEfYGNDEcI42xVHWJn3-mNqMnSpP3lQbacWaXNXT1ssdnNJzVloTDryY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs57lZb2N1CIkIbR9aSdxhEqbW37ugrfNNnL7rjcWkiQ&oe=6A9733A0"}, {"file_name": "foto7.png", "id": "1200958077910790", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974497_1200958081244123_917649329002123938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfRt-JxYlY8Q7kNvwEUOyY_&_nc_oc=Adr606yR7HWpcocl3npeoRmOmW4jJdsHPJpd-5meujbhtnpxY1xtGH-OiVdihLlWmS8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJXslz8xRh_SGoE27ZHUpg0cNlUjojccau7MfLUyvYTA&oe=6A974147"}, {"file_name": "Foto8.png", "id": "1052062059604410", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57572954_1052062062937743_918130921635033274_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgspEXUBdFkQ7kNvwHCndGM&_nc_oc=Adru-p15MU49amCTZui8nlsl6Af1gLLF8WQi04BkH7Zn8K_ZcPwF-QJlZmvFcmobPec&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8J-ziLSGhFOv6AFVp1ZUpdwIVGpBri8cv3BHgrHpwRQ&oe=6A97214E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSyFXJhUoOwQ7kNvwEIFm27&_nc_oc=AdrZJ1K-c_zIJQjsrSWHDvm6iQFcoAcZMs1ovva4RBPwWOy6B4m6fgeiq0jVWGl-kPw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4bu2Hp75qBrtzqgfQOHs9vs9QWezI1QP1TGK2H_Idnw&oe=6A973292"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url
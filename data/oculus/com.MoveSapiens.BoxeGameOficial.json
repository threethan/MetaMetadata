1-7&_nc_sid=6e7a0a&_nc_ohc=SJs_oHb82ngQ7kNvwEE7iQ6&_nc_oc=AdqDUM6Gt_T_gNAqKN_fJNZKjgdxPBP6qvR-SliQ3duSUNcn4geb1Uij87TWEZbp0uI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n94K0Ef0ZSb8NoEjccv0JRZ7sKF1EyB8s85T0GzCT6Q&oe=6A450620"}, {"file_name": "foto7.png", "id": "1200958077910790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_1200958081244123_917649329002123938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9iwnZUUYoYQ7kNvwFZkfL6&_nc_oc=AdpSwBAgX3XMGIT-hUqbH_87bOTgZvUwbfhmYBDgS3BPuKWox5UvCh7Uk_NbAzcBVw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S3nnIMbqQvZveJQqxdrN_0oEiikXULpThzKick-HoiQ&oe=6A4513C7"}, {"file_name": "Foto8.png", "id": "1052062059604410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572954_1052062062937743_918130921635033274_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_bFNS3mrEgQ7kNvwGRHASM&_nc_oc=AdqjZ3MezivCQzI5LZoMgggBF-zSd2XHEKj0mEQ32tL4l9BIt4l_nNU0jAysRzpTLvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zMsxymYTUOpYWv437lrT-jEdAPvkSossFB3ZUQEZWnQ&oe=6A452C0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "movesapiensbattle.png", "id": "369502332406406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_369502335739739_4753847007498255395_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6JCWZ_-tKQQ7kNvwFd0lVu&_nc_oc=Adohr3u4KfI-HK4-yoX3cnzRwSlrthP3azDP3USEXo_lVqoRrD7p_VOjaBuCljPtLWM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jsm8i695bp-weuwycUa5xsULVb8e8-qTapP3PU5HivQ&oe=6A450512"}, "display_name": "Move Sapiens Ltda", "keywords": [], "long_description": "Dive into the year 2107 with \"Move Sapiens Exoskeleton VR,\" an Oculus App Lab sensation blending HIIT (High-Intensity Interval Training) and virtual reality gaming. As a symbol of constant evolution and scientific validation within sports science, this game is more than just an experience\u2014it's a revolution.\n\nYou'll be greeted by S.A.I.H.A., your Symbiont Artificial Intelligence for Human Augmentation, integrated into the groundbreaking Move Sapiens Exoskeleton. In a dystopian world dominated by omnipotent corporations, your mission is clear: evolve, adapt, and dismantle the tyrannical forces. Train rigorously against a reprogrammed drone, enhancing your physical and cognitive abilities symbiotically.\n\nOur game boasts a unique Kinetic Energy Optimization System, allowing you to absorb and manipulate energy, granting unprecedented powers. The training comprises 12 blocks of intense 16-second HIIT boxing sessions, with 20 seconds for kinetic energy reloading. Every punch counts, monitored for speed and strength.\n\nAs you master kinetic manipulation, S.A.I.H.A. offers real-time data processing and strategic insights, optimizing every move towards liberation. The game is an immersive journey, a synergy of biology and technology, pushing you beyond human constraints. Be part of the vanguard, embody the nexus of human spirit and artificial intelligence, and forge a new era of freedom and justice.\n\nJoin us in \"Move Sapiens Exoskeleton VR\" \u2013 where gaming meets evolution, and every move", "short_description": "\"Move Sapiens Exoskeleton VR\" is an Oculus App Lab game set in 2107, where players train in a dystopian world using the Move Sapiens Exoskeleton and AI S.A.I.H.A. The game combines HIIT with VR, focusing on physical and cognitive enhancement through rigorous training. It features a unique Kinetic Energy Optimization System for absorbing and manipulating energy, with gameplay involving intense HIIT boxing sessions. The game aims to push players beyond human limits, blending technology and biology"}]}, "developer_name": null, "developer_privacy_policy_url": "https://movesapiens.my.canva.site/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "https://www.instagram.com/movesapiens", "support_website_url": null, "website_url
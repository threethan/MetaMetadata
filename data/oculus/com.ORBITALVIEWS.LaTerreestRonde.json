dP4UF17BrdpoeMmxJl2x0K3cG0dhi56vP3R6tf4M&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe3UvtO9_bslHVLvJG9DrBPa22rigC7ToR8tBlCiXDTw&oe=6A91818D"}, {"file_name": "Screenshot_C1.png", "id": "1757464732284558", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825257_1757464735617891_3439448723179904928_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5CfaCBn1pkQ7kNvwG5Uy9x&_nc_oc=Adqq9WDMGr_IpGutqchEi1Ln6QHU_o-NxQL9elOLCI7VYDRb5iFdVLHCZUWccWbRS5U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ2CuI6BoH0LpPfywnS6RYvpG9nvacEHJ3NKJyACDuMg&oe=6A9162A9"}, {"file_name": "Screenshot_C2.png", "id": "2075477833326007", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823783_2075477836659340_9081838472428724810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5_yKZGjHL4Q7kNvwFjsaxx&_nc_oc=AdrZULPbZcJcGw7dM09Gi9d8sKEPP_corC7sJ8eltJOeHBAYySmSL_FzN92AS0jmylE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFpj7vuuXKSNWBbzO2GQhn_IHvDHYun4ztJ83xkg4MdQ&oe=6A917E37"}, {"file_name": "Screenshot_C3.png", "id": "875159662302851", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/593990472_875159665636184_533254773452323523_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfoB_7zCKjoQ7kNvwHGkBw9&_nc_oc=Adp7xrDppmqw9ZW5QJlJ2JnvDiDbEfSMkOMrfpxrMYjMHgigpbYL3O6S0AymejxVGBA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsHDGUXlc3uqzHBI-SiviFl_UJkGFuXLSurgfno6rpig&oe=6A918B85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Earth is round", "keywords": ["Education", "Sandbox", "Science", "History", "Space"], "long_description": "Dive into the heart of Antiquity and discover how scholars revealed that the Earth is spherical.\n\nImagined by the Space Department and the Time and Space Laboratory teams at the Paris Observatory, this immersive experience places you in the shoes of great thinkers of ancient times and invites you to experiment for yourself.\n\nExplore three interactive workshops and encounter, through thought, great minds such as Eratosthenes, Aristotle, and Pliny the Elder. Grasp their insights, retrace their methods, and experience the power of simple observations that transformed our understanding of the world.\n\nThrough experimentation, rediscover how observation and reasoning enabled scholars to comprehend the world, long before modern technologies.", "short_description": "Travel back to Antiquity and discover how the first scholars demonstrated that the Earth is round. Recreate their experiments: measure shadows in the manner of Eratosthenes, simulate eclipses, and explore what the horizon reveals. An interactive experience presented by the Paris Observatory."}, {"images": {"nodes": [{"file_name": "logo FR_trans.png", "id": "4158282391130584", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499313072_4158282394463917_92584586360233504_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YunSKMgnEiQQ7kNvwGAtJ_z&_nc_oc=Adp4ZMOhHtutGbRRaltQZxYOoG31z0zZjlPweHQt8ZuU5yREqRVLNU8asM74hH44oa0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0QWyAdcIyZaXxnvgA8b_gjZ4FOT4R_Qx1YHrVhstPwQ&oe=6A91682E"}, {"file_name": "Cover2_FR LANDSCAPE_square_portrait.png", "id": "3031630510526628", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491827626_3031630513859961_7277487456001196397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSwn80pTIVcQ7kNvwFftQLR&_nc_oc=AdqZQmFU__XM5vDb6GlPVEtyqycl8NQX5M5IwyZPX7_ynUtfPW_aP9Ky0yR7QWZ24o8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOoUbwTaC85iOYfbh4eM0sIopX-ZlU7YWycQXsKv-RFg&oe=6A917412"}, {"file_name": "icon_trans.png", "id": "1556471572525199", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/595136811_1556471579191865_5707153332690753058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_
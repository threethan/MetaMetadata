dVdFQevin0XcDweAu0ChZWz6zI3uZZ1h20AWmSsryXVwgUqHK2ri69207SWR4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_BS17AbK7FKf8WFyGzG99X9UqShJ6jN5ZZaznqf_RSg&oe=6A916E87"}, {"file_name": "Screenshot_Key.png", "id": "1544813410343538", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491828008_1544813413676871_591505897233208349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeFFK29oBnoQ7kNvwGBftzu&_nc_oc=Adq8_EfVVqNvnP5bNBa43K5Ub2od2Q1W4YG5nLxFs7SBh5LiafNi15-v4mZRtR_alFk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEycoyo0KdvvA0td-NMVT-r2t9v8DbwsXkshE4LwxfY1g&oe=6A9179AC"}, {"file_name": "Screenshot_C1.png", "id": "1669639527652571", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824700_1669639530985904_602461258779068862_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGGv7WU0UdcQ7kNvwFW0mSE&_nc_oc=AdoAKWbzeBgUftSW_zZwzk33QVrKyBjkkM1sJkRm_gh-SV5uXZywgCj6yuInC5NNb6Y&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaKa70GeldSINCO2eM8QK8cWZkf2qoxafD5CH0I4SxWQ&oe=6A918216"}, {"file_name": "Screenshot_C2.png", "id": "1018988647312663", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491825503_1018988650645996_2222831659375120859_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEllySBmbrIQ7kNvwHGEGZW&_nc_oc=AdpLH_Jd2yiullA5qipKpMETtY96v-e6CW58WsGlVBuHXrFhfNBXCYltmJWknLdhLts&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbATCyCOKxH9i_nVJ2EgNQ4CRc1LLwsGmlbiaXXw1FOQ&oe=6A91881C"}, {"file_name": "Screenshot_C3.png", "id": "2028803294677095", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823366_2028803298010428_4292452015394984140_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYyulbd89-8Q7kNvwGf9BUa&_nc_oc=AdqfWaN3irNs3idKlU3RGMjIGen6DaMZCzO28Nv-n3TPFuJx-vHQ_C2HS4KoSSuXmIA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDZ1xGxciSkWCvZpL2rqqucQb-r9pjgqMfzQAAvVBCkA&oe=6A916A41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La Terre est ronde", "keywords": ["\u00c9ducation", "Science", "Sandbox", "Histoire", "Espace"], "long_description": "Plongez au c\u0153ur de l\u2019Antiquit\u00e9 et d\u00e9couvrez comment les savants ont r\u00e9v\u00e9l\u00e9 que la Terre est sph\u00e9rique.\n\nImagin\u00e9e par le Service Espace et l\u2019\u00e9quipe du Laboratoire Temps Espace de l\u2019Observatoire de Paris, cette exp\u00e9rience immersive vous met dans la peau des penseurs de l\u2019\u00e9poque et vous invite \u00e0 exp\u00e9rimenter par vous-m\u00eame.\n\nExplorez trois ateliers interactifs et rencontrez, par la pens\u00e9e, de grands esprits comme \u00c9ratosth\u00e8ne, Aristote ou encore Pline l'Ancien. Saisissez leurs intuitions, rejouez leurs d\u00e9marches, et \u00e9prouvez la force d\u2019observations simples qui ont chang\u00e9 notre vision du monde.\n\nGr\u00e2ce \u00e0 l\u2019exp\u00e9rimentation, red\u00e9couvrez comment l\u2019observation et le raisonnement ont permis aux savants de comprendre le monde, bien avant les technologies modernes.", "short_description": "Remontez \u00e0 l\u2019Antiquit\u00e9 et d\u00e9couvrez comment les premiers savants ont d\u00e9montr\u00e9 la rotondit\u00e9 de la Terre. Recr\u00e9ez leurs exp\u00e9riences : mesurez les ombres \u00e0 la mani\u00e8re d\u2019\u00c9ratosth\u00e8ne, simulez des \u00e9clipses et d\u00e9couvrez ce que r\u00e9v\u00e8le la ligne d\u2019horizon. Une immersion interactive propos\u00e9e par l\u2019Observatoire de Paris."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.orbitalviews.com/round-earth-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Orbital Views", "support_website_url": null, "website_url": "https://www.orbitalviews.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "
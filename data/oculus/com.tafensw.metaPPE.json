&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dpm8ckP7vAQ7kNvwGGw6m6&_nc_oc=AdrIsNgG2xfKRyoReWiGfvmw-uYafseRI9jocWpKzzKn1v6Zu6Y5C3rahO-zeA1e5zg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBJ441j0YnOCl1KWX94lSLwD6PW9bLNs0p8d2dZRBUJw&oe=6AFDD093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta&TAFE_PPE_icons_WIDE2560.png", "id": "3224434664437673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982601_3224434667771006_7731989109123112177_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpXsgztBBnsQ7kNvwEXj2b1&_nc_oc=Ado952J0Nh70lW0Km_LzkiRpp9DtrTQCvPc6khKv51VlgTQtkklvU2JJRxvRa2PkPUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs4Zv4OowOn7ZPppszZwQZyTyfZkqxz-agaiZ7PPCeDw&oe=6AFDDB6E"}, "display_name": "Personal Protective Equipment (PPE)", "keywords": [], "long_description": "PPE is a standalone experience that allows players to assess their knowledge of the personal protective equipment (PPE) required to participate in various key workplaces. Workplaces include a construction site, a science lab, a welding bay, a veterinary x-ray clinic and a commercial kitchen. The PPE selector, at the beginning of experience, can be used to select the specific workplace the player will be assessed on.  \n\nPlayers select appropriate PPE items and \u201cdress\u201d a virtual mannequin to show their knowledge of the PPE requirements of specific workplaces. Once complete, their attempt is assessed automatically, and feedback is given accordingly.  ", "short_description": "PPE is a standalone experience that allows players to assess their knowledge of the personal protective equipment (PPE) required to participate in various key workplaces. Workplaces include a construction site, a science lab, a welding bay, a veterinary x-ray clinic and a commercial kitchen."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_term
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYK43tdTq5cQ7kNvwEX1Khy&_nc_oc=AdpRCkb-y25e6sgoV3MkSInD4pDL1PdCdVBjtpzvbLdl62aV-Y41cqCBqLTfnvVes7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuYxcW7B5ghphzr6qUuL-0A4Y5aCuYHd-aO8fQ5y9FIA&oe=6B031693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta&TAFE_PPE_icons_WIDE2560.png", "id": "3224434664437673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982601_3224434667771006_7731989109123112177_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISCM_E8uh8EQ7kNvwEc3qSX&_nc_oc=AdoF38nzOgrUdDnMNgjjZpGD3sK6EiZy6k5ahGGrRYjHy3gkrWCW_0mOK7IDGJAZt1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0jAs6M3Zr33aXhhi9P6LAeOs3R48QtQ4v1K3uXvnxDw&oe=6B03216E"}, "display_name": "Personal Protective Equipment (PPE)", "keywords": [], "long_description": "PPE is a standalone experience that allows players to assess their knowledge of the personal protective equipment (PPE) required to participate in various key workplaces. Workplaces include a construction site, a science lab, a welding bay, a veterinary x-ray clinic and a commercial kitchen. The PPE selector, at the beginning of experience, can be used to select the specific workplace the player will be assessed on.  \n\nPlayers select appropriate PPE items and \u201cdress\u201d a virtual mannequin to show their knowledge of the PPE requirements of specific workplaces. Once complete, their attempt is assessed automatically, and feedback is given accordingly.  ", "short_description": "PPE is a standalone experience that allows players to assess their knowledge of the personal protective equipment (PPE) required to participate in various key workplaces. Workplaces include a construction site, a science lab, a welding bay, a veterinary x-ray clinic and a commercial kitchen."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_term
rbSyJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bcsr_ityAO63JYoUbR9IMkD_nHPQaVWetsTbHa5ZJeQ&oe=6A3AB293"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta&TAFE_PPE_icons_WIDE2560.png", "id": "3224434664437673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982601_3224434667771006_7731989109123112177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwWvONL0nOQQ7kNvwHlTXa1&_nc_oc=AdqBAWBMxLXSe4hIOorMpAxCCIHgg1F1133p5lEXA6Jcx1SmwNMG2stVAxyZKtyWW4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dq8WKYme0J9jaBpXu28YvanJKgq4Ed4X1rNY5JyFJww&oe=6A3A852E"}, "display_name": "Personal Protective Equipment (PPE)", "keywords": [], "long_description": "PPE is a standalone experience that allows players to assess their knowledge of the personal protective equipment (PPE) required to participate in various key workplaces. Workplaces include a construction site, a science lab, a welding bay, a veterinary x-ray clinic and a commercial kitchen. The PPE selector, at the beginning of experience, can be used to select the specific workplace the player will be assessed on.  \n\nPlayers select appropriate PPE items and \u201cdress\u201d a virtual mannequin to show their knowledge of the PPE requirements of specific workplaces. Once complete, their attempt is assessed automatically, and feedback is given accordingly.  ", "short_description": "PPE is a standalone experience that allows players to assess their knowledge of the personal protective equipment (PPE) required to participate in various key workplaces. Workplaces include a construction site, a science lab, a welding bay, a veterinary x-ray clinic and a commercial kitchen."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_url": null, "website_url": "https://www.tafensw.edu.au/", "category": "APPS", 
-7&_nc_sid=6e7a0a&_nc_ohc=8lSMua9MF1YQ7kNvwHPXC0K&_nc_oc=AdrWD7LtqYGVNvTrlZ3ypYRHV2UME6ExaKj1eqkd41WUCi4TusQqypUefLg2UpBxT3E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRODtilAqRADIgCyjOUv3LCehwsYP8TLJlFWTwR3dp6Tg&oe=6B0B153F"}, {"file_name": "01-plant-model.png", "id": "2885192831867129", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839744_2885192838533795_2022926176320895647_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XHDnl1dr1sQ7kNvwFQXhn1&_nc_oc=AdpdAKLQU6FzuoeXtA9og_bLUdKWOqcqe4duMhT6rkWi75dmKh8mXIHti07lU81FHQQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYmDTDtDtiI2kTnhwliRHgQ1U8pw-MhSPe9KbVjH9KDQ&oe=6B0B3ACD"}, {"file_name": "04-detailed-dimensions.png", "id": "2077142079669840", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839669_2077142083003173_3748864899032635690_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7vKW8Tp7K0Q7kNvwEvTmFS&_nc_oc=AdpctSMa3yPxPyib17jWcvzJ5kGNcfAcDSb6trWCwg8zlJNGCmAqrq3kTPQNwfxzP-k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKRgCPbm1ePmsCVKag0yk5sdhH4M_EJh8RUFWRMrIiIQ&oe=6B0B378A"}, {"file_name": "05-pid-lookup.png", "id": "1040849169026993", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839724_1040849172360326_7718384863667290122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdtfUM8r0i8Q7kNvwHmBYdO&_nc_oc=AdpOhez-gqY62IInOpdBw5Qn7J-cIZ-2Z6YXjVC1k9pbOLnoBorLj8Yq066Yw-OhZao&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlYcttOW9fqkD-CD8SyLGfWTavOMkSRZxyD1j4vpvjPQ&oe=6B0B2E4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlantNext XR Viewer", "keywords": ["Plant3D", "piping", "construction", "BIM", "MixedReality"], "long_description": "From searching through drawings to selecting piping directly in the field.\n\nPlantNext XR Viewer is a mixed reality (MR) application that overlays 3D models of industrial plant equipment onto the real world, allowing users to access essential construction information directly at the worksite.\n\n\u3010Key Features\u3011\n\u30fbDisplay 3D models of piping, valves, equipment, and other plant components in mixed reality\n\u30fbSelect components to view their properties and attributes\n\u30fbSearch and filter by piping line numbers and equipment identifiers\n\u30fbDisplay navigation guidance to locate searched components\n\u30fbView detailed piping dimensions\n\u30fbCheck center-to-center dimensions, elevations, and distances from reference grid lines\n\u30fbAlign 3D models with the real-world environment\n\u30fbView PDF drawings\n\u30fbOcclusion support, allowing real-world objects to visually obscure virtual 3D models\n\n\u3010Free Sample Project\u3011\nThe application includes a built-in sample project, allowing users to experience its main features free of charge.\n\n\u3010Using Your Own Projects\u3011\nPlantNext XR Viewer is free to download.\n\nTo view your own industrial plant 3D models, you must import compatible project data prepared on a PC.\n\nProject data is created using PlantNext Publisher, a Windows application. Creating Pro project data requires a separately purchased Windows software license.\n\n\u203b Compatible with Meta Quest 3 and Quest 3S.\n\u203b Designed for construction and plant engineering applications.\n\u203b The application interface is available in Japanese only.", "short_description": "View industrial plant 3D models in mixed reality. Inspect piping, equipment, and construction information in your workspace. App interface is available in Japanese only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://plant3d-dx.com/plantnext/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Plant3D-DX", "support_website_url": "https://plant3d-dx.com/plantnext/inquiry/", "website_url": "https://plant3d-dx.com/plantnext/", "category": null, "comf
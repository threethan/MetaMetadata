306b\u3088\u308b\u691c\u7d22\u30fb\u7d5e\u308a\u8fbc\u307f\n\u30fb\u691c\u7d22\u5148\u307e\u3067\u306e\u8a98\u5c0e\u30ca\u30d3\u3092\u8868\u793a\n\u30fb\u914d\u7ba1\u306e\u8a73\u7d30\u5bf8\u6cd5\u3092\u8868\u793a\n\u30fb\u914d\u7ba1\u306e\u82af\u3005\u5bf8\u6cd5\u3084\u9ad8\u3055\u3001\u901a\u308a\u82af\u304b\u3089\u306e\u8ddd\u96e2\u306a\u3069\u3092\u78ba\u8a8d\n\u30fb\u73fe\u5b9f\u7a7a\u9593\u3068\u306e\u4f4d\u7f6e\u5408\u308f\u305b\n\u30fbPDF\u56f3\u9762\u306e\u8868\u793a\n\u30fb\u30aa\u30af\u30eb\u30fc\u30b8\u30e7\u30f3\uff08\u73fe\u5b9f\u306e\u7269\u4f53\u306b\u3088\u308b3D\u30e2\u30c7\u30eb\u306e\u906e\u853d\u8868\u793a\uff09\n\n\u3010\u7121\u6599\u30b5\u30f3\u30d7\u30eb\u3011\n\u30a2\u30d7\u30ea\u306b\u306f\u30b5\u30f3\u30d7\u30eb\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u304c\u4ed8\u5c5e\u3057\u3066\u304a\u308a\u3001\u4e3b\u8981\u6a5f\u80fd\u3092\u7121\u6599\u3067\u4f53\u9a13\u3067\u304d\u307e\u3059\u3002\n\n\u3010\u72ec\u81ea\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u5229\u7528\u3011\n\u672c\u30a2\u30d7\u30ea\u306f\u7121\u6599\u3067\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u307e\u3059\u3002\n\n\u72ec\u81ea\u306e\u30d7\u30e9\u30f3\u30c83D\u30e2\u30c7\u30eb\u3092\u8868\u793a\u3059\u308b\u306b\u306f\u3001PC\u5074\u3067\u4f5c\u6210\u3057\u305f\u5bfe\u5fdc\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30c7\u30fc\u30bf\u3092\u8aad\u307f\u8fbc\u3080\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\n\n\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30c7\u30fc\u30bf\u306fWindows\u7528\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u300cPlantNext Publisher\u300d\u3067\u4f5c\u6210\u3057\u307e\u3059\u3002Pro\u30c7\u30fc\u30bf\u306e\u4f5c\u6210\u306b\u306f\u3001\u5225\u58f2\u308a\u306eWindows\u7528\u30e9\u30a4\u30bb\u30f3\u30b9\u304c\u5fc5\u8981\u3067\u3059\u3002\n\n\u203b\u672c\u30a2\u30d7\u30ea\u306fMeta Quest 3 / Quest 3S\u5411\u3051\u3067\u3059\u3002\n\u203b\u5efa\u8a2d\u30fb\u30d7\u30e9\u30f3\u30c8\u30a8\u30f3\u30b8\u30cb\u30a2\u30ea\u30f3\u30b0\u5206\u91ce\u3067\u306e\u5229\u7528\u3092\u60f3
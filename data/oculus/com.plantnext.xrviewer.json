rlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23aZ2wXUtJkQ7kNvwGaDMi8&_nc_oc=AdriKKe4zwaaBuUrsEJp71Io6yWR0eoXbh1IUpPMWEJKFnxIVqMPwACiofSnHaXkTfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUp-HLQaydvCy_ZXWaYWwNjAscRRwUX4iemxSrHPIH8Jw&oe=6B0F09BF"}, {"file_name": "01-plant-model.png", "id": "2885192831867129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839744_2885192838533795_2022926176320895647_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Pgq6XWNfTwQ7kNvwGuvD3P&_nc_oc=AdqMsEcze9PFGBbL9mvIKyj3Ot4x3w7CHWPgsRZEfhhZT74yKQFvaGj5ydRQPlbzEco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2Grl4ghqYRJOskOOJ-fcwMfClm2hfmG6YIxZJFkNmgQ&oe=6B0EF70D"}, {"file_name": "04-detailed-dimensions.png", "id": "2077142079669840", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839669_2077142083003173_3748864899032635690_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65SAXU5z_kMQ7kNvwEUJ9a4&_nc_oc=AdoEr1Qr1AQpLX3s-T3hQMMcRpSP8AWSXaA0kLQ9WBURCIf95GKojiBGabJoBcUchY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXaGNoqzAeDFZ6jfcSddR8-tH02I-SXf9SBcCO2bnrlRA&oe=6B0EF3CA"}, {"file_name": "05-pid-lookup.png", "id": "1040849169026993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839724_1040849172360326_7718384863667290122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Te4opI1vKUQ7kNvwExBm2m&_nc_oc=AdoFgU0G5KlbgP3WnL71TP3Minv_iuy9bGwctGHeYsk51lv2999c6vo5254QKUxV8-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-Mcf2p80NQZs9ZSL3Q9G0Y532PtPQj9VFq5SIcZB5ZQ&oe=6B0EEA8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlantNext XR Viewer", "keywords": ["Plant3D", "piping", "construction", "BIM", "MixedReality"], "long_description": "From searching through drawings to selecting piping directly in the field.\n\nPlantNext XR Viewer is a mixed reality (MR) application that overlays 3D models of industrial plant equipment onto the real world, allowing users to access essential construction information directly at the worksite.\n\n\u3010Key Features\u3011\n\u30fbDisplay 3D models of piping, valves, equipment, and other plant components in mixed reality\n\u30fbSelect components to view their properties and attributes\n\u30fbSearch and filter by piping line numbers and equipment identifiers\n\u30fbDisplay navigation guidance to locate searched components\n\u30fbView detailed piping dimensions\n\u30fbCheck center-to-center dimensions, elevations, and distances from reference grid lines\n\u30fbAlign 3D models with the real-world environment\n\u30fbView PDF drawings\n\u30fbOcclusion support, allowing real-world objects to visually obscure virtual 3D models\n\n\u3010Free Sample Project\u3011\nThe application includes a built-in sample project, allowing users to experience its main features free of charge.\n\n\u3010Using Your Own Projects\u3011\nPlantNext XR Viewer is free to download.\n\nTo view your own industrial plant 3D models, you must import compatible project data prepared on a PC.\n\nProject data is created using PlantNext Publisher, a Windows application. Creating Pro project data requires a separately purchased Windows software license.\n\n\u203b Compatible with Meta Quest 3 and Quest 3S.\n\u203b Designed for construction and plant engineering applications.\n\u203b The application interface is available in Japanese only.", "short_description": "View industrial plant 3D models in mixed reality. Inspect piping, equipment, and construction information in your workspace. App interface is available in Japanese only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://plant3d-dx.com/plantnext/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Plant3D-DX", "support_website_url": "https://plant3d-dx.com/plantnext/inquiry/", "website_url": "https://plant3d-dx.com/plantnext/", "
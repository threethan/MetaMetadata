hc=lVfs__8YrzYQ7kNvwEnc0Io&_nc_oc=Adn05dt4tWASuGEw-sPPdXNXZB3_3uqH5Yp-J8LWeA6yrVlLmT3R8nnmdPAUpgZ9jfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuTT4NP74Kkk-S1xZq7dKa5AT8-c1zko1VYQMZIjptmAw&oe=6999B45F"}, {"file_name": "MountainMap.png", "id": "236155306004996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86629766_236155309338329_5652908726960707139_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsMvsW6UF1AQ7kNvwHE-LZX&_nc_oc=AdmCjrLUgzQOaAUpcap5l9H5YQi6f4xFe1LB2klRkdusMgOm6OtoIxuVnBkCvmp-1JY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvKBAIgRnmBk-IJbNbL5TKEhc4xvZrKhUq-2fgzaKcKDg&oe=69998F08"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlY1GE7rJvsQ7kNvwH_vwh5&_nc_oc=Adm1dC_f5hUKuGG5n3eYBse4agiJhLA6smDmNdAiDSHaOSHeBbWQ8LtKqATJuf-MD8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvi5965mRA4pep45SU2jU90TR3_BNzepa-AVdQZWos-Fw&oe=6999B7FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J7-MFNNSjEQ7kNvwHXi6jb&_nc_oc=AdnsiA1IsMXB__E71xZRVciWft5-fquTs9VR8g-xzVtFPTCKSTFc4p7ibTYDU7O6734&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftY7yxewlxaDijmmKGIK9q5VdLuMkB1gk3GPOwcnr2VUQ&oe=69998F50"}, "display_name": "Control Tower VR", "keywords": ["airplane", "plane", "atc", "flight", "controller"], "long_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3-dimensional space to guide each aircraft to its runway while avoiding other aircraft and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter, and zeppelin. Each aircraft present a different set of characteristics, for example, a glider cannot climb unless it is in an updraft.\n\nThere are 2 game modes: Play Now and Career.\n\u201cPlay Now\u201d is an open-ended gameplay; the player must safely land as many aircraft as possible while the difficulty increases over time. \u201cCareer\u201d is also open-ended gameplay but requires a minimum target score to a medal which unlocks the next map. Career mode offers a variety of challenges such as UFO attacking your planes or having airplanes go next to a point of interest before landing. \nBoth Play Now and Career has 5 different maps, each presenting a different set of challenges. ", "short_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3 dimensional space to guide each aircraft to its runway while avoiding other aircrafts and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter and zeppelin on 5 different maps. Each aircraft present a different set of characteristics, for example a glider cannot climb unless it is in an updraft."}]}, "developer_name": "Digital Emergence Ltd", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence Ltd", "support_website_url": null, "website_url": "https://controltowervr.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
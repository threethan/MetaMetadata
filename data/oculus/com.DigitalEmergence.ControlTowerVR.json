ng?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3zZLOwgtLIQ7kNvwGSwCNd&_nc_oc=Adp9J6Bsbl1x_6BC6TTT-8FmcfXNQU1IhcPVFCyJx6uS9ikC-33Xl9jz2q2bhBptUcM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfrsHYdPOw_O6H0KyLbfozjlQ8gZBLSSob4u-LHwpjxA&oe=69C11C08"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6Ry8CLcIzYQ7kNvwEnQjPD&_nc_oc=AdqIz16SN5gzlP-NeF2OnBx3bHJJxRlk0EZTlOFt0_uJyyDpXP4jYmbba62oh8RzpiQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyf1cyA6ui_W5uyEAOpkOYTwB94ATzfkXate6gxGkZUMQ&oe=69C144FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-aXyTso7vwQ7kNvwGadHv_&_nc_oc=Adpv3gwKPLIFNwyMaewk23Y_29FL0HgpQwg-sEaPf_gF-YDhH3KJfhv9gUgMgJu6UG8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQy_iE_it9US4uDGNIcg46VMGf4P1vuhWZy6YDHq6pSQ&oe=69C11C50"}, "display_name": "Control Tower VR", "keywords": ["airplane", "plane", "atc", "flight", "controller"], "long_description": "Control Tower VR puts you in the role of an air traffic controller in full 3-dimensional space. Draw flight paths to guide aircraft safely to their runways while avoiding other aircraft and obstacles in the environment.\n\nFive types of aircraft must be managed: commercial airliners, private planes, gliders, helicopters, and zeppelins. Each behaves differently, for example, gliders cannot climb unless they are inside an updraft.\n\nThe game features two modes: Play Now and Career.\n\nPlay Now offers open-ended gameplay where you land as many aircraft as possible while the difficulty gradually increases.\n\nCareer mode is also open-ended but challenges you to reach target scores to earn medals and unlock new maps. It introduces special scenarios such as UFOs attacking your planes or aircraft that must fly past points of interest before landing.\n\nBoth modes feature five different maps, each presenting its own unique challenges.", "short_description": "Control Tower VR puts you in the role of an air traffic controller in full 3D space. Draw flight paths to guide aircraft safely to their runways while avoiding collisions and obstacles. Manage five aircraft types (airliners, private planes, gliders, helicopters, and zeppelins) across five maps. Each behaves differently: for example, gliders can only climb inside updrafts."}]}, "developer_name": "Digital Emergence Ltd", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence Ltd", "support_website_url": null, "website_url": "https://sites.google.com/view/digitalemergenceltd/control-tower-vr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26530017653316753"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003240_1608195706340658_8885868801352132357_n.png?stp=dst-png_s3
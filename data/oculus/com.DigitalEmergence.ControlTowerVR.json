582473025617254_8880973784013326554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFuwiROz_U0Q7kNvwFX3Bk_&_nc_oc=AdkObM6vKbAIFDpK4DXF7a9g33LwuT80c7qZPFxlg_VOUCqQrOFFjLfsNb8ALUV7ZP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZ63RGhhfMYrSWi360JH1D8saDGtiofWs2NHN9xfNuVg&oe=69B806DF"}, {"file_name": "MountainMap.png", "id": "236155306004996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86629766_236155309338329_5652908726960707139_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naA3ZdBr-DMQ7kNvwH6F5p_&_nc_oc=Adm1EOtLiWklqX_SclGD1s1k-xIxdTZ8Z1KI5UEF8RdB4vA5taNMV7m7BXz7CYqkcnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afznsis1T2Z5MoLUHTLLXjwzGO0Tu3ondvamdBQgZdguPQ&oe=69B7E188"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kuny7k82GIQ7kNvwERPz1E&_nc_oc=Adl8NM7_duczCrKz0-5MpJsHCieRmFD4egdbtqXAnRRPqtARSFADveaY3qFimcPco4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz67sCeufWVhEVSSsvHdrjCV45YBD-i-UqTkW3vRO-5jg&oe=69B80A7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqkx5cPYfdIQ7kNvwEtmZju&_nc_oc=AdnmEvPMggInFM4GBtjz604AXZDznMa5P9-Ea1fOhl6uwBRpGMc54Pebse4ik9f468Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyro4chjU7PMz7QlWJuNbTHRwPwpspzWS6exC7VP7QivA&oe=69B7E1D0"}, "display_name": "Control Tower VR", "keywords": ["airplane", "plane", "atc", "flight", "controller"], "long_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3-dimensional space to guide each aircraft to its runway while avoiding other aircraft and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter, and zeppelin. Each aircraft present a different set of characteristics, for example, a glider cannot climb unless it is in an updraft.\n\nThere are 2 game modes: Play Now and Career.\n\u201cPlay Now\u201d is an open-ended gameplay; the player must safely land as many aircraft as possible while the difficulty increases over time. \u201cCareer\u201d is also open-ended gameplay but requires a minimum target score to a medal which unlocks the next map. Career mode offers a variety of challenges such as UFO attacking your planes or having airplanes go next to a point of interest before landing. \nBoth Play Now and Career has 5 different maps, each presenting a different set of challenges. ", "short_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3 dimensional space to guide each aircraft to its runway while avoiding other aircrafts and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter and zeppelin on 5 different maps. Each aircraft present a different set of characteristics, for example a glider cannot climb unless it is in an updraft."}]}, "developer_name": "Digital Emergence Ltd", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence Ltd", "support_website_url": null, "website_url": "https://controltowervr.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
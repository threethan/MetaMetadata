hc=GWzvjIsulZwQ7kNvwG9gxLa&_nc_oc=Adk_7c-P-m1HOIR09qjS_X4SzyxU5QUwseCF0uZM-9DZTuOQflJY_9jCo9GxpxunPks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvXFDuyIS714Ioc9tJ0xOQzz4HVl_qzRWL-vnjUMgZq-A&oe=69A4405F"}, {"file_name": "MountainMap.png", "id": "236155306004996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86629766_236155309338329_5652908726960707139_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0cUswjbPRgQ7kNvwFFCGH1&_nc_oc=Adl4kaXdJqtm0p05-Qll_GqpqnDSDNO3fxEjVfWOvG-CpNLEqyss0Bn8piktI3oNgaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft9GustN5a-kc4J1kJTbUQAXwHdRXZOWviSMCqpvCPPvw&oe=69A45348"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4uzq7yI5hgQ7kNvwFohgIZ&_nc_oc=AdlppqVxq3M63sN7eAgT3lcVDhpARlcpUzcpG2ENeXVrA4R91s9hUFvrAeuPwIvnjHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvVlJf0L-Mvw5hYEG2hFrY2zTNd2VxRiesbNUkWcejV1Q&oe=69A443FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb0VroaPkr4Q7kNvwGOy6FG&_nc_oc=Adnj1lV20MRH8eQHEfHX6tF78W62PuAa6M1kXZ55Ej1BHxbXqqG0djhB4WNq_UjgnTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfssoDxxK1tHLG9OLna5zl0d9F_rlXt1idB3WzO_UaOoBA&oe=69A45390"}, "display_name": "Control Tower VR", "keywords": ["airplane", "plane", "atc", "flight", "controller"], "long_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3-dimensional space to guide each aircraft to its runway while avoiding other aircraft and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter, and zeppelin. Each aircraft present a different set of characteristics, for example, a glider cannot climb unless it is in an updraft.\n\nThere are 2 game modes: Play Now and Career.\n\u201cPlay Now\u201d is an open-ended gameplay; the player must safely land as many aircraft as possible while the difficulty increases over time. \u201cCareer\u201d is also open-ended gameplay but requires a minimum target score to a medal which unlocks the next map. Career mode offers a variety of challenges such as UFO attacking your planes or having airplanes go next to a point of interest before landing. \nBoth Play Now and Career has 5 different maps, each presenting a different set of challenges. ", "short_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3 dimensional space to guide each aircraft to its runway while avoiding other aircrafts and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter and zeppelin on 5 different maps. Each aircraft present a different set of characteristics, for example a glider cannot climb unless it is in an updraft."}]}, "developer_name": "Digital Emergence Ltd", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence Ltd", "support_website_url": null, "website_url": "https://controltowervr.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
82473025617254_8880973784013326554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A_Yx78xXrcQ7kNvwFJS4vT&_nc_oc=AdnSuXWU5wtl4P4FdUJ1MbRKmCCTOF9WIhYqt8s7d_vpUQNPowXQzdqW-4VJlkUI-gY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuV8cGatdUdxj4J7WheUkUPjrh-Pe3YoaABU2-ot8x2HQ&oe=69A834DF"}, {"file_name": "MountainMap.png", "id": "236155306004996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86629766_236155309338329_5652908726960707139_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYPts_qb4N4Q7kNvwFeQYYZ&_nc_oc=AdmdBqo3gaYNc-bXgZ9gaMeywCu28aqU5hmHPeL7ob2_BpxU9jd_J0pEHy98bhJOO-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftq-aMNwyVPuxicMAmdb6LZSO-5qhOqBfJiz7EYwD7eEQ&oe=69A80F88"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jFl-zoW_qMQ7kNvwEPTX51&_nc_oc=AdkxOCgIzW6hydCAZtyMFEis88OUMkJqYcZtq_WcXuSXj1PH2cXvRixd3ti8vxiSK3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuZQ_--illUFF2VBHZo-orYD32JERch3fc5eHUtMJ6voA&oe=69A8387B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdlHwzMaGkoQ7kNvwFhOZcF&_nc_oc=AdnTPRFRwXK8J06ShT-RgudI6zVx5Zmg7v5HiVqUvzdI2YsAN09mU8NsH5NopuC2BFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afthv3JgAZyHMJ0NR7dtqWFhOKjhOkGTLrEmOuXZOO84GQ&oe=69A80FD0"}, "display_name": "Control Tower VR", "keywords": ["airplane", "plane", "atc", "flight", "controller"], "long_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3-dimensional space to guide each aircraft to its runway while avoiding other aircraft and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter, and zeppelin. Each aircraft present a different set of characteristics, for example, a glider cannot climb unless it is in an updraft.\n\nThere are 2 game modes: Play Now and Career.\n\u201cPlay Now\u201d is an open-ended gameplay; the player must safely land as many aircraft as possible while the difficulty increases over time. \u201cCareer\u201d is also open-ended gameplay but requires a minimum target score to a medal which unlocks the next map. Career mode offers a variety of challenges such as UFO attacking your planes or having airplanes go next to a point of interest before landing. \nBoth Play Now and Career has 5 different maps, each presenting a different set of challenges. ", "short_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3 dimensional space to guide each aircraft to its runway while avoiding other aircrafts and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter and zeppelin on 5 different maps. Each aircraft present a different set of characteristics, for example a glider cannot climb unless it is in an updraft."}]}, "developer_name": "Digital Emergence Ltd", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence Ltd", "support_website_url": null, "website_url": "https://controltowervr.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomme
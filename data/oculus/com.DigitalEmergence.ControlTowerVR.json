oh=00_AfuiZaDLW0k-2gD8FESDAubRx3OrlFui-nG6jdtsmM1K0A&oe=699DA8DF"}, {"file_name": "MountainMap.png", "id": "236155306004996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86629766_236155309338329_5652908726960707139_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE5C99CZN9wQ7kNvwFf3U5K&_nc_oc=Adm59hpUKPklWDfPlNdjKxyV0R1-SVJ4G_ws2XndJjNmShezwYbBi1w8jeZyD3l1SGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcZp4ZEuOr02w1AyY9Nuj7ig2_ydRNum5pj2dAXoYudQ&oe=699D8388"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8v9dOwowFgQ7kNvwHhaUqY&_nc_oc=AdnME2SolVZldymp5rzjGdV1C6XI300av0K20Fjho0a-bNUAeCSRx0RuN7RbM_yHJMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-I2Zki_ga8Vr2FkcAjMmscEPtlSAUKp5hn2Y7jF8mJg&oe=699DAC7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGpeMzIE6HAQ7kNvwHkCRpg&_nc_oc=AdkngG3dIas941QkocQ9hjLDG2qeVHykXn0VlqkykOcH0SJvuRR6m6I7bGpGj4oJdNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMfSrn9w1UE2grFV6L9D19M_uNURf_Jcf33TY4kMXR-w&oe=699D83D0"}, "display_name": "Control Tower VR", "keywords": [], "long_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3-dimensional space to guide each aircraft to its runway while avoiding other aircraft and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter, and zeppelin. Each aircraft present a different set of characteristics, for example, a glider cannot climb unless it is in an updraft.\n\nThere are 2 game modes: Play Now and Career.\n\u201cPlay Now\u201d is an open-ended gameplay; the player must safely land as many aircraft as possible while the difficulty increases over time. \u201cCareer\u201d is also open-ended gameplay but requires a minimum target score to a medal which unlocks the next map. Career mode offers a variety of challenges such as UFO attacking your planes or having airplanes go next to a point of interest before landing. \nBoth Play Now and Career has 5 different maps, each presenting a different set of challenges. ", "short_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3 dimensional space to guide each aircraft to its runway while avoiding other aircrafts and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter and zeppelin on 5 different maps. Each aircraft present a different set of characteristics, for example a glider cannot climb unless it is in an updraft."}]}, "developer_name": "Digital Emergence", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence", "support_website_url": null, "website_url": "https://controltowervr.weebly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "293879949993838"}}]}, "schedule
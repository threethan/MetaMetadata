582473025617254_8880973784013326554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_x_XedT9uAQ7kNvwEto1gb&_nc_oc=Adn_4m2ryKy0Y_LtvqnpDekZUkqqSrM0VZNIGe-TEGMl1eMWM2y_XoMHrGiJY9Imtok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPjpfqETOu4iBG7erRFzqpl3nayXHzBp8BQTGKZA7aEg&oe=69B6B55F"}, {"file_name": "MountainMap.png", "id": "236155306004996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86629766_236155309338329_5652908726960707139_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naA3ZdBr-DMQ7kNvwG8CrEl&_nc_oc=AdnifaGVe1crr8exJIUoFjMO3H4yhkV_mqnO_c2nA1b5fjq3XxGc7e5dIvX2fM7yKMg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkceKIqhmISWqdM5ovPZ7FJU3I7O_hZ6pqWYlv-xjgKQ&oe=69B69008"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kuny7k82GIQ7kNvwHQTvKD&_nc_oc=Adnskd8f_sPKngUG33_9Cc8qvO-y_dHAlPVA3YZSEmq21YblDCENxiA68w3wMf3sevY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7DH7LqKoKq7vHvoh5H1gdpq2lPiIusoXU2Viyzi4vKA&oe=69B6B8FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqkx5cPYfdIQ7kNvwHYzaFm&_nc_oc=AdmjlkH5la3rE_hViqBHfU7UuEQAQgRPbWiTUKXwLCaMr03oW7VNfbvOhLr7zNeFhWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLKcBWBvQ_vfNJQ96-Z-z0y6ggCrQ7hTUcdED4bFj_eQ&oe=69B69050"}, "display_name": "Control Tower VR", "keywords": ["airplane", "plane", "atc", "flight", "controller"], "long_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3-dimensional space to guide each aircraft to its runway while avoiding other aircraft and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter, and zeppelin. Each aircraft present a different set of characteristics, for example, a glider cannot climb unless it is in an updraft.\n\nThere are 2 game modes: Play Now and Career.\n\u201cPlay Now\u201d is an open-ended gameplay; the player must safely land as many aircraft as possible while the difficulty increases over time. \u201cCareer\u201d is also open-ended gameplay but requires a minimum target score to a medal which unlocks the next map. Career mode offers a variety of challenges such as UFO attacking your planes or having airplanes go next to a point of interest before landing. \nBoth Play Now and Career has 5 different maps, each presenting a different set of challenges. ", "short_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3 dimensional space to guide each aircraft to its runway while avoiding other aircrafts and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter and zeppelin on 5 different maps. Each aircraft present a different set of characteristics, for example a glider cannot climb unless it is in an updraft."}]}, "developer_name": "Digital Emergence Ltd", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence Ltd", "support_website_url": null, "website_url": "https://controltowervr.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
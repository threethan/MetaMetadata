hc=dt5CDffnp-wQ7kNvwGYhyhR&_nc_oc=Adk44uRdcQkKlL9FhtYcqFTwi98l9Y_2Iq_YNTFJ6b1qxXsdQhUFbg2m60kmThfbiQI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsyyLzjD3l6Z5JSjmIA9AVYJZuJVl1iXR8DUdFDJXXzYw&oe=69A19D5F"}, {"file_name": "MountainMap.png", "id": "236155306004996", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/86629766_236155309338329_5652908726960707139_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0cUswjbPRgQ7kNvwFYUgKV&_nc_oc=AdmoODb9Yjw65CsO08Iqf-eLkQdr283pVZPuN3tKJrCQoht_ssx0we8VBMw-M95U9xc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsa1wW2dVfAf-gcuLElI1W_7QpzuVd44lz0OrMPz3KYkA&oe=69A17808"}, {"file_name": "CityNightMap.png", "id": "814210383701157", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75392879_814210387034490_2905782898928723536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4uzq7yI5hgQ7kNvwHSRRiU&_nc_oc=AdkRHH6BV3-t8PW-XZmqPE43JN9PlrQoPUN5JFsoQYdy8DSFFhEo0a4VbwBALS8i9Fs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvWEsXEi6Wv2pVQ7W0O63WTviwWkpJHzlCNJTrftb6WCw&oe=69A1A0FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ControlTowerVR_Oculus_Banner_Large.png", "id": "1462741121195775", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75303840_1462741124529108_7229600463246882697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb0VroaPkr4Q7kNvwHkMxFM&_nc_oc=AdnyCftbD_VdW5hbTBcg1sMyqMBxv8kSc0NIy4-wFzkZq-nr4PRoaa1W6EYRi4O8rD8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvc1vcTelpL24nOQ5_nx6OgtdBX_BGyjRIegFF8Dsrhlg&oe=69A17850"}, "display_name": "Control Tower VR", "keywords": ["airplane", "plane", "atc", "flight", "controller"], "long_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3-dimensional space to guide each aircraft to its runway while avoiding other aircraft and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter, and zeppelin. Each aircraft present a different set of characteristics, for example, a glider cannot climb unless it is in an updraft.\n\nThere are 2 game modes: Play Now and Career.\n\u201cPlay Now\u201d is an open-ended gameplay; the player must safely land as many aircraft as possible while the difficulty increases over time. \u201cCareer\u201d is also open-ended gameplay but requires a minimum target score to a medal which unlocks the next map. Career mode offers a variety of challenges such as UFO attacking your planes or having airplanes go next to a point of interest before landing. \nBoth Play Now and Career has 5 different maps, each presenting a different set of challenges. ", "short_description": "Control Tower VR puts the player in the role of an air traffic controller that draws lines in 3 dimensional space to guide each aircraft to its runway while avoiding other aircrafts and obstacles in the environment. There are 5 types of aircraft to land: commercial airliner, private plane, glider, helicopter and zeppelin on 5 different maps. Each aircraft present a different set of characteristics, for example a glider cannot climb unless it is in an updraft."}]}, "developer_name": "Digital Emergence Ltd", "developer_privacy_policy_url": "https://controltowervr.weebly.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Emergence Ltd", "support_website_url": null, "website_url": "https://controltowervr.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
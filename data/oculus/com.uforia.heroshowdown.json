d=6e7a0a&_nc_ohc=xQg8MG4XOTYQ7kNvwEYfuTQ&_nc_oc=Adp1bEsn7N9F8XKs9ocSWqPeL84SI0ZQaP1YE-AEpJqsjkZ_nhP7XNQynAgxrLQlQsA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQQN3cswjxUxfkZsZd-Bk3lR2o3uQu_PDwwdvi5fKPwQ&oe=6ACD010A"}, {"file_name": "migrated_image.png", "id": "1067341576982177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162811_430027997343545_6873559063725080576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S9O7nUe274Q7kNvwHRxsww&_nc_oc=AdrYUxBZVFCdxZFrnzZeRMrW3m4e27Md5Cb4n58gpXY48HUxriRr7Q15m_YoUn3Epgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2YQZCM2JD85GFYP1eNZo_lcE8JtCuXDVtre2KJAyO_g&oe=6ACCFA23"}, {"file_name": "migrated_image.png", "id": "646879289429877", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162718_273000173154444_433343220705918976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaSMCJGtgysQ7kNvwHKNeQj&_nc_oc=AdqOcf7hW_eszyMK9FUgPkYNIO3b7sY_G70tCiFuCqbp9hVyh3LjNxz6fuyZ-PaDITc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHoBaias4EA8U0hmDSTyuE8kwc1mARtnpoUHP7pm9z7Q&oe=6ACD116C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero Showdown", "keywords": ["hero", "showdown", "skydive", "shoot", "destruct"], "long_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nHeadquarters gets a call that a mysterious danger has been developing in a deep region of the badlands. They summon you, one of their greatest heroes -Lazer Face- to discover the source of the danger and to battle whatever may come. You wake up moments before being hurled to the ground for an epic hero landing  to crack the ground beneath, and quickly discover the dangers of this unknown region!\nBlast away both enemy and environment around you! Survive the onslaught, decimate everything, win!", "short_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nImagine becoming a super hero with the ability to shoot beams of concentrated power from you face. You wake up to a pilot telling you some people hired you to go kill some stuff, and that you need to jump out of the ship from 1 thousand feet up to do it. When you land you then blow up everything around you to survive! 35 levels, over 10+ baddies, destructible environment, destructible enemies, and power-ups!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://uforia.com/ptos/", "developer_terms_of_service_url": "http://uforia.com/ptos/", "publisher_name": "Uforia", "support_website_url": null, "website_url": "http://HeroShowdown.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669651704072625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602290_402787233416307_3006445719579000832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gtnE6BnIYsQ7kNvwE_qIPp&_nc_oc=AdryF7Nku7cbK-BcyNjyTlp1HCssvJNl1745xbn1CAHLTrVYjtHMQfnQcidigAUiaFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo3DIBWt7qLmXVYy31qfVNjOix3dpuLCR5zzUNnoGsIQ&oe=6ACD0E52"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Showdown", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1490770800, "lastRevision": {"nodes": [{"id": "989680964464432", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_meta
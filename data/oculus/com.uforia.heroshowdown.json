4FeIlHTfMkRls46_ZJEg&oe=6B032B0C"}, {"file_name": "migrated_image.png", "id": "825395821299243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162814_197249790777683_6614508356079976448_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6E5szGk0zoQ7kNvwHAyyMq&_nc_oc=AdqJXvgnelHwBpXA74w7tLnnYmkkf7fi_AoSfwCHaHtsE-xgNPzmeSQCXRFz2VuIXMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF01VZT-JHqlcnr9j9tY1MCKS9XUzxL0ZLvZxLRmlgxg&oe=6B030E8A"}, {"file_name": "migrated_image.png", "id": "1067341576982177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162811_430027997343545_6873559063725080576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS7ZnZjhXFcQ7kNvwEPsBz5&_nc_oc=Ado0j9uzO4kDrwlEB4wy_8eVscO5goXFd_5zqemKWupicgPqw6KfRDdaLv8LIBuHMns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_-6B61IcFg2GMlgSVAbRYXQZCs-VmiOfU65l59kPTAg&oe=6B0307A3"}, {"file_name": "migrated_image.png", "id": "646879289429877", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162718_273000173154444_433343220705918976_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KReHtFCr32wQ7kNvwGPVx8X&_nc_oc=AdrT7zcxqQtL10di8n7kstGStBYVILSTnQVfEX1GQbLn-ap-4P1d6qVUGnq3a2y1QCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkmp0pVc62M0mhlarkuw0LUein_F6ZgD0JuoCDOQvLqg&oe=6B031EEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero Showdown", "keywords": ["hero", "showdown", "skydive", "shoot", "destruct"], "long_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nHeadquarters gets a call that a mysterious danger has been developing in a deep region of the badlands. They summon you, one of their greatest heroes -Lazer Face- to discover the source of the danger and to battle whatever may come. You wake up moments before being hurled to the ground for an epic hero landing  to crack the ground beneath, and quickly discover the dangers of this unknown region!\nBlast away both enemy and environment around you! Survive the onslaught, decimate everything, win!", "short_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nImagine becoming a super hero with the ability to shoot beams of concentrated power from you face. You wake up to a pilot telling you some people hired you to go kill some stuff, and that you need to jump out of the ship from 1 thousand feet up to do it. When you land you then blow up everything around you to survive! 35 levels, over 10+ baddies, destructible environment, destructible enemies, and power-ups!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://uforia.com/ptos/", "developer_terms_of_service_url": "http://uforia.com/ptos/", "publisher_name": "Uforia", "support_website_url": null, "website_url": "http://HeroShowdown.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669651704072625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_402787233416307_3006445719579000832_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt5A8VZxXo4Q7kNvwGZ0g_7&_nc_oc=AdqWmgs4B8dgrTRu7_zfqZ6x1EUuqFN5LNzCWsNuaVrhsix-9ZM5v8YjPtXP0pYDlj4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjaXCYrgYaTYYk3mY3zk9pb21VrHM9sz1pTRmBImkLIQ&oe=6B03
0ZKeguT3_te_JdvORoMw&oe=6B0B140C"}, {"file_name": "migrated_image.png", "id": "825395821299243", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162814_197249790777683_6614508356079976448_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gfuglW34QUQ7kNvwHehg4c&_nc_oc=AdrvMwQPRT2ksZ5cN1HjGD51wI6QzUgGU2wehdf2pst3Hz8jlix4AfzBaLJXMPUU10M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwYIIF8QBr_ZibTHx3HmUxblGuk7tjQwrI-F4A3zT_1g&oe=6B0B2FCA"}, {"file_name": "migrated_image.png", "id": "1067341576982177", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162811_430027997343545_6873559063725080576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArXOASWfxFcQ7kNvwEjqGju&_nc_oc=AdrqWh7Z5547BdPEhyp0UPjquoCcMUObVx-ZX6Nu2fsim3equgYVcJXFXvi0vWZ3b7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKn-2o1V7yKz4_x8Xk2Gr8UQNdcDR37m34g7jUDUesiw&oe=6B0B28E3"}, {"file_name": "migrated_image.png", "id": "646879289429877", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162718_273000173154444_433343220705918976_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOfOd1-uAyIQ7kNvwGDVwcM&_nc_oc=Ado5ppNnsGmgd_NmOqnQuQc1FkmI9U8JNjdBV862s2p5wD1lDO-rJ9Dmm0xD21Jap4g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8rt52X--qo_rFE52IiKGGU8MMg52cXT11jyp73XSEuA&oe=6B0B402C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero Showdown", "keywords": ["hero", "showdown", "skydive", "shoot", "destruct"], "long_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nHeadquarters gets a call that a mysterious danger has been developing in a deep region of the badlands. They summon you, one of their greatest heroes -Lazer Face- to discover the source of the danger and to battle whatever may come. You wake up moments before being hurled to the ground for an epic hero landing  to crack the ground beneath, and quickly discover the dangers of this unknown region!\nBlast away both enemy and environment around you! Survive the onslaught, decimate everything, win!", "short_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nImagine becoming a super hero with the ability to shoot beams of concentrated power from you face. You wake up to a pilot telling you some people hired you to go kill some stuff, and that you need to jump out of the ship from 1 thousand feet up to do it. When you land you then blow up everything around you to survive! 35 levels, over 10+ baddies, destructible environment, destructible enemies, and power-ups!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://uforia.com/ptos/", "developer_terms_of_service_url": "http://uforia.com/ptos/", "publisher_name": "Uforia", "support_website_url": null, "website_url": "http://HeroShowdown.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669651704072625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_402787233416307_3006445719579000832_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O10nqej8PCwQ7kNvwFQtTs7&_nc_oc=AdpkqNJsLFHS2A08LDn4dHlHoa0A8xITrRjS5EFpRTI0MijvxPmd0xWBq-gQpX3TmQk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPyFPFYfbilz-Lpu8BCsEohzFXZNdDK1dvi5ZkMxNdBw&oe=6B0B
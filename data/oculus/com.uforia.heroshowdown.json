d=6e7a0a&_nc_ohc=qCbeDAGkxfMQ7kNvwFvRDBu&_nc_oc=AdpD3IFIs2uPUFWuPlv4iUkxvNqsBP3O5o_Y3Mz2pO82Rry0SeDfQHJ8HWtPfqxrSjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-017minMSzwTTFidlmf-Tel0EkLyPFwkpy7JiJv2Nmg&oe=6ACA5E0A"}, {"file_name": "migrated_image.png", "id": "1067341576982177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162811_430027997343545_6873559063725080576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snLzN3apSGEQ7kNvwHUTamP&_nc_oc=Adrp7Z2e66Vx1pVZYVUMjH-BD4VXUXhFpOyxnpl7Xj4F-YX4xr6ZlGo6eR17gWovB_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSx5GSfSHZYl3yILe4ayTUiwDHXLX3IEx2B3KrOBZswg&oe=6ACA5723"}, {"file_name": "migrated_image.png", "id": "646879289429877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_273000173154444_433343220705918976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaSMCJGtgysQ7kNvwEHxRFK&_nc_oc=Ador7aHOomWq3Y_A_7_Ggv-gnqhYGoJZmA8EIHpy5sFZH8eTYKzI-F1TeJJyZLNwKRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbPHW86HZqoaGc_C34vaA3z6zR-FlsnrDphd9qKSS53w&oe=6ACA6E6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero Showdown", "keywords": ["hero", "showdown", "skydive", "shoot", "destruct"], "long_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nHeadquarters gets a call that a mysterious danger has been developing in a deep region of the badlands. They summon you, one of their greatest heroes -Lazer Face- to discover the source of the danger and to battle whatever may come. You wake up moments before being hurled to the ground for an epic hero landing  to crack the ground beneath, and quickly discover the dangers of this unknown region!\nBlast away both enemy and environment around you! Survive the onslaught, decimate everything, win!", "short_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nImagine becoming a super hero with the ability to shoot beams of concentrated power from you face. You wake up to a pilot telling you some people hired you to go kill some stuff, and that you need to jump out of the ship from 1 thousand feet up to do it. When you land you then blow up everything around you to survive! 35 levels, over 10+ baddies, destructible environment, destructible enemies, and power-ups!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://uforia.com/ptos/", "developer_terms_of_service_url": "http://uforia.com/ptos/", "publisher_name": "Uforia", "support_website_url": null, "website_url": "http://HeroShowdown.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669651704072625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602290_402787233416307_3006445719579000832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gtnE6BnIYsQ7kNvwG5Yi_7&_nc_oc=AdrHqBwQpgdQEmqbgxDgs-yQxksm7S1Nj-HNv6VstaV_Kz-BxterqdhOIWedqD2vIvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP2RxJJlizJ2uQCnrfdufK3k18SxmPSipWW4JXyI_Tag&oe=6ACA6B52"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Showdown", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1490770800, "lastRevision": {"nodes": [{"id": "989680964464432", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_meta
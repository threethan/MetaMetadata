iUL_ZMT4PNAw1Ye8uaxA&oe=6B09C28C"}, {"file_name": "migrated_image.png", "id": "825395821299243", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162814_197249790777683_6614508356079976448_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtJNpIUM0LQQ7kNvwHSwn9A&_nc_oc=AdonijPqwhA9aMgY-re0yoVIZNi6E0VCbW5xdspP9D5Q3OC_vMOupv7Sttq6ATC9Bkk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWm0h3VyHMJNpmOXbYYayihmDX8MH9yxRRUro0p_H5kQ&oe=6B09A60A"}, {"file_name": "migrated_image.png", "id": "1067341576982177", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162811_430027997343545_6873559063725080576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArXOASWfxFcQ7kNvwFkHulT&_nc_oc=Adoqne4wtywQbbGhSYF8cBH4NiRAIryS-7eD6SqRZ-jijPtiIvt25-oLU6tmgB2Eqoc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVAEAJPdMnyQMii7hz36AqVFVnyFw6lGEieLu7GU5VXQ&oe=6B099F23"}, {"file_name": "migrated_image.png", "id": "646879289429877", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162718_273000173154444_433343220705918976_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOfOd1-uAyIQ7kNvwG2z_vz&_nc_oc=AdpdjBarNIpHV5qwuiJSjzgGGntG-M_oiBj0u_tJvrPWoXuVC0dJBkhfc5mxJI6RkUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLmtONnFBUKyUTfIyHxGOZmlw1JxReJLtXdp-XMQuj8Q&oe=6B09B66C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero Showdown", "keywords": ["hero", "showdown", "skydive", "shoot", "destruct"], "long_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nHeadquarters gets a call that a mysterious danger has been developing in a deep region of the badlands. They summon you, one of their greatest heroes -Lazer Face- to discover the source of the danger and to battle whatever may come. You wake up moments before being hurled to the ground for an epic hero landing  to crack the ground beneath, and quickly discover the dangers of this unknown region!\nBlast away both enemy and environment around you! Survive the onslaught, decimate everything, win!", "short_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nImagine becoming a super hero with the ability to shoot beams of concentrated power from you face. You wake up to a pilot telling you some people hired you to go kill some stuff, and that you need to jump out of the ship from 1 thousand feet up to do it. When you land you then blow up everything around you to survive! 35 levels, over 10+ baddies, destructible environment, destructible enemies, and power-ups!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://uforia.com/ptos/", "developer_terms_of_service_url": "http://uforia.com/ptos/", "publisher_name": "Uforia", "support_website_url": null, "website_url": "http://HeroShowdown.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669651704072625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602290_402787233416307_3006445719579000832_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O10nqej8PCwQ7kNvwFs6mDR&_nc_oc=Adph9cxs9CZ3rMq95qIc-qDYY_meh4MqRifDZbLnTTK53ylZf4S7nEh0S-C8qnke1Qo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqmyUmqBNLaJfrT-37FBzm4z9MjIm0qqr_xEUdt_RYTA&oe=6B09
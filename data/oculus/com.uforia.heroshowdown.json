d=6e7a0a&_nc_ohc=hMVIMhpAqUMQ7kNvwFEoK9h&_nc_oc=AdofPOErQSJmc93kMn9_qy-1M_fAwogBGfFRVOLAofP1YmOpCslx1-OVjTIS-xoy9Pg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKiEgWKWDiip3A9LeBn5qNgm4Pk63U27TQcdBa5TV5bQ&oe=6AF9D40A"}, {"file_name": "migrated_image.png", "id": "1067341576982177", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162811_430027997343545_6873559063725080576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zznon8lu4OQQ7kNvwHDFtIp&_nc_oc=AdoZXH7OnFetz3sk42a6UGtI2nhzVg-NJ4kRgqhy9_OSElSp-ETfvSNUrJ7pXG94AVk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-u3PccWurCtmQaGB2Z00yp7a2_VPeo0lq9_rq0Dy87w&oe=6AF9CD23"}, {"file_name": "migrated_image.png", "id": "646879289429877", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162718_273000173154444_433343220705918976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6ongUKDBjgQ7kNvwHgvOnQ&_nc_oc=Adpj_Spht4wMaCx7GVEuNO4BVnDJIa67hVQvMjBBqTS-9F6Q13HY1waCDojQhHKjETk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwN-IJwZiOu8IH1DtunKp_a_hh9mbNdW_WxSVUANcxzw&oe=6AF9E46C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero Showdown", "keywords": ["hero", "showdown", "skydive", "shoot", "destruct"], "long_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nHeadquarters gets a call that a mysterious danger has been developing in a deep region of the badlands. They summon you, one of their greatest heroes -Lazer Face- to discover the source of the danger and to battle whatever may come. You wake up moments before being hurled to the ground for an epic hero landing  to crack the ground beneath, and quickly discover the dangers of this unknown region!\nBlast away both enemy and environment around you! Survive the onslaught, decimate everything, win!", "short_description": "*WINNER OF THE GLOBAL VR AWARDS FOR BEST MOBILE VR GAME\n\nImagine becoming a super hero with the ability to shoot beams of concentrated power from you face. You wake up to a pilot telling you some people hired you to go kill some stuff, and that you need to jump out of the ship from 1 thousand feet up to do it. When you land you then blow up everything around you to survive! 35 levels, over 10+ baddies, destructible environment, destructible enemies, and power-ups!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://uforia.com/ptos/", "developer_terms_of_service_url": "http://uforia.com/ptos/", "publisher_name": "Uforia", "support_website_url": null, "website_url": "http://HeroShowdown.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669651704072625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12602290_402787233416307_3006445719579000832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek9DLAV--sQQ7kNvwEnI0xP&_nc_oc=AdpCUKi9iCfnw5iOB-jh-G2uIJDSzILFZsSTTPghFUFxgXEtisPsatUJClaDFfGadGY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHRIOG3YPhMODa4-Yuk2ypiZaMS8zxT_somgAHmto4wg&oe=6AF9E152"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Showdown", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1490770800, "lastRevision": {"nodes": [{"id": "989680964464432", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_meta
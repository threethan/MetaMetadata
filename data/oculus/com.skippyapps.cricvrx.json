"}, {"file_name": "SS-05.png", "id": "1068028827353852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556802_1068028830687185_6487883716050509134_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yzd9iGRWKQQ7kNvwGINs8J&_nc_oc=AdqpxsaypMzA11VkvA1pi9iCGhidk3_mbQcoTXouTj8MejzhyH4tUJQAMF5XlLL4FSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEVkbAe_sCEyCKwx8lpnXbcwchk40DMgyjajhJ77NS9A&oe=6B07208F"}, {"file_name": "SS-04.png", "id": "464495284644044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254874_464495287977377_5489601859940204400_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1HoHQQPzWMQ7kNvwE-dSbu&_nc_oc=AdqdKqIMru_WNmqV4vlh5GPs07fhCBUKa8i-adcfs4ParrBymnUxw7HjAia352Su8eo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9bK7rgT0SArPhD8dpmnWDkjT2ZY4io-6TLSdJGOKnyQ&oe=6B072384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CricVRX - Virtual Cricket with Real Talents", "keywords": [], "long_description": "CricVRX - Virtual Cricket with Real Talents is the future of cricket, a game which will provide you a platform to relive your love for cricket. Cricket lovers can now live their real cricket dream, as this game is specifically designed for sports and cricket enthusiasts.\n\nFans cheering for you - Walk into the magnificent stadiums, feel the heat as fans cheer you on and live the game like never before. Get familiar with in Minutes - Anyone can play CricVRX irrespective of age, gender or cricketing experience.\n\nExperience being a Real Cricketer - Choose team and experience the immersiveness with adaptive commentary. Real ball physics including swing, bounce and spin. Your VR controller becomes your bat where you have to play different shots with perfect timings and placement just like in real cricket.\n\nHave fun -  by competing with other players by setting the highest game score and see who is going to beat it. Enjoy and have fun and prove your battings skills.\n", "short_description": "Play Virtual Real Cricket against International Teams in a limited overs thrilling batting challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cricvrx.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://cricvrx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "687503689201746"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1222853873358220"}, {"status": "PUBLISHED", "id": "1549365743335813"}, {"status": "PUBLISHED", "id": "1574751044074381"}, {"status": "PUBLISHED", "id": "3031963123675162"}, {"status": "PUBLISHED", "id": "3206733329509591"}, {"status": "PUBLISHED", "id": "25161766256792431"}, {"status": "PUBLISHED", "id": "1618253169049723"}, {"status": "PUBLISHED", "id": "773657408260192"}, {"status": "PUBLISHED", "id": "3176798882550687"}, {"status": "PUBLISHED", "id": "656120809117763"}]}, "baseline_offer": {"id": "3031963123675162"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1222853873358220"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35938167002448632
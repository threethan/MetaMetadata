ame": "SS-01.png", "id": "317898583115287", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75422389_317898586448620_4175535195344797757_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prmhjEtQH9oQ7kNvwEhTS6f&_nc_oc=AdpZZcexzrU21L-0W7o1p8Iu1snWLrBQW-ApQ8q_pwll1PH14gQ7Pde4ip4bTCCEfho&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlA6lUEJbOeehFuR9JMWBy46jT5rqrMVD6Kn_asLrfQw&oe=6A85A9D8"}, {"file_name": "SS-02.png", "id": "5528165630588369", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75443251_5528165640588368_493897522005459592_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1054kjVmTYQ7kNvwF_GQ5D&_nc_oc=AdrokcyilDfeH4Gs4Ij4lcYPGzc-PSR98TOde1c_oIapDl4F1XobEi7sIAbl8veeVf4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFARgIRsk5QYGl42QDZFYtb4YdSK5U6No1hCXDd3TmJw&oe=6A85A65E"}, {"file_name": "SS-03.png", "id": "825346575080137", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75441581_825346581746803_8528999227328354471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ndzqmJE--AQ7kNvwE7oFS-&_nc_oc=Adqt2YixHBWvjRSvlA1VAVI6khcKMiuBIEyLr-0kpEBt4ztvmwQAFRKHw31XvV5FBQg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnv4QN9CjZqkbUGnCydCM882iQwnWhHSu2nGYbukgegA&oe=6A85AF80"}, {"file_name": "SS-05.png", "id": "1068028827353852", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75556802_1068028830687185_6487883716050509134_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC8ZKgHtHo8Q7kNvwEzJy0A&_nc_oc=AdpAdOBvXvvH_as_Ky94YkcxVn2vvoUeegaElexa3mJJM5SnLQKMkcXKucXS2q9hshE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN0kAiHThQVVqrZAJDfjENtC3sJViyjRzAkj1vyd84fQ&oe=6A857D0F"}, {"file_name": "SS-04.png", "id": "464495284644044", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254874_464495287977377_5489601859940204400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_RJzDv6nuwQ7kNvwEwpXH9&_nc_oc=AdrCO4C1_lG7-jMCnxnK_ChS-TmAjN5_0ZljgQYbpm3wRqEEI3XlQFvbN7sYhhxCl_w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkYeu_vM6yrIWGaGIeUGyFPtOF9bNA_ASVSKADYCDG2w&oe=6A858004"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CricVRX - Virtual Cricket with Real Talents", "keywords": [], "long_description": "CricVRX - Virtual Cricket with Real Talents is the future of cricket, a game which will provide you a platform to relive your love for cricket. Cricket lovers can now live their real cricket dream, as this game is specifically designed for sports and cricket enthusiasts.\n\nFans cheering for you - Walk into the magnificent stadiums, feel the heat as fans cheer you on and live the game like never before. Get familiar with in Minutes - Anyone can play CricVRX irrespective of age, gender or cricketing experience.\n\nExperience being a Real Cricketer - Choose team and experience the immersiveness with adaptive commentary. Real ball physics including swing, bounce and spin. Your VR controller becomes your bat where you have to play different shots with perfect timings and placement just like in real cricket.\n\nHave fun -  by competing with other players by setting the highest game score and see who is going to beat it. Enjoy and have fun and prove your battings skills.\n", "short_description": "Play Virtual Real Cricket against International Teams in a limited overs thrilling batting challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cricvrx.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://cricvrx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connecti
f&oh=00_AQTyKc1TfEK2T9U0OhuBz77kI97Y8sZ6EtfrkU3NeQ9Iwg&oe=6B006D48"}, {"file_name": "3 Leader Board VR League.png", "id": "1348211953675361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_1348211957008694_3294936995753069880_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NTYy8EE0cgQ7kNvwFvTOl0&_nc_oc=AdrgOJmBKhiHxlHeuOmGkfsKrRP0vlua73hvFMo4BL-yv-Bp-aUj6DVquwrG22w6RLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZhp-U9mZkqWbWRI-7Fj6LPGeS8XMFlvHUB69ADS1VXA&oe=6B00825E"}, {"file_name": "4 Stadium LCD Scorcard.png", "id": "858123163185109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035339_858123166518442_7279831802835114053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW18lm7C-vcQ7kNvwEoNzV-&_nc_oc=Adp0lCshIyF4RVcaPuMLLi2Qv5F5Bujj3cqFJJXralA3n-IIHcXOCQamLQbxeZUG_BI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa_bqSErbdleQchhbZ_3LvzYPZzoA189uM_EnM51CGSQ&oe=6B007C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Banner.png", "id": "1635194703765728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1635194707099061_6040746323908345062_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMrdo0Kvip4Q7kNvwEI5Okv&_nc_oc=Adrkvg5wYMFT_GSwGe-yux8-MA7omPvUiQVy0q55QnFgH3agieNGuLfPr736K8ont08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKJLjT0gafrax7fdU30lUOcFwn1Pg3FomdMTdsfJ2azg&oe=6B00665B"}, "display_name": "CricVRX Cricket - Free Roam Sports", "keywords": ["cricket", "sports", "fitness", "healthy", "baseball"], "long_description": "CricVRX - Virtual Cricket with Real Talents is the future of cricket, a game which will provide you a platform to relive your love for cricket. Cricket lovers can now live their real cricket dream, as this game is specifically designed for sports and cricket enthusiasts.\n\nFans cheering for you - Walk into the magnificent stadiums, feel the heat as fans cheer you on and live the game like never before.\n\nExperience being a Real Cricketer - Choose team and experience the immersive cricket with adaptive commentary. Real ball physics including swing, bounce and spin. Your VR controller becomes your bat where you have to play different shots with perfect timings and placement just like in real cricket.\n\nHave fun -  by competing with other players by setting the highest game score and see who is going to beat it. Enjoy and have fun and prove your battings skills.\n", "short_description": "Play Virtual Real Cricket against International Teams in a limited overs thrilling batting challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39893358056929487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348038_312061910567527_7787277845429328689_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfBNEpWASrAQ7kNvwFu9mvr&_nc_oc=Adq5Jnx9VpuVHvzQ1bU6xlOQYdnbAM-O
k_w1FLAZD8j1Y0J7akpJjv3Zqw00O2cQ45E&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4awayvZ2KDAhMnAYjEbhFiIiYfBD1xV_8PGVu_ghcUwg&oe=6A09C19E"}, {"file_name": "4 Stadium LCD Scorcard.png", "id": "858123163185109", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035339_858123166518442_7279831802835114053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlRcbYkRSucQ7kNvwG4TbxA&_nc_oc=Adr-Em01lpAbF4DCo1N2l0WgznTQV90QRaBM6X14-ZfJE0DwhmyBJZLjWGE8n7Dycj8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54lvv2YdWesShSLWqvws7-muJE4a0F5iKOStdof2vocA&oe=6A09BBD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Banner.png", "id": "1635194703765728", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391911_1635194707099061_6040746323908345062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXvJDtGjGssQ7kNvwFEzW-Y&_nc_oc=AdpPcwp4QB-gg6ERneJVTnIkLrCCsqndenZbETv7jPTUUIHKK6GDXZcpXPuJ2Dti7F8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GRwijKXkPilPMiKTrBuK6IPZoMqqrsFlt4iZLLUV8Rg&oe=6A09DDDB"}, "display_name": "CricVRX Cricket - Virtual Sports", "keywords": ["cricket", "sports", "arcade", "franchise", "fitness"], "long_description": "CricVRX - Virtual Cricket with Real Talents is the future of cricket, a game which will provide you a platform to relive your love for cricket. Cricket lovers can now live their real cricket dream, as this game is specifically designed for sports and cricket enthusiasts.\n\nFans cheering for you - Walk into the magnificent stadiums, feel the heat as fans cheer you on and live the game like never before.\n\nExperience being a Real Cricketer - Choose team and experience the immersive cricket with adaptive commentary. Real ball physics including swing, bounce and spin. Your VR controller becomes your bat where you have to play different shots with perfect timings and placement just like in real cricket.\n\nHave fun -  by competing with other players by setting the highest game score and see who is going to beat it. Enjoy and have fun and prove your battings skills.\n", "short_description": "Play Virtual Real Cricket against International Teams in a limited overs thrilling batting challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31261973276734718"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75348038_312061910567527_7787277845429328689_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PULSDgg8DgQ7kNvwHI7aye&_nc_oc=Adp5SncWRVznVxohVEaYEr7j7tqwgKlQHpBZDszBPux24T5UaP_Tu15tRyRCOE16a60&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uaELWXGGBQUuBS33p8X3awlIR0PxVeZ9yQihEHh9RkQ&oe=6A09B108"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CricVRX Cricket - Virtual Sports", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"top
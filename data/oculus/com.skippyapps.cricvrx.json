ame": "SS-01.png", "id": "317898583115287", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75422389_317898586448620_4175535195344797757_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSvZU0yZcCIQ7kNvwGpbphp&_nc_oc=AdoUMpqBMZ7YqumylIZcE2v6zMceKlfKgiqHSoHxdHvMXoUDmTyj8v7V9q7FqRYAu7E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWX3-3XjD4pqC50069GGF0LTUyfe7pHdUxUzeSMB-oyQ&oe=6A8EE458"}, {"file_name": "SS-02.png", "id": "5528165630588369", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75443251_5528165640588368_493897522005459592_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb_MldJdc1UQ7kNvwFtt-eb&_nc_oc=AdoBys7iD5JL4ioNCmwsyKw4IPchVJ3RUuvCygOJK_efWGI4eB1MuRJmxHq7ZNsM6cg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqHIrSJA0ooq0Z2yG16I79hzfBnh2aS9Uk62Kwmo_dkg&oe=6A8EE0DE"}, {"file_name": "SS-03.png", "id": "825346575080137", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75441581_825346581746803_8528999227328354471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SZQrhkJ7IQQ7kNvwE7tTUu&_nc_oc=Adof8DM8QHLfYgYNpG7Awpoju4wL6pC6GzkE8sC_--iAdVNrwlom0D35eRrgafaOV-0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNV0cfyWVqlQR2pGVMMD_1Xoh9A_IjsaBCl1fkRtiZIg&oe=6A8EEA00"}, {"file_name": "SS-05.png", "id": "1068028827353852", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75556802_1068028830687185_6487883716050509134_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9duZSeDspIQ7kNvwFjyxyD&_nc_oc=Ado_EZVqB9WeW0iCX3J1c7Epi3YEeMDq8txfq7EmfA653GLoEPaxrzcP4HuAs2v4bC8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzz97KEJZcJcreRZGze7cxTi3kH8x91eV3fGACDKPrwA&oe=6A8EEFCF"}, {"file_name": "SS-04.png", "id": "464495284644044", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254874_464495287977377_5489601859940204400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCUU94WruKQQ7kNvwGLKaJe&_nc_oc=Adro0efDNzL-dneDLtgC_6A0a05SCFOaBhjVVATy-p29ZE0dGQZQZS2HVQ6Otx-NZhI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgYmoPZbmrIp1Jz13VaZJNFX99F8ZETK0AE_bDdJn4Dg&oe=6A8EF2C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CricVRX - Virtual Cricket with Real Talents", "keywords": [], "long_description": "CricVRX - Virtual Cricket with Real Talents is the future of cricket, a game which will provide you a platform to relive your love for cricket. Cricket lovers can now live their real cricket dream, as this game is specifically designed for sports and cricket enthusiasts.\n\nFans cheering for you - Walk into the magnificent stadiums, feel the heat as fans cheer you on and live the game like never before. Get familiar with in Minutes - Anyone can play CricVRX irrespective of age, gender or cricketing experience.\n\nExperience being a Real Cricketer - Choose team and experience the immersiveness with adaptive commentary. Real ball physics including swing, bounce and spin. Your VR controller becomes your bat where you have to play different shots with perfect timings and placement just like in real cricket.\n\nHave fun -  by competing with other players by setting the highest game score and see who is going to beat it. Enjoy and have fun and prove your battings skills.\n", "short_description": "Play Virtual Real Cricket against International Teams in a limited overs thrilling batting challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cricvrx.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://cricvrx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connecti
6995753069880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMB6sBm7f0oQ7kNvwHyUZX-&_nc_oc=Adrl_-RWPfwk67_gTQvyfhzTJSl4p5Plx-LBPbtnoKfXPZ4vPHHCPvDGhWX1wwSunMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6oNGzxE5Q2cRgxz9HEByshyS-jyv7hWIng2FIM3QbWg&oe=6ABFB09E"}, {"file_name": "4 Stadium LCD Scorcard.png", "id": "858123163185109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035339_858123166518442_7279831802835114053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIN5bIVI9YsQ7kNvwGbSoSW&_nc_oc=AdpPEomDeVK84kfXP3BhCc4myEN8-4rjwgBeLkIoCe1nif0pT98MbhcKfgdgZrt24og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSV5fGEcroUDKUaZK5gXHSw6Kxq7D8edAHk19Pc6K4pQ&oe=6ABFAAD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Banner.png", "id": "1635194703765728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391911_1635194707099061_6040746323908345062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUR_3h7XXDQQ7kNvwHgQrKx&_nc_oc=Adr-u-OeTxA5seJyr-k_LfcapRgaqRhrGSpqsTJXTuWGNY9OhDNjUDccYiJPHqRfNEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP2JRKsy9a9323o5afXoXT1hZPP6Ql0eihxYFaYzWBng&oe=6ABFCCDB"}, "display_name": "CricVRX Cricket - Free Roam Sports", "keywords": ["cricket", "sports", "fitness", "healthy", "baseball"], "long_description": "CricVRX - Virtual Cricket with Real Talents is the future of cricket, a game which will provide you a platform to relive your love for cricket. Cricket lovers can now live their real cricket dream, as this game is specifically designed for sports and cricket enthusiasts.\n\nFans cheering for you - Walk into the magnificent stadiums, feel the heat as fans cheer you on and live the game like never before.\n\nExperience being a Real Cricketer - Choose team and experience the immersive cricket with adaptive commentary. Real ball physics including swing, bounce and spin. Your VR controller becomes your bat where you have to play different shots with perfect timings and placement just like in real cricket.\n\nHave fun -  by competing with other players by setting the highest game score and see who is going to beat it. Enjoy and have fun and prove your battings skills.\n", "short_description": "Play Virtual Real Cricket against International Teams in a limited overs thrilling batting challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39893358056929487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348038_312061910567527_7787277845429328689_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayGpEdYWKW0Q7kNvwGNTfRh&_nc_oc=AdpX1bbLoUcS3SR7g7j29MZrGWKvMNGHW4unPJ1VmAiOF4QIVysktg8SM-QJ4KMmkGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUlisQovq1XShIqUxuyHTkJuwrlW9kkz2VDd4gAd2FfQ&oe=6ABFD848"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CricVRX Cricket - Free Roam Sports", "platform": "ANDROID_6D
6995753069880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl7xj13TqY0Q7kNvwGzfv8b&_nc_oc=Adpt61P3HCdtLd63X9OHhbJ0xWyG6u6q7v7WOOYZ4fFusPgy3k_YVCl7ELTY-2KnuzY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5_l_7ss2ZmdwG01OOHNPNDaXf4aLZo7bcYU6Lxyj4vQ&oe=6AD0D41E"}, {"file_name": "4 Stadium LCD Scorcard.png", "id": "858123163185109", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035339_858123166518442_7279831802835114053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9L6l_JvNosQ7kNvwHGBrlv&_nc_oc=AdpLnmTfXZyNBuSbJv7zhT4s_Ym90QRrcrHZ_Jmvacj75INslsILy4O8GhGhXcuIRVU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNojgJ1-yjEs99_845MSOY8kdHKFeU7s2bnu3wpME3X6A&oe=6AD10692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Banner.png", "id": "1635194703765728", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391911_1635194707099061_6040746323908345062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r3TNrV-tfcQ7kNvwG8Ov5G&_nc_oc=AdpkIykNvkEz54jszfxgQ5BrlEJ_s8Nu5PovlBFIZAAA3XT6eW353hS6Wj2EfyFDG7k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAmPKXb73tUHsIjCLAxBL_qez0x1hJYi5LpiAfBx6pCQ&oe=6AD0F05B"}, "display_name": "CricVRX Cricket - Free Roam Sports", "keywords": ["cricket", "sports", "fitness", "healthy", "baseball"], "long_description": "CricVRX - Virtual Cricket with Real Talents is the future of cricket, a game which will provide you a platform to relive your love for cricket. Cricket lovers can now live their real cricket dream, as this game is specifically designed for sports and cricket enthusiasts.\n\nFans cheering for you - Walk into the magnificent stadiums, feel the heat as fans cheer you on and live the game like never before.\n\nExperience being a Real Cricketer - Choose team and experience the immersive cricket with adaptive commentary. Real ball physics including swing, bounce and spin. Your VR controller becomes your bat where you have to play different shots with perfect timings and placement just like in real cricket.\n\nHave fun -  by competing with other players by setting the highest game score and see who is going to beat it. Enjoy and have fun and prove your battings skills.\n", "short_description": "Play Virtual Real Cricket against International Teams in a limited overs thrilling batting challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39893358056929487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75348038_312061910567527_7787277845429328689_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRHAr-yc7QwQ7kNvwH3jgWQ&_nc_oc=AdrVRQtmFX93cWwZ-YkyslhKKMHbs7m7nQW1A4Jlt5s5T6WmyettsXN_QvnDZbqzqCY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaeYinp94eexfb3JEs7ySahX9FU8XSAXcLoRFy4d0LMQ&oe=6AD0FBC8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CricVRX Cricket - Free Roam Sports", "platform": "ANDROID_6DOF", "context_category": {"c
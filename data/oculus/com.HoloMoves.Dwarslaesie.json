Ykw4RBkGrh36p4sv7KF7MIQ0ghRS1QuVZDUvJ4VxaMOm9w-P8Rhrs9vbg6WEw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96hL5465yuw9IHi0hdZ1T3DUHH_UR--pODaV1VSO7waw&oe=6A22F904"}, {"file_name": "4.png", "id": "1089940620011860", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618000_1089940630011859_4737077461759013317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo_RbN-ippEQ7kNvwFGJqW5&_nc_oc=AdosGgfOLrCQM7_NVReHVhEoigaFoh_akCiIMOwVYrxA4isgxC1s0Czzn5FHXVWx8pE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tnpoEFrpSdbvvBsAvSCvuF_uDGv3nlErLex0kT0wJdA&oe=6A22F7CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spinal Cord Injury Education", "keywords": ["HoloMoves", "dwarslaesie", "education", "holomoves"], "long_description": "This mixed reality education app helps patients with a spinal cord injury better understand their condition during and after rehabilitation. By using the immersive power of 3D, it transforms complex medical information into clear, interactive explanations. Patients can explore the nervous system, see how a spinal cord injury disrupts communication between brain and body, and understand its effects on daily life.\n\n**The app covers essential topics such as:**\n\n- What a spinal cord injury is and how it develops.\n\n- How the nervous system works and changes after injury.\n\n- Bladder and bowel function and strategies for managing them.\n\n- Neuropathic pain and available treatment options.\n\n- Sexuality and intimacy after spinal cord injury.\n\nThe project was co-created with De Hoogstraat Rehabilitation, rehabilitation physicians, and patients themselves. Their combined expertise and lived experiences ensure that the content is accurate, relevant, and sensitive to real needs.\n\n**(!) This application is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Spinal Cord Injury Education: supports people with a spinal cord injury during and after rehabilitation. Using 3D visualization, it explains complex topics such as the nervous system, bladder and bowel function, neuropathic pain, sexuality, and what a spinal cord injury means. Developed with De Hoogstraat Rehabilitation, patients, and physicians, it provides clear, empathetic, and reliable education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves", "support_website_url": null, "website_url": "https://www.holomoves.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "nl_BE"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "TRACKED_KEYBOARD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24640823852214168"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1298872798596589"}]}, "baseline_offer": {"id": "1298872798596589"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761829920, "status": "PUBLISHED", "id": "1298872798596589"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25045463088416907", "version": "1.0.0"}, "id": "1280717223383882", "channel_name": "LIVE"
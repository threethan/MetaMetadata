-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7CrC8NOM3yH_DqgSy4KJiQvDaUhCJuSHmshp6ZQ_dtg&oe=6A60AF55"}]}, "id": "1251204320372786", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1339505760990754", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_1339505764324087_2879707108999612819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWJRnijxY9cQ7kNvwFkbrYy&_nc_oc=AdqtltCZfmvRiZlb8fpTzEg2rfKWn2GTyVuxfuZPXEwb7uqC1_6mpaCYpMidyxIgi5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9i3P4cPJ4jqhqIOiDaNlE3r79pyR7aKWDx1yM7_Mdag&oe=6A60BAC6"}, {"file_name": "screen5.png", "id": "1846726509545005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823746_1846726512878338_7203807176310004644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_-FeOGPkIkQ7kNvwFIVjNH&_nc_oc=AdrgZnnZwk38cmT5lFNUA2OQRVZ6ZEKZM4ci-FfqwJVjfTxvUSRRPBpx4Ce_1lZPMMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4vsdUCuaCM2qHs-_S8AOVvt2nJDhzmQ5HCLfp7jP7cg&oe=6A60AEDB"}, {"file_name": "screen6.png", "id": "3373519446132719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_3373519449466052_1611334096864511101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgcDlNTGDUkQ7kNvwFMSGy4&_nc_oc=AdqDarW0zJjZNb_FKLpwRJfutSEOy9xG-JzICn5cOae_ZVWt0bDCGAId_PnEckIL4io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdT0VFdP5WGbMQY47143BqB1CbkKZWfaOzLVe-zVFxLQ&oe=6A60A5E2"}, {"file_name": "screen2.png", "id": "1310069680919748", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1310069684253081_1215384073143068776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHFYm6RkF_UQ7kNvwHSpdD6&_nc_oc=Ado-lcEDCAzMQL9tn4_T0Y-a1ElN5zPxpSTWM16oUG3ZCjgVVbpVVoiuiDnEKCygsXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUpIOJrNsukXkyoYQVyv5d5QiJsqU39Z0zm2MyKteZ4w&oe=6A60CB1F"}, {"file_name": "screen3.png", "id": "834883059460577", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_834883066127243_3675854998550483605_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gc21FISzQtIQ7kNvwEXFuZk&_nc_oc=Adqdi88QNv1Guzwx4ohEIExYqe9tdhZZintpnCqSe4Eit95xdhuApqF9WUAnmOUU8rQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpvsI_JzAMBZuzAOp4cV23wza84IKsTLSQa71jg1vY_A&oe=6A60C429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "2273318606449517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_2273318609782850_4522852467373448408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBptH-DhKwUQ7kNvwEv6iO3&_nc_oc=AdryuIjanpSkWA0ghn4OqmLM-ZYcAa5aCxs-74yk1Ews5TUhUW2Mtrf9a1J0RIB4Qyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyX9_luUtwoq-q9lAT7G73sSzTZhT-sN858QInRMiTZQ&oe=6A60C72D"}, "display_name": "Theremin", "keywords": ["music", "instrument", "synthesizer", "spooky", "sound"], "long_description": "# \ud83d\udcfb The Theremin, Reborn in Mixed Reality \ud83c\udfb5\n\nPut on your headset, flip the switch, and play. A real instrument floats before you \u2014 responsive, expressive, and endlessly tunable.\n\n\ud83c\udf9b\ufe0f Adjust with intuitive knobs. Turn knobs from a distance: point your controller, pull the trigger, then turn your controller or pull out radially and orbit for more precision.\n\n- Amplitude Curve \u2013 shape how your left hand controls volume\n\n- Timbre \u2013 from pure sine wave to rich violin tones\n\n- Reverb \u2013 simulated room acoustics surround you with sound\n\n- Number of Octaves  \u2013 define your instrument\u2019s range\n\n- Lowest frequency \u2013 from deep bass to sparkling highs\n\n\n\ud83c\udfbb Designed for Playability and Expression\n\n- Linear pitch spacing \u2013 equal distance between notes across the full range\n\n- Pitch hologram \u2013 a luminous ruler that shows where each note lives\n\n- Adjustable reach \u2013 move the low note closer or farther from the pitch antenna\n\n- Touch Controller precision \u2013 stable, fast, optical tracking means there's no need to guard your \"magic electro-magnetic circle\"\ud83d\udcab\n\n\n\ud83c\udf08 Beyond Western Tuning\n\n- Explore microtonal and non-equal-tempered scales\n\n- Perfect for experimental musicians and sound magicians alike\n- Work on your gamakas!\n\n\ud83c\udfa5 Record & Perform\n\n- Connect to speakers, amps, or your DAW for live performance\n\n- Record or stream using the Horizon OS camera\n\n\n\ud83d\udca1 Use Horizon OS Seamless Multitasking to: \n- Play along with YouTube karaoke  \n- Overdub yourself\n\n{1480275323043844}", "short_description": "Put on your headset, launch Theremin and press the power switch\u2014you're ready to play. A real instrument hovers in front of you, right in your room, your studio or on stage! Express your spooky, sensual, operatic, inner world through craft audio synthesis. Realize that melody that has been worming around in your brain. Meditate on sound, somatically. Shape your tone, range, and reverb with intuitive controls. \ud83c\udf9b\ufe0f\u2728\ud83d\udc7b\ud83d\udcfb"}]}, "developer_name": "Paul M. Christian", "developer_privacy_policy_url": "https://musicality.computer/theremin/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "musicality.computer", "support_website_url": null, "website_url": "https://musicality.computer/theremin", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33091458173778916"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "27226319127052223"}, {"status": "PUBLISHED", "id": "1280974657191120"}, {"status": "PUBLISHED", "id": "905546208491017"}, {"status": "PUBLISHED", "id": "3827448987556171"}, {"status": "PUBLISHED", "id": "25535503202722030"}]}, "baseline_offer": {"id": "25535503202722030"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "27226319127052223"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37560777496846939", "version": "1.1.0"}, "id": "1333167594581401", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29752287957695971", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37560777496846939"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1333167594581401"}]}, "change_log": null, "created_date": 1783315759, "id": "37560777496846939", "version": "1.1.0", "version_code": 171, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29752287957695971", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37560777496846939"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1333167594581401"}]}, "change_log": nu
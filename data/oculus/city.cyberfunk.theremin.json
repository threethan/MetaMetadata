771-25/491823746_1846726512878338_7203807176310004644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_-FeOGPkIkQ7kNvwFIVjNH&_nc_oc=AdrgZnnZwk38cmT5lFNUA2OQRVZ6ZEKZM4ci-FfqwJVjfTxvUSRRPBpx4Ce_1lZPMMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4vsdUCuaCM2qHs-_S8AOVvt2nJDhzmQ5HCLfp7jP7cg&oe=6A60AEDB"}, {"file_name": "screen6.png", "id": "3373519446132719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_3373519449466052_1611334096864511101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgcDlNTGDUkQ7kNvwFMSGy4&_nc_oc=AdqDarW0zJjZNb_FKLpwRJfutSEOy9xG-JzICn5cOae_ZVWt0bDCGAId_PnEckIL4io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdT0VFdP5WGbMQY47143BqB1CbkKZWfaOzLVe-zVFxLQ&oe=6A60A5E2"}, {"file_name": "screen2.png", "id": "1310069680919748", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1310069684253081_1215384073143068776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHFYm6RkF_UQ7kNvwHSpdD6&_nc_oc=Ado-lcEDCAzMQL9tn4_T0Y-a1ElN5zPxpSTWM16oUG3ZCjgVVbpVVoiuiDnEKCygsXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUpIOJrNsukXkyoYQVyv5d5QiJsqU39Z0zm2MyKteZ4w&oe=6A60CB1F"}, {"file_name": "screen3.png", "id": "834883059460577", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_834883066127243_3675854998550483605_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gc21FISzQtIQ7kNvwEXFuZk&_nc_oc=Adqdi88QNv1Guzwx4ohEIExYqe9tdhZZintpnCqSe4Eit95xdhuApqF9WUAnmOUU8rQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpvsI_JzAMBZuzAOp4cV23wza84IKsTLSQa71jg1vY_A&oe=6A60C429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "2273318606449517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_2273318609782850_4522852467373448408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBptH-DhKwUQ7kNvwEv6iO3&_nc_oc=AdryuIjanpSkWA0ghn4OqmLM-ZYcAa5aCxs-74yk1Ews5TUhUW2Mtrf9a1J0RIB4Qyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyX9_luUtwoq-q9lAT7G73sSzTZhT-sN858QInRMiTZQ&oe=6A60C72D"}, "display_name": "Theremin", "keywords": ["music", "instrument", "synthesizer", "spooky", "sound"], "long_description": "# \ud83d\udcfb The Theremin, Reborn in Mixed Reality \ud83c\udfb5\n\nPut on your headset, flip the switch, and play. A real instrument floats before you \u2014 responsive, expressive, and endlessly tunable.\n\n\u2728 New in Version 1.1\n\n- Hand tracking greatly improved, closer to a real theremin where subtle finger movements matter.\n- New reverb acoustically modeled from a cathedral\n\n\ud83d\udc7b Ghost Hands Add-On\n\nRecord your hand movements and perform alongside your past self. Layer phrases, build harmonies, or turn your room into a haunted chamber orchestra.\n\n\ud83c\udf9b\ufe0f Shape Your Sound\n\nAdjust knobs: point your controller, pull the trigger, then turn \u2014 or pull outward and orbit for more precision.\n\n- Amplitude Curve \u2013 shape how your left hand controls volume \n- Timbre \u2013 from pure sine wave to rich violin tones \n- Reverb \u2013 simulated room acoustics surround you with sound \n- Number of Octaves \u2013 define your instrument\u2019s range \n- Lowest frequency \u2013 from deep bass to sparkling highs\n\n\ud83c\udfbb Designed for Expression\n- Linear pitch spacing \u2013 equal distance between notes\n- Pitch hologram \u2013 a luminous ruler showing where notes live\n- Adjustable reach \u2013 move the low note closer or farther away\n- Touch Controller precision \u2013 stable optical tracking, no \u201cmagic electromagnetic circle\u201d required \ud83d\udcab\n\n\ud83c\udf08 Beyond Western Tuning\n\nPerfect for experimental musicians, sound magicians, and anyone working on their gamakas.\n\nRecord or stream with the Horizon OS camera, connect to speakers or your DAW, and use Seamless Multitasking to play along with YouTube karaoke or backing tracks.\n\n{1030632632950832}", "short_description": "Put on your headset, launch Theremin and press the power switch\u2014you're ready to play. A real instrument hovers in front of you, right in your room, your studio or on stage! Express your spooky, sensual, operatic, inner world through craft audio synthesis. Realize that melody that has been worming around in your brain. Meditate on sound, somatically. Shape your tone, range, and reverb with intuitive controls. \ud83c\udf9b\ufe0f\u2728\ud83d\udc7b\ud83d\udcfb"}]}, "developer_name": "Paul M. Christian", "developer_privacy_policy_url": "https://musicality.computer/theremin/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "musicality.computer", "support_website_url": null, "website_url": "https://musicality.computer/theremin", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37477173261874030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818852_1729683617717802_1136305034481194227_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0S7_PUiv8mQQ7kNvwFCY27O&_nc_oc=AdrRyrlM0bt74FbA3TI-Gx10NKYDcHWGCuUdI1--J80sFEFsBcxBSVVzAoirnLKmHfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5J8B5JIONe3COqLzBufFKfZuYJoUINYDVxlGE7DAoIQ&oe=6A60C1F2"}, "is_concept": false, "is_test": false, "is_trial_
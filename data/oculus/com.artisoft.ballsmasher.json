&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nd2WQQcgqMC2o6TW70VrL4r2QTbE72QU3eCJzdM2kag&oe=69ECAE5B"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfg5OotDFwAQ7kNvwH4hIyO&_nc_oc=AdrG52pl5r2se_uhnplSSEtcEE0tbXopRNduPpYVXocfLA33ZNGV9GShXNxshtoONFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mTn3Lb7lNmGAn4ylgRgbaURgjcfudPtTLF-V7WuCe4w&oe=69ECD6E1"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy0IZQKhCBsQ7kNvwEqfAXI&_nc_oc=Adrk1E6Frg8bh7utNzZhR5p1tFTXLtIffoMkE2K5O9Xjy4_lXN8vrMJbBdsUsNNLhY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JT3sYe2ZjGQP325W37TsQOdMj5h12TrZdryw4AhA2rw&oe=69ECC3AF"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kde5Cy2KMSYQ7kNvwFvjF_r&_nc_oc=AdrmgYExcKGdP6rB63VOt2nvCUi2c6JZMTTC9-ibEix8_mKZngFlK9OKnMCJZM8ilVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hg4O_uqaSpIa5_sdXybvIXXVC25lKzEGbVXhEGYV4lA&oe=69ECC352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfaArX4K9cQQ7kNvwExVCnm&_nc_oc=AdrsOBLAaDv7jYpunNPYKq0pOsUkPVueKI3e5N5OrUtZuJ56tg3XnSzc8uyZlvJytBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zYxXnwMqG15EL2LgPbnxnGrn8AXwIlrNpDkSsiCpDWQ&oe=69ECCCFD"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
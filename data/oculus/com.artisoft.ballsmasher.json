&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oNC4wqndZC0idUyz77ca95Gb5CqDnHRZSAGE3L7k-xA&oe=6A3FF51B"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX6WPi5Mj1gQ7kNvwFyXsmY&_nc_oc=AdoId6JGEcDG2-CUicYntXYiGnN2x7Oki1--xzW0QfIcNlfv34tlH8dfP8jLaAxMbmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rCfX28-w3LQbJqSDujLLCXd1vRvsLZopQP4hQwQo4uQ&oe=6A3FE561"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqiQqyLxUosQ7kNvwGirxa9&_nc_oc=AdrBk7wepxEoV80PkBUWk6wcFCObdKSZAYYKBOWADufqgPbjvibRUE_AFxgr_PcrKVg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KsIkRUjZTt-zHXBe3aZwBe-jPN2uBOIauQ2yFFfG5Yg&oe=6A3FD22F"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPDfQ66jiYgQ7kNvwGGEGN1&_nc_oc=Adrz9xGPLvA5FtpiOJ0ISe5s44_7z71gdbAaxCZHKwFQk-GEwJT73E6-sYHjIhqUt2Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8REhgt7zV1avotr-haAarE6TDFtVpJNv2Bp6HEZA9cPg&oe=6A3FD1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxaRbUXlTXIQ7kNvwFEpjiv&_nc_oc=AdrxPhyqZMRJf9FgAxNUeG4NlDRvCi1BOvVkXmikSdlME9VyTFJ9qlzkImCRxaOfzww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uzdZwSyTVb1V9BjQl2-zposISXWNejcnUJgmGPuW-AQ&oe=6A3FDB7D"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_8SqG5g4UfRcggWr9D-Q_wbqEU1Ej3SAjHymyGcteIQ&oe=69CBB8DB"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF35qp6cFVwQ7kNvwGa8q2I&_nc_oc=AdqjNoyPN0nPOoE57wMoxJPWjmN_XrQeUqNi1fmwRxKDAzSO5Cx4i-Tc0W9F3qKWCyM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvKEJ4VO_iBcwGSyCLLuJYx9_i7sgli8SNQAjkXpwx4Q&oe=69CBA921"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBGtJb_ozGMQ7kNvwE1dmVN&_nc_oc=AdoHsCSSCLHblqQfaV-DRKqP2sqlGUOS3lMmdNEcMSgrnooOQXpyxWlLcAEmP7nWTDQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbuxDyarZobD_VONMm1VdDJXiSIHo4K5YnFi_x-yp5ZQ&oe=69CBCE2F"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bw-MHPZVR1EQ7kNvwFjbKt9&_nc_oc=AdpdLvCd4vJftao7LfyaMzr9RtY2As4DtjPEumP6c8IV0QzQp1bQNZkMgdUnm727F6c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwJMAF8hViW6jdJZYyvD1-Lp04ceHxYPwCSu-mOMKVwg&oe=69CBCDD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU7TH4tW9KAQ7kNvwFC4YFm&_nc_oc=Adq9ie_vN39bmzi4PjoGkSpN0Wv7xdjVMDZMrFLRgdB6HyJURYJGWcwFe0nR-Pv6UD4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJFN34I-Fpr_Fsc8udQ4pXoixcd8msuPKDGSqU6ACdwg&oe=69CBD77D"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
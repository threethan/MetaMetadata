&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9dI41Nig4V24QuuahetGFQz4GQuiOLNUir8BVP1y4jQ&oe=6A32C61B"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlPCTM7bLCAQ7kNvwHDEcgn&_nc_oc=AdrKBORvYl-_YE7iJ1X6S4EVA11-of8bx3UATaEXeVIK4pXpIEnSaqnMQdJAPAgpAvw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dVIrnwEypOIixSZKf3m-9fM4HxiIafGmAW6sEMRY9Ug&oe=6A32B661"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLa0QKxTr-MQ7kNvwEss4xJ&_nc_oc=AdqCRLavpnoR5HMonL5VtXkJ3uWsEC1mW25qVCRY7DQUNAtZAqIQy_17vI90Apae1dc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B2d1IXy5NzRTHj6iVKSi0Hcu43gkzcYPdpwsKB_SfEw&oe=6A32A32F"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AB7V_C7Nl9sQ7kNvwHJaVQD&_nc_oc=Adqd4XE6KttbgQDbx34i9JseyfOP_RYiPFfgAsCQQONAZsS3DrF7ZwRAQrNL0JyzbL4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WHQY9Y-R1zRvKTn2pXmyrt9HByd-m0Zxc_t2vHv9eSA&oe=6A32A2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrY_yUSvMW0Q7kNvwF0p6Ml&_nc_oc=AdqECKOy6GY4eUhuOsGZpLhP40e7xqKYs25TfTN6jLqEF2qzsum_ijcrQPis5VCH98o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w1fWVF6cNKQ7cVFL0EO5VJ5aJyZWdETDny1FD8co4yw&oe=6A32AC7D"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBDefbkqFN8Q7kNvwFRQ9w3&_nc_oc=AdqdePX1YIR9TrnZfTOx0Dd98oaHmHQ2aqP5jIzvTv96HvjSNsvTMy68xmveytMPgU8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ050b8ejvpZpoIM-i-W0I24YhLa55OPReaGiphZ2TsLg&oe=6AFB48BD"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5238121639644750"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1730645998171948"}, {"status": "PUBLISHED", "id": "1368250434846345"}, {"status": "PUBLISHED", "id": "3149672861895100"}, {"status": "PUBLISHED", "id": "1721405348988290"}, {"status": "PUBLISHED", "id": "1994891387818184"}, {"status": "PUBLISHED", "id": "1058951146430815"}, {"status": "PUBLISHED", "id": "783443124516668"}, {"status": "PUBLISHED", "id": "693180737157721"}, {"status": "PUBLISHED", "id": "736925309284237"}, {"status": "PUBLISHED", "id": "575212601749544"}, {"status": "PUBLISHED", "id": "2619210988470681"}, {"status": "PUBLISHED", "id": "971582427768204"}, {"status": "PUBLISHED", "id": "836680194578379"}, {"status": "PUBLISHED", "id": "992807505156556"}, {"status": "PUBLISHED", "id": "1574449116648071"}, {"status": "PUBLISHED", "id": "1300996383945806"}]}, "baseline_offer": {"id": "3149672861895100"}, "is_approved": true, "firstOffer":
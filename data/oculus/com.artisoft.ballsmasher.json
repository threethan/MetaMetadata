_Af0-Ixs8SLJ6O88z7qNX-rDCGOjICVCvo2qgLTfMyj6R6A&oe=69F1F45B"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1J1tgSj_woQ7kNvwFjsimg&_nc_oc=AdpUf9HU52F08o2yvI5FCOTh1GY2MH4qDMfa874PzwRF5ywikR5YRDGSIFld26NQNiI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yCNr8LN9UO5o2-wP1IMvGhnK4Wyu830WgYyW0AMX6gA&oe=69F1E4A1"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZO_aQR5qhsQ7kNvwG-qKY5&_nc_oc=Ado08sZnZcTKtPO8q-2-3bDlUxmJUe8JB2-egvoy_RXxgpXMpj7KoTI9Y2KCkwZO8Os&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3B5iSHgO7jUde7d2K7oKHHj-vPVMl5LrMzbmzmdZqWfg&oe=69F209AF"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgZsW-CCH_sQ7kNvwHAQZ68&_nc_oc=AdqmmyOC9MiATsJEp65y721kEazmQwOfDWYziW-FsXJVyjVrHYC90ENXZuyGiSBjHVI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d5e58oND-3NHUKTgRpicpkJl2zWqsMmP8PSzi91Y9iA&oe=69F20952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Qf50nk-DKsQ7kNvwFNEyVD&_nc_oc=Ado_4IgnOboE_WoiqurrFxR3O3kXLtpX47sI4iHwmJ5QpIfOeMOgMCs0o7-O0yJRabc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1GKt6MOYYmYr0rE8k0ml-mugOAEteh4CE7XZNGJySb_w&oe=69F212FD"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
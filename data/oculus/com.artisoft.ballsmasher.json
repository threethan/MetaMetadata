&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TSGf9OqHLNI9r-r4AWOjM1ETuLdKmHdW7KkL2uJHtjQ&oe=69E0D0DB"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHjw1N7KENgQ7kNvwHOSrxo&_nc_oc=AdotSEsJrPhgqbBIr3O_UTA3V8x9DB0BH0PaEJ84DAqHl2_cFYVTgGyeHT5GAn9GE9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TofVrYiZ9mEe7i2cX-plLkDFQPE_BUg0bZBdha62ufQ&oe=69E0F961"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_I5vXlAej0Q7kNvwGaIoVI&_nc_oc=AdpGQLJDhBrWdB7iscvuKkKwK7GDCDSU8_KJNtwobbFm6e2fSUPi7Sji3PEW6lS_jcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11kq_0riN8V18AAS7auwCtoyOY-p9gAeF6AIzh1UbDnw&oe=69E0E62F"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihMUl35KYA8Q7kNvwENQpYf&_nc_oc=AdrR-qj0EeZk93B92hVdchJ4Kyvq7KK5JHEsM6I4ibJrjAvIJ_lbWSQZObLIaKwICCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PvZ8d6k8UsM034ryMfIlvCW_VKftlqVQJbkM_IxF5zw&oe=69E0E5D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YoZ9ED8r7oQ7kNvwGz8bxi&_nc_oc=AdpC3LFdTnIsqIzTTwCBVlDaqz59K4AcO9iDlx2HLRLn2J9BDm5h7NJMT5AQNXRqp8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_QeBt22a505mYPR2tUVzQ0vmipCw5KVpXUTktmPDc_A&oe=69E0EF7D"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
77270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnMFqX6QlmcQ7kNvwHgnLGT&_nc_oc=AdkM_tp_9eWvnLqSnvEprIp5oWb2_HckrDtv2K4JqplmV-fz11tccTaGBcUrSYJswnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftI1U3W9TPKu_yyY56G97Wd0X2-efr4Y-0TgDmIheT7Vw&oe=699ED621"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1UG4f1mqIcQ7kNvwFrlrN_&_nc_oc=AdmlwOqUkZyClqV1CF1u9E90jEOkoSl7enwvf48aWesviTJEJBlGYM25RVUNAz9zi4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsfMIdD7BAM9Eb2qAvyuxGqa5e8gx-6tsEKTdMGqN9Kpg&oe=699EFB2F"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRs-4dMeD38Q7kNvwEE-vQL&_nc_oc=Adne5Un_ZGVEwT_ilaFq7U56Er6v-pPHlQu4kfMaZ88o0z512qVYvy02nkTERVfZzOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftCyJiXJLHOux3sccnzVsHAMJlWl4Jw3S5bJxIylolUHA&oe=699EFAD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjASRwKz13wQ7kNvwFg0amk&_nc_oc=AdnNwEQIv7SaeDT4JQTsMptm4ODUwnZ7-xjJsV4J_wT6QzqU3san_Oba4OzEtSl-I1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvuSu68mNQAeUxBFsZ2Lh7X5Wo0UQufo7kD3IGnKOwmPw&oe=699F047D"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
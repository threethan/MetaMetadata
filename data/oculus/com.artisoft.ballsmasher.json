&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YuZJ-G9yRuqXK1INb6-MDyttAJBl6Tzbx0DqGflXovA&oe=6A09AF5B"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-38Hww5Q20Q7kNvwHh7hVT&_nc_oc=Adp9US2-bkdrBaRDdjfsjW9A5cfQa5kzdcTv8goYiF183LL-GLYXaZpIJ1VMyjCrO5I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GTwS9JBFsIdoTyRgPDzLYaeQv-OhGFj9NWzWXF6y4dw&oe=6A09D7E1"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiMzQtuerRMQ7kNvwEYQIID&_nc_oc=Adq8VZnvJyrzv4QMo0UBl1BiIC2kXYZ47DPuOO2IiYEU1Twb3amPbTeUpWsX-KbToAQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TkBS5f_5ojFUHTb9dYsGX97pS2BakbbICK84jY-txHQ&oe=6A09C4AF"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6IOHrC7vi8Q7kNvwG83-vC&_nc_oc=AdpQ2TP3r-B3kW-Mcq_NzTRL-ETGe0WufYndb0ajR3A47xoHvrwdcnQ_xVouPuCohiU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WYO3F1_FX2IDTmTZYVWww6FH-cyZU5rTZ3PPB7HS4Zg&oe=6A09C452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNCk1XdMIqMQ7kNvwF9DeJR&_nc_oc=Adpg2mZN8cgVZEXw7VGHREWFfbtLLL6PA2eLY5Eo8zxdgzh7cEAMTAc72Q8_bJ7AkiU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44zTX9pTUM7hA9loqsn5Tq8RqJa2v02GQRkfkntYmt8A&oe=6A09CDFD"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KdALp2VkSNiLLMVK4gTMxaUtWZ1n3qYpvKw0SsnrqJw&oe=69F5E8DB"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bRujaXr2l0Q7kNvwFKeOCj&_nc_oc=AdoCBx0ThNB4spwBaRcI9p2xUEqhjEj2nih_iQjGAezAREbyMoFIfgS8QWXNFXGkeac&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UwCkzRPMIEc8uHdxbKh0tlk2jDP9iMVdpGZYT5cICFA&oe=69F61161"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk5lMDsW-0cQ7kNvwH0B7VF&_nc_oc=AdrUHEGQIk9vT1aLwSy8a1eLJ_DhdxVQv95HkeuaH9i3tOkqOAmRuqcCNLOEQ1nmD44&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af117rfXyCpWrSJUZQIwrq8j1HlJIbQF0HBaLTrKn_z9IQ&oe=69F5FE2F"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POup8jLeD10Q7kNvwF9C4Xg&_nc_oc=AdpgUBbGIJAe7JUwsAQAFTxFnXR7A3Q1xz5Y88ce8U_QRSHhjCTIORljPeJ58iojQAI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o-vZEuG-G0U_aLN-FzH1ghTiaKKy0CgRY6yH53wJrTQ&oe=69F5FDD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1GT8KfwPEkQ7kNvwH9qoEM&_nc_oc=AdqXn6TaCsCysWt7A0Z4pEHSbeis79I8fakyIz9pftV9kSDVVMhjEz8Y7sizp5r2Cfg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af313bJxyG6HBld3WaOvR-5RECNIHIyC9pKNanx2LFzg7Q&oe=69F6077D"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
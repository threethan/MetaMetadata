&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TKO9gq0pdu_RRJriqV34r2c65zsZMzwRW2WrGSIN-2Q&oe=69FB2EDB"}, {"file_name": "sc1.png", "id": "1698965373936946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982551_1698965377270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oVYnfJxM2sQ7kNvwFq-GDH&_nc_oc=Adrjz5vsMhCiyS_hFUglTRioZBNO3-dzIiEhPYV8YlQ-QbbECnQEXinriO1wSUdM1Iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qrwAIcaCljUc51dUdgJgaO0hOsKn312XmEDWgp7kzMQ&oe=69FB5761"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqqAvJN5BvAQ7kNvwEe7yEu&_nc_oc=AdqaKklvUEuaq1u2tkUff-X1Xi7j2zoORUtFGMKOYOe6EzG9ES3JGQONH3S53U_j8lQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P8nnnAsVbaR80Zj4iNKkG7RUrAstcDNQZCRfkjLg4xQ&oe=69FB442F"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJsWUar_AZ0Q7kNvwFj6CQT&_nc_oc=AdocA2hzjczjliX8324lkDHZRmJ3yAcm2gaJBS3q2Xyl58IGFJLs_B0oST5E_PRYn70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46_6MJHNb7vGE8JJyhY7cGMsQDYGM1ndrxXS9-Df9uRQ&oe=69FB43D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5M6L34cUx8Q7kNvwHa4BUK&_nc_oc=AdrtdTjl5nC1OPMKPYfu53wvk5xaJrjtdn49RATxgo8yqOHfOacCIux6_RZIAU4Ok4I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74GfM2ELifKlIp7dLc75thvJy8rmxyoixJylgI5bGmbA&oe=69FB4D7D"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED
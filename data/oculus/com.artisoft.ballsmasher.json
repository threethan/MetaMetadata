77270279_7553645442698234559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWUIyisTKKYQ7kNvwH7m3YJ&_nc_oc=AdlorLsp8Iy6oUYLga6Su7wjcc6w3RtSHG_2yf5KMJEXKkGO8e3Y5ya6C3oabwOjqqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvbK_VKV5yxZZX2jiFGytRO3ERHfkwER7QTTOFtnUdEjA&oe=69983EA1"}, {"file_name": "sc3.png", "id": "362227642863079", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_362227646196412_4627867009706605201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgOiPknaphsQ7kNvwHXJLtJ&_nc_oc=AdnX0IuItKSUWTsuD4ABWNOzqblAsD4SMO6dKmL7LKhKdHF8o3fNM4SVI3ypaWnWrKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftl0rP7prqZlyb7827zcBFdA7wLpRCDHA6cDpDjM6ldEA&oe=699863AF"}, {"file_name": "sc5.png", "id": "167386486400512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_167386489733845_2832025039911865533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ2O2whOxaoQ7kNvwGaRv4Z&_nc_oc=AdncF3Is7iGUkzz7aHlr_qDZqjVpf2GPQYPvneYujH4jntkhk1jCokRvRYNPrJE8SDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfupVeYNqEGU8wTx9G9jAxYsvV5n0O0b3w793n1560I1Fw&oe=69986352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc4.png", "id": "860094495571873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240101_860094502238539_6759068810652291731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afjMc2cv2V8Q7kNvwEg0Pl7&_nc_oc=AdkRZ6UWTVk9OpH5oW-BvueYev8DkFiwyzoe2hjf-R7kTwrqaTfbMfZk7oNcsqZGvcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfutpgTTtuUMMVfp7dR70Mh1ZeLGrmOAbKdXzbK7tPe-zQ&oe=69986CFD"}, "display_name": "Ball smasher", "keywords": [], "long_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. \n\nWhether you prefer the satisfying thud of a baseball bat connecting with a ball or the raw power of using your fists, the ball smasher offers a unique and cathartic way to let off steam. \n\nIt transforms the act of stress relief into a physical and engaging activity. So, the next time stress looms, head to the ball smasher and unleash your frustration on those unsuspecting balls. It's not just a stress reliever; it's a fun and dynamic approach to coping with life's pressures, promoting a healthier and more balanced mindset. \n\nTake a swing, make a hit, and feel the tension melt away as you engage in this unconventional yet effective stress-busting activity.", "short_description": "Ball smasher aims at stress reduction. \n\nGrab any of the weapons: boxing gloves, baseball bat, sledgehammer, shovel, cricket bat, tennis bat, or your fists and smash some balls. \n\nThis unconventional method provides a physical outlet for pent-up tension, allowing individuals to release stress in a controlled environment. The variety of available tools caters to different preferences, ensuring a personalized experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bs_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://bs.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
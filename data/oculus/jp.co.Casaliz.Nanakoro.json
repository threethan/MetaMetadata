1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyLeXzjBeHgSSjuQuPB3wS7M-4jIpGuP_0aJfCe_7VKA&oe=6A7076BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM_HDwW2hFoQ7kNvwG0cn8H&_nc_oc=AdrUzZb1Lz-FTm2mZ2m8cYT-fd5KnyOsrjWyBppwQPYQaYEWwwliE7Y-JDY8iLM1ZfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER08lwJJV498rEKQhUh6YYJsPfJsbrafa99FKE7XR--Q&oe=6A70A265"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaWXomQAKzAQ7kNvwEukd_U&_nc_oc=AdpaJf_Ulxd1kmCvNClChqBOZjgQghRMTm2bq8bN4kGSSAbkWI6WQquEe1GobfrAwyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsUWsw1h6TX0q9vIn_pzOQC5h9F8zjkZdBtxe-Naks6g&oe=6A70763B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRiHmguAMKYQ7kNvwHVcHBP&_nc_oc=AdrbF8Rn6XdECjCL5ub_LVcgpwjmzXzDZc4wdUmpX9jbIDHglskBPcPZIQi_4Ua8RCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBchfquY3JbhcZnAl8RwUevLqwbBGVta-ujmH_enWcHA&oe=6A70A9F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0QU2kZFQy8Q7kNvwEcoQBk&_nc_oc=Adr3IHyyMjxA1J5hb_OvKY96Rfu1Uc93gRFVJRFgQpCRQ2QHav8G_SrG7w5auKb-Zqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1uKTAcOX1KomAjbqE8VIgTEK6efDDYjMdsBWAixaCwQ&oe=6A70A6F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44a16zijtLQQ7kNvwFlM8sS&_nc_oc=AdrCGsMRgDt8qFC1OfW6H23DE7swCQJ-3G182BQO-7A0jtwcHt8xD2UIuAnX4E9dOlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3WmuGUhuOEA86ycKpx0BuMCeW9Nr1F962GCYhEDqFjQ&oe=6A707CF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h3vyG6L1dQQ7kNvwG79hr8&_nc_oc=AdpKOZW_hvzV_47bt2cCAhFD41kHDJ1aed9e2favILOZyItrtXovWpy20_j1
7Pthv4Q7kNvwFF4sJQ&_nc_oc=AdqD4782zaAFc-3FCRdbV_ZhwyA-IXpoq1rKxV1hy8D5sCUshgAyDBU5G4QR2rWCI-8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q-cj5AubhYQ7kbsq1o6G4Z9-XBCionZe3DVfeGJcgLw&oe=6A1078FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFOkMeoBZGcQ7kNvwE0x6RH&_nc_oc=AdrXVv3ZsNbLq4AloDMrsP4lLBl3A82hJRqvbw3W4HbA1J8DYGDSQuIi2Jw_H4OjSEE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_r7__DtfDK02qoWBtbE8WFpNYTV90IZga7FPzUfJlNA&oe=6A106F50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWR0Ds97hQkQ7kNvwHUiNVQ&_nc_oc=AdoCDUy5WpP-KJ9-oT0dM2vEKX1q26jsYp8JkazFXRzcDWVU60amZ8RYB2JEknWiAR4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sww37y5040NFDVA2K4EFGmyynUN69SPAQLtVAAR8ecQ&oe=6A105141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4zKLn7hQNkQ7kNvwGqtNpO&_nc_oc=AdrUrskOxmESznrb8Hv6yCOXeQLSQ0huOcZ-hvrYLMQzzf1d4AruFiNhraxdcqKzWSw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hx1pkhR5HXVIh-WkkC_-H6ninpLf6avxNpeRVFw5mZA&oe=6A107D49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QflVjXdftXIQ7kNvwEM41Ux&_nc_oc=AdpxrAbIvj6kKCweVglcRnan8LhkFL4EyUNIIdjPL8P3AKXSy-E5XsbzapAt77b3ax8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xCOqGSH9qL1Xy7Le3ZYr6xtALqReGBBUUue7Lx21l-g&oe=6A10527C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ganj0hPYcbsQ7kNvwFnD6og&_nc_oc=Adr_Cv07qZPDMTtKiMsKtzCDiru70Tq7WRnzSokVaU9897RSxKO5iZTxfsA0vUS_ukA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I_g3Vd1d_XxpnLB6XSe2SHXyDz9rkJHGNWPS9ODTypw&oe=6A105108"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
j6UnL0awVRY-ldAsnDapbxbB6GIWMCapW8IVuAstUuSN-7WUDo6ycq7h4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfziWvuW36yLJZse__oUW_eWuWMVp7x7C5eJaotRYyEuGg&oe=69BE83BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usiwXc5vUrcQ7kNvwFR62A4&_nc_oc=AdkPfNIZ8i1NxD8IO5k5ZfjV6Iww_qHaOf2DCaBkgb8XkLOTnKn_2QeCXIr80R55Co4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWiRTIXNNSrHGrse5hKQQ5TCizr_9jYXs3pbNfG670Cg&oe=69BE7A10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O5sTG1tyZ4Q7kNvwG68bLu&_nc_oc=AdniBlnPic9OpGKmakhRudVI_K0s4UegRqfqZ41rtvqfsHiYvjbe5cszqEqhO35Si-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1TrvOeyf0ZfViIIPF8w2TLYNQQr1niVf0m8l3fnADaA&oe=69BE9441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRDD-ZER5nMQ7kNvwGL96go&_nc_oc=Adl-GUjaPCrHbcQShWmJeDnaDHA511wj-CmYOvHSVO-QRsJ7aR_A3FPU98tKXrrUy08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJwapYNmTehgdWBLdRTF2enusc0QAheiBbJp360dZAHw&oe=69BE8809"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p2MQUrsV1gQ7kNvwF7aDud&_nc_oc=AdlAN6AAOf_xA0FBUEF821NuokiReuDrYO4cE4kYRxQPqBjFGN09NRhdzaRnXcLMH30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1r27BuUGgzzhqJFN2bqI7G8CC96NLNNrm_M2dol8F_A&oe=69BE957C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_CxGmFnvVkQ7kNvwHFPgQl&_nc_oc=AdnllvCIfJ8AQT-38TfeUigQVNmWKc7EX4-ofB7vH366-fMDublKe0gNEoqzfmuOZF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi-KV4VNETrnENxQCVmpFwbYbThuQA1Y67NKL07CcSeQ&oe=69BE9408"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
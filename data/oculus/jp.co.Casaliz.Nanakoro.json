jv7Va4Q7kNvwEuiCJh&_nc_oc=Adr2egQ5Ng1r0XZAfBxa4W5ZB5Ooa7kfj01SajhbWfxgauEhxQy26QKhCuEScz4ceAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLODmPbDW39rv2wxh_mTLaBHRQF8U4FzUioxEHIPBbeDA&oe=6A9D897B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KytHytd6AycQ7kNvwErbM98&_nc_oc=Adr04M09LvVAh913v_Q__J_bwEDY-uRLiAuecRLsrG16lnLEhYIFd1G0vl7ni2_PBsA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-fYP4R25tQ38zh6IH3yvRJFPehFZmbemVEV7cVDa9uQ&oe=6A9D7FD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcrYo3n6ox8Q7kNvwG1yMuE&_nc_oc=AdrqgGpMg0sjgZbiWPzWg_FC4Tqj-LSKM1kgTA2KtnulWIDGhJ9Ujdo1J86ebt4lP_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkz5B2WS348Ji5_6DK8CtBC-L3sPKE4pxG6SEGOOvnUQ&oe=6A9D61C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaOF-8V4MQYQ7kNvwFbzE0q&_nc_oc=AdpMB1RID3Yb0syZnJVQog9kfFqmj-Zj4-JRT1md9u6vDxgsDNjIc_q0YEWrzyBjIlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3N04_JdP4StSlRqEwaJYebm_rExaMuADG0qF1O0iUVw&oe=6A9D5589"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkPpcFo_Yk0Q7kNvwF-RDkm&_nc_oc=AdqkrCUTt0rtb5_IJDUSm1iFe2aOpLC8TuBJp89JhG0-TPTWwHynheHT92Ub3mPnmQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7c0xFmbqceoCI43QLwiTc2fFzp3FNcWJlgc2MOuPRIQ&oe=6A9D62FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCfcBzu5T3wQ7kNvwHh75as&_nc_oc=Adrexb3VGu7IWjynBj7yKSR8NBYgIaR-0YqoWTUW5UHoRk3COOJqrhOlYOd4y1bJ-7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwcvaZD92hkH_o913HV6Ti1aNCxqZPA6Z1CMKWj2UGkQ&oe=6A9D6188"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
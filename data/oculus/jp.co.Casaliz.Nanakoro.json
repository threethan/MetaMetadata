1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XijqarPApY0JRmc141SVOc4NL7S7ONJYnAv4mAMJCEg&oe=6A2ACF7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAelkpHQKegQ7kNvwG6TO31&_nc_oc=Ado7Ovv_CmzmnqLm5PAKXMiuP1IkpVv8BSXzuaZkHhwpIolLopTprPjp45mMxmgb634&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9933Fi_p4F_f8fucGeoNTuVt7_6R1zbn7S0OwiMGEOpw&oe=6A2AC2E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqdb27omJJQQ7kNvwG_9BYo&_nc_oc=Adrf3XiXjGhaim0yhxBVKcKBwtU0QzTQFhg17hmBWNBqlOV3yerXBF3IWCsPPnrTDlE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O3DZTOlSv2xGLbwToTaiuzJ2O6gy9714RdZPlyB3ZpA&oe=6A2ACEFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPC49rJJnIYQ7kNvwEe7FqO&_nc_oc=AdpfuA3ADiVT1d64QcBT7vZGL97qJqzCHLdZ4N4IZq5rczcOG0_GJjEQc1poBLlT25g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P8Pzjy20d2LPXdKC2NH8S-I0y7u11lJBkHlhzflNGyQ&oe=6A2ACA71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGaWybLh8YkQ7kNvwEkqHR6&_nc_oc=AdrwzYEAct4kqEThA65lzSAN27ohOYwy_7yuD89m8kzB4MRQ2hNRvCDYR6f107X7zO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_swwdpndvEWsflrRCQ_Y5pE3K6Et6ghNCX_k7NBQG19A&oe=6A2AC774"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWpwdJvcE-IQ7kNvwGofRud&_nc_oc=Ado7KiRUAvNvQ_Yuc3rRJkCXoxuBVf7GQH1K1frdroUH0Gi_IB11UDJQyxdziXWg1Kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1TIJ-2DCNfSWFQrVaSTriPoS1mUzS-W6uCDOxZlq87Q&oe=6A2AD5B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfYPFwdT0cQQ7kNvwG83xou&_nc_oc=AdpKAAZaI-ZK6T50pRRSFos2SQ9u9BfLgKMPnVqa5-4j_b9k7wGwWDXDvuD-
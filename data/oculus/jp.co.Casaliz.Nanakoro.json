mn9AVejHo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv7MYA_wv_OZn31RDTi0IsM7omgPCyR335Ow3CTBdyJg&oe=6A858EBD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVHg1gMm-EcQ7kNvwETnhiO&_nc_oc=AdrgxTjiz96puNvH77uDMqQRbY9K-gznqboAaX0egd2vLKcbEBPoN_Onv_LNOpRsQaQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC6CnmJN028fwQAm1ONJHWpoIAM81osu5D2yknV5HGuA&oe=6A858225"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9ul-duFQpcQ7kNvwFLtrUE&_nc_oc=AdqRBw4LrgDTZRyq9nJynnWtIsf0bGYIChWQjFYT7c4_U254F86XtDIh4yjppvAegl4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvic9Q95Y_PISNpcWZSrFw2qowddo4Mhvul5tNRQt23g&oe=6A858E3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkaZGC2MtjYQ7kNvwFArhKe&_nc_oc=AdoBJYXPgFnzgGevgIxfrXVkSP84m2pOsb2ZCZTlNyvzbjle0UutWeUZSqJuuxSKecA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVFmXZwovvG3QfviF4en2GDteSLh3Rxf5sSYnxN-vuTA&oe=6A8589B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bww81EkDY-8Q7kNvwFxNW5f&_nc_oc=Ado9HMfagWn6RVBt7Rq_dIBbQNYrzDxdYBlC7L2y44zlWvpAoHAiogfwYXML_bgN5NY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8JBwK2fph2naRWLeAWWSkd_35TL_oL9MUQOMWfZGJZg&oe=6A8586B4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=th2rqc_rJAAQ7kNvwEUVnes&_nc_oc=AdrYyEw3ZyF_nfHFDEQXUz5TJ5ynPbuOy8qSbxkxGyfWyHhvYk3Z7O25PxmlnKk0DUc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOeVm-3nYQOvqL7eIDbypYt4q0WDftomeAFPw0kZwu7w&oe=6A8594F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQibRSIPFI8Q7kNvwHDb-2G&_nc_oc=Adqjr4wfXLhV_dx
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vMLRfIE6UlXCpUvL2F1HtXYvq5eI6vLds3GFYJk1WvA&oe=6A3E95FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d02eB23s4goQ7kNvwEKmKge&_nc_oc=AdoK1tQ11VgQVNIutQ_FSNphuBapbLVCM26r5frgxLVgiKVymeMpHsdQ8FeHbXGV5mI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PHh5YMec68qNHLgx2yNcJhkS1zjebIk1KLe-Uo4cG5Q&oe=6A3E8965"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_HnGEbjaUQ7kNvwG10ykl&_nc_oc=Adpv4tQ5RAHDlKVQkiiabjyUorTj_CVy-navrZpt0e-1m9ejn0wekyNSIL2ttQisSO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IyJdi9wk4MawWIYgctOdp_QXqiMsQ823Wye7U-Mitbg&oe=6A3E957B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGH-2yCus2sQ7kNvwHQSl5Q&_nc_oc=AdomUJFcas5Q-5RFy3Tk4wH1YEsBjYs6WYZx8O2TNaoZUY0-aZsJY3HNYnXCYCTYj80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Rq2Vf5JWt1XZ0WM4SF1BVHv-qZATy0CINnqA2P83zA&oe=6A3E90F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqWiI5TZOucQ7kNvwEoUbiF&_nc_oc=AdrqEPPdPpzaSi1Q6MBfrP4efwAehYRyf1XC6wWsFrYmNgrSGs2sZwQLeJvVBttLrwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iNtngU3xIXAY1La3fMYv3CpPHlEFjc4dTkROOeLeoWA&oe=6A3E8DF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH8H_2Vmip4Q7kNvwEDd-o2&_nc_oc=Adrqk68o7E_QVjyT9-BADJmsoeYNJtYakjNn-ZaPpEqFts4MTD8POUZr-D3P8eI3fr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gBxo9pKYdIA6hhYzTB6YwcuxrY9cvslYGFgZk7zYUZg&oe=6A3E9C32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1iO2oZiczUQ7kNvwF0K615&_nc_oc=Adp9RTtZ0ejUST1vWXpVl1fpUAd1EiMzuL9Z2lW2UB6g8n95vT2XddmHyzKl
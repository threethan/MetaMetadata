kf7-DEQ7kNvwFHj788&_nc_oc=AdpT8BL6KIQU5ycBjFpb-SmEiLuLVAOKaBJPvLKGjHSj30XNYakKUFE--heZoOgTKPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY0C0PY58Nz8WgtKIKraJHDvN9cXgWweh9f7mIXmUQ5Q&oe=6A4D1DFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF7Hgmvo-BYQ7kNvwFTk6eI&_nc_oc=AdpHIHnQ9rmFtqH6udj3TbWfmM1nzRfbRHDEBngKGJ70W1vNuAdt7EExywrkD3uZlhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Cxu3rUDYhS7DKEr42PUpGhER1VIvuRQUaW_QEbVZFw&oe=6A4D1450"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1KwWEGsg4kQ7kNvwH9QVlT&_nc_oc=AdpGkPXyJ6vyJ5RuN2FS3Zq6yV_8kxX4V7r469T0Qfm-JDe0MC1XtBEYWqgDdt_4YnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_lGFPU0N3fgVTLRO78vg_iFFXGVg-JBksz40WWuyPOQ&oe=6A4CF641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMxrlJBwoVcQ7kNvwHn4Di0&_nc_oc=AdrY9Bghc-YYFLUNheTGtBkGbRyKY401_dOKK1Mls1RKqH9xcwQkP-a-t_sQ4EOrUgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1Hbk42VUFpzj2PXSuzflo_peUxKNii0Z3zUbpBU48Pg&oe=6A4CEA09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kirRubUVNHcQ7kNvwExoHGj&_nc_oc=AdrVt9ZzUADhYahUNhZPEpiGyXs3CvwcouvuYc6AJTBC6Ou2D8OdYtF7F0UD9DVajPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmrycBAuvJWtPtdu4Gn9rTqyixWmCHoU1Iss0GnPGGXw&oe=6A4CF77C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_y2BBCjJXMQ7kNvwHS-qvo&_nc_oc=AdqFhr280SPwPZ5qJuG0YmwAu8z704ezmEmH5kJK_GYSLiXSrLvTopxOSqzhjthwO-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAaYvqCuZ-rCNTBdeL3Iqn5WuXNoAyOVlLtkpqz-MzXA&oe=6A4CF608"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
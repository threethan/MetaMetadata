AM5_OQQ7kNvwElWfVs&_nc_oc=AdoxFPeZhv5lika4auzTFv-qkHd86ZKnnaiCg9L-p9h0L4zhA2Iu7HpNH0cEvDlIOPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9cyUDh4BjjI2q7gwsNxIVVrl-7ojJ7ZDRlyLZ5poakQ&oe=6AB5447B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ8QKJc0HXwQ7kNvwHiv6yp&_nc_oc=Adp9794ht7HmI31Thx6U7qL2amx3jdOJE8SNzkLQi8cwGYdOI7Bv8sR_GLbx-LsBCXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSl5fmwHIVWMYExEhIcI3znb-q3WjC3KmrJRtXSHb7XA&oe=6AB53AD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntPqAKglsl0Q7kNvwHg2FsJ&_nc_oc=Adpom8fur9ExgV_zm_3zJ5_a_1onSKTvlIaQTo2bMXODh0sV_8SW8MjyCuja1vaUfk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk2vUhuOjXtFYX1_QNKpHLeStRutNi0ihvyL3pbmt5Vw&oe=6AB51CC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEkUjlMjxgEQ7kNvwHYuQ0o&_nc_oc=Adomb7dECQTudSZGyF5Z6PEf85OEP7RojuU-WELHgt-YgAPJzeW7l2BavjRPrLzst4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ__a9nyHe1si2hItZavEXYsTb63MSgRzACNIpa6gA6A&oe=6AB548C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wEcQmqfm2MQ7kNvwFKEVCw&_nc_oc=Adoi01Nnr28gX41v_7CWVTjD96GJCNLj-Nb6tPJHUdEXqOflNaAut9Tv-owGS_xkMWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwTs7qPPz7ELVR9Q7PdMyz2ybcAYJFjLzyb8NgABF3rg&oe=6AB51DFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3iOxpOcr-8Q7kNvwF0aRDJ&_nc_oc=AdocYBD6O3LowP1k2Z6WJJdCYIU7d6YdxkEuSk7lhRlNPrGupZfB0lNJL8gPCROalvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfAxVrN4F-gF81xfI6DVMprHvrF8hEaoyFygZOYWPrhA&oe=6AB51C88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
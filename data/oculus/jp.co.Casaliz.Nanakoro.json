iHAkFUQ7kNvwEoyvGB&_nc_oc=AdqyJ8D1Z24Gcykwr5fnFLBSbn1nOc4dm4UNN3fOqJQVKtcv0HuGt4Wk_uKpsCb0zNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwEHYRd8Wp6tSlb4vP4gRUgYAn6Ty00amNphiZFsF-Kw&oe=6ACBADFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbxrtpNwYskQ7kNvwEVXH7q&_nc_oc=AdrDZYJOyDTTK8m8upaClVEN0-ttHtx3OTDO2YnBs6vEhRiF3OqoNxS4ISMPlLx5Y70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ5VfkUbppPJberqhGGdV5Uh-6gyx48neR7uhPfblPYw&oe=6ACBA450"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2oRw64Ic9cQ7kNvwHEHqKu&_nc_oc=AdomXfPbI04QN9L-yUc3nGmFfzqKFeDiJZMBMnzmx1WykM3SZfWnJ7VNM2b8bQFYl_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcl-RQdJi3JO2kwvx7q6IDG-rujE53snHzptOj6vewCw&oe=6ACBBE81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvl5DIOMjtcQ7kNvwGenMZG&_nc_oc=AdodFDeVMKy1UBUXaeiEmG1QstyOy--Too9ppDk2XrM-P3FOY2H76P4Ta_pATJdgGqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp2bWUsqQv3ieHK1RCj_uf3OUYnaLaMZOZKwu2RzN6Pw&oe=6ACBB249"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5LCW5R8KyMQ7kNvwFfje8a&_nc_oc=AdogSb3nmMOhDDiMI-ZnM8tPLXaAkb3l1g--9IuuqKiqOPq_mhaKlRNtXl2MaPuWBgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkloUC7CdU2cchP7-os4raV-C5vjfhbkZW6ShBTKZlaA&oe=6ACBBFBC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpAbMElzt6kQ7kNvwGNqNA3&_nc_oc=AdrxzyoDPtrHRl4CCxM7fORhc854MfkQEGTfTkIjFQ-wI-EgNyiEMGU9y_4MemHWf2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP60xuM64sF8XkiCHKpnOCkQCFwvWG4CnOyv1HoD9hFKg&oe=6ACBBE48"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
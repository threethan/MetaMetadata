1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP09esyYhHXLvBpMTkFVu3kE6YhQnMYU7wdv69NXoC2g&oe=6A7C543D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D7R5zxz-l8Q7kNvwEKjiNk&_nc_oc=Adp2rOzlOCvt6MjrmOag-iorL9o7Y5MPrYUxmgsSfAzAlVU4TB9MS3fsil87A2xzJ7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXl0M5-XBclCa3kKbj7mT-eNMK6Sek61ht7m1DQK1jkQ&oe=6A7C47A5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Znfy6arrjaAQ7kNvwGbjPp5&_nc_oc=AdrztqYVmX60vv6KEjkRmfJXuEAULKkKQFUAxSy9txxXJrqfySOR_dnvLS8jatrDXgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErxdlraDb8UZJ71WwO2BrilaCzXWJW8_z6_lrowHZCnA&oe=6A7C53BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTRGILCYHiYQ7kNvwEmfwEW&_nc_oc=Adpv88n1SXnRbASDtF1U_FuVkJNUzoIAWv6Nj7FomRty_tKfpt3lY0s_FrvAdf0Zm60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdt83x9dMKUmzIB5ieVUpgHAohNul_U0HxsG1Kf0h3bA&oe=6A7C4F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MK4Rp-uCMtMQ7kNvwGtL_Qj&_nc_oc=Ado6Z9gSr7dpNTwo7wrRj2uYXyoHR0Ts4WhUSSuRwsh78ZFp0uMwNLbeVstKXWSTuws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXckW0hzDVt4lvMtrafeW05Y6wpsMOAi-ieF49cSo3Bw&oe=6A7C4C34"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8Ra9r33ywkQ7kNvwFTtVcz&_nc_oc=AdqynWZ58k0WpJr8APrDjQc8QwfgphIPh_hpf-mrWd94VhDdHZdagZKvntex8Nl6hJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbyZy--Mm_650GgTsno42GlrkfXMetuq2XpfWolF1q0g&oe=6A7C5A72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcaGgOKHp8YQ7kNvwHgdGBQ&_nc_oc=AdrzOM16tw5tt3x9g2ZTpivTq-OcIKgvZAF2geKP3a5kSNRmVRdW2Ir17pqI
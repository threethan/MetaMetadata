70556961", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKCb0ONXRsgQ7kNvwENgjFo&_nc_oc=AdmDwuSvVo3126kp8OPBwkfv2w7-a2keNLjumds8nhVqlzPNO7KpcOxUomR614VigwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVPgTSoSeGyu2s-3eCVh2ZQgs29C4z7K3Z2TlmdzC77A&oe=69BEA7E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRXAW653spsQ7kNvwGOgJyw&_nc_oc=AdmtefcpjmyAjYT99owBpuHvqOGkhCT2-SskQcNlzlMNjtpDb4_XxKiWEI9gHfu7X-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyyhf0oxu1Pxlm7JoDS6VeEqkg4d_B6w9aSI4QcKFZXBw&oe=69BE7BBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmxJXVb1_AUQ7kNvwHr1Rrx&_nc_oc=AdlyAzlUHz_xhh0mPhpays5nDnMFunyoDEfIfXoet9u_BrmwBVcVkMBh6c0btdlX1MU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5lmDc1bDjVeDozCjHBrBjtTBjfFEdKdqn1BAfxToJeg&oe=69BE7731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjtDkcXeH_QQ7kNvwG0t_6x&_nc_oc=Adlg4L0EE7wyZcHOEp4THDrDoCeY_6ediQUcnLRh86-UGWFqCoQeyHv-yN1Ry_6k-us&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUWVPP77UUIgSiwoWmCqoFFFBP_-2McHV2qfId4uqlKA&oe=69BEAC74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdTiyAtyGDUQ7kNvwH5-KLr&_nc_oc=Adl0UbDwqhiXi_aSJFW2mwy8lMCXXOGDh1ucjkEFpfOnYn8O02Qf96GzT6mmGkiAWgI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEuQ0vdAlfGdnjIvpnac8XZxeKW58JprGcaDPEkTEPZw&oe=69BE8272"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utKdpOQ_ntQQ7kNvwEmuU7S&_nc_oc=Adlnv8wAhM0FHEYvdszhzxbTC3SwnxPf484c-GKQNy_iBmI32wlwpbR8QYdBRguI4lk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlFHP4j0xKBuvsH6Q9Ifd2aBswWrJMfGubCoHKcMsTFw&oe=69BE7F03"}, {"file_name": "2560_1440.png", "i
EvjK6sQ7kNvwHgl69H&_nc_oc=AdqHV4frzGHH6Oq0V_QhP0XKj5ZWfmlNalbX0Vof5gObt6WBG0bAvlsJe76P-DXPd4Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDloH6pzqWObPlolMPsZakjLK8Xyt3SNWSBe4Y618dVQ&oe=69C7BE3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHRUy1JcMhQQ7kNvwFY8EVe&_nc_oc=AdobwineXfXOHBMfK09bWlW9lVHO_XuA3wuCD4sGZMcBOMkdWL248wEvyxY5tJkq2Xs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQ7YdkL6vvIaRI8Fb5dGqNoW-WKnOljBUFtm2r2_qfQQ&oe=69C7B490"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYeUML1i7a4Q7kNvwEquM6-&_nc_oc=AdoG7orKE4W8AQbwEB1jUC88_j28TblYidmKBIliGMyBh5pacG6nADdbAVbFWZfL58Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1sC66awhHPcOtUsQ82a4iIamUa2xhy3g3K4eamVkJRA&oe=69C7CEC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aemVJDcoD0Q7kNvwG3xIuB&_nc_oc=Adr5HJdLlZOBziWovS6Eimj6euuL1xGEhddmMirb88l-Ra4kjVzqr_1w3sy39vmMs-c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjiXeq3bGtEFidtUbfVGQh7iJ2T7sYiI71fEwR_MnT_A&oe=69C7C289"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyWoTwIY1skQ7kNvwGAhO9i&_nc_oc=Adr-0SzAdCdBLBtmVapTyTQE1HdBWAvPolSlsWqz_ui8TLoPOsE0Gw5nE62GN5s3nKY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_OH90NaU1hA4UjcewjJaGlCB7CE8CK9BD0xFKoAizzQ&oe=69C7CFFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkEhkWmbuXAQ7kNvwEdlpIY&_nc_oc=Adp4PkjftWe_IGxYLBEHSpUT9U00uRBH-KYcgpdDqRgV3Pdd0TX5YVhltbJPOoxadHc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLV9AgnRtZRB6AUuUlhYibXl6vIdozaa7r1IbKiQ6A7w&oe=69C7CE88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
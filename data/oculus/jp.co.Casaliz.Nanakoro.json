arhap0Q7kNvwHc61DC&_nc_oc=AdoAAXfG6kNc0dGTx47o1rOk0Tas2xfGGmv3q5e3RNz7482tAMKR4erFlHXdvAxxBbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0uCC8IcOWgDfGkmq1tdxpqnkPDjH2JGZoaphMWVZHvg&oe=6A51127B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtyIzK_pdAQ7kNvwEC6Awt&_nc_oc=AdpRxsnGy-82tq3AYtnQyqTP9rokRHJi_4KRGscBrfxPM3bClE-s4_yI5Y0cHnkfwuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH6k85A9IifA6C-M4hHdDUoL5HwhacfHhyEV90CKiQXg&oe=6A5108D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxuUC4S7_EMQ7kNvwHszbnS&_nc_oc=AdobzQHFcXYI3PSwziXf1MPphGxT971Kx83rMcl7c0VqS4iXupzVlfOXh_KWi4oLZ1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChuCp-6fSBI6oO9q8Y_HRX9l9_zE4lH02E1NwcakPsHw&oe=6A50EAC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlQwx8oT6-0Q7kNvwEVZmD7&_nc_oc=AdpK1pAKHatMxL-9LnIlGi_3gXrK-166LWswGO8cyCFTVxOs9cfa2e_EB78VvfVuzxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgm81Ilxc5XPFNcXNRPPzh4HCds_l-Z4phVnk6EGvsuQ&oe=6A5116C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X8ApwHBkbEQ7kNvwF1KRAR&_nc_oc=AdputU5iHz-0d5Rrd7rMpnE_shzxQFK8TgLu0ZbhvN3ajpmtcnhPRVX77Fcin0IIrbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrr0CrMpJpUu2EN6iDPIMGcbLqYUYleLZbeGzH5mIMDQ&oe=6A50EBFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkeowdnPehUQ7kNvwFQ3xcj&_nc_oc=Adrv4h6ww5wQYOcy7fMunLLdwwyxyPiva6O8RSNylU9XX5p57qC6mNRgOafXa2HEWhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBm8xg3LhMNdjMdBN9520tx_va5njqo-xV_QpoSNIhiA&oe=6A50EA88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
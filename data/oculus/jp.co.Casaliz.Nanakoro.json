1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jn6jF_01qYyVMd2mE9WrjWpffg8b_lgx9ZykUFc0BUw&oe=69FB597D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAUwNVi3jTwQ7kNvwHxtE2Z&_nc_oc=AdplKpT8PfsP20-M0Um9Mu50LGCLb-4ibW0_kAEN3ggf2enlu41MSM65Or4jDerLk0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h-IwfuVKLyi2b7e4rl2TYhB-loKjVji6eH6y77x-OXw&oe=69FB4CE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAXvXKgtaeQQ7kNvwGt5dit&_nc_oc=Ado-VWiQTjJqJnvlhHGfL5ZNvnPlzQ9RdvWtu_IiwHjLujdVtbRe_GxA5anyqSgrqXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hKBmfkfg3AaN7NUq-G8EsJpEqc2E1jZs6o9Pyy0NHiw&oe=69FB58FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TFJro-6VLIQ7kNvwEXi6Ru&_nc_oc=Adp5-M0V5ghRIW_IiVQUFuLfUzcvSGSpGmVXRQ71c-LAAsq26fdWKbB4kEARkdkZORY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RQroFOIeyr655HBN8EXYtHegAjYikfql6fxKBCv1nKQ&oe=69FB5471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhAYF3c29EQQ7kNvwF-3L5F&_nc_oc=AdrdQr6R_6xab1LC4C-ZE0-aG2-9uErVOplkGcIPAEmxRqZSM6p-Sc_HK_-a1lcG1AE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p-eKn2ukJIYuuvUKymxThgTNrPRSzGaiLXexv5MnPHA&oe=69FB5174"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtysQQaPWvwQ7kNvwHyMC0p&_nc_oc=AdrS6gLrNSvx7EkG2I0VxWlGcCMP-RrJ8TM-X6V7OfjmHGXxW4zUTV0XL302srOv39Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CwSRlQNpKW8cx2uTotzFeAjX0Fy90LJx7hDMEvT3AXg&oe=69FB2772"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYjoZewyY2sQ7kNvwEF9UFc&_nc_oc=AdpW7zOJKaz8efIF20NIE7kkZi4rb7S2QQTW4nZMPtZT_rsQVx0smBmobMrL
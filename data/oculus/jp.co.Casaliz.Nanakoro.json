1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CymaE2066zz-afkV1Dz8dIJ1znZ0cPjWSHzfBY8TvJA&oe=69DE203D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfA4CILAKUQQ7kNvwFWNm41&_nc_oc=Adr_j_fZQ30fcPMWW02VrTA1KC_bvIG8YFqaJE1-1XE-O8usaPp4oKCNZO-lvTEndhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Dk5ztqfi6dZa1FnDisZgNoda7GwGkZRdvKhGVmvo3iA&oe=69DE4BE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtbEEkMy2koQ7kNvwFZYPj9&_nc_oc=Adqc_q3C-Qvuikf8D9etfOFRmDwttFNCzkv94dEQOfZ_8pzyTQHfM8n9iN0VdxDkDww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uqrnCq7oTlVkYZHFwi1U6BmOC6uN16cJ9Xc5G6gUMhg&oe=69DE1FBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb38AC9frKUQ7kNvwFXiQVJ&_nc_oc=AdpN_vDiiUOn8guLdbZIsX0BGaN0tkCu1dANrvaZ6V1LN49PrpCkvVOIf7pVOsQFrUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qVbN1zrexG_FF6e6wemA0TJxK1X8kGGiF0u3qdABikA&oe=69DE5371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoMWRF4EpMUQ7kNvwHHdN-d&_nc_oc=Adq4kX_CwG73uQovrAb3S1frMxeHlxK9PcacVJSygWcdU8YXwHothNmuIH-D4Ej5CKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ztHQ4bujSqsiuZl5dkxI31dkAq6DpjN0C2HaLvehylg&oe=69DE5074"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VssMobewo-oQ7kNvwHxiAVH&_nc_oc=Adrd49DRIDl33sowZ3Ja7PnbOgZM3xqT6bbOE11NELMNast1DwQPpmDsbYNe16zkV5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wzo6wUvbIv0wTaA-7_cXTwAROa_VwwZxaId985FWHHA&oe=69DE2672"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whpsg5bEIyoQ7kNvwE-6PbA&_nc_oc=Adpl6HWxRGI2OVfBSLyDaHpp07k3rJOO8qhv1CwYwMJ-wj6BVgd6kFyMuXpL
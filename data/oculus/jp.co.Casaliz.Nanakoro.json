YWUkilZ5-WhzmbFveU4iV5j7RiS-DrkI2XhMFWL0Y5nWVeFAtw67BxfN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlQLY7CT7RT8MuyK1iVdMkRN54xb_EaODA4KyJ5F9s1Q&oe=69B93DBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j_KI2v2B9kQ7kNvwH_LnaP&_nc_oc=AdlJmQsDtUORO_LyJdG7lnHAlWSCqE3jZ5wdTqccv1__tS5rglCpnaAf7wO2B3erR8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjwQE-pUypEgWjZyUsRMzObcVnwnaXH6revnACiTjZmA&oe=69B93410"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87aaMaf3JSIQ7kNvwGRDdeh&_nc_oc=AdkQMHM2O-lCOaLhdKTICTBQ3JT1Wwos0vLeihjl2jfXjs55Xl-p-Mms8zeOqpIro1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx64QOHlb8Y6obu0IpZJOThJOL4P5uhGXoULpI5O9lV2Q&oe=69B94E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aITXKaDD1MQ7kNvwFO2RGu&_nc_oc=Adm-MrrY2cjQKSkETPOIGUmHYlVMR5LjeQR1W6AJUJy-FqnqLggYI3CNKMpn61cEcjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqoOkCM8c0BTFzEbTmTlJtdHz0y1WCOR_IR_1VR3cNmA&oe=69B94209"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlRW5j_PFH0Q7kNvwFQ6FJF&_nc_oc=Admkq_EZk2KN-3hkOkdGCrzCf1VI075ahv1xif0UnjJY4aqvE6y9Z32pYAJ2sMHvITM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKw3RJPPwSvadL94KIburz7q4N-FYSfr1SIM9rzaGX1w&oe=69B94F7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4CY0vJd9JsQ7kNvwGEOltJ&_nc_oc=AdkGlsw9AfKdY2TBDhADLST_DCg3R1h_rFEyMjSnUluQutpCKjntVbU8O1uMqj_OieU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOZdQxbjgpbBQGipkz4zrBAWO9xQUnIxElAYKL9pztDw&oe=69B94E08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
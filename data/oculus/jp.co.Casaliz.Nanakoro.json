HVMuiot_s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXX3993Iu_NWWXcjML8b5Oa3XC7nQyjKDUqzUBT98NVQ&oe=6A8D77BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXY4KxEdUh4Q7kNvwFg7uqA&_nc_oc=AdqweFQsbiHXycKqX2MZUmf-BPqgRMcTW5t9aYicWuiBipOOp3Ry_F_VvWyUAuAEtSY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg89eigsH8Xm4cTeBy9QXAoPeOWxW9IjtjRA79pSZxvA&oe=6A8D6B25"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=100CqZURMx0Q7kNvwFeFbyG&_nc_oc=Adq6EwllUUHl8jmdQEcYyCRJdln22KXi9QwtK9d5dMaQIYuvqJiZdmhqpgA5G6kMtaM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMTTDDrgtolry_kaB4RB4Fbf5ko36FkgGblAon2kMXQA&oe=6A8D773B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXSi9IiZBDUQ7kNvwFa_PMx&_nc_oc=AdoS-u1dNrnB5QQVOWICsS_RBb3XiSL7i4K8_i_y3X7Kdjrr7k97R8qZsQbv0xEdWpw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6nxm4zYY-YpMRlnVI663l8-reFhdMnJDsCzqFzVWCNw&oe=6A8D72B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WW4d3PtoKIQ7kNvwEP4d40&_nc_oc=Adqz87UIH6hvccr_aEJZxeFjs0mzsNsVjLxmvcxq-dP5lqys3DlBUQE0LMTuZ9_yAFw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCA-11N1ngIurTNMlb4zGDVySQfgI9eMyalGalLgmCng&oe=6A8D6FB4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba3u6TcFaEkQ7kNvwHjxwaY&_nc_oc=AdrpuMAZj9IGIFL7HiPHC6JFC92bc7CUGoQE-me9LNK_hB4-ikqYb6t2fMl-StW5H7o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHREvK0EIYcR1pFFffAAzyWPEOFgTttHhPbvFNX6kvlew&oe=6A8D7DF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah3TgkCstIkQ7kNvwH3B6MX&_nc_oc=Ado0P_rSEBAL8WT
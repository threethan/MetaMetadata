_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af939zZu_OItAo0yZ5mi6dFtYhne-uM9lCHLAW7F7oAcFQ&oe=6A394FFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YW-bQ5JrNYQ7kNvwEinZn7&_nc_oc=Adpsx3BBVbHystthvYyMNscuPls-sINslPRzySIUIhMslpQvY5die0ZgnmN2Ltl3UKk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y8rExb_Vm5wLtKR44zMObtsbVK2jd1p3BljyXaF7wqg&oe=6A394365"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8nIjtwjzPcQ7kNvwH09JWm&_nc_oc=Adq9mOgswYpziJ95vyKfGvxe8hV79TJBP9CLdOp-m_d_qYtEzgozG-mLVqcfpAFOuRY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V33ZRs1IMa6wvAs6_5yalN2CDD2PA9iTZrn06czYp8Q&oe=6A394F7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjUEIsAFw5kQ7kNvwFlyE-b&_nc_oc=AdrLuhrPbUOI1mj-HVDIjAwc929CIqpYKLZxWj4PACJmFRTR6oeTyuxuNxaGq7Eb_FY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ofY0ZZKPAHM37He_-iOdjVH2TzEHl4EXUIzCs8Bne-Q&oe=6A394AF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJJzul9nFu0Q7kNvwGapioa&_nc_oc=AdoxbrHsgkSrioS9i9F3jUFFtKUx4DdUSbUMjAAn5btJn6a_ypw8nKdGbUCDcXzVEps&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8JKhgqBKaFP1WNJEIJLsPzzJ6j2CJRoQULPZIRA8HJw&oe=6A3947F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqcLu8VrL8QQ7kNvwGe0Obj&_nc_oc=AdpE62_oxt0CAEojryjViBmgUTKZdWAP_zhVNaiI6s6WeKP4Wlxui_RNExXuvj0pluo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Du0wvL899bAx8l6U7aLSXlBHntZY6tPQpWMK-tEyDag&oe=6A395632"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a34TOIdK8uQQ7kNvwHuh5Yd&_nc_oc=Adp-UKmfpjqpkUMESQvpf-8SWb7238GTVHO3Nz4pSo
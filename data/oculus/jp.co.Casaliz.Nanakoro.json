0T6liScE3fEXDED1rl8mrbnmivIQjBQLYX0xRw&oe=69986C65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD6sxBlorL8Q7kNvwEjCgmX&_nc_oc=AdnUT3CaZsDvMa-r2rkXCkzbcqs_si7lNBn5WwOy4GjVzMITVtqFFp22RNvYtUBBTc8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuA384lVhn_oPHN2K2VCmAkVwVEZtS5RkwxuMU0_VvksQ&oe=6998403B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se7tlvbDmRUQ7kNvwGk7QXt&_nc_oc=AdmV1LZ0qGpD9CL19gDaDF5abBYPzuxLCESkvMX9lNJRrXPejOKTKOXyQatIMg8YatY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftqTkMyJGyW7Zlky8X-3aSzd9qmrXubYiGDeOzomT1rWg&oe=69983BB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp1TcCAuNKMQ7kNvwEC7G5Y&_nc_oc=AdmVEkzmghvWFXl7iLkAmAanJ_fIU5oe6As4fA06IyGpgjS8-ZaTiEnIfItJRFq4OBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvldMBGO4HQoLBdlv25rhqJb2binSGdHvD1vnYpOuQLjw&oe=699870F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw5HOZfIFJUQ7kNvwGKOUFN&_nc_oc=Adm_i_BoV_GEp2R02ZScT2NmO80k7zhV_37lNJxTLw5dIvtw1fJ8klT2TYGqYZqupwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsgi_lcGQsTUlgDKV0z74IxWLlLPuvgObtT2eP5AHdyWw&oe=699846F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_q9dYzQHokQ7kNvwGj4EEP&_nc_oc=Adk0Zb5IlaIh4lyTsGXcFIildalFbXpCkxr1qPBprUYXTeI7Q6_dTRJUoTkEueKaNbI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afun1RVogPK4XW-Z6iOQrZX2Wh_F09Xfn0IbpX-XMoBVhg&oe=69984383"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDIcNjWu2IkQ7kNvwE61s1T&_nc_oc=AdnFeeY_hZUlvDhqmG7bXV4PftBpCuPzGVwX_OVGlc_9I4njSDiybp4drcpo5k1FqfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvtG7wEy
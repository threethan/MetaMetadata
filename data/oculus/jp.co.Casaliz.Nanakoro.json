1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASf4mtbi8jA5DyczCYpaJg37XXUeDVkyMxHtHdxdybDw&oe=6A4921FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlIClYdcnw4Q7kNvwEwgnGj&_nc_oc=AdrDD6g8CIRmNIo5KDrS6KbSn55emLDOpO7QNa9ttQRWIOqjQox_pTp60CY_WOZVJ4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtK20nLKL7gT9E9DYc2-8B9hMtM8PBuMR22LcbJYEZHw&oe=6A491565"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cVfha9ZuGEQ7kNvwGA9I6U&_nc_oc=AdoIbZ6M_Xek2GrAqeUUdJJZ0DtjA7MPS_rwrfhqp10OXCqmOdYHognsgZ0zSmo0WIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-5vKzNV-2V7XPT9jXDYkC_l9KfbU6BqV8tVoGtKn71Q&oe=6A49217B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOGS4WJMp7AQ7kNvwESZ7P6&_nc_oc=Adq24X1CI6b_MQ_LMU-KBGXx1OP7Wng-rim9AtDGgLxWTqoXAAYcnZd9H96-qVcYlxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5OV2-NY21L1NGkdyNdjOudS0p3wVFwk_PcusFLpVkqQ&oe=6A491CF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyXMtAAyrksQ7kNvwFxoZpu&_nc_oc=AdrSkg6iZLbxeT1OYn4P8Y5EOUBcUWjt3hFHDfzIjSpSbVmpnqqm2x4CefFMSjxAxMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmfox4P6e_z_2sXiapE1pbZhgxpbALQHCLkRGwRu1U3Q&oe=6A4919F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m01QlJ_7IgUQ7kNvwGWp-uV&_nc_oc=AdoQ72HfG0xO7_ZL6wR0B_uApz7s7CFYheurts-GhVgLqDThsYwx4tQF0jOKBOL53Po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNAyoxA60uepIBvPXrf8uuTk-PIK3g2tOgmFuydOGrcQ&oe=6A492832"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWdjQWAaSkEQ7kNvwHQpFkq&_nc_oc=AdooLGmtolPGNYM8hl_pl6XMiZPLJg2zWMkuH8NjUt8TB9NfZnT6qkisL8ZP
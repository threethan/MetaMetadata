2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_AbKks9EYDjxfKYzT7W6kfebkEvM9S1SieZUCNUJHsg&oe=6A7B02BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D7R5zxz-l8Q7kNvwFlTOHE&_nc_oc=AdobFDCqCPJzfdtbja5Kz9toFF73nd3195s7m5d7tls0u5qoo51eUJt3tM5MvN2-zUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuuCuIytXpMUH4wDCNUNo_Ex0mgQOU333S8bGw1APFJw&oe=6A7B2E65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Znfy6arrjaAQ7kNvwH9i1jI&_nc_oc=AdoSihSUaAsTy_vv1wxJ8D2jg0EMinLMY2s-d5hVxefi1X2r3w3KZ4cpL3C114BPP5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_gj3wGOGkrJ6PwRrfQWhvW_Z--XUnD-NMxE3gVgpSVQ&oe=6A7B023B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDRQ7Z5xMOIQ7kNvwHkLSTc&_nc_oc=AdrjffswuWLy9clrj1M2-9slsE87Nvib27kNHgPs9k4VOOyRsMcTP9bd6PRyQ9XdZG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEufdVHFfXoI5VrEbEpxYdjelQ4R4zw5uBdIm8fO16_OA&oe=6A7B35F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEt3zotffV4Q7kNvwEkhvZZ&_nc_oc=AdrpiNnu1UIfiYRqkjXr9PMPozrzpoCjUV-oqMOQPLgcSV4FqUVQawCkOjuxunOJg1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPF0R-oEc__bzYe-kx6DfJw3Qe8CcThhrhRxUPODNFXw&oe=6A7B32F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8Ra9r33ywkQ7kNvwGau8Pq&_nc_oc=AdqS6Zpa63iCJw23IyBx0JjG_YOmyZIApAmZpderhYJ3OCExVgzmKZZJYuziar6rgqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ1ddrQhAVENtkADgzft5oGwzjp2In96X4DnXCarzj-A&oe=6A7B08F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcaGgOKHp8YQ7kNvwF2_zQ3&_nc_oc=AdpRIt4-iC4i82VkHlgB6kTyqAhWic6HWb-qWNUFZFrm98uuqf7Th1uEnQ5V
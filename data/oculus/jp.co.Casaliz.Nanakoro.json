_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISruHOgF7Vt6wtm1CyufSYt-OtNmUNWAIW-oPvNw0yvw&oe=6AA4197D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAXxZc_iY94Q7kNvwG967ZH&_nc_oc=AdpEv5TlVgk3yjcKYn1a01DghNafms4qSo5zDP0I5rC2TqctkzYusDh7Ij_W5J7Ope4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvi5Eo6SlI9vXs9C5iv_SWN19XPvRdQoEVWAK0Z_eAIg&oe=6AA40CE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnWwD8ByAO4Q7kNvwHDhBIv&_nc_oc=AdpXOrTD885tmdb2i76rbl0jb1THO9kr41Lnm2QRkxSVU3NTzi8IvAaqOUmiMtZCRMY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUqrtqT0sEvTyRtVBWhLZKUqL1i8foo30CU-DnrhpufA&oe=6AA418FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rzsgf4QLVgoQ7kNvwF_Kjio&_nc_oc=AdqhvNrdvW-OxQV7ykaIEdjAjmCjTJNo-NkgP8BX2W3zfIJq_k8lWRWkg_tdGXeRKwM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY6n0d0wz_YyNcBenFVQz0Rzj4AwcE_SbSEUN_VJEJFA&oe=6AA41471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsHVg0bZUn4Q7kNvwF8pDyY&_nc_oc=AdqoC4qAhHloTyXxUSDjV2tWWkeZ6SvdLInZbe3t_vf2TJyl7QlJoASn_G5JklWU5UY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVaMmsHyvdQAckPS-P9zDc5vkJCSZxNnVKboq5q0N_cA&oe=6AA41174"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQQiByNJv40Q7kNvwElmN6l&_nc_oc=AdpgsU-nUqOqCVvdlfNNsgfn0c16QJcRlmZOsoWJiAcwgD25dht_IkPnZ40uvNgvWdo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNaC1CCWS1kG7qDlq6mDXu5Vs_t2lkiujtBI2KcLpqvA&oe=6AA41FB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYSxErT5FXYQ7kNvwFiR01h&_nc_oc=AdrWRIp4FCq8krVsTcQLq6fJXBnO6wNIuAsFb7eh0I
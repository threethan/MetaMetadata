2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGXE0umR3azfKn2hZUzOxPPH9MQsBbtYmo_uNVCvaRew&oe=6AC6607D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8nPqoCOI6kQ7kNvwEHNXzn&_nc_oc=Ado4wNKPZexipaobczMqjYL5BytdkWBIs1xEtfDHOy8W3yshyWTcy2wXcunQS-rvk14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVVWeruxZjjVvkVq_gDxH-n0D4BDsdXRonHtSW017fVA&oe=6AC653E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9OAojLEz0sQ7kNvwFECCCb&_nc_oc=AdosmK3cAwO2NanHj4jJgAs3u14nnqB3W1FsbgneouNBqcCnA9dpU6MEoSogFCEX3hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4FyXauIs1gvSzbxrFOCTSRXTUIGahPjeVYnpPlVlOcQ&oe=6AC65FFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJYTqzeOdoIQ7kNvwHEGUd4&_nc_oc=AdraFz0tFtmKIhUAEVKEur1dUXuE1sROEmh55s2CmUNsmhZxl18NIH5Popk4EtgGIzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq8gcu4tCeHXTkxKq-48GCyoeHUUc0hMn8hOydUjwejw&oe=6AC65B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcNQN47s_c4Q7kNvwEhihMp&_nc_oc=Adp2mXWmSD6ELqcaHHeoPBH7Iu7KqEj2si50QoXS2hFRxcI-ihqLDHmwsGOTrTvkxiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0yAs1MTx5N1MJ1sHM5fObyJZB6dMfgomHwk0iHQ8gxg&oe=6AC65874"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUUcPfQZsoYQ7kNvwHJwatz&_nc_oc=Adp8w1hAaLvc-h1CoiU7BueIM82ycfc32Jmzp6-Bo0a1RUsKhPApD5A5r0qkG95Bfd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXimTdeqKSjgfinEOrvCwjlQd5-O93s5eNYMRbZzLx6A&oe=6AC666B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWimkfk4LVwQ7kNvwGthOK_&_nc_oc=AdqzsG6UcEanM_6rJvYR0X8L3K3HQAhOIAuyRdPlR3_wk7cuvKdrE12shIa7
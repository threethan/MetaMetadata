1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPy69DQX3eHeIVKaZz-0OzUlHeu2bTBOsCKviJ1TZ4PA&oe=6A983BFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzfeEuP75pMQ7kNvwGVZfx6&_nc_oc=Adr-JuCQ55G6FCHwg9xuOMuU4h9wz-3EHnscUulstIB_vP28hluOMuNN2h09nSs_aaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKUqrIg1J1_jx8F-zNhmRuSwuTum9mIoiCIGW24hVPLA&oe=6A9867A5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CswbQ9WrukcQ7kNvwFCc_oa&_nc_oc=AdpqsJW5CQuhF5GuKvhx2o4AZvTUceeg55HWRnYHau_-d7-YWP8eHQhKpv_JngVXOUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOeq6qhn_tyAfAS9ptBmvPFUa-2tViS6nUJmDlKXLPxw&oe=6A983B7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlTCGQf97q0Q7kNvwEqmzF5&_nc_oc=AdrxAHS9ic4kvNSUeJyKSpIUHylfhhX2Fbmm7z_mpBU0z-Vn25AvlZUBSP_e8-_cqJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq9pc4dcHQwCg6DAmhvmiK8cUPt0JLVyY8HLD7_j5NXg&oe=6A9836F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gf1YYHC7v4Q7kNvwHDjL5F&_nc_oc=AdovayKJeRu9lDvWnf_JCLmuHpx3MuVKhEglpYu7zcX6fvflDRJNolX50O5SysS7S-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3GLCY0CDk08xriqw9ba8geJTkYeiogmYrU85miqq7WQ&oe=6A9833F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxvg-KNTLS0Q7kNvwGewF27&_nc_oc=AdrnfMdYJrC-Bt2vFZUuzCBcKoXjJpTIv7wOXlA404bdwXGWiZIbKxJTARx7Y_6DUbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd93MNzRi8pV1FlQooNQbLwq8rs0kYiio5YxiTPubo5g&oe=6A984232"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6hilrlFle4Q7kNvwH7QUKo&_nc_oc=AdpZFICLc_-MZ_4Y18IDHKCs5gHf7NjBb909zCNEUzcZX9iVA3btffP1WVa2
70556961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKCb0ONXRsgQ7kNvwHUuTX8&_nc_oc=Adkq3Dmtcc7b-001FSoFs5KeqRe3wf1UAr__C0UyYlcH7cZZXWqNrAlysdndMfSpYbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6TuRDNxE79MrDk-I3ObkN-OTLVLdeBTT6vy6Ooc8MHA&oe=69BFF965"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRXAW653spsQ7kNvwF6HHGR&_nc_oc=AdmbF9k79mZi8y9-lgq3uapoEt_G_loz6WlDW_eBToqu3_9VUezteOPzmbKEGt4qMAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPpm2W2XeEaagFgirvN9f9wFmMqyisLI-VVLq9j8Ie2A&oe=69BFCD3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmxJXVb1_AUQ7kNvwEHOSNs&_nc_oc=AdlD9m0n1jf_H1n1aYUvpiMT49IyPGjwmaSlgwBWB9cP3Obmhs84opJeG_UgBm2mbrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNu8F9ZINVi05Etmck-Bt3Xl9N3ZTWGgMMHnvrkVaaTw&oe=69C000F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjtDkcXeH_QQ7kNvwGb-wCi&_nc_oc=AdmhCpZuFH8neoXQFI5uhuMtapBoOkpP-P6TicILlKIMQKVhiZGERPi3kvLQTFR234E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw04PjHZTyarIarYoMgYNUIxIit29h50FPRsvmqJFJCPA&oe=69BFFDF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ99L-BmthoQ7kNvwG7-kSU&_nc_oc=AdkSCN3FNqieXVUZIFlsS4OEC5HMi4hj_UpjQvNNwMpb4OoroRHW7cn3qQkXyvY8Mgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVmI6_szkECifOHTshLD7Ir0oE4a0obGxDTXM0gGAhSg&oe=69BFD3F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utKdpOQ_ntQQ7kNvwE_IuxI&_nc_oc=AdmvtSGXnxW5OePOg6HY4AuDewxXqJL0lmZ7tF506UftovB9wyW-juOMCh_lYaKbB5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4-x1tHvN7oQS4IGXTlDKc-xg9XNzOqPnZNSh2OYRG1Q&oe=69BFD083"}, {"file_name": "2560_1440.png", "i
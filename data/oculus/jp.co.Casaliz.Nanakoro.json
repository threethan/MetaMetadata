aKLhxYQ7kNvwG2zNl9&_nc_oc=AdrGnP2tYhFphPsRVvfMHrHFPMcbPS82pa1RUbfGHbRZ93keu5E4Y44HQHp4SGoSnAc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dIS7vc9XCK6Nn_oaK0VpFWJUupjReeLVZJJsMxY_FwQ&oe=6A34117B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k67gKpNlUYgQ7kNvwFxZM0v&_nc_oc=AdpwC8mPwl5ioJs2nPlhka6RS_mCzOcDYwaKOy80rfOF2a6LhkTNtr26DxyPXoiZUzs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8S_24sgdGMJZMDYP2xHGd__oR8lSHAp7RaE7EJlel3Q&oe=6A3407D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSvKPbQIXygQ7kNvwEiDg9k&_nc_oc=AdqWGvQ6K_2tZ9IU2lQeZ3jyuEWY1u7PVOVmOMVObM7W3bvqU63V56FdkQ3YZfz-IwY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y9VZrA3_0jiL309dWagraSX4og88pKzyEVLeTvZs3HA&oe=6A33E9C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HaO3NnKjJ0Q7kNvwFiiJ9K&_nc_oc=Adpl9m8qh7eNgio5YNTi0WVLlov5vjsDVfys8KrcgranhNsUBA4FWEQaTLnLB7hz4SE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bCW3qXDTIWffj5TvhT7onp98XEBPVlBGzpRcpRk8fhQ&oe=6A3415C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3ELA-glM4UQ7kNvwEbKOVU&_nc_oc=AdpXq2ppiphFFogmIQAHYMoj9CyowKKL0dhIry1LY5ViimYmVcLCw0nW_Xe5sGNJ1PU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_50Pf3gCmx-iynaJHVit2RtVxzFMY1sDmex_eyjoBblg&oe=6A33EAFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh5LqmbSVwQQ7kNvwF_66WX&_nc_oc=AdpiB2W3z3oT3QyZ_HC57LFASyO-SZL3M910UoT3D3jNaHhAqgaa5qqjdy8b1qo8NcM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nXA4sum2hR79jdPUgDzBYyUVTTPS59ialDHMe7hcUvA&oe=6A33E988"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
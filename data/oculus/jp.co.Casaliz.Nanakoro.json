EibdgCAWMDnImTrjo904fBONMU4GB5M86Ezfyg&oe=69A1A6E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rt6DhJ4ttAQ7kNvwH1zHdz&_nc_oc=AdnWavQnBndBcDjFwkLPv2ntELm196LkCoJWXPekI3uau5AX2hz5iKdG0cEAJA2sMrU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftZGUoqj8WAKX5A0oQok6u4K05XXZLxAhGax9RzybyJcw&oe=69A17ABB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpoXC--cE2wQ7kNvwE5jS_9&_nc_oc=AdnZAnBXIRfQ7Uh03ylROa-SvLjvKH8CruDqWdbj7GvpKFt9zRaS34kucUZCBa14ZBg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu7obqlh36qmxhARXcOLUW73lZPXsmj260WUX4b9RuLuQ&oe=69A17631"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3bOhvRgV_EQ7kNvwFe4QFe&_nc_oc=AdlTr7J8RH8iC26qlydS-7QHogWK1jiEv0yJg1NtEgBCbC6r-0epqRelERL1I_FxBwo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft5PB8u4Ryyln2f7UjTccjsAsKLihHG0oz7otsnUXa4ng&oe=69A1AB74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGonuwNABtYQ7kNvwHOkiHS&_nc_oc=AdnhwoKidNyO4qLYO_H_vRWqPw9dFf64BUn1wF16O3sRxfy1HIPJv9KGU3_hMkx2Ews&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft7yvKItezYv6mUm5oeeAaPlPVA3zc9MW-TLs1fYpM0mQ&oe=69A18172"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUPOj8c4tpUQ7kNvwGdHBMQ&_nc_oc=AdlKpQ-p7dyjArQ7qSMU0Hr4mVA_dwPZp5yggA6gWA3ZwU3zAfWUZLFyo6_6HcqCz4Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvWuqVByv8HzEp9cKYXEhzVVK8LxR6RYHRASFqzUExmUA&oe=69A17E03"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1F_7MC9fnAQ7kNvwH6KHrY&_nc_oc=Adkj3yXXAwJF1b2Jlc47PmmY8eyavAQOYA9O6w7fonCClIKtathRiuuyaisG4uxDJIk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsO18cQO
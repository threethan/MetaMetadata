t-iad6-1.oculuscdn.com&oh=00_Af11TtuaqQB-6qRMnbyW6qC7Ojt2DVkyym70IoM4FS2ZhA&oe=69F09CBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8q28btznFYQ7kNvwEEOznG&_nc_oc=AdqhlRjhly31PSRbnUmvRKBsvWgeaFHHCBBSegtg33_JrEVkML2SbKINy24KnG49u00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2cBHxhTfO_ARU22zOfj4bu1rnImv5AGPYclvHROGDzcg&oe=69F0CB50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L_x1Npk_zMQ7kNvwGmcRCl&_nc_oc=AdpiomCdOjheSfTcNsy2COgH5hLRDGlKLKw6yA9uCi0Jh2O7KGEFeodXkP_mVLTeOes&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3TucAPoRYYUZIF3meATX-vkOkYqblEfbI6N2GoPHluNA&oe=69F0AD41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuGI1K3tLTsQ7kNvwEyO6Zy&_nc_oc=Adr8551ebWSPkCOJ4-yP5taDpAE6q7lHAtLly66sKTpFdIlsaTTLc9R6IA0qD8fp690&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3xLA6nq_UwBOL1HqQ-eBi8EBvh1wkzYjBfH_T26Sqcfw&oe=69F0A109"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p49XMj8Fh2QQ7kNvwF4hvyx&_nc_oc=AdoODSeBWYwG_5jZtL8SSNhtk6cW76SXK8IB9QO4rTODikCOMNZJq2nPDIFPAX3zkas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2TFnmZ1EB4ynty2f9C0lt79GwZUbF8K8boYlAid0E5Kw&oe=69F0AE7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqS8DKbVrX8Q7kNvwGFbE0H&_nc_oc=AdoN4ZsHD6YhHadoqdM1v8BLy71Awlt-x5ZQacFOairCQmu3Nr1eeFffLze8c22ABks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af371oX1Y9j49I8bLPmzsFdpFFFoRqJa5TJKeNE__7y25Q&oe=69F0AD08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4CtZqKJ07MQ7kNvwF84bgZ&_nc_oc=AdpwgZLUVRd3wLs8EQR2gI0Uh0f2MC7njArCP69iNt4TtCwWpKdkelOZnjrTqw69uIw&_nc_zt=3&_nc_ht=sconten
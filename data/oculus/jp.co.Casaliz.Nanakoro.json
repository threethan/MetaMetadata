1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HbI6NY8w_iOb4pt4bv5tp4RWeUD9wH8ZWV_Cuk0BYYg&oe=69D6373D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcb31F87RDEQ7kNvwGMpPpe&_nc_oc=AdrQ031dY-obRfMRIS9xYDcwINLXIxKhxTEMY8f_8y3Et8-eBmXQk6bqcC-Dw0Ari_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p5I1UfROYd0huGgxVzNTq2xTb18-GAIScRUP1-JdSaw&oe=69D662E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN-3jZ2srpMQ7kNvwFSVOnb&_nc_oc=AdpVNKhJ45paSq45KuJylbeBT6vFbesd5jjwazFBXPrYuBHUMZ8OjT5Zb67od0wFQ68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tSXSbNNMwJxm3QZVUGJu8L7AA3dAucP-7S7YCVsNQbA&oe=69D636BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV2xYrTULxcQ7kNvwEBo2IB&_nc_oc=AdrO7FEl6QjVHZiPGnJ3No4ERW53vw6SwFv5FKswAtjvatVnFn2jCYu5TJ7GVf_jiBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34c0eSn93MU3gj55mwIlZCWOq4chqAiFYlezpQKFqPUg&oe=69D63231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUOFVcuiOfcQ7kNvwEkzKsc&_nc_oc=AdounApPOD2CCiF79E7Rl9GdmtLE9taSsCw7WWqjvDKY6EjDwg146FdOrnriq0pHcgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IJFgX3HcVn3axoI3d44TfngrneEHxAUn6t9ETf9zL9w&oe=69D66774"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh-qoypAAjAQ7kNvwE7TnRG&_nc_oc=Adp_zgJVI1H36ze03KD7DmxF5PfUZWzwRwP7EVgOnm2F8tyMY6rhjjg6SFz_-dniDFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BezrbLZJQUd6ROX7Entwtvh2Xr0_xJUn4YPIbtM3FnQ&oe=69D63D72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1NiYsLlthcQ7kNvwG9UqNX&_nc_oc=AdqGI0zBT9VVpcGUUbooFWanyJDO3_M_QY6WweDfEoPHyHI986jhSIn6ouS7
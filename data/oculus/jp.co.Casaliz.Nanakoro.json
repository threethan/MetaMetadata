1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx67q0Pwg7lhPwFxWMiNCKFQ09clf4b4f_ECN6AF5UHxQ&oe=69D0F13D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k_hmjC1-SkQ7kNvwFI4OGJ&_nc_oc=AdrAL_jRhPwRnnf0jqz8quNqHJRCnXs4v6ydIrh-iGhkDV8wDpYv1AgsgQk-UdGefUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDzU_-0piawkrHEX2EM2dMv0a4MLoHZ2b7a1Xt6oz_qw&oe=69D11CE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V34KjVh_s1MQ7kNvwGOUV36&_nc_oc=AdpjQqrbSzkFZBWJYdwNrkXGqSVC69KjSHlUll-NJNwbX4JhIuSclkS6c5uh9zNXqKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygDZZV5zBHw3Jz0DrpCxVilQmIHCvkIP0OxC30-JOrxA&oe=69D0F0BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mLZS8GFB8EQ7kNvwGYSUgD&_nc_oc=AdoGAM_3KhHjiWE4a4f9S-LcPghv5TwRIB3TOUdOnEN8YsC94o0GyPONJekVxQcdZkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg4T03f-KUexHVxx0uTQoEzEB-O-YpMxPUgYXuaLNBuw&oe=69D12471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW6LVYwczz4Q7kNvwH9J7Ac&_nc_oc=Adoly2u4bOD49ve0N4ABNXIzGSwE417tEmF0ObdE0ySAlnjrDdvGNse7-ubJQ77f7RQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5AQH6PjBpnsOjsa86Ot1knOFApxyGSOubhlyZNWPRmQ&oe=69D12174"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRrX-rt4Am8Q7kNvwFMfSWy&_nc_oc=Adr2MPEQ4PXMKgmgzhTX178M3RTcTxjQJLfQs5Qdvc0WFQ991Lwylyq5ywnUN-SZ8sc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynSfZFnnllkoESMuVJJ7-6u_JluX2-745mMY_uSjJarQ&oe=69D0F772"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGE7DLUR3-0Q7kNvwEIJOIE&_nc_oc=AdrvChMXAh0t9xdtGG6L90udiywAArHg4C9hrlTD290s_C87E61bUNply2NP
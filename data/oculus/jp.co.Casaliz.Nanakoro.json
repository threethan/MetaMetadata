aKLhxYQ7kNvwFp78MU&_nc_oc=AdqSfxNaZazOKCrrqgRsjpoQeSzAuozzYRHb-zsUZ-XuulstnSXAATbFDvbA5zSSb6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2MEqPh_Y3Bo3E1uDKEDhE08ljwEXHRnXqoNc1IOHnRw&oe=6A3562FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVcf2_syML8Q7kNvwGkYJHm&_nc_oc=AdqbTrO-YoM6gluXNbGI5mR78IgSn1mZGSn5QgfZDfCbMJS5MGHQi3_zZXe8SwURYl4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rOnWhR1LhsXMGgqsv6PEMk-Dblw5doev6xiTctUk0WA&oe=6A355950"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSvKPbQIXygQ7kNvwG_vr3j&_nc_oc=AdpRXivwwQ2iob8sy4Sy2xeEybOPGBMziHrgi7K5GWWvhla1tN-jIOrcj42cbFeoeHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HCh0VrLChy0q8A8chL8DckohmBpmqktQ9APtVkXcDZw&oe=6A357381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Yu1WAu6yQMQ7kNvwF40lVi&_nc_oc=Adq2vkIclVfouBpI3ftED-mHFI0UGfTDbYzcubPUFac6795SHmXEXYCN0qgs1Cthqnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91USv3sB5q0-Xgfzlqf6EjoVINN9EYrfpZtTlTRi9wKA&oe=6A356749"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhGOKJrUjA4Q7kNvwHJc5Wc&_nc_oc=AdpXDiUp4EHpzgsXGupcj9lJWClYrXoABrlME5hkU3OApwk8bRJUQq02wDqcZuud9vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qh2QHveDnr2QEXvzTNwwfcSp_nkSEmJ2uyqsDJCUm7A&oe=6A3574BC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzd3J23bWbAQ7kNvwGBK3L6&_nc_oc=AdqQiX-oag_YAFoRYCK1vVd2HAyR4k89xPlmzG7rCEEY5yNV-tW_yawHxqxfLrlqcVw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b5xSShHWeVvi3Fooi-zTIzGMI0B-WF7mW_wgk8CvAbA&oe=6A357348"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnlupOc66c-_Pm3FEMFh4IM8hJBAFE8Vs_KFrPgK0AYg&oe=6AE0BE7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUAvZz68GHQQ7kNvwG41yED&_nc_oc=AdpRbeGPdbN0M_CKESAqb2xjOnTN6QAMYRHWJuNHW1Zcl1eZhXUQBFm4V2TZrR8xRS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObtM9JbLSPBL22ozQdzt6U6hc-xPgdKFH7Vlt22TJpXQ&oe=6AE0B1E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIMqlSfLQmAQ7kNvwHVLjVn&_nc_oc=AdonbQ1DN6QcZFwnYBghIOhgDvDnpGbK0o0gvrmnJw8VEnsdbeCCk9OxzFb0JWG_qpM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMF_GEUyfm9x2gfEf3ZVRiuFAcsjG2wOuu5OB3xhbuEg&oe=6AE0BDFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hh_XdEQFhoQQ7kNvwFEafk5&_nc_oc=AdoOMb0voP4hLybEjNOr7iAr-ZLGUJ4QZPTwNdyDybVjePAxKM1h_q_pNYpnVuHWCKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8LOqYP_untoV0z4ybotzQ_LsntbGzha_qL7Sa42JJZA&oe=6AE0B971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnMhh7myvggQ7kNvwFInjh7&_nc_oc=AdqB2LAsGFZIzT2qCWgI4BsXAnBjocdmmVEjNdpbWqON_Aj225OJ73QCok8h5SNVSP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRwCggP4KcddPQOgB7DrYpSTzHD-yEQl7Wee93tB55mA&oe=6AE0B674"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8YzY_mGplMQ7kNvwFLwo9r&_nc_oc=AdpVgmoV-q_hZpAjMqLVvnV9GZtESha0hh0wH_ZGjrzv0hqh320NtPBWdo8qE1nMO3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAe9AciQjS__E6s9aNL7jMC0ASNVDjokTXNzAH8VOzwg&oe=6AE0C4B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gu-r74w08cQ7kNvwHLMb09&_nc_oc=AdpjcsPwxrYOkb2_LN4y85PBPm1X6n_bGkX3B86w4ohuS8YI-0I7Rv9nrf8Z
1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fy9Nb6-tUF1kXeRUxyqKDy5sEG4ckia5hCvCYjQMyxQ&oe=69DB7D3D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OH8qrg1MBcoQ7kNvwE-VHVr&_nc_oc=AdoGxHSgaeLN4n2_qGrEE1yTrnmP46ozMNM9iD9596-G4Z6JZtOBPiazu1rwra6Ex4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wZ-pBAZMgHTDr-VZkeukH-Qw9byliwC7H4QSoFsBbng&oe=69DBA8E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euLj71_LVuwQ7kNvwEE1Mqv&_nc_oc=AdoNYoySkWvm370_eTjYoFl5duN1g8FSGBVl4JYHPU8FA53IZ_EIQQHQmOG9q2mlMA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z3QA8y4Snuo1cGquyOTmzUGXb9V4XM2ID_R4EGkXjYw&oe=69DB7CBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE3OG2pfWzsQ7kNvwFXN_E4&_nc_oc=Ado3_9JOu7_I3e1oK4XF04pDoXyrhl6TYdqOgGXSwzUPUXvqfoEVAd0FqxLwinbl3lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PnsIglYSoKQBx1_BYyHZF-pkdQI4repLGDBNr0f2wRA&oe=69DBB071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sneviw3p1sUQ7kNvwFf6_T5&_nc_oc=AdqJ2qNj-R0ne11YdNO0L-KARj2FK14qcd6lk5MFiD59CgPnr3pkxhmOOeoAvkYkkO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07-iJYN5BtMiPntNv-UvNSwVzfgvJcytvl9SQFHsWaXQ&oe=69DBAD74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VssMobewo-oQ7kNvwEVZ778&_nc_oc=AdoZ4arlcS7tdQYVhnNKeBf8m88Sxke84TxZOuYsigQMccL_BQUQOA-BSUZrOCT4ZjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hLq8vtlvb3TMeN8qpimKMSqqPfzKOmF8YAxyrOmQeJA&oe=69DB8372"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSsNtOxKd94Q7kNvwGUgJko&_nc_oc=Adod8urYnk67G63H4I_qxuTAOvg0RQSCN0gEpv6r9wg97hHdeGYmC-nvJQNQ
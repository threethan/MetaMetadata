jGQIoIQ7kNvwHG2OwP&_nc_oc=AdrUDzOjzS2xS1E6dVbM1408r6WqFzD7hRKV8YxS0wxIM8Bg_nhCUPUGbj372c83CAI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS6kw832J20FO4gaYBhzCg6sEXeSEt3KD9eWm3usx6xw&oe=6AECA37B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpypYvN2-cEQ7kNvwHKY7Rj&_nc_oc=Adryqz3Iw0xRZQc-Zn1MFAq62HgVgvlrFDAPlMe-UmPcNDBJQQImngUZN_IQUjn8X5U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTA3Q2sZ8Wv-23PjJVC3LIuMDZU0wUflb95RIrQomlxA&oe=6AEC99D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXPpNiiu-EIQ7kNvwHlpPfQ&_nc_oc=AdqeQs2ksLJKC5hJHs2Zs6xnaqpv_5HzR9cwT5cDqNReHg5zAvazacZJUQQ-lB1kyo8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAiDjyk75cbxpnMwHrAQA8pbmcc_oFp4DIfBDLNeL0xg&oe=6AECB401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_it1Ze3vTcQ7kNvwF6dD1x&_nc_oc=AdoH4vQzyYlDccC8aI4FfhyIpuPdMDPhDwJGq0TzPNLRpE7Kj2p_UIUuZTUQYjYhAYk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWkb5zwon-zUKYfMymh9A_m_Ue416qn0Eav1EDCEnaDw&oe=6AECA7C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBY5ujPkGwQQ7kNvwEeSIw0&_nc_oc=AdruZNdYnOLA_80VL5taRceqnQmys0xlbDHnc93zj8OF4eg_mwg4nj8AVcMp6ixSiZY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiMRff676XFmdN6UVx-hqprmL2p5P9gBRYdIayXH8y_w&oe=6AECB53C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txFjOhMbsbEQ7kNvwFO-bBA&_nc_oc=AdoJpUtOmm5XyFe9S8sQsddEsVrhPnDUWPux3FNwxfL0GsmAwBJDN5TuE7ah1zR4trU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpxdBvgK-He_cjz3AMgv4E9_h9HDS2VRnwgSyhA3XkPQ&oe=6AECB3C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
9NzhziBPkL4Qehc-R8mRkujMdUPwwXO4d2m4Ag&oe=699DB265"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNUF5_uGkvQQ7kNvwHJXKUt&_nc_oc=AdmqRgdgnecbJLbGTBoR60_ijcUqvTaeZHPyNxFqLFJtE528CiqApEYOW6TjW5Rd7oo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvJRYbSiJBtc1OJVwGk30lieB-4AKVmm2N-gMTsVo78_g&oe=699D863B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odUQ6aq5Gg8Q7kNvwGxbhdm&_nc_oc=AdlwbGG-icHghR5dsvLcrdS5C9Ez9N_15UDs_1lM5jqj8hpF7LALHN1flB4EnW5X85w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviHflHtBPYVCQzQGcBq3BdSFF291tPl0ZM2KTk5ImeZQ&oe=699D81B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDUpakTbupwQ7kNvwFJkIfJ&_nc_oc=AdnZBLCnDfgZF1dwC2pAVwgBMIKxZeaXYWPkE1MvLb5IQK6TAIwVkIQbXNuf8iQvZts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHNfd5fbSpaG6Ils-yUaU4wuemaGA2ohiPBbNmqtZPGg&oe=699D7EB4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQz2W7cA8Q8Q7kNvwGdwhk7&_nc_oc=AdlF_zoFUxm822--Dw2PXw3BW1a3WhkJeLBRJd6-pHe6NYJKJnm5HfTLMR1SwZ7_1YA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXVAqgVOqabfcwaeAYnRtbgQP_elksicPyzhs18SZ6hQ&oe=699D8CF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=difJXqGaP4QQ7kNvwGnm5Ll&_nc_oc=AdnaYq-V_kQj8MQWvaocc6oFJ3khCBhKfbBsJd62KH_ArA11KPelsCowCs0D6ra444o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftitCoxRWrt-Mh5vmNfERLJrm2SejAXnRyO9q3shFPGIA&oe=699D8983"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jwu806vn2QQ7kNvwH4WqFG&_nc_oc=Adl1HXQ_in_SYrdkmEtWmvjTnnybkC09OEUL06CMbtynpOourQ9mhbO6rPlJRdzDx4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3l29oi
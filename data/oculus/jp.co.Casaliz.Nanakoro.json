URgJ1kQ7kNvwFqQwEC&_nc_oc=AdrmTdeIt-7lYH9Xd8-y80kNwYz5qbTRPiE25eJvjerAxyeIK0zTYduSN9IOaCp6VpM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4ZbzWbp-IDCqeUpqQwc9uWjo6Mg7MflGKqd0vkkHRJQ&oe=6A9173BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTgFbcoCakUQ7kNvwF2jph-&_nc_oc=AdoakEllAFUGijYm4U3o1zw3FbTi3_QD6-sj4M7kfYX5xL1v7JJr8aFv8B4K0sHmj2I&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmNHwm-pf_bMqqdN7mZIwPsBRQlMwWnSvg-s-ieWCplw&oe=6A916A10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOl2spafVk4Q7kNvwHOe9OG&_nc_oc=AdqpdWblc1laLtewua9URknTHkt1NhljTq0klD9Wf29CRcU9IUje2VVuXi1ufkF1qXQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEwbBn_4Bh607Em2fHnKem86G6eGQ8SCySGvNs7ah66w&oe=6A918441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5UMQuGyR0AQ7kNvwEOQeIn&_nc_oc=AdqJTAtUBPNyHFqZvEXeCkFP7deJQC0M1CG-8wXrxU9ozM88N10Mf1F-749mfNvkR6I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUzJsgnPx1mqzNxN-6SFnmg2PWkfOK0_eh4Yf8golIWQ&oe=6A917809"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsKtsrAdCoYQ7kNvwEgi2CA&_nc_oc=Adp5NnyE4eDeXKXBFWi5MAg3XUw9VRvVj3gd_4Ap2uShEXi8sjaeyo26OuykinajImU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdHH5UhCmMfNv4hoYUGJ2cq1kXWo4gme1QAGes_4dM7w&oe=6A91857C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBCRSk05K3YQ7kNvwE11Lw6&_nc_oc=AdoCt_jH1fuQb6b_SBNF1WmWGjQ_mh2fK1K6NH_c0xMSgR_V6HK2oWcrImHXycuy1U8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXghkhXtDRMMiouqGKN-eVvCKDpZqzl1QOzHk529ZGyw&oe=6A918408"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
jv7Va4Q7kNvwFgsAIc&_nc_oc=Adp0HBIYw2SpCnNAnxRYJKe36P2MY8P7jHX0t6tOU7Y4i9NpFXueUpecFgLfpT5b61w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI66RMLiIPQwJt0bXzWngn5VkVYfkqOoTCNYS_QALtB7A&oe=6A9C37FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KytHytd6AycQ7kNvwGV_Wl7&_nc_oc=Adp62Lb0KZYx7mFVdVQYO47uqHlUnm-DzV9wRxucmmL52HRZ_Eo1_gBYCB-Ca1MOxjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtWtV3AQKpyyG3kcDcDgp-PSlN0McWpAKycQuCkWlL3A&oe=6A9C2E50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcrYo3n6ox8Q7kNvwHL6q3Q&_nc_oc=Adr2SPzKsbxUQ5k3a0MsD5HfEa0OgAmbPS1PqicFnud7bACwoF8Lk1R-WcNPoEoCyWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsTuOYzEue4zipB0VeRn2rZHI0a8MEYr4NlpRHRg3WqA&oe=6A9C1041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaOF-8V4MQYQ7kNvwEIvAze&_nc_oc=AdoSqSaBOlSGV3fglvIsEmDaDK3i85rqojGn9F8kmqx4iNGSEqAZiHrmvPlUDUswSJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLndo3Hf2eCvVRdGsgrmORMdAo3SWVsB6B98Sc972BuSA&oe=6A9C3C49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkPpcFo_Yk0Q7kNvwEckim6&_nc_oc=AdrqhajEjCXan-BPLcK8z5n5OFxbxoM7ITb-SoV_pKht6Ct639X8QNS4RDLF43NZEXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAhtNUff70xosBqv49ePJZ9-0fwH-0bffIoznNNAJ6kw&oe=6A9C117C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCfcBzu5T3wQ7kNvwFXDYRH&_nc_oc=Adq9f15k3Rq5CHI6l6ZlAvGg0M6Wqy-7oXSOVBFmke2hiqXbaWxcvYGkUibNghi0oAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqHiZxdYUCIc8DHJ1XD5DE6U3weOTiTExqevKqSC-dXg&oe=6A9C1008"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
C3d5jQQ7kNvwGpMh4S&_nc_oc=AdpAo7h8wN0VaPY9dIqnG1jMnGbEnvR4-UoaWUu_GwGaeKvNY1KMgnl19FlTkB4ZtHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gqp0G3rPmzcWIjOLAPxCX_vbhIDH8X6TSe3RMD6TgFg&oe=69FB28BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MPaNV6iHvoQ7kNvwH7hIwV&_nc_oc=AdqEnJQg-ln4b1wmlGo6v-m8QT_e9erD0FEVxF1VR-WGRpSOceGstOrcuR9CKTF8oXY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QV5vzOVxyJz2RHwvSYnEu99n9Ey9cFbwTT0iWE-eceA&oe=69FB5750"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA01HN564IwQ7kNvwFPHJBZ&_nc_oc=Ado1zXF2gek-yJ1Vs-IlQCKFtyukUNXrIhNp5fSDfryzSRaSomfPpxiw-wptUWFSOrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FgTUMT861tf-3bBGLfS1M3CdV8VegcskZZbsj8Hw4rQ&oe=69FB3941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqpeD_Dea-oQ7kNvwEK4L_k&_nc_oc=AdrMCmr7BJcdtZRGv5_eYtTcwknhIsaGtK7srk0bnVNWAGjTt2c6rhCXUjg_ZOL6xZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55f89D-XpYsI7-x4aPZ_1JNMC2W4u09hRPAev3XD8giQ&oe=69FB2D09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGWU9DIhUoQQ7kNvwGOKPle&_nc_oc=AdpzFNP6x6Tqr5wchdkuv8RYERdE8zoNwtnIan64PrPCR0JbQW9xpQLAdKv1NkAf6MA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NRY4X9BsuE8oFQT9V9BnPcgYohZk9yMu35_R7EyHzCg&oe=69FB3A7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-evSxDdujjMQ7kNvwFLjmxh&_nc_oc=AdqpG7Uzjm-B4aBjGU67-IY07iUD2POgH_prJQ5aAXRHTtg0OpMRHGYsOTaN9-1zLzo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bmcVjf6ovKv5aNjwsGB35cHQZAt9s37ZzgkUnkV60Ww&oe=69FB3908"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
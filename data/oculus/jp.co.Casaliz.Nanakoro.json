KvbUkcQ7kNvwHEol7Z&_nc_oc=Adp1_eFVFqLijdgvpQK_RvQFnNVbnBz5nXxduynDWXsVOkHoaw8eAdKuYblRTJfVUtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKq3iVEFPlmIerHxcAvW-ezhqXmDODuetOSSytit2dfA&oe=6AC121FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUf-RZ9CaRkQ7kNvwF8LRAZ&_nc_oc=AdrF5E1a5WidvRpCzcs24zVUNtZUCZxp3ToYQkftUt1ThtSQQ0PeGi3PBvfrGf9uym8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9oQejnZBJ6wrXgHAoiIvM32BboEhV85UJtpN7Jr8adQ&oe=6AC11850"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAdWuszxDN8Q7kNvwGfyLXI&_nc_oc=AdoS4arYE6pRN_5duVx55K7nuXSSQTTclMJhYzlt6LegxRiEvsEWh7qot7pmwr7K4pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHgZn1Dgp0pawM9TK9FZ-9YmjUX155OOlzqf9N-ES0zA&oe=6AC13281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFXFrX0xQGsQ7kNvwHXXZKu&_nc_oc=AdqpTm--snmrlLyaaMy_JZwdU8PReajHUU9wae7pa8bozvoET2gEMhIHic-WSr1_Euk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4UiklwwjmVmrEh3E4LdrgPyg35F41JzBWip_UR3Diyg&oe=6AC12649"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMd9m4IrbN0Q7kNvwGMcfjn&_nc_oc=Adrk8YaaxCTxT8wte3fdIE_wDzeVcG-bi0MkqmF1y_8y8DCG77vlbPP3UOZ6eki23BQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNpAqyOUisPhxP5_FHokWUYh4-TK9ZO1VfzvqAyF-UJg&oe=6AC133BC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtdbrV8dWsEQ7kNvwGy4swb&_nc_oc=AdovkmLMAwmKA-t9Drpf6y6RACL3uJw8lXnjeUcc2QybNnha-3GlU6eCQvSJIl9nycM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPURHsoMsgo8LYMRl8G7wpQ9sXvnNBDUscEsNE0-OfijQ&oe=6AC13248"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
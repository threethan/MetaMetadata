T3FQCUQ7kNvwHv_Gea&_nc_oc=AdpnbSk8Q7Lw1rKL8XpA_pKZocVwDU64aE05835471IE8OqE4GrlTgNYV3yKAoaLHV0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-_UXAUIDi1mNkRP6Oc0EQ1n42IxA6sTHPo1bQIbybxw&oe=6A0F277B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFOkMeoBZGcQ7kNvwEkrbW3&_nc_oc=AdrGgoXZnf6QnlnZi9aTOT85t5WE9Y-w361wGQXojkWLX64OSN_OYz-fsb41xYoy0Dc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z1u86iQowUwAlVoGCbtf6l44RuopEK5tb5jISfN0lbQ&oe=6A0F1DD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbM3R7JqZfcQ7kNvwF65h1m&_nc_oc=AdppHXVTCOegNmMOcv4qWs4k9GfVOOmqjnreeMdLdkiUlKj3J4U6lYjgjs941okCPZg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46yhrIBwFlu7cPXVkCY0tbxBUdf-dZPG30RoKc_Kf9xw&oe=6A0EFFC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4zKLn7hQNkQ7kNvwFj5ONW&_nc_oc=AdpxoeqLgHiAMMxGGmGXnafPwpGnSPVLMoTfONCC1_egOrkdkkkTaarJOTyJVnOScVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KlB03J0geDcMJQeUtHsS9mJCNPt4RFssHatWs2UGs8w&oe=6A0F2BC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QflVjXdftXIQ7kNvwG1K2pL&_nc_oc=AdqIQGFxs8pjnW64uPdiKvuJRTi3TngwdgxqNgOa-XQ1DWtAuF4fCHGgVmeeUHvvV8w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60w4B_zSNOhNABGuMM5zKQOux8cS2CirhX18kWLn12Dg&oe=6A0F00FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ganj0hPYcbsQ7kNvwFUiNIs&_nc_oc=AdoCIiJWJvTtsTrlJtp5PeG5HLX3oHA93_Dd32pfbiTf2mGVkiHshFF1RUa47n1asMI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76-qXfF9OZG8t6pdc2JUfhQ6z45Szf5yq264m5690yWA&oe=6A0EFF88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
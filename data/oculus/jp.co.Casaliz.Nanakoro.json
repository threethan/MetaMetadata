Nr2l2GEyRctr3KepW0Bro6KYc42q3F5xCnLe2860b8poNqpUrF7qfNsQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBzY6c-BY2IDK1baR5ANjCPsQACmVGSAHKLaBcfhdNLg&oe=69B0033B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEC-GAMPockQ7kNvwHd9Xrb&_nc_oc=AdkyGxjkZGN3zTIhiOT3cezRp-30fDWtapiYR1CJqgTqmAtB9al7A0S0MpOs6ERRpjg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDjj5kVsk7um3mioTCs1MoxSoG9hJmHOF1QyOEpRkjbw&oe=69AFF990"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnrAk7tFJCAQ7kNvwHA3S0L&_nc_oc=Adn74uI6fnN3E-2_RziptrVvC8K7mFIcBAdvXncs33Wfs7eHM7yqDjzQfIBKVS1DUKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycpkASuwB-SFCxQpUqrpPDaVqA8YNdaj1cv1rUQWChWQ&oe=69B013C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWevMONcsMgQ7kNvwEX_mhU&_nc_oc=AdmKdmEz8t7x4x17jMuhy2IKvTYEXO_qucved8aaC5LBWJwE6Fzf50SZiZBWa3707U4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMNrtIdasiRaPIgy76DH2xJg2GtLtP-0wFv9CGmr0Usg&oe=69B00789"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFEvYvy-oxMQ7kNvwEqU74s&_nc_oc=AdnBkx0SgCPm1mj62e3Wko_oYrX2Q-RJJbyLvJPFU0frN9S8I3S2Opurt_CAWFSTBGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1QMon5TDM7W9P87b0NcQ0hbUIzcb1F9X9ZmWbdasx9g&oe=69B014FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwOuMAJqcbkQ7kNvwGvqkUr&_nc_oc=AdmpD_hCtC8FGmrJsIPqY4E2JdSxAuH4TqFQtAwx5jAUvayFhF8YhTx3K8j1zOK2nYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0gDVQ0BthkKIATQ8gi7xdHt_OkM0lw-CdUNs9XidHng&oe=69B01388"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
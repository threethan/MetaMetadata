sOw4ksQ7kNvwE1lwI2&_nc_oc=AdoncX4xXFBak4RNoCdRNYWZCsR2wTa8_mzkZ46hQ7Ie6dF8BLb3feS8hQf5Ab3tykw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuhWd9zytO4kS3oqq-UstVe6cInUSvQej4D-Du5ywjOQ&oe=6A5A14BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_N0yuLsEu8Q7kNvwFu1GcL&_nc_oc=AdratnQdlelZ_tWKbMZeeyLUVO8ohoLcmtslUdO8l4lX8CTQJJGnSMKIydHbkjqGVI0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgmiYiz_oX6G3_-ezQg7T414OY3_xI6DEA2opP9ZYMBA&oe=6A5A4350"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phmKsGlUHy8Q7kNvwHivXwh&_nc_oc=AdqFBG8DLoH78-lBymgyY-Wb6B4DwW-8JMmdUOkPpdgXJge0Q1vBWcgaW9qTxUwvoyo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn9Xj-psbrihejnLzobOtEd3O3iIszB9avtzGUYlLSOQ&oe=6A5A2541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrhW4AHKD_IQ7kNvwGJ-W4T&_nc_oc=AdqexIL7YabnlBF9DsWLiaiEpYieHUWSA8HU2BRFuhibr34jV7QQ-KgSP7vR0Oc4hqk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI5POCqvMJo7SyA0ZlrTnsC0PB-I-EvXzZ0SnzEXIVHQ&oe=6A5A1909"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CW5LcYyTjIQ7kNvwHeCUiC&_nc_oc=Adp6nUKIWwcwbb8sjEJX049W9XQF6uEu7-iKslGX94mfbXrS8yJJcKjRh-x6vGzw1Uc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyo6MnlLdbhJQxNPKUrbMKCGGYOrf7flzjXUEYGtodNg&oe=6A5A267C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnSE4P9KmJEQ7kNvwHOgZYW&_nc_oc=AdqUMy41TrD8dkQ_q6iOSRpDQsAahXFJGAgei3zQfd1gQdgk6jgoKgmUSh7LvcnWCBU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO6Tbbi9euRpJcHlvrpMdX3E1XhraMA7VgMknT9oDMKA&oe=6A5A2508"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
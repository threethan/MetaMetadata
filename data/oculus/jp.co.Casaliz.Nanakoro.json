70556961", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVM6y7oL3CIQ7kNvwGvETT4&_nc_oc=Adl16Fle-O-OFU2Jn_cLuiDEEGG48g4F-JzyyZk8G_JUIDFP_o6UWukVvIm17VzwOhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWuBVItl5zj-hVvjyZLoprUAqjSgbdpoiBsOPuVL0Erw&oe=69B6BEE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYTNswrXFtgQ7kNvwG0cojF&_nc_oc=Adm9jcsx2LtVTm1SCG8ZI69b567mR_G4rw2bmJITGznr9hYVgIazPNtIK6aEmdHcB8k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq-x4KLuKnGk__tW2RxVFiEOFkwqUHtFhzMFdDFllhAA&oe=69B692BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMObxxzD9b4Q7kNvwFv-Hst&_nc_oc=AdkaPsM4z1ZRs5jPN56pcSXGxM0LfHxJArSuDYq4gquefkCg0iTotCzPhSBbwK7NPIo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxy9LkNy4eY3fsHAO_3kqIKBnlqEveTTf5TKBoWAYVEmg&oe=69B68E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0nxIx2KxXsQ7kNvwGC-sUB&_nc_oc=AdnY3BSNK08YkaTTb9VW-Rv76EV7xwMjM4P3as8LQ6mUepGYv2eAFLRC76G2aAKFCjg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhc8ct0QCKziS-6pSXjn4t-QDcVlXV-s2syNEegBsPAw&oe=69B6C374"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc29enwUSK0Q7kNvwEHXl06&_nc_oc=AdlUjBMgYPu70A25M9JOgUHIpsq1N23925McpoyCSl031lbuO0-mUF47Gotf4Q5Hmtw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPFdtEbbFi8VKwlgQo__3PKI3kf9qTRKXIlYmH6rLiqA&oe=69B69972"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BbxXiLH4TMQ7kNvwE72-Kl&_nc_oc=AdmKGIe7EvZVi_3Elgt13LDq4gckI9GuA4sDf-T2N-d0Guv58z0EsqaL01lY9vdXuTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE_q7vM3PrRnxSiY6P08wWYKD7fr7j1_ta3OQQ6E72Pg&oe=69B69603"}, {"file_name": "2560_1440.png", "i
70556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7T3sgVGt5YQ7kNvwHSdfwU&_nc_oc=AdmVEUtNqTuInVwZpAvAsRxznpn7rDkz1oN0o0E66aV2IPvOlXHzh86Sd42N-sDtdqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWYL9Y4lG_Ye1jEvWoqhn4t5udb3bfEUAwjH-vg3TfXw&oe=69B961E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3WPq-zNph8Q7kNvwH3qf0E&_nc_oc=AdnEdwStnPsj15SoaBX9O47Kz30Sk_CWi4-KvQgPqvVQ2y3eBLJEZwgdJPS-GnNY8oE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxCTaIG-uGHyNWuyTRSmDKjtknnMEWb-lom1SBg9747A&oe=69B935BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMObxxzD9b4Q7kNvwGKct8E&_nc_oc=Adla3-E7gQ7xfOheJZP17aN21C7nd_ItlfLCmZ7GtRJfYIa_p1E-te4ntGgn0IVBGqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEjX2qbVCenf0X6nzSl3jEskiMQ_CbrHosSGzZxnQGiw&oe=69B93131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0nxIx2KxXsQ7kNvwHmeuU-&_nc_oc=AdkzXQCF4pTZLGP4MtHScAZHECjW-8e-DODProQgrUnxv8zxK867VLlzFRUpS53CLhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSGDie_-37NoP_98JmytzuxGcrDhpgiomfyyHjOp2adQ&oe=69B96674"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BXVnXMwwLAQ7kNvwE9MDRm&_nc_oc=Adk6eTjHwm7v_nJcnbCY8gCx3CahuTOUCkNXHYj1QEOKSGxvBs1wrZ-0t35L7pM-GCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxs1MgNDZX9wNYwwg1jtari4MtKK2eJa7b_ayOtiCo4-Q&oe=69B93C72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z551Ngrnk48Q7kNvwF3m9Ro&_nc_oc=AdkZPMaeLTS719P6N___OK6S9PTHVAQF3pX3mUI7tVPPvM3O26QhIqVBblWm6OxxNZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyL9hFJAuSQjlojyqwKMg5GlXA5BoEoKyhfrn3wbxhbyA&oe=69B93903"}, {"file_name": "2560_1440.png", "i
ITqvVO7MZQCpVlTwIEOXCDpMqgsjbxCVyAvRXQ&oe=69A05565"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNUF5_uGkvQQ7kNvwECMYui&_nc_oc=AdnzY4jN8QCL2Pc6MowbGsSdZj3ABkddeQk3pcV8CL0bFSzmD6pCt1TVBUUSBTkWAn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsH_XH1bDlX5n7t0gcfvgyIhvFFyK5cEN9Tc7pyLtAdtA&oe=69A0293B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpoXC--cE2wQ7kNvwGlOxuu&_nc_oc=AdlN9Fm0V-JXC29XpCGl_vuOmqWZNmrPirwmto8r1JlLJlve-V0fiIHecpqhYzArg9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsa3jxxewX_8qFGUiIRjlgxQqXcI_VFqgBA2BMISTZuDg&oe=69A024B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3bOhvRgV_EQ7kNvwHRukU_&_nc_oc=AdmVUOckOJvNVRi_dJKbvlDJCXZ8O2urFVPiqNkOOjPc3imuO5Akq1YLGducoQzeO3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsx8sv4v162BMWz4NMjOnZ8pqOnov9J3h1Bv0UAxLihAw&oe=69A059F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGonuwNABtYQ7kNvwEwH8lk&_nc_oc=Adl3pXUiZsT96aKKXf5I4u2GCnykJTJMy5pecjQdFUoU30-Xy4qWxfEcLTUeAicJirc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAxxOineSG-eOVP1N0aRH-jnxWtnc8kTalt8PGDhUmQw&oe=69A02FF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=difJXqGaP4QQ7kNvwGmluhY&_nc_oc=AdkaSvMbniSAZnjXP6Nfc4xr0X9931YUXsSYmd3rdfK-tXlNCEKNv1PmD6kOPNc3qEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSiLWKW6Pufcjl7lffK2e9TfjAyVqLH_623sKIUwYO1A&oe=69A02C83"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1F_7MC9fnAQ7kNvwGhnU2A&_nc_oc=AdmNN6enOe9fK1zYLN583xMWimi9rFkQ_6cY8V2uPpZ5IR2m6COVR1Op3K69MMM9h2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFoKFi-
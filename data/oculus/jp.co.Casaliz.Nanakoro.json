1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rlm1YhF_yr0EhVF_yrXZH741tlyrBcD4gbdhbB4KtGQ&oe=69E0FB7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwC1HSFAm7UQ7kNvwEDJQ5K&_nc_oc=AdrUlMcSckQQf0oUt7lYgh4vKbQYhramZOqf80KklPtU72_p_0h7Xw54Khai73RpO4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dD6OaeXkr3zEHBEh21D0CR__I3AMfp7ccQWvcszUSgA&oe=69E0EEE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DcG3KzkwukQ7kNvwGkphnP&_nc_oc=AdqWqcKY8CT8wuu1lxp7aq2h3MgYI-jBg6fhGLnLkBQphapCgiotv5LHuDajsOE2cfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gkYOzCSKFIo6N_4mAVg6YbQCRO8pnT9eYwdTK2CNfZA&oe=69E0FAFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb38AC9frKUQ7kNvwHWL_PV&_nc_oc=AdpmLxN0WLrFybfzLR_3zs1Mw0HMMN_oUuK-BN0yglqPK-sMefAdTDdurjiQngaCK7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gt2hZdM8ee6rQwqtkfaKShcQik-L49qHSUSw5Nd2GxA&oe=69E0F671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoMWRF4EpMUQ7kNvwFBLaha&_nc_oc=AdqzSRtwMk5dJEh7nxjSUXLIwv5o1WBkCjSk491BhpF6auGddwx5oONAOke0ZkfZ2BU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2654VYTVXtGyk-0j9lF0T2t7L5CjySH0MKmXPfQatV0Q&oe=69E0F374"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-HFpOrD2AcQ7kNvwFYO8jg&_nc_oc=AdoS7LrZxdWdt7EMdwd23MKHPQD3QI6BSdCCTxo2KGQkBfkRNTQF0EJGwtFYkt_vdEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28zwiBTtkiPqmabqdUc7RQxTi1uFs_wUWQZqXL32rKJg&oe=69E0C972"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkFgLQDFK0AQ7kNvwFQhBar&_nc_oc=AdrFvCm2jp5uHurxy92sGQzBGD5bYCW4arUrgO4hcgZfElXbzo32OcPDnwSs
KvbUkcQ7kNvwF-ODaL&_nc_oc=AdoMXHgwc0tOQC94VcXdzXXphAWDL4ZusVrWOsMrSGTumbvXQMnGW4E6kZconn1YCyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLER5Jm8tHe96HDZ_cpz0mzQAM-aNFEDPi9QqgF0c8NuQ&oe=6ABE7EFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqnwMMLfau4Q7kNvwEmBduM&_nc_oc=AdqK139iAZ0_PAI0FIH_5t5wTkru4RJyCMPMYhSDa8lYz8hOWRWfPtjMbkxxsv7Dyhs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKGa_XEnv3nn-wpTRilZd5rBRg0ks65_VXgC6uZbaiEQ&oe=6ABE7550"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAdWuszxDN8Q7kNvwH4HP1g&_nc_oc=AdoD6jY2WmHjAFgazsNUrTw2nOzZjDZ7JCb_sTjj5azUrktNPiYQzPwL9FvZIsweM0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDdSFB4PoshzjFjRsEtleQQg6vFtpvD5WblXAQQ2_s_Q&oe=6ABE5741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5jPpTRNlgkQ7kNvwHKTdez&_nc_oc=AdpNE-cMZCSqMRiWib-VlfbPMi3D82aP9aDg4-PbjDC87ZVE30nr08bY7Y8miky_fVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbojtQnY75zOs6dTNhjzdDr08h83HoQflVekNuW27oQQ&oe=6ABE8349"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkpwDksztTQQ7kNvwEeHr-r&_nc_oc=Adr8sNjVHlh_iDLQ9Ob5oQdry-aq8QOUL4Qn6hBuSU_EBQ6hdfHUfN7Vcf4SkmJ9JRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKCCOT1nXasD0LahS9qz_ovRnSV3YAAAojQsdeRAMVOQ&oe=6ABE587C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOPOu55wh_4Q7kNvwEtJKQ8&_nc_oc=Adq1-tW78sL2G4YedPhypnaiSXqZyniP29BXeJh_ohDV0xX_2SQ8nVYPASK7p-x8tvM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxnn2lA_RFm9C7zcnqw7cGgbG4kswLtQkv1NQltLaCnA&oe=6ABE5708"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
rM77DUQ7kNvwGI0WYn&_nc_oc=AdooMLVtZR8bLt8yoOVRmUfZ-2ohCIYhwvmoCLigB6zbpXBbms41LLxpVKmGlrjH-xM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZp18A2YeQ8MDoieH50hopZxZPg3rmSP0o83BFCTD38A&oe=6A634F3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmjkCHDmwLUQ7kNvwHiIOQa&_nc_oc=AdpJCwfkFvGy_h_pFYo_gjhkG2FKgs2isD4y8jW9u10ycNwK_Ms2VNb-AS0OL3mdW64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYK_qpK6ytkmqV3odEn3i-97ktoqocuBLq0YPWX00zKQ&oe=6A637DD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H92OgHCLcUEQ7kNvwEVtYNt&_nc_oc=AdrM86TCg0dBi-gJqc26LYNZ8lusXhSGreVISjnrE516Bm-8U4Pd3K10hEQtNvawzjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjXOOB93AsHlOe4jCjUTf56R5H6A1D_cZ1Dmknjf73qw&oe=6A635FC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgroAO-KkUsQ7kNvwFtFonH&_nc_oc=Adq-1w6LVguebpAzU_0d2YXi6KLUme9p9IKkpo_3CxsP2qUuckwYekJVhtED4x1mwqI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd3dUaEmNqaQYFjZ6STKBTJMijS-MStzGm9iSh24FiYw&oe=6A635389"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8fKcMxY9gQQ7kNvwHISm6q&_nc_oc=AdpvZrQW6lJ4G-hWociZF-dqOCuDaGXa_NM56Zs2CWMi9fO5jR1uuSh0Zgys8mMr_cQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0M0xmwwjSIMjhqwb1lZ_wRZS1XBYbdX8q8pzEchNlnw&oe=6A6360FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7NAO_jUE8sQ7kNvwGpHS9V&_nc_oc=AdpbGQcsV5WG4RTPGB_R9HNcVmmtJfZ9lBu_HtqgDJ-r8CeJc8EptZ06xn0Gce9-HK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpESV4nTWyVX9TyFvi9kh8w-yg7gVC6EFUSVbQ_SpSfQ&oe=6A635F88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
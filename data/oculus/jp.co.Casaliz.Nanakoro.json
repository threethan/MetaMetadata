arhap0Q7kNvwHrZbmH&_nc_oc=Adrn2wqAihiaTLnsdJ06WKmtcRFCGptuKhrj4pWZtf_AKilf7fT-yTaLWo01CfnD8MA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBQuTtdqV8sjktE3ukIn5QRMqT4G4V57uKVBtFkU9c8g&oe=6A4FC0FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF7Hgmvo-BYQ7kNvwHA8wUj&_nc_oc=Adph16SICyANTRkw7-GaKzOnkcbDXQkTqm8BGEKoSz9NXx2VXORZG9m3xXR9kEUbzwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAPhSK0MuqPISOAI9Q3KDnULsHESt5hP9hgNiluxOAIw&oe=6A4FB750"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxuUC4S7_EMQ7kNvwHSnuoF&_nc_oc=Adrffiywf20V2Pcr5UDRadggtXz37qE7LXKMsmTy2ZWD4FwXOGP1e7Yg7WpLSEDM5v0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBcLlR1gBZjuKRgCTqyStuLW9pfgZV8Cbnx0m-ImUK7Q&oe=6A4F9941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMxrlJBwoVcQ7kNvwFE6zcZ&_nc_oc=Adq3n7VUpWxX747Uan-GsE2av31jVhXsWhpnbZHcuFnWeTYB4nqgZzSU_mGw4W-3kYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXZ_olAGg9KwwT9p5vmcCsQGm_saC1K7m8fqEYgbgISw&oe=6A4FC549"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kirRubUVNHcQ7kNvwFunneT&_nc_oc=AdoBp96kQk1YMFKnolU9ud-65BeVW8gHToM_dmmldylNVqr3wqKTbyJB2Zs15_WcE78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB_HuyEwkWwJknnqCq7UeCYd9eLYNsSlJGQpApVzch6g&oe=6A4F9A7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_y2BBCjJXMQ7kNvwEGY8zA&_nc_oc=AdpP-hsKTrj0k34PkaYG2x-3GGlWyFeRtHFc152qupLIWRc4Da7jl3FBTMADze48YqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh6TUflVDLMhdg0dztvzoXDCXFhGHzyGrKJAAlD_cLkw&oe=6A4F9908"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
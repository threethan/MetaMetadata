ia037sQ7kNvwHgTTvL&_nc_oc=Adrc1ib_YlB2qNgxC1CJPpsK-ovXRKJdt7GiidHW0C49SkC0TLb6al-ipTFBX4ZN51k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaeph9f3adl02dMT85KH4-CpMm4lgDBXlYefNz2uvO2w&oe=6AC3C4FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGBcxgjuCEEQ7kNvwETky7g&_nc_oc=AdqkXvBOsMLpa-gqQ3Uxooa08sVc6d61dM29zVMaO8GH-3LmGR099-GE8Q-3lXcsjes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz4faFExTafzyafFjW9I4bXRH7gya14sQs0JXp-hy4cA&oe=6AC3BB50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tURn8OZnijQQ7kNvwHUlia6&_nc_oc=AdrA-ytl3GutWLtLOubxzkSC8eMoQCdsZ6C8UcXm3mmAF_hErRRcWa3naEHxtJu5MIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGrPjodh7YJd3qDhxdMUB6oHQ4pdpM0aJEz58Gd9Lcvw&oe=6AC3D581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blMvnjCb-okQ7kNvwHAiz_1&_nc_oc=AdqIAw63KEgeDsZBwCRbN6xaQ4PeMFH7Yw4jfqE0rFesr0tTo4_bIzkrnye-IveAv6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWqoibsro7RJD7-joqSuz0unjpxf7eb0ifRAMJtn_a0w&oe=6AC3C949"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXiCgn2zVakQ7kNvwFXQhoF&_nc_oc=AdquEAyQ1T5Nqg6KRb74gm-qWh6izhly-3Q5qUYsdb4GOGKBYZcjUO0PBn0asWLUsSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObcpX9ptGNdgXxvBpp1YKhyoKechGeAiIpcMgUj8sTQg&oe=6AC3D6BC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wf8Hn7rhy0Q7kNvwEcDo4F&_nc_oc=Adq6DOZhV804GdDWiCU6KQWJCsi5tUyX3g0RASowPFcD112c6z0sC3L_3tOVmDcy5j0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeUgeIuH-xWENEUTAXPPY7hY3byrclFO_wUTEdwk7q6w&oe=6AC3D548"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
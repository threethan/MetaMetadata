U9vzCixO6JuCfuW0p6FeBRihdmRFBDM0r8uWWgwGS5720Rvfo7uyHu7xrH-GY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRDUhp_ZqTUUOcdbpHtKNLcs9gfpgZys250ElTGS07pg&oe=69AABD3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O7s_pxiUSAQ7kNvwFa6muj&_nc_oc=AdmOYXi57AhQA65gfwHPjUYqJbcjae7Ty7FOSOdFojSswUCfLdP90GzJAHAhYeWgpr8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBq_yyT3am_KaG9UyynQn2R5UtTXDJPI3UyywQ7vJ8Qg&oe=69AAB390"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4BzpHaXYrwQ7kNvwHUZqRs&_nc_oc=AdmIXJ9aR_dGr1ijM7qKqdL7vW6QMkxbeQ2vkaIiIkg6usxT4k_QBM0zG9yqeaC0D3c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9NPqe8ieWtFd9EL2K2Bkk2yPEs7CZOqyV5hr0lP_-1A&oe=69AACDC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bF5jEORIXiIQ7kNvwG5rzim&_nc_oc=AdmRRS47gzqWnJFYrwjTJp7TYJV7TNZEQtPjWjMKgqr-p22H0fDwByZQqnMIJ8FjHfA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzIBOEJdG2te3NlZBPO-TqZ0S0_RT9GjbPeJ1Wo9LOQZA&oe=69AAC189"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXIeteLiDyAQ7kNvwEoXUS4&_nc_oc=AdkWvnz-de3sjejjefVH2XiWk1CLW5StABclbbyqyQsmy7N-qOh0-D-7K9DdZU-RSD0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyixawGL-KcQH5HZomU9IWv8K20lrCSbLYtfdWXHuYHNQ&oe=69AACEFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAPiGTlGkZkQ7kNvwG8ik9m&_nc_oc=AdmOhKFI6HXHuJp2EBCzvaDF_J_h6_4OLKZPG0VvuY5isXqGDa8LtoNqzvgUNxyuhYU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afzo79tNouAbtEIbJt1oDRWhZdz04HmTzaZU5WXxyjxViQ&oe=69AACD88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_s
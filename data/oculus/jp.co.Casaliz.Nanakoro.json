fpL7xUQ7kNvwFJ8JJT&_nc_oc=AdpDehiVr_ceNJLIaYz9oTLoohlqr5aLaYEVTP2DaW3d8GTkFxe6JnwVLq3qU0PM4p0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiBeFXehttI3YO04WlXjpAppcOSUiCVY88OuzJIV9L9w&oe=6A79B8BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxKDeTzrgAsQ7kNvwFh7Z-i&_nc_oc=AdpFLe2h-GWa2LDPPZ-NCvge1GyGOE_j3tF8ACb_oDrvSqq1-gH16UG0HukapOBMK50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-3N7M9oYqlOwIbnhESLOrlY4q6ObGIFKJ6L0w63cBsQ&oe=6A79E750"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JWMfm2z4OsQ7kNvwG30bwr&_nc_oc=AdoCtPwOFsmORlRZ8M-W-EaTHfG_G7DFJjSvebYiwTvPEZV6YW4HjghaGzfAl8uHwBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaBCFcxvACrkDmSTbnit7Ut095xjLaepsoI-q7Vpsk2g&oe=6A79C941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E95cjg0AfkQ7kNvwEbECBc&_nc_oc=AdqlMyPvrvaLBWxof6e3k65oUKfbCjDwIX9bmGtnZJlCdXThHB0evtA9Y8rJmcjqVUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVY2zFNxG8v49S8fWseSOUDIM-gWoOIAE2h4YgYSO8hQ&oe=6A79BD09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEwBuQSpIEAQ7kNvwGw0eZu&_nc_oc=AdpA9ijovtiHdWBVEOkLatrkAncdhoUZJD7z2osQ0RDYkyfExb4UrokdkNTDeDDQOm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2IH7ZmxkVWGcDwnhg5wBgeerYWzD0Xd5dfxlsYkMHyw&oe=6A79CA7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRWvAB0et0MQ7kNvwH9p19d&_nc_oc=AdrC-ZRgGXxcm3RuIRHCjGAjWlHzrj4S0hjwy2cJRXBz2qjm1ZvdHRW5oKu1trfhKJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc5WxvS9oqr7hdvxieuNTggtiUVBIdH2-9gaTENWDa9g&oe=6A79C908"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
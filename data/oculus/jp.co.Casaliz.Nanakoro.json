1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h0eg4k27-4bzY0YQ2-c2kMXmV1EGVcTnbpKp6St4cnQ&oe=6A1AFD7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=navGkHRqshEQ7kNvwFVwj50&_nc_oc=AdqxhlaAi11xdkUAnkur05PedxFkwlQWlBpvXqyoCQ5xk1pqR3rwmUyGzxKNT6u2A5Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qPoRum0kWAyKdnpek6W2HJr4AKN74rPv2ookDAYG6fw&oe=6A1AF0E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6Acfd8KSh8Q7kNvwG5jFWJ&_nc_oc=AdqcCLBskoFXk7tZ6QvNysAU2CpmAYsMtPfwy6CUF4wO15rSwRF6hqYJiOVHy94QmPQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bgXAxkhfyhCnaHOHaaL2qoZjNtuS8STm3C0Z1pG56Wg&oe=6A1AFCFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdtaXHCIk60Q7kNvwHOi38s&_nc_oc=AdpYh6pjZg35SK2Jszgi8-Lu1a6ZmHilpsp95VyfaBWPrt1nxhwWCBPPDtAo0Y8YU5I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AusF8MZ2cA4gEm6XvQvLM2RZ91IAZuTDPgcV0Eq73og&oe=6A1AF871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmzkuGrANUEQ7kNvwGYFurO&_nc_oc=AdolHkL5RgKvlOsIo7FwBEAx5dVnrAPuZ2GzbxIaSl7kkOh4Cu93a43EWhLaftRvQic&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eok4oU4wITTW5_btfdEfnjAa8HlXeJG6gBfRVsUPAEw&oe=6A1AF574"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvswlu0Qgv4Q7kNvwEmgv7j&_nc_oc=AdpqfiOS96gnaac9ipBGPUzWDpAdZ4l2bGP1Us7eIgBxF8dF8288Pq5vw--J_iTH2so&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zdnO_nF_cdS3w_qvE8pv4vKSNlZZgrziHBeCTBDSqdA&oe=6A1B03B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMiC-owEOrMQ7kNvwEm4tPK&_nc_oc=AdpdTmR9S8-5ZnbIV1edQNMBG9h63dtsPO1NENaP5XaFLSEI6VqgjQcv4rz_
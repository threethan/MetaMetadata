2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaAIds_taofYYtC3v3erCnWtUF2fEewVFoUK-EVWOSsg&oe=6AB3EB7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYErgxWvt5IQ7kNvwFFgEXy&_nc_oc=Ado8w2YTFFijI8c58ydBegji70CXCJDVNAOa3BIoaZKBIYQTfrgPZWZNVwqQQydoD_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAK1Eo7JDUVirc0EsosCoH0ePvQbwDBSjVzkzGbQel3Q&oe=6AB3DEE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To1EDzuG3OsQ7kNvwHDBYh-&_nc_oc=Adq-0-iD4dMyXZOB7fNH141Xua1-Zl3I8Vbm07UW134j47IBUrUI_5y8dpL-a__nVhM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJImI5aCFTzpmMWm99pbISqnuVWAWo-jiOtTrkGZFrQ4Q&oe=6AB3EAFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_Y2u7yv5esQ7kNvwGywQt5&_nc_oc=Adr9QxdULe7ziywhfXvv4imr5grzHCJfvMgIQXUzt-IJsL3jYamdpCIvnVeMyhM1xfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNHmfjg9eXjYC1cMO74NJN3ldn11zaqXx9GERVFLw8wQ&oe=6AB3E671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Prh8SjX6Km4Q7kNvwHoswD5&_nc_oc=AdqolTm4AMDDAvFg4xbyLkAOQXySvGTEY6GoJKhg6DIqQdPxPWd1AebXHvFdGMfXH84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRm68dogAjqHgVcjUb-PlzACM5VqGoa6ZAWDtmxj6mVQ&oe=6AB3E374"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ah9EbFUw-oQ7kNvwEJ5xRA&_nc_oc=AdrY3dnwtflI6YJ5xipZQqXv4D6A5UmfaExPw3QaF-sBJCysi0AmxMZG_Rtds4D2Q3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5xHm_f9MxrehHN7clAyTS3om3jNMFhQgfYvdicStSEg&oe=6AB3F1B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XakvqYEC2_gQ7kNvwEAIBXd&_nc_oc=Adow8dEc9VRjpXI0-5tBwnlNvIl-oS5hmz2fkqoViBjrjqd-TyK73ZX9iMBh
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWB8tAzvFVVFxwNgtIIaOzRMpg9EN7mPLDF6I8dlgA-Q&oe=6AB299FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYErgxWvt5IQ7kNvwGQnBiS&_nc_oc=Ado2qMLWm57nxvve99sdKYkNc05XPac3bMmYcldE0V1QaAsJzrLJPtixMsk5JvJtlEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEz6siT63PSEr7dFFkiHdneSoeiw9SAqi-2d2FmHTKyQ&oe=6AB28D65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To1EDzuG3OsQ7kNvwG2fQY9&_nc_oc=AdrZvKG0DssaSPPVi5mHf06J8nZYALW4ujcckWlY9xFKROw9I4jn3LtOT_S0awtYQuQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4salxXpF989AHKLb7ADoH_oecKUGzLfET2z6indr11Q&oe=6AB2997B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucyBdWcG4DkQ7kNvwGe0-I1&_nc_oc=AdrVgPi-0eynXtxwxm80HjofgRTJ97vOlhm9NpXvoysoeHrF4o-ELDQ9xBdzkeLgZns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGUNRt7A7XQs27BmQzFZyWH59WiGbC1y9-suG5aSPtNw&oe=6AB294F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBDeUwTNOJ0Q7kNvwF7bkrn&_nc_oc=Adr7NOC5IVxtjUMU5w0vuLRQRbdoI1RafulavTu4cIQAUv5a61yyv0dyLB2DdHv6390&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlw0K-OjaS1cvhRvH-Uebl-fc56Q1Jd_ZvQ1TfgGMFtg&oe=6AB291F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ah9EbFUw-oQ7kNvwHdlE-N&_nc_oc=Adru8AtrX1SM1Ji9eID5eyWbXr4v7k7ThUUqSTKN2zKI2-DBOnDTz0uO4_EMU_OxgZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnL6Py935SDQ--Umrdy_7v0zp0DpSGn12Pet6vFs4kWg&oe=6AB2A032"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XakvqYEC2_gQ7kNvwG31xp9&_nc_oc=Ado2bOOeTPyUkxfXm_9QSIFgd0LOPv6P7tnWfEvGTLS99MGvxJ67wZsfsopt
-l3JJUQ7kNvwFt-Guq&_nc_oc=Adqg1PT-fH6PUxT87Db2c-IWhUMocMpYoIxu505nSbJk_mACe6F2lAOG1pdbMu7aFRA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYD4ezMkP-wF5CqgetHvfYvODb7u9ka1v0RxoHX9JluQ&oe=6AC7B97B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Mc4WJ8zRBsQ7kNvwHtzHe1&_nc_oc=AdqL28qPWWb6B4ubghQSCII45XF3BtAlC_5L_laBoh-FsaaNMiL_7YQ6rv_syS4jg3w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM052fTWPXSuwvMxPCxtUxOqNt_OzhltlJuxG-rAg3X3g&oe=6AC7AFD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssc-f_cJ2DAQ7kNvwFtXGPg&_nc_oc=Adqam7HJiJUuyJC82C2yCxhhT1yuWjl0qPn1KJ71_-mwU4wlR6Vf6-Ez2-ymKGXfFR0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaUnjdcqHCJpJ263Sqyw9wIM60_XqQkgPEryHarWlnzA&oe=6AC7CA01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvBd5r8xllwQ7kNvwFs_QYp&_nc_oc=AdpM_Yvu-Kx0uH72kBa9VEqeNDcximpnivjxmHNj3fiAlqSTnNGrTmfstNzrNwmo7aE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLHVwuMuEeXqXmjMvr3T39seA8vwRM6AP95FtZc19-ig&oe=6AC7BDC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DynRxSRMG50Q7kNvwGbG_bs&_nc_oc=AdpX213QWrVRNJM7y7gBVcJLC04ezlWEajUjZcsvxmcsZpsOtP58PaglepElgnltBbk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN7Znz_gxijjfMViHjrfCrHQTcB502QZdP0fMBRobmRw&oe=6AC7CB3C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZkZId_rp5YQ7kNvwErt8RU&_nc_oc=Adpx1W4EXkISGIGc742Zb3HAnZSKba8DCCz9kxZORhE8IeWK4HpYvFmy3t_KDyRhdbQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg4F-o5FAqRvDM1poK3JgHsIw3oWMf9uhVh93wH1X9-Q&oe=6AC7C9C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
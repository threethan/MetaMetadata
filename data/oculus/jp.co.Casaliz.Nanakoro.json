ad4E09EEfZmhXO_x1XPRW3EE4ZfLxDmET7y_uw&oe=69A59B65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-r_lzM5U1YQ7kNvwHn6OgQ&_nc_oc=AdlrdKGqS3fgwLGCHTEyukNfhLjlz7F7f4WMxgVKBCkU4xgsAZVS8ofoBUnOXY81LBg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuWiTHDu5lCIBMxhrGK5nAm1MzGUusb9_VVzv6YMA7_uQ&oe=69A56F3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfvueIvwUzsQ7kNvwETAJEa&_nc_oc=AdkDXrIi8s4UIjSxZKwG6pSeTAG3F0ogLD6Hp3c7QWtCeP2bqRG-IT7G54bCN4Hucq4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvpRou7O2vBAd4gEmP904cvaGP2Fw623n3wrCEEYXfSlg&oe=69A56AB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2qWAAtZXlcQ7kNvwGFoY4d&_nc_oc=AdmEucG4MbJOPAMroetXfYJPvkobNKELINPp_bBqajqJtZaiev_piZEi5nY81FDRFnc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuKs0Kt2NnhU1iOU72TCYk74zUni2CE4x5N9Y2l6JRyAA&oe=69A59FF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXE-ZLkX6xQQ7kNvwGKjxri&_nc_oc=Adm73a6NuIeDTCle-xoFj7PaQXDADn3H4-O-A5jKcsV9LE2qcjU0m24D4hMYyd7N1LA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftKUZR03Hx7QdAPgtp5S3kkKCrAr_UK-svL9neg2iW9rw&oe=69A575F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NAINkFNMJ8Q7kNvwEcyQot&_nc_oc=AdmspPJy-SUvC-ZmMky-m-Z3GD-asdKYfGubpdaiGVEwUyIJI-MPou607J0g0QmecrY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft5R3bd6vbjpygCoe7WLuJCn3jEfpxUPEB5I9KmSHglHw&oe=69A57283"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Q5ZAbSh0oQ7kNvwHzU0Sp&_nc_oc=AdkhyJ2fT01_2hQHJUUwa_cg5TSa1-PqHdqMve3jgkhsSQugh5Sm1s-5J7U3V16LPkA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afux66Rty
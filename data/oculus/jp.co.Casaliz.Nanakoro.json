3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhe29sPP4Sq9hN2JA_eGgCFrVAHUdsnkehahRZu3_w7w&oe=6AA024FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vfwUenHwN8Q7kNvwEDaPSV&_nc_oc=AdqIQJ-r-5PC5_qxgiGzliyBlASqszmk4wPkQj6w_vsqeGf-4MgNqe1G9Cpo9tXHSZ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIotsz50bz4URCjcUK1nYpItmd07HFboOck4z5eXFaR0g&oe=6AA01865"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmmQZ-bAlbQQ7kNvwHLkdc6&_nc_oc=AdqQFMmjE6rZdmZ3lmMo0CXhCwu15wikG8tlvs1wubjBcc3jAevE48eYEceYyy1eqAw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD5TNSHdk8jaKEI-qRtK0qQzcUvnrVb_nXtnps4zmSRQ&oe=6AA0247B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe-ULuGOJs8Q7kNvwES-Ceg&_nc_oc=AdpLY4rjBKLc2LrQ3mRo6sPcvHN8cwimEkEdINV5j-c8POR1NO7PVTWediX1FElnIfk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfN9MaO8wRF2ud6cMUMTWrOeez_Ibr1INPf8ht_H7J4w&oe=6AA01FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QReiDOUrhw4Q7kNvwEYQf5l&_nc_oc=AdrH60dcbPBah9pDw7DgW5MYMjwKGYwAro4kM4k5BfylQFhVFHWLJpnMmintfE9rOcU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDk_0d3wSqktQTc9c5ZHDK28MtqcNI-myBx5ALei5VaA&oe=6AA01CF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtvrBtytcCsQ7kNvwHo_xW5&_nc_oc=AdoU9tk1i926CLTbct7K6-_YV48JvpvwwsSpzeTYEYKPr_V0t0Kp6eX6sgVphPaS7CQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9fM-P1ScGkxyM6WJ0BTRCnMzEPtUCc6mNa-S81opzqQ&oe=6AA02B32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el9vi03AFpUQ7kNvwF4LpZu&_nc_oc=AdoFO2jN4cAtcW4a0kopSA5BV2fHn7qTFyaH8AHjGzgbQdnrZ2TrQoYTYyM2
eYx47cQ7kNvwFVZCiT&_nc_oc=AdqqQ_RiaJzYNnFgwKIjEUPjillM9DpsrfutG6gODFN6R4SpJVXGvj1VBudFT_O-s9E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZB7sByNJtlTJpQVNHaxZkoKoY1r1jDCi84kt6wD42FQ&oe=69F4913B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ5ycXJfx-0Q7kNvwGOGj7r&_nc_oc=Adoz6Yn70nXugfFS6JS4H0GgHHbki9JGTE9jV19LSxwkTYu8t8dUcxEY9YSf3YT3BiM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Z3Xx2qe83pSvsMW2TGBwc1mfJdk0wPmhl4Do2CthDhQ&oe=69F4BFD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci1iFVS4594Q7kNvwFz7UcI&_nc_oc=Adru0NYeYNzLLOpsu8_pnVv9XbeR494YWXbcgZfvpFzUJLBflcvAZ0YVP9lxFe6g0fg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3e4aCqcboS3tRl-EG8JzyNTR6VNlDoZto04NtCU3MQHA&oe=69F4A1C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zFSfE593VwQ7kNvwFaYLC3&_nc_oc=Adr--PXtqzqItHu_b4W1HGlPV6dpU1JgjjQwogT7_sHNgktODZPRv2oIpiB0GSAUsDA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DANava2aXJNLBtqsL96V1n_gG0UUTClu0GSbXeif1Vg&oe=69F49589"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnBa_MS4LCwQ7kNvwGjOp9f&_nc_oc=AdokJZMFaRXSJEXA5OWclFjCCHINziiLkUarKNnE9oed_nIZztnsqoKlZV3-2BIJkf0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jcIZwPSCgF44Bt4LGPXFEnay6OOtz4lnx_up2UJtyKQ&oe=69F4A2FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_eXz_bsBMIQ7kNvwGjEhTz&_nc_oc=Adoj1gaWqbiw5zKD1ZiZFqubhoRdHt3jJfNWbafhVzR_jemuKErVwsRuP8NGo90JlsQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03pG7_THZNEIR3_6YMTqx7GYd-ivqP7Nn-r4w6LtzwCQ&oe=69F4A188"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
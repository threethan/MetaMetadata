1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nm3rEFZk3Xp8myUt4xS1OML1Y6X0xvhlzwXYjPwGwqg&oe=69EDF23D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vphOstCs32cQ7kNvwElmamQ&_nc_oc=AdrqMVbfkTQqc4TBBJ6L8I5v56qJu0qq1KCaKI6nCIF6jaYwrpKvWt4yb39HL4phnpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31zmbsSixXdRr2zTCcrGSTh6ZZjPqQmxr_gLIQbzW9kw&oe=69EE1DE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIrk6WdO3csQ7kNvwHK7Y27&_nc_oc=Adr22zldSmG88hL14erIZvVrQn7M3O3xP_Di_LmVMSFPueHY_vNYajEKM2w6zemtaZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Dp1FqBK2NIsXeLsHkrNX6weWur4VG5UMvLu7-z6XuXw&oe=69EDF1BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKCuomsgjlwQ7kNvwFU535o&_nc_oc=Ado5pltVhWU6l8aT7TxEsr-vGIPs5vmuixeE8HlbV-IP9G6RH_RyF4wG4cVhApo-je8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pU6i8uEhcaJADePJzsi3bV-4S44gKKU-mfSRf7cT2HA&oe=69EE2571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a38i-SgkDcQ7kNvwGFBbq5&_nc_oc=AdokbyAihX_hL_z8QAlpRpS1s4hJwBPKhqbSpyMKNBK6GOCmc2ZLQzO8DoTIcZ7Z31s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cjy1wBWzjLpSKWWplAYC7OccDUoX6WuF8uuQE5bePRg&oe=69EE2274"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doAw1u99-HQQ7kNvwFUi2Ok&_nc_oc=AdpkZ8x5NVr4iTeEkFiwDA5bkysiMcBXwGWKvwCtjuUMURCYFKNIUs2HtNtObHOnnOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WBKBc3PH4m86sCCsA0sLYMx7tbeeVGkZ3mDpS6woOhw&oe=69EDF872"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgtg5ujthoIQ7kNvwHVE1vE&_nc_oc=AdopvrBcYmKt8JsSuDvV4AwGeWBshhve5MwCba33IiGS4itp_ViHT86BXm93
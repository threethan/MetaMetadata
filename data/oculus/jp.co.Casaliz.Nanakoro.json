1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfauATb-dVsdNoqdHdgU3YjiGNrVZXysj7HdBeU2LdYA&oe=69CCFCBD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxdHfbHq-oQQ7kNvwFeqF_5&_nc_oc=Adr3i2UyN7kmPaijAEMAEvUXbXRr-boxf7wGks6jqPUrVCa8PK3fluiiWglDIaTSoX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhCgPE4M04IaJoH-ekeABQMUn8WStW43hK6QM_E4fHzA&oe=69CD2865"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWxg8YnLoDsQ7kNvwE_xfrg&_nc_oc=AdrfRfywgJ0OqAIpQGjGmsc8skW7dHAbodtHjyc8aEbYMeI4SRsgbQhmeWW5MzDhiyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr7sqOGVD-Gm0Ijd3H0Akybyw_aq_HrAQ1mBoASSD5nw&oe=69CCFC3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BousvCmjTAQ7kNvwGaRWCb&_nc_oc=AdqD0wtEJM4VhgzIxWy8xJQapg8zyNbwmc_hS_F_wN5Dbg0csrjghW7b8vdFQlOYuVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4OhEqoltLtGZQEvznZA2GM6DMJTOxhXQ3TfUcVvrsRg&oe=69CCF7B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CZNU5dFH_YQ7kNvwF0cQXu&_nc_oc=AdoDvgP5Gk5T4AxW50Y6uLltOszotxOPj86IPLqqeqnQR2qLM-nuMOYz70YOBQ593Mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsV0hsjHO-cGuYX63s7t_JYxA8Gahba0aVyIxZ9nbw0A&oe=69CD2CF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-06h7SADctkQ7kNvwEcwW17&_nc_oc=AdpL4I4ncF5xlEQd0bNgSUUkO8oftM-6LgaZCOrUM_dq3wttBAzeSrUPtU7EeKw2dVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7NvYyCbpx3uRkvLbkvdwpwKJlaBjgKMSzJPdg6n9jww&oe=69CD02F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y77ZBgcaGIUQ7kNvwHJnfSK&_nc_oc=AdpCQl8jT5EZWUCu6KI0Uho3pSeNJ4mAUykvwvW0FB8rB4uzOvA37mXkOSQh
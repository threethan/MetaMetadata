70556961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tTlvvf6py4Q7kNvwF9uVfr&_nc_oc=AdnSYBubstiVjU1qlRI9NWZdLRsF_OQc8FwAx0SnhOBrDXmECpGaXbzLmVMn5odsy3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvPNgPUxNgH3tDAh-8dfGjWU2nuQAMyrQmokA_OaaCJdA&oe=69A98FE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrxvQ8CkC6QQ7kNvwGdN_a9&_nc_oc=Adl0ZbA2DvmhAXGSGpUp2UZkWcwsQe8ymjTIv1T07ULAkSQ60XOkzN--wwZHNmPw4PY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfskmG-LEIGUmuBpaDzmRGf49_LEYxMdo04CQWKhrvTcmw&oe=69A963BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zkEyA-HLkIQ7kNvwEwXSYX&_nc_oc=AdmXW8doSVRtNPUs_wyaB5Z6U0wBHc6Bh9KqmVHlkjUNX94N0exzw5AzWj0pC4GpSIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftKgXFu2AvrdbgygzIhgCeJGe28lnWhtERqkR37pfSu6A&oe=69A95F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm-48tWGvocQ7kNvwHk0MDa&_nc_oc=Adluq1L8cNiBWxAXgYu9wQr-fsPSHNFcQ8hTfglcgI7J-bh3bhVEJujUMQPq4scV22s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuHDVh-q7VeqZhaAYZSeH8jx_sk-MnP33n-IoNGIcx9Dg&oe=69A99474"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6SERSnid3cQ7kNvwGmHvvY&_nc_oc=Adk3Ucrq5NFHAcKWJHM2sV4MbEdhxMQd91Xn9aqCq196tUSWDX-gdED-9bHORpR5enU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuNCf6i9uvRxa99vA0tcjbQP1pcOwQm_sWSF1gVBBHfRw&oe=69A96A72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClyTZvmO2vsQ7kNvwHlb0z-&_nc_oc=Adngyc_JloeUyWYrQCU38VtjvSVJ20ABL_t4IGtbRHvBb8jUCgjadDIiVWVp-BnFBsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvGkeo6ZfVVaCY_KQfj6v4vVc-drybi9H6LqtPHZ6j3Qg&oe=69A96703"}, {"file_name": "2560_1440.png", "i
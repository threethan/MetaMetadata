_nc_sid=6e7a0a&_nc_ohc=PzzswmB5kdUQ7kNvwF5Paof&_nc_oc=Adrw8HwlwecW6fT_T4RbKqSeNiwWFH8XqReLW8Ow0McsObfY4CKWEroZfd6dP_RN_XU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1xhmYemt6_Os0zkTRHAqxbBJlyfagZo9euxSMlBjk7Cw&oe=69F21265"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH6HPNokSZYQ7kNvwGX1j5G&_nc_oc=Adpe2IG0AvQL350XUZRayj3LdTlvbr7RIDrYgeEK69hWxWTsY-KY_6KXRiYmUbBkJb8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3tp6GUKUV9h7yv3HpLTknFstpsMr0YTyVlMevjcDXKOA&oe=69F1E63B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgcwzVeSPrsQ7kNvwHGpR2v&_nc_oc=AdrDHIoexp1tkCeMxJf0qAHxUq-fJjPTjMgdfCaJNUdPeOw95mCsnMR8VSl4PGvDBPo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3V_DB_IYI2_qWAH-JxPkk7qoUrHpc7-2elL0NZXb3I8Q&oe=69F219F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORKV289TG7oQ7kNvwGZPOfI&_nc_oc=AdoGj53m-ftTrogaBqkVt5ZSPPkt8Pj6AtUfOnwg1WIcFQCtg7YQbSz9-D6uqLtHcQ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af02ms_8-HhiMBcyBtqx0q83GC41O9vtH0xkNVxAJCh2zw&oe=69F216F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9B6BiTaDkcQ7kNvwGq1YDx&_nc_oc=AdoTGKOi8suenHI6y6pUUSD6GsQG3yEXvjaMsBTMJWsfFC2YYO2zXQUjvsQP6aF3-IQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sY3uBIB_3MIW-UqGf5g7oa7yps3uycra2PFWnvkxOpA&oe=69F1ECF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI9v3G2JLAoQ7kNvwEMe_Sm&_nc_oc=Ador5WCxF3wv07A3h1DKZrfijvhNhLxWgLAA0D9lXZ-_qfENdAe_UbJHCh82dbhaWYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3jJaE_5kvSXkzEJfp8mwGTYJfp-xTxpnTpr0arxqrR4g&oe=69F1E983"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=
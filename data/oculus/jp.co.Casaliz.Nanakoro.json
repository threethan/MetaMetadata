HwjsTgQ7kNvwGetya3&_nc_oc=AdoCC8m385ONPnZc6HVZX65vOJJe1SuBDOuGb-NZaAgXJirgknFXImILIlJSKwILxTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PLdIF1mUjTCMV0XDvdgqS5gzz-3NmuZ-tqhO72wMm6w&oe=69D24A3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzvrVoeYPs0Q7kNvwFOS_ym&_nc_oc=Adp3NjdLem7oFPcPzKIGdlh3J_8kkEaBNceCSdtCmllRe4LY7cPGcbsCdD0oZsnXwYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_u4LGBRDo23u_g4N1DVLmEsl59LNJcMwuGG4RLXqZqA&oe=69D278D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk-VCnE8LmQQ7kNvwF5X_rJ&_nc_oc=AdpQPHody-yH9z2cga9X5cRmhLVhIhenDBhuq1pgXQpXnxDO_qegeq-coIcepFsDdIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05HmYk0yy4I_4WLdCg1ieZ9nob4XHvoozVHNMKUWv6eA&oe=69D25AC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uew3XDW5eEQ7kNvwH_9S3z&_nc_oc=AdpWaQlmWFiLZRinhpfBJwgTYLknnrVBgvxNfPVmn7w-OzrcwfvRigJ5wkax6dRlCyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EGQShJyc3UUxsDf0FR1Yr9j5O9voM4mXsqJ0chLTWnA&oe=69D24E89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HGpozMSkakQ7kNvwFFyHdb&_nc_oc=AdqCNRz47A9HiSqGkP-weLtnewNHfqumblt-kQUVYVQPb4v_xSzEmQO0-SKuAi-Zljg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vjAck7Ses8NrukLYoXJ2FbMxVcwti_xF_wzPTbFXsxQ&oe=69D25BFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVAHmTcja-EQ7kNvwHgp7C2&_nc_oc=AdoZce6_sGrBykzXszWJiX10Lple84l-RS62DQlOXAHyAlJy9RoZ6OvPOP5ljhRwihk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aeuWhMRAfv6waWDbAbRm8cFfaGLW7TfUbMPqmjfdCCg&oe=69D25A88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
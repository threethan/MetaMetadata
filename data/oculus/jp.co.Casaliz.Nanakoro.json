1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD30-uBWFFceu6yaNRYhpFFQwbOEG6ig4OlFa61o0s_EQ&oe=6A622E7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RID0jpl-8NIQ7kNvwEsw7go&_nc_oc=Adp2YTUF-e8wCkJnm4d86uammyxvmqiW21oyPMmCGDPLAJfjtxZrE5ntreB7jTvlm4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl_78VmCR10TmvXsb6vxp8A3epMBzq8l4Zo-HRgpiTQg&oe=6A6221E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AanhA0kZbawQ7kNvwFQgOci&_nc_oc=Adoz6es-5jQc72T26Vp-uuXQWIiBYtdMvdxXbEfzbroQ0jIboO0-ccApMK-IEFEw3fM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgainrVnltsL_v1m4T64EPPc4vTnbw01H63rGdTwHnmg&oe=6A622DFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKYox6OQytAQ7kNvwFYRc4u&_nc_oc=AdqOtSom4JdUiW1On_AhJQBBDHmPcIt4WINNS-2jS7bSR8-pqIQ3D1iFCyuVoLfqtpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX72vt6A-CvwDM46VdI_5DIT5i2-V6Mi_GgSkM4o6MUQ&oe=6A622971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT1Qh5reLiYQ7kNvwGtwKqA&_nc_oc=AdqWofi_VDwGvltDGFYj4HLLf5_0O43R6CaI_Z7S9avdn7elvmv83McHwWK8RhPUats&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABrGjVzmGTzB8AYc4TbJ_PStTEVzca2RN416IqxEReNA&oe=6A622674"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvBU6a70jAIQ7kNvwFg3gWy&_nc_oc=Adq23H9pE6p8eFFOYXJKtmhb3Gf8Nv0R8UJiOZgBQr4atX9uXoTVyaFlHQYiACwlSLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLe1_DQndr7WT0hV4P6zKADEmtcEB9NGlAdC_Qj3w8vw&oe=6A6234B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfltRim4pLcQ7kNvwE99oEk&_nc_oc=Ado8-Cu3T7odkr3HXEFlBTnHs7ADtc-NFvWc_Sw-36rIdxB3tydBcWTeJLYi
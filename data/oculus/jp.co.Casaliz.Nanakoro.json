HnOYpUQ7kNvwEhlpK2&_nc_oc=Ado48tm5mrCr-96zk5Or5g7mJKSs-HTqCm9GEN5GOGbvxzgiBO6c1gpqHiOlCwk83PI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49WXWdNnFWCzmY4g6O8l1GpSq60xzlP5evniCORIjudg&oe=6A146D7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0QcasMVrNwQ7kNvwGScLm2&_nc_oc=AdpneiymN5MYL4ZUZjhp-CIV9sc4anZiUEFuV0qYpVsSuSATGuxNW0L1AbHZuU0OkvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5amCWNNt05VwiIGh9ha3Qy7NKtelY-228OZQFvv9jg-Q&oe=6A1463D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-0kfBsELnYQ7kNvwH5IFWE&_nc_oc=Adq9AEKR8cygo8X7KrVL_enJgiYVQtRbSVDPzcVOctkWeftvczxmCSzn1CL3v3Krlds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PmRtvYBLKMxZgA-NLqAaN2eaH_Vpz6GUtqM51zzvG_g&oe=6A1445C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpAO8YcmQmcQ7kNvwGB-Y1W&_nc_oc=AdoNT8SH-6EAJTj-Ctk2GVYU8ZG7yZ2OGelwCXAn1zRPAt6k5TnK0_Q30MLwN9Vdn5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54nLjCRLInmvr-r3zXf3qREEUb4mCuP_eyhHOz-zz4Aw&oe=6A1471C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB6FNDV06AAQ7kNvwGiC7DY&_nc_oc=AdpMMBWpj-NRlQ63Q9KbSYqoukSR3WpmcRAj5L23wEw4FSmf1wmz_SKupHsGMNAcZsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WHGPkWD6ia7WrNtkeHfFjDoaMQEkLw_BvgG7jqkCYuA&oe=6A1446FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhI295HKUIMQ7kNvwFGZgbn&_nc_oc=AdqSTSO8QM_V-flUGKVt810hXv4E_F9t8DZWawCsUU__hp1r0Bwfai36dmJcNB0OHEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69dAkq7vqba9j_eman5_yjCe_tEcK4L5rNS0GkZdllwQ&oe=6A144588"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
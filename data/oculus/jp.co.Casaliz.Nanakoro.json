4rQdzRc8kTvJr4xewnb0ATl9ZkzA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Za3N60z_1-uerzFmILB2-MiQ9qNvB-BcAl1KtczIo9g&oe=69F1EE3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ5ycXJfx-0Q7kNvwFwAmcZ&_nc_oc=AdrwTT5G8RdXjAxA7HyRTovZaIgZBNKcEBvfr71d7823Vg67PZWI9DbHsyMkptmgVmE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Rz-Q43xJtkL2OoDWkyormuqbxwxkD23r0ILhX6Ar53A&oe=69F21CD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L_x1Npk_zMQ7kNvwGMzsHQ&_nc_oc=AdrrvHUe9CL7YX6BGxV1X4FCxOIv86szLV3VBnjQVauqzij1bsSiAVgijEkGoWt82Hk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pBk9T3LIDYCxEaiL2N_sx-N13hg3BRLZiA0oQ79dGFg&oe=69F1FEC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zFSfE593VwQ7kNvwFHZfS1&_nc_oc=AdoBjWF21dAU0g20NrqIrAQQ_utWrNE3fuMGotW2wyN90JhI40Tv-AtZk--cM-hxbRo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3seSOzDSmVxBO5vdFqHbWGFEYWOo9Z1LUHsr6dvKmNhA&oe=69F1F289"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnBa_MS4LCwQ7kNvwG-E_HD&_nc_oc=AdqX5RGW1kl9iu6G50LDCZt9lpoLkkQGr3tNQRaQItwD1FgS9X2rgPSyN3QEKeO0gYY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36Y0buqGPlcwGiFF6IuPAu0Rf-p2F9iD8hES1xmYqwUw&oe=69F1FFFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_eXz_bsBMIQ7kNvwGqp2cC&_nc_oc=AdoewH6Mmkigz1SrL6QiBoCGdCX2e26Qy-QAQK0KxAyyNFruu1vudJIht8gXByoFCvI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xHZlJ2IhniFncOzKabvxBY1w9WKnouk0cysvU0MG9Og&oe=69F1FE88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4CtZqKJ07MQ7kNvwE6RrHg&_nc_oc=
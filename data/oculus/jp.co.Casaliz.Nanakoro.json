70556961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVM6y7oL3CIQ7kNvwHiBOWn&_nc_oc=AdmVJJXZHkIz-yLkBlTSd5yNBmH8M6sVDcf6f_sKSbG2vFrbRYki6-_S8hYuIz2_NOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_pVfYP1QVXIX_pRyFTtWDGMAadK6VO5_Vk4Ks6vrjJQ&oe=69B56D65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYTNswrXFtgQ7kNvwGl5gWD&_nc_oc=AdmqacOYuRJas0qtuAbw8IZW1K97ioUxItMXsgXljmjj6HSJoLfOV-oucPj6Dg-tan0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBv8CCMaDY_rOmRUTmq19cAKBZdC6KLoKOoEOPWDmy_w&oe=69B5413B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lxdgLLKs7cQ7kNvwHmzAv-&_nc_oc=AdlhpmtRPdKZpPeBju_mwFpBM6uUokxQHKamFTjN0Ei2FqLrig1MJS9-Fx-aHf-bOws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPEqNuhqYb4lNdpYQFA12tOH3f8ReeEx6TmoDhq2RNDQ&oe=69B53CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-7HPJMXcEAQ7kNvwHY0vEx&_nc_oc=AdkP8boR84KQabVqkkZy6LmFtXYB-cCSpOYz7hQKBql6lKigDLw2cX1rjjZ55qomD88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWqyyFcKcGS7AH3acKmtf8NLbNruRciEM8WIkr5G3ZkA&oe=69B571F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc29enwUSK0Q7kNvwGFGQgr&_nc_oc=AdmU0qsz07Orh5b1T8bs-76EYrmxPk2Gs_bQalitX6h2w1wZBimEOtdH2GdiC_h_fPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzavkHMsK-c4SX6AFwVvFOL9TwFYh3QkuNdoUbP10HGGg&oe=69B547F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BbxXiLH4TMQ7kNvwHB3eu1&_nc_oc=Adn-ve6kMfT-v73-WkCgjNuRUcu0ZWMEjCnPwsHPMc39MNcTvWrNzkEmrCNsojmtTjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFKsjqf29MvVDjVq5d93-1kKMg7C5rS-VOaWG-Y4paJw&oe=69B54483"}, {"file_name": "2560_1440.png", "i
3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSz5yQJxHlxJhnQjI6dCS7lQaGm29IR3CujiJB5Estjw&oe=6A8048BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTzYpv0zqL4Q7kNvwFR2LBu&_nc_oc=Adr2JJ-DBxnMF5t3CtV4GG_OhH1bfTLYJo9lhuhwY8Mpi65iomol-nW7vHKO75SpJHs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDSyNAR2xwcUw7H36yeTgPm8jmxraxdJPFfB3FwxVtJQ&oe=6A803C25"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd7EckBRbEYQ7kNvwFYy11t&_nc_oc=AdrZOZuttK8JbFlamQjJHMXLYOazjPQGLf8OZfkKU-J5xtvLZ2CMJgNDfh8wz5V3Qfw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH__laPTcCOiYWjZrSqs8ctSlxnFG23QjcSNuJJQFAyng&oe=6A80483B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL12ZfVGZcMQ7kNvwHctcqe&_nc_oc=Adp1JmU2oKuXkDSNXhCtDtO-Nj_4y-g04xf3BwhJYGL9r9eqD9NuzsVJdlphDljQhVw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqoKeIuI-Bgw2BMtR7KFNOo_YHtE3S9vLOnLjQVFuIDA&oe=6A8043B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWCWan1FfDEQ7kNvwGGZBEQ&_nc_oc=AdoaFqRiq9fqBs3irCuWPMUi_oZ7VEsoXEAwuANU8SGm4i_-IprhLFEOlObcOJq8VGk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqX_ti75DMsbuNdW0UFgxFqWUWyAD7cm7mudetzX-sJw&oe=6A8040B4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I6siZD1lx0Q7kNvwE82wJd&_nc_oc=AdqYir3iQVG7_bN-fjJeSg-X715SvZ_l1M51nwn38iYCTNi6Ui4cbT781mBxU7vGCTE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiEpNWk-SxexGkyawwH7xio0iQpvVqmaBgIaCrtyIXqQ&oe=6A804EF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9Mmts-Ng2YQ7kNvwHoZIgq&_nc_oc=AdrNcxP9HukDbwFfgffltfDg5okWIbEVkxJGBIYjFdy1jyD2lyJJgefXw4-u
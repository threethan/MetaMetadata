GOepCwQZ0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFR5R2Pl5gWwDMdm0hiJcPnaZ1FgO0AwYv6GGqpwAosg&oe=6A8EC93D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMolc_da_3gQ7kNvwHzbYHt&_nc_oc=AdpI2stqGZUkQQ5paC2AMgH2ltWe9v2kbuHhogfKOzd43BvyZQr4LEVNILS7Co22fqA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQI4EoBH5VIdCk-7FLfCRmfI_W2jstPOarO5w7E8pYCg&oe=6A8EF4E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzwZpAk7IXUQ7kNvwEAIb-e&_nc_oc=AdoIqmH5Pn81RtB_u6g0RjK5YSbVQUYzPW6NsMz3Uw1K1UBinoVptt-lW7ThwAe1fG8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGezh5y-lv0Rgvx-EN7DGrl4g2XB02RuK-h42S9y-8f0A&oe=6A8EC8BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXSi9IiZBDUQ7kNvwESF2xk&_nc_oc=AdoJfBenPJAyEflXs01nk28LX60ypZRu7LX50X_Zgx6Kn4L0mt2TfiYb8pRWGTRaf0Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNyfR6YVO9kLSLqv-LSHR67l1Si01VgHZx9_mhzyYLMA&oe=6A8EC431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WW4d3PtoKIQ7kNvwFsoCqB&_nc_oc=Adr7hl2M7vKBJWX6r32i6dEk88n3mDO69V3g6IHoxz2fkqJI7GYBFRtbnEPsR6hLEB4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1JfSq1IPfh66iOqxCK0k5uqTaJOKYiP4C7L_aD2a9ag&oe=6A8EC134"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba3u6TcFaEkQ7kNvwFr0BOX&_nc_oc=AdrvnjTQ-wJLmJ6WqFCJR0loVLUy5t2W44Zdk2hZOLl2UYSFfl2IFwJYfWunzvfkwdY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGctVxNtz6ZQDaEobZMEjBVN3GLBdiXNyUazl_GA5NDLg&oe=6A8ECF72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqDsNxEiu4QQ7kNvwFawGdg&_nc_oc=AdpF15sSjLb49Bk
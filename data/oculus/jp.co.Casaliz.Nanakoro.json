9Cw4joQ7kNvwE-LCiI&_nc_oc=Adp8ugQI1qpiTlgGXNu4agTEiDuEBglrdz9l-kt4c57G1zh3Lzbn161aQ5qjxtAl4A8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfYtuxf55T_OkC-iAqwMbXAcb4yOK5_IPMR5pE2WOumA&oe=6A537D3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtyIzK_pdAQ7kNvwEem5N-&_nc_oc=AdrtjIfo2iuVLyT-kz810SewdOAtkpb2NaepGpayOHeg4XEWSoMwGUqLyaL1n7wRHfc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfzmYCnSlSIIa9sKMye-I5tRVwfj8rKskKq0YBKEe_Lg&oe=6A53ABD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j7aoUEejPEQ7kNvwFhcMg-&_nc_oc=Adp8v0RYopea5wiP85KWKKUJkbh5aLj7vrnKhtsvcR-nqzSCqnfAekmoTJ-fmQ56Vb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqZObtv3ZTBGqbtIqa91uWH6HSv-ZH-ntONxl2Hfa-vg&oe=6A538DC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlQwx8oT6-0Q7kNvwHkD_Sh&_nc_oc=Adr8FIUjG5v4IbsgyIcVCPkYTfg3RsaIkjJzxFqoU8tfYdo5yP_CW-Zos9p8sEVPvjk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-CfbaY7ZkHZMDxGKivWvi6exmDtEBbbPkRtx1TZD8gA&oe=6A538189"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X8ApwHBkbEQ7kNvwGiRvl7&_nc_oc=Adp-KhzT-UR1XydmrfAIjcl1a6Ejcmpi3hOgawsadc9acUns7daRX1e9PlHpO_fUBRU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ_NWvcgxPrFs7GbJJ2iAdJYFef6zS2iUpr1978B96jA&oe=6A538EFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkeowdnPehUQ7kNvwFaU3Pn&_nc_oc=AdrrJ76wjNvPqQJk3t8TJ1CgBHr7dmKhKZ-BxilXdUklwLl-pi03oeq1aQMs5kYKFZE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwV-SRxVqF0h-LsdOJJzzo3mVnPgvQb0ZBGiIsz_9BTA&oe=6A538D88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fLZug_Zy-P-4bHRsMH1QmnkOwQQBs1MYsKtCa-3LJLA&oe=6A01F0FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3zhJW0qnD8Q7kNvwEzRY6_&_nc_oc=AdqzpDECflGg5gFRf2FQi4S1domy1tnk8WdFeodb34bJQWmpDDoSWU_d_zS32SPpk-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lfQWVUw5fxyQn3GrJQg0DEI7WSyak_Uj6g36hCe1VSg&oe=6A01E465"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8VWrlf2tK8Q7kNvwHOvozL&_nc_oc=Ados3L7IZnBHIzoVbAQKg2wvoneoAUpCZorFWcpr6J8AeFpn1H9lAFEo_4CMKK81OKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZvvlRALKK8aBuUV0kD9TSZPWCgjXgHZ4EOA8vJURI1Q&oe=6A01F07B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJv6szO6yvYQ7kNvwHNYp46&_nc_oc=Adp914VJQUxPseFEGIxD1d1UDojwn7TD8VLNia5D7pzQcNvWcnX9G5zNxsjcx3GwZ1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FK3klYjp_GDOhwRJvkx_tLCaYHli69ASeVDhWd2OsbQ&oe=6A01EBF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p78WA1635MQ7kNvwFY7lvw&_nc_oc=AdpujiGbBu8g8YjyVRZ1I954FNBK1sVuTbFglSVaDsk-1i0TYFrLrudsjfMhI-68b1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51W3VopnJEyuLebdU2neuhUUSagrVGUD384Lm4VURszg&oe=6A01E8F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1snkfEInE8IQ7kNvwHu3m2K&_nc_oc=AdrMuX0FQUiywoe66HICPulpmUqXK7GfKCsJOikZ7p8zT3w6hEXP4HRTra74APmrE1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hL6vmgu9tfHscsRydEinbnyRZGu_pVMyzKcuHmvw9JA&oe=6A01F732"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hitFo5hSQeQQ7kNvwGrdk_y&_nc_oc=Adq0o7rl_FV1MziYRuYW9k-6OHiQVnnQLQNvMBjXrkXUur9vrRYk2sbYiPT7
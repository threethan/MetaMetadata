-l3JJUQ7kNvwEwh4we&_nc_oc=Adp_DiXahMgsUHUvgWIx1e31GyZaoXRcMZjyjFUggor2eIEk2gmgl6rKajkolsQ7AB0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMll3ollYuJ4rGsqWkhunRg6ydY7-QB5qHLelwsdGJ4gw&oe=6AC90AFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Mc4WJ8zRBsQ7kNvwHv24Su&_nc_oc=Adq2_hlF-nMXxGM3ARhvOyx7s0R2u2dD2fE9cCjHnm6_qeOIV07jM7BRLU2iqh-vy3g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEwO4lPOZ1YCuLJ2E0xq3cvFRxCv_N24dDyFUuieET9g&oe=6AC90150"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssc-f_cJ2DAQ7kNvwFDGv5r&_nc_oc=AdpNTCCMxaYDYRiLandRdJE8Xcs2bc_x8j1ssleb6rw52UojybdZKxq48q5u4i2Ndak&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoYsWpcfAhmjEkOhchP2aMP-noTHcBtBRNOquKoqtsEg&oe=6AC91B81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvBd5r8xllwQ7kNvwHjKU3M&_nc_oc=AdpxMf_hUDknKHIRFXIUrvceAzVdnSgr-k5rxfGFi1x5Sez6roz8wNERtuaZuzgDKTk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYwo7QLKjiXYu1LhFWpFhH5o4oK0KMSwyQNkrvHX7V5Q&oe=6AC90F49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DynRxSRMG50Q7kNvwFs7soe&_nc_oc=Adp7BUJ7SR2uvUPzAkS067UK9DIaZvXETIzlOeX9Pv3J1GClWQqbAy3x_4VKqebGa-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOkFyysgDWx0WeCbemu3DpCzyHRIytnD1mrqQdoVBU6g&oe=6AC91CBC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZkZId_rp5YQ7kNvwFnNTI3&_nc_oc=AdqHckNuYT-0JCMkt0A4zUt6iBbAZN1BxdPOyzIpoanXgQ81thZh4BFPGDFgKYNlGM4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxyyvjUG9f5-aX-UvREyv7fI5XeY1caZXbW-R_b4VR5w&oe=6AC91B48"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
IZEp8UQ7kNvwFSVvdM&_nc_oc=Adone4i6ijHAFdl5puAjTR-NORZL8zrcihtLrI5GA3d9xdP8RcQpzOWS1hn9wa8PWls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IjwhNQlbtAcfpRL4LNUvABLN26rTc6g7enA2hIpvSkQ&oe=69E36DBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhABFOjppckQ7kNvwE44lrN&_nc_oc=AdqVtrkWIOFRruDV5R2T6JAVENpVdk3Hi1eTfUPViG2iGdBy56KP3y35CtLBQ879kBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zx-OSdevlo2nQGTmMmWuPC3jJBaAm_H9aTw8vrd85lA&oe=69E39C50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUw4tCG5UuUQ7kNvwH7KKKY&_nc_oc=AdqCHIjwHjTaee06ObVTMY0zrqcZKqU5defIBugF5-Wy6bYXHO7CtDh07CsV-RB-9Jc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TA7CRCnaj3vRefHpXee79rdBGzCAHNDnoeqbl9lvZQQ&oe=69E37E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_kRwS2djkwQ7kNvwF6JjGN&_nc_oc=AdrGfDZ_9yyZrN7SvHSimY7_AeQPDPAvzIpXlQArJGbUmXLDn6lsFVZUK9jV3HXTwiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q2tKckB4JkWLyxx4bKhXcFOXyhzp6U1Txtw2IqfraTw&oe=69E37209"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR7E4G0IUWUQ7kNvwFKQt9j&_nc_oc=Adptkn2eV2KDsxf0J94esdPBKJfulQ_4KCi2xNi4z84jHZj_SZnPadCGjK_OZJTYTRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zYOLoji3SIawyCfklnSHSp6kSujhlflwwgdp14liAOA&oe=69E37F7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbc5z9cjOUwQ7kNvwHBhuvd&_nc_oc=Adop1ScRIoWdvumzP2nYHIWaxPh9v_XYJitBk_v6JaFzNSWKDLfIW0VTSR-wUR0_NNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-1Ct0W8rpLVp9nx6pZPkmjoTerqkA3PYuSGe3SI3I6g&oe=69E37E08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
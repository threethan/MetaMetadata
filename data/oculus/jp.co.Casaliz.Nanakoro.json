yswID8Q7kNvwGdi1kQ&_nc_oc=AdozNK_MUPV966XrDY2htm_TBIFDVYi-RYjvhn6_FzzJDWoiuyHnZkFSEe4k57wUUDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bZUskubVWmpkKD4b5KIium7RfqcECuHmuAaPd4HjgDQ&oe=69E4BF3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhABFOjppckQ7kNvwGSiCMC&_nc_oc=AdqgSoZcG8I19XGWdaZ7exf-2va9di6M4UeBOs8Z78_dXbMRnJ5c6aPXBoh6gueupRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02LACL9_4W94ifHD-jrbL1n87qXGcsFUa4WFga7CkkGA&oe=69E4EDD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiGkRDkaab4Q7kNvwH9aJRS&_nc_oc=AdrkLJYx_ZW-LJKlkmNIOyEEHdLFRp63T1EAA62FkVu4UEsJPk3JdsEU7zdYi2wRCjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E3YV-Fr-P5iElkjDVAzsrjQiS2TiG1dATdRDRD9f7sw&oe=69E4CFC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_kRwS2djkwQ7kNvwH9rdJ5&_nc_oc=AdrMfHjVFobKS3uqMJib6m2JtOJIo2fX7O8JKDR2KVCDL5bWWbFUnzz96DNeSrOD7qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qy5LzVyOE4CH8uDkxoMI0N-4QGRFmXd7PkU2tV7S75g&oe=69E4C389"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR7E4G0IUWUQ7kNvwHaSKkI&_nc_oc=AdqnCan3RIOBT4O61tn0IpzYTnNryz8jVL52txzIH82dAxRPdapP95Nfm1DVsVl6Lls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jO1If_oUmpmp2FymiBRkLmB0_Jdpo1bFd32mc84V91w&oe=69E4D0FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbc5z9cjOUwQ7kNvwHayWa7&_nc_oc=AdoAurtNNbZDq593xq0Ck7Trq4rWukr1mpTuTyREXt0Cvk4sItuNBMKWv1SkHNOViQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2suJvFl2AVtqjUoMmRI2wGhLFTliIuSiLRr9pzW7WQYA&oe=69E4CF88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
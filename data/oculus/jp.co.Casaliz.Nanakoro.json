QoFjhXOxod8PI5DBGP9xlo8dE6nRe5GFLsL-Dg&oe=69A449E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rt6DhJ4ttAQ7kNvwENywFX&_nc_oc=AdkmvqFgpxF7Fp6ICrMd4FQCKeoEZWsnkgQkBfmtLKxSMQPZkzsD_sB5VZ4lkZ6kAHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsA4_wupcIK47xGJjpacoJBa00UjCGwNf9UQ36x_FxDWw&oe=69A41DBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfvueIvwUzsQ7kNvwHCD9Yu&_nc_oc=Adk8tf1XLy9qTpjbvT8ylLgZQZB8u7nrrbdh2JlW3D6YW9KTpoYWRe3RImK5vsjBjys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv7yhQRKu4ZWUs2qvmBkkY_eGk0qm-GyZ4nMpmetKoKPw&oe=69A41931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2qWAAtZXlcQ7kNvwFu8pa_&_nc_oc=AdmSDekAEFaRuzzKcp39SNOOhUramPs2FwrkhsDU9sewg9T795OXXgmpIO9eyomA2sE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvyeCOqyuaYCxvLM48HATyoVfkx0w8Tu0LxSok1bVlMzg&oe=69A44E74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXE-ZLkX6xQQ7kNvwFqLZVg&_nc_oc=AdnSPLBMR7qCM5sTnMjEXQX05AoHizF5Il0tqjXdXj9qxx0CiB4q_p_KMQ7qNGZ5kBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsPDuNCzQyTkBQ9J1w6hn0dOhdBa5O2gTv6372Aup3uyA&oe=69A42472"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUPOj8c4tpUQ7kNvwHqPsbj&_nc_oc=AdkpcgDxF94bg6U6BQxyms2FTlU3l2H1HDTH3rU9pBGdIkjs28EW2v2g64puMc4f87k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv7omwfMTKg8QA5yqps4qOYVGhL6XHGtehB5s8pQlh4Uw&oe=69A42103"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Q5ZAbSh0oQ7kNvwH-yp3B&_nc_oc=Adm8GlnbWfzufzerWpcfNb7BTPc4ED10nwlnPAoTn7hLqhUhTW-Cixn6obuzD1kvYD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsXxLocB
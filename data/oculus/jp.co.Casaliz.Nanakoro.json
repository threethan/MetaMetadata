1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkvLfWZQ7xWVBHKvZd_3Fo_ttLbdfoh6vhz8isQnP7jQ&oe=6AD38F7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-yroC8Xf44Q7kNvwFbmyyW&_nc_oc=AdpKKjpjKvkiC_OpgF0P7DyuncADyf4OPAw5h67EjYjR5yWrQscSZAzUa2MW8Ik5cc4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHJCoTAFQcUsW0IvNyZC_Ls9ZOCtPEJQ8-KGLy0cDWgA&oe=6AD3BB25"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApwyouCvcP8Q7kNvwGaYBpJ&_nc_oc=Adqa9IszXLb6xzj-mmm9vBBY1_VIBURf6ZrRm7RK2IdTUQXSlL8yr4fqyKbS6E2xjiY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiD6hspYprJ0WWJq3bVoj5y4WiPA9L2gAIoe1_zf8Y-w&oe=6AD38EFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JJvMtFIL28Q7kNvwHO1FRy&_nc_oc=AdqhEocf52cUA5eJmbnInT7HGDifMR1518OwQJFDYMlK89Od_7B57LGJSwDQsfn3LKQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCN7CwM325fzd2l4ztnr_MbK-J5MyZUR5BuonbirmX2w&oe=6AD38A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=girM7UWwwUkQ7kNvwHHP6gK&_nc_oc=AdoJ45nOB316MfkTvcmTK4ACLF2erwGzAe2yplPgAVkBA9JGkxNSMXes06HZAK3ImTY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdvB4WrF7x1V9ki3P_ez75BCegbVOlsII9dgZWRd58vQ&oe=6AD38774"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0v_fCyI-IQQ7kNvwGfWx8E&_nc_oc=AdqTlp7fnCs_x-aCDyBaJJNwWSOELRnT_gUIaNeYH-iQ1zMeLAAK5feKPJ7wIeKF_L4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjNTmMt9EwHCL_5EpUr_LpvwP_F2MG9TRZ-T3ct0y1uQ&oe=6AD395B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGYzj4o3QTgQ7kNvwEQPMCe&_nc_oc=AdokymzvJq_E11K2ThWAD6S2Fw3aZsbDOxNfNw5qgp88w_MLUFEdFyrGJmRx
NyYgXMQ7kNvwEJA299&_nc_oc=Adpl_RThL9-qeq3OWUghJ3hYdPJEU86N59dkk6E1UdfpfcZpU8sjASsD1Y99bmFtNCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQJCQm-hCtgqTz7I42WM00GDzVrpsKOmx3MrS8fZH9dw&oe=6AF880FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucPYiHDVJ_wQ7kNvwGU-dxW&_nc_oc=Adr0Mz8-Duj79nUjt1Wjy1bv_7bgWZ1EdyulDDBcJjrxcc-HSvALiqcZJGeKKZaQ5ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToJE9ODqt8Apq_0q_K9FXUGi8G_X6_dyUhFpuSqHL4sg&oe=6AF87750"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYPw-fwxfcAQ7kNvwF5UBM0&_nc_oc=AdqZc71H-aI4Jq0-eG6sf0P8uBEsKi7iBe--ksvaEJCYaFcRHcFSRT8X2RRK6O9Gv9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfa_r3q-uxym1IEs5CK_44hlTTTl3YzZG1oHphSb-pPQ&oe=6AF89181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWul1Ft1CacQ7kNvwHMqG7M&_nc_oc=AdpnohnoOTRYzRkmvZ97p0vu-yYJIsIXK3y2__VU4N2XYMRqVgeia32wzCwXa_QtCN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9qTAPcT0cDo6ySXbBbgnolKZ8NLQVjxUzvYhwVNIEqw&oe=6AF88549"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjHqXMoBJxgQ7kNvwFJut8y&_nc_oc=AdphK5QYhmf539u60q7Y3RovbIrm90vLWP40AUuXCvaxID6uHvmipP3jHaq3HrZ6Ets&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgenj-P_UOowwr_q924YeyT4wrs-IyTvl51qrKbAHPWQ&oe=6AF892BC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpuH2PxNTm8Q7kNvwGKjat8&_nc_oc=Adpd7UY01ULGZvMvhteknTMHsk7FPzQQdr3-nUE_4Q4yciAjTtBllwTg6hH3nefdOI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTbyLEvvkRs7-s8YJpRRu_ikCIttLGm-Lejc_OvS6Hdw&oe=6AF89148"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
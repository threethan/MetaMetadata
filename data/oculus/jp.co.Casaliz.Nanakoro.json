2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ilJ37tHwv63vYEyp_myRsK3qsQw-fgiIulspZXp-tSw&oe=69DCCEBD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfA4CILAKUQQ7kNvwGrfgWs&_nc_oc=AdpRsiYc0qLIK5bQ1rO6HcN3Yzr5cazkm0apQujLkHmTar_0k-WzFNAgP15cXgYrXU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p2SBqZTg2-gNt6sTY66yExOUrXKEPTCW2WvV1IW5wqA&oe=69DCFA65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtbEEkMy2koQ7kNvwHYfkDd&_nc_oc=AdoF5W1m5o-Neup6pAiZh1YBnD_ZaxW0emFxDEe2XLbTBpw-9cKFCAMItgis8beH62w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0er-dCnCAY9Gc1z59thyBhxfZ62ssEHitdATY26cJGHA&oe=69DCCE3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE3OG2pfWzsQ7kNvwEjqA3W&_nc_oc=Adq6QtPdN_h_LhE-BT5qaVROIiqO1h_8yZZXNpJz1caHBSINsO5n3NLG-O7i9Iyt5Q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02x1D3daW7dlBJQ98JQtKVSoWwxd0GjoZRJplaPdlceA&oe=69DD01F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sneviw3p1sUQ7kNvwEIEOEH&_nc_oc=AdpZnhXH1HY9glFm_E-w3XB0R9uKa6Sr7QQcOMwWrNU7VvEELWAoyMvnCzpdK0sJswo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25xzz4BBsOaCbABxwsXheCR_YnM5ak3y_q9jhpJ5emHQ&oe=69DCFEF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VssMobewo-oQ7kNvwF85Ygw&_nc_oc=AdoW9HHnMVeRpf6EvRjo8-dfp6LLLPy_O4nW7ryIwSJ6X3NHmskaWd1cCjhccKQaN5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XrzAswQwulFaec-WvN78MXW2fd5dpYictLB_g3njm9A&oe=69DCD4F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whpsg5bEIyoQ7kNvwGKrpZ0&_nc_oc=AdquAM-UbrVb5yUZFPSQq5RxmqtDvOg9skYcMoo-15lNUC27ho9ef3pOUT4T
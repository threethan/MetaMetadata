L0aTGAQ7kNvwFWzxWw&_nc_oc=Adqtq_0gxrtlLvNPQ1FS4iozVtc6iwcihwE0USbLdj-iKkqZe25glB3FzD9oXIYAoQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmyhQ0XyVc1DRI0WPNcRnKJ4q-h8F86X7zYUiE2GkNXg&oe=6A95D8BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alnuZezKdc8Q7kNvwEFNTfG&_nc_oc=Adpdf5CoHzbZ3QYVkZDbIL3NWmq-mdtM4nOvvaEdfqp64EDtqwdD4WnVhv49zVjRHDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUxBvSt6vuCI6PCxqemM-IzP5Me8di27llfkkboZWshg&oe=6A95CF10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt1sF6PfYnIQ7kNvwFmbsZ7&_nc_oc=AdpzC_7XabLCI30_m7d632VW-Y8oBN3gpZokqsMMDHe20GLppO6gT_CFEcw6qxxctbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNySjFkwk0OVWkjmJO60--0jrZdUxCqTQgKrruY1DjaQ&oe=6A95B101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFpnRAGIyjUQ7kNvwEzN4HE&_nc_oc=Ado0iflDMDNJAG2XrmANJR5fPEOm6RD9DG-hBlwvmChyzatXoWOiljou-syaKABKiN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEjnj1-7I1kjcgXfXaS-MoTsT6GOwY9AXeDWYfA9D_hA&oe=6A95DD09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7xUZJHxcwMQ7kNvwF7BRo1&_nc_oc=Adr28zIl5Oflkm31_z-YtvmZTfNh2SYjPpsr4xwjk6vvJH5JLc5Wu_lPk6tBToqDKv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA4vXcSJHOC6_U9hTeuVQA3lyVM90elVUGlKtiy46tow&oe=6A95B23C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6GDLLj5ta4Q7kNvwF04fsI&_nc_oc=AdqsSfnFjP18uZVkthq-PesskcCMraqF_nXz98vZ6GD7CvkjCEHZDACC9xgy8XVjgAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtF_tPlAeQ3oIySG2PwwpxXFSpGjL29pCs0_kDnUq7Tg&oe=6A95B0C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA58yEb4aOlmZSxQQz-F2d4rP1d0S3aef54PIQJuzB7Q&oe=6A785FBD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvKNY7fT3L8Q7kNvwGfZ7GT&_nc_oc=Adoz5RaM9Vd03WxEg8W6pRAumtP0Qq9SpNvRPaCgZKO8AcbUsdJx0U-Z_oS7nr0GUWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYLcDt291zoaG-1tG4WnfPsCxknRD2ZVfJiuVZ1XpS2A&oe=6A788B65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miSxYLAz9JsQ7kNvwFsOfwH&_nc_oc=AdpOIIUZjC4xTMZv7ZhiBgH43tm6m3p6dsiaN8Yt7OKKUuwjCjgVHEpJXVLSPqvdOcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzxBT9BD0zYli3Frl1Yah70ynFcBVy1hlt7xfsO6PBDw&oe=6A785F3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDRQ7Z5xMOIQ7kNvwEoGvrB&_nc_oc=AdqxqmdtWlE5XUJImYabjxRoqZwj9uMQero8TRzQp45CJbgj65meB2mKWUplSu5JGOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFRFfMp7aPw9Utx2de5W3N_qEsUq9Y194yFp2TBmubUQ&oe=6A7892F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEt3zotffV4Q7kNvwGgbCTk&_nc_oc=AdoAYq8QVECEjrJeq5A2Dpss357jECBGZPmV7pA3zA71UdswunAFECPjswu3KucOx08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8YYLCPEKeYW06eB4G5CBk6fGtOsR8eO15iom5xPNcVw&oe=6A788FF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXJdcJziJ-MQ7kNvwGMf8yT&_nc_oc=AdpY2aML_9DbvH4K1oOZ3yyjcj_GA-lB7i6XFJwBiH3DXp6vEHwvRy8X3LzsFRLMzXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ3nabGhlfxVEzCTy7l5o-4aUjtMZ90oZONz3D-jnKTA&oe=6A7865F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4lpeNifSbkQ7kNvwGmmyKE&_nc_oc=AdoK1ZH0CNN30T3dQgiU9RlQrIdwIDSF3QGjEmt2U7F2nHDEvAvOs5NuI3Le
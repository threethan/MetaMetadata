voLqugQ7kNvwGuZiyX&_nc_oc=AdqqcQ3bgNsmEMHPCqCvFRqxZm0R-grXhd6L1CUXUUhKSkMaqGVxNCtKwv6m_WPBfNk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSQzo3r6fSGaxdDES0tPY42n8n6hdhIw30Hlp27zBAZw&oe=6A81A1BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMYQ8sf2zX0Q7kNvwEbzFHt&_nc_oc=AdoJ3YhWsRkPwxrFSQZdvMrTh3dnP-HfPoa763zv2UGuUbfyeVz_LNMslI0dxleJtrc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjVvEnM_kIMF3Fgl5FlvSurAegwkqrjw_sonhoTdMaAw&oe=6A819810"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUIpnezgyEEQ7kNvwGaWI1D&_nc_oc=Ado-9qrzgJkt9doCU6b2t8-Y2cU3i6C2ZJIzcl_RPHtp4F8OKP7YjdNM8sIaCUnZTBA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUzMsHHLWy0cnlOCd6iQCrfBgKM4S9nqfENGyLSpQSRQ&oe=6A81B241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkg3bkuu_PUQ7kNvwGTgUAS&_nc_oc=AdquTJPB-u8QKAPN7ITPdOeL_ww8szHe5XsDPIpE8u4VM38FPWpV8TqT9AjORU_jVHQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8EHVPybzuuhKbi1ZRWqYz4C-11ihRqIW-Mg1t1jfHtA&oe=6A81A609"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsGPA66t9XoQ7kNvwHSP9IH&_nc_oc=AdqC4kXmFtOX4WgLJlw0MH4ieCNjipDYNheD6BUu8tkQi8ayhlxcXVe85pND6fKkbj8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHfLiIzTyXxeinyZIo_J3161lsC1coOecCfT8SmCl2xQ&oe=6A81B37C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEVucTvoKMUQ7kNvwH8o16R&_nc_oc=AdpV2d2kvqzhR5BL0meYfav6qE3R-23SzUhMQcTC52UzUpZwqVwe19N6TknBtxZEgPI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc7SwXq2SZ1gDVREkfICZqKBDMsunQ8Xj6qYFzpxcVnw&oe=6A81B208"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
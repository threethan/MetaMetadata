YpJhudOmZMScJB7-JiB06sgZYwMjqX7W5Cmqz3VhP3Wl8c0fP8gNxi0I0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-KyhAdtvahVMYw7QJ1tvDUOm3o2s8DcO9_axLlozM6A&oe=69B154BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEC-GAMPockQ7kNvwHDhR5w&_nc_oc=Adl48Guotg2yw7_o4fCVMrdi8Q4H_Wtm2_HHz7zJbAOHuHuXFXMc8OmPFclct5Vtbrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjZNOB2P9uNryyZKe1ppIvsxh_l11rijj7PTaheeQz6w&oe=69B14B10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23NuyogPDH4Q7kNvwFvTu8f&_nc_oc=Adl4w-N_V4vBDN1ivGxmGC7GheHDleNDhhOkhWxLzZg6aKjn4oSI6KoZ3Fx0btLO0yU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrgOY_OWyasWyNNOCbw_5pKp4SKIN1so7k38nzGRwS5A&oe=69B16541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWevMONcsMgQ7kNvwGvd5qM&_nc_oc=AdnE46XebiSrh2sZDDx8JhddFYALpFrm0ViZgOL2vOUKgMzxzNpW0T4x3AubNnC12-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkHFOwSmp5qQ00jAxmoTpk5Mzlk5RISleF8NPnHMhBdw&oe=69B15909"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFEvYvy-oxMQ7kNvwG14vnn&_nc_oc=AdlkHSl6yy8rMO9d36Z-6KtcWeDXatDNsqyUcfu8uu9wCLl80xHNPLMkm6fylT8sNu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8iPxsLd8OAiE8DNggffHrCry38mTe3oaNuaHWg8rp4w&oe=69B1667C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwOuMAJqcbkQ7kNvwEp29jM&_nc_oc=Adky8QUZO3OMwJ_NOQAsVJiVqiBNC1kc6JbyMMyL_GcKl53NLbpsHRWdBskHs2-cKFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyF_HVX24SAH5mhShwI9jPOxxL9BLLvMbTejtvKqRoMPw&oe=69B16508"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
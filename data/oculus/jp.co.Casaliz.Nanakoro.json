1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aYALii661TYZnExL4tASfhixHzrNCT0WYrVOtNhWD4g&oe=6A37FE7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YW-bQ5JrNYQ7kNvwH2truV&_nc_oc=Adpa8c_WJjy0VhaeiN-3cAC9XGluNKPLTDypggEZD2GvkWD9bMd_UXq0Hi4oUn1XkUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-7hmJp9RnGDf03_BToCiUrHQMsAoXsowGfrMQnjVlMQ&oe=6A37F1E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8nIjtwjzPcQ7kNvwG308IL&_nc_oc=AdqK-KQGu2Qziim8JVklyQtMEeRtsvBNLYkSzWqVvYeZ7ulABGKBQS-yvBxQrvPXGXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AkbQz793ILCFhbBHio3H5UxXmHN4e7XP7IUGq9lRzMw&oe=6A37FDFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjAuTj9Td9QQ7kNvwGcF8ld&_nc_oc=Adordf7SJP5srDQ-jmQn-atXfSF3etgGeaibSUlKv2dxb9U-3zeEA47pQzjZYpYNuwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93KZhbTLCheEZRESReBIQuRiEanDjpJMBPu-3h6osoLA&oe=6A37F971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqMU15xYU0QQ7kNvwGbP_V6&_nc_oc=AdpRX2l3HS7Ghy851bQr-b-iBM1dPOZyHVa857Q6azcqfCujqI7KM4_dS7EvJB5W5M8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QrDXNZLmZ2U3mZ6O0jhclfMLoEV00UoJvJjGQ-vZa8A&oe=6A37F674"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqcLu8VrL8QQ7kNvwGz8-lp&_nc_oc=AdrBR1WD7wO4QsKJsIJLjU2I3rkI2VuBqAQU7M79uE4kGNZmGEty3XdQVa6nsilEMRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ERBI7lPwZnoqXR9e94lfgUoX7OmGHxEP1If3nOWeBug&oe=6A3804B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a34TOIdK8uQQ7kNvwEhzvRo&_nc_oc=AdqD54xzhtNYqHBULj6wgS57SI0nwBSpyJr7weuZpSY9Tg9yWAfqZ6M15Ywz
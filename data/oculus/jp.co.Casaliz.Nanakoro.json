x0Qo0NEAkrZjaiwsvfJENZ1PJRO6dFoxrudPSQ&oe=699F03E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNUF5_uGkvQQ7kNvwFRzFg6&_nc_oc=AdmKYiIDur6fDWyiAVn4pxFIxvIlC15Z5DsxanhYDL3iaOxjSY21KofaK6StsEYIzWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftMDCOeURDum0aVVzeDc2Ez--ihTWrAI1m59Ac9c0_5bQ&oe=699ED7BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpoXC--cE2wQ7kNvwGw2BhP&_nc_oc=AdnPzO_KHKqh1Cr5RdCF5aZ6cybKa206bDMDqnuVabxFhKIMhBciC3j2tq36nAtc1QE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsrH7XSSuHHQLkS2QZ4RzG8S45ftjyaNX2izCj8-MMMFw&oe=699ED331"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3bOhvRgV_EQ7kNvwG1rz_t&_nc_oc=AdklJsqE9hBX1HUccFdGrIWE5D1CcruxMKxOPmVh06T_LUN0ZLIC2ast8zbPoYZff5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvUOc06diC3W30VS-LcsgvBmYUA8sCzkBabIvCiNJZO0g&oe=699F0874"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQz2W7cA8Q8Q7kNvwFtPiU_&_nc_oc=AdkdmOjwh1zCcirUUZDzQZrt0iApEIxK7C8yWYiYbcJAjo-lUuk1UTbx42zjeAMmyYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAdI0bOC1-ztBzKjU4acub35HxiXF5ArgqlkAdSwRBnw&oe=699EDE72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=difJXqGaP4QQ7kNvwGaUje9&_nc_oc=AdnKCq1A4-KdIPeNg1RJKTwQasZwJuGcKDuLHD9VcfhO9paJ4dD2dutZCzxBS1z9nBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu9r4r_lTsygM1Eczn5jl63Rf83UYkWKCWoo2MPWLsb-w&oe=699EDB03"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jwu806vn2QQ7kNvwEuBKYk&_nc_oc=Adk6ZPN_i3_642h7W85xfRP3xC_dad_M8whWS908aonj05a5VKIFe1QppwxK8sKUXpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv2NVvrO
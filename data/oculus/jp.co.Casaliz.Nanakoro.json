88reXUQ7kNvwFWAHKF&_nc_oc=Adqfboc0z1l_LVYyl0TCVkRH1ZMMahAeOyFiAd-va6WVlXtw0dfLpS3QNosQqTE-YgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtiZGbRsuTYXqM2b911UamjRcykMXSAYZkHR_y5bG0nA&oe=6A82F33B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMYQ8sf2zX0Q7kNvwEMxBgi&_nc_oc=AdqUQ-p8EdlZZUPJ5BED6__ENAuVu4ntnChP_EpR0FomQQgUNkooCxy9wFPsZgahcNs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEnqG8X_pXgKZDvvj_3hphHFH3AmxWGe7ThazX5SNPbw&oe=6A82E990"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4D5LdvAnTIQ7kNvwGZ_ZW_&_nc_oc=AdrQJsn2B5O8PgvoMTmM1rLaJvtjbHDtY7bEL4S0zOhBInl9DfM3nhN1mdOXAmmw_x8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvdXcbJwZLaxqUdAdL-w53es0NoeGsM5B9IxBpgJ8P0Q&oe=6A8303C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkg3bkuu_PUQ7kNvwHbYx6P&_nc_oc=AdqKmTJt172TYm3DPMFQiE4DGC0RLUVKJ3HKVZdd9wizFii7L5flRPeOl2a6tWR7pqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9VV2smeFMkX8xy11uYh5AYz_3zVTKBlCY-LbceXqZmQ&oe=6A82F789"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsGPA66t9XoQ7kNvwFL-J5U&_nc_oc=AdozXIu9kfIot770dWpSD-cxILxKwuCA1Q0nFPHSnxpvk_n3LRb48vPX8xg4pLwtqJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFToUH_Wz1kf5zZLmAdUxUqMNVZH05o0hXsE6UHPEDwhQ&oe=6A8304FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEVucTvoKMUQ7kNvwFuAfJk&_nc_oc=AdpqD2J_LHklUWc3wDoQEdrn1o-ar-dNzntK3IRZd4tXDRnrVWLXLnvverAect1VTD8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5427SjOnsETSz9BWpXAoFYfNPOSE_QH9nSxKa1MCM5A&oe=6A830388"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
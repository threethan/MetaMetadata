1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPqGctXFPRobkBnKllAWX7XsjT7Jqzj4-gWXmIkfECrQ&oe=6AA2C7FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAXxZc_iY94Q7kNvwG-DnYN&_nc_oc=Ado-Y4tBxC9Jju-00uYhpYCGP9Ql6K6Eeth5GoFnob5MyZgltNqLVnNTP9HKdbvnS90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQdhZspWjaZy5FO7kbeKpdSPzXPsOqT-e9ue-DCavNZA&oe=6AA2BB65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnWwD8ByAO4Q7kNvwHa6OFH&_nc_oc=Adr20BdA4RJf9b9sw3KAuSJ5jrVsm74-JKtPZ4OEvfzPkx6y0-KLBf2yoXq_HPboWkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzqAYxKBMl8ICRrdPKAjwW2TiIYbZfFa7s9F-IYdGLVg&oe=6AA2C77B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe-ULuGOJs8Q7kNvwE4fFZD&_nc_oc=Adq05AkcYh117pudzJ_QLmdyPcgsJTqz_Th6nhZIyTTLNR-GgDpTJDnfdvHMxTVqO4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL27P9FsuQ69J2clN8QvAoteuPCcyY-sNd7Z-zLO-Bshw&oe=6AA2C2F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QReiDOUrhw4Q7kNvwHUzCsy&_nc_oc=Adpmpq7Rzuj2BGr99RnAmlV_o6v3hE2ZV4VPEQTHRemOihLXG9pkoYDN6YDdn_Y0FOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFYssnqP8_hnYI8_FfdErVrhghmvUgIAKLKaa0B-Uc-A&oe=6AA2BFF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQQiByNJv40Q7kNvwFLM7QK&_nc_oc=Adr1WUt6v9y4CTQqxZ2NBwKjeDs-OX-QlmunSV07dZU_BCG3svUEv0g-zBMAuxEdWnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7qJNq_xWCfTaAapNrCyRor3Kx1DgdGkpzsX3737DO8Q&oe=6AA2CE32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYSxErT5FXYQ7kNvwH4kM_x&_nc_oc=AdramHksMxSajDBktlwYUn0G7N8_VpmixsFQrz6rNcTf9Q_1oKDoCsm4Rokp
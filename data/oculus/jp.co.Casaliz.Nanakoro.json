t-iad3-1.oculuscdn.com&oh=00_AftsOJVFDRz39-cO-PIxazE0G_50HI43dmKxhqVDB-REig&oe=69A0313B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb7LUUD__MsQ7kNvwF1nja4&_nc_oc=AdmELljWVZprotoZPDtqe1F8elaQs8stoG_UjMcTRzjbiKth0PGXjPPHwmx4L08b7Jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afun4ST8AueRcVAtvq8l1UDZqOWIwP0KdW_VgmVRxtsNGA&oe=69A02790"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHich2xB0BQQ7kNvwEQjbVV&_nc_oc=Adl7jAmwylzIN5heC51CaeLq62wd40Gco41qVLEdTW0sm9S02LBaP4NimV8zRO-vgcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftovTzRndlBJyjmbjIeRB4ITfPBxKq9jUs9gk-Yie9lOw&oe=69A041C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyt39FiJwpcQ7kNvwEiQEse&_nc_oc=AdllOk6xWoTQXPrNoGAMuB-kJ-_xdkfti2ML23YKG9vLnFzUqn8fHbyVUvCQnJ3bGjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTOm61MPyoF16vvpn2T-qkbAmo-wUbJ5znk8lxZ8ymIw&oe=69A03589"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbykt0gOoegQ7kNvwG0y81W&_nc_oc=Adl9T9c6hZiHa58Hg8FKUITVo2l5_8q7Gk5pba-pYwS2ZQOOp1bco5gyVqvD3T39mvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvFJsM2CSEvXDN3DUKTsGeHQxQMuSjF1D6vzxQrZREdQA&oe=69A042FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhmZEUwFG98Q7kNvwFmZSY6&_nc_oc=Adlppe3kB6n587a5THL0ssvf0tujK3lcbP2UsPHT9hiCBK0VpfcE7zROUUwJKKVTA2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLj6sY29H7Qe-9rNvTHq-eLVdP-cm5xIedd_lUw56WDg&oe=69A04188"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhqODh7GP_YQ7kNvwHvskaW&_nc_oc=AdkZQ_LZOQb-6HfsNX-neyn4UC-JlLcvJlHd492nXYIipy4DsfjUdgfBb6aof861YN4&_nc_zt=3&_nc_ht=sconten
qrtfIUQ7kNvwF0mVc7&_nc_oc=AdqOU8IGIO2JAh-KY9PCa02ujfIkyKQ5YI3XcBIdBZLcgFM3NIHwJmaoOUW1m6sCKe4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtXyIhuTjAeXKPpVznW5n1oeVqKP_oBFYIexhkG-znWg&oe=6A5CB7BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ87n-VmjNIQ7kNvwHykF56&_nc_oc=Ado8Veh6iDiItsGB1LJ3F4GWcfy1eSkcJkEmvirVDXu32uRoJbomC5VDrcbBj_JUg80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV4XWqQugBteClyZ5W0piIKJ80JHXsaYnu6bx5rqWUHw&oe=6A5CAE10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAOor7ZXwn4Q7kNvwFlyMER&_nc_oc=AdoNC2P_LeBhJkwEhRclYU_Ic9U3PRruhhLESb-S7JZfGkmSyy2CtAlLWe7YIkBDlOM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCshS-5I5EU80Xy_H7YSZkk0MGAYL9ffbmFkcjlOM_uOg&oe=6A5CC841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qVAfgUAH50Q7kNvwHSvdur&_nc_oc=Adqvj9g_0ew2FX_E34CkAJ5P0yaHNL5-UHzQGuLxlpziS08QLRfO_SqMscrV6wb0YSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZZKRZ5PbTXsk08oR71wc4PlXgWPUeAe8ZS8OzMH9Q4Q&oe=6A5CBC09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrogoxmvpU4Q7kNvwG8HsF3&_nc_oc=AdrXhzO2vmsZ6sxLz3YXphXsT6G1CP5m0bug84bJQemMged7HNpe5crAzSxmB4_FK_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0lD_z0AFKgUyQJkpmVWlzE0U7ZBliUy4wkGAmwpTuww&oe=6A5CC97C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsVHS1HBdeEQ7kNvwFuK35U&_nc_oc=Adoihd61PEtyu-G0Lg2Dvw2HInK-BLORAiJfjR3TDc3oxXOVnL5Zyubjtz6zS008EAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmrev6N002a9NEuuDFlNpbnvhbl5afRUEiQZMONdGl1Q&oe=6A5CC808"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
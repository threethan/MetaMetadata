arhap0Q7kNvwFfQSGP&_nc_oc=AdqVD1LM8KtdsDhM3brYyW3VT8WauJSVS760cxfsyol3aA-7HAxaZLb8O9CeT7oe5Xk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaSKCwNfHPt9GtTFa5Z9xdHCQUVQBLbfuPIZSumA5vCw&oe=6A5263FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtyIzK_pdAQ7kNvwGqmkeJ&_nc_oc=Adpt2Yo8RWB9p9isX8Bd7FZh84uUFT8ezYhCDDHIAlmTw-MtffghvHShA-6jC9oJBWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj1d0K7i7yf1iDqkeaaEkEmImYmuSiNUJY1yOe-JlVJw&oe=6A525A50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxuUC4S7_EMQ7kNvwF_9GID&_nc_oc=AdoXcCkEr7YjHURggFqeqYHYK4FzGecSYpplPv0sHTeLF3zcM7tzCuiiS2kqPFT9QJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS_JzqGo7CusFpVdjGfuJ7SpfOMSR0mBpXG6beBJYy_g&oe=6A523C41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlQwx8oT6-0Q7kNvwG7_-Xz&_nc_oc=AdpHz6Tqd3KazNV6RCRET9yrPLaRN6Iq0wkmxJBjD9FAxgWgoJaM3oxACjnQ_DgeUZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMWHCGzNS37gLBU0h7k0icgJNuOFDDtfihxRNbdP77bA&oe=6A523009"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X8ApwHBkbEQ7kNvwFwpq0-&_nc_oc=AdoTDGhrQCirplJ3-jrLQ30IiwJ7Qejgbth09CIrGmPXBE8Zhrcd-ghl8J4Br-RrGLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsmxZ_fRyH5XAOriigyL7ukVJnvg_30_5-sHz4wCS4aQ&oe=6A523D7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkeowdnPehUQ7kNvwEXhN7P&_nc_oc=Ado3SczoC1ayXUdRjvtOE0eeiJFp6zTPBBJrsNqaafhzb_ZbhWUI0RsmtyCybXff-0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK1L_nvF2lJeR1oH0QB_JOaOV04k8bsneLvm7Ez91G3w&oe=6A523C08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
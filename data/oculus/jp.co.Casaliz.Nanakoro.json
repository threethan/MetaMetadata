HwjsTgQ7kNvwEBX5g9&_nc_oc=AdoD9n2UuXMMQAVRk7U4NpVQmH1AjP-knC8yvyx0BIHxdpH_VMi_AovNqzowla5lfeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLuF4JiOqbzD8VjbFksG6idMeUvmzqI8el-ERLHsDL5A&oe=69D0F8BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pzCmadF3QMQ7kNvwHqjT_b&_nc_oc=AdpVtvi_J9x0BJPl8hi4g5u9tgnhnGfOJEs1vqG55T38Usu-x-JWyVqMiTjcS2BeTSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyhb1VAAiOBF1nW3QwGaB4sLud2l12WvPfobiUL8GIMww&oe=69D0EF10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk-VCnE8LmQQ7kNvwEkm87W&_nc_oc=AdpaAcsfycHjlAPcD-pls0ZuBr1_iugg5Mw9oCCmgsLbHELTUX4U6r5Hf9J8xHxb_a8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKwZon18RQ5oUffqpvuQ9sTNon9uk6bA5quwoPkPQWYw&oe=69D10941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sz-KRQrj58Q7kNvwGIvMGm&_nc_oc=AdouW351JsAk3MPfLLmiPGxaS12QtljViD53TqaC4jLohidtxiD93TWwZDlW7zH11rE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxalgdNjTVhX4ATAhGnBSYzJog7zM4NGjJaoKDU5su0sg&oe=69D0FD09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4DHOPMH8iwQ7kNvwGRFZwk&_nc_oc=AdqKgVagrq-Hfw0ILWl2nValFIx-EolI1RAyyzJtqT1yWqmwTJR2_gKI1I8vBKCINqE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfWmrq6hsksdFQ_aeeJm07GNWLWb4Ig3IhahBmvE4KrQ&oe=69D10A7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVCArmImPdwQ7kNvwHeRrPB&_nc_oc=AdovlJSz-5vJGQeFWgdzfts7Z3REzHkZ9bgqkOhNnxMD6J11ni45rFX0U-EYSghxgfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw9l59Rv82rdPu0XxYp6L3LJLAaRzZioWijwRu0LRgpA&oe=69D10908"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
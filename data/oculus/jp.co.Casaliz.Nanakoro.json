y4sDhcQ7kNvwEsiO9U&_nc_oc=AdrVlfRr5PRNdbESbSbp_jLEYrTQMo5xKd4KrK_fi900uy_0RsIhxQt4STPMQe-Kwcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKybqRnUw2EH1pRfBFsfduLE4jUpz0vXUiEJ6RHW_Cesg&oe=6AA5727B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzHqO_V131sQ7kNvwHSC4z8&_nc_oc=AdpOnNTiHeec0Yr5_sxHNBwmpfGK_L_RSLTIm8ADXdVRJ0E1fX1c5w1cVBBqs2kg-wc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOH-BjBGopirNpRbkGXfNRk9ihbj0NddAiFiKn4sfeTA&oe=6AA568D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzuC18BzbUEQ7kNvwHHatEj&_nc_oc=AdpBgSZFRPk7mF1cDdz1QPLlwBVywSBs7_kgfFge6Gvi2ImzxwHdSeP6SPLCB26-Wa8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxeGYOZ6VibUhAZkjrxTIc8-0YpvTIEEHb7xlXrloB4w&oe=6AA54AC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeD0wDE8hfIQ7kNvwHzuVxg&_nc_oc=AdpfSM9Bz3O0ykYvUH1UoVTSW9AOLnZlW4Y3DTgIwOjrF-OsKya1WZ7ARlld7yD_ma8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_7Skp5sFYSIZj0lyFP9SgNy0jyUDZAnNNiRpfMO093w&oe=6AA576C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOtyEWK69RQQ7kNvwE3S3HI&_nc_oc=AdrDGds3YFwakvXBh7b2wUDT6N19IOEFkg2ynG1Au2JMr-SaKpcRwcyAM1Ij9SRAvZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzcZlQq_WQbgGbDtny25c6WjNzx8dxbHSGJlT8r8p26A&oe=6AA54BFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kp4ep_KVhyoQ7kNvwF_Kq9Z&_nc_oc=AdoCe-Y9QEoOZPEEzd7HLlqQoV4_U7B93A3Jr1PEpTUTJ0hhKwFCsU-YI59M5JLmNK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNtazqC4Mh2a3gKqcBtVY8byvLeYCjnMDi0G5HVk6AOQ&oe=6AA54A88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
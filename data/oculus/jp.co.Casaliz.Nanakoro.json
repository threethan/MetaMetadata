1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoTEfHpql0V4dLnvv1n3vZu1P8x3R_fJwZiZru1ND2Vw&oe=6AEDED7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7jfxzmkZ8gQ7kNvwEKL-76&_nc_oc=Adqahgx3QQ9rZ6EHjlcn5SdfEwdBueN2gPKqdKf-A2T-j1_51sWeVDhJWyPjRGLpJRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Del9IEwc7oXk99KRzz5jEPlVCWcmEHj3-xiaFtKTeA&oe=6AEDE0E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCIMAdVvUk4Q7kNvwFZPUrY&_nc_oc=AdpJO06IVDybJeT_KI1DXT5hrVd56C57UBbXvHxvl6R39O1_x-YIdEc9Qo0h06FHLdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmWq5r5XBNeHKLcEwCF4c8apTgaHldhfDcQRFGrez6oQ&oe=6AEDECFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rja6pCfnPcQ7kNvwGiRYQe&_nc_oc=Adpt68ocy27U_saPCG0qI6LB3Lba0fH0SjKat-zYd33S8c_Qa9qXvj8yi1XeVn1OGd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT98m_Z_iiB3FgKqUXwZzRrNJIy0jgUFFFxJGAVLcXUZA&oe=6AEDE871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmMJwRbM174Q7kNvwHk_QYz&_nc_oc=AdrEa3TTB-pySOcZNl454kmUmYcH0j1qmo46TWBaqf565ERaNWmlqy2YC6oY_-r7MFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo5wDMpyQ6OVSGN3kRI4jAOYySYbM2cZ-6Oi_jQBM9Gw&oe=6AEDE574"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uBJyIKiY84Q7kNvwFlKgap&_nc_oc=AdqssTCh3AvIJiEJQ45l7zoYpB-yVe18n2oaSR7_gSRXWf7ypyZF0kyFClQGFbhTWow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSza8kUIW6XhUWAnwXGfdyHoWeJI43B466hPPFtYx8T5g&oe=6AEDF3B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9NowTAKd9IQ7kNvwEmVs0-&_nc_oc=Adob3WFx6z-dA6ZXffMDCpLddwHnWzkzGmXvBEOxKcLRiFf1eLOwAXU6RRA2
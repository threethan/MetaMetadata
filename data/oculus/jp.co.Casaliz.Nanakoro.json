WxzPojECCoQ7kNvwH1n9we&_nc_oc=AdqxmuXAfqPvw0pLeTAzGv4qOO6MptYkr-4eQsfu3UjcNOVYiT67cKpjGLY5TNzfesc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mhxlu0ZnpjFLkYmbWlh-KqccuWR8j14DqBWWdDoTABQ&oe=6A39577B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv9XmHAdJ3EQ7kNvwEeLhVB&_nc_oc=AdqGX37DLGkSTonyywxXrgCBXjFQvPdYOZjbLwfjSctEV3NDh81oEnlFXeo5BkHhZpk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-uhg4IkqmfQYYOKutZWMDNfDa-egXjo4svKSaQUs2Cg&oe=6A394DD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lQH1YIw2S0Q7kNvwHc59r2&_nc_oc=AdpoD2ogUhM12sMH7t-6ixF23KLwlIA3q5ynlfhW05H8_0JiJ-mPzHKxhEgie14EgkY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oq0qNeMUJA3GUJTezLn39MTlxfnvnyar6kZwS2vNKEw&oe=6A392FC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXotT32i0gEQ7kNvwGO3vVF&_nc_oc=Adpk4qUMFc1KWvSqUiGLWuLGs0vlO3As0SD8E6uT4-7VJ6Loc8YJPbyTOzZWS2fvabU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KsRdh_F0gIsvvauOaqtq25TivKj4AJhvKPykPOZ4Scg&oe=6A395BC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6tTHT-kpQYQ7kNvwGUIpCM&_nc_oc=Adp-BN9h3kbpaw9UluH9_K2Nvyio4jD16HmmFEEed5PtQNMa8CNbA8Rgyl3ljjNcIv0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rBn5qBvpPqZKxX36obb2JmpK-ecQEhand4iJFws_qhg&oe=6A3930FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw7TSCPN6-cQ7kNvwHRzWiq&_nc_oc=Ado4FdU1R8hqJdzWiiEXOQ3-GcqURYtm7A6UwTKVUk5SgllVxDfwSMLEoZ-wVHuAqU0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fYoNu7F9RR2qRJigEV7yT-fV7b3ardYlQyKzd-4FWfQ&oe=6A392F88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974714_10204990
3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78ur8rN7qzWC201d6oqPPgARwHGUMAeL99wWdW9JqEpQ&oe=6A0C7CFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzAsmWik8OQQ7kNvwG6w8Hl&_nc_oc=AdqL8pyl476XLjY3BG7ih0tyycKxc3rYG4MyJPlpGRVtCDZA8IXMzLZWriGZwZ0Djoc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C0pGVWDf5crO9qM6Tj9KAZFlBunoRa1dIwDKXAUceHg&oe=6A0C7065"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhF46R0PkoMQ7kNvwFnpDYd&_nc_oc=AdpGx160DIBRBpCJ-xbazVFMytPNSROmP9uYQOreolwa7xTx-UTep2jv9y3LhgB8g1E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d8yl2QBntOwvRTGI7oiHFXkGJEMCUn2pmMfQ1WQrsEA&oe=6A0C7C7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-I5tBB8eKoQ7kNvwH1FYSe&_nc_oc=Adoupg21BnW_AfXKT2SmozwR2K11GRACJb2WJVhVHt8I6nFIxrQBI4PmkK26foemL_0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50MpPD2J-HzwNE4Gf_-or7GeNxEpfu5Y0FNvj7C0kSLQ&oe=6A0C77F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX8Im4MCMYcQ7kNvwGt_isJ&_nc_oc=AdqlOsxFlmApbs4AiElUinKI7Cc0-AJutpKYMgphyfMGVvjhJn4THOa5R-NTPlqt-yY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vbCD1N6IAzye2LLc62-Q9FQFfK1Gphky_COTp8nSZew&oe=6A0C74F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfwMF-uD_MwQ7kNvwEZrGpG&_nc_oc=Adptvv3NbdRdGt5eQKbVK4wrPSpcyJbtiqAldYuk6Prq-XxKV4job0S9_bxPnVl_A8U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jcB3Zzu0nFg-BK52YQBryn2Hdhu2Mr7-wp-RKFoWxfQ&oe=6A0C8332"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbClTdfq9yEQ7kNvwHAm0F8&_nc_oc=AdpKZsugcrhkNzuzKLrpfvLUZI2GHX_Jh2f9QIP4ZpztwsRy47xnCoAuTgHz
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGM1NA4IPDy4nxecWeB0uJdmEBeAlrcVLUEzYg4Iq6cQ&oe=6A5B5EBD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRAX-Owc2mAQ7kNvwG3huNo&_nc_oc=Adpae48AqbAk9T4399fIX-wkytthOGaIyKWE1exB8BufkxcUnm9U4y3-iC3jeydgY9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu0GchMMFIuzGGyTIYq6j4HSLGOvVmrNW-fTrQ3bEM7g&oe=6A5B8A65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGZryEhJj-gQ7kNvwEl1ALt&_nc_oc=AdrEHNKk7rZKzpnRlJheWAHa4rKDKMbDZH56H2jIEDB7cm9jSITHryLygsgMyLko33U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa9iFmCsPs3sfWV0VkjRqDTcuvKQZk-nqqNebw3_Sc9Q&oe=6A5B5E3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7254xmtRK4QQ7kNvwF5Q-bO&_nc_oc=AdpT9DFZ6AKoS7-bBRd5tqYmhN5z9DMn2aMUErqXvxuHsCXfCX3tIENm__SUlsTxHtE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7MonWS-mwdOncSSoyARmGrDjEyZXNXMLYIrwjYKOHjg&oe=6A5B91F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBrsBW8dxUUQ7kNvwE45PZd&_nc_oc=AdqrHcCv8WWi46Luopt0iYDdaRDgUT1o7hg0s66crGVlVkEh2LakoLk9WyAZEa1M-XQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB12Y_L9GS62X_2ylGfKVpwyJjgRN8EfJW-0xMz7m5azQ&oe=6A5B8EF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31xGYBWtP8QQ7kNvwGXKrwU&_nc_oc=AdofOFDFWNs2qmYS0GYnPcIkPhS1-Srv8ED4VgP1FKT8HSswSzmloG8az4kW_zclaVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGmbweLRGR0eAJxjw7ClfOPIRPJtKuShsZ5yxkiRSaGQ&oe=6A5B64F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jehux-erHukQ7kNvwGk3ye2&_nc_oc=AdpbU2_kHpp8MWbnHqOHoeLYTqc1Ki-nEQbLBfRM1jazvR30y5hscTZ-VdgX
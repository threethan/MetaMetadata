px-j9ath-iHulB1eJOTC4JqL7VwCm6A6E6-YTgVx8cY4p9qXIVOC1DXWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYDkcJglEJCxumLUykiQlOTVs7bPvK1SVieuL3o25IPg&oe=69B69ABB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j_KI2v2B9kQ7kNvwGVMKaR&_nc_oc=Adnxv_liIdu2xRf2jl1rkfX2u5GTGieaBDO55RiEbjXRsLG_PtRRmfndc8Cylvc1kp0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSN7RpdNhQYc2-Fc8_pZkhqcM5GdPABxkf0OacF0CgoA&oe=69B69110"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUrLianhLDkQ7kNvwFudmz-&_nc_oc=AdkkaSOY6QGK_ilc2hPON79sC5078VYBAG8DXEK1ozQqTD16ubEDkIU0e9YANdLySao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_1YgbIl1FDjPSEAMCdB8mUzAUraD0CsZfIOb4GLvrsA&oe=69B6AB41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aITXKaDD1MQ7kNvwEsqEZH&_nc_oc=AdnZ7hJqbIl7-w-O0F7tqFi_C0rzJEhK_xkb6F0qbeXJIV9IicIjXopgxNy2G_YdjVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVqAbaVr-jS7j4yrlOrg1_bESDCeoF2yxwt2Caca-5gA&oe=69B69F09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlRW5j_PFH0Q7kNvwFXUH6T&_nc_oc=AdlhyXM5xAnReVAnJx9HI8M1gclK08PF4h96YENB1Bau7OiERzH5tD-rhwiaA6aKZpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDcrWZRuF7b1LCUEOoTaeFonFqOHCYteubwYNa25kreA&oe=69B6AC7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4CY0vJd9JsQ7kNvwF-5fkJ&_nc_oc=AdnMmt2L5R0L9bXDUHDYqpwK48gZcmoUIkT13p5jO4-quPjeAW6gqYPVYIiPEQLl-yg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFHHP4LCCjrhRka6wMF0SOPDcYTR917jcwA49_PKLaZw&oe=69B6AB08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
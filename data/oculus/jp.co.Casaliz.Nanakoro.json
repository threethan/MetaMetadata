iHAkFUQ7kNvwG_krAC&_nc_oc=AdrazSft1Xoe_LRR-ystjhJXm_vsdgeVoCnCSNjNbADb1n0ElTPGeue3SJB72VEFnW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUVEMSuMr3mpKFV-xEci4DLapC80g8gJhuP2rzQhb_lA&oe=6ACA5C7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Mc4WJ8zRBsQ7kNvwFZTAtV&_nc_oc=AdpnIoVLadbuz_wziRgmoOET1r3DX2I7T4a9et2Oh1gU8Ff6J_RhkkvOrLJRsjNe23k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeA8s_OMyQ3ovxO5VEg4y0v4sKA0Aa0Cw0T-ye-v46pA&oe=6ACA52D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2oRw64Ic9cQ7kNvwELGpD5&_nc_oc=AdqRdbaJxeYb5914vw_rJZQw-xbXEDeJt7RWWhLC6qix8nAlHIpR9lu-seYj4dxayT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHAhARPBfBA-Sx0o5HKA0JEjOF0Co9pmWZDkqdFq0-Ug&oe=6ACA6D01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvl5DIOMjtcQ7kNvwF9krBn&_nc_oc=Adpj5geJz1fkAnmumfgJ7Ai-TfpXHApYOLYPb3jY7_rxG_ghJCGvg5PVJ2cXvm2oHHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUZ2mhCZjeTltKSSYSrmnOof-PWo3iZYurflMTMq43DQ&oe=6ACA60C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DynRxSRMG50Q7kNvwHYufml&_nc_oc=AdoNmluQbSfCNq2cc71b8BX948cCJf-dvkT7VdBXbQTLY2E0trz0lmnopY_259bkTxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOClG-OAMssVLqx0VDzxgGAFd1wwoRwcXH4JXhrZyn3wg&oe=6ACA6E3C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZkZId_rp5YQ7kNvwHVPfzX&_nc_oc=AdrYftgZf8ZS1OQMAu7ET_ILmnH-fzE6E1E3dtHTzyNf0u1fmkq9UbHkn16cyY29YxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh4s9-XESHqOp2DBRZo-L2V46uIvLnmkGxLN4lsaRGeQ&oe=6ACA6CC8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A6vx1GTgp30BQsN-grC3j29rPj-LIczd_PzHJ85o7LA&oe=6A19ABFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=navGkHRqshEQ7kNvwExmBk8&_nc_oc=AdoKaC6I_y7G92pyI_zohlde8gLLSRz_ZFhP7d8Tp-f0s0otSgv6NEDQsXBQwJovLYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EsYdqv4-f1e2L15GQS-NlrCl4tsfiIImJwP9HhGm1Jw&oe=6A199F65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6Acfd8KSh8Q7kNvwHq9x-L&_nc_oc=AdotFyg0VYBr52sA6oEP8ILPVo3ytfNELexYgFYk9C9mkEV3OEDgc7RhhPgONnqEV8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DoidqipYbbQo_6QPPLchmCS6uEWOKNWZ2GzYkCgF4cQ&oe=6A19AB7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdtaXHCIk60Q7kNvwEl5tR3&_nc_oc=Adpx5yVgoDCjJG6rL6NJPiFMkYwE6CyvuIV6uqr85P-sBI_Ggj2bsK2xmZ2RUP9fnLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DKP13N3SO50auKemh2DTSe1kfo9h6OaKEE9rmwrzI8A&oe=6A19A6F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmzkuGrANUEQ7kNvwF9rEnr&_nc_oc=AdrRQ8cLkFurW-uUWDox3QDU3x1SpETu8WsaBDapJAdsiXpC9g2WeUZvY878GiGR7zE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lA6ecToL2e8vml-7Twp5bx4mlP1bX0TowY9gKLww4lQ&oe=6A19A3F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRgl2_Vr04wQ7kNvwGSuvti&_nc_oc=Adq0KPznLVYBI4hRhd87FgO0BqpNhCU4TQcHmMmkM466D2Y9eJPLu71dmJaSkaFs2r4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Blh-rzZZhsccsnJ-svgg64Ug77Jd1WJoGBBwea3F0Qw&oe=6A19B232"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMiC-owEOrMQ7kNvwFX9Owi&_nc_oc=AdoGZ0z-KAX_6nK35tmlGAYnRCGxGn-j7PwfdryOYcI-n7kL7xnO7tYufSl3
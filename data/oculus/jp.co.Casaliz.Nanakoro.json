70556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKCb0ONXRsgQ7kNvwH2lCB1&_nc_oc=AdlKSJJDBIGsNHBLg0yb_KzJ47Vul7sSftO686gJmBKpbfWk0O56bHH24t04ym09cAQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwo08LJQOAEgKRFim-jbZc-xByfxvC2iOaIOjKa5UKWAw&oe=69BD5665"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRXAW653spsQ7kNvwGgnr9Q&_nc_oc=AdmMoWfjvdlZYAOFaSiNRsne9P1rAUga_KhwgtbFoangZcnsbyn37fZX771se4TuEdw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGO6CL7MUZmjtEKEdOCz2Zg0Y778lkHPUKjboEvGu1bw&oe=69BD2A3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdq4zqXnrDIQ7kNvwEgCGJb&_nc_oc=AdlmeNz9udNeGN8TcJIulP0JkVE7jYEA4VlJ1lD1UUceDtkIyWZtNJm0v1HxDmWM0oA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyibZ7xFDarLSxLxoT6Q4CmnwXwu_cbmOFpKI3LHByQ3w&oe=69BD5DF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPm12fcsPacQ7kNvwHBvtEI&_nc_oc=AdkpLT5bzMQBkYoGEgzR3zNmnFvRXIJWuKE8gANxlz7sbxDtdDVZ1nePLYizhrPgXRU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFYEOBnIxD8eIM0pNynYZIggwrERMCtNbVdfeoZXsOxQ&oe=69BD5AF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdTiyAtyGDUQ7kNvwFDxbdH&_nc_oc=Adl-K5BGmhz1PMaI_yRlNjk5MgZ02ySv9ZLw2zIVQnVSAQWoZaHMOV8IY1czmFYMhRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRbZfNte6EfGfNiV1GDsheyBMFLBNA3Pe6are9Atw76g&oe=69BD30F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utKdpOQ_ntQQ7kNvwELYW4v&_nc_oc=AdkuMJNRa7g-WKt9EHC91MqVPokn-XhRHOQjlJctvXFb8MvV7IwTT47ozc7X86p7bNU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3FoKB8CiJZ-ePxqKjvWxP8XcT7KjQ7B4Y9bBfK29gvg&oe=69BD2D83"}, {"file_name": "2560_1440.png", "i
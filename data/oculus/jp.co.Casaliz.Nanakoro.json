y-82jcQ7kNvwFz97nD&_nc_oc=Adqiaw6cP4wlXpHd5tUt6o-iTxt71Y9dRiO1VxMM8GE4rX-r__jcIkvX8XqP0aI73IA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GDACxL2WIzv33v-Qqh4eVmfH0C3UEhYZ_wohAYyL3jA&oe=69EDF9BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8q28btznFYQ7kNvwEBRIWk&_nc_oc=AdqhN_pRvZwmOkXv8AfY4IsENhVy3kPcYLJcRCM6OfpkXvEFstnJyj_1fT-_D0rhGLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M3V-YWg1bo-g4dI0dZi0I-LOOEbootwwCQ91SgJVqqA&oe=69EDF010"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b1JEPuVOvkQ7kNvwFEh2NH&_nc_oc=AdqgBYPJBbBDkLb9rTqBsWisLJ46-plUDQlK8izGbIysTFi7K-PVjKepz4Lb0DJuYZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xX5gej7XXwGAVfZrE1NSs3HhkbVzHlUkcmitfU5Re-w&oe=69EE0A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuGI1K3tLTsQ7kNvwFpXWzz&_nc_oc=AdruFzJNgZn8lc0EoVjCiPPtXqe2ZN5jZhRcQ3q9WBqgwisTmDtHwuWh8axVpgpVlOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fr0SM-lC0LI-vuFYnjFkppwKQ2Rvf_qCEgiX8juVHHw&oe=69EDFE09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p49XMj8Fh2QQ7kNvwGHGb4r&_nc_oc=Adr8kl7ezGFR7eCtb7Ayb_VgJXgYNbwJoLqZNXrEtQkYhNxky82cUi_VmBPJLHfGB2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gNU4cIJKSDFDv_-mTepRsp1q2knuOuro-aVx3pAjk2g&oe=69EE0B7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqS8DKbVrX8Q7kNvwGxQkJ1&_nc_oc=AdpCW5N_jBhwLXNsVHFVhvo4BN7SZM9v2jP_nwBA2feCiKfI1apiDtkUpcFjXhoz05I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qGo92L3QZ2n4dcyXX-AtCx3Vs4o1RmpQXHPn5Qfzp8w&oe=69EE0A08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
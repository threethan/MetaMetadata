t-atl3-2.oculuscdn.com&oh=00_AfufXLGewqtLpkxMvwuqbGQx0smchhOvCJE7tiPQcZzbIg&oe=69A5773B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1khL8rlA5toQ7kNvwGs0FCD&_nc_oc=Adkn4Kzbwa2QlFOosmdvXLBfPFBzfDNxHKd1qAdiOk-hBiwd9xXano4MK6T2i--859Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsoqg2RF4o5z3dSaGMQ_n3PGcdvRK4FAiew4S6X0aabBw&oe=69A56D90"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufGVyOu-vKYQ7kNvwGeo3Sx&_nc_oc=AdliUaJj3iBJ7DBk5wJzdUJ-Oqd-DVDdMj33OjZ8ySBw4aVyvIxRw4kScNHeW7kGV9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs11nMVjpH8sb9vmWBQ9Ewyttg4rLBnK98ILE97pkwO_g&oe=69A587C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZPyCJKDNt0Q7kNvwEaLl9K&_nc_oc=AdnuKvAPYw0uSAuH_W3txCrX22O_9fLaMitMUeQW2Cwjsxkv0cbOHNqhZAkEu-wJ0Z8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftkp0AQehtx7YfAc00mS7GwNd8svv2gTeQRsuHqN0sMKQ&oe=69A57B89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJfcq-Hz_ogQ7kNvwEKVZUd&_nc_oc=AdmYfzB9BZFPNSObcO-aHRZWfH15C8BKyXOMjhJqAKFv73LEY-eTiFBlPij9wov7vrI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvBZ5S4RxvDhjovKRe5gWgOcKBofUPtIitgnDtE88eteQ&oe=69A588FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKemQdG8KKQQ7kNvwHsMuL_&_nc_oc=AdlLRImyxobRUCecs-cV_HIWdIrI2jtN6nVilecXNum5mN5pnTK_wXA0_SWktTk1mQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfustoSL4sNBQ2ZkXeQfc3_jvf9vQmhw4GiCS5QWebhuYg&oe=69A58788"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsacpP7Bt4EQ7kNvwEVGcdu&_nc_oc=Adl6k7NYVKgJLnjTctB2S7ZimE3Pdc3zJvER7CoAcwUUPS5Ylo9Z_nm9HXG3O1gSWG4&_nc_zt=3&_nc_ht=sconten
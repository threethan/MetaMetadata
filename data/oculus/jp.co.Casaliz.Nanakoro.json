70556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfsRDtIpAhEQ7kNvwF90Uxt&_nc_oc=AdnxM_l34Ct093aPhIIWiS4myh3s7-e2Yuvn9aoiwYCmDIAjsqM-o_PDU_J_EdZH2kE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmSdKFHKg1BSSZzBJOv2pPfVjR-QJ99g8Q_nPQzHZdJw&oe=69B02765"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au0Mg06RkBUQ7kNvwHFsKCE&_nc_oc=AdkE5D8KmZPlWWMSmtU8N3X3MysaRCjBFExLTeoOu_VhBP6UcKTh5O3MHmeEE8pQXXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZl_u27Y6rlhZkP9D15SZdxJ7B0g2w0-MFcqRIfxr83Q&oe=69AFFB3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcqVEaIO1IYQ7kNvwHxGLxi&_nc_oc=Adn4L4w41ED_tW_f_aCCIiBMXem5xPwHLwXCg-jqxpMr5euDt_T36z2gumHc3wZrs_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPuzjt10ez4OMFTtL-VSx4BsfkIRMqelcJff_4xB0yyw&oe=69AFF6B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AzqR1GN2WAQ7kNvwFVHJIo&_nc_oc=AdlwPt-xcvC0uqFjo8VvC0DzG-rgDVhI9FHjUQEppy9zP9TdzfnYv6i2dl4CzzXf5D4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-DzxTFwwF6YRrXYjc-78YaHGms7hg4BeJcB6g96euHg&oe=69B02BF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX_iQzbQHBAQ7kNvwE4zX8l&_nc_oc=AdmgxkizRcUrjGbf8smajpxObaqFW_yngM8KgME0GfzyNswN7PGdrtPWg1YIGgsuWs0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLFMnTg6W_rjGoUFhfk-lDenteMRnUlF6EtUKMRp4cNQ&oe=69B001F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z73_0x2bVrEQ7kNvwHS6jdQ&_nc_oc=AdlTdS1x5q5HHhAXf0Z-BSiu1eDHc_b0xJ5qdziJDuB5osZiFAqL1eok1AQmDtpEUk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXFtdilLbOIe3tnT3DX4JULcGWXi317LKBK5wE3Wg4GQ&oe=69AFFE83"}, {"file_name": "2560_1440.png", "i
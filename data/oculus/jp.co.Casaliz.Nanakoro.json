_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVkuvsYATrFg1zajjG6MYcXYP_MYJgXAnMsm5L_pvL0Q&oe=6A7DA5BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D7R5zxz-l8Q7kNvwEkkSz9&_nc_oc=Adqm8smB0tttCitPXC5uqTYD3m91c3rpjF9K58I_gg5ZWH0Ym7PWKp_fP9hl4vBDtcE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYPIHWvBREYt_DJDwVkw-hMXSpBPsjCzweKq6f-Q2o3w&oe=6A7D9925"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Znfy6arrjaAQ7kNvwHtX-DR&_nc_oc=AdpQTd3TAb32vU5ny8oOYIBGOhE0-C-fdfgupmobdIqWf3EWbMEuecKmBYFu1VTwrDE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAe_FyYkacOQDLR9t0Mi66TP8TtAnQo9Ei1qcijBv0ag&oe=6A7DA53B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTRGILCYHiYQ7kNvwHDEkvm&_nc_oc=AdpZUkHb5A6U8Z-aJoFIpT9amwxHLV0a3RxuIl_C6yncolpSSl0SC-jIquocYls12hA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3zCc2ZmmExjskGgtf4eQFAsZHL7WTXcbuPr00Awlf6g&oe=6A7DA0B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MK4Rp-uCMtMQ7kNvwEXD2ST&_nc_oc=AdqKvtLL_taXO0CSkD5096Xl73C68NVtFbK_fSEoJqNxfiVhYOgMk1qvz-aQ8AEgoYk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH-Q9-88HT135DGPD-q_zJmkBqth1Z6uLzqofyQjJDNw&oe=6A7D9DB4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I6siZD1lx0Q7kNvwGdYDC8&_nc_oc=AdrPx50dMhBWrUl0gT-7iR1qCpN40IS4yCKV7FoL3kU8WcV0KsXm588rdFYXXOI1l_8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoakirKxmrUdUxps2N7RJnez4denqERIP_prNgKEXjug&oe=6A7DABF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcaGgOKHp8YQ7kNvwHjztjD&_nc_oc=Adof0cSS3aH9e_mXTb5VemcUQ3B4YRl1gIn1gFYsoz
_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NaF7PQeApF10y3WZPt3PAi_bhcoGWz6nZyGnpLcH3Bw&oe=6A36ACFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hnRvDeCPMUQ7kNvwG0vOuo&_nc_oc=AdpRYirrUt3XY9iO1gvIknfg_vmyLfPssiL4-s3iH7jtY9ngVPmepxmE7GdybWzk1hs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fwVh8xWjda77md1_Xe80h6By228mp7r5ZDDxD5_8A5w&oe=6A36A065"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpatQIYxBIEQ7kNvwGCWg81&_nc_oc=AdpNzNIFJfrjVvL-d0ehbrIxteuzE_oQEQuZC5GJgXuDw7Qqgt6s89HhgbEP7GkJ8JA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bsCG0zv7rX8QmIkBxJenXGsWUX85EcBOp8_w64U1dEQ&oe=6A36AC7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjAuTj9Td9QQ7kNvwGYLR-j&_nc_oc=Ado_xXy7O-45krIaAYiULEjrNYqALNN76wc1Ggun_0afoT7m5nsHj-F38tkU336V85s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kSI8VyHtthCGdfromLa1XUZnaf5_V_mnX29uOIm408Q&oe=6A36A7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqMU15xYU0QQ7kNvwF-VTeh&_nc_oc=AdrKjOURrNeINkK2bFMUhURrb5z_6U2b7ityCCSJqmSaf_XWPcukDb-WcR6jDIcnRr4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80T-0Zuf6okjkfAILddnttBI4t-Aowz1ZQ0l5wLyTlQA&oe=6A36A4F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqcLu8VrL8QQ7kNvwGDNOrV&_nc_oc=Adqlq7SSq6VMEi6ptRRd_ct78YQNITkf_rw7mA2VQKFje7TSXbMIa7HIkDGNoutPx5A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c_j1-LVGfDZzf34Gg09WQ_mUNiPh6k_C5by8hdTHhGw&oe=6A36B332"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OYh3xqVcF0Q7kNvwGyaQ2V&_nc_oc=AdpamoFUF7zKkEJnaWILWrYSrB7rdOW5w_7tKFYdLc
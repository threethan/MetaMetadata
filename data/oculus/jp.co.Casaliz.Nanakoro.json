1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iFb20fCfwwvKtS1vNaUuQK0zEwuXdeCcYB3PtSkzJEg&oe=6A185A7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=navGkHRqshEQ7kNvwHon6Pd&_nc_oc=AdoNtBWkUOto1i5UDeXcgCj-p4wUtJot9QnuyUjfhhoij1kjjn8OKLWnEQETzD7NRFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ofS_zA1L9ipAKYSKSgyHiKnWQ5ZM-wBYHmknZPmZz2A&oe=6A184DE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6Acfd8KSh8Q7kNvwFWjuvU&_nc_oc=AdpLuIiZdL_ZCkQuR3VRUVuhRabGx7DYLlzvXnf8ROUh-8pY7u3Vg3EvE6pQG9CU3GQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aUe03uMonSYyqUcqd30VPW42n8BbTgLucfxKblQdFCQ&oe=6A1859FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D3J7YvkPscQ7kNvwGlM9t-&_nc_oc=AdpmZWR7w05NdBlu5Y6tC49l-jxGPBDaEccmQUTw4AD8BqozHb5oLspLzJKt1AM6v6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d5SNHMI4bxx8_yNL3TNCUn7yPM67aiKSfeTbxHNiH6w&oe=6A185571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z453xr9OioQ7kNvwHSGjaR&_nc_oc=AdrKfqWHLHJ0bz3U7e_N_b2CL9ePPaoEMO8fQa4VP2dPP7FYyLuS9dScJNCbn3LiQL8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42bJv4b5BqbYARQ8zByaUGr8GHcbw_m6cAR4NbBazn_A&oe=6A185274"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRgl2_Vr04wQ7kNvwHml5Zy&_nc_oc=AdpVL3m0ePP2wK928HiJTQBC-KL031CE8kXMmzqq4cDw_3aQqr4ZPa4a2XxxjliReV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Au4uVtv8X5xLHTDCUW-VoEjP5TN7U-INNEarxqS8B_w&oe=6A1860B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMiC-owEOrMQ7kNvwFQwxsA&_nc_oc=AdpvSlADKPEhR7fhItVCUWNFdIzO0ZAcd2NdAFJS9BMHKY21Op8NZ1MfnJUh
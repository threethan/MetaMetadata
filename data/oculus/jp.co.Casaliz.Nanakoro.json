0x7aAQQ7kNvwFYhhhU&_nc_oc=AdrINtUB22-swF04XA5k_JDeJMvcx1CBxdvrgcXK-8wxEE-9XSGsraiOEqFv3drAQQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqrRtRsLjZlm0w2QHEcEadQNGT9miH9WIcahj9vpTwSA&oe=69CA613B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdbqUjVFuPYQ7kNvwHmhIvw&_nc_oc=Adq7WYwpV5P2oa_CmKUgKeKTCdJcZb_C-gL-Mb0DJTqko0ULFyO-_Vz2XBOWenWnXfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIk9r-Hvu91LLqQp6U6o9EVpaezx1682iNRbNcr0Uxtg&oe=69CA5790"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16VwdoLdrvMQ7kNvwGXH8st&_nc_oc=Adpl4k06AudaFxaEFmVslR_WVkNfSDhaXHPm3rHpmsrZx3wvHvrNf_Utkt261COUQY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzD42t_2VMi-q0BcFDNC-1Ed0OUxrQq8fTERDFHxqB33g&oe=69CA71C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp0stz5O5TMQ7kNvwGF_DuE&_nc_oc=AdpwNirpqmi7RcUVxshUzPnha-PpAhuYeOSD7LFvhgWtoiw-RR3cUCmenw4ozfLV-Rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz64rg1u81PBegNHiIYN2n6r_M5gtykoSBZT-agJtzORw&oe=69CA6589"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyMwNZ_XbIgQ7kNvwHRUmIX&_nc_oc=AdqIvz4h3r0YGiMkE_l5VEiBeDUFkOCsV7uh-eSD5kE2-XHgqe-zIMTvNjPlSXmlTAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0ID1Mz9dZpOboicIax1YJczCRzqGsbix6BUOXpsSpcw&oe=69CA72FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--JE3Wd9c-cQ7kNvwHLdqH4&_nc_oc=AdrIPsHXJ5MIkr0nWyuv_vucyx4XQJ-rVaMXTebs0sepnekYj4txH3HjDzS7COsNT74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVGg6jZcy7ksUZpG1psjtHrtYeDS9hTl1ZAjd-FxvbPw&oe=69CA7188"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
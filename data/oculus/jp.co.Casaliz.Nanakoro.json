2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WrpMZJ-N59J4ro92qyvgsuTv1dQ59XleF_Jhip8iMtg&oe=69DF71BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfA4CILAKUQQ7kNvwGhtKZX&_nc_oc=AdolaO91O_SpFhGVZ2MVERcdeYXW2EmIKnBQsBMGRMdRN1n5oDoNfEb4cZlXXZF8iRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IDFLNzQdYl1HE0LWS7YLtZBfD37Y6sUSvVTnLahVh8Q&oe=69DF9D65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtbEEkMy2koQ7kNvwG9ICRo&_nc_oc=AdotyNYS3PzxZLpEVFD2wKVdbiaOWqZncIBkozfIQY9HquWBdpqBZjJiAGneUDsaUF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RsJYk1nxXYj0DPKum9vadyToCK5xnDmcLtMC455RuyQ&oe=69DF713B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb38AC9frKUQ7kNvwE1aaVw&_nc_oc=AdqbA57mImludUe4_Y-RdM5tII6boHZmQhKqFKuhwlq8XRI6eJepKIcUFrr0J7Xf0nE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KHxxyW73ZCZ8Zsg-qtFL6hZKsLtWL8Twl3r_uUE7N5Q&oe=69DF6CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoMWRF4EpMUQ7kNvwFZh6Fr&_nc_oc=Adq0R_qId4mpu0eawLRfCq1B5gDkVaPKOsxo-AJ3wpPXmgdbTkvpyLj5mLqN0weG_sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t5gJXVToch7zv9OthbbgrkVEi_i-eWv95zKRW38bRNA&oe=69DFA1F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-HFpOrD2AcQ7kNvwGetRKN&_nc_oc=AdrNqSzBJVsf3TaruNL8yo7R0XqxhYHi0s5cVQ8eM4bGmedN9bBOhkOv1NQrnYm1v78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BCzqsQlXdZNgN72H0xvZOfBAUuS0zcEfl4JB-tnog3w&oe=69DF77F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whpsg5bEIyoQ7kNvwEZrosa&_nc_oc=AdrPMdldACjSi91zYtfjEPOin7GIVjBbkTmidm6eaMb9o5vNFD9kS8hN5Fx4
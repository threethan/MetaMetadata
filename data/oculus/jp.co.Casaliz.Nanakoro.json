C3d5jQQ7kNvwHkhafW&_nc_oc=Adrp5snbAtipeKAIxrPDLxESWMmLnFk7dAgmL4RXv49mX9vwlUw8HX6icS1flmI8HCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K6ihfPFolQm8n5Z2Yt5PXzGpBWKmbEtLoPtwEt5mCFQ&oe=69FA0F7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MPaNV6iHvoQ7kNvwHPCVvG&_nc_oc=AdqW3YyRrXM8ezs2gPoDSfEdCLnPyhmxNbqw4m3sbKVSJ7ZRwsTZVmxep6E80u0wrsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44_XptWLqq-ZA8Io3dEPYh0gecY_cElGKELaq5VWs7qg&oe=69FA05D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA01HN564IwQ7kNvwEPIl0F&_nc_oc=AdpCM7ysCO7SlnplF6LYTWH-5itFyqsK0ganrzueFqH6DSZb2okdGx9iyeHEm-ZbMD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fza1ulR36UN8-VamHOblcG8BxAiIq7PmwMXJVL_E1Ow&oe=69F9E7C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqpeD_Dea-oQ7kNvwGHEQBI&_nc_oc=AdoiASufBw3kGGrxhPHppm34ABarKICu7Sl5QcQlxQlI42NOoL4BEIv9OaEVWilv57s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SR7StV-BE-mWeb79_V7PZ6GAIzPYLp3RGrsaBHH6bIQ&oe=69F9DB89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGWU9DIhUoQQ7kNvwE9Fnb1&_nc_oc=Adq4t6uXFgCvRGM5riSeY9j_AmiPFIRp4FVugc92Ma2vzHU8de4Whc8Z1FRazAJ3SwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_X9vgYBmdJrxlDiok1wrKztcnYwAFQL8TQAEM5eJJYw&oe=69F9E8FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-evSxDdujjMQ7kNvwG1Ujnu&_nc_oc=Adr96nvtS4mYq11fgzQkFsaOJrxhrYBGo2hcFeNkPcUTtFr3AVCaLSXVZMbRvd5mYy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tfM5uiYxrCZ0TmgMKSq-ahDBJGU4eraswPgNluPWnLw&oe=69F9E788"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
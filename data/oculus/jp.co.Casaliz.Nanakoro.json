pz53eUQ7kNvwFGAFDK&_nc_oc=AdrogcmZ7PGI8ck0KN7oWdieFK2W9xiFfZc2VkuZVf8MhewysHRvLdsji97Q-3571A8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeWzlr8wed08CYs4bRFsNVDik6UnFKLH4cAh0zo2B-fw&oe=6A69E6BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RFceUf6XtIQ7kNvwEVRNIr&_nc_oc=Adrq4y_fIVOtHfjKR_ilgIx9TrwM4CVWvUA8_Tjmefb5Wkc5WxcxTSZ8XC96T-ewSXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAByMG3uPj7_W8TTk9E8NR0JHszRIzkr6Lwg0BcHBEhSw&oe=6A6A1550"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbpvcLH5o58Q7kNvwGrvIpy&_nc_oc=AdrPEMD89WHKI3jYCqa_2SzF1EJ3B4gTLXgErPyxGaYrzc2uEEK7GjiEPAdX_hWfcm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgiFJ_vxDiHsGrALWvEmUA5qB8al4Qe8l3I5B7B5BKUw&oe=6A69F741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jORDJL5gzF0Q7kNvwESBHw9&_nc_oc=AdoxWdnW4GGkRMYAK8XSyE0wBGM7Lg4BXrO6qJ30E7q_rQjq2nG_iD0C1qHhPsNDIR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGiMyu_nVr4hyakWituJvXNqVa1DXvqin29MoG8FpTSA&oe=6A69EB09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7YKPd4C5W8Q7kNvwEP5pMz&_nc_oc=Adr2lz0ocBdhL29im20ZueZudHXYog-gTmD8xpdN6UJEkh1u9k2gOYI2wgkev0IyiPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzo1Iu-xSVVHyErlL5hpVvelQaq6ekOcL2y61k8m-0Kw&oe=6A69F87C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o07W6Bw6ebAQ7kNvwH7T8Kx&_nc_oc=AdoMSEZ-mkCYED1F9_1XQV8-vF3i1ab8Bx4qcfi2IBxDX1kfTljixVlYc2deFqhIhZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE0YNCRLvF_iT1yEFj4NpINi0CjVCcaGNvReRMtcYynA&oe=6A69F708"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
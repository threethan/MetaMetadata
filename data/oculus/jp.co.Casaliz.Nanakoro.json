W1UjNVZC2b_gctQQU-6F8xE0v8ow6GX-Iahj8H3qJd1XOhZlHFW7VoSjg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxm8daoxkwZRBGyLWplNQeT5mNQzncGFvizbyzPsY4oWg&oe=69BD323B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI86SuUXJUkQ7kNvwHg1MJA&_nc_oc=Adnq_WcdcJimNa8t9xYIkDBndlqxPNJj8SfH__MlpmgQ2Ct8pS-uWF546Z7w_1yRoZQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1CsjV66IrUV5hZydphi5vzcCQbKID0c200US1PpDE0Q&oe=69BD2890"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O5sTG1tyZ4Q7kNvwFRl33Y&_nc_oc=AdnOfTMJO0HRyOGPUDH0L0u4CI-zI1tJX3vevtVrZbil_e4Pg4prxW0CytTKnTf_Qh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5EIO6NREpGkBjg4ZSUYJz05sJtDwL4_xl3aiehijLWA&oe=69BD42C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zKuWZBhjR8Q7kNvwGz21lT&_nc_oc=Adnr5-XRRbCTpSmA4qYqrMKG6U6vCus-ctMjxfWsO97ALU8ui6T7YvbQ2RPErszZ0XM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwwX48AZQbc_FM6v74cCWvY-JiTBxZoBl07t8DJy93dg&oe=69BD3689"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcNIEcTtIkEQ7kNvwESDY2I&_nc_oc=Adl9u5ekzbOidGqwcwedSMOmnGDIfgMbbfCSVV1-_NCsdFkFSJE2kWqFngztkHd2PXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcvJhGIyK5vPybou2uzp6bHj2Wu7nfiMSaHPb2efIT-A&oe=69BD43FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TgRdj35j0UQ7kNvwEN6llh&_nc_oc=AdkGXDYkajd8PGn2p6qIuCAzPbQElqNyvY92HNPlW7Zr4iGb-wsz74VpdDWRI5B5qRY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4CLDVit99QhjEnitgJud9M5EHtwsHhuF9imp6L5RdXg&oe=69BD4288"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
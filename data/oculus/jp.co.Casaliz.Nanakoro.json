1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXF78UbO962LKzsLyFDCdPuoL_g_DX39l3K8bcYzrYnw&oe=6A75F4FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wku43a8pAq4Q7kNvwGZ9SWt&_nc_oc=AdpIoNYlML761rWEP6LxawhE4s6zScmncXvmdwd2TA0tRfz4e50C67oY4-ATM3SbOIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLEKJAE7XgDmdaypwl0tSrZ4Xc7vSsXgR3Vbz-uUmKxQ&oe=6A75E865"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhLZc-r5p2UQ7kNvwGueYSk&_nc_oc=AdrqbG56buwhAMbPuCv0jeIs769xnZ6gykqanim1Sc-Ta5b5HJsP303RcMM1mzXZj6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJcD4jyOuF-oXyhfuV-6rcFFWDGUlgp7X2VzQ49x-btQ&oe=6A75F47B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyF6Y85n5eQQ7kNvwH9NN2E&_nc_oc=Ado8dYe_pwgJ1Q6MwGtl3x6Nhz4MfbC6QiLcVAuevS_SuEdulw1Vuudr1OIsXB3WUNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa2wvUcCQj4XMCrv_ywCpPsRxNuMxx6WckkfPc2V3TeQ&oe=6A75EFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnnR00HuGfQQ7kNvwGngSX5&_nc_oc=Adq90yDUeoo2WDwXj-58Lkcu3BjI02WiDVkEwtugkzOjdlQe3cxP6xYHLtavXIkRR_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9cKvr_ssQkMDudgqyL5iBVIjnnKFUCxPDGj-Eg0hyZw&oe=6A75ECF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXJdcJziJ-MQ7kNvwHZUIfW&_nc_oc=AdpxQOMFUHbWJmpL9baOTU9xKUA8Uvh-n7ECycPrHkcdKWauGoVcjCOibKlKyUMmqUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMm-v-Tnhl0J_FKcDrQNIeuKdMsvFyy8zB5YT2JzIQiw&oe=6A75C2F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZiqV63oOYUQ7kNvwEP97qQ&_nc_oc=AdqFWpLjjyVj0CzNGyKTk43VnFBtHuXg5fXwm-qXEoXKxApH3cnLT6lx3vtw
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeJEqsc_TF_tx0ESVkmQlzx7VpE0VGSocHOK1816-ShA&oe=6A5E39FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRAX-Owc2mAQ7kNvwFy4mJ1&_nc_oc=AdqE6wUn9_CWBl3LfvSxuunu5ISm7CBeTemsxWaRAlmiBpc-1dgJqY7tdevjD3xUVjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-2vd_OrVTXrctcH-8_oBw4rjfqBZWYvsUxXPa3whP5g&oe=6A5E2D65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGZryEhJj-gQ7kNvwHn3972&_nc_oc=AdoSkcEaSHjnkUuXXeyXMAmFCMEaNSPENiRYclSPooqFGu97brlqqfuccC180SgMo0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz8Vw7o_4XW-61lMwpQ6_G-ObyXdM_je98qQRuo7QPBw&oe=6A5E397B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xfX4N3M29oQ7kNvwGZyQjM&_nc_oc=Adqi8xPtXW7B-Klh_JyNLHzMsgm4HwTWNJb4K3mxUCLRpgFA4DjfJTYwylb6CENSu8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgxbjzNj8tmL1chEQyT4DEljsTfUjnZKrI13CJaILiTg&oe=6A5E34F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiquSBI8ta4Q7kNvwHJ7KPH&_nc_oc=Adr4g2qYiQabVQUQDNMe_eHSs_bV0RuqjiJJr4dz_fkSM7xDkmMOmoP87qE5TFv4VoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1lSccjdhrvf9QJEPDHpjIvisA7lyaqjhG5TJQMiylhg&oe=6A5E31F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD4gWETwOdoQ7kNvwEw3mq6&_nc_oc=AdokdAHcYbEgkYfGCj5_S7w6tNF12Mlm7nQgtd8NMx5NnBrM_O_s9nnYCI_66umES1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJohHYhwu5UlXIUAtvInZf-bF7cmd4kXcsu-LMCXYTig&oe=6A5E07F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jehux-erHukQ7kNvwFyNsD_&_nc_oc=Adqt8ZAy1nS7ccYFjwql1sDnRscyAzb4hsbBvHcEkVd-gfU_0l8Zsg0HUUS9
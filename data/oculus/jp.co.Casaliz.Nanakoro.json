p6JlaKLhxYQ7kNvwGAGJtY&_nc_oc=Adqg63Oh83Qu7qrOtYJKNBiTlUKEwbn1Z6IKlMLgPsHHUIZvUIwPFLG5Zf80r8P6EoE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b8Y1fK5xQZQ5GiWKfTdlR5P9Lrv8CiUidf74nt7RI5g&oe=6A36B47B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVcf2_syML8Q7kNvwGx7rvE&_nc_oc=AdoghIe7NY5jFSID4lsw432JqLAqv7FSJMMydlcy23rA2lkTC_-DUT5bfLB63NpjxJE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gnIrJ_90c9wVTLirpbmhUf7dOK5436FTGJ5hDcLFyow&oe=6A36AAD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSvKPbQIXygQ7kNvwEe3OkM&_nc_oc=AdorQ3Pr-dK1SaB4KzLHfJ11MMy0kJK3yR3Fpb_R6BE4PJWKgcWECPOHOVsvghrGMm0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qlx1dKgvLaZu8vFzLz7J11cGUKWGRjx0V_qNVvx34BQ&oe=6A36C501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Yu1WAu6yQMQ7kNvwFATQc9&_nc_oc=AdoDt_0pU0AwnApq_IDhXmViFKhBb_2oG2GXTymVPWlOhmJ-_w9KDk9lcmqfrBpP8uc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mEtXcMceSekm2BIgo-j_8wgF_eDkBAIfNoxvB0zjovA&oe=6A36B8C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhGOKJrUjA4Q7kNvwGfmjds&_nc_oc=AdrM-iK0NxvSXDuaDDRm9n_2WV5KDlXFz8qDYZP5qlFQGtcOnuS7RQHigfGqRUl7tQ0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Eqql7ODuRZdqIrAWe4n494mA1oJJO3D-AJl_BAarcg&oe=6A368DFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzd3J23bWbAQ7kNvwFBY-jp&_nc_oc=AdpVmplUgznVeHG7LYj2HKetIQ54XyQBwIL6U37ubztBlqHEVJ5mkhiJ1HcJiuehRgI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Od-i-yZhHMLMVbB87zR9eHm0KpWM82b940nETCVGWUw&oe=6A36C4C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974714_10204990
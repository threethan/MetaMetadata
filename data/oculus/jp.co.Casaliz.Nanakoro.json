eYx47cQ7kNvwFKoVJV&_nc_oc=AdpifLKl31a8vEKAC5qEkunMcV7iVwGq2TbnnwHfEskUYINpkB0rHQS7CUlsoM0iuw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22GDuar4XtCoSMh9Pu0HhK73VEyufwVqOjsHV_twC75g&oe=69F76C7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZoPI9YfAUMQ7kNvwGT0zUJ&_nc_oc=AdpN_PUwHbFYmiwOQmMNZxoEC1MF2xjDNaCuX_jvlBRejCBip3GbsTIE0eNkzq85gVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27aYNytTjc_qtympM_zf2SGAG87Qi6e-unNXC5BRkA7Q&oe=69F762D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci1iFVS4594Q7kNvwGsBVuz&_nc_oc=Adod3X4cIV6pm7b-_LfGGNpq7SsJXS9tfhZ0kiIcKU3w2JbNOFf3CbNCRdJUfER-Ps0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af194I1lwema1dtBkUWEgMzmbZeE2JDdQGYZuJltuwrMyQ&oe=69F744C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNZ687vt-sAQ7kNvwEQ6DhS&_nc_oc=AdoC_azZmdN0bbQVs26uNWDEkvoDIIgTh4sxxKFdI9QGhX9amVkwuNY7yKjuMf9uidE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1doiXopI6l8-8IDE9y_CqmxMMZPovH8B5EFzhPo39QAQ&oe=69F73889"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiHFlljmHKsQ7kNvwHFzImZ&_nc_oc=AdoO3SKqiGe1UpnTghmDpVpLB5eQQrk0v2B0f8hzkxHZ2HQjzsFHGqqmGcXeEwIqGSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Iy4af_wQqPBQ8qenkibGX_xI0iY0j4pw52-XVIZ4XWA&oe=69F745FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkEDtulm4IAQ7kNvwHdhGgm&_nc_oc=Adr1yaohQNuTNAeJEhj16uvLy-tvjhi3jweV7yrQ1uMHbO7f4L77CYWh2w_5CRDKsWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2d8MqJlT4-5vAGWsvqFQpE7DXdHUkuZ_eet2E5CWNh0g&oe=69F74488"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
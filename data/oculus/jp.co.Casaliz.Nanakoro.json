1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vC6bDLsFHWdWe70wGboEr_aXO99tkiJmGHWJ_9pofeg&oe=6A08887D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-ZGVPpW1DwQ7kNvwH9VAFa&_nc_oc=Ado9uduAtMm9x0zG2eLvgQ76xsuadgglYHhuyU1fHscnieF0EI4IYw30rDCrtri8GqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fDuHo_OocgACQNpV3d_q1MkfrIoH5gBSwxuY92DLHVw&oe=6A087BE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC51SSveQ9UQ7kNvwFl_miC&_nc_oc=Adp3mxt_Zi-52WcEMrAqYqwLEov_4PAFsPc6OdLrvkQPWBE3uhCmmgYde6D1II4ZOAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UeeYHzQWg9yo7YAgLU6L48TVh5zPWBZJG4WckV8gifA&oe=6A0887FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnmeVouO-OkQ7kNvwE3OMmi&_nc_oc=AdpxKuO1BmAruBWuiSAUihWzfX-7MLj9sN8MAW_mhNKo-4SDYy9FikuNKXgZsiJ_GwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ySm7WK0oeNcZ5zmfDv2dvub80F1Z-m34EprVVWzAWfg&oe=6A088371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlcNYf0ufgMQ7kNvwHCX-lo&_nc_oc=AdpknFqI9DycFp3K-brWx9P_5JtH2iGV1eSLbg1kb4FirdFzfzjOsVPgFDSK98A5Syk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GhuYkgLNlSaVh2kOnfhy6qufFYvKhMyfXDpjBIqUhWQ&oe=6A088074"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOn_Dl9OUAEQ7kNvwGv7ihl&_nc_oc=AdoEhglqXiwMqv7J53lVtCP1CnGvfC8b9UArF4Sf9DTaUmriRrILh7HvxQiaNimYRww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V_gmSiT1zKSKIeXXJYXdJkKbXvlqyJjYslrwL5YUM5g&oe=6A088EB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYkdOGCgeVQQ7kNvwH1Pame&_nc_oc=Adpj2TC9Rr8yEywdjgOD_VoHBEIfceouPSBdYskddgk6WS6PfifZsD5l82G8
3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_-lOhrO_DULUOChwZ69k26kWADqV_fv12dYxNSkbGag&oe=6A4E67FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT96aCLukRkQ7kNvwG3J8tD&_nc_oc=Adqarm-zex6qNxK9Mhx6S5QmwwJxnerM999iHOQbCtZwsVxxyRWijs9E8DHfqh_0Tzw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqRgrtJAXjWYf7w8ItPbaEIyb9_sn-J-9ygC_PovtsoQ&oe=6A4E5B65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbxS6u2ud7wQ7kNvwGmksE0&_nc_oc=AdoiYLXKItZDTynr7c8ddZDgkJNeTbKAIsUWEO2fhd9WWmu61gQnUNn6pFFaWUMhCCc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsFt3a851OzswM9EakOnXW4uo5oYfZ8Hsm1kCAVUr9YQ&oe=6A4E677B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuvyRGYR6VAQ7kNvwFNgCx4&_nc_oc=AdoCGOzFRQkk8u7Wwoc-LuSMTYhCqA4Y3Dsg3ho1DKPnBWyw8MSBVPXruUymGPlGrLE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGNw6JHExzQ660KamAbfx54lLA0Umcna4WPZG20X_IlA&oe=6A4E62F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oHLik7HGV8Q7kNvwG04TpB&_nc_oc=AdpgH6Eidab4lN406PlQjEdok06hKQqnQYZOz7PjS5gCJGrI-xvd-VuSgs5Tw3K4TcU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4NivIZbfhaR3julvdtpqRC5dVvyM3u_BsM09T14oIJg&oe=6A4E5FF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osfZnWAc3BoQ7kNvwG2ctCT&_nc_oc=AdqZiZwCryNKzVIFfkNXD6yXpKjVMvsHTZzrcBC9xFNhLjTc-8R7ghqM6zM5EYWbhDM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC2Sjivh7m4FyMFlWERn7JXwi7umf2242xUT0lO-H9Bw&oe=6A4E6E32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KXSTGZge3gQ7kNvwFCZ_X9&_nc_oc=Adq2PdxyCofFIH1TrIvx8BPP6NAI-VfkwY_lGAQCURFsxDyguGKl8u-kvQwf
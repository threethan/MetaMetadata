1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EPUszL1uJd1Dx5ic5Cu8ZFXEva47Xfcgo42ujevdpPA&oe=6A282C7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAelkpHQKegQ7kNvwGJwUpW&_nc_oc=AdrnOyaqX1prVzty8aN_Dobi7vbOOiHvHgIcZis-HAJE7H96grHC1VHaNHtng6juk-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GJWtAhJTeLiWpXDeknMA7qGaU19ta11HwashUG06KpQ&oe=6A281FE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqdb27omJJQQ7kNvwHiB6xH&_nc_oc=AdoVcbe1bH-lirngqWX_ZOZ0ITcxk56XubySetyZRaxSqbbjCRasnFH0h18HmbwgX3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i97u55CMKUnzk8SxYtZ7VfuQvgrBCBfRlLw3wwk8z2Q&oe=6A282BFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKCVnXKiFwcQ7kNvwFkvmmB&_nc_oc=Adp2BScUYIYkPZTDkkpChchoNg4zsN8_gMKPfQSFGfAC7vB9h10CWichv_1RsDlYoao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wuIv2XQRrkRZ5Oh6dhxUpKmhP0z904lhJgd1Vg14c1g&oe=6A282771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTUFm5DRrPIQ7kNvwGvVxmF&_nc_oc=Adqmj8i8uZK3poQwoTM2BWwLXgDXzJva3-K7vxYya010xs5TRar6gmTAkSDN6TzMU3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I3C1YTk4lVFJMsECeXbfYK80n0pCFqvDBUhc3XJi7Cw&oe=6A282474"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz-YWWZqUY8Q7kNvwFfl_P7&_nc_oc=Adp9ks_hU58rxXhX3oFMM_liVaTs0PTqA1S81uCvFGYKIF0_cIh4_ETs4RIFRib70T0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80lv2HX8R8bcDWDuRXJ6bHxetOdjHDkzT-UUgUKAzLZQ&oe=6A2832B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfYPFwdT0cQQ7kNvwGn1G6x&_nc_oc=AdrmLtXTmbd2t_jEBSLpgVH9bmbAN0lkh2XkLTSbHbfoVV9EX8XPQQVfZGcu
pMGztsQ7kNvwFDVpSv&_nc_oc=AdrPPyC_X22d8yB5W6Ok0Oczx9Zaf231CKolwwwJTG7PQAFRWjmdie4X3EtrdSzhs_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7_BsuYhaChvePX6wNbwNzCeXGcWxYJwGXi5m1T-Vbuw&oe=6ADCD17B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKq21z9TmrYQ7kNvwHn51Ey&_nc_oc=AdpX6SMbvJx_eapZmt8i8wnoTWp-My2S04E9e7YCDJ2VJkTBcwBnZvDlv6EWARUKbfI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ38bVnbur2siTrLrdgTXvJM4Z1XpilMDaHKMXC-xY5w&oe=6ADCC7D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR4lnh1WtC8Q7kNvwEh9_Dl&_nc_oc=AdquqtX6-WZI8Ra2ePoM0unECMpjsygDfcmOBJ5_bOmTyR0Yzj3q_IAP1qUJCxLlgEk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB_Ih_YhyHK4e0bc-gf2sD_agUnKsyC0EuLVF2Tl47Mg&oe=6ADCA9C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo7QrQUgZVMQ7kNvwEYwVWz&_nc_oc=AdpZG3jMulvmGRV1gFWdtLZhQHUWal_u9NZxIN2tb1NPFq8Fa3dLiuaHjCzytDwGbxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVXRni8SM1D_k3V91pz3UevMdkp5g_TOUX6ROY1oDaqA&oe=6ADCD5C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z4bc9GhEW8Q7kNvwFrF9s_&_nc_oc=AdosKdv5W5g4jpZF1Qhh3xEUHi9Ri1qIR3CCmESP1eGxxIFJms_Ut0pANsz3qtR1PUM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs0dkamTKy7ifA3C0AlEKx_EySR2pgkGawpaG65b9htw&oe=6ADCAAFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDbBtTgerogQ7kNvwH32yce&_nc_oc=AdpExHJRsJ6GNs0LK5h0c-C9HC8iODHcNOxn5tIVMba0oVMP4YW18jffSo1RraYr9K4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrh6fb9OXKsx31iQEiP-0hJlp6i6A5V38R8tfSKLYm5A&oe=6ADCA988"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
t-ord5-2.oculuscdn.com&oh=00_AfvWZ59Z8gw3YVkzxVITTPqwIKaoDO5rtr7Dzss2i8KYkw&oe=699AEB3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjmFNMzY8DYQ7kNvwGWhUov&_nc_oc=Adl643zGVGajuWR4ZwAlbAmAODaGjbWqWVvdGT0Lmrh8aDnCB1ZOcgaO5O9ss1wLAUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBt2_99l20AwOyK7xMVDZLawPFVdGNNbQrFpUGCkEbtQ&oe=699AE190"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-aSv1UdcDoQ7kNvwHsT_Jh&_nc_oc=AdlOxvSuzGhJd7tWir-Xszj72lvhwcTUFI27HYYuMlqsFwJgPtziJKpXFUIZvSeg_Gg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuXqBy8Is_S-CAFf5E8VBceJPMuDgbcB7f0p2JWEtBQQA&oe=699AFBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLZiMntBCrEQ7kNvwEF13wv&_nc_oc=Adk5isKnWlCdteHWx1Gh2blTnNvj54-AyPyklQCGFO5wVWncCIuTKM1MesrwX_OFrJs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2JZnJREwh9KpndDjfCeoCHasHzsO1BVzYxS75-iaphw&oe=699AEF89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ee8n4DXB0MQ7kNvwG7L6Ut&_nc_oc=Adm56q8R6_AY0_Bp2otFY3m1dVwTiXVCrqhxYrNCMaf7E7ymD2vQfNfzspomegWVl4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKX-bJZUflMCFxF5UHapcFsZ7XaEIWU5seo7bKaITpUQ&oe=699AFCFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3gynFIO-3wQ7kNvwF9eHMe&_nc_oc=AdlhPI9S1XlHCh6WrWUQULb2C-Quvs6mB2msBKgwoT0KXCyD0pP9Op0UscDnapd6APU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfurW8-utBaky0TvpH_ujSQZN3PALdlAL4UInahhUvkohg&oe=699AFB88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-R7-Vic4v8Q7kNvwGN8Ct1&_nc_oc=Adk2lQkoxmDo_Zp6o9aGr044DKK8hIy0OiO4iLbyPl905Bk9-62pxPZeLDVYuh8M7BM&_nc_zt=3&_nc_ht=sconten
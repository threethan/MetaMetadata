1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0CcsmIhJSGgK73eJBXVLTtQ1uoPPR4drWYbus-mnkCA&oe=6AB53CFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYErgxWvt5IQ7kNvwF0SpUg&_nc_oc=AdpQNWrM2c0kBMQ-rB8vRozdshy2KkbmoS64QchnZlmYBekR_ON_ZDDtdsaQD1rbo8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4gJOoOA0pSqOLs3COHQ6dBYvk38FZ1hwpSWtYQPmG2w&oe=6AB53065"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To1EDzuG3OsQ7kNvwHPctMW&_nc_oc=AdqnMAtZGL5EHQDLbwhnzlE_vrexyhXofho9zQLfCoLVhT5BX5oNcnHku-HX9wXUT3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsMR8qBQbmrHEZhJsrYGrkhKH9xHGIWNFqZaaUqTMzuw&oe=6AB53C7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_Y2u7yv5esQ7kNvwGgId4G&_nc_oc=Adr7dkUtebAcq9HC199_yL-0WVFafjlSNwons4_UTyoAUsD7V-eGwsWDFp4X0wM1fi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk_siGjKQ-vRZVXBKA5gpLd-uXCk6A6sXwCctMZ5miPg&oe=6AB537F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Prh8SjX6Km4Q7kNvwGFyMwi&_nc_oc=Adr66OHZeOaylEaywhltae5emTsOvCPsU1kP4k2G8zYuMKVevamTTx0THrV7owyD_JU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDstGVjSt99Vv5QcHHUpynMrJGz362qjvlyrzSSdLWKw&oe=6AB534F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuzp4ubWr8MQ7kNvwEiiIIs&_nc_oc=Adr2ubJTvy4-zO0zdMPYfy2KLxaSV3BTngrnmdRraDBxsuW1x886luY-8DE5ITufx14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl_GeX_KCMoDLc5Onj298_vRiD6k4HILJl6lIg1-6PUA&oe=6AB54332"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XakvqYEC2_gQ7kNvwE3qjZK&_nc_oc=Adq8XkwSayuuKcWeK_c0kZ_IH3TPEt27mLO9yrrqab1Hbe-CoKXj13i6jANI
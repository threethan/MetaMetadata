9Cw4joQ7kNvwGPdgYY&_nc_oc=Adqd6iHBWTfBQMFSpL6Ysnf91qHQ569LukuSYeJqYOG5Oyc3Q2aJcEzvUQ5s5ISjLLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZvHaJlfifvvRUcsIutPsj3SpS6ytukcWGr_us3y7Cnw&oe=6A5506FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APu3_f0L3CAQ7kNvwEmmizx&_nc_oc=AdoWHU9hzvVW0ygMeX92VHk6XhHW34LBPcAzYlhDtc6ylg4GcJ7h6d7NIQsllZ36qWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfrOf7m4BZjc4AMsUalY50E5yOrDanZNwwlsbVtKfjrg&oe=6A54FD50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j7aoUEejPEQ7kNvwEtrNTy&_nc_oc=Adq2d3Mx-bYhoR-G-qNvS8xNiH_JQD_xQCD-_ejlC2p7X8mwwk1e9shbpm_j4bmsVSY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM2gYApjwCl_jhpx-wHeHuAfJ7CV3_0PKmPYvD6Ezi3Q&oe=6A54DF41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgDv0simCtUQ7kNvwHKZMU5&_nc_oc=AdpYOZ9xKNHF2Lt2sQZyNBGCZT4JHGsi6-C7DWfRJnu-IE4Pfh-b0dMcMhbw90fxwLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQNKJeZvO7TaFpirkDSKOopSegOKEHSG2Kf86Vq8DvXg&oe=6A550B49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM-5g1vagkUQ7kNvwGiMocd&_nc_oc=AdpZRwLFNcAzPnyjSRMaGzLPJIoag0hN-84Ib7HZKfbuBVjYrW-pwQ9HdkN86ilyE1A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR2xJCMLZJEulhkX4txztxcRFH3f41LaJxCqOxu8Bgog&oe=6A54E07C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id9_G0Kwur4Q7kNvwEY8y1Q&_nc_oc=AdrXOWGLtBV6QPJ-WkrJ3CZvTpoihWzx7SRRD-waIjFT_2_iujeqkl7mKLrQlV8N_MQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY1QDD-E4664hhdXDIVBsyrKCNioxb1EVY0kyAo3gk6Q&oe=6A54DF08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
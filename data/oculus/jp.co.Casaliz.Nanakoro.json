sg5Z7kQ7kNvwEGn57Z&_nc_oc=AdqDk5MIa4qhxpQQwCiqKX5tMlpBiK6cinZWJXkPxmlVvKHHcisVn-lo9afDWyhsyp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjNZUWjaFxMVWhFWp3DygglAxZfxoQjdMX_adxfzuojQ&oe=6A707E3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cluRee7HbTMQ7kNvwHWjzQ2&_nc_oc=AdqqIwEMVOwRUCs01UaYKnlFJoku0ITyPHxtD5Ve9sxP7cAAaWGCqn24To5IyF7HZQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpff2OR0x9vcjQ8UO8gYQ6QuCreaUWg3OAl70Rfs3sTw&oe=6A707490"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2SYA-7R6HUQ7kNvwEswl41&_nc_oc=Adro9J0oqI2OLEOP4NOe2wFbdPjcWiniNR3r6y54m2Bj1Smv_-xIHlCFfWDBFOgXwI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFihA8-GimUGlmLjhxPCiccyyIiJvaoBUo75yz65_LnsQ&oe=6A708EC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lz974OgyIgQ7kNvwGjLzEJ&_nc_oc=Adort1yU68b5YK5iN_M3sCrInLfA8HW9keChRTywsqvYNQTPKFdBzzd9FNP4VNWNrWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtYOaJtid6t1D0sTmrupbD-qbJd8uHdtuxQDbBW4Sqgw&oe=6A708289"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHIZY9ob9wwQ7kNvwF88lpP&_nc_oc=AdpDm2TTuaav7eu3JqREkufmae01mRMbLqu7QSXcXgqcC1r1B_JJFFCRBKpNFk86FSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYUK3NQD_NUvN8WGxn5JuRO7SEIfUJzkE0DRpkcZAd-Q&oe=6A708FFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZeybcRxmuIQ7kNvwEYTwgG&_nc_oc=AdomRsRhMPXq-n4_FBidJRjaICgmPeemh26YovcUh-UQulH050LD8v37ur6Nks6lJYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJGRakv_77wX0uHjdJUb6GWPAJwRiYDGSlSe_BxGQYdg&oe=6A708E88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
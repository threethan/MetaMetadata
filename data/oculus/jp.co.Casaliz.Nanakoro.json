_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY06zap12sQACGr8bBz8tRBmSg3YNMV7X1HrnuMMnQ0A&oe=6AA95F7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yAT1Gw6aSUQ7kNvwGPJNvw&_nc_oc=Adp5HwkGXpDSc4ZiupOELtkdFNxoInV82K63HgHvbC1DzvpFtn9OQJ2RLGDuL0ZUa44&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXdcVlMNkcl2dhKtf5tXAXiQed33VB4T9tf5K3UlfB0Q&oe=6AA952E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY8DHqPXHZoQ7kNvwE-kH2X&_nc_oc=Adpx6tChWTyiHP2KiQGHnefBkOnNIlJ6CLVdykPXztQuxcq-vL3C9YFl366iSbmPFnM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4Kzw3jyEazi0lXQ2uy-lD42Tyj7VQRcu-3s7KHUNq7A&oe=6AA95EFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lcxHutcNJsQ7kNvwGKEvwP&_nc_oc=AdqOJrDVXsevNa4rJl-PiLj0r9KD2m52e47rWE7X4rya5oSASmYxH6K4LDoeXjPrE0M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGVKcc93ltDLCpSrycJf-m7JPFJEAfdvoWF5yTfYlWkg&oe=6AA95A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KSCOQI7MB8Q7kNvwHyzEP5&_nc_oc=AdrFZTL36co5iC-cVMkgvcWUBZRZDc8A_FHOPLEynQnjU0nCwALjhJl_0cLtI3b8M4s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ57BJUAmNRpuhfxyjAsbPUCyZ4JoJ9CmGYxd9Fr2y5PA&oe=6AA95774"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zr6PZHxDfQQ7kNvwGZL1xR&_nc_oc=Adpwk61-1MsGsiAETnU6G28yHlBlc2q4fOrGaL4nQsDokYAl4YF-rCZU-mhJvi1sHNc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfDvgZ4A8HU7BMza7KNC5HRzysU2LDPvsUPfZDKkuNDw&oe=6AA965B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLhQrJGW1skQ7kNvwExaIw6&_nc_oc=Adr7iqDYqJSVs6-r3IiD5EUHXeusKf7Nq--1Q1CK-n
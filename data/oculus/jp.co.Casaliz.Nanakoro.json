1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKON_cAw8A8_MtvfSHpXlPOlsYUcr3cWNyMEbDaCekxZw&oe=6A9ED37D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vfwUenHwN8Q7kNvwG_ZMyT&_nc_oc=AdpphN8TZZqbkBH38E-neKFCpLt9OR9r_I4NxZptjJG7rH_JXpGaGLkASkJMU0LIurw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIpO3RULJeKLo84naDGLxKQpMVgpgvV_FiIG6SWQTPAg&oe=6A9EC6E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmmQZ-bAlbQQ7kNvwEcP0eI&_nc_oc=AdoOC_YdxylcskK75brp_bYI9gZ82S7w8hodaeKre6K6592DJWgcvQN3OVvTk7_bLNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-fFS5s6Q_y6NVeu85_syQFFo7bt3dq9Lq7YAnju98nA&oe=6A9ED2FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHtY9nX1ldQQ7kNvwF5gMZw&_nc_oc=AdqF8WFhki2o6FL1VFCck3J2WG7_i4o2NRYj_6XCec7EfttlW9XHpjWJwLQ1wr31Grk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7OTLX6oDNE0JDB6Y5VK5F7NE2ADjBmL--0ItI2Bx9zA&oe=6A9ECE71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjYfWeM-ShcQ7kNvwFXxW_J&_nc_oc=AdrYPt7oSalSxeGKvY50bUD8TiGuFBT6N893-xQhRUuvrOm0UqsjywNJ87mDpqGVaAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVKj7Jh4uaAGFiAV1jNGpFeJ1wQVcgz0fIpILi_rK85g&oe=6A9ECB74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtvrBtytcCsQ7kNvwEvYZKJ&_nc_oc=AdpwpZfyjitjmTffncAFiaCdqhU3mBbvFsUPADdilPYTfzyX2sTzfxx4DALg1ef655A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKa9itMIJ7yHl6Kd42joICpxJY68O_-7pbe3C7dPyNHg&oe=6A9ED9B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el9vi03AFpUQ7kNvwGpB3f_&_nc_oc=AdrcnHz3j_iajXNb49Oq8_pFcxCHq64FBK9VOGcXZi3dMsuaexv2J2ONJTuf
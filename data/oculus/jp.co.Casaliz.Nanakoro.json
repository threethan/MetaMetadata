TT-JHZ0ROTK25tL7GzXziCZl5ZU8Ehpk0VNp4w&oe=699C60E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHBTMt4xSLAQ7kNvwHpWIHW&_nc_oc=AdnMDInpN6V12DfxHt3av7FYmRoBLLNpAhR7eK-vpBDA_YWp6dX7GjuJw61Ege10z7Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftuZqwmOjOQ0JzaR3zShkeooJuPYwujcl8MQc8E3mzABQ&oe=699C34BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odUQ6aq5Gg8Q7kNvwE8Of2z&_nc_oc=AdlKvM2cRiiGN9SkZ9QCqnrXxyaTve4HE4n7_nQ93wefq3RejQnxDgQyfkZuOxOJ-L8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft1_yQI0HZPhFiEXOwELEP7ylbWa_fDz5la7aAX0weQtA&oe=699C3031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDUpakTbupwQ7kNvwHKOyeF&_nc_oc=AdlCYBoXNLN2IjXYs2bclXLgrh-37pcj8AxpWLka0vRx0jaF6nCWNqynoEK9DCXsZ6k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuKyCKQG3sA0aUd-G__U0PH08t0E83Jm2wPWkceHFZdAA&oe=699C6574"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQz2W7cA8Q8Q7kNvwFwSO_e&_nc_oc=AdlAKWExaRfvxq4VauRd9Fg8VHRChPNU8UbVw0BlYa5eBB49xMZL8vDjEOUvq1dk_f8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsOGIFiQNxk9jALtLrQmI5pzTVXUf6BvpE5SxA7e8GzTw&oe=699C3B72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njAQBmcge7kQ7kNvwEa--zn&_nc_oc=AdlVkjMEVqoDzjkMkmeM-BUfgRrzSh13-YzHlwI_7P23_1tBLcRiXBHic-flR1_UkCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftDxXo8YDNLWhtrjJ5f4C3PgNRLQZq_0gEpm3JvEjRgfQ&oe=699C3803"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jwu806vn2QQ7kNvwEllg7g&_nc_oc=Adn0Vr2mrt5Lj84oLfLKnC-C1fUjTOmzGy7xH6LgcU4atZMRZpnqwZtvIZ5MfCzXH5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftjF0l_n
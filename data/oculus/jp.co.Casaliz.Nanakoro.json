3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHYDLN61gS6o37j5GBaHY_Fhp-iEDsopys2yRS2nJ-Eg&oe=6AEC9BFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxaLH3Y-E0wQ7kNvwHvP7Kr&_nc_oc=AdouyL58r94x7VITeXK37spsFu9TbiTM6XTrNzBG0UpfgJW7fi-shiLgoF0uU-hbOzo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo2Pbf5f95UYjOgySA3OaZS349xPkrL4Ns_sUd3fi_iw&oe=6AEC8F65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRhR1Pl_Q_YQ7kNvwGgI6Ur&_nc_oc=AdrHD0rP-pcrmJbUj0NKEVOGaRpNS2rdDRmSmHO7eylWuOWC8v-XwsRHmiKuEPWA56M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6FPyCmgfPOpX6QlT3A1duZLZrnbW6HogvXG6i71tjfA&oe=6AEC9B7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rja6pCfnPcQ7kNvwHvbrhx&_nc_oc=AdohGlN15MO4eayoyQW-7n_ZX8sMYAr60QYqtMdcg1bEaOynLDFKllj32o61kzJml44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1QkqKoBK31UjSiegtChShJPvfdFOvYRpusKX-7HtxEQ&oe=6AEC96F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmMJwRbM174Q7kNvwFnccmu&_nc_oc=AdqJ9DZASbrP3LOdsmMVJ3i6lJOMs6epv39ekF26q4aauWAyTTDlmqEhseHeDbdhYXU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgSMO30RsiS_HGfaiBJqbi5zEcnKpD2WRFQD8trJCRTQ&oe=6AEC93F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uBJyIKiY84Q7kNvwGm6a5P&_nc_oc=AdrhodvFsPt5HRsdDQDlW8xgS-87TygiuLIJCnagiNDEI6DvL4njLJxSlMRdwU6oooA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1LZ7NNMU99Fgxn6cjt7f9BOq35R6DtcU6Alpio17GUA&oe=6AECA232"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v98ZCb8C9jYQ7kNvwHylrcX&_nc_oc=AdpDVN6n1rwPPWx7O8JbiZnh3Z2JJs9IcrM5FGo3Y83QCldJ_cqTAALKFUnm
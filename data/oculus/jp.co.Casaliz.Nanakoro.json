1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTatP2m9g-0xgrg17tyYO_MpPwfOTO8JyaFZB4n88wIw&oe=6AEB4A7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxaLH3Y-E0wQ7kNvwEm3Hr1&_nc_oc=AdoRFszWRPvV9ZaqpL_gj7_4N6BVVgk-EpM0I9E0Le9EleV2ry60mt0xRqOwlydK6k4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzYI9A8qBIYXQ7RVYbtOi9dtv4BMkST9hN5gVqT8UV8w&oe=6AEB3DE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRhR1Pl_Q_YQ7kNvwFTJM-g&_nc_oc=AdoeG4LtdtzWZgt7jIzOjGbsEc-0OPM3rNqZeSvEkY-rXTIzGpLace2Qx6pHwaltyQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKtNmFzeTTRA6v9TP6bXYdphjV8fnDSEuTTfhoCB0G5A&oe=6AEB49FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rja6pCfnPcQ7kNvwGx-ps-&_nc_oc=Adp7kH3QHYOHzUFQBAJ6aSOyInwfOmjP4NxF3rjVZfPm-aCCdW-oSBsiHgdotQOc4OU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSboPUf05ESrM1MZR28xoTTK6bAiHMThp67Eueewlzd8A&oe=6AEB4571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmMJwRbM174Q7kNvwH-4-7P&_nc_oc=AdowSXrQrXBMqexZLB28KjVGa0QcdA4kJeQ-_ggE_NKUkNU5ZIK-uDIPnTsmJqsUg-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm2bgopuY2N878n5Yf51YaVk4jk_ZibtcCur4goYzlfg&oe=6AEB4274"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcozkUFfh3UQ7kNvwGFHdVW&_nc_oc=Adp-A25jxB2nKATleolDKM0Ub17iyA8zCmIvCBgMO5bcrGH6bOv5Oqeg1pDkyQzNiqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXPt-1iGdU61-6LXYB8Mo5GLIP_h2Th00wOD3b37Fo2w&oe=6AEB50B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v98ZCb8C9jYQ7kNvwHD29aG&_nc_oc=AdoZybrlOl6xM4nFnRDsWGmyzd6huFXdpjCDe8wdtvph2xT28NA7GPGIsEvw
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5b0L8MMNBUhMN2546Nrvcvon7slsJt-1qbROEzWHnvQ&oe=6A8831BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DA9X8avCSs4Q7kNvwFE0GD9&_nc_oc=AdpE_R7ZiPOypbVrmLs_aL3y81LBKX6hguRc_-lcwbGE2ZVkb27aib54xu0icgLjsZI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHptbiivTxmDCnGTn2lTSJ5I6hFm5vN2UYMLy3EnMENQg&oe=6A882525"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2FEuZE9TnMQ7kNvwFU1a44&_nc_oc=AdrWiluWRj9RcOuNJSbwJRJw-aWFxf2OZPPRH5rLUZ6PLJpRd0BjTcNAV6jiEwUy3HE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9sUjKEisfW78bbEICfuoLuwv1DrBnqiTfaUAcOSzccw&oe=6A88313B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76TCK1-IeoMQ7kNvwGi2161&_nc_oc=AdorBZV8JXn3DpFTHoxt6gYbDbp9vuJv0UZmQHsLWCO1xG8ahsMAra-045ytFFx8XOg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3LjyTnW5Bcuw9BP09lcK4fHt6tn4XfW2vzdU6iW0FSw&oe=6A882CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PUk0tGQ0OsQ7kNvwHzkq_1&_nc_oc=Adr6oLMo2cvl_g3ChfFwYcpHxUH3iUn4H2ZrRnbsPzkqkVwi-ZJ1W_X24XNqa5mcHaA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl21VM1fbCIhZZoZeDm6EDciW3gEh0LSJQe8tKbalvDA&oe=6A8829B4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=th2rqc_rJAAQ7kNvwFcj8AI&_nc_oc=Adqi_dgiUFLUgqv0oUDv9F6s0okcd006oKzHjkzDNb9vrvuHGYKc_uJBxIiu7oszZzg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3kV3MHtpvjpvCe6qyanUnquiOBYhIFE0uVdhlp1lUMg&oe=6A8837F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msEO0h18vREQ7kNvwFHdqKf&_nc_oc=Ado3xvWCqKOdgzF8X_L0uSo12Yf_FRsKa5KoP9KlgR6M_hasbvOXEDhA84pF
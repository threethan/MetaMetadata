1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Z1r3LATCE4YTSzmnlt1ACcTfkH5yDG8lkSy2qnsaXhA&oe=69F3707D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzzswmB5kdUQ7kNvwGDDLjC&_nc_oc=AdowW7rNu51mQugfB6Oyx3qx8NUIox-rCXfqcD2YFQUOVzHCEUtoWFOFZMAFvbsXoOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XPNfA_AS67KLf0pJPKcavIVYZbF--Sp8T_QBXWNGtRg&oe=69F363E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH6HPNokSZYQ7kNvwE7Sxai&_nc_oc=AdqniOhUpGO0cY6-U9r599Pl5qThhh4AD5quusxk_P26KUXkhk9BC6P8ojnQXOotcIg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yTVgYVPeMhf85lBNPR53JIE35E5hMY--ebDbei5rEKQ&oe=69F36FFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgcwzVeSPrsQ7kNvwFaUH21&_nc_oc=AdpnyGfKwXmoFfGPfoTDBFaNHnNJw6vjPsD1lUTWTOACsSpWpFil2pIeNnVN39GaH-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35RXqddo_SlMEKeccKhK50ISL4Gj4vDurNBen0kzNQAQ&oe=69F36B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORKV289TG7oQ7kNvwE7hFR7&_nc_oc=Adr4j9DwmmtPVXyngv8TkojrKexawL5JkAFGndzqfHx6eiYw3YavTKSpnb7dA0zUTnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Pvydala-bmBx1AJLvre5XmEp_ToOyJq6Iimh6F7Xk5g&oe=69F36874"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36qVzbMzRlcQ7kNvwGKbLiT&_nc_oc=AdqsaLXigf1yhQjynjM7kwvW6ZbVxYcsedLJk1r34jLEIUj6cq-H1DvC3Th1aLCV3zA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20XdJOTPL3xFzEmqzj8iX3R_XlJgTuXfGGUbIydJr2YQ&oe=69F376B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI9v3G2JLAoQ7kNvwFqhpIy&_nc_oc=Ado6mtWk9xTFYja08cJ77BKT5vpolpzEaruHMZd35xulRcScLMcJAhdWINB-
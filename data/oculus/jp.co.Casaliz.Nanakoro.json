2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E5mSMcqAUnECdLxffx0thD9fhtCWHJLyCzmu9FXs9nA&oe=6A2194FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIcHSYIQizwQ7kNvwHO9L_B&_nc_oc=Adqjt5ZBXDiOKGEikMNxEsXoDVyH2xTZWqLOQ_0BJslDlnj_EXJnIVBoMQNTPOaaPOE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g7w3vSxFHr_MhabIBWQGqcHWXXWKjgvyjKOV6SSSZ8w&oe=6A218865"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu8vHl1qZ-IQ7kNvwFWNj1Y&_nc_oc=AdrO81pOEiRES_sIY4fuLU-IguhBGcncYga74WAm_UP1tDtRV_fTQUHZ7jrckAi4mYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9x7J9V6KSefZ13pNISdfTVZ55rD0zszdfz0lkRMlPtg&oe=6A21947B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCtErbT1wiAQ7kNvwFZkLY9&_nc_oc=AdpuzC6sQpv-zOabbDJcm6wBFGdb7dbw3kkFw_6KZ9wqYx0-5QOmTkcC63NtpTcOGPE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SVQSPaZr79LzaYl6rm5W9qdxdtAug-a47SXgkVpvt8A&oe=6A218FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk_WnsO8QJ0Q7kNvwFeAe29&_nc_oc=Adq26tIoFmMvMmmJBA2pBnQCDyLSotIpAJpbcHs5OSgZmE9ty2Q1S_pqWe6ZVT4t4Jk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IsWWd2hFTgEdky0fnRwW1_i3G-JGTyLsU6Juyptl4KA&oe=6A218CF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-ANqGh3NrwQ7kNvwHerANT&_nc_oc=AdoAhUD-TyeGCfBEhCzdV8Y01L0Yg1x3KG0ADth9LdQgZEuoB5ZDWYvoTMwv-wQPI9Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CLEPtC2oE0S5w_6ZN-2tyPlpvf7-t3mgnQgxjP3_mnQ&oe=6A219B32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV2XT2XKERkQ7kNvwFQfkiV&_nc_oc=AdpSAIls3OKZD2FmWytArwtFg0UpM_B2meC-OLge_-ZV7fWiUc4nWzt1yGGw
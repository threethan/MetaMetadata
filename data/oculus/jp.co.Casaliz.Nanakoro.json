1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kpVATS4K_pcbrFwlCbIVPtDXe94lfxViUDhqa2Kmi0g&oe=6A3BF2FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d02eB23s4goQ7kNvwH264q4&_nc_oc=AdqiB5O_P7O9AvYonl2VS3oM1RprXSAgtgiqGo4Jz-z_s4fORr7nMr7asiSIp4HUbjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ROTAZ0x0wYmTOtG-n330J-rp8etNyCXDWR3OC2fyRYw&oe=6A3BE665"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_HnGEbjaUQ7kNvwHkQNPb&_nc_oc=Adr9e7S8zCjQkZearC2_8gL-f4ikX8q9kp10lHNxErGxTiU62AOh6NE6Zw4F9mQiuys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tw1CJ71KpODlh5DxDFT9jS1UyFn5NyhcLIgptmOmllA&oe=6A3BF27B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjUEIsAFw5kQ7kNvwFLjjId&_nc_oc=AdrsbktggUiunvG-vjNrP2czxhEZMttDB1gwsuhqpH4aUOmqoEKHyEmKQ5FHKe5aeEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vscWWW1ueyXpQGi_Wv7244Vhfo8kRoPzEyVfoZn0muQ&oe=6A3BEDF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJJzul9nFu0Q7kNvwF6X1OO&_nc_oc=AdqnliHqMdhrYJwKqggCx-c1WwfB723TSKVmYFpTBScvlAKPejDS3U2xP3mLqeVkR-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87EN6P0gLNGHJ-uM4IRwvDGNjeq2rAA2J_57_8EWi5cg&oe=6A3BEAF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovyKC63albQQ7kNvwEgpNzD&_nc_oc=AdqO09JVXn-SYfYMYFSDyrIPy9N9JkG17MnhEVK0lcv77GHOzVBsSU7bQqdyE2F2O5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KAWlZbayah94tTNETU0XNfMJL6PAMNh4b9TsUc1kcQA&oe=6A3BF932"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1iO2oZiczUQ7kNvwFf2B9S&_nc_oc=AdpJT08PB1KbGu2Yn3-bf10S-VNot4rY762kreG6wDd6bZpgjUfMTYE3iluy
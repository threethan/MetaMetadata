2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3JmVDu1dTw87f7FjIOC5cxsAzQh5Ntdqt-t9MwLUj-Q&oe=6A5F8B7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RID0jpl-8NIQ7kNvwG9E-_O&_nc_oc=AdqQkHJk7lBbtvDTS_ykbHpCX9h-j8g1dvmVltGeZlIbVJYSZ8EJaK-aFoQhd8UvleA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD2ep-zuPtYHpBsvJq7evLqOw9HNxIlwLLRuAuYutzag&oe=6A5F7EE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AanhA0kZbawQ7kNvwE9Vnin&_nc_oc=Adp8OIvqBvBFY3TRMkvxgbckKKA7DkQmJYfKEAqqKTTLjXGBGrE-Xd9jT3Rexemkye8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJbDwTYeejIB3O_2hdABy7JYCVvurU7qZikYdMbeAgNA&oe=6A5F8AFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xfX4N3M29oQ7kNvwGdMsGo&_nc_oc=AdpSanH5TxBFMNucmK_9mW7Oy7XjX9lMMxRlCLaAvOR8tuw0oj5W1HQ-Cd9AgmIDtZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtfp4GnyIxzHn5akN-deCIP4VAlxysyAtIbK8wiGpE-w&oe=6A5F8671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiquSBI8ta4Q7kNvwHtHxOu&_nc_oc=AdruuQaD1-7Uj8QWfuDohTkRNAu2COyE0a3ive5jjyjybu3HviGtLtqttmmsq-yueaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvNJBATk03jw6tOzgklvsihKQ_YXGyNrRnyfj7i41_Mg&oe=6A5F8374"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD4gWETwOdoQ7kNvwGmA6H8&_nc_oc=Adoz3ULCFN7n_bIdZrHYe315lGaZ0vVY3A09kk_Iso7A2d-NYzqUpCiE018BKudhZ8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzjfJdL1z3Y13rt2OZGiV-Qag5k7_ZQUSAyl8Gc76qqQ&oe=6A5F5972"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfltRim4pLcQ7kNvwFqOS0d&_nc_oc=Ado4jOFug9o8DyeWlTvJzI0WhEtbrxc91qmzl0_bWNd2yc-pmnCLg9egyz5O
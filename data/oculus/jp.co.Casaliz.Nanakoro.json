1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTqnoNKtAVRbC7czg3_bUXk9_K_vydOFHvTaVktv71Pg&oe=6A770E3D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvKNY7fT3L8Q7kNvwHfJ0G_&_nc_oc=AdpVZkxhCkaWrX4JlJf3RQ9kXkSUwmBOirsP1ozlJdUbkLldqFbuMZjwkDN94IH6dwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWPm6CxCz458arxd8vg3i6k_84LgeuMHD5Of51wrsj8A&oe=6A7739E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miSxYLAz9JsQ7kNvwGF4SEd&_nc_oc=AdopMGprmkoDNoV10Y8mbeXuhlvehkKlpvXPRNJaaL5C9UXzc2U6JDAsf5VsQOpy67k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTL-xwAKcFnFkynQv7VVIpMUDpZEhNTzsGvT-v0kqwGQ&oe=6A770DBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyF6Y85n5eQQ7kNvwFR0k_u&_nc_oc=Adoxdx-Ol6i89VhC_GCcR8LnDwN53MaP75bbA5iZd05mucsYw-Siu7FESIwOr6VYzyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCoo57-t27dKbxmQPLN7ihDkCvIHij8dUfC4XN8RUXqQ&oe=6A774171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnnR00HuGfQQ7kNvwF8_qrc&_nc_oc=AdotHdnHEArPoRf98Y3NgvyYPaE8d0xE0ZBAUyNHFytJcfn-JeCcqFNM3gXfuCtLbXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbycvPjic0cWGzmxL56xzZjRvV0NdBnRke2GhwahawIQ&oe=6A773E74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXJdcJziJ-MQ7kNvwGsOqW7&_nc_oc=Ados8WHOnJ_wYs5FfuJJVoHHj9Sk4zVX3Wd55bePnLgQfH0njzwbJoqEdisvl0YUhfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8l-6lXjONnFyU-RrRcC9WH3uLpZBKfE68xQ0h4ROuug&oe=6A771472"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4lpeNifSbkQ7kNvwFx5u5P&_nc_oc=AdqWO_jveTWKDZXXFOHmSntZrT_GD6XQ_XhleE9w0WM0MoBq845Mf01jmdnS
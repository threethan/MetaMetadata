2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKGz4jIGPPrOEGxw5t8hPKFsh3oLwRRX1drvs-aXl5Bg&oe=6AF484FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot5J2CM98XMQ7kNvwFbDT8D&_nc_oc=AdpuKdMKi5_xCDD_pAjSgScKcPVyL9i1g5cC5CQouc5I1YAd7YoNVmSUlBzIbXXYU3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYrEDmQDWMCf13ytzqXKKFOehjxdKNeZEJfxulq_LFHQ&oe=6AF47865"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekdqDRJII5gQ7kNvwElYIKL&_nc_oc=Adq3TdSSUX-bYfssZgdFNposZZFi_p1ASkVb29dAE38JRExbZsgzafbR-lyAuxEKhbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTA6KW9xZPNi16_b9VqMn4Oay7OBDbNpFClbjTwI5wAw&oe=6AF4847B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXix7RkD8U0Q7kNvwFjD0KV&_nc_oc=AdqypPtynOW5khjBE2qdIz-vfGWs3Qx7a5jhq116C_LbsPbZ907CBRgIp5Lr_SNfzFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlJbivgSQnufY4KfC6TdJvpEHCRTBu6PvXgeEDPlOfXw&oe=6AF47FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZUNSmQ8NuoQ7kNvwE4u7Y9&_nc_oc=AdqwVCfFWKtg2Tc1qaOBJzMPpKEuvDRads3eevGx--1VBoE5Gx6UkjF-dL4CPrbthQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX5XCkCyKebsU3mseZXRqhrwiJlPlOtB2Pm-R1DjUksw&oe=6AF47CF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPe5oYaz2RgQ7kNvwFl7ZER&_nc_oc=AdrWgEu34F9DyGKEYbHD5C8H2YQ1iB1frYi0ZBHp3J-fu3VU_CgZNCx0EEGgwqSPgBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMYs1k7g-QiF0AG3dk44QAKSG5o_j9xkL5Io8PgN3RqQ&oe=6AF48B32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk_5-v9WL78Q7kNvwHeHZ6o&_nc_oc=AdoMYjVoF0BGM8vXq7D9MY2TBrTZbSH2UnGTtVOlVtQ6ku6q5aTjNLxlM_8R
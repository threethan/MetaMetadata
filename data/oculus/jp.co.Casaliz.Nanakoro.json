1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQa1rrpfTklYSPabZh0NwMQd4set3KmiBzG6t8UOLT6w&oe=6A64D17D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL1ceHA5OHMQ7kNvwG_N7es&_nc_oc=AdrvdCeZlOpLGS2_IU-yFf-NPVxF-HOV6_G-qxZFPaPXm0qTTTl5YGkkyMzEuyCYFts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiZjss8u0D6UgMrepfkR-VR9I9Df4S38ehdxjPB93zaA&oe=6A64C4E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdHNof0Fe6AQ7kNvwFiC5xK&_nc_oc=AdqGuPpnfzCiCG5DrAav3rd01vBVHki3Y75AlPiZAb2eN5wCRrYR0uSuJdIyMgxxCSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7muDsAh13SooAmxdp5ALTZGYZAbDNVxwYacItOdL8cw&oe=6A64D0FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmXOh8SfswQQ7kNvwFsT8F8&_nc_oc=Ado7qCGuT4SqjaOoBDfbngAhgkyTFR_XUaajSZY_xJ-5pgA274pysX0uyWJzO2EmHTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG4Bbkmy72_s5ymGZ9tejNH3nw97qxoIu06WVfK9qmuQ&oe=6A64CC71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQUMvrYWkncQ7kNvwEGed65&_nc_oc=Ado_ENlmf3BzGcOTaovxqGWCRCQimUyuWhianMqj2y9nqvY05afimnj6TjuqoeLuQzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGS92ohqjCt2_c3igecM1PRFGuLi6C7gd4IIFpkXrZpw&oe=6A64C974"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvBU6a70jAIQ7kNvwF6y93C&_nc_oc=AdoY5bdxI8l3IOhyQAy2oDAtzZBvb7M3oNcVQUnMHpoSr6I3UqRDO481nQ5Extkyl_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1NUel1ZwI4D2OKthJTfGiC7F_HqLkuK5PmIH-2NRwkA&oe=6A649F72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpnm-SZHd-0Q7kNvwGdrIUq&_nc_oc=AdpTUJdM2gQm8nPnYCczFr-9IOF55gvG3cR0PRITcoKEAlX_F2uxlt-jOitf
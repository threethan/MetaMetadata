1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5mH17y5LbN2y2LF_xypj0zIkPuJ3BIJ04Teb4Tkdm5g&oe=6AAC027D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd_s1U9t2g0Q7kNvwHsJq1N&_nc_oc=Adpg8107MW4ugVL89tpI9aj0L0_gPojOaIqc2EaEZyDkMPfbjd17jkjh3S013OwFvbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs3y7iVXHgMPL2yZ0HjW1SfCA_gu8Dut5RySRQgTKqJA&oe=6AABF5E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl9sV7dy7uAQ7kNvwEkiArD&_nc_oc=AdrtnTFbecGi9HxHIurpQ548VoZ7BziLw3ySFxPIdGu3qzkeMuHXA9meJ0uvHwcQ1E8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8Fj-zWs22zkqTDXwAkNKU5-ONW14ua6rNKow0M1Yd6A&oe=6AAC01FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imUdDyG0aJUQ7kNvwGsxES7&_nc_oc=Adopl-Bn040IEy7c1it2O5fQi_AeRXQPwIltAASjdgdClS4jWmolDUMOMc45rcVCJdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGhHSJdwwDCDflRmY_c27yQ45ONCPny0iQIARpMwvVnQ&oe=6AABFD71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N70MHWezyvAQ7kNvwGLBenf&_nc_oc=AdpCWRoTShCZD2fdPs6n9mxOlhrhuEGQDYwH0e0Zi2VdSl3uqKjq0H0-hC3IJLKviLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJogR0LhpSqjMN8mmTDXoFt_exA8zDsLIigf7ExeAS4OQ&oe=6AABFA74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zr6PZHxDfQQ7kNvwG5a1fw&_nc_oc=Adp5LOwU-f071M5S-Tmt3ZP0gMsiKhOQrBKGHu2xjxETsX0BTmYhrRH0W4CURb3qDg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcuZuWVNcnsB6FnSnD1FIo45eE99RkDXNJ05SFh80HIg&oe=6AAC08B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4CFy9VbmOMQ7kNvwEKyWhn&_nc_oc=AdpCzBsVb0hHdfqPTnsToPFhW5PGGK9Hbjkb2dblmnn65TVYseDLUKBQ8ryB
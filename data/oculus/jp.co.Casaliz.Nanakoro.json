s68LRoQ7kNvwHBSULA&_nc_oc=Adr3raf9o8aaR6hzsfAxH8x9bklN2tqN0zGsVjDEw41yhqU_zJHQJgOxchJbkFTu-2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjHTE6aiONTrO4kNH5qXwFam_tXOk40lpVLcVjz10F5Q&oe=6ADE22FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKq21z9TmrYQ7kNvwG1Vlbh&_nc_oc=AdpC1LXEHbfJQxVKDkiouDSrK_IFqvYtNbd3l-3YcgykrSEmt3wQUAEUoM_enos_PGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwtlwhUhoJRkIDYOK78WgjTjK792vvxXXiOnUfUcOM9w&oe=6ADE1950"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCERD3ovCssQ7kNvwEE7kpa&_nc_oc=AdrtEQh3w2wZqSGafANYUVJXU9Mpt6jOsF9dxJjbcrt9OEnePaKYDlEpx64sVWZ90jU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2LvzWsGBs6ERMb5z2lvk-P06oPwVyISzgN28vJUyI6A&oe=6ADDFB41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo7QrQUgZVMQ7kNvwGdfgTa&_nc_oc=Adr7IGuKaESteW_pMuN_8FZHJric81xLXkXM9RqLyLoFOCLoFyFI7ZXlvtRS4KqK6tw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTDzZXEeb6LWYAQ_-0bfv0WsIVy-HwcqJ-0Au4FCjw1A&oe=6ADE2749"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z4bc9GhEW8Q7kNvwFAWN5O&_nc_oc=AdpZc-VYd0bMfwBgr34ma_jeqjW5zF6g845Zbb3Mf3LICRkJStqwYvNeE1sTH8j4yoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI44BtDxarAlY49emon_Nkc6x22PHfyafJtwjlzTw7Qg&oe=6ADDFC7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDbBtTgerogQ7kNvwEeKiLA&_nc_oc=AdqoNpVKH76XIqbrn-xDyWW-07dpqdHpd0Yl58jh0Sk55AnsWkpXsq9XtKeAhBYUVY4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH96lvP0YeqiLvhKTffJMd6i52UbBckByhgyKuzU_Jvw&oe=6ADDFB08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
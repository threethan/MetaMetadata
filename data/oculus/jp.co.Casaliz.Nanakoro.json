3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9DXSrjQd5MgueAPZGKpP6aDLGYcyeZHBMxis24oUQOA&oe=6AA1767D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vfwUenHwN8Q7kNvwGCeV4d&_nc_oc=AdplOC1ZHkZ3YXt5stmMJBQXkAGni63KQO975SMDGKZwEfdIEikY7wwzTHT7x3JSxhA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4puEHu07BpgQwMQhbzrExmlMFGhW0huL7-iRviqT0PQ&oe=6AA169E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmmQZ-bAlbQQ7kNvwFJ9jNY&_nc_oc=AdojLj6R9KW9SOlBRzodKyvH2AbonS1f1q3wmeXq_UmGe13kcHY8So1wzPu4kAGg7XU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-ChHtBQenXzaDMUgszON4LKgSoRecyFCqIPbp5SjXQw&oe=6AA175FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe-ULuGOJs8Q7kNvwGfvXmr&_nc_oc=Adq7sveD3FrAG1axfFPiLNchTowlsUcd6-33txhdLoaE4kmUvJoDfUtMpXBQYadLrb4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzgfEwCy-g5NoFjWsrCzVyMfHbR1cMxDxzQBAr-DvTVg&oe=6AA17171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QReiDOUrhw4Q7kNvwGoLZxL&_nc_oc=Ado_vU6EkKqP6fw4gLmzILOp6a5oObEYYI5qNypRS9vwy8PO0ZNg5tnQ1l9GX6XJpgU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILXJbLVjQUCpx26rh2RFw63rzGy-AvXtf93Vhv8ns10A&oe=6AA16E74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQQiByNJv40Q7kNvwFI2-2g&_nc_oc=AdodVHy8gCmeAI9CW3VZ0oR0FdFuI_wl8q0SHmHIJxxmFJAM2mHgo2-73Baq7m1jfQ4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr5Klbu6NFxfGzakXHirUhbzAnqsQtrJ4ZGddXsvo8Lg&oe=6AA17CB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el9vi03AFpUQ7kNvwGzv_8a&_nc_oc=Adr6Tii6Yno1QFWfa7lL1r8h4gCvpPr-lXfiWkqzdxP56AJyJA2oW_BiLheR
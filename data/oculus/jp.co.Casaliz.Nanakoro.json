HwjsTgQ7kNvwERCeox&_nc_oc=AdqT2ilMwogQeX5PXGxcHMU1DCpnmsPITmkHEXTVZG8IslVp6HEuLcZslR0vZmZ_JpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oEVAiWbTcZINw9CuKJcXqLkDclSJPfUck9CvWJ3eHdA&oe=69D39BBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzvrVoeYPs0Q7kNvwGF6yhw&_nc_oc=AdrrBfVllSt_abc3g6JQezpFYKDzUMTnZBexQ9rpTrb7yWnf6vJu19pshUxrC6Bwg6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35ftrDS04s0NbKLbCDr0R6tdVCouSTcMeJBv9pbIrp4A&oe=69D39210"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk-VCnE8LmQQ7kNvwEzzX1S&_nc_oc=AdoO_BsRmJ7zC4S4brn6WGyYJuOXcXEf1UD0qE8gIEJOIjaJTJdolrru9dHpHPr4tDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xydEpkSD4Xor_XV1q9gLzpe5jLYgBItmoKcgPDnGqKw&oe=69D3AC41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uew3XDW5eEQ7kNvwG3seSb&_nc_oc=AdqwgmgWJjgIERsoPN8ZZEkT9YfGEUccmIrln2c27s25GfrmTB_52nJ_XrC4jC0ja6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ReQCNU1_3UXbj66dYPIBp-2HT7KTsvIbq0QDbABJdAA&oe=69D3A009"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HGpozMSkakQ7kNvwFlXWKZ&_nc_oc=Ado8tgHYMhM-GCxILMJi9YHEIJCYNhGuVJBIexHsFxYA-okbTYPZgSZRaQVGY2YhYww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37mUFqOMXZrw4pWOSVqCd5RffKNcc1xdt3WTL0CcyIyA&oe=69D3AD7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVAHmTcja-EQ7kNvwGaVcQz&_nc_oc=AdqDpgfG627o3KX9NmWf1b53JWy1Ka_-JIg2spZ1rw1KBlVeh8c627lLJeGGDM9lqTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B-v4OiueSnVhM3kq3tHTQoeQIvtgydy2mk4jV_6Lvbg&oe=69D3AC08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
UWt9r3FiDQQ7kNvwGaRJ01&_nc_oc=AdpUYg0y0uMKJSy2BZD8TrmFASWbnIw208fZANLPLdU1k7HTQhbyrwgTKzQYPWIGfjY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wa-ufv_Kk_lqj3hb1XcWAc0cLFvsKmYRhwoaMYEe38g&oe=6A22EDFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_kl6zgLTaIQ7kNvwHfeESi&_nc_oc=AdpESopJvtP0O2geNaW8RsSbws8jhv2P27NjLl5o6EIHW5OUqGyslwTHlKahFZYIx5Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--h7oetytKSET6K2sp5N_t_Nw5SWZeLYb4tbBxCSvNuA&oe=6A22E450"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csE3RmukrIEQ7kNvwGWeD3S&_nc_oc=Adq-04kiWEBHlUg2lvZaP3LN7lKhtWPgTo0hBSSbbpPbU0YEMDIIgNVMEbvRlsuQZ_g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WVyW4aWg31FcGBJGrN-ms2lyOdOVBrUMpLaswZybS2A&oe=6A22C641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rugfGylg58oQ7kNvwEWpwxX&_nc_oc=AdptwgGCmOPh5o_-yuv68Tzs4FaP4N_5R4jZpmskldEqCPGppbW-wi3Fxr-fpdFou88&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZBW3CuUbI6eXXS-hRrqc1jIwC3fiZIJH8km7rGxyRxA&oe=6A22F249"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfa4E1mCRzYQ7kNvwFuKJae&_nc_oc=AdqqlQCde6Qi7ZXDHCe1jRp9uEVxd3TGetUARbunhR4_puFi_DEjb4Kw0XrXzhtQ0hQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ai-ZWeeLI3MZjF91Ej2_sr7r6UU_u2aVzJ8WwoU85gA&oe=6A22C77C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_2ubBp4FDgQ7kNvwEpbt-Z&_nc_oc=Adp4U-MaghPClex8rOM4nw4ElKmxk1m-mh-PgmECCXpTgnpGxbJAKuANXAKBoJWGosM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D2dHp0cpBCWTsczlhJKWS7PzwHT_Zkpcec2jVluU8Eg&oe=6A22FE48"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974714_10204990
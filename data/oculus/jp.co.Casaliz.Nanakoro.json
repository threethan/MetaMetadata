y-82jcQ7kNvwHVvEpf&_nc_oc=Adpb2Ju3THEjQDjXtnn19Bho3KwM8B04kuEzERVqkMvyErIuJdPgEs3ayRkQ9yH6eqQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kre4qnuu9jR1SWURud5-DQAciQ-VM9dpHNVQpSgyKSQ&oe=69EF4B3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8q28btznFYQ7kNvwHnbvKm&_nc_oc=Adr7NbtY5OZLA0VLwd9TEMpi12O5rs1l9n3mx2BoeiflJLzBPOE48L1TZ1UWWlalnbo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2G8Z49XvvKOHxAQV_O6NTAruGmPt6SCVg8pALhlXBu3A&oe=69EF79D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b1JEPuVOvkQ7kNvwGjCTSo&_nc_oc=AdobO0pFXsVLaZ5BzhGBEYi3ryRd9u3nv5djlUlM7Vt6dW8S2QK8XD88PvF5Cr9seD4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WYNrtWpsj0Lte3lqd_9KNChjbLmwgIPe3-f9t5brLNg&oe=69EF5BC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuGI1K3tLTsQ7kNvwHMTMeD&_nc_oc=Ado0UP7fBm68Uot4FFFVNs0AD_5gjYkRTQoI8DKEsBtaK8LSFeUDnVSPFo35SWrhgmk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1R1F4HmQUs9pwEx5gLx0Ffc-_jQBQo5DK_J4q1zoILAQ&oe=69EF4F89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p49XMj8Fh2QQ7kNvwFATcKj&_nc_oc=Adq7BuOQKJBnRuxD7oZ9TsheFWj096i4oqeXWbptVvFx2DbdsLoenVIbMpXRFf2CmLs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qpTljwNzUhVHxT-bx2X24y634VeJnTFI8QASMks313w&oe=69EF5CFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqS8DKbVrX8Q7kNvwFUzh7O&_nc_oc=AdoVV78Yrq8vSQMixchrWpzkf-LHPYurAi6C-JzU6_p2aobWFiTDIOwLTZRgZtP3zww&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FnFU48GcxXc51mk1OD4972JYeuXgtmCzmszVWKkg0cA&oe=69EF5B88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
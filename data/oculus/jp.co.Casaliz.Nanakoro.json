jGQIoIQ7kNvwGsqd9g&_nc_oc=AdoRbCY1jA9_ov2qsY_DD-PlhjTRDiSGD2MuAi0XzbgZZSaWIdTjFjdXNLfsrWzYvP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMIh0ve_Rf0gA7bfzoLJ4KL0jo7Obc_1ZQQJ5IVXAjfg&oe=6AEA007B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KIUy4bqkoMQ7kNvwE2HUOH&_nc_oc=Adq0TSIc5_6WF9dbY9_iieLf55HU9S92xWSjWuCgLeNydqYLo_9hOTOfoTapYfMx8uc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHrU76HriAjxYKOityBRUej1n-YlLKYx6tC1f3Akzs0w&oe=6AE9F6D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXPpNiiu-EIQ7kNvwEz_oA_&_nc_oc=Adpb4SiiJIbDgR15sIkU6ZUiJWgMtz4ZT5uhNa5VMvYNI1wimlQmUCghMU6DyYz-5XM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToLNThMgT4fNCFNS5IJBocefMcw0fZBrMHYsrDekzTDQ&oe=6AEA1101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqj6kBvzDj8Q7kNvwEpDF9f&_nc_oc=AdrtdqIUoFDGnmIfqch7xzaiIzTfRCNZ79hKckkAEbp-7jyAJMQsqanwJ4vNkWa7VoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9_yjg99zuW5MK-DMR8LkNaylUCZogB7sDgoynXHwziA&oe=6AEA04C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSgcHGrBFHsQ7kNvwEaK2Yf&_nc_oc=AdqZTahYCHFUCql79JuS7MZ1JRf2OiGp1PJ5eGqvqsMpcwIen5OR-vfbMHLxcFrQGx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBMtVg_0vWWRqdTbJtSoHZvrcIj1yv0DUsb0XM6Zr_QA&oe=6AEA123C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_V2qC84BRgQ7kNvwHWv9M9&_nc_oc=Adox0OWuJ9p7IL1ACWgclV6545EZm8hKzbwVObX-KVTpcTtb4Pp-NEgnnvEyb7Ab-14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD1894yqj6uy6ny7YGTGa2szc7Kl0Ml0ozf7G-wc-FAw&oe=6AEA10C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
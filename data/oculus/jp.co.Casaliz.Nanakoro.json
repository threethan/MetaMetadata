2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl3wRb6hHdsPE07VfIDYHURYrj8Xi4rvCZ1VVN2SOVjg&oe=6AC11A7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WampDyvA_4Q7kNvwGJ1zoX&_nc_oc=AdqnpgBcN7mb-DcSkAnvfonNVDhKonvTGPmO0_KBVJVv3YwSbjsdLUoUN8tLaWP_KIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUv5WTuvNB0nxxWw4Vg7uB1YY56eMtupxOJ_6ZvUqbUQ&oe=6AC10DE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5xzPqSDS48Q7kNvwG06dli&_nc_oc=AdrpYrBVBW8H9l48TrVdmnrS5CIAMxu-lOt5J2UvBI3m6w9b_trP7-IgfAAXZHx1Jv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVulkMd63zr8kFsJ-k6EF9_5tj-3EwIlp5Xqr1t20mfA&oe=6AC119FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5i3Wl62uZsQ7kNvwFbVnCY&_nc_oc=AdqwSgiXcz7IdOcpMer9EhYdEouD6aZx204Kz7731GD2gyauzPnPMdMV4nFzDeIEllQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr1QZwiZrwD58WfhLurjsR4pQTKQGNxbRaHlAVrA-xhA&oe=6AC11571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R16KnU6b8X4Q7kNvwENoHCk&_nc_oc=Adq82aHIXzWiGXNhHyvsZVh0VvX-Po-XJIRtpV9O0v7ggvcfI_OF9ZpZPsN6d01JmlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqBJiMB7ZBITldU3FNw97Nzq-YjmQ4roEkFp-uzHt5ZQ&oe=6AC11274"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYWW5EoP2cUQ7kNvwGCa_9H&_nc_oc=AdrwlXQetQjbI2QvV08h24UVL3yyFOFlJGJ8KlLyOpqE70J8e3whDV7w6EzJWrROtSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3zSZuU42V1Zwds2081KxDTL1H9FXINo431fv5OAwUUQ&oe=6AC120B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqjH5iZlBtoQ7kNvwEK_lg2&_nc_oc=AdoY7rfqLB2e0B71WEw3V09Zr0K_6kSTe56rJmP_O9w4sWXaU3RUtigYz0qU
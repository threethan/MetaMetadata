1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr3r851rBJREaCStq3znMNVpNyg1kpqkdcAT_tzsxLqQ&oe=6AE6047D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_NUI0osrnkQ7kNvwEl70P0&_nc_oc=Adod4-SoPVsvPajLRa5bvPWHAYC3JRfuTgrl_M6K2Zu3TAyN4XIUVoW-VH_H1BpWXqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5mNsQlOtpzMIclSvqeKB4N7Obwnczl32cMn6eZRQ65A&oe=6AE5F7E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjPAUYdQ0TkQ7kNvwEHHS_4&_nc_oc=AdqXk1qFk8z6aLyYdbDYQ5r5cKt7hU2KQ6aBgevSsl2v0QHck_5e4R8_apllp6S80ZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlLxmzjHp9kPPG-eHqiEfVpsQ6blnC3s7WHFp9MeozCw&oe=6AE603FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDcekUuDwK8Q7kNvwFdYuc0&_nc_oc=AdrPvuYY-iJgCyQga1ey4R1E9dF1_HxJ_UpNxd-kEQItJxQhmsTf8wblh2__y4Wgs1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx8u4-RhkrdOuL1WfqACSRLIsuwn12ttnv48XoL37SSA&oe=6AE5FF71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZkUb0QcF9wQ7kNvwFgtqje&_nc_oc=AdrOxv8AGr-PXWtyoWptv2e675SOYALQnlW1ZaVYH_xFHgydhFwL7fY0ZYcduJSzGyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3e-oW6GHGfVsaqFCA4Lo7OVx59VGP8savqg7W96pB5A&oe=6AE5FC74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr6RgFbTKR0Q7kNvwHlUirN&_nc_oc=Adplkn0DtDm0pcVImHX3yvFa5TS9Obd8W59EH4YmIl08C0jd1dHvYoVE4nv17VkqDHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqxy9f6VoLUu3Ex98asaEm_HmxjMlxSGxvUf2yBZmWPQ&oe=6AE60AB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bAZcn5_9EsQ7kNvwHzAXWH&_nc_oc=AdoZUCByDoq9wbGSZ1DbKzu4MTo6q5tRCvJO72q0LqIxfToOzrSubP7LF4WP
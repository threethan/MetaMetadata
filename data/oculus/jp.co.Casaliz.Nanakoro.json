1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PbKfQ5bq9JxvCmqhltgDrwegb2eOL18PBg-NcMma2og&oe=69E6417D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukFdaTo25HkQ7kNvwGz-t2V&_nc_oc=AdrJdq498SwcvRrqOLmGURtcLaAMLeTkkZQ1hS0SfPSY6I4w0I8EWf2ur0-OoFLjvuE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MyTgxL0iXtTUG0mWNfvhVPiu08e1y_TZIcy9pqC27Ug&oe=69E634E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JrqHQWkk5gQ7kNvwEDWzfF&_nc_oc=Adpe1K2Z9VW-xXH7kd6jMor5NGXeiKeWGvWk3JgSnE7yZXO4H6Xwdai2USSkX1YLE5o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Xo_8kiRMDx768w6XtYlkmZnYyqN5G8TxbfEIxzLDXIg&oe=69E640FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raVBryM8jVAQ7kNvwGWoqG4&_nc_oc=AdovjaKwyqX5QSFKyXj7ulNz1AS12IrlqnZGXcIgCr9OVsizzoMEd0Wx9_RvJhLVAJk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RTl82ZtSOwq5T4z5cLin7dfyeAC4WGxchuwOh-c2q8Q&oe=69E63C71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY1_OEzBM0gQ7kNvwFuulMl&_nc_oc=AdpYQOf0nAumtzk-mcQBK-8RuWmyq97KPxMYZ54t--WkVqa_y6obrbw7xzQ8POb07UQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uixRL3b3UYvC792LX6B1E1YkE1pdfbKlZOSGDF2huAw&oe=69E63974"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kqVY9tf7ckQ7kNvwEShRLo&_nc_oc=AdrNikQn_jaRSgEsuCkB4qzASq9F5ID7Wdi74ZIscjNi4x9XaKH1JgdtTD2-WrcZbiY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3psGFdhNwjMpc5F_WTXPjQLftwMahgTQfFUmmRcHxSYQ&oe=69E647B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7WQ0n6BREsQ7kNvwFBJIpH&_nc_oc=Adr3PP6yCXbFYgzZNJApgM30u6dqQas6Q2LnL7nA-KLyM_AQTb9szaPJoA83
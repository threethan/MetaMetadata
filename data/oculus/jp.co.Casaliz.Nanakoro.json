1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx27D17koNSYk1wa89s9p18R0wMoWQZD5vViT1VX-rzMQ&oe=69CA59BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p_lQ6HQmiQQ7kNvwGwDTNG&_nc_oc=Adqig-pHb2-x7BTApfuvO7fss_TPosM69DzpXzY6a5VCpXOVzcxejQIis4VyasztxHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw55mvuDYOLg4ektzrcxXF8URgkKvtyi9jh88SK_jFl7A&oe=69CA8565"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQOW1lwzWLUQ7kNvwEi3STk&_nc_oc=AdpzE-hgkh3sv9v1Q3yYifLOybCgitxHiRIv7k6scVo3cwaQb0IMxDAW8so0kjrZjLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyRXOknGvLaRbkGyu59BG_iogI6qymQ_qWnwi91r7K5Q&oe=69CA593B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BousvCmjTAQ7kNvwH6HfwJ&_nc_oc=Adrmyadnfr3AJ-u02JPbgPE_fRsJH997Ln9Acy77jXcOm8cG6JvUuOPy4nTIcaBQ3zE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYk2U46q0ZKVT5ef98EE2dg2wwFko0ss0FNcmK7wXwQw&oe=69CA8CF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CZNU5dFH_YQ7kNvwGg8hMS&_nc_oc=AdqcQ42p15yWkZwgX1hFLJNnaB1NkLwVOYG2JB5VxOfODdOqaWC2D3Ia89qoP1jQjOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAJCzAbLuvDBoY-bJrr2k81I1ftXnzOHBz2ROj2nhb1Q&oe=69CA89F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpJtoWNoqUYQ7kNvwFUlprf&_nc_oc=Adpwff0SfIIRwXv6zSj_PnBUl_A0uhfEKsY446zRvNSQENSE1HeTetSDdvf3hKB4vtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzaHWTNmCkwGqd5K_3oFL-kd56sEdUwAQyO7MGylUfAQ&oe=69CA5FF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4BD1qYTtugQ7kNvwF0rp-b&_nc_oc=AdrbTXki_dOn0gBY7ZIvrTNLqIwkK-AsBS3UsdOtyLWT18KtUaOSFDFogBWj
t-hkg1-2.oculuscdn.com&oh=00_AftzmuAqnvKkEZsa_VFPxbKiuKxF0JCfaIMEXzHd7kREyw&oe=69A182BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb7LUUD__MsQ7kNvwHmU5Gx&_nc_oc=AdlPtpO9YhOWPE4iRSaDLJ0jfszJfYwzq8ViWbjcaHdQ2Q59I7Pt3IVwMUp1GszdpXU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvbZJVymEopg_60LgMvk1y_FBHpzkgVPvYm8hUdNfJmfw&oe=69A17910"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejZ64IpaiKYQ7kNvwHFirU_&_nc_oc=Adm_dyThcAhjdClTDwVVbfu7lDjwyv7B49nnnzZ1EONTfu7Y5vEwglOD54adQpWrtXI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv3P9os0C1TX1RTf1h1qsuk8j3qpOVKCtb6oc3uydf-Aw&oe=69A19341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyt39FiJwpcQ7kNvwFblSbp&_nc_oc=AdlcYsKfrStXUkyO23Drde0zJNyC1e6RMD_pUID2g7g-CLO4A3eqKvM1JAhUfWzzTXk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfspMThu9g8RLt7JRl7dlBwz4mcIlPJcElL_v4GouB1ejw&oe=69A18709"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbykt0gOoegQ7kNvwEzUyXZ&_nc_oc=AdnNsLtv_2bOveHmpK-185hOJyVZpk9S9f9UqjQnj8AiI7pFfJhgaihdVG6UTkdVRrc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftSNBT38EUPZQn39THhDDEm-GrbMj69usbMcWZx6SzMqg&oe=69A1947C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhmZEUwFG98Q7kNvwFr3jWc&_nc_oc=AdkH0ZQ0H4sCkCVv8Zep-HqNbvB2OvV_onqp1UcYSHT7CIQiVD8cY1IcVAROq431Inw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftIat261J3eCfBVXgCJfXkQIQzFUy1gpfICk0ylQ19f5Q&oe=69A19308"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhqODh7GP_YQ7kNvwFvkJJt&_nc_oc=AdkLo1N-X_bCVNiC00ob7-1fJj0iyUZeOdU5FUemWZrLFH9w6xbQoPu7Dpf0cJXRx70&_nc_zt=3&_nc_ht=sconten
44It8QQ7kNvwEBUtUH&_nc_oc=Adrq1WbASHxWQ1bT1o_vRa36JX3baavtkrRll-PjiryVtfuwRFv0L3tINTWQHidII-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh-io_FseEif01jA9rGTS-QpSqgxjWyS899BTrG6bR7A&oe=6AB695FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ8QKJc0HXwQ7kNvwFL_3Nn&_nc_oc=Adp3KmrCVoS07pbx0063MuDyGlfhFRmOenGEdaL1RqMWbTfOb2h_3vF5oXDrikqD5Cg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxH1SCoKjl6g9GAlbV4mf1hRSxEcxe4NFLE3Ht2Z0wyw&oe=6AB68C50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTmu6xaKCiIQ7kNvwGBakTu&_nc_oc=Adr5U1BKci-HQZJxMgwUe_SpHsHs1_wQeKpLc1xKaVt7YIArFe_ItRTz4917YzCzxYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt6-N-nPjm6i5421G20d4d5_e6knKkpJJ3yxtH_x85sw&oe=6AB66E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEkUjlMjxgEQ7kNvwHWTLW-&_nc_oc=AdoZRMnYqw3EBlEer4Fz8MNBiWXadoGtk1lrHN6PYhZbUCjvy9TTT8hlDN3aN7OlGJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS5P_hjs1a8d5kToVQvErw-SYbc-X2wP1Mb8PHnX9ptw&oe=6AB69A49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wEcQmqfm2MQ7kNvwH7A1ny&_nc_oc=AdqfkzJpmvMHyGxObblbI1h7UJwGeq3DER4PfZBmnMLuwulMZc-dDdlrw7NKULKrlnU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz4Bd7B3_t2PET48wSKkL-PamE-E_8QHB2hjlHtrQMLA&oe=6AB66F7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3iOxpOcr-8Q7kNvwH691M3&_nc_oc=AdpZtdB3LTXe_4k3YVKxHhxx66rMvZ_UVWiZt5QOs-E_PZX62WopubmMbLALWldNjUE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcLdgy4fda6Y3Pwg9GJ8g3ssvlhhmApwKvB6CEnjYm-Q&oe=6AB66E08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
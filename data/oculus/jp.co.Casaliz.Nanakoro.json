yswID8Q7kNvwGMXMBi&_nc_oc=AdpjcNEf2VhaPnPS-XcrwDIy7T-3WB7owut0ko5rrdOPdusfzAOsipQPI97lKhYGYWs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rPpVpOEcwOXxKlcbnwTjDQHKWgmWwF0pRbi6bqDcn4Q&oe=69E7623B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr0hrRoV630Q7kNvwH6_H3A&_nc_oc=AdrvcFEJmQz-gtJXLsg5zWjM0K5qUNIRZJ7ij-nejZ2ZO4qbMGWjCXwynM1R2E9BIH8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VakAbHhctDkGKoIUhDJ_HjHoYHEoux3a8s3gsO5eu4Q&oe=69E790D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiGkRDkaab4Q7kNvwGHmmAu&_nc_oc=AdrbqkuBITdFmOZx8ZWkHdbh9U4KVX5BEqBiNk_GJS6Uri1_kWclf_iPJopTyeUYtUk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y4jBOForSM0-5I-Yi1O7u4OzwQWImsZhU7Yo2dQShgg&oe=69E772C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxhZB3z8LcEQ7kNvwFJ3jL3&_nc_oc=AdoHITBarKBBxuffCLlSD_gzkV0UDrih2lEZiCV6PASkDaHzQdHpmMwyG47dhMTh308&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fxhzd_b10Bs06XrG54Ki350LlaYCLwMCkSbwu0T4FcQ&oe=69E76689"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifVOaV8-7GoQ7kNvwH3Pfru&_nc_oc=AdrbwIxSag1k8cbbJQQ16DZtuh7nDWL3gZftc3oADtJMPx_BIN8ruVyTjHttVK-a_FM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dZACss1rDTQVUQMROTviga66TWItJUDQq4wV6YBUsbA&oe=69E773FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT1XzHLMDqMQ7kNvwHY8KRa&_nc_oc=AdpFO7Nu1dyR5Ym7O1W4n6EqSYYnA8b0W_-setou1R57r6ZODQ5jZBgx9qNp7O7Bsmo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hUqjSqUCLOHA9l3nLIYMNuLo6uPU2r9eLf8Y6gyWqZg&oe=69E77288"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
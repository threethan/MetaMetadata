1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nmsmU3J1j7FkgPnoUBMDhkSD_mJy1-TmNWr9Qpp81Vg&oe=6A20437D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIcHSYIQizwQ7kNvwEMXtmc&_nc_oc=AdoUfeJHQ5Uw5cIue1CLuq_AamhrUVOYZMXIfplhSu6jpM_GJy7J7c76ypKHXHDc5ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EMRSbe5ZvuvPTDuckwguNj74q0LnjNMXxslKe1Jw-zQ&oe=6A2036E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu8vHl1qZ-IQ7kNvwHL-0iV&_nc_oc=AdqY717D7f6LS694NYVH9ttit_xyMMMxklL9TpgveHd_nNfFanZl2JPQ77aaHPUazmc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MmE3bDNbK4E3-iYVfScYKCAWRt0lzQdm8UJbW7T7eng&oe=6A2042FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_6aYpECoyIQ7kNvwEzC5-5&_nc_oc=AdpHhLu00UTYY_IprmQTXnozzTGvIMQS3NFpoQvhh2hMBCHD-XDTr8fhXzaaKIlFLOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m5X0QZ_i3hxgOwrKsVmL1jZEoxZo3Cf9H1oRZf8sf9g&oe=6A203E71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz1wNBOheOMQ7kNvwGImJOp&_nc_oc=Adr8A-QIWYr6V56N6-fn-HZNXlYds-nbisfq3Wv96PIWI9Hpd3PqQRRbDi_x2z4L3uA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sbUNEoC9ke89WXoxSa_h34I54OIY7pe5gv9ifNGeMdg&oe=6A203B74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-ANqGh3NrwQ7kNvwHYlW6B&_nc_oc=AdrwsHOGg7EDOX7M1s3ZDp08_CGIzmKEbBVCGtDhaBrX5GMJrsaXSwQq9N4-bU9I4ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T9cQ9HY4kEFk6lvvp07SrghucYJkVhIBl-cajXrgjog&oe=6A2049B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV2XT2XKERkQ7kNvwGHL57v&_nc_oc=AdpW5cdPYdBI40sJY6iaNYzdTQHcMV244Zdka2oUq8UOY0aggxibKXQr4M9o
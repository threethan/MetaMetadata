2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IRA7HynjHkD97b-_5EPhFa-yIEwxECduZNv8Kqxcmow&oe=6A4138FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqsCfBX-eXkQ7kNvwG4M2X_&_nc_oc=Adpz0BSM0lp_XgfUzxxlt5Q7QmtgW4kzRqprLl61CY-G7lb4urIy-r5ci0dsxrRp0ok&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R2z-W6MzyCTTbGXNvtYjJD2LAjMhyvGUSHHweLRpGGg&oe=6A412C65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK4ni7f4aFAQ7kNvwH8DEeG&_nc_oc=AdrJen-BgLXMgfUyLnsNEevghqqyXTA_OTIf7kMlf7la6P_WcslRAe4ZJhbkYelRMOo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IcFwWiIpZEvkDJQu9TfkdcyaFURRvz_OimqHNvglfig&oe=6A41387B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_a3CqlkcBsQ7kNvwGmQWiP&_nc_oc=AdoFQyVhGAI8jVn1fagN6YK1oTsbQRv_9N1tSrLCxiE_IVGPg4eokPt2kOnDZb2wHSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NQ3oBZguZqGYWCOwUyMGYrWDfCqSs5B6symFgLin5pg&oe=6A4133F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22qfQ7h74C0Q7kNvwGbCsl8&_nc_oc=AdokSqv2nlkqKr5Usmakf0zXhHzTuqzTqfqGZ--psBzU9uQaXT7qsRq1n6escXPJ4hA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VMglAnNmrbz_HgxBr-BYnCOtmkyR327Iz9t55bRoD1Q&oe=6A4130F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH8H_2Vmip4Q7kNvwEJfIz6&_nc_oc=Adrmk4kHugUZncOIWT5qHPLdOf3q8u5k1HR5pgirXWYVt2h57TA2zqSm57aMYr8ICLc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Cbks6H-Q499gZpLhXX0x7WD_kGUl83QOk2AySnNLjLQ&oe=6A413F32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__GYiafYev0Q7kNvwEWK68j&_nc_oc=AdqWk-LNltsg6etWat6BpSWQDSuvNuzk6b8MX0UVL8vJCPAoQrEropxNT39W
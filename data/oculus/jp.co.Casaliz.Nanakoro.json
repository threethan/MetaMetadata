t-iad3-1.oculuscdn.com&oh=00_AfuaUH0mGjnqu44gY6TiB00PCYjk8gg2GSJ-8tNGe8GTKw&oe=699D8E3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjmFNMzY8DYQ7kNvwE55xO8&_nc_oc=Adm4XAoK6BI976ZR-nyRk_IIHZzWgQ1B-WV0ELXz1rJw6VMotA4Uryh1lb0J6mlVzVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtA59MvkIu1bB3uFzqHn_YWvquMf_jV3NuEWgvFeHGaw&oe=699D8490"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHich2xB0BQQ7kNvwGTeiGd&_nc_oc=AdklLKViDjrB0h31K8DfYqkxm-X_FC3OsgPim_2l7zHrnckaSwUBekASxb0b4f7eXfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQiiURu_OxpnHr6Afv7zBZSKNCpxuYmTGHG53mwiH79A&oe=699D9EC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLZiMntBCrEQ7kNvwGl-_nh&_nc_oc=AdlhEyVOuvboCi4v4iUS1TNCOtbueegOerwCfuoT-tI-6OdvezEQbOfTPZiZ40Ca2FY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9lvn5R7PtrquoZTAGcxN3OxD64GhZDhcRfJpKZuZDuw&oe=699D9289"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ee8n4DXB0MQ7kNvwGJkTcX&_nc_oc=AdmiJubTwYjg9XB11DXc8bADB9fzqLYoUslVw0w8rWSMica9eaRJKzw3U3FMebaovQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBY5b8yGNISYorJKeWDue3q6OtYwmrPuPKDqSjPz_Fkg&oe=699D9FFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3gynFIO-3wQ7kNvwEYcJzh&_nc_oc=Adlx9PefR2G0aKk8Oy9ThsjabOA9gO1w7Bn3wxL-oZAxKnJcgHiqZiWutbvQZDQuv7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0GLZsjtBMK2PLvVvoNJefnbrAnYaql0WvxHnleF4LWw&oe=699D9E88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh2KhF1JEL8Q7kNvwH8Eykp&_nc_oc=AdmMWm5rolMik1atZEeS3yT3KiMlTPAHvnu1PnNFwcUPB2Z2ocMxQbDbxmpgSEerdMo&_nc_zt=3&_nc_ht=sconten
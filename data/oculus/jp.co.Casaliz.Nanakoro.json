iHAkFUQ7kNvwEScvxl&_nc_oc=AdoFvzufmSdJnmGg5iNu6_2UH4I2x20Zv-mIMsbIb28C9YXjbN1m2kTHFQrtDZKUf0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCzaNq5dgTjF727AY4kNn7tN-3cghITDJQQxL9BsW_ew&oe=6ACCFF7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbxrtpNwYskQ7kNvwE_jed8&_nc_oc=AdpQJMGvYG2EkYfvKjvafs-FZmNF3BRYBWYG30RiMXRQjbYAESvfKwc5PDdLN3p0IpI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhd4hSGZHFF_GZkzpMDzHuy4JjftxStneYhfWZ0Hjcrw&oe=6ACCF5D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2oRw64Ic9cQ7kNvwGCkhio&_nc_oc=Adp7E44uDQFesX3cq4O3q67t5HExIMTKfZ8wwFa_2Un-ohPvefUp6Nsa1WQvgvlDNf4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb8jnJcoIzhFKio1RyDh7I90e9TChBLBkvcUzEX2eMdQ&oe=6ACD1001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvl5DIOMjtcQ7kNvwEfgxB-&_nc_oc=AdqSxw2ACRFsa82hSN5yOsBEV-fX-FSDVY4l9BQs42Z6GprcGPu6-N5sHjRY6U2TSEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgfujVLTRNRf2un2XPw7zI5ANiWW4HDywJQGdS22l3Ag&oe=6ACD03C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5LCW5R8KyMQ7kNvwFNkCrr&_nc_oc=AdrqLwn__yyPFbY7midv8GYaK2kjLt98byw5vKqlinr4vf7yIBYoDzIkL_nZvVBK3m8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBEh-AcuenF64yo_lSt1UX7IZ0ifVln58Ciola5vVyEg&oe=6ACD113C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpAbMElzt6kQ7kNvwFt-cpq&_nc_oc=AdqVsYTpKp2tJp0jGrqRm5DQraKUmezBXZNvZzRgN92JUzROqBEXJfkg4XnRjMxXkdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwySEP7451PlWqts5-MI8gC8Vpf-GDTFEmOuFVcJQWpw&oe=6ACD0FC8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
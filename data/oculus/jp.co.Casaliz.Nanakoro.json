2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U4RX8VjUD9fsnRGHNFDjoDjk5CPvGMfOPo_8rEx9b6A&oe=6A47D07D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlIClYdcnw4Q7kNvwH3RrgH&_nc_oc=AdqAJnOdQqiW0gTwCAqr1aSYBnzs0DlCIFei28MOS1AOlEVhfj1NAYy-z0662zUcpzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zwOVwVffZlIA2QeyIhCAsgqHGUhH4ee6N48uCvhQksg&oe=6A47C3E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cVfha9ZuGEQ7kNvwGJof5n&_nc_oc=AdoP44R8EOjMaLY6IENGdMwnGUPM__cW1clWVRjkjOhWBfxI5bVyB6QY-RL26qyuhQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xc_P5YfUC66TKTdHyzBeViByH-WqhPg8L6oVxV3Cg1Q&oe=6A47CFFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjB_WD3eUDEQ7kNvwHZ1gU2&_nc_oc=Adote5J_veYlPdDo6_cl-FhnYmokTiD2wsqEU5RX7zFv-leg8nwSjPhzUESx94OXBQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VRD2MDgBETnttPMrzxM2uE4u-fU7tp54oSe8hpR2TUg&oe=6A47CB71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asnEOw9oNr0Q7kNvwHoOiai&_nc_oc=AdqVu5k0UeF4hStJNGgvdF5G4OWrVgx-DSyeKRNCJjomk64egEtS9sDIgmLQ5_wtqzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HkQFCp9A1aXo7hiAT4U7vSo3wGYyG9pf_LszB2H20ZA&oe=6A47C874"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m01QlJ_7IgUQ7kNvwGKuAH7&_nc_oc=AdpXmJhzSV3_RgmTovj6e2Vi5EeIF4Grb9N_QFzTxeIpRQBkgQDObcuoZg7gDssLvXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8edieYcZHIU8P17VYOazCpcEGy0v0YhgOsA06ceC7Isg&oe=6A47D6B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWdjQWAaSkEQ7kNvwFKz7AF&_nc_oc=AdobI0MCTyHI66hjUc0pyANaX6MXhvPCUy289dyaPS8apvnTeYdjJ1nDs7-3
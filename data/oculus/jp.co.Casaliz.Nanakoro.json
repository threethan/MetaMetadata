1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHH3T7X3hZOCoilZZcw0EJjDB8e_l3AdkaFMK-6cxrqA&oe=6A53ADFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDBVfgU6bY8Q7kNvwFIyjqO&_nc_oc=Adpb0lDmKGS01Z2KSfMQnufKvuS_WYHiBr287EX0JJOCM2IYixVFyputKW5o-RV5K8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGXtSvPkzn1tmafC-qL6953h5UXNzabo5wNyHsFhKPzQ&oe=6A53A165"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FyTHKe019MQ7kNvwG6QIWB&_nc_oc=AdpdD_ERUVhZx7AACPjrdU9l2ez_lmIB_hoaQLFa1dXAayOq0lvqhtMcSilOdBX8U10&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH0l_2lo3sY2k_sHQSGDKgPTfAqPN3oCTCwT2ybFEd-Q&oe=6A53AD7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlCDc-zqoJUQ7kNvwH5bYaT&_nc_oc=AdqxLWqoGexEk0gGsGk_OMFEk8C5hCqAkTaJ-Tqd8auqJuV1DfcX-9z5GvoDZDAuGBI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ZFu7NjebCn7gOyhzVy4zWGyLac6pAdgzVj9TNDtTkw&oe=6A53A8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljsG_AVnpDEQ7kNvwF4YxV6&_nc_oc=AdqPuxGD11QrjbCKFP0tdcNFVU9aKx9o7B_eSCQkL_zbfjUCrCZZj-xu1J3YE0hJvlI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnME9uJTU_e1-7CbKPR3q619Im3Dxng2vuCfmhpqAVjA&oe=6A53A5F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC6_E6s6-Y8Q7kNvwGHPUAL&_nc_oc=AdrxGZgyyGe9cH0k16LhwZ-70bkzI2ZlyoaBKlpz1W4KAcdGf6wm1zcfL1pqKEgpvxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgvN9fzVwJUS6nt-cCd5d4inEG1b3um88kf3BCQPr2zg&oe=6A537BF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9unmcSYUa4Q7kNvwGCf16l&_nc_oc=AdrBXvCseKSaogO516z2kpTM0ZFaP2tyxzOzWPWXCbwPjOp9Lxy74hhW55vr
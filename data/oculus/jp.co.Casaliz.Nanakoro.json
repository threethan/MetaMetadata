70556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfsRDtIpAhEQ7kNvwF3XJL0&_nc_oc=AdmElod9K0lj1kSRexOX8EKPrQgA71h0Jz-HDIo0oYB8td8vJu9XO-l6V6bKOOHTf6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNCK9MT6ryh1G7GW7yzJZBndPHCy7c8sgYlKsrVVmmzg&oe=69AD8465"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au0Mg06RkBUQ7kNvwGw0djA&_nc_oc=AdnVudDKYuQIk6WOdxiwU8p26sOaCeOJ1qlWhQEdYJ3LUeMDPwQXdHh_MgZysqHU_e8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCQrnV6ZdgOO98nZMlZLo3zRbuZvc7Om9CmaqRD_RBsQ&oe=69AD583B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3fGJJIkpV8Q7kNvwGQeDtY&_nc_oc=AdnR9UYIQ-E8z6ELNik6AGhv9kqb_bcP-fvV4Pti8H00Fni6xx4S-TQWcNEksH3R2v0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwo_OtZpk-s1hc_y_k2qYBejeSVaRoZXwhl5rBnFGjRMA&oe=69AD53B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5LL-zpv8jYQ7kNvwFqGfKC&_nc_oc=AdmX2AylnowEmYDTD_o2QuIVhbjwDfZDVIzhxQdVL86IPbGOoynkdEKCXoZZPu2snJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKunFxVyz1ildbt1yEgaskSrhCL1pEssPefwdHUBG0Jw&oe=69AD88F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymC5dIJhXGwQ7kNvwFYX02a&_nc_oc=AdntJysnjl7vvIJXzM1LrFaFwAJ53OkNTDx6JwsF3NESIQ7fIoBvx99TSZle-inH3XQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsLq_P5SJATXqCPtWLFE1hXNOQbRskGqKc8xdfL_Z--A&oe=69AD5EF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z73_0x2bVrEQ7kNvwG-G2LG&_nc_oc=AdlDCAECIZZ1t-7jNug4eKnevIPn-PZZ8v-SFM0ZSgJDTcgcsQ9xrWOZwYeeWG06zcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7kRb8LxDyCpLaJmF_ZhA74Hn_KwEzlB5Q-XO8AMR_eg&oe=69AD5B83"}, {"file_name": "2560_1440.png", "i
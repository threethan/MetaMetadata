SCRHNMQ7kNvwGSPllb&_nc_oc=AdoSgaQkoNALD26-iwYWOW-Y2YKGymzRocRbjSjEFyyW7FqBkuWw0ZK9BTP83FPYLoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lOU0Q31ZK3PhhFpRM08uwHwyiVcDBjM1EqXZ_sLpnoA&oe=69D63EBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKxDE18gAK4Q7kNvwHQJ6HH&_nc_oc=AdqziFW2WLNEojJGMEn2ZE9lx3GHn5t5YR3ZJTMDPWus8-6VW6HhVMMNvSrzZX2Kz8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39IgkixOWfU_Hiqp3vMCxHqL1XCv04PBrMffUiE-3BAg&oe=69D63510"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeYTs48DQPQQ7kNvwHZtueK&_nc_oc=Adr5edhkGRfPAPTfof-U50tfloC6tbz7Y5nJyed987TiPTYmvLVHAd6hCJnNQgrISxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yVO-Y0cod52nD3N5m21w2XThwZLQul0DYDtIqOjUP-w&oe=69D64F41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnfTOMNpPEYQ7kNvwH9uGLW&_nc_oc=Adonb4coX3m3fRXq_RU5qM3ZLPgCGOp345I2QDIIxVgz3bGq1oK-iGMljTzDPy5zdDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TBpYfSiXwNmmNQFvnmseIwiRSh4ZyrBivf2Byd0tvHg&oe=69D64309"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufqJbNEcYDUQ7kNvwE7-GMz&_nc_oc=AdoNloZdcRL4FeV3u1hqsfBOc5JWZliB_l8UFd3KGNFK0yd_1eol28EVufQDInnzyS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12tbcuq6rnXgFwJ9lMEmM1fIeZ33UD7RK_SRpuqiRDtA&oe=69D6507C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fXj7d-bawMQ7kNvwFDGmkc&_nc_oc=AdpO4EmbPzaiD4PNtLdn7L-oGfajggZxx9yxkY6sF6IGtNi2WfvMZUWtcbJK1d68j8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q2nopnR_BcIh3m79YyHRbjGeKkiE308EechbfABs6qw&oe=69D64F08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
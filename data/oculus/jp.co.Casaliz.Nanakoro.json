MlriPFllD-AjHvQaSrrC4mrjmlEYqnBhDeJHe06XFtpWtABASAIKovOig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftxOzYZuimfu6BVv1AYzkwB-cyA8xdOahq610z_nt3hcw&oe=69A96BBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-9OwpNez9kQ7kNvwFzR-_m&_nc_oc=AdnSh1kxJ9tq15bTePDHWLDcAwF_oN8_LlIqv_q_loYGWX5B8kHBvNxDO0QQonayMww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuc4NGVtSbeDL0t1D9E5mbHuPoRGmbrvH9Xhbl-3MFHNw&oe=69A96210"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4BzpHaXYrwQ7kNvwEdVf5-&_nc_oc=Admr8yC-CuontmQfthrdH3WzQ7uIb62qkYC918PRSYFIA_a_YtS6KtvLeLTu2qJg-jI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu9NofQ6CzItDn4s4SsmmIGJF2GjEH5Ys7mZoUDCishIQ&oe=69A97C41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NRKTZB8FqQQ7kNvwFulAuj&_nc_oc=AdlWD7xTXbJyw1byDqDkG_K6kLCxMNqaH4DZmNT6lqQkOy6Xq3RYBCuihfL9eI2j-RE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvSEXnrCq9CVaw9tn2AQdGsDqi12kevrg4JPBomxqB1bw&oe=69A97009"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HOGoWiaIc0Q7kNvwGnReNZ&_nc_oc=Adk0sp73a9swhmc3eCIa52CgzkxCOE-KiwyDjX2RrpljNC1uPoKOflNXvU6QjfMad1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuSKY7HeNYkCGNSyakCcZqCAIy1t_Aubl5-Ya7MaOziEw&oe=69A97D7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjAo6L6jBjkQ7kNvwFcSLqe&_nc_oc=AdkFdpk1cqSkJA8y2_cXbJDX0ZY9cvMyV6_5nRAsP8f6fZIZLwMxU0HWpPeTRg9zNCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftx9UiYpVEUDaQCTExKAC3OmgteSt_laEthRKjvOBqJOQ&oe=69A97C08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
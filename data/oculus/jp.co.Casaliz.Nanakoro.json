fpL7xUQ7kNvwEm68bJ&_nc_oc=Adpfuw-vqMRfpb3hna_by3Bvxvag8Cyj_dKKs27gKkCaCa98GlLcOuEgfcPSdO5ANOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuXm0ToEia6mU586YZg6GvDeqtUcjEGPfBqqFHS2bFlg&oe=6A7715BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQC3um0IwRwQ7kNvwGH089q&_nc_oc=AdpAfNqG9cg1k5qhCcaD042cRchLR7EZsCTBlI9kwmJp6LGn8HTiCThUU66drozshF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_LzKEgV0jbWcnKzC8XfyvORkOYl2JRpmzeLWqMi9fdQ&oe=6A770C10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JWMfm2z4OsQ7kNvwHyniB0&_nc_oc=AdoOufxenwCP7P8zijeWK4abTypD-PC1JDxUKazvLbp0LuYOd2i_cL0pibdtgr7vFiY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFKY3Wr_CnM0b127yB2o9DB16Md_fUwpZzec8-aunoSw&oe=6A772641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxzdVg8b1hIQ7kNvwFBqs5b&_nc_oc=AdrgA4opfD-QCOrnWHdX0wMdQ6gMhqt6629fwbzIfqIeJ6Dq8PQjjEK4PIvtEDM1WNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBA5snEyXLzRKgPNPF8THesVdEm_c9KVrl-MZ8_ta4rQ&oe=6A771A09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAnIZTjbYlsQ7kNvwHj4gOX&_nc_oc=AdraEwLV7lU3JKd05wli_zu70-QEpqDjj2hU7Ndj6fWQHFd9Gxmr_21GB4KDNGhhi_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYq5Egdw-lkGNXsFPgGi7SeAX-6QkVa7FbRnGKGr6DqQ&oe=6A77277C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RONj2K55BUcQ7kNvwEs4n8t&_nc_oc=Adqo20oarFVXvFiFBTmA54aDSdjDrdK38z0iZ2yeLahLV2eiLI0zbyHb0UKnu4sMKwk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm2gH_VNRfFynYlnhkJtsoZSWdD2UcxWim_NeC_AtWWw&oe=6A772608"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
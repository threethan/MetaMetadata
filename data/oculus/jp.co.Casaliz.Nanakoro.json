qrtfIUQ7kNvwGAKM6y&_nc_oc=Adqtf6x6Z-sUhQK5-Y_4ZLpVoZCkbeD4a4rSrQtMudKB2XtHYv-7mA0XWXp-usGPvNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqE1b6YvheVTkM7QKPlybHs2YmdH9tb3wHxfGfgil2Wg&oe=6A5B663B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_N0yuLsEu8Q7kNvwGO-9fR&_nc_oc=AdoqIvshwBs6y3aMAgPqD4zVGkyCcboCic_aBBEU7H4gRSJCNkAdIH5NUP-ET7g7ue0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALopgSHhQT7qSxmb6y9hTHBfn0U1BQK3zYOyTXN1eN-Q&oe=6A5B94D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAOor7ZXwn4Q7kNvwE0bnHx&_nc_oc=AdqeUET53kPxCFe6YZ9YKLAmBQdslPmSDA5i_4892qM_5NzAJ5EHbSnr0chQK9WWEXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbAaCxbd7GsjIyZCq88aOsap4LhzenhhVnglEU-Xp9VA&oe=6A5B76C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrhW4AHKD_IQ7kNvwFUYtMT&_nc_oc=AdpwrnP-uoAYAus0OQF8ohZoJaIBusq2TDF4vehy6f-7m4e5bbqVqvjBJOinkgavv4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpqdQ2RqMTkfdxux1x1X0PQ17L1SFM3a0L6lPPKChXNg&oe=6A5B6A89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CW5LcYyTjIQ7kNvwHBZkc4&_nc_oc=AdpHzUTORLm-NP5AVjbKij5g2nelmPc0Jok3qzII-k9Ujl_9mdxZdWMimtltIY6Ft3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQhwooNUlMXUFmj8xsF8Q5VRtR9erq4GcEzBgqtMAwLQ&oe=6A5B77FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnSE4P9KmJEQ7kNvwH0oeBk&_nc_oc=AdpXWkOsCx0ZBfI1xPoizmN8xpPXFaiijGnlupFAsnmilgPgQ0diHZ7xW6tbRK2oSnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLUL99f1c0QBdswXl9ng7UFjtSC5Ke2vyP8e9vNQnHyw&oe=6A5B7688"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
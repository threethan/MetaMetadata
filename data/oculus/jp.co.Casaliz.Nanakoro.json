zc_JR0Q7kNvwFI0IdE&_nc_oc=AdovhfA451OFpweawxfdZzKecXjPK_2QlGnC_95PwRiUFf94V2Dr8SvtiP8NMz2qZEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1Xm5WlA6p_XFQyL5PErTG5SweOvh11deR6FRQH2fZjA&oe=6AE2177B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umvmq411b5YQ7kNvwF91zXt&_nc_oc=AdraKoGCTvQegX_wUaBcpJwfcsl4gs1AZdTL5OwlKo4XYY1rAd9QGJh0rgbyv02D0-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgyvqxF7cNjm_iYZBD8d214qAzbJhq0PVl-2MsF-i4cA&oe=6AE20DD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-nxz5DUS0Q7kNvwGlR18x&_nc_oc=Adq0i_VBgZMNLcOdUQ9CQvz_NcIT2rM7KnBXJsbeek71nQoB10L-hYs-BLDi3BM5wsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYp7qP9GLIZ5fmnw5D0-WmH6WdQrM3gNh2a9CRIU7_4Q&oe=6AE1EFC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQk_7lT7pvsQ7kNvwEhpCYd&_nc_oc=AdpPHnyRtZgHh9gpWG-7P3QzCRzTsRFbVl16JRUlVHGAenpWzJL5hhuGeMAgkVoU6lw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0RP18oz2dWQUqRWstWz4f4iouYvn-1_cZWrA-92lkjg&oe=6AE21BC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyh0JUWxEo0Q7kNvwEZ6vsO&_nc_oc=Adqz3PTtUU1TEMJeF1IpUI02rqP8YI4PSBd7v1Xuw4FYzZLGwfDjPfME593DCMpAuBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3KiOPiaaIm4RPxFm0SGgBeiUfTkmpuKuk4eNUsowidA&oe=6AE1F0FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dSAUGgJ6BQQ7kNvwGGRTt2&_nc_oc=AdrAY_yRUTg3pb3szlVojHGdUeSjfeuH4vhCbS1l88qTJtgyIzYDydqe_GWS5Zeu7l0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF2SuT0fjX1pfJkd4KpnsUjYUDytAxfQHl0hPeBfl4dw&oe=6AE1EF88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
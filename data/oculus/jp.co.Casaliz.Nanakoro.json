gEkwYEQ7kNvwFoeQxJ&_nc_oc=AdoA73Vi8BuuYpUmn9S9swGogdEtDM2PVuZdoYYg0gX88l_hjWl-Nrg93ox_Rl0PscE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3eXufzTc7cE5U-WmFpXv7SrY-6dNUOicsj07W7o862w&oe=6AD396FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5H_wq-ZRnwQ7kNvwG9gMmg&_nc_oc=Adqrqjl7fLFZGfKIDcrTD-r9onN9EQleZ5XxmGp4f-egdUesM9s9nbY2lmaEP_4oCiU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlKi8LBA51JkDGgRXiHOx4H4uxE7php2Y3xVCigCzmLg&oe=6AD38D50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0FQzWYMA9YQ7kNvwHDEJ_m&_nc_oc=Adp8DFDllL2mbv2ibBwsaqmyoLlsaToWffWGp-dcALB1NfwfKcdIluq1pK2VjcBDHBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvOzthZgoFxl4fix3bYZnU5e5a5E0XO42tRIIdBoCfgA&oe=6AD3A781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfns5uZN6UQQ7kNvwF97hUN&_nc_oc=AdrilY3i30KIoOEQE8Fl7Q3yten3-PTNun-14FyVoxHQn2S8Sx0S1algJ6P7UeCk8Y4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO44MDhNVlrBo4GNYLQuQalA3MuL0wq1f9BkW1zll3t0w&oe=6AD39B49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LivHghRtqUQQ7kNvwFtPpb-&_nc_oc=Ado9JCe43d6ZleHpPD4Hq0Kt6wdC2FCIZq9gVElg2IfW3Eppd9vUbOmkKLn6BS-rzyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuAqV-QBStoPEZkGcn8o5Fv_dxjxgLjGSyF0K8IEkqQQ&oe=6AD3A8BC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgvmhQiucQgQ7kNvwGkfn9Y&_nc_oc=AdqKkYvg_rnEfSs5kW6Rzg6kW6CJ-S6yEn4XneTnt0SGlChCF5CcASUFmlf-vdXYOUY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk4b5Bzn0NOYZAB9Yyjo_uQNGnq_gxBERrqD5fl3vLKQ&oe=6AD3A748"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
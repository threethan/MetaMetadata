1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nyVxr9MrC005R86U6CtVq5j0-UtRrg8ndVdoBEP5Ibw&oe=6A2EC3FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szxCCtCJeb8Q7kNvwFMYVhN&_nc_oc=AdrN_3YgGMoeIq87_oxXbUfjHiAHePFl8Kb5RWBa-rYz9PDLMzaw8DUEqr-fUF3luew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rP26bq_CmqWacU0rGp5NPXgiTvh1UuFqarE6vVNPy6Q&oe=6A2EB765"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DTPV_qLs_oQ7kNvwGe6dax&_nc_oc=AdrQrGcyCJ97_5vXydQgKCWOffHljB_WG5FbPcF44OaZ36wiLp83k7A_-n2d638iYJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_O_LCsz8Ut-HQfXBaHTjX_NtaJejUMetXC81_nnedMQ&oe=6A2EC37B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UelbbC-gNugQ7kNvwE-iKOU&_nc_oc=Adrukal-Fn9d2heDsAAOXku_a94Me1r9-Iru5xLp2IdrWqDJEOilXPlTM4R3274evJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wMyNRQr_rz3riehDiNVc4ZWec4zPXkvt-q3USdGZ21Q&oe=6A2EBEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G01H3iYO6roQ7kNvwGdY-aD&_nc_oc=AdqY0ntYBe83n8nLYLQfbbJpXe_OjJ7GLKzKEm5tCsQpqQAhyBOR3HoarLt9HITUR9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ktcs2XVskKRuWNRPJ5UgjpO9rjQqJndr8Oj53nI5Ysw&oe=6A2EBBF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH0F-SlmJRwQ7kNvwEtexA9&_nc_oc=Adr47XHKJg6KXt0WzDnxStxjuU_huUBUBJejV-zkN4ulrhSnPZyUrZeNClewB2H5XyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hp_vq6pRXoqKZgSb3Kp43suKSLhG6JQYhOWgQ42341A&oe=6A2ECA32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKgfiA0MvRAQ7kNvwFYzuQq&_nc_oc=AdrcKSbR2X_prJyZtMVejT66RNbqPv0oI9-hQlx4xkyc7CRvI2Ky3vnVvnkT
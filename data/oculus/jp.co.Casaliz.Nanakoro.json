ljcJhF5dluUfEuH49xH02-Ysz3W4_768B5ZSpg&oe=69F0C0E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH6HPNokSZYQ7kNvwHWz9PZ&_nc_oc=AdovWmesF0a49vnqVjtBJXtEO5cyPITHh2gLbg-Pn7CFsP14DMm_xJYrq8WyWVPSRkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af18RNz7119tl6suhuHoh3p_vjnmnPC5Vlu6gTEahcimFQ&oe=69F0CCFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKCuomsgjlwQ7kNvwGYZgob&_nc_oc=Adrx-siqXAVVKCvOJDdxemrHuuvk3KZC76rW-VjrqjGrZal-FYQcTSX6vQ7iWwxlJXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2bymw-J4IitOZTXO66jggpzsODr6eaY4KgLP5DSVamQA&oe=69F0C871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a38i-SgkDcQ7kNvwFDgq4z&_nc_oc=AdrpKYEap8uotuItwXnem1uCEO8M3rnudX7O-UoTRnZoGCVAApncZWfyLIwDhYJi7yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af34tpTe1qu3puljc32KDmlM0atG_-HLKfmymszZQT_hNg&oe=69F0C574"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9B6BiTaDkcQ7kNvwHHgcLz&_nc_oc=AdoZAh43nTSGz2IUG17Hi10M9o_MjF_Ir4y5MHzXaSqwEwAsbEuv694_VfCArrLOzlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Z-jkc9u6kPJN2NbwhT0jcC9uPyhcLnInjf0gbJd-vHg&oe=69F09B72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI9v3G2JLAoQ7kNvwFAAFYg&_nc_oc=AdoaN3Xb5fxzuk7TSmKcKIjxUwIaxhEnqHg5V_NJoV1-IoGeeovJFfLdLassaM1G8vU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1iLn0pvfi4hvosOgO3QWbTqcJdkaiFDTgEHyaJfBQvBA&oe=69F0D043"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgIJZhZfd6IQ7kNvwExRNC5&_nc_oc=Adq9qnkFBYZ3nbxO0dXV6M-NvQXRQ0M5VzjyudpCN-lpVrbwT4yE9jlQWrTitjyAfpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3snVwDY
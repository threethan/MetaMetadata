t-iad3-1.oculuscdn.com&oh=00_Aftchwc7H3ZYK8YTUNRcoJqt4BIgOtX83sA0ROJ0KdQVFw&oe=699999BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dQ0ZPuqEewQ7kNvwGOdXYi&_nc_oc=Adl-Hc9JBYeHdVX4w3mlAcnk5uooB_Ka5SktjcmvSwwbV1qK9JePaG2MVQPMud7hZhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPExEjeCOLnBu7-5UdI6jDqkttNtAdRLcGNvUJbBpu4w&oe=69999010"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-aSv1UdcDoQ7kNvwGXP8mp&_nc_oc=Adkd4gsf_SVNPdVBkkQK-Os6MyfD5eJNmKbiL0VjnEHSIEC6GV5hQr4NGk5wmb5z6ZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1lXEKAMA31ra-R5477UkpeoUJEzM4NDJnsnrIRWH_pA&oe=6999AA41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfXW5I393-QQ7kNvwFjwLLa&_nc_oc=AdmeZcjJLNw8AK6NFfBkbG8VDMv0LdXDmuwQOwkvgDuMfOb70eEpf29pF4aVr4fuQfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswfrcxdiR9twjsfxqylcaIBwuPiEp_Q_U_csV3nEPabQ&oe=69999E09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFUU5x-AkB4Q7kNvwFVF8-4&_nc_oc=AdkGvij3tB21hdxI7eOQqxNZpv-UYJ_0Z_j90D5fKfzgulM7LIo-4SArAs_2DEopJ60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsORoIUQO5JiRcgGqdtP5HojppNvMwAu4UCiyOrNnR74g&oe=6999AB7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWtXiN6ylWEQ7kNvwGWBHXW&_nc_oc=AdmVAwpcx5PECDVv_mLbDG9rCDo3QYkBBNOFehuHTOx6tQctHP4-82WnopXNevX3iv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzuyWbv-yk6gq72ezTliqfn1jXrBoSsp9NMDf1ukq_hg&oe=6999AA08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-R7-Vic4v8Q7kNvwFaRHV2&_nc_oc=AdkmS03QrH6-s-u-mgq1G2rhD2ueeXwg3bNSpuIESnwicR5MHQMv5eXJ3-GQMbtIB_8&_nc_zt=3&_nc_ht=sconten
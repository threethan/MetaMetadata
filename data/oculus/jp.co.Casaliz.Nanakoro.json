1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMim-YtHpL8V3cdOP2Gu0dM3y9KLfPSU-vqx0Ukr3_I4g&oe=6AD23DFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-yroC8Xf44Q7kNvwGla85w&_nc_oc=AdomWFExQhjFrFiop40XoRX4PEfhzE2aMCQTGBIA4oLBrpcOuAhhPhblzozJ7rRc0Dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcqaxn1ijYcbkB3azP1tohdsVPcg3NHFv4IAn9MowSgg&oe=6AD23165"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApwyouCvcP8Q7kNvwGhmPBH&_nc_oc=AdqjVTGHUpPWbO21qOIfZXu3Hj-339hJlha9ppGHlurBDfJnor5lKZ80BmXiWLZ4K5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb1RTigqaqasdD7J559TmpMxbH_YaBE-inbn5sIwTzsg&oe=6AD23D7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bogxX1VAU5sQ7kNvwEguCtG&_nc_oc=AdrLYB1RHnjGAYhi-wPAZRFnCUV0Pc6-2Z_jK8tD7LY7CP0J88ERDMcKtg6KiBM-8vQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMii_xOViyv_dIDNOLx4F7u-8s994drG_6c-cPxcqm_Q&oe=6AD238F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIgub_1kzYIQ7kNvwHMf6yM&_nc_oc=Adpk_QGIj0twqVf7COcnhgXhZ2Sh_FUehnFgAb68WnSsntye6J8d5kH7M4a1CeijylE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGFm8BBuyHsLSJGbC7-4PzPM3HdAnk6xfcnAdUi_Fg8w&oe=6AD235F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2NGWHKGu8IQ7kNvwHcEvPC&_nc_oc=AdoUZT1bemLJ4W04UEvjUXfcJRdKJhzru9kq1PRZ_DB6SyNw-VZJ1hXMn3TVRj84zME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgZkm4Y5z_2q-k2FgBAJgVQrrNYvQhFExVSh9uihmPyA&oe=6AD24432"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGYzj4o3QTgQ7kNvwHAtpXo&_nc_oc=Adpv-um6qWWEnVbfKM2V4DOAY-BVahDjNzmjXCJ8BSLRiwlvh5jC8_bR0zyF
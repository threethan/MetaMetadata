J4ACTUQ7kNvwFzWP6D&_nc_oc=Adogj1lNQ5VR4J7A-NRoAN0UIBq_7vXcNJhChr3xWMstMu3Lk_3WM9bF1eqVjXyYD_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J0xio7i7L1JYIJmw-ofsEgqxWVOZn0JZMDrDr_5Ageg&oe=69EA053B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV3npw_WMuIQ7kNvwFbSz_m&_nc_oc=AdpjMqoXGB_lbNcMQfFBXl16jrynLhOGttNpOLK0N0ESKYS29deXIuNuPXR6QNJ8qZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Anw7gXFh0R51Lai7polNDUZupzM8jNeKug2viLuBYWA&oe=69EA33D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6YgqXvVP6kQ7kNvwFn2rgS&_nc_oc=Adr0Xuj2m8KdVjGPHc94IzCi49G3-NrluVm8zX4y_Jbx3c1LTVQLArWgXM20nIX7eFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28BxMHzgQOa_JIsKh8EJLBHnG5qf49jvtwSSQWlGcMfA&oe=69EA15C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLBOLRXPDZMQ7kNvwFheApa&_nc_oc=AdrRYLJfePjeGTZZuNmQm5OV9B48h81HVGMWuQ1buSAwz0sZ6wL3Dv68MZghHY3c2uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dl7k1fKuR-ESBNtAfM7xNb_jupV07d-J8zeDQrMc2Nw&oe=69EA0989"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za0VnA8-zloQ7kNvwFo0G_N&_nc_oc=Ado055l1aX8Bqztny4CjrmVpKHqXHD6ye5LhW3ORMZEG5Cv6-QjLp4Fe3LnAh0iDK0k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fxyKq9AG-J9j_DRra_yXE9tAdnDNs9ViiwoB45_HwrQ&oe=69EA16FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzVwxSFsueYQ7kNvwEzZP3r&_nc_oc=AdoKNnrmM8aLTGWTh_prsJg6D-VoTAI4a05J4ehLkiiQLh5WKg0vjX0X35kyZpkPvvQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E2raNA3J4QB9sVvU8RSv7w5Kn41aL3lQADqUSVZypkA&oe=69EA1588"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
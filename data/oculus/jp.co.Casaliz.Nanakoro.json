1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZzfAk48p16CIUtGD1cFKWFpdWK_GtHBL8ySy6TcsKYw&oe=69D27AFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k_hmjC1-SkQ7kNvwEhcbKZ&_nc_oc=AdqF2zMcqzj7aQjnCpRmF_tV3dYYdyYtcLRZVgv6krMSXmViNbO2L57lh_3k2vN5Nas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YfcHL-CsgXtn4CgI_5Vab7ZQySFOtu-ktlOs0D504_w&oe=69D26E65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V34KjVh_s1MQ7kNvwEoGBYD&_nc_oc=AdrXn6iGgrfNDssJs_IjgkDoo8zPfuBTP1EvYQyYmDUHmZWisBA_9oO_nz48nmgtpoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wJmhPde6nXDO6LXfjGSbS3KHujWbqJ0w0uV5I_jgx7Q&oe=69D27A7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUcRc7Zn3T8Q7kNvwF5wWo4&_nc_oc=AdplrvRGQExHpHS5JfdMTb6WDivTN8LqQw4-I43XP8RqywTib2EFQfRmCyZgFIS3Eos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Jkk4nA_0asMlcL1NxiJn27HdZuFAQxkPKDC6YuEhlbQ&oe=69D275F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2UDMOSgdyoQ7kNvwGt8yrM&_nc_oc=AdoDCXCKwHiUBPP6Z7kbBYmRmBj0u9cqbXmh08VC5i7aVaVhMorixgHAV6step-Igcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SoBX0dGctW8YcZhLweGo_pgl7WH7BY0dJyA7XpHffYA&oe=69D272F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRrX-rt4Am8Q7kNvwH9uC22&_nc_oc=AdpIMNEyCwsxH5hSf0G3Hipw0Q0T_fcejZ7zs_MuekpaXu-lNtyglfMmL3Upay64k1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D8HLf-OV3a8uJB0JO25htLsuY_s08aUmDbJ9g1gHFcg&oe=69D248F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGE7DLUR3-0Q7kNvwFWXyyO&_nc_oc=AdoLWjpsyWUChOHpOt51snt8RWf-UgYXKfDB0nXudfXmsd9rdcfvmsNGAPFC
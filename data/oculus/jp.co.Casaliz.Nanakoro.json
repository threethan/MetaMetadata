1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz7XN8PYh7S_EeRtDs9vQS4DAOY_3cjssn53olKdHJHA&oe=6A819A3D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTzYpv0zqL4Q7kNvwEKwv5I&_nc_oc=AdoiNP5F0V9CVh38M5AHk4WJqOfRXRD_rpTHxVxNfisssmkEBpddlaVhJOssuNV24CI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiWvKaw_3PO3G76bE4Hl6vKtijB84JBkqPFMaVCzIPuw&oe=6A81C5E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd7EckBRbEYQ7kNvwFnsnao&_nc_oc=AdoT5Cd0yE2vkn8UF4FtuWvz5KwxCjKKQtIwzUlkMCV-NHkdkZD_GlSfI8hkbsPzUbo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbVLI6Gcr6rN3RBkRnSD_A9K-JfKtRFz3f_3QGAj1tjA&oe=6A8199BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL12ZfVGZcMQ7kNvwH_4eZS&_nc_oc=AdrqbZ1S4nmaodGnZp6b7iV8GOzj9BPS412WLPSEoFaF4tzVzdKJT4VdeegNE1YKNnU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVDwxcjLhkJ1Xx2gJiFXJoZ1QeOp7psI-unCiAVI__KQ&oe=6A819531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWCWan1FfDEQ7kNvwHX9wir&_nc_oc=AdreEvrE9OSNrf-hWddprzBw9AzYDtbC9mfJfTLEzom6qKExhAXKwaz9ehgLDdGSsXE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzekaRjhPd2LtILwYAB83EsFanbYoMVH-vE1SicGWGSA&oe=6A819234"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQgu4J8n4wgQ7kNvwG5Pnhb&_nc_oc=AdpCkx5KMUhCEPNj6HWyKISh9HDVkZ10jwaq6ehoEhBl9apkTPIncNql8ynMx-hZoJY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFULGUdhh4a2iOhu5tF3fkhb7sdlQb3bxfxohKheoW_5g&oe=6A81A072"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9Mmts-Ng2YQ7kNvwGc-wV9&_nc_oc=AdrlePJE8ERJnd-fUa0zFYE2pA2XB7_g9AKXrTXpyquoPdHGDPaanB9Ph0UH
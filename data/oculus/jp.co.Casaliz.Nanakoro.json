t-ord5-2.oculuscdn.com&oh=00_AfsHkJjsotNG4Nn9mV3-OQn4iDEN35qZCIud4nGTic2QQA&oe=699C3CBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjmFNMzY8DYQ7kNvwHLwmYx&_nc_oc=AdkQZCtSZ3V-fht_ySI8zQ6Qq_GVFo1vUqpDxNEi-i0tOknIGtNxLl5v6NwB7aKNWpc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv8aTrBcTYZgqfcALz4xKNmkO2SPMKlPj4Z_Wfmg0Ceaw&oe=699C3310"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-aSv1UdcDoQ7kNvwHGKFpf&_nc_oc=Admk0ub45j855Q-JlrP7mQElqjN4O0r9i4h9Bs0Vt_CNfvDVq3Z0jbQuE5gjXusWJ5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQh5nn3aezNrkaiuQEUPjDdPoFGtuEuJIMzKMz9_cV6A&oe=699C4D41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLZiMntBCrEQ7kNvwEEiQGG&_nc_oc=AdnQwObwCPcOn_4hJ3cQSA7GCfYqjcomtq3-6Lns7U-SPOcvPE2lNsp-xRteDlZY8Ko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftGWqisEcGcOX67r0d46ahWDpkqSDHTZydiPHm7lpQSww&oe=699C4109"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ee8n4DXB0MQ7kNvwHzZuNa&_nc_oc=AdlifyrQdFWaUNPzh0JFbZcqr3fnhMlrCpJX1s-VIeHW9pZYJgqbwfL1Qyd8ROckCaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv8g8UNkpuXd2C4sndQ7qoTgFkej_Nz0ASnD8G_rhBLCw&oe=699C4E7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3gynFIO-3wQ7kNvwF7aqW6&_nc_oc=Adl16qHY5GTXpYrLWMje7Yteykminff-Fj_HJOH7pxyb-5NaVAyDFrrXVGycPHyJTnw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft3A_8OGEmPZOVyWlyOs_-L0jidiuIGOA2b6Y362gijvQ&oe=699C4D08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh2KhF1JEL8Q7kNvwFhWHHn&_nc_oc=AdkFOVikxrq4-pxTZXTIcXWcrRBPxTxHXkcK9yciAEVDqp9606RPKP1opfdJWqUn8Q0&_nc_zt=3&_nc_ht=sconten
dhPu4xkDQS7y39zvEUen61QiI0kDXjcxZ_Kj0qxc6vx5mbF5Gj3KI9_Pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy28kqSEstHoY9HhaaCnz7CzNsODd-Jk00vp8sa53k9Fw&oe=69BBE0BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI86SuUXJUkQ7kNvwHliDbs&_nc_oc=AdmcqL-EktQ4Y0l_DJI6ApZjB6vxHc8OD72_-iBCxGg5RU7LJHOO-QdNIAYyRbFBhTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyn8ihpffVOFMOhJyGaH_umJn2rB7v2XtcX9K9KMwZdJA&oe=69BC0F50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87aaMaf3JSIQ7kNvwH7b1lu&_nc_oc=AdlosHQy6vTPUMIG-gqoDjBLVFHq9vi6XSsEELMigILSC2iv_F48GSHUOphfGlFX_d8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCKJtCtlfaIJsJbHqgJleH5xnvmny6ZfPPPsC7PoYH8w&oe=69BBF141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zKuWZBhjR8Q7kNvwGDGs76&_nc_oc=Adl7qkURfGOi5GcZ4jVxZsxhDU8YWbqa1SHyl8KE170UoGVEOcR2Khx1vYc13tvYaTk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwUinbNFAvW82r9f8iDXa7B-pXsukYCXtH77sz6-AVjAQ&oe=69BBE509"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcNIEcTtIkEQ7kNvwFH9_6E&_nc_oc=Adl0GwntSVyWNVaYN7Tni3iTCFnXezJQjh1vMZDnrITkA5FoVnGJSIZTZ1mex0pj2ak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyBYhOmmPJdTaamKRZ26Mz324mejbypO-eFJFCM-lIxw&oe=69BBF27C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TgRdj35j0UQ7kNvwGr4gsZ&_nc_oc=AdknoV7AEINgAMlHeqwpc3sbMb2HNLFS6i_G_lXhnM_5qC8b_djqsy5KNq-gq7Y4lJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3wXwlLSHn3YG7paFGmGx7tErQhQhnNMF7vm9eNSYlCg&oe=69BBF108"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
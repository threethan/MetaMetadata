-3hj6AsTZl4Rxtw4u4CpsR1djKA5ETJWqeLrwhjj9tUYWI4c8DJSlzK5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXOkSqkQq-DP2FqMiJ5lTYQX6H7oyOu1_Dte8Tec70OA&oe=69B7EC3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j_KI2v2B9kQ7kNvwGxMMQs&_nc_oc=AdlTeLjzdSd-zQwXrI8tJGOgSCxdI9BsCV5o-uRLZ2xJarQRtV8a6_jfEpKelslOs1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-jvC-O4w4LiZFzIXgrRPFdOUbptDjhHSpOwRCxcDkGA&oe=69B7E290"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUrLianhLDkQ7kNvwGKfYX6&_nc_oc=Adl6otbx1h01bysXz0ZNFoDk6rO5iwfvM5SYoZDyJF8eh_xv8-BngUX_y5pAIfeJ4w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhsFqzWgebrX2AMiZv3XY8vnSWilzH4VgO4KzVzxy8Og&oe=69B7FCC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aITXKaDD1MQ7kNvwFtV36q&_nc_oc=Adly6xQVz-QAEop8Qhjpbncf2vJkpKOCezglrxTZkZS1h_nVqccALUtTjtwnBrY6Ajc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyc2_xy4jLWJ7QQIF9WCVkFPSYJKgvwzdHgWApSc7YVPg&oe=69B7F089"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlRW5j_PFH0Q7kNvwHGxxcR&_nc_oc=Adl02BpyhSm1wjPaNmCekknJp9zKUJuihZxjBi558FMK97e5swUvUrpEUIclWN-IaE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyokiEU9V8c3nbYvs7wEwRg1yVoUsB0NsCFtzN_QtcycQ&oe=69B7FDFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4CY0vJd9JsQ7kNvwG53yXa&_nc_oc=AdlEmzQHZQZ2DrZcVfGArBk67nLUzj9u1116pePmN47pXDMOfLP3W-TrK08gnRXpnrA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7qgfvTumM_gjE2BwT4UqXCZO0Ilb1bbfnl4t5ZPJ6wg&oe=69B7FC88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
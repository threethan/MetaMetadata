rM77DUQ7kNvwH2nzt9&_nc_oc=AdpdCA94_tZCQmuwHfp1zemSUtNBYTZ8VaOxKhh4Ix647mrmh0aHPLxs3h53ip4F4Rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgzAKErtMRV8I5qaPXOmvK7HI55c9CGUiM_ua8rBEY7w&oe=6A64A0BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzAMUZSVS8oQ7kNvwFHiJdb&_nc_oc=AdpBkMd1vJOgD4WBXgeXWP1IX5lFqdWQtl9aSMhQeIeEQ4njMAeKTC-tHcwJezmFrLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvn5lYBK5wRVRTLEI9qV-h5dBikvHtZw5a5WcaFWcR_Q&oe=6A64CF50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H92OgHCLcUEQ7kNvwH8r8yS&_nc_oc=Adqjvh-Bh-CJAJOQG4lbudxb-UZjlSxnowFHIEt_Cs-gWbzCkPq-fpqvQQP_TOCJbRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXL0FMof0MCWa_klfXk6h8Mb9r5FwJy5rcgr9R6YeoIA&oe=6A64B141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUvdFFSNfn4Q7kNvwEf59j7&_nc_oc=AdrAdGHc2QpkbLrm1drsGtXfucbrKUmL957_KE5gsBketWwo46CiaYt3r7WjjNUqcy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCxKF0e-B2lypF76nmlv1pW_PF8Ty9hwbisN347yiyWg&oe=6A64A509"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-PkTEpbx_wQ7kNvwFEHhsz&_nc_oc=AdoCPb1IyHu-Y7uTKV31jh-d9JKaXVYcf5Mgnw01IYgZAUe16KHO7eLUsHGkGJ80pc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCWhi5u3l8lykHPG_itkoYnzegzJsd3QpE96BaFzKUTA&oe=6A64B27C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXHGAkXFZxUQ7kNvwGiUgbY&_nc_oc=AdqrOd2tsbqE28wNil6QYYhAFHJ8dr4RWZKQWLCW17HS4ywUAblwDh2uQ_EYIOYfm7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiMzKHdwqdFkVSqQrH-cdUhSjsfQfYAQ5237zqiBsHBg&oe=6A64B108"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
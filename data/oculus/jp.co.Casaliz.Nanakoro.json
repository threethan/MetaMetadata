Y5Q5NsQ7kNvwGfikHS&_nc_oc=AdrYVQcnJ2Yrxqvr6mU4CH5KrM6_hltrIJFMx3jqqOLceJC7zm-JBjLu4hD1JCAj6Kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-wrABCzKDcM0P6gdwXRVvyQo41eIlSq107rbxGH_0Aw&oe=6ACFA27B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX1LamR8YVoQ7kNvwH11wGw&_nc_oc=AdrT44ZekEndXmpmU4dy-5gG6e0VOO2LYt417WkKNZTJwua5mFCRQw704vDMeW5nfv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRgdl8-Grw8rIX1jLhF_cICKsbn7Ew-ydl9UsYfnMHbA&oe=6ACF98D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk2N2p9lPrIQ7kNvwH2k6Ty&_nc_oc=AdrGB4OAK0P0sFEzi3tnASX7Zf4Z3eo6ASy8-_oQkuH7vATsZnRS1vHyoXj7l-Y9JqQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNJBfZQrVIerCcve4dlkVi_Nupmsa93hmPH2kjoyk0GA&oe=6ACFB301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUgufg_leyAQ7kNvwEAHYVC&_nc_oc=Adrv0YPcVQJSlG9uu9tqnO0HCauXQjCEVnqcwhpSKOlIWyrFfUO-2P5YOHn3tATT5ks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvyP4-xfXxHS5dH02J9M6eGGRX5JDxMCNzemNzhSF81w&oe=6ACFA6C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um9js5iVsl0Q7kNvwHv2RwO&_nc_oc=Adobdh7gjZvm5nf995eiNuUqy3knDMvG0TGli0uabseZhu_RWPeBGq6zlesxQ_Pl4OI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiPZEbBrrOPsNfX3RVujVXpj6P9LANI9wukKlM_DZaCw&oe=6ACFB43C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19AmRVNv4MYQ7kNvwFEI4C-&_nc_oc=Adqu8p4o6qgvYrm7Y7r_bj9NJmjIYBhhN8dFQttodQcSlkvrLaDqoCLYkeKAt2exw_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsqTcVcInVsdy7t_TWLm0-YWqHZM_-FTCT9i2nKhKL4A&oe=6ACFB2C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
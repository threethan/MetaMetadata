s68LRoQ7kNvwF3Ubj2&_nc_oc=AdoTVL8RnWm_-uxt3NysKTSIvCyAZLQdkM6e_SzXPc7phZKMs9fyyzdBo_HvofU0Tgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrsoiXBwkcuwkUNb6XHcN0Dfmp1J1L3se3I8r74xvdZg&oe=6ADF747B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umvmq411b5YQ7kNvwErr75V&_nc_oc=AdotliA4fHDKq5PJ2gpMfnR69s457APCKTvg8-8CfIDQ0rrHBH_Rs8VD7RC905fZw2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4sJycOO93TxVwxdCFyipcj9N5DPjs_RRIvlAPsfp9wQ&oe=6ADF6AD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCERD3ovCssQ7kNvwFoR8QX&_nc_oc=AdrNVoW23lGG9sIj7Fq4K64z3XOZsDawZlEspAQTmMNXZbfidaY5h3U447LYlpBE2EA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVrv95qstMcw5noTgHUkoP-6YtSWqRAUFLdrpgPoWUgw&oe=6ADF4CC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQk_7lT7pvsQ7kNvwFqR_A6&_nc_oc=AdpPbtGbOgITHWd5zKjWFTlceZdOukgHVUxIaVz81YljMwgpjylq1pEgtr7Vor0yC98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYp3YV8qO5Ul1fPvm0u23x0NcSZQ9_1MhgRk-EJ3-Q0Q&oe=6ADF78C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyh0JUWxEo0Q7kNvwFl154N&_nc_oc=AdoxNLMTcqcTsEC9RzLIRc7PEUvmoqIJpEycSOtCPPG6BGU4ckorDjAGW9gZmcMB1-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn28WtZoJMDJgkWMtNO0a2AVGW4Q3bdWQJJK1CBD0SeA&oe=6ADF4DFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dSAUGgJ6BQQ7kNvwFyyQpJ&_nc_oc=AdoZQot8IICJ8B3xf66L_GXOVgONJFY-xq8kbEflfqpnrDk2yxt-OnClRWRpo-ynDBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnJxp9_MNVL7P6_wzp06VhdEIFivNYj8Wc1DBa3rkFWA&oe=6ADF4C88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
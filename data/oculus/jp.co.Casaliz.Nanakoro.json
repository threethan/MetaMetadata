70556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfsRDtIpAhEQ7kNvwE-TK0b&_nc_oc=Admd3BZybRjg15f1GzYMiQkF7zlqcSPqdB9rxn9r32hZddytBzmZ8S1-Dc7YvM--XKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuxQVVo0Jwg2q7enDCRhM4A1LjkIT3QIJTXXcIrYTuCw&oe=69AED5E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au0Mg06RkBUQ7kNvwHsijdG&_nc_oc=Admzr5cBhn57QhFLMWIYRRu06pMgdhTEblNbRPIGEh_RUcCP7lQPTGFoXrCTuF2l40o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl_ByI5gKnZsBMZ8slIpgskGRpTpOiHiagxbMEiMW69A&oe=69AEA9BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcqVEaIO1IYQ7kNvwGeiO35&_nc_oc=AdngbJOOLaXWWFylEIhmLVwBUY4IcgoRV4ETpXGkLgYuMJUb9AoOfxB77EIM185nvdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAfPZxqbEiZMEvqMlTs8gYGn6tbLAPOHIDrZ1ZQ-4RKw&oe=69AEA531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AzqR1GN2WAQ7kNvwG5CeVN&_nc_oc=AdnGt2cGuesI4dBNljW4wNMjqFd2qoZ0iUHRd-Q3zBN7h0Ezz2v5xIPyIy3EldKNPD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJBJgAFH3Y-ZyAAB7YPSyW985K-fvh4X999Zghj5wATw&oe=69AEDA74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymC5dIJhXGwQ7kNvwFxFW-q&_nc_oc=AdlI0AVSvrgPkMpUGNaG8adxhEHx3qH1GlxZcemd9epQ37s4TjDItm1VHhw5jAa0y8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhNwJui2HPn5sC-UUis81y7fUzuNeYBlDLfShMOOhSPA&oe=69AEB072"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z73_0x2bVrEQ7kNvwFPKllm&_nc_oc=AdkA8iZI0Oi-d02CJ3csibZzUaesPR_agWCKY3QehciUE_c41Z0YMhwkCi41PvhoNL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWgHgVkTICluPsRSzreTK4qnFJ_sGZyvG7Xn61RERItw&oe=69AEAD03"}, {"file_name": "2560_1440.png", "i
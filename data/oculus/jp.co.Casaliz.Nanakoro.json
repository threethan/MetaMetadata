1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48pF5WJunczkWLQKfEPLM3kpH0io72bs_sKUCq8HHs2Q&oe=6A0DCE7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzAsmWik8OQQ7kNvwHVAKXc&_nc_oc=Adp7Irh-hsFgNRexd0breqrdsmtfE74rRTzWfeglkccpcIe9I2ASZf4POPo3FECzkY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kG5sZbk9V60awFO5Qg8TDhKQB8VDs7aqq8dID3587Cw&oe=6A0DC1E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhF46R0PkoMQ7kNvwECzaI3&_nc_oc=AdpWqLxbfwkRv7yvIGqrJm-pKPesHTDVDKtylR6w0zMlsS9kvZlqnIQwNjGq40ccGPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ySRdcaTQYjn9Cg_pcxQzJNdNwgZkDQc4aCSwj-1Kzvw&oe=6A0DCDFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr9GPhzsrLsQ7kNvwFovibf&_nc_oc=AdoqSAvdsqitPrWCSWYkniLeVFX-KWNRfQy7JJq1ihtsajkhnhw4UGqgO2GaDjP2ZDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62XvoJdT7jmIkCH5jzQ3cYOOsK1A3e9OlWxByO_hHF3w&oe=6A0DC971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSz6ZPXevg8Q7kNvwH4yACR&_nc_oc=Adq-ARWCvPwtP3pgyX03Wk5BsGW4bUicEaMklIkF9nCSMTE6480W5rdfdjtfaK4CBEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nlobYqGMHMBKTh9WTlEhrbdajiliN8riV2qbLe4e73w&oe=6A0DC674"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfwMF-uD_MwQ7kNvwEIqdwH&_nc_oc=AdpGRzAZP5e8J4oRl3BwDpd0WNFhZ7_JNmOTKq77ZCPD3RJohUaA2khJ9VsE5o-yxQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_a4pjhzKzM5j2PdwJFyy0uuoWec0UI7sK_j3dbD-cbQ&oe=6A0DD4B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbClTdfq9yEQ7kNvwFThEje&_nc_oc=AdrHzJ9D4c5tqnmIF7ws5MXiFZbWkiedt55mHxzV0xkT5DGY2TsID5PY2ZeW
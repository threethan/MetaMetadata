MP85SwQ7kNvwGqEdx8&_nc_oc=Adon5Qqr4JbQah3PllK6PIrdfnTKuR5Vmuz5wuiOOPORMVje4bRyaK9ydh2BdIK_Sfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xOX62WjPcQvwVhL3A6SRi7UIYd0a1nlsHDyt2GKnqdA&oe=6A29857B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3diDUYrU2YQ7kNvwFUiDi0&_nc_oc=AdrGShhJjBpVW-IOjKrYdrRbljF4eDbcfew2vSkuJq431r71KT-imeSyQCzgSxj3lFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iein1Bqm17_luSvZJgP-Njek0jOrHBsgdWC-PP3oQRw&oe=6A297BD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzBKxQzvkw4Q7kNvwGHD5R3&_nc_oc=AdqiIQMNka4COrTz4pOF8eDBG0h4NRukpDqgnOCmCu5JiOBlDid5qLiIe8HQ32siod4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kGmnuG7xqzGWxpi0DnajCIFL_CQhBLLvXb_qfHK7_cg&oe=6A295DC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nrNVxwMr-8Q7kNvwEtc_LX&_nc_oc=Adpapc4hv6aEY5BWHwGx7UyQ-gZaKlMnTaWaymUqAnYEpLj-lIhGqrnaCYXKvFV2YXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZkdU6ORtTwxYQpxqmD3bzKefVrsbSU9JAIUTgEe4Tzg&oe=6A2989C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a0kbOojEEIQ7kNvwE-skkS&_nc_oc=AdqYTcjLaPLPYsawS_e-nTdes1LppZfr7lFkIaGvTN3AL3K-W1jjcsu13GKNUHKH1Cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ma61-0NMOX5Y8uLk1RjvgMWLi2zWM7NW4UtvV1-PPvQ&oe=6A295EFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2lyVCRiVr4Q7kNvwFpPnaZ&_nc_oc=AdrkTFcg7AcQWTeaaWJyOrhTMlat3OT7vLzqtwafjui9DaJ3XE7lgFBaOPtrQHm0Ujg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qI7J4Dglx7UL4kks4harEixWWIQ_7pbkDgQLXLqn01g&oe=6A295D88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
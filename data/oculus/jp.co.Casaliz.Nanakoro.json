70556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVM6y7oL3CIQ7kNvwHeoCXd&_nc_oc=AdkwWPJQsHI95uODNY_oLazbNi0iUjheFXjmaKhH3yyR-riGjvL5SlLaJW3a5lQ4-LM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afymas4xsipAcVJrPnj4x7VUa4y1iVnLAHWcb4d-4opwNA&oe=69B81065"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYTNswrXFtgQ7kNvwFXrBgs&_nc_oc=AdlzTctQUzPnZcPnIv3WRNRQTL5cXkoBTULlu-_CB_oIHcFGrHCNxgm6t7B28ZhwpxE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKVfTbQ6nRSxD1e97vQySr8ObbJxxlWEnFjwsrY6t6GQ&oe=69B7E43B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMObxxzD9b4Q7kNvwE5xUgf&_nc_oc=Adk6kxfSTS_HT9oRm8eIV-N754zpXWTfIvHJi0q92YjFAoeedr7o-4RpB5f3sUWgz60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2A_q2TUIZKx5hnX0_dZ8pP89MGhw3SyIrk4LmEUz-lA&oe=69B7DFB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0nxIx2KxXsQ7kNvwFXL1sv&_nc_oc=AdliIBgRuTHr6SCHeiboQaHIwIUfI6U7WHGaqFxJJC7EVTi3spUlN_PGU9xsV7GNFXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxbpQigwcF6h_p4Lw288KyrWUeTo-Ijcn8cS3rAW-gWig&oe=69B814F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BXVnXMwwLAQ7kNvwET2obq&_nc_oc=AdlJuL9iBZuhUWtAUONrM5hVQsxQccIivIF2h4j742DjSoH8whq1pMHonGYrrEZJrCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQCP6CbmSEJG7n0d3q68A1WpQS5WBm80_dYl7gebCLEQ&oe=69B7EAF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BbxXiLH4TMQ7kNvwHzK6kV&_nc_oc=AdmHJs1AMa3bjVJz_wHyo-XqAtt8ElZwKzi9kt9Rahw0vvpMyzVpu7rLQEgP7hoGFZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxK6hPjxHrQLXX8FlQHYC9AsMUuvajnWsgYYp5Nnq6n-w&oe=69B7E783"}, {"file_name": "2560_1440.png", "i
gEkwYEQ7kNvwEx11NC&_nc_oc=Adq9ltUQUmbXkQKXWZFIDTbmT2IAJyTbiVtmYn1cWy07o16mRBLiX8nP6MhjVi-MhpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkJQ88Dsa7pIwEGwOSgSmEThEjqeB5gl3imkw5ZM0BEQ&oe=6AD2457B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX1LamR8YVoQ7kNvwG4kPZF&_nc_oc=Adq8-fEE2HXtabmh_JzTTIJ7vUIUebZ7vHdfmP3ziFVDnAd87RtAeei52Pr4aogz2ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7BlK9NtVpvB577Q1VBvNGl_Q-qU0yd6LfPEH3wpPqdw&oe=6AD23BD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0FQzWYMA9YQ7kNvwF45hpQ&_nc_oc=AdoEbX0rHMvu74SD3T3cin9RmefCRslHD37jVIzfc80M1F4xUoXA1wqqLO4c0jkqCgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-lKRd1ig4WwSLlM0AuGSYivrHZ4f53nsGnMjKUBJDiw&oe=6AD25601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUgufg_leyAQ7kNvwFOAfnk&_nc_oc=AdrpVrNfp91Mc1w5sawGmtMeJ2r390xN763xwQctIpaQGcthynLV8ZyoXYZVpQtxTEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6A8HWqCzvV3otCabmkDrS5qNwuBDB461HDe0B2rdSwg&oe=6AD249C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um9js5iVsl0Q7kNvwE1gvHv&_nc_oc=AdqJhzvndbcQNliSIG6PAOgGl6XMp23T_nW4Aks4o4748eBAX9kZqxFRY5_NarfAGQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwponWE-on-IP4z8PBKH4zPsjbIr_NQr11YsDzPI5f_A&oe=6AD2573C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19AmRVNv4MYQ7kNvwHbCCfB&_nc_oc=AdoS9XGuhtIxk6kDEBpGCCrm7_qBDfru2O-cBOsf-epKrOaOj2lZ7L55khglKjvzCxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNED9u9yxAxO1slWWi0GszqCQ5IKNhYF4NF_zjEpYtYeQ&oe=6AD255C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
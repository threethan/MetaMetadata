yswID8Q7kNvwEOZ2ar&_nc_oc=AdrK7q3FgsgNYSjCc3rA18sOD8Wt2UWffiA2920PjTWVUWrltQFmEBbvykkDaoofbME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kYUEcl7Jigc4PTAVyx87KPiX-an2e5RvnCuhTCCwOhQ&oe=69E648FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr0hrRoV630Q7kNvwEQcqVo&_nc_oc=AdqzWt_iBQgOd5E4Dch6jEkMs8bgLJCdrlx5LSjl14ze_TiSKVUtrFz_DQsjhHN9l-4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08pZzajzDIwStDTzxNyuDR_TJKDxnLwIajtk4gRosVrg&oe=69E63F50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiGkRDkaab4Q7kNvwHs4_Jd&_nc_oc=AdoCdSLz08WwbuL8mcj6OOHVfCWC-QHqyedxI6deYGzd1p7701roo3ivtxfjiOfmpG4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r1y6RTX-L1gnk8Q8RvUZ3zMDcpEVj7mI2WUO3nrZAFw&oe=69E62141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxhZB3z8LcEQ7kNvwHOgNNC&_nc_oc=Adq4gUtbHhTeV2dkoCtUP6vOGRi0p7QM_VCRWJQ8tjYwfdSJ1gwwcM31pnk6aQT-XzY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tVCXgyVyOUfvJxBZ0rN3f-kZnWyTogatEt7PNFDL29g&oe=69E61509"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifVOaV8-7GoQ7kNvwHl067F&_nc_oc=AdrR9VOLxHJ1moiK0VybTFqfYoXpeGsn5zW-oR4xKHNa9yO9FXhBz0XfFVSshvBZHKc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kNh90fssYfTmHlFMx2OoC_nO7ZNdG4hPJvTqIlwT7mQ&oe=69E6227C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT1XzHLMDqMQ7kNvwEweRvb&_nc_oc=AdoLc6auC2D11e10a1GUuWpX7jYqZzP-c69HWYxyaLXyn86mVRuVZtzu-S5n1GNj5Yk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18kRTa01TQMuLCr5xDT9Rq0lAc8KbWjKbBSaDgVQFRrg&oe=69E62108"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
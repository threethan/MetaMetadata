eWQx68Q7kNvwFegB14&_nc_oc=Adqv8UvFCVSLJsN68s1sv1spJRrfcOUgnfP-a7MRUyRkFa-6tutVPLZR4u-ZNDyqNng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDS5WWCLXnHVQGfQRIKQiUk3D58dV3J6AKk3JPtHDF8Q&oe=6A5F5ABB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ87n-VmjNIQ7kNvwFgBOnV&_nc_oc=Ado2076jyDUhIaYDHrMmD5z_E5QCt-4UMdk6ymUIkD36clfCWDivM0gBTtDy_2Janvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCGmNKkjEM_0GXUXnMlL5RxXOOFY4KglI-vlEHr3fHQQ&oe=6A5F8950"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWfmX0x3IhQQ7kNvwFQ6VLp&_nc_oc=AdpSTW9ZuZ4w-8I9CvzcFbXVO8IQ0QdKWZTiI3pWWrlVlc4ZUDLym3md2fjxPXOegEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhWg-RvvavWRoLvGR8bmOvJtZrhxO-E1Icg5HQL2LObw&oe=6A5F6B41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qVAfgUAH50Q7kNvwGGsIrZ&_nc_oc=AdqUEVfw3sZZm9jlPgKQNjL_MdVRzGug23URFOvShxGNPVW9mY4jZHKXCFibP4mH_cg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqO5sSKW4-CRa5H0KrLDUcRTyTaOpXEjtW0C5Vjj8ivw&oe=6A5F5F09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrogoxmvpU4Q7kNvwEGjjVE&_nc_oc=AdqXLfN7eWdHSCAER1qMjPDZolYCiypoLYa-hjzZGpZPy0EfFYOsJR1NOVq7cY3z5CU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSYOYjmwXbr4bO2hX2ptRiDKsEjWu0Wb8DLtzSLBO3fA&oe=6A5F6C7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsVHS1HBdeEQ7kNvwG4gQ8x&_nc_oc=AdoV3N0vcn_NiErF9vbFvTOLKjzeWd76J2ONsRn2cUOw1aIbna_0a-GmUtuYcsMvhgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyxlMPoDbeskihrHhjUb1SBRkzBhaBj0VB1qHSC0xCDA&oe=6A5F6B08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
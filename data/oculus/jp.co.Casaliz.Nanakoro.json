9Cw4joQ7kNvwFd1bXC&_nc_oc=AdppIcZLkonxQ75iSDUOD2mhxJJBsO8Oyngh0ZYGTx7Q_8LHravK-mw7BNbJaogBORA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi1gvf6_34HPC1siD2FQZcPHD34qMJ9NGtw2lEgGGOTA&oe=6A56587B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APu3_f0L3CAQ7kNvwG5wNMa&_nc_oc=AdoDKt0LMGP57Ue8CoJcxNlPCuH8lwrngNBi9v8fBL3tw3gn0jagYU-pQ9inOOF-fq8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTCLdAnIvJB32CuR_iAZWx2CbYm7nXzIo6RLdwqxP_6Q&oe=6A564ED0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j7aoUEejPEQ7kNvwGWUteI&_nc_oc=AdqIWMuX6W_rjVq9mrDH9nB9y9s1_Z4Y0TB-t1P-LdmNO9yP20djWwpF5NewRMt2Agk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGq8H8Ss6vfzHgAcH-RKsliKo3R74iBfDO2e4wfTMLsA&oe=6A5630C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgDv0simCtUQ7kNvwFyZuwZ&_nc_oc=AdrJZZV8tt_fx9lRgMvOU1IIHNumexVoXlEh1RSLKc8D-ls9XDnO2SM69cbObhnDe3c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeZw5MHxskvgR6GYJA8kjHLfIJby2seOu_GtOGydbulw&oe=6A562489"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM-5g1vagkUQ7kNvwGOLX9n&_nc_oc=AdoRYpiU1GPTb_kLhi_iVj5dE2IpufPdPU-JvpNA0FG92przcHYYMbFwQLBumdrOviw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQB3oWz7xvijdBwJaqkcLkNF3iLiVqeUg3-bHkJqSguA&oe=6A5631FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id9_G0Kwur4Q7kNvwFzEbbL&_nc_oc=AdrZR6QYbFlIJ5Uq8hf-9sOenv4LC7bZiydGE9TqLn1hafuHTdYpolx_QWEKVBPWAUg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0rmHrGIWvuWFd0ip-0dPlch0ilSWqhQnD7JwA4npa_A&oe=6A563088"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
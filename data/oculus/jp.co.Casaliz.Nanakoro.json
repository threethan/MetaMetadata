70556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tTlvvf6py4Q7kNvwFRVxwu&_nc_oc=AdnvKA9Z4YuwZvTVmp693E27qOJpW-So0McwAZlE4aLn_PhZjDR6H_-unRYldopBkgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTRONg19wDyOIWawGevIU9GiL5R5Kfq8k6XUm7v37L3A&oe=69AC32E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrxvQ8CkC6QQ7kNvwFNDzZP&_nc_oc=AdnTvQarfvDHA1ghZsHW_wtG1NlKAKnvmME_gQMOHzrvKkDLk0g-golVjvvb4j9rzyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCqSgBVO9keKQgxys1scU5zLcToPPy5y82kZF8PNjiPw&oe=69AC06BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3fGJJIkpV8Q7kNvwFZ25ly&_nc_oc=Adm4LcE3LnevDMQnQRhGLFjJuo7YUWuQWSzmRiarJRBEubgUmkJMYvQnALlXPBlyK1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRAoVx3Tzh62Z5cdOYHfTeZU2ErCEi0DGJXZAM97ozYw&oe=69AC0231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5LL-zpv8jYQ7kNvwFZd8VT&_nc_oc=Adli0ZP7qyM1tYSzox14ARtvwJ_OA0jQWgdvyQo_RUGQsCKVxiHQ5Vk2bZ4VIXe3Bgc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-1hz9T7S4sCouQ1cXFcjtkq4R44I36lK0FcNawz73uA&oe=69AC3774"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymC5dIJhXGwQ7kNvwFtLiKy&_nc_oc=Adk9874rVQkA3WP-8JWvM0w3EKqjk-Yz1FA90opMr0T9iKRIy7O9sr8olYPXQfYvU9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0KGnNU1e8Ekw8L8r9DzeWlH4Me5XkAzR0fcD_IjCdpA&oe=69AC0D72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClyTZvmO2vsQ7kNvwGp4TlM&_nc_oc=Adn__sWlct4cVJOreN6otGCVkc_9PIcQlz623fVLjF7vK4I3InqYkMj0muvKuuvSoEY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx57IEDd5H47HNBUiBNbluBQgJNDn-LdGNsazvOa2pEYw&oe=69AC0A03"}, {"file_name": "2560_1440.png", "i
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xSegDRueKL3fjZykcB9f_IXYSBWLYy7fYvILjR73Ztw&oe=6A0B2B7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-ZGVPpW1DwQ7kNvwHCLxFC&_nc_oc=AdqyIGUfLrmeagT3ICiGyMrr8rXwjqQu9bSB1W39Wl6rU1O4vBdYnsVUZSFHJDVC4AU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RjRbqNL_jU2uBGW9naCgh8rDMVqyIAAyyhqJSSih_Ww&oe=6A0B1EE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC51SSveQ9UQ7kNvwGSfOn7&_nc_oc=AdrbWZ9zuZuw6BKnOmBRmkCgFoU_56MdUNrS4k3kttB-darN64X8X3cxzcIZxXXbID4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65xp7v-C9izzRd5S8F6nNcQbK0hb2y9FTs0dBs-3M3kg&oe=6A0B2AFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-I5tBB8eKoQ7kNvwHkPE-1&_nc_oc=AdquMAUexpBOMS5ZogNW0mDftBh0Wn8FP9n0ZH_XwBGjLS8eeXyYtafJOZdr5DWlfKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fFu_qY70jtP4nGcjsc5N4oJyFTNrSaZHzyIDtLeDAtw&oe=6A0B2671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX8Im4MCMYcQ7kNvwGWsMu-&_nc_oc=Ado1XxMlTqqRR70iTvvowiTOAhbtfdcvIS5OckNfyuwpzvAT5i7tb-DglRlk2lzLvaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zDfLW8HHZ6oR2Za6fiEoMVWpiuTSfA8TyVnQMxFdj9w&oe=6A0B2374"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfwMF-uD_MwQ7kNvwHm1NgA&_nc_oc=Adp2GNWzDUTdmpmRaUy3LlsDOaNhs5BN8SCcH-jiL2BUeASNg0a8eLj2DS3nC21XCnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_6MbFp17p233W6d5OljUMUps5IU5xm05AIDEv6LrhGw&oe=6A0B31B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYkdOGCgeVQQ7kNvwH4W6MB&_nc_oc=AdqJfxJMI5RBNBt67zD4hzY3E79TIGNc3GwrgUzQpRM7MJEevpJZGQH7eIF7
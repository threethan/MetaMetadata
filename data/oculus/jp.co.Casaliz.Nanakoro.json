1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcMIfdBBprdnbigUD1dVidJA5fyFRnpNn9OssIuJcS6g&oe=6AE4B2FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLV3ZBSqa4UQ7kNvwENu5pn&_nc_oc=AdqJx7q4ucoEhyHGODI1AWdTDyIoMTOS7XokMz7N8aBVn5NQo9E8np11q9YrexfnvWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5kgfF1LYthXWBFEbPYli9e8snduBUzlfsTo58qVoFZA&oe=6AE4A665"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBqsLwel-gkQ7kNvwHnJeUw&_nc_oc=AdqXXZ48b_a1V3LgQl172aeHmoLJkrXpR6CVxfR4Vi2PIi0bimiFnC78xkUK7SP18PY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQRuf3XAbBJ4uKMNoyKyfFAUJCaxOnNj-AV9dhwD2P7g&oe=6AE4B27B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDcekUuDwK8Q7kNvwGo-yv8&_nc_oc=Ado0nRSnO2XtkmziQFBzRUhyaJR9jRdgjgqcpfAKhBYr3dJ2o51Fv1HURS00MXkBj-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPskRZUQugrCTxzhxHe25YVDerLbcSEdSek_T_tE3IYBw&oe=6AE4ADF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZkUb0QcF9wQ7kNvwF86MJF&_nc_oc=AdrO5JorTye_c6uLLwsR7cSW9M8UuJXMZfBPJDKKILV6k94o44guSp6mERhk7R7N6RY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFqyhrFwAy8LEtBBBNeUmmRJV9lSaW0VjxtcS45nNmwg&oe=6AE4AAF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr6RgFbTKR0Q7kNvwEqOnYh&_nc_oc=AdqMsPJsYcuGOlj0Vv9o7HJDTbkm5PHD3cvMFuy-acefxZSKGEUNiNLlhIM0Lw5fv8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKTSUTlcm8s0y53_JAsqq6NX5abmtFCNRleXlvtiQ9Qw&oe=6AE4B932"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg_nYnSDXw8Q7kNvwE-Npd-&_nc_oc=Adr7-tkyMCIi0f5zlMDP0UvKF0NQfERQtNnj2ESfNHRbOrm3PEhJ2xDNuPvm
y4sDhcQ7kNvwHsO49M&_nc_oc=AdqBFNkM707HXjBHk_RLRltbfhV9xS3-46Xu7rmEiKF6J18S5kFYNH_OxbLcHd6miEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvbHJ7vRqDPBCxPzc_owJ-UOhTqaR8xyC_7zDs1mOV3Q&oe=6AA2CF7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khfuTsU0puEQ7kNvwH78Eua&_nc_oc=AdpeI_WzSLRi1kOVpqSFqA3qgf1v-cMdzLlzMG0VZv0Drg3sSKBygvG5KhtbFyksiuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc9kCVyair8kCQ6psOSKAsdsUGnrlCD7OaqTLvvjGVCA&oe=6AA2C5D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzuC18BzbUEQ7kNvwF2zLMl&_nc_oc=Adp_h9Q8JImK8poftc8z5UuJfe2TuSsPi8bhZkER-rxCiAz4gnkpO-hjVNVj4mI6HKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYnCidS2JE3slivAhaiONywEj1p6XQ7QMSCY6VKDF_IA&oe=6AA2A7C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmMOWrV0I44Q7kNvwEEsYDS&_nc_oc=AdqK5C44qQtR3147qJluxUAU3g8gdV_jL_J_-PBCW5xbGtXWi0F0B3WC0uOeMr_WWhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkidQ8nE71_XO3roEe4sn9Vs4eKG25mdXkyjaXu3169w&oe=6AA29B89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz97jWCJ59sQ7kNvwG0u2x0&_nc_oc=AdrWvRtF1rA8OSpNsykLVrnBLuKAYpEB5XNR4JT9kSZ8Ue-LzoEP_zWxiW9xJOyrdyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEavl8QQT_wTdA5E76FcS9Zs-fvJkTJcfS0vX2I1eL_A&oe=6AA2A8FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZN-N99P21kQ7kNvwEDVp5o&_nc_oc=AdqHRWB9LGxiZe1AzF3q5FDI9Wwi7vf4R1aaKv_-X8xG0BM_8YekIDT2T12CCKbeJM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiYGp3IxYCG_lfpZlxXpTr6W8FPtoukUlKIfgrarIbhw&oe=6AA2A788"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
0x7aAQQ7kNvwGT2wo9&_nc_oc=AdrwJasr4wkNXQDryvKQmuGvRE8X6KDbcZ7jgbMoFANE5SBjsCt13Mvth5Hb2tcezNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwM5ZDWWPMMSPjgZuU2R-NCS5wbaV9UVn_N2iRAH_PJnw&oe=69C90FBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHRUy1JcMhQQ7kNvwGQ7Bqn&_nc_oc=Adro3sjbJqnProAgwIIFpme9PNm_SJ-gKBNMu0qSl83LX5SFAaPNFHwgT36J-mvRfYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqjW2U0s3OiO5TynKeiZkpSm8OJfnXC-KGtGHMfx7O_Q&oe=69C90610"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16VwdoLdrvMQ7kNvwGuyXPF&_nc_oc=Adr2lHatD8u-zLW-CVLcvG-ottqrKCV5vftZYrTVkEG2WIuFjtmaa9Hv3xh1cLXYXo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ0PA9VrgdaLMt-UaS_o-KyZERE6sUm9YwQk8bOUgKCw&oe=69C92041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aemVJDcoD0Q7kNvwHaoZDL&_nc_oc=AdqgmhRDZxM5MkAOusSl1Y0osug_Jv6tW_he4Xm6lJJrMuu07zq7kNEosrAW1WkLzis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7Y7WTXN_Vlv8gsNNxDxZvXwVOo8_F1cdhsPZTONJW2A&oe=69C91409"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyWoTwIY1skQ7kNvwEqqDOy&_nc_oc=AdrtcVnsLJ5lKHm2kgj4dT_MX6_zTGX8rBzYBBmj6AxAXCjM6NezzlLc5yVdtHlZVWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJosCcWeFOAt1SOfjn1EfIFDlYVNL0SViB6HRhyCwxPQ&oe=69C9217C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkEhkWmbuXAQ7kNvwGphXbH&_nc_oc=AdoXmE_5qlEZUaJ3WL13wLmC6YqFnqDy0s_UAwCJ4EZVD0EDX04b_BKM8UHHF1ESTfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbdROVg5kVT-ppp8J14GngLEiAHd0pCbS2FCxSYmsEww&oe=69C92008"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
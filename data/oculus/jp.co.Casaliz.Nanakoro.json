s68LRoQ7kNvwF3jplm&_nc_oc=AdrildZO8BVrPaHxOdNW62fCpsMpqSXLEdXPaMcn4VdP7SU2EDvbxD21qxvvaqPfDBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP45y3uFg5Ps-MAhQpzm7MkNNbfoNkpfIdOsYfXfgo6_Q&oe=6AE0C5FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umvmq411b5YQ7kNvwHmldC9&_nc_oc=AdqSmAjnH7wKpCq6pDS-2KXyzu7q_vsGwr1iRJjiDV-r6bFLLuv1GmxNiyqQjqyO2mc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI7bWUmbl7i9JUmDhDkS1FrvVU9qwXTeOL-982usj9bw&oe=6AE0BC50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCERD3ovCssQ7kNvwEDHL2u&_nc_oc=AdpacW_SgvCyoezdvdK2BeDeWYkNUsxieuNEg0JhfIhSKNE3gNARTHxACfy3_rPyYDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGWgS2FRT-P602jZ7kkHZN3H40c6TPL__6eNW2L6RrsA&oe=6AE09E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQk_7lT7pvsQ7kNvwFFmJfo&_nc_oc=AdoKzrUaiPA6unCC-JSTLSl-Ap1v7N1bjWmoKw44sTVwX2qt9lZyKYmG1WCaub97W-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-Dmn392ZXEwuMLp6_XPXM5L0u11EHwb00-zWloScBnw&oe=6AE0CA49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyh0JUWxEo0Q7kNvwFieHnT&_nc_oc=AdoudHTrFWWLdKSyBINAPQsRXr0eyvYs3VOGx3nG2jTZs_X6aAivEEKMK_yDnbnPtAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpbqthZYo_8uIqyGvGLE-Kqko3sdLzk2jblndIqW2mXg&oe=6AE09F7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dSAUGgJ6BQQ7kNvwEoTMiy&_nc_oc=Adpgu-eUj9W-xiZX_cyR6O7mN6FibCNFt252mL4eJVexVdmjj-f_BovzatQQV5G3ts8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe08enccwn2mQEP0wrxsaB7iIjNrwiDE8AdZcwxCwbwQ&oe=6AE09E08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
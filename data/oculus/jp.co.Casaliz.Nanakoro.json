1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwl0CpKWj4JnsvQk-Oc1XPcHkOzJLndpz9WYcQvsr0wSQ&oe=69C513BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKj71YxlUCQQ7kNvwGySakI&_nc_oc=AdoIojjQDwMa-rjxWMI8IfYiAZ7wU8xGhi0rvup1UOJyi8VKk8j6VZLffc3kqxjgHwU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg0IPR6kGiwddvGM_CCiIhu46wUqFdgceovM4i4mHXvw&oe=69C53F65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G37_JFRDkL8Q7kNvwE99yGm&_nc_oc=Adr-R4dqzE0CZdE1VlNLIIsNGRY4yMTMKWxJB3Q6YqmyPWFU220W7t1prZ8jV1LkzmA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxnPBUOkeWfli-iHEgnxpCmDRxZgJDnBAK2UUkBjxeug&oe=69C5133B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADI0xjqoLuAQ7kNvwGIDiJ1&_nc_oc=Adq3lgrHdMc11_rB2u6A4-iIojB8bGfTo-pQzMkQFL5fjjiFcmUt2TTMHzd7oqCQ9e4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvOChXHhS_BgZc04Iupk3yUmcqzIXwFU1DQcpuENmvzQ&oe=69C546F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTZAVHrqLvAQ7kNvwEiScK6&_nc_oc=AdqT2ublKujmTvP2WGkGyEXNt002ALKZfxehDX6O7E7gWd8U6gv0RBTcduxzyuTF7qs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz53tzSnHUNhjKWd4S9M8-tOoYB52HJpjTFyX7qS_YdvQ&oe=69C543F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rmcnEKzU5QQ7kNvwEBU6B6&_nc_oc=Adrbos8B3oecYeKYYXKi7s-H5mL96hmCJai6PAbrYWaa_K_XHKKyG2M0eX3_WcIbKoY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWjOGwbDDy1JRRvBKZD7nTUAYPYCodG-8uYKBFyIsULw&oe=69C519F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jleE-_mH1R4Q7kNvwFmm7vq&_nc_oc=AdoT5gmxfRxHOGQXBWyI_m8193yuwR8-51M1uVL1gAqQ4VMmZTNJo_G8Hxp-
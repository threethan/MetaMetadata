YgY77Pthv4Q7kNvwFbFuwP&_nc_oc=AdrDnjoUY5FKxJEuialc-KOr2fQOS0aARFebzYw8Gl0xEsr-29RJSaa_eALnxgyKuog&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xe1G1N9okHwLk9CnDe-VJFwvjL1l8VLc-nD09WxEwYw&oe=6A11CA7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0QcasMVrNwQ7kNvwGMupZE&_nc_oc=AdoPYVhHQr3xxh6vPw_ZRc0d3c20zYrGTlJoWhOh61T-wgCww5twbvQu9xuIlBE3WIY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bTpNjroPjwPqEGkqNdKcYqEevhdZiG9lt9rCeJSwP6w&oe=6A11C0D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWR0Ds97hQkQ7kNvwHyTxJb&_nc_oc=AdrfCshPmCEg62EwDOiQVZSAwRIL3AiTSfIa8nno_-2Yoi3LwQvvW39GBjWS2ewwOzQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71WTOyZ0mfQhJnWJa4rg72dCN3Ib-U3-83lP1TNQwC-w&oe=6A11A2C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpAO8YcmQmcQ7kNvwFySpOp&_nc_oc=AdowxK21rz9hxFIaogK5yQAwUqy4bNvg3SVxzvtoyoToRicZBOvNRldvXBAGD3lsxes&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46R1_8Z77b-vnJuamvAJUHsbyRHCj3593t_plOzT13Dg&oe=6A11CEC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB6FNDV06AAQ7kNvwGXfAcs&_nc_oc=Adoy2ni5ugAYqGsojYFf9dkTpYmgYPJ4H0gcaW_6ejztEaYjj5JNkXNFSV5dsdneWlc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Oqdzpi-blpuHdhHTvv5SA7-s1F_OzuQJqit7XdDaa4A&oe=6A11A3FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhI295HKUIMQ7kNvwGmKVDo&_nc_oc=AdqfSm2sNxkh2g12rY0JfW9te0J5S61vaLU7qAI0zg7s25iCWYhJynwMqIwkY7KYQI0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IAjphv2P8Fq9KxfZddRXaC9Nb78J-RR9PqrgrRUXHMQ&oe=6A11A288"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974714_10204990
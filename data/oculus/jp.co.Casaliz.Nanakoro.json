eYx47cQ7kNvwEMCAo8&_nc_oc=AdqJSZ3r4YKdFQFe86R9NkvT8WP8HH5Mka8p3kuWR87HNSpqIsuCwBc9NklKib1Oacg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tgrTlanIYBOWILmyAaG07G7_FI7ZMJXzlS5JlRBPVAg&oe=69F61AFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZoPI9YfAUMQ7kNvwGk9Dfo&_nc_oc=AdoixXBiZpfwzPl4Q1ae29v1FWABFNM_-xN9Zi5ZLqX_FGVg91kDXtuW09VzF5vnrsQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13mO78vWMlpQYj2RCJE4KnfkSbOYtAPu3IGFUp6eFG9Q&oe=69F61150"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci1iFVS4594Q7kNvwHper9f&_nc_oc=Adpf5d4kkcc01HCSBsI1o2jzUfQN2qloizD6PNStFjIPmFM1f91fDiIdiRqPalKymVQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MlQyrh3kN9Dus_l8cM9qtn2pbZtV976RbC9g-0A3fTw&oe=69F5F341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNZ687vt-sAQ7kNvwHME1rd&_nc_oc=AdrS2fbHBs0XJ7Qy1DaATwx4BhcjFEWQJGH3H5UrqsFPnbPXo21sn6n2rZLbpB3hmtk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MBBBkSUZj9wLUgxB2WpiDQuBAiTriZgDf1x8Z9QfV9g&oe=69F5E709"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiHFlljmHKsQ7kNvwFI1Ani&_nc_oc=AdrDWhXL2J_8q-Jj5o4BVC8uhgPkYFlVxNHR3fNULnijNsTC5X6aEccyEB4OTuOsPqs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gbHDGOIFlQ4qs6fzD1fpUGUJdRWtiN5ctSjeUbXj9hg&oe=69F5F47C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkEDtulm4IAQ7kNvwH3GbFT&_nc_oc=AdpoUOPmLkE9bRr4xtOGYC_C-T3kQzUjIQ6DPAlRsAl78eerNoC7i1UJPBM_ySueZw4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LTuHURThQAToHGAxg77xFxudHNprDonNBVdzUlpOL7w&oe=69F5F308"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
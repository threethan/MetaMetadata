Y5Q5NsQ7kNvwHqrhqt&_nc_oc=AdqcwwVQdwMmHJTgqfNITt-aMw2TkW9meB2lfV9GWy9WmNpEfvz9-ZZyA_Lq4RoUXiA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3RzsXYdQceUUQxAVuRtHUTPJKyX2lEpoC4TCYjLPupA&oe=6AD0F3FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX1LamR8YVoQ7kNvwGBYcrZ&_nc_oc=AdrFPX-cYbEbiSweiHO4qSFxp-sTBq4jprF7bNZOerVUFRRjwED47TzWHbkM9PGuJRA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXXqnSRdmukZezpgX9_QHZWTJgvyt2JeuQ-GPraSi48A&oe=6AD0EA50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk2N2p9lPrIQ7kNvwGvbPVS&_nc_oc=AdpMMiYKa5BaYF1lUMC3gOrouIv3fKYesuLppndF_zKgu5O5D6dTSh9APZEbeEJhGwA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9IoZjA35q_tI8CdWwEp03EfO1FCJk16Jk-DYxxhNyRw&oe=6AD10481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUgufg_leyAQ7kNvwGLARNJ&_nc_oc=Adq579mqJsRsrYIRzBiKcBkzuXiry-jStKRxJdvWk8nMP-PLKNE8gzbMtNM2mNFZLBc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMZ8ukDw9xN3RRmes44Xe49wKuhVYemmx61dUUznmp6A&oe=6AD0F849"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um9js5iVsl0Q7kNvwGdJcSD&_nc_oc=AdrVkoE_j1cNbVD4dQUkID9Qv9JDB2MjwH6U8K5d8yhmZMKBbxDeQryw1AsAI-BGfxk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyrSluZqwOWWbBHfo2wv1od0BrBEeIiZc28Btv5PJh_w&oe=6AD105BC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19AmRVNv4MYQ7kNvwH0qOKz&_nc_oc=AdpoOyhTyiB55vKX4PjtA89dlmeydKq7vIxJlbi2nJOh1vIvpEm6_i4InLcgLroj_9s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMHmTCZbRGwczf34LnuUf_YZaOAn48KoX9-2xMsVx9eQ&oe=6AD10448"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
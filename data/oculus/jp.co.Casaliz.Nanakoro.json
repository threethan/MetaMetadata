70556961", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFU7qUBDVRsQ7kNvwEetrG5&_nc_oc=AdnRX0lZQ830SU5xLbmJxUWQbQEA8SoXSFpGLSf93G8qNxgUOaWjZ0aJ1Oj8Ji2Ynyo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzo7GbDHVM8Z5udkJp2RaadLy_gm2LmOUY4HvG0RHsiCg&oe=69B178E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPL5PHoNenAQ7kNvwEckA6G&_nc_oc=AdnIfWQish5hitqCGfaSk6sW_8mWJz-j_mJi62m9N7jXZVLhIMNAbSl3TVzwbYO9pmM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwu2QtZ6U_4sk9bjZ0wZzM0RN2-k7c1Ri6FLdHOJAZ1GQ&oe=69B14CBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcqVEaIO1IYQ7kNvwFrLfiC&_nc_oc=AdmtKXG0eORdMzGRGE_EGyI590iWCsKL31qqPIvwcO1PktsWWFe_qwfCM-f7afQ7wHk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHMA7giyGK9EEcnLyIn5JWw639R-FZtYwBwCk2Lju4Gw&oe=69B14831"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AzqR1GN2WAQ7kNvwGKn09b&_nc_oc=AdmuuLDn8lQHfR8Xy3hLgb2qM8gpMNwlUZ_3Nd6XP3mA6pO_OklOgv4J3cGJzgq8FfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjXmqoOGgIIMh9AH3BHj642Colob8nfQcMebkBnFCVjw&oe=69B14534"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX_iQzbQHBAQ7kNvwFrNAda&_nc_oc=AdlsIxCzVnsz3lwxz3l6eO5bMvinEzj4DEGYIsBD5Dx2qDfPvi6-GgKWazSJIZ8nd5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw10wiId47UBP6xqZ8Yluh5zqkjvEtfxT3LGyC2OUiQBQ&oe=69B15372"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ftzQRK91DwQ7kNvwFo7vc2&_nc_oc=AdlFCKbJFe-1wjotB8W3L0UAhmyCcWeoiOhoKq4-hitWCJFQfYAN47PRXKEUeWn1JSA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ4vS_pnb83lbnhjRMqZ3yS0zlPn6-b8_pbPGVJ0C5fg&oe=69B15003"}, {"file_name": "2560_1440.png", "i
eWQx68Q7kNvwHEro0P&_nc_oc=Adoqlsyrko3ZG2u9AKeOkrY5kv8W3yikqWoVEUtYiXpCExPtioKhknSBqLdroQx4o7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZcq769eSPqpm38eZBmsNyuwFh13zSHLXU3IyhXWz5vg&oe=6A61FDBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmjkCHDmwLUQ7kNvwEQWgGz&_nc_oc=AdpAc9BfUfj5G3xZiiaQ55HUqGCgnZhoFqMIPx94jCC15_2mAa7MVL6kDL5NJZ2bWdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMkOq-cYKMtCmOamdVL6LRAGnnxlIug7MMKZeeE_9ahA&oe=6A622C50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWfmX0x3IhQQ7kNvwG6wpby&_nc_oc=AdodbntKJQMuJ_11e3wil1gM1OYFvJjaiJGhWmYO_NN6XSM8ipy62nO9ymC6Ug9zkIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZQvEK9iTUTTMdgQL4gtYkl_uDzoofOKvbvDNT1i7NzA&oe=6A620E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgroAO-KkUsQ7kNvwGch1Pb&_nc_oc=Adr9dGz43jeFkquRgDGRRcOxEJwmq8otWdR5-STTxd2hqciurwFDU3L5HKhEXObPPXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4pd25Pl2aSe9yLhR8H2xBztwk707HHyVvIfvZxZV0VA&oe=6A620209"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8fKcMxY9gQQ7kNvwEx7RWf&_nc_oc=Adr_r5vjt-1vshk4a1jAGz632DaMiOuAeI17afvfEYYVW4eezljH0_BriLU6HJWwPLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMAxfJ5p8hYcQCMhcgCvcdpMTpRLI9VqidUOEtOJLN0g&oe=6A620F7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7NAO_jUE8sQ7kNvwHUwDNP&_nc_oc=Adq6h46dWXhQzn06-ckSKuEzxPcwOQYa1aLNunu5M6oW0zPAAKMVfKiR4fcznhg_lWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeVrQhW15eP268xP_7VCVmDMZG-mQBjDQZjI_NL7ZYpQ&oe=6A620E08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
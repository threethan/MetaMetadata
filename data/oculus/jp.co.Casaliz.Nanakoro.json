eWQx68Q7kNvwG40bQz&_nc_oc=AdoVc3OAWMpYqAvwLPnw58KQNE8YgtDrPOxS0fTeTE_bb4jc1Rf-AAnFuIfMhtYGpfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC29NMzbc6xWYhTGv1ErkgIqdv7LOCgxzVMbx96ZCRrWw&oe=6A60AC3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmjkCHDmwLUQ7kNvwHq8TLY&_nc_oc=AdpIPUX9p8GQ8LFRa-nMk_JFXA18XIaqemYe4hVNgTw8m968RWyW-shx7YvWgmd7C2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNyycudEja9esmbn7bUwU2LPG86mfU_vlHx3bCr0OIfw&oe=6A60DAD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWfmX0x3IhQQ7kNvwGc_b_j&_nc_oc=Adq20YQzVOPjfefJ8ZYaRYaMW9qdyZXjt3_10rIyKAU2zg9gqCU2zP7yRoHoMCcX4H4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwsvOIpk5WhXBo20c_Sap9FHbAZ3eH65PJ5JC1GogCkA&oe=6A60BCC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgroAO-KkUsQ7kNvwF6fdyu&_nc_oc=AdpTH3__QomOJgLvGa-iRvAIqfRfKFUPrHVvn4AFVO-eYZNyLj6_BC1b2us7ClPXc1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfiOBVqNvsn6DQPX0UBo4Ne43-2BraL9l5Knl_-6NYKg&oe=6A60B089"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8fKcMxY9gQQ7kNvwFSO911&_nc_oc=Adp7nCJ8MZeZGbXP5RtzZ87orkxVpmeL7Cnel3WKvrVfW1ONYNKPjZTG0sgvVcTg8l4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5g6irL8pObPy5TAHyKOz8um08Hbehxe-ZVL6eRAJEHQ&oe=6A60BDFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7NAO_jUE8sQ7kNvwFbZz9p&_nc_oc=AdoZgDpGR5ERj9xzb-hjfB2WN4gnChGiq3NX0zbMbEndot-wYJO9_jbJLuWmPd8W2gI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF-fSuXDrTjjY80AulyBnudQfz7WhbcOCNzsL_WNKLrQ&oe=6A60BC88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
3PMvd4Q7kNvwHkoSfT&_nc_oc=AdpdN9ygyZUgpbX4szQdgn69eRuUDWCeovAn-YpHH1PMaS7G8olX0qsdi-CjXQwaDgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4kBn_SbfuXW4y2VcWCPL-Ktgs4eZYlgSJ84jmICLgwg&oe=6AF48C7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqJuML0tag4Q7kNvwGcWgik&_nc_oc=AdqwJt9hc4lm6awUc8bbD-sKQ-M8TIP_dygnkCRSGb_jqx4YgMZ1z43YnmFtw5y-XNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbmGIwWp6JA-HcA59Z88mKtTSUCyJzllKF0UNWMAr_ew&oe=6AF482D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-4nF3aasWsQ7kNvwFVfB7f&_nc_oc=Adok2B_wfrB6ajvjtDhZg1LMEr8M2MuKLlBLGdCLcR6t-NsQ7JclN-Z4mshjZGXrR7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQctOlUKc-fBvGK_i_8DxJU1GHXGeLqbDX478dLfQ02QA&oe=6AF49D01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i_yKkN2EggQ7kNvwGc2nah&_nc_oc=AdrWjytNOUtLlqSdA3MHKrm-Iz1A18H3_KbJUH9D3Bdyxjk9KtpYExnjvyF-XFe4-ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWzGEKVO0384r6taNDqjcw4mDKHS6OKRe7KRhUH0IyDQ&oe=6AF490C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OngMvUbukUsQ7kNvwGrdLr8&_nc_oc=AdpUR56NLnOljKYNEbM_qyTW7p6j7i2n7SAJi3KEpPWH1aF6lq71l07xvMFSMWjhSY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9IogPmJKrF10jh11UzCFFglOQxyfqn5ExbO0pxqKVWA&oe=6AF49E3C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma5Ki2CBPKEQ7kNvwFmu30O&_nc_oc=AdqHuMLSaxDJrcoylYe2DSZbHPQ408Y-JaaBcqvkeWOkw9WoYPR3DA5jFFytmwE72CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz0bqhz-hb2_51dWmxmYTDhRScRytccCiMMvpaVdcAJQ&oe=6AF49CC8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
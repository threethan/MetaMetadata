MP85SwQ7kNvwEtD4-S&_nc_oc=AdqXq-oQlfBRtbzlYu-wSl4V_2Tg1BM3B07bct3-8sChQC6WxnYIU1StMTxG5xY6MDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eyPIRkqUASLULrSeO6yiH7Np2pSxlXGZNa-xctcSX7Q&oe=6A2833FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxNCQlpbttUQ7kNvwF8_rM2&_nc_oc=AdpfBcBttjB_vQoVqRV3hqamUvD9nVaVYolnMlieDpHuRDnu5wOerFoTORPc_uOE-HY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9obaeXhqag9FSo_8SMwpRxXRspSGPsyJzyw5wgCZgXng&oe=6A282A50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzBKxQzvkw4Q7kNvwHVbig_&_nc_oc=AdrYIiTKLTSjCzA7w53gSLBD0z2Juqx-s41AhYmTtDvIol77Mlf6snsCT88XfEpIQNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AMBz94eJv0-2nxScsojjmKDPDlz75rrhIQ5vzh4rSEw&oe=6A280C41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2QcEJGQZJgQ7kNvwGBQnyU&_nc_oc=AdpiD91yWS1gJ6Dzf5DD8FmIYzAIEnHN-8VMW3rBvzqqwopjiDlFOfbVwsORPa7RuHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qc4D-dBSZZvWl5AQwlVQlPj-I9oIzmHttCeQkCy7NPg&oe=6A283849"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jAn8U0G1i4Q7kNvwHh_4WU&_nc_oc=AdrWKoGsTk-YrsECwKO8GdLpqM4emP82Bw5Eg-cXva3B-P9JFw6UfgRwwtVcdIabA80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z16hIj2WU1sn1XF7gcvypEP_yXGBOoTWmE3Km8WIczg&oe=6A280D7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmYA_cess4kQ7kNvwHxK3O8&_nc_oc=AdpuG9Bb7xtyP4b-m_02-cRadCI0SoG-biUvmbbcY_N2P_t0j202MzgKRARRTny1-QI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PmXeFDBPIVo2RfOS6cAxnyv1jxjTOebo2OrZw_FKJeA&oe=6A280C08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHE5Ibrn8FHURahBCjQTU6cPXA_umlufXdWyoFIjbQRA&oe=6A4BC4FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT96aCLukRkQ7kNvwEnrgzy&_nc_oc=Adp7j_A_Cv73IBTaaF6MQsY2-LjHFmNCAoVXoMjPwMCrV6Ck6oqVVzQfdNSMSLXvlvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8jXB7pBE8-FMC5kOZ3OJInKw_jsCzZLHYdy0SmCT3Rw&oe=6A4BB865"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbxS6u2ud7wQ7kNvwGcJfxd&_nc_oc=Adp_C3Dvydi8xVV437Q8aXXfJoK1htHgX3HKXJ1L-2ApRjyXq7j5QKo7Q_GFlx3GU30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuSVwifUgJUmagtbd8-Gt-1_BLha4Lf-ySGFz9ZM14Ow&oe=6A4BC47B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOGS4WJMp7AQ7kNvwGUIh6U&_nc_oc=Adoat3vKtRXxmNSd9fo0kXLlSmDaHRGldGl4D49rJzQ5A_xetFXxWMSkx_yDbK5b8iQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC7r9TGB0rUAqjZxhn8UpRcMc_Ur8hDvZZxVOCiWR7uw&oe=6A4BBFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyXMtAAyrksQ7kNvwHfw5vs&_nc_oc=Adq1sDW9rsw2b2N6EohsUxyzCgwZu82ouKi6_9vlC_n8zfbbQTuwYKYPifvkV8ZpGRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhE5582CqHbsCWYczyrTUAtAxeRRI31bsdhNNPy69JSA&oe=6A4BBCF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvC54znvDIAQ7kNvwH0YOgT&_nc_oc=Adpc8O_VcIS5biyCclW-de0Hh1BQXDfzt1l9CpjfFfMwUx2xnCNTy0B2QVIMf0WwxGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM-BZ1Nv2XFIWAEJoF0zj1po2tfuPwU1wyN0ietNaERQ&oe=6A4BCB32"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KXSTGZge3gQ7kNvwGW7uYI&_nc_oc=AdqIDqvPYGq2Z5u6wkSgEw29tHq--VDfFkU7MgpUJWpIbYVTIuuY6ZlTK7ZD
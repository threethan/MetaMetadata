2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfdZ85AuwofTYT1OBkBl9ndDGSQTTyhBgheeLh-jvegg&oe=6A60A4BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RID0jpl-8NIQ7kNvwGGHHYz&_nc_oc=AdoLibl2iZZpfk_daotVqZ136fj31rzeDe5mMLPzZGINW-C4OLZR9ByqhunoeAMjf7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXdeqw-Qn637bLjEbkkxJaAtJgJkLVgggO0Bi4S2N9wg&oe=6A60D065"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AanhA0kZbawQ7kNvwHeAZCB&_nc_oc=AdqAPg_ph3JHbBdLo2R_ClL1dsc1ykpKY-mnHaWaMYwpgyCuKk1Xhirb-CG8vA7ex9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLj_Am179YBkZ0ePEQYRy_0PuvPDJEUUXDs3pojOOlLg&oe=6A60A43B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKYox6OQytAQ7kNvwFxbqxy&_nc_oc=AdqcA9hx_neLYzqofTrBpdgyCaORn4SWUKrrVrpli0CJZSkVpYWxzLVfgRYDNFXwZvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlUnZoJcGEGq-7SdW20C4Xg2zqWxBYZrCjMGGH4yYPVg&oe=6A60D7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT1Qh5reLiYQ7kNvwEXEDVD&_nc_oc=Ado70Z9xmePDwHdDtAqhflxwkRg3Merfrf-ozEykVxpPoSbEractMVKbAVXcaL7vwT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2thPsK1Urx9WKwIFSwPrtWI0rkCodDGdgo4UGC3PLgw&oe=6A60D4F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD4gWETwOdoQ7kNvwHQhpPt&_nc_oc=AdqQ7frTdjTuZXVDZVr2DVmVzGdOmaCCBMNCYB0vQhMMazE4_xXCHHxj7ASzOFV9l-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANR6j9hIgKziMKqOq_UvPNqYurENlvnfus0rxNjORBHA&oe=6A60AAF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfltRim4pLcQ7kNvwFQLsf0&_nc_oc=Ado1z7GgTROj598IGzaD7C97MByG-wgJrGVeKMQTfMrmQfGtadfuRIlUa2h5
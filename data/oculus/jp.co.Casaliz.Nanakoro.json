T3FQCUQ7kNvwFm_TPW&_nc_oc=AdpuFCXrUm6ZbzWeVCOr3s-lGncUtp-owf4QahrE7hcsw5F1_UJl3fbh29cSylT1BLg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wFFNGfTpDcxR1eJqzxdl9nH3LkcgtmAaUNg1aJXSFmw&oe=6A0C847B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9LMTHzDIqsQ7kNvwHQEAZC&_nc_oc=AdqLwgPXz_uCFA1wVShwCl1ApLqwFX8sNJqvnw0XPFBm7kgd1My-E4CP-Ph7Uy4sb2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72j1JtNy42P_sZWC0ivKOMrtso3ZGZpR7hFej8oX3d7w&oe=6A0C7AD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbM3R7JqZfcQ7kNvwEPn79r&_nc_oc=AdoIrHh0VaWs4l50sQneBQUCR7RWBZtZw7BLyyBBwYhMdaYGs6HWDhifyyyukt1Zg3k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AtfQNZUsLof6B3JTwyuDgqsWA9ug8-1DCwzwFKFJikg&oe=6A0C5CC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqSeyUwd_-oQ7kNvwEimpvA&_nc_oc=AdpXLV8JRbS_ZTzsh_hgHiCTNUpOq-S33GwLFHxY3fZQUPhu451TdySFH4OsKkiqB6c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xCG7srlLPK0SR47nw2_dPWPKwRPPX7WZ1JnRKA0sS0A&oe=6A0C88C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U8XatFYVM4Q7kNvwEOTov6&_nc_oc=AdqKJXHSg_SmlOZnqx1j1XWZgg_h0j-MJLc18Py-ShkNBfam02_oXvENQLzNosOEa2I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S0d5ibJe7g5WgQZ0UAFSRHWPStH6lElKnVLcOixFaXg&oe=6A0C5DFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLEcFLn2-74Q7kNvwHave_S&_nc_oc=AdrJQxNIq4cuZNPqpxvv-pNJjc4DkObGPmxV8kQAyP8Vm_skJKNJBbo1DVKg-JdsbdQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BP5EtCaMz4cCOR1ofKGzSRTn22HUgtVOdRPm7sdOf7g&oe=6A0C5C88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yw7oCdttkndEpJtpCfhPIKmw1dYmiPdOFBaoRrlwKpA&oe=6A15B77D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dII4HzRf22sQ7kNvwGxGdYt&_nc_oc=AdqX1RZwa-pxVOf8KgtEh1HlaX9E2d2EC7_bjyGCeSR-wDYJSBeITOIweopqnoeiNso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71bLOsNfxEXWowpY6DjnqfpkCnZ3GUVD_eaqr5uFjGMg&oe=6A15AAE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNmQxgzmW5cQ7kNvwGVRqP4&_nc_oc=AdriVmgmqv-cCrNcWPyb50JRIP9fT8ZL0hyz8nd8JRAKdsV76q6463NeUhjeLzwVzSg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B0mYMi7H7JCSkhhf0GCWjXVLvpC26Qkv7C-kA4VZ5fg&oe=6A15B6FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D3J7YvkPscQ7kNvwGgELEl&_nc_oc=Adp-xvZ3j-DoiUhgPFTs62o-F8WcXoM_X0skcyS64UQ_urnHCgGIUjKi3CmmMzlQRuI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C9IIM8zeej94bYrVeXH-Xco-x_IH-t9rOMsLJRsLvHw&oe=6A15B271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z453xr9OioQ7kNvwH4Lymb&_nc_oc=AdoY48ikF65NH8VWj_Shca3jE9gys2n5wBlux5BV6hWMjniEs-eBGw1dlL2RSsvBMJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iqClhlKG2nu_wg3zA18R-PKj26aVy9b7n4VTkbGtHWA&oe=6A15AF74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRpgS8EidAcQ7kNvwF7SQMq&_nc_oc=AdoRPvxP8Quu_SZBPH0Jv0UAu727mW9HOtEYtvN-hDHSn-KSzo3dDsAG_tmsYx3vEE8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E6A9lpNhDH3OuSK8kxuSH3CoF0Sus9KtQBMlIBsZFVA&oe=6A15BDB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atfUJBxGcg8Q7kNvwHeqAUL&_nc_oc=AdrKEi7KkXKoSuyVCRG9Ktj64lXnPgziXJpU47EK-ng3E1WX5H-y_KN7kCAx
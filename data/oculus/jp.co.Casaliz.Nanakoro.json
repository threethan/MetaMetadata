1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wQOFEY738nEK2wnZbysYhSyzkW9PqOUiTeoOkdi5uyw&oe=6A2C20FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szxCCtCJeb8Q7kNvwG-vwlD&_nc_oc=AdolyyF4de1XBe9v-z__biJmc7VzPCBvVOsg1QN07og22xEemTBxsvlyQsqOcg6iBoQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--hvCJHtuERPbVY3RR7FURktBeqmzeVbPR-boaJSub1Q&oe=6A2C1465"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DTPV_qLs_oQ7kNvwEcJadD&_nc_oc=AdpEKHkzc4VPnmA4jgc-OUKNXF0pOaUz0d4OCqE-j8JQUIPV3ztQEbh1aQ6fnxMplXg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_54R305-KLENzM9Y5zh-z_oO2BunA_YiPBbPW0B1PiTw&oe=6A2C207B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPC49rJJnIYQ7kNvwEB1Q4g&_nc_oc=Adqm4S67ZS2KPOLggKlDVBOA5F07UtD_zA3euVl4W9-moEZsLNW64frTkOPdobHLzR0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xU4fXHXYxlN3hWmdCdOnRTHO5hosdUmkwEYre30cwoA&oe=6A2C1BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGaWybLh8YkQ7kNvwFBEBM7&_nc_oc=AdprtTCE3_W4Sl_n5dWGxZnpYF6CN8_HCR4ZK8ceuaB-QYJLOdOdlPWs_7Ilv-ZNEsQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F4AKMC2EwfkXPJkfgNJNkxInAvShIV-ZhvKS-M5U72A&oe=6A2C18F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWpwdJvcE-IQ7kNvwE-85-f&_nc_oc=Adp-B0LlYqZ2rXULBcjaYdrhjgjJLMIbx-4fLjDC2ViHLXxTs6cFXb48uAnRaMOCuTU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_D-n4hL3gikrrkEzT6vCflccN_4qLNDB4vKXkgZCizQ&oe=6A2C2732"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKgfiA0MvRAQ7kNvwGEuRbH&_nc_oc=AdpHYmeOvD551dC4JitQMc0uH_YvguOhsvhco0gw_5zVEGUzI0NjRGV80VrP
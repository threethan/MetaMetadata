2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQiSK-HAtZ7c7Xoy6ULdko2MuBNEeYLhzaMGZjHSe9fw&oe=69CE4E3D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxdHfbHq-oQQ7kNvwEb8X0D&_nc_oc=Adpl9shczAEWRhzcDcSx5kThgUL3kglv_XO9VXwNAvig8BtzQX4uM-IukQuofWKUbZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM7jw2eeT4uNyWGNkKLuLh6gWpPSshObmbOWget8fewQ&oe=69CE79E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWxg8YnLoDsQ7kNvwHzwH10&_nc_oc=AdoQNMSI2puoPM1alP9vO4q76GKhgAN7tOZowipORBnbOSh-kVZu3m1tct9YdpgOR9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztcuNmMySUAsDFYuXphrjj0yGEczpdp0kI1TxFPFp-aw&oe=69CE4DBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mLZS8GFB8EQ7kNvwEO8C9m&_nc_oc=Adrw5QuB7w3iifq12VymtZAK-JjBf6OblkLkkpMA_DIIgdoTrbu1CO7EG8qZNtfqi5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydvYhc9aI7z8mXM_J4SQVofJFAGdlVx-NvVGz79yY30A&oe=69CE8171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW6LVYwczz4Q7kNvwE9vOrp&_nc_oc=AdpuN7LTJSnIVZlWxMmNPcrZTek6Vs9usQwseC_hj-ceiL0s35FybfoTZH7IReP9nMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGlmNkKtAoPtAmiYRB4UylPU3Y7KA5MzfBiyjxVhFJhw&oe=69CE7E74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-06h7SADctkQ7kNvwGPwI1r&_nc_oc=AdpcqL_oYHwLXiQUZgKfW_juQA5Io21HOdMFBnNwvlr9ihzlm_zonzlQI9Eib66Q5h4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQ80lP4rwrzLCXX-uox1x0SADs1gT36ftyWIasrA0Z6g&oe=69CE5472"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y77ZBgcaGIUQ7kNvwGH-sVh&_nc_oc=AdrCwTQW5RSolVkmIT2a-1wNmPQ6zsAI9xB5ib-db9QsvgFIEO0c0pqa7_oE
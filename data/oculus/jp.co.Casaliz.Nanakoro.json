1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KCDLiOta_cgeHCRjcXrFCgbJSuVyb4TXlRYQwkk-4rQ&oe=6A26DAFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IVW3SJ0LVUQ7kNvwEpF_M8&_nc_oc=AdqUN2m2KjM2eTYOcNE4qSFMqdXZHB6RojvPMEdJduGi96KtBYbaiE37In6ckMOavUQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NTDz_ZsZTC0P1jpmuSDLblrF87Hx9WHriAm0Qx_xzIA&oe=6A26CE65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdKV5dXctocQ7kNvwEpCj6e&_nc_oc=AdrodlUUdY7x6IafXwTAdAOTsR11ToLvZWMhv-Ibvdi56Ihxbmuk5KIpbeZ2U4QneQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ATnc2fbgvttfCttJZtJwmBhQu1yzGagb_siCHKrN3wA&oe=6A26DA7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKCVnXKiFwcQ7kNvwE8l8Qc&_nc_oc=AdoZ-1DdL4iz4SRH5jKS7qRRXCIBAKEjXzXbEY9L-5yLFCIElhmPtl15wedOtjBW2MA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5A-dgE-Ple7nJCXQ4wgqIs_WmfhXRHDofhpXhVllJTQ&oe=6A26D5F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTUFm5DRrPIQ7kNvwFpk0o5&_nc_oc=Adq-h29zQK9Lv_nuSdKK5y9bs8TIHfaUZ8wcZ7f-FzHZEciDzenWNkOAL5DCWMUM8VU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EXdc07vBjphhUULpw0Kg4gsrkRrKVpHRftgYiJtt0NQ&oe=6A26D2F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz-YWWZqUY8Q7kNvwG-5Bnz&_nc_oc=Adp2mhHetPWYcjjSPbk_yyh2MPrIIaYvVRErg8uSct4vPSoAJ4OSIRiQU347YppcEQA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mLSCnvb-csnPsxSwqS56Uu_e-E0_Mp_5Js9aiFXWSlQ&oe=6A26E132"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGkH01K9BeIQ7kNvwFHRgGU&_nc_oc=AdqvAQ9-U2kKPoW4jgbMh3g8Dtpn810FYUCNL9ZsmMsEIcOY2VVe5NCtOxye
nrasVgQ7kNvwFjq6wf&_nc_oc=Adri6IThPS7x897CGn0ZmGziYyUJolnTYTaHG-ScJOAhLtF-18pg4BfDH9IUJfa17Gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXnKf6kQnqH7MWXjd3CcQgPcNkinL0W-MFn7cDFR4iMw&oe=69CE55BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pzCmadF3QMQ7kNvwEMUJMh&_nc_oc=Adp68neNV-oE44v-n1RqcFlPVAP7-4bHlPJteDs8dDNNT4WiJpMS6IDMlbK-1Bfa7B0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2R5nS4ZxTYbrZVo_HOGXv6hFvsZEG1U8aFrYbnKottg&oe=69CE4C10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iNUFLmwlGwQ7kNvwGgXhUO&_nc_oc=AdrCB3uUnCJj6TyHCA1s6h1cKvbjdqj_14oDABRmZp0KbZ7B9HnzbGLb5mF3gOUBdho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnNuG6Q32h8UkNZJOZX3HdO-8th240f9F_IKaAZtgAQA&oe=69CE6641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sz-KRQrj58Q7kNvwF9h-kM&_nc_oc=Adp6CyVFoiO2t8402MYDf2Gxa28WzrH8Z4a0Oy4uxoNTC_IMTx5k_qogBD4cfdcIses&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztQ1dkGzmVUWnuqBiuJ9gloApESZQO7hzAtLOUXKwS4Q&oe=69CE5A09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4DHOPMH8iwQ7kNvwGXAGPW&_nc_oc=AdolIdM-2HNNGyBW4NWQiMoL8c1rYhEDroWMRjs3FhzS9vAKSoBuevUYbRkSyRuxTb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjUr4MySSSsg-noJjyZWMZ1Bj70dOtRX9-ypc_nbu92Q&oe=69CE677C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVCArmImPdwQ7kNvwGtWjxS&_nc_oc=Adqt_ZYzdspMdik5oMq7cFuOK1ghgmpAuahqeYwkUuYXPcOK-5NQjlciFDRPp8xmF28&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsgXx612kUX-DKpV-IEctwRcG8rkzkShHTcUhgln10WQ&oe=69CE6608"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
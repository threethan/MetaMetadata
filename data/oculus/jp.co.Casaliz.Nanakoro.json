2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY54q2ahgzKxqM8UfzeRLe7EoQpVb-1niq9B0slgwqiQ&oe=6ABBD47D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAtlph2G9xQQ7kNvwFTWEgL&_nc_oc=AdrknZyWPdBzvvTaPg69cu6_lsZcQvSpr6qJ7YlmYp6KtQ_XQJ2-FyQFKfIYG5kaTTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz8VGr8ToZ37QMGTMkLfrRHMeH1uMlRpV6hEylxPnOmA&oe=6ABBC7E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd189H1pNd0Q7kNvwG_wrRc&_nc_oc=Adp0R13qF9silDMeuZqTSH-1Xd5ROaKbdlEo1uiMwx8tBoj--IfMzZ2E-8_W7hjXugI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmVZryhp8JI4Sk-USVUKhLvtr6siMQneREhej4NPpZoA&oe=6ABBD3FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qyb6cXMkPWYQ7kNvwFYCgdi&_nc_oc=AdpFAEhSw0dzdEb0l5nVDdPHJOs_MQaILpJkn2LeDEftY3koKENIbIXsf3hmsYHh61w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7y1O2iK-gkGj8GvZuoDW4i0PZfIQIKK9lrxQm9yIZHQ&oe=6ABBCF71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WseJ-5EAX6sQ7kNvwF8ufXz&_nc_oc=Adr-h94nrFA6y5oH6Ef1s7WPFV39K5zyUD2Ihu2VhYfwGSKXi533iSRgEcBM-ULXoSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ7xRzBKnMUb8cODrKYCpt2MT0vYusgEC9DZK_5SXn-Q&oe=6ABBCC74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFw0xlqtwLAQ7kNvwGBG9uw&_nc_oc=AdpmDohBAvAcCuyq9imsr5PriYWrRHCuEa350pYrJKZa4ni014nB7BMTP0KWLdfudNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhX2KZcLVG7DfdWpnLmzFHDqA5LmLK1lJ7eXxpxRgwIg&oe=6ABBDAB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKND0yt3gBcQ7kNvwHWJG0d&_nc_oc=Adq9DiDfTOQR2vVQvofpRdNNnCfvWeYW_kvTJpqdlHVEjJtqn-TrspguM6ql
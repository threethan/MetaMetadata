1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk_h-dLEkDT_kzfGW8e8NaYITefLOIYJJNAea227j4aw&oe=6AB1487D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSpq68t96BgQ7kNvwFKp_jz&_nc_oc=AdqJHGrntcxRMfni0_6PSo6iGmB5RQO4CtBW0Y8o5wqlCBUYnGXpEAQ36GZudL9c9gg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW3X0ZKB7F092FqIcoV4ylgfxo3Ej6U9W5FkDKtyk2_w&oe=6AB13BE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGaGjZfp38kQ7kNvwHNlNkZ&_nc_oc=AdofKgVQTtoKWD2Z1flW-Go9Va8b-ezTsp71NN3Fud5IYlScW8nQ3K-AHa9_PX7TUHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvdspGfm24jzx0c27W0399VeHAloznyLF1Jop0ITyIoQ&oe=6AB147FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucyBdWcG4DkQ7kNvwHzdgK1&_nc_oc=Ado_BJNF65U5Bu1cAdESWtMdpcNi_LPq1Sdie_TIpiUqON57-fwYFjjUQQYq470-xaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdKyDJuYANiSFWh0fO_OqeTW_qDZoLUZBtZw2lao4x8Q&oe=6AB14371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBDeUwTNOJ0Q7kNvwFMQMgE&_nc_oc=AdrVpuKymTcL2DDPMvqOQZAR1qqxzsKktmJ1Bo-kFyZivsxGLMqnrJ-s3IqNMxmb4Ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZQsRq2oh064HgDd8dXjvn1A5Y8yLxdGc6xDdy3EkfGQ&oe=6AB14074"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ah9EbFUw-oQ7kNvwFPfuVt&_nc_oc=Adp2ZHCkbPGsnanGLlL6lvub4Ho5QXrwKXiXtIgun5Cszt3wshngYXKuumMtDTisdB4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeAS9S50PfIGJGNLfCI3FxkkjT5nPnVVfgLdC0HaNx7w&oe=6AB14EB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pHGNmaSKYsQ7kNvwGtDjIR&_nc_oc=AdrAYUqmSTBxiPuvc4s0mLoCYROKQqXYIB9NxQVDi8fBpzE1vtafDcdtZEob
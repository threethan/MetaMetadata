nrasVgQ7kNvwHvThm4&_nc_oc=AdpRrG46yNAesFbiVhdu4s5CeFFcKJLyEyJR3WZ1xffaWh85triMS9uNHk14xtP6UE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSd7VgD7bCegexbJvCmc5-3PJpNaKoSAhFTP8AtWvbUw&oe=69CD043B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdbqUjVFuPYQ7kNvwHyc863&_nc_oc=AdqvKkWVy2kiKxVZKPp6gh5E0hgHH7_yDfJ5rPeEGTTztTockafCzIkZSr3k78sCJDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmJSR927JLsMBjDF4wKOmkGy658A8m_LSYQyQGIT0oZw&oe=69CCFA90"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iNUFLmwlGwQ7kNvwEcZhIZ&_nc_oc=AdpdvxloxETlUyPdG4qELzv7qGUDmkpGfHK99EdXa-kUk_dQeqjiAh40X2mGazUxCIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ42q9UGQ-wrKOX9Jeu-Mrkf1__yGtZLy4dHsH2QT3dg&oe=69CD14C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp0stz5O5TMQ7kNvwFYqgB7&_nc_oc=Adok8lifcpxbjmiMmCi7tZy7bKoUq_epFzjdd-H47buG_KBj9A9_vVJd3L9bI14X3dI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9wcldzrgRpotf-uGGjY1gpXhztrswxWbp8wGyP41IQg&oe=69CD0889"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyMwNZ_XbIgQ7kNvwHhkX1b&_nc_oc=AdpfCXzys2hbxphsxZReWoQ2Vgufc0PRpwry5VNQSeBEfHi-KkqLnELturpd0U0fsy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTmPtrWW8ECTFzUdDX2vLszY3Sznfbw1u_MynWVgqBrA&oe=69CD15FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--JE3Wd9c-cQ7kNvwECPA73&_nc_oc=AdoJX948tcwz5F81rGil8EfRybscpNtJyK63VGB5Q2MkEaj_79gvPSLGjHxHX6IoT8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM4wxcu1VmmuFlcTP8XuRGMCyWZ-Lv6vBvebQphjHJUA&oe=69CD1488"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
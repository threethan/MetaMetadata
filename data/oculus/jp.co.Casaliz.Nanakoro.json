1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6S5gJJab4KNFMf6qqX7xEjEMLRJvpjRRKNcieZ-XwYA&oe=6A89833D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DA9X8avCSs4Q7kNvwFVITW1&_nc_oc=AdpE6OpBRkKGZ_Gjl-83N9_RWhcurqRclcKbaKxpiL_984sCZQaSw-4i9UkFa-Y3e1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuDTh0b1H_hUiJry53u9keYLy4TL3xmDFkbOBrX2PCNQ&oe=6A8976A5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2FEuZE9TnMQ7kNvwE-eWOO&_nc_oc=AdpSd1nIH5qGLtte-LoN_hjnMg_HP7yEz6hyUB0nZhhyqsC3Q-9UVnADnmlna8YNCek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuke1B_82n3vTqEW1ROEd6UDFOKSqCpXqgvlRscruXrQ&oe=6A8982BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76TCK1-IeoMQ7kNvwHFlNzH&_nc_oc=AdosPF03HxkA_KKCTEuMen5ZZMeS8t0R5fHXjA_4o5ZONij4cdzCSAQ9-Jm40KQ36KU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVv6yl_Ab19ry3h0aKZIuRMS-oC2PpESxE2_BWQWlekQ&oe=6A897E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PUk0tGQ0OsQ7kNvwF6W-Sh&_nc_oc=AdqrM45mbLvUWRJujhz3qGc7oUizIHDIxI14A9y_juYqBhO9aT8BK3AsxyVM9zENhFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBOWORQMcEA_JVgS-NGNN02Y7qacrksD30w-IkeqLbzw&oe=6A897B34"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0CDEPUy7McQ7kNvwF9nLEU&_nc_oc=Adp40_V1IyZ5ElksmpaNvfu2vK9k3LeNBGZ5IcFT2SOrLyeGBV8PfpZiE8CB5IQxgG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtJ9zyPA7_5wB-JXOZov5hQIWciJefasENEfxs8dAMCg&oe=6A898972"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msEO0h18vREQ7kNvwGNVo6K&_nc_oc=AdrTMqGdvtrEQIcyZqrcMCsKmX1IZFfvCvJqUSv3eCgRO4q8Uj7hzxyvVkRH
_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Tm4BCSb-m_cne6YMRoBIpjd6Rv496a2TIEZXD6lG0YA&oe=6A11C2FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwARBMBGDFkQ7kNvwGqkBB-&_nc_oc=Ado4JRDqNIX4KVS_0RQgi2FWeeKXe8CewtdOVd6szwiqhd2XkCSqFh1-387Pxr3QoS8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uT9aB622aZzJaDlxtvMZtHE1N9FEjY-dWynizu3f1Ng&oe=6A11B665"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgE0dSt0W74Q7kNvwEUf0wX&_nc_oc=Adqoz7t8KnutinO4nYShk3tXO3OAaljkjpnrxHpylczgsUxY-WNfECW0yBGvP4h6YeU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PQlhTkdM9-hTaAehtv22gLO0UiyHPh7YChAqifY880Q&oe=6A11C27B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLuMyUe0fp0Q7kNvwFG__Uu&_nc_oc=AdqhWCMpORhXM8zVCUzDFTYrPg0Dld6MfzqHcFM29lzwjrUy4dZ-8vGkmwnd9rxft9c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mKsWUCdl-x0CdoZkFXf0ekZpR4w2r2xCWwEkQ9M6oqg&oe=6A11BDF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XqNp_UZbJUQ7kNvwGUZyf2&_nc_oc=Adpv_3kcrJbTn7_zj9fb4DwJ2pvl5j1Af_Qa5742c0GXiS6gcaErQfbKK0M3Z0kX610&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L-wEaPLZkE4ABhhVvAFrD6ZnDLTIkejkX51cT3Cjscg&oe=6A11BAF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REOPyZJkqOwQ7kNvwGpLARW&_nc_oc=AdoCkH6lHb5MfIjUzuSrY90XPyDqfpkHV6bYtT8Y2d3T_5E6YHQr7-VxxlbvhqgfCJw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-by8avCKBliXwYTX7Dx33WruTaIlmphGoga6ti7E_6g&oe=6A11C932"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjBZLTiDrmIQ7kNvwHtRbPU&_nc_oc=Adot9oDgQErhYXNADOr4VbBKqNdYy5mlFiZ5yibo_R
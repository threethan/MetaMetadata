EvjK6sQ7kNvwHITzZy&_nc_oc=AdoUBlkOYU-tpY7pk812puJmIOjI8aK8C7JFAo_2lIa1ip8TOFkDHM_Nnofv65iebc4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyF06sLCmC_22wUq8HpyHeUymBztcyVB8YvbG_jH3h0ew&oe=69C66CBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHRUy1JcMhQQ7kNvwEY6kg6&_nc_oc=AdrGbiucbv_M06BxYPAUMjFYJ7PizR0nLIIe-HbBrwxhLxAe1jJV6iF4zkt16uHOvMs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwg33HMpnhW67v_uA3yXlWL6_URwE4iyjf_gShlZoR9vA&oe=69C66310"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYeUML1i7a4Q7kNvwG0PMS_&_nc_oc=Adq2sHcVFulODLMSRY9K-9wA3qdIe6UZ4PFWRUlfMDCjxCYdhTMVYbeeT_nADksr_U8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNGz7t64iuG61aK2eDXT8_wWFtgVc7Ab1DmzNnvCoXJw&oe=69C67D41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aemVJDcoD0Q7kNvwFLxvKM&_nc_oc=Ado-RlxYqjEP_Ww7EicWfugHuJuZb4wNM0_CJ62WszODo_LG8vT81MieFhHUpdyn0NQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4Sy4FE45quZNiE2-iNUJfBTA0FHDPVqry3Tv733rqvg&oe=69C67109"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyWoTwIY1skQ7kNvwEBPVZQ&_nc_oc=AdpVyjX-O8g6Wkdbzf2SVgVo7HNj45xadYJL1IgQOkwWa6Ci6Fu7tj6WkTXyWArjLG0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjaYwjsN_ZGdAqVOelfENgf1wYPFntQOYePjLz_VfTqQ&oe=69C67E7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkEhkWmbuXAQ7kNvwFACY_5&_nc_oc=Ado-0c-i1TYNfHG4OmQMK-zwy2iEXqq_mKMAta_0bFt2L3Oc8vQ7pU1KZtQ-yiSCoMs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxof2PaXMqdz3qQfrGtYUxRcJuLE9Dw0Pet-LYWCCcHAA&oe=69C67D08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ODiDXbHQ7eZRWnlIeL9PjHomfax1XtWlC-1-U0XCKYw&oe=69EF7BFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vphOstCs32cQ7kNvwEwEV5f&_nc_oc=Adq0Ibaz3fw_VBkP92-GMqgBm-IS7ZQyVV35pQfZZL5MdXq3ZAEcyfNCfQ_gKQObKUk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PPSaN_gJkJoeFba7AG3Cu_QXZSGZNlsvjGZDapQ6nvw&oe=69EF6F65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIrk6WdO3csQ7kNvwHLC5u_&_nc_oc=Adrv8r48_4K-aPUpAVbdeUFZoSOEC--NrXk4THsd0kdFeBiZ9zUYFBJAq8_2krrTl-w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af388v0cd2IWZKbOwLBOhQoVerpno2Jx2agoVX5taymu6Q&oe=69EF7B7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKCuomsgjlwQ7kNvwGqezKF&_nc_oc=Adr5zID2xl1OeV0ck8-bWMxvJkrri8c8zUX6TRctxaGqicMgu1Km2fhnPGnSWX0Caos&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IS0TR-CGENRca3mhOT1kB4giYx83D3_wTf2p9Qto3VA&oe=69EF76F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a38i-SgkDcQ7kNvwGCo7yQ&_nc_oc=AdrvJERO3MRR4uy-6pkq_T2ecGIijLR8DUnQ-8QIEwUP9_eIpITMURsc9TN2_bACOSA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29uJWL8DaCgSlKg7FPMyxhZNATcyz5rR6mKIIbTslKtA&oe=69EF73F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9B6BiTaDkcQ7kNvwEmpb9G&_nc_oc=AdqtHwSREvGn1CuGkHnSqzwssHbD40P0fwGQfb5rJFP-fGk5OzjRmof0RFpsv0b1KZU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2y5Rjuad8sqKn-bCPcxMbpf6mkpjgGRe78ddLC3I_Gmg&oe=69EF49F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgtg5ujthoIQ7kNvwGFoIgj&_nc_oc=Adqn4N1Yhyg3GpI-jGKmKFwyfK45cdNAi6ffOUgJcSJUXEOxEhsMJUMhv6UM
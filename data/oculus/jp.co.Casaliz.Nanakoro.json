-l3JJUQ7kNvwHw5C-m&_nc_oc=AdpzhjsCvGCm7hd-6wwqec8SQwFNU1bmeW0oonAgaCdABgTUfOoMNFdlwsUXRKzoVnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC-AKWuliuRYdIhcQmTso-64IKA3J-ILkD-gEGmnV7dA&oe=6AC667FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGBcxgjuCEEQ7kNvwH2M7kJ&_nc_oc=Adr5eO1tntvDe3ZRDHBUguX5NFGsbW9NOovXwDI7y20HcfEp1XRJ1zLFd7OpxsFflJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJMTM_JxMR5khfd_4gTQJq_CZSRc5EgeA8l4OMIHxFAA&oe=6AC65E50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssc-f_cJ2DAQ7kNvwHREBbN&_nc_oc=AdoM225-BqcQoJL0DxRgzeHqG4VqK-mp12n4FsvydM1KKqlthmcbPtL1IbsToHzy3rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-Tb4RNlTqOZUs5fAwYr4lPIDbbPiVZMagGUTRQPly6Q&oe=6AC67881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blMvnjCb-okQ7kNvwFGrUn8&_nc_oc=AdqHyoQh6TxpnQKuW9WxROWiG_e8MLHzZjWHscYgin9_c02dQVRmLRjGr1AIgLBFx84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJaV0f-7nsyluJNao0gWL6Cv3WA5DwC92Hci_gyMaL5Q&oe=6AC66C49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXiCgn2zVakQ7kNvwGFe3mq&_nc_oc=AdoJab-J8k7u_CchWFif9J3sq8s8rtOL_89Y_CP6peRnLXQ2qP_dOCDCp2OI5ZyxbVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe8ZTCgE22xJSdK_3zRhWCQ2a04clK296usEgVnahpVw&oe=6AC6417C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wf8Hn7rhy0Q7kNvwF0zeTx&_nc_oc=Adp9mYGZJaDwQfDu3aiMqzOpCBhkvAWi8IkJUbNJQrmDmYQDaJADsqo9gbYsDgt3fAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuDmepelV8ANcJI3Tn6oKbNmYfCVRyaqpTbVWSzPxpow&oe=6AC67848"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
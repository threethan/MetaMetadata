1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtRjXw0zHWLX7QuJG4OsOEOjTy7bkz2WOkEZBAZdSNkw&oe=69C7B6BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKj71YxlUCQQ7kNvwHDwmRV&_nc_oc=Adq3MU3yo_imD1meQT7bZSG0GnkPvmyJsxxrSczS5Q83wK5e3jDO6UWNZiXNheYWp_U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyX6fQTLCYHcU3Dlu53bmYoPMYLk6yTcKxWOzxNNUEK8A&oe=69C7E265"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G37_JFRDkL8Q7kNvwHkQBNf&_nc_oc=Adpzj5RjvYMz1HV5mALUv4gxpl2t9C4NguEm6n7a2_yVkD4RcsPucDaCTfIg3k-H4AU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKdR0PSSdvYi_9XC5LqRL_zVPg_09faouLulntKuH3wg&oe=69C7B63B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYIZakm4i6gQ7kNvwFQ-5H5&_nc_oc=Adr--RdRWZ7eVCRMDb_HB7TF1mNADuxrzP8BhkBcPqE5Qe0cyrv0mR3UNgGse5CZ2ok&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBSVxUiHAEgAkhX0LEV37RwJ2Akpjw5h8DX0SPEKuLAQ&oe=69C7B1B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQVNKHeM1g8Q7kNvwHypxD6&_nc_oc=Adpj607YJne9mjX_Ri5zGuNBy7NlP7h50WH-HHg1hwR6mS6yJr0OcmNFAO0rL9G0wKQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8XJFQjecNZcxXXMeICzYT_zGN__wju2Jctcrvqt9yiA&oe=69C7E6F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpJtoWNoqUYQ7kNvwHNbMkf&_nc_oc=AdrqQppX_iauY-j1sLgSQI2YcO5RmsaGYkz7ajw8w79FaPI4teHA4BUuZMZXvOuq_mY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzC7Xag1h_7KO9JNTXp_UMetbUfyyq4OcK9mw6vKP-QA&oe=69C7BCF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jleE-_mH1R4Q7kNvwF1a2C2&_nc_oc=AdpVGxxuVbnN_W29i4GgXYSYpXTxkatgVsuimAWHW7J1KdbV0VvnwFGq01l4
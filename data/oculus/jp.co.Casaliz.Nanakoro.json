NHprWQQ7kNvwE56A-S&_nc_oc=Adqy1VeCynYeZFbA73Rbi0kqGrGu5N_aiEsa1CEpVYWTUimtsIeJdYDQtuDc8GgdJ08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOiFyoyxYxDRTOvyJdXt74yVFw5yDXiZWbqvbC0K1jeQ&oe=6AAC09FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaJThyYHYfgQ7kNvwG7ATBf&_nc_oc=AdpJEoZu-83JDnz2jxTuZCDQSmxIzxadXzeiNGjRydFMVy_hNBu9Ule0mEFbHyzTOXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy7wBkXjIie8USvn544OiDTdsKlRsLskeZ0Anzp2T_Vg&oe=6AAC0050"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yOqjTE5hocQ7kNvwG446o5&_nc_oc=Adqgh2gO1OxOQmf0JDjqWm-VHqr0bAncNGqhm4XUVBxMLgBYcjcumaP6VDLTUUXwxKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBZofj7IU0MO5DwU47H-CowZ1M3HNzHS6-BC-9i1fEMA&oe=6AABE241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQPrNSs-J0oQ7kNvwGXeRV1&_nc_oc=Adr8ph-Nw3F4CkHREhr-COvclN5kaK2EtqzzMhfv617IosNHeVjp1n6F4btLG2kBLCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh3YT3O1Plak6eZF8pL7WOVC-JkxJ37LWqdlWVQNxUNA&oe=6AAC0E49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYmLC404LecQ7kNvwGe2Jj3&_nc_oc=AdqsqCleFi5_aW1CZMw6-Pxa8eL1_SP52TRUUiC6U4XhH5Cv92qldO1S2V_DYas2c_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGPVuM_hDd0GgBz1XxjS38R4aTDFyBLtNcV8Hzwehn6g&oe=6AABE37C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRowOdMfEg8Q7kNvwGMFEsr&_nc_oc=Adpy4lNLAep5tQrDlYluDJYS0MSdyrUqvwqrrVQm_eHWN6GD2dIm0s3t76PVA8hu-RQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhHIu1epixTYp18tn-gRrz0S6ajGmQF6a40qfdg5JDdw&oe=6AABE208"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XkO816kHavnrihZj4WcGo4D-HIf4JvK0x4lGbQkwU6w&oe=69F8B67D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAUwNVi3jTwQ7kNvwGFzcr8&_nc_oc=AdoiBxFDLOzmWdYWCNPiH3D7lE8YGXhafXkUSx8uHIo4UHadoDd-ILscuf7YIkwZBwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KGY5rT_uA-16S0Hz4z1vXCX6_vz_PAHk6BhdZWj3jTA&oe=69F8A9E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAXvXKgtaeQQ7kNvwFGLd4T&_nc_oc=AdpAjCXfnzkgzfr5gxP4oNAvfzj-xNT2McMvV6OB-w7tag3eR6wIKw9nFWtXSQgw1Gk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3G-BgkRVcC4jls5SgZJym27nn9tirhx8a1tic_Fj2mtg&oe=69F8B5FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NBH6tZdJbcQ7kNvwEeLYQb&_nc_oc=AdrziS2aSXKJAxWuaCBpfCpHZjhWWcdlUGMupCQ_FdzfFd6r6qWCAv4AUOy-PQ-2aGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EJ-OpMoKtcdEaTHKZom74bU8v7TqcFV42CVdxUXHdpA&oe=69F8B171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86_1eWqFyKYQ7kNvwH2v8j8&_nc_oc=AdpPFcoLmQhXlcU4-g2GrQYJc5OqsEOP3niD-I7mnIBT1uhOtWt_1mZXbT1Sxe7YVI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QStxtbScG0ELGgwGMpwSp5wzOprL_lpQntQGMX1bvaw&oe=69F8AE74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27UWVx1lRaYQ7kNvwHVxyuu&_nc_oc=Adp5mdDgAD5fyPWznncqqKwKn7QROvq-1sqS75QDn-7UcB7-12UXYCJ3h_Nm5_oMwfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0p3IUBiBYMv9JERlW1sX97wRAfAjLm7SLCBdNAtyZlJQ&oe=69F8BCB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYjoZewyY2sQ7kNvwG8e32e&_nc_oc=AdpdgNApo-EBosFeS8ZMZ0QTsyuyXzRNfYXAHcS2dUs9hcSCEFaFL6MmIXjm
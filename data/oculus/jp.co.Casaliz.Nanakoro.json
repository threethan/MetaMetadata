1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZGnjtG2l5_DHWudpjp7BfV4b4FkBWbcO2XBIqZ9TvBQ&oe=6A74A37D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wku43a8pAq4Q7kNvwGdM8ed&_nc_oc=AdoW8etYDInqdozH0nsTCIKu0uGIdxuDgspXOib7xdBRB_emkq_93sn4gVSsgyiAl10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDXLq2vnnKfZQUzWQ4fGx5vzmFI7NX9hDdPvrH5fdulA&oe=6A7496E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhLZc-r5p2UQ7kNvwEumPEG&_nc_oc=Ado3yzaY5_Z-XHD7FkN9KgxamiXt4nlUQ5o22HxIALqDxJ0QG0bw9WWH4XzSlaugbqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH4csCQP0-nX2dev5IzqFaBikcZLeDebiMX3fsuakWLw&oe=6A74A2FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyF6Y85n5eQQ7kNvwFDy9d4&_nc_oc=AdrbpESmUIc331Oo1CjDI6Gj5NhKrL0w3e4bKZVwbWmDdnKy0sWuGP4j39JOpVUf_VU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3mRwqcXNTec9eWi_gAoRhiYJQv34ZU2k87wYKIdPVjw&oe=6A749E71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnnR00HuGfQQ7kNvwH0ZrvA&_nc_oc=AdpF1OimQaE13tm5Cc4tJfSesseMLG5am9Ol4-UUqDIV4b6Hy4wrGxmN_BQCAfBydGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERBw7rsMUFnFtU8V53-oTposCy3PxPMXNuEvhEnYXuBA&oe=6A749B74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCFT9yIivycQ7kNvwHAWOBA&_nc_oc=Adr4VPaaRV3ovx2LHjtYUE8CPhQEPGcxFvKzS6TF7TyArua6kj78D_LxIPISM0_EQbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqEDXp5g3D221xGnMhXm8U4TQLLZKonyfVTeezMQfQlw&oe=6A74A9B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZiqV63oOYUQ7kNvwEZks14&_nc_oc=Adrxb-XUM92F3B_yMBT5BwBVVt6ujPL-OFjEkp9Aob8KO7nbCWj6Gr_j1joI
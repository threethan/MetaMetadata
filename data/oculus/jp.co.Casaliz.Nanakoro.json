70556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFU7qUBDVRsQ7kNvwH02iw_&_nc_oc=Adk34MDkczOxt82nMojdIOXfHIH8xdkt6F_-DGns9x-8iVACsHPHVHKwkoCWDqXtIGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzlv92ql5wkgCutw38hzwmNYGJThI4QDvYhFuZ3f069TQ&oe=69B41BE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPL5PHoNenAQ7kNvwEzQERG&_nc_oc=AdmSCdkjp_eGS1jzeT5vK1kty6OKJlIJgp_Pi0mDAo8rMBhD0O-1WQYydw5M6p49PnU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfykG379HiD7TZc26y29P6jcZTtE-pL2ZVyXns2H4TKrlA&oe=69B3EFBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lxdgLLKs7cQ7kNvwHi3nf9&_nc_oc=AdlGh_e4PhPiqyM6ITPhRc3xb5fBMTQ_DUdpHpdyOaNOfyHllaB6Avzfa4_RsLe-Rig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBOy2uQWE9s9qXx_XREMOWEeZoLNngOMJysD5yPtkdEg&oe=69B3EB31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-7HPJMXcEAQ7kNvwHu7Up5&_nc_oc=Adne4a7eUco51bkHq7-ss9wTUgt2dJcJeiX4yFbOP2KRDaMyUtKzcSst1M-TAhyBDX0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXiFARMDMXOC0caS6yM0e_RhTeHLYBd4g0jlaGLMMpyQ&oe=69B42074"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc29enwUSK0Q7kNvwEJiPzy&_nc_oc=AdmDxTb4hoP7KC54gtz_IrZ8kl6I6SpPxX7DPvA8c-9W_n1M8FApckev8Q6m2jeGAQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXxst2Wq-D9qheM0-OlVANIxpDG3EfheGqCOMUckl11w&oe=69B3F672"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ftzQRK91DwQ7kNvwEgxHrA&_nc_oc=AdldNmdm2SpfH9_fwYcTfsxcBOXXFmJURS0zq2h4XxB9kMBUA7ruLAGndcTfXKdW-tE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTkeFtkThr9QWQqlANqMwczWf0Gpi764yPjQcmQ4LhGw&oe=69B3F303"}, {"file_name": "2560_1440.png", "i
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiRzc1NMNGTCt1g71d5ZKZMMUpWplKsZJZsbz4ZBDQlg&oe=6A6622FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL1ceHA5OHMQ7kNvwG-s5jJ&_nc_oc=AdrNcec-_a_hTnEKvHnAlxT_xAejhhD3KLn_KWv2hxc4mth6mQkpIf16IMSpYLQCcKY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6geDVxnXuMSZDGVhF7udkPQ4b96KpPe8W93xZ9sCUBA&oe=6A661665"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdHNof0Fe6AQ7kNvwFrnz3T&_nc_oc=AdoHhAAeXYUbjPsOYKX1Bpf6QVomXJa8j9La5Apz1hW6t8VZXzyma4W_uRQL6GnK5ik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsC72dksFdArHYuAZFOWmaoHSa0aYMQ7x6FfP0q4le1w&oe=6A66227B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmXOh8SfswQQ7kNvwFKBnVK&_nc_oc=AdqPjjW5BQLl-W1uHXKobnbYG03BWcMAcDddz4e752ON0DKXBnAhF_qN7ypZu43mNps&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjSFptC4sntPo-FILdkuheJVtO2HvXaC2QyLpYSBieQg&oe=6A661DF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQUMvrYWkncQ7kNvwGmwUma&_nc_oc=AdpxeCxUPU-z_rdIk0n2fd6twqJs83VRSUMgduPXnh3SHuMAWJ50C9A8a73FjRitGx0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk03YijpHRAR3Bc2CuKHN7CA8EE910vyU-GitfzMuINA&oe=6A661AF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLFDJ_-9IIYQ7kNvwEavmHo&_nc_oc=AdrOaCw_FrUkL41weixTzW0Hr3MKNlmHm_67uXVJbbVM547TuZewJpLUR8_XLDBhZY0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOW3QmQ-KzG3gol3kFpdNJxyccOXr_T6nOfcy5NHZo-Q&oe=6A65F0F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpnm-SZHd-0Q7kNvwEQmtAo&_nc_oc=Adp0H2Iyy6oaQflL2goT7Qeit9BSKOTGkJ-edAlWJ4GFXyL4cg2wmfCeBISh
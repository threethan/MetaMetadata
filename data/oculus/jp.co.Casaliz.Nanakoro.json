t-ams2-1.oculuscdn.com&oh=00_Afvsq9gSHmKe95MlDzP3fxyliCTwS3OjPUqrSRU4aVcaQA&oe=699EDFBB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb7LUUD__MsQ7kNvwH0ExAr&_nc_oc=AdlrC6NCfx_0O6oq36qj7HZW3TQaGQl5wB3G1yih_jDjyPM15OOXz1BwkxpnWRZppqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft6qJttLlAtD3hmby3zQYtqZcIVAwgN5BuRmN_L-INeZA&oe=699ED610"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHich2xB0BQQ7kNvwEqSpiP&_nc_oc=AdkVFp0RG3nF9jydc1tYYMZDtNw_szosQe47ts8HAAOPrrIE2UNm67KFRUG2fISw7D0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftZKA01G7KydBxJI5yP2EXvgkJLLis0kzNfpEuvglZ-kw&oe=699EF041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyt39FiJwpcQ7kNvwGqO8YH&_nc_oc=AdmbLamedyC2QhEhfyi5niCGuoehr-Z0E1xkozX-CDYdKE2hbazGX6Q19BYlMH7jLPI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvK95coeEtOPLmNOrFiEMR5dD6S8F8ujBW9tDgaqhz9aw&oe=699EE409"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbykt0gOoegQ7kNvwHz1HsR&_nc_oc=AdkJx4QTk84ZQX8x20rDFkVGdE2EvJqpqXyrqoFfVZsyJUrLpNgg-4tKDasOZD6qmbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs7gLSH2j81FIt3Vj0HGfSkF7JYMszQQ9wgMqfWSCpBZw&oe=699EF17C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhmZEUwFG98Q7kNvwFuwymZ&_nc_oc=Adk4Vl4bIgxuAnS6eG0JPmwRZY8rT_2M3R0Bjr2XQuDvll3MfMZqR1AO5UAv9PPFXag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfurcaHhbScl2V3gpEid2-o8qhfs896IrQLjn19_QeR4Rg&oe=699EF008"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh2KhF1JEL8Q7kNvwG8wjhS&_nc_oc=Adm0IYtwJVzRw-ph6_XVCCbWDaHwuIoglkzjaiX_Lc9lnxcBXP7r6WTEiHE2GuaDWc4&_nc_zt=3&_nc_ht=sconten
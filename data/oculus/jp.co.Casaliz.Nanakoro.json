_4zpeoQ7kNvwEXsGFm&_nc_oc=AdpsRg__1xKVcp7RCxQCZy6JGUIzsRFktUYj35TKFtcW5Np9T6r_IBsnB4-7OTQuwZg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_muVnPFiSxCkPmKL0SK8cr2RbijNdbCAbN81l94Q-4hw&oe=6A301CFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPNLoJknfSUQ7kNvwFM84xY&_nc_oc=AdqpC0hsVn2E8pBMRbNQK3YBwb90LDUi_f-1C6RL9RcT2yn5Uu4KMqqquu-yvZ-jth8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MYYAkO9Kb7paYIGhD8yN311CInK1O1Y_IdxS22650WA&oe=6A301350"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQmxClHsUfIQ7kNvwGBbtIU&_nc_oc=AdqqqImcKxuj7JRinbFbDfAdK6WrVKvLN9w-ljjf5jAP8tYqgKkBh5md6sUyvx5_ajM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sM9PPE3ZhwJS7YtDYyG2DMa7Hq918N4lU2gL6cBV0Tw&oe=6A2FF541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPFTqMi4ybYQ7kNvwF5sAlV&_nc_oc=Adrj6pqHH5C2Lz5n96PqEoJaPY9bWjZN3Dp41iy5ZLFvO9I7f0PwyYF_WcIc_4ZVcVs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e7N80QX4LjFev1sOkkvLmpOA8pyVLCAuxmnbsfQ3C-w&oe=6A302149"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxQwrugCg1AQ7kNvwGKDHyz&_nc_oc=AdpvEXZYj14VcNf9YsKf4EhN6LGgqeie2VupnMKRVA9FIYbm_EmM4rFxEl3VBBzHgKw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92na-oxRR6_smVk8HPlRXlRE4UlRogGjpEi-8ZQTAJqQ&oe=6A2FF67C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UzqaTclIeIQ7kNvwG0SC7m&_nc_oc=Adq4PgoyZtXY6i38xLRp05Ot8zqL5JSQOlboRKezei4F93GvrhPejqj3EvXzaCVSFck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r1UTIWQ461GZbC9UU8EKmJO4PDvakUO6irggKCy2qgA&oe=6A2FF508"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
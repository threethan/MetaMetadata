y-Wh4QQ7kNvwFj5Ctb&_nc_oc=AdqVVdk3GHPBVfH903LyUk0xXPisAO_ZbvTblXwYIi03yYj12acDm0SeEz4NCah_ahE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJK555czf3p4xbHz7PLg3OgNBRZB7RLvm2mf_j1gYrVg&oe=6AE60BFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BcPU3W44aoQ7kNvwF1VJqf&_nc_oc=AdpiqofkFlN-lMeqHU1ODW0GGkCIICgEKcdShWQ6p3GV3CdGNjm5NCWS3eRDcs3VgKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-WG2vLtqijqLrJgV7dhVQ1y73bRBWRoUAzw_ZaPgGCg&oe=6AE60250"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbdYLy3gv4kQ7kNvwHS8GPj&_nc_oc=AdqV_aY_G43JkF43MsRMQ9UmgZt9yFmL8Hj5COcXd7-Pe_7a6cy8RDtjgKEbWi4H_1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEU5vXzwwbh_EH66uVivZrPQ3qzmbSB96BwnVl8hSfQg&oe=6AE5E441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQeRSaQb0IIQ7kNvwEf8DVt&_nc_oc=AdreaxkXYx0S1C_uvtGjbnBjdl0iOQLpTAYq-_UyMOjddrpRococl_Ts8LDr2jwtDAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX4R3eWSbViGrIJQ5jSO-xk0zl1fl-RkpZOKtFO1G41A&oe=6AE61049"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i43wKsPT5nYQ7kNvwF2f-Xa&_nc_oc=AdrZ2ahdeHQ4DB7H54MfnYTgYZ0ubWlyz_nGfronpGwqkMvTYozsfi4PPVlqY8pzedQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ90n5gPl5DlZepl9dX3YoGW_HFbDWM7lf_UDOHudWUw&oe=6AE5E57C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULCCUhZGKGwQ7kNvwEJ3_m1&_nc_oc=Adr9BsdPrDg3awTug4Dsf4geEDs5aJIEg2_ajrCJTAQPMQGc3lnXb4G2HNIX_639PUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJoJ9Yep-yPQWsw49Uycm-MEn38c6Vg70TZjonoxDQow&oe=6AE5E408"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
Ue2df6Oj2kr_jKrU2QciB8DYnxkitGgZ83eK2g&oe=6999BDE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHBTMt4xSLAQ7kNvwH-nzTj&_nc_oc=Adnq1iZtoWRgHOqll9zCr88WDMvdwVx95P3-CbKKunWnnPwrZu_F9H3WyQynyT6czfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv233GGRMT_kin46V7tFbCzf9XBCecQGJqjtOD9J-wjog&oe=699991BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se7tlvbDmRUQ7kNvwF58eHM&_nc_oc=AdnpJQ_n5zGrGIr0kKvm1pxby2oM_Jqb07UZLEWAl2kFUpoVytg4Ucw4j-kR0QXrErk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftz5YFwv4Ab956fNx6nmt4MNjW-e4utXuUtDfZu5yQgJQ&oe=69998D31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp1TcCAuNKMQ7kNvwFghLWK&_nc_oc=AdmBuyEZA7FDW_gaQCEp98k6qxJnXeWSF96Pf0o5ez3raTiroL9e2ih8KWw6Fx_0Bek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZw0AE0PHyW_YTakqENex3ZyxDcmtqOr3jqAyhZM57vg&oe=6999C274"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw5HOZfIFJUQ7kNvwHA404G&_nc_oc=AdmYYvM3pOtIv1ziU2RjklmFnYqr8EXmXMU4zM5WqDCuUWcl2L6kHF6yPKRHylWtAa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvbpmTu2wwomagOGgCTPUmqvqZpZzUJG5qCYTkoVTDmwA&oe=69999872"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njAQBmcge7kQ7kNvwE1ximp&_nc_oc=Adlma92Iurf50JnWlfsh63kEkC-a6zvk27Pc7kHCChDVsFbk4_HcBZP5ZUd68HYX534&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZ8CtGbDH9pE9KViz3FNuIPZipRyaH6nh5OjmeWNkbKA&oe=69999503"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDIcNjWu2IkQ7kNvwEp36Ti&_nc_oc=Adn7xcSogAf6CscbxxxX4ciiNqoiFsAyO0z2RWpzcUAwd5edM29tuRfBzVFPT6pB2MM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0usnKd
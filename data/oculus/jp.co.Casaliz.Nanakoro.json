t-iad3-1.oculuscdn.com&oh=00_AfvkXCkaTOnScHkb_qEnpk_g2Ge_0QXHV3ra-7IFzjg-Og&oe=69A2D43B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1khL8rlA5toQ7kNvwGeKt_e&_nc_oc=AdnwXggxvklkbIBzjvNVe64k1RNOwLeHrND4MfYDoJlRyhCTuKnZLYpl6who9hO3fxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs18T9LLvHGHYoa1EujVBVm8s1cSsaN8NOE3657zeMibg&oe=69A2CA90"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejZ64IpaiKYQ7kNvwEShmqq&_nc_oc=AdkqKyUiK_lERwt3YQBR9IHjlJuKZA2vm3aBXvRazhJVZNiKXgu1NyXGHmERQuc7vlc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsreK8ONnrf9G-UqQBCQFey5lh_IJmhNyr-BQdTxYjRiQ&oe=69A2E4C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZPyCJKDNt0Q7kNvwHY_7xT&_nc_oc=AdmlFgVSbwIwh0c8jiZDB5H4pckpFgsML_PS--9oKjIH1_a6B_qKIplxHwf6GJWEVfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsK9Ldz5k5L-w18x8NxVTFGfrlhznnkXiFgNBcml6HWWg&oe=69A2D889"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJfcq-Hz_ogQ7kNvwENREwK&_nc_oc=AdmcspYlSyJ2-BJnevTngk2lm5poKBP6eMioFvZE-avyG-ZjBKdNSZFzZmCl4oRS61w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afum-3n_KJ9wMDdlIqpyo_DXIIi0rhuWGCKoPLzmfCLCoQ&oe=69A2E5FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKemQdG8KKQQ7kNvwHaLaBY&_nc_oc=AdnhTkRufpVJWWQ9kw1ZbCzxi4g0F4wiyE2UlWGvm6T5kJ9fZkIJpk_1Yw5ES10iuXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv2K2G1YIKhliC-d1zK21o_pi_joL2TZPCCtmd03U_Y2A&oe=69A2E488"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhqODh7GP_YQ7kNvwExX_WR&_nc_oc=AdkNEHzKH1Zga3s3-0OURo1HgG51oSSK-4f-4sh2IMyu2eqXuI6KVF2r_OGdsKRs6_g&_nc_zt=3&_nc_ht=sconten
_4zpeoQ7kNvwGOYqxl&_nc_oc=AdpMq0AFFmdDnxLdAhYiXpJnxtTws9t4HI4UFV288tH-CTlKiftYoYdIdcwiEdVE49Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OUCjn8VVdnY4PUsp0oo2CQNHj4Scvol2hKgrachsjvQ&oe=6A32BFFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k67gKpNlUYgQ7kNvwFhAsfQ&_nc_oc=Adoxdwp268H3eHT1owgjVTRwrQecjrIrhPnYLwlJX4A6cg4obwzsjsjCC6QVSjqXgPI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dozaprmtmrBjO_Uq-fM7ueoMir_Tidx596coptC595g&oe=6A32B650"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQmxClHsUfIQ7kNvwGk8lID&_nc_oc=AdqC_iYXxJ-JSF-AU6uAY_0PfBSkAbyNhjsyccIfknRUlXlTMxP_jf4F4KfRxuUw2KI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Hvr1m8uSCd3z3yKeRbm7UXcgFRtVLCcekHmF-KvGbgA&oe=6A329841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HaO3NnKjJ0Q7kNvwG20Mjl&_nc_oc=AdpcVebhxAnuQchkYdUAfdkRWcZug-BRjmeIidPkC6TzahzUKnMaXeJT_zOTULSQM-Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SGS9HwZH17rk98H9MzTIF10TDZ-RLFJ9EjgURHAIugQ&oe=6A32C449"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3ELA-glM4UQ7kNvwFcT1vX&_nc_oc=AdqUOmTOUAFaF5Qp7ldL3C3JhCJcJhFxWi32OMbI1TrSCEPaj7o_vrG1QX1dw43B3eY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D5ZOYn97ctfXqzTM7y1W1PZ5tqQrs33IcxYgOJnVxhg&oe=6A32997C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh5LqmbSVwQQ7kNvwHf4r31&_nc_oc=AdpurXbDFrMgF4iB9nOOuE9CG128oNGpnCk0wFW9CETMBb9pHA00QopL2vVTohZ4Zww&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bO37J6vVdQ1Fod7hQs9Dcnyo4evxQJmUVsdrYskgZvw&oe=6A329808"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
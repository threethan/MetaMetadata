AM5_OQQ7kNvwEJcqAd&_nc_oc=AdoPrnV8w5kOLkgaJLkgF5Pau4dn5-cVVpf1i4i1iSxvJrE8OexGSrtk2Dj1LnEWtPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPEBt1V2I282-jUCYn95bnq6zrLfYZdtHwClc7GE1N4Q&oe=6AB3F2FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ8QKJc0HXwQ7kNvwGdQw6K&_nc_oc=Ado_3XlSaxUC1gGM2V5r4dAnms5SUqrwfKStMetfYwRDYoMuXwLjtsfO8PVLdl4H92Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYmKA0tvmhI5NcglluPX8xIt0jsaemm8nGQhsb5Fqjtg&oe=6AB3E950"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntPqAKglsl0Q7kNvwFsFypF&_nc_oc=AdoV5nha0Do4RVStrEOMz00FbVJ973TYiY-ogS4D5YAh4xsTJVAaUuuMbxtAcsfNkLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuqK7pitEhLW6BPqPuhZNjM1Pp6HcmT-ASZn_gQiZy-w&oe=6AB3CB41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEkUjlMjxgEQ7kNvwHic9bj&_nc_oc=AdqHHcrCK8B25Qy2nXAniJQT1L53EtsBiJMjP1dMUBleDKCGQkf-_Hhj2nkLUmv1tik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRCYTtUaxjj34beNtMyOxg6-IktjKcd5qlXBZ_EpHnGA&oe=6AB3F749"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wEcQmqfm2MQ7kNvwHmDQGh&_nc_oc=AdrI7xn0_pCRO6PlUPwDVAkLd-suzjdRQdZ9DSdb8Rp4JoXdkgTpY79SUh857Ylko_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC9oR8WGJlquVEDWcCzTv21hD5Lh-vAMa4269B3iBtiw&oe=6AB3CC7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3iOxpOcr-8Q7kNvwHLsO_E&_nc_oc=Adpq7BydaabxHA25S7rnAgIrjudGF-tbyksDLvTx4dK4thxxV-no2u6yqf3eAiPjlDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZhLmbtz5FV2_zkNjWptAdE4sR-Ui7UK6mr2NruFqv9g&oe=6AB3CB08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
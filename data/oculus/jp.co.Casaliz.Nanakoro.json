rM77DUQ7kNvwFUIBjz&_nc_oc=AdpMI9cPa3nT4YxdWzT_alaBYuM0k8aC0CZNztCfHkHSisxMFLlcg7Q9qDU_O-A6bnw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqiqphTRsREY17LJGj1qnc3nA99DiwdoLYVOOCVAVk6w&oe=6A65F23B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzAMUZSVS8oQ7kNvwG84U8M&_nc_oc=AdrkoaJVPqPkp5ufNmClq_MMQb6-kNZMeNoG3wbGTUEVQ7Dm84hjZ_AEhIzbYAkLzCs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOxRGcbaCT3xHiH9CkmQ8gofDOMzFWUmRY1w8I7UdJvA&oe=6A6620D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H92OgHCLcUEQ7kNvwFZSgZz&_nc_oc=AdpNOuXMgiByChOHauBVxcHgshvDio3HWANvOO7zmNBHKrrdYBYKe8O1Amn5Wya8h0E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuxqto0yOyfj0q-BavkXgDPYCiVa6TSloa10Xc-L_l2Q&oe=6A6602C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUvdFFSNfn4Q7kNvwHCLdbZ&_nc_oc=Adqm70fSj84m8nhmrWfdZ1f2y6zoCPLjfjgPamqyyNPZF4wjK7YcKcG0IgyAshIoAQI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH8JD5Bhfz2gX0ZC__DfoUAi36Bu6zEfbEAwWRjv_wjA&oe=6A65F689"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-PkTEpbx_wQ7kNvwF6AwbP&_nc_oc=AdpLrzn2zoxep4iRWYup3g40GyIj_EmgUoG5TldsQfjbxZVh1LgAuq3Y_lq78oe2CMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzG-tGNDRsiFQ5RW-c6hf8SjbJ2-DhulqV4UMRNRflyA&oe=6A6603FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXHGAkXFZxUQ7kNvwHY0hfs&_nc_oc=Adpbf0mIGUbrwYrnewNFkPFDS7sfA-Q4bOfr-2gFaJ3NNKebGU0tqJeO8uf4DwFV7-k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAapb47FXw5F759h-OTCX88SjlxetpHm9H1PZzCQqq9Lg&oe=6A660288"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
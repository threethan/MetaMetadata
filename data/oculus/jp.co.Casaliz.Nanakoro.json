2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30FU_x3H5XQlTrOoUMu-xh7-tH2aL_w_DKamMygIY8zg&oe=69D4E5BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcb31F87RDEQ7kNvwGCFAnV&_nc_oc=AdrwvnXDXKZ53S4GOuuKt8wGb6_aUWOD2Mmxf9KQYeU3oCUAH2x5SIA5MH33eYcuOGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c0M4HDARlhPHayNTYRLDiKne_S0OhB4HU4gKjI9K6Zg&oe=69D51165"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN-3jZ2srpMQ7kNvwFXDhLN&_nc_oc=AdohLemBISZzxzk9gTPf23h07j76ZLV-e0t5szS5FIBqFQlSVnWpV21FPvIW44ZM1YQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08w9iAzoeNLkp8jSfQnE8l10YOVSFgnk0tOPJPs2x7KQ&oe=69D4E53B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUcRc7Zn3T8Q7kNvwHeEhdG&_nc_oc=AdrE0aWDWhqpcUWleqdaNMexQZJXL-kgKiRd6pXSBxpIVYrhPzf7btj08FdVI9Dpe6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IYk5rUshRj7n89vbPbmrFtfO5h2Y32EeMv1HrO8xHXg&oe=69D518F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2UDMOSgdyoQ7kNvwFsWjT8&_nc_oc=Ado898SzXuL-hgA8ko5v0GP0z1syowjTaI7z2fNWndlZzaCMb6xdNyqfffj7P_d64wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p8jqnSFYEJZ3RjnRurrxhO__rJWU2ui0g5j62L7N_Ig&oe=69D515F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh-qoypAAjAQ7kNvwHtDK3_&_nc_oc=Adr7kuwyu_WOfXMMl8YkVTXzsZ8MagGeI5czEakz6uQ-QwLGXkuSQGopEYTq7rsJKPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PfCFymXEwucpTfnS0fvyZspjj5gwl1_BIoJjQgUI5AQ&oe=69D4EBF2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1NiYsLlthcQ7kNvwE-Y3Y0&_nc_oc=Adpbk2x8HFkyCO22mcGUeL9jARvUgu7SHY2EpV2_zSudi5VI2qgzW4MqlL9v
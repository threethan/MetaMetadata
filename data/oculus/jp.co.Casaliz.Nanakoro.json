L0aTGAQ7kNvwHIRq0o&_nc_oc=Adode6QxHQgn0IeYqSMhBbf6M85pwKDbzCkPR6s3quI8PDft2y3eDX1x3iE-8lKMafQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlpDn5UMyIZY7UmNXwNHN1VubN6_trg5hfoOSV1merbg&oe=6A9416BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTgFbcoCakUQ7kNvwFB3d5j&_nc_oc=AdqUBfH8iI125CdJRpILc8UFAU76-gJ-LyWUHVZs2aVuTyiTHk7jzD2K--ThDHvWvR8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJoUnfWEa70GwSQMxQsgxIaA5L0I88QKUT-YLYBLBIsA&oe=6A940D10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt1sF6PfYnIQ7kNvwFbX96J&_nc_oc=AdqaVhy2TIjtbInEJxybN1tQtXOb1BNv2MzPjCFcKZOQzfPWVuoukyshewXUXvG6pmI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPOZp72_gMvcAfq255wzKmRpjE7VBAklmMvkQ93fKkHw&oe=6A942741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFpnRAGIyjUQ7kNvwEMFB8p&_nc_oc=AdpIts4IuBcE8SqymDXOiqbGMoGUvuabRGpx4j3uYdY0ICXCXklj2Qnjl2yeC34hgf4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES2FScDaHl2uet1ndmK2kyduBBJju5voDq186Tn8tPZA&oe=6A941B09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7xUZJHxcwMQ7kNvwGlkDP3&_nc_oc=AdrVYI0d3NcXz5w30b7MGJhADkrCzf5b8HnKIMKTuj9PC4n_gG1X6xl8XVXNjM2jiYU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9zkCCGSjV85mDDStTVQgkrvS7CP2I5xmz7yWuoXBRzg&oe=6A94287C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6GDLLj5ta4Q7kNvwHbZYad&_nc_oc=Adq-yvO6jJxcZsDUNDOMwo0vkKqhzQ07kqKWxiq5ZgS_-dx34b4ce_-DC-HfCJFV6zU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP8QwJQJDfr9ETgZhpOkz2uMdjH5ROyOgNcejU00LWzg&oe=6A942708"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
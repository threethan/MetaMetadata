3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GvGO2xxojawMv1A5wIl8YAvt01j4-VvLbF5ECtF2SXA&oe=69E75ABD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukFdaTo25HkQ7kNvwHfMu7z&_nc_oc=AdrcxBvT53nbN069k-RZfSxKJ9xkHThowQyGJObT_1zyo_6fTMSOZfTlC4ALLf_WEpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07ibeTBhcOsKQy23Xon_4T6BEdFwFV5u_6RbVUwaObMA&oe=69E78665"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JrqHQWkk5gQ7kNvwFuka3v&_nc_oc=Adqm9cbC9PIyYig9H990pUyjbh3xryrWzoypkWuXD78t6zBWDdCygugJOJDEVmw4nsA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0leVpOhPj2nINkVrmzjdW0tUVSuLMRpnI26d2IjA9PmQ&oe=69E75A3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raVBryM8jVAQ7kNvwFDwgle&_nc_oc=Adrc4sBaWJD7qz8uQs4GVUgyH3A2dElvoCu0hvojx-rjNRBDY1r0dnL3fwx9jSpNP40&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14zSCo5TpbjvL0vtdgb5ABgyMRaYhzrBjHV2dmKdJguw&oe=69E78DF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY1_OEzBM0gQ7kNvwHqWqYI&_nc_oc=Adq9RH7oNCXgRwqZC-nkT2tBJ2Ne5QD0tj5qcCDhLtR4eAaSsP7wmbd9B7roWSU6Cbs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kT03zR4oetO6Wj6cpJMeVZQmi391sx8fhCaphMRCS2w&oe=69E78AF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsKBeOv01KsQ7kNvwH0vQ36&_nc_oc=AdosaEOvoJ2aB0oXCuDgRKTk53gmEreErzH1CQWhTK7AaVEMjOnC9Hbzcvi1LLsp2cs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UwJrNRLFngT2Rr5WKB4yzeMxcwG7EmuoJWFTD7aKp4w&oe=69E760F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7WQ0n6BREsQ7kNvwGpv6K3&_nc_oc=AdoC-BoqTH7W5-QAE57O3t5lPNFscUvZX7ibvGyek8nakjSKGNQyyLDs-s62
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ61wn8Br3_Jb8baHX0ZrM3yiu6eeie_j7X_VFzqkBweQ&oe=6A9C307D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0aivY0q4cQQ7kNvwHeE7DC&_nc_oc=AdrYq2m1U6_jX8vzGezdozoTOqsT9hxYMZ0Ygd-ezpG2bxXlNKja3guaJ_nyKhuUICI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp_KXGALeCRAmenn8ZUOhOGqyytvEuHr-zwqsE1Yp8pw&oe=6A9C23E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL4YpbDC1joQ7kNvwFbSTka&_nc_oc=AdoNAA43F6j4UmdnbEi_3NUROtZKXkZkpU3AsqgG2WhKIqPPBqym9iy0YGlOq_H8okE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlX2SQscS8F6x7k9iw8gdcpKPLZpqwOKRuEFnu9chUlA&oe=6A9C2FFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHtY9nX1ldQQ7kNvwF6g-fM&_nc_oc=Adp2AsmWldmboR5mZyTeEfPT9uuM86CefdsC-UpcOGNW-1JP4u4yy2JG0lRUTknB7cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIywVEMbTu_zRYvzlpR5I1MloPkNMKth0tBeUR-4DNRNA&oe=6A9C2B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjYfWeM-ShcQ7kNvwGSHc1O&_nc_oc=AdoFpvvhT1gbhs4D-tPxcxk1aRclOfAjl0gY0dElt1BwXKCGGuDFT2zZ90XAtQTYF58&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxPAtS2irueiZA4NxH-wHyrsJ6OK32vady-FmsIzdlmw&oe=6A9C2874"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxvg-KNTLS0Q7kNvwFCuGiQ&_nc_oc=AdqLl5N6oJkeBzupLWpanJEDQy7aLfkHarCap7SrpMKY9gTcZItVcrEmWQDCDQNkI68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq1dSqdqr3Mxmlb-kYIUEC27bPRjLGGRuHI0WN52-zSQ&oe=6A9C36B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oduMcqWIkvcQ7kNvwFjvjQa&_nc_oc=AdonMUl_Ty9NMn-EpS-cuPGpcax-N4_w3unJhEUcyEh-LzPFau9HiBKimbob
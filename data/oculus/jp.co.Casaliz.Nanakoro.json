qrtfIUQ7kNvwEv4I7J&_nc_oc=AdrGV1fKdNlpVe1IprWGB1PNXokwyIN83o9jTdwPqKwvSQKjK_JGj4ihbXfWRxNPZzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKoClLydSjVae6R3nZh_1wdIVHTfmUcZhN4jkU_Zo2GA&oe=6A5E093B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ87n-VmjNIQ7kNvwEvkdrE&_nc_oc=AdoaTtCpTUk4Ey8Hk0dZlhJ7skaswIGNuXrfh3j8k0_ZKu6jlUirLmZyZZvuRE4LqKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnHMA0YeEvwz9yNPUxY0Fdg1ZRGdvZ9ef7Sehqd_GEgA&oe=6A5E37D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAOor7ZXwn4Q7kNvwFYya4s&_nc_oc=AdpP6ZfpgRJngeW2rTqNLl2QfrHVguQTyzDZijkrZ32Dagb9ht3aKgWVusONbU6GFUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGiwy4F7lMA5dmtXklG7wIEv9s74U2ZSGVsxoE0gb7qA&oe=6A5E19C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qVAfgUAH50Q7kNvwGwMVcm&_nc_oc=AdqB3GtPBA-d3ISfa5XiPpB1hToL2XMMK8GDcYtrTDAqUKxiWanHWt5kmM4X5fsPZ7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqUi_cYHCWd-GcwCPbrgWutEVsTPjW-tK3R1PTMnJOaA&oe=6A5E0D89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrogoxmvpU4Q7kNvwGipjVp&_nc_oc=AdqzspHR5uNNlWTAavstaJMmyWY-fvoVcXHllVW8FUkI8472eRm4OKrl4vNr-NC6AzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl_AwbKzz7LEVljBKlkXdQtvTfgSVKeD5TtmVFt8mWpA&oe=6A5E1AFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsVHS1HBdeEQ7kNvwGxuZ8r&_nc_oc=AdoFqY_R4g-jt4CkfsinAFtCB1wxyf2nGyticXngysAdZMgq0_28LWjLpAg3ZI8_fiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Pl8UPIIgkUPTvGt5n3bYGN3CZvh572YY4TZKMPqr9w&oe=6A5E1988"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r2NnJ8DgL1LlmMnaRT_qXrGF3esqXM15e6Kntk-demQ&oe=6A22E67D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIcHSYIQizwQ7kNvwEI5iqw&_nc_oc=Adomk6C839VNf5PnVbaJq6O5yqnfstBjoIRRGDPYJuovIPwt0b3tZ_Nt9_4wu4ARTIQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-ZES8v1sB_Nb2dV0M8LGWbkqf6ZwohuHI_vMWeL0Qhg&oe=6A22D9E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu8vHl1qZ-IQ7kNvwHryUNS&_nc_oc=AdrGtnuSqBsVZGoW0KjGzfWVPssTr2TAh_NCC3SI3HFZFbdefXQnOhYiVRfbdgrIn4k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QwwQx4unA8BqjfL9B-aaD9mgQjafviVKokA9wS3yCMQ&oe=6A22E5FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCtErbT1wiAQ7kNvwGtbzwp&_nc_oc=AdqcSha8Q6SHWYVVUPkL6uyxMFA_tlk1i6hfJN62BLqCk_fmLpF5Uvw2JwzokMf51NU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bZBRyitxoaC5bHSg-cCbHrX2Mq_4v2TgMDxi1LMF5Bg&oe=6A22E171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk_WnsO8QJ0Q7kNvwGyfccr&_nc_oc=AdqsLr2NfUqkMQTB9-YcA-cHymd70Xjj3hQFYNyZNMe-MonvBjv_Rjk6tosc9U9isJ8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TVPspS1c1-W4F9QG9Z-gIhcmkaa85VcZQNc7hz2XnIg&oe=6A22DE74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKIdnLg8xJcQ7kNvwHBB3ZJ&_nc_oc=AdpeTIIwSKJXV7l64yoL89hlIAWeG6O38QnXaRs1iFmGwuYRl370l_A-bxZ8LQFKqNY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w_0wYHNAGhLHb6cJq1AJnVGtIyyGN4EkSwcamMwDL4g&oe=6A22ECB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV2XT2XKERkQ7kNvwE7BTtc&_nc_oc=AdrVZ_sQT59UUaXj5I1fE3Gnhby0A6vvqmoB_LwKir
l4evTQ7VelABWmjDfVcdgKY74vOSpEZcdvf3dGw8Tnq-hxYqEWJH34ZGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyTVmDp3ZDE4644HHNA1g9qyJLI1TqUrQsqU7QWOaasw&oe=69B3F7BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX5FBnN56bcQ7kNvwHu8Jb5&_nc_oc=AdmdDNXS_pkilYIg6QXemJ-o_VS3g_6gl0LEDwiEZOGKt4j2GS7Q7N9-ylBfHGD-ZHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_l8X_CL3VHNI3cMbhYEizVY8tev5sugKcP13UsoHjVw&oe=69B3EE10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23NuyogPDH4Q7kNvwGYFt7d&_nc_oc=Adla35lnPzp0kjKjLyyn5fwnGNk7mlQL3mW5Asxf8AybA5IRr0MNlQYf6Xmp1KSiNp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPxJBuRMXKmai4x9P89OwNunTHyqeemzVeMR7IA4-dAg&oe=69B40841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIsCaGWcvJ4Q7kNvwFGY2Op&_nc_oc=AdnGW6aej4B1U_N5jP8IK0zKXuMSHliVu563xmcTL1tJjctYlHnd1dRDXw4gJE7kyL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0IJOOyqGJzyFbaQ-Ig0O7jceRnJCPmOQNkSLv9KRO4A&oe=69B3FC09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HymGyssevEQ7kNvwGsxLKy&_nc_oc=AdnIBGPjHEcMZ79x_tZ7j3wAzX-0uvQVmWIgqQCJmQ9dHs_Nj9Yu6uoCTvuyo7FF3nA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRwaM3txkhtTAshD5Ln-o04_MU7532WcvvkL8MmXolmg&oe=69B4097C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_DHrUSZ4YUQ7kNvwErZzMB&_nc_oc=Adm1UkPDR_udXwY5KdrO33ags677LpNJusT2ROphQ4o98s56aMPqCv6vOsQ5SdwUE4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4--h-mV-HhRPN0WLUSPBd6GpjxZc6bsGiBkHDPNJ6Rw&oe=69B40808"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
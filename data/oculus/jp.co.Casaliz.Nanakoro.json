70556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFU7qUBDVRsQ7kNvwGDH-FA&_nc_oc=Adlbb83NCpcjO47HA35q_y6DWmAqsf3llDAvKnWAmfEQ88sAh_EhWhW2nDu0qwQt2w4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyzX8XZV0Sn6bNBT67kJRxQMFZPZZ_eMzWlWWHu4sU85Q&oe=69B2CA65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPL5PHoNenAQ7kNvwGhvopm&_nc_oc=AdmXbxOsaINYYmJsbaxoiOi5UONr2HgxYtUVdjbWzNXOaNIzpYyC-65bR8IhcEd-WH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx1uU62hiQrmHLRB4Y18Ykpc0cMK_w27A6Uddeinv_JcQ&oe=69B29E3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lxdgLLKs7cQ7kNvwGtdnvM&_nc_oc=AdlkiR7SAWtkITbSqRjY9oA_Cm6Spt_C_PrZzSASZVuhM-JMBNrBoetDDnz_mpZ97RU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXK_gaE4cNOlW7zpsQBuR-xx4DM6pBYEDPIVSzWlZSZQ&oe=69B299B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-7HPJMXcEAQ7kNvwE4DwNC&_nc_oc=AdkvW3-lyDmTdBYnfVgAHwkYsARP02sab6XOlfJNaJZestmpAWCWmM_141JnSlbAYO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9DB8fHN3fbSfztNg1iJmKqi4fPyw2HY9iVup_2BYTzw&oe=69B2CEF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX_iQzbQHBAQ7kNvwHNTmDH&_nc_oc=AdniR-QAzIHdcdQBjbP3Qy0q50CJ0mjpC19JVzVwEQ1AokE6I-O91rwbOQyiTP1zZPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJKmFRKH0jeb3gSXpxYy6w07qZ4q0wcGCGEVfIyZG1cw&oe=69B2A4F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ftzQRK91DwQ7kNvwFXOa-x&_nc_oc=Admw7T0NyOo34G5OsOyTlgjUNicNCmlfLjdpsK-vZ9YuoYuC4qZlKccpN0LVIjrAhO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwF_Ag5jrLv2O0fJVKsGuDhiJy-Ka-fI5JnfDODAbrv2A&oe=69B2A183"}, {"file_name": "2560_1440.png", "i
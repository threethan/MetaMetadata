J4ACTUQ7kNvwG4I3EC&_nc_oc=Adpfc3tEh1Qth2ys2y9ApJwm8i3Fr2GAZxsA8rZ3G1NAWhjnKSb6Kothg1W-xGDslD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aYpRfO4mQkhmbI2s0F90GWAZVgMleJbixiMI-43ngiw&oe=69EB56BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV3npw_WMuIQ7kNvwG0HUS0&_nc_oc=AdqXmjU7Iw5ShubPDQjMSxuGPKy779nS-zLdjnBSsarna3tFOLV8v3Or4zBaiZJC678&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YTtbeSePP1Xn6YmTT0t6qaG-QK7IXjy0edIfmLNWVtg&oe=69EB8550"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6YgqXvVP6kQ7kNvwGNWoNB&_nc_oc=AdpOKdUWmW4rUspP84MKYEcG_f8mHO0vlVWXSbUshQ3nz2rVM88Ru_yyKryUKeUJKOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GcnNWB1XsSbBZyVcScBBrIXFr8vreNYaKX_P7Ba4ZFQ&oe=69EB6741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLBOLRXPDZMQ7kNvwHb5cwk&_nc_oc=Adq5Br3-xhfC8khbnuzMxAMuhgIAC185r2OES-QDAJCbYk-uK_SHMC7-FoHB-iVkvhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p05YvJTEQTnAEfTFJ_2a7Owuhal4U-RCdwhdUgTeecA&oe=69EB5B09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za0VnA8-zloQ7kNvwGvGWD9&_nc_oc=AdoqvqOHtST23UUcVQRi40BWzKYC3DFjKv7Vy_mklCYCeRA26VGdA7dvbKFM1DmX2X4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rVy3tZlxmNN_skDKuMdPrI-SXQc4AL_dKYVCdG9MzWw&oe=69EB687C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzVwxSFsueYQ7kNvwF90-ar&_nc_oc=Adpf8V6rWAf3Foq5JCkDZXRt7iFV3_VTxYHCGrpSj2-nApH65nZmQa2gYBUocw_VUMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oRncdfm_TI2yNbMnSlKE6a3Wapc5p8_tR9nfUZdzd0Q&oe=69EB6708"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
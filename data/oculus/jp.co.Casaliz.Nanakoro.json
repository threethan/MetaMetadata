1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4GnWDX5sRl8eWdB9vKg8ywsp8YtFUXG7JVIMZ6j_Iyw&oe=6A8C263D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXY4KxEdUh4Q7kNvwG9BZ5d&_nc_oc=AdovqAVkcdR1Ng0wfg4_Ijp-da4pGO_ynGTDZE9-3Xq7mBhVfUylYt1KLyvo0QXUQ_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcMr35R0fv0AJAnycmG4r8rVXl2MGrC4BwX4KApeEABA&oe=6A8C19A5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=100CqZURMx0Q7kNvwFfQv9E&_nc_oc=AdoywYC3eeq-5B8-7-o6u_e37C8ywHtKkd-cFPxLiJrZ2e-LXvLzf8f8i-MPmvH6zZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJxuxiNzzmMKwgl3OQsMNBhNVKCHtbjaJpOcoHaSFQqg&oe=6A8C25BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXSi9IiZBDUQ7kNvwHceXbw&_nc_oc=Adq3AO0W4_VZA3EQ3-ceR-wsXVa1CULQZwNPEc7Mn7qu2YyVW740vQyhwocTzh--IDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0rTGLH6vzwVCZSE3oMEGg2QHw8COg9ZblGKceExhpJg&oe=6A8C2131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WW4d3PtoKIQ7kNvwGwi78R&_nc_oc=AdrgG9rnmwcZKE6LazzXWw85UPQsiHN2npw41KzC2U1KJo9mHJmiOevMaRmLMlSv1LU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL4nrIya2HrfO4T6Isp1VYf1xU_bCS3dvK2-BmHiOeYQ&oe=6A8C1E34"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0CDEPUy7McQ7kNvwGssUfN&_nc_oc=AdovhfFa1rIQzrN1QEPoVcGnV0Fbo_5mtP4dQZVm5qBy5uQBBlDEmsoGJetXO7jt6is&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH7aQVsT-dKrKQyNi6K341-8nWnq2vyyCpfYdxEoq5-g&oe=6A8C2C72"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah3TgkCstIkQ7kNvwHOsx6V&_nc_oc=AdrCQBe1JNbeztKZKD0miDDjpkH26rc6CyP0VKxx_YTHEUzTg_W1bv4A3SI5
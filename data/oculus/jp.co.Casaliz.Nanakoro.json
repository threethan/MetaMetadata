1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGvWLerXGfx5g7sIS5gdWkOSpKuBG3FshiWk08TNlDEA&oe=6A4FB97D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4gW4VRBDS8Q7kNvwFGSrXS&_nc_oc=AdrN3essbh-Sw2fxKMI4H9y-3XbWZwOgVwfVc4u3WR2pG_E_07PtKN6SPU5daULw6Qs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByWBVbFkGMPaesjQEeK-sZuZEnBwvaj5ZsOxKPRb31QQ&oe=6A4FACE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uocjo1KDc68Q7kNvwFl21U_&_nc_oc=AdoolvNeSPGHuOumIljXkNhXLYWHpE87KaWTSdiMifQ2G_wttWSYW4ogt5WPFrqGbC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6c9HrtgxsQa3nI8V6D9mmXgYbhxmBF7wu9ReTBJF4OA&oe=6A4FB8FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuvyRGYR6VAQ7kNvwG3EKbd&_nc_oc=AdqPdZShwHRTxwBPAjOeRJbwfJm_gjb4UKj4xnVWkPycY6brebSDli7njZTXnJKhvDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5ohyCDYfUVQDErrpM1-GvZv1ZHLa6AnsA9D1EsxP9fQ&oe=6A4FB471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oHLik7HGV8Q7kNvwFAhKEL&_nc_oc=AdoVqYPjNIMnq2XFrdbrsEFH52OiR9igWtGWrx1ug3s6tKhz7kPTXrHk99w0p42jaGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGcOw_gn9peobHp7ZjxwcHQFBPAk6IlRcjZpldKbiJLw&oe=6A4FB174"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osfZnWAc3BoQ7kNvwFKEUWt&_nc_oc=AdrDjQ2y2bMB8gpQPyRJitZYMkYUbX3OVYbiNfHcICQLaXBTN0uzUZM7YsSYMtv1xS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0eE_pGvmma-KU28kdbswDmgXl0JkXhfapIzjbhHbUBg&oe=6A4FBFB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sZntNWF7ZgQ7kNvwHRkSj0&_nc_oc=AdoZv50BeqUzyXlMi0YNYNjhLJmBesMb56EVdBKZUeoY_Aqfb4Vp64v1F21t
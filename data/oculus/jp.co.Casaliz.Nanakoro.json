EnVPmAe3GmcYScdOEJ4oH7SXpGi5u8RG7NVWcG8zwMY97lTHhdkhCgRSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqgw42Kd9wMoPPbe1Vbd-KEsqckUDko5_30STpvo8ldg&oe=69BFD53B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usiwXc5vUrcQ7kNvwGiauc3&_nc_oc=Adm3KgmNA3ypk1SC2DuFMZxyCNzWYcZCAnomI-XMUDcxumjWSN5RyfURZHcX3VR7XjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhDGFpF2Q5v2sA0i6PcBJ8PyhmvWD4zMg34UbweDh50g&oe=69BFCB90"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O5sTG1tyZ4Q7kNvwEsgbfp&_nc_oc=AdlfQIebFLkSJ8Rz9AhULDF3FJ1iKzNZp2Rz4hShyCBtp4lOOf3fpjuXoUYW13I1QjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUCcAzps753p1VW0E2hI6V55Veip5AYf125w7B5I84VA&oe=69BFE5C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRDD-ZER5nMQ7kNvwFJjVZ_&_nc_oc=AdnDkGpUalr1F5W48NzumDbudyIBmjecCyQAD816gm5hflJgzl20yBW8B5qc6W48Yrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUdNlDl8355WA4iJAnWd-xN0nBDhgxYkXMQ0OHLesFnw&oe=69BFD989"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p2MQUrsV1gQ7kNvwHLCWFA&_nc_oc=AdnluRVaORYiS_G7enP-gdOcWVAnHbp7jQX4NbRKFEBdfOv93MT20vvEKnsE3385CYc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwA5qfdttJKgRsJCvIWQO-C02RtikpdxQ4iluj84OTAQw&oe=69BFE6FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_CxGmFnvVkQ7kNvwFctNYK&_nc_oc=AdnmXILJ4mshGe0vEIvRR1kC9FMrAn_2uGUnEACdddUn95ykRvya8ciiTICEOiF9vzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6aY3-Pab5Pe6NTo9ZVVV3bn_q9O14ZGCSYLZsiEy2bQ&oe=69BFE588"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
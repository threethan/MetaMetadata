t-ord5-2.oculuscdn.com&oh=00_AfvxtXvZIG9s-yCnO0aGRs2XuaWiPfe220pXQU2RWyVWlA&oe=69A425BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1khL8rlA5toQ7kNvwGX-NDZ&_nc_oc=Adk1YKr1iS00fFo0zqq7xfpc9bqhS8FC6PzcMVYrw8AahLoM-bf_sOlN9EU1C2_qmXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsB7jIe_me9vg2_KG0afQJApT2ZpGy3vfgADUMcpdvP9g&oe=69A41C10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejZ64IpaiKYQ7kNvwFtJnL-&_nc_oc=AdkZY6xxFhWnUOWbGmW1OUMy0hkgASMzGBFi4JJGU3t-rsCtudjs1e7JUnNxkSUmdx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv69ZJl-JW5itK45-mMWOQ2dJYEP0Hue2u2FmD59Ffqgg&oe=69A43641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZPyCJKDNt0Q7kNvwHVPIU-&_nc_oc=AdnE2uk_jOjjGmHL84T3nqfUzUFjUtaOJ3ZI4HScYtY75mQE06iw2LxecSv5lEOvkEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfviPPZWq4UlxaM8IiAGM4nEdwZkYq426TkckEyJqxpArA&oe=69A42A09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJfcq-Hz_ogQ7kNvwGr41wJ&_nc_oc=AdlcAUtptGm6tB7DgziGgrp_txvrbngwCwApHnHggRda2jipaXPjjc5oVt3HekmsNeY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1ghDiXEIy2v2uwu5RKlrMIe5_Hwn4nGqM-5ytoegU0g&oe=69A4377C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKemQdG8KKQQ7kNvwEuUPDd&_nc_oc=Adng5114UPlWmWGarcVP6XNoj3G4uASpkxP9qMYTxhSEmlmRxK15vMMs95woHgS3d4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsRcUQ3_xYyazQ8-XWas12zb10-Uv5w0s--yosh51FXAA&oe=69A43608"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsacpP7Bt4EQ7kNvwFnIm13&_nc_oc=Adko0arCi5KTn-of2cPI0BjzozSZspYplFR9riafRvBof-S4bwD7BtIVkD89atTgO8g&_nc_zt=3&_nc_ht=sconten
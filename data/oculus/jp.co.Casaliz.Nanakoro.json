IW39C9PHQAQ7kNvwGgc6Q3&_nc_oc=AdpNNHuKy7rIrbPMx31nMyOPjPrkpByzlJfM-O6f3lkZxKt5bsStswu-20rvcez47aQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS7U8l2FmOmxufwWhc6b9lJyUZ5gM-NCAgCjbkF5KIRg&oe=6AA966FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBm7M0J1wEAQ7kNvwHkbP3z&_nc_oc=Adr-kKAi_Ie66xwL9i_Hs6ywD1xj7bIepTRkI_Y8cow92IRGysaRJ65RN9-VocYO3N8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx80xhMFRT7VNj80RbqTj7dOdQlhQHIkU0Az5cXDaZLw&oe=6AA95D50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7XfH3NFh9gQ7kNvwGkwi9X&_nc_oc=AdpX8XZ6qcRM48IZetyjX2pPQycVCp_9EEwFIHSiff0T-oXo1WTBqAUBTA5XGIT20io&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDDPDxYRWV-ihBL8oMlWT6xxsvNnTFgq7Z7K8wbazKbQ&oe=6AA93F41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSdHcFIoPeYQ7kNvwGpx2VN&_nc_oc=AdrXlk_AD3Vs63qsQCmUG0UhzefTXOMfKmhsqNY7XH3-Lrll1evJ0PTz0nYEuLXxcnE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaVhIYDz1ij2-B-gGQYKWPkjxm9b8UFXtpHpwfIlvFrQ&oe=6AA96B49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7pAu2AIbWEQ7kNvwE-ua0e&_nc_oc=AdrPvMKTqpWWglOasPmDfr6qaAPNLUgW7yN09gqe0BF8R8t1BILQgL1THNGWj9AVVzM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhZXwyEM_mx0m2lUsnveO8msdT16uOusId9_ojbGFpCg&oe=6AA9407C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfu2_eYjLI8Q7kNvwEylJw-&_nc_oc=AdqCJt4iH-Ss7S5J3h3QF9btJ614_LCo0Rx2XrQ0JP_TxVCT_BMkVD_3FEWzS91I-EQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAyX1CFRvs1hu6_DLp49ULhJrwY40HeVjaywH4rXFCkg&oe=6AA93F08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974714_10204990
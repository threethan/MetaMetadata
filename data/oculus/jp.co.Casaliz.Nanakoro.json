GYH1SNiid2PFjk4MLmK9NKf-PkAXKTZ9vjQJ9A&oe=69A2F865"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rt6DhJ4ttAQ7kNvwH0HS8O&_nc_oc=Adl0WV-g1eg3SUZCA3qA2ng7gmBcxm_PVPIwUZchqBnA2Q0YPkLxCvYEEX_0QFO1ohU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrkfwiM8ZWQu9FI11yLZFuyaJ1CWjF4XSAViTZRJWucw&oe=69A2CC3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfvueIvwUzsQ7kNvwGXwZPW&_nc_oc=Adm9vdLjwR3m4eKpnYhtQ7x7j31OwekTeSl6OEZLnHgrWixRC_MNdypoXUUUwrEx2C8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afslgy8N51dTOnSllmcWtiW2fhnQDx5OBFox7z_l_qx0KQ&oe=69A2C7B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2qWAAtZXlcQ7kNvwF0kbyA&_nc_oc=Admm2Al3Y7gxl7fsXGfkzq8nC6C3lMRUYaxtJJhC3ewPkF4F8ZyTWdV9YDo_ZtsKUC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQ4VGHgvrqVAVNhufS5S31opUVH0dwwKlrDsknfi4ixg&oe=69A2FCF4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGonuwNABtYQ7kNvwHUqrjG&_nc_oc=AdlIGxQLxVBwPEhP2QkQBhSnKH-MRqBr7iQWSZ9exJVztxMXS6Lw7mKxlG1LbXEz9uE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJNhaM5qCgvEgySMhAPFsJE4buTUEdjzrBermkv4DirA&oe=69A2D2F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUPOj8c4tpUQ7kNvwFQ8FV-&_nc_oc=AdmgDEBwpjGHk_JTnyptQPv6b9kEVHEpj7ux4PlYWY-HrMZqCznklBrIv7vxaXmA1t4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszTnMHYFUlrhlqyrJt4gFMTfKaSv4_8Vg1w16W_S6RfQ&oe=69A2CF83"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1F_7MC9fnAQ7kNvwEv048q&_nc_oc=Adku0usYeZSjUvuYFshsBjQ--JMdfy4sNd1vXoPGOafH7o1aaialh-uU19kCt5PBsbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftw_1Q8a
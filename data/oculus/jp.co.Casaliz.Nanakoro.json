88reXUQ7kNvwE54uMZ&_nc_oc=AdrLZRwOK-DJMbrEP1TzZXrmcF9PSoTRB2O1Qxhbt1KR69X0iYQGwwp9SPeKRYUurdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv5WYD5_e2EJif7KAZLRRXACntHrPA4bxHftr738B-0g&oe=6A8444BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMYQ8sf2zX0Q7kNvwGdlElE&_nc_oc=AdrR3RuN_LmhdGyAkfJbfUpebrw6dmStOVzG14JPk6ippm-MpVTuJbX9KYdvnx--mjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe8vZDU9I7oigEglRd2g_tFQDQ5yRUYi65uPJSfES6UA&oe=6A843B10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4D5LdvAnTIQ7kNvwE5K0Fa&_nc_oc=AdqW6SZpNbmCYOWqTM1ZNQfRekTyPWq2a8--YS5vAdXV1gIUSDyHDAAFEuwlyGhA6hU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjNqnJHvZHOOMH2nRpDgGkSvfauPiZAB-eKNL2k7ZWVA&oe=6A845541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PqP8dYSTmAQ7kNvwF3VI6x&_nc_oc=AdpXsbKG0iEzHTMjBEiIZmTvDOY48ztbaCu5tBLPVrjt5RJ8ZqKJVhm4_mqr7qI7Rxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXDkzju901hmEwWjLbPO3zg4whBan6hGv2mlU9ShD2EA&oe=6A844909"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUo2THqUy8sQ7kNvwHMrwuZ&_nc_oc=AdqlEoI7qn3Mf1SLMRXdZSBz2q4kZGGLmrBpr40w8WnBNWuMovq9akkKfaxzIZH5ZXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFbGEo_Cxmk8W4XBevcnOWMEbzv0RxHJozez8uc1q-NQ&oe=6A84567C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkmPS9phsZ4Q7kNvwEW4OGO&_nc_oc=AdoEHOlq80c5695zh_iNL7Fz9aGhJZvfjWU25yzX__NxcM2kjQKNdMwl3bEAH3NXgoc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9FXN9nJn3biOz21lMpiN3W-Li-IjlFOZ65P0vwxlAIA&oe=6A845508"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
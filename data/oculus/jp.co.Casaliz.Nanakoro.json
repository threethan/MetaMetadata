1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K8-A2saOeltqbX3dOCa-5I90EU67f9Wg3rUgGf--KxQ&oe=6A009F7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3zhJW0qnD8Q7kNvwHkSyxK&_nc_oc=Adp2IE3O4CTlc-Va_96tJrlNdr3VAx79JxSeeYE17EbqqbKMGMNyUbUMr9gOZ6OqCrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ow01BdqN_T0T9wGpV25lyqe3EHOpgu7sCDVjPuwvcJA&oe=6A0092E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8VWrlf2tK8Q7kNvwEXVJvb&_nc_oc=Adojn1vgbkMr8RGQKdiPDdcF-HuNn7nEj7pAo36NMSGqV_0GXT6E0w8eU_c7pauUgbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bE14x2fNYmZjgDaULupkxxKMSoJjXH7pP8fFyJnLqNA&oe=6A009EFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuM8DGE0NlIQ7kNvwEdkoWL&_nc_oc=AdoBkNeReSpF-y-2aeBKOiGLC9f-H42xo66-cop6Sji-ModQa5imrUw0D6u2J_Pw_vw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UeEf7nCHmzQhuAhW340RGMnygqZo5opKt90ZQ_RfuSA&oe=6A009A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRLjk9OXhU8Q7kNvwFk4Z5v&_nc_oc=AdoI8Th7EazOzyKcXddAyMxfErb_2BvQqTClyNFTscmnl8lxVyheryyLcee8ZNqoMR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HbRGMznbwLzgnXY3xLd5dZDIAhVGqfg-V9y1FesQ3dQ&oe=6A009774"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1snkfEInE8IQ7kNvwGFYYYO&_nc_oc=AdrGYzFMVaIFoBdVf3ZCvSWBzEn8pSqy9FNdycH35i4JC4GLCFhqxeMNAyDorVB2HN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iHdWIU6nyu20z47Um8YnPm02TobiwaNH2XrodTglOQw&oe=6A00A5B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hitFo5hSQeQQ7kNvwHBuREE&_nc_oc=AdrUHZvTpg8xE4DyZ4fdTOcpNuS16J6kbq-7qLLd5G6pGvsswXZG3jVgqVID
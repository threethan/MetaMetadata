iNvjksQ7kNvwGHWhKj&_nc_oc=AdoaaQb365WtQhcdZdsbBcF8m-cDiCnoNdqcgRX9ffTv3v_I1ccX-j3CZEZmwZVBeyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfZgxtAh2zMGHxYrDH8zP8fjFC0mZPhtf0MZ770EFQBw&oe=6AAFFE7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku9nrh0ZzXsQ7kNvwEm4lKz&_nc_oc=Adoy-Z0vDg9sLHrAyscPrKEtIYiDUGfCtx7CMsxcKGjc5GHOkGR7ll5j_Hn7apKMCKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaCyKlj3Rrg_oeWhBsXuKAo29tTXvI_nsouK2GqimO9Q&oe=6AAFF4D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgIpJ-d5ECwQ7kNvwHlLsOB&_nc_oc=AdpMyrHN1pZo4JEmJpqfq4HyRjQd3eybTJMjtg0jetPTSXIuQiiFd3AIJvw2pUxRgNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsu7MgsrJ1kCIqgmos9H3Slh4lXKocykhf1hN1C1vyoQ&oe=6AAFD6C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQIczeeLzMQQ7kNvwGu8Zi4&_nc_oc=AdqxMtkQvE7iRP_H91DNIMtERzNRL6vJEc65DkKI0jxE7xS3-n0JISpbMQVCkmavlKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdx7N8Wgxz6hiSNME4-NXcbAIcCQcdsWxvwTjsv-5RGg&oe=6AB002C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ajIlyeBi0EQ7kNvwHT1D1Y&_nc_oc=AdrNClgByxHzFGXpQu0D3YROrA1wGTqeHigcZm0aErXPufliuL-dpT13Y_DlZYwIA9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6KciiN-Csr9u7y0Aul1BfVoIpCkNn99tpVhwn31gssQ&oe=6AAFD7FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUu-EBcSNfsQ7kNvwHrMKJZ&_nc_oc=AdqzSvzZlo6cU6zZzbiXqFCdbxRTs8RBiCBW3gAVGoIRmxwMg-n3lbNyLM2QLxVFclE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5b_agKVdUkkYhWs98AHj7N1AcwxkH_lMO-7pNJij3Zg&oe=6AAFD688"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
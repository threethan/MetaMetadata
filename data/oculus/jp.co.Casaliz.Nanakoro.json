PvIeEoQ7kNvwFi2I7I&_nc_oc=AdoETyjmNtZPHa8Giu5tCakWXHlil6QiNL6uLStFRRN9EKJVDJs1PIsoJR2f-NVjAt8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-HZbT9Ytkjg0pe_Cb3kHceFpbtoiABspyH8_6CuYc3A&oe=6A49297B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7nBSuk_cbwQ7kNvwF3ebmf&_nc_oc=AdrvoPmg-j5R_qwl5SFxTyJ2fl8oVW8XzDK6X_4FNy-A6pk8A2zrfyFrMoVr_BMu11Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwcgoM8CFZN1KNB2NbTWYZQwg5IOFDAtndukpQMISrPw&oe=6A491FD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uZPT6WdPwMQ7kNvwEwbRsL&_nc_oc=AdounGKjV0gKht9neeXAy-dFTGDTWtrK_2Sw8KVXKb5wnh40jyvTHLGOp8vdnFEUsGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeNCbQkgMKkkjuY4H3Lnnro2UMEShSO-KhMXG12ktDDQ&oe=6A4901C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy0vXrCe7jgQ7kNvwEst8nq&_nc_oc=AdqWdwrbdwwP19GudhTm9aM3rZCfoxYUo_p5mrFRxfSLP8gNLyRJ8A8oa3ckkIZDYzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7s1X3WXyhBGrDW5u6StNa1Ghvi6azkCVQJZpnioQ_3w&oe=6A492DC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWtSk8RnRZEQ7kNvwHh29W_&_nc_oc=AdqgEX7ysR2Zbu-SoLYkMz9odvwa1qyMUutp40F-3cDRvGchKHt2LTkalYjzWALiXK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrMot2AP534r_8HGeqmYLbTlNLNnwpg8jGxm1pMbpb6A&oe=6A4902FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMxyStVhnK4Q7kNvwFaT2gi&_nc_oc=AdoACTK67uiJAn1fhhNcXi6vxBCdy4A1z9tkPR6Zlxy82apD7DSaW_ASOnupD9N5c7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCe8aZPMDkvkH7Ez8TltHlXr9tk6nLiJfDaH3nZZ6Lyg&oe=6A490188"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
k2XhLcQ7kNvwFWhyXf&_nc_oc=Adr2oQo8QOZkxb2nLIMt659by5FIAKA_IvboCFm336V4WCttiD1boBWfnME_ZiaN8lY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jAfsMxmPGId4BEK30jV6B0rRD5ML-FxUVlnqjlo38hg&oe=6A0B32FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9LMTHzDIqsQ7kNvwFa07LH&_nc_oc=AdrlxH14vA3YMUaClT3TdNl9Z1Osxb73VfrBDgGoADVppfs3I8Qpb6BCyolQ8ZSoi5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MFKzFR6bScE2t5Bdo373-SRpk41t0P1JxUhbYjU_wjg&oe=6A0B2950"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiP9owDTfEkQ7kNvwEwzJJT&_nc_oc=AdqWbLMLA4qPtlTaWkDbcABU46MylkeK6TsR6UIrYFJOvCKaWiXw_Fm75b_ksz5Y9RQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HJHaMinpi6LaU8RPSbf7OHrxDZRA1Y3QS091bt9xVlQ&oe=6A0B0B41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqSeyUwd_-oQ7kNvwH-sUZB&_nc_oc=AdoFXQlcz_QFpAWILZMH27-e8QTGeY8jGxZ-BPGReTdX2jHgkjKTeBQaupRH4Q_0rog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70dHUfH_odXDodwNsPmI_aGkp6Aiur7_tMpIqiLszj1Q&oe=6A0AFF09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U8XatFYVM4Q7kNvwFMzyAU&_nc_oc=AdpWDAw4oDAlJRnuDqRXK3zcZEWC_edlkSGO4H6yk-NJlVci1-NR-Q2qyfCuRhMg7I8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56qLZKdtZ_EfBkTW6qf8ZgVbqftyJWTXwZ7m3bQ5aSiA&oe=6A0B0C7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLEcFLn2-74Q7kNvwHjSFwK&_nc_oc=AdqOTFD3EGdtu7_GUUwTwSZFHvJ53FKth5lzrfX3qeaLTuKoxUzYith3hYLLc6w_mBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54oQ9Rgl5vr1vkZYQejWD3E_NVrxYJsVe071oiGvjiRQ&oe=6A0B0B08"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
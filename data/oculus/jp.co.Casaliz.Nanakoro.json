1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CxWZWkKyMU6-6xjAu_uJ7qdceuF__GEUr8_r4p05STA&oe=6A10717D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwARBMBGDFkQ7kNvwHXun2j&_nc_oc=AdrzsK7znrzWedhUPacvFaNtjPy5nbzt8-BkvMScgp0MwYan4SVyBWsytoSZCOnpco8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gxNzv21ld_ok2s7A_7RCzIGV_15ch7DcV5VzVk0SUKQ&oe=6A1064E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgE0dSt0W74Q7kNvwFAVzru&_nc_oc=AdrZY1V8ixQukxLPMY1fknMb9LJF84fAFKrASSMDHZpCWGQoAbGoPshNZD4i9AfZbYk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WP7yEqcAWBR3qPwsemb7_-St_92z6-omU_v6grYNflw&oe=6A1070FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr9GPhzsrLsQ7kNvwFt5iPL&_nc_oc=Adr2yelAaLDBIbtYQjV9THdTyo-s5DY4nmfME7A0nJFR68Cq1HJc4yaJ6-wAjkg2OOQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48P53BOxTZ02-aYzrxVpLx-x-z6t8Ffiv7Lifp69y42g&oe=6A106C71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSz6ZPXevg8Q7kNvwGNxTuH&_nc_oc=Ado1IYk0mxfpxfEuFUVHyUCnwtLyH4DptUYi9FeslAJw3UpVMtsh6wBlH5Dt36m9Rq4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lWpOAsJWzXhNOS1xzhHLsAXFgR7714Q40X0lLMpiXnQ&oe=6A106974"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REOPyZJkqOwQ7kNvwGfyn0o&_nc_oc=AdpAs8TanaybjM_WsBK9VLQjZ5AA-EI_6h0gsk1aFV29FVHnrhZXGQ1iFajLU4ftcjk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40XE66kt_64Lo7hiD98pOjR-A2PeKV8D8seLdm86JTcQ&oe=6A1077B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjBZLTiDrmIQ7kNvwEeMvG2&_nc_oc=Adr7aKi4XS4sTldxtOzG3b8o-3pR3tEnpxoXAXWDtlmOYERtJd_MCuZJyrll
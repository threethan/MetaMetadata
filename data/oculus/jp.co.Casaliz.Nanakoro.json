zc_JR0Q7kNvwEiMCHk&_nc_oc=AdpLK8facF8bkRuAF9NDNqsk3lMErZkWBCWRvCJiESihfzolw45K_28EUbSGROjBDm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEBRJ9py9XCWvp7tX0DfGKsVRCOQYK2lVU89HkJenN2A&oe=6AE4BA7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BcPU3W44aoQ7kNvwH5JKhY&_nc_oc=AdrKhS_rxFuBote2O2DjihpJRQi8NtETSCtxt9Jw0SJQEsU1MQ6n7hhsxruqhdpnz2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2M2D8wN21BpA6beEZUHAY-CeXHD4YmwJibWQxL_ipAA&oe=6AE4B0D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-nxz5DUS0Q7kNvwGOmhMS&_nc_oc=AdqoQsOEMHjF_jMyKSDiUvwfGo7hmo-iW1R43stzeh-MUDKKclkMKRvkXRCzOD4Y148&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl9eby3NKIy71o9Dios-V_C4nOHqlGl5nlXDnxYkYaFA&oe=6AE492C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQeRSaQb0IIQ7kNvwGEJnY2&_nc_oc=AdpJvmMzRTFpCmKUQEjCHvqTZbvssxQgJaVc6MlvodFkz-eA4EG_Lw1rl5vlNgrYK-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe_-14VueJoaqpBFJwu2nRV6RR0jDMUaRKSa1y_9nYJQ&oe=6AE4BEC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i43wKsPT5nYQ7kNvwGD03Uh&_nc_oc=AdooBcMoBheRQna5BXMYcDoWtufAKHvZES4afHmyrXD0_NHxJtZYEiIoifBj1MI2dpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlGwqbyUyKuhQGcJBU9dyTEVJ6r7zH-8_AAWqRKhFUWg&oe=6AE493FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULCCUhZGKGwQ7kNvwHESrbD&_nc_oc=Adp5LnCy5cCb4JpkeyS0wCKOYl5s4pyJ0ih5pXFpFjxb7PLA0BPDrrFetgzpCCniT8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxBfAbR8GIsmiFiObqg0T4cUF8D-7Rj_QRwokEV3-z5Q&oe=6AE49288"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
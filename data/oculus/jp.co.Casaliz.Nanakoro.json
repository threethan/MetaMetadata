1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiJiiIvAbbVH9eLfcZsG_gcJef2KuKLYg4qXgsf9OBnA&oe=6AF9CAFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jjn9lrh7aEgQ7kNvwGVRGJ3&_nc_oc=AdoRnr3fGYjjjnvKXf0LNPWshydXXgbcPOqjgzfUDivsQ_CPNQBu4V3IES6eYmNL1K8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGnlEuK1MjDh21TwnPyy9pzrUxtuXw9L6i12v61Gnc6A&oe=6AF9BE65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_1yeaJndvwQ7kNvwELuNW_&_nc_oc=Adp5-Gblku8qIgs1xqXW_7uBdf5pkRutMPjmVNH71phvY93X1eE8EXcrkiz1cQGr13s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9pzgKgoFkpic1mrDrHXUxV2zo29YvDeiFSakuYTsOIg&oe=6AF9CA7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNIUhm3NahYQ7kNvwFGRpto&_nc_oc=AdpGzlueNpxXm1Wo_Mx08wiXNxS1urg8VE0zNzjE1AlB2p88gJELtzpSMKAHclvBads&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQms6AlOqaKH9lTxsPxrfdAL6h95p05eljUVJhtnmgAYA&oe=6AF9C5F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o6Vc3q_jpMQ7kNvwFUzak8&_nc_oc=AdrOQ_MmH8PS7kqvfwasXQvP_RqMwfTW7ZP7kX_b573QhYPwcR8yBauxEEy3jDl8XxI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ6G-goHQKLJ6IUZEcSOOGKy-Utx8286tman1WMG3_5g&oe=6AF9C2F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnR13f5PSv4Q7kNvwH1HKKD&_nc_oc=AdqQaHDf9cV_NqJH-NEbO0lBdF5sbc5TEmYpRK4pHcVEQa9HBeowG7-JhLQ3CBOoeTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz9N2cUxmUaRj6cv5ZzcMBud9jK2LY7pDWdq3_h9en6A&oe=6AF9D132"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZjaMH8tgUYQ7kNvwFSSkb0&_nc_oc=AdpEJw4S_mOIZRkZ9Up2cVW0sUD0uSFa0ZGoSEdwgjv-mDrTK1dTsZ8XagFy
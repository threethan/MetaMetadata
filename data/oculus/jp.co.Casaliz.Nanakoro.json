t-sjc3-1.oculuscdn.com&oh=00_AfsWefkun_kWCez_m1gk7BVjMf0S4-izSeBX_BdBrGUpzA&oe=6998483B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dQ0ZPuqEewQ7kNvwGs7-sY&_nc_oc=AdmGmI84lDIeqRICgL7G4QN18QeapoaOrD_K0IkevKNsck1hzD_9L0RkWKl34Ia4_QQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afui8Lloh53Su_slLM87xAd8a_wZiRaXvIcmfJd5bR825A&oe=69983E90"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ssxRdzfQCcQ7kNvwHpQBOO&_nc_oc=AdmNc1y_5YIb6SvNzhxMLv230dTs2rObvQqhvv46DP4bBARFmoF_ok0c8qEleMxMYMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv_SNcf0OQkEP3wz6NNqMirSO5p0CCIxBpDScZWHXqx2A&oe=699858C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfXW5I393-QQ7kNvwFm1lvR&_nc_oc=Adn1C2Uljb88PLHFUdpbN7ryX5Jomsug-OnpW_y6Tv3eTTj2fVJbK1kvzYhKGM7F788&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft8dnEXC0QaF3Al2W4TieFgB7six9eLhBdxR05rAggTRQ&oe=69984C89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFUU5x-AkB4Q7kNvwF8ETse&_nc_oc=AdlC9OPyPWy4JZvyuLzlwXGeWeB_gGe_GlOhl_60IkKqhbraCEZG1VtqeFn2TZgCdwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsOzV6F_AB4v5zet3Dn3EvTcz4UlRag605H6wg9V0GaIg&oe=699859FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWtXiN6ylWEQ7kNvwGQ85Yz&_nc_oc=AdnSv-uG7fsZPpwo1UNl8OvHH5eU44LDIJ9OlCe0of6er6jvQB9tyYyTao2G6dIX6Nk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvGU0-JwVMOVirmMfkOxK1NuXFgOvIeuBzVdFpmPcltKQ&oe=69985888"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-R7-Vic4v8Q7kNvwEmdKPc&_nc_oc=Adk4oVo6fSETbjt3N9EOVQhJvcstHezq4ojRcM6BFQk7cLjxxUA3OOvGs8m5GZ_oZ-4&_nc_zt=3&_nc_ht=sconten
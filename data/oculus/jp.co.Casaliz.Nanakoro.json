1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi7NoIFGFRJlFzqkLkXFJyLX5HgePiikCoJzAMADIW8Q&oe=6A69DF3D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPb_g2LRCeoQ7kNvwG_d7kS&_nc_oc=Ado-BFeciEFQhHeawc7AXGw4puqpdHtaZq2YAngdOYMEATZ0cSoW07X08k9xMfhBYek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqukSfhc71mQ-1b4FxFq-s1YfzqpYNX-GI2A-9bCWkew&oe=6A6A0AE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wARKaZa-DJwQ7kNvwEHYzux&_nc_oc=AdqyGyZa48DyfQBGA3o06PxivvAzAzc2e2o9hNnpanTDJdb7ixPLi_1aNuuO4MNpak8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYvXbl-eCw94iTArsp8OA_Vt-dK74Qqo9bvRzKILl5Lg&oe=6A69DEBB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_27i67wMoXoQ7kNvwG1Z0Hr&_nc_oc=AdryRQLrhEAvPZXPcbiN-VGZyE1k53YvfPUx_vTbtPuCwBLip-SEBSwGVRpjLmqyqPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNTDSHCOzTtGi3Mj9MVdB3uW16cTX8PEAJqDn2GeAlGw&oe=6A6A1271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWWldtoIjn4Q7kNvwHkWtq1&_nc_oc=AdoIR2e0fh_GLRrcDyN0yZ6yEA_S7YvTLbdesMlEzq26sOMdVl_VnT41jTh7kZo9E4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC89I3_JyeQiJFS31TK3Eu-dyEXR5djUKnsWUZQxTLvWg&oe=6A6A0F74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6Ven1JFrzYQ7kNvwHv4QS6&_nc_oc=Adq6-q-8lEvX5ISsWkwP5wCBpXpiSVvK2F7SZJU7GihNTp61eMYdlra-bg6V32X-v8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLgcQmsyAvoXg1MomkXLa8gSDVmlg5nJpA7xICPZs3hA&oe=6A69E572"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BEC21yf_kMQ7kNvwHgYarI&_nc_oc=Adr79yTaG6_w6CKkQjpjDHHeM1BdogwrrHI8J_FD96nbfpRy9K9GPWAwx2X5
k2XhLcQ7kNvwHz0qtB&_nc_oc=AdrJED6O0wVooWqRIjV6eocr2LXQyAc1j8jRBBdp3BM8Vo8NZgk-jlELYnFtoo-7TH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V-eVuO1LJUI_ykRecExbQ0TROr6uxCMGKNXo7pdIaaA&oe=6A088FFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nlE5K8FjhcQ7kNvwGsJrhF&_nc_oc=AdqUOMqSmXxCbhJeh9UAEcjeVX_Q8hpzAz__wCp4E1Lbpvr5T8QQbSCYQVebWyoJIqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79d_f8v0aQm5vy9YojyT5l6JBDGGtqEEnqbynrEtJJ1g&oe=6A088650"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiP9owDTfEkQ7kNvwEz1t0b&_nc_oc=AdqPXVBP26Uadp4MtkecCP4-4S042ryS1TGJmHUijpSR9olGgE8_sTBDbpwz2u_2oU0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C_u4u0okcW4QwSh8yDOrKV7XGFkQZsrxP5Z7kqUZRIw&oe=6A086841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWiYsxbF8tgQ7kNvwFaADUT&_nc_oc=Adqxw3FyvRNESMbX-3nCY9TwboDrmbQtwku1fOj1zj863E_G2TID0MR67jMcSnCnnpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z78jV0aIbZcFnq3TFQ77xo3eZbQ1vyTUVXfw7l26HzA&oe=6A089449"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GOUcqCVXcQQ7kNvwFMkpWt&_nc_oc=Ado0MPEQ_C6URBISiCtGDPWP1SnXf5uKTzJK431I5SAjwo53Fr5vQ-PFXXdfCX5Cvt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dqHXFa8fLh5B6BMFzfN2UhLdNzYb6aHj15rCHTSwn3Q&oe=6A08697C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7XAysMeDQYQ7kNvwGy5PWR&_nc_oc=Adoi90hdvPYEUB3pCISEpqGRA2A_KAWK44Drt172G5x9mT1cs8HAi3cctDFbODTJQ4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68uDL-8xufmm6eJb5TYxdxj0QWdvlA98cl7BhXDi7qag&oe=6A086808"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_duj92Qi1wy9UDtflqoAnOp1C9qDIM7yoUWu8FV3Y04g&oe=6A428A7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqsCfBX-eXkQ7kNvwHu_UhL&_nc_oc=AdrnaUgqp2_9kXHwSpoHcJ_8zE3ZheeU9gyhLZc6YEMbewILIcMOecXYBbGenBl_gfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aaGaUsWgPL7Vc33B7Q1-UOx1d8UQPgfrtjbgOFY576w&oe=6A427DE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK4ni7f4aFAQ7kNvwGrK7Bx&_nc_oc=AdrBHL5Qq5ULNAyoiGD10Bjwb2aJRzQMRk4Bklqt6O9pASRo_PTuYUR5WboKNhorbHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qqvJ5UI4RUQ-Y_YQ_T_1r-RsEsYHqv4glbE4EM4gVHg&oe=6A4289FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_a3CqlkcBsQ7kNvwF7JSJf&_nc_oc=AdpDg1dBhjs2V6bB-QRfe4YYy-gMzKGCzFGvPgjW0ldturA-t8LUnlfYHf8IqoWMXr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z5GVG3bRxrKNIr9gN9U1BRCzEsCucSQcFcALbFGyJhw&oe=6A428571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22qfQ7h74C0Q7kNvwE-2Zb8&_nc_oc=AdoWMdF7g4igOEkEHqmUla5ZtK9w0l3deMUst7oNrsslEJJADYLnCRP0A7pSBAN5KVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ldYd272K6bxfQC3DGKF05YKTnzxJkQzc_kcFkl81pOg&oe=6A428274"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIRDvXp2aoIQ7kNvwEF91_l&_nc_oc=AdrYu3p3l_Oh1HZ-ie2V_La__DU4wV4rGLvUe7dCLqTYPqfIbZBrYvgi0ej9jz6_bgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-haCKPy8P4aHn0jO9D0_DjFH3GDZWo3aDp4kDaFYYjjA&oe=6A4290B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__GYiafYev0Q7kNvwG8PU99&_nc_oc=AdoR08HPMrHpkySSrec06IwjUAS_NkO-zKGfdD0P5GjthxQpral4amG_9cU2
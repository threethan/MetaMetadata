y-Wh4QQ7kNvwGM7ZjP&_nc_oc=Adp9apCAu6Rr2Mgr6o2Lh9bXfwOahRkEvDqPDDjhm2G82eaUQ2XBHCZqXPoToQDJuZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu51ktumPe8nFPYRWrpSWpNS1sLivfXNJaH6G7fMyigg&oe=6AE75D7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KIUy4bqkoMQ7kNvwGZxOIL&_nc_oc=Adp_7p2o3BVTdwP9abdr05lOFdO9LoPBPMIsebcZyahmRZstvJuu461PMv3bJ6A8Ngc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4GSYeaxM5eUST3ont6DhcdVkPbLMMOATYVKo4hXSbgw&oe=6AE753D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbdYLy3gv4kQ7kNvwHsvSVn&_nc_oc=Adr-WGvk8-MonPsVl2GvXMUO-cJAFY99IdlflRn8UHozn7HSHPO6P6cy3EaPE1fCXuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLTGWGWcbA5TzjFYAXhVuctsBPDakRKNBAFMDrH1NS3g&oe=6AE76E01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqj6kBvzDj8Q7kNvwFg_vq2&_nc_oc=AdrrLcRfDayDw3ywLtp6gecKQS3D84_bsKpq-UEtnxeDszI7GnrkAXljlXEhXmbOLL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgs9YhKCckuelE6O0LnR92vDb6Trn6TCbqhqhgPmwQjg&oe=6AE761C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSgcHGrBFHsQ7kNvwHlMaJ4&_nc_oc=AdpfMCgdm8AcrNb55uH2EH_CuAnohyCJ9sb88K6_ZzzxtqKleDo-1N1DrFqi_Y8z1rs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTORGZSvw2__FTpb_YkFctdh6PSLNpHdLbvGyA8IjUbyA&oe=6AE76F3C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_V2qC84BRgQ7kNvwEDJlAW&_nc_oc=AdonSg0uS28uSErWLTn7TuCpp4RxnxIyXell_ndIoZ8YRhSrC59-BMLp2z2PnDBeTFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmNBj86X49VTtQ0I8fO8bwbsD-ePWWM6IbXES_M22aQg&oe=6AE76DC8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
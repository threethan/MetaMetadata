hcI5M81QTpFZD3EMOfG9lchvpeyU6XMYM76i2V6En1ifHbFOtr_B6EeuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyin3nekh80lXmQ4hWGPvmkSOXonhMDC75nV1HCWxlGCg&oe=69B2A63B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX5FBnN56bcQ7kNvwGISN93&_nc_oc=AdkLwaKj1Ex4ik7oH8B6sdsAK5FUDlehDlSrPUDypW9gJMTAvxpMGml9wWtAj3UVayY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzNRlMrbPH4JqfcbzIspGQx2Jr5Wvo0N6e0xltCpUFkWg&oe=69B29C90"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23NuyogPDH4Q7kNvwGq8Tsf&_nc_oc=Admo9ZPGtrKE4HD34mBbYsKf27G4pqcKTpuxE-h1nOTUxEQUxd51GQqDLZM7VduXEjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtRFfFtY_Tbl6ZnRJktU1Rntu_f8xxadtHEs-4p6i_Bw&oe=69B2B6C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIsCaGWcvJ4Q7kNvwGTgj0w&_nc_oc=AdmMCVVED3MLVhX6SXZeXW7K-VIB9XLpGZVRFTNeUg3lwL5JUUxjg5R4-OvcfW_K2H8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFv_CxCSBXgLBFQ6pphClFcoMEIm11a-Ft8DBbG7HOWw&oe=69B2AA89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HymGyssevEQ7kNvwH8WCg2&_nc_oc=Adl75UUB_MXLrtsKG7DRhjiFysA2Mjy8ohoLSX0Z0VL0SNcYZHu2bSz4AFeA9wJ78n0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSlKzfI_MNdhuq6hPnSX2aC_lROQlY_nP5EgmCiSXCzw&oe=69B2B7FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_DHrUSZ4YUQ7kNvwFCZFFB&_nc_oc=AdnFIb8FCP58trFw_2sDcqrrcXw8me1yZQvlEXkIa43B2JqS4rWq5-Ie3CY6heNA1UQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzYJP3ShBbmkG5MlugUA5d0l2mfqKoMs0n7ZQ5jjPVhZQ&oe=69B2B688"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
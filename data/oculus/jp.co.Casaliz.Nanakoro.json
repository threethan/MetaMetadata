2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsyNfRWV8pLax10sZKkfUnBvDHXxiAGTyFUA1G5yz-HQ&oe=69C3C23D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dH2D8YCfwIQ7kNvwGLxHSJ&_nc_oc=Adrmeu1jS2yaxc8qqBocfCkFVNgR7Wlxh9G_e7AOBng5n_lmRT4CeqNJn-AiUXcIsKI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpJdQMFKQRSs53ufNqmaE7_zPQx9rzLs1TpahtnNYZZg&oe=69C3EDE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPDg-6MzZ2IQ7kNvwHLs4XD&_nc_oc=AdqtKX8i1kybMmX4lZRr0iKgMvESHxrVcCFldNVq6AItdyDsdtbMAMQCZDLTvlLZzCU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3Q2VCLuEtDFqI_bD2kInU3pi_g5jaus_NeTdlTmlE8g&oe=69C3C1BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADI0xjqoLuAQ7kNvwFrGgp6&_nc_oc=AdoKO13ZqzyFONj_NAVyva3FNvDvF5WRjprMkSoMyku09LPa17Tc8NHQpP7tBMdtx0M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyahuKWifN4Ixs49AWWs4AFWySqKuCPJQ-9Ma-hz7o9sQ&oe=69C3BD31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTZAVHrqLvAQ7kNvwHgDXY-&_nc_oc=AdqEjsHS_bwRPcxXA0oaJYqgReK6EcyDTxy0uMwIxe12ZSg-fLfr4QVhaDS8STJzdwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4DbQt7GtbeM6XNUTgT0clfRpF4gZTe4Pj-BcThX08hg&oe=69C3BA34"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rmcnEKzU5QQ7kNvwFPvvyY&_nc_oc=AdqdKFIf9FhdsvD6mYZRiOEnpJ3ZmmRSz8vPfQh6_0hoCeXmNYlAidBYECzo94whGWE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxRmdPAdvov7YekLJiygku5nsGEKPN5rtZy9_mBD2zfQ&oe=69C3C872"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMW13MofOZ8Q7kNvwF8LLhw&_nc_oc=Ado9z67JTumMeej9i8i0qek-Q18pnpulk2TeF0hX-V5Cx-nZnl_a8KqP6Uxw
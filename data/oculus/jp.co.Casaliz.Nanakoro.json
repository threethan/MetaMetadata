qskqLwQ7kNvwF8oCqo&_nc_oc=AdoBm0xqJ7uSulx4b8ALOP46CBwSLe6rpXgeiJim0sZpuxKLL2U_BwVNykGZhlkpNic&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMcx_tZlH-0VdGDem8lC5DPNLpbAEfJ8MkSW4SStPvrA&oe=6AF9D27B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucPYiHDVJ_wQ7kNvwFgXy-g&_nc_oc=AdqWX4ujefK0gCrp-EWrz0mDGdB_J2ZSDIEgkbqpOEuJCNpmF5AFFG-Ej1sPeNj2lTU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSonOpjoQkTD9w6MNTYIRT9cBPTeuWU80qnAXIjZ4eBVA&oe=6AF9C8D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smj-2UENadkQ7kNvwE3wyVW&_nc_oc=Adq_6bwwPweN81f2YnZhM2edZVltRBQ10471Wa5FYKeEiToR_V72Y_KL2Hz8-iDOItM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1DGc1YoUNfmqT9X5CafrYAxMCT0VNWm5WHEvA91ZmFg&oe=6AF9E301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKF14pVAEaMQ7kNvwE5V6cZ&_nc_oc=Adoou7MKNZM-MxtRO091bizDcwtEm6-Holq_alHbmLtFVo-L8RqlVoj-ymSN8zrtAa8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc7o-ryAMjlmk2wxnWc8im3bLYt04Ax_g8qqj8FLvORw&oe=6AF9D6C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjHqXMoBJxgQ7kNvwFqZzBC&_nc_oc=AdqINUoHxmCaLchbf9vpnRBFSz58sKTwdFadI_HtE9lJITW-XQB-P8jXEs9oynbELBo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvxDheuY_Onjm6SFYNbX-uM5rDSLj6WP-eG5WxGJteGA&oe=6AF9E43C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpuH2PxNTm8Q7kNvwE9wLYF&_nc_oc=Adpri00z1pW5YuMvV-esQWHs9jBwaD7kYTd_JwfXSpFsA0aNRc_0UGuNRS6-pY6Yhss&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjNFCIOwKYI55lbSb_BWdKWyUpxFv4jYB6tqLGVJ3CXw&oe=6AF9E2C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
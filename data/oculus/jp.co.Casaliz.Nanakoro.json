ia037sQ7kNvwGaaGw7&_nc_oc=AdrJg1znjELN7c1APNHGzRysr5uk80-FYCqlxM951DAMUzQiGQV0e6qaKeN6ageWGVE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPur6-drZWK2Q8SROvIJJeoSnBnk4SfDWVzhQ66O83pxA&oe=6AC5167B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGBcxgjuCEEQ7kNvwF968hK&_nc_oc=AdpORzcRhQakEcuqpRTq6HQwIa3bMTNpgiBvZ5qXvfgM4UIhrWOyRwczH6EvvDQM_M0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPglP66wL4hj2Q6rrbP1eHbTExLJhg5evDHj4mIltoXCA&oe=6AC50CD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tURn8OZnijQQ7kNvwGLDAvP&_nc_oc=AdqLYZ9h0isEHN3N8sQXt0ZKj3N613VRoJ7pkgAU9np6fKER8gvdQS0pzWYza6W9RQI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOHRXjbneKLHtmGXb60Q3ne0UXto815bJwDnYgi1O3tg&oe=6AC52701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blMvnjCb-okQ7kNvwGdN2N7&_nc_oc=AdrHRvOCHhDv4jlh7VbDhHRx2wNiyBsWxvmarQ07VTnRoiP5YQ1nR4UEMr0JVYBbd_4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2y9CYQMbnn5cHPHx4syUj7jiCaLvU3FThudK9waqw7Q&oe=6AC51AC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXiCgn2zVakQ7kNvwEPKkjJ&_nc_oc=AdqkOAWtXa3Vcdo1dgYrrpQuaEFd_bK4AEhIoMxtxplM_IHmRlE1Lx4DycDKfCE0mt8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZulZ05eBmc0D7xLeRBztfQs7ZDSmfi4SUxYVb_XSB9g&oe=6AC5283C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wf8Hn7rhy0Q7kNvwEv5kQB&_nc_oc=AdpvQXb1w0TQPhnTN5GdhrC834TXO-bDn32eqpLnv82s2eWPqLm1sawwklt0rxSKpao&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN76gLCke6MuR_GPD5AayxdvzCu0_Ggmi_oqyIuXtRSPQ&oe=6AC526C8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
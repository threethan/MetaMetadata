_4zpeoQ7kNvwEAODv7&_nc_oc=AdrgkuUmYSTK4DbVjG0YmILS3Vi5AW7xLlDsW7o2nVExD0SZRggjgbt4vyyFT2KQ7EA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D_0Osr-ejwEpaJVSqLlAmPOsO5xmRwBOvOG011b9Ouw&oe=6A316E7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k67gKpNlUYgQ7kNvwFb7X48&_nc_oc=AdpfyfjBC6FfpJP3KvexRsppnSpyu-VbRFR8IdDPVCmgtqHZx1swy13Ttrng7AY3d4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y898fmHz9n1aZE5E6qFw6EIwC-OjFTa7Ap7MmJch4qg&oe=6A3164D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQmxClHsUfIQ7kNvwH4abja&_nc_oc=AdrIcG3zfuVdJrMYbjDdywLWqG7jImlPWSeRT-2YPDt2XT0-fzmaUBNxkakYVPV2pjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A7ZE5AkBll_HV6OQ2z0QJhkZa9YpvcF3WPPtLUrNxkQ&oe=6A3146C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HaO3NnKjJ0Q7kNvwHmjmBn&_nc_oc=Adp-2c_Kl4uEPn-6TWigclraD4B4Mvqv_CfAnLtUnxDuLgO5wLxyI5U2_hUifgzAL3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XrP16dkLYbzxBKiDmgk0s_6hBXfb2OxHkg85Li3UUfw&oe=6A3172C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3ELA-glM4UQ7kNvwFEzYha&_nc_oc=Adr6ZoOSPemRwkS8mLhDP0kZcOtuiCXNTGcD7ZqY8AkBEPOwifuhstyx0VpzVY2NGcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PDipBaP5pNp8CpWNfZl15g3UH0-VuY-M3tb14_YFFhg&oe=6A3147FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh5LqmbSVwQQ7kNvwEYvp2O&_nc_oc=AdqOGKOnE8PsP8Rtvi62_aQKj919gUu6O2E_bRWckdr9C6MNVH6girgjovRpiG-UZVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-40lhtDh8Di-3im9YYH26FpyKd7nf0DOSEb1qSe1P69Q&oe=6A314688"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtAXhxLFJKJ_VuvBLCpT_35tMbWvO30Uuui7-IPSFrIw&oe=6ACF9AFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4MAnqhpMtwQ7kNvwGGckwP&_nc_oc=AdqWCD532SKI59msOLLPIVlq2mCnLK_cSr2JtpNyWbuBUU0R4LP5b62KNRhNdq5YqXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1eZPDt_dVJKeYk93aZbPNVZie5hv3M0-emdxtkYWuVA&oe=6ACF8E65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY22hkMWdo8Q7kNvwG_fTyD&_nc_oc=Adqdpxb7u0mLhfsMIi7JSb34EMAerICfr-k8NTnkYYoHFs90p-yADbc_ff4ttiMQlrs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD7B3Tcoxyc1tsKBwJQdqabkHynNkS6NP6V-YywgaIVg&oe=6ACF9A7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bogxX1VAU5sQ7kNvwGTNdo0&_nc_oc=AdpF9WTIBypBxcKiCLVoNZS4OTbn9g7PbkyGzjp6_3MWMTzT5Gh4ZE2Op6_ZEUnbRyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYQtSmr-GuXq-GjTpE75T-hyy4IMGLIgFZKJvh7hoxAQ&oe=6ACF95F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIgub_1kzYIQ7kNvwH9eI0v&_nc_oc=Adpy7bfUh8byywIP48sBcUpw_n4agTKXY-8c7HKsi4RQ96GxKl3M6A3iWPxEa5SoMWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7fO8dq9SvjaqxojhRugM0758gtUs3tSzCp16NIWrUlA&oe=6ACF92F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvvzG9pruCQQ7kNvwGgrNsg&_nc_oc=Adop7Ej2el9wx2yEbl45vuZ7gcetK2T6rcXV1jgPx_8ZITAyuWS75DkVnod8Bg_AVRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3tP7xP3PDlAEnv0hJCzex3SVAOylqfy4YXz74jewuGA&oe=6ACFA132"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaTQE4OOyqcQ7kNvwFla2VL&_nc_oc=AdpW1_Ar61dkTkPZ3kYSK4qu2vpeC03Q4ikRIBWGgYtfP7q-A4glRwkTp-V-
d1vw9wQ7kNvwFvZNkU&_nc_oc=Adp7PDM3BuMfZ5V_846KdE0JUM8RJun6grQ-emMbWYcyykzC867aPyDus2px489tD9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bJKzYLodo-XkWZ-sO9WvgAxvzOZg7aTgehoezPhWIwQ&oe=6A43E37B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y22c6m0mON4Q7kNvwEx76u5&_nc_oc=AdpCTDA-K1NehibdmqDVotgCj5LkAhfL-HT6SBSGcWZPf8z1vuAicsXJqHkcxNAJKhg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UVVBOVDqNPNSsA8OmX1NXi4ut8n3yzTbXfkNDcWmedQ&oe=6A43D9D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=325acn3fCrYQ7kNvwG8dx2t&_nc_oc=AdqCshVZLItraQ5zCmApHgqmIGPrVMUYjJ7hKjjHLzBwvTC4jXUhqtLNz-ht8u60W0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BSn78bbgwkhoQr70Ec-JN3T6oOe6ZQToXI7IcBeVXkw&oe=6A43BBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnJY_Bw7FVUQ7kNvwGHwmIr&_nc_oc=Adqmp2ZvKDU7mU7yBuislOB_-9IdXLPOLx4mdjfUMZKJRhKY6Fo1cowC9X7f7pdmWOs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l3P4HMWg7JYugW0FtK8BMhZSHaPd7OnfdVDBZ9AlmQg&oe=6A43E7C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I87xHDTpGuIQ7kNvwFgExH9&_nc_oc=Adohb2VBRm1-2mzn9xozHgUW9g0VBKXYVmJQC0-hWY8l3YGKFhXDIVxfvydWgRbXXiA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kCStz2BsTL76v-z9RBgEX6yp_a9cWz5ZR9qHqDrpVGQ&oe=6A43BCFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tQKyxZGL2wQ7kNvwEMOgl4&_nc_oc=AdrQDbtyjQ2U4ImU6yygpTvHI2JR9-Bdp9dfpPf07Ur5PyWf593fzjuIZtu_gvrrvvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af887d-NDk7AHZgzFmWm-eYibtlpxJWYaGi6IaWmt9wPHg&oe=6A43BB88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
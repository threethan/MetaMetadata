1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XAyFPUo-ZzEllDrQhwpT1IdDlZ5ejqKL5_GAGtPiYpg&oe=6A1EF1FD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5eWx0Z0kiwQ7kNvwEU5R6b&_nc_oc=AdrC39wz_05yvJGaIIgdCOqFmOVA1VNjS3heIu4eX49Ge9MWnfJ1ojoaNv97d__lOW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69cmum4aj0x7glFSbzr4qYHDiydOiFg1ExLdXNNJx5ZA&oe=6A1EE565"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFRrQONPZpQQ7kNvwFuhtMY&_nc_oc=AdotjjPGtQxAX52L0O4xcYANY3PzSUGQF029UCHVbOqLiVzWaW0ldckRT7OgZooGDiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nuNM3Us3fUhY0pZfQzPMZszQC5NeLGRKC2cKp0C6wVA&oe=6A1EF17B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_6aYpECoyIQ7kNvwF8Rkqu&_nc_oc=AdonKRSAIIY83jUuYhhsLa5JhGN68HxE2zgJdIingDvRrLyfyrqY1M1TGcWeR4xb_Pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SkhRWtNCObrSJhExTyBnrvUP-m_v4kdVV7b-Z61rxog&oe=6A1EECF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz1wNBOheOMQ7kNvwH2G8mX&_nc_oc=AdrLiPhpoZL8QQLmyCQuW5tpamshe5qg13Yifs72Q0p1xcwcNVi6bDbHWrFQ3ce3jTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40Wog541NkEa6l2tSlRVnX_XArMeTvsYua6NfWDNseUw&oe=6A1EE9F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-ANqGh3NrwQ7kNvwFeQ14G&_nc_oc=AdoTKml6XKD5b5SyKlU5pLqsScKJOfvTiPw4RtvSjZU6C_yNUFXB_iHVnm7wnGmYaTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74GD6ra3NupPqz-j5noDSPvGN2fZO7-RASj7Nde5mwYQ&oe=6A1EF832"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8qhqydCPr4Q7kNvwF4OAdm&_nc_oc=Ado3blA9MC39Cy9ZvpEscn6dpspWLzNGz7x38-rFfiEEUUshQx0oO-XkmJhJ
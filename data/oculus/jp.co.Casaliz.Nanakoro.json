F6pIEzWDIbp_rDm4pNP220gX9AlXjfk6I0mHQ4JW5DPuCFq-POezQbJDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfznyhdARv9rXbntOFJsnbY0KNf_rA6_wIZxT4w8s62UgA&oe=69B5493B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX5FBnN56bcQ7kNvwFtPqfa&_nc_oc=AdmVPqpbjJTYvUUxE0xZ4wTOH7tvgIsC955DHeqc0MJ_uq5CD3da4jKtgtvEra71yPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxm5Eh3k6hSYK4I-u55wALao5KExAx7_XftIzUHZEzuGQ&oe=69B53F90"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUrLianhLDkQ7kNvwG75RJt&_nc_oc=Adlpa1yebLpj2pSTp_Z5kANZ70Hkn9mmkBgVdk5vE-snIuEXPowXkeFwgCHYxZNatec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGruAGcolcUPeWQ17dfvY4CtfWK6aXBHCRENb6FuR2hA&oe=69B559C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIsCaGWcvJ4Q7kNvwER7tE4&_nc_oc=Adm7aF-gmsVr_QWCXmu9vpB5i7tNsgq1PBbgj7nOwd_Ow-7MU14bCiUs6pSx4mTnog0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0sWteaUXuz66PI4jmVnLyVId9AKyOqgJBmRi04I1W1g&oe=69B54D89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HymGyssevEQ7kNvwFf0aNO&_nc_oc=Adlvnt2lx8HbidBe57cqJ-PE--F_mlFQ-rV95nqJiWMIZnFN9Oo9TV20wIF89ERg1h8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzioaPKXCkjWOmt5uHzARMJabAhKBBMxAPNRS4ZWGInaQ&oe=69B55AFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_DHrUSZ4YUQ7kNvwGSc27v&_nc_oc=Adm3srgxSwyQHbBSDi0hF5VTHxZRDJOcFvYtha3Y-CA1zK7qcts_ttj1yZVOhaf2CJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuqsyGIZ65yVw6Gi4ZAf-Jlqn9NlhrjR2TGqOskpxZ6A&oe=69B55988"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e
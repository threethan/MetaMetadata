GDQdqIQ7kNvwFUXGEh&_nc_oc=AdqJPL4uxnlJn-sIE3EePDiry4wiW8QO04YWt3W4I0SZiKO-2kpV0c4Zwb1ld6XsXME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vb33ZgHdBQ-JU_ZWkW9eUAEV21Uyyh10hiTxw-NBQsA&oe=6A26E27B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxNCQlpbttUQ7kNvwGi2y2Q&_nc_oc=AdqWIS-vu15RbMua4CalzQq24xrF1l9B1KNWSqzMTHjuJcHu7ouWgzwLkBMZ21ntdIM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nDRhaWw27Eu21HOxnRcLwAW5Z6tLv91UXEIclAF3fyw&oe=6A26D8D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdPKldvefEoQ7kNvwFrlwpR&_nc_oc=AdrbfMz4dS_UUtdmwfycfD4Z1rjChwi928E5EPSfuntt-JYWNjH2m-OFIVRBSaz-doI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KUWX3VwWBN78aIlh50heq8gjHyO0pGYd-t-cdBpJPuA&oe=6A26BAC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2QcEJGQZJgQ7kNvwEyYIe-&_nc_oc=AdoNJFm_By0uo2Eq9nPSeMj8uzSvviqDRuKrBPYAO6Yj-6zErQkWNel2mPM_z0moC7o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TdPt3Cqy1pV3oy56p0DfVB_JMs-AnC-YMZnrrM1i44A&oe=6A26E6C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jAn8U0G1i4Q7kNvwFFkc22&_nc_oc=AdrsCy3NW4woRZmqcvrqIF6qibTX141-LvLM311G7FNj85AM17sy54-eAdZnFHrIIWw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98_7tEGR-fXd6zvY-TQvoTYrDISwhV1_-_GHaaR0D5PQ&oe=6A26BBFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmYA_cess4kQ7kNvwH2ZfWT&_nc_oc=AdrfPKBIEEsAWpDGagw4hg6P8nAWAyvhl_s_3y6v7SGHWmDDydpPBTNMRlgMePVRKe8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6k9ii0vehqeDaxZSFFI4Yv0mYegLgHluFeyzrnv1wJA&oe=6A26BA88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
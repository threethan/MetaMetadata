1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_I9DOSSyPVwTFBs-K2pBOUbYc3hLnBFH-Hdirno8axg&oe=6A82EBBD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVHg1gMm-EcQ7kNvwHiB85i&_nc_oc=Ado6HLYaqSPY_jCzyk7Bbr-9q7GMlkrbvdzp1mrekaX6TxDQvfvBDtwsQUbhgOOf-GY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3a0tPvn5RjKnxlMbPOkBNAEcMM1PFF6uIZF-DkkTRUA&oe=6A831765"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9ul-duFQpcQ7kNvwHr3nCW&_nc_oc=Ado4rUuCNJxBY2GbK7j0amkYX87kvxo0YbdOCJoeksXTcKZXt7RGlAuE4QByysq3v_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwTSG8SgqlE2h0iJZOl84y9w1x5NTrKOLkAcQyfpxznQ&oe=6A82EB3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL12ZfVGZcMQ7kNvwFCfKCM&_nc_oc=AdqJHlQp4bDxS9eM1om9XdyMtg3pGO14Z7uW_asuYx7zcwAOJUbcklYAOak3tQuz4dQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfxiNt6uFo6T6LKc-GcTkJpvyKhct1-gj_QtLeOhaujA&oe=6A82E6B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWCWan1FfDEQ7kNvwHhYBKg&_nc_oc=AdrJ7LEeaiwbbglKUqSKnUD_I4odxDI5w1wy2n8CFFjlyaGZrSclnjgGpsB5RulZqBQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaAJtTfZxz_kXRRLK4T-7nVqo_b_m0D7hYWuulSaVSog&oe=6A82E3B4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQgu4J8n4wgQ7kNvwGfhfsY&_nc_oc=AdolqsPLGYXoFadacZvPyXQH778dQoDnGsaAm94wlI0sPa7Izl_RIVxRB4jqwsXzBU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhkMMyTHOCyZWe1TPpvHEgML-5BAJDAbiLjXgsTckyfg&oe=6A82F1F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQibRSIPFI8Q7kNvwEzdRjv&_nc_oc=Adp8pGj7fUUpZivStQBb0ZzW1Wxnh7vwMUcFRGJG24blgP56gB1lm97iKnRl
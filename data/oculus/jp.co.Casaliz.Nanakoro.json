C3d5jQQ7kNvwEFsBwR&_nc_oc=AdrDII__UEqgLv6tcTbO1xzEzaeVs4ayHHRbdB9jXlabqMwZvCrLCxvmkEACsPKXQjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2putVrhXp4J4GuYKJr0efEcB_nuoCDW03JuB_OX04Rkg&oe=69F885BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZoPI9YfAUMQ7kNvwGuh2Pp&_nc_oc=AdpCo5WSqfUSUgMQ7IGElTbNiHl47_Tx_Wj9oXQF0jXPGIHX6KDQeMP-MUCl63voLvs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QZASjrSJ65dluCWTuNldY5HwQ8p0BQM1m2tOXb433aw&oe=69F8B450"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA01HN564IwQ7kNvwEP1JP9&_nc_oc=AdogHVzhm49hCcCFda1-4NayNBrQzBj5mD2pdA6dunQFca4SoH0mVmnDYRGSPDCpOfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SR2KoWz-YmXosTaYJY3EnSvWedvS_hIbODbixoTci0g&oe=69F89641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNZ687vt-sAQ7kNvwF0dtus&_nc_oc=AdpUvcTk8AT0NcdqPY2MTbZHVCcYl5emqMqH14yijNb4GZMJno9-fMJ65-8rqok1z8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c556f0l088YG1V_1G5n7LpRggS_MThJSK8iqDFtbJbg&oe=69F88A09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiHFlljmHKsQ7kNvwF_rkH8&_nc_oc=AdpP9GH6NHKZtWfqW-D4n2bc2F0bDH9s74E0eMBR2Eb4Mjgw2QLo6S5Y5ht7iBkOZPI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af253SfJAc-ZEwd3a3xbCXBq0CqQwyfadEfpnO4L9d9CQg&oe=69F8977C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkEDtulm4IAQ7kNvwEA2Em6&_nc_oc=Adrkf1lzMVkGHzXn3fTgrsIz2uoXsu2raiGull2amf1HxROFPaPng-oBj6t8Nyq3Tuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eCn70h48U9BmFckcdYgG42qXf4Y4ueMufPF91A1EvOA&oe=69F89608"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vVoCOgZYtSZf93B3aWSIC0ZFah4DP8L9IR_9zInPcKA&oe=6A467EFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uQdFrvy9pAQ7kNvwGHE6O1&_nc_oc=AdotK2GVHnOJBt6EQ92Ak3IWUox9HrpbHlkuLG0_x4UNkNQmCS_X3NU197JeLJVrO1Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kzi-r4vFPVIiIdRQHBZyUXvxhNMEA8BpKjLhLllxGeA&oe=6A467265"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF1MhDeZNqcQ7kNvwEOx3UC&_nc_oc=AdpUjEpZc6znrNdMdv045RmfkBtMr3jjdlThNX2OILuuB91YQZhKPif_G_LGiz7mRWQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1HDDE3yMbi_8om0aD3OAUYVxRwiaNEscl7cdbCQvVBQ&oe=6A467E7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjB_WD3eUDEQ7kNvwEfjhyh&_nc_oc=AdqyJjOnV2dqQ4-ljVbALV2mHiX7jUY2y4BEh4sG8XzD_G541KcqJ_ZV327ieBKLDTs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89hLIVyCOJbUw8dvKZfhwfbIG0txUWcmHBnyqxQJCUdg&oe=6A4679F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asnEOw9oNr0Q7kNvwEWkwu-&_nc_oc=AdpBhdh2dO26F0Pg3yvt8en2KuPmQaLazUsOdzcB6oVerBafH1CKefrCsbSoVz8BEmY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xcoWPBcvs_fNsTReOgpoFArSsANVdgLAfMmcsIeD-sQ&oe=6A4676F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m01QlJ_7IgUQ7kNvwEUy2EB&_nc_oc=AdqhxBabDeP7o_iRn2PfLQ3MkdYeuLMoexjmGvtRC1UKuT9Pl4eI2iVXi9C8ZcR-d2Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2VsNSnzLZaCmvT8oB-hiLRA7_UipiqO_W1oUZwN8Rmg&oe=6A468532"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z06_7tRXuAQ7kNvwHt6RNz&_nc_oc=Adpz89mZ5RrP_Qa4mUKprBlJs0yE39WgXpNnzJOZ8U
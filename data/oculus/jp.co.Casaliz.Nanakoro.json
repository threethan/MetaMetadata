NyYgXMQ7kNvwESROSg&_nc_oc=AdrUVQlokgwNKK3YPgPf5peTocRBVDU2nHDmVHY3Rj3Pb9YSpSewaOXGIIuqUishjBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtFe8UkvfpMOFgM5W03nTlxmu5vcXefcXYCyF-1RBdWA&oe=6AF72F7B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucPYiHDVJ_wQ7kNvwHXPtJg&_nc_oc=AdrlTAVRWr68O5HLohqG96V5oa3CkD9YCvUnAxGHFYsYU9MY2iNQI6ccEm-rXM7UUes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjX98a-K97T7JO7ZsRWpHIzQsVut3V55GY2snUXTVILg&oe=6AF725D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYPw-fwxfcAQ7kNvwEAMVGV&_nc_oc=AdrvxhCPmT8drO75QUa76-zDf_W-gv-nFadf3cdX2FEr7AHDTDdQM8bMILZYKmDJaQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTsV_SslNHxu4yOqMaC4PqWVqIbYJRHRvSC9ab32sQ_g&oe=6AF74001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWul1Ft1CacQ7kNvwGd3GhW&_nc_oc=Adoj-IOebBV_hiDjy4gNN5GQHtTeDm2T8eTDZdlj1UUne89biz1PVLNg2BN8zwGChGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJBdH6D4gy2gwzq_OWdFcNv0Zo6ZtAhgO1wbLmRCfSdg&oe=6AF733C9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjHqXMoBJxgQ7kNvwEHJxvt&_nc_oc=AdprRAHy8aoB5hozz212VRJomSs98h32Ms4W1RwI_p0oGvrIpbIY3iUP122nL2hRTA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYut5zncdbszAshWgr6BOw7ZK8e5jF_TfCTi8RyM5CJA&oe=6AF7413C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpuH2PxNTm8Q7kNvwHfqih_&_nc_oc=AdpPxu4CCWy1jbwuhktkGGRQ9eHwRxBY063zkgzh1oj6VmpdnbROUadM7irUWP7B5yk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDIqR57yWj40qfdk70kZUe7OdaP45jFFv50-ZpmIPeaA&oe=6AF73FC8"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
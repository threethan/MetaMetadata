jv7Va4Q7kNvwFdPOf_&_nc_oc=AdpL4ET9OJxDjb_t0BLL_1hPYGu-N-i3kgY0DKeKmF0-XcF4kEl9mky3B2n9BURc5dw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmkVf09L_-WKae2qxgsgKlFg4dKK9xeWD28MK-FW7u8Q&oe=6A9AE67B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaoD8gTKpp8Q7kNvwH0UhSr&_nc_oc=Adr3b4d7c9ApXQwgxSeLol3_GshuOfX9vT0HOQ2AwO1tUGbpSWiijpEHnXpekwrJBxE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZOwfdjzZQnV6_sFrWyNwGkwvdlo9R9ciWDJeyDbFwgA&oe=6A9ADCD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcrYo3n6ox8Q7kNvwHjxkHY&_nc_oc=AdoQg6TOIWqm6eBqhSLcmZA1ahhAc56LC6lymix0FS1fz0nq6XLz0k0k8WGHIVG4vIk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoltKU5EM1gEqIwFQFs4QxS_DDMncIiXSiBTYJh_yQbg&oe=6A9ABEC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC326KyqFAYQ7kNvwE3GlVM&_nc_oc=AdoVdHoUyZ3FeeseGVoGYEOcZBHAoWadCBSmvCxQWZ-tpA7AWk3qxaG-2M2s2X0LZZY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrKLModASdaO3yp0nmLsZNyZ2QnlE_zgImz5--sus5sQ&oe=6A9AEAC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiE916Gu6ZUQ7kNvwE-wQEF&_nc_oc=AdpodtRBa42ywt_eM17gjM5MUFTLVJ1OoWYLXUmU5WkwVV2PL5pLUbASG3s6wY3IiIo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4Xh_bnXbMkRZvFib9HBCtyDh6PP_h3Qjd1XwwIOQnsw&oe=6A9ABFFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWKrfcBjXNYQ7kNvwE2IbHg&_nc_oc=AdoGKjyQqeFajetCQnSDGDUDElHb3GfYGC_839qH-oK-cawitnOflSbpnHNvM30TmOc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI0FFhMfCsX3u_o86oKEx4UhtqG_e1Lw-JJFmU70bLPQ&oe=6A9ABE88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
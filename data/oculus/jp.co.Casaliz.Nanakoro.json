3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwKe3LdCfG6R5Aqb912x610mB1k37wY2_E3G6z5fkQiw&oe=6AE8A77D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_NUI0osrnkQ7kNvwGcpwZk&_nc_oc=AdrvYePwwIqIZciASaq-Pj_lKdV7iKiunwStawzzCceDn4oLOzIsCRkcMA8F9GtH-bc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt9aMQs98msZJNNHktBC_9LwbbG-ANhPGyWQJoFQkBbw&oe=6AE89AE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjPAUYdQ0TkQ7kNvwEnwv11&_nc_oc=Ado2TPiKiMLW7ykWvKsmVmCgTG9LFIpDaOSeFm7G6y9hSOAjXeodSa6GWqLYKL5HJLQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT-3PpGNBED1k1M2hte1VfcDMEvR3gprmjVPZcMq1A1A&oe=6AE8A6FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1hHpycTo7MQ7kNvwH1ZiIt&_nc_oc=AdrapzSs-N6MKx-MtraeKS8LryCY5yv4VeX9R80-bbwzhliG6gOBAbkpodziGM98I28&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqNXffHQI4fLtF2u4ZKUMqRh5_pzb06zIHDLfNfm_Uig&oe=6AE8A271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GRL5mKovxMQ7kNvwHji3XG&_nc_oc=AdpeLmpzLGo-awprUUv-cZtcEP_ZOUF9WGzf1qyRoD46yk61Bq0v8ijeQEipADpca8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjXN7Kx1-_VBUTus817HkxbJSePyR5TtVWUCStXmWx3w&oe=6AE89F74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcozkUFfh3UQ7kNvwELg-_s&_nc_oc=Adou_S4IpKfi7juR9h-Ko1aBohqfXRmZDFXa6hFKMgoViw9lZYLGDy8SXTBB0vvewaE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3zUErcSOo5aeHc4o_mrCfebp7zjSpA8opywLrBFT4Og&oe=6AE8ADB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bAZcn5_9EsQ7kNvwFmUi_v&_nc_oc=AdopCKe0_0JCnGgrjUBa9QAHsAE_5v2Aiinc_1o13vcfVDuCq0t63gcCzIRO
iNvjksQ7kNvwGoTvZ9&_nc_oc=AdqskloNrJXbfBS2g6ycTFGjRHcL0hPtcVXDE7zN4c7AtH2il7mV6xRK4xCu1i-Ao6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXR5DQdwB1NWhIjKA7ZPlDiNft2qcuiejFfg8PHfeP7w&oe=6AB14FFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku9nrh0ZzXsQ7kNvwGZjcq9&_nc_oc=AdpgqR3TjjF9CsqPZVBz7PxZO37sseim84IWXV0-IiUR69abaDRQdx-f9PrSQPudnqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYxRkCoDAM8-TcsgE2LeWJ4xsK1Ui5ote6R1k_xZnh4A&oe=6AB14650"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgIpJ-d5ECwQ7kNvwFttttK&_nc_oc=AdrRHLn-V7cavZeRGnbCDTAfWHjQ-f9ajZaRSh1hzWlYKOKG9D1zpG0YkHkt3t02gBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQBRcwRfuwX8TRaC6ppeIVz0vNcCeXA5jNvzVZCWHEAQ&oe=6AB12841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQIczeeLzMQQ7kNvwFip_9v&_nc_oc=AdqRyePt6aurK7yWj9rPgyP1jwLKGv9XBROBS_2xy-MYkIHWLl7ubDfuV2kgsR_0f28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5-oGSC244gFFy9MY_UAzgFO_ObRdN7hy-6FVWHF3eEA&oe=6AB15449"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ajIlyeBi0EQ7kNvwFwdKg2&_nc_oc=AdqZCFnfYQ5eAbWmSiE5lOSsX756gMfKJcHccn4yaJN0dhpqqnwYVUcbk4kF_HIKRjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyOAwnJozENbar4UZXoyMwnv07yOY5VnUHApqmdhv-pg&oe=6AB1297C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUu-EBcSNfsQ7kNvwHjb_wW&_nc_oc=AdoFsmrGl7wvVyIHPp5lZaUdGmwWLIyqYqEMcnFIhvojhlJZVpxgEBWXuRhEyTSITgY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs-hyqTqZ4AaKsWifElV8iMtn-EKb5jGsDOsllj5JaxA&oe=6AB12808"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
_PxBwwN3mvZ-0XDrv1M40dueiHjykuNIQoopBQ&oe=69A6ECE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-r_lzM5U1YQ7kNvwHWTdQp&_nc_oc=Adn41hHidS5qJsvqAgibE0fObOVu-oXQFm5tbOkQDLV6Hvtbhi84tMjSSU-6TUEaVKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJEaca9Io6NpOOde4i0o6-mJ83afEtrImoQNSNkVSJAQ&oe=69A6C0BB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zkEyA-HLkIQ7kNvwHLC6a7&_nc_oc=Adlk6hQiyWvd23BvK60Y4Yw5-v6I-DeZqkEQf0Sn6hr4BvbTNuLW5ifhGPk4j-mXLKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuoZF5FCQKHO0AqiNOXEbELaclxj4wXV9Y-lVUaIPefg&oe=69A6BC31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm-48tWGvocQ7kNvwH7hHa7&_nc_oc=AdnnceF1HRGLfGHLs-Ejv8mdYTlPdBXRYZHr9XHCJmsJe-YeiEOK4gDBnsDCDTRcLoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7lPOcErIRC-zi9JkB2BTu3DCZFV0mntNdk8SwyUCu6w&oe=69A6B934"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXE-ZLkX6xQQ7kNvwELCPDQ&_nc_oc=Adkfrh2iC5Em4PSNmwQu7mtjhwmFjccLAY_M9ErtOyGju4YsW40Hilz4EvKFYJ8z1lY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuf1ZsxaBP0Evv6L3bv18nHfepJOfn_RyZ8fzIi9Mmvkg&oe=69A6C772"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NAINkFNMJ8Q7kNvwE0yK1H&_nc_oc=Adl2keyaPhdGs_qn4mL9rZm8Wpc74GHZtKVZqW6tpbpL7y8d-aa3Tj6kOLkolvP3tU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHxWzGw_jbO6cB7uWmFISUD06_hMq_wodM7uGh-G1WkQ&oe=69A6C403"}, {"file_name": "2560_1440.png", "id": "608617901157423", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_608617904490756_5422133007871785041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Q5ZAbSh0oQ7kNvwFxb_VF&_nc_oc=Adki0Shd_s7EvEpcq0_2_jjdOdjtgl_sDAu8gtx5am12q3pVKdK8ivgkvjd3-nZwG_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftl_1IRP
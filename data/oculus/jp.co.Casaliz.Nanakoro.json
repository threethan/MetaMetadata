1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q2XX8R8Offoxv59728xjX-NSgG492SggymSx8DNUGEg&oe=6A32B87D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXwnITFXs0UQ7kNvwEpyLoF&_nc_oc=AdpfOHKOjYkZv5JVis-4ERch4hR0n2XtrQ0-ifuGYYjRQ43ucbFal1nQygvB5ZP27RM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pvv5kMKHkQNIXQuIknOW-sIFr-aygIffELp5lo-Br2Q&oe=6A32ABE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fmru7VO7ikQ7kNvwFbvS2W&_nc_oc=Adosag7SAIiaHdDIds_7w_SRY_crl-Ad-PzG7G22CmSTmAUXIbgae59dbhjBJ96mBJA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ytNn-5gy7G0hHQreMsw2b_pc8ej63j6xxpGldHGqDDw&oe=6A32B7FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpDydPShyA4Q7kNvwGw4F3G&_nc_oc=AdpwqQ0hioiTGZ24m6BDpkwuS471Pqtm9pNXb2OMurshQWf0k6acQZB6NRgq9gM-Al0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tPEjayfspHv4czWnQqndLvlHGBs_nbemOpeaZw8R1yw&oe=6A32B371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoD2DcbKI6IQ7kNvwE3uc9P&_nc_oc=Adq3ZT-h5xYn7igXAnM0I_shJ6Z6W-TdP7rkIn4ufmSJNHHsqcM6-R1HOko-UeJi4-Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AdHz6eLC8JqywFc6Ilx1lqHO9s_vSPAhOTKfyhoDqPA&oe=6A32B074"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ9_qXFS78QQ7kNvwHisP14&_nc_oc=AdoTo8hiTYHrmKHPYsd6SZEhhMkyj2nYu263zVHxl8K4Oy2SglUzb_zFzIIrEBqjReg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2Y2EiUDiaJtxT2CB2XiWkrzSvYaqVyJyboJ33VcXDeg&oe=6A32BEB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQuQ9V4ptTcQ7kNvwHcYZsm&_nc_oc=Adret7T4jZ1HowbJUlSiGv4xfDVG45w-gipJWltAL_ORa1gaRbgC4Zok9ezt
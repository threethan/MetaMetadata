1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIann3HfDa1WXcm-0Zbugg7ANpybqYCx9SWJlAWhUoNQ&oe=6AB7DFFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGhkdw50u3IQ7kNvwGp0XZd&_nc_oc=Adqd_cnRoiVgWHXjxd8F3aEgP_c-BJbVfJsVyRoqIzS0OCgx2bEGHjE-uA7wpTtgTq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKwV53-h3m1T2sIZmvGj4O4tezFqkibIooacsjpmiNpQ&oe=6AB7D365"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T77zW9xmhC0Q7kNvwGPdLH5&_nc_oc=Adpb9PJ7dyabgo-jXmfDiv9VtBOqTy0lw__ps8DZgOs5r_E4nhVrG1ThBvyMfESJdxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiFtWvBHDIkD4352OaUPdAi2G7ydNEVPN1B6xBUNKU1g&oe=6AB7DF7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dik9zT2ZoAIQ7kNvwFCXoGT&_nc_oc=AdqIdupy7QxtGXV83oWWFp6q3HQ82y2PlyzqOk01Fol1w3K07pVU9YcF3eIVoL59CbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF5doMBilgowJORv5MRDGicIu90Bd9Dkx3WyYqyja8eA&oe=6AB7DAF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YArwuutlUKwQ7kNvwGwH-2F&_nc_oc=Adqf9fgwvyec2x7XzQx_dkMgSYPz-HCP_0SzIlOh5e8ECDH6d4cH4g_NemJK1FnYeHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqDMC9dFYdPZ_Jcuvr6NOl8GWO8AQf68q0qZUhjZQkmQ&oe=6AB7D7F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuzp4ubWr8MQ7kNvwH-SETE&_nc_oc=AdqnxVkbnx_ZRBpIK4tjNpFvqjWRLZdLTsH-lNU1wDXPtzcQrq9Ur3MqEz3Ro54gffo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJaaZkA28VfkiyDJPweNX3CaEksX2qtQH5DkYtnn-ffQ&oe=6AB7E632"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gry5UbZyw3MQ7kNvwGOpb-I&_nc_oc=AdpSpd3qiFahKPrhySpHQI1eBmzXlaFMfk3HXtt84UB5k9Cl_nO7pKMtsmNv
3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgMi1IZt_mfBx88AuHOLZCpboBXojh0ckycBp_dChqkA&oe=6AC50EFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLxmG28HxrwQ7kNvwHoLztf&_nc_oc=Adojo9i9D6aAsJPxXca4geYajX7MZtk5Da3wWvBXdxBRwf0p3p8BtUbU40WLJ4R8YIk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5gOun8NCD1sREP3dZuEOtdDHSsKkpNtOuHoEA8tTtZQ&oe=6AC50265"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jrTL3xsqbIQ7kNvwEdurzB&_nc_oc=Adqv4a4N73zXMJ9nsbC-wB8J0EfHBQOrjhDFIzyEw7ZxYqGVdDVJ1Th8quMMdzUw22s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfOTt3Y_0HoGisOVQCgTFtwVhFLoIpyuHOj9hHsB5ZLw&oe=6AC50E7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJYTqzeOdoIQ7kNvwGL4jGe&_nc_oc=AdqGx1A04yvBwd_gIANBltDiEQNbTqTlnUuv3lKKREnfAbDxDMJzjnK2SYmaiXJUlnU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPL18e9RMr-XVh08ruSTrdBw4XwM-nWpQUIWMhOErwyg&oe=6AC509F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcNQN47s_c4Q7kNvwEzQIYJ&_nc_oc=AdoXlSxePk3g_LnKCUrq3rzg5VojxKVZq4qYmbV2g5eboISjbDPZa2vn9BXf3atVC94&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIgk45vryeQ9Ad8piLsnpfAuR_WgFqEd7XrlU-w2PuSQ&oe=6AC506F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUUcPfQZsoYQ7kNvwHLS1zk&_nc_oc=AdrhmRfliZrv03EVDp3qJJQkmWvpcDRT9Y1YlAgBYGDm-X1V0_VDIxg4PBF5AvmYQC8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaADzkjiyVAfq184hjhG7Rhz6dJLKJ5tGdFetEZhip-w&oe=6AC51532"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvazGCuZeBgQ7kNvwGLpRGQ&_nc_oc=Adrj_jHQALudCCWRVPmIUKP2szMIayddXgrbXzC26tWSmvTVBf5rCWEPXtfa
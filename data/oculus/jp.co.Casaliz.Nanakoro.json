1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AJxUPsAnZajt0ay2P6LgJocNyAjUqYmhRvGHavT7E_w&oe=69ECA0BD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vphOstCs32cQ7kNvwHIj54z&_nc_oc=AdoeowfnKo7VkRTSut7q3gfU3Y6EHrGgsGA_lm4fQVzWWLMdwSPgu882IaLnRrvQXIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aiw3gYZX3v4W6_jL1PcG-B4z-A6O1vFl3OsaHG0CAWA&oe=69ECCC65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIrk6WdO3csQ7kNvwEdsQTY&_nc_oc=Adq4HsBuH_OTw3LIB9EjogJly7ygUUUW2a_00aBIfXPUAav3WRRA-drZnBRWxKtTo_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38dR_pTXmofjB2pkbVcpkhhzUTB4s8rJ78PIcqcjrPBg&oe=69ECD87B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtWebr0uHzEQ7kNvwHW931f&_nc_oc=AdruC8WmcLjI6pJY7-Ry09HwqPkNXJs7VW-Ldhy_kdlk1KmyTri36vJz8DhhiWD2MWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p1NPCBEj6ubOSzUG44OwP0RxIC5APykvBfbSFe-O_7g&oe=69ECD3F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XdLpVCVwBQQ7kNvwF1ZeKT&_nc_oc=AdpZt1VM6pdCSkYOlkP-CXZ_4NBfabaf50IQAhJCKhFDOdyzmjBY6E2zoPhR-P-UhK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_zLhwI_OACfkuPBLzOY1TSCulVWr1K5-cEWTjc-gNng&oe=69ECD0F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doAw1u99-HQQ7kNvwFqBM_r&_nc_oc=Adow0ntRrhLlgXbRPxkAJNSojsm6TQwKhEmXL0VfEzjjnN6MnrZkoranpEKr_T10cXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wT_Yicpk08bYtSbaYe7YpLiGCDioTGOklWt3FNCcpQw&oe=69ECA6F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgtg5ujthoIQ7kNvwH3jJbe&_nc_oc=AdqFG7uDL3QZFrcrClr0CsqlueJUV3dUP79F0PcL5X6uHF_9Q7-8S9hki44c
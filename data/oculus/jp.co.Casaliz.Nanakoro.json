1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf861NYCxn7JqxcHgLXbzA8ySNEcC7Fr5uD87VP3Dmbw&oe=6AA80DFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yAT1Gw6aSUQ7kNvwE2tSMf&_nc_oc=Adof_xNc13hBMi83BTVpiJ_AfZwjGAiiZFW6aC8CDcyPcrTRH633NqiNgcQbIke5Yos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIyMDxD4W4n2Oj47EKsGO6DkM8661RL2d9uHq9efmszA&oe=6AA80165"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY8DHqPXHZoQ7kNvwGXDIz-&_nc_oc=Adqba-4OC_08ol2SDj1u5ABOkVMvex4uahuoLhzI9HReiIstpn7JBKy8HPHynyP6J7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1PJC-ScgFE2kC5qUoj8CZejlSg08BI8NU9tXa13gtBA&oe=6AA80D7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lcxHutcNJsQ7kNvwGhmAMG&_nc_oc=AdqZu6g4UTjbr35CKRlE2nI8nLAlSDaJ0YiTZxVUkZ4vtha-t8Zfvt3VNP81Rq7Wmoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5qAMZU5evaN-U2mAp2hzeFWeYmE9qsenT3jFKTFQRpQ&oe=6AA808F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KSCOQI7MB8Q7kNvwFnusUC&_nc_oc=AdrkJzX0TRZnZShdojbe6fvUoOXwromedBjEUHaMdZonzHbx0nmDItvlENX_1FvJKYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwHw8_oBtLWJde0Lx7mqMUWUSPOxvS68oPrx946johYA&oe=6AA805F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72KPrYKJztAQ7kNvwEEdHwd&_nc_oc=AdpjUB9zWM6PF3l28Zx8wM75Oj3LmWUQr_QVvJiZia9w-ZgWLwsZjrraXG6IEOS98qI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAyHLnEPTKNUc3BKXhi9nMR3KUSlp7w1Hd5W5XFMRWLg&oe=6AA81432"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLhQrJGW1skQ7kNvwFVk3NC&_nc_oc=AdoE0PR-I9uYMmgmIdKuE_ASXM4Rh3zrIgzTn2N37-_FgWGniGpHaTz6ASd1
_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp3nq4s5v0tQ5kU_xRqnCp48q2zf_7xNDlcuTfX_e3Ow&oe=6AAEA57D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSpq68t96BgQ7kNvwFiidEK&_nc_oc=AdpYqYBqCKGZ50UrNKSKkR50pCHQPY0pVyLMZGtGQvHHT4ywkpckFBR8P1indJlcMy0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL912RyNre_bk90w5UBV24NQGNKSCk-kciwwjS8QgFyrw&oe=6AAE98E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGaGjZfp38kQ7kNvwFkcLbn&_nc_oc=AdocsyarIGcKi-INqv6T71I8jlcQh389Vt91TQ1FpZ_Y2zJLidbHcdD-wOSVZd9-yN8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAr7yy2_5oauRHgsZMvMoXcLBK4vfc9GUS2HOiRKKccw&oe=6AAEA4FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imUdDyG0aJUQ7kNvwEpLc0Y&_nc_oc=Ado9SQfw-gHqUvLqSmOOUGFkdrfumggzYzM5nyYNICW_biaP6vXd2dCFJ37iipJA1V8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6u6vvFbdOSPZCJi4rrT-HLVJPxhTHO7LeRYbbsqALEQ&oe=6AAEA071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N70MHWezyvAQ7kNvwFO8wzh&_nc_oc=AdpFmmY3RfjAJ98yj-3tJFw7Q0NQw86lOyuSvCzcEl1hSfyvq-IrgnVmKhICSxp22ps&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQeAoWTly8KRVZ4rmaZ9mTHVjYPgVWywbWjKPd9oiYJg&oe=6AAE9D74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P634BYEulIQ7kNvwH6WzCm&_nc_oc=Adq6GcA8c-nosjBfN0TwMG6gMYy8Zt3TVJ2NXffGf6oK56KWb3gHpHkRVJyhhap6IIY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRg62YrY1ukiTSiH92FME48HAHHkIKRf_Pu98NXgg2ZQ&oe=6AAEABB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pHGNmaSKYsQ7kNvwG-pCJd&_nc_oc=Adr-QimMWdMK8ZJ0rWJP8ygJwnqiHyW2_dxdBj6Eri
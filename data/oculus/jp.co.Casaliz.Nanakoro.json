CjPItoQ7kNvwEsKJug&_nc_oc=AdpibEIRzCIxFtz5QT0ZSYLcdgWyzE64dL1etK3pjtAsnUOXqDSBPPVL_yB2lMJIOUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5urXtCcZVjxMsEyxz5KoTKS9_wpUPL61N1r8ZIGMwFnw&oe=69FCB27B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MPaNV6iHvoQ7kNvwF_5Ak0&_nc_oc=Adr6vm5ATmDa6d63ZZSGsFT3M25Kb1U69mEiUj9oT6_bFXE0lvWHd0FsYTKDBEL9tlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4joyJhY81hh6TsJAVbFbWNjF6esi1xO0Il6dfeon587g&oe=69FCA8D0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFdY3HpMoCUQ7kNvwGDZqVr&_nc_oc=AdowqeWaR_F4u875rJ25L4bB7I0BNaTrlnHmo7EAoJGK5CEU5j5G67yOUuJ2hhThMpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I4OQ0TII7y09ZV6NeWvtQuxvMfKLDSYmsgODSBuFEqw&oe=69FC8AC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqpeD_Dea-oQ7kNvwHZP7ZW&_nc_oc=AdqFVNleEfTbgrMPrYw5l7YxavU7ONjdeblhlojy8mpQth7df4qi_Df84miGzuxeXuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QYZMjJrQ6ynp-zkzFpsHCU7cf38tHPOqqblbHljynbw&oe=69FC7E89"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGWU9DIhUoQQ7kNvwE-NJfE&_nc_oc=AdpiEx47xrmMseTYVKn-hGGLH-XWSua115vZQHqcIPImRLiglLeGRrBSvzXYxzy6cvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZaSIN3yAfK5nu1OnnaKYDwIz6OlcJqzxoPegBNiq-xA&oe=69FC8BFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-evSxDdujjMQ7kNvwFQ3Wdh&_nc_oc=AdoVoL0K8wpefN-rgyoZ4j3hOA3_sjVFd6nXcxmSs1vWNOzz3SeXxV5hfznc7UdSou8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YI2ak6zxZSqyaX_k2pindHcWT4n2l2BBOvAUKVJ5Slw&oe=69FC8A88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
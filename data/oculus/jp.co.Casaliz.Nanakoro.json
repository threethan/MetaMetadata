2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9FFZbF1cuZBvWBPozPhNykverLxe8mrp3WhUspRwzug&oe=6ADF6CFD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUAvZz68GHQQ7kNvwFRVqkx&_nc_oc=AdpYv6xK-uaFhR-Ag3naVHssFZKBksLFMqrz7llB5fTAmK0wDTIpxi2uUbTjc9I46Dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqWWBwzhhSN22WId62Om8HP5wtcbCNpvzwislOwOzGUA&oe=6ADF6065"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIMqlSfLQmAQ7kNvwFhAncu&_nc_oc=AdqBoUheoMDYBrTGCEl32wrxCZJRyHM_ZJbf0PqiqgrRXwTm1EtC3LXNUkU3y0HWtXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-_cSPFcbC0GYZYDP8hi49eYGFZiJk20lbJOBFO2YUyw&oe=6ADF6C7B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hh_XdEQFhoQQ7kNvwG3be8C&_nc_oc=Adpza5ZGaH_hj9-zmIi59TlJx3NIXJo-fKDZ_3j_0NOyTF7qyr0Vj4HwIb1fZjglTpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3W3qbEuAgwx8OjGGBOp1csMslxkhZ9E6lnPTpcxDu_w&oe=6ADF67F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnMhh7myvggQ7kNvwGykMaM&_nc_oc=Adqk1Oh2SpCJuBJrf_nnVHFW_SjqeFK520Oz-YAPAJqF6THd1uhaxAdl2D9mF1ATkEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_0Ck7OY5qCCDG6I0ZobVzk6LRU0ieSIk6UwphN0biIw&oe=6ADF64F4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1TMK7K02ZwQ7kNvwF3kRka&_nc_oc=AdqsBnZ-HFk0dkosHVCH3_3Iaui1x-1PyuydDkM6NHVevuMj6WKGDF2MyPV4raIpsoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmyxVDMaes--ojfs_X3Np4ocPVVbL8Ft9fAI2le8fXpw&oe=6ADF7332"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gu-r74w08cQ7kNvwEoql1R&_nc_oc=Adoi_JYGagIgtsgetJI2DnWvkGAlczOb9h77MMxjEWeg-HdOJgBMDZLAXuZg
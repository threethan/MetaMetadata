3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP02tjFujuTQ3E38SvFF1KPAtCNmcHVNMq3TZ_By2UUhg&oe=6AD0EC7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4MAnqhpMtwQ7kNvwErcJwK&_nc_oc=Adr3s3k81ZtpEHRUsoCRIY0g3TTvF379dVwlIKyLGw3BnekY3Av7vV7d63hUqODTwNw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDh2Dq9vb3eTLS6UdqAXBT2tCpeJQ9_Fz31z0Nhx7IJw&oe=6AD0DFE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY22hkMWdo8Q7kNvwGFrMfE&_nc_oc=AdqTAUT9p3LaImXLHSNN-xamV2qVzBtW5SO2JQ0EP8FNgRndMJMucduBgn_oNjH3JCs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFWUXrlSup366NbN6NyP2tLkvNScKxw0Nr4w9W79TeCw&oe=6AD0EBFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bogxX1VAU5sQ7kNvwGwCOW0&_nc_oc=Adpn8OiyRLi2DoFV9pch1Vh79L3xR1s59MepBcQ6CThhtZr3wCnBovft0Tye9s-AY4A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbFofyGeQ9NVCMu8s9fqlyGDQjezG4nfuJpkP42v66-g&oe=6AD0E771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIgub_1kzYIQ7kNvwEqjZcn&_nc_oc=AdqEiLPWveB1RRHKOLuBrPheyJAwWbhuwIziz_evNk__IjprlLFoO4Q6ikUXn1efbf0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKQ7mISAEkg-kBUqkDKeN4yPYxNy0rwFagGvnJ46uXlQ&oe=6AD0E474"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2NGWHKGu8IQ7kNvwE_byb0&_nc_oc=Adrp6kxEEAvXDBqyK_v6MWoZ16CQzuwG3Wfaz6beJwWUwVHAlNDzlAmUthO2hpvm_cc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFCQkfEEEQgYoz6seCtc_eOGHtZQ8Zlm4JYwKN9BS76w&oe=6AD0F2B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaTQE4OOyqcQ7kNvwEi5JJF&_nc_oc=Adrf-bpMILirEppkfgOMv3eks-Skp4xdcFPSfFLo82kQZGYcjV15VpNCUARU
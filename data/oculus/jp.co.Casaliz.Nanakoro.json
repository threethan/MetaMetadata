70556961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Ah8EiOgMsQ7kNvwGIV5Pl&_nc_oc=AdnF07_ecctA-ekOa0VpD6cEq104ZjLCo9TtHsy7KjnpjfftktyRUaYTwrxsmUl4JAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfudAZr4rqBGuOZgV0zTd7A_tHJig-m1X_W1uuBXF_7Ekw&oe=69A83E65"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-r_lzM5U1YQ7kNvwH7wwmf&_nc_oc=Adnbk9xnM684chgTwuJzUlhAqB76lnGh9GoddwyqB_8eoCJNJIgpNTDBYHU6_DHqcQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftnRuwnvwKi_iIgLsc0wXsrf8SfVf0hFGfReFxNBD3zjQ&oe=69A8123B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zkEyA-HLkIQ7kNvwF-66F6&_nc_oc=AdlCzZbcsgqaKr7iLFPHxpeUAb1DB60oQKgGY4UMdYznzU9zs3KxoUFcCRnq77kTgC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftHnlbuFPMW_vedv91O6nBvsLdXpYca7tN3SEhx8eNmlQ&oe=69A80DB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm-48tWGvocQ7kNvwHlFlvm&_nc_oc=AdmAwVJK5ttTmU9L34jE2a15YxeqZeAT9APsTrtwoPADYmqO6ePHMs8dQAHcbuvxQ7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuhV4LudTV4RmH7ybtVJION2k6KM8uVooD0_rFnpbaMMw&oe=69A80AB4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6SERSnid3cQ7kNvwG-fJdW&_nc_oc=AdlLXcSyWqEJEno1C_KpjdQAWMZDYN35zdvQq7N3YJoRNlAB4CbYhzmiNLibuzjpEw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs0dYthqzmQPD-Di6yRx4jOmNq0gW_NBJfO0OKk3GcDfA&oe=69A818F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NAINkFNMJ8Q7kNvwEGQkaN&_nc_oc=AdkqJ30xrKPAXTctEX9PsSHJyseiUYVzDESEjmn2CKlVy4ijQ3Zg_0FDyhbZ6EiO9NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfunCyUtUJDEby4_ptUBTU3J3E74U6pvQTIhyMGmMQXiww&oe=69A81583"}, {"file_name": "2560_1440.png", "i
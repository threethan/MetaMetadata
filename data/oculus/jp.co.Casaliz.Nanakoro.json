1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bMFZB4em_nrXnyh4_rCEr3LrAjIXn-pQkRuHtoQpNcQ&oe=6A355B7D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hnRvDeCPMUQ7kNvwEtXgX7&_nc_oc=Adqh3nwfCMVbHFMjDR4X3jyv7ArV_wc2HJBWmANYloARSfLasAD9bnMB2ISwpxIO-mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wVnDnBmYpGQdgOSKZtrFn6DKrEiahz3AatjH6IYKn1Q&oe=6A354EE5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpatQIYxBIEQ7kNvwEpNUa1&_nc_oc=Adp9J0V-MYc491PmYvpJhHGmRpbEucuLrLP7PZFBObGeFGNeuXHYLvy2hVs6uaq2C7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_HiwH5Jxu21YRDeIX-2qQpXCWtmoqmmWc1rZAPRHr4A&oe=6A355AFB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjAuTj9Td9QQ7kNvwHZ1n--&_nc_oc=AdolvhlPQ4Lc4dAmAWvj90y6HtWlk70LkxUq65ygqiC9bDvRSuIlOtEhm-7Vf4RNVvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gQ1sYmWMtu96WiCmwxkMIxETXKZpyZ9KOKgHlSrsxbw&oe=6A355671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqMU15xYU0QQ7kNvwGml5RY&_nc_oc=Ado8OhjaG40CaHFCr_wygkQDesmX7DzD375bujJFhJjb3qbfMr4vQkuszLkuLFjSAqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nWogH-T2aM3nP7-uhC0Ea311XQ1MelVr0H3O5Ac76Ag&oe=6A355374"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ9_qXFS78QQ7kNvwEWxx5f&_nc_oc=Ado9z_aL3zB21zSnpwDMdiq-3Hv2p8dPIB_WYxIaWAJcQvnIxaiIE43Mhlb_fG8GAcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-LcDR32CVkGr7L73ZDtkA5g5R_kh7Huy5h_Hbe24PMg&oe=6A3561B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OYh3xqVcF0Q7kNvwH0oX92&_nc_oc=Ado6E4MRC9J2D1qLNITMdLLfiADcoeJcrf2l06dntfHjzT4CWxYA_7UbbeoY
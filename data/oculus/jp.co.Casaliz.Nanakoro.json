SCRHNMQ7kNvwE4352s&_nc_oc=Adrh3TnCEXITiLgrikJvqnnUWPtW4esJP0cQ_3gdLnFQuhq7zW3V4PbqizDrgMPzB3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xKkGRKcMIrBQtWbmQ0KOvTa0QHOu0o3N2A6oGqCHFnw&oe=69D4ED3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzvrVoeYPs0Q7kNvwG9ovAS&_nc_oc=AdoWyBroyl7Q-y015DkqSpWv9KEedobe-XVLsnVKHKL0RN7EoemF4aeX6Ciam6u1uMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35Z4qlMTGxPoFq14O2HiXVN0-50cTgvsZ4LtSDveYn_Q&oe=69D4E390"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeYTs48DQPQQ7kNvwEBkKOx&_nc_oc=Adr_w88rfdKqHj6tuwJvW4Xd-d9RtOCH1Yzkv3uSOWl0KPyQIAIQaZNqbTJRDHIG4Rc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bJUVi-z4VG5v9p4N6StXjxGZ-OCw901vPRwbsWChXvw&oe=69D4FDC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uew3XDW5eEQ7kNvwGMfKKA&_nc_oc=Adqv7-AhyRmPQGO-bdrPpCzvMc2QsknpGAMbMY090_FGzvOwDI0aEBlw-SrMNOh3dOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22GKcBomqksXms_PjYQ5ryP8jGEe4SbkG77OkrFVa-Kw&oe=69D4F189"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HGpozMSkakQ7kNvwEA6RdU&_nc_oc=AdqJaeCFwrAfyUd-uP52FaYWCMFiYu-dIzcUkA21pypOVvcjm_qFWiE7tEZO32OmhOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XM7MrFiFU3B1DkNGPvMqZexvzq5MIE1bSqRZ350mWOg&oe=69D4FEFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVAHmTcja-EQ7kNvwHAMMsI&_nc_oc=AdqfJgdtd4II0vqm1iZfPYdnTxcBlPWxWvgiVJjy9l9hEeesy1xyMyqlRdrgkm2YldY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39PApfgcfs5xDCrLgPFpBBNoz118zlvIBYctQQzy14dg&oe=69D4FD88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
7Trdd1vw9wQ7kNvwG2JSIM&_nc_oc=AdrTSCmsltzwPSRCWazdgUkKMZj615wKqt1v3QtpHW4pj6EmdLIGtwo6VOhW1w5BjhQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-urduKbE-zx41mT49SclZEVlYaTfLQBXoLgUiVjGFRzA&oe=6A46867B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWxUuK0Qv-IQ7kNvwEHMDjE&_nc_oc=Adp4sZTNX_T9yr_gxmsEaoLmmdfB2sLwkfmPpLIabxEtAG6gGLsL2Uyhl4R6Dx9TWDE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n_DauqYUKbeULcdvqwVzGyz1C0TH8PIt5yx_pUgzJGQ&oe=6A467CD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=325acn3fCrYQ7kNvwEAmns0&_nc_oc=AdoaEMw_wX1_GEfIjM_2NB8tJZNdUESGYCMxdyUmRl7Q-1tMxDeYfaMSxgjwphz27go&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ez9Wi6eSEbBZg1XpgKhdqXtIWQNeGjIPcLyUuRANolg&oe=6A465EC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV11n-Vhqu4Q7kNvwFCbrqr&_nc_oc=AdoFrBSEh6YsRqdG9apRqQYpUc9QVHy4FZUSdjb-WibcjoAK0l17P18KEtCUWUyQcEQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c9joPfOllIqoGl8yET2-tLXH2At5Azs0aiNRwD23yWw&oe=6A468AC9"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXeqb0MDkzcQ7kNvwEqLC20&_nc_oc=AdpbOrTr_hsahKGFAwcU15fpHNeQ-jGua5r2sBBhV9653vRirhN1x2-hNRAur_GEqmU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sQvfBH85WavfusZcut65mofPz5KQ9iX2FN9MZcMKnYg&oe=6A465FFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-17ul-T6hdUQ7kNvwEeegWF&_nc_oc=Adq1ncxhbXwQrkaBcpka9qkZOS5M0DjoYeUJxM-XLTaewjOZuu1HBJ5ZVlY10FpYxHE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-wAPHwdEjA4ypC-tWUhTPmRItDk1edEMj-hZFwTkm5w&oe=6A465E88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974714_10204990
CjPItoQ7kNvwGBJCck&_nc_oc=AdqtTd1NoZol1uMOtg-0wkNRZjSrjv-_teQvQP561yoOywNYn3TuesBi8MjIhgjVKOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W8MlsR_NXvg06XcPoaXlxyCPLolqWTQLgA2qiCYbULw&oe=69FF1D3B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61xh2pCGQAMQ7kNvwE4blT4&_nc_oc=AdpqMDjjXGKtpijHkUu4HZ-ImjgyIwLoYwgWg0BSr2CFep9up-XOFxtCJhTCWFtP-Pw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rauUB7Kbi4jg15vhJ5jqwVh-OOzTDeGY9ZRVGdRharA&oe=69FF4BD0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFdY3HpMoCUQ7kNvwHjnPcz&_nc_oc=Adppeum8-Lr4i72h44mglX0lk0tRK4Gs1ZckWQcQIY5JNChuliWw4c0-BPJLmKFVhjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SooAk2XB4UlQhvCbw_UkSTNk119XhZ0lEdWXEfx2Rqg&oe=69FF2DC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvVQLniM4W8Q7kNvwHToxW7&_nc_oc=AdoPFUxz6JllkkvgBpPOzQd90758Ab6NjuAC_GKYFyuU9cC9vGlkjqCXZGZBn7tQM0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BQvHDiziWaCQMBGA7aRylEqKu9yF8q2lZiDRXMByjaQ&oe=69FF2189"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb-_gaDtPnwQ7kNvwH5ofAo&_nc_oc=AdrLYCpC6Tx73xTxGkfNWccFEcDDtsaXJveF9gf86sMchxtHh9KLBxs_Ww0cyi9U_tg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47fE_PUhNM7sDpDgRJmHMKIFQ42RGW2R1UDbad_Q7n0g&oe=69FF2EFC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTQhgSkTr-MQ7kNvwF8nUmj&_nc_oc=AdqYY4UR3kmcROPfpaZ2DcUlIKvsB3IHXRu98bqI9pPa-S-zh-AXKgHp948ylCRPHCQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vnyj3Sgxiuwdlq1id2mohYloSOTKM_cC0xCDlHbzeig&oe=69FF2D88"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
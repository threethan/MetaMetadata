zc_JR0Q7kNvwG7p9uB&_nc_oc=Adoj9IHbjU-N_qP4VbxVNhLSP6SsgCaW0sxVXPgnMaD1Whgvh9dD2S4ODFxnzkcfY0I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1QaBqq49qqzgriBLHLO9f44etXXjUPgyG4PiP3iCCZg&oe=6AE368FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BcPU3W44aoQ7kNvwENEVWD&_nc_oc=AdoW5sBgfWBcLUTZDRzMIwVHARvXDVIu7wx7jpvElOen9LuCLFW-HHZF4fZbb-ro3EA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMKiKXThuoQYNIASlxdda_HwTjUozlGp-cD7KFtWXBXw&oe=6AE35F50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-nxz5DUS0Q7kNvwFXp__G&_nc_oc=AdpsaoyU-OM_xuwvPd7tAtSIjFt4u-KieN5PtFKyqJWhAoA8vpphD3T9pvYhZxSGklY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0BgvaG7quBhMjiLtX2Cq73YKoRWlURwfgwZbm5QojiA&oe=6AE34141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQeRSaQb0IIQ7kNvwGR3mB4&_nc_oc=AdoQEaBPNEbE2mk5ugtZ0_B9kWN2qohwbLvxBW6njJOZpO0t-W9gIpklUSiZuugTFrM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9-HMLzIJnMY0JNOX-18qVNPf5XYkE50-o2idyyPuf5g&oe=6AE36D49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i43wKsPT5nYQ7kNvwFYHkg_&_nc_oc=AdpNe-5nTmCYooW_ZKavK7rTcXQ5dwjvq8hA_hMOmsIrtEB5L3eqN6Gs6JU7K2PFhn4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbsodWfhlUfrZk4BSRf7ncXgLCGndWyHWITNEpFFBuOg&oe=6AE3427C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULCCUhZGKGwQ7kNvwFlTg1f&_nc_oc=AdqZLAB0jfVqFJ_haHVQFYkzjDHBVIt1R5IRI6u2xJ6jGTbX5Stypm8ecFD6Qm4EvRQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxugwxaMDQic5WqUp93AoXNVrD_uxyy69qJoa_MrOc4A&oe=6AE34108"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
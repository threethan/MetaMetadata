1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6tk7Iy3v81wFa9ebqnojyiLQkv7FK0e3x_S_kPWeJ_w&oe=6AE3617D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLV3ZBSqa4UQ7kNvwERdA73&_nc_oc=AdoNfQjv79-KDC00inxWaj3IeMOW27i9DNn_bzlMTMoCg4W-Ii5sZlQPouNg8Upl0VI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3ecB_iwkXk6ik3s1U9FSmVvM-JtFJ98cZxMbi7EwqcA&oe=6AE354E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBqsLwel-gkQ7kNvwGZNA-5&_nc_oc=AdqGxS9bV8eZhxhmn9zUDnx5n0zwmJ3fJHOm75xkOgrXZaS7l_h_2ydB8SlDlLKAbIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhEekGPQLwlaLvZ1QDyabBUeE0wcxJpugguoqLDfvLpQ&oe=6AE360FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDcekUuDwK8Q7kNvwFTpooT&_nc_oc=Adr3fQE868CRxU48D8kB7sTjtDFH4saKnhEEsHJSRibO2oVQhbVLwpqTyCSov-Cbe8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzd7HKNDx3iqaEZpLkos1jf2QW2wSprZasupNM8qX53w&oe=6AE35C71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZkUb0QcF9wQ7kNvwEn2u3W&_nc_oc=AdoA4zysQz1h0QT1dtnKfR-DFOByaxtNlxbQtsEWX7GTCdUJASzzJlYwLkRGieMMqvs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrssOvn5VAXjEzNLRLet46Ju47jpurazcAlI7zb9ZzlA&oe=6AE35974"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8YzY_mGplMQ7kNvwEJ7bSN&_nc_oc=Adp6shp3u32rA2gG36zYSmbQ9l2fAf_J2-M5Xy8ZW3UxFMhSA4Gpf8dwSUtRHDlhNeM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXAyqI_3ny0x5hyaTDpwVsmuLpEPEclJ2m8jIsjauYzA&oe=6AE367B2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg_nYnSDXw8Q7kNvwHRpOTO&_nc_oc=AdpL80JHh5AzFJINS08ikaMbrbHWr2M9JjBuUIITu02U7zWfWEeVrPQO_nxy
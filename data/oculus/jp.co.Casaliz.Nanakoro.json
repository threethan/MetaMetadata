bL8HxIQ7kNvwFsP8_P&_nc_oc=Adpp2aNpnm_jpWEX1BUJxNDLScInMYlYVBFfk5JKsNUOVGX6CCHpz3Y7-T5wkY_lJDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44Ns3LzrsRDYVOTdbrdcxj2DWGxYVwtLwhIy64-UwecQ&oe=6A01C03B"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO7wiSaVe3EQ7kNvwFHdS5m&_nc_oc=AdopA0W42CeVYCMUqltopAkAA4ddzEzgXHRCoq3a13jGl-kXbBfx_vUHtWtNujEH9vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75qqVbAEsu_4-GZ5ws5nqEahCAP6dAB-ha6RUq1WuGtw&oe=6A01EED0"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUTJM7hOLJIQ7kNvwFDtfQC&_nc_oc=AdrRDghmm1Gi0LLUGaFHa1RwxXfwMhW1SSsAfwCfY3LG171eXDAUk-IQj3utiH3jaOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6acdztXymvrGSu565-VyEJxg3qc7FbmGpxWQ1PRmiLCw&oe=6A01D0C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcfLyau5--QQ7kNvwED_CgE&_nc_oc=Adqdx9L1vSvOZMF3zsm87JYdAuzjxt6WNN0bG3l-nNjRDiu8v2rFSlq2eNo1G7uOY0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4teuYMFHRvSIYK8cXZDRif1V0a-JaZd0XYI75NwwYzGA&oe=6A01C489"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4DUOnXPkI8Q7kNvwG3dAuB&_nc_oc=AdrTKDFhuQk49ZynA4UnGOa073NVQPD9wScGtOVu65Bo_nbL9-jN0HXmIaMJ1Dhf1VY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WQvVuQ17FhP47oAM2bUuHdP1NYKbl8Jf9WkIuARz2zw&oe=6A01D1FC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCyGsclvwtAQ7kNvwFTd5WP&_nc_oc=AdrVaf5MEmKDVlAK9Wy8LZ-vPraKUkOII3EiDQpHl_PvW88kx9hLVF9liBzdOrE9SIQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hq2ZTAtaP8PwIdBOukOook_z9jPRtLPZqTH32NT1s9Q&oe=6A01D088"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUaxSmkCsGxBzqXF_6e4zsswO0ba8p5_F_sYPhK1PM_w&oe=6A67747D"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPb_g2LRCeoQ7kNvwEBeJjX&_nc_oc=AdpbHz79H7WbySDH9_0kNlepTdn327Btnh1jpZXkQTNN4_KcLjn2kgRz2co1_Nbb_UY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyZ95EbVFVPVEgc48iwJjGab2bKndpmbAB2HHWqdcDdw&oe=6A6767E5"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wARKaZa-DJwQ7kNvwF4F_RF&_nc_oc=Adr5qTtosQI1dK_Txsry5zW2bVCq8i3ghQnesaFxfEaJGTmlNCGgg6Kid5l6OcZcogI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmByzaIkENNqzf3SmoJlYOXgL3or9xzYmOfV0e7wdYKA&oe=6A6773FB"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmXOh8SfswQQ7kNvwHvzv0W&_nc_oc=AdrgtlryzOQ2F1wlu1a8TxWw1AHTvz0PIy4ohLwjZQWX7U0cD-u7fhpVEYkX01eY0n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpDpfRo5LJuy6NpEDRTJUoEtKGfyK6pN0eIwAOz7Kw2g&oe=6A676F71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQUMvrYWkncQ7kNvwF5FChU&_nc_oc=Adq1ov0-MLWlC062kxp5xJK7r-UnDmEXjMjxf_FxtZ5t9-ITS1df61qaA5tKgot1ykw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYJV7AUTehor6CteWmDS-C1d9WV57OE6i2eqefznBRoQ&oe=6A676C74"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLFDJ_-9IIYQ7kNvwFFCQCW&_nc_oc=AdrNh-SNaL5ZK9Jn0rAE-x9-By2aTq9qjdgSU6lLm8xypOE_toXb5Z2Q5Z_osVne12o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_iv4Ao8yImAPfwNrUu9Bdtak3qZaxYfVWQZ2R2wT_2Q&oe=6A677AB2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BEC21yf_kMQ7kNvwFMh82J&_nc_oc=AdpmoVig4QHrlCw6kOJrSWpyr6MfmP_wetDc32LAM8FQgZOnIjm427f8MOeo
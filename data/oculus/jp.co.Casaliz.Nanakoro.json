1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzzFk3ZhdIb-2MAJznrItg7yqFfeAY4AznRrLvoyJaNg&oe=6A92BDBD"}, {"file_name": "screenshot5.png", "id": "745469470556961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974862_745469473890294_4917969047552444137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdtR8D0ccCcQ7kNvwEOHDGJ&_nc_oc=AdqcVD9MzlgNYggbdhXWq9SvOlAxnpkned5bvaEhH3ZSDbPVeRIWM3ds_dHzguPLr-c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGncGFZjC3ojhH8gJyzN_GaYvqoTlhC0q1M5odoex34xQ&oe=6A92B125"}, {"file_name": "screenshot4.png", "id": "711385250719907", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54770913_711385254053240_3044714358488556391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXh2pa6VElMQ7kNvwFv4ead&_nc_oc=AdqRqhbWFTWNq2zjC5ueCpoPkyRag9K2tCI2s-sLnxjxYd92wqWDU1ndjv9hLoyQE-I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6RUCEU9_0qfPixUi_Dek6DtnoAHPFfgxjXZcv2342xA&oe=6A92BD3B"}, {"file_name": "screenshot1.png", "id": "507466741586549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_507466744919882_1560503634334867844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxYg0PsLvJoQ7kNvwE_DZcD&_nc_oc=AdrkSXEL3QVPP5UtUxLkcqy90qQ1-QkJ003H1aq5LtMHMMcIM-8NTzpMUF79WhJszBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKwdMrUKDvQ740Weg-gAR1Pj1n2bfK9tgP4YZWoN_SVA&oe=6A92B8B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "603579251657790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575347_603579254991123_5543628032946564325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVpjWT_uEOcQ7kNvwHplBu5&_nc_oc=AdpXjo4b0LFsLpZU_ZdJNU7FL-9PNrZpe3jhlLefBkrF7mk8c6oCpooJU8jOMZEHOYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrQDiOFEfM0nWJp68hxI7C51nBc0umfgCOOjgpigTWaw&oe=6A92B5B4"}, "display_name": "Nanakoro", "keywords": [], "long_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "Nanakoro is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1853078831735141", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003226_1853078835068474_588340096215524759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1V0xX4dt-EQ7kNvwEhNWQ6&_nc_oc=Adoh3aWejXUEgDLRKVIbZF4oWFL1t9ecAxCsXXNIBREIsH-WNY6BgwO4FXMLCgj-jA4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES_u_qg_CKmB_-mDhOkbQJiIiMrIe8eKCxBeZeKbYmQQ&oe=6A92C3F2"}, {"file_name": "1440_1440.png", "id": "932574974560310", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57570312_932574977893643_2584588908208900608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnHGCFKRBf8Q7kNvwFWIhaQ&_nc_oc=AdoNEQOcSzIfsKXRdB1iZjo9KyMyHF7fOBTWz7XVS1saknpyKJIK3mqjdh4M
0x7aAQQ7kNvwH3K9cc&_nc_oc=AdqnP3R6265irY3CW32smEHW4tc75NPv8QrR-dG0Zd21DzdeUPhFmaDhQZa0RRnZ2_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfYDgMrIYz3z45SCRvuOFVAPZHDJ7Vxk4YZWDA2j9N5w&oe=69CBB2BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdbqUjVFuPYQ7kNvwHLZuHP&_nc_oc=Ado58BMxOFH2gg12FTL5a-4t9YWUsAf1HZ1_FXwPJAweqFBIKZX73ICJYm45N9yjM-Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyAhmcSEy_C0CTYOXzsSNOiuJHf-xkbXEszd-3OLwXRQ&oe=69CBA910"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16VwdoLdrvMQ7kNvwGJTRhh&_nc_oc=AdrE2gFEwiDn7-qdhs7ZKr26-BpR7SrFcPxeAqErb6qALZu3ZzT_wmu36vC28Ns4HpM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMgRFoMbuSjZo25feVqTIdL4MNPnIJJB5Oaj4bVboiYA&oe=69CBC341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp0stz5O5TMQ7kNvwGpSguz&_nc_oc=AdpCemVUJ1hUPzJqn3IIIfxwxoyGS1AwDExSFUYupFBPNYyXgBCVmb9E99xBwcCID3k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9jO99TGdPUwytXXvimAIGDDDCa1mHfXyFsFufdLuEMQ&oe=69CBB709"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyMwNZ_XbIgQ7kNvwFZQih4&_nc_oc=AdrM4bcFYFv5tiTN8QitklY-j7yQgbXFkJd7PmTkp_k6wEsn0uj-MluR7IIr710WfF8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5mqEXw9Jv58EXWamOB7fcTyV18N9a1rjb_dJfRhLtjA&oe=69CBC47C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--JE3Wd9c-cQ7kNvwFS8SGe&_nc_oc=Adplzte658ADk6Yw_Eu-8TkxLpzHo1KQn4TFrUM7KFhp_KZQ2Qzf5oFWrd7V3cePpmQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0_DnuEh7n8FFh9li1uwmtxbHiRUWLjYQPX7VxA_CBsg&oe=69CBC308"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
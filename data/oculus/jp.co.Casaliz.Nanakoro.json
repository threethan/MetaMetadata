ojECCoQ7kNvwGs6n4B&_nc_oc=AdrdibwWI3OGDtwgvL9WXItNK4V-3eNy7YD6HVqiM-nMPA_YRzoTcik4CYF5GzX8tAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rOn7ofynX_9K4DtMvqmUJxhScdNAlJoc_OSY7_ZJnfw&oe=6A3AA8FB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv9XmHAdJ3EQ7kNvwHQ49Hc&_nc_oc=AdpVMAUBQ-NcOGnyvk9tdjh5GFwSEb6qGQn-GNOJ_A1MfiCCrFdf2K7ujVyFx_P9Cu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8miF8Z2V2S2ysdVHtA-XxXmZ5sKXYWksLE0hv2Wbvwow&oe=6A3A9F50"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lQH1YIw2S0Q7kNvwEJgIb0&_nc_oc=AdoXSZgqh_2kNrr_ciNiSFpYL3ouuTF8ZIl4PhZad8p_CRufJqLe0Lov-Y_f4ukXlr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rx3GxkmZAJvLNNzIcB3GHSi6sf_30OySRNwJN2gPBKQ&oe=6A3AB981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXotT32i0gEQ7kNvwGb0Xmb&_nc_oc=Adpwy6whq61si3N8XbglTtNR99VGhACNd_ZJR9r2USNGELvEBi4TZZKb-NiyOvVpbLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af963vxu_0ruJNDFjOml64A_xUGNGRow-lh9-UZEjLZ9Yg&oe=6A3AAD49"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6tTHT-kpQYQ7kNvwHnrkju&_nc_oc=AdoFMN9Et6hCOX88vntQmciGxz4l5az2E2AEziczWtfUjxL_Fg2uLC6umtgbmmHbqYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FvkO_KUTr97eXWoiK0cVg5EhHdGK8PtR8TlrgkeUD6A&oe=6A3ABABC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw7TSCPN6-cQ7kNvwHRmbTO&_nc_oc=AdpZ8wQVuFx9kDIUOJ98g7fQo8-wriDEKXTGs-AqbtdkkbV-9Xj7h-uhCl8fIr4mfvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rJ6pzhaSU3247RVckWoweurZG12GVGzhjgV_Eyplz_g&oe=6A3AB948"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
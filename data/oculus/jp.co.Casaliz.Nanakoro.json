pz53eUQ7kNvwG9ZXDZ&_nc_oc=AdpR8M1PpL2pLLgCbdAMC3PyX4XAvJoyjQhlZzGIl2KZxgtQJfbKkFDYPpzjpptIN7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjbUoCloapMonCCG3vFUkx5WMCaxfhr_uk_syfa8mcFQ&oe=6A677BFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzAMUZSVS8oQ7kNvwEflnUc&_nc_oc=AdqH9zOyY4sK08wByHZx5FROGpG-enbjtxe2nkVgIi4d8j0lZKY_hpDPlj9ooPh70Fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZtxFB8iO6Q5UCAA1BU_S-uzPkAJIHLRP_LVXJhoMY4g&oe=6A677250"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbpvcLH5o58Q7kNvwFCVNKB&_nc_oc=AdoLH6sBfTFYSOb-jmrmyerQ4gb2oPgNG0bqoiojLWSecFjiSAHCiFalTaYJseEp8mQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJX5dXbe77SA805Pe0_xL_54g8Zp9-rBH7YaORm72sIA&oe=6A675441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUvdFFSNfn4Q7kNvwFTEp85&_nc_oc=AdqH_yQHsn2GAj_uZEPA05JgwWonwCqqoRAcemSYSCkeVX-xy-DOuwYPUlx3GBtr24c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsUAbId1VY_O5FBHk9ww1F2oD-nhmMUkjxWh5NXJPJfg&oe=6A674809"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-PkTEpbx_wQ7kNvwEBM2w8&_nc_oc=Adq3WA3kwyWFDRv4LS1v5RZy_a3qHHb6tzMKtS3rOUMc73xQQuiEdAw-8xK6iVPbG40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4wISw2ZYJs0BWl3uZ4NOQv_mgt0fGh3oQL5uGpLzGhQ&oe=6A67557C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXHGAkXFZxUQ7kNvwEnYQao&_nc_oc=AdqMaOHQjch9xbE90riwWoZIeOblmUy1zX-b38HGpWadrSvLRoo1WDpu29JVGHkLjWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADMbeX7gECWdGAeNTGrRoBqVc4xaGH92qDXIPYI7_1bA&oe=6A675408"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
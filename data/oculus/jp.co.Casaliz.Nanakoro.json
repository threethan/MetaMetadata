t-iad3-1.oculuscdn.com&oh=00_Aftv9jz_O7GvthGPj3Q-bK9CdG1Qhmi7CzijV31peL3jNw&oe=69A6C8BB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-9OwpNez9kQ7kNvwGcGLLe&_nc_oc=AdkNHtblycpygPMJQIDrk1CULtsL6Pl00ZqBZrmEPJXotlwt4a9FyzJqCbTcrNrgq24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUEIn3OW3BKozX4Qp7UEo29LXs49wHgjO_WQ6hF7Qh9Q&oe=69A6BF10"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufGVyOu-vKYQ7kNvwF2Jiks&_nc_oc=AdkQzcwwbQi4gQXdcr5k_BJvCooc7wIQ1OqA_AH7-eFtabHCej4gMp3CMGWTYh_NunA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuF3o_ix4Cz0m86jl75e2wo24hGg7gMXkYvi0u0j7QOBA&oe=69A6D941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NRKTZB8FqQQ7kNvwGLJ3kM&_nc_oc=Adn4CkBqo2BQu8zRPFzj4cDnPOEv6ZflPZSpCNEIjmFdw8xx_I_UZ-MaHd6AecHRufg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusZ06yyXwINQFLeQhqLHzkrraWXKOnSseF9VeN8iQmbA&oe=69A6CD09"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HOGoWiaIc0Q7kNvwG5VMz6&_nc_oc=Adlm77hlrgVBT_ievk7kmVE1L2yG-cWTsh5i5lvh_Rrb3Air7K7LRfkuZD8XmkKra60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpiQYmSu8qVO5G_j3d0b2HQx1WC4UCLQFyBcvU3pl-dA&oe=69A6DA7C"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjAo6L6jBjkQ7kNvwEYqTKg&_nc_oc=AdkXut7G0-QzJdMjhGNyIXncSehKXDLxJBaQSTW4W7f4eDs2V5gVOuXRFEGx2YGdaRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsnl526st9ieaYvcdQp6hVFn1j0fLbyDDsSyBjbGMTb1A&oe=69A6D908"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785535_7499278713744611319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsacpP7Bt4EQ7kNvwGvcOEe&_nc_oc=AdmlEYLIvZ48EPQrkdqfx4H_37AY81iNS0XJGObonLN_Iazz5QqZL5fmSed58AvQ6wg&_nc_zt=3&_nc_ht=sconten
NyYgXMQ7kNvwHHKy-r&_nc_oc=AdqQhxa2rxhaIw763eWMEOszKJ1WYVhzwuVmM5N35znGke60y2A8OO2Bexf63wr76o8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvfw9MO1S5tftuSvsUmbdzV2nyyc__gqXr-bg9I5_jYQ&oe=6AF5DDFB"}, {"file_name": "4.png", "id": "685677814186423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_685677817519756_8367910662252141871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqJuML0tag4Q7kNvwH0FyIT&_nc_oc=AdplSgY3dH2aOT4S9XibPNIX08mTHhrx5RvKAG9yrYIGTZddTfmIdPiL1pZ55V77PL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeH9YOzuIVIaakoeZFTAG_WJFBqIJB99vDz8OdH3fzLw&oe=6AF5D450"}, {"file_name": "5.png", "id": "1778894433046581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393784_1778894436379914_4492931559093412305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYPw-fwxfcAQ7kNvwEMXysN&_nc_oc=AdoZ1yJXwVz0QWaFLvy5Iukdxj-5SNGjci072RZGpBz3YpiZx-2_8zfPLB1iNZEM_Vw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW5Ci00ZHMGcAhE8wYf6ToCS8omstPjSOcdTRWfTZ4Ow&oe=6AF5EE81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "1636727033687668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1636727037021001_4419805504055800919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i_yKkN2EggQ7kNvwG02kai&_nc_oc=Adr9paB-6YarTGro9hhNs6q_XClhbKkseakylq2jqrLbUljWQxU8PCYi540kBGRpEJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6C0TZb6Tm6M6ZtAlJr4TWFcaJeW5afu5TFqX-JQSB1w&oe=6AF5E249"}, "display_name": "MasterVR", "keywords": [], "long_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson.\n\nYour speech will be analyzed and scored. Each word your speak will be highlighted to indicate how well it was pronounced, green is excellent, orange is good and red is fair. Not only your pronunciation but also expressions and speaking speed are analyzed.\n\nThe customers you serve are of various numbers, nationalities, and genders, therefore you need to choose how to approach different situations according to their characteristics. Of course you need to be always polite as a professional hotelier.", "short_description": "MasterVR is a VR app for customer service training. You can talk with characters in a realistic luxury hotel, practice giving a speech to an audience, handle various customer interactions and hone your hospitality skills. Conversations are scored using speech analysis and you get immediate feedback on your performance after the lesson."}, {"images": {"nodes": [{"file_name": "3000_900.png", "id": "1214983979544039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1214983982877372_5051249061967279628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OngMvUbukUsQ7kNvwFd8uyu&_nc_oc=Adr5VB8_a4_eQ-m3UzkOoRsT4jQFpu99l0XItFchozZDAgAPZH0RSMkzByt564djZuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwPMwTuQpvZ5TwVWHJx9AuMpMrllBYLS4IlE2Uzl2gRg&oe=6AF5EFBC"}, {"file_name": "1080_360.png", "id": "1081611253695962", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_1081611267029294_9182265417373877690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma5Ki2CBPKEQ7kNvwGS_6sq&_nc_oc=AdpVeKBAG5Bb9q8gy7wx36u1v3Y96inHCtFdJ6e8VockGTeL3KXQEOLuytOHhZSRptE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh2RB-PcstwAgPEBSot0tI8Q1ZIrxYl4OmSeDJs2hreg&oe=6AF5EE48"}, {"file_name": "1008_1440.png", "id": "1020499043452202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1020499046785
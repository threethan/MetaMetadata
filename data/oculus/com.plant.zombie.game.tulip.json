"2039382679953445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_2039382686620111_7605825634399446130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmaFo5GWid0Q7kNvwG6ohPz&_nc_oc=AdpN_51oMjnQIBxj6VTMpQnuxu6Y9mLLOPiafTbYrA2h2N7SAlm-YS5XwGiw7BR3pn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c42lLQ43-zal6Gg3IjdKYYaNskr2zw2A4HXt35WBw_g&oe=69DB87D4"}, {"file_name": "7.png", "id": "754117727525368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_754117730858701_8349642138893157194_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6hKUGUGHtwQ7kNvwFn2kqB&_nc_oc=AdrX3PyQSp3VigtnvJug7RRCq9XN5jh7UV1kM9iiLmsz-vLyb3YD5oWgnCWRLMfS0Pk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KjC5dAG9OgiTIlR_1jgItlRSFhgIesL6nvqLCCcj8NQ&oe=69DB8FAB"}, {"file_name": "4.png", "id": "2085487902298389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821725_2085487908965055_973954738443654290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb0xGgpiL80Q7kNvwFNUkuS&_nc_oc=Adpyl-PxtvIsPuXEWMnRsvj0THWp0sy49kgmXia5px1Sv4DIMwUHbg87BIASUdEcJ6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zLG7xWcBOxTMb3hAADsDGfbcLCHwJ2VeQMnxeeAVJ0w&oe=69DBB238"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Garden: A Plant Defense Game", "keywords": ["zombiegames", "apocalypse", "zombie", "plants"], "long_description": "Your garden is under attack.\n\nIn Zombie Garden: A Plant Defense Game, you step inside the battlefield in fully immersive VR. Plant, grow, and strategically position powerful botanical defenders to stop relentless zombie waves from overrunning your backyard.\n\nThis isn\u2019t just tower defense \u2014 you\u2019re there.\n\n\ud83c\udf31 Grow Your Defense\nCultivate unique combat plants with special abilities \u2014 rapid shooters, explosive bloomers, shield vines, and more.\n\n\ud83e\udddf Face Zombie Hordes\nBattle fast zombies, armored brutes, sneaky diggers, and giant boss monsters that will test your strategy.\n\n\ud83d\udee1 True VR Strategy Gameplay\nPhysically place plants, manage resources in real time, and react as zombies break through your lines.\n\n\ud83c\udfaf Designed for Meta Quest\nBuilt specifically for VR interaction, immersive scale, and room-based gameplay.\n\nIf you love strategy, survival, and satisfying wave defense mechanics, it\u2019s time to protect your garden.\n\nThe zombies are coming.\nWill your plants survive?", "short_description": "Defend your garden in immersive VR! Grow powerful plants, stop zombie waves, and survive the ultimate garden invasion."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33973319935645827"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828583_1406233924032875_4212285086844715215_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sD1iMln67fYQ7kNvwGh5bqc&_nc_oc=Adpbac97sOQyIX_JB2ejw-RFLpb7sUTTGdBE7YT2ysfBqwtkZYG05W5YFdKaw9A2GGc&_nc_zt=3&_nc_ht=scontent-iad3-2
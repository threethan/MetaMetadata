2510525092803_7619456364490220738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT_lOKh_YIgQ7kNvwGalRks&_nc_oc=Adpw0D1QH0Uo2iL5GNDl5HuyXj8KPoFtfkSJuM6H86KsBWEQ3NkoJIrH8aI4GrNMgDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMWOt0-KQm1Gm9f7ktTs346aKmGHnfnjxFxve9IgQvwQ&oe=6AE0CEF0"}, {"file_name": "5-night.png", "id": "1603069314851425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623585_1603069318184758_6775787578210289837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CnP1K58r_EQ7kNvwHncYSN&_nc_oc=AdrTg3pnrMZz2VBcsBtWli3z7ixb4W24no_2qyVLQEQQeMQrY0COYVidQncQtd_iVbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjO-dnlxqjt-Y8LMtYW4OucptzBg8Sz8hi3Lthey6MIw&oe=6AE0A9F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Direct VR", "keywords": ["music", "immersive", "artists", "streaming", "360"], "long_description": "Eclipse Direct VR is the immersive companion to Eclipse Direct, the direct-to-fan music platform for independent artists. It launches straight into the Listening Room: choose a world, choose a release, and listen while the world moves around you.\n\nWORLDS\n- Flyovers built from real aerial imagery and elevation data: the Big Sur coast, the Grand Canyon and the Na Pali coast\n- A voyage from Earth past the Moon and an asteroid field to Saturn's rings and Jupiter, built from NASA data\n- 360\u00b0 video: a forest waterfall, an ocean shore and real astronomy footage\n- 360\u00b0 photographic places, from a sunrise beach to a Milky Way desert night\n\nLISTENING\n- Browse your library and free releases on an in-world panel\n- Play, pause and skip from a panel that follows your view\n- Point with your controllers; sign in with the in-world keyboard\n- Report any release from inside VR\n\nSet up your library in the Eclipse Direct app on your phone. Everything in it plays here.\n\nStreaming: music and worlds stream over the internet from Eclipse Direct, so a good internet connection is required. Streamed content is provided by the developer and may not be available in perpetuity.\n\nComfort: flyovers and the space voyage move your view at a slow, steady speed. Photo and video worlds are stationary.", "short_description": "Sit inside your music. Eclipse Direct VR opens straight into the Listening Room: pick a world and it moves around you while independent artists' releases play. Glide down the Big Sur coast, cross the Grand Canyon, fly from Earth past the Moon to Saturn, or sit by a forest waterfall. Everything in your Eclipse Direct library plays here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eclipsedirect.app/privacy", "developer_terms_of_service_url": "https://eclipsedirect.app/terms", "publisher_name": "Eclipse Direct", "support_website_url": "https://eclipsedirect.app/support", "website_url": "https://eclipsedirect.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376509572204483"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623585_1066736296120810_804931517742760859_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFf3sutPiu4Q7kNvwGoCmsB&_nc_oc=AdpNl8vYoqd6nJTHu6up4yIbNuVhuu639dUEtexpjTueD6gCLP9ETmXclmPqYpZVurI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.co
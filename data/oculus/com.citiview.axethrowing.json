sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMFzSJreHIIQa-VGSQSHV8NC-XTZUepz9YwbNBGo3XxQ&oe=6AF33C76"}, {"file_name": "screenshot-5-2560x1440.png", "id": "1071273522318819", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827987_1071273528985485_6738320543003804047_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q064SoeqhVIQ7kNvwE5890H&_nc_oc=Adpr24P_VleMeIVx8edFPpcSNRFwnZfJsbf-aO5HXDPTsgITQxDGgxGw5wlza5QifMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-NqpffWl4-L0a4if_49FIb_kYSKi-opU6XKgStc1RKA&oe=6AF3269A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1562573324939827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1562573328273160_2728480216072760845_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYi3ZHeUgiwQ7kNvwHX0l9X&_nc_oc=Adpj9hGjJ7eJBYN1mc4q4soRBhfzWqylE-qRhIWPW7MKbG77buYKAwfgCV6_nv--ogY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFSSZNo--7jzXYMXfU7Q6ra1x5Rjm5Ug7I0T7c2J5Y-w&oe=6AF33344"}, "display_name": "Axe Throwing", "keywords": ["axe", "target", "lodge", "throwing", "sports"], "long_description": "AXE THROWING puts you on the deck of a lakeside lodge with a barrel of axes at your side and four painted target boards twelve feet down the lane.\n\nTHE THROW\nSqueeze grip near a barrel, or anywhere on the deck, and an axe is in your hand. Throw it overhand and let go at the top of the swing. The axe spins through the air and bites the board edge-first when you throw true; throw it flat and it clanks off and counts as a miss. Every axe returns to the barrel on its own, so you never stop throwing.\n\nTHE BOARDS\nReal axe-lane scoring: bullseye 6, rings 4, 3, 2 and 1, and two blue killshot dots worth 8. Every hit pops its score at the board and the big scoreboard over the lane keeps count, with your best score remembered.\n\nFOUR WAYS TO PLAY\nPractice for as long as you like. A ten-throw Match. A sixty-second Speed Round against the clock. Moving Targets, where the boards slide side to side.\n\nTHREE WORLDS\nSummer Day over a wildflower meadow with a lake, a dock, pine groves, snow peaks, hot-air balloons and birds. Golden Hour turns the same lodge to sunset. Lantern Valley fills the dusk with paper lanterns rising over the meadow. Switch any time from the menu.\n\nSingle player, no internet needed, standing or seated, snap turning, six original music tracks.", "short_description": "Step onto a lodge deck in a summer mountain valley and throw real axes at four painted target boards. Grab an axe from the barrel, throw overhand, let go at the top of the swing and feel it bite. Bullseyes, killshots, a ten-throw match, a sixty-second speed round and moving targets. Switch between Summer Day, Golden Hour and Lantern Valley any time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-axethrowing.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-axethrowing.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1321092361083627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1609135564195077_3311907029430022169_n.png?stp=dst-
: "copertina_quadrata_1440x1440.png", "id": "1137293322026939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/767585477_1137293325360272_9071977861411515494_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkIZbuRGSCwQ7kNvwFHxY39&_nc_oc=AdpYbmGAqOhT4jprSjtDilc4kO1-uzHmKRbrR7RibM2ljptEuxzT2AekJn4_Su_r5AE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV557Mp18HUmoP0CVJWDK2ha_CE1h3h0tbe0zkl3E8RKw&oe=6B10633E"}]}, "id": "4862218334102936", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1_benvenuto.png", "id": "1461554342794335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831299_1461554346127668_677253963315390729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vWCcOeDGpIQ7kNvwGwqCSY&_nc_oc=Adrp8XZv7QxLbUFh4r8Wf8nzXBmWOSLpbQ54FvD95MydEePsNPZWiK3_eS7NhMpybgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwJkY5gEtZNuP5ewwA0IZopNbHQV-zbLw6j5rrOm_wjA&oe=6B10418D"}, {"file_name": "screenshot_2_esercizi.png", "id": "1589328949630810", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1589328952964143_2045481382003756288_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvlspPqpz-oQ7kNvwHsH64y&_nc_oc=AdpmdYU4jZWzBhjgXorYib63eK8NeMvcUyYGZGB7HVc2JUIOC3sfY8TgAkRAV3o4NFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIBmg7RZriH3fgK8bysHpeAMF1dKEEbQ4v6DjXEjzrPw&oe=6B10589B"}, {"file_name": "screenshot_3_koi.png", "id": "1001527556328250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/613094043_1001527559661583_2942534362364023241_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZecmGz-g7j0Q7kNvwFgMCN1&_nc_oc=AdoBIGm52LKJmTABIve0nuMKazipKABWXczKMJd1dNaCEQe60cROMXvZzVP98NDjgnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEViX7fbOsMg00vV3vG-JQXrXTHHEZ-_PKrDLfaecx4Q&oe=6B103F2B"}, {"file_name": "screenshot_5_isola_alto.png", "id": "1865200054897350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673738609_1865200058230683_9152509647230052255_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r_sL5AkvkkQ7kNvwGkEJ2b&_nc_oc=AdpGHmXbeWw7RnYpYsJ1n0nTAl0DiWTatE-fNHZZRSijT_VM4a6nitOFRcF8Mk4Jub0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwydDzAsugHQN42kfi3-8ADXa7d0mKpJzFNZdxS9osig&oe=6B1048FD"}, {"file_name": "screenshot_4_isola.png", "id": "970076255794514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_970076259127847_5984138969731993226_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V6siDCFDRIQ7kNvwFDz8Y6&_nc_oc=Adp9G_NizSRB9Ga3iFKUnzHbmcDGNmrQDBsl4kAJKT0YLvXaB5wgaxrPktp0gqB5RTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXt-hH1bA3VkGW64wYQnv1vcTpqzRbnMIQ-JcChMCpydQ&oe=6B106981"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Il Mondo Bene Essere", "keywords": ["mindfulness", "memory", "relaxation", "wellbeing", "cognitive"], "long_description": "Il Mondo Bene Essere brings together the VR exercises created by the Bene Essere team in Rome in a single immersive island.\n\nHOW IT WORKS\n- A 3D island floats in front of you: rotate it with the controller or the thumbstick and point at a place.\n- Each place opens its exercises. Before starting you see a short description and can adjust the settings (difficulty, duration, speed and more) directly in VR.\n- Each exercise runs in full immersion and brings you back to the island when you finish.\n\nWHAT YOU CAN TRAIN\n- Attention and inhibition: The Lighthouse, Whack-a-mole.\n- Working memory: Koi, feed every carp only once.\n- Episodic memory: The Witness, immersive scenes with questions at the end.\n- Divided attention: The Market and Airport Sorting.\n- Cognitive flexibility: Katana, cut the fruit in the direction shown by the legend.\n- Calm and breathing: Aether and Constellations.\n- Duel: short challenges to play with a friend.\n\nThe interface is in Italian. No account is needed and no personal data is collected.\n\nBene Essere is a gentle daily training for wellbeing. It is not a medical device and does not provide diagnosis or treatment.", "short_description": "A VR island of mind-training exercises. Turn the 3D island, pick a place, choose an exercise and set its level and duration right in VR. Train attention, memory, planning and calm in immersive scenes: sort luggage at the airport, feed koi carp, cut fruit with a katana, watch from a lighthouse. Interface in Italian."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beneesseremondoprivacy.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "Bene Essere", "support_website_url": "https://beneesseremondoprivacy.netlify.app/", "website_url": "https://mondobe.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1501153789738706"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/767585477_1137293325360272_9071977861411515494_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkIZbuRGSCwQ7kNvwFHxY39&_nc_oc=AdpYbmGAqOhT4jprSjtDilc4kO1-uzHmKRbrR7RibM2ljptEuxzT2AekJn4_Su_r5A
: "copertina_quadrata_1440x1440.png", "id": "1137293322026939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/767585477_1137293325360272_9071977861411515494_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkIZbuRGSCwQ7kNvwHqR9vv&_nc_oc=AdqnzS0HWrJBrNobTQSFTxHVMb6f9njh7UMyLqZH4OZPqUBSTw84cltHpbxmLX9pPc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUDFrFu9D6rKVRGhyG94LAX4tLoqOYo8Xdca7CujEpLQ&oe=6B0F11BE"}]}, "id": "4862218334102936", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1_benvenuto.png", "id": "1461554342794335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831299_1461554346127668_677253963315390729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5llXBkeeX-kQ7kNvwHf0aAU&_nc_oc=AdrD1mRFvQHcTMkD_H2ytR0p5H3g-wLixkj_p70kTS-9qmCGx4ugNIJ7tArYeDp4wf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXRr4IsKDxS2V2HD5SWoCebDlT7crWylDwVP4gHv9IjrA&oe=6B0EF00D"}, {"file_name": "screenshot_2_esercizi.png", "id": "1589328949630810", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1589328952964143_2045481382003756288_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvlspPqpz-oQ7kNvwF5jr0l&_nc_oc=AdqBEHqc5mJBE_H4zstX7hZXhJAwC9QWWPp4AoLohczckH5dXMAJOsGtjuzDe94rrFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUMKGwZuGUsUbcjylJCOdFoN5mFR4-uZBqZr8szUeFc-g&oe=6B0F071B"}, {"file_name": "screenshot_3_koi.png", "id": "1001527556328250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/613094043_1001527559661583_2942534362364023241_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WfCOBs0Yp8Q7kNvwFujZOO&_nc_oc=AdpvjQ8ticRAI3Bb4QT9H5RhU3M0VL5EIuIRSAMb2Ml9sHuKRIutPnfCrnl7vOnvNl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWFjQ0nCXjzZLjy7CUZ1Ll_1-ZxVDEHhogqKpe9woAfA&oe=6B0EEDAB"}, {"file_name": "screenshot_5_isola_alto.png", "id": "1865200054897350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673738609_1865200058230683_9152509647230052255_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2J1B7o9dOdEQ7kNvwFwpqmj&_nc_oc=Adq1tpvm3sKDrjoivdsrr-43CtL5sZPeY1mgtE0sxDmpb4d2_ZhJU086wSFMKC6TUf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGlC52qVcUg_W-YzIn0mKlknECdqkNBCiljRdakef-RA&oe=6B0EF77D"}, {"file_name": "screenshot_4_isola.png", "id": "970076255794514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_970076259127847_5984138969731993226_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V6siDCFDRIQ7kNvwFqxsmU&_nc_oc=AdoICPvGQp-mrswM3hIpqUwATgM5r5qgdEXKS2mlbHwJaM7hK8Ojti9J-JqS4TPngKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAxH51CNHxUuokJWRnlihwQVuvmG6L889ITynzDIDUuA&oe=6B0F1801"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Il Mondo Bene Essere", "keywords": ["mindfulness", "memory", "relaxation", "wellbeing", "cognitive"], "long_description": "Il Mondo Bene Essere brings together the VR exercises created by the Bene Essere team in Rome in a single immersive island.\n\nHOW IT WORKS\n- A 3D island floats in front of you: rotate it with the controller or the thumbstick and point at a place.\n- Each place opens its exercises. Before starting you see a short description and can adjust the settings (difficulty, duration, speed and more) directly in VR.\n- Each exercise runs in full immersion and brings you back to the island when you finish.\n\nWHAT YOU CAN TRAIN\n- Attention and inhibition: The Lighthouse, Whack-a-mole.\n- Working memory: Koi, feed every carp only once.\n- Episodic memory: The Witness, immersive scenes with questions at the end.\n- Divided attention: The Market and Airport Sorting.\n- Cognitive flexibility: Katana, cut the fruit in the direction shown by the legend.\n- Calm and breathing: Aether and Constellations.\n- Duel: short challenges to play with a friend.\n\nThe interface is in Italian. No account is needed and no personal data is collected.\n\nBene Essere is a gentle daily training for wellbeing. It is not a medical device and does not provide diagnosis or treatment.", "short_description": "A VR island of mind-training exercises. Turn the 3D island, pick a place, choose an exercise and set its level and duration right in VR. Train attention, memory, planning and calm in immersive scenes: sort luggage at the airport, feed koi carp, cut fruit with a katana, watch from a lighthouse. Interface in Italian."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beneesseremondoprivacy.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "Bene Essere", "support_website_url": "https://beneesseremondoprivacy.netlify.app/", "website_url": "https://mondobe.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1501153789738706"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/767585477_1137293325360272_9071977861411515494_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkIZbuRGSCwQ7kNvwHqR9vv&_nc_oc=AdqnzS0HWrJBrNobTQSFTxHVMb6f9njh7UMyLqZH4OZPqUBSTw84cltHpbxmLX9pPc
le_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuB-rzTtVaQQ7kNvwGG7Yjr&_nc_oc=AdrHko5rm3-FILXDc9__-vUQmeZ6q5PmqMMGxHuvCBcnOGOSN589AZ9fy-NIsOKKEwk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PhVD-QJcTNkW2_Z1rGx1Iq5gie66fOJMxMQvB7CC5ow&oe=6A466D4B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MyWZnat8-0Q7kNvwHFfCfH&_nc_oc=AdohDiHh8Ya4rQz2VIW1gTGbVEoCalBx8bPxv3pxTvr-UDqYSFVx6FsNa2lqNUcf8lw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F6MVYshvwGGrT_L9nnw8a79NnF83t53oYbCqez2-25Q&oe=6A468983"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfkW3E5g6HQQ7kNvwHLFuJE&_nc_oc=Adq-pWMfP3X8_0IZe_sd5k0hVDhqx_Bvin8bqZOt4h6VbqxMtOvm25YVNHdNkoh2Y7k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pUK1QL_yq4p3lysmk3J5cnW1-qjEm98cfl-nY2Mf9vg&oe=6A46796A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVrmrGIbG08Q7kNvwHigw6T&_nc_oc=Adrv_y4uDmZ2WyQ7ZkXKMoujIzoB2JgNM_W-iXFKb-at-9_bw0Gu9aVxlOvmRnUCUf8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dJwuFKHyOYNIe6KFjZ8kC5pjH7tFWgKA44Iy47XRawQ&oe=6A468452"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
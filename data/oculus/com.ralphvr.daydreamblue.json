oc=Adpo2eNGHp8Alb0dcZMz0ybfOCY6nRGGGhjoVjxquTp2FS5CtM7CdGDZ9e6lNOZqtg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUO2obdH-GRvF1PqPlPXur44E4seifljVEStguK5_dCWw&oe=6B10465E"}, {"file_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmH-9ryb6HMQ7kNvwFoPaEl&_nc_oc=AdrgKl1GaqvWai8YV-iw-fy3oe8B5vEVAN_1QPJ_g1LKJuwHFOPVydjwFJV1rdzoatY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMeXT4dmtk2oFTUN6xfIBcemuNTuB4lChiJ6vDtVI_ag&oe=6B105B0B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhcLDq7M-VAQ7kNvwHV3hxX&_nc_oc=AdoEDQwG1B1iXmSBCaDJGktuOsOWNlkDq2epW73RdFP1zuzga9tIWpaisewS-n-Th0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3C8lJtRFOjh-cYJJeXspbr0FWGjPITC7DFHd1fPKIpg&oe=6B103F03"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJPxbV4dQ18Q7kNvwERuJ62&_nc_oc=AdqIl5mmq88AJYa9rd8sripQMEGDqV7A8r1gFk5AFvLo7VGgCbxgeuGm5I7xv8J7lT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVG1QqCREA2wnQ5GWrhab7BCjGvlh0TDM-7c4t-aAUnlQ&oe=6B10672A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcw5fkdM2fcQ7kNvwE39mSI&_nc_oc=AdqCJZ_zV28uTnpyyPFc_tQcdx26_NmUFotD7hQUtbW0X-mcvlE4SnPrRSpx3cgwsY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWNiGe5tIxodZ30FEV_uxtXF_G_88cpdAID2cABjut7kQ&oe=6B1039D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
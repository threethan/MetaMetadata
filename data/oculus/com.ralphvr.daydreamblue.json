e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li8uKsXNyywQ7kNvwFaBOOT&_nc_oc=AdqS56ypzg2QI3OunwAKpMbfJh97fxmFVO9-q2seeezMSikwMLACngZFMSkIW4q4RCg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4B6Ljb_JsmhuAdE-sDAsPOxnKZ7wi8Gh8AkvRrSUV6A&oe=6A71EECB"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_1kGr7WyFIQ7kNvwFyPsJd&_nc_oc=AdpsFgQmYlNpD7OpbeS7nBRtRyHJ0jq-RKALPsZVhBOedC56ysQ1sPe6FeDChoj0DXQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgdBSusj235N0k5LX9USNTsVGXCGcTbDPfjb4-KZjVZg&oe=6A71D2C3"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvY024VzOeIQ7kNvwHNcrPW&_nc_oc=AdoEGhAm9yjn02GF6rKfkafa5e4j_-oI0fBxVfmWmPw-f84ArZw6QqoUtHucLVHSeN0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQVOzNdBu2uqPsnKszEVCnKFfiItpyXJwVnOZ1_d5nYQ&oe=6A71FAEA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym7Wlgk07NEQ7kNvwGayHYr&_nc_oc=AdqzALIsjQyhAl8oPr6hT-hLv-Js9gXT7nMxBPWuUTx9SjYmfLUmRXpLalpB8lHGI7w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4tAtJaKt8RDkCCia2XiyVIKXVFheusp08lNF01lu__w&oe=6A71CD92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
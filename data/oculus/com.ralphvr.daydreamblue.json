oc=AdpwTokUXWZXcWVJ01tvQi0GVI_fIIWoxEi5FA4ODgUnb6FgWZLvrUBaG3JtIRlCZKg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRCDT7aLEBolq0bdhZl1M4Tl34ZYYFLC5WUbY75v_nhw&oe=6AFC7FDE"}, {"file_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84qFQnys9JoQ7kNvwGaAWF5&_nc_oc=Adq-b5jXR0rlvaDGh8kBRFFL5LQ255q6i8GoKrMats9GjWLWtX3cCWU-7YkFjK3NntM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR25Wvdj9W5PwVyg6GdLWQU69hPrs9-l7LodtNrtKVifQ&oe=6AFC948B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ueg0ApQYdEQ7kNvwHkjrZl&_nc_oc=Adryzl7c5EoU9p9Bmo7RMX2RcVmWlLXTG_4jEXs-mT4rDp8SYulOA5zZKKcrWmHRxU8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Cc-gZorKMntm4hL957EHrKEDyI3Y_JFgSeNhLoaZVg&oe=6AFC7883"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT3FsIS27IgQ7kNvwEKP3I5&_nc_oc=Adp5OooZIwxzq-WBg1WYd2sqD_RRg6BPsJF8XQU8kMXgJWJCRAXmTyFZUyKlwh6hhZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRcZQJsH1Kp5sVmvJoA5KZ7frwYvC4R1p_F87WaqsdCw&oe=6AFC686A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZTzVa6NQcUQ7kNvwFBRAl9&_nc_oc=AdpWHM3Nh0BuTHA4A4O5RRP-Q07t8TaFgJNNvheJi4fViBAEhMROL7Wd3vNuggF9a08&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS2XhRR3osIgGkiJiUe0vj9vCFkdUw2oZFS9CTb8fPeQ&oe=6AFC7352"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
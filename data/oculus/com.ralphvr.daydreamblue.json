e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIuo20odyJ4Q7kNvwE-t-12&_nc_oc=AdoRGyDtYWNTPizEhne2Lx26bo7x2Bikc7HAz28qt7w69dHaeFmgkmLGAIwloPb0pu8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNLPDOzd_zWXD_5hqlC0ZSo16fNiDh-9HuQigtP2Nzvw&oe=6AB67CCB"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfQ2n9TrfE8Q7kNvwFQcz4y&_nc_oc=AdpS46fBVLiEezjoKSJjPaxQ0J4srz-NexFai2D44jtNHXIdSZShgbJSO-_e8O1nu0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDjiT1s7cI5zoIMPw_fLiCiHsA0z2plEM0k8VZONxd_g&oe=6AB69903"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZiZz5THxyIQ7kNvwF5x2jn&_nc_oc=Adr6lxG_OQneWUdSzxxzoOCyr87NQA6ElNkdBnuxTfPPz0fqu5NMlmfAWfai55AIthU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu95oD2yjMuZanNz-yGfzBg3RmG74_uBLVjRxW3xuNfA&oe=6AB688EA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B00LIP2QZlwQ7kNvwFwJHfI&_nc_oc=AdoznEzFaVu_UxrfNfyLmMx5M7T13c97UMiYyUJRmcwdnkRmgFKG_fqEFvhjCoxDV9s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkFYs2X9eHrv5uMSmysHH5dqDNlhkeG6iei9ow7vRpEA&oe=6AB693D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hKLbkbVADgQ7kNvwFq0yVa&_nc_oc=Adp9w_qCDe11EwxCm9xo6SR7-LXWgVbLW9QVNxWD3XBhR7JnZf_WURrY89Mx0Ja0y10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr7a20j1_zCUIMgPPTjxsW99gFELCcgyHo6oDKb_6FsA&oe=6AAA9F4B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1o0vyjmds9MQ7kNvwGUkNNH&_nc_oc=AdplDDRO7j7bW_hPhG8t3aThOMc-FDGdP8rrQCLcLwOpIFXzwpJL6Admk_v2NX3Qakk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMw3w9KxjRngxVhPt5-ILbvswGTBo64HJuKg2d1qqUYw&oe=6AAABB83"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6irbMLlRlUQ7kNvwHZssD3&_nc_oc=AdoTof_2a0vGYTg1o85U8YaVC0bnqdsqbLctK4cCNTTNkKJFWBO8OAAKNmPuZR36IyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-YSLe1crsfqur17B4ODqCEnmzCFQwplITEUGoNa3yeA&oe=6AAAAB6A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBE7K3UBq6oQ7kNvwHHkAPr&_nc_oc=AdotALiNUpfQe-bvv2Q-4D4fElyGSHN5O6qCI27OGnlmamvZZvIr_cLDMaPPVItuCAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwhRL-6hGxpHU4Wo_K071xoHo7XikMB3ERlK3ZO3J4qg&oe=6AAAB652"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIik4ggmUVEQ7kNvwFzxjws&_nc_oc=AdlHpf1o3Wj9hOtX4OqV3UpJUpUkqPeWxAO3NfUqjznHP2c0h9lYwYE6K64W14lExLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuxbnBJJFHXjVgC8EfExM_I_dDphTHVlMxYIZXlHmv9kQ&oe=699C5BCB"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiBi8JlohcIQ7kNvwHNanuG&_nc_oc=AdmjgU5HCr5_HPwkXFFWYtxY2hoiXjlm4KazAjuJTxayk1QahgroHN4j1AGkjPsc9Ac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfscPiXZ3aEwaA0Muk_Vwn58borUH2EVXfHY0tdAFL9vvw&oe=699C3FC3"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzIqqpBcF6MQ7kNvwEemuGh&_nc_oc=AdnwMN_E7XpkBI0Jiqyjs84SEFIxUDZk9vaHaIMxbkmOznqi7UQk3sTfH3-FlN3G1Fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu-Cpzr3u0ZJpDEBhOt-uvJ6yKOgPXFN5bbvZFou2jW0w&oe=699C2FAA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p0fS8EmrZsQ7kNvwGzoqQT&_nc_oc=AdlRcQPrXXCNoxTFy9pwL0d8VEgMw8SViCZcaYJwX_F_3aJ8EUvWuvavmy34E1xd4Ss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvDPSZkExoVnHIluJzYy1KTv_NBQCrgF9Cs58ygBQY4hw&oe=699C3A92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138848_1674193699558666_2375952895712428032_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-
e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUEZonAqH8QQ7kNvwG8vLn6&_nc_oc=Adp3BKu1Yj59VKZKnHF0GJ5zr1njb1wtfBaY83L2Lz-Nszc2wi43iSQeWVBjVrvv8TM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMvN0Wz5Jx8tsE1ynguKdpnS2JAy_T223ePfkE3pYO7Q&oe=6A915A8B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ee6wjR6wisQ7kNvwFpUwyz&_nc_oc=AdpTalhY9Yu-WPmQEZFQz62rarXXlo0CaicG2G6XhAfhqDOzg-MFrZnmYr8Px8KlZd4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED9oWOFJgYEkaDE2IbwvCu7c7VF2gZqyMTw4aiunQ5oA&oe=6A9176C3"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIcAJEyEoOAQ7kNvwHUVyuW&_nc_oc=Adq1WphLG-GIYXRJX8pi-t11vae5TCF5taTfEJ5cY3sr64bivuwbEbnpdKTSEionI0E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqG5KH0apY5_pInfqtf2gHRdKsQyc7ZWYtOf-3vQnnOg&oe=6A9166AA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbPDSQIK4PwQ7kNvwEI-2Q9&_nc_oc=AdqO75e1hT4I-HkHbc_TAvnAb6sLZ_m9KEolLZVAF6b-DDZeu91L3_xKdSzWFrMjbzk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRtSyUU-09OwgrRfRSkmPzP7dZJgHFmm6lRnCwRT701w&oe=6A917192"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
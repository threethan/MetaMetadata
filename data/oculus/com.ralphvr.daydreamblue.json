e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2PY7n1lxqcQ7kNvwGdiwnf&_nc_oc=Adp_ioDTabo7CmaNJdfFjDuuPpkrhkVHTHGa4K2bHNua1oQpYJRIQCzcZY2lHoG8pgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24ueHoheQe1I-ohYcS3adEy644JEzRVnfQiAvv4e6rMQ&oe=69D3BACB"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MLhy7X7n_cQ7kNvwFn7p2N&_nc_oc=AdrYmOHh1e7d0AseZEK9vgnFt0gxy5yFr1GklyyJ974XLdma3N4I0esVLHY4Ss_p4yg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sj64lUC3GImFd4VimI2vD5jX-Uc4VMnD6Dv5pz_syig&oe=69D39EC3"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpIOMlhAMJYQ7kNvwF_NJTx&_nc_oc=AdqX8Mv7Ob2iipzH2x4docaiONFlwkRimnmtZ3ZhPy3B9KS9t8JLll0kjAQl8TFnKOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gCqixkJ3HubHLVTu3dpYKMajSh4lRObWSBIAmD2sF9Q&oe=69D3C6EA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0L_GR-lIhwQ7kNvwHXj25t&_nc_oc=AdrFPYdN01CUxXX-Ae-YqcLrRpm7_Gmov_uCLs83AI6A-Ro3VdHJkR-lKrF-vtrurTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D6iSlzwYLrPdLiCn6trFobfE7KMXojBXW-NAvq8kZeA&oe=69D39992"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
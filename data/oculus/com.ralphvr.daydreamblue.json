f&oh=00_AQBuRSwmCs7uHKdcrAUsoGNjEAs5tYrbiaS123si34vO7A&oe=6A68B16E"}, {"file_name": "migrated_image.png", "id": "242819263430002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138832_960175364052141_1384421680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UZhOpTOcXwQ7kNvwGi_WMP&_nc_oc=AdqvPrVBfg7HL18v-4Ttg3Cj_f2rir1N8PT8SX7EWajMO8eJOPt0EtmlKI6PPk5okqQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRzupwhTI7xKDt5G1Zu3abkmwqfjUXyVs3zsDQGO2qcg&oe=6A68BBD7"}, {"file_name": "migrated_image.png", "id": "204378094240396", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12482343_191260564665364_6642883658816421888_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mhAyceS2isQ7kNvwFRs6HN&_nc_oc=Adrb8mJQWqD50Qwa4b33RdUZ9PnZ9va4G2GEfbKlalxefskGK7-jivVaY7v5wQZg28M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2tSWjCWFg7v6DbZNlFxxMmc2Wmo1bz9YFEHwT1hjLDA&oe=6A68AD74"}, {"file_name": "migrated_image.png", "id": "138716730895627", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_1301919069834465_79683846_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9ReaTkdbxAQ7kNvwF5lRhH&_nc_oc=Adrf6299URpNPKflzIiHwv_eZC78RX9N1JhgzV9zVVElehq5DfSuXnI881d3fzYRnsM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWGSJXChXiJFrDmlO9YG2sSpsH5VW0FSctKwA_lUo32Q&oe=6A68C23B"}]}, "id": "656622931772667", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "673572540125606", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602235_1600054556969368_6565890945491927040_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWVee8KXmX0Q7kNvwGYYMum&_nc_oc=AdrG-Pejjac-4301vWeqyT6aZxbTR_YsjDD_A4yrjFNd-FP4Iubl2VAtLMtaeoMs52c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB2PD_1tR1eQLjEBtF49mvRNJuESxoe4ivW04VlcjstA&oe=6A689F9E"}, {"file_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XklXUjlih4Q7kNvwFKmNUe&_nc_oc=AdpYLr2CqhZZCH8D_HqUA0F2KlPI7p_G4U-wkpn9U22MSNBwm0VtOociwDwNGA5PXI8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC46V1F2U4brXjYkd00wkLXy9YlwBiKk-zLJ5PPCvYorA&oe=6A68B44B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYxeHDbSZ84Q7kNvwHakEDP&_nc_oc=Adq2gkMuEXxv5MGpDlLOai7lUDumoYo6W-oZH5xDtIsC2FRIfhabxvdsMo-WOJD1DOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADIigXdA9U2dUpIroHVzVgxZBSaUcgLzw_xlQr50VbGw&oe=6A689843"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBzhxlg5tm8Q7kNvwEenoB_&_nc_oc=AdqWIkeJ6OP_X0GbSEbjV95bNVkMpLYkz6cFBRS1vv9Hkkl89ljGaaPDMLKHCOfilH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxsWIyvwKOKft59JOdUiQ9m5tUHoaRtpaF2hv4QND6Pw&oe=6A68C06A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-AW7dIDrksQ7kNvwG_3xPu&_nc_oc=Adoslo2v1WXfRTmCQPH50QF2Zz6zO7zE2vBGouQtgA5CK7Ra-3pPxNSp1zBScr4Ef00&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU1AwNV8I3CJL6poqOI4LRyJtE-Lh1UbwVTF38uQjUSw&oe=6A689312"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
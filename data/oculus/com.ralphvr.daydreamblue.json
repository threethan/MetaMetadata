oc=AdoAt8vp2ZQvNAEq6XvD9JcNJRSVpSLojmi-vlspv8_TTS0f28I41-Qy8Yatb6x_ldA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNbo8V2YI4vvt_yn55e-rnVuLOjFpR7UWPb8P1uxiMxg&oe=6B0468DE"}, {"file_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqU7rMu5kXcQ7kNvwG9Zq7H&_nc_oc=AdrTnPoQBCz13e9N2pOyHrc76C4Lr2jE2k8UK9j5qm8YwGO9_7BKmytEHtgMOoJWZTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyTc0W3Vg7fUmBXm2Gpxl-neEW48fmBkEWVQbbWVIA5A&oe=6B047D8B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoapbVc5YVEQ7kNvwG3VAJY&_nc_oc=Adqm6b0gvmas3k1KLjhd5rGVkpMloJ32CC0PNm1GUCuYINd4a_ZM9B1orl-J2crIQEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9uFkWgkQRm9oCk2guQr5uRGpsVlQ6a1TljW1L-Bzcsw&oe=6B046183"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvzqfbkD4NcQ7kNvwEUTHy0&_nc_oc=Adp35Yb4IrHlRCr2sRPPpbTQIM8SM7NoI_M8Ul0a8a7NehPc-MBL2dh5mw9SjeP09G8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1FKM4BJMLNkpTms-a3M61w4vZweHI22o-jeHFuWXbMA&oe=6B0489AA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZpTuG3fmRIQ7kNvwH4cHy4&_nc_oc=AdqVlAbEBOnq8QGjmb79xgCmkt1nsr7Z-_J6FAT4QFIUEUGBf9Ulz26oRnMERhR-hKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpCCH6njvLXGhMjkL55nD6pNhsi__eveJulfQp361xZg&oe=6B045C52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
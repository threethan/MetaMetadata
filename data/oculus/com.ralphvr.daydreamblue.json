e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdnTxadz-38Q7kNvwFA8GFe&_nc_oc=AdpSRqapKyPX7pmzQGr7rX4xLDpEXiwpIZPk1yOc_gjX5fSV6tnDAiAg1roYEFd9yvA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu5lHIPbo7X8ShWK0IZYd18hsjQ6RZETvGKj0_Fe4XhQ&oe=6A563F4B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BAYGnQynpEQ7kNvwHv_kIm&_nc_oc=AdorIvgG-0-cbxgEtyt-Jz_3C5SEyu3gCNXPPggGjmZ6E7Md3stBzY55yErdVAVxDU4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRDNRVsEdnuapjrXEm8Ov_QkXUgYN3h3MG8TtKknRKBQ&oe=6A562343"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PUYN-9Qd2oQ7kNvwHkJWWZ&_nc_oc=Adpmvlp0a4bKCSaHNhvAUJHjZ-weEVgIrb2oL-r6DpLSHUW-UDGZZPwR3Ax1uI-moQQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANSfob5Un7DoU2vtJ6FyBDjt3FVMqCN2qu4H2l-7G0HA&oe=6A564B6A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnDapIYos8AQ7kNvwH3Enhc&_nc_oc=AdoTQQmW8yxz2oR59qpmV0_-o_nNYoMviMTwYcB4CHGgaOV5XTTzqtucDtnu2ms07Ho&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_WZ9pY14JX7gv8ghUExy8yc84TbO_aiwW4GUmae9Vmg&oe=6A565652"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
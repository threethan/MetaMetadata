f&oh=00_Af3FFNbJ7Uwn_ZS21Hl_8NwE9bpjJ9spqmqu01BlOTpNaw&oe=69EB72EE"}, {"file_name": "migrated_image.png", "id": "242819263430002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138832_960175364052141_1384421680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEFsrsttzXAQ7kNvwFFDbVw&_nc_oc=Adq9O-ypvWhX5gEE0xV9B5GToH5AQ6sb3eEQIfLRNKvp1zACU0N67xPEH52zQEcepOI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eKG5S6s2lZ9Ps1Y0YYiHByJfTzNK2Ch9YEDmbqWfg_g&oe=69EB7D57"}, {"file_name": "migrated_image.png", "id": "204378094240396", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482343_191260564665364_6642883658816421888_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dZpRfrbBfkQ7kNvwE5ppFN&_nc_oc=AdrZ681hYRvxL2QaddKUePlDvHvvB5h1W3LxovQ9e8j579TjFCMbzFa4sVVgmL0KWxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dQd0itwhdAXUthCPowMucwY7xg-elmYtTAhGr9IgEUw&oe=69EB6EF4"}, {"file_name": "migrated_image.png", "id": "138716730895627", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_1301919069834465_79683846_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAvU9Z1xYDEQ7kNvwHQUJaP&_nc_oc=Adph4BGzu-rSX0AYY8pMC_8hKSpEi4EbM29OKidpldCqlXZSIef-oOw_ivE-Zj8cHQc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d5Oa85WAFnriF9qO8rNi-Mu2kGt9_4nQgTeVaIV4a-A&oe=69EB83BB"}]}, "id": "656622931772667", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "673572540125606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602235_1600054556969368_6565890945491927040_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMNL_kGHIUwQ7kNvwFtwoDZ&_nc_oc=Adqt3tW8YYfmXMdI_4kA1omcE30uPE-yvg4TtWVg95etdrNkZ74UZN6gwWPJ6ngvZuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XJJheN-dAmTwRrImxGRiOzsoB09YO6GmjEFpDfg5D7A&oe=69EB611E"}, {"file_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vk8IhzQyorMQ7kNvwHTY96w&_nc_oc=Adq8D8sWaxTVOZqcsUafR182ZTRQZNnmwEtr4-Z4-jDIerw1VoO6a9AQJ8klh2vP5hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s-ccLboL8ha5vOO5wIk5RA2XsPVPW5imiQRFogadvOQ&oe=69EB75CB"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLKkw6rufIoQ7kNvwEPXE3S&_nc_oc=Adrpj8v-ooeSqQceg_imiaIi9h6Eku5fc6l6_37gHhmg_wrieeRzeHoWtgG0yQvRJoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rPwl4DGwpMwTIfQgdlytHCeNqmjfap15sO4DHG9aZyg&oe=69EB59C3"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9djBe6140iUQ7kNvwGdHbuQ&_nc_oc=AdpvMwHTF1bF3SjIDXP-B5pWQeK2XW4xCRKsZ-JamuATvax5SyPRs_mVl0bMIwoUzVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ktsBznANQTZGgB_RwpzJWjxtdzXVIPUWX-FTMCPz55Q&oe=69EB81EA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yKOoUtPXT4Q7kNvwH4yiNp&_nc_oc=AdotzRIsx6h8rRMqmKGIGYmn1Smqt-ReRYPUcSTs1vwwDLI-0qC9goFY7ynUvDx7BsM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sCDVB0F3HK3Ttv1UQvQ-UTbnECju8FW4X-rt0NrvQSg&oe=69EB8CD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
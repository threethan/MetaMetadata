e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygxU6xMXr6oQ7kNvwEpUA_c&_nc_oc=AdqiFkIBkTi6alg2RGswX0tQwsp9iHN7N56UFVKf2S2bPjuTMn3D229II3atfi3wYBg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzm0ePNSa-5Ag2n1oubxGS254y10ZEO71b5YqWdFy-Cbg&oe=69CFC64B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sC3OHW9bmgQ7kNvwH-Xk5V&_nc_oc=Adr0Ih4Tw8oacbFiG3JslE5U-OLRuMvOVJSFWN7D4CnkB8WNeyBzhQ5_l3lROSa74XQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKwggLMYNu7o16NWEJzMsQfWziPHYrgIvH3bX2uF0sLA&oe=69CFAA43"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqJk_9KUKZAQ7kNvwHzRxU9&_nc_oc=Adr6ZPrS39dPw1juFlEU-lfhE7OpRKfFDzVKXgKfwqz4k5KWuCnlrXOXYVEyPDtCPbU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9hLzk-vzhliYxGK-iTlw_aFYr0VdzCa5Kaq66ioe6lw&oe=69CFD26A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_O4wPkK19G4Q7kNvwGhOwWN&_nc_oc=AdoKsZRSAu3n8pPb6S7IF9I5Tzr2r3Qn1mMwUe2xkieRsrn47EIqLqSnhjgG7AjO8dw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMuyxtOCJKOzIhQ4p3GdtZcRC62SWRd_gBMjCyvpHGHg&oe=69CFA512"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
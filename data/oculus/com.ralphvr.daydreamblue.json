e": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5c31LhhHJEQ7kNvwEUsHef&_nc_oc=AdoOQQzDyu8azqyDGrglAJ-KQSsQOjxycVOVzy1AjcPHRlWNJ_688ursux6kUDhDfhg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R0A5lYWeLy6grvhLJp1FXiTvg-KcafrQes9AnPEzI2g&oe=6A105FCB"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1Hl4GcARHgQ7kNvwEdWgea&_nc_oc=AdpEDOsW-O2x_CEZuBatBjIL__UqfIv7Oviq3ORfcRT772rPwlfyeElQkNvBYYKgCI0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pWvIuLEZqO9RqyA6j7xAaZPN65kYautDcyUAyoUh-mg&oe=6A107C03"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQtnLsjlOFAQ7kNvwHEdua9&_nc_oc=AdrMVV1lYthM45e1pza2-2eK678-PalKPm_WzHwbWg_dX34kEe17rF4M1n-tp3WwXak&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L_PYPI3tb2GU39-XckMNeHiKTJ9MymiUYWfnNpk9Q3g&oe=6A106BEA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhVW0TurCuAQ7kNvwHcg0Tb&_nc_oc=AdolrZcvSc87e5SQpbROlDeEFPGCgYXLb4R-60Gle47kx8uF3kMBQqik3B2D20T_IkE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AKtTC7qm__18K4d5rgcciwRQrhZ_4dSyeHaE2W9OKUA&oe=6A1076D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
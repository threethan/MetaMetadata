oc=Ado3omD68JbFeBzCKVaNtaDNMQcA3Y0Li1aFv8Dt4on7ZbhTxFs139Zt4zdy_gzcpdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwTuw4xGIGJ0RPvHadMau-f7th2o6iAmVAjmLdwieAcQ&oe=6B03175E"}, {"file_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqU7rMu5kXcQ7kNvwFDlT3M&_nc_oc=AdrSxLw6F-j9EPEhAiexveCeRXVPmM4LK62yzDquS6CiIgtYsmaL1qD7U2-vpwdj2kI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb_Zdam5FLhoi15Pd5BXT2UlGM5CnUHilE0dqPBTTKuw&oe=6B032C0B"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoapbVc5YVEQ7kNvwG0NTIh&_nc_oc=AdpYpR4ib_AsngLL3qx4Nle6OsSl7UDZakhAwVCgd6eKQAHobAgnLLJjW4S3OvyH4yA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgbinuiJfYl8Geah9Yzqai5kigO7TDd2MZF4thPAfG5A&oe=6B031003"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvzqfbkD4NcQ7kNvwFms-eg&_nc_oc=AdqzWyRYUPLiw1f6QvdZOrKwVHgJVyvms4dafbvCmvIwqCD0QojuoNVrEN6Q67CHVUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ZQFPr2iSf-Y1GTZRsO1lN8SDOJ3YPuzR7PvAHPh0kA&oe=6B03382A"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI-uMzIIphwQ7kNvwGUJqbD&_nc_oc=AdqmURvKd4RZ1txJaLjuHmnuqzpgK9b2TLDXa4ymz9t6w4mBiy1TuvXqgbvxvelrilw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRht7nyfuQju_HlkkEsMvd6CB2znExRhH9-33jcbPJ7jg&oe=6B030AD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
f&oh=00_AfwbIOCXlewswXtKmniuj9oO3ZNgaMn-rlk7WYIHz_1LpQ&oe=69CBCEEE"}, {"file_name": "migrated_image.png", "id": "242819263430002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138832_960175364052141_1384421680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MCo8QdbixcQ7kNvwEzZnP0&_nc_oc=Adqy0dz1S4j6oU-ieJZsvGVzF-M_sDJ74WFnvn8ECEtqmgXOagdl7c6-dOED1tD7p7k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw4MkBLo0lDRic7OrADyUa0cy5E8bSTPADxsOzElEdew&oe=69CBD957"}, {"file_name": "migrated_image.png", "id": "204378094240396", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482343_191260564665364_6642883658816421888_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EC8QOfU9boQ7kNvwGGl8ov&_nc_oc=AdroRD6L_427MzXujX0xkONAv-49xIXtrRtQ9gGmgbbvn4q0CjDt4lw2AElAu2M5UMg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNG471qsVR5nyx-O0pFGq3fOorxSKxZ1AR4-yDjGXG8g&oe=69CBCAF4"}, {"file_name": "migrated_image.png", "id": "138716730895627", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_1301919069834465_79683846_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8tRm0l40owQ7kNvwGYuaZ1&_nc_oc=AdrUy9-NmcX1-JRMVCklsDVXK8UWdRdAyydh6_a1TuEBuzPTF6yYhdRDSvBDi_aMt-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjCHgVFadHlZ9kmy8goqfKEC12EYFOuHv-63GPZbDM2Q&oe=69CBDFBB"}]}, "id": "656622931772667", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "673572540125606", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602235_1600054556969368_6565890945491927040_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoHYLYV9egkQ7kNvwHVnr6-&_nc_oc=AdodjgK1BqpO3bVjF708iDpfbWRRhIz7sHE_HuF-w4G6Nl5SZeoMIPfM_iiv2uPSk_s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIRxVIGIR0nA13B6D3KwxXIk8z_f3lWCAWtMszdTgaPw&oe=69CBBD1E"}, {"file_name": "migrated_image.png", "id": "623429851831490", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680517_449120785258344_7075541029079744512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuBIE8wVpc8Q7kNvwHiyNse&_nc_oc=AdrqVs4zyixZXOQCztXoVmX9dq4jjIpP8JD9HUO7AEfiZRgTO19S0Lnst3a2zobZC2Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwt3HlAVdPNgfyzxaKy-eoP4JLiFxq34ugKOR5k3b1MfQ&oe=69CBD1CB"}, {"file_name": "migrated_image.png", "id": "617155355682910", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138933_553517471508961_269704215109042176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLH7aoDWM7IQ7kNvwFrY4DI&_nc_oc=Adp2hXyy_UafLEHaSBthxny28BxNvj5rqYyl6eTyLE2waXze3AtMcU2zB0c2MXUPSWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0VfiGCVR8fBbT0uq34aSlmNrp9KAgUDEw067QzPMZVQ&oe=69CBB5C3"}, {"file_name": "migrated_image.png", "id": "208826913686206", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680297_1892763980951337_8298338112539459584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtBfaNnHng0Q7kNvwHpCOxA&_nc_oc=AdpJsugKiLTez5YCVUdJgpmiQ7uV9jX2auiucQRItIAj69OFypOnbA5z8pr-mSu4vu0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4bc8TayZwbySnhWo2YHke8IdG0zqjv898iPLF54VS8g&oe=69CBDDEA"}, {"file_name": "migrated_image.png", "id": "139433187474552", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410343_372469353086254_3448822755451994112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDVm8yx64BMQ7kNvwGDBWZP&_nc_oc=AdpHDlFnkj6nukhThT3xnGO4-8gyuZ7A085vtyPxYv2zFXAJ6HRTVWfDD142SkRe9fA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhThoya0Z95S2Rm5sbbckLzdrRkf7PHv11-TG-SzQQTg&oe=69CBB092"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daydream Blue", "keywords": ["relaxing", "casual", "multiplayer", "social", "funny"], "long_description": "There is a magical world where games, smiles, and a serene lake beckons.  A place where your robot pal lives.  Where items waiting to be crafted share warm afternoons with friends waiting to be found.  A place once out of reach - but now accessible from anywhere in the world through the dimension-piercing magic of virtual reality.  \n\n\nThis place is called Daydream Blue.\n\n\nThe lake is there, and a raft for you to lie upon.  Your campsite, too. A tent rests just aside the fire under a glowering starlit dusk.  Nearby, your favorite rock and stones perfect for skipping.  Trees high as the heavens.  This is where you can smile, where you can connect with all those other people across the world looking for a little relaxation and lot of fun.\n\n\nMultiplayer?  Yep.  Fishing?  Of course.  UFO invasions?  If you know where to look.  Daydream Blue explores a reality just outside ours. It\u2019s a feeling out there in the space between hassles.  It\u2019s your own place.  Your own dream.", "short_description": "Relax, play games, and build friendships, all inside the world of Daydream Blue."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ralphvr.github.io/", "developer_terms_of_service_url": "http://www.daydreamblue.com/", "publisher_name": "RalphVR", "support_website_url": null, "website_url": "http://www.daydreamblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "904546173562937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
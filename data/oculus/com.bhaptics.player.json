", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982726_467237374496699_5600897206481665559_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYO2hCDAGlAQ7kNvwFGhNq3&_nc_oc=AdrzK7m1ESeWB5maZ225kIXeauC8JPJfLtY67v3D93GVs11piNZbQhqUANQ9oz2BBmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc7YUYI2J8_6mn_1SwpafsjrEPrTSW02ap7Kb0DLFxdA&oe=6ACBBEE8"}, {"file_name": "05.Screenshot04-2560x1440px.png", "id": "314013226965418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031476_314013230298751_7849957315873123109_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llm81LteJmMQ7kNvwEMgGZi&_nc_oc=Adqh5W8CbCluxqiVTtvPGd18q1o-KmLGFm2wJ8XZ1t3YmTcdoOaD2vIRPUS62WEJeEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK0FLeq1JjUTFG75c4-KBkZKyniWJ0RU1Mny8bTR_OOA&oe=6ACBC27E"}, {"file_name": "05.Screenshot05-2560x1440px.png", "id": "275807634258881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984465_275807637592214_6306817039150739602_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpVaWlpbAlYQ7kNvwFcu5U6&_nc_oc=Ado-I0UA74MAZWVSI7fwFwpu6Ln2yL5G80V3n2oajvgbAFxqq8gy6-Cyyv5YXnL6NVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcTVLfG9ItUHTrwkNxlDc_6RGNVn2UgEo-nuGNKLALgw&oe=6ACBB96D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07.TrailerThumbnail-2560x1440px.png", "id": "5334467729957483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566677_5334467736624149_6454293066537641987_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCfnsq-3YhsQ7kNvwEoKw2a&_nc_oc=AdqK3rxMRgpy-uZlhqKWVQ4oADWgijr56LoK-dI7whFXtgFvrfrkET7TAW1p_T6mRN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvOHrljeOWOBe0I22sHP02EsTaMAf1DlnMdbw0SgG2Mw&oe=6ACBB54A"}, "display_name": "bHaptics Player", "keywords": [], "long_description": "bHaptics Player App is a device manager which allows users to connect bhaptics devices with Oculus Quest to play natively supported games. Pairing a device in the Player will register it on the device, allowing any games to automatically connect to the devices. Main functions of this application are as follows;\n\n1. Pair / Unpair: Users can Pair and unpair bHaptics' haptic devices. Once the haptic devices are paired with the app, it does not require any other pairing processes for Quest game which used the bHaptics SDK to provide haptic feedback.\n\n2. Real-time Streaming: Users can see the haptic mappings on bHaptics Player (PC version) realtime using this application. \n\n", "short_description": "bHaptics Player App is a device manager which allows users to connect bhaptics devices with Oculus Quest to play natively supported games. Pairing a device in the Player will register it on the device, allowing any games to automatically connect to the devices. "}]}, "developer_name": "bHaptics Inc", "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Player-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "513919543391118"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "680299338449020"}, {"status": "PUBLISHED", "id": "2188085558000604"}]}, "baseline_offer": {"id": "6802993
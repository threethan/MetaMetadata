", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982726_467237374496699_5600897206481665559_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3uJ_l2Au4gQ7kNvwGE7M3y&_nc_oc=AdqhB3tbPcN0D2YIZVHL2N07V0nhQSCjNw3vz8dk6uK1A39xwBuwzSsGggRc6cqUoLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiwxY3fXD2_kSnPy9S8bCfGiblSGnYhq3n1X2Y25WwIw&oe=6ABFA928"}, {"file_name": "05.Screenshot04-2560x1440px.png", "id": "314013226965418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031476_314013230298751_7849957315873123109_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IwaZjYpV8sQ7kNvwFLDKQ_&_nc_oc=AdpksOeRMwm2tKci45TRgHTYShf_EB7TkSZ7mXY_aaoI53QDVbcLHJGFRtK1r8rTdQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONtvLIzDhNAiilCzFDBrnK10I0_EKK14-ObVRKnoJOeQ&oe=6ABFACBE"}, {"file_name": "05.Screenshot05-2560x1440px.png", "id": "275807634258881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984465_275807637592214_6306817039150739602_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4WcSSz8pKoQ7kNvwEv_92Y&_nc_oc=AdrNVW7daskkSM0DTRfhVFATJ9Tu68BLFsd4D_AmzDNl7Q9Aicoun1zuAVT97rUDemA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ_Q9ddPcjtd04dqx7G_l1iDEz4uFXp-FEbcXUmX4gPg&oe=6ABFDBED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07.TrailerThumbnail-2560x1440px.png", "id": "5334467729957483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566677_5334467736624149_6454293066537641987_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDYWKBYg4gYQ7kNvwEspkFd&_nc_oc=AdpEJpSSJvn4EnpNa3bG0bsvjtWyfwJUsgPetGGd6z8B_4XUJhxDrFT4gdNfjCyyYmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnP5et-Nz7006D-bJK9XSfxGuj2OJgTLFOhx4CqFe68Q&oe=6ABFD7CA"}, "display_name": "bHaptics Player", "keywords": [], "long_description": "bHaptics Player App is a device manager which allows users to connect bhaptics devices with Oculus Quest to play natively supported games. Pairing a device in the Player will register it on the device, allowing any games to automatically connect to the devices. Main functions of this application are as follows;\n\n1. Pair / Unpair: Users can Pair and unpair bHaptics' haptic devices. Once the haptic devices are paired with the app, it does not require any other pairing processes for Quest game which used the bHaptics SDK to provide haptic feedback.\n\n2. Real-time Streaming: Users can see the haptic mappings on bHaptics Player (PC version) realtime using this application. \n\n", "short_description": "bHaptics Player App is a device manager which allows users to connect bhaptics devices with Oculus Quest to play natively supported games. Pairing a device in the Player will register it on the device, allowing any games to automatically connect to the devices. "}]}, "developer_name": "bHaptics Inc", "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Player-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "513919543391118"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "680299338449020"}, {"status": "PUBLISHED", "id": "2188085558000604"}]}, "baseline_offer": {"id": "6802993
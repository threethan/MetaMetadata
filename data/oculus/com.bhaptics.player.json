kNvwFdtiHJ&_nc_oc=AdkEjMaD31aiJvjzO1jTBA8yWCE9XZko2NEhRv7c2smo54raxPMJJKxBnj8dFpszH-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWIrXqQNUKq3VD74TKyV9GWdB4wcWqBHHmmJEcLXs8UQ&oe=69BFE9BE"}, {"file_name": "05.Screenshot05-2560x1440px.png", "id": "275807634258881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984465_275807637592214_6306817039150739602_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZU7pbjQRfUQ7kNvwEgG8ns&_nc_oc=AdnIfBxkrc3ivHpWGfVTZxbCf5ph8erqkLMaKg4ItlXcUoFNagad5AK5DK5s-kFBBJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkGjIVgftwbkB1Up2P80fLOM5k30Qu4PEOXX3vR9QckQ&oe=69BFE0AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07.TrailerThumbnail-2560x1440px.png", "id": "5334467729957483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566677_5334467736624149_6454293066537641987_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOprCyrsZsIQ7kNvwHCJxEb&_nc_oc=Adku7414cgVw4IhU7DQgaC1ktFW_Y7dsZSLIQ7ymYAkaGzRvhNr0fByHK_N4BbNFQxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwn-5RQdLS0q2QjPk2XbAJ6XOpSMtmsIu3aVDJJsPkrGw&oe=69BFDC8A"}, "display_name": "bHaptics Player", "keywords": [], "long_description": "bHaptics Player App is a device manager which allows users to connect bhaptics devices with Oculus Quest to play natively supported games. Pairing a device in the Player will register it on the device, allowing any games to automatically connect to the devices. Main functions of this application are as follows;\n\n1. Pair / Unpair: Users can Pair and unpair bHaptics' haptic devices. Once the haptic devices are paired with the app, it does not require any other pairing processes for Quest game which used the bHaptics SDK to provide haptic feedback.\n\n2. Real-time Streaming: Users can see the haptic mappings on bHaptics Player (PC version) realtime using this application. \n\n", "short_description": "bHaptics Player App is a device manager which allows 
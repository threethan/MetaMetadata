AA3F947"}, {"file_name": "Untitled-5.png", "id": "1563122734096448", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75230044_1563122737429781_4826929505904444582_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLefgWiWUxgQ7kNvwFfhO1A&_nc_oc=AdoUTIgcZVaa21cIumOVtoEJkUp_wt2ftIpLZv4Rsnf-F7NDsgFJqPoQyY6GBTYB1vg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo0qE35NW4YsFQpq_6Rr-qLYoW2dqNTjaOafo0CbWriw&oe=6AA415BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DMQ_Landscape2560x1440.png", "id": "1640105473176745", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031402_1640105476510078_9052484158633082271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmxD3VkNaM0Q7kNvwFhd1lh&_nc_oc=AdoOOj-I1H2dG5VvND0NceBssAtiKkbaW7TaSNcgK2GXa8a0g6ASoHYKiB6adgES_Dg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHI8TqOa8XGxLHaTAzOPDeiu4swISXtu67szFnjNmZOw&oe=6AA418ED"}, "display_name": "Dead Man's Quest", "keywords": ["Narrative", "Pirate", "Puzzle", "F2P"], "long_description": "Hey, you! Welcome to the island of Pequena! \ud83c\udfdd\ufe0f Dead Man's Quest is a narrative hand-tracking and puzzle short story and technical demonstration, lovingly wrapped in a light-hearted and quirky pirate theme \ud83c\udff4\u200d\u2620\ufe0f! \n\nWith its carefree, comical, and visually exaggerated style, Dead Man's Quest features colorful characters, a perky parrot \ud83e\udd9c and quippy narrated dialogue. With hand-tracking controls, you embody an... well, unusual character in a precarious situation as you wake up in a holding cell in the Fort. Did we mention you need to solve some puzzles to escape? \n\nDead Man's Quest is the result of the developers' exploration into hand-tracking technologies and their love for games such as \u201cMonkey Island\u201d and movies such as \u201cLife of Brian\u201d. The experience is not intended as a full game. We hope you enjoy it! \n\nNote that the experience is meant to be played in one go, no save system is currently in place. Controller support is optional as desired.\n\n\n*** Dead Man's Quest does not support Quest 1 headsets ***\n", "short_description": "Hey, you! Welcome to the island of Pequena! \ud83c\udfdd\ufe0f Dead Man's Quest is a narrative hand-tracking and puzzle short story and technical demonstration, lovingly wrapped in a light-hearted and quirky pirate theme \ud83c\udff4\u200d\u2620\ufe0f! "}]}, "developer_name": "Cortopia Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertinament", "support_website_url": null, "website_url": "http://www.cortopia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9595206203929404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75520119_604468731637879_4430936095071163122_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRMEKbmZWAUQ7kNvwE_7MW9&_nc_oc=AdpIm3TbSP_luj1HBgg42vYpVegjoQFPUr9pzm17RKdFGQEByx5ctyCj2cycdfrY_nk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSaTZWc0plYtMLuytCIG1VYPyM5KxH6iyrhKbrYWVUNA&oe=6AA402B7"}, "is_concept": false, "is_test": false, "is_trial_offer_
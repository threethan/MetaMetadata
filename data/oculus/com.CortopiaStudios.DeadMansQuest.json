d": "1563122734096448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230044_1563122737429781_4826929505904444582_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpGscUv6tmEQ7kNvwFwT4T8&_nc_oc=AdrvewIEcU5jESwQLNMTsl8GrHlTZsJCoy9OC5pg72k7tnESQqsG_TRlML8mkEXlQyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeC9LiwUJ-82j4YlGQEgPzddsmcrvdRDQdd1PZLipFag&oe=6A6E083F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DMQ_Landscape2560x1440.png", "id": "1640105473176745", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031402_1640105476510078_9052484158633082271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSs7ate9L8YQ7kNvwE94N_d&_nc_oc=AdpJcIPZ-I_z9jVMRAX5ahQwb8nuu2utipvF7ZrPakRESQduFlq0Wnkcs9u9x4o5yrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt1TD64KOLSLG4iUbvJnjwo-o0Y69lJ0pV7-iqZsEwWQ&oe=6A6DD32D"}, "display_name": "Dead Man's Quest", "keywords": [], "long_description": "Hey, you! Welcome to the island of Pequea! \ud83c\udfdd\ufe0f Dead Man's Quest is a narrative hand-tracking and puzzle short story and technical demonstration, lovingly wrapped in a light-hearted and quirky pirate theme \ud83c\udff4\u200d\u2620\ufe0f! \n\nWith its carefree, comical, and visually exaggerated style, Dead Man's Quest features colorful characters, a perky parrot \ud83e\udd9c and quippy narrated dialogue. With hand-tracking controls, you embody an... well, unusual character in a precarious situation as you wake up in a holding cell in the Fort. Did we mention you need to solve some puzzles to escape? \n\nDead Man's Quest is the result of the developers' exploration into hand-tracking technologies and their love for games such as \u201cMonkey Island\u201d and movies such as \u201cLife of Brian\u201d. The experience is not intended as a full game. We hope you enjoy it! \n\nNote that the experience is meant to be played in one go, no save system is currently in place. Controller support is optional as desired.\n\n\n*** Dead Man's Quest does not support Quest 1 headsets ***\n", "short_description": "Hey, you! Welcome to the island of Pequea! \ud83c\udfdd\ufe0f Dead Man's Quest is a narrative hand-tracking and puzzle short story and technical demonstration, lovingly wrapped in a light-hearted and quirky pirate theme \ud83c\udff4\u200d\u2620\ufe0f! "}]}, "developer_name": "Cortopia Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertinament", "support_website_url": null, "website_url": "http://www.cortopia.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613735987447536"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "207603778663606"}]}, "baseline_offer": {"id": "207603778663606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687477431, "status": "PUBLISHED", "id": "207603778663606"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6314530571997000", "version": "1.0.11"}, "id": "799156284898551", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appl
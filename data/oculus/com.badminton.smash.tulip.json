": "3.png", "id": "511317038559553", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_511317041892886_8059195430270283687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXdgOdU4y_kQ7kNvwFb2Vb0&_nc_oc=Adp4ofWt6gNUg3Qd_v3HcQm6m-iJhCGfSDd2oj3j15_goYTcLwEANbRK66hS5sJrUZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKol5SVMOKCFd8sNQ1VuDUzxi-ExxnqRbFj-OktZ3xxVA&oe=6AA2AE61"}, {"file_name": "7.png", "id": "1074916594294912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001708_1074916600961578_5581163018300583326_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMskuJdB8W0Q7kNvwEc217f&_nc_oc=Ado-tZfE39-u5RX2ghPC55aExUJwpsfhP6JFXnE1d1kuUQuG6Nx_zITRBdFkRQAjcv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIICizqlUfEQZEyUse9drIQt8uOYkuPY62JN7wOrL1SWw&oe=6AA2B052"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Badminton Smash - Sports Game", "keywords": ["Badminton", "SportsGame", "FitnessGame", "BodyFitness", "Exercise"], "long_description": "Welcome to Badminton Smash VR, the ultimate virtual badminton experience that puts you in the heart of the action! Whether you prefer the sleek ambiance of indoor courts or the refreshing vibe of outdoor settings, this game offers a stunning variety of environments designed to elevate your gameplay.\n\nChoose from an extensive selection of rackets, each with its unique feel and attributes, allowing you to tailor your game to your preferences. Engage in thrilling single-player challenges or compete against friends in multiplayer matches that will test your skills and strategy.\n\nMaster powerful smashes, precise drops, and lightning-fast rallies as you explore different courts\u2014from vibrant urban parks to serene indoor arenas. With realistic physics and responsive controls, Badminton Smash VR delivers an exhilarating experience that captures the essence of the sport.\n\nAre you ready to smash your way to victory? Grab your racket and step into the game today!", "short_description": "Experience the thrill of badminton like never before in Badminton Smash VR! Dive into immersive indoor and outdoor courts, where you can choose from a variety of rackets to customize your playstyle. Perfect your smashes and finesse your volleys in dynamic environments that challenge your skills and reflexes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8939532742765004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75630187_1280619696448294_5428893568350014404_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkP8p6eNzRgQ7kNvwG6-1mP&_nc_oc=AdoD-NedVMcKdTfVBXuXHI_1dVCybkjHG_K6-mf1Hxzqw-668y6w4LHppgLDj1Ep7p8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9W7KlI2mTme8fyf5WlQdh1p7ruboWXLuzucReI_MPLQ&oe=6AA2B7A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Badminton Smash - Sports Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
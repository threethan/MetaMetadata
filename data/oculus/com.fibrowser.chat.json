06_4034513356484527105_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vtHf4ZyjlAQ7kNvwF5xEmd&_nc_oc=AdrI7N6ZVvc5pO4IMGnenEZeFSdSTFDVbIRBjAD1V4E1TVHuoaqWaOze3I5OP5868Es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo37jbLeThfnS-uAwS6EKw7tkz6zbYKlpHS7_wDDJ5uw&oe=6AE48D36"}, {"file_name": "video.png", "id": "4613450785602187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_4613450792268853_641852619022054102_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dbsp6LWR5cQ7kNvwHxYDf3&_nc_oc=Adr6leQ-dCyW01bY4hdnXCsUIxxfHQqnusTPbxAq8B1cmlHLctZcZN0nbSxckgrq2rA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfbkAqDMxBS4S2gZhN5Ia8IwdAyRp2DpjTFsNa3czTlw&oe=6AE49099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FiGram for Telegram", "keywords": ["telegram", "messenger", "chat", "channels", "video"], "long_description": "FiGram for Telegram is an unofficial client for Telegram, made for a floating window in your headset. Sign in with the Telegram account you already have and read, write and watch without picking up your phone.\n\nFEATURES\n\u2022 Sign in with your phone number and the login code Telegram sends you. Scanning a QR code with the Telegram app on your phone works as an alternative.\n\u2022 Chat list with your folders, archive, pinned chats and unread counters.\n\u2022 Read and write messages. Reply, forward, and edit or delete your own messages.\n\u2022 Photo viewer for pictures shared in chats.\n\u2022 Video playback that starts while the file is still downloading, in a resizable floating panel.\n\u2022 Voice messages and audio files.\n\u2022 Stickers and GIFs. Animated stickers are shown as a static preview.\n\u2022 Channels and groups.\n\nIMPORTANT\n\u2022 Unofficial third-party client. Not affiliated with, endorsed or sponsored by Telegram FZ-LLC. Telegram is a trademark of its owner.\n\u2022 An existing Telegram account is required. New accounts can only be created in the official Telegram app on a phone.\n\u2022 The app talks directly to Telegram's servers. We run no servers of our own and never see your messages.\n\u2022 Not included in this version: sending photos or files, voice recording, calls and notifications.\n\nLarge public Telegram channels can include Telegram's own sponsored messages, served by Telegram to every client app; the app adds no advertising of its own.\n\nCompatible with Meta Quest 2, 3 and 3S.", "short_description": "Unofficial Telegram client: chats, channels, photos and streaming video in a resizable floating panel. Existing account required.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fibrowser.com/app-chat-privacy.html", "developer_terms_of_service_url": "https://fibrowser.com/app-chat-tou.html", "publisher_name": "Michael Stollenwerk", "support_website_url": null, "website_url": "https://fibrowser.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1117025034334738"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1843117926856995_6028389321068125387_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9MuwN5KU1oQ7kNvwHOFr50&_nc_oc=AdoA66wFmmGHwaLz-5ZgzapOhohQJKZCeX9-ip0QWLMKqOYj33Vs_smXG1OoJS5hJ3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtuj7pEc8lFmVu0LR
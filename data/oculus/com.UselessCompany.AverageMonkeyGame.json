gA-S7XxLDdAbCLajB58nJ51oh6IcSU5lb2vMFt5jRc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgtWaoovZ85xk5MS96A8hL8aBAXIkHnouHK--tQtULCQ&oe=6A4E3E9D"}, {"file_name": "download-compresskaru.com (10).png", "id": "1148153706354635", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031557_1148153709687968_1368719980759441579_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WynB0a06vUMQ7kNvwFSSD9K&_nc_oc=Adr8oIhjfF-nOOdDbXam66TwYYhvQERFMib0whCKcXygWpr2LVFjypd6xqCf5Pft6ps&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIRtVnIC1-TnduRRSLYNs9HOpYoJvWDNx13RlGXSw3lA&oe=6A4E63F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "download-compresskaru.com (17).png", "id": "932010394787194", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035382_932010401453860_7210810169706802136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwAPJRHDqhwQ7kNvwGmxar7&_nc_oc=AdrOx11g0IFSDECCzmQejl7H71V4Xk0dWWFDL3xrXQQhbc_8snl_7--lOWlgQ5kjDJY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD29__e9VPM3I8_6Ai0svauaMqLc8VlZ0TjgPQuoW9a8Q&oe=6A4E5195"}, "display_name": "Average Monkey Game", "keywords": [], "long_description": "Introducing Average Monkey Game, a captivating gaming venture brought to you by UselessCompany and under the ownership of Shrimps, officially launched on 2024/02/25. Immerse yourself in this dynamic fan-favorite, rapidly gaining popularity each passing day!\n\nEmbark on an extraordinary journey as you Become a Monkey! Average Monkey Game features a one-of-a-kind movement system driven by your hands, ensuring a uniquely engaging gameplay experience.\n\nExplore various entertaining game modes catered to your preferences. Engage in lively conversations with friends, traverse public rooms, and connect with new acquaintances \u2013 who knows, you might discover a lifelong companion!\n\nPersonalize your virtual identity with boundless options. Modify your color, revamp your username, and adorn yourself with cosmetics that resonate with your distinctive style.\n\nNavigate through the game with caution, as you must survive encounters with roaming entities. Dodge and weave, avoiding capture at all costs. Average Monkey Game offers an adrenaline-packed adventure where every move counts!", "short_description": "Average Monkey Game is a fun casual/horror game that you can talk to people and can even maybe make friends, this game is overall very good and fun."}]}, "developer_name": "UselessCompany", "developer_privacy_policy_url": "https://sites.google.com/view/averagemonkeygame/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Shrimps", "support_website_url": null, "website_url": "https://sites.google.com/view/averagemonkeygame", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7988984661116731"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036651_406626758615326_2524024568303502890_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2rSeohUS84Q7kNvwEPBDdu&_nc_oc=AdoCjklbfq6ygBTMVmK6o4_mlOdktsHGyc1LEgayWUgpK0_0PM70070_T4TTh2KFd7w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3xNa6Skg4J2sdWn6yocFOy4G0hFsX4n0G_ciHGj17kg&oe=6A4E66BD"}, "is_concept": false, "is_test": false, "is_tr
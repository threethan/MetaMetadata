PN6emk_aXfHfY6P81PA6akTJ6bVMUwH_-cQKaTSR9w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyQ2qBnRRnLTp9wMlb9H5LbeEZS0KwSAdeVuC5NVBrig&oe=6A88409D"}, {"file_name": "download-compresskaru.com (10).png", "id": "1148153706354635", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031557_1148153709687968_1368719980759441579_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGkhcSnTqywQ7kNvwF2T-0C&_nc_oc=Adq9JjdFtiMHwcGFNw6QVoJRjcC6kWa6LGXeiFl7OAXcB85GnBvC_Tp6QabME_ILgMY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFekuExwga0UacXfJnv6sOPdedcpx6FTkGZt7pYWzZi0Q&oe=6A882DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "download-compresskaru.com (17).png", "id": "932010394787194", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035382_932010401453860_7210810169706802136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJYoQuV6xm0Q7kNvwF7PLMr&_nc_oc=AdrgQEwIAQ4q7qRZZguNu1aCXhX7cIsWT24051hR6I2ZXv3Y0q1UPggv_5OFPi0OwRk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiSs1ac54SBWCx4k3vrG-UdWm7aPGBqJ3y8v_hjgpdSQ&oe=6A885395"}, "display_name": "Average Monkey Game", "keywords": [], "long_description": "Introducing Average Monkey Game, a captivating gaming venture brought to you by UselessCompany and under the ownership of Shrimps, officially launched on 2024/02/25. Immerse yourself in this dynamic fan-favorite, rapidly gaining popularity each passing day!\n\nEmbark on an extraordinary journey as you Become a Monkey! Average Monkey Game features a one-of-a-kind movement system driven by your hands, ensuring a uniquely engaging gameplay experience.\n\nExplore various entertaining game modes catered to your preferences. Engage in lively conversations with friends, traverse public rooms, and connect with new acquaintances \u2013 who knows, you might discover a lifelong companion!\n\nPersonalize your virtual identity with boundless options. Modify your color, revamp your username, and adorn yourself with cosmetics that resonate with your distinctive style.\n\nNavigate through the game with caution, as you must survive encounters with roaming entities. Dodge and weave, avoiding capture at all costs. Average Monkey Game offers an adrenaline-packed adventure where every move counts!", "short_description": "Average Monkey Game is a fun casual/horror game that you can talk to people and can even maybe make friends, this game is overall very good and fun."}]}, "developer_name": "UselessCompany", "developer_privacy_policy_url": "https://sites.google.com/view/averagemonkeygame/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Shrimps", "support_website_url": null, "website_url": "https://sites.google.com/view/averagemonkeygame", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7988984661116731"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036651_406626758615326_2524024568303502890_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnEZ5llclFAQ7kNvwF6ATiF&_nc_oc=AdqycZPNymyvq5FrT9xX0xu3F0_KwYWJ5A31PCI3xF-aguF-nbnHmhVqHsHH1wJj5mw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN1hZj_TSY9SmCGA3p34ZCn-fnnrq52HPAkbpduijTCA&oe=6A88307D"}, "is_concept": false, "is_test": false, "is_tr
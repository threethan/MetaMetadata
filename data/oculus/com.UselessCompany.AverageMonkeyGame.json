xJU41BBkcFEjbsA_8uLypimwGgesmwf17_o9rPh5Y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOb8wbhNEJuHNef-77k7raWFCqT0t-V8uXF0ZVidiD-g&oe=6AE764DD"}, {"file_name": "download-compresskaru.com (10).png", "id": "1148153706354635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031557_1148153709687968_1368719980759441579_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWcxqanfL3EQ7kNvwHLNS7H&_nc_oc=AdoJwmrNw34eG4yr3zpdmb5Vj-qN7EzQlszRSBY4BHf9J2qN5aHjQxoCzxnAxVEGjxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44sJAXNzkA1VfbSgA2d-beH7nnee8DACtgjyTp6leew&oe=6AE751F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "download-compresskaru.com (17).png", "id": "932010394787194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035382_932010401453860_7210810169706802136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQQqccwUY6EQ7kNvwEBsWeN&_nc_oc=AdrJgHfbfZ6-AaOVg4i4GvmdRxjSE26gt3mNpd_5yk-57s592GCddOFrios0ubi4XE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfg5HtCDNcvU92iu1ApHOq7TreFBhZ0HqMqJS0QzvV8g&oe=6AE73F95"}, "display_name": "Average Monkey Game", "keywords": [], "long_description": "Introducing Average Monkey Game, a captivating gaming venture brought to you by UselessCompany and under the ownership of Shrimps, officially launched on 2024/02/25. Immerse yourself in this dynamic fan-favorite, rapidly gaining popularity each passing day!\n\nEmbark on an extraordinary journey as you Become a Monkey! Average Monkey Game features a one-of-a-kind movement system driven by your hands, ensuring a uniquely engaging gameplay experience.\n\nExplore various entertaining game modes catered to your preferences. Engage in lively conversations with friends, traverse public rooms, and connect with new acquaintances \u2013 who knows, you might discover a lifelong companion!\n\nPersonalize your virtual identity with boundless options. Modify your color, revamp your username, and adorn yourself with cosmetics that resonate with your distinctive style.\n\nNavigate through the game with caution, as you must survive encounters with roaming entities. Dodge and weave, avoiding capture at all costs. Average Monkey Game offers an adrenaline-packed adventure where every move counts!", "short_description": "Average Monkey Game is a fun casual/horror game that you can talk to people and can even maybe make friends, this game is overall very good and fun."}]}, "developer_name": "UselessCompany", "developer_privacy_policy_url": "https://sites.google.com/view/averagemonkeygame/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Shrimps", "support_website_url": null, "website_url": "https://sites.google.com/view/averagemonkeygame", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7988984661116731"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036651_406626758615326_2524024568303502890_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntB6nyMlbiEQ7kNvwGDoSpF&_nc_oc=Adq0_9Rd4yPjwlb58bBF4k9Kb_ilfpFdrXwtVlnV6gnlfHqvUAdmhLK81H9vXzQhKwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8njz1mUSyOxwAal1h4R1NeQB3-SX3pUOoCzo92lEaIQ&oe=6AE754BD"}, "is_concept": false, "is_test": false, "is_tr
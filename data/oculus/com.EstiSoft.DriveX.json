nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM7Pf3GqkfQWbbye3x-cBcDta-Q8vQTO1c3MiOdxzBUA&oe=6A81967E"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-10 171008.png", "id": "837147435772270", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823259_837147439105603_6052938068308851275_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8tcGW_eMXMQ7kNvwG0S-Gv&_nc_oc=AdoLh-SowFpeeB4ZOHqHvJFk2-9JiQ2bLuvd6GNw_-Q01nyrosR0wkq9WTleFq8xZAI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgP9ut3p5DmuGsLsG5IbA1Q8IhusjOoc8rFeCl4BNWag&oe=6A819609"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-10 170941.png", "id": "1901722637368382", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822307_1901722640701715_7391790895149354048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcP2eUyDpy8Q7kNvwFapHBJ&_nc_oc=Ado0kThjxXFkYBFRv0EPTbD57iEIMLDXsCxyIYnx1-6qd8b5cOatknKnbYJSzdR13HI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvlBEfrZpSiAJPI28L-Pn6VO3YmhEfbj_zIA1oiM2S_g&oe=6A81C10B"}, "display_name": "DriveX", "keywords": ["CarRacing", "Arcade", "VRSports", "Drifting", "Driving"], "long_description": "Drive X: The Ultimate VR Arcade Racing Experience\n\nPrepare for an adrenaline-fueled ride through breathtaking landscapes. Drive X brings the excitement of arcade racing to your Meta Quest. Take control of a high-performance supercar and prove your skills on challenging tracks.\n\nKey Features:\n\nHigh-Speed Action: Push your car to the limit. Experience smooth and fast-paced gameplay optimized for VR.\n\nStunning Environments: Race through detailed mountain passes and scenic roads filled with dynamic falling leaves and atmospheric lighting.\n\nCompetitive Rivals: You are not alone on the track. Go head-to-head against intelligent AI drivers who will challenge your every move.\n\nTrack Your Success: Keep an eye on the live rank list and lap times. Can you beat the competition and finish 1st?\n\nMaster the Drift: Use your driving skills to navigate sharp corners and maintain your speed on the asphalt.\n\nWhether you are a casual player or a racing enthusiast, Drive X offers an immersive and fun driving experience. Start your engine and dominate the track today!", "short_description": "Step into the fast lane with Drive X! Experience high-speed arcade racing in VR like never before. Drift through scenic mountain roads covered in autumn leaves, compete against aggressive AI rivals, and fight for the top spot on the leaderboard. Master the curves, control your supercar, and feel the adrenaline. Ready, set, race!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9715304801907026"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2214153922703305"}, {"status": "PUBLISHED", "id": "1708643413883079"}, {"status": "PUBLISHED", "id": "851303330868435"}, {"status": "CANCELLED", "id": "1481025720407142"}, {"status": "PUBLISHED", "
.oculuscdn.com/v/t64.5771-25/491825415_1263683818952088_8961425840961652867_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah0RtyP0CWMQ7kNvwE9m_FE&_nc_oc=Adl5qfRnqTXhtrdfC3b8i_61GjjU8l6fXrgYz1KtUgdLcU64QIx9Q4DnUUujOkASjlw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs3eC4mKn4Sgr1Te46U0ptbpj-RVzS6Q3iLJLUf6UKr6A&oe=69A575A5"}, {"file_name": "ss3.png", "id": "779747015190625", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820496_779747018523958_1891827424910502207_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G30q-ij3zTcQ7kNvwGmIW1a&_nc_oc=Adlbkx0giiDPoTc1dNPgaX2DyLEF9ZOORAA49XRtFhWt1Hf103kEukdU4U_QMdjgZYk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvJTxkhDtcmZcqOZaWJg6-JUr74i9fDbLtYydlg40lGcw&oe=69A5776D"}, {"file_name": "ss4.png", "id": "1522591162180031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824741_1522591165513364_63392522205975281_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzqC3wNCwScQ7kNvwG-pwjl&_nc_oc=Adksk27Ge2WtBgVD8X_cT76YMNxssBQhk8ZXAekh4Pj1mPCc-nhvewLLthl2IWVrzcI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu4Kzv6XqmKxwTuSzWU48AIdxbAKQM0eo94MYtAvQcnLA&oe=69A57E08"}, {"file_name": "ss5.png", "id": "1408150960683877", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819281_1408150964017210_2086225247869091379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9Uh48R2q74Q7kNvwEtQ9Tm&_nc_oc=Admlr-ynR8QVHzLbGrSx8RsV9d4i7sYXIU2WbzASL4TjsjutJkDOdiIWFwyKyTTDwFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuAmwn0SaPohWLoflHscfsiLWQHHclkAld3pYoKdafL2A&oe=69A59749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "1512451429859570", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821674_1512451436526236_3245078182096381388_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qh6nOJANmxAQ7kNvwHMhIzW&_nc_oc=AdmodTTrTDBP9LSm9c8pb1RdQ_EqZHO0dpmGYgulOpBhTXhEKmMy2HPeajgWjQILiio&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvN3XSx3BG9ojsI7O5klHPWFgk1YKJqnBWpXb_-JmLTBQ&oe=69A588A3"}, "display_name": "DriveX", "keywords": ["Racing", "CarRacing", "Simulator", "Realistic", "RealisticCar"], "long_description": "Drive X: The Ultimate VR Arcade Racing Experience\n\nPrepare for an adrenaline-fueled ride through breathtaking landscapes. Drive X brings the excitement of arcade racing to your Meta Quest. Take control of a high-performance supercar and prove your skills on challenging tracks.\n\nKey Features:\n\nHigh-Speed Action: Push your car to the limit. Experience smooth and fast-paced gameplay optimized for VR.\n\nStunning Environments: Race through detailed mountain passes and scenic roads filled with dynamic falling leaves and atmospheric lighting.\n\nCompetitive Rivals: You are not alone on the track. Go head-to-head against intelligent AI drivers who will challenge your every move.\n\nTrack Your Success: Keep an eye on the live rank list and lap times. Can you beat the competition and finish 1st?\n\nMaster the Drift: Use your driving skills to navigate sharp corners and maintain your speed on the asphalt.\n\nWhether you are a casual player or a racing enthusiast, Drive X offers an immersive and fun driving experience. Start your engine and dominate the track today!", "short_description": "Step into the fast lane with Drive X! Experience high-speed arcade racing in VR like never before. Drift through scenic mountain roads covered in autumn leaves, compete against aggressive AI rivals, and fight for the top spot on the leaderboard. Master the curves, control your supercar, and feel the adrenaline. Ready, set, race!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_catego
vpZ1CMT5NziD1yQwJs4MclNOsM24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1lGpUfs3SHl9qgB2zUF2JzVcX59wbNUhPXTlTX7FO1A&oe=69BFDC08"}, {"file_name": "ss5.png", "id": "1408150960683877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1408150964017210_2086225247869091379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6kBLe-Il3AQ7kNvwEUDoVD&_nc_oc=AdnFByNkNYIAdZTOaD6z-lEGL7XYoeYu5b_rmJSXEqEWKZWjDu6-5mMQy3cxUm80qeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFGYpMZacxgth7brwqMJgoseEkZlG4OzPzshAIJQzp4w&oe=69BFF549"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "1512451429859570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821674_1512451436526236_3245078182096381388_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E97-8NQY9gQ7kNvwHYi_GT&_nc_oc=Adl2poP0XBS0bMKBEJ1eSSCMR3TMu5NcwwFOJpONesxSS4Hs7ULnInFaq32Tvjz17e4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBE1NyUEb85nnJIrTdPCmP7Qjhs0NWw5SFmbKgnkDFbw&oe=69BFE6A3"}, "display_name": "DriveX", "keywords": ["Racing", "CarRacing", "Simulator", "Realistic", "RealisticCar"], "long_description": "Drive X: The Ultimate VR Arcade Racing Experience\n\nPrepare for an adrenaline-fueled ride through breathtaking landscapes. Drive X brings the excitement of arcade racing to your Meta Quest. Take control of a high-performance supercar and prove your skills on challenging tracks.\n\nKey Features:\n\nHigh-Speed Action: Push your car to the limit. Experience smooth and fast-paced gameplay optimized for VR.\n\nStunning Environments: Race through detailed mountain passes and scenic roads filled with dynamic falling leaves and atmospheric lighting.\n\nCompetitive Rivals: You are not alone on the track. Go head-to-head against intelligent AI drivers who will challenge your every move.\n\nTrack Your Success: Keep an eye on the live rank list and lap times. Can you beat the competition and finish 1st?\n\nMaster the Drift: Use your driving skills to navigate sharp corners and maintain your speed on the asphalt.\n\nWhether you are a casual player or a racing enthusiast, Drive X offers an immersive and fun driving experience. Start your engine and dominate the track today!", "short_description": "Step into the fast lane with Drive X! Experience high-speed arcade racing in VR like never before. Drift through scenic mountain roads covered in autumn leaves, compete against aggressive AI rivals, and fight for the top spot on the leaderboard. Master the curves, control your supercar, and feel the adrenaline. Ready, set, race!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25068212856189638"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822817_596126566889568_1925785627073492906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIqVXBQ66DYQ7kNvwEjZ7LD&_nc_oc=AdkP7H8_qXFAxhHykWJCA1GBJKWrFflIPcMiNUjXHylaWRZbWJDPQqs8TEPEhWuTiXQ&_nc_zt=3&_nc_ht=sconte
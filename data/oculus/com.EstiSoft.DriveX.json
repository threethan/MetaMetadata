oe=6A2C28AD"}, {"file_name": "ss4.png", "id": "1522591162180031", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824741_1522591165513364_63392522205975281_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNbcCunL26cQ7kNvwEivEgR&_nc_oc=AdpN2__LTFQXURzxHsA6d3IHIoBFbujLVZ6ZORvC2ryQJJW18z3OaMRznm5LS9Wpud0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-McpcVEAyLOAJauph2FCxb7933XXKj6S7g4Hi7qv00SA&oe=6A2C2F48"}, {"file_name": "ss5.png", "id": "1408150960683877", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819281_1408150964017210_2086225247869091379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO3gQVbAEUMQ7kNvwEQJKwQ&_nc_oc=Adp1TGvGm-h-F69JcJ5PXNQogkA0a_Fk9MxyFWfFTwvhUFLhyRiJAuxWRUpS_USSihk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wLyqkd_gj_dHHvShQLAwuB8_MIgPcX_saLyVVMPYgTw&oe=6A2C1049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "1512451429859570", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821674_1512451436526236_3245078182096381388_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcuMEPxJ-7cQ7kNvwGegvlb&_nc_oc=AdrhaBkOw_ujXgkAYJT1EMtWVRxmpIkSQRW93IUcyf_rmbiUJn5vojKwttwIM5OyZmE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ro357pFcyNEXlaCvGAHhg5zKU8N3lok0KqIBrLccs-Q&oe=6A2C01A3"}, "display_name": "DriveX", "keywords": ["Racing", "CarRacing", "Simulator", "Realistic", "RealisticCar"], "long_description": "Drive X: The Ultimate VR Arcade Racing Experience\n\nPrepare for an adrenaline-fueled ride through breathtaking landscapes. Drive X brings the excitement of arcade racing to your Meta Quest. Take control of a high-performance supercar and prove your skills on challenging tracks.\n\nKey Features:\n\nHigh-Speed Action: Push your car to the limit. Experience smooth and fast-paced gameplay optimized for VR.\n\nStunning Environments: Race through detailed mountain passes and scenic roads filled with dynamic falling leaves and atmospheric lighting.\n\nCompetitive Rivals: You are not alone on the track. Go head-to-head against intelligent AI drivers who will challenge your every move.\n\nTrack Your Success: Keep an eye on the live rank list and lap times. Can you beat the competition and finish 1st?\n\nMaster the Drift: Use your driving skills to navigate sharp corners and maintain your speed on the asphalt.\n\nWhether you are a casual player or a racing enthusiast, Drive X offers an immersive and fun driving experience. Start your engine and dominate the track today!", "short_description": "Step into the fast lane with Drive X! Experience high-speed arcade racing in VR like never before. Drift through scenic mountain roads covered in autumn leaves, compete against aggressive AI rivals, and fight for the top spot on the leaderboard. Master the curves, control your supercar, and feel the adrenaline. Ready, set, race!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25068212856189638"}, "review_messages": []}]}, "cover_square_imag
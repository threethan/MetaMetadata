urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VkG273tx8EQ7kNvwHtTcyC&_nc_oc=AdpkgVMWU1QpboG2n9jUAu1iycz4exCk8jeKhdwwieTnjDU2NMdddRmP_1vZY5V350w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv4Bjff9PCe5LexIeonlF-lre3gjDRJD0QWHl02QMSYA&oe=6B05B02D"}, {"file_name": "ss4.png", "id": "1522591162180031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1522591165513364_63392522205975281_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2RJdOj_IXMQ7kNvwGwFR64&_nc_oc=Adqwp6QGzzaPkRzkMPgCZklnqcaEvpfqrp4KZ6XRWvkm-vPKddcX-unx1kwsiFj1fo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSXVjOJ-hn9t9Z6l0hUB3R2x1Enq9u5CEZw-YWsHswLA&oe=6B05B6C8"}, {"file_name": "ss5.png", "id": "1408150960683877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1408150964017210_2086225247869091379_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNzVFk4VBiIQ7kNvwFz50vn&_nc_oc=AdrGoXP_lJyVsPLVmVxzwLJioKy6b7k0KY73XcUrs8EfbtJ05sFKGLWCQ_Pn0H_7mK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKVFWOhaFU5_Tb-vWSW3qh2aafJvX3APgHy-DTuyGrMA&oe=6B05D009"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "1512451429859570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821674_1512451436526236_3245078182096381388_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmnzxKAG1XgQ7kNvwG33IRk&_nc_oc=AdoXBwbKsIbYZB7Kpwp0pdP5OBowAVR626RvBDyLZO0S7AGGFk7ihei0YcFqaX8IcHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTwqeCAOLKH4wRzkQG03pCxRO5SMu56ksvzKNZ2_QWzg&oe=6B05C163"}, "display_name": "DriveX", "keywords": ["Racing", "CarRacing", "Simulator", "Realistic", "RealisticCar"], "long_description": "Drive X: The Ultimate VR Arcade Racing Experience\n\nPrepare for an adrenaline-fueled ride through breathtaking landscapes. Drive X brings the excitement of arcade racing to your Meta Quest. Take control of a high-performance supercar and prove your skills on challenging tracks.\n\nKey Features:\n\nHigh-Speed Action: Push your car to the limit. Experience smooth and fast-paced gameplay optimized for VR.\n\nStunning Environments: Race through detailed mountain passes and scenic roads filled with dynamic falling leaves and atmospheric lighting.\n\nCompetitive Rivals: You are not alone on the track. Go head-to-head against intelligent AI drivers who will challenge your every move.\n\nTrack Your Success: Keep an eye on the live rank list and lap times. Can you beat the competition and finish 1st?\n\nMaster the Drift: Use your driving skills to navigate sharp corners and maintain your speed on the asphalt.\n\nWhether you are a casual player or a racing enthusiast, Drive X offers an immersive and fun driving experience. Start your engine and dominate the track today!", "short_description": "Step into the fast lane with Drive X! Experience high-speed arcade racing in VR like never before. Drift through scenic mountain roads covered in autumn leaves, compete against aggressive AI rivals, and fight for the top spot on the leaderboard. Master the curves, control your supercar, and feel the adrenaline. Ready, set, race!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=divotbTarDEQ7kNvwE7TfHh&_nc_oc=AdoWM3PzpaKzBI6W-EefBoU0MAlVK-OvuMAvn33qDmX2b-WP1-dmO0uDBEpSYmBX-NI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DPgqOrmYqb6DCvGp1868mp6XPQ3ZeffG0G4zx3fIokA&oe=69FDDF8E"}, {"file_name": "Kidney.png", "id": "498568506683709", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822467_498568510017042_3258570424510693208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsTpJjKMGwAQ7kNvwGT8ZFJ&_nc_oc=AdpDjTATdZhBWmDyHNS6W1odMSTJ7UJzYa5YfKbPs-F66QQqIpD6WZh7O4hwXenUfI0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vHug7FNQhqiRcWkverMBeaI_lLA7UEX3jqPqH6VKcGg&oe=69FDFBBD"}, {"file_name": "Planet.png", "id": "728560263330551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822818_728560266663884_1722430561971528261_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPPKKLSFVsUQ7kNvwHfyS9c&_nc_oc=AdrcsVSiYng6jSfpNvm7GGLTA-iQYXWiX5rEU_m4oN1YUf_pEhAMymxIEe6g_Z5Xm6Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wnyVj9Zx1_vNGXQyIgLon4q3X2BCjN5PcqUppNxVy6g&oe=69FDF7F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Myracle AI", "keywords": ["ai", "Science", "Education", "Learning", "VR"], "long_description": "Myracle AI: Redefining Science Education Through VR and AI\n Myracle AI is an advanced learning platform that brings science to life through immersive virtual reality and real-time AI guidance. Students can explore core topics in physics, chemistry, and biology through interactive experiments\u2014all within a safe and engaging VR environment. The platform helps learners visualize complex concepts, manipulate virtual elements, and build deeper understanding without needing traditional lab setups.\nBuilt for Classrooms Without Labs, Designed for the Future of Learning\n Myracle AI is ideal for schools that lack access to physical science infrastructure and for educators seeking engaging, future-ready teaching tools. By using only a VR headset, learners gain access to a rich set of interactive simulations and guided experiences that adapt to their pace and understanding. Already adopted by a wide range of institutions, Myracle AI is helping shape the next generation of confident, curious, and capable STEM learners through the power of immersive education.This platform uses a third-party language model to provide real-time guidance, with all data handled securely and in compliance with Meta\u2019s Developer Data Use Policy.", "short_description": "Explore Science Like Never Before with Myracle AI in VR\n MyracleAI transforms science education through immersive virtual reality experiences powered by conversational AI. It enables hands-on learning in physics, chemistry, and biology without the need for physical labs. With curriculum-aligned simulations and intelligent guidance, Myracle AI helps learners deeply understand scientific concepts in a fully interactive, engaging environment.Powered by a trusted"}]}, "developer_name": "Cerebranium Tech Private Limited", "developer_privacy_policy_url": "https://github.com/Cerebranium/MyracleAIPrivacyPolicy/blob/1ebc73d060d11289ce251a17698253e459b0b1cc/PRIVACY%20POLICY%20FOR%20MYRACLE.txt", "developer_terms_of_service_url": null, "publisher_name": "Cerebranium Tech Private Limited", "support_website_url": null, "website_url": "https://www.myracle.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "T
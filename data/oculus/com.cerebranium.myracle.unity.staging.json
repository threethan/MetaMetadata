5096672671", "locale": "en_US", "screenshots": [{"file_name": "image 1 f.png", "id": "1542170053519964", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618293_1542170056853297_1650808185921066144_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1vbx_kCFfEQ7kNvwHMzCdn&_nc_oc=Adq7htSxOX7w5w7JMAy5f1MXB3MApQ9L4xO9yc8JHy6lPblsD7noFNsxuZ1B-f_B3W8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sct8_6Eg381HYn49Qx5AsgxFnONzjXDbBTJ5BhBI-cQ&oe=69FDE165"}, {"file_name": "image 3 f.png", "id": "3426063657593897", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618069_3426063660927230_5536730006779404551_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktlk2Xzg810Q7kNvwFOjq15&_nc_oc=Adq5xZRr7vguxkhiEATocECl_nWW3FgJczW9f32ReEOEir6YCZe8xVbbnWXly5jwowk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kPhwAd4rVOcsUZV-vheN2L6_tizbqm6LYrPMgDMtKlQ&oe=69FDEB73"}, {"file_name": "image 4 f.png", "id": "1721401888837878", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307309_1721401892171211_5318540574929538390_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF6BPGCIqu4Q7kNvwFcOFo-&_nc_oc=AdpOsPQJ-HNr0UYbcAaKt2Xxp6Wxeh3OXeP8fnCYk8j3tW9kJlpYlHUEQ5xlTlrFNsg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TaYQpBpMaIRG51ISTAXaWVRipdPJfoxYbFN2uUfyXWA&oe=69FDEE45"}, {"file_name": "image 5 f.png", "id": "2101124734068102", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618252_2101124737401435_5468262433488340371_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Dxxm5-Es9oQ7kNvwHLFgnc&_nc_oc=AdqSPbJGJbxEDFPXSu-8Rlnhy3KcLrWQxnNAluKJvLrGwUtTpHHa6H9HsGu--hYNvPQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZjAwvy6qT3oPfOXf_xsah10v2YwlcPCiWVTWNAJZGUw&oe=69FDF44C"}, {"file_name": "image2f.png", "id": "926781523263021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618440_926781526596354_6086509386658285580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjo6yeoNec0Q7kNvwFr3nBj&_nc_oc=AdoPVjoSuwjfdnbcPWPhKe9PrJPxGBqFkdU4RfZsgqjUJJkjZbLUrii-2-nVc8sp8Zs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LkglUZ_3NRPvE0E4UZIm6m1GaKU-t9WPLpdZjJ2wEfw&oe=69FDE03E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Myracle AI", "keywords": ["ai", "Science", "Education", "Learning", "VR"], "long_description": "# Myracle AI: The Future of Science Is Here\n\nScience was never meant to stay on paper. With Myracle AI, learning transforms into a fully immersive VR experience where you step inside concepts instead of memorizing them.\n\nExplore **human anatomy** in dynamic 3D and see how systems function together in real time. Enter the **microscopic world** beyond the limits of the naked eye. Perform interactive **chemistry experiments** in a safe virtual lab. Watch **physics laws** like motion, gravity, and energy unfold around you.\n\nEvery concept becomes interactive. Every lesson becomes visual. Every discovery becomes unforgettable.\n\n## Powered by Intelligent AI\n\nEngage with a built-in conversational AI tutor designed to elevate your understanding.\n\n- Ask questions naturally  \n- Receive instant, accurate explanations  \n- Get real-time guidance during exploration  \n- Discover deeper insights tailored to you  \n\nThis platform uses a third-party language model to provide real-time guidance, with all data handled securely and in compliance with Meta\u2019s Developer Data Use Policy.\n\nPut on your headset and step into a smarter universe of immersive science learning.", "short_description": "Step Beyond Textbooks. Step Into Science with Myracle AI. Experience immersive VR learning where you explore human anatomy, dive into the microscopic world, experiment with chemistry, and see physics laws unfold in real time. Every concept becomes interactive and unforgettable. Ask your personal AI tutor questions anytime and receive instant, accurate guidance tailored to you. Learn smarter. Experience science like never before."}]}, "developer_name": "Cerebranium Tech Private Limited", "developer_privacy_policy_url": "https://github.com/Cerebranium/MyracleAIPrivacyPolicy/blob/1ebc73d060d11289ce251a17698253e459b0b1cc/PRIVACY%20POLICY%20FOR%20MYRACLE.txt", "developer_terms_of_service_url": null, "publisher_name": "Cerebranium Tech Private Limited", "support_website_url": null, "website_url": "https://www.myracle.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33986509780996007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619704_2020937068437527_8274258711004944735_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGW0_GUtbOQQ7kNvwFeo00y&_nc_oc=AdoOO4huT_ZZ8U3l3hXxoQJ2ZXrh2kT_KzVQICKBB9xQyk-Jm6tY0JMw2uIvo0TQbd0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77j-p6BxET4STZbFKGObFnDXOam9C5r-hujAwKQh0zzA&oe=69FDD4B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Myracle AI", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "relea
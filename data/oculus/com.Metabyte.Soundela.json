nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvMkzY-Hm3YQ7kNvwGCZItn&_nc_oc=AdpZANePoUjInD2lOFGmZhl7gfQLL6qNEQMgOg9wFlRumL-a73u5RzjVAPkT-GMi2iE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1ynjf9jbrdOLoiPu2QsJNvTX9U7GLrHjabd5isLTzSA&oe=6AF48E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub1WCJVWQlAQ7kNvwGdM-Rn&_nc_oc=AdoqA9VjqZU9mrhENBKPIT7YneZ83I03S8YNiDR5hL5-oULHYJc5x_IZ4Fq5cv-Si4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs_cs3RCBb7BMe8vdAQbADR3D0eDFtfNLYm3iNoaCjkQ&oe=6AF48D77"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.
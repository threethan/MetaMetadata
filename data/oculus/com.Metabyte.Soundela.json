nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGGD6kwqRvsQ7kNvwElMVou&_nc_oc=AdoTsxQD-DWqfG3YNePquzg7yxJGnfJJe-IRsQnpqbJ9_kDZYuvmppK-PNYD63SSXIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP9QWsBVqXiIOEAAddI5xATGZu93excadatGSKhqSsqg&oe=6AC1241D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjJjHlwk2vkQ7kNvwFpDsTv&_nc_oc=Ador9APk02EUGn2sITx1DIEmVO225k7WaQoaLw_ITBePiBO9EvQgDCut4K6kCPL2vzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR-ve7qv0pcyvIzdrAvCFrA3X63-izkugq49dm7Rw2iw&oe=6AC122F7"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.
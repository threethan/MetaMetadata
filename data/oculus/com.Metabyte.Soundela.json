8_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oac7gwD3-rsQ7kNvwEdyMbG&_nc_oc=AdpM0PhD3mVpP7shsr-M6-RVZjOGZ4ThDh6fMEIp5HFk6wDbGGKNCtJFwtbIBDbv-Mc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGOiQlUZ9R3AS0lcvvdz-Jx1qOST4YLC7hFZ-CJ7BYOQ&oe=6A4BC0B7"}, {"file_name": "Unbenannt_Frame_0_02_1105.png", "id": "360448189747960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_360448193081293_8971944314535998179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1Red3URh0cQ7kNvwF5h_EO&_nc_oc=AdqrZjS8yxJuy6je0na_EeyEWW9obp-R32czaw3IjQB50wEzkhLA3b5zLYE5S1igMBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXsRWlX04_ukc_gLENSSq6R2ZtqeJPtBubSvm5UNPTFA&oe=6A4BB65E"}, {"file_name": "Unbenannt_Frame_0_05_2706.png", "id": "974131283654126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974777_974131286987459_2556363952917919133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4Ytlvpc9kAQ7kNvwELckSB&_nc_oc=Adp001SjfcoAxYHiNGz3SMKyHHwVib6Y1SDxgtXfp4nF41rBSvOoQpiNpku_9ac1aWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj272-UjfzdEDCPsMnX1mJNar4hwvgpabcUcg5KhYxPg&oe=6A4BAE5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpoUbJchx34Q7kNvwEl7Dvv&_nc_oc=Adqjim5IwlPgWrij05j21HRe9JAWSu_-IwsURBG_ZTpszTPQ5g50GzLpRkupGZZaIdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJy1-XZEO9FoFpM_IU-lQKo-W8G-shesKkDd87O0Bojg&oe=6A4BCD77"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.io/", "website_url": "https://soundela.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6405700956200903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572927_895658305280662_3267477016050408601_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7
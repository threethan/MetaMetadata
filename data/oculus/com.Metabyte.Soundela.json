8_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiWVDLA5X80Q7kNvwEkByXw&_nc_oc=Adp41f25EGYSZhX0NG9V9rsYDohmt254R1BP6_28sMqfCZ4Vaj4Hy7EFC2wHrrEu1tY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YzsfY1jJoNKBSMog8VkjmNNem6GODTK722F1kfj797A&oe=6A43D7B7"}, {"file_name": "Unbenannt_Frame_0_02_1105.png", "id": "360448189747960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_360448193081293_8971944314535998179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFDm3_eRPNoQ7kNvwF1K1p5&_nc_oc=AdomI8S885vVGZUEqKg6D-OTek4AhaJdVDxLdP2n_pM64qXrysC12xoIGVKqH1SOKmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qKOicO-UEJx8-_2dG2Vt7j2WdZEj5olN6bT_WQP6M4g&oe=6A43CD5E"}, {"file_name": "Unbenannt_Frame_0_05_2706.png", "id": "974131283654126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974777_974131286987459_2556363952917919133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crkD1X1KPv4Q7kNvwEk1hYP&_nc_oc=AdrERdBvKYuVpwnfBaKSVWKS9B-7q68PPT9YVessXQBc-ovpFN7M7Z7g5wHsbrkKlus&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N6xH9CYeB8wBjuQxkA7yr6yKKMWIBByAlO81x53c44g&oe=6A43C55A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRNX33EpHrQQ7kNvwH5ST_m&_nc_oc=AdobMFvs-bS_3AO_qPc0Pm78PdKHhhWvl6LTemZo8R-kEbOYWhbx98RNeJ_mYsRDE7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UCUyn0ONp96iuu81cdesIgnXZKuvcY-G0aEoSyM3sjA&oe=6A43E477"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.io/", "website_url": "https://soundela.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6405700956200903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572927_895658305280662_3267477016050408601_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7
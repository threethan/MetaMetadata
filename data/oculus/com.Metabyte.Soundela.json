8_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2tkkm9oc-sQ7kNvwFAyX_U&_nc_oc=Adqwuby37cces6UJZJdP371sPYSuT11qw4eJYXngEsZ0ZlzbUa0C47ohrP17i0usv0g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC3ZdPdeRffRyz5p4KdN06eWdgL1OgDwwobGdlVgpUHQ&oe=6AAD4FB7"}, {"file_name": "Unbenannt_Frame_0_02_1105.png", "id": "360448189747960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982552_360448193081293_8971944314535998179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdb8Pdu0xdgQ7kNvwHgBJfX&_nc_oc=AdoG25kKqrKWx_7wtBeSJasSODWV8ACOHEzMpCY9G8ufD2NOnMxFLE4-KTrLH1a-bLY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFc6FQafO4heJPndUcPM2Zxu6xUXBO32Zfy0JZhJkPbw&oe=6AAD455E"}, {"file_name": "Unbenannt_Frame_0_05_2706.png", "id": "974131283654126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974777_974131286987459_2556363952917919133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edX73bAsFF4Q7kNvwHL4Pd_&_nc_oc=AdpFlVrKteXCtdCaZjxKbvuobu-qK7DGg7wyqbrx-XyoDBFBsqnZgHDKZqnTQAkVuHg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5WloHyfDLurA63GEdwmIWWsJb3yeInA1VN5aeYtj6Xg&oe=6AAD3D5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxVNhCMp0fYQ7kNvwEhB9j_&_nc_oc=AdqPoC9dG1HtGseE8YlCt-10T7VzAXkog6v04z7O6VGDJ-oMYXrDelRWMnxwr8hH5gc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkk-HHzKfqZnWQktpE8ML_PAKSc7f3RjciJtCYClLWgw&oe=6AAD5C77"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.io/", "website_url": "https://soundela.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6405700956200903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572927_895658305280662_3267477016050408601_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7
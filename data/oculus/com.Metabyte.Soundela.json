8_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLS6qDQTNZgQ7kNvwE8fjUG&_nc_oc=AdrITt-lnhKLFtOa-TAsoH4bsSuQRIDSsQ6T6JXRH0P5G_rmyOo5ptx7LWLfYnFkUmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R4sx5sEHTPpjCqO8iE_X4eVqFRUNoOtNk6kgX5HzMeQ&oe=6A009B37"}, {"file_name": "Unbenannt_Frame_0_02_1105.png", "id": "360448189747960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_360448193081293_8971944314535998179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWOJnfpKbJ8Q7kNvwFyCuRQ&_nc_oc=AdqyVd6eDFLZgnjpEE1yBAkKWGSUEfBFdI1tfFpqisgWjJhnjoKJ3MHH3SDiJ8NDsrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y3ktfnpqFsYmaltP-OptKY4ImJ3D9TrYhLZOMRwR_kw&oe=6A0090DE"}, {"file_name": "Unbenannt_Frame_0_05_2706.png", "id": "974131283654126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974777_974131286987459_2556363952917919133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gc_HuPZS-N0Q7kNvwGz9NQx&_nc_oc=Adqr6MfRZsbylvVXG6sn-nPjcsXXJCoFdcnXG67bjt595bJl_zfY9kLXl99SX7LWMvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SHWtjExPHZFij94O3C7GUG2wzPWouTUVOdIMbhxbVjA&oe=6A0088DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpjQHqan3LkQ7kNvwEgD2LI&_nc_oc=AdodSIT2MrXoQGHZOdiveBtBT8lLIguLLKTBT0u0EokzSSU8k6x0mm0j3WptSjXCn0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6033GuNe22ylkAA14GLEWlpm4vy4tA3TtV4cuFZEnFDQ&oe=6A00A7F7"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.io/", "website_url": "https://soundela.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6405700956200903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572927_895658305280662_3267477016050408601_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7
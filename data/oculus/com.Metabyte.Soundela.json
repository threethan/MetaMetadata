nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_olALdDR3ScQ7kNvwHlOqle&_nc_oc=Adqk2fD8_7iCeriHzMMC9Z4peIanlursMpiVwN9NpvSowZ57Z-BDugJmZvJlazYaY9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm9mtdG2oifPlXLx-e0tz1RsYfdZ3QeseqhzowMwEooA&oe=6ACD019D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moV_VhtGWnAQ7kNvwHysvt3&_nc_oc=AdqyoL9VzjZ5h2mOEBPDqNdG7LMbWHDwItO8l3SV_u6Ad2tzMxH7r_LhnZMu8EqOv4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvyJlYQavd2It22yvDFl6fMRdVMjtr0Kzjfu3HPPKFxQ&oe=6ACD0077"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.
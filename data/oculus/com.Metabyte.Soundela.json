33_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk8hyBAZTy0Q7kNvwHPXxYv&_nc_oc=AdrfF0Qm-LR8RYhL6wqRhnlwUvolw_HzrNEIG6M7R4qpNUbQuTeUq9Oior1g5FwDjas&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlGaLuAAPh4cJwPKOGH7CZIkxfl8oWNdn_hKbCzeH-rA&oe=6ACCE5AD"}, {"file_name": "Bild_3.png", "id": "1803801987284993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1803801990618326_4504542907661097088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4nH6_1KOi8Q7kNvwH2Udf6&_nc_oc=AdoQdirkjMi154sp3XAmyr7H6g7cNlHSo233OV-N_vhRBB0pbRdiy8_FyIMemoAuIMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOniD0obOq6GmJjcDEKUL4RC-qcyStkQ6VCXzd4vgkQaA&oe=6ACCEC88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moV_VhtGWnAQ7kNvwHysvt3&_nc_oc=AdqyoL9VzjZ5h2mOEBPDqNdG7LMbWHDwItO8l3SV_u6Ad2tzMxH7r_LhnZMu8EqOv4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvyJlYQavd2It22yvDFl6fMRdVMjtr0Kzjfu3HPPKFxQ&oe=6ACD0077"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.com/", "website_url": "https://soundela.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27800698409607848"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_1578783627075344_3873034322739634987_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnrTdTEiab8Q7kNvwHrE2Ba&_nc_oc=AdrMlzas_3vIaAiffcOx6LkJ1oMqU5Rih-LqoIX7AybV_9HtDFbtD-4Mp--v49rb79g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSCBX-9i-KGJ6EIqg9sS9xhbGB7So5qNp2nxrnfBS1Kg&oe=6ACCEFA4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soundela", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"t
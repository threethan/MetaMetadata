nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbS8joMV4gQQ7kNvwEFjW1O&_nc_oc=AdoFi_-T5jTlLiclhDuf72Fma9cEZgsmcNuRgwthybfCSjNiFma_5qNJpt_z9TbooPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZCrFBJSexzABeNCT5-0NZbjydGZsvzfJHmqlAdgWvpQ&oe=6AF8831D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqgE6S8FO_oQ7kNvwHEuUPd&_nc_oc=Adpq_3ikTW-QEAyiB9rBcSncGqhvrOB1wPPlEXPVPpOTSJ3QYh3tpzC92jauiQG4c2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6ShYC-yZRNEwM4Im5Cl-gcQbhJ8witErL8B8OaMllIA&oe=6AF881F7"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.
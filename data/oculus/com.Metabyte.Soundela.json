59_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAMukbpOi_8Q7kNvwEv4Y6S&_nc_oc=AdpLDZGM8xkmR3R3kCIMRwmybetN4G-oq6Q8JFml5bPVrHS5AffCfejmYyZo4pppQB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9yk-L107NxK147L4F1CgfcUFock8zWv4OLm4rfIEydw&oe=6A60CCBA"}, {"file_name": "5_Pictures 2560 x 1440.png", "id": "1515005466021784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1515005499355114_4285525449600174080_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvPVIDRfblYQ7kNvwFROcqq&_nc_oc=AdqJAOFXjRsn-ArISK7UNlsCQgFSYE7uHrsqXtZV3yns-EP_UQLBlgH7829MFZrTE8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWTwcQsY-zBM3ef9Kn6glgO1W1veYPS8jY1U4h2PaWzg&oe=6A60AE5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfY6kjfF2w8Q7kNvwEzww79&_nc_oc=AdoZXEOYRiVwvLLp8DcXOe5LtXkpVfVcfvXd7_jPMdD_004ag6YaxadqgsaMsdkPWMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTmIaG4DTfJSlN5MrJRtd7v6gAXQmK1rZcEYCNzn5DIQ&oe=6A60AD37"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.io/", "website_url": "https://soundela.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6204385602999107"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "356821466678935"}]}, "baseline_offer": {"id": "356821466678935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1696951779, "status": "PUBLISHED", "id": "356821466678935"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7182954551808869", "version": "0.28"}, "id": "1318614042337571", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appli
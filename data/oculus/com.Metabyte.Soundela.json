ss=7f20f&oh=00_AQRFgjG1iVj7UGkfQNCis85wD9gm-oAR4juAvvwyVd6lJg&oe=6AFDB2A6"}, {"file_name": "Bild_2.png", "id": "1067869372894372", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1067869376227705_560414091099221833_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXdaexsTQeUQ7kNvwG9Wfk1&_nc_oc=AdrGsqdOiBkWcU7yzx_PsA0P0gtx-k4bW_FEaRbOvWzJRmNzSupw9tGLxpOM-MJfyPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-1WdLdvKP6VpCBLxWQqTDXvOB6GxmAVRm8uEbk6-fkw&oe=6AFDAD2D"}, {"file_name": "Bild_3.png", "id": "1803801987284993", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1803801990618326_4504542907661097088_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoTAU2IhWMQQ7kNvwH1GTyc&_nc_oc=AdpJl0LpO94_zieol4ZfuIrgLJl_BLoNqepsU5TLsD0miTiTgS3bdM58eCv0g8F6zaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSkpXqE9L0w_LY18YjLS_Kpk3DyobGhCuhjhnpFrLTLg&oe=6AFDB408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g20qZ3ilegQ7kNvwGAdiB8&_nc_oc=AdrI6QvgiwP9WnTRzxBjjj7vMYtJQQS3AK4wr0zwy7KyeyDRItPT-Cr1RCFnsVOsvdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUV0fzwf2IQPec_LSXIEu18urBflVNPKK6avvV8TlW3w&oe=6AFDC7F7"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.com/", "website_url": "https://soundela.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27800698409607848"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_1578783627075344_3873034322739634987_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKyMp-4PD28Q7kNvwGXMzJ-&_nc_oc=AdoBB85teqbdLHw8FituDbolhFHuwgjivxo7_7_zMZR-9kZw5n22a65cEiVybROOPqs&_nc_zt=3&_nc
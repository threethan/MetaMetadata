nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGGD6kwqRvsQ7kNvwF8ZwVs&_nc_oc=AdqcBRAuY2fMBq0hXsJ-lKGhzoFk0lVvUkaHnqW2CJC0v_uTu3rsYkA7tBe44i9xrHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWsKMiX63lDSRXuiU8xRKrJTj61tMMIJD8tqfxqTfakg&oe=6AC2759D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjJjHlwk2vkQ7kNvwF80LfR&_nc_oc=AdqfcM8Wbi48JK_GT-sTJgY3FAO5ZywH7bOlkvlQ8SGq30bfOGR7jLZG9ydIycfb3rM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqthP6DFCHh6NSuFcbRby3IkVksYMmU6xwa-rJzgBprQ&oe=6AC27477"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.
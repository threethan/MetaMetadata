nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvMkzY-Hm3YQ7kNvwFxu9Vz&_nc_oc=AdpgFDNRxvBNSYqiJC3a7l6LbtROX6pMG05-awyZhABWZ-0_jfkpEbM5lFWVZRnbnJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5CUHml9BuE9zDtGJ-W1qH4tYBQlLTvHL1RpORN7kEtw&oe=6AF5E01D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub1WCJVWQlAQ7kNvwH-oL8l&_nc_oc=AdqxjyEyu9VBbKIPY1dKceChzMfAWnn-nioYDFhdj0W8NrAjmxclCSaPMudvnML05ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-1kQwq9irbE_rzox42ikH1EEAplB8vv3yyOjyedVlqg&oe=6AF5DEF7"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.
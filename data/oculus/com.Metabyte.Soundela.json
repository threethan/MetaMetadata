0.png", "id": "1272381453460068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1272381456793401_7484308086019440259_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6doWAb5aJuwQ7kNvwE0Xlwh&_nc_oc=Ado8RX0pKQ938RBYCwCZ3f2PWlxMMLweYO9z-lxjSaiYe3T7OkEuvysjU0U0fsyCpxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOlPHDCNchXbQiPSoP36fCZugr8qjOO-4qxGMRnr6J1g&oe=6AFDAF3A"}, {"file_name": "5_Pictures 2560 x 1440.png", "id": "1515005466021784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1515005499355114_4285525449600174080_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U93g9H0FZMsQ7kNvwEC1Lh3&_nc_oc=AdouM9VJy8GRTsbdko5PcwOACNj6aNujYSu48OeOPwt4kZ-1ssHRVlUhWce9dGREdUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvv1PbjjKngkoFMhi4qBzpHdy9lm8hav8zI5H6fig3Eg&oe=6AFDC91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube_Thumbnail_1 2560 x 1440.png", "id": "700861391952316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982564_700861395285649_2086792765612152763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g20qZ3ilegQ7kNvwGAdiB8&_nc_oc=AdrI6QvgiwP9WnTRzxBjjj7vMYtJQQS3AK4wr0zwy7KyeyDRItPT-Cr1RCFnsVOsvdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUV0fzwf2IQPec_LSXIEu18urBflVNPKK6avvV8TlW3w&oe=6AFDC7F7"}, "display_name": "Soundela", "keywords": [], "long_description": "Let's reshape the future of learning Piano - With Soundela you learn to play the piano in new virtual dimensions. Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way. It works for any kind of piano or keyboard. Players can choose between playing simple pieces with the help of a 3D notation system without reading notes or activate sheet music to really learn the song. Using this new technology, virtual notes are projected directly onto the real piano keyboard, creating an optimal environment for the player. On top of that Soundela aims to become a virtual music school teaching interactive lessons, learning technique, practice notes and chords interactively and receive instant feedback, music theory, composing own songs, improvisation and much more.", "short_description": "Soundela is a Mixed Reality piano learning app for beginners, returners and advanced players who can learn songs in minutes and not weeks in a very fun and innovative way."}]}, "developer_name": "MetaByte", "developer_privacy_policy_url": "https://soundela.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MetaByte", "support_website_url": "https://soundela.io/", "website_url": "https://soundela.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6204385602999107"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "356821466678935"}]}, "baseline_offer": {"id": "356821466678935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1696951779, "status": "PUBLISHED", "id": "356821466678935"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27771177132559976", "version": "0.3.1"}, "id": "131
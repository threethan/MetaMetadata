7275088046445_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7P3DWYwiNkQ7kNvwFw07tE&_nc_oc=Adqwa3cilqMljI27C6bBA8Xea3ecqmyWN2MPa1vmT0eTySVeC1PZIjgWAA1A4o3fsfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSjiv7dYguXJm2h83loVyL3gS0T85yElbsNsjPwdtJRw&oe=6B0DCE93"}, {"file_name": "AimAssaultScreenshot_2.png", "id": "1647397519211046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823447_1647397522544379_7242525253114032672_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIQS1SbgI8UQ7kNvwHY4jaD&_nc_oc=AdqvQQLa7eFcg7s9ZSy55dAIXCteJ7VENR9EOyxLIDldS1Or11lyFDIC1Uyw_Hl0Y84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7ZqKwQrQw4rv8A8WrEsGuIT4HeAulznJUKtVH1cLCQQ&oe=6B0D9FD3"}, {"file_name": "AimAssaultScreenshot_3.png", "id": "1042516971283635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618038_1042516977950301_7127956922843357683_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G-2GIkz-AIQ7kNvwFLeqzs&_nc_oc=AdrbBk2j-gSO7FDNNFsMxd0yY6SFBQ3grs88rtn-sit8O0J3qE2AnnIQwF_gId0Zzlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTR1e7clkQ0W1OWckGBdcQmx_qY_ijTxDYz6Z1RjVeqnA&oe=6B0DCBB8"}, {"file_name": "AimAssaultScreenshot_7.png", "id": "1258289705921377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819980_1258289709254710_5517956587707328170_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xh1r6S-19GUQ7kNvwGrHgba&_nc_oc=AdogNWYoN1cIXtQxgY0RLwwebwAIuwjqJ1SglRXqCKzdVFOFa4L1tLrYR7d9Xh2V2Mw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUYM5EaEPVhQv9KUJPk9ZUGuukTHCYvsUezDZSmPSD-g&oe=6B0DA70B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo copy.png", "id": "745003004781662", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828899_745003008114995_1490029844351575801_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R7PIzplQPsQ7kNvwGZ4szT&_nc_oc=AdptxHH3bUxiBwojzlrPzDndmLSrOnT34ba2VfIaAJ1phgh79ljMPqMV2rwWN6N43_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlgGaIsfyoxzkIiHMtezMZj1Wy0oXkxzqJCeh9dU5ARA&oe=6B0DA0EC"}, "display_name": "Aim Assault Demo", "keywords": ["arcade", "shooter", "retro", "rail", "action"], "long_description": "Aim Assault brings good old arcade rail-shooter into the world of virtual reality. Relive the excitement of old-school arcade games now in VR. Try out various gunplay styles - single gun, dual wielding, with or without a crosshair. Race against the clock and try to beat your personal score or compete in the global leaderboards. Fight different types of enemies in intense situations and everchanging rich environments. Dodge barrages of bullets, kill the bad guys and save the world. \n\n{1109498334375581}\n\nWe are excited to give you the opportunity to play the first levels of our game for free. Immerse yourself in the action-packed VR rail shooter, full of shooting, dodging bullets, and fighting villains. The game is currently in development and will be released at the end of 2025. \n\n{948482724042529}\n\n\"VR gave us a rare opportunity to recreate the arcade shooters we all loved as kids in a new way. Because of VR, we have new tools to immerse players even more into a game full of action.\" - Jakub Kucera (Game Director)\n\n{1951700829016520}\n\nDiscord\nWe regularly announce new locations, enemy types, bosses, and game mechanics on our Discord. Share your thoughts on the demo with us.\n\nWelcome to the world of Aim Assault!\n\n\n\n\n", "short_description": "Aim Assault brings classic arcade shooters into the world of virtual reality. Dodge a storm of bullets, take down hordes of enemies, and save the world. Try it now for free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1MY3bRXd0pXVUyxJ45dbVp6nz232SSenm3r_S0XbLrCI/edit?tab=t.0",
7479381_316100663097278584_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9Lk-4z0gsIQ7kNvwFtWiL8&_nc_oc=Adr4X4taU8gJO9DArWn2M2dlm8AQbWeOFDfoYQ4ne2bHiCmWHO8CXSvRc5hRZszc5fM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi2sxF6uowMYYePlD7jafMhDB22Bg8GHAMxhjMDFwv-g&oe=6AAEA618"}, {"file_name": "AimAssaultScreenshot_4.png", "id": "747678417671402", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307303_747678424338068_4921017275088046445_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnu-LUkMBHQQ7kNvwGLD9Y6&_nc_oc=AdofwVtI7A0CGTMR-HNqkOmCu0WUYBNbkQWne0zL7OW8J2Nph42uuzjp0rLLf2UGjWI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_VKOs8gwyQLijWesOysnT3WB9H2KWMWdvqIZjqO9Dag&oe=6AAEAA53"}, {"file_name": "AimAssaultScreenshot_2.png", "id": "1647397519211046", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823447_1647397522544379_7242525253114032672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpPRnvuV8DAQ7kNvwGpGj6D&_nc_oc=AdpaHfGGsiQDYLWYsE5T7tsHZLZa34HThn61bNr4wISoOU1CUDnfUgK_Zc9w4hj1jaw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLJuf-0lUUvh_iTnQxlAuIkxhrpQFz5xcNDlcbxv_QeA&oe=6AAEB3D3"}, {"file_name": "AimAssaultScreenshot_3.png", "id": "1042516971283635", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618038_1042516977950301_7127956922843357683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu3hVTJju-8Q7kNvwGthyBd&_nc_oc=AdrY9GtAy6kEZF65E19zzG7eHtMpvRSIkztDGu_VJ_aHUiFd55FxrEYI6BWnrcVqM_Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_Y03jCOudosit9bAcTCcbl8GgrQozAeKBhQWclKD59g&oe=6AAEA778"}, {"file_name": "AimAssaultScreenshot_7.png", "id": "1258289705921377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819980_1258289709254710_5517956587707328170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoyUFUEnPF0Q7kNvwErjYGv&_nc_oc=AdoSoupK9iOxtSnuoTABuJ2AqgPOicBSBaN6gEa5pNo32A3RfWlrkNdcs-iFDGMeqB0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOw9IdCG-DKonIlWmNBDCHf3UyKVIzeVeQArFtT07NUA&oe=6AAE82CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo copy.png", "id": "745003004781662", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828899_745003008114995_1490029844351575801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzZOffo1lu8Q7kNvwHkH_aV&_nc_oc=Adp4m_ZrJowB1Ja1qlilRj41MvmvGmM0qrg9RwSY9W0sekoq2QuYCvGrUyLwrL4QSfM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Wi9MzMJ087tCn8nuEVLcRUOBl7FdMWStCTHDRsoU8w&oe=6AAEB4EC"}, "display_name": "Aim Assault Demo", "keywords": ["arcade", "shooter", "retro", "rail", "action"], "long_description": "Aim Assault brings good old arcade rail-shooter into the world of virtual reality. Relive the excitement of old-school arcade games now in VR. Try out various gunplay styles - single gun, dual wielding, with or without a crosshair. Race against the clock and try to beat your personal score or compete in the global leaderboards. Fight different types of enemies in intense situations and everchanging rich environments. Dodge barrages of bullets, kill the bad guys and save the world. \n\n{1109498334375581}\n\nWe are excited to give you the opportunity to play the first levels of our game for free. Immerse yourself in the action-packed VR rail shooter, full of shooting, dodging bullets, and fighting villains. The game is currently in development and will be released at the end of 2025. \n\n{948482724042529}\n\n\"VR gave us a rare opportunity to recreate the arcade shooters we all loved as kids in a new way. Because of VR, we have new tools to immerse players even more into a game full of action.\" - Jakub Kucera (Game Director)\n\n{1951700829016520}\n\nDiscord\nWe regularly announce new locations, enemy types, bosses, and game mechanics on our Discord. Share your thoughts on the demo with us.\n\nWelcome to the world of Aim Assault!\n\n\n\n\n", "short_description": "Aim Assault brings classic arcade shooters into the world of virtual reality. Dodge a storm of bullets, take down hordes of enemies, and save the world. Try it now for free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1MY3bRXd0pXVUyxJ45dbVp6nz232SSenm3r_S0XbLrCI/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "DIVR Labs", "support_website_url": null, "website_url": "https://aimassault.divrlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9955186757911831"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1452878829207525"}]}, "baseline_offer": {"id": "1452878829207525"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753085760, "status": "PUBLISHED", "id": "1452878829207525"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9960932894003884", "version": "1.0.21"}, "id": "1249626356757080", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9565626616867849", "is_concept": false, "latest_released_binary": {"__typename": "An
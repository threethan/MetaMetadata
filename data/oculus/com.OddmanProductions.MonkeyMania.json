ol/Oddman", "developer_privacy_policy_url": "https://sites.google.com/view/monksvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Oddman/Naturalol", "support_website_url": null, "website_url": "https://sites.google.com/view/monksvr/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "8435893976492661"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974868_325526293157229_2625194253642024053_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSdDZhUeCysQ7kNvwGz84Zh&_nc_oc=AdnSwREs_mExKzYEhPFocB_ZUgaIwW2gh3uBeKGP6NfDriKCnOafLzQ4qyWf2_gwI-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzm0DyeU8F0Znszk6sT_fvUQxy8xr8ycShegDgic_1xcA&oe=69AED522"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monks", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1690305090, "lastRevision": {"nodes": [{"id": "6358116004270479", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6358115990937147", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "pla
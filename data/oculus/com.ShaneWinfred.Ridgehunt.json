xndgW4DEBqbIJzxzp1dw0kC4H9SaLg&oe=6B105387"}, {"file_name": "Screenshot_05.png", "id": "1033219259836030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771264_1033219263169363_2758679911098773983_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g84rhDN3RvgQ7kNvwHGE1N8&_nc_oc=AdqNgijzgSf3j-isDZD0MiViBX7ExPwWsnN4s2oUzitTu7_InNSqzKRNyUOkhU-3CpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtb3lJtJHVLAqKtKe1nnTYr1_wkHHpUE_a9_1j1HOJjw&oe=6B1068E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_V2_Cover.png", "id": "1159787126647527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771240_1159787129980860_8392614378787507541_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOYXWJWWyjUQ7kNvwEw4LEK&_nc_oc=Ado2piwgnIy6TpZnOXQPs1QqjbTcU8waYjPeR7Gd7IK1flTlc2YEk9vDfbXXmWYng-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXp82aOF02xs9ALQ1aequdpQvL-dmYZOfO-f-_WbYswhw&oe=6B1065FA"}, "display_name": "Ridgehunt", "keywords": ["hunting", "safari", "deer", "archery", "sniper"], "long_description": "Ridgehunt is a single-player VR hunting game for Meta Quest. Read the land, move quietly and make every shot count.\n\nTWO RESERVES, 12 SPECIES\n\u2022 Whitetail Ridge: northern forest and ridges with deer, elk, moose, wild boar, pheasant and rabbit, and black bears on the prowl.\n\u2022 Mopane Ridge: African bushveld and lakes with gazelle, wildebeest, Cape buffalo and guinea fowl. Shoot carelessly and spotted hyenas will come looking for you.\n\nFIVE WEAPONS\nStart with a recurve bow and throwing axe, then unlock the shotgun, hunting rifle and sniper rifle, each with its own ammo types. Harder weapons earn bigger score multipliers.\n\nMODES\n\u2022 Free Hunt: set your time, ammo, kit and score target.\n\u2022 20 Missions and 10 Score Hunts, each with its own best score.\n\u2022 Hard mode: big game only drops to a vital-organ shot.\n\nPROGRESSION\nEarn credits and XP to level up, unlock weapons, ammo and the second reserve, and buy gear like scent blocker, soft boots and camo. No in-app purchases.\n\nPLAY YOUR WAY\n\u2022 Touch controllers or full hand tracking, chosen per hand.\n\u2022 Standing or seated play, snap or smooth turning.\n\u2022 Optional radio guide and adjustable HUD.", "short_description": "Hunt across two vast reserves. Stalk deer, elk, moose and wild boar through northern forest ridges while black bears roam, then head to the African bushveld for wildebeest, Cape buffalo and gazelle, where gunshots draw in hyenas. Hunt with bow, throwing axe, shotgun, rifle or sniper rifle, using Touch controllers or full hand tracking, standing or seated."}]}, "developer_name": "Priminian", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRpZddGCd41CfrdqcnGDHH0aW6IuhfJmFvsOoFzMr6guOZq5R7q0hFXNEOO2hkQ_W00nLG954s6baXC/pub", "developer_terms_of_service_url": null, "publisher_name": "Priminian", "support_website_url": null, "website_url": "https://priminian.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40143764568604296"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842206_1651407573191610_248
nKwkzgGjxkwsqyc06s2zAFQ2d3QcUgFXDTmPvjoyGx0S7IAb87hVkiO8_3emFJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsMCoB9nAq7_ivEDLe1-rLzmMtOuI0KQbgDuKdSU0mWw&oe=6B103C39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_00032_.png", "id": "2351987628869739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839687_2351987632203072_5068746984890519464_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZycsmy8UxcQ7kNvwEa-BaD&_nc_oc=Adr0mXGcdsqYzrRBrpgE6TUQlWyUHfgX3vVNksfleRW7u-A6PLfbS-7HotNgz5jC1eY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9Er0p4eWeJamCTFNiBdjlDbWc8xBjUs9IXQLgseiYGQ&oe=6B10444D"}, "display_name": "Ridgehunt", "keywords": ["hunting", "safari", "deer", "archery", "sniper"], "long_description": "Ridgehunt is a single-player VR hunting game for Meta Quest. Read the land, move quietly and make every shot count.\n\nTWO RESERVES, 12 SPECIES\n\u2022 Whitetail Ridge: northern forest and ridges with deer, elk, moose, wild boar, pheasant and rabbit, and black bears on the prowl.\n\u2022 Mopane Ridge: African bushveld and lakes with gazelle, wildebeest, Cape buffalo and guinea fowl. Shoot carelessly and spotted hyenas will come looking for you.\n\nFIVE WEAPONS\nStart with a recurve bow and throwing axe, then unlock the shotgun, hunting rifle and sniper rifle, each with its own ammo types. Harder weapons earn bigger score multipliers.\n\nMODES\n\u2022 Free Hunt: set your time, ammo, kit and score target.\n\u2022 20 Missions and 10 Score Hunts, each with its own best score.\n\u2022 Hard mode: big game only drops to a vital-organ shot.\n\nPROGRESSION\nEarn credits and XP to level up, unlock weapons, ammo and the second reserve, and buy gear like scent blocker, soft boots and camo. No in-app purchases.\n\nPLAY YOUR WAY\n\u2022 Touch controllers or full hand tracking, chosen per hand.\n\u2022 Standing or seated play, snap or smooth turning.\n\u2022 Optional radio guide and adjustable HUD.", "short_description": "Hunt across two vast reserves. Stalk deer, elk, moose and wild boar through northern forest ridges while black bears roam, then head to the African bushveld for wildebeest, Cape buffalo and gazelle, where gunshots draw in hyenas. Hunt with bow, throwing axe, shotgun, rifle or sniper rifle, using Touch controllers or full hand tracking, standing or seated."}]}, "developer_name": "Priminian", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRpZddGCd41CfrdqcnGDHH0aW6IuhfJmFvsOoFzMr6guOZq5R7q0hFXNEOO2hkQ_W00nLG954s6baXC/pub", "developer_terms_of_service_url": null, "publisher_name": "Priminian", "support_website_url": null, "website_url": "https://priminian.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40118278207819599"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1111932784996437"}]}, "baseline_offer": {"id": "1111932784996437"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795659780, "status": "PUBLISHED", "id": "1111932784996437"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40086182087695878", "version": "1.0"}, "id": "1148584384335349", "
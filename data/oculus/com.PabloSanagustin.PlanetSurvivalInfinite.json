.5771-25/491831299_1497692849058599_1108439445345166811_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waA8HIgvgXYQ7kNvwEcStzM&_nc_oc=Adp8n1_DVzkBlpr5xGBpUx0J9o4h86cUreurezjd3-so9qrso9jm6Hmh2FH_cVRKSq8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCW12obLE4fZFaenHyrZnPkwkGuCAoQ8s8KROYbNCBSA&oe=6AFC8FDC"}, {"file_name": "2b.png", "id": "2118614582110547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_2118614585443880_4425122248205192893_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI7UvfGVRVAQ7kNvwGBmVSJ&_nc_oc=AdrW-o7lSoyqLIO1kfKVr0Appd5AA6dH6ixvd-vZdrSCKdq6gLcJwvdCCCP3giPCTNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSkdNyHQw00CspIkKPLp81heQfbHfdKeqvOwZhpjC4qQ&oe=6AFC6D7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ibiza Madness Zombie VS Demons Billar", "keywords": ["zombies", "demons", "survival", "ibiza", "billar"], "long_description": "Ibiza Madness Zombie VS Demons Billar is a fast paced action game where demons and zombies invade Ibiza.\n\nPlay offline in Survival mode and see how long you can resist increasingly difficult enemy waves, or jump online and battle other players in multiplayer matches.\n\nExplore unique environments inspired by Ibiza while using different weapons and strategies to survive.\n\nDesigned to be accessible and easy to play, the game focuses on quick gameplay sessions with simple controls and continuous action.\n\nFeatures:\n\n\ud83e\udddf Offline Survival mode\n\ud83c\udfae Online multiplayer battles\n\ud83d\udd2b Multiple weapons\n\ud83c\udf0d Locations inspired by Ibiza\n\u26a1 Fast and accessible gameplay\n\ud83e\udd7d Compatible with Meta Quest devices\n\nNew content, improvements and additional game modes will continue to be added through future updates.", "short_description": "Fight endless waves of demons and zombies in Ibiza. Play solo in Survival mode or compete online in multiplayer battles. Easy to pick up, fast paced, and designed for quick action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://diario-de-pgkp-lord-tartaro-yeventos.blogspot.com/p/privacy-policy-ibiza-madness-zombie-vs.html", "developer_terms_of_service_url": null, "publisher_name": "Pablo Sanagustin Ballesteros", "support_website_url": null, "website_url": "https://diario-de-pgkp-lord-tartaro-yeventos.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1338886315978432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312310_1417590306928466_548376690672839768_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsLRGYho0cMQ7kNvwFbwbTa&_nc_oc=AdqoY5bhrBnN_fr0dqkzAOtue0hGxXVWPYFMt5-Ho_MCWmwmTmQZ3IktxLxdtK4fowc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8E0bhES74j8gNnEB_f-Ry9mdjKlUXYcmX6IY71Rx1zg&oe=6AFC95EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ibiza Madness Zombie VS Demons Billar", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "64435487310671
hwC8A&oe=6A8D7213"}, {"file_name": "1_V2.png", "id": "1180467559753573", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974844_1180467563086906_1588071258005231872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nFpwf8neKUQ7kNvwGDTlpi&_nc_oc=AdpmOhgMZOAoEdFqF4jS_RFerm7gCE7RxVDdBdEzMvgdXIhI_i_V5QzBNA9JmEROkms&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0jat_d7FYZrmq7CvXeCU1LXruDmgSQ0wcErX8U5SpHQ&oe=6A8D854E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "459143080084620", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982658_459143083417953_4317925573810879115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzktOpacER0Q7kNvwFeLQcp&_nc_oc=AdoI68tvzpQbkx1l6eDRXe-MK94Ddj3LiNX6dbnbudd3JUsC55hdRdkMbVRNqN-5s_s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmcSpMIo_yZLWILxL1JlHkh0AYjZw-P4Yswqy2m12VVQ&oe=6A8D781A"}, "display_name": "Lifestory - App", "keywords": [], "long_description": "**Lifestory: Explore Your Timelines in VR**\n\nStep into the Timeline Room and immerse yourself in the world of your memories with Lifestory. Experience your life's most precious moments in a virtual reality museum.\n\n**Features:**\n- **Timeline Room:** Navigate through a beautifully designed VR space where all your timelines are displayed. \n- **View Moments:** Relive your photos, and writings in an immersive environment. Each timeline is a gallery of your life's unique moments.\n- **VR Museum:** See your life\u2019s story unfold in a virtual reality museum. Every moment is a piece of art, brought to life in VR.\n\nBecause every moment of life is unique, Lifestory lets you etch them forever on secure timelines and experience them in a whole new way.", "short_description": "Step into the Timeline Room and immerse yourself in your life's moments with Lifestory on Meta Quest. Navigate through a virtual reality museum where your timelines and memories come to life."}]}
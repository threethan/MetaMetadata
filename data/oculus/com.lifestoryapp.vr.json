A&oe=6A22E0D3"}, {"file_name": "1_V2.png", "id": "1180467559753573", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974844_1180467563086906_1588071258005231872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3s5iSUOaFIQ7kNvwE4LzH-&_nc_oc=AdqmwqHkJadsMUvlW0yXpLnDsgKat6HwjOi7TLP4KA7gxYeSVxKEEVPScew8BXRIlAg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-SmKKp-SkxtYA9QO_z5B9I_0FKUwN8y8V0lb3PQTJwA&oe=6A22F40E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "459143080084620", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982658_459143083417953_4317925573810879115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Zv-BRnqy9cQ7kNvwHRFByR&_nc_oc=Adp11qKG63i52133NtK9-GdmYq-Zk3yb87d7gqvgEMSOXLNDVNGQdu7JWHcv8oo3hd0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xv8lLmDs-LXOt369rd4xTZpzeKdebyfvKIpg4bw_GvQ&oe=6A22E6DA"}, "display_name": "Lifestory - App", "keywords": [], "long_description": "**Lifestory: Explore Your Timelines in VR**\n\nStep into the Timeline Room and immerse yourself in the world of your memories with Lifestory. Experience your life's most precious moments in a virtual reality museum.\n\n**Features:**\n- **Timeline Room:** Navigate through a beautifully designed VR space where all your timelines are displayed. \n- **View Moments:** Relive your photos, and writings in an immersive environment. Each timeline is a gallery of your life's unique moments.\n- **VR Museum:** See your life\u2019s story unfold in a virtual reality museum. Every moment is a piece of art, brought to life in VR.\n\nBecause every moment of life is unique, Lifestory lets you etch them forever on secure timelines and experience them in a whole new way.", "short_description": "Step into the Timeline Room and immerse yourself in your life's moments with Lifestory on Meta Quest. Navigate through a virtual reality museum where your timelines and memories come to life."}]}, "d
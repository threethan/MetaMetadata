727119_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtEXmCGf6BoQ7kNvwFQsOgg&_nc_oc=AdrQ3s8SwtZ8tgKYiUOMg_nhleKySgcV9BJKA4vuf9uAbRtHH6oZyz1mICCSMEgeVSs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vOTa1bbJs-boeSSLKgPU_oX-2WuqdgLVtk2QF_13byA&oe=6A14415A"}, {"file_name": "Screenshot 2026-04-22 183450.png", "id": "2057292631877854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_2057292638544520_3904925737965230172_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rC1QYSvwv4Q7kNvwGcs_Xz&_nc_oc=Adq2wk4c-b3OioHUklZy19jxhkLGk9fmRzm_xx2NPUHd9dva1qT8gF622NySBEb4gjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lwnzN4zZE2DTujWdXNqzEuO0FbD4qqowXg2JCUnTwug&oe=6A14684F"}, {"file_name": "Screenshot 2026-04-22 183334.png", "id": "1486145703222353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_1486145706555686_5424602579787655220_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLGOHc-S93UQ7kNvwH7LUK9&_nc_oc=AdoJ4JPAzYJ9Ptp83kQMmAepGBhj3o9O-FkN8DCnSyvXB7plGs4oluiPzComyahC9hQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j4qZRhoIEDUB3IzErlkD0HLVk3aUv-wcgjfow6ResiQ&oe=6A146FFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC and Refrigeration", "keywords": [], "long_description": "HVAC and Refrigeration is an immersive Virtual Reality training application designed to provide hands-on learning for technicians in a safe, controlled environment. Through realistic simulations, users can explore key concepts, practice system operations, and develop critical troubleshooting skills essential to the HVAC and refrigeration industry.\n\nThis application is exclusively part of the Immerse Learn HVAC and Refrigeration micro-credential program. Access is limited to learners who are officially enrolled in the program, ensuring a structured and guided training experience.\n\nBy combining interactive scenarios with practical skill-building exercises, this VR application helps learners gain confidence, reduce real-world risks, and improve job readiness through experiential learning.", "short_description": "Experience hands-on HVAC and Refrigeration training through immersive VR simulations. This application is part of the Immerse Learn HVAC and Refrigeration micro-credential program. Only enrolled learners can access this app to practice real-world skills, enhance technical knowledge, and safely build competency in a controlled virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26898661036432818"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "858851457230087"}]}, "baseline_offer": {"id": "858851457230087"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777875540, "status": "PUBLISHED", "id": "858851457230087"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27052809737684613", "version": "1.2"}, "id": "939259725617949", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__t
28.png", "id": "25856630287343803", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822327_25856630324010466_791130295076693467_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnbrpzpzouUQ7kNvwHuo4Lo&_nc_oc=AdqfSdon1gQu4IS32ZTzSlU_9JgNwwBAvaTkj9bFJ61vhgO8CZtApIstoBaGn8gMpVI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rinxL58xrxYscZc5RyJIkZgZy90QvL5_rATkXK6pDmA&oe=6A4670F5"}, {"file_name": "Screenshot 2026-04-22 183214.png", "id": "1968449717132778", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823351_1968449720466111_7811789961515727119_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQvcnhi_iZEQ7kNvwGexOHa&_nc_oc=AdrC2ZltnE_lfUWuYCKkxG-EL5-bScVU0EtEkY7a4NNeI5cs3ei18JEbmNrT4v51nao&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ifAfJqaACtlGk_Gk2m_veFkwyyCx52oxZSxXNKH2HUQ&oe=6A465A5A"}, {"file_name": "Screenshot 2026-04-22 183450.png", "id": "2057292631877854", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819239_2057292638544520_3904925737965230172_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK4n1kTm_eEQ7kNvwESJec-&_nc_oc=AdrCyfyaYZpyAmmF_XarOP2xIRZOWuFGF1oz-ZTeOKvBPeV81Wi07oRq7ozjIKNymhg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tOUrN6WspUu9VQ5L6C7OhUwz8N91JsbdjWLOdOfKZgA&oe=6A46814F"}, {"file_name": "Screenshot 2026-04-22 183334.png", "id": "1486145703222353", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819859_1486145706555686_5424602579787655220_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1qdjlmJ9JAQ7kNvwGO0V9v&_nc_oc=AdrXldyLMvtM3g7DDsvyOVeHf9MUadObcupmfVrw0XjVtSFyrOCHDIwAsqw-jECj990&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f_zIt86tIf5KVZjK7ssPJUZ1q_772Ayrw4x4AWcAcSQ&oe=6A4688FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC and Refrigeration", "keywords": [], "long_description": "HVAC and Refrigeration is an immersive Virtual Reality training application designed to provide hands-on learning for technicians in a safe, controlled environment. Through realistic simulations, users can explore key concepts, practice system operations, and develop critical troubleshooting skills essential to the HVAC and refrigeration industry.\n\nThis application is exclusively part of the Immerse Learn HVAC and Refrigeration micro-credential program. Access is limited to learners who are officially enrolled in the program, ensuring a structured and guided training experience.\n\nBy combining interactive scenarios with practical skill-building exercises, this VR application helps learners gain confidence, reduce real-world risks, and improve job readiness through experiential learning.", "short_description": "Experience hands-on HVAC and Refrigeration training through immersive VR simulations. This application is part of the Immerse Learn HVAC and Refrigeration micro-credential program. Only enrolled learners can access this app to practice real-world skills, enhance technical knowledge, and safely build competency in a controlled virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SING
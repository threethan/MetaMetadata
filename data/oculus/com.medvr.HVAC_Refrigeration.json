_ss=7f20f&oh=00_Af5lwnzN4zZE2DTujWdXNqzEuO0FbD4qqowXg2JCUnTwug&oe=6A14684F"}, {"file_name": "Screenshot 2026-04-22 183334.png", "id": "1486145703222353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_1486145706555686_5424602579787655220_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLGOHc-S93UQ7kNvwH7LUK9&_nc_oc=AdoJ4JPAzYJ9Ptp83kQMmAepGBhj3o9O-FkN8DCnSyvXB7plGs4oluiPzComyahC9hQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j4qZRhoIEDUB3IzErlkD0HLVk3aUv-wcgjfow6ResiQ&oe=6A146FFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC and Refrigeration", "keywords": [], "long_description": "HVAC and Refrigeration is an immersive Virtual Reality training application designed to provide hands-on learning for technicians in a safe, controlled environment. Through realistic simulations, users can explore key concepts, practice system operations, and develop critical troubleshooting skills essential to the HVAC and refrigeration industry.\n\nThis application is exclusively part of the Immerse Learn HVAC and Refrigeration micro-credential program. Access is limited to learners who are officially enrolled in the program, ensuring a structured and guided training experience.\n\nBy combining interactive scenarios with practical skill-building exercises, this VR application helps learners gain confidence, reduce real-world risks, and improve job readiness through experiential learning.", "short_description": "Experience hands-on HVAC and Refrigeration training through immersive VR simulations. This application is part of the Immerse Learn HVAC and Refrigeration micro-credential program. Only enrolled learners can access this app to practice real-world skills, enhance technical knowledge, and safely build competency in a controlled virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publishe
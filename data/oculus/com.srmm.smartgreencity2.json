_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfpojNvsmKUQ7kNvwGbz1Nn&_nc_oc=AdrHnM0CCc7511OX-SzSa6fwEH95yqN0dSFTanXOJt4gAiSWi9RYvRa6AZy8tF55qt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP1VupBnY1vUG3k6D25XYV3ah7xeIJSDjWObg7mPPVbw&oe=6AB7EEDC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwsDGDxARBQQ7kNvwH6jBv9&_nc_oc=AdpulrShJaRydtGP3iHTQP_fojE4ZL_Ler9brPjbDDxiG2PRgRvsvukJgSvf0XMXSEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwluJhYe0Gzm16EHY1FUK1tdcSj_uWoZZgEo-stWl3Yw&oe=6AB7D55D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWm-mKi5ZHwQ7kNvwEcE4rZ&_nc_oc=Adr6UHitYzWnSvyt9On03MmWphvrh8kVsfPJWkaMpr7qNPh3mxls9uYJo6GFdo_mq04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqH0ftMcBA2PLtlfU6mz4EOE5wlqidKU9uhqLxa91U2w&oe=6AB7CD32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruddxp7Z_GEQ7kNvwEjiWnl&_nc_oc=AdqF_Jd2l-dYBq4UHkwa-EfqBTVgq65qodwYiJBUam4mIO10OQh1EsKzs4mO-wcogaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIG1_RWQpzbY_BRB2iz7dSJvwJYj7gkAs8xiho7J0xwA&oe=6AB7BA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYX6YBhTwd8Q7kNvwFC2_0N&_nc_oc=AdqZ2UYBGP6WwLScszyC_HOGGcEw7RmPliFoWEb5EK7rtjDgzxAuG2l_CydsgKNGYZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKaca69wEVFwCrc15cVy8we1PiUhWdFRxgYTDIMjNuQQ&oe=6AB7BF95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RV04yYuwKYQ7kNvwHF_QUq&_nc_oc=AdqGWdw8u82KH7Xf
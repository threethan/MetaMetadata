72pkw9RBHXgpTvQaKUCzQLAkaCoeT6CDmmEVjvMH4BBeYbC2P1WmPH4F5Nt3cw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jx4iHLqA-fmrbXyOCnkfyezZMN6uXAJ_IMbt0CVghrA&oe=6A369A32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_cv5w0BuRQQ7kNvwG1MkWL&_nc_oc=AdpqHDFQz1OxHO-e8KzwbH0aOdHK5IcKkl9YSweogydcXIdCpDsJqN3SdiZlBWa28f8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NRQRaIJUvA0BhDQaI1qovYPQFYGDuO_Web9Xn16PDTQ&oe=6A36BF97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjLbDpo166QQ7kNvwHfc_IE&_nc_oc=AdqE7hgIqNIp5d_YiW9HtZm81v90TiEVroEFNQ6aa1hgfLMfCwpi4UWvCSUS9pjeVe8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J4PbHsw7H60DdlJEg-3jCOLNbXzkvQxDR9DFARVP7ag&oe=6A36C4D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz9Vh7mI58kQ7kNvwHJSDkY&_nc_oc=AdrlfeLmab2YaBMk3kIwcuRZyYSfjZ4BfBDljUkCksctESOYkCEkSok5lZkAxZTjX7A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JrLjRW8ncnuzhO9Rp7cQc3FNsjBZJ_lbnO3O2G8e1Yw&oe=6A36A042"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eeHwjgjgzQQ7kNvwE-trDd&_nc_oc=Adq_TEz4Wi932fNmH1ODvBBwLBkX3rSndRkxwA9xhhlds-cZ_9DK3VtgsHWxnc3bLto&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Iyqp_2SKaMCkk9lcRMikgxR6jgiwA9Ci7cTJ2_9ZTzg&oe=6A36BF04"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZIRx06f5L0Q7kNvwHfDME1&_nc_oc=AdqJo3zz-jqNv1xYRZxn1lehxzLie
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0n7fokTAI8Q7kNvwHBlMT0&_nc_oc=AdoM8yow9ZzDol53VT_sEWFVbsvuRK9c1F5353uR35wEDJ1CfwABmW66VkgoLg1GOUg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPUes4-xYcNUlxIHm8Z3w0gcDmFaYoH2_tfBHT_xQYPA&oe=6AC51DDC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5UY7znLc3gQ7kNvwEUhCwW&_nc_oc=AdoqcNpa9CUow8aTBvK3DQCcMUa6e1NYfjtRkvE4QyyzywisFNSnFqMeqHBX2VsJ0C0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZvhALkbNQ8xn0LK5MkBR_BqU0Khd1sbe6VNhK0cITDQ&oe=6AC5045D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0bszef6Vb8Q7kNvwFBv9aK&_nc_oc=Adqd0LfvrSycVALzVSITZVRKDzjJ-pv42Zsa7jvUFix_vrqtAyagMFbFrjd9vY37eow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMD3yGtIa4A2xGdfHzrjzstxaiP5-rwYdfpnrBv-CWNA&oe=6AC4FC32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ABjnWLhrc0Q7kNvwHCI0yZ&_nc_oc=AdqpdSCWkcg_00s9BK6163jfel1u-xMExZfE6tcDrqcpK0Oiz4bVU6giOpjav5ujy20&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9KoZtHC7P_wSNP9I3CNBPQhqY95G74FgsbxMqZxqdKw&oe=6AC52197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oesm5hbIDJ0Q7kNvwFnExXv&_nc_oc=Adrj6RkBSF2lIioCzChieg_b7lZDq_QoQjzgrGodQDxkbFjyQDGJUfshbvYMGCf-F1Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVXWBm9YNIOnZuKraho_8cPF0IgfD8s2oS2QD0vb2UuA&oe=6AC526D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ976dnhZ2QQ7kNvwEnAvpK&_nc_oc=AdqWHEDbiFzkcoX1
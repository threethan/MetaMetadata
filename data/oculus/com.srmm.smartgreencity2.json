nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszkPomTA9dO4i_qLxwLwObZjozr2RedsXzcwiw962bRg&oe=69A03C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QINuDMGHMdwQ7kNvwGuPBIo&_nc_oc=AdnkPDZD_td8SJB7LEqBv7-XOu3nNMXXJIRdprWZgItjBm2b8RJGnAVEprIZZz3bkBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvVWKU3KgCvE7U1NFjZlJRvC7b1ohcTILIbXfDKJcFiwQ&oe=69A04195"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFRDH1uZqhIQ7kNvwH0ZaNr&_nc_oc=AdmNSOPg83Ohuho0Q8KRXujlxNLeyak4Lb9T4IssoC4_wcI6FiwgDK2dBY0ORsx6j-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuExpESCGFd13b1JxIzd1cvYyP0Ny81F1OeoNNIB2wONg&oe=69A05542"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsAtnbrvKhQQ7kNvwGMfXxa&_nc_oc=AdlbColCkiG0-rlnJ_sDbzRzzh-0KyeWlnOtB2oX_4u6uHmK3Rj_yQ1U4DgYbRyKrlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8FJy4M8EkNvI4Lj4puX0P2xWfsFZCGpFPqqMW8kljkg&oe=69A03BC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qXvnnaz1qoQ7kNvwEML4Hc&_nc_oc=AdlSyOTdgfnbziVBNqfrbQk6KA6aH95EjDoxU-3fePAxVPVXtxsUo8wE5PcK1752Ews&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjgFWmTbLNX-7PJBJRZ787fUbw8YjuMXkcl0FGQ9YanA&oe=69A03422"}, {"file_name": "Icon_512x512.png", "id": "874968081049627", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_874968084382960_490444167917392231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-EeF_09ccgQ7kNvwFziCni&_nc_oc=Adk_3KvOBORxVum745FI6nF0ZbID-QIkmy--Vc0CxF9WtpbQhigqMNBrgUNRYYn8yTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPuRJzR3gVGZBSgfciZqLNSGk6hBcevq
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Vjic3VS9AQ7kNvwE5jrCB&_nc_oc=AdoPMDFvzOtA1p8J_xvh0jE-WpTes9g1gwGxpjcU38wSa8GN-0THDrvI2E6HjvAe0_M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINHUecXv4NnsdZ6nUBTS1BxYVmyBxxtarhbsb3dTaSVg&oe=6A9FFB9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp2wQy6GM9EQ7kNvwHLeUCh&_nc_oc=AdpZh232jKfeOyvBn6DxVawfriw-EIYghy9Xo7qGBPQ2y2CSd1QvrTvMc-OnmgN0EvE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7vSz7yg0okJHRUl4sJAaBSHA_A5rXg-r8FnzAhKCSvQ&oe=6AA01A5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv8KVYttfOMQ7kNvwHGU4Y6&_nc_oc=Adp2dUy2g9e3Zok7bDofkIj9si1nOvem2ot3TUwX5iT-zFmSMXHXn2l1LgqfkCTvVbo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_diGAIB9MR76Tu0yS5jK-9Z8kcDZGOMmzRFhzeLTuag&oe=6AA01232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwUwm5iZHfMQ7kNvwFhTvV9&_nc_oc=AdqveJhgumtENUlv0yPR4WnLoxwepGRWDsRmKE5Jh38_J2rJtFxjmwEXvDj7k6trT7g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj_HObtinvQSbZW5z4CNWJffTd0N_IRagHqQU4FKuEig&oe=6A9FFF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0_VRObde9sQ7kNvwHflxVz&_nc_oc=AdrRDkwJHD2gDbZFM6BSMz-z56KI-LVY4i7lvI69EOPLu-UY51qq-NSoRm-R8VIVtSc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg7zb6kIs9_qceb7xLM5Qf-IXBNS-CvYUgBDv79ymrlw&oe=6AA00495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW7jVLNYThcQ7kNvwFaAnR1&_nc_oc=AdrsANPpgG-edv43
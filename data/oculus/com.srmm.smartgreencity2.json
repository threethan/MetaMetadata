K-nPi3PMaYfK1hdGYVcb0xHVDLKd-UY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LEnkxjcnb9jZdKNIT8T1wP4qJkkCInpt55DAiW9lS-A&oe=6A105EB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55-muNlIUVMQ7kNvwFpdCk-&_nc_oc=Adr2iUURO4IOu5INQ2Dpa5alH6v8OB9qzQUTNmVn4CAXEZQAUievdX-O9nNr09KrdIQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i7OD9lgrpAcRH1i5dZ314ma0s_8OeJ3_ys8dKs-OfnQ&oe=6A104BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAAqGpulK6MQ7kNvwFZj7qt&_nc_oc=Adq3agfLDVjQM_3gwKGc2NHJ6eDzXgA9sh39dz77Yvie39MULQkY1F4B0Db6uS1EDmc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sBy2z1Lo6iMvh7pvWwZ289YGfkk5t1725G9cyUAbeOA&oe=6A105115"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuDEvT1yv0QQ7kNvwHPtWkZ&_nc_oc=AdpUo-CmtXt4-QFC0J0SussmoRzbPBBHVDGqCJ480qqIOorC1DJ9ouQLpoQIOEYM_pw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R_XvXH2Lzmk-8l5gK7h1KVdkPbegL8dFZrMergj9kXw&oe=6A1064C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnEs-WHnI-8Q7kNvwHZhDeE&_nc_oc=AdoXZVRJM2Ubea4_eNO87GXLSwsJveXWX25OVuJfi_-G9U6VcmY0q3DMPeGqXGkO3bM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xeufc0hiz3oJxiOwxSpyG4kQWNY2NQDSm9lN5u4fwFw&oe=6A104B44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6roXnzWWR6IQ7kNvwGyNcBL&_nc_oc=Adr81zoN5Qqkjdsy8gktasZnrMjkTd5c4D1zvkRNp--JEwVS5RCkYkI9cfXxyqm
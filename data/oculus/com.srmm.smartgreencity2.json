qYDZqjwMV3b9N-4X3ciXQI39iiTi1VA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErqqXVwqlw_c-HiKsIv13DCxX4hrohiy2tXtDrU3bK8g&oe=6A81BFB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywr3DWlFjlsQ7kNvwGtCHyT&_nc_oc=Ado4fa0nPiDjLnld9LhokK_B1LUSzhvEVuTEmpCGt6YhxqqaMSISvza2t-4V7tiGfuE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGql2_j9Bqn9UCwF_y8DmDyVcOGZxlYdgWoZhr7dIfxxw&oe=6A81ACD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nETyeUfUSt4Q7kNvwEvueJ0&_nc_oc=AdoZKxoiEad9xl6KnCRuShJyH764zmfPt9zaZQzPuxcXhZsIIP_CtHmI6kA9H1QsCd8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk8_xoY0qTrYiaBauVPlkfySvA8ps26nc7-dJXszaOVw&oe=6A81B215"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf7kC19PlP0Q7kNvwGZ9OHt&_nc_oc=AdogVdQVNzyl-vy2BE1c_RrE8omwS_NdB4QmulbXzQ2CTcchrQS0o0JsG33AC88FpbQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdiHZ4cTYE6Vs9BdzoMwDLD4VgmCpP9-hn7wt_dpdQOg&oe=6A81C5C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlLxJebWJ2gQ7kNvwFoazvV&_nc_oc=AdpO2xak6KqET-8gk4Z7uXKMKm2TlZaNe7eBfOPC-b-pM3JsPHlEX6M-2xW6SxsvgWM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGpwrY9B4_uNm_zp9z9X7zZat0t-jRHIHy_Lsov1qhSw&oe=6A81AC44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey34n82bc6AQ7kNvwHiKGby&_nc_oc=AdpZ6WQibf1BYHoEy_ebB_qvkdwmX-Zlos8WDO6okJkPtXVK-H6AuZzeTI3h8E6
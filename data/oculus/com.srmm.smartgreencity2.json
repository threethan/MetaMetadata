L99a4ibxaE_Q4xiq-43E1vO8DYkqH5UXt_mzFRGbRH78vxtF03s5eYSwwvhTq0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bsGuDEYMQhqJkud_EsyhqSVz7uun1pV_URiq7opneCg&oe=6A466C32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ExYJPZ2VGAQ7kNvwFqqe1c&_nc_oc=Ado2H469pf6NkzAdtUZItO2JZLzRJvjGThvk-9jp-9dSWh3mn9eUM-kDGbqbJpTqh9Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qsLdLqfYUWhAwCth97L1fRzrb-o3x12-8zVyGgaP5hQ&oe=6A469197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hXVsNyg3iYQ7kNvwHYAB91&_nc_oc=AdpMPcs60QGilbF5LPaTq_9-BVfQLES51_52xAJWYxHf9XmKwJRCyHIn7WM8PenS6ac&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wC8FZ4PqfbCCvixZ4LeVuGdgXc9uimm7IqaoT40kbJg&oe=6A465E95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf7pGHrjNAQQ7kNvwHBk75T&_nc_oc=AdpkzsQ8d16H5LnvXWmJCCmt1V415GWjn__YBUGqAnBiE3WMi1dgxCAj36epISx-Z54&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vy69w0SF1n9A3IHA1mGOB0_PBcr6geg1M0TbPOY3waw&oe=6A467242"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CCH85DVMEMQ7kNvwF6QIKH&_nc_oc=AdoGhL8Thki8Q-3JDwPKl4qi9u_iDKT_1PmHgxzUBBLTN2pZy5xhZExt_DnzQmPpplY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vJa3WoLK1XvECqfdcqYJScGP9yUua2Dt_16EsH5Xt4Q&oe=6A469104"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz3VNLK1VqEQ7kNvwEJIaOM&_nc_oc=Adpge_fpk5-oYWPGiLahLkQmgrfJ-
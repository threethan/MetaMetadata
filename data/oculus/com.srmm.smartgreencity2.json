uCOZ3OJfW09N9idFuZ7jXu3648IwXnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID8seikhtAxzzOZaGrQD1texuksOA4IutFj5s1hel-Iw&oe=6ABBC1B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QcJvR3wU7AQ7kNvwFkab1j&_nc_oc=Adqi7vV17kgDwJ01SxSzN7z0-LFRCX2gc0nbEDomxepABD0ecxLTCtSz82m0TlgGo40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-OK8XwBL63AigHmw3uAllLr1D6lW-epM7nWmUVqtmaA&oe=6ABBAED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHHvsBGAm8wQ7kNvwFoVqOd&_nc_oc=Adrdgjs_aHsZON8lN0k6SqpZlDNCOFhgX585Y7FiIaY9iylfiVCNswn0dUQIgfwl2iY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKihse8zqRN8A6da_NPtP5AufNAcgXarKiDdC6nQc2Jiw&oe=6ABBB415"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKO1D8bRu3EQ7kNvwEXzel9&_nc_oc=AdpACmxUeMK1R7J3xHQD5CcTVcuza82TYQi8h5FtaGryMQ6SDoRMGumwpEJPyJ7OYO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz3VIXtsWSt_Mtf8i-chtiPaMAncRjNsOXhRLSCdH3og&oe=6ABBC7C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG74BL0vABgQ7kNvwGCiWQY&_nc_oc=AdozQdMmC_rtklD_aLWlmwG6LgVe5I6VY7z-8Vgto356DgpDvXtX1260dxLo_eB0KLY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxF3oAcpKPX8_GJSNPdh9cVK1lF9eNj6NKB9I4CXPq4g&oe=6ABBAE44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5spnfZyrSkQ7kNvwFtwDOb&_nc_oc=AdqxzFShSMZgVyQpcj981Q9KbGbNLiPd2j0d1wHuZZ2B6J-Ys4bL9Axi23usGNN
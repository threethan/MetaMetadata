vqJPqd4ZjC4ViBco8wAxyYskCLuL16g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2vbJ5AvSurmeHcngsuWUVa2J83ZYuaBx222cZkEmZdw&oe=6A451AB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8fl09Ad0osQ7kNvwGj_3Fh&_nc_oc=AdqyKGGO5kFYt1LhFm7dF7vcLEIf2cNo2y2NE22ZvLXQuq4PKoJ5ZIQkYq-McRE8hWQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C0_-Gz32LgnkAIpKSCthYKjPBZieO0J61wP8kPpSAvw&oe=6A4507D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hXVsNyg3iYQ7kNvwE6E9wK&_nc_oc=Ado1ZyfHHdOZVIteQvwssvyyu9Wm9Q0x_o5Y5nmScnPvAUnKx9eSeV9mnuoTwYbJYKo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OXH1UoAxd6pxxj5kDFAb-ecYmhlWKUlKd-peJ5nUDAA&oe=6A450D15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf7pGHrjNAQQ7kNvwHZJpVQ&_nc_oc=AdqYaeGtWcu4cwFDRhwt0M9d081PcvL_RSDf5BhlZ1JaciwtGbFQs4M5Q8SE-Y2GIZQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82PgiD5aduJkQq4A5hv7a43ZQwuKdJkbJPvUMrbyT7sg&oe=6A4520C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CCH85DVMEMQ7kNvwEBzM34&_nc_oc=AdqPhe1rBKObdDXFoNy03AdQf7bJOwHrfh60a4b4GyXN5GrdkW_hKsAb9OMaygXxa-M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XhTrCEDv848WPkso6AAJZNPAlfEiyLWrwR6x_QT9I7Q&oe=6A450744"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz3VNLK1VqEQ7kNvwGQZqrs&_nc_oc=AdqDRLNJstDTb_-iiy_T_e4KX1AqSsX5NbQT0p86jtelbgoBqKu9pxrU3tn8RCU
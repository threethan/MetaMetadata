_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qxWqxDR-1IQ7kNvwHB_Emy&_nc_oc=Adrn95tnL8ofre_m1jDOZJxSBnlg0MtbwM9o4Sp-Dzx35xDG4yAxyjd8KRDzVSSSms8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl11biqCViBxab6sO_9H0QRfj-Xp2xpNhOP-sIxXT6ow&oe=6AA7E49C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvdish1RF1AQ7kNvwE3mR7M&_nc_oc=AdotFoApImMf6QQMaHisPWGI8LYVU4XVItFy58ZuP9g9FMvC2rDpOGEEHG7-NjYQZcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjdwkrb4NYOwpw2639IVmlICJr5Pf6-3EVs4zMf1OE0g&oe=6AA8035D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJaYzlaqk6QQ7kNvwEF5Rzm&_nc_oc=Adq8OOMgD1htpHppi5fZYuQfyNEsGLD-5Mb3c3lyLXZCZk8kp3Qbm7jVikhMDeQV_gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3KLdz0dcFQ8taThCxB7cxDp3cIG6QM5ZVGsFldNacUQ&oe=6AA7FB32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZCdvcRez8wQ7kNvwFDIs1u&_nc_oc=AdpsDxTEVYBNUOR3TOagkS-zOefqr9JWl250LfEyp9i6Iul1EqJDPgB6BbiiVbfxrZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0SoahWM9li8E9beKOH_OCP2gZ9Aq9QRf_HnmrGWaGWw&oe=6AA7E857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KUuq0bzIhAQ7kNvwGT7_DE&_nc_oc=Adq9K9gbyQcuqYigXh1CdXylIDN_cbz3q9kOegZQrLerX-6nvh95GB8ex0lcb_68PWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMdlYnw3r4VtDBaIZNlCr1CthDBUttFowThs4Rq2hNXA&oe=6AA7ED95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Fj9_qpyitoQ7kNvwHOUwJx&_nc_oc=AdqEzfzTdJziJWRb
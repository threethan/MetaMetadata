MKkgsZIFYiisLy1-E3AHgKzPZlGMAYM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37qVJ-Uj5hlLfF4OSQNitNUjrGMBqMfNilqTkgfO6f-Q&oe=69E23A32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbHnbtU9BJwQ7kNvwGxwg1t&_nc_oc=AdqIdFpzY2fhMFYlptth-obOTXwv1poQqrdMYwZmMWTOqdlWUDs3YQghkaWWgPSYiCs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YQpoEDmhfSMqpICcE29kYXTGt15hB2XEVM64FLNFaZQ&oe=69E22757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guh1yJVp1g0Q7kNvwHEZrX-&_nc_oc=AdoWAiKycA9Mpf7qZmTHkGBwgpRgcHGyq1vUqgZhJmztOaQmym9CKOandO6aFZhnxVE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sDaIPVZTf2TnioG85droFfnPg-U4U1XP2jOQGu7X-1Q&oe=69E22C95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7AvfMojMUgQ7kNvwHTcWU4&_nc_oc=Adok2WJnycyFJoP7ymHATuuXRTEKvN1ZWOuIW8vz7tbChxUTYGkw536543CjaqH0SQ4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KTOxSA5HcQaOU9CY9-zeNjQkbxwPGxRrSO1zYReqzsw&oe=69E24042"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWWtJCTbaZEQ7kNvwGrQ7fZ&_nc_oc=AdoNEml7pbxXNa4zU9YkNr9qjG1diRyYjgvevMsA_dGMD6XaLukWWUYE_tclFDoiClw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05iivyCGH78kkd7iKHlpszfe-v_5-EMDDO1cwpfVysLg&oe=69E226C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlYYUCWdY_gQ7kNvwHhIoOa&_nc_oc=AdppDKM8GOrniwLFw6X7jV1BzmAshUqpNjwZSDnlHEk8O1VSO0TF5r580M-ikfE
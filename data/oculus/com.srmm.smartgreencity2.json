_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOMEV76degQQ7kNvwEwAOT3&_nc_oc=AdpkIoCSuANB1fDYVJXyNpV3kayAz7PvjZBVryNMKCjldJODGlHUFwI9MZ6ih336UEE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbG0b5ak2y5OPc77_Mx7PZVN6RJzeVPhKzrEcnIOrXXw&oe=6AF9D9DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ULLj5x8dzgQ7kNvwGt8YvB&_nc_oc=AdpSTS9RxRCcS1jZikLKy8B5Yugc0fQbHu7ofSIYqqifKeC6ql2vkK4mv47jMW4L164&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjzL7LWCJldlWVmWPHH_mKuTkQ-1ak3s2FYNRT6qibBA&oe=6AF9C05D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_svq3GLfwkQ7kNvwHPPifk&_nc_oc=AdpuNXiobwTS1CD0zSUoJ9lnLX_thTq5aeWS_7g74OaijNk7_J68rdkMI8LVwQ7NkJE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRppHb6nBfj5byu-e2H2HDCjCQJc-N89_ISU2nczqA1g&oe=6AF9B832"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xe48iLtlRM8Q7kNvwF6TZW5&_nc_oc=Adp2Z3sDto3nMSzSqfVOqxJ0kG21K1Nc8O2S_Qu7R-uvFGmtPaEBoGoq4D6wFle-ZWI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT15NqC7uwlOibcW4nBvymfBEafmhw9WwmZzVF1mTsW7Q&oe=6AF9DD97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8KSdOJAi_8Q7kNvwElIqBl&_nc_oc=Adqy50Ilvjz-xWQYfP_qeZwSerHpATr3lq66awgzzZArliYvcZlMlehpaHHGhH0E14A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr__EeP6r9iTC1E8caZ8J4oRfpldhtCDhkoXX5os0Nxg&oe=6AF9E2D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4LgN3QuJAYQ7kNvwGDdHXE&_nc_oc=AdrBt-gNv4Mv2xvD
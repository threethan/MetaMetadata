b6FmSecocHjKThZzUQicD8j6M088lw4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpf2vxavk71NSr8cGKDdAHXb3wwaNmfCxVlQkLLyAU7w&oe=6A58E132"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_nXEvyYNwwQ7kNvwFFvdE8&_nc_oc=Adrh2zDDB-8yBM5vHkbIhnI3kTSq70YZE6exkhOwiF5F5HxN10jidI1E0obOOrEQCx4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpTM86cgp2Vi9hfQYrYhcxdlTK0NcEr0pyWMm-ZXyDOw&oe=6A58CE57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sGBjpctIJkQ7kNvwEIDUf8&_nc_oc=AdqUdhEs1YNX-LLTpxoRY-thFo_W4ECfUp_ItvOSLaXPHbE4h5k_lbgQJ44D3KmE_jU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFb2skyxrnM9dtjim_l9v7wopha3lLY8wwX5INaI5WSQ&oe=6A58D395"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLauvhjk4ccQ7kNvwGML7x9&_nc_oc=AdqHQW7g-MZXJ9bNYdsc0WwPbRK8rx84i_sYCAW4O0BRRIE354IdXKn15qBkGZ5d1oA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOJvs0mMERz6v9GfeXx_AgoK_3IlWfYqbEqKQrlRmbNA&oe=6A58E742"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPVK8n6R3UAQ7kNvwGPYYZd&_nc_oc=AdpengUAqFmT_FXnsZ72FPbm3Outz14dNjH_2v5VpcbPPE2USd9j1GZukMlHSJ88V1s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDew0uG5WWFp4dZ3F3pFSJVbpNVuYQobjTdlHb0YSgUVQ&oe=6A58CDC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_O7VE1v1JkQ7kNvwHrBH5s&_nc_oc=Ado9ihnPp571iBtJxk2NzNPAsB9eMUWgcc2AFT7XcaTePV5-XcfsrlBrwfaIKVt
o8AjwbE0t39h2sbDSzv2bOzCygObo2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3o4fc-XoSh1Cwqhi6oUBptnNS-RXDxpEx_fZTdsxyhQ&oe=6A997AB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zAuM4x4tOYQ7kNvwGiOQ7f&_nc_oc=Adr8kWoxk06LKQ3sGcBztWX2LReacTeDBxrtuV_B8HScvfWoYIG5TEkhNDU6_QwKSZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoecW2l54KTlKk_4G31P6yhD5d5OpPbbnSZzIAXdPGjw&oe=6A99A017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mRm1Vg1U_UQ7kNvwErvyna&_nc_oc=AdqQj_51rIG5Stiq03ouYIiLh4EfzvjRZNLiiQPV7Hi2u92JnjU7Wjh3f0JhQ7MaGrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR3HDwo8TLsrOlwHCUQJP9G_gjokAVVKi-aYAPmvY_jw&oe=6A996D15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOpOrc9RidcQ7kNvwG7Pnja&_nc_oc=Adr2XruhTFDdCs8sR0jStbMdXNmnukwQqQWPVoppJ8rfgx_tancNwP6DEJsuAy6C6rM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4xhSNHtlBUASrRvSM5nsvHR3GFvh1M_rQA3f_B5pIrw&oe=6A9980C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMygUwpA4AYQ7kNvwF_92-V&_nc_oc=Adq1GTDknre5CwBWLnXkjlmpxlUSdPPxzQKtakI9Q9Dd7erG5HcmsT5S4ulij75qsuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIczbNEcbQvhWioGsDszz1tXAZKuzfyNL0sB6udolxwag&oe=6A999F84"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGaSifnGPoQQ7kNvwFEaIgb&_nc_oc=Ado5gSFI8eAnt0PwCAjmGwL3fzGhRdqUsbPJ3kIr_yQAQ4TuRKvw9lrGALk_ZDf
d3bOFE7kY9w8XMGG7jsn-mMT87OVvR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09iHhUxhlWTV2L9zh4hKtvEl_MczgdfTw_eqZOhQEigg&oe=69EE17B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN_5KsmHeJEQ7kNvwGbHKUQ&_nc_oc=Adp22EstSpoyz9fWfYu5YuFXd_kD4xJcDPcDqM_b46v10oQv0Q8-PkNDhjHwtYrPXno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dRs7SRignxUk_5NMsOyL-iFGRzlkclK-Y3KkNLKpAhg&oe=69EE04D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFcP90Xkv8oQ7kNvwFIMuei&_nc_oc=Adr7sz5rASK6L4fDvDMJCqGtKxxH1KBosqXM_of3tC16LA74qMQqIsq5GaMC7FYLG1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19l4bVCgCy3xfuKSP3tfRJcpgyhSu78R4hprD4QeeOiw&oe=69EE0A15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zChd2tZOqMIQ7kNvwEAJ1A2&_nc_oc=AdpR0XoAc6llwaXt-xI5fMhPVsKng0lFg7UCHnBKRdS6Pn4uYksjqXZY_3wRtBKvQn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FaNllnNsJAe5Y3Jw-ezwKjArsWfiE4OQEk2sEVG81jw&oe=69EE1DC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXh7BaUlREUQ7kNvwG0e8HU&_nc_oc=AdpZNFs-t29nEKnZ3SWBLkC5Nqu0xE4DLVBoj9O8w2kjLlSxJDxaWisdJmwO6PZmnkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yAq5aWKtKMGK9NnYDls4YFJOdEojXNKKdRI2n1xpAzg&oe=69EE0444"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKtrCOavub4Q7kNvwFQu62o&_nc_oc=Adrm3EQQlAeWratU7cA36J3hTw1ZnpcbZFvjmsRbGvhNOMW_Sic33Jv3MLkjsXt
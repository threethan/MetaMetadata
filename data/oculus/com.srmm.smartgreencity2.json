_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1B4QSkfcQ0Q7kNvwGHEc9t&_nc_oc=AdqhZKp8LdhaL9vbxAfBhnFq_KGh7OEMRjJ9HMsK7uwt2x8M2YbXe30nljj3oIlKlyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af835AxSsgsXiJBHy5QM3M6PplQJ3yeUP0FjsZ5kGgepVA&oe=6A2ADE5C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln1dWs70pmAQ7kNvwFl1hfO&_nc_oc=AdphTi9WPq-vXKpwR0IFt7_DTf99dkAtJEZAzDI9jh6LHqzktvFpLIQfeWMEt4KOFw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V9yTFW7A_BQDC5tn51S4gcO1oLN6PKDpbViyYxy3gSQ&oe=6A2AC4DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdJH5SYSKAEQ7kNvwGyVp5q&_nc_oc=AdqJzyM_3OIIZxcqtA3rUXDO8Ib5iL2XUfPlLTtsP45a4DgRUQiAKfvzQ_YZkmng4-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Khq8T_S_BgvVdxfkC--gk0hVMjdxZBrYtTe9TzCI32g&oe=6A2ABCB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4jy7gz1M9EQ7kNvwEv4RyQ&_nc_oc=AdoGTLUTGfDy1TBnxnpBHiHBiiAzvS3g2yY7pMpSRp0r5NSWr9gXvyxcH2G_3gphbjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--WlmaWDqbyY7hcwIC9fo5vDd5-PaP6lKym_yUrRPDVw&oe=6A2AE217"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQE9YrjSBO4Q7kNvwHMnWW8&_nc_oc=AdoVC5uHkZV1s0eX7mrjiBzThTNDVu4J7SSA2DJl25M0Nzn20g58vJVAxYflr3FXZhQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z2uoFH5O3ZvFyTP7tD-apU5Z-NzQyCXJdi1CJ7zPOLw&oe=6A2AAF15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzHcIgdVrkwQ7kNvwGTMIoZ&_nc_oc=AdrKvPxQbSA9DEn_
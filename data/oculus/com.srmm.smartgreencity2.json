evm9OcqOYc3_zTE0jvzJ4xe3YiWje4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFnci8Puz_00pLhwgJz1ECD3apUogCeNCGO7ZNYkCF0Q&oe=6A75E232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75UgdzNv3vkQ7kNvwFQ-saa&_nc_oc=AdoJuQMlIyOo_Ts-hrv6uPqwrb8kQTTk4j9ykCFw0f0zYU7gzMf0ijqkL25DwrETH8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmopDNHim7WzejWl43vcLXm-dir_aSuaQJNaefVSPGCw&oe=6A75CF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiCytmD6XKwQ7kNvwH4Or0n&_nc_oc=Ado7uggQCVsekBNacau_4R93y5Mt8ACxpyHT5oSMwRVlfT9Rstb7yf4Nr99OjWJacPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpJHTYqzGc103AIAN9wcxP00kjzh0EX5nbVV6UVceRdA&oe=6A75D495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2KYVU0egpMQ7kNvwHeksJX&_nc_oc=AdrE3hZo4QtRcx_44iNMlSDMYfYYQQYDX_0f1tlikHkozWiBu-ox0t3cis1Cq2vAXx4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF63QzW_zwpFdxT1wGztHPtYkwRZd5mKSdbSPJt4KWwfg&oe=6A75E842"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8gQTINQNBQQ7kNvwG70kTC&_nc_oc=AdpWLJQr_22UwAe5ntRQ-5c_rmq70uWiJFc7PrBcuaWxxSUoXKVN7yJphWOaoCI-gJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYheeA7VOwJnxhZtdOxqLeRb4LvEjEC0hhmQiUys0a_Q&oe=6A75CEC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRdIjE7iPu4Q7kNvwHMrK6r&_nc_oc=Adq2cx5lTwMUo40mcsPUYmMX9f8UOuA4omVOoFgqVaMztUYPhHd4xnmCkZgDkGs
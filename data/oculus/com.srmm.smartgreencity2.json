gQH4mdQ6GoEBO7WJo5YybguhSD6aKm0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTvIoyLcb54gjpziWWO0CNFGXi1qjpBnemkP1rbyzT5Q&oe=6AC79F32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ABjnWLhrc0Q7kNvwGCUQTT&_nc_oc=Adp75W2FSGduWU-QhiBclnIWltM9so9SYsiZkclOpz1bS2vG0f-wKyHQ_fBWocmwdCk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNurp-ZhlGEVkdbSyRARYK5mg4GOeiOyPh9K5r81ViKGQ&oe=6AC7C497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUd8ifLt_DwQ7kNvwF1Y4VM&_nc_oc=AdpP5C0c-9YZFb1SO0NdQoCIw8ECOzRW0kQjiugHN5PVtI3HgaN7OhvSyjZeBTFFeU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9QXR0boGuZL6HVvxTFLV10SBXRrL7qgJ88BKuQXHlBA&oe=6AC7C9D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOBAQXhTg5oQ7kNvwFERpse&_nc_oc=AdqIQpj5ac1-nXtbX80jJ14QIZobNpR6muTuingZ6Euq9mTwDOTR2zVn4zagcjhNiWU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ3imFheqjWCdZFZVz-Df5RjfDkG1TudFvyHva17FvXg&oe=6AC7A542"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkU4PYbuCjYQ7kNvwFWJgAQ&_nc_oc=AdoPfV_tB_29ZZjqxED-wrZhgC0s3KZEkOx7lq_K2zm_mBQcyyndR2_uoWjVb9lPHq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNch-BqYV6uDhKVSMa3WQyWBPxeQHe9QOZZ8RJHvMjng&oe=6AC7C404"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fHZtFHvFRIQ7kNvwE3ZZmy&_nc_oc=AdrRVG9S1KduzZ4oemA4_f8vWmzchH7miirYSoWMyNIgt88gKJqg43iXxN3yB28
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpZtLVt9uNEQ7kNvwHmbF-H&_nc_oc=Adow96owGFu7EIUsgNs9Kwsd2xzt8ObdbwcwEtDZqkKfpMnJV7hVybfW5PS1B5rJaHI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDez0BxB8TJc4JA6nudOxw74Pwzh6Z8oZkSwiYO4tJdQ&oe=6A6F341C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YugHdIYtRBgQ7kNvwHaFk2N&_nc_oc=AdrXj4D3IfVuoj3S9w-Gdr2NLXnk4YvrCiYCy-RvtiXpVkHQYwAdLnCPCSgulUMddt8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyXGv-1KOlysm_ZQ-039cP4X5g0VX9vG6QwxjUVaYC8w&oe=6A6F52DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B96KVPK8e6oQ7kNvwHS6PRi&_nc_oc=AdoiB0iikbGBdmTyaFV6Z6wC0-MElzd2ZGkyOA0g0yb2ciXkhxqXN3mMGTMWrRxPwaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtsg_tB7Vfy1U78k2VM4ONiJj9aKPbg_VhxDU9T-TqKA&oe=6A6F4AB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g02vsRoFyKUQ7kNvwF4W-0h&_nc_oc=AdppEqIBx5sgLFttZ4Spk9xDn3_Pr4geprYNKBf0zJL-stJbjDR9Ty8wzTejosNivyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFUP52JIYFZqC89PacDY_DyVz-EhsJ4wZSX3QH7YlKCA&oe=6A6F37D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UNdnoriJ9UQ7kNvwEw2woF&_nc_oc=AdpmK2GFF1rRzWBNnR_ScxfKOGPKihtdkyQnP-v90fBoF6PhXMai-wj8OYQGWUbr4WY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMVcLgaeoy_P59pjFBvR-2Fsw-C9fTugL84Zgtf8HxXw&oe=6A6F3D15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHNO9AIYdXEQ7kNvwHIX8Xk&_nc_oc=AdoidlYqVpeRsHaV
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTwmbuT3grYQ7kNvwHz0D4_&_nc_oc=AdrKk5HOROLOfcVCc38L6vGgdVhWyefqikzLurLZPiqaW0kYsdT4cw62w9WY3dlSiCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUNxeymwPjLygysvdzB-eUnka9TZcyM5jVexsqsOm2mw&oe=6A75CB9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvYoNcdXyD0Q7kNvwFpvolg&_nc_oc=AdosEVocvMp3D9FlT6u439w-xo-KZQNzAFwjE-YxlRYD_mFvmpTlAlvLOhTtIDLc_B8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Z1y_ZdmvzLUqnIXC_LPB6Go0U23QP0DYlPMl2JVa6g&oe=6A75EA5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfdMEFGd_JsQ7kNvwGfwi3q&_nc_oc=AdoHCxSW2GfvOY689MLkIosInYOEMydAKvTHevm9OcqOYc3_zTE0jvzJ4xe3YiWje4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFnci8Puz_00pLhwgJz1ECD3apUogCeNCGO7ZNYkCF0Q&oe=6A75E232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75UgdzNv3vkQ7kNvwFQ-saa&_nc_oc=AdoJuQMlIyOo_Ts-hrv6uPqwrb8kQTTk4j9ykCFw0f0zYU7gzMf0ijqkL25DwrETH8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmopDNHim7WzejWl43vcLXm-dir_aSuaQJNaefVSPGCw&oe=6A75CF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiCytmD6XKwQ7kNvwH4Or0n&_nc_oc=Ado7uggQCVsekBNacau_4R93y5Mt8ACxpyHT5oSMwRVlfT9Rstb7yf4Nr99OjWJacPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpJHTYqzGc103AIAN9wcxP00kjzh0EX5nbVV6UVceRdA&oe=6A75D495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2KYVU0egpMQ7kNvwHeksJX&_nc_oc=AdrE3hZo4QtRcx_4
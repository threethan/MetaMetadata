IMGzNtKkOJFw25HIE9oDSGH06wstfX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qtwDZ2l9fbdWGFiJwaTtyKaZTiquCWI4QdYLYCEtBTw&oe=6A412632"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndNrA1xG334Q7kNvwGX6Yqh&_nc_oc=AdqADLKq20XhjyRJ5kveoFZ4w3pF4RIk_9tqHRpE0Y6ryL5sb9XgYTc2HdjAF4ppe14&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ktp1-l3Lxq76ZWJgv7wFSDkaBeiNkDZKjHl_5B5S_7w&oe=6A411357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN19EeXP3bMQ7kNvwEmtarr&_nc_oc=AdqCWyzFgiztP_DFk4eQ_ctEY98522aISabctVqdRuiXZpfXypVo9j9wKguJNogIPZw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-84xeB6CW4bgKViLrvEKeeAUiUY-0XE9hiLewn30ra-Q&oe=6A411895"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpq5XCofckkQ7kNvwETU6QO&_nc_oc=AdoYDUbMr6FwkIfWImhGGyIE-PT1MJTt4QpC0KuWuC1eV7fyzV3Q1DsmLc5DtvGCijU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bHIKw4TW4ypWV5I8v4PlsAa6KNT_uGSGKElCGdmHwDQ&oe=6A412C42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L29K6Acz2PoQ7kNvwHY_HW7&_nc_oc=Adq5fjooT8Bo1_rbMbQDyvu6wws0iE2ftTf2pHqhGawLoSQaJsB5ydTNAQEON-rFlPg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fX6F-zTHSDmslargvKO8mv72a5QKpD4jLpAWp8bAJEQ&oe=6A4112C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWEhY96MlKAQ7kNvwH1ynXa&_nc_oc=Adq6HXZl5WGuHJ3zxuhxxZSvZpDsObe7mAfhns3YXUWpgssV8plWSyK0FEnZ4xR
MVNhW4QpiLa5-hxqKA6igtsnPCOXLYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e33aOWGuQjHq35uNrg3AZ91fQ1M8hTS_GDrKMmi9GkA&oe=6A0875B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BX9ttF-NVAQ7kNvwG5GKSH&_nc_oc=Adq4OB6tRIr7G94UCLgESuMivQlRCUc2OdIan2rOpDl4xkmClDfw3bP3Jg7biYU_1U0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70fr_9BC0PxFHVVaRmvYpz_cbkam3NuTQTK2u8ztiu8g&oe=6A0862D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtINDUaysYYQ7kNvwG2tFqs&_nc_oc=Adox7B8KkryiH-yKOEND1LMCSycbJCxXcybCFcYqNZEZgpCSui5GU3zaGZJi-LHhTM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sTlwyF2fY7ZUyq2_Qrk2x8yVy39qHQCOTrZV7cSD9UA&oe=6A086815"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rD-mvMiANgQ7kNvwFMI69c&_nc_oc=AdqAV-CsXQ4DQzNdlHEGZdRv8uPa1XFxr33VA3xkfEC3NBl7QXCg_TFfkGtnSUyeqSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wTgmljchi2hA-eamXaNNPKfI6FQYUE3s4G4Lm5qdIuw&oe=6A087BC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lhw0ySlFyo8Q7kNvwHHOCi-&_nc_oc=AdrozOL5zu920djMUx-rQTuPM19R3YEV2Sj_Apw9ek1RPNvTvAFnrucV6fti5upCe98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GgowdVLWuCPUEFuhd4kalPM0PW4Fwwf2AedXR226mgg&oe=6A086244"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EKRGSXpMoUQ7kNvwH1yo5W&_nc_oc=AdrR37rjD0f5ecHGDIyazv1u_MGUmCC5LFONQsaeAf9E2spZRiSpuMO7scyzFLu
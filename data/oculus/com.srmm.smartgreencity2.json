_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qxWqxDR-1IQ7kNvwFFLnPd&_nc_oc=Adr7NXI1fkwhAGz5oF2srjFOUtUirCTiI9MgEoORMP4-MudhOVvdDXxBdDx-tI1aE7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhH6a6jD4QnIr1Azolyx4JoVs9Ae6rd88llcaoWz_5BA&oe=6AA6931C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvdish1RF1AQ7kNvwFixLsd&_nc_oc=AdqcQ71_KYi10L1t3mUVUQrPbPEpqx7lrB2_uc7TBaWrd3AZ0mTvMJAVljWgZgIPbHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaNx8I6eP9Zaq9Vb4_zz7vZQz9zJQBp8XiKj0xtWawSw&oe=6AA6B1DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81WE_hY6DHEQ7kNvwEar9cn&_nc_oc=AdpOnMejluVzv0bw_WeiCWnFfubbRY80EEeGveSM0YwTTXqu1Pkcf5SSqgb46ViOHik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAz-kFk_sd5MGC6kcd-snyzm3lTkIure7qxkmlBAx_Lw&oe=6AA6A9B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZCdvcRez8wQ7kNvwGn7-hE&_nc_oc=Ado7K0gEvFAiiFDn2CPjO8QDQUNK4HXpRAEnL8rwD6D5aFAbuuv6JNAsQVTFcQecHWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB1KvD3jVr_AydhrdCdMv-xWJmiCxYvq1h3ZRS9pQ9ig&oe=6AA696D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13c49JOoBScQ7kNvwE0kOWF&_nc_oc=Adra5CydO2eTDPP1x4sEn-RSlqF7SDaviD4XqKMs0XgR4wVw3CmgkBk4hjifPc18v-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJuaQmRgxR8wz0PsPUWCk3xYZ-jPYNX-wiGw2cwXayhQ&oe=6AA69C15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Fj9_qpyitoQ7kNvwG3x446&_nc_oc=AdpaPv7kC09iR43B
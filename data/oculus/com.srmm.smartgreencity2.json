6Fnd9zxVgdocrXZ3sMBL4STXGYCnNJ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjkFa6Vk_X0BZQnK32TQmv2V6yBVXbuotueUU2kn_QNA&oe=6A9ACC32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zAuM4x4tOYQ7kNvwESG6nt&_nc_oc=AdoRD_Dk7cwsSzAci-DFGz-C_B6Wlsw8SgXFPxPQ_MWCJH5DyHDgfObhBgYm3ID65rM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHbpe-h-YoV34G0LqP6v_km9SMv2rt8xeTOJ0DTl2MVA&oe=6A9AF197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mRm1Vg1U_UQ7kNvwGK1xDW&_nc_oc=AdoFu4lA7m00yBbcsxoT24HiPIP47p09w0dogE1TztJCkt4RbqUGsgpUBVSBHRO1rAw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ4gUE-MHuSoBB79DrtEmqYE1JvI_q-naADQQqppaTpg&oe=6A9ABE95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtGEHZNU2ikQ7kNvwF0PU4u&_nc_oc=AdoskBgguS4WmL1K67a4-n7tX0fnfRJQyjsFy8i2Gol68ihuTZNKLIr-mQDrfKH3Wbc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8WkLaRXaIwE9VDvHxsote64V6BLJKbVsMI3RWXnOaVQ&oe=6A9AD242"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC2XTpAwxzwQ7kNvwFGMQXd&_nc_oc=AdpMS9nG36y1oopHytLQopFkfN5TUqG77kcGVW1ZU4DcpvITdoQ7a0rSMf9wyxXxr6I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIImNqz1lFnrsMu-TS1n5IbhputPPiqwDhgMbCI29mQyA&oe=6A9AF104"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGaSifnGPoQQ7kNvwFtEvjf&_nc_oc=AdqVHcejmBePOc112HTHBPGAk0jGt7AXAvwOhXCEny-ARsy8RpHgXsUN1BDnK7a
uY6LnzDG63o0unvs2oP7ilmjCgU_BUg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Gtt4UWR-3QeGpJjjd7ofcbVXRsX9Du7fJ3-gqF7DTRQ&oe=69F600B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK3RWtGWzQEQ7kNvwFVkpKy&_nc_oc=AdrkvV0rxZr9SzXQBctqxGxVFuIlIDlolUpEEJESQa_MwpXNc977fe8vLwh6Ke1AEIE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09lMaFnmrzMVkkJKTLTSqPS6OqQgHvioWRfLKjGygceA&oe=69F5EDD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQwkK6B2swMQ7kNvwEAwJfb&_nc_oc=Adow4K9f4vxVivvBkiCfkYRUKN_5bGozeflyGHlouvetR1c7IigkVIEPBVYC1FeAXsE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kAIfbT5EYP8LKhfrTtoTpIhxnFmcjJTP7ER1IA5N71w&oe=69F5F315"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdJFxYSV03QQ7kNvwH2nGim&_nc_oc=AdroNTUfJknqTlruKz5vkpRB5fOET9yhuihYppBMfO2AugKuN6VrCJiAuF51e1kGZY4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZLl15vpcwzl1zYzv_F88swSRutc-PBQtFmp1dF6x10g&oe=69F606C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgo3rpWQxzEQ7kNvwGQ-g7-&_nc_oc=AdpHchmskT-wTmbqOPVitOtl-LMA3-wh0Jc-A4aTqlnzMkC57YyjY2Lm6C-PMQAibhQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04za4SHuH6Fmc_UAD4NV6zuFXWxm_yzp_QTpGJ6sottw&oe=69F5ED44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2tgWg5EgTUQ7kNvwG7jKSa&_nc_oc=AdolWyCvVNuIt_c0ynQRof5_GRSoTqkiPa1vBi5I4f8X3Es3hIhZ4H4X5sog34b
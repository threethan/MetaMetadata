_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbWXRRr9abEQ7kNvwG_fCM0&_nc_oc=AdqClIxYLDg_tbw65FR2WNttxn4e6Gz5fs1aXY-I0O3JKFXNMr7uc78ZPAeTKoO7Dcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJaV8fKIXRHIoIyQHwc2SdSITn0TQCkDgDFQ2jEMNa_A&oe=6A62051C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgATsfQwPWQQ7kNvwFDfg8O&_nc_oc=AdqwZS7OSehrKdd1SzhflDIDIJv5vebFX6NWrcsWbGBX0DYGElvUct3UhD_JuOPYHNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFnbVx3VprmIhTa9tNyvJrzeR3aTcmCqY7o-tzFecr7w&oe=6A6223DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TORdhRaCkEEQ7kNvwERY1o4&_nc_oc=AdrPaAD-12gVOrwgOoGjjKtdRifKBnt8er_vrx4B3nqGgdwbXbvnW_aYxKLaqN3tOoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPTHuSBsvdngabdXxpv4FO_n5NPBGveC2TyFBZv4gMNg&oe=6A621BB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp1IR4M2_CAQ7kNvwGrvlnT&_nc_oc=AdrRvIy5AGayijjMzmhfutEXXij_Mzh2UeIOxAjoABRpTyXWOP45AoTwOUapcFjUr1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxcOUEqlztRMxFdceg02CS1fvWCP2NkeX7O6UX9tq_9g&oe=6A6208D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBQfYjXlZnUQ7kNvwESEkY_&_nc_oc=AdowdJD0NJLwnEYni-AgBjozyr_tH3oQX8mUeM-bjFHvM3Miaw4Lp2Oj93S7NCe1q8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbEDM9NxDmAhJmuYuXydTrKPucXRusZJhveyzWmMW70Q&oe=6A620E15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im7Qlym5KjwQ7kNvwESYNFt&_nc_oc=Adrbht8yUx20zmFo
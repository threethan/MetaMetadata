_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO0K2Y5_3BcQ7kNvwG-JbDc&_nc_oc=Adr3wUSmLoZejBvLBzmuW3XG9Rn_71b20rmhyIlgsZhQ-emfgWDp0OodSWBX-0H4Irs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3n_cG_qchDLU9-zXbOMFh1EU8KGj3W0CcF1nOyCTIXFA&oe=69E4C69C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZbFP0eq--cQ7kNvwGZHfZ5&_nc_oc=AdrYUf2C7NsvEi3vI7ERcON0IBSpWCmnzAG5SYI0sSEUudmrxHjKNwouk8G14wWFcC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GnMMmfEiXz1Y-hSMXN5cXKZLIbrJe3aZwmj5QmUYVEg&oe=69E4E55D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Aqn310TzEQ7kNvwH045vk&_nc_oc=Adp7WqA8KNZQiMOMbMMN8pkelqLS_cQg1Zibx9n2oVjGBAQC5JpA0Jj3SqJ4FMjQAlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k6sB1Hq2ypfnBsiXJaaqVKrMaIQZVQfAduhrVhA7yUA&oe=69E4DD32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2_venUNwhAQ7kNvwF9TQIk&_nc_oc=AdrkXJAegJqbZTtIhqxgcq7WF1-5HAYrz0NVjsGsqRyXMGIvkyiFOi5qFoY5dYdjOd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09_Pc1NE4uOM7XnLAsqyH8iXLubmJeKYpLXko4urB0RQ&oe=69E4CA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guh1yJVp1g0Q7kNvwEG8oVP&_nc_oc=AdpdG-rQM_wOyC7672d1PN5NuKj3D8ncACH5IwcSdUhVk4lLrrEPWvyRiWY8SDSVyDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Yb5TzRcmBWGtwWLKkga17HhQk7q9XDV_3012B9NF8ig&oe=69E4CF95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enQgh3Q995cQ7kNvwHA24yf&_nc_oc=Adq5d8yOPCJUliN3
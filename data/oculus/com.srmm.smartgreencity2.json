LTtsP45a4DgRUQiAKfvzQ_YZkmng4-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Khq8T_S_BgvVdxfkC--gk0hVMjdxZBrYtTe9TzCI32g&oe=6A2ABCB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4jy7gz1M9EQ7kNvwEv4RyQ&_nc_oc=AdoGTLUTGfDy1TBnxnpBHiHBiiAzvS3g2yY7pMpSRp0r5NSWr9gXvyxcH2G_3gphbjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--WlmaWDqbyY7hcwIC9fo5vDd5-PaP6lKym_yUrRPDVw&oe=6A2AE217"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQE9YrjSBO4Q7kNvwHMnWW8&_nc_oc=AdoVC5uHkZV1s0eX7mrjiBzThTNDVu4J7SSA2DJl25M0Nzn20g58vJVAxYflr3FXZhQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z2uoFH5O3ZvFyTP7tD-apU5Z-NzQyCXJdi1CJ7zPOLw&oe=6A2AAF15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzHcIgdVrkwQ7kNvwGTMIoZ&_nc_oc=AdrKvPxQbSA9DEn_FsgHrPgRuA4yISsSfMOWVOKbfM0BI4cplNWeRbGcsp-78Yhw0Yw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8THOO3BmbL6XSYomN_4YEHDsY471lGCmpazGfK9T6T1g&oe=6A2AC2C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8pcGv85lJcQ7kNvwFW_0sr&_nc_oc=Adq_LYSHDF3IxwePE_cuJPtzuMYzz0YBuR8UmcEbs4rksHxhyq2wGNv-p_BfOIXA6QA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_GPG6MhUZS6jD5zTpRePIaxQoCAQiqN7po4dHsRRx3A&oe=6A2AE184"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE4fllBfB7MQ7kNvwESD4o2&_nc_oc=Adql3sxnWgvF-WY9eMkZjkpjZaifHhRGesuciBGwxb-COtgsj372iOUnpvnSCRu
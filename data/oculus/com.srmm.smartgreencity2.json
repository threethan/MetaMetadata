5DwAsXgwx6TdbpBqnMtBmC7W4etnRrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-rEnrtY55OHV17eaXRBHja6iJLVuwDG9aSTl3D29Nfg&oe=6A79D6B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPUsNsmsfdAQ7kNvwHUfBJq&_nc_oc=AdqwXoMaZc2yE0_0hPHTjmFqaBHgl7FDOGowrP4Ehd7ZBAw4PDYIWr7XfBp4K-sZ3PA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8lEsOhw9puhqEJsU-EaUHowpMMtbNpPM1w0Z9I5nCaQ&oe=6A79C3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSjPAvBKhwoQ7kNvwFkuClt&_nc_oc=AdqRUQaD5dma2JgrHb33zB2ZyLCyvpa1AfTqZ56k4_X5-QuXeJnFoVSSIAc47NgjPFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBdyUw9SQ8ZVzaXqZMocls2dyDgP-eK9Hkk7OLHNaNUg&oe=6A79C915"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQWO315w1HEQ7kNvwEUt3Xp&_nc_oc=AdrLW0aWEGQl1p3tLA1ip18bNNCLnmONtQZzks3GkbWyDE2jdlmYqxrZRZEO0SlVt3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVvygAx1zHC4IlPBoinuYO4HpEzIdx-EXwiObTXMuggw&oe=6A79DCC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjO3kOzf0S8Q7kNvwG7h-gQ&_nc_oc=AdpyrMsh-7rfsZk1DDiKRS_kC4MBRHVdO13Y7VANF6Dw1QSz_2qrR5NUr8fJT-aZgas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCXoVt4kPNzpmm8I7DWapnsVMaV-hnb9Fs-af7RcgPhg&oe=6A79C344"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQGMg9O2t7YQ7kNvwETod-R&_nc_oc=AdpzB_3MT7W0ax1byPAwrjeWluUWuajiq-1Ri-ZOEny5XVMHAbpx8swMExGrRe5
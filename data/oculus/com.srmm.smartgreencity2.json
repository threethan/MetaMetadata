TUwX5iT-zFmSMXHXn2l1LgqfkCTvVbo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_diGAIB9MR76Tu0yS5jK-9Z8kcDZGOMmzRFhzeLTuag&oe=6AA01232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwUwm5iZHfMQ7kNvwFhTvV9&_nc_oc=AdqveJhgumtENUlv0yPR4WnLoxwepGRWDsRmKE5Jh38_J2rJtFxjmwEXvDj7k6trT7g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj_HObtinvQSbZW5z4CNWJffTd0N_IRagHqQU4FKuEig&oe=6A9FFF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0_VRObde9sQ7kNvwHflxVz&_nc_oc=AdrRDkwJHD2gDbZFM6BSMz-z56KI-LVY4i7lvI69EOPLu-UY51qq-NSoRm-R8VIVtSc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg7zb6kIs9_qceb7xLM5Qf-IXBNS-CvYUgBDv79ymrlw&oe=6AA00495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW7jVLNYThcQ7kNvwFaAnR1&_nc_oc=AdrsANPpgG-edv43tgNAPRSFAEQ0A70h8KY-0UyomG1xcyMVWliaPiIKMsnmyx_OEJc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2sioIBrkcgV-MdBCwJlJ6CdZlnJ-w6M1Pyly9BdJoQw&oe=6AA01842"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lzmWcKVCCUQ7kNvwELeZBd&_nc_oc=AdpovHz9Ce-bJfqQQSsghqmB8EkRl6iEhjPcimrRlj49BzQQZwJs-6DKNov9K-jD9Sc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaRYNQD6hbau1UcbDuvtj5nh_6Y0OCsfLyUqixW7ef0Q&oe=6A9FFEC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-lF_G23KYIQ7kNvwEmXWPT&_nc_oc=AdqWLqYblraqhWKI4wE_lFFYrlnbSO_wbxEQLwHXoWboQy3Q8VPnG5oPSB7JQM_
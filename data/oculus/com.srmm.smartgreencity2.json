VJ0lDzq4_A2xuH68USYtiG8Rd4l5ukE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdqy8ooEizMGlgkFG2ed_QzgeZgx8vQY1qYwTkAqfPEQ&oe=6A709C32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g02vsRoFyKUQ7kNvwEI4O4K&_nc_oc=Ado-i2bR9p04WM6KkAbanj03aqLewQy3PsXuJB13amyGWv6rtw8MKVP1okssgZFwtwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB5l626BzQvQPyNgnwUcgFdKXC2hqcXdAyR62bt4VDdA&oe=6A708957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZOzLnwFbnsQ7kNvwHA8v2e&_nc_oc=Adpgfyz0yEP8hsPI_WwxFeNI-4UzFUkIQjyBkOtyMk8oD873fdZ6lHlqAUUxg4AL6e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_qLqE_LunrALjH7JadQ13x1NtLYtCpbwj1lnMlmmQCA&oe=6A708E95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHNO9AIYdXEQ7kNvwHXv6sJ&_nc_oc=AdqPezpecopXrUwxLhahywsvYk6yRgUPF2qxBjFcM4HVYMI4kUpjDunMshjegH77mN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2mUT6ycH9yv9Tiu-v1WdAMOzZMu20qemlnNcIxlzjqA&oe=6A70A242"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4H4XmExINUgQ7kNvwFLCk8l&_nc_oc=AdopKZyBKnsckhO-bG4fAvhxMrUbY2tlor31Do8tamxdHNySGqr-FLKyaKO17uQZsSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuhhFBNG5tLHhb2zNBRS-uaAg-HjWp2AMo-A39q-blpQ&oe=6A7088C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pidkOVO0QEQ7kNvwGi8f6g&_nc_oc=Adqc1Rc_WVIaSUePqV-TJJFcb0E9mCAloYhjMoPNKI3k2Trqgc3HhTYuznnOJ6e
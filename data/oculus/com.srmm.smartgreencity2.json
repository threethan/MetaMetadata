dZzcTnr_LvjCn_dA2mPO8g_qgCP-GOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BiTNTkX45hvz10khs1POkcde1aNDQZAMCk3kYpDQmdw&oe=6A2819B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZqkFz97Nk8Q7kNvwEfp1uD&_nc_oc=AdrkgMsHTr0nRmTmFGLe4gMTncsa0K3oIQbwvvT4h2Bz4xigtExdNaxSVdbiXF8z0Eg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lpLLaUosgykWPUCoTl5XleVYXiYZt1FGWLhqkT-SPzQ&oe=6A2806D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bw9OodamwJAQ7kNvwEkz7hd&_nc_oc=Adpbipg9URDhxM51dAbWAaS4jzCKplwkPjWPBVTqtNDLpZrYPfXZETABQlfCeHEq-Z8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WpMV6XdTvHLHDi2-z4owXG8MNRiT_Qu8nccyN60YPaw&oe=6A280C15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzHcIgdVrkwQ7kNvwFgummy&_nc_oc=Adrpdek8EAnJc2Fx6VaHwPpneasDidyZrr54lGtYLgj9lw-c2vJ4_aMjm30dL58NvI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-COibxyBb-jJI0dOF_6I0Z-_07MNmIU4lg9xRAnGFJxg&oe=6A281FC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8pcGv85lJcQ7kNvwGDRsTx&_nc_oc=AdqkWHY6hxE1hKV2oS78bACVN97nW9yFFJHCEJi_yUiXu5YiHwl0AW1XxJ6o1NzSu3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YVX-2FwS_hukNou3dyL79fWK0rwU_8mMy8bmuWDVdrg&oe=6A280644"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Squr4vb4dw8Q7kNvwGugDeh&_nc_oc=Adrc0zvU36qMwXQK5SPsHFIwvp0hjcjimwQEZgEe6xw18-GIcfPjYONO9ZbpW0K
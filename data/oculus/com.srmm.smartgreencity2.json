_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMxsourElA0Q7kNvwG9ioGn&_nc_oc=AdpoofpTp9jLrzVTN8l0lk7ulsy55vKVzt-B2hzBeMvcMvLNNsSaXsBmqVlbctr7GP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4bwjTWJVZIgQMwmFZJLiU9SOIYl_6DJhEqkltQlttuQ&oe=6A5F621C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LyStEYzKeoQ7kNvwFD9Ye_&_nc_oc=Adrx4_aXcHZl5uQUYO0hFn3DGNABpFGgKBhl3aR4jcv-Mq7fInnYuP1vlST72fK_uk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvWc4I-ThWRoQVeI4YuggKAtRAJ2xJ1Ah0F0S0iDfK4g&oe=6A5F80DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knZX_dzcvDAQ7kNvwEuWnoh&_nc_oc=AdpmaHrQd3OT1SV_86IMC8WeeYsPmwqv3mljmPsby2Icvo82w286jlRroPoyq-p9eNM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3vph-9b2Bsph78xC4AJHK3ql2XqwA9Ov3tgu0oICq9A&oe=6A5F78B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ki30UqsfMQ7kNvwEbkuW_&_nc_oc=Adp3IZu__D0tBr_nE28tYOLcyVoMDH_VotdOVklaLO__ZdaFEaPmqyKFm9gW7_QMF88&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvm5T2rhhvizFnQZAs_Tayym1ydKM32GLbs7cxLwFHLQ&oe=6A5F65D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8CgwmFyyQIQ7kNvwEc0_6N&_nc_oc=AdqxreETqRzBzum4tbwxTJtuKP2eAxrTRNg4LBBpx75suK8eZPU6e3_X31lvSyumJ04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvdvOZXntscKDqq5Y4KY5kXaJFoFnJoGEbmvlLFuzFrA&oe=6A5F6B15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im7Qlym5KjwQ7kNvwGJ7UgE&_nc_oc=AdrktvFdT3V-441t
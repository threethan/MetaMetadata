_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRLgnz4TBNoQ7kNvwE9eNiS&_nc_oc=AdpdPqOaoGaZUZiyJVvPNzvwsuZP1vDTGE0vd76Z0NOcDWN7m0g7Qg9FSoCgioMPzI4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RRFt5EBlTLOMbDChnHiHZhHkE7LYuWsnskLnaAclgaw&oe=6A32C75C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzjMNO91oDsQ7kNvwFDNpB7&_nc_oc=AdpQ_5UHAtq4CMZ056IXkhzT2OWu6OvuFKAsyg48ht0dUZJCXl_CnRL8BIiUzhRiVhM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hiX1v061bjnX10zb-4KV5-zP9AFlxGuxwTXOrpPxeMg&oe=6A32ADDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ag-Q8ggsbgQ7kNvwEUjj19&_nc_oc=AdonC4DRgoDjQ5wY8C6Dmq_XNGdsOyZEAMFkEenaj_tUUwtIzKpTWbd851qWptcJm_Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wsza8tTFHqsxRb-QABP62ityQPTriOQZYgeqTdfpegw&oe=6A32A5B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBuHT3Phs1EQ7kNvwE5hPtG&_nc_oc=AdreL9LkvEo77x7yv5u-1MgO-tDTfacsdPu4DqMDFdg_uVz5elHSj7QoUg4CFp81IgQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EnPbx9hfaYiOdl1Hi0ZrMkF-CqSUe5u0elcMcHnTP0g&oe=6A3292D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1VzpWIFkYAQ7kNvwGsBeJA&_nc_oc=Adpm-w1F27RKE2TW7BUjjR1M9rUSDtdmrbL8BiGNAXtdKdI6LVwYiPiPw6J7cIUJHRA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ul8y-dL7I_6dJM5kKeHjvdXSJt7h4nTCVkejnItOs-w&oe=6A329815"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ix-HDS-9tsQ7kNvwEbubnn&_nc_oc=AdpHnpLsC2Jgxx_k
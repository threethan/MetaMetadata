_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTwmbuT3grYQ7kNvwECdWWK&_nc_oc=AdrJr3x8v2nNJYypqUX6hV4N0MToy4QEYwxNCgjt-X8l9DFUe8wFGSzhmOWqgxuVr7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9KhtZno1mQeCrqPff8m7d2qtojco3R7BFjG_zPywZuA&oe=6A771D1C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvYoNcdXyD0Q7kNvwFq8Crk&_nc_oc=Adrvw56p96nRBNFjz_1teKVKTZkHa4ecJ34ukMO7i489ieW7junoCKnojRTFW9bJB5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNoHJ1XVP7futewKSA3zelRA8pfAkiEIkJi-uzyI0YQA&oe=6A773BDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfdMEFGd_JsQ7kNvwESKbQN&_nc_oc=AdpJctelG8qEWSBydVpmYpEIyh-8JhThtASBAd_TCyKMiqOCwxXzABqqP6A9BdVVA0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsO7zpyF8guC0pHOC9f3z7YDm-kF8uXeHgI8HY-jcXcQ&oe=6A7733B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75UgdzNv3vkQ7kNvwENK10p&_nc_oc=AdrLe8RkNyt70FhC_JVdbckqiEC0ZMWm66U26irmVzFpEhkyeuL0lmD-u1Nqip5AawA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnVj2CXm5or_2D2g24qLqE88mkAWMm2vAf3jTTQ4aQbg&oe=6A7720D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiCytmD6XKwQ7kNvwH-KS30&_nc_oc=AdoVg3k1Ozqtq1bwO0FZ22klSJbSOM8xI0IkLsxFnFFpez1QUnlrJCoNWUoGvndEgzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSWVWAumQfKHMbxlmUw2zMIh2S9V07B15-V-WFrs_COw&oe=6A772615"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQWO315w1HEQ7kNvwH0K7Am&_nc_oc=Adopvqxg28bX_r-z
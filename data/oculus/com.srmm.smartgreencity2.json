qAFOvp8L0lHC9tlH75fGLsZRy4HZtX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XT8czGRYpFqtlM2g1zj6QMBQlMLNn2RfuMojXrTW_4A&oe=6A1301B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOlS5UClYc8Q7kNvwF-Mkur&_nc_oc=Adq4XsxkQgfLQwbLN8F5V7J9e8TMWl_akXxmhhmpeqJrLOOYJo2r0DXpzH8SlpCwv5Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dQpY3gSfuaXZe4R2pyv8Iyu7PR_adOkMlqoTT2g4AWQ&oe=6A12EED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0qvJ33hbnkQ7kNvwGCevS9&_nc_oc=AdoN7RnEISkz-Z9-QYiACikOnzO2JZ-SKBoUMy0KrwHZihOeMw5ZtsskMlRgG-KIy5s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xUJ7bSrd821X453vdA56qVXS0a7MT-uziItntJhYTlg&oe=6A12F415"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuDEvT1yv0QQ7kNvwFfeflm&_nc_oc=Adr8qigQwdPXn9R8oY6cZREcTqEpyDo_RcSUO15MBbDIaamLZ_tc14flZnrH4WD4NjM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7StrzlMlwq22sTq7ThGVhWLex2ialpk_fMYDfA5P1hpQ&oe=6A1307C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnEs-WHnI-8Q7kNvwGNnu-c&_nc_oc=AdruPguztGgIwJz11tyAkeBQc6YH3GCmqG8SX7fddVZIOEQgS7raU9KW-rT3tezlVAQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pxBKvcUUuJMAyE9VUwKh-m__vYGya8BXcOT3MBKBOyw&oe=6A12EE44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBM_e5sjtSQQ7kNvwFLQTc6&_nc_oc=Adp39taOSaX4gZe-80cq43pWSu39J9VE2zJ0B709A0wZfgsnd9ESWHUL8rUvz7A
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzULoM3MBocQ7kNvwHd5uEl&_nc_oc=AdrR3KoMtu5L9m97K63OYCPkuNgJH2nMm8K7V6PXG3-abSUzC4hcWReCgiM1rHkQglE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YZxpcFzfpPthQfmg54D5UMXdPjfxgxo4Bm_C9034fPg&oe=69D2519C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W-EJfESht8Q7kNvwGAMrw_&_nc_oc=AdqYAe_5GldGob00hTIu_VG7wwn8ZCtetX4GhVI4GpkiFEPzXAgJXN8-cJn0U19a1Sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jYysM2QkwMM2O4v7IDoupEwfbLNMYlD83Q37ePRiWZA&oe=69D2705D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHbNBU4NpDwQ7kNvwFkLsJN&_nc_oc=AdrLnGjf40Wcba3QV6LYzzoDNRF2H2fscJJ9UMcRumnMisZPhrIey8_U41TkH0UHdMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0njFXcOdzKqB6In5SL05sNuUWZ8yNVvT-uCUVza5kDYA&oe=69D26832"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=485X1uh3vKEQ7kNvwEgufDv&_nc_oc=AdoC-Al03SqeU-TBWClqSLu2EhrTaNJaqDAICt7aS5EMxMAMBTD8HVdkwJhazCdEMY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VP7OEU-7HP-zXdqLHrQD56g1qUbug5AqU-QeHtiN3eg&oe=69D25557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWqXaOQctj0Q7kNvwE2AuEi&_nc_oc=AdpfluSvHZg-pfm7fjJJ413ky378_bC5D4nCsU_cxgvLEXGa_CZ4ffUNis8HS7ITA6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03CS8MRmXlXsPej2u3hXg0BUgztgmTbvMyRaq4N_XDHQ&oe=69D25A95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1h0VV3XDasQ7kNvwGWjcFG&_nc_oc=Adrq7OWznstyg-gm
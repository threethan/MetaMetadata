WkaMpr7qNPh3mxls9uYJo6GFdo_mq04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqH0ftMcBA2PLtlfU6mz4EOE5wlqidKU9uhqLxa91U2w&oe=6AB7CD32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruddxp7Z_GEQ7kNvwEjiWnl&_nc_oc=AdqF_Jd2l-dYBq4UHkwa-EfqBTVgq65qodwYiJBUam4mIO10OQh1EsKzs4mO-wcogaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIG1_RWQpzbY_BRB2iz7dSJvwJYj7gkAs8xiho7J0xwA&oe=6AB7BA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYX6YBhTwd8Q7kNvwFC2_0N&_nc_oc=AdqZ2UYBGP6WwLScszyC_HOGGcEw7RmPliFoWEb5EK7rtjDgzxAuG2l_CydsgKNGYZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKaca69wEVFwCrc15cVy8we1PiUhWdFRxgYTDIMjNuQQ&oe=6AB7BF95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RV04yYuwKYQ7kNvwHF_QUq&_nc_oc=AdqGWdw8u82KH7XfRNWrdwBn86yH5dfk5n-OpNsQI8Tk4oltB8lcsh5WEg2D9AQLvkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbD1OVzujyYUjfXyL92O6Ah8xg6Y_mVQU7y5GUGbXOjA&oe=6AB7D342"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQyYKQRAzNgQ7kNvwGE3ZwX&_nc_oc=AdqqZvOxzo1A7FSQ6SctX5sq9s-MKcHh6lNEuLdo6lqWXb2VmtYe_oHZZzFay6jUeWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK6X40mL0lHnIwZFzIj3KtyE1zdhJCS9XGtw6ADO_CGA&oe=6AB7B9C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5m_QhlgDG0Q7kNvwGRfCAB&_nc_oc=Adr5cIEUq_dRVwuMMehbDOXJVzIs97WjzwzG0Z7qARS9e-3whOdjNwnn0pqNp8R
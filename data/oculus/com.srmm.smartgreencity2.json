5q8gIYQWOVP6wfAfnz9Apfd3UDZdXRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JWxIvPoQ4sYhmzVcc05qrApnpNfEbu4mD1yAMqYHR3w&oe=6A072432"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BX9ttF-NVAQ7kNvwHfnh63&_nc_oc=AdpaYdBEc0eRX3bPpNuRWtMlf9vmXKJ9UMdOTwDG6vuLzPLxVqYquyYlME77CRX2RiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cRZQbjYBZXf4Kg9v1ZVGI_ormzyKtU4Tnd24CRIPWTw&oe=6A071157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtINDUaysYYQ7kNvwHV1l4p&_nc_oc=AdrCsnt_tC-swn-1SthcehzgfgD3BBoc4vcPNM8L6eiteV_HyIHHgu0C-sBX2jGogW8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-GElLs6URO_JTPzYjv3rYPx5jWexRbbvLxXp8XJSHcg&oe=6A071695"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSCBZHcwg-UQ7kNvwEjv1Ca&_nc_oc=AdrolyyQWNPQ5FiZ0_Pa1pHrTNT72F6tUNK39I155-zCvMBxZbHbjZtC37F_-WLLtVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78uGP-reyepSDijQ7EWK3sG-Mmjktjk3JBdt7edexBqw&oe=6A072A42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu3aJaQt1aQQ7kNvwGPkEgj&_nc_oc=AdqfVgVNVMHZMTlsW30rbRcAUuB60bkxdbx9W5jbhRwAlHRgfEeRD2VQ1iu0w77kAdM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zs3lxXrRMpvMNM4FbkHgwVkDEZ1aFd6A_YWY_HUslTQ&oe=6A0710C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EKRGSXpMoUQ7kNvwH-l3jP&_nc_oc=AdpHedID407Uaj4LPpy7M7DEA6XsMmtEp2vPLknoko9b2iKin6XHgdEnQkJxzFV
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJerzDsXX8cQ7kNvwFUYpqo&_nc_oc=AdpE_3qCKo6gW2r4ecVzw3NSRnvnHKbrhWqMNFLeCJTaycd6mwxk_EnqZn6yaP2nksU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL_mqrqW_f_A2IugLxfx3dgzW-g_4U2i333fHGlEQmHQ&oe=6AE764DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq2xWEvYfEkQ7kNvwFoMQL0&_nc_oc=Adog32T2SKBZoZc5t9InFjXLLeGGp_LVDitemQ4xs1mgw8g9uTzWYRnllQob1ZbRbq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl_2y6hCPIxqbDrx9U9QnWxSkc1tdNQpSWdacZYBBP6w&oe=6AE74B5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZHlISA_NA4Q7kNvwF2cKfb&_nc_oc=Adr8qj--JQRhjniQmwnS9kCoXRSsFZFuuoyv2WuLgpSDug55yngicS7Jw1ewuWYpDfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQOZev8QTJsZQotUIZx-3FqOLaJhZ8B0Y6AxvLa9-NZw&oe=6AE74332"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHrglUFsMJQQ7kNvwFqPbu2&_nc_oc=AdrmnDvr0rcwf7tqNDu-BvT1QZgA5xJxqq1iaqBqBojr1pqBKtdVvWtRGSkahnNIh2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJN8uvR4yvAVOQeFATGEtKMXOwI7-b5cSYTcDKMWt15g&oe=6AE76897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNNISHBhvlsQ7kNvwEh6mks&_nc_oc=AdrXiETtoKZrdIbnX4W4r16v_3Ba8x1OKiBkDwVqGY5CXdxJUYmAJ2hYyCvwK-w0Bqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9nn8p5XWpTUSwnPHp7_sIH8hRe2rT8PchtiawbhbpHQ&oe=6AE76DD5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12egQ-3_wHkQ7kNvwExTOLd&_nc_oc=AdrYo6acsYIUurS3
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1B4QSkfcQ0Q7kNvwHhsG9Q&_nc_oc=Adq7uuwQuhrsDwcm-LlHdSOlZS_v5jk4P1mOYG5vbq0J-9EaljGjQJi7Nur8OXtvfSg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af956hNPlSTP6Xp29Qgn31NAWsFZ_UYoQUdJXpAgKkKa3A&oe=6A2C2FDC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln1dWs70pmAQ7kNvwE9GIwo&_nc_oc=AdpBf4X5IiBSVeki3CsVkpUR0D1ZY5I6GTgL96TV4yuT11aakr1yTFtfhlJp9L5UuJY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rde42YQLAoM2lwFTwgMQsI2ScQElT1F09m5FRX6hcJw&oe=6A2C165D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdJH5SYSKAEQ7kNvwFPWusV&_nc_oc=AdpSSmPOibo4zW4MGn1NypOXfGdj-nQ5tyqTYKA1GL9tLfhDGN5bYrLSffh9Ttu7YBY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MWO9V64hPAPyIxKanusPLmvpZOKNpHefKtjzZOxbSYg&oe=6A2C0E32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4jy7gz1M9EQ7kNvwGPTFRs&_nc_oc=AdpUgTFmwOpcAYWX9LEse1fZmzRPhExk7YgYss4sEFsiEQtTccJYUAy3nX8uxuBzE1U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97o3WjOAZmW8lLnSRpRvfkVqkayjELW-XywE4XWP6Xsw&oe=6A2C3397"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQE9YrjSBO4Q7kNvwHSlmvA&_nc_oc=AdpWhraGPUXoJa7pF9kONIbgxASIemGVPx2nObh7KgokPqhWSoIIyN99PpyvrsAHdN8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bJAvpCTHA412C-2FA2xat1RlrLQyXI8ToCd7fBM2_Vg&oe=6A2C0095"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epy98DiQSi8Q7kNvwHfVRXY&_nc_oc=AdpDJspWIMU0_K9U
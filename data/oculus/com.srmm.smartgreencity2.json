_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sG-M_oaHmcQ7kNvwFBc_WQ&_nc_oc=AdqRXIrD4nISEYstbKkaA-kGEARjoWcfly11jRZshHFn-BWJvi4Z9jRm9f0NR3lYOaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASfq-gNV1jUzRAK6zW8AWexKhm7hjj_xz6kGBnSSWKoA&oe=6A4B9B9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPLHfiO5_2gQ7kNvwGZisZN&_nc_oc=AdrsVqppLWJup2gOQ3zKlZmttBApbs7y7oI99BsVddEr74IhiQccBpDSftxBI5FrepQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhsw9tiQjfKK63VK_7GNY-hUEELpK0ti66hjx5-a0gCw&oe=6A4BBA5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2LSQmxFY9cQ7kNvwEFUS4o&_nc_oc=AdrGlFKkEMlQ3hkPuvXeUqJ1u5s_dLEbXEY13ZPXIHwPO4pKGybo6xe9pleTEkh9t4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC38lAjrPpVzLK6CTeee99_oo4Uz3aO7uz-W6u53Ep5Cg&oe=6A4BB232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4KPbW9gFsAQ7kNvwGV6KZN&_nc_oc=AdouBSg7O1aLZvXDFx4sWTpU4PvpK7CwXKfzQ2P67o0F59iTAnePQTbU8FlvWC9PWxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtI7sJBr2YWW9znC1JgD6KS0Do5QkYos1wVzYRYzroZg&oe=6A4B9F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im8nF0benLgQ7kNvwH-7P_C&_nc_oc=AdoA3J3hG_Rg9BTfWrQvQNQpruVH640UFOUObml9Fp3p6SEbXQaTnC2RXV9uFSOycPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI4sxphO6TRVXxb417VpyTIstcGJwSc_7O3gn05mEdBQ&oe=6A4BA495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3U2YtxCh3oQ7kNvwG6P3Zu&_nc_oc=Adqt9xe8weGR25Ig
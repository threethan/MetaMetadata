_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpZtLVt9uNEQ7kNvwExyHnr&_nc_oc=Adpftx9DUqQgjKZTPU5uOhALiMCN5_P4nyxmkE7jw73-nR8k4HsJk48K-useA_Fv7Bk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeNKf7CGmh8sDjiVuhBunz2vo7EoXmzCbvdlh6k0CTNw&oe=6A70859C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YugHdIYtRBgQ7kNvwGC9Ceg&_nc_oc=AdpJHS2BxhcluQ97hAq-vp0Cke1sRyiWdu9CO-ZX8XHCp91RWr5WuRvZ54ab0sB9d-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm9O6Cjm3NOuOw3oJCGRKkE8pKaYtFzQi144ZyL4TlaQ&oe=6A70A45D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6jZT-F_HpYQ7kNvwEv-bS4&_nc_oc=Adr6PDHRUvTw6eTRpTCQVzYwfX-bl12UqaOuVJ0lDzq4_A2xuH68USYtiG8Rd4l5ukE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdqy8ooEizMGlgkFG2ed_QzgeZgx8vQY1qYwTkAqfPEQ&oe=6A709C32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g02vsRoFyKUQ7kNvwEI4O4K&_nc_oc=Ado-i2bR9p04WM6KkAbanj03aqLewQy3PsXuJB13amyGWv6rtw8MKVP1okssgZFwtwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB5l626BzQvQPyNgnwUcgFdKXC2hqcXdAyR62bt4VDdA&oe=6A708957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZOzLnwFbnsQ7kNvwHA8v2e&_nc_oc=Adpgfyz0yEP8hsPI_WwxFeNI-4UzFUkIQjyBkOtyMk8oD873fdZ6lHlqAUUxg4AL6e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_qLqE_LunrALjH7JadQ13x1NtLYtCpbwj1lnMlmmQCA&oe=6A708E95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHNO9AIYdXEQ7kNvwHXv6sJ&_nc_oc=AdqPezpecopXrUwx
8vYTo8uSGdqmdTGEBQMwoXar-1n7CC0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RW8Al5kWJdzxtCbnbmb0JqluXHKFDctoTh1cn0uexxQ&oe=6A16F632"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy29RQde5nQQ7kNvwHaBl7p&_nc_oc=AdpFZB5nkJHR3JR9_LSt_QP2QFN5J_XhW3Kk31vwcng98KpYeRE6W-TPQI2_gAxwU88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EkPwx-6ArTW93Xisak3faggLzxX3yfufSYVjqfGQ2Pg&oe=6A16E357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKH3ye_RossQ7kNvwFY_mlR&_nc_oc=AdqYHaKBRNIUpsbj1Wtx6P1kpccZHn0K-LYyMTJKc0Q_-g2a9d7WS2wG2l-YqC2AdfY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YqK6xVKKdAc1hfWIjCCcN4YPSTog7BnOgHU-JZNdIQw&oe=6A16E895"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVNBvJCjJwsQ7kNvwFU9WrW&_nc_oc=AdruEST8cyUm0lVauDMeXXoM2KhdnhldC94iNho37D_8yTFHfMoFc2QjbipMarY11FI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bBJsQ6NNjWreAqb9dkrOqopREzkXZzjES-SRMtTE88w&oe=6A16FC42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24faiF_hc7UQ7kNvwHRhLjo&_nc_oc=AdoTQ5qB5adq4g-TSOuD1QLqH9pbu8ublmHr8RKZ1zimnh9N3j6rL5vbhgQjO-qeWZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66jyShHWFsbuehyhzRoZlgXmZUwtSwhsqRvy_jP3WDng&oe=6A16E2C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvQDOp-2JHYQ7kNvwFh-c6C&_nc_oc=AdquZ8GAhCi0MbzjgdaOJ5z3nTaQC8Nl9eTpxRMm8yc_h-sjJ2Op0AKuhwqC2yr
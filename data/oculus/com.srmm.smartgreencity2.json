N8E-l5Iex-vuneV_ZmEpaH2vRyrlM2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N7YzsCZdW9IkXDv-iSCR8U9Cb5oXavkl2owsN9IkhfQ&oe=69EB74B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN_5KsmHeJEQ7kNvwFUgXh2&_nc_oc=AdoZCE69N_HQaENbv1Aw2SONHaj02hcbbZDsWSpcJP_WBa-ZCTe8G-27z6Fm1LdxdqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zSim25txXb9a-AMV-9Geyj7sGCO4RjwPt4fu41oxU0A&oe=69EB61D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0jf7daTMrEQ7kNvwEguGqM&_nc_oc=AdpQILze3yGhlat9UHH68B-03VHEVYp1aFcZlzFpmFr3_wOo10qazshUxByMA-_XNjU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jc0uv3UgXidrJz2lOkYo_JAUmKkhHPjcq0v-fpGYuIg&oe=69EB6715"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqroLgsqqf8Q7kNvwHp5SK-&_nc_oc=AdpbxyPLNZQn0nhlUArOJswNvKbQOs7xwWIoNdxp-qTgCVyig-ItDf3arT8zfHU9rXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q2XQCsoBAWOLlKXa2fXsFw2UxULRIPJZQgO-gSgjIiQ&oe=69EB7AC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuRT7ZbG6JEQ7kNvwHR58Ns&_nc_oc=AdqowEOhW3C-bVTr3KGmouCT-gGljoMiyxEvCtyY4YAIltbrSYb5ESmdKY3MxOD2TAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ayhquExpTzEFgDVvmJHzwTgd5dKy6sL6KMYfyk9GO9A&oe=69EB6144"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52KpKIMjpbEQ7kNvwF_MO9V&_nc_oc=Ado3kNxejrwHNjGmiWWuCeBA7_xJO2lLNxGN7iPp5_hEfm5OHxSwh1ghxYLG5lK
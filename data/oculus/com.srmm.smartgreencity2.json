sbi4ALy31djf88aWk7u2EE5kJXKRu_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TYqhD7mrGzUkLJa2JqPKfOiXxxeB1-KWjlWj5Dk_2Ew&oe=6A315432"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRoTw6DytdcQ7kNvwGRGAMh&_nc_oc=Adrv1I0Zefrlgxg8iMPS_wObGkZk73T28ZRC_jGPfoeZ75HG6ToxKTqSWfRkx99fbhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ny0prqXbrPIUbs3VkPlJcOzWDyreQAV6fFEMEHwtsvg&oe=6A314157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1VzpWIFkYAQ7kNvwFcS2TC&_nc_oc=AdrLT75OiJv3ib1q8BcBz_3G-AjFyszf6US1F5HZQgnMtcpM4ygQs6TdqKWwaaXDPxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q5ULIqjyP41exi_8ehMDczvv9L6cCupY7PDtexHwT9g&oe=6A314695"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ix-HDS-9tsQ7kNvwE0GZD9&_nc_oc=AdpWjKmnRN8zaHW46An4xXj1Qzr1rc3X5SLZxjsQ-2NKsdo5iKfjpz4gX4ZeyiuGX8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WehDd3NZINa7zJEJhI2cGYsaptfRje_zw3muCAws1Ug&oe=6A315A42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o_qqGJo9JUQ7kNvwF3h4b7&_nc_oc=AdrLoK0Wxy3gGt9_lFhGbFdrXU6sFM7ciKXL-1bD9tpEu-EKoHxoKnBEsnmmaMr3ItQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3m6K0VYP2zzZULWKNXh6MhNhK-Dnyrd7Jim8BxxlGVQ&oe=6A317904"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idOf6M2REcEQ7kNvwEjPnb-&_nc_oc=AdrHjJD7vxLLbf_1cSeAbNl04GTYZ2RDywQqzr4FebOknWJ-EBcVcj3NX6w5YA_
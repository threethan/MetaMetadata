xaO2SXdz6Es7u6XBGmz10FvrQxEjXxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVB534uPdAiAoNDJGyd48kuFTmHdxtR5m1dxB1bseVIw&oe=6A9EC0B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwUwm5iZHfMQ7kNvwFxnbB5&_nc_oc=AdqMjyEIA9h490Al0a2yxn4zZHumEkayL4NhI_L-AAl_rY3DUsWyD1-zMAUDg3f-XLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPxEnswaaHbYoPP4BRKo3D80KZSx2gVYmWbXMjOaVE0g&oe=6A9EADD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhHw7-v59A0Q7kNvwFpWAYE&_nc_oc=Adow-r6Ef3h96x_dMxZMa_VybbQOe0LWiog7HGEAcEQLE-PeFMs4zAcjnsyFtlOGVek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiNcTbVzwS5POl1YB48Xt3vG51J28Ng-8TGhByyHQZig&oe=6A9EB315"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW7jVLNYThcQ7kNvwHmg9bY&_nc_oc=Adq1lLsxIoLZzTn9XkKzIplbm4oMYsK0B-MyejGTCbFVlT7EvKPvMjEXg0b9gYmo4Jw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnuTXjLqDIGpTxUWVrVlidMh6jBgOkh-hF-RsyMJHqXg&oe=6A9EC6C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lzmWcKVCCUQ7kNvwGG3VnX&_nc_oc=AdpC1QicOfPAbQgHQylByxcpvQg9whKS9Wsg4saKPa1g_yAT-vG9LDa64gfrbzwzXIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7oocpV25zaaRIBvqR9GZ9ls6kd0HeggnI7NyQx8w9oQ&oe=6A9EAD44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWDPxxWQ40MQ7kNvwFxlmqD&_nc_oc=Adq6kHKjsBNRK9djrOZFN2ed9gsABHLgBoAaKkPCWNqOj-e-A07qM__X99F4cHD
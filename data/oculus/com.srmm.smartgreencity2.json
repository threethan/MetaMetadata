_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKZHvbxwvTEQ7kNvwEQJLJy&_nc_oc=AdrrDGGiACIz4-RQJbXsBTxfoPAQKwscukZ9IzFa3qXWsK08QVbttnuVgSHNmVPlFyU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGarFREzQkpQolpfPkvv-rdXCd7pUQIScb1W0ZVl5OXkg&oe=6A917B1C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qagne95Dq4Q7kNvwEqNzt7&_nc_oc=Adr4fbcnk8zCC5BNSnF8qhOI1RmS_5ihIVTI9GhPudMttE5z2LH3E8jF1K3_PCRdm_8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF80Kh59mBPX0uwoLps4Zpb9zDXLLzpORtCQzPWQHqyzw&oe=6A91619D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vR7wRAa1cUQ7kNvwHTlzi8&_nc_oc=Adp35sYUs6j726JZF_kO9esHdTY3Gj3O_1qUl45MTceAY4-8rBZ7ZjKtd5nhg5JEyQ4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8wYupV0BtwSRRdRCTrrdeGJhnXEUMOxtzW3l4JA9_TQ&oe=6A915972"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vE1LKfQR4QQ7kNvwHkekyb&_nc_oc=AdqoXmsieERlE69JfzhW3Br4FFVovyfzNSxrKN0UFx4EOJJ7UVHet6_Lx-Ad0NWN36o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCUHzHuTw_YSFW2yeFHJxN4CErxi9qt-MDDPY0EpFe2g&oe=6A917ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNkPyhlRWIQQ7kNvwGB5Aag&_nc_oc=Adq1pGOkwbKKp7xEIu11KAd6ERyUdl_86pjaHjN3-pDrL1X6DfnAdzZHAMQI5Qa_SvQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5eMiRUKf90SCK1Jl_IWODyvfxHlXx3L7C-6MFIjlPOw&oe=6A918415"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8hJu183oYkQ7kNvwFYKZPi&_nc_oc=Adpp11oe6eyLpG0K
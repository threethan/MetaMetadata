LDH0xrHZ4li7V1p8cuWKT6pGNP5kgk4zwY7lp9QFTDvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuj-ecH9SGt9c9V8A7Ab4uG28s1cDM6AYk_w1VD70uliA&oe=699AF29C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCFUG3pzWowQ7kNvwGSq5Xa&_nc_oc=AdnivguvfowAdiOgCh0Qj1KgZHtc4fWFQ4ehOEOCokDGpQa78xHWlssha5Z9quTeAjI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsncDj4rZwJsqmSbJ94pqA_mV3zLtD1QZ2qFKmhiLBoow&oe=699B115D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBC_QIwrvvoQ7kNvwHiXnCD&_nc_oc=Adlxp2kLZwQd8BqyZLiQX1TG28jgIireNwkTpa1dkmpW_ApqbHvdZfAxisW1aDhRG1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs3LqHiSsIwoke_SX4qQaBFZJrO46m5PBe2eBbuoZpwsw&oe=699B0932"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE5DbIWtpKsQ7kNvwGB3hpq&_nc_oc=Adl4Yul0U8az2tja_bdS7dELZgAwgk7ycMdFAz-tCjXVmJw4I9aw33akuVfLfKWQMio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsab6QL9T8AaXFZDi7PFSfUxq8xsJ-UwOXp6yAEYrlPXw&oe=699AF657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWOA967thm8Q7kNvwGntv1I&_nc_oc=AdkqxNal64Clj9edHYmvMPKBbKQwrsBxbJ3vqRBLNgwrmePzVxJv-8EnVDCtYpWRClw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftdLrHfrJDN5weLrQ1j4vq48uf4ezHR1Pu4NF1L2q-LQw&oe=699AFB95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_8Y0XGY7ccQ7kNvwE91OPt&_nc_oc=Adn81bYaCdk8JvUSAwHELQ8_xxFZUrgpUDCq-DHW__hMKIIsYjM123lOCUTGjzr7JHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuYrBCQyu6cTr8l9PYoKuEUMfkbtlI0IvewK3Ab2hXAPA&oe=699B0F42"}, {"f
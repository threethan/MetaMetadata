_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qIr_F0d4N4Q7kNvwHz0YX8&_nc_oc=AdrDpZf7iIhwE2iQsv5ro__dg8KMYRpzOddLayJNI7L2bSIBGAI8pZ8mDAL-ACbWso4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4PXa-fOQun2CtB3DVD2xadHvN6Mw8jN1CWO4ePmcn3Q&oe=6A674B1C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUta7-brfRoQ7kNvwH4lBQK&_nc_oc=AdqPkokXRD3Vg2WpTDEBxKkH2NuRMMO2V-uMoVNi4BhGNMzXyAo7dhjaX-UqfBaTiPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW2Q-kF-lS38Z7gxqASoYVReKwzXYbnr9Ch8Gsv1rJLw&oe=6A6769DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHKDhqSmAb0Q7kNvwE1cBuw&_nc_oc=AdoxKCu3l3iAPS7K-Y7NIw0mQfdu76gu4rnyxil2ZToagqJan-mCRDhG37aeBtbpkOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIBBS1yCgqrHOEQ4vwaUt2_QxK17JYaUI5VKEr0A6cXg&oe=6A6761B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zU31AKZMZcQ7kNvwHPm0CJ&_nc_oc=Adpt5IO_lw0HzQOOeB51u9VLYSvJ89oWgYd9_ORszJ-FNJPJAmVIKnwgxsr5Q_v1ncA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLxixJHjt-1xjf01Bv7GlSFkZphrRpR-pQIcvFY_syZw&oe=6A674ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gi90KxKUJEQ7kNvwGC9XFc&_nc_oc=AdoQ8DeQ6DIRSdedFJfanc4xsdNssitrN2OJ1KWcveOtfLWjLEKhC1QJu4WN8ahCRoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcJvUTyO2QmOEksvWv-Jf_GdzysjNR3uFbRC-r8vdjgA&oe=6A675415"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8au_hldh0wQ7kNvwHQVExr&_nc_oc=Adq1w8rt380XoKZ1
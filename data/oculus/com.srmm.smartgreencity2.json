_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDcdh0xDeYUQ7kNvwGl0cZo&_nc_oc=AdobBYMSOscFyntyPKMBTa5qnMMhpfQ0md1VlL8iNCje3CjGkFDKZPFrzRzGXwk_rzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4PHHz74yTq0r9ELoFhDL96WwyWmus3j_xgMlXMTNjxw&oe=6A52331C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CTnqVZin_YQ7kNvwHl-PcM&_nc_oc=AdqCiwY8Za6z4NiZOwKLLIXuZNIpW2uxsGaBXIVo5A7fM-CqZhgSaj1V8Xa_LPj9fLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHzewBvUu8vYDKYPPESCtbDXlgEApu1XVcn6WKygc1yA&oe=6A5251DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbqm3FV7gQEQ7kNvwEujOtO&_nc_oc=AdruHpaS_qiaADQQQmCOAnXRJuXf9TJJJ7Qkkbn3G19C6x0Ie6REh1FKC_DTeY5A97s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGtKStG82S4da8QYkb3XtyCiDSPrIMzbB5bgXAnPLnmA&oe=6A5249B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH8WGz5F0soQ7kNvwEVGTHD&_nc_oc=Adrx-WcUoZ4K38FHxMRBKvt4bdW7IqTftHm1fm-ZODG3fxw9RA-DPwQp4A347g1o5MM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZmZc7xxX6gc81Stu1Br43mnpCrDpPK-ZyFHeGfNYLQA&oe=6A5236D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dZVr2Tw4bUQ7kNvwF96qbs&_nc_oc=Adpjsc1BMquTZjWc7cnuGuiNljqiFj7emBoG2DUjq46mPbgtOJ09XRGVmNkdsazrFxY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9icj26NRazQ3sA93vUsgM-SDHbeyLylaS8RPwp5_6mA&oe=6A523C15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjIoGs0OZb4Q7kNvwHQBb-R&_nc_oc=Adozhce5C8-fzpwL
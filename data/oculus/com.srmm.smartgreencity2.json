_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO0K2Y5_3BcQ7kNvwE1L603&_nc_oc=AdqemISMs-Af10A1RnD9_myFrNLu__s0Nj3ifurPffhdOgI3YhVAIyVNi9wDeWoKz-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wN6BdyEjvQIyLU5U5-jk6lzGRe1qmrhwWj5TeVOcOHQ&oe=69E6181C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZbFP0eq--cQ7kNvwFBEaQ2&_nc_oc=AdqSYQiqMqPdXT1RfNs8X30x4CgxofS2xv6O1QWvfpP1Ore4NvRtlTo9Mf3YmkiEtlI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IArIWC25j-oVRv--5YKsEkP_wZuYE3e5ggLtYQdyPYg&oe=69E636DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0eEs4hWSBcQ7kNvwHCCpi_&_nc_oc=AdoOejd6jxHHOVVzxuXXOHOudqTHsqS72xooOQKeaTB13T9jjOV3dGasMkRTHHeDVeY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UaI7uSDJ_RWiS13ZmgPJUmrWeAZYwoigpkVNfUINWyQ&oe=69E62EB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2_venUNwhAQ7kNvwG5FfAO&_nc_oc=AdorZtYt6APo8snYfID-IexMQMylFgZMakCpjJZLKCfoQdCDIU528PF8tRN_AQrjY18&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K--0Kx5PB66ivonvwqAZfvMz0QwIwAByuWNrgFVvAJg&oe=69E61BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U7usWRNra0Q7kNvwEA5HCl&_nc_oc=AdqITMqLyISNSyXJS1TiYtRyVdelMDDNPeQ6INHwz3IlnOdtVmQajPqoxnOAJLMZMyI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XrF1mjYw3OAA5-sWcNniTbOX4mVSUpcrGePwUmSHkSQ&oe=69E62115"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enQgh3Q995cQ7kNvwGpshRO&_nc_oc=Adpex0Zzp4tlobwU
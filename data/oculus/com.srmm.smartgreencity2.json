nOZNdzZQ1B0Rf_jdsOoHNcNd_ZAO3p8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILvvmRT02hU8DSU1sWcB5x_1fRiyNef4R_bV4uATWjdQ&oe=6AB28732"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeMdqg7hipEQ7kNvwEYrD4l&_nc_oc=Adqm5yNGksNr6n2r9AJPwp2sG_OGqMNiJRqpyHC6f5gEriOBZDHiSC5DvlZY2Zqk2SM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrIbfRzXK4z2cOp3iLk3k_8gnh9rgKNpDXoEO5BCuiYw&oe=6AB27457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdtZTTPfs2UQ7kNvwHHuyPr&_nc_oc=AdoT37FaEx2R8mG40QxvEqCAepUtNdVqMMgqnv8asaqx_4Fv-B3CI_9JGHk8PmMoONU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW2eg6OA9KBmuyBxD_3_SdHmZOcq8cOJTEUwEKgr3oZQ&oe=6AB27995"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fx8QRenWgFIQ7kNvwHnf2Xk&_nc_oc=AdroNwOtWqa-ExirHs01wX9fjxRPr5VJWV1NhnSSF4YW8aKfnY3yjv0H-00Z1l24dlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4DuvohYM1Qe_Aom9696aZNQFgrBDFTtFaukee1IViZg&oe=6AB28D42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8G7zFn-fNMQ7kNvwEhR7CU&_nc_oc=Adqh7SU8lh76ERiAAX36rgeeJgfOotEWRpkQvtw0uL1Sf6wGxPt7Q8Nz-J37B9prqO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEz_DcdfOwyqix12i5ZdeWBpDAObBz5JjvXAo76GGJMg&oe=6AB273C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hecqXFwgd_IQ7kNvwFcd6aa&_nc_oc=AdrLY6uvJawxseIQ7SDBygE4uXEABihGKl604ECVCjc3Om2j4tH6dqcP7cJwo8y
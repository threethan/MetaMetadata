_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewtLreHHE-EQ7kNvwEB0Av3&_nc_oc=AdqUnKFmvnkSuV5Fe4P3EPoZS2UWF9nxB0bDj4K7zV3fTP0-OZDNOY9fyMnGUDIiJa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOywAyqlpOgkOYF6wfSYQFDG-PjXo3UGGskeorRW_c54w&oe=6ADE2A5C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0CJhS8kTh4Q7kNvwEA4_6u&_nc_oc=AdqSR8bixtKOLqbvmTjcspYcKkk81Yh-69-jzRX_OFqZo6bcwEHnAljcxI5J3z4k0so&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNj7Ar6jcqBKrMU4Ik82t-ywnciMFCiwmwuaxburS1Pg&oe=6ADE10DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1VDLkoex_QQ7kNvwEfs3vf&_nc_oc=AdpEEBtXWpmTlc-RojIwQ7ZrSjqPpIApuNLcuTydxr-mmYmgKHKNUl0-kDRy78TWytw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGPW5Sy-e94-FgvyZtR9QkefC3xnQLTBm0d0aZ_z5u_Q&oe=6ADE08B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgH6iG2_UiIQ7kNvwFoQtub&_nc_oc=AdqVl9VCZxMjtkS4n2xeVmevLIaiJL_0jV6lqbG_89X8HTQlejNFNVIvpmUvcUtdeP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5jbFX7vRiR_GJ5C9jjtZCmDpgFB6EtigNr1r3U0ig5A&oe=6ADDF5D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLBvIdIjofYQ7kNvwGyt26F&_nc_oc=AdpW1xrNDJlKjL8kjMf3FmiMHQIF2hr5YX43MEGwiEwo4ErEpcWB0pqioQWF7Gl3aUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6RgLEorDs-5Z2pm9SXkbHWsnv33SUpUc7JnWD4dJ6Gg&oe=6ADDFB15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLcSM318wQgQ7kNvwGdNpeC&_nc_oc=AdqaimmgHF2-AxA9
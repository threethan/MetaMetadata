_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9ga89F4uz0Q7kNvwFGKdnS&_nc_oc=AdqQIMD3F4lmP24c-SZfIn2itIrAMMdegxhIhYlGo34LLlCBkaLDHVBPSm-TJZkWEDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e7RpTW69rz00-0TJ-3WCPrTigcPRiyXwrcnp7tAWrlA&oe=6A3D535C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE-JljY0raYQ7kNvwHbC8CO&_nc_oc=AdpKlWMEXw9IAChVi--xQQSMUiXQ4tSOsw1aYKn04MOinp3DOH-K6D4NNTDihdlq0jw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V9sDh_jWlbJ9FEtXb4DCs2jw-2bfm3a0kG6wdilk0rA&oe=6A3D39DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv3BNn094v8Q7kNvwEL7BaS&_nc_oc=Adoz_Gyl1cjDFJGGasTJelup7cUZ0_zi5R5jTKJIxBkM58OAni-rnD-ZfrPZlDeKfHw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ytWPLwV86i_CHeCMEqVNOcK5DQhjQPdoP1x8f7MOgJA&oe=6A3D31B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrfWqOpAK2QQ7kNvwFY5r5d&_nc_oc=AdoMgzVjEpPuMUGRXbjLvEi1wkEkx-RvCICZdE7OppiBGpiV-Vv4pLYyNmtkxO7Iq1I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4rkXaaaymXPwt8wHHPfIHVtFFfcXjpisT37l_BGLZrA&oe=6A3D5717"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDGNo_34JFwQ7kNvwHGijYR&_nc_oc=AdruibvEI2SxJQnNJOBRJoFSBCq9SGxUMKmwMW_f2SFnDnRUlM3KaGivwnuZFpCXjZo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ppQs4aK68oHQm-R6nDOz8GoG66Rxg67qCjY7_78YXbQ&oe=6A3D5C55"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD2nH1HA9jgQ7kNvwFaEKJE&_nc_oc=AdqnVxX31g5g9hgA
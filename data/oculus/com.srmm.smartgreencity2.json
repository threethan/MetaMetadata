kbn3G19C6x0Ie6REh1FKC_DTeY5A97s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGtKStG82S4da8QYkb3XtyCiDSPrIMzbB5bgXAnPLnmA&oe=6A5249B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH8WGz5F0soQ7kNvwEVGTHD&_nc_oc=Adrx-WcUoZ4K38FHxMRBKvt4bdW7IqTftHm1fm-ZODG3fxw9RA-DPwQp4A347g1o5MM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZmZc7xxX6gc81Stu1Br43mnpCrDpPK-ZyFHeGfNYLQA&oe=6A5236D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dZVr2Tw4bUQ7kNvwF96qbs&_nc_oc=Adpjsc1BMquTZjWc7cnuGuiNljqiFj7emBoG2DUjq46mPbgtOJ09XRGVmNkdsazrFxY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9icj26NRazQ3sA93vUsgM-SDHbeyLylaS8RPwp5_6mA&oe=6A523C15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjIoGs0OZb4Q7kNvwHQBb-R&_nc_oc=Adozhce5C8-fzpwLXiA_PsfR1q-jGqdELKnpFP-eXodFg_i_cIExBtIQDeP9bSx9K9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcfYIyxKtP5GgTIrPj3oQmWJA_KrmXDJtNCF6bEfxI9w&oe=6A524FC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBQ-GBxL3AwQ7kNvwER1Oqh&_nc_oc=AdqSinFxv2o1xHh5nKGjPKF5dj6DqXNFtlDFMSBZ1aYCdVrh3jOSJ_pHtYE2pMNZ4Ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBF7wa8QntRaBLNA_GYJSvErjWEQ1zQ8NkHgYSMZJiTA&oe=6A523644"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eyRZop57u4Q7kNvwG6OExY&_nc_oc=AdobZldkhaxmzPJ9hSbvAX75eY3cL0T63AKnC27p6CQHH4k4_U0uy06aYonYf1T
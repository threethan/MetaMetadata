Ez2cLj-H6i36GY0gzyroTIC1vm43eT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsNH7_wqzCRJUSuJvZ39lPhCUjgjlcjXZLMIBV5iJ4Bg&oe=6AC3AAB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaamLhg9rnoQ7kNvwGcZxa4&_nc_oc=Adr6lqcQny7mfWvYU4Wcf0othj0gmMd-UzqbMGS1ZAU-YdDyj5AprzsR8GI_ib6PN0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBy8zWh0lWPrY7mMd2p0e9dQvLF_mWuHuytao7rraiqg&oe=6AC3D017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oesm5hbIDJ0Q7kNvwEXUTeL&_nc_oc=Adq9M3IEUNS2j0adwKRa-SRo0vONOutISnnsa9krv8wt__Vt1gJ6CTA5PnP7M3TWx2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYInhqhq69ywdGt2ilkxmQEbQCGXOfKPB9EobPy8cxaA&oe=6AC3D555"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ976dnhZ2QQ7kNvwFE8Is9&_nc_oc=AdoSo4HprVfiShbbj3TcFRC4XN3NCAIEWEZoj32vQqpOFJWcwKNAIIAQYMbfpVNW8U4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiyudH91NP8-VKMLFMJz6ILRuvaVDli36luihdbqykHQ&oe=6AC3B0C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSXAxkUW-KQQ7kNvwGbInVp&_nc_oc=AdqbR72-o7GZvyko9qra28trhhvISk1CN-fRbgyDgbUoyUgYYQPNTr7YjapjE6Fv_fA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAq5GI1orzdjs_dfOERZwxgDEZ6sQv7LePgZFC-TGdDg&oe=6AC3CF84"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pheJxCnuSkEQ7kNvwGh0Wue&_nc_oc=Adqjb862xpw5n_-BrfXcNnDGWpQHgMm13ZtC0aPW0HfRDpSSlKdlG8tEqgWZ1f3
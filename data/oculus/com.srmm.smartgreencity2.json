_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PhBNodeGRoQ7kNvwEr5yZi&_nc_oc=AdoAkqudjAclTMLqv1FHOrRZiYZ51SCUb4vTPLAbAh-6-_-uM-uojZ9i78M41v5Dc9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx4_pn2bO46dZxo1nngGFjKq5Tnf2RXjQ5rOMbshMBhQ&oe=6A9C3F5C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gv1BINwCHYQ7kNvwFvVmC1&_nc_oc=AdrfEK5XByt3Wwhvyfd-jBG59zfwpCID1MqOVXPwalnp1KcGLAV5L8EQi5zJtB9XU5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8OE4DeUumuxmtop1EDcb1BYWj65SRkHz3_5rW5v9xZw&oe=6A9C25DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VqThRPgbNQQ7kNvwGOu1vR&_nc_oc=AdoEox6HqKiBOs42Xiz22cuVLBAWkbLOQ1ryrw1WmY_WGXmN5ug9osRNBt4ZX7wRBcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi27q8c4VwxB886sUyHg8io4036LK15aBamzNDdcw9Cw&oe=6A9C1DB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zAuM4x4tOYQ7kNvwHtvxvG&_nc_oc=Adoio8DlTn9drYH0pZdoZldOy4MKkTOoyJiZwo3Lte6hNEh_Hxqfl-bF08DuwhAZwN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDiv6-OlPTMS7vpXlRb5LJebVFtAc3-svrUr5TDXE9og&oe=6A9C4317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhHw7-v59A0Q7kNvwEf-NpZ&_nc_oc=Adp87n-RoLrkK5xgPB7oX4aP1N2-zQbBpbe_JuGurYVII2axj2-TIhP3CGZ06IqPDZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrg6-mzdHLn8PujNskrEIsZms-lp1LMhYvEwQUx-z05A&oe=6A9C1015"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtGEHZNU2ikQ7kNvwEKTnuu&_nc_oc=AdrnVVw0kzQnmusH
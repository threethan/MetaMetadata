sjfggc1Ewnp3HdCGA0-QsQaW_Sar-b-EjfOYIf9N1Ql0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-ryAKqmE-Vcs8M9HjZ2yXug12qmPaZQPWlToy0QhibQ&oe=6999A11C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCFUG3pzWowQ7kNvwFkTcVz&_nc_oc=AdnqPSEUoIxiREyQHd8plaOCqDRYO3Dfk0PE1fqo7IOPN_XVL4goBItTkZ4vi7Sm2RI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvwt9QsW0c0hB-92LfKg0tv5kJwSdA9lI1kZcZ9DQrNsQ&oe=6999BFDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V7Z5Y7fP5cQ7kNvwEK3_Uj&_nc_oc=AdnO_Pe-lZct66IQkrnOlHVqkN8Jld_MWHkvLS3m_EVUcvhOJMr5hZAKGeOfvPyoKVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqEsOFi1poI2a2v4wujTVt4aIu8cCspDUkDiIrTiIk0A&oe=6999B7B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE5DbIWtpKsQ7kNvwGoWYjd&_nc_oc=AdkoKpwR0ffRl9GSM6EyZa-9i5wNqNFPNqHs71rKg-4l20XHOQj2xHkcli80LloZWck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGVoyULEeRd1FfbTv30JyFAIJvsVtYMXoulKP90Q2VKg&oe=6999A4D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4_e3Svv8-QQ7kNvwGWgsBA&_nc_oc=AdmAG5ltY2DKmPLz7C1zXPNAxkyHC4H7UiD5g0q-K5zHKoU9eAE892mERlZtSuU8Y9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6bvTHAn_e1g336L3t3KljzHRo7hpunFmSvavDiI1hgw&oe=6999AA15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_8Y0XGY7ccQ7kNvwGsba-8&_nc_oc=AdmAA5amZblgmrUbA5POQkntTdIojJFYVWdcE1lpG3eOoKZIDnTsbi8KRISXrko840c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDnm0FvHEsRmejBN8EHs6LOdQYYrNSsaQKv39WV-_Ryw&oe=6999BDC2"}, {"f
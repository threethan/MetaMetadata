ZocmtDf1Zi-u3hQCFIcC-VVKYU7nK-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhhoLLxILif1KQEyvRwAswMv_4Qi_ua8wW1z1BW0vwvg&oe=69CBD0B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKaU00icZ9AQ7kNvwEQmxqT&_nc_oc=AdoFnnHAqRReytNXRoAjPNQtP6JoIGUNbIAuqJjNeiv0IM8sIop5TMZpYYPVqA0G5X4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlyRz7tC_oIDX2B6c9wuqbgMV_mFcxcyNgwg57mH3wWw&oe=69CBBDD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZFWep5a1BEQ7kNvwFlJgfI&_nc_oc=Adq0EfYEWU-h_P1SJsLqZZqgQ5jZgdv0NRiOmA2VB5hwe35aV3wkJRbF9E3koLF7LbM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnDC_pyGb9bUtYJ5NV54h6Mr5fLUkE8KtZN1DLN92hVQ&oe=69CBC315"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZx5VOyD9cgQ7kNvwG-mE4m&_nc_oc=AdqlqehoGB-mwvPcL4CiCeSwEqcM4ZEbCJJxXKjh7eGxzgujp9CC-hq5dxMgQOi_x6k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSgsxDiEbTyrqK0tKMNRMw2fEpB-zPuQE0yZgHJOsXbA&oe=69CBD6C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUXxqjljr1kQ7kNvwFg00RF&_nc_oc=AdpP3zuwgDfafIhXbclJ8DAskH3FQ71aYo-wwkSm-3PXpFdpP5JHHtmQw2I3bhs7688&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzceXwQvYcaWSDuGedoRHm9tTwH2jTaruEVUnhuV_BJBg&oe=69CBBD44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3abrsy9K5UQ7kNvwFdpCZ8&_nc_oc=AdqLB2YZKt0EjWVHfzuTJNmf552QOOp-60zIk6mleodTPddxVb9sQDCEqcNsrEb
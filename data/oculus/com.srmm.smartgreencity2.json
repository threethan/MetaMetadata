Dl5A_p2tWhS-cMMD_Y30y3Bm2ngSlRM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ilYF_YdYBKFqbN6KzzSsw5vDeBXL9GQ613QN2NPezyg&oe=69F4AF32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK3RWtGWzQEQ7kNvwHgrtq8&_nc_oc=Adr0VwJ-jrckVULJeoJshibXSD27E7plIB6h1d9W_scG6kMZkVZLZ7QYIM5-E-5JZes&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2H3gYXJXF4B6O7CjTbQC_KYWpJNNX_-UnJbibaPoHJlQ&oe=69F49C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0ty7rKRLH4Q7kNvwH5Yjog&_nc_oc=AdrnZdqR3fTIG1CsduPIyA3LFKkLQmGUlHuF7chIWVi3ncZvZVC1DKCZobpiwHM87iM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af290jn0gsa_CdSjoUiSEzCAbyLakbVhx1bvgRdayd7VdA&oe=69F4A195"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdJFxYSV03QQ7kNvwF9wUaL&_nc_oc=Adqk8O55hjd29mIbRqCg4pe5EpkpAMcJbZUIbMzChokQySXSjCDkM_ColPgiszhjsbU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05GRSiJG97lazm-IJyPtxxn4vl5hpeauBFH9IaJCYP7w&oe=69F4B542"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgo3rpWQxzEQ7kNvwGpSp0Z&_nc_oc=AdqdphJDOm-AU9DC0Dnsy0xuJ9zVgJA4bKt-HHk22yTT3PYgNwRR5ZSzYD97R2ptCN0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OT5_Nw0Rvd1mieY1VP9P16vxp6fy3g8puVJtrVll62Q&oe=69F49BC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8pq5V8-u3cQ7kNvwEFt6IW&_nc_oc=Adonty4fjXHfcme_OGeKyQdyoHLFmEIiK9o1pu2hoNkn6aEVhqgz5eGu5nyNg2r
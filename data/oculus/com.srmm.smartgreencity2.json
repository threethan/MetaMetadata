_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF7TPXwnPR4Q7kNvwH390Mq&_nc_oc=AdqVZfxGxL7jEzkSRvsUpTmT2kZV3DFp2_jRyce5QqYcJ13Q_RMdqqOrLsdRco-jiq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4W8P3qim9onLhSkpJaPRO98gvavAlcS-NkCbEHGwUqQ&oe=6AB2709C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nSokREV_iMQ7kNvwEvgam6&_nc_oc=Adrywl-aaRxtSIrtPkC3DQOmWEpj-D-K--YXhBue5lDaZOJgKQUBwxHgdJpTc9rWPeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwV75F8oCyXXxZDGgM1lWmGCOdOirFPsqjSIlqIFxxyw&oe=6AB28F5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMsV2AhCXGMQ7kNvwGoALN3&_nc_oc=AdqmmfnVUH4ieSMg0XpLq2XgECH5yh86hnvhnOZNdzZQ1B0Rf_jdsOoHNcNd_ZAO3p8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILvvmRT02hU8DSU1sWcB5x_1fRiyNef4R_bV4uATWjdQ&oe=6AB28732"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeMdqg7hipEQ7kNvwEYrD4l&_nc_oc=Adqm5yNGksNr6n2r9AJPwp2sG_OGqMNiJRqpyHC6f5gEriOBZDHiSC5DvlZY2Zqk2SM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrIbfRzXK4z2cOp3iLk3k_8gnh9rgKNpDXoEO5BCuiYw&oe=6AB27457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdtZTTPfs2UQ7kNvwHHuyPr&_nc_oc=AdoT37FaEx2R8mG40QxvEqCAepUtNdVqMMgqnv8asaqx_4Fv-B3CI_9JGHk8PmMoONU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW2eg6OA9KBmuyBxD_3_SdHmZOcq8cOJTEUwEKgr3oZQ&oe=6AB27995"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fx8QRenWgFIQ7kNvwHnf2Xk&_nc_oc=AdroNwOtWqa-Exir
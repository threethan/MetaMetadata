wFvxptbTr5m-gRkI-ujnUKCpqFZCNrE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwTaS7pptCxH3gURb7a61IThBrPUNwcXooFQwp08h_9Q&oe=6A8705B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWFnELQaqk8Q7kNvwFw0_of&_nc_oc=AdoFC7mXeJ8vj_Yq3qYDOxN8oIcxJu6HAqx2vuaYNAPNvMx16g6Se5sdG-za_JgLMgI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb50NbL--E6C_dbX83PlyXd0H0BtztSdRfsVpGfNC28g&oe=6A86F2D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ncCCpzLxmwQ7kNvwG7qW6O&_nc_oc=AdpeJd1h3vKzb353N6DuYGIr-m8qZDqVIiG9DJ2REunIJ2sXk8Qmjn5G2h8HscN7uB8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5O5qhYhTTf_JfSbJmXKv-Kl3FclZHVTzv0RKJ7NBhRw&oe=6A86F815"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCJpCQSs-LIQ7kNvwHTgk-b&_nc_oc=AdqQC3hm-HzBPutOXeGqG_Puxs7I0oba7vPizpBlV32jIUe1bS-k0I7Z98PXYyXSiBg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCUhDZ2dKBcb9XS88AHhH1ZkU9Nf9D56cEJvaGZ-k5TQ&oe=6A86D382"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByuOiVomKbQQ7kNvwHLBmM7&_nc_oc=Ado-8b6WiKJ1TBGaC5fKIeKrKGEcsblnFT-Sj1qIqU9gCeCnDXpairP4GBUSwJ10cLg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgM6lOoGwgedJf11wpn112AKBu8RJnZRlcXGmPwJmPGA&oe=6A86F244"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj6yvhAhdaAQ7kNvwEumexl&_nc_oc=Adoqbc-a1V3nlPPUPqBeFSQI45hWrGKEuZRp12qxAZ-0NJg2bYe1pOb3NnWd2Nw
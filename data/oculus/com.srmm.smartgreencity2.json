_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxyMiW_IPTMQ7kNvwHEAixN&_nc_oc=AdqXRW2jve7eAWl-ixNuw7RG3JJ3rX0HovK_2tNZlNG2GqH1a7CqNFAOyejlcFjfhSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I7tERcMUMHFsb5dxmypZ2g1v4a-FA7w7DlWtdxgSmCg&oe=69ECAF9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqJdbAq0qTkQ7kNvwHxDJM5&_nc_oc=AdqTqw768-dsEXBGE1gOb3tEQzD4q3X7qr0WavbP9AsPc_lNse1zwEg8VLR-NSIXqro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EArsm3TbW3pDTZJA9T7pirFRmHpxwSRJHt0iHqxIwXg&oe=69ECCE5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDm2jBDUfNUQ7kNvwFGw-S0&_nc_oc=AdpJTEZghKON29gh2DG93wvK8asJLNhpwTHAf_17hXlEzRwMtm_EFUCSjqNJ0ywC938&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SL0-ZtUIxc2ju4ue7JaRvqtvT4ytyRgiu2IuoqY4fNQ&oe=69ECC632"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN_5KsmHeJEQ7kNvwEWcTI-&_nc_oc=AdqojXekqv2Wy0RwiuMVCkzwzYfz6IdeDNpsDSiUtFivw79FQuUfV3X4XPZ5x1bENLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GCtTJMuTCQhLK0pXEHStdlznqTbuXc1kmdUPrV_FtjQ&oe=69ECB357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0jf7daTMrEQ7kNvwFWlPEa&_nc_oc=AdpM2ndV5ra0nHnFykrekEw8c36hACF34p8l0EjRrMH60Xoy21QtnvDr6vjzA26wk_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jQZGbDulPwLTZ9Zg3SX_GU9pPXQWCN3hz0R_oM8-IqA&oe=69ECB895"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zChd2tZOqMIQ7kNvwHimPd9&_nc_oc=Adpo1VgMO-ONJ7Cy
uYkRIFZDffflcU63leG_xKyjvB5Davs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEo3RgFx8iqurpRWBfq77550zIvsEaaB0TU6bcaYg31Q&oe=6AD22B32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlKXSLtegE8Q7kNvwEajqws&_nc_oc=AdrEfkZwbVXEIALA15j7sLVanR1bwd78Ueg3Aqbh88CArG-b7_bLiOJwxBsdAbl7k9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkxKlFwSU1w9fzQ2eiK_F2Jzg5HJeiZcoZks-J0rBgeg&oe=6AD25097"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGO9uv8kxdAQ7kNvwFgomdg&_nc_oc=AdrUQ4pUs6jQuZ6HgRfq3fRyKFeUHIZsErG5hCUBaws2JxivkecoGKbPoYHS8KWHomk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiD4HJxNiEhQwWunzC6SjshRtJV0or8XFzDk9c8tPq_g&oe=6AD255D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwD5E5kwGV0Q7kNvwFMo15O&_nc_oc=AdrUcUeDFv8km-uEPVNkmo9IUz7mJv0dR50iMqAujeQgtgr6I0Soh5yu_Rxrfp6BJmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFAtfXYDPXd-DGLDlSfnet4HbRjQMJQm-8v6eTYoVhCA&oe=6AD23142"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZBG0POtG1wQ7kNvwFo1YLr&_nc_oc=Adp225mQrGbo_O2QI1VKx_WF0upyFItrmruuEDGqdfBH4ukOhMRTEfXa8wgr-bpxfhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4vRU0wHbJW1X4QZ9FMAyrL3PRmIAcH9HHnlS3WoNQig&oe=6AD25004"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePfB030tXK0Q7kNvwGLo9Y-&_nc_oc=AdoWR7xOkBamHjolWy4IThP1B4x7M9GUrZsWM0wSa8OFhgImLdwrCmMtm8g63wP
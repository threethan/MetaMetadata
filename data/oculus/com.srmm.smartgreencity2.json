_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzULoM3MBocQ7kNvwGUNMGT&_nc_oc=Adp5hIm00GFQ7jVJxVnD7BF8bQ5VkZPgs_FcJ1TpVt1hJQUaD3rvTANME5_FCW1htDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQUGFveYUnuEgZBMwwp-J6o9JV7ndWNL3mgpnGgVSaSA&oe=69D1001C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W-EJfESht8Q7kNvwHIxaWM&_nc_oc=Adpyzx2CaZ1DE9S8XtXvCZTohVjlzGvN_sbZQ5pFqTX3oMItEaJW6btbcuIGRQDVMmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEoEQdwqslZWRGa4Ge21llH3ee-PEwOVVt56jfaOK6lw&oe=69D11EDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T-PC2yqwsYQ7kNvwGRiT23&_nc_oc=AdoTyZ4PzxRpiaDQmr5bGAsp_Jo_PTkMWDnBKX1sDmRcGC6fSzdnQbxU8hs-TNr1t9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTM01Bl0KPRcLbnFQpo8q9_vzQQZIdnvlEySlb8ounQA&oe=69D116B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=485X1uh3vKEQ7kNvwGIfA3b&_nc_oc=Adodf55kdE5Shzto2ZYQb_B01TroFzfPWHRj2OKTjsDSJHDUva-JDk-vlSG-6ykTmLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU2MhW3xs3KzToeXOCku5EPFFXGfOQjQ7ytpIJ-5ggOg&oe=69D103D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDi7K2d8zjkQ7kNvwEP-6Pu&_nc_oc=AdqFoRTy9Eon4_gc4avRsiO0v0Xq-QanuoW0AWfOCvo0tbggvyAd3hPZ06Zeo5wOBsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_l9KWLdoEGNgSbjMrO2L_ydySfDFVwTXrVq_ztP7EMQ&oe=69D10915"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1h0VV3XDasQ7kNvwEz2-Po&_nc_oc=AdrZ5wHQ0O5_4xsG
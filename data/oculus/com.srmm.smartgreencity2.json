_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOQQnB1_tPwQ7kNvwE6GzO0&_nc_oc=AdqV_sb_i4Ao2iqf1JrAeUW1_y981tDSkFaBHxFt3FN-GKD6ykiFK4L3n9is3dZjrw0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjG2db_IIlth5SdIy7iqYxs5gUaDS5nFhTwMED8zJipA&oe=6A4E3E9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=569sxP7tkgYQ7kNvwHb5r1l&_nc_oc=Adqwbj_tMx5vF7kCQ0ZbKWOWN0p8LsCPM4-c7wstP52AkZju1SpcTIsj3MG_ugRJW9M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCybfwqTDeA_zlkOLoInuwGDazCoCLAv6kX5ERPRKrvvA&oe=6A4E5D5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_va26lP4BNYQ7kNvwGwk2Pc&_nc_oc=AdpyxY4dF52_CF8vSKpLw3LgL_qoSTeBZYgEBjKxurtRNvHaconJzLaUhC4YaJeRy8A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvtSzEDkD9L6O7c3vCgHbldyFULkRWXTvi9x8oH9Atzw&oe=6A4E5532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uLTNYBgrvoQ7kNvwEPaFVg&_nc_oc=AdrWCAgT1bL3BXPSKLQpUxzF483VCzv2Z4K-PUrWZYw1awuQ_iTFJZFo8Vm3MY1kP-c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgzy3DOe0NGQ9NJUErEQL9IQVYW-KonZKeokdw6FPMrA&oe=6A4E4257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYAE8SqyApAQ7kNvwEdH6-A&_nc_oc=Adp7mBD0Ohrup4W2z6YTNavYcIBGRcacWCGmWVAZEphMsFVoJoZbzw_214kos3iEAvI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkR4QgM_6wgRw-ioWI9UyXW5qQRkgRmDBXppc78gI9Eg&oe=6A4E4795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3U2YtxCh3oQ7kNvwFs5nwH&_nc_oc=AdoTrn7RoTUxf7iv
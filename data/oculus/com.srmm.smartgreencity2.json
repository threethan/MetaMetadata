QUJIUbVLTsF9pEYKrZW5722FTNmJ-Os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tCXIwlYHzzQvnL7lNjDtzwPsFp-87R4w9gXlo5WbKRA&oe=6A1EDF32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IivGiFUc7dsQ7kNvwEePw0r&_nc_oc=AdpsXHp1sqi7Xw8ycCGf0wCYdprxF5iMkp-tY_mQ2dlaQDpsg5PdNR6BtMH56E6zrVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EMqaBRZ1wLyiP-Ltbowda6VZriRMLfzHJ8i16OXTV0g&oe=6A1ECC57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSDicPc904IQ7kNvwE-Co49&_nc_oc=Adr66-01mIU1evrqvbJRg1HhWpWHm0yvoZlkLspUcYdCh-cBD0BxgM1399odCD0ub8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I46xZ6FtdTxKF9PxZBSqUGQOyiVaN4ZrIiIuxohB8og&oe=6A1ED195"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwLvjWPs8jIQ7kNvwEnxnDs&_nc_oc=Adq1NtaiwMZaEedRGNlut0Wt34fEWuIpYpJpXGvpeOKrfupM2SsUpz2Cj-rQEkKQJAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sA2hOR4XeCziHo6xVweSEds9Y7X4wA-pZ_eo5jBDlRA&oe=6A1EE542"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4Hu4u1bP40Q7kNvwGc2PP_&_nc_oc=Adrw01eh3XpDQOP6CR1bpZ6MH7alK4GHDlk20x1sjaehp5q_sX83629LBbkUacrAYME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78eC7vS9KH_H2aaObpjVAlNPBKpZ8EFXqeu_en97Zilg&oe=6A1ECBC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxD_9zaxOPUQ7kNvwGpggh0&_nc_oc=AdpZZngrLif42bOz20apgskNIeZ2oglCU1AMNu81u7gi1LvP4M150QZzb6QsGm4
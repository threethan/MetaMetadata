xmQlI4OuQq59OmBFDy0TrCFN2WkDxn4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwl5unI7D1N5vUsUnMQidXS6h8SJ2bK1tJdXeEZ3CpbbQ&oe=69CFC532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=485X1uh3vKEQ7kNvwH65ixA&_nc_oc=AdpDVouQ9YA6N-PGGophGr7bxflJWTiU87FNsIpxjtRV_-jIKg6OsRmeQu22SHfynZ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySCSSRhFPItO7kwuO7lm07mMKXDIBtcbHvCftr7H7iJA&oe=69CFB257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDi7K2d8zjkQ7kNvwHf6WFF&_nc_oc=AdqucZ5DuxElyw0yOPUMyH4tl-vycPna4cQ_2MuU9kFKx-d7qJZSWqugkb1WXcFHRCk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE9Y5yoaDA-RCRqK6iuCh_7HSFVreG4rr3T068BrYVhA&oe=69CFB795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyOU3aM-O_0Q7kNvwFA7cwo&_nc_oc=Adq40YIuVCf-g5zhprCJ9m3J2Qpe9W8oghrDHia5qs05clvOK2gztFv7zBiu7fbb86M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGC9gXEdZr-khWCklaL7d5eHe4rQMq9zTLPcqycyeMAQ&oe=69CFCB42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2sKny1AvgYQ7kNvwG_c5U5&_nc_oc=AdpvKgEGg4dOuHya_osqDOQQNNXg70FhzvnqZAvYfVzGbSCuH2WlE2Ll4RvQlov1wBM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ3z1-hNnef7_tjtThXhzBQt43pF7thsCOxJ-Xwh9NVQ&oe=69CFB1C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PadYTiVSvJ4Q7kNvwG4HXcq&_nc_oc=Adr1sOfwW8kExUoRI3zToxKuEWV7vyRmZYVG-uthBpvhGSyMeLpY9vnEawAjbEH
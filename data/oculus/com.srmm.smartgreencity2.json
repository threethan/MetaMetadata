_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nvVJjZSg2sQ7kNvwGFEUSS&_nc_oc=Adp2l6WNSJR6GpjfpNf7piQcP9va77Ywm_gk-CW5pC6auf0IF9KMy-7yxx_yUHGNbok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_CxqkO27K7N1907eOZ-NhjFu8W-g4vXsu26ebRnnLTg&oe=6AC27ADC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3vp4FsVLN8Q7kNvwH2Roil&_nc_oc=Adr5p6v-VYcgTSCuet01UjZmDJMAxToMJtsd5vj6lHhSs1TtAfhYobZM4UwxVD0FozA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOViuSNRFnBvpe3Y-Bq6n9gehpuQzHbRIeZdY5rIRoiOQ&oe=6AC2615D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voJkaCjzinoQ7kNvwGVfjdZ&_nc_oc=AdomLn_IUaUgmDryEzNUvp8kkHdtKiDwLVZvfufQX6RhILIk_9OMQHy5bK5_C9Jti9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdfLm5a2P84bBhIVCglkv0HADxZNyGS0SrGhrSTGARVA&oe=6AC25932"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaamLhg9rnoQ7kNvwGtdqDq&_nc_oc=Adolk0p4KDdjOhQZ3M8mYh5o5y5eIg93X-R4XftuY5P1GwBLcrDP2p4pHAvpscXfS9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjTvW74xh4Rn0hWYQnoclEJNftQWzLNPxh9PDQXZv8IA&oe=6AC27E97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87M7SyDlr1oQ7kNvwFv9ADg&_nc_oc=Adr_q-C8DngifJJw20YzA1oFTHCXjmFUcbV1L3EfLUKhnRTN_bcnuOfn9mlfdKijk3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrTV2kcAn-iddESTFwSUNe5CeKhRhG5aJTYPEOx8ZPfQ&oe=6AC283D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ976dnhZ2QQ7kNvwGUGZ53&_nc_oc=AdrTz14JHEEcoRlP
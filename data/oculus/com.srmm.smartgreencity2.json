mXaq1SXDhI2b2CXDFRWASSHVycAC-Rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcgz69AmtPBQ57VFAUGXe22OfYolg5sQGjyBGHZq_oDg&oe=6AA2B532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lKSg7vn0OoQ7kNvwE2x24L&_nc_oc=AdoZ_3TxHMQxvMYN9rxKvRHTMpDBeeH3VNNQtMDb3x7sfEYx3sF2TfeyA99Tl1Mn52k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICODtG5nL-ipTtBljL_MhmyuHJEeiS9O-WLukFQBzZQw&oe=6AA2A257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0_VRObde9sQ7kNvwFd6Tli&_nc_oc=Adr-DeKeu9fNAwf87_d5EJxgav9FHbjcwhpLWbvu-njGCRV1vOFAvEFwqKXm8KrMH48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJggQLdHu3RzzdO3cLu5_lL_YC27IdpkiiOgLxXHlNX5w&oe=6AA2A795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxcBN4Ul99sQ7kNvwHRRdS5&_nc_oc=AdoWwFCI9iXwTUAX7ZcOkfy_amG_KXtWU5yUgiwBsOWlbPYj49aPmB27hajDx1ruUE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUtEhiRRxIBYCOJm_Ha1i-tOGO4JB38FObXCUferxrqg&oe=6AA2BB42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCSjhOCN1usQ7kNvwHygZ0Y&_nc_oc=Ado6wh6Oztkxyq0lSMvdAtOnUxrYN2ELgLdOMrrbHI4XDqeRIWVbF4SRvxyqM7EQ8_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVzi7impSWwMEd0axQqItvZsOYojeqBeJJwskDsdk8fg&oe=6AA2A1C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-lF_G23KYIQ7kNvwGrWCyd&_nc_oc=AdoOLncIbcdnFDiNnw72nwW5QbJjL7A2iOrWC4EinTkYvxGsH4pVBU5vAf9C1SO
PEemkGG0oF14uVDTcf8L9tP_jc1W1ZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1PmNH_o0k75Pd_bYqZCOAkLnEzBc9O7D8uX8LepX-sg&oe=6A8C1372"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zk7UePDKm0Q7kNvwFllXtM&_nc_oc=Adr9wk6tXK-PV5inrvyr9Fn1rGXRDmP3n4w2JEoKHNzWSBkPg8XXqq4osATxEC_IV28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqdSmJWR5j_yCz0N4-ZKIgdjVWxCFtJKJwvjKQW4pFPQ&oe=6A8C38D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RYK9YjWdNQQ7kNvwG1Z-fo&_nc_oc=AdoyCuCW6qBha7pYwvlMFxCrEhW-C2rXFrtcLn3qOAMhegKdfb2aGsTpLGOIqRAG_xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRMndhFwx4AAEtpove_wRVOBCkiGmiLn_vOowGW_drlQ&oe=6A8C3E15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pXaDVW0gAcQ7kNvwHZAVlJ&_nc_oc=Adqr50QydxMuV6F1kL1KxC1AlME0Sn9anvem8KJCexAlhYXDjEIjml0XzmUgYQJUdMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlJOQbxIKigQw6TiArfApd2rXdT_8htnvdtqRvRbNN2A&oe=6A8C1982"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEI84Ipi9QcQ7kNvwE-ml9b&_nc_oc=AdqCHNZRI0RyyReRE4wZnNAvj6st7YYCQpQAxrE_bJ1sm59JLA1ny0f0q_28_5c8VQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWSI-efgHlGXgTbcRzH0qf2giqd4R9AiNMO2rlxfQUsA&oe=6A8C3844"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21YYcqmq0VkQ7kNvwFn4xQ2&_nc_oc=AdpHqrzRDLADUqlLcnLHCe39g3wnYC41N-H921vGqyeyvEQgu6tso7kU0o8wy4L
NHyCtxog_DRQSZzaT7wKu2mIkUX19IA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByF1iZsloK4QnrE2KqxY2GnTUuD_CnxgWcH8fduu48-w&oe=6A60CA32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ki30UqsfMQ7kNvwFeHyKX&_nc_oc=AdqiTFPeAqJNaNDyKVcsoycN6Sf5D8d_a4mEQ0qca1LS4ognZmsJVKtLvwq4X2YkOkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg8EFLj4nnBftqdECPkQHLvepr2tE6vJFcaGzNKPrO7g&oe=6A60B757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBQfYjXlZnUQ7kNvwErm_4V&_nc_oc=Adqbv2jKQ3N8paV-NsUp3rOWDNsvqgJ42slMqNkLLhvrGs7KHuRwlZoO7p9Tei0OD_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYrDHE8W3KlN0x8hKki4Gu5L8dpP3P5R8Gw9gbRjIHnQ&oe=6A60BC95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im7Qlym5KjwQ7kNvwEL1lsF&_nc_oc=AdqSWZr6a1P7Y0t7E8rXa00M-L7PEc8sS8y5cT9U6n-MwccKVPMtYOkLQcKU7HxpP8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAki-dXNb9jsB-nEYxkfX3LK4J2KVthwxgM5MobPivL-Q&oe=6A60D042"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5fTCj2A8ssQ7kNvwEZXuRP&_nc_oc=AdowNB_GUtKSrlztWElktupdBMOTyW7c1us_-oqt3_x0To8yHLHTw3S_iPDMpvnp4wg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW5xR2T5OSCpxS3U-o6WTO9yRiKaShSQDcYqU4zOSj4A&oe=6A60B6C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLKywu72f-MQ7kNvwEK8v7l&_nc_oc=AdoATEFyg7EFEvvY9kcnCJ5z_vGDXzmxfRV3gyxXszU0sVlHhis8yStDTmoJac9
gssj7NEe9sqxb6JzjjyUBz0dPVWC4OM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyWpAwV7_xOAfqv7Rl6pzf8MGGztnVXtjsEPY5_jpELA&oe=6A8AC1F2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zk7UePDKm0Q7kNvwFwUrAI&_nc_oc=Adp__iyNcag4aH0vmPAcmKYWxeE1j8CoPEB0hlZ7ymyksNqlV7FGOjJw_kKVT1GuZ0g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_w8VBPXcQxO4ZnsICx5mPq0-w7-uqcD1jYI4xCMNtRg&oe=6A8AE757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qN5_SjCfXsQ7kNvwHjtM6D&_nc_oc=Adpv1mFd9WlemacgDvmOsxHL-tVkqDSM0ueNQMnRzvj8IIP_96SeHX3AUm69mRg1q6U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV5fyu1MamyNOpuTIJRS4emijgpgiNpZr5DI3AzNy1wQ&oe=6A8AEC95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pXaDVW0gAcQ7kNvwGYDsz0&_nc_oc=AdoVx6fppzb8gADQQdfbZmQdflxPsBhi83wejYlTnsKN0E_fMeUKJp_S4Nf8OYC7HGM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHHb2r4zsGpjT-wW6kka1_F_nJKi8EORQFWKcvHY3qZg&oe=6A8AC802"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEI84Ipi9QcQ7kNvwFNEjOc&_nc_oc=AdpnLJVj7fwOFRp1UW5isZgI7ofsHXdOUwzAumFeWH59_4-Ypbbf81xZ-1kf2hnrBHg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI-1Haj8HdrsdIwTco24oooJOKt33CUsa9CvFU5RtPgw&oe=6A8AE6C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcVbQkQq3_gQ7kNvwHbodH5&_nc_oc=Adp44KOgrvxVfupL2PzEFH3h42xpZBukRR8pSWFtboEahS_r18Z0DFP1k9HdBME
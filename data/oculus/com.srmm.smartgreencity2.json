_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fpasc4xBLHoQ7kNvwFMfaYy&_nc_oc=AdpKl1BIeSdTqvjYrILvhgcR2_9CDNqbfrZGwwHstfKmqhalU844YfbPnfr-77Y4pTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lR4eSibWZ3-I9lF9tMgcgJ3N9G7N8TbC2e_SgCYq2_A&oe=6A046A9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuti9hgEuH4Q7kNvwHttRQT&_nc_oc=AdqY2fHJ_upMT2q2jzH54sDEuixNfacVilwGTqtb-S6up_4Le4dU4wAuEmz_77K09kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o9qry7PBLUjYMAi0gvhQIX3hUs40XCXaRN9DzS7M4lg&oe=6A04895D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPCiLJbQUbsQ7kNvwGzdyMT&_nc_oc=Adpqu7kTPMwhgLsSqS3W_wEmFrl5WcxcK1OQlkyLsSDxET3lBc1V4j5eILU3_38bIis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wM9ZgCPNVkrT15iX_L3DRbo6cxypNB8NtIkAzh3wZ7g&oe=6A048132"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXbHer62cy4Q7kNvwGDa0pR&_nc_oc=Adp_z3WToTQQwN0DcHel8bJwZqPpy5zmsLopQLoVg8fpq_5DP9ZLcU9TIEAP7W_NPew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UEt95oXknuRr87z0L1aRIzkBOc99yYyLDdbhuK6EbMw&oe=6A046E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb3tm2-UgNMQ7kNvwGv45AO&_nc_oc=Ado8q9Hb_Y31DKXZl8XFj6UjyJEb149tcFMqAyY8L684UmlVup12lJjZcnxZSBDaJtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S4MtjlUGjJnyErtVp4Eheyx3t7fl-hl_JIVAoOyeoxQ&oe=6A047395"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSCBZHcwg-UQ7kNvwF5GeLW&_nc_oc=Ado4XmiKX6wMAbBp
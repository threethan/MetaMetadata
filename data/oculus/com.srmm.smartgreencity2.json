dc4BJopVBy3aYfSiQrybJzI6aBgrjQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BaErtkH6n3lCzipRppi-g7vIzowCfOcpSXUMR2zqnGg&oe=69FF3B32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgtBt4zeXQ8Q7kNvwFTubvj&_nc_oc=Adru1kctKk9hegaCcpznWddN53E_UWDNlyWAOQ0usz_wqytWwRwmXF-ClpaXZ1LdVrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NnIPkW8OlDivzVR1eTNJWaL7NZkV8f4h4ch-vsmsgPA&oe=69FF2857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9kXa-urH9IQ7kNvwHPPgVx&_nc_oc=AdpBAT7Wj0fFVMDse5TexG4x1JqDzf7ttG0JNX84KTQXDfUUncYkIuGRIWhIWalU-bg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dRCPYGGB4S02Och8m3Do674lW2Pr8Lyx73mJGmcgeUg&oe=69FF2D95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N1UjKTl7N4Q7kNvwF8AqOQ&_nc_oc=Adpxq4kYSyllHdT8yVTXaWusk1Lr-PWD4lGnPtCrc4Y3hsempG-Unjje6b4d1kFOGm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70rr3XZjXerxPi8e0HqBMzJV3ryuiGPpMyDTp39GIOFg&oe=69FF4142"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2G7URYtxbkQ7kNvwFteuPV&_nc_oc=AdrTCFzCdPP_yHqoqOD7bq4lraKWzLNjVeSoSL5Isw05XjYslY29I1V4LuoBpqabtp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t6gRJvGqZt6xsUG6-4ah13hxrf8YSmhsFR6YK_D_r1Q&oe=69FF27C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUZFspZte4sQ7kNvwGAvGOu&_nc_oc=Adpf9hsPFNb18TchZMTBdc9ygeuSZVH2dkuGZCKpk1gfOHFG7vemL5vXEad_Hvv
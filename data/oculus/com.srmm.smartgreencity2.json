8fNaBZQ3sDEA691LIQVvcEyml0zj9Z8KQht87ZicAkVqcKBPWxcHzpabaSFwYk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Mc4JBCNeHGxi7cBgKMXK1bSa4q_QmwEFmBI16BTa3w&oe=6A22D3B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2U6gnfvDfQQ7kNvwFssdkk&_nc_oc=AdppPZZScBL1fRgqVS-yAfJTkeutTz0WUnjVNOE1T7xlpHmhzbYxF_pRKTfayBDde2A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sf0yCAot2f3XA375DOXaKdjwEw9XdTbFMt2dljLztCw&oe=6A22F917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OZrfIg5RyAQ7kNvwEsM5nN&_nc_oc=AdpfPX2-9wdBQLXvu1koHOwCQqB1lvHtDlT3WAB-D0ppP1PNnDl1Ijz9FAH74DU1X3c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_foIweSpmSoaP4smD5HmTfbp0MxzgVbVW4fv4S_C3QWg&oe=6A22FE55"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxisxJ89QiUQ7kNvwFd0oq_&_nc_oc=AdqSQtE0PJp2GLnRVJyZ-_04zzFc4R6jnMvQ1Hw_0ol1MINW6nsoFwCa2YEoKkZq9ps&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kZ5YQPcFRqp14LnTW1sXcICT76vHK_ZtOXTEYxdOgkw&oe=6A22D9C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct66AR60SPYQ7kNvwHc_Lh0&_nc_oc=AdrYELxBMbNwaFnBGZ84wqwpqD7uVu7u3u6D6Dwlr2h9BlSSDxLFunU1-fvj-ofaQZ4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XPYO5L_Pjwnsx37R0te9TSF1LWziwzm9M63Z1bTYEgw&oe=6A22F884"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d3VPey77DkQ7kNvwFx_HjX&_nc_oc=AdrnR1BxIYjU9cwZ4HkT9FVYdMeOR
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tX_J2cMx3MQ7kNvwHvfMUS&_nc_oc=Adq1TYgQLE6-Bz5ZmHl_7ngKC3npuEqQppXhtB26ntxd_6GiqjRfb8cQmQeGWwyTs-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58fRpqCDN-d-um5y6CXJCSz5-90aiQ7cM7Hx-aXiJK0A&oe=69F9DE9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLMjeXJ9pc8Q7kNvwE7NMDq&_nc_oc=AdorbhXIrVJyvxce1TVU5l-gMiPJl13_IKSrFPHMKKm6kxIyp4g42_pr8IX18LmSrr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M0Vp-6VnYyj55rGsOnoFQKZe8MxrVMC1IeXOWPdQjNA&oe=69F9FD5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPqm6m2GkqAQ7kNvwFEMRgn&_nc_oc=AdpHuka6kmzKvgeaj6YJP87BRlABjfdl4MFNSl35Bada9REWCK-vEo2ivlnV6RAsyJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XBvYZ-y8nmk3nSCDzrokYRHSEudeXjZYsmpIA8mRn4g&oe=69F9F532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xSlvFHYrogQ7kNvwFSTlH8&_nc_oc=Adr5Nyer2BEKLhLf3dY-_J_mkG2LWe5MUq3QfFtCmVfrubWjCM3bbge8mS-MfRBbYyA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4leeIqU7k0r4MjvFkAIm7cY1-NOGKB-7v98Xl-9fzByA&oe=69F9E257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y5QgNAXt_4Q7kNvwHXzIXX&_nc_oc=Adoc9rGpLXZT_005JWdFX-YVkDKhNRdWjh8dhYVu1jbPfw63A8D3niyaaDcuP8mRKjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7COB4Lf4t3lLxLJwgoJK7GW1SMXZVZHW4z6mqKeTyYCw&oe=69F9E795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us-lpZFx61kQ7kNvwHotWBa&_nc_oc=AdqxGAc0RlBNeC29
SdRFfrciTVqsF7KvLk7YZd0M3FuYZtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GsJQP84o5lE7yWYNhvEj78_D9gRqQY3i6XcDWQucCCA&oe=69F75232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xSlvFHYrogQ7kNvwHnRibs&_nc_oc=AdqJSzvOcfJa7cFpjIOq8O98dXjLdMIByQqVZsPYXLCpqFRtSG2RZtB4JxFLgpB-jks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33Ps2ff3hga2wNBIwvgCZCE2JOqmpO-SjM31jtb9tGbg&oe=69F73F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQwkK6B2swMQ7kNvwFlO6q3&_nc_oc=AdqzYpE03jFGpxenaaRAEk_jd_jxMibTOjqI-DsCjjfxVwbLbPs1z2_8SIN_9wCMGVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1H76ILWfgTJTV42V4KFFlG_RgqFeAZ7ZCRoe5_U7TmSA&oe=69F74495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdJFxYSV03QQ7kNvwG-3Kam&_nc_oc=AdrhVpxwUA1YLSurc2NGVInpl3e0oG3nl0HRCzgkmLm3ehp0EGWxTWaQ2e475rGPBSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xqioStjZCDBXzjv0wL7TDbI7I-ANsphnH8_lpNYCLFA&oe=69F75842"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgo3rpWQxzEQ7kNvwFphyaU&_nc_oc=Adpk8TdNUjLknujj2QBNYmG5Pa3kTjQeSkoJlZGBYNRIcv0KivvFKSy0AgrB-OUEzz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VlR41DFl2WCWsbYVbo86QzXy-93d4fRhg9eZDeB6v2A&oe=69F73EC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2tgWg5EgTUQ7kNvwFT6Wc5&_nc_oc=AdoBQEbiNbb18XDEOaPUzeIUKOPX0A6Jq8WnWJlKc473zhi4DAkB1iockORZabR
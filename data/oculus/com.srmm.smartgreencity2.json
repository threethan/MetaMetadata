_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI63AM71iwoQ7kNvwGiH4RL&_nc_oc=AdokbHeZ_awkmOqWCfTOEuYSlyG_RBLMGElyyul10nD0JwB8MAdVmG3uwOrt5AMFUrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt8G4ahAYLJpeznPU-7WYMp2oXoB5oNV1KU7LC44QD9Q&oe=6ABBE35C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H09hpP420xAQ7kNvwEWjbik&_nc_oc=Adon-U6mI-L-h7Ac5ONHUCZUNe3RazK7gSsnT0FLyMtCfEK5dcBkk1ccPqn8Rmcg5jw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuhSUfQwnI_w7I9lVn8E7s0QU-Nkfct60yZXj1YsU07g&oe=6ABBC9DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sLoyrKKWJYQ7kNvwFhDzzC&_nc_oc=Adr_H-Czv_utuayzDzEqNP0KorPPxO_lQ0JGuCOZ3OJfW09N9idFuZ7jXu3648IwXnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID8seikhtAxzzOZaGrQD1texuksOA4IutFj5s1hel-Iw&oe=6ABBC1B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QcJvR3wU7AQ7kNvwFkab1j&_nc_oc=Adqi7vV17kgDwJ01SxSzN7z0-LFRCX2gc0nbEDomxepABD0ecxLTCtSz82m0TlgGo40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-OK8XwBL63AigHmw3uAllLr1D6lW-epM7nWmUVqtmaA&oe=6ABBAED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHHvsBGAm8wQ7kNvwFoVqOd&_nc_oc=Adrdgjs_aHsZON8lN0k6SqpZlDNCOFhgX585Y7FiIaY9iylfiVCNswn0dUQIgfwl2iY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKihse8zqRN8A6da_NPtP5AufNAcgXarKiDdC6nQc2Jiw&oe=6ABBB415"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKO1D8bRu3EQ7kNvwEXzel9&_nc_oc=AdpACmxUeMK1R7J3
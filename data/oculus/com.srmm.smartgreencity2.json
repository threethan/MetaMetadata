_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUHjE73uVd8Q7kNvwG0WCl0&_nc_oc=Adr1UvzP-0k7xn-w_wmUaH67lroak8rTM8I4u7fXlfDP8kxkmCyNgPHplwo4M83dJ5U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmJ1BbdiibI1wuTKt8d-tBEE6mX9X6sAlaFMeWhDe_Uw&oe=6AD0FB5C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRkKlrHnfJ0Q7kNvwEtSarA&_nc_oc=AdrIMOafu6SSbGgc9kijRSDWG0fVh8IgWP52O1I2VV9McZ4UB45MxTplnUL6IdReDBY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl5craKn4oj4qaTxSHIa3RNV0iIYSo1tMtZ0F3XRimcQ&oe=6AD0E1DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS2CinUPHzoQ7kNvwGrza3T&_nc_oc=AdpKyMhH9ULsCfuD54nyGYeJDeVUduu-J9NE-lvaP02E4pmCiovognrDaA9uNZSXncs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaimcZl9kLjOryhgjmXZRc0f2RFfHys_W12NQ835ndZw&oe=6AD0D9B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlKXSLtegE8Q7kNvwFNL-V_&_nc_oc=AdrvjQSjWSH6p5vMcbPBu3H3JqEIt9lO0bSy88XePb-O9lQFUXo_etwhbSHo9xlONrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqEw7G4lGh59389S6ougGMX_Z31rDvGuWyZMoLPayx2A&oe=6AD0FF17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGO9uv8kxdAQ7kNvwGCzK1u&_nc_oc=AdoJFz1KdL4u9BClKhjv8PJSf7EC1tdgzuNchH5QuqrgO8gzcNH657y-UGUYSoUD_wQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPszFDauK0Fg62SLq2RzMZW20LBsptO6VnYzmBrKSpFpg&oe=6AD10455"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6P6JlpRtu0Q7kNvwHMbP5q&_nc_oc=AdpP8hYgAt9wVRJe
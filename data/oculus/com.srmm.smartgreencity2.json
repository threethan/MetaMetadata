ppWdq82XATu-kqz1hX5bziSq1URA5VMydWbnpeSKZvzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUr8XoaDMcPM8rBjK4uBEronc6YR8oBnK3dF3vA9s_JA&oe=69A2DB9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGTOP0m7Tm8Q7kNvwGIekLd&_nc_oc=AdnbrwyM_-DIRvPXjDHcHMzIJrQ34SqVLDdYFAsbCAcSdQ0fDJ0rAk2n1HnOZi0SvYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuC4N6rTMhXcQ90fyhpj6AqWozQbN9huUfl-fk1HdUV6w&oe=69A2FA5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf1_x4e1sPcQ7kNvwFE2nZb&_nc_oc=AdkK6EtxSPkQVRVnkyEbs-V_EjSNNw5-umb2kxwRYFJ-rR6rzupF-hXS2AjvJ1hm6N4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOMwYm-0fx8rnHXo1YahdidIImK46ytmUanZVOqLcHUQ&oe=69A2F232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urd7NPudP8cQ7kNvwFwOaGt&_nc_oc=Adk84A6-uYy6yg0M0cEXYmqPLlFyfadnAfXmtizvinZeBOdAhKOaOry0lSGDXSISTzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvK5ak6cSD6SikT_-5blVRuZeu37zxLrjydv65oLj4z3A&oe=69A2DF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEekpsQErfIQ7kNvwGd3Chr&_nc_oc=Adly-hKWKbfCF6aPnIC5T1Yk85EA5LiFgTJKq2YEAWqVG5pD86uuz4dRnjcxnWtauss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpwPPP9kt2kb7T5OsXgfWcWc9SZHpQkj39OdKoAnoQhw&oe=69A2E495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ovl9tiEaZAQ7kNvwGwLw55&_nc_oc=AdkmzBd4SZXFK7Rtk2M3GtTRdK-JtWMm6pVhjya-TSkodIdTDInPy3ubo1dN_oxttDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBZMykGfFzj5DQhdinu5aU-brNUR5zTZJgC3QhdOeQhw&oe=69A2F842"}, {"f
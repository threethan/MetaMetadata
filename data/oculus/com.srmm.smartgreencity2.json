_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrtBNgJYGkEQ7kNvwFVWGxA&_nc_oc=AdqDjCAEPjbKNZ7QmtvawFziyc03rftf_R924LnEVviwDB6B8R804QASRrNIfKhZggM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWjNyXpC9vP2q1y1tSlqVMFXn5ITkGyfSlSgm-8qEgNw&oe=6A79C01C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEs7OcCTcmMQ7kNvwG8NgLd&_nc_oc=AdpIy-yPgdJOoaLLDR5sULmWzc-G-9ThMo4o7VXZ93W3spaFzIdDlusPMUO3B37W5Zk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIeSbtnhNgISWiLCxZt4QDf2jHg5poDt-XdYFdprqwrw&oe=6A79DEDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZFLZ_RnYeQQ7kNvwFzLTwp&_nc_oc=AdqtnnWUjplnxZkgj0s4FYnRbGXloyR17GNr5DwAsXgwx6TdbpBqnMtBmC7W4etnRrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-rEnrtY55OHV17eaXRBHja6iJLVuwDG9aSTl3D29Nfg&oe=6A79D6B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPUsNsmsfdAQ7kNvwHUfBJq&_nc_oc=AdqwXoMaZc2yE0_0hPHTjmFqaBHgl7FDOGowrP4Ehd7ZBAw4PDYIWr7XfBp4K-sZ3PA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8lEsOhw9puhqEJsU-EaUHowpMMtbNpPM1w0Z9I5nCaQ&oe=6A79C3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSjPAvBKhwoQ7kNvwFkuClt&_nc_oc=AdqRUQaD5dma2JgrHb33zB2ZyLCyvpa1AfTqZ56k4_X5-QuXeJnFoVSSIAc47NgjPFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBdyUw9SQ8ZVzaXqZMocls2dyDgP-eK9Hkk7OLHNaNUg&oe=6A79C915"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQWO315w1HEQ7kNvwEUt3Xp&_nc_oc=AdrLW0aWEGQl1p3t
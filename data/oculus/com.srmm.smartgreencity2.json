dZ22tF3OPQXI80QBvwQXQ0-ZHnztdnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O3uaJnXxZ8zc6O-LUqHYLjXzwRcFQUPeEWNeqJ4cacA&oe=6A199932"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy29RQde5nQQ7kNvwFzG6tB&_nc_oc=AdqZBUQc8-1cCGtITYnIWeHA2V_zhch-E1AByZz8Cnfxuw5lDKxdz7hC2zUpdOBHqcA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D4V8ZmntkErdgrXH9Q1dBULKqCDfiNmKXwEFpuodwMg&oe=6A198657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnJE_U8_QBYQ7kNvwF3l0El&_nc_oc=AdpCqWY12ZtBMQnNBJdcLur_KVzkt1lxOyesBu7U-tGRrfB54HPNe6DiiRPBCO6KO-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EFfR1zENlj8j6KpC06G-bMOW-YFZlV00nRjHbVm6nIw&oe=6A198B95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuZzeJ-UEtgQ7kNvwGFhAqb&_nc_oc=Adr_cyXlNt7zwFffOd-HS7ClutOv1TJFZ-tnFECAwgVg5HZ2ZjSCcvLnBn826A2tyNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sOf9IO9oeDAU0YZxobZz3W3w54vhBQ1cBo2zAaNxYhQ&oe=6A199F42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM8ysiaBqTsQ7kNvwG-LE5s&_nc_oc=Adrjg-LN-G1Y4Fqf0jJf4AwfeT9pq9znkBq6Z_OCf3egoj0u1bASCg2FOPIbQRSD8LI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yeaQdn4bepUfUq4duqUommhiPJjMMO-Ajo_oHwAjOdw&oe=6A1985C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwnKoWyV1QEQ7kNvwG31XbQ&_nc_oc=AdraAOXFTuR-O_HPQyPVtBkcOPXA13-pXjGDDnAJwN9-L1PposB_7P00Ju9fCKO
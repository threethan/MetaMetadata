cUtqAqE6EZ3lHqV3xDMqG20oICMwJO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7wfALTSuOWPwQhuFhsLxrFxyKxMnbZpR7U8ZYv2mR4g&oe=6ACE36B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbkaVYmXePUQ7kNvwESnInp&_nc_oc=AdrUT2MsspeBrAHxCVG-kE1lqKOa0saDiq7HMvqwusGw6HiYRyLeYKAYK4bD9QzJjA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgSA4b2IElx5zt2z4xwQ8vgbMduQZg45i0w2WPn08x3g&oe=6ACE5C17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyqgCz11oSoQ7kNvwGGcZb3&_nc_oc=AdpbMx_ysmCtSXcZLdkNDG3LQWQ0-opLcv2d5SCqow4GW6sjQPvhnz1ob9BV2BYiE1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPus2QJpe-b1nzevkgYk_RVzIev1H25uj38FT-MtTJepQ&oe=6ACE6155"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6P6JlpRtu0Q7kNvwGIMzj-&_nc_oc=Adpn_OGIj-DohyS3izr_S4510LD9DgNf6g037uJP5KolOMDymUB9j_nyiITcSrZ8KD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUcZJpJPVg2qiyFoBg0lwrGo-V5dhq_PehdnExfxDjog&oe=6ACE3CC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhEpADF3FU8Q7kNvwHNl3nR&_nc_oc=Adpkn54YNiXMwKdSqcW6qKrTnnk7SzdJogLjeNJ1lNuqkKy-_XT1pE5Eq0W-ADQMyrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOR6BsoExWhvk4gGhYWv1VRdCplvSDsIiG-FfMOIKTYw&oe=6ACE5B84"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiB8US6JtooQ7kNvwELO5a4&_nc_oc=Adpof7Eqa65I2aUcmITGOVEZRx5VWnqHbOsf9IIIRaeLsnBYJ-FSpSdoTZbm9aO
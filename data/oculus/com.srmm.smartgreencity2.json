fufQX6RhILIk_9OMQHy5bK5_C9Jti9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdfLm5a2P84bBhIVCglkv0HADxZNyGS0SrGhrSTGARVA&oe=6AC25932"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaamLhg9rnoQ7kNvwGtdqDq&_nc_oc=Adolk0p4KDdjOhQZ3M8mYh5o5y5eIg93X-R4XftuY5P1GwBLcrDP2p4pHAvpscXfS9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjTvW74xh4Rn0hWYQnoclEJNftQWzLNPxh9PDQXZv8IA&oe=6AC27E97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87M7SyDlr1oQ7kNvwFv9ADg&_nc_oc=Adr_q-C8DngifJJw20YzA1oFTHCXjmFUcbV1L3EfLUKhnRTN_bcnuOfn9mlfdKijk3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrTV2kcAn-iddESTFwSUNe5CeKhRhG5aJTYPEOx8ZPfQ&oe=6AC283D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ976dnhZ2QQ7kNvwGUGZ53&_nc_oc=AdrTz14JHEEcoRlPp038xlpDoD0pi0HuKueICvhoAYmwgjY4aAuJLxYjlRox3e9luHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcZg4my3TC_otzzI9jOOVQciWJj7w6RJgCG9tKvNoTsQ&oe=6AC25F42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSXAxkUW-KQQ7kNvwE1-NKt&_nc_oc=AdpLfeOEw2y0VUnWcJEf6O7J9Na9JOT5ErnftZTX9IsD0SxQc3E5VAQMByf4A_cJFbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK43L4NGKzHT4ZmSjnG765-CTTINq1Chg0kceW7k1ADw&oe=6AC27E04"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elQG_oorzgQQ7kNvwGKldpf&_nc_oc=AdoyIhPYe4ezTdGKCSBippTMvilQnYf9n2Nw69aJ2_I3ei2yTuPZIC8Z53hnTeW
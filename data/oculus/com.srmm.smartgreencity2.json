_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-7kyztzo3kQ7kNvwFPnkcL&_nc_oc=AdremwNu2zmFOUUfEwo8pNWIbVH5YzQHLgIK2XOnpe-dl3Ztn69zKbo5L721XrpKq5g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1-7x81Pw0UewijQ3Jy6H_dmHHy8B0dr13HWQvU_Myuw&oe=6A97319C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AfN_wHpA3kQ7kNvwHWfBmq&_nc_oc=Ado9VgaS9PX8wLLM9ZOlVnv0jk7vNMdRsV-aQM3BlJ9wa468maB7HZKPBSzYKSvBKKs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_wUp6PYX8Dt0sP-MjGC0yCOCm3CULAC_KQr1GNOnYVw&oe=6A97505D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEjFRJjBwZIQ7kNvwGmGLoY&_nc_oc=AdrwKnmVXMH7xmj10IEHNyWTvRhnPeZ6XtYg4SjSR910T_8xvt4wmevitpTdrLstfF0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuRk7B91iNMjvGa6Sa1bTLMo2DD5wKnVqwwsadcqlvZg&oe=6A974832"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_j8rK1wpDEQ7kNvwE8-HRT&_nc_oc=AdpKu5G0JJUMkYhkO8kiTPU5FZ49Zpfyvr0QIc75OC4gvPJEY8zohErVHBxHDvtGiQ8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEasD09xvnbNewtMThF5XXxu3mzjCtSzWbqPqJXy-aVQg&oe=6A973557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXyzU5cYbfEQ7kNvwHAuqpi&_nc_oc=AdrIHMKobZeglEcX_4mpOibaUQ2749qJbHJa9tsFBKhqkAhhUtAOTlv8_q1O8NqRzbo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvYwrk0mfHm52mrcSeDlNFmchqAHszi95BHCUoLFo9cw&oe=6A973A95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOpOrc9RidcQ7kNvwFE4bvd&_nc_oc=AdqdkIRij2SNqDuw
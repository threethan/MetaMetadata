_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbWXRRr9abEQ7kNvwE-53k5&_nc_oc=Adp9Ig4oGurWO34y9fJvyjclk9uqAzo3P1At0wLtgqp5xMqy4NFMa-khxYvgfx3xsx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm64p4MpxKZAmPzEUHAryYUnB4yq20B9Y_cObuTtdupQ&oe=6A63569C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgATsfQwPWQQ7kNvwFn2jJf&_nc_oc=AdrWQwaArH4CyU3BA8LYO7a3L1r67-Qf2pq-rGf2GV_6bUEn4KOZeJKrT8tjscA0hRQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9Wn3AwSSjcz1vmjr38i8vfOL--FXiFRBze3HnQh6xQA&oe=6A63755D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TORdhRaCkEEQ7kNvwGQJpNA&_nc_oc=AdrkkDmC3JGzcLj6l-cr0JVPDGjN4-d1ktlHqudZBX4etv_ZUhiYJJZID0ZjBb_E-Ls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfQNR6UW42HruEHo_mWuVfeuLNHGop2fhtHlMIg9IFnQ&oe=6A636D32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp1IR4M2_CAQ7kNvwEDe17p&_nc_oc=Adpq_C8MNoIWcMb6Scma6ahmOHJseONTEb8T0VRGOeeoD-cQ6DN0dZIXjawvvbae-9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCMmrMpO0gUJkU_ZrKB-en4Mo8T6bGG7Wcli_ymrarPg&oe=6A635A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBQfYjXlZnUQ7kNvwFI5H3N&_nc_oc=Adqj7bpohwyrXOvZbFcS1KBlu8EspW9isMgYfQc4EOyZIgrDXlDv7XXDv89oiyCN_Gw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLO3XQ7OxQ-uHrT-7VzGgg8Bsp-JvOkVr500g2VUqEZw&oe=6A635F95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFJwCV1tcvEQ7kNvwE23c6e&_nc_oc=AdppkC4nE75nTW9Y
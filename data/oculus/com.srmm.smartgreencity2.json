_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Vjic3VS9AQ7kNvwGAXJqR&_nc_oc=AdqakfK-2H5rdy2zaqD21rm4JdmktRd1hSlhjgW_jNBUILa85O0JH2KNf3U8jn2icc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6L0v0rANrVkGEQlXF36QuP2lMN7isss6ZF48ps6gVvA&oe=6A9D589C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp2wQy6GM9EQ7kNvwH-WBFZ&_nc_oc=AdoGdYE3oy5J4VefH0nDlNN0gna4xka2AHDeNMSLWVYN1dFzfli60CSIxBkGDgi5K5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtHCuoHFK67ezN-s-f7LZW1xtn7aF-0ivaqwIkfp2erg&oe=6A9D775D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VqThRPgbNQQ7kNvwE4Ka_c&_nc_oc=Adqh8BDSSgqkQS7EA3rRaPIVSF8fb5_AsMC2wkeVsqV0F6M3Ms_C1TZ3dDFGuJ7N4sU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_ORJ-KXrgETDQcZB_s5eJCy9Oz2Sle6o11tBTnDmuSQ&oe=6A9D6F32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwUwm5iZHfMQ7kNvwHgBqfj&_nc_oc=AdrnaPZvi49-5f0YtI70hiyQi3Z275G_x6HVOnsg42YgWf-fuf2Di6cm1yi7K-BZE-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOwJIslZXCzrUfkiipTiVyXOt7pP_-a5wiLrNjoXCjHQ&oe=6A9D5C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhHw7-v59A0Q7kNvwF3CfLp&_nc_oc=Adqrzgvx3Pf1LQO1cFPjuYzGNq8KhVZBJ328D5LPpVselR_jNeymY4mR6uoV4B2hWuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBjpqKjKB-WgPZMThTi_h-b3nTKshgctPpk5bA1I3Asw&oe=6A9D6195"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtGEHZNU2ikQ7kNvwEWyxd7&_nc_oc=AdpEDRFw4QGQp67L
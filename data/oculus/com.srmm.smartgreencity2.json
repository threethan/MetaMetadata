rw1WmY_WGXmN5ug9osRNBt4ZX7wRBcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi27q8c4VwxB886sUyHg8io4036LK15aBamzNDdcw9Cw&oe=6A9C1DB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zAuM4x4tOYQ7kNvwHtvxvG&_nc_oc=Adoio8DlTn9drYH0pZdoZldOy4MKkTOoyJiZwo3Lte6hNEh_Hxqfl-bF08DuwhAZwN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDiv6-OlPTMS7vpXlRb5LJebVFtAc3-svrUr5TDXE9og&oe=6A9C4317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhHw7-v59A0Q7kNvwEf-NpZ&_nc_oc=Adp87n-RoLrkK5xgPB7oX4aP1N2-zQbBpbe_JuGurYVII2axj2-TIhP3CGZ06IqPDZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrg6-mzdHLn8PujNskrEIsZms-lp1LMhYvEwQUx-z05A&oe=6A9C1015"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtGEHZNU2ikQ7kNvwEKTnuu&_nc_oc=AdrnVVw0kzQnmusHbU9QNRwP2QdXXNe5LTC1ybFOuHYyYRivQlyOqHCmlguP0ZhcNg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9ypy5piiPBPSXsYtkjdrur87ajwm20DIaga3k5jEAkw&oe=6A9C23C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC2XTpAwxzwQ7kNvwGehKAo&_nc_oc=AdoXtCm4obafU-5gSKCvAIcR14RR8ss2McCeSnZvJ1BtdFnHNfakJiPj0Wex5pI0kGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoc-RAm4CJYPa4ZiHA8GzezCEhz-DTc8ClgWau7qmBHA&oe=6A9C4284"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWDPxxWQ40MQ7kNvwHC6WgI&_nc_oc=AdoQMESYY59qfUbN0ElolOxufPg_THpD7UXCy7tn-R-zCN6BdJXzcveDTjsbfnN
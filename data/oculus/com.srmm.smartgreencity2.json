_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7DGNm9z3gsQ7kNvwGY9hh3&_nc_oc=AdrRSfxrFNVOjvkAF7ee2uXDxVupAsVrEq2wI6uzalevbZmZ-K3WhlvwQKiO9CNeqIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ-DHDUr0Mngeg9hhgTtmwbC8xIUe4s7aYjjvA7seiYA&oe=6A6C911C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPhtV4kP8TEQ7kNvwE5yJCH&_nc_oc=AdoNtS85DdNMe-SpR-yr6j8JmFMlHP6kDcVLcbAnHS9rKaneqUvj3ApWrA1ylJXxY5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnZQ_km5Xl_Es184KveJOkz7YtQh5d7jeerti7nlLD2A&oe=6A6CAFDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B96KVPK8e6oQ7kNvwGWV7KI&_nc_oc=AdqpsRjaFmdzBvjvFKENw2VwR5GnZjwnhn_D0U6E7RTQrNy2e1OUno-Hqcrw0y9VQ0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBffIm0W5MLKMK1RBXscOjsBpWcx9XNjBK1EDEdWUCCHA&oe=6A6CA7B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NartyBQyr8Q7kNvwFJcexr&_nc_oc=Ados_qJUy3BQSi0nqnppKepfJEp83Sgkokd2Ex_bEgx17T49MBs3cyeGxAwnZiEmxGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIdTk3IOYtUFrlJ4T7R0jG1-XTe8e-NwwW-pXYCaNGaw&oe=6A6C94D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UNdnoriJ9UQ7kNvwEyeWLc&_nc_oc=Adq9Pnfi9yK14_SWQ-UV10wcoI9m_PFZuqzjY0J6A4cZXiMfZxU6-apY60JBtwyX5Ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUh1Lz9cyFxaiBxnPGjVAZogUKL0it7XAV_uWojQ-TCg&oe=6A6C9A15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMRbGfCuILUQ7kNvwGgkM51&_nc_oc=Adpz041nzUo8GOF8
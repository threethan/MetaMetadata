_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b72KgOMxu0QQ7kNvwFuJ8Ad&_nc_oc=AdrsixF98PJ4pyR-EUu8jQcUXnw5GTLwhAQBMuu2kREvc4EcMpyfSAVpLqmbZAhqAqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53yWY6S7dVyGlQdvmOsNEzUlTn5YrvdoaWXEy-zfE21w&oe=6A1DAF5C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yUmmW9aTiIQ7kNvwFyp56g&_nc_oc=AdqieUj-BGMzikpNW7HGIodoAcE-RPngdL5HCyO3JgYWlrZKa4E35AD7vLOLN_Ssizw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hh_ltIDXB-h5GdRdFjzgPW0hc5UUsVkSadOY9Q9Jn9A&oe=6A1D95DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9hMEIIZaskQ7kNvwGVDZB1&_nc_oc=AdoFRj9o6-Yj3pjHlK9oQaI1OdeMFYEyxxiVCfi4O1kZymHRH84YOJNIdW7X5UWWPtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IJvQt35V5qk-IihWif1vIp5-q2naHOOubt17JQOSKtA&oe=6A1D8DB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykEGyVCnzIoQ7kNvwGN-_7r&_nc_oc=Adpmljeg28PcXMJqCtAe8RDr3gpd3_aHdw2-DJ4WBl95y_maP4ZdLD_HgJjjFaO-1vw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uaYz-pKDSFlIpkiIxFkzMNmp6FtQpOHpgU_lcKUnkNQ&oe=6A1D7AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSDicPc904IQ7kNvwHXoPfK&_nc_oc=AdrMVFi3MHPdvIT4GuK7wJnAgeY0XnK93l3u9boz0w-WmwOSfBjaT0faedfuG5fPZVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CW4NaAAs0U3PftZobAnUcitcGGP8TZzyd7r5QZQBWbg&oe=6A1D8015"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwLvjWPs8jIQ7kNvwELkPdS&_nc_oc=Ado0MZb7_T3JPtND
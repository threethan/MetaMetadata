i5HprTvmeIzf2rXF8DGzEglTpTr8vo8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MdWZJhUlu3GHtL92-4whX1tE7ETB4pr3_wBNlYz6Wgw&oe=6A3548B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBuHT3Phs1EQ7kNvwEkQ8Ek&_nc_oc=AdqWt_vo_JWek68e99cfUQB82_tr72moQhKjj_1uvt1QYBOTFORKxiS_46UKyxcBRkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V422WvDrUXIoJmX11-5yWkUEETHWk9--VDrNkjI09Fw&oe=6A356E17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjLbDpo166QQ7kNvwFiTEl5&_nc_oc=AdpbYETNfohPy-ytpVlF6koBm4IazADx5IBPPZOO3xu0l7VaVIJ2RCF6p641X60SrLg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YT2aI_6RYRVQHzZCYmDfDY-xtnNHgS_KizX6pUeFVKw&oe=6A357355"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz9Vh7mI58kQ7kNvwF1CfKC&_nc_oc=AdoTwqhHwxRZU6FEmFmy3CKNayyANr4XZpNl83nZWskpeDFi3DpIUPvCElQk2XXLcuI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yr0XKug3GU9LX3T2i77oZlIilnxr8rYfyapoHcb6QMA&oe=6A354EC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eeHwjgjgzQQ7kNvwGCa3TQ&_nc_oc=AdrJUBFlyL02EJ1hMrQx7Rc8_apfYTW1csLi61xs18jOwoj7cWMcW2O3Pd3lGn4ECVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3uuHkFb2brTItxw4R2eoAGEgH1X8sgmbUpzX75gMdiw&oe=6A356D84"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZIRx06f5L0Q7kNvwGOyigF&_nc_oc=AdoinFj-Ol_VXGEKOF9EhpWEgk2fOt0HxoRdl89CN2ooUtOyrlBhzkvkGRG1XJB
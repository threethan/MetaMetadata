_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b72KgOMxu0QQ7kNvwExN5_W&_nc_oc=AdoP7M00q7zANCaInNPgqwdP1X5JIh3bMr5wLv1qQIELskB96f5VRcaEaoeXXs31oPA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CCvj8JE3uenRNOJT10-V01MvjKJdlQFuMLxOSiC7P8Q&oe=6A1C5DDC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yUmmW9aTiIQ7kNvwGasv3u&_nc_oc=AdpodAkyVt2iItvla-xN3lCPcnNBneukPLZRU3dh-69_MO7dewqXs-sYZx619eVWSm4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v7a1DENEY-46XIMZGba_92GSernoIQk-lb3FB5hMVHw&oe=6A1C445D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKxVC2C-YfwQ7kNvwH8UhPK&_nc_oc=AdreHxvynnvtzl99zilHhVPzuPRqqhFO8mY2QQBIgCjoL54ss-IBDBJqMN97pP_gryk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q-8XQc0EzBcN6vhPg-W4eBvJTWRK_XqQWIW3aQ-f9-w&oe=6A1C3C32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykEGyVCnzIoQ7kNvwEPs5-w&_nc_oc=Adok8RaD0GZKHNJ3ZC_eCglJU69sJNo_xfKGDmpcBooZeAZ6_RTUkc5X3lOokS3LOow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50qTB8-ACRG_JNtaQ9l5CaAuOPO3aiihLgJ8JbkeDrkQ&oe=6A1C6197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnJE_U8_QBYQ7kNvwH1eOWT&_nc_oc=Adro5W_8psIUmFCGPRgNBUU8Rjk53NhsObe5R7_KGsauUKCDcCGaBYz9rJe5fUp7CB8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WtuV6UFkyX6JdTfmLGcIuRu98pA2p5dzhOLOvQ3dU6A&oe=6A1C2E95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwLvjWPs8jIQ7kNvwG5xeRL&_nc_oc=AdrgZlJOdHC0b3PJ
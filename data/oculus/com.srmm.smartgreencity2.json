RRK-_qeXG5TY86Hsm8QneMJ68rno5NWHlye0Gz9jhLgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvXqyGCT7D6_It_u9UCuvqdPYyhffoQVUW0w4zdvXycqg&oe=69A42D1C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAR0RF9SEcYQ7kNvwGRSa4-&_nc_oc=AdnFuXaUU-VUOn8kOxHQS24zGmnUUyRXnFffQmbUNENNsnYNM5H2UTbIShijC2-cjUM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft3PPb_KqM8U6aWVfnjLeXtm3KrWMy8Vynnq-bzdQaWeA&oe=69A44BDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf1_x4e1sPcQ7kNvwF5q8EI&_nc_oc=AdlOJORolJgR29tWgq9iN2CHN0-he_XcJb36W6Kk8uIIB5gc26sIYPm3B0X2j6oEkJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftQ051WWkdnkj3cfKwLA8j5KfaJUSUveMEnWlVDi2NkpA&oe=69A443B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN_796i_-WUQ7kNvwHNmAGZ&_nc_oc=Adkimw0cvH2ga-DkD7VmnBvs2WlKIK-z2tUi37iXfEgnFmnsCWiqswBrLFIbnTbWMs8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsYYU9FPT6BzCQOwQnUZ_6A7RxuJnTvcBic_QjrZulFcA&oe=69A430D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEekpsQErfIQ7kNvwGmr4Sc&_nc_oc=AdmQz19GE4vG7vvq-oMiNeW_Rc9Ov939xERzLcNnLZz-aDdMtR1u9aC0cXRTNKqao4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftYnkNA6JhJ7sXB6ve9tc9mn-wB3mEN-kiALqy4woh9fw&oe=69A43615"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ovl9tiEaZAQ7kNvwGNhpoI&_nc_oc=AdmlCrnY6MuArbGuM5i_CvzxGkXQsYSqnnICm2JQWwCx0EjAgFvh2Pybt1s1b7Odj5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuggnt1V_e-Fuw8x4hhkTUton0HPSRkJ513-b5kjg_gtw&oe=69A449C2"}, {"f
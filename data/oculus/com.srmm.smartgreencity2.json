_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7DGNm9z3gsQ7kNvwHxDy4R&_nc_oc=Adqg39lDmYOYOjcwMrYQnEhNxcEJDN4FzaOARp8-M5RAtf6tCYLMPsz4sG29qeHtxMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBio4snLs285RIHjPZrj1_y-kuJ_0xaAo-4omybN0Z39Q&oe=6A6B3F9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPhtV4kP8TEQ7kNvwEsNxIA&_nc_oc=AdqjB_VxZJSH8L4XYpee4a8VPwZ8uHWEobb6CS_SDEqNBYicYpu8zlHfV7o3Kh_Fl48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO1dsXAHPRmeGi5tJl9AvNCP6mjTSuQUvIbhPW14Myrg&oe=6A6B5E5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sF94RqD3iUQ7kNvwG5YMBn&_nc_oc=Adqi3Bo6AA7Acu-hBQCqK-tSxwfR8lMgaSccXBJLv6xT3rgYv_v1eMluYDeF1ITcd58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6s6PifKTqpAku_4vWc-2GLuDMaCyyrXxz72Q_LVLPYg&oe=6A6B5632"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NartyBQyr8Q7kNvwH5ZBM8&_nc_oc=AdphLT3L-5LwicGLpsoqlZGOuQJQ5GF1-Mp1wnzeqKUGFVvSM5YfzblngemRFFRUGdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCGHB3a5dbrW1Nk_dSO8Yq53GJjOypWmXiw4KgIlndgA&oe=6A6B4357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nBNmHvsuwAQ7kNvwFsrcTj&_nc_oc=AdpBNKYOU5Pe02QYiqbe3WXkqWl_uLzyCzjipu6RQaFgF0h9M3fpF6r7WyzQ9wnEHxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCihbSbKlLiXosKcIzVHLDMHofqRtB2NELduquRfqu2zg&oe=6A6B4895"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMRbGfCuILUQ7kNvwGWRc-j&_nc_oc=Adqi0BoN1UQ58ZqS
C-4MvAwFN0mpY-m2GNcHtworz0Uwiaw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VIwEvVHWWwccZzcrw9C4P3AXi4dIhO-a472jqASj9jg&oe=6A242532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2U6gnfvDfQQ7kNvwHryq61&_nc_oc=Adrfpfu9eiZ1eUKlHw0bF1ryiSjUHbYnAX7uemenisBVj8mmJ0crp2MBxWFkszhFJDM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vr1iB04xftReADcJo2qydBozBaqU0wDApWgGbcMBqmw&oe=6A244A97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OZrfIg5RyAQ7kNvwFlTG-y&_nc_oc=Ado4n2rYOVUO5d6VZPu44Y4X6iBlcMZsWzOQbp7WKqym3WS1AHeYxAgJdkwG2XcNQcI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cvRAE8amyP87CAZ5jX6HbzAENbXu3yP_n94Gsunro6g&oe=6A241795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcKQUP8gDkwQ7kNvwH_gy-N&_nc_oc=AdqSubMw8m_pI5VPtXoWCyH-hMWoPtAyDu2L5OBfP5tBqobvt45JbVJvVzsPUQvZYD0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I8tgYJ1WzkHIlR3B71_DRV8ZccOPS-HhnvdXsvqyyXg&oe=6A242B42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c79kLYg8I-UQ7kNvwFKLopN&_nc_oc=AdoGLXdKGJK-yoJ97zgLjnnEB5023Fqo_bXNqt76sUXNg64hTpjVtN8sCQBa0ak8fYQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-XR5xQOyD-mIZ_MnB2CLs9Ht5NEKz8_6gDHfgEhVP1A&oe=6A244A04"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d3VPey77DkQ7kNvwGitOps&_nc_oc=Adp9QqY6_AuJbUrucUkL2P9b1lGAjsZV9sNuo9EGgXSloJ9Jh8PFVTS38VK6pRt
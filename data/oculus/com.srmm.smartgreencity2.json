_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jyFM-VSJpMQ7kNvwHy4aP3&_nc_oc=AdrzDU1yjPFZuy-dEVBNWGScgBzJh1HvAbp9g_DpNIaxzN9f1R5wX2Hy6zwrmlbB3fQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88h_sjiqIO3UhaKF-g61fJvVMVVj-SIsL4NxZMJl7vyg&oe=6A21A3DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wViOiRxl2EQ7kNvwGav41B&_nc_oc=AdqdGQQT1-c8gjPADDWZZI0h2flIVqFanuZ-j46xOGymcxB84A4ek_4p1vASMRLrDuw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rry13BUboBdSMBaIb3bWBSt5UERgSO4We7WiQz4Vecw&oe=6A218A5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSDgfu90FVMQ7kNvwF51Z6v&_nc_oc=AdqmYOFREps9g8Twv3TTsCB9T7CHVpEl8FGhmkY-FFosm9V8gV2yQWBP7RrMlJYdb7o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9frrnlWov38biQEIwT68RqfaLGdAOfNtSAd8psrAdGVA&oe=6A218232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IivGiFUc7dsQ7kNvwFXXMYj&_nc_oc=AdpK0UvocEM4MC6BfRf8wqAKm8xmJi6ch1wOqKaLKejLycUQeddmUZy8aGN39vsADrc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bm5ww_ee04S8a67ms0m9UnKYP_X2Jk7P9UbwzGz1vdw&oe=6A216F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OZrfIg5RyAQ7kNvwE4VxTC&_nc_oc=Adr0tjUXUx0o4JBvUI4ZyjFub0869ok6ZN4GysgZ-CzQsxZkf-c8s4gYdfOvOCD27Qg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_2PDjyXQl2oqEPdkbQI9Oa7ZgZ6j5NGUmswXBxN2OFQ&oe=6A217495"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxisxJ89QiUQ7kNvwEf9pqW&_nc_oc=AdqamZwQ3ycHhyb8
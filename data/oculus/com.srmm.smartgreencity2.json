_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUHjE73uVd8Q7kNvwFaXuma&_nc_oc=Adqz9v3aZZyxGuA-vv7avJiR04HOF8NNttuosXyMHYiSHRH6Y4T01zDxsToFAHCTJeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMt1RQcC-PgVXgGA60U3-LV-FmmMMtR9D26qExZgcsYA&oe=6AD24CDC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRkKlrHnfJ0Q7kNvwF0N4XC&_nc_oc=AdqqkAdYigpmY2lrXFSkZHpna2KMWC8-8fjxnwVqMkrTCoXfQrdnAgKFOWxQ_WF7lJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2pNAR7IzGegAI0HsRN1ylqRyw75t9PxgydM7fdSJehg&oe=6AD2335D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS2CinUPHzoQ7kNvwEshSlV&_nc_oc=Adp24fi5vdmgHhwd78Ls-xLvv5PrIZWar5MRuYkRIFZDffflcU63leG_xKyjvB5Davs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEo3RgFx8iqurpRWBfq77550zIvsEaaB0TU6bcaYg31Q&oe=6AD22B32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlKXSLtegE8Q7kNvwEajqws&_nc_oc=AdrEfkZwbVXEIALA15j7sLVanR1bwd78Ueg3Aqbh88CArG-b7_bLiOJwxBsdAbl7k9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkxKlFwSU1w9fzQ2eiK_F2Jzg5HJeiZcoZks-J0rBgeg&oe=6AD25097"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGO9uv8kxdAQ7kNvwFgomdg&_nc_oc=AdrUQ4pUs6jQuZ6HgRfq3fRyKFeUHIZsErG5hCUBaws2JxivkecoGKbPoYHS8KWHomk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiD4HJxNiEhQwWunzC6SjshRtJV0or8XFzDk9c8tPq_g&oe=6AD255D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwD5E5kwGV0Q7kNvwFMo15O&_nc_oc=AdrUcUeDFv8km-uE
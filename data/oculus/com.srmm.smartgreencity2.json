_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j3vVRyUGfYQ7kNvwGMyoI0&_nc_oc=AdoLg8SoUKR6atgIfebOms88VWiXp4PTy1ZFKD1uyI8LZuvGyR4U_qaMarTII4j92pc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHr7Ko-CgdfOTKc8PvHj6Q-JFY_H6sBGMbIPVIrUfQ5w&oe=6A8AE39C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq04TAfmM2EQ7kNvwH03R-V&_nc_oc=AdrFSNaGRBiRXZdMgSkRuCICjxjL78rI7vjbHIXtPCsryP3TG2YM7DtIgG8-pMqyclA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmdT5EnBTyacUCLaVlDKtBuAhFbdcfnb0-bll5OzXHoQ&oe=6A8ACA1D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sUUn_lKArkQ7kNvwGfXtua&_nc_oc=Adpz7nrbsGgV8C8r59H1IFb7Fc-LFKpaqQMjgssj7NEe9sqxb6JzjjyUBz0dPVWC4OM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyWpAwV7_xOAfqv7Rl6pzf8MGGztnVXtjsEPY5_jpELA&oe=6A8AC1F2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zk7UePDKm0Q7kNvwFwUrAI&_nc_oc=Adp__iyNcag4aH0vmPAcmKYWxeE1j8CoPEB0hlZ7ymyksNqlV7FGOjJw_kKVT1GuZ0g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_w8VBPXcQxO4ZnsICx5mPq0-w7-uqcD1jYI4xCMNtRg&oe=6A8AE757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qN5_SjCfXsQ7kNvwHjtM6D&_nc_oc=Adpv1mFd9WlemacgDvmOsxHL-tVkqDSM0ueNQMnRzvj8IIP_96SeHX3AUm69mRg1q6U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV5fyu1MamyNOpuTIJRS4emijgpgiNpZr5DI3AzNy1wQ&oe=6A8AEC95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pXaDVW0gAcQ7kNvwGYDsz0&_nc_oc=AdoVx6fppzb8gADQ
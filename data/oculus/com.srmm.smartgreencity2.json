bRFyhqPTg_vf7gognL8_p_WgTr8kUDpL6Rt-X-eyj5vs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftIrURZWgjfixgZGN0W3WVSsUV1ZBWdwRCGQ8PC7xYLJg&oe=69A57E9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAR0RF9SEcYQ7kNvwERpD8m&_nc_oc=AdkO_3zI8kPyKwNSp78yVqCCKWZUfQpgJ1QqkWCcuWJOKNVWSOU6A2wUP2Vb34oqTjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuJ890hTNHGHbxjYBBBeqRgypMY01wgSrGKR48fBEFWgg&oe=69A59D5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf1_x4e1sPcQ7kNvwEEzYSo&_nc_oc=AdkN4EOkVNnNLS7JPBVZG8G7gSC-g5OXUXq5qVVyDe7HO8NhkLp9eDTeYDTQghF6Tsk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvYf-94-BOJ4aE3Qpmbio0u9wgewtHlj3H-mFgnS41keQ&oe=69A59532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN_796i_-WUQ7kNvwFVtUOv&_nc_oc=AdnHypzONUXAdgT_bcC9MWIZJugBJd8cz-WAwaSb7oTMz85PeiaN3KD6NIWbwMQxRW0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvHsF6aBICnTdtnngVNzctYxk2oJ6_wjp4KT7rspbDNIQ&oe=69A58257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEekpsQErfIQ7kNvwF6pdZg&_nc_oc=AdmVbv6HC8aeyE3LQKOea1atDrJDIir0y7r5f9k1Fp8oaqyCNFzvt261B2tJwPpnRRE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvXgw6B45qTYWNZdlqN_xPE_mPWrs0zZlsbREL-tUCJCw&oe=69A58795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iauqEUoZCS4Q7kNvwEpaSJW&_nc_oc=Adl8j-jpe_vRGswA1zUJhyHBA5VKswsLcnRaguylHX2NoDi98U02DmpaZ7SnedjBzFc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv9h4bw9ZOgHYCTakUUg1WHcJaQhp6xPwAzqKdhNdsqxw&oe=69A59B42"}, {"f
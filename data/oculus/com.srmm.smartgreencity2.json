_nc_oc=Adot2jVEDe_4KMQsbySrpeVtUpS3kawlIdreu0O3XXRxMnugB2tHNoK5-SVJ1sOtVDk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEqAlaPVWAwLxx5_QNyzEltNWRtpxt4uoRynhCiGfW3w&oe=6A8D64F2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAWT5LKZGEAQ7kNvwH8j9IS&_nc_oc=AdoeLEEAT3rjcSu1mYkJObCsJ7YcdgnoXMivUZDX2G_JVTgZl_1V8ierRGMZtBaVvWo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtPlW9gXI60QecAybmInmlvMaPfrRFdareXveTBEEnqQ&oe=6A8D8A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RYK9YjWdNQQ7kNvwFmEhrT&_nc_oc=AdoA27iz85vnjHzya1vc4_qE1aJ54oudZDnu_MyZ-P6y_RNbBJXcroyLVxlV77Wcos4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTnOuV-zTCPUx_ce-UGfi86P2LLyFMDriGx0p7-TiZwA&oe=6A8D8F95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pXaDVW0gAcQ7kNvwFe_JC4&_nc_oc=AdoOmnIG8akO1l4TUoZc9i2CGrqlrAQzEVr55C3U2WOk_3ycD5Z5MdvtIKtd1WGVRNk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj7jFRdkSnIXB-Xzk8Fk9S4q-72iRDI6M2gB7lBwLi6A&oe=6A8D6B02"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEI84Ipi9QcQ7kNvwHjR4Pz&_nc_oc=Adp8ON50G43wT08GTL-4vmsMD7HhbGuv8cthc_k9C3PU_F9ZSpNuAiaxY1f9gwlKIhU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFima1zzAc0nknD__A6UwFum9vDpb1hCb_u4jwZTt8ukg&oe=6A8D89C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21YYcqmq0VkQ7kNvwGPeeza&_nc_oc=AdpZdLh8jm-
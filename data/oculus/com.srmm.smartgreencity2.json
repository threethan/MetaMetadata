w8aJ1WO35-gDw_V8SW5rgQYwpndXAcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5S_UbOqi-LGtd9NB5-HkgN7U_6yvHrVwriW2lP8Y3Fw&oe=6AF358F2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SIMz7JKLqoQ7kNvwFC3Bzn&_nc_oc=AdrdN-bnUYjPlftp8roeVApPjVMMWserWTJbulE_HNaJgsl_SHeN_2dq6KTKH-eA6MY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc5KYosLtHX7SLBiFyTUo5uHPBGkZkPc1T0EaZA8bK-w&oe=6AF34617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eowZmjLQStsQ7kNvwFZU3OY&_nc_oc=AdrjikO2xgF9p-tEgbYomQqZHLZ9b51yZpV37G_s1WCXKaYyU_HlF1TENrNusnTwisc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqeYEnSMAzyUqOlfs215MBnVJCAFzub3ITDiA24RAfuQ&oe=6AF34B55"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYYf66Ic2kQQ7kNvwHySlyk&_nc_oc=Adr5m7K9YUBjp6yuDJHBwe0_ymrA7J2tGamDkfKru8D5KZdpYqbDMQTrg_U6upyyVYM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ62-LKiDbCfwnt14bDJfvmT6P536BXWT8N5BiFar3Jxg&oe=6AF326C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dYBdekWrC8Q7kNvwFyVks9&_nc_oc=AdqQYlKr-9vzceCMvGVMcbifoTnj9X1RpP6olcgUr2ustOJwOeT837BUii_Jw6ktVU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSms97jzm2IJkqZR12MQgAfltHSYMKmZ0T6vRUbLgg2Pg&oe=6AF34584"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWXImmq4SuUQ7kNvwE-1uRR&_nc_oc=AdrBHmfHSmgF3Y08WppUZwA7NbRcoLMkC-1Ul8GpUqUV1uT6s3PJ0fhJJmVNnIm
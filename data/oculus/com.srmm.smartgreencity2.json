_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0n7fokTAI8Q7kNvwHfas7N&_nc_oc=AdpKCxv43IOMDi3EAnAijb1L_zE_gBJ69iac4yHK_jig8YZM3OTvNsB5ns--RoEKfpw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7CRAGTW-q2U3PukJGuYbfQdSxFRjjtDrikoTnciMBzA&oe=6AC7C0DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5UY7znLc3gQ7kNvwHglQag&_nc_oc=AdoRXoFy4uHfxkdmgsRIO3htfvw-UEGgd7QP_dnPLGQyidq60LC2Epd4mfEaUue06Nk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEKjod-pdRzC4fzoqNwO8UbcIoSQR4R1rKhosbYxJF0A&oe=6AC7A75D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehFu0rUXzwYQ7kNvwFZqnkz&_nc_oc=AdrHo9zyFl_Ru4VRpZgozVBY2lkLx1sJtsuXgQH4mdQ6GoEBO7WJo5YybguhSD6aKm0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTvIoyLcb54gjpziWWO0CNFGXi1qjpBnemkP1rbyzT5Q&oe=6AC79F32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ABjnWLhrc0Q7kNvwGCUQTT&_nc_oc=Adp75W2FSGduWU-QhiBclnIWltM9so9SYsiZkclOpz1bS2vG0f-wKyHQ_fBWocmwdCk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNurp-ZhlGEVkdbSyRARYK5mg4GOeiOyPh9K5r81ViKGQ&oe=6AC7C497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUd8ifLt_DwQ7kNvwF1Y4VM&_nc_oc=AdpP5C0c-9YZFb1SO0NdQoCIw8ECOzRW0kQjiugHN5PVtI3HgaN7OhvSyjZeBTFFeU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9QXR0boGuZL6HVvxTFLV10SBXRrL7qgJ88BKuQXHlBA&oe=6AC7C9D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOBAQXhTg5oQ7kNvwFERpse&_nc_oc=AdqIQpj5ac1-nXtb
TfolPIEvDf1Jz4BlkgGO8BBFcjkdT7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK8pPXZN9FaxXERs1ZIXMHxUIe6KmsH8eS_mInNamgOg&oe=6AE0ABB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f45Pkk5ysB8Q7kNvwGo4Vw1&_nc_oc=AdqXJsceUkIFkhc6OruZCD1UYGMF5-eDSpuSFK2vkw9H7Thv3Md2KPKmi__ZjDUvHbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLYserjF7buKdQ0Qxu62VY5S--AeaUs8JzBmKSh9V1IQ&oe=6AE098D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8pheZ9v6-wQ7kNvwHOdHDo&_nc_oc=Adrq41dXz4v81_w6P7yqnUvhLssuVlYUEJocYliyvhzDPSa7sXmtpolQdcES50LtVU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6XNVECRTlBRaNHqmvqfH7oFUSXaJMTU6DcdENU_BTjg&oe=6AE09E15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLcSM318wQgQ7kNvwFln1sj&_nc_oc=Adp1SSo8QcTSVZ24-ZC3QvEuB1tlDQsQjx3Kfcz_cLI-sS_lYR6hjlY8w-rrTcayAPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPul9I_a4kdVwli_tIPQkl7jAB9304mCraA9A1RAL1r_w&oe=6AE0B1C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKcdlQ_sLlwQ7kNvwF_hOFw&_nc_oc=AdqzRLv6piuMqVoNsn5F6BUOzwiroJ6MXed2JTyQtEiZGGrWSXwaFyK3L-Av4WY1mBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwvJGR1xTQmzvLvKPe2Jazd1ElnbXvDQ0qzSdoW_235Q&oe=6AE09844"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYEVdi7O0T8Q7kNvwH60WHr&_nc_oc=Adpu4bDO6DBv_m-R-Yj2OgC-IphrlwCksJ3aC85GvKElNGi3yc0GEdlqeIC22xX
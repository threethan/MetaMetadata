ND3fE-PGsVpzEt-OLp4tPinyVM5r8hE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymoifH5LtiXRCZOzPYOX0ykEaHb00_05CBEuon7FDdnQ&oe=69CE73B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKaU00icZ9AQ7kNvwHY1PQg&_nc_oc=AdrFZ-3E962SWQyjWklL6a3Qd3l1ZSxlTXvWV_v1ZbLW3bRhnkufSHK_SRCSfJ9eRJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7w1PpozGr0K1qwWfvieyX7G5z9jhXV70K8D5nHniB7A&oe=69CE60D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDi7K2d8zjkQ7kNvwGDfEr1&_nc_oc=AdpQyM2GXU-aQrZPKjpKds_pjnf5wiR_U4yFevQ4RcZGXNPrQi0sxIA0it4Bd14TEy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOUUsT2P1KKgPr4xo8pIfWQFHVA9C1dDRmjt_rasOZAw&oe=69CE6615"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyOU3aM-O_0Q7kNvwEJOmin&_nc_oc=Ado1rUoy4jLRIPMiTrhXFWODUnK6S-gPVza80EBpKgyUcar9pUFWqeXsuDaRqNB7Hf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwlt3SbRxQecaLkulziGi9wLG-NZUdUReMQyp0vxGKrsg&oe=69CE79C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2sKny1AvgYQ7kNvwHjZ9UN&_nc_oc=Adr9sDHyORsRnC56MriOz5I0ODRrUFn63mkkjGOvyQuI0DpFxYhhYMH9__y2Sp6FMgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy31PHwq2J0apWcxyvDESnoqzQZb_GEteHKy8CDknfDnA&oe=69CE6044"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PadYTiVSvJ4Q7kNvwFtmZZA&_nc_oc=AdrHD6L_OYKKx6hkRPxLnsC78V7QX_4bemtswObpDtWuTgCpoot2h7aRsoB5uWh
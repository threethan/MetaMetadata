_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b72KgOMxu0QQ7kNvwGTwUAo&_nc_oc=Ado4RaNIeTyxq5DF-raA4hplN08Mj6XR3P0WI3yrKq9ReCGTvAuSDHtE2GFIxbw_5do&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ofWjWCs7_w8pTM3ZOnRd3usrV8fQkz35OBncDOgl6gA&oe=6A1AD41C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yUmmW9aTiIQ7kNvwFg5pWC&_nc_oc=AdqpEBUhUeZLTpUS2w1XW6nLVkgst9zZD6PbcoBnd7aL8QkIGHv8kwbGZ0O95sC0WTg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l17vpD6CTXVSWxScQfLUWzBatbAXB-4X0mYd5nORjKw&oe=6A1AF2DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKxVC2C-YfwQ7kNvwGLhz3Q&_nc_oc=Adq2Ec1Ri8f09yj05QmI6o3rrzDNM7oqlRtaStGSDx-r0lk5gP25yzt6LAmn4UgkmM8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XUok8GpFxktK_MkqjhJCmlZaEl4hoj-FJ4oUA7zuVYw&oe=6A1AEAB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykEGyVCnzIoQ7kNvwHvYymG&_nc_oc=AdofIGSI3ZRBzoALH1l2TTw2CnqYgyDJFKesIgkmxEPsKchAq2EbBsqQLBaz_gZ-TP8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HVLAUG6vTxgrB3LgFEZOroDp2Ipvx87KyGWFw8d6NJw&oe=6A1AD7D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnJE_U8_QBYQ7kNvwFfoRUX&_nc_oc=Ado3bxuPY8jOu0kyYs5N9xLhCCXi9noxkj1HBBM8FycHGs6fkU80gALrzaZJ7CVXt8g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E96Agl4sQOnVg0vPvBcMGxP3heos0jBSgaxcg5_lSIg&oe=6A1ADD15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuZzeJ-UEtgQ7kNvwHxuedj&_nc_oc=Adp1tlDdBwFArtbF
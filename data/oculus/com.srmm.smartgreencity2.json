Pn-gs8m4WrSj3YP2Y5skcb8WvNpE248&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cOb1REZlUR1kEpBPyF6MM7gvV8rkjqA7zPqX1gh8goA&oe=6A008CB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgtBt4zeXQ8Q7kNvwHvn8qR&_nc_oc=AdplkzYNn_SHdFzmKgAI2glVdwLgX15yurX4Aw3nrq8PSBpH-Ynm9cYCjwHPF0XPs90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MrrKIhO3HI0L_unr0MBa__dD7lXGWWp8GPezrbpmaGg&oe=6A0079D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9kXa-urH9IQ7kNvwFLjC6P&_nc_oc=AdoRBFvqOIO_c-Es90k03kL6EAlwsqjk4MAPJuFteUaPB4YVST3w2o3u1Es8ktX9ryc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U5ovM7o_ZO7N46Q7rr9I4d0mGLKY05SkJfzdpGmSjJg&oe=6A007F15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLvZfBh5-HkQ7kNvwF6xgqA&_nc_oc=AdoWijG-PoTayc-dT36Ckx-N5EFe6MVGEdLItEHs45gLf-thu2H26w35wYPFY6JCL9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BUfNHJv0Z5WVxFGDFUvY5rwIy4jRAxBOAUoj9O0KWjg&oe=6A0092C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiHF-6JfbmcQ7kNvwHFnxJr&_nc_oc=AdoD-s7JKDX7J3CDYeiv1wVGHpNbGueJcSZYiuNaodmANcH4r_OENKmc_kHrt7NM61c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A8j8r5pfucMR8QrswOf4SwcR2DYqeoCgqwQvusvMWFA&oe=6A007944"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUZFspZte4sQ7kNvwEkDBs_&_nc_oc=Ado492oQT3uQ8ic_Wu0e3WOQRyiLwu7xV8ZaFpmbKlCYWhh633ihVUzSbOpuyN5
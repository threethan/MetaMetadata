tqGCyWyKavLgW8Rr-fp7ZJDzB85vdf4zVstXANEaCDIBqgZE69Ti6vMg_zQqsU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjEvldlXB-g9HC85XMNXykD2q-T738XH92I2xtrARN1Q&oe=6AAE92B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wPlnFT1FOQQ7kNvwFK8xt9&_nc_oc=AdoRwSEWyOSOH23O_gLlqmGC3hmxf4sUJGwKFGH0tdJtpVJQ0__ixjS31z0VbZi55Zw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDvnO01ric81-c7tmhC5D2tJLPcz44Y7F--1hc_FztoA&oe=6AAE7FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSp9OAaptw4Q7kNvwHita2U&_nc_oc=Ado9naWkWzanObUX7c8t2EIkRFCoN-cR0fznACARaGSWTQ86KDdaJm0uR6abB4tzCxI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe98KLuXTvWjGy3YRBh7uyyxT6oC9EvXjFwAN_SK2mtA&oe=6AAE8515"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uysOIGkZYoQ7kNvwFLCC8p&_nc_oc=Adqq5RWJlEQISsiSLZZFVzGKhSmL2uAPgGT-VifQToxxCOZNbgYJLQ1uqbu0kxaGieI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJesg0oTe309BcWZocZ1kIDlEPMkaMSPlpw9zHgxxMzbA&oe=6AAE98C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBftgEbTX4MQ7kNvwH9rjo-&_nc_oc=AdoNIsSZxVtDLbcxQQW1FjsQcS_OuTidP33ntxL6tXV5-sPiCI3GhHZfBk8ZmZRMHOo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI33n736GKI_l_AB_3ZyI94NqgGn-HG84nW9Czr_gd9cA&oe=6AAE7F44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5ZMj_td0oMQ7kNvwGBMEs8&_nc_oc=Adrhw-snBX6cPm9RcSbPr5_8aGpWP
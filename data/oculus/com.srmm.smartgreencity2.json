7jvUFix_vrqtAyagMFbFrjd9vY37eow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMD3yGtIa4A2xGdfHzrjzstxaiP5-rwYdfpnrBv-CWNA&oe=6AC4FC32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ABjnWLhrc0Q7kNvwHCI0yZ&_nc_oc=AdqpdSCWkcg_00s9BK6163jfel1u-xMExZfE6tcDrqcpK0Oiz4bVU6giOpjav5ujy20&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9KoZtHC7P_wSNP9I3CNBPQhqY95G74FgsbxMqZxqdKw&oe=6AC52197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oesm5hbIDJ0Q7kNvwFnExXv&_nc_oc=Adrj6RkBSF2lIioCzChieg_b7lZDq_QoQjzgrGodQDxkbFjyQDGJUfshbvYMGCf-F1Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVXWBm9YNIOnZuKraho_8cPF0IgfD8s2oS2QD0vb2UuA&oe=6AC526D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ976dnhZ2QQ7kNvwEnAvpK&_nc_oc=AdqWHEDbiFzkcoX1CPol9naetkU3IjFzin63752NpMJX90ZanKavOBkgVKoEDsQigp8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEwceEs8D_1DSdHTfsBy2WHfiJf-OzMm_DaATwKnDeUw&oe=6AC50242"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSXAxkUW-KQQ7kNvwGq9Eh0&_nc_oc=Adqyf52PcCyJdvBNUebVuBU4Sq0M6vMdeQH20VXo5xwV1coXr70wO9ZpCkHHaNbIs1o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCj4HVLIWY6yhUUcRtq9uiVyyW3kHak4HSoLpfVzQ97w&oe=6AC52104"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pheJxCnuSkEQ7kNvwEOvP2u&_nc_oc=AdoHtnYtc5kR9bd40lI4pEHoDsjXfdIchL1lblOFuJRmn-arKinIJBXr5zvhqfN
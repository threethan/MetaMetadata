_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuums2L3WjkQ7kNvwGKhhcb&_nc_oc=Adqa8GHpClnYIEjVBWs3aNh0ZB0Sl7xRb3DfcwUAYKsWaqb2FZkFwWiOz1whJLL0tVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcwxzuRJJ8kW-vw3Xv9wp5bN3rMJa0pCo79xcv5vNzrw&oe=6AAA879C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fma3gf00LqkQ7kNvwEjaR0N&_nc_oc=AdrfEawS_rgoGJ4d3ODn51Kf3mVBD1myQgb8Q7JoIo2gz-n5BIQXBXQP_yainjZrc_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnnUBLL9oNaZbN0q82jNUUMgsmDNJqfzSDap5CIii37A&oe=6AAAA65D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJaYzlaqk6QQ7kNvwFCfCqw&_nc_oc=AdqXrkLmVFw0xzknVFcjUYmsEiSoRAcv-IlBrdV2C4LAz3-hahsgu1mkpdcIYBvOJqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCRd69uLHwNqqjW8HJi8vpMTVeF13hXtQsxefQup4c3w&oe=6AAA9E32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IIKJmONy8YQ7kNvwFXZ33I&_nc_oc=AdotNI5M0JEYqevc21fhVhYZXDg1HiCwxFOQUw1B3c9XnIgovNw9GuOyDekNacrgU_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIybtUp2nW4yc0morjFkOhN2owSBWa_rZrGMYRfBzZ-Vw&oe=6AAA8B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KUuq0bzIhAQ7kNvwFEpTTD&_nc_oc=AdoLyvNwBDA7tU6uu0_mwRwEV-KBlomlxROrjtys7mWrSzfV3VkQNcLEteLeTJ77R-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsLu883ShZsFeI7eVQoaImx31d8QHwXS8fixZEhNss0Q&oe=6AAA9095"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LSbdW76SFIQ7kNvwEpYfCr&_nc_oc=Adp_I2g9eoKfTDpQ
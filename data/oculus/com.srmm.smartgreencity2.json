FRCzGHjbMvrJpQ2pD2QGi757lFtFPy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSaLQ2FjogT_xZIPrD-sQFv8kvCkEZQ8GnxhR-0nU14A&oe=6ABA7032"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QcJvR3wU7AQ7kNvwG1ZxZ9&_nc_oc=Adqiy6Pr4p_HFbWBlT4l1kEJzUqyO_k-p_NS44tmvOoTJ96BECYtmdvCSeF10nZYGP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvY0Zpq75rnVjsCtPtjaPBSTT06Y4u7GI32Oe3-fc3tQ&oe=6ABA5D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYX6YBhTwd8Q7kNvwFj1kJY&_nc_oc=AdraVR7EMLiuREkUa4S_UAyhTvoo4sCNRs-ZWGSxPIJ8q_pRbMEJIy3-3ca1t4nfc10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK6ZkkTkkJrvvTcgp43kFnIx2UIBy5SWx9pnBlaWmL3Q&oe=6ABA6295"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKO1D8bRu3EQ7kNvwFmka7h&_nc_oc=Ado5NTA79thaNkT1_I6AKhg2kiOShxe5l7iNLSTuAutrK3VFpEPIFba54I-9KPYuPII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsmfyOLShZw6cfA3DOCoAJuxXxGN6tEfV9_ROLDQMWHg&oe=6ABA7642"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG74BL0vABgQ7kNvwE0j8LG&_nc_oc=AdooYYCNkwW0c3BCaFHCayGmjn049S0tDSzT8V2fj6pOKu4-TzEi7o_-knQFL7xH3UA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1FqF5GoqCHjHZY9Llkq5p9tYbn6exlj0gvSGkLAQ09g&oe=6ABA5CC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5m_QhlgDG0Q7kNvwEDJN6P&_nc_oc=AdotppyRIglUagoKAV25ECQ0IuGSrOZfqedaXX2qHnRmJ6rNN6hhULyQU2BComJ
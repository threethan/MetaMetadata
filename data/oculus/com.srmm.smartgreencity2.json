_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTwmbuT3grYQ7kNvwHpEEf6&_nc_oc=Adq50Iv_kZLvyh0fYado-ZXSh-q4tGYzbHJmTRJTHFiKUXw4TEIn3oBcUR8i0LW4DCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMJyGxPU28yr4GRxrTF5HJ-s7fp2YpqdA4PTm1mHBsxg&oe=6A786E9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvYoNcdXyD0Q7kNvwHLx4pl&_nc_oc=AdqWMhscIuifdqjg25w-xEfEWAsvqKsDFc3f4Mshvqq3Q_jeIBw9LIqe8CGOdBz0K00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2DkDKyPVruWciQwbVYa4NaETKwzeSEVNcHwsq7TB3nA&oe=6A788D5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZFLZ_RnYeQQ7kNvwHf2mIU&_nc_oc=AdqwBDmBr9gWsC8sEev1Oqg3R2xg9nVlQP6OEclrhfMK5z8JJFK4LrLjJ4C1jMCg37U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2vPcdvZwSOAq8Pg-SJeYWShv6YR5GCiifHfGvcrSyeg&oe=6A788532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75UgdzNv3vkQ7kNvwEAk2Am&_nc_oc=AdpB1hvQweEMonIr4xqUzxeinwsk7updTRhJtW8URUf-HL7PkAs7OGgjS1Md0SNabOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH94h2gE8CmSUJyawqD2O3UkcN8No7_HZ8kJm-57FZqBw&oe=6A787257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSjPAvBKhwoQ7kNvwGossTd&_nc_oc=Adphkf9FOKtncb3uLEzikmLot_twUcPtTbjonVClZrOXsoYFTWNQU5Jdr66LNi87qjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZgcwQ6akukvLCF1kmj8HsYtJavHJV6SNtTF-GWX18WQ&oe=6A787795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQWO315w1HEQ7kNvwHwRe71&_nc_oc=AdrSsEdZiw_eGBWB
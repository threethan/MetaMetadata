WU5jhuazr5Jg5YN2k9II8WCNHqodc4r6W_tb6nYaK8Zvq-IcifVDDkSLzSH24k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SvOXetWjbkV61TtYqCveEltCT-vVEY_dBoahTEymOtg&oe=6A393D32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_cv5w0BuRQQ7kNvwFzv9eY&_nc_oc=AdouADq12EjR6IqTdeJRv4tWLYxyvLy_EoVCABRGi5kYfySprNzGDLA3cEANCc21Hn8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3lelPZIYwhF9DCHVzp-W8G61_N40I_iak8MosddjMfQ&oe=6A396297"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5utehXi71D4Q7kNvwFccXBi&_nc_oc=Adq5r9SIYbgyZnuy9pz1Un8_I04IH8iqjN3w-XhFTj4X0K4ZsAAXT3YR_OEqwGNZA7U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-coebznLAeE6fmtUcglFhF7Ktzx0HN7ColSXaNE7miRA&oe=6A392F95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBWgP1lJrwwQ7kNvwGqr_4J&_nc_oc=AdohMA8gs--_JG4VhhaMVjqhN8znRYwFi1fL14KgN11utOxGUq-q42iUpJDq9OugVis&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EQxq5kkgP8M_umT7O-iN6yl56Ndce_M0GTnD2QvjcQg&oe=6A394342"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sme94qTCH2MQ7kNvwFbkNKA&_nc_oc=Adph2UP7p48zOMsB8zkg8s62-JOjcpaB7j4qJL0uXVFgW1im37GDliMxCZiNKEGM3GI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_77DaUUT1IgL6KIV1UFaCD6fcgNDTOR-WcZ3Zn-wMcKg&oe=6A396204"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8D1syU-T8MQ7kNvwE7vPxY&_nc_oc=Adq2CWvlO3u4lSXJWmOGZug9_LtzT
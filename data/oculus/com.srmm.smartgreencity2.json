k_0oQdYc9FOPh3z57286ME-26am_bSq8V0pHeQMKRlLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3Ls3UOAnwSmDes-g5_kTPhvFyEFJLOrbjFCUlVtAQwuQ&oe=69F0A41C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VimZLf2z7PcQ7kNvwH4TjOr&_nc_oc=AdogKmR0pFIJWPqf4oR2fzG678k__A64Lw--jVMb6n59pMkf3AAPNMiYFAJCCfUOkJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1S69iPR0B2PVswWKNqv1vuClBb0Tj0KiLvbtMS5xMe3g&oe=69F0C2DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF6lH23aq0gQ7kNvwEPQ9z9&_nc_oc=AdqbIn9YejthBQYsd4ueXMriouQvoVsU2Yt4xL1yZdH2TMEWfwwzeq1yUk17O7PK1fM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1KJjo7brT07YtOoCeyiay-aCNaR9dwG6OmI8i_fFzQSw&oe=69F0BAB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzaIhqjTSj8Q7kNvwH3-RqN&_nc_oc=AdqVeg_8a2cR154sX4hpf_QnEC96ylQP4OJIBAuu9gKr_yrKxVxOioPn_pxNdcVwAs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af145VTg3-nJbKiUN5dKXsku83J1RmM8_hAEj1U3WQk8Vg&oe=69F0A7D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFcP90Xkv8oQ7kNvwHWVu39&_nc_oc=Ado9_4acJbkBJ1RM5blhN9zdBGeYF5TpIncxEayY3Wg6GV-ENDdxHd-x1fCA5PlLMtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0i2zIXKS53tGTSnhTDvVu0ENkFEYR-txbGL7rOvNVP9Q&oe=69F0AD15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcGtOqcLDO0Q7kNvwFwpG9k&_nc_oc=Adq3nU_3yqC0ODxXp0lskWX5vDeDQnJ--m2f8Rah7hoyq3sDpKM3vVaB9HglMb9JdmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2TZWpU8E_hW51q1hlBpC26xkswfsIFy7V_Dc0P5p8BaQ&oe=69F0C0C2"}, {"f
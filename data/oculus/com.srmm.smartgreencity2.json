k5U_PLWmzQuIpNum2syz-dI3N7t6P-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfs-2Khe1qaEbuC9gYA5FpI5j7hH8vxnZBqk_5spvwMQ&oe=6ACA4232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXD8lTOsUjYQ7kNvwExk2pe&_nc_oc=AdoDr4bEg1i5tFkdmGD4yuEcmJEkPaX7wdRgaWA6YdEEQkEbvJ3WVpHvpa3m_jXIzlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx3LEu-Y-QkAzKsDPb9-RsOvAOvvP1RR3dqsUbzsWl3w&oe=6ACA6797"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUd8ifLt_DwQ7kNvwH2VBHn&_nc_oc=Adrwum8e89ha9RgI35h-tnDJYdm18NNxR2Tb2PXq7k3gPgnZgjXDuEyL-YriXPCGPpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUJCkA5y8ZYB8nOK4HBeLOKg8AeXNI7VaKxJ8RlYOfDw&oe=6ACA6CD5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfG2AJ1RMXQQ7kNvwHiUMxc&_nc_oc=AdpqKXbvGtVR7Cw7JtaF4LGhTdOITe9nxxej7iEkw-df4TjlY4klgmmPB4B2mQtlcrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjXWfRzpYhXo9cB9o3CBZIntcKMfLiTZhMX0_uEXTmPw&oe=6ACA4842"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcT_85zSAtoQ7kNvwFRfSYZ&_nc_oc=AdoPDdkYiIXQF_SmOoh9odZdkYdNndDybwIi5-b90u_n6Ye1mISTyPIevWC8zx7s3kI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVz0-cvhkQrMdkUjRyDwrR997DSIEkvHR3qYsRjtg9Xw&oe=6ACA6704"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fHZtFHvFRIQ7kNvwGpL-Ro&_nc_oc=AdpPL4Gk1LcVpq3-L8xxzISG-xT6bS08JBW9NWYARZn6ejmIaCF8gzrr2oJGvkK
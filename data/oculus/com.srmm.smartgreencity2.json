_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeuNaI0A4ywQ7kNvwGxVCYq&_nc_oc=Adp3A59wJ5O7bNOdqeDOf0uXJv5HrrS10bLLcTcuBssmlkwksRDM9ECaU8H-BU8ECzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYKF3rJ6EP9aQ-JluGJpujBRAHroupx5rzT-f3qGdJbw&oe=6AF5E55C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AoQB6VYQ8cQ7kNvwFQGUcI&_nc_oc=AdrMJfpyzJUFNeZEW-ddDW3YGSPSdKRKH6nf4P0eKh0iulqxZmugBDbpetkX71-RO1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1-4NDPULzibDLSEb8zI3n0lpJTjnuz6YX0gpC8cxa6g&oe=6AF5CBDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xTOqtHjYO0Q7kNvwGaOm-R&_nc_oc=Adovv2b2VtwpZfkBDYhO__IzNYzNNz5OtvC-Ird_-_iK4z7Tr_lPO_wLWufcn86YpEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN76CqeDYlHrHJjParcYWUO5QhZG07TcfZFziKKkGLAw&oe=6AF5C3B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK9DtvymYzgQ7kNvwFqfJ7D&_nc_oc=Adojnh8rdPrLF0ffo6HjfaGZj3dDyLU2GXrMNt9oT4xeSyIMEybu20OCm46ORks4YYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD0hzeQB1CTmnS5o7pdmSwpThFKhvAwLizYhar5ZRiiQ&oe=6AF5E917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eowZmjLQStsQ7kNvwHcjO8c&_nc_oc=AdqzN_Mgbj-hnf0N6uFlcG2XLO1PmxT-ASLlZ_1iTJfKyysMT4Yks44J_UfoofP66RM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf84qAK7MZ-mhDhwTe8X95XeC1Gn0537IoHtTPkBMP5w&oe=6AF5EE55"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFrQNvdajbIQ7kNvwFrh-Z-&_nc_oc=AdrrYzuDR-m_jMuA
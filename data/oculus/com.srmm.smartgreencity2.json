uMa5fJXOszCp0sUTcNlEcM7EbXow39g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-YCe9z_gqa7luRPh8kELaCXIXf_nDWL4C8l2FrcQ1cg&oe=69C3E7B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P5AhE9kgsYQ7kNvwExHMqa&_nc_oc=Adon1iqEf5af8O2f7Bzc4_TFbofzFCTxykEdJqheqnE0PIxST5xWEa6prHhzB7Qlwxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTRxwZM3D2M9a9NZ9jCJ6eVeTPufXwwTDJTQdBSPy_pA&oe=69C3D4D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgeZO7LWYbMQ7kNvwH_SmVs&_nc_oc=AdovE4zkey2KvwCXd4tTOFTRn09ldlgV2mggSIU_XCiemjyOXvwNFqnQx-BGlWN0EUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPOPi3Kqk3cTyPD8TGf1Q9jr5ZfbzxczZw48EnyKBJNw&oe=69C3DA15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx7sCANOCR8Q7kNvwHe6z7d&_nc_oc=AdopckyQO7pEiQiv6FBJb2TLQklTqZhrEFayboQ3XLoNvNs2MilMqkRPp4dP6Zeg2D0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFLp_cbp4DPkUsz5K9toD5-0QnnKJZQKlzkUHLdr48FA&oe=69C3EDC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzGCURRFBSYQ7kNvwH0cOmm&_nc_oc=AdqwMOihbFDLVxjL_TrbRpv8qvN1vuFPDipbVDJ4G5naaYQ5BFUzhMBEx85ocVo8fZ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwENE4MDoWWG03qkoAHFNzX-3Hs0-ZTfJMfD2cgK8p8Eg&oe=69C3D444"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sENSKE3hOpAQ7kNvwHTLiJx&_nc_oc=Adptgv61p0yfhYks7gKIjvZve6xLPzE1AKFvtG6UPnbT1UHx_-TEfNQtW66Lklp
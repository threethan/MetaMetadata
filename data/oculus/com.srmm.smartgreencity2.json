hZoLdKNpx9k0JmMn4z-iVyZGQV_2l5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_9dzcvsGrYjikBNLlpUIP2TjVorA6016kjaAuOSv4Ng&oe=69CA7F32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyseW1gS0mwQ7kNvwFzEY0E&_nc_oc=AdojvUDHVnfD8m1NCiuFDUUjageNYhzfq0QZu0andBWAQ0sMBSS2qd0N4DPwP2qJI9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0RO8LA9OgJl0BHH3GOAKJkrqfpNug1uVB8jlhHHBMeA&oe=69CA6C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZFWep5a1BEQ7kNvwFwxsUb&_nc_oc=AdoZ6jLxuymAPswHji5aiSInKqWcUHIjX-i5W04btG4l80cGYTx7l0Vjqiwwhy5YPYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKZmJ1EBja1QHPvI3X4BLVOThw-W8gIgKCvZEIVflMeQ&oe=69CA7195"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZx5VOyD9cgQ7kNvwH4DLrT&_nc_oc=AdquEe9ipEmYjWyLqaSsaUI_JV7WCwQyYU3gSZ49as1zfG_ikQpUQ0aYZeRQWAn51CM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCyH2F81S_LoKoAqFv6PPN_yIMnnkVM6y3TD-NQ2kqRA&oe=69CA8542"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUXxqjljr1kQ7kNvwET8igZ&_nc_oc=AdpiRcILO6l6XaeRW3DzfuInssC_v_zkfxM9pTaFmdUfRAvXUGb297wBBPf7lA9b5C0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV-Xch46AHt3EA9OHYQjlNEz45bbz2Y1F80zjdjWpA1Q&oe=69CA6BC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3abrsy9K5UQ7kNvwG-ZBLZ&_nc_oc=AdoTc55yQ5mgXnLNCrMJWGUSa7YK0uZCLyHlrYKenre5dUyg6j6lTpmMOy_5Jdq
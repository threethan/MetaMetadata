_nc_oc=Adq6oOzR8K12a3LxEiOLQBSsS_SJKiNhd9hN8hoj2X9eDPY0nbmGSSLnSjs5PkR2oWc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzVVRsWSIOyo0-Qh1u0ZwQG5IadhnUWnq6OacMn5Cmwg&oe=6A857BF2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWFnELQaqk8Q7kNvwFnq5LL&_nc_oc=Adqpc1Q3K0i3Sj0a-69x7p_34_NKnhcDfTqpQ3cdQtpc0mUmBFfa5QlS12tj2u_k_ls&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWleR5BrQgy7jYVVcQAUEchf_Kb4Zz_ysYyQLog2aCzw&oe=6A85A157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ncCCpzLxmwQ7kNvwHv8kNS&_nc_oc=AdqgY4e-Wuk2SfFBZoQb_tVK5r6DKqGIi5CANktQz6ADP7OhR0NUdCGgTNQgPwhVcxc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF214dCQlqLgQKrRFy9PcQEIgnlOwjhsnr152bbtb79VQ&oe=6A85A695"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZWyGRc53rcQ7kNvwGfktG6&_nc_oc=Adq3zLOOiKPERafXEK3i1_o177aTGNcoWFOFdF-eEOHX28iiL8QTL3oBjUaXAAO8SjM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBJ2_68wC0cRkhh-LMqaQeuLD4e7VirK-kq9rE6nRJOg&oe=6A858202"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InmRM-GrMl0Q7kNvwHEgji3&_nc_oc=Adrmaz1SPAwVfEI0Qxa3No3LEMxrbUs07oKKPGKfq-kaDpIiJM03hikHpUPGrj1I-b4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHibvfmrg0avWzoV41wNDr8_jzmECwbwBH4jDiJm_4YA&oe=6A85A0C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj6yvhAhdaAQ7kNvwErx81R&_nc_oc=Adoyk3sgCSX
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbhORaaJvUcQ7kNvwGeL0IP&_nc_oc=AdoI1fEtMLNMDlr2vtMQiR1E83MVjNtj7rZBb2Z70oJKaWzSqdJdXgz6lXHOCqexqow&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wP9_IjHDWr2MQiQWfAjgWL0iETOWGJiZmHiha2gCgkw&oe=6A0C8BDC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlPO53rSWLEQ7kNvwG4fyGt&_nc_oc=AdolOzLwAR7yAWw0D-JHMVGVlm2fUb1Utf9pV9xty78-uHRAqMmrxFREEvnFR-ScZg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K2UiqSHtEagrvwa0VZpkDPN4162CfRzFhjNnJskSDJg&oe=6A0C725D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShFYjXp-mlMQ7kNvwHICpHE&_nc_oc=Adozxalx434WMTdYcvGxA3-MeXcu_IAHQMGjAXx9ieNl9KiuVEKt_Gis4xy4_V3AKlM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6umeoc2zNbSNZzUBwciHD43dJOvXWQtgWZGfRgSr15sA&oe=6A0C6A32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsWIs4bQJUMQ7kNvwFNWJ2J&_nc_oc=AdpdbUfmnhu2j7n15CJfREwOKImmqOBl0IRCQSL5Un1IxgdtPWImE_h3n6yZZ81YMEU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qw0QiiK8ZFta16l3gz0bz2XP5-UzzuD75gV2rtqFoEg&oe=6A0C5757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBJIePVKfTsQ7kNvwEalmnp&_nc_oc=AdodoPkiC3gA4FdpoFVr-w_5Q7yLfJKXT4tuFrFXcSsDTwFKSwS2zLQoPZtANSHuizQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MgdW6RX5Ez3W3eZDIOC_ElGfZ9VV4CCRYEPsuz630OA&oe=6A0C5C95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkmzxv18QowQ7kNvwGd2I60&_nc_oc=AdpMYzlcg7pt2ZXp
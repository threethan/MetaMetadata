_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBdCzNmAaUkQ7kNvwF5h-78&_nc_oc=Ados0XZxD9UlOjbR7kIiwlxVDebNfzWgdfKSj8ale0MY0IsxD2X6btaDW4VITOSOLgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dvRNew3xvrM-Q9VG0Clcojv6YszzrMiHGNjoHr2yqjQ&oe=6A1474DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgXNW8fYJ-YQ7kNvwGLUDJU&_nc_oc=AdpbwyJh3QqoXhGCJH4qEDADbovmsEbDaNqWH6qRlSnTuWAFqZN2RWFK9f46KY4JhN4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YFFT5JHZmgEeAxYaN8iaIiJwAhb8iheLoLnbyMXtFag&oe=6A145B5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kgr1hZ7XCyMQ7kNvwHDqDHf&_nc_oc=AdpBVuq3RrbKY3Th4a7uE1bTuK4o9sB9Pw9e-g8BAx2pfxWmqZ-OAfiNrp8BoV7LZrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f2Em3l8rNuirNr-oWYH9OI5PsNQcBnLoQuP0XMwG6sA&oe=6A145332"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOlS5UClYc8Q7kNvwGdQV84&_nc_oc=AdrgnHV4lNAV-9bdL8oe6-_EKXsqCn_ozjyJhvDLFE_8NWNqgG1Ns1RKvbQA6366RlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZR0fvPymmMq7rnne-i3C0_ACnuDwTZaRHKRxh2abagA&oe=6A147897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0qvJ33hbnkQ7kNvwGsJ6WV&_nc_oc=Adp9bQpXxXuYsoLCZKrYvslE8fp56jHdbW4DqLpol0va-0PltDimEZxTFBxX_RIC77I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_zjBcSEGMjmVFByidqBM_pzLKQa8Swj1MFYIPIe1H-A&oe=6A144595"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVNBvJCjJwsQ7kNvwE09m6o&_nc_oc=AdrVgi5b2FSHtbqI
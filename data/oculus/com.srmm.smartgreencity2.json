_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO0K2Y5_3BcQ7kNvwHd4PUt&_nc_oc=AdrwHjjyh2VoAoX1FGcCgib-hGA_PUgow_ceNWk8qeSpgimClnl4AAGb7en4LTsVTm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WiF-RmiNY9ltk5R2FaFeo-4mORjojZHqLfY5q8ul6lA&oe=69E3751C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZbFP0eq--cQ7kNvwEsA_wR&_nc_oc=AdpcXLxPiuOq8FvdMlZkGinSBKK1Qqyw5hwXRW-zT4byc00ZBGUuq3lFBLdTBlB5__4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27uwvA2VJ7dDAnVkLE51y_nvYqLOXl_dHG6WvIgB4jIQ&oe=69E393DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Aqn310TzEQ7kNvwFt9nMC&_nc_oc=AdpZfkzNhVjtgzj-LH0YD4Te4hc4kEVp02bcN2W7IqXw5hsD9ssSI01BMP_uX3XKBHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p9mz-3t9BXYZ4Pj0Pjxv6VJ_S2rCefZtkDkVpb0RXYA&oe=69E38BB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2_venUNwhAQ7kNvwEsjO0F&_nc_oc=AdoqkMrIprIykUpYYpY808NmXWNvgZzFx4fLVeC8QPP2GsVBsxmM4-2yqpHZmFXvIAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ATsmQUUeSZtPf4Lsy1pMM1N8dqtUar5v4TN6UkEsOag&oe=69E378D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guh1yJVp1g0Q7kNvwFsO6om&_nc_oc=AdrMG3tz8H3RUETQp8JbQzSZqfT9m03UYU6gqKRc48FklBhOaQnKiEu8BhjJpVAyRuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rDErQKK6WDdjBarkZPM-SY4upECdserG1Sq6oMKaH5A&oe=69E37E15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7AvfMojMUgQ7kNvwEvAQ8x&_nc_oc=AdpYVaZ53qTewP33
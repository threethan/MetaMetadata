DRJ3HSUKk4OLvXwXxhZ12_ApWJYn_nk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tz-KsuBI5ecO2idBJmwT8Z3AQ30QsecWYBqe61lnOJA&oe=6A33F732"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBuHT3Phs1EQ7kNvwGV1SUP&_nc_oc=AdpHLPyw0zcQ6zw0bibz7W_Qt4hzcXBRcKazhio8S3ONmNyQaGyvJ-4CMv7uDBI76kk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PQ1HSGv3ZvYOmhNWAMvHcY24EJ9nTQYIvv9M1s0yVyA&oe=6A341C97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1VzpWIFkYAQ7kNvwHAQTna&_nc_oc=AdpUvwRtRGXs8mNP0HCz4ml01xR0vKgmBMr1m2JKodotkafhoaEj7hg-gANx4p2tW0M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hmQyifDrVVdhYcZ5Fh6UDKsDOA3MxD6yeOQ9Yqf0pbg&oe=6A33E995"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz9Vh7mI58kQ7kNvwEFo2rS&_nc_oc=Adq2Sv_YyV9gNQy4aS10geWM9pJu43kevjsgk4nQcAnFvkmu6nYoFe_BUg6TZOKfc-Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dR-3m_mRHubZPDeFIpIXrEsP0np4PwHuib_sr5skSWQ&oe=6A33FD42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eeHwjgjgzQQ7kNvwHKFWWU&_nc_oc=AdrhuMovuHSqYWo1hUT2sgUOAP9jGSkPCwBo02Xu1ebXHG7eeq4oRKEhvuSiDjh98xU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hUvjnIF-cPDxJEpj2GItN-fVRXlFi7zrLA8crt3e5OA&oe=6A341C04"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idOf6M2REcEQ7kNvwFMEdoP&_nc_oc=AdoqdzqXMr1BHUfgiWipzcBs5oPHPVy37Tb_0WK9oyeGZ6p7ZuGhnwvp-NPtLUC
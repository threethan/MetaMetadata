QprLBsZS_984fYMXG3FIlzLnkflFrc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzlw6KwlmLH4xBWqQ6SGv_831kr2WK8ZOudNzfw2UvyRA&oe=69C92DB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyseW1gS0mwQ7kNvwERWcA-&_nc_oc=Adqr2XU5KbllQ40J4npbx6-wvJ-mFHvVDn2rMCvCvDNpAGDuP12Q-Avqsekb0eP5AXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9WI0MWYeSMH45H0VEJWKf5AdO0zxy37I7cf1cPt_8xQ&oe=69C91AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAc2sWxU6LEQ7kNvwFHZ5-a&_nc_oc=AdqohjDAlVT46ko3DzGHg8iGelkzu94H5SNW2hnhl0ZaRtW0-2VLdkWrOJwj5HwMiAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS2zWmcaoWUlCwPe1cbtpyjPIxE6Spmcb5IEGxjIZpog&oe=69C92015"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZx5VOyD9cgQ7kNvwFM-6yt&_nc_oc=Adp5A_rESmzazunTyLvJuRcRfDJE546yoiWhdLMz7eDetgu8yGYxtiByGkXAt43ak9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlTSEEjCJPzbhyLnT_13KqvsPeipHBQ4p7rZcuDzfknA&oe=69C933C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUXxqjljr1kQ7kNvwHWJZGT&_nc_oc=AdqzLms65XAPy-0JD_PXpVdDS0qZCeaw2aU-B2j8gQ6pxPixzP901n8kbsTLlN-v9q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzw-K3eWQV-cxCHu9v96rkBxK2jkFD5r_s1EQZlQWORZg&oe=69C91A44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tFwd7EXmq8Q7kNvwGlUwLN&_nc_oc=Adqrdh130anquGFfwhRror4SLkQuHF-qrXjs9YAfMdnDUjAdQMtuTlyp_FeMMHY
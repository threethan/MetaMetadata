_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwoSMzzrLowQ7kNvwGf2I_q&_nc_oc=Adr-xEQFN-jj6959ZO_3reEqOSgty8uAL75sCSA8F_RJiZ2599SPP9dtOUnVc7JDJYA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F535Z7uNZ78xduZAIUfPxtTpmEts10PenCXE-ETOEjw&oe=6A10481C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7g1CHeW3bJ0Q7kNvwHqPicu&_nc_oc=AdpFhPrO1XvUsZUHzcRWS8N66XoUGl7_ctSHGOKD8mLPB1rqxhxaAxq5u2eGuPcNCsw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d42KcjHGtv4XeSaPXX5MSHb0c4XzmSZvxce1l18B9ZA&oe=6A1066DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28gN1FMgmR8Q7kNvwEX5cZu&_nc_oc=AdrCt_MOpx0-KuIClrJxw_FikrAIxurjLv65K-nPi3PMaYfK1hdGYVcb0xHVDLKd-UY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LEnkxjcnb9jZdKNIT8T1wP4qJkkCInpt55DAiW9lS-A&oe=6A105EB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55-muNlIUVMQ7kNvwFpdCk-&_nc_oc=Adr2iUURO4IOu5INQ2Dpa5alH6v8OB9qzQUTNmVn4CAXEZQAUievdX-O9nNr09KrdIQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i7OD9lgrpAcRH1i5dZ314ma0s_8OeJ3_ys8dKs-OfnQ&oe=6A104BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAAqGpulK6MQ7kNvwFZj7qt&_nc_oc=Adq3agfLDVjQM_3gwKGc2NHJ6eDzXgA9sh39dz77Yvie39MULQkY1F4B0Db6uS1EDmc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sBy2z1Lo6iMvh7pvWwZ289YGfkk5t1725G9cyUAbeOA&oe=6A105115"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuDEvT1yv0QQ7kNvwHPtWkZ&_nc_oc=AdpUo-CmtXt4-QFC
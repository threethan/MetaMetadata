_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOQQnB1_tPwQ7kNvwHP0PRo&_nc_oc=AdoQljZiI-K8d7tfLzRkUmfeAH_nWNFSAp9VbzOPgWgVeMWJNur--QUZudGNp1lAOtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsvS4vxQs6a1zxOiuWT4bzvX9JNkxVrEHHLa4KRWCAkg&oe=6A4F901C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=569sxP7tkgYQ7kNvwHswo_o&_nc_oc=Adq3Nn5mA7ZhPLKTwSA_xHchytDVnfBvfc0l5iQoxtTBFiGl1bbFTJ1Q5V_IKcIAQc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1FLcusYv-g7wPR_55zw241nzv3WomB6QPaUXkA3Xtww&oe=6A4FAEDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_va26lP4BNYQ7kNvwFWZ8m1&_nc_oc=Adqjb3W1gkunso12MJzEG0OPeLZNithJWIlPXrPYwSD-lbacP9SJQsWRQ7QUAGsPQKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFdMrGUykHQ1W1nLF-EPQ-Zl4uIGQyFjP33EEeiTpXxw&oe=6A4FA6B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uLTNYBgrvoQ7kNvwFb5lBz&_nc_oc=AdpFkJn5jm7hufyMs995FT086KFfi6y_MqSdNDQzhPr5hkQLBpQmUA22C_Mba24GnPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVQnlbJpnrH-pLIm-McairVFaDiE4R3j8YqQPN9PStrw&oe=6A4F93D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYAE8SqyApAQ7kNvwGQNbEA&_nc_oc=Adqfy65j71MqMDDrEmJgrA98QshrbxEVEfc2_3dPGgdiRbr8w9ZIRJSnEz8wiuGYRJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsOSqkqzbARCY2Auqgf-9PHHdobzmc6cbkuBKBlmHr_w&oe=6A4F9915"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjIoGs0OZb4Q7kNvwGWH7kD&_nc_oc=AdqzBwIVLJRCDSXJ
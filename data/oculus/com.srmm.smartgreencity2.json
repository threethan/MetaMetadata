sIT2QG06QzaPnNPz9BG7qdiRfc7gWI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3NnqX1FdL8_OETIkqjHuH3j-URV938zAA9PNVBxfvrg&oe=6A6DF932"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g02vsRoFyKUQ7kNvwGI5PVM&_nc_oc=AdpbyhSfelgaMYcvpTeex7d_WUao47atM8jw6en0MFk40884q4A7_ngn0BwSQDoL_5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB_c_pNfCZDuCGjCa1-wOboi1XttzT0rhpzPSRfNAgxA&oe=6A6DE657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UNdnoriJ9UQ7kNvwEwiceW&_nc_oc=AdqBlwPjyA1Wpki_PMBW5IMunfLQcWGPejG9_piBz90Q3yXxn0YCO4jlV9Rf3xhHOc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2TW0h4noew-1k-K1h9VsL15QTKhUOLWGpeSxGChNQ7w&oe=6A6DEB95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMRbGfCuILUQ7kNvwGrZ1ln&_nc_oc=AdpQsXmg-EpFmDMmfvWtnwvVoJUszI-u0apbqshzpgD73CF_DdQZIA6nMgTHOyXFYUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPLCz-Eil6ruShpajPPrwjzcIQ_faOLl7djUYLV-YCiw&oe=6A6DFF42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_02uwmFCkMQ7kNvwE6P6FB&_nc_oc=AdqTGdY-rfWQQcR8Soy0rpuGy1MIivwgiwznVeMYo4aXf8MFS9wFZVFqGQGb3TtDepM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXJGLkWtruU_YIGfknPS1X8KUUMeG0joV1i59aOgc6ZQ&oe=6A6DE5C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_SD7u1pXgAQ7kNvwGSP-c0&_nc_oc=Adr6dewDpwb1P-DHE5xLFFa8j9SeQyGXrVw5yUlAJ4KJfkV9UVcIJ22uhJCltk8
TTzPtJAlNX1bxD25r1QKEPEMLlCkYOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59cFZqVFyOPsLd3lz8aqhgw-R_vVcsmvz59MKP_N-fIw&oe=6A0DBBB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsWIs4bQJUMQ7kNvwGwYd8A&_nc_oc=Ado9zOcHRtIeVFmCAHN2W4qO9DlZOY7A8i8FpolxpjqzprUE47FxAFzk3qx3BbjKXKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DlH-2cv7xLmtv1k8DUE99n3hDuiRDP_zk3tp72ZEuJQ&oe=6A0DA8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAAqGpulK6MQ7kNvwEYejsG&_nc_oc=Ado_57-H6URj0vNrd_9rUbq7JO7U5ehmLQIhcUPYO4WQFOxzAyGb21trbj3C7joOpdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af769OGWYuQh1t5zWpilAEgzAbeYnbd6mkqicIAUMhRVeg&oe=6A0DAE15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkmzxv18QowQ7kNvwGnYMEB&_nc_oc=AdovwDIreY9QAdfQfB5FJh-bF2JIzYElr_QP546WLTI3gyG-CDg9AqL4G3iuJd6VhyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SHrSkh6hjFZwsvbsd8jWA9crOND4RQYUFntAfDZ3Mtw&oe=6A0DC1C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNndU0wNrO4Q7kNvwGpq7Oe&_nc_oc=AdpHFnJz75pgjOFjQ19Pw21GzIViVWG98vckCqjTOe8JCWolIpQ1d_KB919zTlXrIII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AU4stHD2ThuBzNlLnTNnlZWGGfPInVKojRDRMRElBjQ&oe=6A0DA844"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6roXnzWWR6IQ7kNvwFemJrb&_nc_oc=AdqR7r2wEyfM3G626VTBXacOlAW3zMc0IWxqKMlMX0oaGkn-D6r6GnXHuhELAdk
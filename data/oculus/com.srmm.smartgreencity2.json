_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xrKm2xEd5oQ7kNvwFcmcc0&_nc_oc=AdpEbLdKkMZOunQyaqWBI2zLGmfz9gCA4mGfdKxFlWReQrVTIsl1vdlqsDiTVmTCOJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0akyUf6dDBI2VjOW02yvAow7NJLbZMARdJ86ZViQPurw&oe=69D8E91C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY5N0P9AhH8Q7kNvwE9z7At&_nc_oc=AdoIFPWYov415PlOlGCulA-yh0_MICFJqfryIJsoy5BrmfPc9fiOcZ1byonPl3pblWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l-06BD3KvCf_iY2uYwdXV4bNMkC3YQ6FmDgDCRDXBxQ&oe=69D907DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LxsP0U9d-cQ7kNvwHTI9go&_nc_oc=AdpefP8XLfWNzkuyVMvSwH_KWYqCTgSYQXegKYNdy5oluf3K_h0EbN8FoB08c_5EMOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02ghumxNYUTGwLQt8k4hlxf1t4r4lAphuijRKkNo2EFA&oe=69D8FFB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMyZtD26F2IQ7kNvwH2l2qN&_nc_oc=AdrwxhfUSXy9N5g7KS5wtyL5PBV_Fk6DwmZMsB9J7UcM9QJcilRJ01e3WC9cEDwI9EA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nXf476CzthpuDJa6GGh2aXjR3S97uihN_OPnaUPGd7g&oe=69D8ECD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdBu5Zwt2HgQ7kNvwEq1y_g&_nc_oc=AdqWGbGm2CAownpXxJL1fA96apAiigrYruFqQL5YvEvqskpVF9tKTQIgXtnL2Q7dV2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hj6otAaBSZDsip7cNfXd97sgQdAMFhEXWnowMFUgdiw&oe=69D8F215"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfOym3B_WhsQ7kNvwFHwFMO&_nc_oc=AdoWcs3iBkrHJg_L
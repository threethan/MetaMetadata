EgYtV8h7kpDJs8RqsQ9Nv8l5oVJQe-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22IV1wd8zGz6Vkg3SB5Da4f6ZdRrptKTOL0rLC7wPUgw&oe=69F8A3B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xSlvFHYrogQ7kNvwGRkEKq&_nc_oc=AdoBTmCooXVBmbI2bwJdMKKenKhoxoCwOqxjnDIuhR_7L5AHZVdMwBQbKBP2IjYQwsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Z3xA_GSKgIoJbuclsDVP5Nl6yegDQQ_TeNdVsSkRy0Q&oe=69F890D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQwkK6B2swMQ7kNvwE80Q7C&_nc_oc=AdqD-Yz7y-EIZE9gehAuKVKG3nQrO_RObqkX_FAVIYpduRJTgKceodQKwwqwuam0Los&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05DqT3YfwWsfiLqIns6_YXstL3eHA8ID3NCHu2ypQEUA&oe=69F89615"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us-lpZFx61kQ7kNvwHEoZbQ&_nc_oc=AdrG9UAfSthUhfW5wWPpgkk39OFyXmfU4UDT1IYQm0JAPf5mMDOQb8qoB8vQefw5pn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3P-fIzEpksAjuLfZmn-Bh0S_4dxzTI6Mt9G2We5A-aAg&oe=69F8A9C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdUDqC7GmPIQ7kNvwENmxNP&_nc_oc=AdqDuUekgsg8-viXnsg5zW5QV7iSA43QhjQyTjb24MXiE-l2vDqAC3VqwJCrymtErjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EytIIq6JrcV1sX6hETz-9YmTK_1d0oVwyPdzwyO_IgQ&oe=69F89044"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2tgWg5EgTUQ7kNvwGdTrh_&_nc_oc=AdqEnFEthR8tTlQu327i8IbdUd355-mLzlRS6r2_uLxusfpNappxmUhpZ1F6BRG
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqCLNoo-8wkQ7kNvwGMZyaY&_nc_oc=AdrwabD1ssJcyYTlpK4-6YZyy6o0-UuCR8rlG85195sEO6g0G7MZEXGU1czZ1Owph0Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZC22BOUkGBohxlzPSncZS9hfrlxyJ6f4GE0IpFKF-_A&oe=69C5229C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBTaw6h64sYQ7kNvwF7SoBh&_nc_oc=AdoEdKpOjaDS2RiMGCLqpooWfEMa6yTsl4LhsMcTHDZXFXDKwCv0mk_avmt8CDkKc-g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFb4-Ud88Ust3zaP8um_nTP8UZCx081Eml2SCwi3V6Pg&oe=69C5415D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZHcnBYR-pUQ7kNvwHKbbim&_nc_oc=AdqoPQmCGXncQUndCcv0GzN4apKcnPM4qnJ1ztpIt8WD0unXXjndzLQbittmHIe7Wco&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQDj5NTkYXuIMxuIAQr5JdBxPGPDui_2Q4mc1AzvN_8g&oe=69C53932"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P5AhE9kgsYQ7kNvwHZQTxv&_nc_oc=Adomyr1sc3BbY3lkQHJ9ae0Dc9irQZU4jkU4J4xfLo128ONnrrlmtOsbh6M0jbf1JQc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHH2ztVHoTTjOFSDUzsCUE-tK5Vgzr_AogRQqUpI8jTw&oe=69C52657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgeZO7LWYbMQ7kNvwF9XDxX&_nc_oc=Adr3vFaxxstVVm1INw_zUWWcg3rCJdkV3zY7LxJuJPxAN7t8TXi3LCq4swAANqQ4264&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy--Tr8NJOXs1F7CPDUA27lu9sMjXqp3WGVRNh67FXAlA&oe=69C52B95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQebAyCZ3PcQ7kNvwHwjf6e&_nc_oc=AdoC00LQhOJcEkyD
22Cyf46qRM5CeIsKS6le_pBBYx_7dKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQWp5gBBUf3Mj5s-ws_W2_AbRS42i5RWGoWAU1biTlhg&oe=6AEC8932"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZhrDjI1xMEQ7kNvwHLV7Fh&_nc_oc=AdpTY89ljnwhphPproBy2ISMNBkTTGDVm0fO5g8C0j3Ggm8aCPcitisAEvOduyjaRVY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROdS-AU2fuMSp5_2a67utk4fk-_5g7ps1yOfaoiKcQSA&oe=6AECAE97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI5qc8792B4Q7kNvwEgCtjz&_nc_oc=AdowiLnG8I_2jmRYZngS4xvgoVZm7GDgF1PcP6NzCU-xNdJAtK902yhEVNRBCcEFxl8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLmFrJgYt0s_-1Q_Sttd24qd08ko0XO8ID9c4LhF0U_w&oe=6AECB3D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pz0Zo2SfMQQ7kNvwG8CzpP&_nc_oc=AdrLF9TVv3pdRPwHyrStYothje0XkhH9GgOiKs9cGrTAXUer6CUfMPFA1P1WATKpaKc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWoAq9uUjEc_3mW7Ov0NX8DDfu7dnwRDYAYk5HYRb7fg&oe=6AEC8F42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkt8tu92nqUQ7kNvwFsKR3z&_nc_oc=Ado0qvotZbA5u-MGr_g9i4KOAQ5Jh-jNCa8CnjWIkubYW-9wLQRdhTanCPwyq0lfrng&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZmasluT0a7GpcAbb98G3ylM_6J59Qw68cqV6jS2Z42Q&oe=6AECAE04"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlfTv3xskmEQ7kNvwHMje5_&_nc_oc=AdpphfU8y52RhUpsKSMg5--aq_XX_93cbV3Yh33WM_AyMbKLz-ZJ_22wRz4_UBz
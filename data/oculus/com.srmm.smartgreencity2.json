_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j3vVRyUGfYQ7kNvwHOc8_t&_nc_oc=Adpe9rCe7oOdYOKkkGym3IMUl5XR9ZbGF6bjxeC9bYRkfJ7lGc7KJKUiISTiNxZ6yoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPmIj-td0WEE-Df7KOScscV6h4uhWkBzCHGA0hOzHfWQ&oe=6A8C351C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq04TAfmM2EQ7kNvwFvgFrX&_nc_oc=AdrQGYXt5ueZVe2A6X5HRRIB9me18CqNoivpG9c4lQod6HGPx4w0LoZvupG1q8tlY5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp7ioGnXMXQTTCXjCIbg1LHxImAWI012lLNkEK95mbXQ&oe=6A8C1B9D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut8YNsHneNsQ7kNvwEiHf_Q&_nc_oc=AdqZ-MIn_3KBw5LACNQii7tV00Ai957lelnwPEemkGG0oF14uVDTcf8L9tP_jc1W1ZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1PmNH_o0k75Pd_bYqZCOAkLnEzBc9O7D8uX8LepX-sg&oe=6A8C1372"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zk7UePDKm0Q7kNvwFllXtM&_nc_oc=Adr9wk6tXK-PV5inrvyr9Fn1rGXRDmP3n4w2JEoKHNzWSBkPg8XXqq4osATxEC_IV28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqdSmJWR5j_yCz0N4-ZKIgdjVWxCFtJKJwvjKQW4pFPQ&oe=6A8C38D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RYK9YjWdNQQ7kNvwG1Z-fo&_nc_oc=AdoyCuCW6qBha7pYwvlMFxCrEhW-C2rXFrtcLn3qOAMhegKdfb2aGsTpLGOIqRAG_xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRMndhFwx4AAEtpove_wRVOBCkiGmiLn_vOowGW_drlQ&oe=6A8C3E15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pXaDVW0gAcQ7kNvwHZAVlJ&_nc_oc=Adqr50QydxMuV6F1
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uCnVwXhHocQ7kNvwHYXPmS&_nc_oc=AdrzdjCVt-GuACEbBbBEniViWLFnaVQmcDDAUk-Yd1QgXySw0CF3QKpNrjN0LTYVENs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx9y9B3npuzNjpaGXlfq7LQPj5sOhnONo4uXkobw42Vg&oe=6ACA63DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3mUNMd9RKsQ7kNvwGCHSPP&_nc_oc=AdpIV0mw1ABCdZDOBxB3ZxTBgm1NHCWML30ZDzyp5iULueu2dP_FNOnSMNVhvumYvCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN77Wg0167wCFwfcaBQP13h8k85BgDauxd6vvAug69AkA&oe=6ACA4A5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehFu0rUXzwYQ7kNvwGVbI1C&_nc_oc=Adp7V1mIVcICjH0FCBg6s1jyh8reEYTydLCek5U_PLWmzQuIpNum2syz-dI3N7t6P-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfs-2Khe1qaEbuC9gYA5FpI5j7hH8vxnZBqk_5spvwMQ&oe=6ACA4232"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXD8lTOsUjYQ7kNvwExk2pe&_nc_oc=AdoDr4bEg1i5tFkdmGD4yuEcmJEkPaX7wdRgaWA6YdEEQkEbvJ3WVpHvpa3m_jXIzlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx3LEu-Y-QkAzKsDPb9-RsOvAOvvP1RR3dqsUbzsWl3w&oe=6ACA6797"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUd8ifLt_DwQ7kNvwH2VBHn&_nc_oc=Adrwum8e89ha9RgI35h-tnDJYdm18NNxR2Tb2PXq7k3gPgnZgjXDuEyL-YriXPCGPpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUJCkA5y8ZYB8nOK4HBeLOKg8AeXNI7VaKxJ8RlYOfDw&oe=6ACA6CD5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfG2AJ1RMXQQ7kNvwHiUMxc&_nc_oc=AdpqKXbvGtVR7Cw7
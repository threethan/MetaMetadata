ZEUgIFB4qxishC0LXOKdEAubexutXc3gpyNHV2J8LwKnSjUldIb_CtluxE1Umw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN6XcOa4iNIbGI3rahUEVtB0M3R1UZaAIhYcU0W-tfNw&oe=6A7DCB32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88fa7cxTkBcQ7kNvwFtWFEY&_nc_oc=AdrlaFYr4nVDGqlkgoWijjwEpVZvYm2OzaNah_BSTPa-jYAE2YSk9fkyu23lNgkf-F0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpLs1YBV2ccO4ml7IkJ1ekLQU-kK96ChX-zDeBxdddJg&oe=6A7DB857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPV7vDH01sIQ7kNvwEjxKhM&_nc_oc=AdqiI45s60ZFrKVzH8Ydh7NnXatUqYyNfUMYD1C4gEbtmdiNtEFgkCJVoZdI_YU6zt8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaeRdx0p0iVE97oEuNjJqAUZpD5ehPTlS_RafgaPkKqA&oe=6A7DBD95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKCI9oQPIuYQ7kNvwGwS2BJ&_nc_oc=Adqtkf0Mxt6HrVUPUsQYsBfJTKLg0s-vUdXnk0dG4L-ixKLjnUpUsPhAoYKPN8GEMJk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPRJFSFX_jKuADiLmKo1y4U0Awph83DFZqfvRh7eK2XA&oe=6A7D9902"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76HOX1kQ5kMQ7kNvwER2J5X&_nc_oc=AdqAKhWPuJ1rMcYB9g6vWLdl6zyDgZPwQwOe7Zp0mRQS3dMQcm7vjIS7QCPMR-Z_1fk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoW26bLu-XDFMZyhVwa_97T9UYOfqDQfRbdALSXo5ufQ&oe=6A7DB7C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxBzUlCY9oUQ7kNvwFO8WK2&_nc_oc=AdqR-0JOJm3ECKkms9Y5Dp5ToBLcH
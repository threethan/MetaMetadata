2wqJQ8iDcOZo3D0J4yw9VEz0hwxQ50ZUdD1GxsSGdClc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvtXgrWsXNswhdCIdeuqQedRczYSNNnB2QUdhHvlKGkUA&oe=69A18A1C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGTOP0m7Tm8Q7kNvwECreWH&_nc_oc=AdkvoqUck1FltduLnAXJCd5htbPuT_Kl3ztOdzlv5SQveLWiTe-lkhQLuzrMMs-8ZrI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afsvkfr62vE028k1Tzf8SjJH7mXNcgPAU22ef-bN_snCsg&oe=69A1A8DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYZMcCUKrOQQ7kNvwFUesi0&_nc_oc=Adl0vMm1IcmQHfSi-C2haZVFo4Bn8KAnaIUPEm9c1MYjSB7gLD-oULUzMMzMgGwvSfQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfseGJlm-5XzQAsqnHDmSU2fUWmJ9NhtlSqgDTxGed8cCA&oe=69A1A0B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urd7NPudP8cQ7kNvwFCbgqu&_nc_oc=AdkrQD1VFbnd3c1m38MVS0iqmXSMN8qDuveWVxMyBFN2bMT00kMQwvTi8BGqcdv5F2E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsHxFZCd8p9_30OWUYeK0VZP8F7c1kst2CUehhSC9eVkw&oe=69A18DD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QINuDMGHMdwQ7kNvwEUoywu&_nc_oc=AdmG3X4G54rm3vI-C73iHAIVl-fBbpBKi1XllLOywdC6Wpi1O6_IBK9pDHfdd5739C8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftUFXeN7BnnbDJoENrEs4r4J1MMnAbHiR0_Q3ohKnueng&oe=69A19315"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ovl9tiEaZAQ7kNvwGhnj-s&_nc_oc=AdlDxihUTNEgnri5i1twBbC9qVXruNqAmS-dUSuUiIXXO6EST9c7OvEsV-WFEOG6k2k&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvFNO4uig_grwoup2RvPpivbeDW-m-gC8xy5I270YRlnA&oe=69A1A6C2"}, {"f
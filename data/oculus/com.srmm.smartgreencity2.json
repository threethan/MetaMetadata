Oe7-51sYWrnwgrT-oiEubG1dMbE4S_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsGHXgVZg5d2cTZ-E47ZMo7X78oLS2-oqrxzBf-5o9vQ&oe=6AABEFB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IIKJmONy8YQ7kNvwHaUm_n&_nc_oc=AdojLO9h3AZ1h3WvK3ysNq0Y67fXDoY8et6qvsO7FMjq17ogeXwmpNJ6J2ft38wO-iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC7GxOmprRaS6MuYG5DKrB9QibtkdzOL3dvmuJnVjSWg&oe=6AABDCD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSp9OAaptw4Q7kNvwHKiimK&_nc_oc=AdrurvKLz_LHl-JNe1PlvHsGwHcNPQGsaXT2s9MFC2-s8klZEj6UWI1Ci79k6jL3_3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJggYLO15hIn_oJcHKXkSv_ffP9Ljqg48GLZzdfUIWNHg&oe=6AABE215"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LSbdW76SFIQ7kNvwFgnKol&_nc_oc=Adoz7YS_73u-LFLZOBrn7LLzQ2LDa5BjgpcOE0FGaFCZE1jL_jP6EAk6pltZjFKld3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQtwH4VYuTnJNXPmHpZoYW7-Wzw7dsFR6nYhsssbmxAw&oe=6AABF5C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3zT2EwK0bYQ7kNvwFRoBq9&_nc_oc=AdpDMCe9TojL0q7vv2FDgjrdvm4pUYu1FW4SoEKjEqQzW1Rl9NXm8InpLN1DtgtMhgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICuj-TwgPMFzfySedf8B1e15qfuzGUtXp9oSYahSx7mg&oe=6AABDC44"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5ZMj_td0oMQ7kNvwEQB1cS&_nc_oc=AdqWtkJcxCcuusx4oEMjhjNb2nVjc0Q0PeW4xV-phZtU4K8CuP7Vpe8YIrRonI9
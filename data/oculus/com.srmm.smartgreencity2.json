_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sG-M_oaHmcQ7kNvwFp6Lb4&_nc_oc=AdpgPioBVqi7N5QkOCceiYr8OMAzzESAMwnRvFqugQkpHh4AkySkMw7LGp6edKdaXvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU_QBorxq9ivctnBf4UO6_tNv9d2pDWL3yrORfn7L31Q&oe=6A4CED1C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPLHfiO5_2gQ7kNvwHShYWn&_nc_oc=Ado7rZLcJurzz4GRZJCImnJZ9e9LkQpkov9KEgS2kp2t17O-Tzb4-lZ9Mj1DeF9sIEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdGfv1ECy4onsXiXiWKbcXmm5rLxpkMGJhmSI1IOkvZA&oe=6A4D0BDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_va26lP4BNYQ7kNvwH9uo8A&_nc_oc=AdpH-ZwxUe43kRSpv3FxHydvdOlC6_CwMGh_-sWXKzSm7lP9XnqSENBJvnsjIVbC8JU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj_doqvXQkSVOCoTXSJeBrcSc7h6tNyVqi7t6q0PavNg&oe=6A4D03B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4KPbW9gFsAQ7kNvwEQBji1&_nc_oc=AdpHsOib-XpD_YFYQLEzwhPTNg-naJZobxAFLrvwGv_3YviRe5xSg1sC1_AQ3ZPwfoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbA0DvrtQf9oAt9B2ImKCSeIXJYgRyZXIefz4sZIQR1w&oe=6A4CF0D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYAE8SqyApAQ7kNvwEwXEf2&_nc_oc=AdpJcGW-GQtDG3eOse0K5B-N7KccATT8SbZCNZxIQue6uM5HXs9wS2odkHL62rW36P8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANnC1ds_DYyf0766Le6nbA76LWwGya1FEJi31506DFMg&oe=6A4CF615"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3U2YtxCh3oQ7kNvwGdYLb_&_nc_oc=Ado3rM-Ob8Ev77nL
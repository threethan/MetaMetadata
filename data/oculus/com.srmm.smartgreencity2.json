_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiuHZRy_Eh8Q7kNvwFYeUsw&_nc_oc=AdqEvbSTo-hztCe6GYKy0tT0ZsQv2jr8FAeaNEqTWtPcDjoST4J8z8DMURVhmvv3YHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtnabIDl0OUla1_mVGrnIYDJsFaRQizhUsORCSyQrJ4w&oe=6A7F061C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spemKem5GrsQ7kNvwGFZZsB&_nc_oc=Adoz-DYpFrgIzhI_ka-Tgtm4HRVMxNk4gmRfwqQgOfYVNyHuyTBsm3Z1e1AX0mqwKqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdlDE9CgTvZ0XvHEMF2-NlMZQcJ8eHghODWd0oD3Iw8w&oe=6A7EEC9D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pb3GrG6OKb4Q7kNvwEyJ-tD&_nc_oc=Adqkxn83IXbONCHwN7AS2OpMAexJtnvV7sm_wIokcBm6IJYKvaMtNW1Cy4ahliIAV_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC74r6a0Vxqn8r9p1yaF284S00b82k733uANLSMeNQEw&oe=6A7F1CB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88fa7cxTkBcQ7kNvwEpOSb7&_nc_oc=AdqiCEChKVULLRIDYpu34dPNefArKhvU_71c0C71odg37aq1aDxLBDa7upuEkMTm200&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTeRqypb5fiNuSo_KhsRdlKyxDNJuD0zx8Lg2ZR1yAcQ&oe=6A7F09D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPV7vDH01sIQ7kNvwFp02TF&_nc_oc=AdopIJn7Rds6T1IUGHUFanzGc6DdOLg7jGQ9ruvHbskfAmSJiqsAo2QyBg2lfCWBUJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoBl9sHZDVVpaA2x4a8n8fHYv1MTvDm20QhjM0S0DMjw&oe=6A7F0F15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf7kC19PlP0Q7kNvwEOMlKo&_nc_oc=AdqYknK-CDfxZUMj
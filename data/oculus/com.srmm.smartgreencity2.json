-wU3dh9N9mypA9R0Dfkjx4pcxzFJjqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N0xHbxE-a1WfZ27_5dw__TSfUkveDjiT2LLSsPHJwCA&oe=6A3E8332"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndNrA1xG334Q7kNvwELY_B0&_nc_oc=AdrHk9DZAt---cqDgcmxniKffnfCfwCPpr7HBRHAd8USYW_s9zaQESVIDTgg_KgEnC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97QaTvkqT91qKhxU8k68Iis8aWchmRgvIRAAScHkirZw&oe=6A3EA897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDGNo_34JFwQ7kNvwFzqbt6&_nc_oc=Ado937-JXpA8m0_lA8Mmv3u2PckBrugnz392nhiD_Qr98zpgxSlsfoOpoEz3XEA-XhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yxtYdumYEsUca1dNKHgzqogXo9tU2qPzDlMdbAuj-vw&oe=6A3EADD5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD2nH1HA9jgQ7kNvwGSC4cA&_nc_oc=AdoXkiH1_IojWSlD6mFTTW3l7sc7z1eUMlctBG30VIRZxc8nB2RsHzVVnMZE3gZLWX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F6gT6_ldjqR7Bb7MOvF77SrDadE4xPE6wdwe2a20ltA&oe=6A3E8942"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQQzKgP-j3oQ7kNvwF5E-_W&_nc_oc=Adpv9v8o54mYC8Y8TU2Y7lZLGJyTmM2SJfkloPk6w4Q97bb_ArpYzwd1F2puCQM_7FY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wca5ta6QMC0yUep4qpUG1L_plsk-c0ApPuKGoyZ3bNw&oe=6A3EA804"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnmkYZ1cR-UQ7kNvwFJI-mE&_nc_oc=AdpVy5FJ9eJRlDew0VHvMBBLaAflZfYTpV_ToSof_IBbG-IPKtJmw7x2_H39YzP
N2W7IqXw5hsD9ssSI01BMP_uX3XKBHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p9mz-3t9BXYZ4Pj0Pjxv6VJ_S2rCefZtkDkVpb0RXYA&oe=69E38BB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2_venUNwhAQ7kNvwEsjO0F&_nc_oc=AdoqkMrIprIykUpYYpY808NmXWNvgZzFx4fLVeC8QPP2GsVBsxmM4-2yqpHZmFXvIAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ATsmQUUeSZtPf4Lsy1pMM1N8dqtUar5v4TN6UkEsOag&oe=69E378D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guh1yJVp1g0Q7kNvwFsO6om&_nc_oc=AdrMG3tz8H3RUETQp8JbQzSZqfT9m03UYU6gqKRc48FklBhOaQnKiEu8BhjJpVAyRuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rDErQKK6WDdjBarkZPM-SY4upECdserG1Sq6oMKaH5A&oe=69E37E15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7AvfMojMUgQ7kNvwEvAQ8x&_nc_oc=AdpYVaZ53qTewP33v4JQXl6tgJw-OgXUZWImrl2Xm9U5FAPkds9uwPYD7wGITJyEm4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05h2EMt2qy9TKbugQaXgf8QSbFhFgeilLjvvcRosN6IA&oe=69E391C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWWtJCTbaZEQ7kNvwEG_iIN&_nc_oc=Ado5Yg24yFO5yq6lfNdK8a8qUdSJ2lpUUkC9bh4EVGRs5deuWjL_qkvHSkPOylbvN5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sNQ25-yBtX2Ht1Ufwzwb7FOoFYpO6EtwzkZnVSD4ygA&oe=69E37844"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlYYUCWdY_gQ7kNvwGRgUos&_nc_oc=AdrKzKM2JFWMFiw-zjvCA_kD6gxrPdQ6e1NJ15e-GM3C-QOkdZ_Y6CFobITgbJd
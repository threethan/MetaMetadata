_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KntJmEY2oQQ7kNvwFMfi3s&_nc_oc=AdqRJa4GYPCq_E7_a8l-4TXmoyG7cpDiN0DkAYDhtwp42eeLDNLPLQaHz_OqSvxX8uY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IAuTdFeyO7TQNs-gloe0JG1rgDqJViNfpbB0kNAeepA&oe=6A3EA4DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeejMS7dHxgQ7kNvwGBH2L2&_nc_oc=AdprBHY_nJqvs558ydJmEampozt8EC5ypS_LLvIAgveU-oDtTvmZz2vXUx5xc-7O7SA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uRGXnG1BGzMiAhSdslfsQPpXpqpcAdoEIlc7ECN4tFQ&oe=6A3E8B5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv3BNn094v8Q7kNvwFzsutF&_nc_oc=AdpkB_fV8-A7YJAYoZHopxz61JHdPWi-7irV-wU3dh9N9mypA9R0Dfkjx4pcxzFJjqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N0xHbxE-a1WfZ27_5dw__TSfUkveDjiT2LLSsPHJwCA&oe=6A3E8332"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndNrA1xG334Q7kNvwELY_B0&_nc_oc=AdrHk9DZAt---cqDgcmxniKffnfCfwCPpr7HBRHAd8USYW_s9zaQESVIDTgg_KgEnC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97QaTvkqT91qKhxU8k68Iis8aWchmRgvIRAAScHkirZw&oe=6A3EA897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDGNo_34JFwQ7kNvwFzqbt6&_nc_oc=Ado937-JXpA8m0_lA8Mmv3u2PckBrugnz392nhiD_Qr98zpgxSlsfoOpoEz3XEA-XhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yxtYdumYEsUca1dNKHgzqogXo9tU2qPzDlMdbAuj-vw&oe=6A3EADD5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD2nH1HA9jgQ7kNvwGSC4cA&_nc_oc=AdoXkiH1_IojWSlD
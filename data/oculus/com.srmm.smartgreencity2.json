_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9HWdw9q2qoQ7kNvwEudILj&_nc_oc=Adooriwea1j7IXdbJN0crr2MpooqFmfUI__pzpO_pvC0JzHw1OQZk8Os_7URWpnv8gs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t5EyApc836ql9WlOWqOXvu0LXmSam4v7o5j3G6GKTOw&oe=69FC819C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXJtXnCjUXgQ7kNvwH1csDD&_nc_oc=AdqnpEGPX5mU1fwA2SdNGSC0lhGAxFlb2uNxKqGXK3SahrKwSLtFf93t8F_G8t7AwHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zR06IVSm_lJr9EjRj2o0qw8C7_AQ_vC3fNePc8_6dMw&oe=69FCA05D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPqm6m2GkqAQ7kNvwG9TnEx&_nc_oc=AdqWmfohunmryYMSz6fCJgBGXgvas8zuozxOOKBeSXiv1Y3AsMwpmRlMD5iW0sbcO3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TSf_llGAOiVG2m19X0g-v-XRXS4BOhuUuSGzsTwDWhw&oe=69FC9832"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvtVJ4yTKe4Q7kNvwFjXwB2&_nc_oc=AdrVGrYgrSqZ1fpxpA3u7YK0kmfbJZ8o0aqtFisSglsTJaONQR11lCEC7tinbROtbCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6veqzpRp6GHfh6DRXwLBhdS7NtpHdNzMp9ZraGA0M2cw&oe=69FC8557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y5QgNAXt_4Q7kNvwE-C4M_&_nc_oc=AdpG4f7rDZsnDsz3z2LV2aenld0kOn_t1X-xcb1Ppz8SecaUNLRglz6tObFOZMjB2mE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AegxlhriDH8jmoMsin9hSkUC8VMPgA4z3uzoHd4iOiw&oe=69FC8A95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N1UjKTl7N4Q7kNvwEUHci1&_nc_oc=AdqdJiXWwJq84DtL
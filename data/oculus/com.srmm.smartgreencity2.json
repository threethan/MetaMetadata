g8Qf3k-V08dShlxCHAn2qo6RjMSxJKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARKdu2SM5e9VdkUPjfmnyghR2uZzUMW71IjQrQR6dwGw&oe=6A5E2732"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ki30UqsfMQ7kNvwHvA7gR&_nc_oc=AdoA5yuP6lLUjXdwBXEpW24i0dT6C_ju3QSg48q-Mv7eBWLEX5r0PMqb0DYcWLoyOTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtETHZHagngXwVUWEFVGtKeQVNhN7jGiqu8s5xxXegPg&oe=6A5E1457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8CgwmFyyQIQ7kNvwFy2uDj&_nc_oc=AdrSKAro05FopEdDPHdap0BCW7TXO6aVMnW9bTmbej3uL844K6V2MmM9h6qXnjHZJ9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADpTTJABzljXh96u6Ql7wvhkU7c-SEg0Ooe9BieauF0g&oe=6A5E1995"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tATVQAfteE4Q7kNvwEqACj-&_nc_oc=AdokvC_BkvqjlxtbTTFwavvrt2Bs23zuQuRp45zQ-9pRsJbzj3UuQmij7KS9Jj3Ml4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiuW7XjFvyUGoO48Er3i-BQhNTpiyu-DvVlFmrKLFqWw&oe=6A5E2D42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJMKOZPHLRsQ7kNvwHmNOJP&_nc_oc=AdqQNsZDGvBKorVN8_NObaPYLx8WrMooUs2wtx4obFlznmyJmsxRZ-Ivnt6JQtyjy_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjkZzCvYFTPLinrR-4BQStZtTnXR2B7GWP_n6nl6E8Sg&oe=6A5E13C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiIcAdtCYnEQ7kNvwE90XQa&_nc_oc=AdoTrCem3cTI-nEDgenB6VALvdPGR2h00dS6dUOY9a16I72NVKT-tGnhIWLDGzZ
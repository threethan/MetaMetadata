GBRaI5GsLBkrmh0kCPXMgKTU0cD_k9c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMItq7bfvrSEHJ6M7uFTW7Jnf9gxREQcof439fVSeuWhQ&oe=6ADCB732"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgH6iG2_UiIQ7kNvwGAhjA6&_nc_oc=Ado6rhNYtzMTVlOtu959t6zXwdldY04kpPhor_3ReY3IJWMRuHNNpR9Oo_PO-8BhXMM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNszukGzCkPxnXUPF0UMk8aaf1CrpHk0Tlj9ArqGV5yYQ&oe=6ADCA457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLBvIdIjofYQ7kNvwFwdEU6&_nc_oc=AdrrmXbCW9dR6V7Mob6hpj_G2knaKWcId6apWaGt2bgSJiGg4-OlMwQE-PCAK_8IHSs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPytnks_koIidiAYJHzSMK9zuB4NQD5BV4CeNiiELdQiQ&oe=6ADCA995"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03KtMvh_J8YQ7kNvwHGD0ZI&_nc_oc=AdqvbnjDBxrn3V6pxYQQMQQx9ijqfUHkUBDN_zTgWg5lFZeUi6jkubiMGvWaLtkZ8uw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_POLZQ8qXDnAmvvW5MykM3YAIa-Oy06Tw2B5hFozgwA&oe=6ADCBD42"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkEg4WAEuTYQ7kNvwG9Ba5q&_nc_oc=AdppujPntdYh9a7vFwCCouE8jkMVMgLYeT2UcC6tLlbjYdckcPUa6EHTxZezAM1fi10&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMij5q4IknCnUibYFOr8TNELuGcM9eDk5vUkJcxQqMgGQ&oe=6ADCDC04"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZlSpOTNXQYQ7kNvwEHM37e&_nc_oc=AdrQ7x_-Vs7_EjXXlwXm6JpN6P4k3PcjO80hJHER62NkberajGg6BaE-TkdGunk
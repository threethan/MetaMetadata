_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI63AM71iwoQ7kNvwFAGBcD&_nc_oc=Adql8nJVp6bzWG_oNwkIO87sCrz76Vwc3fyv_I2ttRHUXEZruAo-LspNeWs9insyaoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwtZlzSa5GbEVQqXWs-sB_ygFC6d1-PSSz8dwLxtWLNw&oe=6ABA599C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H09hpP420xAQ7kNvwHBnGk8&_nc_oc=AdpKQ6W6q60CTBX-nIYjaaU-xEOzucDk2JRF-CycjcVODVxjx7-ibRJqEnIyNGf_lxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS5CVTrmdBVPtML9T4dmTk8_yiTDzWh43Z2YalRdTIYw&oe=6ABA785D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWm-mKi5ZHwQ7kNvwEzS5oU&_nc_oc=AdqKWWnADEhVe7XNoIf_PhJoHc6Qi5vonQe1FRCzGHjbMvrJpQ2pD2QGi757lFtFPy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSaLQ2FjogT_xZIPrD-sQFv8kvCkEZQ8GnxhR-0nU14A&oe=6ABA7032"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QcJvR3wU7AQ7kNvwG1ZxZ9&_nc_oc=Adqiy6Pr4p_HFbWBlT4l1kEJzUqyO_k-p_NS44tmvOoTJ96BECYtmdvCSeF10nZYGP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvY0Zpq75rnVjsCtPtjaPBSTT06Y4u7GI32Oe3-fc3tQ&oe=6ABA5D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYX6YBhTwd8Q7kNvwFj1kJY&_nc_oc=AdraVR7EMLiuREkUa4S_UAyhTvoo4sCNRs-ZWGSxPIJ8q_pRbMEJIy3-3ca1t4nfc10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK6ZkkTkkJrvvTcgp43kFnIx2UIBy5SWx9pnBlaWmL3Q&oe=6ABA6295"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKO1D8bRu3EQ7kNvwFmka7h&_nc_oc=Ado5NTA79thaNkT1
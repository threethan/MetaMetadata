Ird_-_iK4z7Tr_lPO_wLWufcn86YpEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN76CqeDYlHrHJjParcYWUO5QhZG07TcfZFziKKkGLAw&oe=6AF5C3B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK9DtvymYzgQ7kNvwFqfJ7D&_nc_oc=Adojnh8rdPrLF0ffo6HjfaGZj3dDyLU2GXrMNt9oT4xeSyIMEybu20OCm46ORks4YYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD0hzeQB1CTmnS5o7pdmSwpThFKhvAwLizYhar5ZRiiQ&oe=6AF5E917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eowZmjLQStsQ7kNvwHcjO8c&_nc_oc=AdqzN_Mgbj-hnf0N6uFlcG2XLO1PmxT-ASLlZ_1iTJfKyysMT4Yks44J_UfoofP66RM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf84qAK7MZ-mhDhwTe8X95XeC1Gn0537IoHtTPkBMP5w&oe=6AF5EE55"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFrQNvdajbIQ7kNvwFrh-Z-&_nc_oc=AdrrYzuDR-m_jMuAUVySWNn955lt1muiwitlq8YAw98BZN9h8tMi669zR5YDFECWa7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPO1qo1rQshXs48o7UzMRUSnalLQP7BM412xvSBbjwjQ&oe=6AF5C9C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HePW_CNOk0Q7kNvwFp1FLp&_nc_oc=AdoLHJm4KdYhyuCMk48McIa6EZVtASsB_xNA6hnwQhenceQqCGAG3AzFvalGyT8Frp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxH0M1veurgEQdPwgO7bK73R_mEU7YcKgqkHDBH7DYfg&oe=6AF5E884"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWXImmq4SuUQ7kNvwH5J9y6&_nc_oc=Ado7xW-GF9QLKMZz_fz2nNK2HMu52hJD2za9mJ7zm07tS4MqAB6oM4n82aavtg8
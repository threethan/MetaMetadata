_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j3vVRyUGfYQ7kNvwEPJArN&_nc_oc=AdqpwglbIOJDX1sTAEUELpE3FiLn5xKbJirQT4xa8jkPsr6pKAnkqN6ljyKbTJsw8hI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEveN6P96LJm0w8meaaFO9nKI3RdlvYktcnLwsJCy8huw&oe=6A89921C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq04TAfmM2EQ7kNvwEM4yZK&_nc_oc=AdoLA2tiHKNgp8P2Ml85DXvbs3LK0-myPEGAYO1PH5tmipq3xJNqGljwBxW8BeZNCxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm__zNQMGuByT1qyWA7gemGvTF5aWesPQp81rYDjZK1Q&oe=6A89789D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sUUn_lKArkQ7kNvwHMssth&_nc_oc=AdqQ6r0mQqeT7sntF5lB_pIYtzIm8DsTR5QDHjAZ5gramYGKcEFStRJNLNyrxx1a3SM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEHtePes1OR8gOjuKWZ6_H9gcRFNiDKLlvhT08sxCAlA&oe=6A897072"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zk7UePDKm0Q7kNvwHXwv0q&_nc_oc=AdqXlHJOV4ADoWU9wNCLpuBgm-jhfc5GfY610Clm-G8m_ijsX5DzsiJlZbdl8krXgg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtV804dhVGGc6kVghj3R-cNomjPv_k6hhChHjpCJ0n5A&oe=6A8995D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qN5_SjCfXsQ7kNvwH3kvGq&_nc_oc=AdoUer1XpVa5a_ijqnSHwmwl8w0Rpa3sIFKsyjAe4qyxLkRV7rg4EXKr4m0m-zwjfe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBLy6oNTylwvb-Lx61g2btrO5zm_dmXMcY7W72vDRFXA&oe=6A899B15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCJpCQSs-LIQ7kNvwEMdM2O&_nc_oc=AdooWiU6ci47jl-H
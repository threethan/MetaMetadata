_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJerzDsXX8cQ7kNvwF3e9UB&_nc_oc=AdppFoYvGggRKwm-Ikz3EBJxrJahXeIXHBrfiRTHu2bkh1VU6EeWLIxC3vizOCsSO1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5JdYctGv7NChu0gewrNs016OAuc0oe67CNPuA9vTIIQ&oe=6AE6135C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq2xWEvYfEkQ7kNvwHFx7U7&_nc_oc=AdrZuHX1rUjwQfGOmeGhjrwbzGTVdnpb0tJWtGhUeUQjhGpyOkUcN4UZ1sMNFPNu1LA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsmhBxj9BDtvl4YSPiFyTnOtCML31KrYel2XdOdYhicQ&oe=6AE5F9DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cocVnWehL8Q7kNvwFMKy5j&_nc_oc=AdqBeFYSyKp4Z7r-Y6mu2tkFHXn6dtPUJ1zc_6DSwApkGa4w_mTg2hMI4qWbNMzEwr8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzcQ9O03H9aT9viXghxwdKgmgbv7Nh3P1GxShSlFZEhw&oe=6AE5F1B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHrglUFsMJQQ7kNvwGWQ0w4&_nc_oc=Adqn-DH2wnDccAGJB2a9vyetUfxViufF79Eqt4nAB1NPruVRaUh_mCKdeY8HnqE3Ceo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCSc8miMofr8ZK2qnJP9fywZqGkMYSh3OORx09N5grPA&oe=6AE61717"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37fa8VqcylYQ7kNvwFDi_SG&_nc_oc=AdrgVMXo969AWDPH7X_sP7XMgIFJciD9bO6exa-JuXjkLSZCVbv9jzb5AYvIB6rwo5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMas48ZX17xkLf6ttdB74IhYGsHQTG9Wk8RKfNNYG5pmg&oe=6AE5E415"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12egQ-3_wHkQ7kNvwG7MY_F&_nc_oc=AdpNYLGJVQs8Q8mf
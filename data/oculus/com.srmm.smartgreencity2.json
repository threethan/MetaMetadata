_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewFc4IZYQJkQ7kNvwHKxNEm&_nc_oc=AdpRDn9Wle6ERQPw-qzmlspain2gF3YOtpVTWo0GMu1OHcPCVU72IDkoglQeey6RnqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ4sc7MTlarKrJF4IFBGSHZ_sh48_Vwnjmx2ahbhWbHA&oe=6AEB595C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8EayaExIaYQ7kNvwGoKMnJ&_nc_oc=AdpLwQF1P29H2gzVTo3fQ96RzS5qGqj8B45m5kyClOC5zYH34p3pq8t9M3mCVaHZF08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNiHG0wvhBPqbaSmH5Z6bSKzE1x_QMi0sJsvfy8Wv7tQ&oe=6AEB3FDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v96tV7k0Cr8Q7kNvwEz1VJ9&_nc_oc=AdqVr3qDmdES68NlfYadhfkU43ODxcS_nFt_-so-erNetyqypAXdgGtcQEROYw3VTDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8JfBq8DZcehVOJ1N32ERdbHUwyV7gQV6v9jb7X-NOBQ&oe=6AEB37B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO_semKIHWAQ7kNvwGwkeiQ&_nc_oc=AdocYqo6c1HyyZpHkp46Nur6_Q8tfuM54VrsMQfWluKPZPnV1lAO2zkhlYclOGD2LH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFp1Xsjl8Cm1CQDm0cMpjdQpDZo5YgaqX9w_nIC6wqWg&oe=6AEB5D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI5qc8792B4Q7kNvwGNKGcZ&_nc_oc=AdoC7FbFgxPUgMSuTJjdDp6m3svtv88qMdB-9OOHqP_jt60fmYu_yFLR6MwD36T5HqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxNInECBv7rkMhbdhGAqHHJnQJSb1JGu8K3Ey3vTEtsQ&oe=6AEB6255"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pz0Zo2SfMQQ7kNvwFCUCCI&_nc_oc=AdpgsC9GNVSbmNve
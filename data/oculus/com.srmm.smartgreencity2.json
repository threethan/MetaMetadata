_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a51IXZkxtEQ7kNvwGWCZWs&_nc_oc=Adq5G8WUUi8LWAKRP5WeQdCKdjzeunOvMR723JFGPoI9nYYnlgNvhC_YEEvIcBuXgaA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dsE4yBV0RNwI8txR-sCLZBbielHmv30JThp7A5aLKiA&oe=69F4989C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfqZlMrnKOgQ7kNvwE7mGsh&_nc_oc=AdokNWvmjfpChA4r22i9kchffkpN9t24LaKeIBQKQzZ8PFoJb-jIWWxdQBONpS-sc9o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Pxm_cKxxyMGsYkSI4LeIc2i0SI_zyJgdBpACnjGDKBg&oe=69F4B75D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM97j4WcFJ8Q7kNvwE3mFj8&_nc_oc=Adrbh48ArhWbyfGfvFudPseHzz5CgQdEx-GXDl5A_p2tWhS-cMMD_Y30y3Bm2ngSlRM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ilYF_YdYBKFqbN6KzzSsw5vDeBXL9GQ613QN2NPezyg&oe=69F4AF32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK3RWtGWzQEQ7kNvwHgrtq8&_nc_oc=Adr0VwJ-jrckVULJeoJshibXSD27E7plIB6h1d9W_scG6kMZkVZLZ7QYIM5-E-5JZes&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2H3gYXJXF4B6O7CjTbQC_KYWpJNNX_-UnJbibaPoHJlQ&oe=69F49C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0ty7rKRLH4Q7kNvwH5Yjog&_nc_oc=AdrnZdqR3fTIG1CsduPIyA3LFKkLQmGUlHuF7chIWVi3ncZvZVC1DKCZobpiwHM87iM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af290jn0gsa_CdSjoUiSEzCAbyLakbVhx1bvgRdayd7VdA&oe=69F4A195"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdJFxYSV03QQ7kNvwF9wUaL&_nc_oc=Adqk8O55hjd29mIb
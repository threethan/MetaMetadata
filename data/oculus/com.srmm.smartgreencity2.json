_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ9DuqinVvAQ7kNvwFMZ56R&_nc_oc=AdqJWdjUEJUWuYmriohsDwnfoR4NmFvFgiWZlOvMaiuPd8Q5IGdXQIcKZUp8ho_6T4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtvD2RKJ7nakpWI7q3ZCQZacIdhFhM10HUyLE9q79tYQ&oe=6A57791C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf95GnWsv38Q7kNvwGF7hec&_nc_oc=AdrHB3UW3en43vP_8AsKcuK3iNHv7pZG6QA_LUIKnAzaRQJQH7g0qEBMgC6eK2J0B3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRd-xXIEL0zEldcdvVgWJx6COpmDvJBqzvH2odE8llCg&oe=6A5797DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYEuV7XEULAQ7kNvwGihYhb&_nc_oc=Adqx_0AQ2HMTtmYY7228wX0s6elzaBxnXfBb23Y2NY8dGUCquk45nMCXqhoO-te9gF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn4fvrsr8SmlpYIsDK_eDqQ2gVaCumvBtHDwYa3lmhWA&oe=6A578FB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_nXEvyYNwwQ7kNvwFeNIMF&_nc_oc=AdoaK_fRsbgZlqF5shRaxls0kRYy4Gi6iXo7BD6nw16AQqVaWS98qGnAWnky5ZNJOkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqHrSZCSSvvAHyLpTgYPzPAafiydpD69XgP39UJ36Yyg&oe=6A577CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc6TeH9MBmwQ7kNvwHsETdj&_nc_oc=AdrBhNcRSBhQKp-TNGPo7TB1yZ_8-o8auPP8SDz6IgI76s3qz5WGTDVpMx-5h4KZSz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6PmlUlTN3KK-4yuTdSsqAc-O5KUTaxEndepZHl2eaGw&oe=6A578215"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLauvhjk4ccQ7kNvwEC0Z0a&_nc_oc=AdoVo5mpeSiZHRqt
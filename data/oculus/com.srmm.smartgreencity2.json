ta2RNN30ZTeAJoKZv3cgvYiJXsmw1VQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3vTdv1RNqpN9J6JQ56zH3O5K5Kd1ONoK43IN8PKUxOA&oe=6AF89EF2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xe48iLtlRM8Q7kNvwGYx6mk&_nc_oc=Ado-Fqzt7rT0taU1wf06toyUspXSU6kZrAVqy-ET-Obv16kKBiXD86hVMujE_myXZ5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCq9wEzbT4yIKRTIXDjskTt-MfdkdFuzOb1ChXdfARBg&oe=6AF88C17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8KSdOJAi_8Q7kNvwHwGdkV&_nc_oc=AdrjPH9EI22LtS5TImkNM3cChL1dW-GtngaOzCzgs3NlON-CzY31MG9TZJNyET-y0Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKtWz8HTHko8UkSbomv525T5k8Dq0_ynS_Pv_jSbc0MQ&oe=6AF89155"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFrQNvdajbIQ7kNvwEMujJ5&_nc_oc=AdpjMOBNcJbrqrOppCcN7_C9JY4KmiUGvE3AOfUDrJ-FVYqrPZhv10_D1Vj2t8xW1r4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsXOiiYed2GBpBax-RXIWwGNk1ONGcx8iH9HO0JptdmA&oe=6AF8A502"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HePW_CNOk0Q7kNvwGYIKnD&_nc_oc=AdqKyhkETznD8DMdlYsMlUNOEdw2hZn4KNKICfnoyiBJwJnWVrMd2NDbK8TISF-vvW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxqcWe-udG6gVcSUA_S2lNSQajKdaKdQGhuUPc1298yw&oe=6AF88B84"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJgX4-HNdaYQ7kNvwFY7sK_&_nc_oc=Adp0R2OnwnosP6Vww9OtQ195uvFzJA7VNLTiK_1u83MXcJLvnvygcsCVL7sRudT
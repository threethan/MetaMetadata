_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-By-Of7AHEQ7kNvwG7ZybH&_nc_oc=AdoWJgb7yFHrl_lWSLXqeqKhSLs3gFpit0e-hQCjecbb2v-OgFvEG3liwswWAtbQg1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9abVrrxaBbbmcKMKlkRT8TI5jaxrskS0VwLSy2bvM5g&oe=6A380D5C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT8Pc_FMqQUQ7kNvwFcQtM4&_nc_oc=AdqvAKJcYJJk7DQCe_rHdycK1aaJ8N6GTNiPr-G5attr9Adm9O3ko9NGsJvfpzhawkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5M51Krkcc6YJDnb8EEqq1HJiK-Yp6MiqInQtHBoutpw&oe=6A37F3DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIM3YjUrYOYQ7kNvwHahDd_&_nc_oc=AdrqoE3SeMiDPq4t4XCAJv6_xbJKo2Wgw71-GMz2QhZbBW5WBMXles2TpuHiT3Rs74E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ewoeSj_KYgMcOfCp6g-zrxjvPu8FLfz0s_snJvrKJCw&oe=6A37EBB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_cv5w0BuRQQ7kNvwE3qCm5&_nc_oc=AdpMgsAw_nSLZrDD3s1BA2Ri1SQlKBscr0wQYjrMZixNG9uBcb5n6LkwSL1Po8_PDo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IV_Y-39mUrs_zg7Dhor5RvqQ-KCSmAQhKCfSz5PnSgg&oe=6A381117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjLbDpo166QQ7kNvwEAMD5k&_nc_oc=AdqdXfNfR8jo8kqaMUbNUOh6D5_gSsozSUDZkFVSh9Hhs_Vy0Tl5ealc31F96WvYtAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ofrrS2HgaLfcgdHZ35G3P-IMAv4i37B_9Rg2wh17kGg&oe=6A381655"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBWgP1lJrwwQ7kNvwHSRwUB&_nc_oc=AdqBhmzLj54FubFn
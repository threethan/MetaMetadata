0U6E7RTQrNy2e1OUno-Hqcrw0y9VQ0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBffIm0W5MLKMK1RBXscOjsBpWcx9XNjBK1EDEdWUCCHA&oe=6A6CA7B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NartyBQyr8Q7kNvwFJcexr&_nc_oc=Ados_qJUy3BQSi0nqnppKepfJEp83Sgkokd2Ex_bEgx17T49MBs3cyeGxAwnZiEmxGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIdTk3IOYtUFrlJ4T7R0jG1-XTe8e-NwwW-pXYCaNGaw&oe=6A6C94D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UNdnoriJ9UQ7kNvwEyeWLc&_nc_oc=Adq9Pnfi9yK14_SWQ-UV10wcoI9m_PFZuqzjY0J6A4cZXiMfZxU6-apY60JBtwyX5Ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUh1Lz9cyFxaiBxnPGjVAZogUKL0it7XAV_uWojQ-TCg&oe=6A6C9A15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMRbGfCuILUQ7kNvwGgkM51&_nc_oc=Adpz041nzUo8GOF8CKDorS7DvPAcSAflws1l8W_NhCxxrkh9qyrjh5jQHGCdzveuIsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhtqdeSMl-Gtqe-Y2hkU8HFOxb3o1YDhZMlYRmz8h0Qg&oe=6A6CADC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_02uwmFCkMQ7kNvwE6kvOv&_nc_oc=AdpNNTZzWo9FuRCoXA8x8xCIUN3nstMPIcPtr7D99CQfJx8_YSBpRrW18Tl0RTJBGwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCve8M-UJnYRQhvUtijK2iL8x2QF10oesLsVA59SZRGEA&oe=6A6C9444"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_SD7u1pXgAQ7kNvwGZ0lbP&_nc_oc=AdoqFN6XjxsVTPdGh_kMrjRB3Pwj4iC5-Mzj6e5bglktXSa_hRqp08bUSs_EHpr
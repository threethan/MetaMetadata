RlnBEaHeRmRcLabembUjS8Tb2tARheD9yJ95VZVOHK3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzqNyelGuEvvIDBvX67n2_MDKLoBLl7CTlraoi0sG6AQ&oe=69A6D01C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAR0RF9SEcYQ7kNvwG6znke&_nc_oc=Adn4bw1FOIGeGid8Ithlv5HCySARAh4_Ju4pVEohqGiLdRhfgYrbdt8Y8zkIEJrQMuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEHyZM9RUejkFgcTzq5758Xoo8VXj5il8lSr6Gi7PpqQ&oe=69A6EEDD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaRl-pDfPEkQ7kNvwHlGs0K&_nc_oc=AdkWRtZIHIZvdopb1lcdy6no3OyB_NoNIMgHeuAs378lkGyCBqyX4i5QBUpa2cZMpJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgVTA_d5STvRiYdATKCcOGaR-31cAAWHK8HAh_F42i2A&oe=69A6E6B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN_796i_-WUQ7kNvwFK6uUE&_nc_oc=AdnvZOWABV9RF-l1f0iGgQzf9L1IjVWMHQSook2y90v6EBWZIHaOmfNi_cav7pz8qkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpKzYUwYOojgFwUvqJcR56O6t1btIZVZcc7mC7hy-NCA&oe=69A6D3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4yWBr3a3XgQ7kNvwFl5kTC&_nc_oc=Adngl7f02SzGIa0NS-NpF39Gg2RGYQw5IugWRrFGnQnx7C3kXDCRFuU0Af9s0z4FcBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvlWX-m5E7hJrcFZ-caMq0eAs07nW8wG6ELXb4Uqrw30g&oe=69A6D915"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iauqEUoZCS4Q7kNvwH_XguS&_nc_oc=Adn_mzbmPATWn7gu6aPadpIFuIJDDQI6OKSy8i4JoF9_i-mQVQy38oDm8RK3gt774IU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuZonfQ6BcygvIXyqvQZQW7TKzrEShH5exB6hHdexKDlA&oe=69A6ECC2"}, {"f
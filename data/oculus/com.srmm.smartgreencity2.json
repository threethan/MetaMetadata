s-iMraoWJZjd0r1kOUacIylxIP6fLYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL807m7EoZ3VA0wrB5fPbU-kq7hT1mEutVPSa5oHqHxYw&oe=6A986172"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_j8rK1wpDEQ7kNvwG-GJIv&_nc_oc=Adp1_-1mwjvwsir-n0Cin7vFFbhkZFGTpGfE3eZN6AjvHlbnejUAIG81sdpqjUuFxXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfrgFidr1LDhCM2CtSgAh3aLBVCyXrF18E1cg7GgkRdQ&oe=6A984E97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mRm1Vg1U_UQ7kNvwEsde22&_nc_oc=AdrBoJp5EZZChlJfmKRjm2WaEvHrUxhrxWjLrhOtKb6MfFVvkckKcxw9zn4U3QE5wUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_HThrMgGRnQYiVwvZ1FmGLpAQBxu-zJbI7Rr5UI2aWQ&oe=6A9853D5"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOpOrc9RidcQ7kNvwE9hHBR&_nc_oc=AdrXmoKoHUdALDrRMfniS__7wD5vlBscs40K6kV1XzOlAMF9r2q9kTalfR7YuwpSXrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOxg6aIS1OIuBGd4MG2RvBd17G6Yuu6jkN_RZ5KELzDw&oe=6A986782"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMygUwpA4AYQ7kNvwGCDP2k&_nc_oc=AdrLxqXpxW-hjApKkgbCVX_pJ8gVp9tacOJQEAw9boyjLFgoWJsoHULJpNWB9GRqryg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlSWZTPdNZzvPMXG252YCciw725MKoaPoeEV5pTRwrrQ&oe=6A984E04"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGaSifnGPoQQ7kNvwGHjYkv&_nc_oc=AdrxiMCh44dOmtM2BuwratpGl2zv7Ei9kOLzYddtc0HsN3qOyEB9pUxU5BxCDaW
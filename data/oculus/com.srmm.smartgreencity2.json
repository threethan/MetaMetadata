P8Pmf0Js4LYQ8zV2Mo_tG3YT966QjvY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-axLyEZIjO_E4ao-psDtRI4uhVFGL69sVF_4WiwjJWw&oe=6AE894B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO_semKIHWAQ7kNvwEdaCkS&_nc_oc=AdqwQZLaRONGCvTa0WMK3HM06CXL_RO6dBjJpWK2KTOo16e54C7FAFHpQhjgdzOTKAs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwMPLlRTOq7Enz4sg2qRiNIdXTVg7ea1cxnNtbMBPwxA&oe=6AE8BA17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNNISHBhvlsQ7kNvwFqQduq&_nc_oc=Adpf6INqVPFp4r-W7tttQZJLOkzb65coeQYGUlow2D8zqcOvwrsTmRewpP83a92EXeI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ95bUkf2tq34DwQi2ByHBBXsMFAt0lJZqDT9R5NdyGsA&oe=6AE8BF55"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12egQ-3_wHkQ7kNvwGOdFXB&_nc_oc=AdoMV6HyQ8HPEnFwBHbgi0jK3KIQRwaf6mebP20a7XSn1yCTKXOssUVs0KodYyP4s2Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrbO9MAGmqT8cLpqj7ygO_ImZqGApojk3HR2CyDT6gKg&oe=6AE89AC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7vzVjd6O8kQ7kNvwG2cmVe&_nc_oc=AdqcmRqGYIehubJ8sYUhBlNG3_CWz-G6fjwGnZW0eJ_kbsh5IXKql2g9MePvcUW5QrQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh2c2D4GfP1l9zpC-aFip6yagT7KGCLXRBanEDZ9aK9w&oe=6AE8B984"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_iJXnvyBF8Q7kNvwH5VeE5&_nc_oc=AdrUdVlI-dSiiHoUi9QqegGCtZeU2s58vurqTh3oQAmzpczezsIXFOiUPhRwAfl
tMYoyvSH9IluP0z4EBW7oUGREpWEaoE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXOMKz0tdKTffPsCANqi6nkIExKug10biTbYPrAscJhg&oe=6A92E332"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vE1LKfQR4QQ7kNvwFcpQwN&_nc_oc=Adqnq7Q38qzjo5G4RFekO0laICekN3Ctj18whNGI88ivpbdI4KYRy_fPQXc2CwDZcJ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESGf-h1TZKa864MreeMwtB8qXashfOR84nWKh6J1i2xg&oe=6A92D057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNkPyhlRWIQQ7kNvwHp9yHM&_nc_oc=AdoOpFaOm_TNiRpP3ysbsJj3ZJ-1WItw3fQxb9PoCqMhUGLpHo6RoJrrRyZlHP4QxqA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvn3GkcEw-wqNVU3M3pC1ir-Ehcy9JCtrg_0N08moVig&oe=6A92D595"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDBiI-JmNZsQ7kNvwFYLkDT&_nc_oc=AdrlYDfinv7oKqNeTNW0kgUq59wsA2kEstdVyaijSAutfMHf01meIa0kCDmEMVaf7tQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMWDcO3LiqLJE5ACHchElWYOHnTPqStEVCyD5S63FwAw&oe=6A92B102"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AExAuV6t5sQ7kNvwEhsqRp&_nc_oc=AdrEtLcrxGJ6TWYvUpnSCEx91TUujKdPYPKT23p29VLWQHvsumMAYDheqOtHOytpepw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeqzeMUMr-U44KyaHGMSuUrwIy35pUcjkPFyuvjLcGlw&oe=6A92CFC4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKvlKyoGy-AQ7kNvwGSsCNz&_nc_oc=AdrVD1KIzbYWdcTOqKu_RXtBKkU7g3hHzJXjvWqAU1ox7OnWZZXKhiyEFIOUvlq
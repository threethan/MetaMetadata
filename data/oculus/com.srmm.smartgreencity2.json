x9n2oVjGBAQC5JpA0Jj3SqJ4FMjQAlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k6sB1Hq2ypfnBsiXJaaqVKrMaIQZVQfAduhrVhA7yUA&oe=69E4DD32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2_venUNwhAQ7kNvwF9TQIk&_nc_oc=AdrkXJAegJqbZTtIhqxgcq7WF1-5HAYrz0NVjsGsqRyXMGIvkyiFOi5qFoY5dYdjOd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09_Pc1NE4uOM7XnLAsqyH8iXLubmJeKYpLXko4urB0RQ&oe=69E4CA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guh1yJVp1g0Q7kNvwEG8oVP&_nc_oc=AdpdG-rQM_wOyC7672d1PN5NuKj3D8ncACH5IwcSdUhVk4lLrrEPWvyRiWY8SDSVyDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Yb5TzRcmBWGtwWLKkga17HhQk7q9XDV_3012B9NF8ig&oe=69E4CF95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enQgh3Q995cQ7kNvwHA24yf&_nc_oc=Adq5d8yOPCJUliN32s6tLRwdgKwoP4spnOALRDnCx0pVhndrueWguv1jQ3-aAMP8ZjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36Qxs1H-18ANys9oZDYEstq8uAAtXx4akbaPH5ZT9nLg&oe=69E4E342"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vValFYjg58Q7kNvwGpKvc5&_nc_oc=AdqRE2RuNXyWcE-4QF8DcfeqxgxuAMYIWvPKzELjwZz-NEXl2eposq3CJhAsOSACdSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GQ_k52PhAe1lUwpnsFoEoxIOzWo4TeU-Dr-fE9UjdHg&oe=69E4C9C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlYYUCWdY_gQ7kNvwHVV-hk&_nc_oc=AdpmHYDcF30W-8330lAUe5HBLBckV4u9IGEW4irWxtPyiosvfgayQs3HvlW6-yg
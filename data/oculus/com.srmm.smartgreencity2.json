_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI4SCcxWXI4Q7kNvwH8iBic&_nc_oc=Adowc3IiE6IonPNCej6VVpapwiPUvI_XwgQAMNXD7uCkh6wGEaM3YWVEozcbmCcg4o4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD0l5jT-PKn8CLard2esGoHCc9rU50heokAnkcCqq-Xg&oe=6A81A91C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIN0Ra8opcsQ7kNvwFDknHW&_nc_oc=AdqFsiHUS6-bYgYn1I-TG53LYQ7MlhHdFAhgcXg7_Jo9nxjB3dQVkDp-bv2NrjfnIkM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ8Pxh-fS53XmQhWvsQtz4FSN8VilH-Gf3TqpjHIKIcA&oe=6A818F9D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgYiL3b0X7UQ7kNvwF3broz&_nc_oc=Ado5E2O1utpVyQj5Lbbe4b0rOhSPjDdvHjsAqYDZqjwMV3b9N-4X3ciXQI39iiTi1VA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErqqXVwqlw_c-HiKsIv13DCxX4hrohiy2tXtDrU3bK8g&oe=6A81BFB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywr3DWlFjlsQ7kNvwGtCHyT&_nc_oc=Ado4fa0nPiDjLnld9LhokK_B1LUSzhvEVuTEmpCGt6YhxqqaMSISvza2t-4V7tiGfuE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGql2_j9Bqn9UCwF_y8DmDyVcOGZxlYdgWoZhr7dIfxxw&oe=6A81ACD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nETyeUfUSt4Q7kNvwEvueJ0&_nc_oc=AdoZKxoiEad9xl6KnCRuShJyH764zmfPt9zaZQzPuxcXhZsIIP_CtHmI6kA9H1QsCd8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk8_xoY0qTrYiaBauVPlkfySvA8ps26nc7-dJXszaOVw&oe=6A81B215"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf7kC19PlP0Q7kNvwGZ9OHt&_nc_oc=AdogVdQVNzyl-vy2
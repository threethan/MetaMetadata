vFnilJrq4d8Ti2ToQxpQO6aoH8s1qPE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYYNEdtz6gQI9Wjnm0Fno466f8QzrwHqVSh4qRZ1wqbg&oe=69C68AB2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P5AhE9kgsYQ7kNvwHjUhWF&_nc_oc=AdpVdpZn8g9i7u1_WGFeAlupZV6Bi0PRnDLv6_pijMR-SgoTLBjrEenX9xyPwr_hkPo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfEcWoiezl3UNDBlVNhBNpwxbO-epiq9H2VIFiZEXVug&oe=69C677D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAc2sWxU6LEQ7kNvwGbx9fw&_nc_oc=AdoI9vayMgVJ8-9wSJ2L4MMBZJGKSEmDQLN7l3ryYlCWiwkbAExPVJzdYjwW5KZvmcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfY0Nv7VPUVHxg208vYWsCGCwpdNnxojJWHyx9enIGlA&oe=69C67D15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQebAyCZ3PcQ7kNvwGTudwt&_nc_oc=AdqMamAgC_cyeRGuNK-hNOHPO60rrJmhF_zWGrNMt9APwM4Xd1O3wIlMjygNVun6wgU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyP8UZzW7Ns0SlXBeo6IU6PgPcH_kTcWDQORtg-EuOCzQ&oe=69C690C2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc1U9wBHdqMQ7kNvwFLaq9X&_nc_oc=Adq92IKX8x0kGh7bYAIMU-wWPrmi8knGfjM1xe4bDdR-ELtYjKbHyIjdTUd_-4FcclY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZFiuRJr_e6x4R_WMW8LLVDqdMkBBLg66KqiiGB4Lqwg&oe=69C67744"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tFwd7EXmq8Q7kNvwGvaG_i&_nc_oc=Ado0G6i4X3vP9ZnenCj-OtsHBeEaGAtDH9JinWvy-0PSj7PiDuegr4wPA0tZc0H
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUdoOo2teG8Q7kNvwHu1RX4&_nc_oc=Adr32pDrC8FIsayj6c8ha07gwqYsZimzfLg9jd76MBlGjKWmE2tQE7j9dyUVocYnBjU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L4l21te3QxgPnYhKmpAkhaBge6mXOs-1m6e7iK843dA&oe=6A2446DC"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4IdYDHzP1gQ7kNvwEkorGR&_nc_oc=Ado-iufWm7OMiotRPw7dZOwhQWsdGiBbh6nWvaZ1j1I5ETQ1NJwZVGCaMVnZcD4f0xQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZRuzDorSLYHuWKeJxEbWEvxBxS9Pqn3FvbRWV46xzmg&oe=6A242D5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSDgfu90FVMQ7kNvwGISYy3&_nc_oc=AdrrIoszCP8F0nEaEs__Goy-btyFbPFdlrGrC-4MvAwFN0mpY-m2GNcHtworz0Uwiaw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VIwEvVHWWwccZzcrw9C4P3AXi4dIhO-a472jqASj9jg&oe=6A242532"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2U6gnfvDfQQ7kNvwHryq61&_nc_oc=Adrfpfu9eiZ1eUKlHw0bF1ryiSjUHbYnAX7uemenisBVj8mmJ0crp2MBxWFkszhFJDM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vr1iB04xftReADcJo2qydBozBaqU0wDApWgGbcMBqmw&oe=6A244A97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OZrfIg5RyAQ7kNvwFlTG-y&_nc_oc=Ado4n2rYOVUO5d6VZPu44Y4X6iBlcMZsWzOQbp7WKqym3WS1AHeYxAgJdkwG2XcNQcI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cvRAE8amyP87CAZ5jX6HbzAENbXu3yP_n94Gsunro6g&oe=6A241795"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcKQUP8gDkwQ7kNvwH_gy-N&_nc_oc=AdqSubMw8m_pI5VP
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lBqzsNR12gQ7kNvwEC51YS&_nc_oc=AdrmudekoRqYp0v2fgnY82CQLosBeKFUmptFl1smh2AXXAeEKz0BdAW4EPcHOOm5llA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nac3U-5tKJNT7OHxiK9wRs9ELHcSEuB6yRq9wmJfEQQ&oe=69EA0C9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-9Sf5hm95gQ7kNvwFwHMte&_nc_oc=Adr-plz4u9NrSR7DHW2FwGUe6nMIqb4O5RdVQQp-lKt1_J_2WaiJa_h5mHOtR-JPlBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wVCDBQA6aO98jT0TsBW_x1-0ouFB4RNHmiFHmHTLrqw&oe=69EA2B5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDm2jBDUfNUQ7kNvwF0xcaU&_nc_oc=AdrEVSaTiHfwxHpA9s4Yd9pn3Z1VxDAkexDaS5xLxLiqun36bQb0QS672_GsBzYF-Cg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dj4I7fqyR8xi8tkSq0Pn5TzBJSeU1g6ul9Oc8vuQTuA&oe=69EA2332"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVaxPuYYf3kQ7kNvwHFfJFO&_nc_oc=AdpKe-zVpe5KFmttGw051nUs1zshQrnjo2uPjANdgf-5y4QlVZvSSf3RNfoCAfbrxOU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1prU2t8mpVoC9f8egOXHOBeFtX8qqP1ONmbDLZ_u4CXA&oe=69EA1057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0jf7daTMrEQ7kNvwFeME7q&_nc_oc=Adq2EwuXU96LsRls4tDWcmVCN3Ua23KAQFuFGLTY7shuYOGkZmCYjakVZin_rpaaazw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iQTAeyMWizrRc5gbYhygoqCX9p8HViZGLoUoc7vIBQA&oe=69EA1595"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqroLgsqqf8Q7kNvwGxumjv&_nc_oc=Adr4iE79jylKCYuu
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qIr_F0d4N4Q7kNvwFJm8Y6&_nc_oc=AdqMs32zkpxBBMWvkJN8TGUianWyFgLw6zmQkYSKCmd-HNEyJY6qLy2tqgKnV6jktMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJjVrIEaDCSvHTWEDcauN2MdCIT4xbyD8mm41opwljww&oe=6A689C9C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUta7-brfRoQ7kNvwGkT-WC&_nc_oc=Adr5krlD72553fzm7t1iHIEdYlVxBuwkkgEPwgJUhamscV8Eijwju4nVij_Ph3TXUGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnZtdT9iPIhvdrcShBbXrnAhPu132U9Cy5YHQpkwOoYQ&oe=6A68BB5D"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sF94RqD3iUQ7kNvwG8ehuS&_nc_oc=AdqNSjfEAJiL7-K2t5a_U_B52-Iel1_Mm_0gNlw_XJv1FO1vfhFjqiXCWpnUY1OdyaI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJYqod9fY6oKu0-DROuP_V_7mYVo-N9aeu0xSIOm7QJQ&oe=6A68B332"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zU31AKZMZcQ7kNvwHz1WHd&_nc_oc=Adpjb9zTO0YMZHuQNAs35Z7YEEK4ZezoIgANO5Vmeh9d2OmJZKig7Yv_6NV5Z7uf-kc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdlsduvh6Du_n1O_JaPNB0DzrE5cEkXD36Oz2G_GD4fg&oe=6A68A057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nBNmHvsuwAQ7kNvwGm8Cio&_nc_oc=AdrIYfOXGR8Uz-QyihqvhpRzTVP-zFjAv27LgNUPxvYRwlY0YqvcSJ_yYn6VPdWPm8Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBYKqu_U21GBt2WjejrvmaNV-6Giv26fae2mz73n35zg&oe=6A68A595"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8au_hldh0wQ7kNvwGjAJ7l&_nc_oc=Adr93mgi1owP63zm
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exHwGmApA20Q7kNvwFr-7pk&_nc_oc=AdqyCqPyOyKDV7CzRvg37oyLWrYjk9kl01FQFLIL6NPUIc1mu41oYOF-R_EYNJp2d2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VTxuMZyNNeYnbZ6rU-oYuzF0293F1XGP0EqK3X_L2DA&oe=6A283B5C"}, {"file_name": "Screenshot(5)_2560_1440.png", "id": "1543167612893241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031355_1543167616226574_5478733150451952791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3jhMjhVV4AQ7kNvwFOj8Ci&_nc_oc=Adp-uGN92vd6cG08GFk7fLEQ_JWH25SqH2tgALwhqQXXFccTOm0AxoAQjjkkeopXlC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9QW1CpQQru_E7pk-gjt1yc-hOzfBgba5drEEMGUx_Jw&oe=6A2821DD"}, {"file_name": "Screenshot(2)_2560_1440.png", "id": "1154233268797591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982571_1154233272130924_4529887224270705141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kbiJ59hSK0Q7kNvwEXqH0L&_nc_oc=Adp28z6JTa1jRnfz7MZJKkBccx9NGoFUJooNdZzcTnr_LvjCn_dA2mPO8g_qgCP-GOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BiTNTkX45hvz10khs1POkcde1aNDQZAMCk3kYpDQmdw&oe=6A2819B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZqkFz97Nk8Q7kNvwEfp1uD&_nc_oc=AdrkgMsHTr0nRmTmFGLe4gMTncsa0K3oIQbwvvT4h2Bz4xigtExdNaxSVdbiXF8z0Eg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lpLLaUosgykWPUCoTl5XleVYXiYZt1FGWLhqkT-SPzQ&oe=6A2806D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bw9OodamwJAQ7kNvwEkz7hd&_nc_oc=Adpbipg9URDhxM51dAbWAaS4jzCKplwkPjWPBVTqtNDLpZrYPfXZETABQlfCeHEq-Z8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WpMV6XdTvHLHDi2-z4owXG8MNRiT_Qu8nccyN60YPaw&oe=6A280C15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzHcIgdVrkwQ7kNvwFgummy&_nc_oc=Adrpdek8EAnJc2Fx
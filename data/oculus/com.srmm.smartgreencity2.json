veSM0YwTTXqu1Pkcf5SSqgb46ViOHik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAz-kFk_sd5MGC6kcd-snyzm3lTkIure7qxkmlBAx_Lw&oe=6AA6A9B2"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZCdvcRez8wQ7kNvwGn7-hE&_nc_oc=Ado7K0gEvFAiiFDn2CPjO8QDQUNK4HXpRAEnL8rwD6D5aFAbuuv6JNAsQVTFcQecHWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB1KvD3jVr_AydhrdCdMv-xWJmiCxYvq1h3ZRS9pQ9ig&oe=6AA696D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13c49JOoBScQ7kNvwE0kOWF&_nc_oc=Adra5CydO2eTDPP1x4sEn-RSlqF7SDaviD4XqKMs0XgR4wVw3CmgkBk4hjifPc18v-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJuaQmRgxR8wz0PsPUWCk3xYZ-jPYNX-wiGw2cwXayhQ&oe=6AA69C15"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Fj9_qpyitoQ7kNvwG3x446&_nc_oc=AdpaPv7kC09iR43BmIuuLbK7a5IrddnIMsKmV2oh8vkDLeehWKUsBuZyfc2snLCyEmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1iWAl13l5CuRpAibJgAcAPla8Tf6NstlEWIn7dQNciQ&oe=6AA6AFC2"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St8SZqe-MZQQ7kNvwH47xcG&_nc_oc=AdpSRgmw6y6YjiRzOKvVTOQVoZRUwWVpTq9NL5dIA-Ah65tcV7WBfH4AzCn7eX4dmGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy8tn-xGYPpjr_XXGwFXDhNxTzxZu6vPvaBeTd3DTMQg&oe=6AA69644"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sQzFMGwL_4Q7kNvwHxD73x&_nc_oc=Adrknd7Kj9xHVhBDQfjgeTeT7xd2ncpDQaeXqcBk24uPeRV7SaAeO8LHCNWIDYe
6tPEUu_yYQqsYNRE__yKwv5-Po0cSIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFHPAOWa0zSythtb_E4EF74dZ3NYVDdCBYleUblipjnw&oe=6ADF5A32"}, {"file_name": "Screenshot(1)_2560_1440.png", "id": "2100665936973153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982680_2100665940306486_5664456920141678252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgH6iG2_UiIQ7kNvwFGnukZ&_nc_oc=AdoFIyIlDnNZTmCMoc2njnhel3PvRYioP8nzW0ps_mlRhS8V-5I-M4Lc4Jlc4WBbwRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML5vsKgNcaJkZP1MuXhsYANBv3TPvwP1bUbz4xiMO5Fw&oe=6ADF4757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "368600119311127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_368600122644460_5598028405797075028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8pheZ9v6-wQ7kNvwHuRy_N&_nc_oc=AdrElffYbbtRcQcO5eJtc30zQW67_BR5niI1Aq5-Zyj8j_tfhSDz9uvCxTiAkW6yjDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzU6b5oJs92YB1NO4caqLL8co9P8uXKOYduKfxV5ndYg&oe=6ADF4C95"}, "display_name": "2035 Carbon neutrality of smart green city", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths.\n\n1. Experience goal\n- Discover specific career topics in promising future industries and occupations against the backdrop of a smart green city in 2035\n- Explore a future path by experiencing a space for carbon neutrality\n- Learn about the need for carbon neutrality and what young people can do\n- Learn about core underlying technologies such as realistic content technology provided as an experience\n\n2. Characteristics of content\n- First-person perspective in which the experiencer becomes the main character\n- 7-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n- Estimated experience time of about 20 to 30 minutes\n\n3. 7-step configuration\nSTEP 1 Instructions on how to operate\nSTEP 2 Meeting with the UN Youth Delegation\nSTEP 3 Practicing carbon neutrality in urban forests\nSTEP 4 Implementation of carbon neutrality in wind power plants\nSTEP 5 Carbon neutrality practice at the East Coast carbon storage site\nSTEP 6 Think\nSTEP 7 Finishing\n", "short_description": "It is a VR content that allows teenagers to experience a space for carbon neutrality, learn about the need for carbon neutrality, what they can do, and explore future career paths."}, {"images": {"nodes": [{"file_name": "HeroCover_3000x900.png", "id": "7527653000591853", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001730_7527653007258519_8435369833685824333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLcSM318wQgQ7kNvwEW_azs&_nc_oc=AdoJR4K3U-_rZQ7ussk99mOD8Wf0Xj0rHl2c9klOjbDY552Yj_NVWTzwrsuMSeV2WI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8RJM5OL5Q3PV3SaDHU_0B61egXYA0QdZgSHzSPDTNZQ&oe=6ADF6042"}, {"file_name": "Landscape_2560x1440.png", "id": "1452940842279363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031355_1452940845612696_1891464877969558457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKcdlQ_sLlwQ7kNvwEETncJ&_nc_oc=Adq725P-XPSl0hx1bYSuORzN5dq1SCgj5-j6-I_rdgHz8DUV5aGbnxq0eY4vRqGjfbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaGDFn7hRByVDMx7J9yZTO0e8ZHJ57ymF1uiCO48rHSg&oe=6ADF46C4"}, {"file_name": "Portrait_1008x1440.png", "id": "959181839136200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566686_959181842469533_2388841801262298119_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYEVdi7O0T8Q7kNvwEoGcFE&_nc_oc=AdrNfSZRSELyg21C2_hYZWPqEn9yDkEK3zoPlV9SGwPMtXwVQ6wc5ayFp4kvJLf
a&_nc_ohc=YFBVg6JrNPMQ7kNvwHzetzD&_nc_oc=Adof5gzsobTp7qFWvJYMZ_5F0m82ET9LqmbgAxMTjSVqq_oJimtoS3KrskxUa8e88vI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDByv9yzegcsqy6vXDX4oTsR8vaW1vAU6LqzC_Gew722w&oe=6A4CEB6A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZuUbj6Uow8Q7kNvwEZLH2J&_nc_oc=AdqFyOSOjxGWT3yqnLizKR6_dN6Q2dhh4HS9R6U38RJ_lcbiaLHPZWh0QQM6kBbayNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0cFDVdx0OmUS1LipG7dIKYJMJB0lkyq5iw0lJfcM3vg&oe=6A4D04CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M37Gz2Pp3LUQ7kNvwGwLEMV&_nc_oc=AdoAxwy0WLwbBncu1nUHZkpbfx6Y59UOFnt0UESH7rO6uAqjHsP1GNudOvIS1LDnwgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDODjkdzPvkJeWssL_MLbJ6oF0-b3G5UXHzXkoPwdiLw&oe=6A4D1FAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-wi9FV3w_sQ7kNvwHStl6S&_nc_oc=Ado0ySTh29Ee8TKO6ddVAM56i0_m-4oiqP0wQa0yJVWmGGp0LWVKdkcejqWammpQbjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUBWm088zfeMkgUD9_K4hA8-WLQr2DthhX82xuiEpu5A&oe=6A4D099B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keuwLSOYClMQ7kNvwE17-Ml&_nc_oc=AdqrA-OEI7J35NBELhG9gAyaiKd0S6C3GEW5pPIsgEuEmBrIFrQVGs4zFNsjKb39Qwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmx97raIuWeVSm98u7wFuQYJ7Kyw2Wm5CXviDWYfL3Hg&oe=6A4CFA92"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=CYOYsS4I0KkQ7kNvwE9QAAc&_nc_oc=AdrQsQtVmi58uDobQ8LGaVqQXPfq5LqDG-RHBhXJNMZCkq1unSSEqJs2ZAht_wnf4bk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzuD7kwfZqm-yRP9ByJVtmXQPbj3Iejwwl1ck2qGKvsg&oe=6A54D46A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z7zS2IzL2wQ7kNvwEQsc6l&_nc_oc=AdqYr900DFDLpUSVcDALfJOmq1cQYtHIGhe53PX4jYvdRlfsY-L1q2pamm1ReTalj5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrELWry27kNwIxaESGMcLaCPzbd92RHMQYVLcxkCUSgw&oe=6A54EDCA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z-na67aB8cQ7kNvwGejY2X&_nc_oc=Adr92IHIsKl8VakaquwFUK1SwIuOlC5arbbbeaSQZXaQrDhyFUWSPMpa406wLKcuEjM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCdkPe8XD39uUx990ZN3B5MFWi5mtyYZEWzMp5FMIPYQ&oe=6A5508AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPN2savaz0IQ7kNvwFe5SV_&_nc_oc=AdqvBLa_b4ZkGrp13dPeGRoC7EhMFuX3DUwbhocoAzxBHcZJtDoSqFLaA6YgvSpl6H4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQLNM26Amfi08pr-Lp8Nb5BT-4UR14D6TPRmplbPTHRg&oe=6A54F29B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaEhfUpMBsEQ7kNvwFyA8b9&_nc_oc=AdpPqrsCZ4ysiV0hFk1wH1WF_BYQtfoMpgFThwrKMuNR39wtM-F12qqlvgJfQrZdHbc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjHv2nSxJEBxAXSWE7rla4vRSpXTK_AD7-S_rXd5ForA&oe=6A54E392"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
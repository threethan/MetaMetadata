a&_nc_ohc=C35udAuz29MQ7kNvwEriXfe&_nc_oc=Adrk6E985nhtPfR-JBcQHzY4e4x7aLemBIthYCDTTmsrPvAtWM_yI0FeDxFAKKIBtGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAnAtXxxOonr6R1Bd4ARaUvysNRuI3F9Aw9h968T3lBg&oe=6A6C8F6A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DG_Bq3QS5vAQ7kNvwF9SWJh&_nc_oc=AdpEi5pSWUKppAWoFZ7cd2MUMdwBKhNDLuz2VIOxp6Xk8-LPQhpRaWNZubuh9smIzwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmWVWkAUliO66kXnwlgn9yXZqc4gGig_7G-cY_msbYcg&oe=6A6CA8CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjS2c7IFw3MQ7kNvwHMRrfX&_nc_oc=AdoGR9s0FKzniaK0oN2FTc0Gns2AH01VkgZ0hAWQtR1wNlOkM2yYcWNqVL2aZSzScP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuMzpiDcl4EGcUxvN7zho5_HRZ4QFVKZpmlXFGR76pag&oe=6A6C8B6F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqnDU2s7t4QQ7kNvwHV3LZL&_nc_oc=AdoZfwGJBJ3gZQnGHI1CoXPoqRt-yWXnj2qI4dF9EKA8EH0nfm7OxYMX86uBBFr-hFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI02oGsqpBQvwsM9DKZOCQhUppGjuEdOIoObuV75aW8Q&oe=6A6CAD9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMk1q1LhIF0Q7kNvwEOx8SP&_nc_oc=AdowReypQCv0zISbDsS00k0lODTBxkedluuG0LiVm6p2SS2SMFOeM0xEGaKomNUHtvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBldNXmtOusToWnqGiNyhp6az0_Ak4Lvr-NUqLT_BQj7g&oe=6A6C9E92"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
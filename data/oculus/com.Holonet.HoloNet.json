a&_nc_ohc=l1WqzO6vMZgQ7kNvwH7OuM3&_nc_oc=AdqRS30ejjR4CieX_kXrw_wWRE_OEGZHn-GANTAz3OntsyiE4CKCMfpfV9cZ5YJSXJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBS10pp4Ak7gBupcheuzbAJk7zBRrZ_I5bG5rQH3Ub3w&oe=6A6DE0EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XbcEQ_WD5AQ7kNvwHnG50n&_nc_oc=Adqk7m9-KtsSg-fzPCV06POGg-Ty3QBDstSBklxu4IwpelMa8Qe2LYw6eERN70lJ0Pg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE-QXu_jYqjuug40YqMJU63IZIy05lAclUEidyWUwjmA&oe=6A6DFA4A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjS2c7IFw3MQ7kNvwEY9is1&_nc_oc=AdrLoAide2fUTR-cnU6rIvW9YQ9ejx8EqbftNypYiSdoYLwyCzhwN2o1xaxnINLgTsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-gw7tQ1fFEocHn-bU86GyT55NDGv2q0TSZTVicAMB8g&oe=6A6DDCEF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqnDU2s7t4QQ7kNvwFV6PFM&_nc_oc=AdruEKUv1B815rgfGnyDE0VAXOs2QfV_tb-kI9y1ifCzx0PyRcDK3vv5vkJzGNu5CAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEzVSBhZNci6xK844SqgdxfxyiXdiAOAf6_ElxJkk84A&oe=6A6DFF1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVDMu5F_9dgQ7kNvwHKcr9i&_nc_oc=Ado_MpzaCm1kjArWoeKPqeYjHjGifJIsJRPUDmmP89M2nWKxGtAy_YFII9jHA8qXkOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU8J3EioZ5ZMzvpDaylUv7Cw298CgJIVd82ndHT2FczA&oe=6A6DF012"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
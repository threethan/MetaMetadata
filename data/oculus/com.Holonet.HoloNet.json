a&_nc_ohc=Q55DnkxvJ5MQ7kNvwFwtVr7&_nc_oc=AdpueQ0LGRn65D-40eFVV9hImQQymkNRjH3NAKj88h7q_eo15_YdTYcOZyL8_NAgCgo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3-SG1BY1y0PxPQOMx2UWi6iq9cx5KnVO35Vl4C-cwlQ&oe=6A81A76A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV9OpMusvA8Q7kNvwFn4Va7&_nc_oc=AdqqvwVzmgtmf5tP5EZ8Ntfx55WQSu_loS_OHeo6ZngVg0xVv_dQGoPnDt6-msYRoKs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaVYwM3BDh4UdYsbEMPFGFXdKxfw1t0kAmTC41RXYhIw&oe=6A81C0CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXwbJuxxzaIQ7kNvwGygcpT&_nc_oc=AdpPaPb-gcmsIz4rl-vjHRON6jvGeb971LdkZuHtESJ1vBSpghN9RL6OgVS8u6L-MCE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqSC3hrh1t2hSRQAURWLt0bdKz2Oro9uDi0XBVCiDYzw&oe=6A81A36F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3R-_FKE4ioQ7kNvwFVr6ZU&_nc_oc=Adrl3ljhdqmRlEcELbUb940EPA0Iw4ZVrQYgrC5fezsn0Y79s6oLcDGy88iFLiAwREc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0Bpd8V1oo8_TvCYGhyRr6sHLpe9vZxo8JB1F7TdDCjw&oe=6A81C59B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr8HwWxEIiIQ7kNvwGDiqFX&_nc_oc=Adp9RWMVWTQtNno5zH32VhtFeTxL57VMScYSEIuqVIDaF2hOLmsGEGdlF_ThRb-tZEk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrV7G7jyrs5faVwdElJzlr9GIsN_0bhQEAdv17wuuAcg&oe=6A81B692"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
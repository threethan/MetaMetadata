a&_nc_ohc=ShuZrtmeNnoQ7kNvwGRmUmL&_nc_oc=AdoDee45OzwlheBrvK8iFlhvuwKk_w8m3FMXhaK5XqBESQGb0pO6icTRNXCPVpgWvLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ_WP0QFOWARLytUIT5I8Z2hcIoIvSwSRWy9s2boaABg&oe=6A5CBD6A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNKUug175YwQ7kNvwGgAt5k&_nc_oc=AdpjWLFIuyYFBMz6f5RV-TXMBAs1zIxGX-XYeNv9Ear6x0DGalo2p99G33s2qyfcw7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCna9bWNHbIstdYovJjOiF8vtBjQhtNfFankPcNzTdaUg&oe=6A5CD6CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbsoDl0gGVEQ7kNvwGxu1H7&_nc_oc=AdpMbfyiXs-Fp6FOkkmntg7zEwIOUZWZyRGEcJXmbLgnreMGi_tdzSYp7xMiyovNkpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVvljhimcIA6HYFfyZw4xFiXaMVwRGYGbUW3HVx0jWZA&oe=6A5CB96F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAW5RjnA3ZIQ7kNvwEM2qD9&_nc_oc=AdqReoJqNQNnv4LNqu6QkWrFCwWzQVCyVsWbL4navp23HWQEOmHPYXaBNuAUTI4Patg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwOodEig1ZNZnBLzZaAQ0QD0LxFezUjbW_ldjAv-iVCw&oe=6A5CDB9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQBIkNRdDGAQ7kNvwEdVHxL&_nc_oc=AdobBQy1P9ryytF2OCwd9oQWOE0TgAUlRbCpPFbJZBH80FoB-jsTpt92ZYo988PNh9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASX57dWfkJf4Ib2s2NrxwLVBq1MwRN-TDrUEduWCBzww&oe=6A5CCC92"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=95iAhYbp_KEQ7kNvwFjfzp0&_nc_oc=AdocUY7Tta9pwrtnzmfHc8PsLDcNssSFBRBOxWSMlqDbU4rAMsmd3H9WM3PGvBzfZFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-viF5DWttkY-7lq7P3eJxsycvL_Wqo7W1S-Bisi5iJxw&oe=6A2D7FAA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1wNNqBwK8EQ7kNvwG5WDI7&_nc_oc=AdoF3mp71xn9yw_BwPqphPU7OgeO3WjUuyXA8jrGAamTZfp6wlQxN_aqJaPFpuENJmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dSN0rJ2Dly55ZW-4I7RyUBlphT9ifFhndsJmiLxPCvg&oe=6A2D60CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiTtUaobJVQQ7kNvwEBf_kb&_nc_oc=AdrY1fY2Z4RJvwnPj_XRjvf_fRdrk3arqQsrB2dv3X1tLdkgoLtegL0aKRpqrThUPvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BV64sY5BYU8U76k-iOfSLDxWrKMxFPBN8P9-ye0CpyA&oe=6A2D7BAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLmPgpLeImMQ7kNvwHgXXro&_nc_oc=Ado5bCZlztAnrdxJ8sy6hbgR31TcMBT7YZEaxCRO8utD_6f9VZhgtoMwb1ieTKUBzqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qXhjnszlYNoqw4laU36xDmUj_CtJ-rzGm_GAhgcyT7w&oe=6A2D659B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyhZ9ZD2H4EQ7kNvwGaWqFQ&_nc_oc=AdpGh9Vnxy0rxPbkKKH-rUKuMdBu50RHzcJnCqDTTcvFRszFjRt-Xvin9JBur0v197U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fHLkjxnz1AYmmnYsd1xfjILsKUfoop4QDawawRLoZ8Q&oe=6A2D5692"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
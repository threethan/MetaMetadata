a&_nc_ohc=j0Ja-VY2soEQ7kNvwHmEn4_&_nc_oc=AdrExgLPsWhD2NKjPPEjsnFEfuu2qrFfID94wQ5FYFsDXPDriBwQl7HFKPYTOp_HXjI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS23Fh4KJ2EkcXNDqIomckHs8P5h_KHOzpOaaqoFUqDA&oe=6AC910AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81kBrgQIN2EQ7kNvwFPiwdt&_nc_oc=AdrdzlsFAAi7IXDD96a4QN2sbLU4nudHcTrTe1VSMz_2pBYhMBySLJ-ob5oc6rg9UlA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_zprdR6EwV3vykL-wUNjftGiU2gZ1WkG2Vw8bcHCuOQ&oe=6AC8F1CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZKR2jwLyeEQ7kNvwFTXyAN&_nc_oc=AdpOUQB7uUmqp0b0-3RvL6vpPXiEk-38dylmSLu8Pr5d1Lv3vBzRiD3e4Mjbi0amyfA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwl5L2NYJ0c5L4vDj4Qo2kFpHM75upOnLCPxan_nvlXQ&oe=6AC90CAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfykCvvHWsMQ7kNvwHS3SxN&_nc_oc=Adqfl0ETd7lmzB0I8mD4ZqpyZgtIaC74xlD-5arzJM36apJ0A6w56onebiV1yMKMGHQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbZUCmGDqtY90fSwCneBmt7d7V8QZqH1WED-IRd2HEvw&oe=6AC8F69B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d345i87AO3QQ7kNvwGDZMM5&_nc_oc=AdoYakzESpkcpmN4AYs2mC79MSAZK0LcMDdKReFyfCrzEI65jPvp_t3vDAn2cKJaMiY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX5cM2joJlGDs6Y5wV-qFA3eAItX_7NxIMq-SvAdbQ8Q&oe=6AC8E792"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=_9CLZruAlpYQ7kNvwG2_URM&_nc_oc=AdrdJtX-Ec7ZF900T5RWcTold8gcj0TyFhCZEykFrIX32FzEmLr0WFofbVOc7Uyulgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC7lpBb_3Kivv-bQwfXc3xQBFjVQBi52xO3-Mj9FlTIg&oe=6AB3F8AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRujZWXNZXMQ7kNvwG9bBtC&_nc_oc=AdqILNS5Oe40WvLYj7MjtmwtvVKMZoN_dIbAmT0C8zvF-4es5477H7GnwBP3dUmAVF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA3AsCmECuyCVr7z9doDaP45uKHRY2HhkyoW2MEY9PFA&oe=6AB3D9CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_IbiaZNpPkQ7kNvwF34cQ-&_nc_oc=Adr3LPSRwuN3GqbcPdMgeITe-lzYXvfCCnOytXBWbns_CTCElNHkD9vW_REqOixkuSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvvcJ77Ih3ZrHoEXZUqoukWheGQ0HCwTKrfeCEEuJQ4A&oe=6AB3F4AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgsOiEGzB7IQ7kNvwGViXgy&_nc_oc=AdruZGadDkQHJTCFI2nWc6RoSWV_bTZvKzbvg-vLkA25XVW7JDqlBNhRp4q9uYNQwNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiJpG9MvVsU_YAbcZM-Z81YB-MaIColVEDJU3JnElvpw&oe=6AB3DE9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQaUllARpB4Q7kNvwEBVjgQ&_nc_oc=AdraVMBLtst5hWjb_Fyr14BvD0XiscEJ8YvWdanE7Ppvue6lfYeP2zHmAH7Q0D5Kqag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnaNjYFNfoeTG2yCoyg8O_uQnx0kpDkna9Bh_wpKOaFQ&oe=6AB3CF92"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
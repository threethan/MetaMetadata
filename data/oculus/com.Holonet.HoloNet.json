a&_nc_ohc=bQYlwTYxvQcQ7kNvwEpnlKp&_nc_oc=AdpgyM_tmgxhSYztN4z6Kz2ns1btVvCPaFnoTTEJkUEzpzCsBS1p-k4iS3T0xB7rn_k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFIMuJx5RqO0NzIzUoEWS6cQ6zLsVc5nZrdL-kYwZlIw&oe=6AE611AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbeinJQr6IcQ7kNvwFGmXie&_nc_oc=Adp7fVLWeN7QU6RLfvBGV1gGLMq8Q76U9FBvmDzlXTimmW-ntwNPQ-mMQCV1yCUiLvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw_DtR8t8lokRxo3hW6a0EUFoDU7U4SJLjM0Sq6DgU4g&oe=6AE5F2CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1iI83abMb4Q7kNvwE5KH8E&_nc_oc=AdrVPv8D-aevVl2hbCwifJbdjQ48ZhQZidO7j0f8it03GRRZZcLpA_sIZKkXu0aSUPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdSbED3lieujldLJwjRd9hR3RtYnAy19iCRADQwzkY3w&oe=6AE60DAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubCNcsoGAjcQ7kNvwGg4ytx&_nc_oc=AdqYRfJ8nsecar5CqoMU67aOYFPx4zSagnkegb3CdefbyGoLkz2H9Mz6qLG-ltXZ8Nk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8xwMY_c2Cskj8lvDKX-Ezxc7W0t1TUprs-4Vg_370Cg&oe=6AE5F79B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaCW-Seqj5MQ7kNvwHB8hy0&_nc_oc=AdqMnIt81nAvhZUE1Q9ROcI-HQXJaetl0USzLHgO4l_QH9q6WJocG_nbrmUfo_NqrME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAZzUOu-daVqm9qSiYOlVFWI5OXlADjpfRwuicQDXjzw&oe=6AE5E892"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=vBmMAZtFQsgQ7kNvwGFAuqb&_nc_oc=AdpjGFqmcDbslrLZdOwzY4ujH-JofUwr2_UT9s_n09tkHrzscTCltD-4Z1pvh9-qAEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOZWMmhUCoSa3yYzCgrbWImSUAOUCInss8Upq55YPM-g&oe=6AC127AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-UnJ4FMff8Q7kNvwEVl1Zv&_nc_oc=AdqzcaVMQDQJLluh60yPXxkB8cQdVGn55k8ZFlBSBfpZvS4NtDnWyQAkotwTmBn7Ams&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4wu24QhZFojppB0C-Rh-j16aoKbLn5sY6G3CM-krxfQ&oe=6AC108CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX7pe-0AeWgQ7kNvwFUPjrg&_nc_oc=AdpMVTf3SeI3qakgL0pTNHvLM42UlAQthyr4te4GdkbLQP-_dNa0Un8Abs0Hg05Y1MM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmkDpWsHdy7_tYY-4bLCSrSQpQH7dvOtisjrv-HIiBEg&oe=6AC123AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49V6qhPJmxMQ7kNvwEyHtDd&_nc_oc=AdqGKV8J79WIzYSWxqBpB48NeVrTQHJCPCzsUQM9SXxur1c8QaXUdbpjElPYq83nCnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzueovv-VFasSNuUsTuGC7DE54u4FamwsbhxDHWkENqw&oe=6AC10D9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC_65JIGpNsQ7kNvwGNsmjM&_nc_oc=AdohKF2iTKytZH5IsQocGxm4sQk5DpFCGinB1JmCxUa43-Fkx6uCVfTRoKfMg9ttk_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhb_SM1O5LFCwoU7rmyO9S8vz7WAWOKT_rcxxIbCy6dQ&oe=6AC136D2"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
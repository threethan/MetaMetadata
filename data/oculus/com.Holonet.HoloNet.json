a&_nc_ohc=SJjNrTzk2JUQ7kNvwG0CyAB&_nc_oc=AdrqYpk-bInUql9rws17-uHrM2tW__h561SoUGZwnpGIcLIW6BnC7YRwblCMHIlfYCs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__tiuJHY9nz_1AbIvhVM-G9xfCC8qnrDN3fgpUVeUO8w&oe=6A45026A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf3suUSQK8sQ7kNvwE-LTaQ&_nc_oc=AdpdHZWsIK_TSxfjSb_r2edjJnhkTL4RAnEN5itJjpzQD1_0a_ZI5tEzbbbo9l9vybs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JZyU0fLZdGi58CkBWBokCw8bd-ohStcc2tbKTZJQHVA&oe=6A451BCA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4ZmcvDWZpMQ7kNvwGJT0kL&_nc_oc=AdqzMQeg2bSgBSR2MUm6P36JNdJEOiwySHYd5OiV3hC-ODeH9_VRbUfrzIVZK96eobU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ytq9uO3QZ_vzFnu9B_CTTgbKFRYBjOeoPxSzTq54u1A&oe=6A4536AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PkitiRekZYQ7kNvwHg3T6v&_nc_oc=AdoioNNwB2cEDE7KJUUpWAfInOM3zdsPAwBZkk05CuMurW2MvDBoFBE70jLM6kZz1dI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KZ8LyxdSHR73UcK1HY5qzfHauzYmaRzvpOEuwHThcvA&oe=6A45209B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkCTD8Q-eh0Q7kNvwEbOWsK&_nc_oc=AdqosE0K0Az2hrj_X0DMf93ANmjGWvVwLd5GOuu470bK8MuNf7dg6gD3d2jNQ2MJnMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4672V9GrULUzPI-Ka-QfJgsFNUa4M3w8sW_inR8UgYg&oe=6A451192"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=SJjNrTzk2JUQ7kNvwGoNjof&_nc_oc=AdrBIb4havJUPQG-yxyTbBa1LBK1sYIziTlG42Hrt11vds8MYplioaKtzR20fLEV704&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pfp-WaWVIA7lbr7yUJADJb_2Jl_XSXuUAqbRx_xQWuw&oe=6A43E92A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf3suUSQK8sQ7kNvwE38oSU&_nc_oc=AdrSgeKWBpNatCpRaOYABY3qGAaQl0dByyC5EnTMpWBOWZXsM5lwAr8g2tdxFQrliB4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OtNkRH8vgsuXC8dPI2azyJtFhdot_7sM-CHZCeqpbWw&oe=6A43CA4A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcoxaPSIXKkQ7kNvwFRCOx3&_nc_oc=AdqecwY17heToTvc8q0S_7Vl2f_mmcmh4C_vNFQbB3iaENVOdNJHcywB1nRPr7GQTG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-008laXmHUrSfinnzlJqlLRpRhbQ-Tgaw19Mf5DZfoVQ&oe=6A43E52F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLl1l4O33S4Q7kNvwGde5L6&_nc_oc=AdrtpI4zhmjaKKlza8Oav5DMa_wxQcfUSTBIQzs9lxbtRPLgMroS61BypQNqcdviPlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QW4MzWU93LTTW9Gbf8IWQiT32pPbR9q-pFBWOuh5m5A&oe=6A43CF1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkCTD8Q-eh0Q7kNvwHr-QDf&_nc_oc=AdqdlB9yYogaYWoBdJJCh3zWOnSFvm9lOyJLXRQEUdlCTsGjNONqxwSPd2xDLdADLdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3aN5zrOHr7QDf5KeRQxgEnbD7V70YhGSlCT4ivaD3Jw&oe=6A43C012"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
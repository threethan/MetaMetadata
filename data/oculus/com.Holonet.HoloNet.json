a&_nc_ohc=jf8jNycahLkQ7kNvwEX6w_t&_nc_oc=AdrsyEBrCb0qG-UdjGtNZY5GuCbLk6kH-QmC4vzkebI5PCfPc9z18oCKDxMQtEt-4BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNjmR7LsH1PlE_or73U7kB4xaaKddiP4LKaJLHXcz8tw&oe=6A6354EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hjxals87oxMQ7kNvwERS7Hh&_nc_oc=AdogeVgwLrQjThp8kWYgYhLC6EsJFk8-zcu9bBqZp64PEztS4FS33xk3e6y9_nPU6c0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGRiVEJUtjtwc1nBNFoBI7W4QQdIdUeiYhRJ2g2_xr_A&oe=6A636E4A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9WJ5SGV3nEQ7kNvwF0ldAY&_nc_oc=Adpta3FNluJTGY0PLy7IEqB0r_ZMIZKKzjKdvr1SNYu1YR9ZpQsmsl_ssVyxuN7vciM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlC5AxRU6tpXymxsWE7l-t6cgJps4jdezipWtokbZoGw&oe=6A6350EF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccosipGnebsQ7kNvwEuwP6L&_nc_oc=Adr59cDoGiodTbxAQNMdeUAL9QaS5y4jiI0WG4hEixlRVHtvq4oXSC-1q9Yt_QagWuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6ELRen2Ylao9KI6PoIjxepxoy4O_ph_MzlItHLxni0A&oe=6A63731B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCTjciLDOjwQ7kNvwFssGhy&_nc_oc=AdrX5W7HeeRElV3Ek2M-8UTAB3sgR88lhoxkVkhDsBZQT8MGOQ9dO0RtqhYCPbE3yVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu2q10KAavWr0EMzyP4_NQdb8Ydx4DuXLgSpVwEXtrWQ&oe=6A636412"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
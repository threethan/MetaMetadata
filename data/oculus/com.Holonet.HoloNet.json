a&_nc_ohc=pRx_6kXSQSgQ7kNvwGsUqF_&_nc_oc=AdqnZBGNQpiH3SecYnanGqKm1pEA4Jv4nqtTVAK-OhwauE_lAbQV5z5RHfYstdkgbQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpjHGIGPXhAjNshMbGs70Oc-T1DISp1MPudNljiCWreA&oe=6A9EA86A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGqAmGonM70Q7kNvwHA78GV&_nc_oc=AdovxGg69j38zg2x_85RTR9bEAhtVf5sxJ-XcXWxym2Au1dm7w6q2qhb1kiwEZHNmzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy-wD_L9xyPdg-m5pvx19_9AENeJO3DPqtyBg9y2WF4g&oe=6A9EC1CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TemMJ_Vkwk0Q7kNvwF8ZX7n&_nc_oc=Adpdy9jt0gv_zu0DC2lQ1EybJUqee1bqf5uRcq11GIznWy7ja9xXDBxidtCeES8xYtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGDnDdV6sGqGI_2GD6-TLOYtBdTo7mRhxAL0jzkyhMng&oe=6A9EDCAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWNN4_QhdWYQ7kNvwFt9XGQ&_nc_oc=AdpHWZoXmoIOhT4QPc8FXFRdsCKSbeUucVoJNZzM-i_T5TpsCOwQeP3huVOCR7yNFGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfLgleX7NKKnoZZUOR4R8VMt338ux6xXdOXVA9l6SvbQ&oe=6A9EC69B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU-7zEs2A_gQ7kNvwHFodD_&_nc_oc=Adq_ewuqfQJtlpm6Ut-6vLX1T96ORxQTJTo5ipCdzTM_-ZGOmSAbGn4m24-TmGxbjb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLayiEWY8Xl5wmIWuGQ5lD5uFWL5rABTtu9fQ06kN845g&oe=6A9EB792"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=_cifCBtHVosQ7kNvwFtyT9c&_nc_oc=AdpkoIG8CqTSofQgu9a22tquWlv1um9PDY1nrkNucuqo2UHvoZXwDa73wUG-DQ7rO-0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWNO2yTjbGLrd9aemIe5y0IoDHzqhmCioeh6-syCYFNw&oe=6A58C8EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkz1PgaqzicQ7kNvwHYqirU&_nc_oc=Ado7B-vsRz4pBX9y1RMwzTgWYScN8_YCs5kgb5YKtqSF_2t31av_mIX9R1ai-lDEFu4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGD391x1NPmaS0RAfeRTtCZ2rI2zRkYET6pULCJ_RLVQ&oe=6A58E24A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMo5C_P6ihQQ7kNvwEj_xkr&_nc_oc=AdqKKYZfIZDuAfHwuHPomSAnanU6ijKaHbAsAdYWJL9W4uzMH0J4muWSwK_PsGr4QHM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6vqklGheew9vaRHWCscHAZvHpEKnxnaKnVyAMYzvGnA&oe=6A58C4EF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j39-rVGnOikQ7kNvwGvUb9O&_nc_oc=AdrRUBDLGhfCgWwdVfJa3Pe3fm_0hQ_NeUTpgFVz_KLt03rkdO3LvEY_L5HYkadzvTI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAcCdVJwtYsC4HlcTXF3uPBkgDOjquYd1xA8-v2wW_uw&oe=6A58E71B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNj2qMPDn3cQ7kNvwG2vslI&_nc_oc=AdpVnB2s18N15cmhPhr55f-khVylk7wI-EqkxRO-kRiVAIwPYLVKdYerdFneLio8iXo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtA1OXb3CHwmrqP_ahAeDviMkgq_I1MLehKSR6OR6N9g&oe=6A58D812"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
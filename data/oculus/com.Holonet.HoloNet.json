-sea5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfMPd9MQhiYQ7kNvwHy3ci0&_nc_oc=Adooma7ACURrQbbY6HLZw9RwAROC6qUGnKXHZD3XL7y_SIhzUNVr8c-g0xlk2gubk5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpqz-Ds75MoDV1gp65pQ3vNaZbRpQmuCyI1WPd0DHdpg&oe=6B09B952"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "RE
a&_nc_ohc=qTVnRXKalWAQ7kNvwGiFr4R&_nc_oc=AdprN6MKyC0Meq6ojk2SFwJSCzLJsLgf1IqAwJd6w7dr_kRW5TSShLRpwQTyy3mDfKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--vq_XO-z6AA3l57RAQkjcNA-yVOp3a-pwmV1d5n2A6A&oe=6A3FBC6A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMS4UcTKczcQ7kNvwGWVcpu&_nc_oc=Adqx7ysjvQgpZJQi_eLPGP7Zr_L6afx3c7eUSl_d5YBAr8ykVXZ2UK6TpPFIns9oHWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uHn6Hc9Pl6yFfQjmFOiopKTfOlYb_R5jXkVgHbm2i7g&oe=6A3FD5CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EZ3RjARWwoQ7kNvwGvKoWt&_nc_oc=AdosE66kKgXHqs9YRoQ7Pfygh4HxezoyD46TctxeFbkm1a4fuJ19RbB9m72A4KjgMhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R1VranKAlB58UH6jhn08jPFv5uAuD3iVWIInfFGR90Q&oe=6A3FF0AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBnvgInGLwMQ7kNvwGTNJpj&_nc_oc=AdrloHpKwAW0QXOjm_q4z3IG5cJmzU6ooggWpNh8x2qHDrB988_tonnWxMBLSQg0lFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ijqMyO-kA0sSB5bv68mn_6e2fdtx4ruWRrKF_Z9WG_A&oe=6A3FDA9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnLiprlDgZgQ7kNvwFlxl8n&_nc_oc=Adp_pIMIS3DzjCqzVh_AsRxBaVsjhZtWD2dx4LRhOD7Vrycj7KzF7g20GpvqhS88URY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CzQ3JT1rVNBrYJnydjaSELLaEzr_5o3ZzqmgW8FJTxg&oe=6A3FCB92"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
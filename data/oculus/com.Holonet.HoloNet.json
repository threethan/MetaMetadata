a&_nc_ohc=SM0Nn7eSVi4Q7kNvwEo2whW&_nc_oc=Adr94tD06kyPKW1zuPzKzztRBVX0nbCJgSG-BHVvByjAuabtCDFR8CSwOJAxHRWY_Us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84gslC7EUPrkSzprCJNmnWfrHKbZYm5w1v8QPrX7HkUQ&oe=6A2ED12A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZSPbPhX6JMQ7kNvwEhHzIu&_nc_oc=AdoIRYvdEfAV_4nOCg9GsyuTwrSq0zzotCFdGGKnnLFLXwZ9glO8yBdBpGp4L_CeXzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jyWNiircWk4HBL29OPgBfbospJgGrqtbrgUlZXOAGQw&oe=6A2EB24A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiTtUaobJVQQ7kNvwF-J33i&_nc_oc=AdreKGy5mpEiDAlfu_qtpEV9dJ7eIpty_r6fiXRlYoOx5g28lLsaEFTx_fkVxcERjE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hPCi3XDofnL5N5_RrYHVO_3d2Luu7ZtQkwF_hw3VnXw&oe=6A2ECD2F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLmPgpLeImMQ7kNvwFjUUOz&_nc_oc=AdqRWKuZXXja8K_L7Y3dREvQxGx8uBmER7-di1Q-oxQk95X0W5pkmsteR5asJbSuT2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pVJnHocaoNJhwnkz-wBqOEyfmuKmUWO4FHQCptm7PvQ&oe=6A2EB71B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk_nfj3hYuAQ7kNvwGsD0MW&_nc_oc=Adrj9V91FrZFe8qyojP5-n94RnomMg4AR5_Ss9PHqokRtPcnD6W4qoqSnyXf4boXLog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j11Lln5iHXghCgWTEB7UMi5FmIRVbDqJNNrlVBHmk0Q&oe=6A2EA812"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
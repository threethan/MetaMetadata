a&_nc_ohc=l1WqzO6vMZgQ7kNvwH3c_3R&_nc_oc=AdozUszrunsmwE7X_feNJsHg6xKnYUVwwpe0hAo-52fY2qclZkUuk0OnDckP96_19Bo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnRHYVDv3Fn9WYbuojS22tS9J2VedDZyGDT30LZffAGA&oe=6A7083EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XbcEQ_WD5AQ7kNvwGqT-Im&_nc_oc=Adp4R8pf3y3hIOAuHoiYvWW91t5u6K-VLYYCaSJR6QZJaPTS0vTDztiir1Mloq8irgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEwnSA3DP9FrvKOgcTMzqPV1_6-qnQ4H0XqrnLDasFgQ&oe=6A709D4A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SUVNRnG35UQ7kNvwF_y-Tc&_nc_oc=AdofOPedCUK_TxkTKmtNYKABl0lS5BYdJhOHHJ06p9aakHacRsUpRMz3u8cPtOg3qrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3gIO99WsJZzJquDIBoRRbiXXHYYL1z5zHSOw0CDXBLg&oe=6A707FEF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMRFqfxXgfsQ7kNvwHCIPqq&_nc_oc=AdqH5yK9jKAHxUBr6jmT11TjCHBPeCKIrRujNlQIpDedFBY0_Ohq-VESWcoUxk2qVpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-bzFUEwzY-SaqQXHoyBMAYHdphPoFGfMk8bbpNivMwA&oe=6A70A21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVDMu5F_9dgQ7kNvwFzafIg&_nc_oc=Adr04Jx99xiRJZulUs179-ufJCwZs2fqY5j1ucrMYlIQik4H1vTvhJuu34IpM8REV8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe0GUnyVonUU2NTHyDqCgS-lL7eEiZf9yIXUMpWc7wzg&oe=6A709312"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
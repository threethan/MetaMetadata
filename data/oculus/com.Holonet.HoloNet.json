a&_nc_ohc=LGPw85ZaaiYQ7kNvwHXHLBR&_nc_oc=AdqQGzTy_to-8NmI5tlIKOJpH0u557q9wKRGdpdowiheY3zeDA8gfb-ygfn_nc8wGKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vueam5fLxkirVBWUqIO3XgO3ySbbBhJ23EivxznaVbA&oe=6A2952EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly2pSSFk6agQ7kNvwE3aIbW&_nc_oc=AdrsSaZ5vIMKI_tZjFjz7GwlUpy_4Zseqp4rpUSiBh-N1wrCBRokOuMii0S6fbltcow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95JivAC0-l-Jj1BQSGi4MCvGLohW-AO009KB8rPbC4vA&oe=6A296C4A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI-0jM-iyl0Q7kNvwEtX0Bz&_nc_oc=AdqyxKMjyIF7vjZAmOanqw90SA3hIGw63ST0LAEfZrfri36q_XrvYdbg6DqfO4aXAqE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AX99uu67jH1epkNmET-m7AQcxcwn0Mff5PWC0H1lW8Q&oe=6A29872F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuXUoaGXxOkQ7kNvwGrNeBq&_nc_oc=Adp5zg85GQrdZu1lrh8FkfvrOEZK_smUFfa5J67wgEbg6uyNIhiyPZZ5VXMILzYCNMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pAvvAMTIstJzRDoP2b_E8Dq8dFX2FJ1yGGs06dGuO9Q&oe=6A29711B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtNqMzsf_1IQ7kNvwHHadwX&_nc_oc=AdoQdKHp0kK9m3Uw52zDXFj3fMa1BC_LMJUSzHwRSMT7fIFZU6yY36zlDE6g95ssrew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zYhyOTZ3GcE7rVTTAq0AMdHwI2lux5nqYlhcdeKsRRA&oe=6A296212"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
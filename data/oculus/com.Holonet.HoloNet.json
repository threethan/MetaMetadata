a&_nc_ohc=ci5TH8lJERkQ7kNvwHMoeki&_nc_oc=AdrVAFgTKzDSzaqnyh1TLnDn4ao6PEvIkwC0AyYv3DMuJVy7rXziol-6bt32o62gkes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMikOnAhsl1AGXWByf105ZnppsaM1T-rT4TKWz12Olc6w&oe=6ACE56AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHTklxMQd7YQ7kNvwHmdcOP&_nc_oc=AdrEpra_G4i0CyFr85qB4svimgq2ThY6g3Set4BQ77Xv9qsX8Fh_MdzJEum2tZSv0QE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrxJVe04PRP_MUECULe5CFCozAqa-8RdjAjhozIETwsQ&oe=6ACE37CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM-0VmYOPskQ7kNvwFKAAGD&_nc_oc=AdoCsGR3L_RIeav3YjCbcaByf9vaCMMK8DoTRn4qOJ64SxQHzbpsC39geWpQnoqsFJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVxEdPYuXs1sSrwFEV1lt0ArIep5u4cQiV5fr1Qk5c8g&oe=6ACE52AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wl6wGR7RD-AQ7kNvwE9P8pa&_nc_oc=AdrTmtq2Ynvx3y9jzUssbF1E4O_eMFxeD7_i7zpCpv3dII6t_OS9ZT6cZkahgcIvgTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv_RMU6yyetFjFR0qMthqQf6-2QnkYEm0--0hx6jFaSw&oe=6ACE3C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1lnsMlUfVwQ7kNvwFJig8E&_nc_oc=Adohw5IPXqRjpXwUciqNNrO1UshrIQY3km6ksR-g5-0LPNY4PMUYABCC11dSHHbP16w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNITmmcqson8cmp-qTa6p9JbLmylaTi4YD3UljOANQqUQ&oe=6ACE65D2"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
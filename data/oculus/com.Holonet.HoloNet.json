a&_nc_ohc=P6xRNPsAOscQ7kNvwHV8jaB&_nc_oc=AdrKvPPmmEmtZjdtnzcX65oiBxnqFOxt7v2L1tN4SdxQq_j4bwvmTa31siLcgiTGGaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9P_CpdAtcrsbWIm_EQ3jMOH-P9oJVuWZm8IQPPIXqlA&oe=6AA29CEA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC-JRRDLgzEQ7kNvwFejy_L&_nc_oc=AdrVblNCwW5oe64e4Tde4PD1unfkApE3GABtTQlzsBz6QnC8DUPY9lqqwtfaUoCuVCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnogDiZvbfD_2DAFUYkhBKnkQUQD08YwnrOTo4kqMmdQ&oe=6AA2B64A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1AdimMApRUQ7kNvwHfX0D4&_nc_oc=AdqizWLeYqErh3fh0WdyQk9p_vHhEw2Th-TpRdWk-AvfTWVH5bu1WT64Y8C_IorF9V4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKQNcm7FoDH79x8Xno2jrxqQxHEhAs9EmnOaGBLVOBLA&oe=6AA2D12F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0csYGriKOQQ7kNvwHFccw1&_nc_oc=AdqPoyME95S5RfUhyYK759jFLvhxudIBFji6DxQzMZsVjVilcRyUE4z12H0i5_B-EcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPbd_aJdqbdpO19hKwLYcrccpl4vOStxAI5IZ2WHiwHQ&oe=6AA2BB1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbS1kie3xHkQ7kNvwEXMRcA&_nc_oc=AdquwDpl5JQf9pircXkzcebznS1FOstC4FCLRU1UVAbd4HluldnLCHaE79k2JZy0MSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK27FqgUzBboiZLF5dc-3TsO6PlMqCQL0kzbc8B6gQpOg&oe=6AA2AC12"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
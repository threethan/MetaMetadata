a&_nc_ohc=LGPw85ZaaiYQ7kNvwF9w--4&_nc_oc=AdrQGaXg9Lnv69lLXv1Ld9zX2rGlvf7WgI3fBW4o3ZQ_X9q3Zr8GqRNO_Xslo1DybFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lmFIskJTHeI7MfXDHTcBnP8pkg8xlkarArHkrOsQBlQ&oe=6A2839AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly2pSSFk6agQ7kNvwEWvJHO&_nc_oc=AdpqYF3oATA6U_8gNpZIXd3XjS4MsubLf8bqsBEw017_IT8JVQj9lWKcC3YAxBRoWn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nvtFcUSENIvFBtZqrx1XF61ztFJksr1nsSaxOhMKzbw&oe=6A281ACA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vIXVrYVHRoQ7kNvwEbn022&_nc_oc=AdqgD-YeQS2TWVsH1alPByv8co2ZcKAgXIJX-2_cm3dpOxQVpPqnMPUOKhvg_EXWMDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zUP9iNSue8d93b1cxTTxugQvdZ5uLjezkVEqzHKqGzA&oe=6A2835AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvM0QP7boIgQ7kNvwE57WxB&_nc_oc=Adpgbb8Imev8CdwDrSI_-IZ8ctQfQgDoLwGVgdEkhpiE3kE3mzXs3UC68JMEojXVZR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EfuWnmvzY2zl24E0AU7SMRxOrWgpdO8ikR8vatU6OmQ&oe=6A281F9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtNqMzsf_1IQ7kNvwF8kCqk&_nc_oc=AdoBCXINGGLuD3hOvs9hpjBvrlZg-vTZFUpDIAj2pNjEbWVDKuNjoPNoE-ymTL0NfIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nLi9mACG4m5TKAj9e3r6ZR2nzeSLsSXxlcjS8QucPiA&oe=6A281092"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
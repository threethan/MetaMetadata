a&_nc_ohc=KPRzoIJu-t0Q7kNvwFPMlt5&_nc_oc=Adpxb-AoTVWNG89GknJsDwV0PSTBGA4a-EkUT-2XZXqgwU66Vw5uRgjuHbLacoK58PI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdOu2F_QHLS16jhSyl0mX-8fbaNLLrslgFIiJ97Xet9g&oe=6A883EEA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbNGcTPCVGQQ7kNvwGI4oOL&_nc_oc=Adr7nndV7ewAaLcrwr9gfGvN03RSr1QWpiqyYraNMPrSB2QYeimTcBlfE9-Af1A2VWs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhQcvN8HKcUFnZ8TJL8RDE-o_4TlneoQGu0og1ygdsdQ&oe=6A88200A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEK3Z2xD6bMQ7kNvwE2m30p&_nc_oc=Adowwe8dlk3FHOPVz35Jo7QNOQOydXFn1XdgE6mm852VM9hyPCtBlwuymFSyQlhT8_Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAkjZRl2cVBzpXYBvmjPs_Ath1NfBeHBqruytyiCmAqA&oe=6A883AEF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJS3Fh5Z0UMQ7kNvwEOJV_9&_nc_oc=AdpUXVX7HXqMTa_nqeMjdqWq2Y7GdhpbnLINuiUaMMlV41BQCBZjHHye4LakPRa3Fq8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaEC0qj0nLNkG3U8b0Jjsv1cm-GkWl20CPEwT3ZKyTUA&oe=6A8824DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0V4T7b5PdIQ7kNvwFWgWds&_nc_oc=AdqvNx0PsAw1DJ8xV3a2e5mwK890nyQ3OpIHeNbgeNU5ZjZ7ZAu8pyn5tgAa_bUilkg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP2diQIY9YAQtTaKWoWbV_Ui_3abXJAK_HfGpFjS_TDA&oe=6A884E12"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
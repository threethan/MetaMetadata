a&_nc_ohc=G4ENQesQIqgQ7kNvwHKgawk&_nc_oc=AdplQqIm3TeJieIvC8Yh-bmor-rrZfK5sUbI6zvSPNatuvHZ-MAdTTtjDt7NdqcFha0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANF-5Ee6hcqe5uX7-_ClnzW9YtbTho2201jo0622hVzw&oe=6A492F2A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwB_DE41HxYQ7kNvwEGc3nZ&_nc_oc=Adr-CL4KtaCe2gDHzWRAPryqwUFeHtBBlFVnbc08W46suUQPo5IAt-ZC6RA2uAMRi28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB11zkjXL6e0itMKgL9CsIGfHIWVDKG4DNRFbF35TqE7A&oe=6A49104A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrraFA9LVlAQ7kNvwEHNUMw&_nc_oc=AdropTObQRCiV6uVY2JxDYPcyiSbA_5T9i1GTG1IdzH_GeAD08litkwtZw1vWzt412w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUMfNahJhW-gWSuxQFIAE3SlLzdY-JEIjXCt-I48M1_w&oe=6A492B2F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqcdMqMAuXAQ7kNvwFTS19a&_nc_oc=Adoi5WLbWNH5gvvaTvErMJzSRWrRAQazUH5ToEAs68zB6aw3UJQw8LFsgqSkgaTWx_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa3fD-CD7ESyyULSV0TfgKlXJg4bhh6ekWi0wR7IrbIw&oe=6A49151B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIMad5ne3foQ7kNvwHVL8K6&_nc_oc=AdoGrOyu3hMu5yJD7SgCaA1iirmqpiB5mOq7fKyK4U9x0sqnWhTKlQVdY55aRDh-NvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcQuqOVLGyshMqF9W6ypLY0jloZOwzlWYPTtw1zKxdZQ&oe=6A490612"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
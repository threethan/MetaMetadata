a&_nc_ohc=iLIWEUpXntQQ7kNvwFOJtbO&_nc_oc=AdrumylJIVM8x_DQJgcXuS35X71rhLoYnodVKm1yUN6F6NpS80GdQ_2udEehdNTpFDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sq2NHlI9UJb6jlvDuJK3lrnpJy9fcf4GTD2IjhvbUXg&oe=6A34172A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVXboGXEGj0Q7kNvwEopbhc&_nc_oc=Adq23PmlbirM046bzoWJhoSO8Y-rJtiOSc7EfkcE-K4GiUYLCKQYOYQg75PDFKdtKm4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90mUBUI7LncQ1FjYTrXH90PPXFkRLMMYnJ_oeqb9cuDQ&oe=6A33F84A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAMA9oaV76EQ7kNvwEsJoI8&_nc_oc=AdrpiILZisPytD8VQDQfvduwiOBDzhvpzY_cRjdqexjxXlMQ7Yq8aHn5JjTJJMKtr50&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i468rTxDeA_KSWv5PNMNxUSmTvGa2aDGXAUiTn5A9XQ&oe=6A34132F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYQ6Q7hFTsMQ7kNvwHMsUdG&_nc_oc=AdqAKxw_aw7y37vzXEnH_1ZAw-OEbtnPL5AimF_bxsX8aXVhe3LYOEH1uRE6jKJimsc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5VM-A5-CYZ08FcA4_ZQ12ahXimvSD0tBm-9Prp-1CEA&oe=6A33FD1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvncuP0XNl0Q7kNvwEfpbLV&_nc_oc=AdqBJl5_TTi4MpK9MAck6dl2mEYQrn6TccGNIf_Gtv2Jr-qEWr1Q5U-kg4UO9GQxsrU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eHcRynCOkfbT1Ik8qF1gkkig3iDAUtRmj1WTC2hRkvQ&oe=6A33EE12"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
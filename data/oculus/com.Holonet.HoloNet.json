a&_nc_ohc=LlBln_BNz_IQ7kNvwGfR8ba&_nc_oc=Ado94OuQZ823QtQkFRaomh4qiLY803luUGHAOLLKlH5VEBcgt2EMBo4FvhqDPqoqzVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xdfuI_QI3-xjyF6hDjWO86NEWzeHFQ4oDsN9hsKSjxw&oe=6A20186A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BtluCKAPL8Q7kNvwFTl2yd&_nc_oc=Adr0RDaF_znrB-eTSjA3TYasXEQ_jacpuB_u-NGU_mqEL8NNPDMtsQkxoMJVCJsJ0gI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hZG4hRE5V3Gys9VAxkeP35qdFVyGScr_RT4jjMY9B-w&oe=6A2031CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX1xjD0cQE0Q7kNvwGoGoJx&_nc_oc=Adr0zyOaGrvBZb57NxL9dRLUMixaTYFxiXMmMvb8H_OKbIRMHAzyABZBUJNxIMPyMRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L-dunyrlU-ehafvT8ajmG03dSQ12FSi4gpwzRTfQC_w&oe=6A204CAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=562flowJkDUQ7kNvwH8MmH9&_nc_oc=AdqX-SCvQLKZAoBf6cjTVeEl81wXWubbSv0CUIRhX_9eyZb8Uta7Q_HnksHoexaySss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lYmYKgPaclszif9TsIOD1NIegw0Pza7iVKLxNRRMPOQ&oe=6A20369B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2phfoV6yzoQ7kNvwFGtkbL&_nc_oc=AdpP4JusRDiBFmP5FL3IaaXvE9OCEJOsn5DQiaFokHCulFr_zLkD4kvHMNPX3L2V24U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dKzSQPxZfoQPJM_UbnHj020ZkPG87ZRylg5tKsf6JMA&oe=6A202792"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
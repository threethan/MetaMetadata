a&_nc_ohc=Ti-3X_0sWlcQ7kNvwHxTwzc&_nc_oc=AdpXFQOe476vNPFJTFEnGTbW2BAK-cnFLFOjzSDOK8i3DJraVVLEvQXfavmLigg_enQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlW2gdHmCJjmJs17o9kD1BoSJxO44iPA9uQdMi_KkZtQ&oe=6A9027EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhmP7WOG468Q7kNvwF9uenQ&_nc_oc=AdpS6nJoS9mNJf7PkBh1S5gFeOE46qkm20Up8awowWSLt9oYFYiw7QB26xMT07ysOUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs1WbdGdFB56npHJZQzI-h41Qhc_17hAyg5Zul8nknSA&oe=6A90414A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L43ZbURO0JgQ7kNvwGgugH3&_nc_oc=AdrYam8mJWiNHA7VbAoqT7Od8i2LiFPUdvVLrVPPg1qk7iXe2fMG9hnFPrnGtXUvZkc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLKMuEIvzYnRMWyl62Hpp0Kp0STO28H1HdI5wItGPjJA&oe=6A9023EF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SuKJwXVRKcQ7kNvwGzHThG&_nc_oc=AdpwCHalWSiOANlCRBaStWoi_0xmgocFSRfXCXQ4uTriiG06nIDiIykJ9MA4JpHbCMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUUHE4HiSAQUhacd5fFhFmd95migqlNUUD7R4BoZ5gEQ&oe=6A900DDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA1dTLouk9cQ7kNvwFC0-ec&_nc_oc=Adr7wtXqBbX5dSijBAwDQcdOTEXFeohlyR-E3bsmEbFeCYe_m7SL53BEVTHmGh02AjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5EstCnhiwmJ3jl1e9AlNF533rtCgLUXDBjYZP4WUGgA&oe=6A903712"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
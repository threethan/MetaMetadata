a&_nc_ohc=pRx_6kXSQSgQ7kNvwHBsi4U&_nc_oc=AdrEFGFE8onzTj7fIlbMcNzC6hSa5VCtuD_K_2D13KQJE1nmvxnXgDgKSKgm59Nmagc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIplxO38DNCc1316UFkaNsPrB4owB_6po-aK6L2EefPwg&oe=6A9FF9EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGqAmGonM70Q7kNvwF4Tvdv&_nc_oc=AdoI6TvzhX2sZzNS7FA3V39JjJluxXaQHkAAAZfYJVNfMaeyJ7md1aPInd6QVOkIm3w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR59ElGOSPDXUpEvU8Oj8AYj7vhKg5ERat1366_ERiGA&oe=6AA0134A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1AdimMApRUQ7kNvwHsnXhD&_nc_oc=AdpJvjupN57gcSUqZQTB6HplgBdyuJJpp5nF3QcdUSPMs_OWAuDyWqttsOeYk4oi3Qk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwpMe8tArNt3dAVOlkMsiz7eOa2WgIRJJxnWgJMH_0hg&oe=6AA02E2F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0csYGriKOQQ7kNvwGdzjFb&_nc_oc=AdpyIuf8_eT1ahs7AJiqz6P5GdcnKrsHcjp0o35OQUqctIvVd9G35fSt_KwN9BRQ2og&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpOkOWHxOi4BEyjcwClRPVSH_6aQAgtHohs9P6B6cZhQ&oe=6AA0181B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU-7zEs2A_gQ7kNvwHsNeFm&_nc_oc=AdoiaTREnFUbgtaWVldDanj9_64ZlMYZF9PDStR8eWzYVcunwNkPlKU8XPzDAh8uoH8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ062SrmAStt5jdEJzfLorHsZAHHcd5_SZgCZ-sbMpfEg&oe=6AA00912"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
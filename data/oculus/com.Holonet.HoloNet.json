a&_nc_ohc=Ozxwc-p-zBwQ7kNvwGvhmSV&_nc_oc=AdqsSAnWXnNLRfW-v9hibvs_UmCdszY8jl2VWjC4Pz7SWjRIfIrMoYQCCaCiy7VogaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1ib7EAe0gSeYxEp4yXOkDvXjjN64eKVpJPDqFzVnOYQ&oe=6AF340AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdsBonDjquIQ7kNvwGieP1o&_nc_oc=AdrS_W-j8Kbuvqts90IfH_BlsFvSDDexHePG4zNEQjugI_SdQ4iU84hvChvUi1uPXZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeeQHFON2UubYWrOYOn-PqeVNt5OJQKfvET6XxWsNq6Q&oe=6AF35A0A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYUiq6hJVDkQ7kNvwEtKxcg&_nc_oc=AdqqzkNz4yxPuMfmdoNAbC8b78KWW2fxs0L53CcyCxibEPxhoqtZ5Ysjv2Slpr7teIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9yIwI4-hMs48rxbgbNGvWO3t8-VobAfg10_14dQakgw&oe=6AF33CAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1-XPXRwTvcQ7kNvwEN-tox&_nc_oc=Adr4Wb9odsv6Jz-Hbu0a2uSyHfvOJbfufyO4hTnXUAxdsL7p5YsDUH-mOLGPs_lD3LU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR94dpRq7OD7PNvWM44m5buxFfDWNzUtINEO1FOt0aAmA&oe=6AF3269B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB5QAh2lcMYQ7kNvwE-GUod&_nc_oc=AdoP42foP67D5Z5tonFiD5uQOcrDVM9TXFr3KGS2o3Bkh1uWSMvcoK2Iz1F2CQoiCfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbMyyzsoXWtgwIYUm2lGCcL-RPwyQQZ6odXmr4-m3S8Q&oe=6AF34FD2"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=j0Ja-VY2soEQ7kNvwGtFEt1&_nc_oc=AdpdtoYO0SZtldX8eEW1oxFcdsSRoowPYV_BCzyM4I0TxaXXjI1k-T2yIbqhbg9cC_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFqt98QAanLnFuRyebDuS_V7yqc20nm3PhmKj-sq5e4Q&oe=6ACA622A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81kBrgQIN2EQ7kNvwGp6O4Q&_nc_oc=AdpZxzqAv2t2Y2PSNMG715Aa2caG7Rep98RaBE9DF0opI4b9Fpyk9EedGbWF2lGlns4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmRjAm1iFMG8AikwwWTSqsg87ByCP0MQGVjW52rWPHuQ&oe=6ACA434A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZKR2jwLyeEQ7kNvwFCEm0t&_nc_oc=AdrJVERkOFbJbAQWMFM_58CBpKr6NXz16Mz6YkM4aToP1osAemCvr4XTKqYS5iDvY2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2xmcQBQBnZxDb-UgyT93Liym2843irwyJC8kKt0Zijg&oe=6ACA5E2F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfykCvvHWsMQ7kNvwETpAK6&_nc_oc=Adr1buhyonvBtKYDXgH17EKHqh_A64NifxmbFnU7zzR-nXdHYzC9BG_GA6uvrrAMYn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt6sX9tQ1mWtmNEgueW8hOGN8rPh5FwQkazKzTu34XQA&oe=6ACA481B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d345i87AO3QQ7kNvwFJcxuM&_nc_oc=AdrLXFpBKG4rbliRmeC61PssEYy3eS3sW6yiRJZkjwgx9GBaUuzin5PkvuGG3JVhZ5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVm_TYOnfPtjSp5v6js50TISchm2o3Yb9A5d26hz3NSQ&oe=6ACA7152"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
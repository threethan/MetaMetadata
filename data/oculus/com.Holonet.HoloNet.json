a&_nc_ohc=LI_DFinN-rgQ7kNvwEo_a-6&_nc_oc=AdpZhH6WqUbzQvmuklr479sj52JMEwIH0BMBYs0KsjmBVXd9x5I_Azjnx9rpUqrzVME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJazURbqJ_wiAHF_OzuO-wBF_guflix4X_O-3e2N_4Lcg&oe=6A9C3DAA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBgj6nCDU1YQ7kNvwHF-H_6&_nc_oc=Adr6vw8bOQDPpVz5JlkX1rIUJ3R7WPp8LSg9kWuhmZElxXt9-RJDG0em8vnMRnp5MBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINzw8UQRE7Y1cTPNCQI154cn1iVJGYZsMAAlGgi0c32g&oe=6A9C1ECA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TemMJ_Vkwk0Q7kNvwFNl1IC&_nc_oc=Adq6dLRaoFEXPikbD42oF5i6vWmi5UgyAnfxTtm7x0Bv6O-dPdchWS9buqPWkelr7qo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYu6_AZTCmeV8wN3s6QoiXzl0fme-pS-7Ct3CSm_EakA&oe=6A9C39AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWNN4_QhdWYQ7kNvwFLPYwQ&_nc_oc=AdoLB4RUPrQu7BcEY8jyV4JZyeQ6dke39SehAqAgL3AYLggQwyoyyVV9M_EAjkwbj8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkb-9Ff_PTOcB0qCkIiNrEJb8KTxOo7SP5urMGItaWgA&oe=6A9C239B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdWCdc1VFAUQ7kNvwGwvmGJ&_nc_oc=Adp-N1aJR-nk9BXwnubMT3Frrui2r_F19yiJ-Foyid_nwShWTOyU3wQZ6WWnAwtXwcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInxsoL9jMi7-jUFrha9mAi9RaiDVOD53xuBnAjp9axdA&oe=6A9C1492"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
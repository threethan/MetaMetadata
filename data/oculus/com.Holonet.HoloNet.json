a&_nc_ohc=ObdKMy1pqHwQ7kNvwGjYfJW&_nc_oc=AdoJtqIybd7R2Wng07IflUKkcCs6o91lzUXLNhrkN3PGMI-AgdglSK_OXKTRsEgZ1m8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN55XKpPuJ9jF5D-Zh3-moy4fSO2TjErSi6TCpCIRUx-w&oe=6AD39CAA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4p8dmfq7-IQ7kNvwFKJ90u&_nc_oc=AdqCZoDW7djxM9sGVY_9qf3R7ExpJHQLf7w1eeJyc87Am2FxGU4yiLte2CaGjxZPClY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDC7sJmyquOikMq2I5fCtnFDMdmHHGZs_RpgUATkSRpQ&oe=6AD3B60A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70PPwudA8o8Q7kNvwHrxEjN&_nc_oc=AdqKx5433l5lAbuYuOPjMpR0E7lFgNgEI7FUsO4tX_teFqUEyCP5-xV_WFwVCceXSmE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrT46j6tLwQLLm0Bh_NbxUW2J3palS2pzuV34m7J_wIg&oe=6AD398AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaZaqT9NKbcQ7kNvwFlzc4k&_nc_oc=AdpRbcp-3aGW_ZZcV6PqQhXy4Q25OP-e2KIQVf-Ri8_r4wfl_enT2d5b_HcjC0P9wzA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQH6EyfFiaCQ8yyC15Ty9tU8mW7e6_lmqYt-g6AvadOA&oe=6AD3BADB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSx1-0pbQdYQ7kNvwGHYJK3&_nc_oc=Adq11C7x0kfnlvFUzvJUsB79-jArjEikSVjDig6lU1zZYwId38FaiXFDawumocVqROc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTC1ld0HmSzs79_yZtznZsDVm6cNZLmeOwRr6I_iNQUg&oe=6AD3ABD2"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
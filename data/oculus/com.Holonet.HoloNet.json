a&_nc_ohc=yuJGvMhUm-8Q7kNvwF160kB&_nc_oc=Adr10tjn270p-PMqRwtu8hnUUaRUSSDxf1af1IPPYv1yekCxEPzzohTVUW9uu6b98Zk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAiHkgBIpnS0FDOb9o_1qQfIjvJ2UiqfyvNraRlgkzcg&oe=6A8AE1EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLEadfW_1PIQ7kNvwG08rw4&_nc_oc=Ado3AJM8mjLJE02UGeJrPw7tN3B7VsWUpcWthSqAHG7DuHd4nj3o-nVkJM2yCNcA4Vc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrn9hZQ0zaLYVb1sY9HSGri_q2yyE84RJQ9s1zJxnMQA&oe=6A8AC30A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEK3Z2xD6bMQ7kNvwFG6DQT&_nc_oc=AdrAWVgl7SotDKcYdWvfVeztZb7iGCUnratKq1MVjStvfI0rz4N7oqF-kZVSjVUt0cQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfre-VN9P4UfnSw-nKahtRASVdrm1cjsUGTtLkBkIdQQ&oe=6A8ADDEF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJS3Fh5Z0UMQ7kNvwFvH4QO&_nc_oc=Adqwi8v5MmYWTAaEDIVw8Z1O-fR-43_pSNXmAmaf_nYN592CxaATohB5gCo9YZZgprE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoPLdEVHoDqOV1hutXuAsO0EGCBEftM1zmm8stJ14lgg&oe=6A8AC7DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hhjmux9yWgQ7kNvwEGb9AJ&_nc_oc=AdoDwaK3HlRq6YMpnXoGtHwb06rJA8scK-1OeU6AfCGJCmSI6kWoC2kEKC-egRmirCo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6JMKltm5WCl3PXdWg2jkBljMGEeev2TsaR6eIyayYaA&oe=6A8AF112"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
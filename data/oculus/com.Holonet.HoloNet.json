a&_nc_ohc=dLG8YSpkNDEQ7kNvwGJWMZe&_nc_oc=AdpHN3V8kaoe1YqU4Yseezn6yepP_Y-Q9k1J7vezs7s1TLyf0wO-127_0ldE8U3yD3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfJQB4WjLDPR83ICoCA86HFAfTq17vz6OItC0NOgJUzQ&oe=6AA6916A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOhT4PFfSjkQ7kNvwEYAgIr&_nc_oc=Adr7Ot18VCPggVlatjHDBf5eyP71dA3PleK2EnP0hCmJxaI98MkMde9aGV-Pd-SWWYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdnbAg4bU-FHelDR4SgQO2K25iVRmzSndrssyW1xGu7w&oe=6AA6AACA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AX5rcRi1XwQ7kNvwHe3eOl&_nc_oc=AdoVW8bG0Z41tk28g4lrdd2Z_YtYT0v8ZfvIWQrCaD3krZeWjxbkoIottwBIGLEb8TE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqExSZT34WpG-ldt5pFb5E9122LtmHTXndwMNjeTD83w&oe=6AA6C5AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bioa63xKTi4Q7kNvwGRDQQL&_nc_oc=AdqjkQmxCmFr6p3ja6jCJQwcdDA8UIE2owTXxgd_upHTN-OS_OKehA_ZEFNEt1IzLFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpYG25iuhoVfBmEOo7Tv62T7WFF4ivEUPNaQg33giPkg&oe=6AA6AF9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0-mVWNtXS4Q7kNvwGg_kg1&_nc_oc=AdrO072ewm9iJMZmdss1cPF-fS7pHpq5111YjZaqjPbW_NcdIlStWDNxADb0D0tULvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRMu_qIfiEiz1ORWnS8Yko4uZDmgscl0f9IKEINmCMRQ&oe=6AA6A092"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
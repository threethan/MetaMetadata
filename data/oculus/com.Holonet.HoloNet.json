a&_nc_ohc=bQYlwTYxvQcQ7kNvwGU2EzE&_nc_oc=AdqCwySjsbklRzvaqOZCqrNuvq2wIXA5vVWCQ_zb-P6ng7MzPUW7lJqRrvfifRmB6r8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR09L5BzVmZRsXvBZadMZNkl_QRLP64Xs05-xwaoJ7Rmw&oe=6AE7632A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbeinJQr6IcQ7kNvwFPU8Jv&_nc_oc=AdpwiuyaTJSsQNyYOe-MTwPm21GxliI1GuEZdj0WajWOKtDiXYSbW8Ly_TLL1iIPTos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgIrj_V4_X-PqfxAfEdtSS0SPyc9gKjaPDj24L5f5jCA&oe=6AE7444A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLnQ-JiCXkoQ7kNvwH8W50m&_nc_oc=AdoBU4vyINEs40wL1I3vdOoVGoe6D3g-9bBIgG_Uj5iLTcAL8hEu39kIIDsrEizzC64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw4fdJ2xAvDM7Sg_BW5fL4pJswiiojRMFqZdLSHE5OCg&oe=6AE75F2F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkmhV3h5sy0Q7kNvwFikEPu&_nc_oc=Adp4QJY5rwqKt3_0yLp09N0y4BSr6yXPfhSlqdGUM4Eeoy-1QMYtFnP0PnEC5K5YY2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUUIRSVj6oBxQeU4P7F-LTEUvLrZEWSfC5rZwQIhhhNg&oe=6AE7491B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaCW-Seqj5MQ7kNvwHJnAiV&_nc_oc=AdruupcNXSHRLA5-W63CLSlnQom9N-pYAdJVfXwT46-dbQGmFCrh7WVzJuURGkskIMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTOXXi9VZEbIFfTkFq2pyOiIN5XDMO8fqMe4zUVvu_qg&oe=6AE73A12"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
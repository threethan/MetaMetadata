a&_nc_ohc=kY-gZ3y7stgQ7kNvwEBXNJG&_nc_oc=AdqEur9IgDn1-dp8ltoiFgZ5JgOc-eHJcyZahDg_MpxtrWtKQMfxHKZnHb7cQQXI03c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOVlwFtt687YOLsrJP-1bKTGdq5WY6TFFWmv2PrSWNMQ&oe=6A92CAEA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aHpv6RoFQIQ7kNvwHKWAsn&_nc_oc=AdoXIKacUf-KCIqkHzblvQTzEr4SUHuOdvvGEzAsk3hXYG_K6UP9qzmc9jj74wyRfO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrKqeBvV5CkxkoVRjiBp7LbalzcY9iHUC6giYZW_xSTA&oe=6A92E44A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L43ZbURO0JgQ7kNvwH1iZs2&_nc_oc=AdqunbUf4ul5yn3hVFMYd9lzdTv2KTNIBDIcqlnbMVRh0LqZ7Oz6CWuGoKnSi2S73uM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX7-wvBYq1sEqceRdJGfoeOi_MiOCi1JGd-1NUvoR_Hg&oe=6A92C6EF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SuKJwXVRKcQ7kNvwG4MFd1&_nc_oc=AdowQEV4_tOD8GX2TFsgeqpam_CR_se2aa-4ZeyBzyPqWVlK-A6njCGet5I6T-rYZhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE67_qjRA9ypdTozaataquUg8a32cHu-hUb5qAKSMbZRA&oe=6A92B0DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8D8iQkjxT0Q7kNvwGeu1OL&_nc_oc=AdrSSBECaVru1pHwLoY1kBqw1o5R2YeCfh3FO8jdG8uNmSHHz7CCVre5pVu8t4uTGbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8W4Z0bVceuqr9lpRcpovB2Y77GafyIeY5IcJOY7REjw&oe=6A92DA12"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
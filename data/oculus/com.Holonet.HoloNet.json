a&_nc_ohc=h3R2-Fjg_gAQ7kNvwFCSoTB&_nc_oc=Adpmx_LcUXS8zbglx7POdfvHeAqSlVfYToAB7peGNYaKPcap1Tn5LpBtuWoN82_PWGI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIKR8bSxnsGLnhki8WY2whF6WvreMMPsBEFjJyTwv_FQ&oe=6ADCD72A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGfZ9NEAoZ8Q7kNvwGBbKLV&_nc_oc=AdpcqeDJhSqlPB6UbqXymO4wrbzhcv2OF43D3VGX03QYvaQHc6qFlH_4N8dNQbm6vh8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlDHIFHXZVMrhaMwyH7NgaidT5R5uW2iuhIZdNrrCKyA&oe=6ADCB84A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1m8aIpMWPMQ7kNvwGr5WOm&_nc_oc=AdoRozfYTo4U63Xn8gemC_jgo2c8PHcT7zetHGbMuY8lFaHNZGDe1D04wXtLQSJTV3A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKrtvR0Rdi5WOoe25tfUTTBkzbtrH3zGkkJnX7m1UmVg&oe=6ADCD32F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk4zGc8jzDAQ7kNvwFTVM3d&_nc_oc=AdrVEBTwq6pJSgIzEc0xk_Ve3kRmcxPHlf_8FKRFw45DYiOE-bkmqZTK964EfjHBBto&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQm-qBCdoIaK_X4EG62P-rvIypO3WOPD2dFa4S1Se_GQ&oe=6ADCBD1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-sxCrbJHiQQ7kNvwE_EUMU&_nc_oc=Adqs53TNG_6FCE7AtXJCjfmEf1hGVBqzBVlEObeUxBiOY--M36NU38h7oygUT3sFDKE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrBlTApvEjuSqdImW-UJLcgJBVCyihi6dlh2W6wMs-WQ&oe=6ADCAE12"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=lVfAdhAFIxkQ7kNvwGlnTZj&_nc_oc=Ado47S-QPZyVmMjMPh_O8dawkBJYg-uG3MZn16fLMlR6hsCBmv8auvLACareJzoi4dQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmmNbcsiEWl5fJWqexWQXxhVVNhJs0xhe_ymJXvl1RDg&oe=6AC66DAA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ST-jWiA_toQ7kNvwHSV3y7&_nc_oc=AdqVrfLVhOnxGnKTI-Py0-hJY68btiKFseV1u79Bz1UKe1KEkHuuuvu5oSBM-Ak2jNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQyHl3N7GSSzGvgRJJlIolv5l13PGN_XAhahhdxIOgNg&oe=6AC64ECA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYKRm3i6kxcQ7kNvwG0oLjl&_nc_oc=AdpYutyY6gAZe8cXLUVJTkonMAPYd4Atcg4qLpZIjORkXu4_DMpxo_Lk-f_b6NDPzdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNggP_VyWK2YThBL8vM5Mj1saS9BL_bbsnTPPB6aZ4-UA&oe=6AC669AF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCkN2-iq_skQ7kNvwHey_6N&_nc_oc=Adr72ksgNFxw0FXGYvMEfK0K4rA5ybkXvkuj3xZHPCeeV8ur8x5ryJ1o95G2lDoD9x4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtL-R7lkUk1qlMseL_czr8uOHgeSs-JMqFgF2tBRjp2Q&oe=6AC6539B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pqARnV7S8sQ7kNvwEbAn-g&_nc_oc=AdpMVPtVpoScbA4kyK5Oj0sl9RTtRH-RdJgzZX9xPDLIHu1vxEjm7Av1ZvNq-_GS10k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjmkNkVC90AU5ZwzGOKO7S_WGg71mFHSiA5yYSXd_gBQ&oe=6AC64492"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
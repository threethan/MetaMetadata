a&_nc_ohc=ZwKiqPqBuDUQ7kNvwEPFmnG&_nc_oc=Adox3KeXHNM2Wzkjhqz48ra2g4vv1fcVtNbsi2Ep37OPmgMAnKY5anXZkODNTSFMo-8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k-FUCKEfgvtHbp-xllaGcQVpTKDtxE_q6bv6P9dgBtg&oe=6A24452A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-21GGyKYWkYQ7kNvwFlKU4r&_nc_oc=AdqfVceu4s_5VZ33SSLbG40jqU3-S5amVkSUj7N94Z0PORqP5H9fqdsWmsng4Awt2RE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KygNiwIwlRbWfuYte634r4B3g4HFLsPUVyxPtn6nFFA&oe=6A24264A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E525DO5T1oQ7kNvwFqz3Oy&_nc_oc=Adob8LGf-QUJHvO3GyD4Ng9rLz0ZYagW2bXEUkt_xCZKsGoI0zKXynHZCYd3xIfMHGc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gssr1DB_4hGyPr78wAkkW4Y-ZmgDlhPHO4pdezVdB8w&oe=6A24412F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-wI0zLut5sQ7kNvwGlWQCZ&_nc_oc=Ado54y4HcxNdfbLnqxmYNdy6oWOubMejE30_mfMOSsOR7Ggr5wWoDQFTgR-KS4Brd2Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sJjLm7Jw4tXAYq2KnnZ6KKeXeROQBR9MjTrDGc5o-6g&oe=6A242B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjxoGnoQTGsQ7kNvwGSRcu6&_nc_oc=AdqzJw5tdT3f-0-XpcjzuBqy3E37dmXt8sBaqPtb3jhvF2xpDiJWlW4j8XtaSJ3kOo0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KgTTPKITPkKWnvXX6nW2EwG1nIAtMRE3P3kD_m6FWZg&oe=6A241C12"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
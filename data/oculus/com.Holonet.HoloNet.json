a&_nc_ohc=h3R2-Fjg_gAQ7kNvwEhAB_6&_nc_oc=AdrkZMJEoCscrcCA9kAVXuhxE1j9KPDAgaN9KwI-uwvgCEkBw87jhHHTo3Ft3XxvVtc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBM_8G-1ELkRkxpzaqu5pRoj1aagTFZW2XHpT89pCT5w&oe=6ADF7A2A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGfZ9NEAoZ8Q7kNvwHPHZg2&_nc_oc=AdqapjlUBFIIti_S7ROFgt9Xj6pRAwzsJN-k9a9zWkRzzinRzxxWkdRJN9XtQFIFcBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwHzNX3vQZgDpJFow75OKlLqE4F8ok3VGjxMuiaCyw8w&oe=6ADF5B4A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzeWSuyam9IQ7kNvwFbkRYs&_nc_oc=AdocxTH1V4tLRuXQxmFmJg-U3G3i1-l-bZUttISUOHjllN-7cu0pxVV3XCUWFB-GIVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXIo9nmNjqLE68YEREQsgPCY-m5-Wa5Dt_8iS3s2mbOg&oe=6ADF762F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwfM5-ngo5IQ7kNvwEYlQm2&_nc_oc=Adrj5I8p5qJx0TDYhly7e0qrpgznOYtLlL2QvN6vByfInadgaQn3sXAEC-uWYJ4FFL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTwW6728CC8XiPKayLk4mLdm2xOEmOp171goYAWL32zg&oe=6ADF601B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-sxCrbJHiQQ7kNvwFVO_KS&_nc_oc=Adrc-6H_kBmDHacmhlwcfDaeNZVTU3w5MOA0uh306rK7cO-LgFUJAtZdfGbN3fgS-uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPNw8xq6lX1ry7Bv9EYiplGzVBDA-V8AwnzV1SIIqOWA&oe=6ADF5112"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
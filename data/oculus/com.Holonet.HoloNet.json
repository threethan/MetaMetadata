a&_nc_ohc=YFBVg6JrNPMQ7kNvwEkv7JL&_nc_oc=AdoEa7Qp8_V3j_m46qHx4IadQxnl3S6PkErNgdRnVYrSycSSMjVgFSj0HXLbjKiNv_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA7qlhNJOz0nZepLFJD9ipWd5XX6LCxCJXWjgiJ3rMOg&oe=6A4B99EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZuUbj6Uow8Q7kNvwEiXlOz&_nc_oc=Adokin3MBPNkaB7z6mV_TEInGkbNNI3gLOkiiUQvujuJ07Pz3cSBaVHYt9bYlOPc804&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBocTX5g9aAk9p-Uz63BwZpHCcCxRlci99vGiGoQpUe8A&oe=6A4BB34A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrraFA9LVlAQ7kNvwEDZgrH&_nc_oc=AdrIJ1VdGStO20rPGnZJpcMMiacZw4GjJ4dX_2hAkH0D1rMU1bZrCezYEuzv_aOxC3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgs-GqQ7tRBi7H7utoFMvfqsu2p_OyZqybgDMdEmzsLQ&oe=6A4BCE2F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqcdMqMAuXAQ7kNvwGTLK25&_nc_oc=Adr7z7IC7ZJliSHO9Fj7HOUafo8rqtQMgBht_PhYr9PLfOkxf6HIhG6EFGLxty5oxSs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgTXpFay1aqBWbjgHxfGD8WdNaNKrT4qNQNvMUMpznqg&oe=6A4BB81B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keuwLSOYClMQ7kNvwFCAy44&_nc_oc=AdoC6erz2ENyjp63jMNe3VQYMlq6TiYRM-OHglwQwNBObfmP5bZ6LOWlTraC8ZCEQR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoq93H0bXpaJaTYW1Jd2MRUzxFLcKaTEFMM0_2Vqw5hg&oe=6A4BA912"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
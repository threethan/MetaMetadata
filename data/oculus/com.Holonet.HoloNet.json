a&_nc_ohc=lVfAdhAFIxkQ7kNvwHtFikU&_nc_oc=AdqqisrjRH4VwX1v-FHWu5MPnKmgEvfVxsh_xqobgGcazyZj8bwH59MfHa18_YbszVQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsIAk0hnpnl2IvXjh4DCP-96hHeslNzMyW9MhJf48cZA&oe=6AC7BF2A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ST-jWiA_toQ7kNvwHmljVV&_nc_oc=AdqjLEnL_cIx06kZO87c_O_sUc_bZhtJTdwnGhk6BP7hvWEBvEe-X-BFLYx9bRZesjY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo8Gazbk8luTzsnYSvdq4Q3EY3EJw9nZVwAiJ5PRbNEQ&oe=6AC7A04A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZKR2jwLyeEQ7kNvwFPAf4Q&_nc_oc=AdqqeZepUkq7B9VR4ZaVfw87w2CcLkwst13amY7nZaJ2bcm5gEjM6DF0dDbK1YmAdQI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFWg5VG8Zixyz4EPf8xTZAzEMDmuBnnIj75P0HzClN_Q&oe=6AC7BB2F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfykCvvHWsMQ7kNvwGaddeh&_nc_oc=Adof0QcScNYozpQlu20UorlFghTOzGpcph1agdjpbXLT8faNFJfHi76whVGune81q1I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtfU2Pon0zH4A3506xCm5cz6zzVpXNfT5EwGEKDagkpw&oe=6AC7A51B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pqARnV7S8sQ7kNvwFMl1gY&_nc_oc=AdoK3iZY4uWRg6arhPvM-WnuljGgPdXgjzHEyDrxyO82-_zME6Ov4mENhYxOls_IumY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtReIKD5ERaEdzxKmvxehPcOWq7At0_ibj5ftUiDLDTw&oe=6AC79612"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
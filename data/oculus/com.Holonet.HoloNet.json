a&_nc_ohc=RmFNI5GGeWEQ7kNvwEvo9fG&_nc_oc=AdrUUdrlTL9Fm70SAMMpViHHSbeF5M-TaR5OZHY0bR7XBkfGiiQzTu7nK_XymUHVfAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCX_hbOXzdlUB9zAZtildiLbOwadFvip1mat4ktQwzhg&oe=6A65F7EA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b17MYUngLCEQ7kNvwEwRHfs&_nc_oc=AdqC0A6V5AjsC6Z53ltphHqzqQY3KPblSUfge6oteiYuKViY44TFsVbM6zy_DEXKVME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaOLByfXN5Nt3jmoghDfVX8_72irbrCy5eGXC5Arillw&oe=6A66114A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUGFy9HLVpoQ7kNvwHREkC_&_nc_oc=Adp8E87CXUcE8AbJtfQ30CU6Loxya5Qb4rdj2dLHozs5QMXOVhJ-gH503eTymlOta8w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxSl1sk-1B3B_JNa2jSB5LeYYcpXYAb1S5-X5Tvy0b6w&oe=6A65F3EF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDXSJpIuw_IQ7kNvwGxYrSb&_nc_oc=AdropJXfepGEKgNzOMQ23iMJLhf0JUpOkEYU8dyQOSc9lWo3a3iitjzbTYvXzu_KSVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuIcUFxrwkdCVNS8oWaXLztPMzga1sr00dZVNRAZuwKg&oe=6A66161B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU-2eoreldAQ7kNvwE8hGXL&_nc_oc=AdpbwyHm779lr2jfa7M0upwbbvQJ17sEpDKq6ve1xSl8V9B6KBFHiTKqug1GavgqKHM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByMrXAGVOhuoE-bxYnuhYWviiyDJ_weBOCgRJcD85-SA&oe=6A660712"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
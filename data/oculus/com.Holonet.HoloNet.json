a&_nc_ohc=WI3-AMi3hdwQ7kNvwHeveYw&_nc_oc=Ado_Pxb6XsDt5OxLkwQROE3zv09WOxnpZqF9dHvtS4UcUrzS0b_D6wmu898t0cTwkTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVv_zcYY_vbqsOsk0DV93Sb2_hRnGod7LLIg3fQU7q6A&oe=6AAC0FAA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWZxeoudqxEQ7kNvwHzVoQL&_nc_oc=AdptLgfcLdMSJxtqXVpuOrWvw68lBb5VXswc20nN7jsdl7lsqOf3s7clwvUxVqjuWUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBqrLzb-QSQkMLAM86mDHINOol3e3jrjLHRIoDJ272vw&oe=6AABF0CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLyKnQNxS00Q7kNvwFzwE3L&_nc_oc=AdoPTbvESNExEXxG7Jr7le_11j6o6GXch7qchEGJRyngHHK0ciLnEQ7u-q0O2ZC503k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5f8pOPYGIfjY5R6gonL8Es4lxjK4zBqtuaTvK3p2XlA&oe=6AAC0BAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqfdLHuy0j4Q7kNvwEoqEzP&_nc_oc=AdqM603hix27HWQIl3urfOSyeQoapnSZPSD0CBzWvjHyKFk61l2CXVlxUQjyiXylPxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw6wqYlyPSR45KWVUqq6Ma5F3rSVwHn1eKRKy1XQmAbQ&oe=6AABF59B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l-Cnm00bS0Q7kNvwF5A1KG&_nc_oc=AdrjK0FTrk-Ha55m3ijPUeapLt_V1MbJJHEwzbEAJBw6nNehjkzclwNkn2h1Rrp74Fs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzrsC6ZW2h70ar6yYB_9laOa9v4VyqQuP6tKmoUwEplw&oe=6AABE692"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
a&_nc_ohc=htIVf4csMVEQ7kNvwFWmwzr&_nc_oc=AdpbW-OKLBAv4Hey69pFWl4j1ENMH41Z9kPvCYooWXYzr-Jau8ImEx1eirnR8z0-IJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi86_4YKke6Lss3UZJ9mF7xqhIwOnwHP9COOP0A3KUoQ&oe=6A98492A"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dJWeznYjGkQ7kNvwEVyu1k&_nc_oc=AdolOniGPdPZb2vSHSOSWGZyrfCtVZSG70YZSRrhSU3kRFq-BCiguMBqwHjbJc06ucs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIupiwzgmPQd0NMxCdZnbJSDPZiTCxJ62V6zUBsk-iLow&oe=6A98628A"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_XK9E3QdU8Q7kNvwGLG7QR&_nc_oc=Adou3nV19lcgUg4nCIWUBui8y2H6ilk2ranDBDaEkTNJni2a_STCDMK1jaQmpEzL7Ok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg5Z16bay9t7f8q4ZnvSpOXpV9mJQzvetaAXUHby05Gg&oe=6A98452F"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U-rEDS00c8Q7kNvwF6jUY_&_nc_oc=Adq7S4Kujv5Eat6KSuxK1vgbrxVXATZOPNttktK_8qpi8DlikwP9MA4lUHBGxsk4lRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa3FNWV5jQ2B2ic4GtkvQUvlF5UF5wt92N1C03Qmp7Tg&oe=6A98675B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cXEJkupEhQQ7kNvwEhgccG&_nc_oc=AdpCVmIHFups4KHkhf0_hXcR7O9S4rcBI40maWZQYwzX6o4HLUPbXjz72BQU3hO_Tzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPkniBUulr6IfVG76IRWbNj0j556fYEOV1zFLRAtJ-Yw&oe=6A985852"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
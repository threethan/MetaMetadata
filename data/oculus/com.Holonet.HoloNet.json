a&_nc_ohc=JlGQ0gIILNUQ7kNvwHeTgzL&_nc_oc=Adrftill-z2ZQA-Q-mAaZGVuKckZWGosvTxHajH51Trb0IW9Z-1z88D0GsBxsYB1BH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjZPWLrUfSLFiPBw_TuC3mCp--ObKBKib_S2tIVlCr0Q&oe=6AF5E3AA"}, {"file_name": "Auditorium_Screenshot.png", "id": "894432532766544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_894432536099877_2605537956162452026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYPSw_NnH1UQ7kNvwFNs5Ej&_nc_oc=AdpwOzPHrLNAOPy6iWV4REj502SYBRoKwZHMqgQrz5p_f0YePY0CChrYu8wCooRTtec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe-ZaKeNvlvGnsyM1onQ3ehAwzsYuedovYgAUpiUUyww&oe=6AF5C4CA"}, {"file_name": "timeforum.png", "id": "1164582165022506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_1164582168355839_5219627423614381217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYUiq6hJVDkQ7kNvwFfoZV1&_nc_oc=Adrmx9TfWczwEuPgKsiZYD8rwI7fXu2g9SrP8BSUSKERzcy-a1kXGifQ-5puKPHquDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Bg2KK2ArIy8dLvn_4iJVsm8gFvdyzr4I280uU1sP3g&oe=6AF5DFAF"}, {"file_name": "breeze.png", "id": "647613987666491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_647613990999824_6991856521777887069_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1-XPXRwTvcQ7kNvwHf6wel&_nc_oc=AdqKZu4Qx6brIVGIWwM0wCgtQ9OS4JH7TPKXcOQ7Vg103P55h0Cyv_e2vM9neaRS8_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8MD8AhC-N4uueI5cjij08Z6SZzKyv1-YpsEV17WsOFg&oe=6AF5C99B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Holonet.png", "id": "1154923896432940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391769_1154923906432939_5113825261925433410_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8yeGsHL2AYQ7kNvwE6CTbg&_nc_oc=Adpe9Bq5zLHGDNtEdUmFBJR0I-LgHyFS7ykjrFD2rAsx1SpLF4QoE9tMxvR7WDz8CME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDYF4C3tzXtSkD--RCqv7z1nDkVdkmQ_yrZOMzHq89zw&oe=6AF5F2D2"}, "display_name": "Holonet", "keywords": ["collaboration", "metaverse", "games", "hologram"], "long_description": "Work, play, and share immersive experiences with others.\n\nYou can appear as a standard avatar, or take it to the next level by connecting your headset to your laptop (download the desktop app at www.holonet.world) and stepping into the space as a real-time hologram.\n\nWhether you want to hold a meeting, take the stage, explore hidden tourist destinations, or just chill in a cool setting and play some games in good company\u2014we got you covered.\n\nExplore virtual worlds as a hologram or an avatar and try out our:\nHigh-end meeting rooms with casting & file-sharing\nAn auditorium for talks and performances\nSite-seeing tour on the Adriatic coast\nEscape room set in ancient Roman times\nFun game central\nChill hangout spots\n\n\u2026and more worlds coming soon.\n", "short_description": "Become an avatar or a hologram and explore virtual worlds designed for work, play, and immersive experiences.\nCollaborate, interact, hang out and play games with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holonet.world/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonet", "support_website_url": null, "website_url": "https://holonet.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
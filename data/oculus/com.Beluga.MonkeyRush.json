98303433_4296923911508061160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWVcd_oHj_0Q7kNvwEF4dz2&_nc_oc=Adruh-sMpGER6Q9zBlyJY3RHPeoXgLRwPeQQlj_xQIkhLC2AMDH6lsX8-Gm_EZk3jh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHxxIqQ_SvUnVloPu6RoaBaPPyGW9y_Xim9Mjohc4Erw&oe=6B06F19C"}, {"file_name": "2023-03-21_19-57-02.png", "id": "232674785924918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984463_232674789258251_4733865034867576966_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEAuOrkkOZUQ7kNvwHf0o06&_nc_oc=AdovuB1bJuBaxzPbxkAiR_0nS0lDPkqBpA_rKiTG28vgJtps1-bQIdHRJVHx3G-2aZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Dn4ly1Ngl2K-DW8xd92hZwz8vpuhZEuz2SD6JGlx4A&oe=6B06F39B"}, {"file_name": "566.png", "id": "724648312629394", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031588_724648315962727_8458282529807701185_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8GHCOUnX4UQ7kNvwE8RZ1V&_nc_oc=AdqqvK2QuwldgH17bm8kIJxkTqJ_XXb1FU0XHMZLNvfx2PefkHOdRhmW3ud9myXc8UU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKWgdnUyrhcvqaF335A7dkSZGiVNfOLs6co92-DW-IgA&oe=6B07205F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MonkeyRush", "keywords": [], "long_description": "You play as a monkey, you just have to have fun, make yourself a set of things in the store and be the most beautiful monkey or play different modes (There will be more and more of them in different updates.) In our game you can find friends and play with them, and talk to them using voice. I hope you enjoy my game>.", "short_description": "This is a game where you play as a monkey). Where you can have the most fun with friends or find friends in the game Monkey Rush. I hope you enjoy my game."}, {"images": {"nodes": []}, "id": "538234485146619", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Rush", "keywords": [], "long_description": "\u0412\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443, \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f, \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0435\u0431\u0435 \u0441\u0435\u0442 \u0438\u0437 \u0432\u0435\u0449\u0435\u0439 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0438 \u0431\u044b\u0442\u044c \u0441\u0430\u043c\u043e\u0439 \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0439 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u043e\u0439 \u0438\u043b\u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0440\u0430\u0437\u043d\u044b\u0435 \u0440\u0435\u0436\u0438\u043c\u044b( \u0418\u0445 \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u0445.) \u0412 \u043d\u0430\u0448\u0435\u0439 \u0438\u0433\u0440\u0435 \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438, \u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e voice. \u043d\u0430\u0434\u0435\u044e\u0441\u044c \u0432\u0430\u043c \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u043c\u043e\u044f \u0438\u0433\u0440\u0430>.", "short_description": "\u042d\u0442\u043e \u0438\u0433\u0440\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443). \u0413\u0434\u0435 \u0432\u044b \u0441\u043c\u043e\u
0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLIBTsyqthAQ7kNvwHCQBRp&_nc_oc=AdppDeKhu5PDsAqd9RtP4csatBHy67SMZElWDmdaVXcAXEyg-IUA3L5gm1mT-HKGhwg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0u8WNmJ2P-WBwvPn9_UVPgI0oeWMpFIhXcjkAQFPqrQ&oe=6A8D650E"}, {"file_name": "2.png", "id": "3386068294970100", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974528_3386068298303433_4296923911508061160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58CylQ0L-hIQ7kNvwGyhYXS&_nc_oc=AdpKaoHxqiuOI85IpW2qyJU4TDH6gr0D9wJV2cCukRKZEb6yY9ZhGtF6WtDEuW-GFcM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKDZZsTHLmtl3GAb6l4i4kDp-KNFn2XN77zWe1zsXHgQ&oe=6A8D6F5C"}, {"file_name": "2023-03-21_19-57-02.png", "id": "232674785924918", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984463_232674789258251_4733865034867576966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tlj0CJQ_AUQ7kNvwH8G2z8&_nc_oc=AdrmLs5Dq91mgAScOXv8CdbNzaJzPX4FG5DLlQ56wrtiwt7-TRK8ZoEtze6UDJqp3f8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn3SD-nglbWmEHP4OAuMdam7qNjolA74yV3genPZ8JFw&oe=6A8D715B"}, {"file_name": "566.png", "id": "724648312629394", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031588_724648315962727_8458282529807701185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta4oS6q-DZkQ7kNvwGG35qJ&_nc_oc=AdqO0EiiT70DkcTSWnNcq4DrWyMLIKZS_XjalHp60EzM2daahFNmgGgcUiKEHMDKVVA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy3MciiukqhLkvj9JGlY95Om1Djz5GZM2t2d_8FtdF8A&oe=6A8D65DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MonkeyRush", "keywords": [], "long_description": "You play as a monkey, you just have to have fun, make yourself a set of things in the store and be the most beautiful monkey or play different modes (There will be more and more of them in different updates.) In our game you can find friends and play with them, and talk to them using voice. I hope you enjoy my game>.", "short_description": "This is a game where you play as a monkey). Where you can have the most fun with friends or find friends in the game Monkey Rush. I hope you enjoy my game."}, {"images": {"nodes": []}, "id": "538234485146619", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Rush", "keywords": [], "long_description": "\u0412\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443, \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f, \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0435\u0431\u0435 \u0441\u0435\u0442 \u0438\u0437 \u0432\u0435\u0449\u0435\u0439 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0438 \u0431\u044b\u0442\u044c \u0441\u0430\u043c\u043e\u0439 \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0439 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u043e\u0439 \u0438\u043b\u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0440\u0430\u0437\u043d\u044b\u0435 \u0440\u0435\u0436\u0438\u043c\u044b( \u0418\u0445 \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u0445.) \u0412 \u043d\u0430\u0448\u0435\u0439 \u0438\u0433\u0440\u0435 \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438, \u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e voice. \u043d\u0430\u0434\u0435\u044e\u0441\u044c \u0432\u0430\u043c \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u043c\u043e\u044f \u0438\u0433\u0440\u0430>.", "short_description": "\u042d\u0442\u043e \u0438\u0433\u0440\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443). \u0413\u0434\u0435 \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0432\u0435\u0441\u0435\u043b\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0432\u0440\u0435\u043c\u044f \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u0438\u043b\u0438 \u043d\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0432 \u0438\u0433\u0440\u0435 Monkey Rush. \u042f \u043d\u0430\u0434\u0435\u044e\u0441\u044c, \u0432\u0430\u043c \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u043c\u043e\u044f \u0438\u0433\u0440\u0430."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkeyrushprivacy/", "developer_terms_of_service_url": null, "publisher_name": "BelugaTag", "support_website_url": null, "website_url": "http://monkeyrush.ulcraft.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "5768035296638236"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75282159_120055227687256_256908963088112458_n.png?stp=dst-png_s360x360&_nc
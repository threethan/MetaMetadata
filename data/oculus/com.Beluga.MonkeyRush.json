98303433_4296923911508061160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6Q4PSlZPZIQ7kNvwHUiQ_E&_nc_oc=AdrKsHL9VZEZEqWEIbmAuWn7bHTriJ1yUw86c1dNJr9z4p6Gw_OdfvhO0R0VDjxVrRk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbC612E29lJlT2RjjHJGOxu320Lwzh-ARfK_QKJJZViQ&oe=6AFC659C"}, {"file_name": "2023-03-21_19-57-02.png", "id": "232674785924918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984463_232674789258251_4733865034867576966_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Lml5rRw_XoQ7kNvwFu-jU1&_nc_oc=Adrr7YdrkM50jq5ZPvm1IEa_w96hO7tW6EvwHZl-y9M1w2YYZmvjuEBfDDs7TkQDq1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMrN_4ihWaW9UhDaJZ9Yy0YIFG_j90aKPgpCPjT7UN5w&oe=6AFC679B"}, {"file_name": "566.png", "id": "724648312629394", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031588_724648315962727_8458282529807701185_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FxExdrItHoQ7kNvwGb2OEB&_nc_oc=AdpiKoFVcfatAX9kY7SKIyLBDMSHXa4B74JWcMHm43bZ5vmKeXgPwJeK3K5mRcz9Wm4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAAB7GKE5CviJ_vRvkcjUIKkf_Z2pSAo08GU9wqIGJzg&oe=6AFC945F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MonkeyRush", "keywords": [], "long_description": "You play as a monkey, you just have to have fun, make yourself a set of things in the store and be the most beautiful monkey or play different modes (There will be more and more of them in different updates.) In our game you can find friends and play with them, and talk to them using voice. I hope you enjoy my game>.", "short_description": "This is a game where you play as a monkey). Where you can have the most fun with friends or find friends in the game Monkey Rush. I hope you enjoy my game."}, {"images": {"nodes": []}, "id": "538234485146619", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Rush", "keywords": [], "long_description": "\u0412\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443, \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f, \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0435\u0431\u0435 \u0441\u0435\u0442 \u0438\u0437 \u0432\u0435\u0449\u0435\u0439 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0438 \u0431\u044b\u0442\u044c \u0441\u0430\u043c\u043e\u0439 \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0439 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u043e\u0439 \u0438\u043b\u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0440\u0430\u0437\u043d\u044b\u0435 \u0440\u0435\u0436\u0438\u043c\u044b( \u0418\u0445 \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u0445.) \u0412 \u043d\u0430\u0448\u0435\u0439 \u0438\u0433\u0440\u0435 \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438, \u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e voice. \u043d\u0430\u0434\u0435\u044e\u0441\u044c \u0432\u0430\u043c \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u043c\u043e\u044f \u0438\u0433\u0440\u0430>.", "short_description": "\u042d\u0442\u043e \u0438\u0433\u0440\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443). \u0413\u0434\u0435 \u0432\u044b \u0441\u043c\u043e\u
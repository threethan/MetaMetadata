8251_4733865034867576966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kqo2URG4fEgQ7kNvwFPZkQQ&_nc_oc=Adn9RF0_neh5v_zn1nc5JMzQW_B2xAA8yqRYrD3OQmi4-bANaf37oDYjsCNlbiX0vnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuWpAG8V-S4pNMjF-eTOy51WnPt4lerIaEfe6mkSupZJQ&oe=699C671B"}, {"file_name": "566.png", "id": "724648312629394", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031588_724648315962727_8458282529807701185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-sETyfeoS8Q7kNvwHmZ8fv&_nc_oc=Adlo1hfzLVjL5UpCeRyDKg4NXmbpGqxLPPQXYtfmSuGgqeiN9sSgNWxPt8Q_0OOOrkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvroYdyjkyQHhCMB0rluJh0XmO9NUzHlIu3OW_v0-5Stw&oe=699C5B9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "111111111111.png", "id": "4866259026832086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195913_4866259030165419_751740270347823471_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bepp4ASJyJkQ7kNvwF0RUqA&_nc_oc=Adl5XKKuWj81Iw_Oh7NybtDfL9jExQgzvHWG2P-aWJC8vozpVHiCALsY7YpWWVaD8Bw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvii8-Y1SFbeXAS__gTFCHUOeKUf2fuXGXhVb29HAYjFg&oe=699C6514"}, "display_name": "MonkeyRush", "keywords": [], "long_description": "You play as a monkey, you just have to have fun, make yourself a set of things in the store and be the most beautiful monkey or play different modes (There will be more and more of them in different updates.) In our game you can find friends and play with them, and talk to them using voice. I hope you enjoy my game>.", "short_description": "This is a game where you play as a monkey). Where you can have the most fun with friends or find friends in the game Monkey Rush. I hope you enjoy my game."}, {"images": {"nodes": []}, "id": "538234485146619", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Rush", "keywords": [], "long_description": "\u0412\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443, \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f, \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0435\u0431\u0435 \u0441\u0435\u0442 \u0438\u0437 \u0432\u0435\u0449\u0435\u0439 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0438 \u0431\u044b\u0442\u044c \u0441\u0430\u043c\u043e\u0439 \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0439 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u043e\u0439 \u0438\u043b\u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0440\u0430\u0437\u043d\u044b\u0435 \u0440\u0435\u0436\u0438\u043c\u044b( \u0418\u0445 \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u0445.) \u0412 \u043d\u0430\u0448\u0435\u0439 \u0438\u0433\u0440\u0435 \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438, \u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e voice. \u043d\u0430\u0434\u0435\u044e\u0441\u044c \u0432\u0430\u043c \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u043c\u043e\u044f \u0438\u0433\u0440\u0430>.", "short_description": "\u042d\u0442\u043e \u0438\u0433\u0440\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0443). \u0413\u0434\u0435 \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0432\u0435\u0441\u0435\u043b\u043e \u043f
w8TTdYB2DF8j0jzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwQh2TEW_ozQgMIFounaeIlmafVxjn9gn8Y2o5ZH2QIg&oe=69BE9563"}, {"file_name": "screenshoot5.png", "id": "1246956520465329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308699_1246956523798662_1159875501647006787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVt30Go5USQQ7kNvwEUzgxF&_nc_oc=Adn4qr2JkainVVFEMd3PW_iJ-z0Pk_SfMYZLn2aMmqB_FO0tcBG0EVUxKmODMMDA4Uk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTnn_QI7gulZeVvproMS6bKxPvLw1wldZKYoh6UAFFOA&oe=69BE896D"}, {"file_name": "screenshoot2.png", "id": "942985934511992", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303440_942985937845325_3841436471541970257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6d0UWNd-IEQ7kNvwHgp60m&_nc_oc=AdnKjFVIZNe8tCmkkcplkA5LQeXHq-w3J81c2zrbPEk--4bYdsK75DU9XON4mVTKKv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0_h1wRvzIGoan1ueN1oDQSjSL-sDclWIonesd8RxHwA&oe=69BEADDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intro to Construction", "keywords": ["Construction", "Workforce", "Training", "Education", "CTE"], "long_description": "The Intro to Construction VR experience simulates conditions of a residential construction work site. In guided mode, the player is introduced to basic residential construction concepts like safety, trade math, tools, materials and employability. In the more advanced practice mode, they are challenged to build a structure using the concepts learned during guided mode. \n\nXennial built this application in partnership with the Home Builders Institute (HBI) and the Boys and Girls Club of Martin County. HBI is the nation\u2019s leading educational resource for career technical education in the building industry, while the Boys and Girls Club provides workforce development opportunities for children in underserved communities. Intro to Construction VR aims to provide an immersive resource for workforce development.  ", "short_description": "The Intro to Construction VR experience simulates conditions of a residential construction work site.  In guided mode, the player is introduced to basic residential construction concepts like safety, trade math, tools, materials and employability. In the more advanced practice mode, they are challenged to build a structure using the concepts learned during guided mode. "}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy/", "developer_terms_of_service_url": "https://www.xennialdigital.com/terms/", "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1062549017734874"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1491102795139317"}, {"status": "PUBLISHED", "id": "1489091052449664"}, {"status": "PUBLISHED", "id": "1418295009350306"}]}, "baseline_offer": {"id": "1491102795139317"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757343480, "status": "PUBLISHED", "id": "1491102795139317"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9199439033492013", "version": "1.0.362"}, "id": "639787023888382", "channel_name": "LIVE"}]}, "is_fo
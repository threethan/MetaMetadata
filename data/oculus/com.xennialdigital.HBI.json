}, {"file_name": "screenshoot3.png", "id": "1229991542065419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300327_1229991545398752_3034987523092930153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bugOImE5aEMQ7kNvwFi7W8n&_nc_oc=AdqqfqItaeqP_oNSCA19HK_cLf8s1tr-JAnzzN548AGTVw1OvjEnaW62nCvltluHRRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJdOlKe-iHIWomG09dbPeRL1UC6BBrZB127SmRGcqpdQ&oe=6B0EFC23"}, {"file_name": "screenshoot5.png", "id": "1246956520465329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308699_1246956523798662_1159875501647006787_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KclRYfQGRHoQ7kNvwHGIW9c&_nc_oc=AdrvzRueBr6dO7Ezl5DpMpwm6nKscsqqk2xU7AcAKYICrBI8jjuGNg3Y4nhvgtpDurQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdnHbRqQDPtHsm1zIidd2iJRKgghrCvlvXxLdPQfd1vA&oe=6B0EF02D"}, {"file_name": "screenshoot2.png", "id": "942985934511992", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303440_942985937845325_3841436471541970257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmHdLN3yTxIQ7kNvwFKLNSD&_nc_oc=AdrS2Qba0QOH51GLObIWOZ_MI0hCGmeQluOWjlaA-IGVkFtIEY7xq9gLdPRjHli_VF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlwRxqA-HSvjOGYhstVQ1N1A1Rb-gfemBqQKv1H8TTpA&oe=6B0F149E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intro to Construction", "keywords": ["Construction", "Workforce", "Training", "Education", "CTE"], "long_description": "The Intro to Construction VR experience simulates conditions of a residential construction work site. In guided mode, the player is introduced to basic residential construction concepts like safety, trade math, tools, materials and employability. In the more advanced practice mode, they are challenged to build a structure using the concepts learned during guided mode. \n\nXennial built this application in partnership with the Home Builders Institute (HBI) and the Boys and Girls Club of Martin County. HBI is the nation\u2019s leading educational resource for career technical education in the building industry, while the Boys and Girls Club provides workforce development opportunities for children in underserved communities. Intro to Construction VR aims to provide an immersive resource for workforce development.  ", "short_description": "The Intro to Construction VR experience simulates conditions of a residential construction work site.  In guided mode, the player is introduced to basic residential construction concepts like safety, trade math, tools, materials and employability. In the more advanced practice mode, they are challenged to build a structure using the concepts learned during guided mode. "}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy/", "developer_terms_of_service_url": "https://www.xennialdigital.com/terms/", "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1062549017734874"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "b
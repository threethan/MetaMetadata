JktvryOQ16I1k2_qXfEiT5Jqkg&oe=69F0AE63"}, {"file_name": "screenshoot5.png", "id": "1246956520465329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308699_1246956523798662_1159875501647006787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2pnjeVn0J8Q7kNvwH6Oklw&_nc_oc=Adp5ILM7DGpRUgOEga8uR4uDajeAlgQL5_wRFhVfc7KktialPttegkMXHr3tGWjyHKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af00kmY5Wo0HZHMkYXUBqEzV43BMTS3mmFF6VJfRoNqILA&oe=69F0A26D"}, {"file_name": "screenshoot2.png", "id": "942985934511992", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303440_942985937845325_3841436471541970257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qx2QS3m8xkcQ7kNvwE61six&_nc_oc=AdpCQt2ryJJS8KEMeOxYd14zspPjnKxGecmxrr6xpLi0wcwRjFcAAhtv62ootzmVMfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1-Vkh3ecOBqbxk4apAu8M5tx3NWRdHqDG_gcHuuNB3hA&oe=69F0C6DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intro to Construction", "keywords": ["Construction", "Workforce", "Training", "Education", "CTE"], "long_description": "The Intro to Construction VR experience simulates conditions of a residential construction work site. In guided mode, the player is introduced to basic residential construction concepts like safety, trade math, tools, materials and employability. In the more advanced practice mode, they are challenged to build a structure using the concepts learned during guided mode. \n\nXennial built this application in partnership with the Home Builders Institute (HBI) and the Boys and Girls Club of Martin County. HBI is the nation\u2019s leading educational resource for career technical education in the building industry, while the Boys and Girls Club provides workforce development opportunities for children in underserved communities. Intro to Construction VR aims to provide an immersive resource for workforce development.  ", "short_description": "The Intro to Construction VR experience simulates conditions of a residential construction work site.  In guided mode, the player is introduced to basic residential construction concepts like safety, trade math, tools, materials and employability. In the more advanced practice mode, they are challenged to build a structure using the concepts learned during guided mode. "}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy/", "developer_terms_of_service_url": "https://www.xennialdigital.com/terms/", "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1062549017734874"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9199439033492013", "version": "1.0.362"}, "id": "639787023888382", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4682176931884935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9199439033492013"}, "release_status": "RELEASED"}, "binary_release_channels
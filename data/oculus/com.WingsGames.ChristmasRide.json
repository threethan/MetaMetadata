dn.com&_nc_ss=8&oh=00_AfwS9k_FIi-0ZRbCk4VtgcUmcKigd-uqoxtGb_PKWEzOKQ&oe=69B3EF0A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGR2xuGmen8Q7kNvwE6ewr5&_nc_oc=AdkLvMAhdzY6DXyZKz3oQQeJUdkHvVtdylx1GfsPkCONxNWECIBKn-J2jH8FW3QKGYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6QNlTxgF94bkqUJ6yzlnOSoKfpt0kSBya8xCaJIZH9g&oe=69B40A29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gerCUvQn5mwQ7kNvwGErSws&_nc_oc=Adk5SH0DnbRwzNm7ozM7phZ-9oTT4J0oUAER_9WE9n4kv_RW21cHc-UH9fWeI-jJyGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQSBSkCp0yGOPhFrXE6uX70pe6Qi5lCD0kBl0n4hKpvg&oe=69B3FB8D"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, 
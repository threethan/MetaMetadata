kNvwHVfz-T&_nc_oc=AdpkZCAsv3TPe3k2XSpmAeY0dQ1PWO4VsWZlkTADfNW22GMWO1msEad-oJwNI-NFVyA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaQ9TDBO9CeH7ek_rE2K_CxhL9r37s36OaGKgkNiRY1w&oe=6A8EC80A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i13F5nAWSUEQ7kNvwE7IIZp&_nc_oc=Adr93Va-ItnkcUO0SEa_shcXe0Gher9zBb1WP3k_sMpmuilfKmtMMisLFSZBq3MN__c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfLz22SboNJiFyhwc2ssE5YX214q3ODObaO9plSbM1cQ&oe=6A8EE329"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1larIT6-A0Q7kNvwFL6WYl&_nc_oc=AdoQkUNXwslkwbxvkh7uLvTFlh1q2MIYyVfHlaiLaJaNNQ4iwe43ZIeRBCt2hw6eFEQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8wnB-78TNWomswKqKsjzc7pwjzviUdMDnYtnfBL-Saw&oe=6A8ED48D"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wingsgames.com/policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": null, "website_url": "https://www.wingsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7156065344453201"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "781957897646896"}, {"status": "PUBLISHED", "id": "1413988962529771"}]}, "baseline_offer": {"id": "781957897646896"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770067440, "status": "PUBLISHED", "id": "781957897646896"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7141293019263767", "version": "1.01"}, "id": "343069391867960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7134268863299516", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7141293019263767"}, "release_status": "RELEASED"}, "bina
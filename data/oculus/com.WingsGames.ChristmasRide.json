-25/75210393_894794079037174_4909291357598082682_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrSO-T00ZNIQ7kNvwF8txji&_nc_oc=Ado5g7NS6Qg0MHHOWBJdksyjOaCsCLpQdbbEzLGS689vd2KEO71fcXr3nQUxrjZUHqk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCCtrdI1Bvxuj96qoJEZDLjMEJPPmF_scc5EYWInAINA&oe=6B086D56"}, {"file_name": "3.png", "id": "581922950793782", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974482_581922954127115_3782516518672647732_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRDDqFaMH80Q7kNvwG6Gyy0&_nc_oc=AdoZoBAr_HJcFCaShSEjJFBfTEs6YhS7yn-vU829LffZpFlgkbUtWsicAe8th48J2Wc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhoNSB1zzdNlg0aMDXfEqnUd99HveAhdtt4oYBgxzUIw&oe=6B084A4A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8yOdlVMm7wQ7kNvwEpAjKh&_nc_oc=AdoGSh1H-u0w6TW6Gjo3KWBEDghfuV1fbxj1RcooTieOGj6P3dsmrkNfWuwjuq3VCB0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0onEhz9NckZA6ke_XNbZ8cGVUSv7gdQw7PPmuui1D9Q&oe=6B086569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-eitH_KjcMQ7kNvwGLPZtT&_nc_oc=Adpmd7Wg_LXNhR5BjajZhGrn939HMPnKLlh_AofNyHwceWoIncjI_aY2pUoMKQyoFGg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVNnIi75RhQIBIsiSr1jzpJ4XqCd5dYJvQJTudN_q-IQ&oe=6B0856CD"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wingsgames.com/policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": null, "website_url": "https://www.wingsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7156065344453201"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "781957897646896"}, {"status": "PUBLISHED", "id": "1413988962529771"}]}, "baseline_offer": {"id": "781957897646896"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
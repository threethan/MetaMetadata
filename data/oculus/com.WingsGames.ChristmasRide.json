"}, {"file_name": "1.png", "id": "894794075703841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210393_894794079037174_4909291357598082682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YFpeTzWTQsQ7kNvwGAHxBl&_nc_oc=Adk7uiOBJ02RZn83cTt4vZBM1hytrbyzGurekUveUA3Xa0E5Bj5LVJLUrBuAgmYj-Tw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftJcHHzrM7iX2cz-xeZ4mTNQ3_LhsEyN7lqo4qtn6WJqQ&oe=69A98616"}, {"file_name": "3.png", "id": "581922950793782", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974482_581922954127115_3782516518672647732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrWIoLEhIHAQ7kNvwGXMHj0&_nc_oc=AdnnHHULrV8qqmtLhDB6KY81Lrkval1I37FyBAP79bLobYf0ys5vZ1Yy7ot-L2ppXOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvItKeERNdIYBERyUT-MM3IV3IP79WwGxY3xFS-az2WBA&oe=69A9630A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CId-k8YgOAQ7kNvwHtv6V9&_nc_oc=Adm2eV16-Cp3EW558iGERDmLQGCRT3iwxkdqEVG21zp9jXbJi7vwUPAF1p3sVRFZmm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfunQ5axPnbq6ANXf1DdSQRf04mG3pDHGSEYqknngdaZ_w&oe=69A97E29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3ZctpW-ufcQ7kNvwHIMnJL&_nc_oc=AdlGCBKGA-9Eua2gY94j_hk1ohgzjEYcXF4uu0HCUJ3yMukzOMiEWuq_zfSo0LQud3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftOMt2EYKc99OipR100UWZdo46eAggKXUyY3omwEooktA&oe=69A96F8D"}, "display_name": "Christmas Ride", "keywords": ["christmas", "kids", "rollercoaster", "fun", "easy"], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wingsgames.com/#policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": "https://wingsgames.com/", "website_url": "https://www.wingsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25910627911903661"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_388529116884222_1191132712077715549_n.png?stp=dst-png_s360x360&_nc_cat=106&
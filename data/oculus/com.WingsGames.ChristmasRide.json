"}, {"file_name": "1.png", "id": "894794075703841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210393_894794079037174_4909291357598082682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7LKugsrihsQ7kNvwF3Vl-r&_nc_oc=Adm5mqO9-fPQREWwlFEzagFiGnhRgXaH-eOtavk2fUGHXn9XIRtnKxlybby4AcX3Gf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAoUzUZKxfrtuqHmTEMPFk3IVH3Ajj5oXrd3AaT0qDiw&oe=69B6B516"}, {"file_name": "3.png", "id": "581922950793782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974482_581922954127115_3782516518672647732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR119u4EfXkQ7kNvwGhYyBj&_nc_oc=AdmCs9eDU0x_q77xRzV77BCrm67_drpca7UCTtTbvfy6iE71IPhtzqKCGGc8yM6JSKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCAyFfzISg-zIcDv3770TZevjfN7oXpBMY2H7FArVpQA&oe=69B6920A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGR2xuGmen8Q7kNvwGP354j&_nc_oc=AdksqRv6F7KE_4CX0es80no6Yu98waKlhnE1ivM8T5HtYCyFBQtNlkuB6MXuV9sjklw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0BMQla9d1qFLFYeIyVHBGEzVKTAT3JDCt49Zlrc1i4Q&oe=69B6AD29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gerCUvQn5mwQ7kNvwGB4c4_&_nc_oc=AdmyvJoRFF1Q__wCn0pNVrlL6D0VcfHvluOcvCC3uczd2IjEhvhM5a5VSsTm9rfW-UQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgBf3QL67luicCPyI5N0FzIpHGzL1KJ1ucNEO0C0d9zA&oe=69B69E8D"}, "display_name": "Christmas Ride", "keywords": ["christmas", "kids", "rollercoaster", "fun", "easy"], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wingsgames.com/#policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": "https://wingsgames.com/", "website_url": "https://www.wingsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25910627911903661"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_388529116884222_1191132712077715549_n.png?stp=dst-png_s360x360&_nc_cat=106&
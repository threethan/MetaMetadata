_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhsSeO2P3tAQ7kNvwEg3gYN&_nc_oc=AdqV9gUGQ6EFsh5x_uHWjcWJLszpx4ZP94ycUfP3LaKr-0kDFjKTL0iOIMRRn-PPe4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0qOFKttO5v2LlCVL21ETZK7dGW_5JEmxL8FTdINBrZqg&oe=69F0AF29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK9saklWXqUQ7kNvwFhjFhF&_nc_oc=Adp659JYKpllj0jXKM8jQjXRLHNQ5NK8OYJ896NKIA3yKa68b1PVGU69OIoApd4YRx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3NQrlP0pZN4NzJ2JrWoRy3bJLkJaOoxrIxbLF99AZ45A&oe=69F0A08D"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wingsgames.com/policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": null, "website_url": "https://w
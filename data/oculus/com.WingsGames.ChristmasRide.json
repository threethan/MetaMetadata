-25/75210393_894794079037174_4909291357598082682_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMMGaXGh-7IQ7kNvwHpVg63&_nc_oc=AdqkXLo06oB6kx0jCZIIFc2jREEkrRzduV5rtaVhTUSzDANeD7zVDv0avBsDPSJU7QQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSxKZ-OR0FnnJuJtLFWOon97zTVlnMX_vH__IF5oUMJg&oe=6B0DB356"}, {"file_name": "3.png", "id": "581922950793782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974482_581922954127115_3782516518672647732_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgKcY9m5KrAQ7kNvwEX0Uu4&_nc_oc=AdqK1dgqWU6LgO73RhgXiZQGsLaMw3C7Iqu3zCBcl5xwy3Jl2QN-E8jLZ_o-2J1PRNM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQt4s3aathIwmrWzUXERor1BTe32GPlBw1JGPYc_iIyCA&oe=6B0DC88A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEdMiXXtMV4Q7kNvwGJg3H-&_nc_oc=AdqhlX-MeJCN1Iz_q1_YgKYPbK6CeJS1B9c1IYzCGzI_KWiiLtNMxQdkQSWbvYqaWYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdu_Eh2737vXSz33ZwAkWdPZe36wZD96otlCs6MeopmQ&oe=6B0DAB69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aWcCyFSjB0Q7kNvwHe6Kzu&_nc_oc=AdpTXOyxq1EhA1G0IOXc0iYCclh5VyJ8NogmDGcLhROGzn1UJM25qwYJSzKflJFc1SY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUXzeTYc4kz0d1N6oEDomjviU-qJWTI6RSwEBy-PgJIA&oe=6B0D9CCD"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wingsgames.com/policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": null, "website_url": "https://www.wingsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7156065344453201"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "781957897646896"}, {"status": "PUBLISHED", "id": "1413988962529771"}]}, "baseline_offer": {"id": "781957897646896"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
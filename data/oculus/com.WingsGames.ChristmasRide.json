dn.com&_nc_ss=8&oh=00_AfxnyhHWBT70wExGQL2O6oWzEL1XWLdddJ9FVvXBTAcGww&oe=69B7E38A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqMlFXWHFHEQ7kNvwG5aKTq&_nc_oc=AdkhzNWRfSe6kd9g9NN-NYMG-p3zT5GN4rfZ5Rg-ghYUyKbvCgr14d57RHZmBqbqZwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0DjvCjyhalem6ivRuy_X8x_2Mj6qSIYARScFsYYbtLA&oe=69B7FEA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-N074qiNssQ7kNvwFQXAzf&_nc_oc=Adk4j3vIZeXyNZZQBdj7JGIkF89Ad-zJJ892a11AlSlqswNfN1VrqZW5sd-FQXN-tjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfybJrUiXmdLiiin82G7ZKyq6h0JofpeLQ8r86H9r_3r4A&oe=69B7F00D"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, 
_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12me7Y-x1AUQ7kNvwFVJB4B&_nc_oc=AdmXVNegZQUlo3F7yjcXO9WhOEFLVYbfpN8tUQUkwFEXD3l9UAdVvy1BUFag8UcwQic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvALlTmKHLG4lfmwkb8uJaNmKfbrLCH9-bCpS0QtMIHGA&oe=69A2E6A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ftAR7ZZzToQ7kNvwHz6c3G&_nc_oc=Adk1VrrWBFXtSJiU7ZIaW1PtS_R1VwsL-RRy05qJJAZ02xiEBc_NlS54x_dM1JXBSPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHQ0IDQNMqd5SuhRH4OotUZk-040mFrLhPeRLMdXc7Cw&oe=69A2D80D"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wingsgames.com/policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": null, "website_url": "https://w
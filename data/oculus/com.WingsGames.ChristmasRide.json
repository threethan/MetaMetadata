p Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wingsgames.com/policy-christmasride", "developer_terms_of_service_url": null, "publisher_name": "Wings Games", "support_website_url": null, "website_url": "https://www.wingsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7156065344453201"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "781957897646896"}, {"status": "PUBLISHED", "id": "1413988962529771"}]}, "baseline_offer": {"id": "781957897646896"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770067440, "status": "PUBLISHED", "id": "781957897646896"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7141293019263767", "version": "1.01"}, "id": "343069391867960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7134268863299516", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7141293019263767"}, "release_status": "RELEASED"}, "binary_release_channels"
dn.com&_nc_ss=8&oh=00_AfvItKeERNdIYBERyUT-MM3IV3IP79WwGxY3xFS-az2WBA&oe=69A9630A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CId-k8YgOAQ7kNvwHtv6V9&_nc_oc=Adm2eV16-Cp3EW558iGERDmLQGCRT3iwxkdqEVG21zp9jXbJi7vwUPAF1p3sVRFZmm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfunQ5axPnbq6ANXf1DdSQRf04mG3pDHGSEYqknngdaZ_w&oe=69A97E29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3ZctpW-ufcQ7kNvwHIMnJL&_nc_oc=AdlGCBKGA-9Eua2gY94j_hk1ohgzjEYcXF4uu0HCUJ3yMukzOMiEWuq_zfSo0LQud3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftOMt2EYKc99OipR100UWZdo46eAggKXUyY3omwEooktA&oe=69A96F8D"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, 
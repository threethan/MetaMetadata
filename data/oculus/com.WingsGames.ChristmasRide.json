dn.com&_nc_ss=8&oh=00_AfyCAyFfzISg-zIcDv3770TZevjfN7oXpBMY2H7FArVpQA&oe=69B6920A"}, {"file_name": "2.png", "id": "348982611186927", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_348982614520260_4984398909412926887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGR2xuGmen8Q7kNvwGP354j&_nc_oc=AdksqRv6F7KE_4CX0es80no6Yu98waKlhnE1ivM8T5HtYCyFBQtNlkuB6MXuV9sjklw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0BMQla9d1qFLFYeIyVHBGEzVKTAT3JDCt49Zlrc1i4Q&oe=69B6AD29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide.png", "id": "1537180897082998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035399_1537180900416331_3308939231393192739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gerCUvQn5mwQ7kNvwGB4c4_&_nc_oc=AdmyvJoRFF1Q__wCn0pNVrlL6D0VcfHvluOcvCC3uczd2IjEhvhM5a5VSsTm9rfW-UQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgBf3QL67luicCPyI5N0FzIpHGzL1KJ1ucNEO0C0d9zA&oe=69B69E8D"}, "display_name": "Christmas Ride", "keywords": [], "long_description": "Welcome to a virtual winter wonderland in our enchanting VR game, where the magic of Christmas comes alive! Designed specifically for a younger audience, this game offers a unique blend of excitement and festive spirit, perfect for the holiday season.\n\nAs you step into Santa's boots, you'll embark on a joyful sleigh ride across the starlit skies. \n\nWith its cheerful graphics, enchanting soundtrack, and easy-to-learn gameplay, our VR Santa sleigh ride is the perfect game for young players and families looking to add a dash of festive fun to their gaming experience. So put on your VR headset and join Santa on this unforgettable holiday adventure!\"", "short_description": "Join Santa on a magical sleigh ride in our delightful VR game! Perfect for young players, this happy roller coaster adventure lets you help Santa deliver presents. Grab your controllers and soar through a festive world, spreading joy and holiday cheer!"}]}, 
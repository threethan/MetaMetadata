_DCp2Qi9IcQ7kNvwGZwnN0&_nc_oc=Adq6FmX8h_OJWf0Soj_beOSB_6w543V4_q422Tn9hA5lYHZt0qEw462i3mZSwqmYrGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEAgSzgdSlRbNSWT9V4_J26D9CCB7Qzm-F4SrAjObarQ&oe=6A8463FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ4r5EjjFGwQ7kNvwEmKNna&_nc_oc=AdrUpgkZNAMsErBBlLQyYK5eZib0dTioETSZcqKr2xD-gamUaTNpjdtc2m07KZzjD_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv2CCABotDdFoGbrTDTG5EFlDGJNg0GKiW0pVaqAQYlw&oe=6A846502"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Alx1OAEmROUQ7kNvwHzhQ-k&_nc_oc=AdqYGdevCubZTUhRZ0uIGGBIp-3tN_rCyv1uRgx9c7K5sQfcNgZjbPZWBEIZqtOEcYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPRYDSIsyT22-h1yW1kR72y_ymYVB6rVHiwVAKK0lhsQ&oe=6A843C19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV7FPWf_8vQQ7kNvwEShrs1&_nc_oc=Ado7-CaIzfBZ-S77YLIU2HyV5f6edjqgNhk6BmlXiWPoohmQADs-cp9zipcaHSB2GN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK_fOIOmd5tD_MlX1_yYz-c7tPt919_py1t1Qq0DQGMQ&oe=6A8456A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7ja6C0jcpUQ7kNvwERsqGy&_nc_oc=Adro-LW90R6maBbkMTnzh6gc6_ywgyUlPRhjoz9DSPnLozvGcLMo5UW1gv_Sp1UYJ5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgBJ49dfOdXyi6g115-Ii8Soq88HfKXO1n2PPvpMt5DA&oe=6A843FF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
chLpv4IUbEQ7kNvwHjoQZ6&_nc_oc=AdoEjX_bQ5VeU8E_pCWJuuUxVWMOPJ-Fug7LknMB7E1TY1EEdGA_34kdR9tyzwpAgK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo5zwvkzpqueabwHzQ7SP2bvmxHTM1Nh0Mg27OYjN3Dg&oe=6A54EDFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TySDXzcIA30Q7kNvwGM5scW&_nc_oc=Adq0XVMntGWlPkXcXIqf3jkJIW6dNdRjziQTCdxbI5LiXd_0piaqv7LYp7hfjeED2GU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt4wo35HwO3dfPvAdc3hQrAjj_h448jUTSBGY7c9lPZw&oe=6A54EF02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShK88vRn-REQ7kNvwHM6XN6&_nc_oc=AdrSIJ8FQJqoYkOpWP9-3BSHRD2gatYw5rnmaiYhY6BhqFT7mxDsZWmJ0J4UAcvmH9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD093hrjfQEKN6qTqg_MWVWsWo_CKhlQL9T7eV0B8jhjg&oe=6A54FE59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRGmHuMDTqcQ7kNvwGSFQ5p&_nc_oc=Adp7OVkybF6hLU_SC0hORGbCj2kXqty63Mk7nci4we0BfbdyNiiAR8PR9Yp_6fQOMEY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1gCADATDlr_4_XV1EjwipXFP9rVTThgieH9L5KO5NXw&oe=6A54E0A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jqll2GOTPIQ7kNvwGzg_p-&_nc_oc=AdoC8YC6RpuMmyfpQD09bhhMUR8jsZqZS4qvT1rSZoECeBUaE2wa11eKYFYVfRcgQ7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6u5X_llrMWavGOduNIGpOVJ2y6xqpb1AC0xnG2jnsWg&oe=6A550236"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
xr5BVJ9B0YQ7kNvwFvZNVf&_nc_oc=Adr1KVAGrQJyxQQZ-p1vlF3V2tDR9HtT48QKA2DwXEju_ATPTWj4IsksPDWxuUbtSB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb8bLOG1XTi5N-4Jluvcu_hKMCnD5YGkpIL-7PBZM_LA&oe=6A4BB37B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3YhF9hwa4cQ7kNvwFPW851&_nc_oc=Adox9ZVDjzGsU4zu5Ic8dMFLLuOm7sZcCk4IV1BKodeBl5lpZ274q51FqcIC3KAqP6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGBiUqIpF2-c175a4FYlGcCKofEGcvnwV9c6YUfKrxuQ&oe=6A4BB482"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdFRlymJpxAQ7kNvwFKXvvc&_nc_oc=AdpjfWWdZKQeV8i3mNh7tk2Bdwqp4amFWDxCXlbFVRxSGp-IoLG8xxylh07sY3OROJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHYFpoQ6sUy9MkJtrzJ9-tuMs4OFcu3kYtfEQ3X5SXRA&oe=6A4BC3D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEvbf_dd1bwQ7kNvwEfoYlN&_nc_oc=AdriA_yUEEiVeqVa_4hMZH4eql7nUUbxGFs9iiD7oKwVrvRWuowBEuTvVG4o5sW9yHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRQhPS5qStIWSf9TH0QpuWXyIeWh_rXYrEk2HzOzD2bw&oe=6A4BA625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yacd5CUuyL0Q7kNvwE_P2z6&_nc_oc=AdoXNpkxZbmlbSPpwuDIW6q6ItQDn9NkbaAf9v4SpbOE5KWng142j8V0yQ2Q-a--xfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgQq_NXZnTLfo66DKaaRNR_Vu5Jgf4sUedcjAo7TUigw&oe=6A4BC7B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
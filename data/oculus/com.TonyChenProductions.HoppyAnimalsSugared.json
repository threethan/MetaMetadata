m0dy4UhgwEwD0pzjba8dMXw91JAvxziGn5hDkw6sk_C7ODgIwV4IlHv7T8RuPnpv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2htOOPSiJI7PcqTaitzlu8Qj_cQMz9KhwpTyKhnGgMw&oe=69B6B9FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW8164CQhSgQ7kNvwF3jWkm&_nc_oc=AdlhTPoM1dUz503zqZ-5E6kSf6Fvh4iWY1m-nkLFs6Cmf4mVv9yVlE5px_qaihv5-yM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYgy2CmFGORCtqtAnGwb9EycQX-AGlpqxnSqFI5X5ocg&oe=69B6BB02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CytLmcW-jIQ7kNvwH6F2XO&_nc_oc=AdlXFQxP_8uTi4k5hgTURF0mguS_C491iAcFU5tjbYMvCuqhtK4wOp-klz3jEaRZaLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5KhaH2utwXnlSP8bGK4mTPvEh-2l4gtm1tbqdVpT0bA&oe=69B69219"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUQhurM_UHEQ7kNvwElo-3q&_nc_oc=Adk7FaqnR3aciL1rPrP6JonV9zJgx9295uuBLcFKXRsO_Pot4dOkRr4Ob7vewnm_AgM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5X0BCrnUyTo9q2-mIQCu4pHmc8Lq6awusw-lXWyWdrQ&oe=69B6ACA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aV3kC90jToQ7kNvwEs_-Rc&_nc_oc=Adlnxvmr9TuIMu_cRn8xIHOtm1PeCuJOABH2wcqi9HdA-5cT4Snt6Rah2_QTxDkdNAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoML-3Li0SiE-RoAuT5wrvrDxgJ4ddSXwMYLfcY62xZw&oe=69B695F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
h60xSLu1SEQ7kNvwF3mf6u&_nc_oc=AdoR-BnVUqysru74YFfZTcvWZFFrEBWU44AFqkKt2rC-DZSw5EgsNZ0hUjNfjwO0IaQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_03fdhrHpXgF-iRvdUiBYtrJeBz44QIq9oWQqSvHGgiA&oe=6A3003FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKnnjA-o2JYQ7kNvwFlzYRO&_nc_oc=AdpyYc1uuYIaV-eosaL7G5K9srp1Fv6loBiOCoahbthnAkAu96Woy1nntOJtoMeOKgI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93O5CVqhehow6fIam3NYbZQttoaMSlhVM98bcmjdc76A&oe=6A300502"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHsFgzfFjbAQ7kNvwGJqggM&_nc_oc=Adqrto2DHxYT121WIzMMUw2k1CDiqQ_DME8anwwB2vcXxAvd2Rb3MrEO0dImq1_AAS4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gmzd_q4y10HQEayKwwBdzB178072eV3WNyaVgpMzwjA&oe=6A301459"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq8em7G57_wQ7kNvwGqn3Eq&_nc_oc=Adr4haW0JZ_rBkpw6zDkJ_O4B63JyBNX4jZ-WscK34yfysrkypQpzOmRUVtt7KVI2is&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hmDw7sTRWoqRh4eGYsrLbVYF7rux1LRv_Cpfn_VK_pQ&oe=6A2FF6A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOH7XJ1YQJwQ7kNvwEw5zLo&_nc_oc=AdpPapdJAF2o9h93jzc-uEgkcZB6ZmzJZFnQpHjK9x241Z_wLwiqLQaLFp6mS844CA4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r_0XZR7PKvxiZKhUHJtLS9teM3ooo9EgDjjQmPaL-pA&oe=6A301836"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
l_16QMrAGZyC5XzkpX0VlAWUzh9D6Nj48eLfJ2fElU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48XjFV0tLwbOy2gUm_qHN4x28lvANStKBOKYAOom2CIw&oe=6A0325DA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH9mkb5kI7kQ7kNvwHyTdLO&_nc_oc=AdruB5EndhBLbs68eQYAq9vdSX_dSmcvVRebu5dF_3T0xybdFGIcQVqwIe8DPzySUTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jNtvhYqQl6T_8CDR9OcXzKHC-vjO_t6iiR-5rfUUPLg&oe=6A033C83"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbt3uYvHCP0Q7kNvwGes5w9&_nc_oc=AdoKBhXb5Pw_eMFIhp0Z6pCayrx5r5ScrDLkf8cW6_cKN-4GRVqNS-ptrUdK_VU9SmM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lcFd4stwUnRKjLUMMZYpMaPvBtMeI2Q3jiWOnOOdXlg&oe=6A0333DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
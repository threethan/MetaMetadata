ma8ZzUVpxaZ9JVPMg_Yt_PGef3xd_h7jU0-3XjGup4iuSvD6usES-sFZyfQcX3wI4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycDqlMQ5WNmrQcZeN2-PVrXYRUidYAPjr190bkTccZmg&oe=69B173FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSiqzrX7Ee0Q7kNvwFcLfD9&_nc_oc=Adlw2naI7qr80ZBLOtXsWVH-ji5SzyM5ZO5LxaxhJCAnNAp7bKhYLo5fTuZpb5B7DoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8Xx3ks2Nqos9IPePoCVHvNk8HKvsS0OpccjpxNSbF9g&oe=69B17502"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfKOeCK-SpYQ7kNvwFXACsP&_nc_oc=AdlrqsDGGlHIaJulkhHHqoIV1Cz1WesbHmCYhJjcMJvWmRLKwZLLdLX-24J9rKkSdRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz66W95vs-HeCE01wDJLAK7R9zq-yKyXEfxc6f8NrRWrA&oe=69B14C19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt2zDcD3cK0Q7kNvwFQ6VvJ&_nc_oc=AdmfJH9VHRMdvV8i5DbaU_C8TG0S-DtARYAuy6c4b51r2RWdLJ8cxp7ZYsSylO4vJxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0JhZdlCo1xMh37uln4FZvphUgXLDbgPhjCl56XS-3Xg&oe=69B166A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Bt9NZs5r9cQ7kNvwGd6uGA&_nc_oc=AdmWnYIRID2hJJgL2pHFvMqn4GIdf_vwBXpSd3veJfuBV-jVIXIeJDPfg0FnDbIYL4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afztxpi0l83tl2O1Hkq5ALgoTbJr6tk5vMFgBqtGJNpiMQ&oe=69B14FF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
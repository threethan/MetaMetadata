vR4UJ0_c28Q7kNvwHAv5a5&_nc_oc=AdrCFJomx6d0AQG5eu4aFD1k8IvCDv8F7rSS3SzeQvMCtDORjIdxpy-57pnZBpX6htY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9mxGLmhuajTnBUn1L9xFn8j_mFJLzJxjIHE1kq-pENA&oe=6ADF5B7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkQjPrXggGkQ7kNvwEvD-_E&_nc_oc=AdrKhh1_V69se0JUzn5aPDO9GWbs1fpLJerqlyJBzFoPaX_j5zx40NIlL6AxxydJpYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONrcsbr5zh1WAg7zmXKZmp0m4Nyg3G0fVLEk02jswrlQ&oe=6ADF5C82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2m_yb_xlwwQ7kNvwHVLnZO&_nc_oc=Adpv5HUGKaDersp3HNTHpblFxcWjy5R_zzpl5KJqBnc825c3SHZOXybgKCuZVbW-e4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8gVlFdrqLyUz8P_wqd6z1lpuuuhMAmuzPmwxXdwtMMQ&oe=6ADF6BD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMs_dEUnPJ8Q7kNvwGeseVA&_nc_oc=AdptdiEWLngWkjkniR9Redv6CiRvDhcnRma5MdNpP8sP6g4G_x9x89dsA5Ukk1HJGPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfsm03IEo-lrs9QyIewvIZHeJwTq1U_nBc8NwZeqAfWQ&oe=6ADF4E25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG2ftPSGKmUQ7kNvwF72eII&_nc_oc=Ado06AOMTBzvE3lmz9Rf1idRxFw0URM0qZN-tvsoATMh0wNwcU9q430X99EaXu0J_58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyswzvLK2JQyu-QfyESCNP3VNWdtBE98Jl8u2Dp2FUCw&oe=6ADF6FB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
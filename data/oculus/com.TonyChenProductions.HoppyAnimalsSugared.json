=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftKjQa9jkRe9yQFDU4PZlFSaZeLYdq4qO-3UnfRGJlpxg&oe=69A1A1FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMUQyGLVYV8Q7kNvwGeXx7I&_nc_oc=AdkdOgjD1rze9asUPs_tQ8hUpqvie9rykGhQfIpB_-Ob_6J79yErF7Kk0ZmQKXSuqH8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsIVMxGwqdvWLBQ6-GT4eMbeIpZeBjhZwR1hoHAIibmiw&oe=69A1A302"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWKtXkgaXiwQ7kNvwHcZHww&_nc_oc=AdmLEA131YGivqlEdYwMUBMY2g_y2T8l73doDsuBQSioOy3sIM5iZr4wTmWPMkyRxpA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvc6KXtfCF27DA-q99Z29RaIlID3ontN-tRoUUfinT7Ag&oe=69A17A19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h3QVWO-6_IQ7kNvwFteFsy&_nc_oc=AdleNPYlkwNuGC4iAV2X97rcjkA1gcpMnZMKT9Mt-6Nfk2a-2uTeuNCI2ar24suwucA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsDT-AK-QErBzkjZ7IHS8B61ntjwSiESO7yaHqJbzk3yA&oe=69A194A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAXbWHPUqbsQ7kNvwGP2LFf&_nc_oc=AdnI-RYx0uVrFrDyyU_-M2q06jKtTApzhQGBPBOdiLo74p4-qrmoPLPwt-KBX5Sscp8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftJypDOy7merTJ4SplOgYDSFyFILXL7i3p3lL6Ur7RF9A&oe=69A17DF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
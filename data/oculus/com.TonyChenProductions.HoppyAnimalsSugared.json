vEmIhC_XncQ7kNvwFFTXjm&_nc_oc=AdoBOhHksZut1oTh-0ZJU-jMmuJkAKcm1YqYma1iGs4zjamFiqiZ_WNIu-xy_cLSfAM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTPXoxgqxZmcmJRkM9pVtSU2EgyrjLW83UtV_vfT-rdg&oe=6A621CFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CeGJ2C-tJEQ7kNvwH61O8Y&_nc_oc=Ado6wy5cV3us8fEqmGfm6Y12OYf7weA76zlMDqPjYbDaY80v_OwH0YpXAQMwPSecxZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4WvO7yStqTxKX4Hgl8QkTc8jUs9iiaRaTcHY9c33S2g&oe=6A621E02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7KH78X24H4Q7kNvwEQjGU7&_nc_oc=AdoBA2Aih5cVLivGthbdqhD6QsdvwFzIz1kU1Cw57BSb21afDllK2J8KSLm1QAU4Nc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPwa9LPcUsipI45SxUIRnN8lRfqR4Kh5Of0GxQUTn8Yw&oe=6A622D59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpE0gWkQ87wQ7kNvwF5VDwB&_nc_oc=AdqIRqqcoPvt3trM3C_nrKYZBu_wdI3ftaXqPWM1tPvRkv8xBcIc4N755lsiKfbMdIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGU-CrpgM9omvEDjkt5h9yMgqitS6i06lwFO2TTweQnQ&oe=6A620FA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5qWhirLF9wQ7kNvwHAyai1&_nc_oc=AdoDVDBRcgb2p6ekSSvPvUOnmSLTe_eXGBOG8tvyBbcwDRgA_yGM3tUC30oYJGRyNRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnT2mfFZzjJdSdKCsYNgnpBD-9_l0Vmc_Yd2d1InX5Fg&oe=6A623136"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
8HEZEhq4V8Q7kNvwHoM4I-&_nc_oc=Adp346mjjWuBkYNNC2ozqaiTC6ZSsJHiuxqlV1p6nXSXuEHTeNbXemSHecwvqvo4y3A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOH7fDQNJReOxY_ILkV7C9kKqGUa6NT2qPVcXdQHgwOw&oe=6AE895FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zx69-4aDa_4Q7kNvwHxP3D6&_nc_oc=AdqtdAxw3rT8ZHVvecvEZxLGhl4iSBMoLSdYpWmGaSSd7HKRNK5fDiXY4ws6RE3HFUc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5ZwMLSgzCFj-1sekRnHI-TIcV1bKsxfZEjJh-_PdjQ&oe=6AE89702"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6-dfFaje7MQ7kNvwG5rGAT&_nc_oc=AdoB2UUpMMNTF0oCRj5zKI2nBegb1Ya5e-_LHGd77WQx7PQEqseaSyuGxGDD3LDrMzk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA3OhCD7jypealnWbNT0FPGseU9oUSXAhgLtIrItIY-g&oe=6AE8A659"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OfcFaPnApgQ7kNvwG_oOOf&_nc_oc=AdodsCyyBpRhZZLTM1e3cpWq2fGDI6fS1ewFbtjoXtQcDxQaNpwhIJS4hLP6k_2y86o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4WehzQRTkyV3Snp82HztAp9Kl0RxAJcPIf7OsBt9hYQ&oe=6AE8C0E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKXspysfUbEQ7kNvwFsrwGN&_nc_oc=AdpmQNkElVilwjYxQyahvGVPrmx0foSNbz4WuY8lqpHs_PIzAHwfP6CXpHiS6dtK558&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmxz4nuiAQEWPNSZtskRnvUf53z_5Ltig6HwzkSL2kYQ&oe=6AE8AA36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
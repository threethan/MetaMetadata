lF3IkO1a3IQ7kNvwF6Pumz&_nc_oc=AdqOcB8uKuwd2CxKHHZaYdTVcMuJpWDMrMPmN8pYt9HvBbTQUSkituWe98CZDxUlP4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzNSLhzTgoQXP3l4YfxyaTIMyCr8riiOdJiWWMDtQZ1g&oe=6A5F79FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CeGJ2C-tJEQ7kNvwF4JVLT&_nc_oc=AdosPJqnPZ4Y8-0bNz6X9agbjEkJ51RrC79HpCDMfx9XYbQ27-rDdzdSTqGrBow8Hhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6SQmYcZspNBzXa-9XfJS_5kFt9sjeCx0ztV8srOhkKw&oe=6A5F7B02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV2IULU7dpkQ7kNvwGCKT26&_nc_oc=Ado1Ga9UniouI7nFsL7qRbugzIO_vPaq5VISXfvQdzsrzSbrThRcRd3gsTMcKhzG9Dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA4R5qMP3dF6DVrofOaSFc2gALf_2mL2erDlx8c7hMhQ&oe=6A5F8A59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpE0gWkQ87wQ7kNvwFNXF-z&_nc_oc=AdoqRyasajxALpHucWIz7qZSNWG7N8FNu5s2SLQ8Pt-XbD1NqckENgMJWZUScnuFd8k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa5R5_rOHlKcEe5KQnXViQJyWK0N3SWXMFD9caKTjjdQ&oe=6A5F6CA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5OQzhYuAkEQ7kNvwETQK8l&_nc_oc=AdoxdPW66mJ0-xmp9flM0a5mjHhn-dQRauhaLKkG7xZ2Rvh0-uGg7nWXwODqHC5gCgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9Op-rE1wVLJwoARvRPWRJ1O3hVo0KPJIrLaoBFjmBaQ&oe=6A5F55F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
Lq6tB-AVeoQ7kNvwF4VIsi&_nc_oc=AdpEDonVpI9fpUrqnr5KnVUcf6sld0k7FXv5plOqgTzN9vQhcIbUKEbjPJWd6zTj0SE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU-do83lUpgHTZ-ZeOvSj8-ScoxkweUY7TMjxDXuKmWg&oe=6A6CA8FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAnvGLBoFf8Q7kNvwEqSox3&_nc_oc=Adre3kOdj3FAqXIi36WmRgcPKIbSOyLvEouc8cJGkB8V-sn8guHsg7oTzFPz5w-Fh6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB54kWvqE-OB4RGr_9O6ZVKJU6YaWuT7o7aMW9LzsobOg&oe=6A6CAA02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKRKIhkV5GsQ7kNvwHMDJCN&_nc_oc=Adowv6uxCBCohUMtOa9r-aRWn78nxbybOQsaw00Q7JylSWoW60z3-9P-eDjUwaOj4as&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVtea2Jo7MjRijpY1-JsySTdHVNFQoJqquG9g7R-Qcbw&oe=6A6CB959"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrTTE6SBqN0Q7kNvwFi1Fgz&_nc_oc=Adomr-rasnws8GEwP1i2rHtTC1Wkx5_FE3wFxxCG4T-DIYp497lzykVjBLpwPZY-vkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFFf9_aPIPMuQ2wT1xks7fSXWaATEWryGsJJ9k7iLfMA&oe=6A6C9BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PopoVAZxWqAQ7kNvwHTBmKe&_nc_oc=AdoeMpUKaO_XvKzrDrU_78sURHpeC_LVvCrXkuWxLa-bPxCLbdDyZaMemkfiw5QHUow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA_hX2RQzWgnG0Q64whDCvlpC25ZbCgXoC_OmDc0X0XA&oe=6A6CBD36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
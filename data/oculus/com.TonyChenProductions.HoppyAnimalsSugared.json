w46y7I2XpoQ7kNvwEkKTvm&_nc_oc=AdrUIMEBuoA8BcAqUPv1r05pyiR59Q_clz0kk_T8EqyTXPWMpaz-6fU4L-rooXlxvB4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ59HlZN3Muyio5ov5H2WgTIg2KktNfN1w_Bn0VWYEIA&oe=6A4E567B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3YhF9hwa4cQ7kNvwFt7MrB&_nc_oc=AdpbH9yNoRNgh3ogHJYrFzFN0xiTy1XVv1M9Uly0K4T05_WrEHYsI-YiLPCPjXurxZ4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5ubOXgDvjTkm_WxEaa1wzylHiljXtrIkiR_6XD28dPw&oe=6A4E5782"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDqeQtUbMZYQ7kNvwHRjcr4&_nc_oc=AdrKwIR3frjP6TzDFaY0enOtjv1o17Vk77R7afOGeYafZgxui7gGZYdwttejpVHdylY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSDgGaC98199wN3b4d6eIB4TgtApGuaUwzL0unmdEzFA&oe=6A4E66D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEvbf_dd1bwQ7kNvwH4lUhq&_nc_oc=AdoBWDB6Y9oXCRRpNW4NDU2nkLsbUrIlcn9UuMDsJXfwQ_1NgLmbY-T7Y0Y2Ai6F4Jo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuka9AmIE4ErwDJ3hm7G8_h1N6110q-9cYoGf5FD8alw&oe=6A4E4925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpnQne5bZBIQ7kNvwFTHwW1&_nc_oc=AdpYF9rXbdFYn2Y6XVoF-ZHrLF30dKn15YZxDzI0GQaz86-eXSWU3iPryNrfY_1y6ZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6mRdFKzl7M7lGwj2xEqb51KQSNOxqkgqqActOdUQiYg&oe=6A4E6AB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
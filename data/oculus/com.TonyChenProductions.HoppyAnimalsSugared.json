FokaF4KtxMQ7kNvwGYvJPO&_nc_oc=Adpaw0dLPf8-nr65OrRM37WcDMrdOJblEMLtSmkU_BtJEpyF56MwrcPVTzhxyHmLapI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFry_fIKBw7ao-Pb3MzKnvDJ-ucba0OHYofxSRUDVFcsw&oe=6A93FDBB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqKQ0L_4fl8Q7kNvwHyhHZW&_nc_oc=Adpe_GW_cvJxQamP7XUavmpznH4-d6Vso-2-NlVk5E79LBonw8u76ZCPPabYnXj6Sy8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfVw7b_x46dLI1uWsqwmyE_vxgRN2X-SnYEhtuLolnGQ&oe=6A93FEC2"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrScdtReS_AQ7kNvwHOxGrG&_nc_oc=AdrateFwx-qtNqpoFyrfJaFzNOHBqPWWED54q7GK__5IiPe0HAkd6PbVw7fWAy7Jo0s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLHH1R1BEyq5l3cx1mLxFuq6futsz2Se-3wsute-_fyw&oe=6A940E19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QXARSFzFWkQ7kNvwGVR1az&_nc_oc=AdrY0cuKS5WvMQCHQftqN24p1D-p_Ptk4SqH08Tn0d60fEGvlnxO1aHfCpLdTrHnSIE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEADif_dG2BxnrYaNomPWr-Z1qZCKQOByqbtBA09Vc2Hg&oe=6A9428A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjgvHHD0-3gQ7kNvwEvjTKo&_nc_oc=AdoZtRIG8w3hqylOccRTsZW0qgCv5ubMsYgB2sANmHjT_2OfposrxPSOZFdQLK39omc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPrEy3wrMK67AlCQzc6kIuV5BniAn6DQgvhyYi8ha35Q&oe=6A9411F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
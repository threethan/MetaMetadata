5payqv--04Q7kNvwH0scOF&_nc_oc=AdpHiC5BiviA1S_6_0-a6sJjOIJJ4bP-1TrDrNBz8OGYBueyKQR_Haorj-4X_KcLDpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyPO9g-_cEBSlpZ7p-l1YEu2b34a0ZDN9SpwVJqRs0IQ&oe=6AEB38FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaJ1zklWq2MQ7kNvwFuifkc&_nc_oc=AdrfNhdpci9-BfxJ3FvjcSstq93vFewn0LxOCBQmpWVsNxzeDo-zGd4FpMCer8nN9VM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxsmNTIiUVMUGxk3QiPMAxJ8hfj8jJA2UnygCsDpR4Zg&oe=6AEB3A02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvNfkFKNKaYQ7kNvwHcIX-h&_nc_oc=AdoUC9bzISspJRBhklfjVo7XHB59Fp3wg0sH327M8XtuR9RlkURB8Rgr0xlSiUTrGkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdLqQRodJEoMWQopvQl5E8HofgqehVqEH0co0TVcFz6Q&oe=6AEB4959"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrBhIFf7ywQQ7kNvwFVAzKX&_nc_oc=AdpXu846KHA0Eqlsd7cIAY-4BH0-6rsrjNgMt4RkamUD7ruR1gO6dBkGikN9W4sBPwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNFG6fpcb9apAliyoVtIMjq8tI9TeSBDTeCVsuYVlxuQ&oe=6AEB2BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQcfPpsASscQ7kNvwHjdeOl&_nc_oc=Adr6ST5InI-NkG_vXZZUNlB-q8DmbD2WGEajB-pW_4Otu_6M5Uu1xaFhbsdUQI3g09s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWkwrJ1lGbNgciXWqLZ5pDa707GA_t-k1JArce_R4q7A&oe=6AEB4D36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
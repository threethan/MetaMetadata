kotYuIvqeFvIcFwE2Q3CcDyELs8okg2cDcCzoY5_NDBQsfpnbIqOXIK6T5UVbP9xc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6vF5XyKOgcI4i9oRWsyRIseNfXoRAf6MUuXD0RfI07A&oe=69AED0FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfmjjn_90KoQ7kNvwFxoeWy&_nc_oc=AdmD9r7H3qMN2iUWQsNxtds0A22NvRioC06x2UWSv4gcHApg1ro3U2K7STkzhvBqIsw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTB9hgCUSVFBGufDxXJasSdEBrPp6rxPcld0w1vUvuMg&oe=69AED202"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfKOeCK-SpYQ7kNvwFj0jNt&_nc_oc=AdkzPORhVUQZalH4fy5Xgd0hIpt6O8myalDKfKb5I2kK5qo9lnuMaQUDrvl53pVCRDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQJzgzc5KbUbv0KeNh1QON9ueGQBAVqccDyHtRoo8WVQ&oe=69AEA919"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JFO8bwdStcQ7kNvwHORkSh&_nc_oc=Adk8tJaT66SeqSUxFg8cE9ptOxS5JSQeo1-nnmI-3bZPaSAvfvoSvlgFc0S7bbi8T84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwc9m4z__UVOP_b9j6qtfD-rqIoHHfBUbj76foqB564gQ&oe=69AEC3A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Bt9NZs5r9cQ7kNvwGVlVEH&_nc_oc=AdnKbj9DMfEACFn8zkPOekwNKLbVyTt_rnUrvWZY_sj1Gl4lZNmUTpmWk4bUdvXrVsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzR5PXdhJfAOXxxoKffzM0FrIJpeGfGDTkaNlqHVo6uPg&oe=69AEACF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
Z_mQxOqQhcQ7kNvwHtZ9Db&_nc_oc=AdpCYG-BTVUOp4y0xDICwhyrAgqIjFDbcdjTle--gC7WbJpftdro-ZpKIphJIBHE0dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjAmGdwmTLrhMOiYLZedGDLvByKCa2oNnZSJOCAykoNA&oe=6ACA437B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szkS4yqokygQ7kNvwEFyN2o&_nc_oc=AdpVixoThIAVAI9Dahc2ZGpoZ3AuqTsGr2Nbw2BItCgv0TDb_D3Mlfk5Qd85XCtwkz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAS6-6thrU_j3tC7QmjK4PPMSup97tA0WAUI0ExUNbPQ&oe=6ACA4482"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHXvnAq7PQ8Q7kNvwGngDfV&_nc_oc=Adqry6Zfe8WHOItwWxTYdzGWPKPcd6d42eEwBC7qbUwXlvuXemq3N4-Rahu48XqhEIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb0SrkccmEtjH3wbXd9klv_TBAn66PACcv_HtFmg8m6w&oe=6ACA53D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEAe3EnQvX0Q7kNvwGmVCi7&_nc_oc=AdrJAgXkvtmD2qbxdr9o4QxyaibgZ59-erT_DsM2f2GHwfaErFS9IUKIGeM2nCAUV5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_Iapbq0jkGcWagqEZ4-c3tbt_mP09HMKUrZIY3L368g&oe=6ACA6E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZS7EYjDREsQ7kNvwH8p0Iy&_nc_oc=AdqyFpLlMiT7-dmyajaJHVq_7ArjA7l9WQGwa7Oh6rTSeGGyMF7gPm3o2v92Snr5QFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbSdFSoQ4oFMKea1mHJatc7RW1K8bYL1d4upoz5fvR0Q&oe=6ACA57B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
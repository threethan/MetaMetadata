RBCp4qbpqMQ7kNvwEKmg4z&_nc_oc=AdqbQrl9Nxq2EmwRVLySz598mV533vbDM2jP9R9PuDeu1rSrNi8sHYnuLxOPcF8L2Bw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZpbSziVUYYnnqo6liMfJ0TE0l0zo0Topor4_c4nQmyg&oe=6A8AC33B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftWIVjux1FQQ7kNvwF3Sflr&_nc_oc=Ado3aDjjGuWbDfzwWouWaNQbuke0FwtLXHRqnYtzIq8N-JZTg_QB-mwEMtJeeXi348c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt_M_PURFX1a5bL7iOXea64RZ5M0U_xoh1B2xsUKhuEA&oe=6A8AC442"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvAc3khoKtkQ7kNvwHEDG41&_nc_oc=AdoEfymw8maxzf1UQUH_TZVS9hEJIjXsoJbPhJahPW_xmHAde_wdSjGfq2WLtTALpLI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwp83iIAZfo2S2jDfidbEOZTVFxbJPhW0iUFrzqR29Jw&oe=6A8AD399"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RARLl67sNCAQ7kNvwFud2sc&_nc_oc=AdpNbrDNqkrSGeuwmg3TdacQ8DtLDwF9ekCI4pcvDVsI27iiNZRySh8WXzZfSm34p2k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9MBLLJaljvD-wyU3byEKq48zoom_KRG0Spw15OVZsAA&oe=6A8AEE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKQuwGCcA9oQ7kNvwGGikmK&_nc_oc=AdqDdYhxcALiv3ZjvH2g_yVXkh444VfeIlovwoVzg4cI9aiZCta2A8v3hOF55g8aKj0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR675xerwPKML9Z3hcDpTCvCky8T7vH_p-eGhK8r_FFg&oe=6A8AD776"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
vVc-gsCGmr6_7JBwUiwDjdpNw8UvD4mdQtpE_8tluQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTydIGlJ3QbPlmW6b9wiXZofwEwQLhlLks0QLSzNzBZYg&oe=6AE8C31A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbq7SFDO28cQ7kNvwHBsnpq&_nc_oc=Adq88pPj_nb-g2EOdnUVDDyhI8-07f8gpeekL1A7gdAApGPzS_EcsNQhKOlfpFaa7Yg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUMwmmhIojK7kYyBYhWpLBmkDSLcRy5cYjwsCiBr3xxA&oe=6AE8A183"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wfG32TkWVMQ7kNvwHZuWDL&_nc_oc=Adqg9DZgm7-Jz0z4YSx4Tb4M9ZxT-k1pvufuSpBnSDRdyiTcJbxU1LfYJ6ofSGE-5-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRcf7OiYYwqMzO_B9VD_ggym5ecyFlXjhoj3W-rV66Ow&oe=6AE898DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
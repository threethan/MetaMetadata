829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOBFdk_uCYAQ7kNvwEhrvk6&_nc_oc=AdlTJ8dAsR8qz__OGiIzSMg-tnHlv4he42VqgUy9rE8-Ci8kv6hx0XIez-ofRreX0P0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvP2zmscmNC34bCSgFeYNj_6UhjmXcsfgCAsVEyj669Xg&oe=69A17543"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_EIvXdF4kYQ7kNvwGLCM9X&_nc_oc=Adm9VSdIz9Kva71TPuqYh4BpzTuGz-dEmCWD4XMF4LiOFWWVSY8eC3ttWOVZzYWZD7Q&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsvWYK5Q6NtsMEPrGGJf2pNPd1jGVHIGGcX8_VAsnnBeg&oe=69A1A4DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over)."}]}, "developer_name": "Tony Chen", "developer_privacy_policy_url": "https://tonychenproductions.weebly.com/privacy-policy-
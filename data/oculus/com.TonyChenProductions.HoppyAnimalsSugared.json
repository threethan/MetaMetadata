GBRMmwjgdkQ7kNvwH77IF1&_nc_oc=AdpqKn0g7NEYKBA711hOTUU5BB0p7rDEUsnsWoDV_bblleVvdEwyD8s9TBuYeNpPY-0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62g5uvoGQb41255CEF7iCc6ArywB1hBlwt5JQ2eTGjrA&oe=6A105FFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjHpRd9Cl2EQ7kNvwGa2CD4&_nc_oc=AdqQlOySj5RF_wpwMPxf-Ttb0o8rz18KcBnGQC1bFVadoB3jAuPInvZ2AFU7f38JhcU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZBA_UX3PFINqdKBY6-HBJi-986pbFmdSnEFbAQON0zA&oe=6A106102"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPxj5kbW9C4Q7kNvwHGpT-o&_nc_oc=AdpLg8PtSatATINq2FsJfs0QtBlxmKk5ewkKSTrxIqQGBzKPUh3S_oSIPJm4PRBIJs4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pi-Ld_Gqt8fSLLCjqoKj9NkNsijKftbIHZBdFZlfuCA&oe=6A107059"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SFdSzD_E_MQ7kNvwEAfuoj&_nc_oc=Adozovhj5BTx-vnztkOn2dWdcD6h2qURG-iKULdEAg_K_Dz6sX59SKLB4fegBtrWHZE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NKhYawOrcBjkNFnNULtYq_2SXxWhN3XhirrikjJTKDg&oe=6A1052A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFij9chP-2AQ7kNvwFmskkx&_nc_oc=AdpQDesv4yUx0bGgJpiu0Rs4HpM4UaYhGIk2PuM6sDdaqzB8dEu5LVz71JyzL0EoIjs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TbiX4uvFdb7OpfHmK6XPXskIX8MOzyseQ0BEGagbQ1Q&oe=6A107436"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
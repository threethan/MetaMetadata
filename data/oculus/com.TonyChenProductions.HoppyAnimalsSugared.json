=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0vU2KCBoEgQQuMTFlBXY9GufX2uqTscHY9R54x6C6CNg&oe=69F0BBFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAKw0G7XD-0Q7kNvwEhZ41T&_nc_oc=AdrvJ-p12tPDpdAoPcLjq6PtzwQpCnnDSF5JXV3kWXSRIO-UHcuRFVf-vjYKz9K2Wm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3644FMCtRlFrn7s4uEAb6d5tupp14wjdN-UxEJUI_YGg&oe=69F0BD02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVioxdW6WuYQ7kNvwHHDKsu&_nc_oc=AdqYYaPR5uQGk2ry2nEyOpsjtSipwIEl8qHc-XiO4bN_SkqVy5E0ZoKSu40s8s105Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0DilUfYuwJhMQvqe-vTl9GROtgutBgEUYvRXJ-Fe86ng&oe=69F0CC59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVBcI20lNXEQ7kNvwHZokUK&_nc_oc=Adpo1HZfBKjf5SSul0nic4UkrX28izzs_GzCGUIRO7L4yMKyJEHfYyiSO-5NfG8dKxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af08iwrhJ9kenObKL1HQ06h9s53Axz8qTaLQSEmDKkmc_w&oe=69F0AEA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdic7vTSZocQ7kNvwHZCmwT&_nc_oc=AdqC-An7G8lUbyyc6qY5XZMsmRlkpf5Mb4ObLJ1-zK7-4kpsSRlcy5PZZQUf1rj9ijU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3fzb1OEJaIL_2ccRu6ARpHGyrYqDK5w5kSs87jp11_Sw&oe=69F0D036"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
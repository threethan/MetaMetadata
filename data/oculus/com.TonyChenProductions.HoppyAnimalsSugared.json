=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLuzAgBlSgbFMEoJChR_TfeE4Mddh1heJiGD75hldQgA&oe=69A0507B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6zBZ98fqo4Q7kNvwFA39vn&_nc_oc=AdnQJ-sL9VN7_tzoqIeTz4c4CLCT9XeBBc0BuuyrbAR-7Bo27GrycpF-0ih--fSGbzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftclkWFQV3y3WunTk3QVDamt4uX4gXHSHf-07b7CGjgPw&oe=69A05182"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWKtXkgaXiwQ7kNvwF0wYU3&_nc_oc=AdmaRKelbd6JJvskbJlwfth9cjPMsevasjOXE5P0UkCN7npmPDIJpsEF_jhTuu-1rrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvVmeh5PxZpfzEqmJLWWNN0hpIV64oVbDQX6nxgFt0Tg&oe=69A02899"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_pJu55AJREQ7kNvwEmwAaF&_nc_oc=AdmvTc3TTaRdn8tPsomTrLxGKH8-h8lOAaXY6wgUs4mVJiXbOnl0y29wN-MITBDLD_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfumXSn3eUtFvvbRMKYn3VhBkl3-iDGuaorDXlbm0Uo4fw&oe=69A04325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAXbWHPUqbsQ7kNvwFJYbZg&_nc_oc=AdnWRsvEMzEnrfnEsmdaleuMZo0qvG-qDFxpsSpsk0dnvmsextFtwSqFU19VrCt6YYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuqrBGFE2sXS-wqFBaZzVbCZPatamzVMRS9XkFpZM6hHA&oe=69A02C76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
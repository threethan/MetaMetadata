zaYus1cqlsQ7kNvwFGF_4x&_nc_oc=Adps9ivlC_UVEgKhLkhg_4jFoq6PHYiYnsIjQfzNoRnYkdHqoFiXjljb-U4IDhhHFIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP22V2VZrP76ci9h2ZSy1381yHsNaNOCpvnx0TdXdINYw&oe=6AD22C7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkAbkKUjarcQ7kNvwF6RBrD&_nc_oc=AdpDqNgyePvDZQGKl6ighnB7C9Bz3O9bnsodN4bLvv0zCoD_2B_Nc-OI5HWmXLymR2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Oz0sa0eXJnfw2AKXvz0KuXf9Q_c4-8yDNt7mqabQzg&oe=6AD22D82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq4lzcHaRBcQ7kNvwGk6FTZ&_nc_oc=AdrSkQBITWNcuK1AOAM1pHHi2dTN8Snqg21MhkiRzomFWq2gUy7fiBPutzcGd85b2Tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrz4sdozfIFKRt8kgJvRUaXn9jjUPCKmBI5eMr1oXX1w&oe=6AD23CD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Icq-X0-X_NQQ7kNvwGXJGb0&_nc_oc=Adr8vJukL4JfcfTH1Jr5jsHMXwZldsyeGr0aZiwHL1YT0TRJEGV8KUTXRkTW22mKMrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1BLx7nLlHSMbDskkJvpEQOja2yM6tTiuQ9Ke1qps9uA&oe=6AD25765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrzGDdK-i2wQ7kNvwGajOdu&_nc_oc=AdoRC7XvqeS16br8OHbeSjsDMeLY22qiDYVeUp156idy6SyD7GQuTk2YnIEokkRksMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBNhJl1bJWFywgAzNC0ifsqkISY8lPduCgvglSg-hhpw&oe=6AD240B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
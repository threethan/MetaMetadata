2dM47pXJZEQ7kNvwGu0R9N&_nc_oc=Adoy4YxFVCG9vUAYmowqY_cjr7dBAwdMH_IWhvITp3dRBE-bmxV2uHxclFcnxJQqc8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLls1sagunZCZc_IuTTvCPj2d3QXv1jMFCUNOw7Uo0j8w&oe=6A9C1EFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlFvjvIQt_QQ7kNvwGBLb9W&_nc_oc=AdrY5znQ4ncN1Y17ouGWNs3WHl9Y_3FoxLpwHPd_en-bJFLfRfn3br0Sv-UhEkwPKSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKfxJ-HlorucMPreN681eIXYwQR834XC2DehEowDQK1Q&oe=6A9C2002"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qv0tf7g3Y8Q7kNvwG1A8jV&_nc_oc=Adphmpry084Vi3sWMEYqoFkqc4GLV-6Js-0ADrpckeKzJR5CfKt-S2jrGs0LmZqy1mE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCAJowdeBJaKJDYoCG3c5x8JTrLdyZ1DGIGwwqi48zDA&oe=6A9C2F59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7vq0h9ss_IQ7kNvwFTpmeT&_nc_oc=Adrantd0SjbYqwkcSfyE8bAHKyT-SgTojS37-xXDy_C-HYlrfXccPDkjM3_6Fi3Zkuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBR_0PM0-l2wecKbCQdimEf_vzyhZRDircLeYcNvaNAg&oe=6A9C11A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmBN4CCqgXIQ7kNvwGcNDnM&_nc_oc=AdoKufxfDtFWzRTMAbSezeeBvOJT_AZusky9i0mrc9mH8a3woK45J854l8hY-MACEDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK9NvnPMMSE7Rb4-cA9OGXk_t2-eHozjBwjwB2jvF_Vg&oe=6A9C3336"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
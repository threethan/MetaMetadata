chLpv4IUbEQ7kNvwHhs8QE&_nc_oc=AdqCmsfJ_4DX2eZXEXBNwUrKHsBxmbAbq_4RIu_qbi-8hqeGR6B3V3zlSD8PvsV5DG0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl5VqCbx4cKWUwZDyQhbsBNFFeyAFhN8TO5nw5wSyssA&oe=6A563F7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TySDXzcIA30Q7kNvwHVUqCE&_nc_oc=AdoVsKuBkTVkVif7f_4W_8P1VbzXP1dI7aPxaBEOuzR-a666X1FWY1DOlxkZHnK3Dsk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBogGp4EdFJXrT6Ys6rgyf3OhYDOh68AZpg2Hp0ZK_4Iw&oe=6A564082"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShK88vRn-REQ7kNvwGxTfHo&_nc_oc=AdraJIF_WMpuHu8QphEV_MblDJJzl084Cv_9QCwydcw_DBdn5IDdoy3nZFqkpURqFjs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE6KmcYo4OTlLXY5m7Qkfp2NGSJM4J_q8Cp_FAzHyd6Q&oe=6A564FD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRGmHuMDTqcQ7kNvwFzccRV&_nc_oc=AdoDEUtipM0YrKBgEarLnu4zFWJVh7gCI5ghLDQDdHksujJGHcGQqksQ7tNtz3kUBWs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnbrXEZUUfnn7FRZoq8vpikWjrLaujHr7yoobeGYK69g&oe=6A563225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jqll2GOTPIQ7kNvwHH9X65&_nc_oc=Adq4mScAT1p_8ENAZvFSS3Xlxy50lDQFd36nPontxfbEvO9vUYkjDyYALMRdkqM0BW8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuPd10RXY4tdKgNV_rrlvV7Y6G-Yizwh5-eg7KP1XxXw&oe=6A5653B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
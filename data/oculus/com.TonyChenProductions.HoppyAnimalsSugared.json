rkrGCjvw3sQ7kNvwE86i5b&_nc_oc=AdqdSWTfo9lz-cOpfP4AQXZy49nPTsQpJKIHB9z60qU5HX7yFx7TZDMy6TtAuRKJPao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPsaHvAv45F-MZuOoESj_xJT_DpI5cVO9LC4RlWZsMrg&oe=6A8C14BB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zVyud0kY2oQ7kNvwEMoSPG&_nc_oc=AdphRMrvBm6q6tRu6MYE66A-msRfq5re9bNStU3hx9C7bCzBcmavO5Af9K2CE4DmXM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvAbJqHi2oIN6EKSO02ksE4Xd--FVwJLbrHd-Do0ExHA&oe=6A8C15C2"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnqa1S3ChLUQ7kNvwFX2Y2V&_nc_oc=AdqcXsC_UXydLrPvxXE5y1jMJ4MCnl0IhYfbwSDyGp1PdteLFwdH51nrGF2tLaS0tog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM90psv6uQUZZ6z7dKaFGumtE0zzbIsc90Q1IZICykrQ&oe=6A8C2519"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RARLl67sNCAQ7kNvwHyXKar&_nc_oc=Adr78mgaYUcToanXeNcYqE4lrXUC_M3xHICRNUI5l0-1dEAhVH4v9KeInn4dxliUPps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFumyiAdtLNWeHYooxxY_b7q_lvLgmFkp0jKJhL_s0SDw&oe=6A8C3FA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIptBgpvb0cQ7kNvwFYuMRx&_nc_oc=Adq_kDggfZM85A-dtFzzny2gu6e8u8ywIxBtLV-uFahCkH_WLW6X0zDz0nry_WVtIyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgMK5ruScd2hKNb088uc68khHVA3ioTZn2pI2dc8VGsw&oe=6A8C28F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
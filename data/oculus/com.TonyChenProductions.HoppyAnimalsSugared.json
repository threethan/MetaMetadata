vR4UJ0_c28Q7kNvwEseZ_C&_nc_oc=AdryiyrvkzXWWRXYWyVK4yHKrcRdvtsOB1DSSJvjkIo0Qxs7WY9qh2pk0hnMidRyVE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhsqbl4P2XoE-JVqhRI9ooAnrfpnft-cY0M-zHvnzjwQ&oe=6AE1FE7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A988cXNLGiIQ7kNvwFozJzE&_nc_oc=AdoFnxYVOY9mYfTzoaW1pZN_qhEUqcM-56lt05R_547C091D-Uc9b512RfiL206lzR8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFau7uGMU2jqHurdPwZWAc_NTMKCGW6dgyOYiRNOjvvQ&oe=6AE1FF82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2m_yb_xlwwQ7kNvwEiN5cA&_nc_oc=Adp9gtyCknIHwBd504Haeyt8UlwcRxYbc7j9QZOuT8I_k_KaKlCDRnGi_TwflB10-r0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-Np-jo3mTe2HdW4ZreHhTDYEj_Ef0vAIUgtd_uO8tQA&oe=6AE20ED9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzdJmWxVtJkQ7kNvwEnWKpI&_nc_oc=Adq-ZhLFgKR1VuYZXtNbkGSWuvewzDSjWWiYpa84u2mC71aCZjTaZj4EzLntCZW-X7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJiiNPpEQ8gS9coiq_76eYky0MeQOLHLCnRpFkWg6j-g&oe=6AE1F125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG2ftPSGKmUQ7kNvwHx6wPp&_nc_oc=AdrtxyJQGVOWdqaEsPdv7nqaIdELIV9GY-NvcFuorX7hIJ7gTZ_9N0CAbae1Gvppfsg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMxsFRQtplElMhv-MFk979JtZxhFqArLw2loC8lyEhfg&oe=6AE212B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
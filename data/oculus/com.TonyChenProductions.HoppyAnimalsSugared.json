8y9nqgS2yUQ7kNvwEF61t-&_nc_oc=Adr_OMZrW-nSjaF6_AKB_1xD4ICtpX2ANIsXCs87kh6pOTahRVEHva32Y_8aLmsQhuo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1sFShq_UZz8fErPvYrcCmOmpLA2lo7s8U9ApYD2uJ8g&oe=6A2C0F7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygGA-SZWkxgQ7kNvwFAIC2F&_nc_oc=AdrV1VylMYcKEe4oRtR7MgrV30lO1tSeRTj4DMy9z7t7TxZmN_BtOwNcCOcSVDUAmss&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bpyQ4I1719WuslfI0_hklkWk_nnUzozQvORytweml-g&oe=6A2C1082"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgJFxmEC-TsQ7kNvwE9bNDo&_nc_oc=AdolIAAty_8aZ6bog3HMaUIIPDaiY4TI6K2p3cOzC768m9dADLO915FgabtChXkpstk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aX1gaQBtPKfbGWNN6lMneMDsSWp2ZEqe3fdHq7_zXpg&oe=6A2C1FD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-bM4R7SgccQ7kNvwG3QFvS&_nc_oc=AdoPwAW63h9_Nb-KpiBtS08guSxo4CFcXGpjaFzBUUwGpvFoIxUoewDAf67Dk9gStaw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v0PeHIoLqRj39-XdJsfiQqmQ39iACKP5zxeNoa2WmLw&oe=6A2C0225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk1sJ5rKAbIQ7kNvwGnJgNg&_nc_oc=AdqnAsAQ6-0WBI50BVuxp5qPhOc9jHzX2Uw5SD9KczihfC88Wz_CF_q2I4EF_jXiNrA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aTfzGqWH4V6F-gAz3y_Y2b5V4gD_mbc4Thuo-yzOTbw&oe=6A2C23B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
GBRMmwjgdkQ7kNvwGwszhw&_nc_oc=AdrmVBGo-Blqq2eHsOFUhk4tty3t4KofB28VVgCKGnXODwCwNBk1VWsO9ZDKXdLkm9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GjO1f4Az9_s5XvFjfSpvaqnaRi-A3zz9jga18Bt73dw&oe=6A0DBCFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpU17zBTucUQ7kNvwHXbZJ2&_nc_oc=AdqNLp3GgBDaGUerZyiaR-KAJCDBYMeqdJA_hZ6Xgjbd8x6T5GbrRzYFeclBx9qZ1nw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zlw0_IVNUJH3TZZZpzdbkLmZvSIIoi2VX5FMDf3ZyuA&oe=6A0DBE02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPxj5kbW9C4Q7kNvwHfvJnK&_nc_oc=AdoQVm6ACyUwPqpk0mQZq9KpHU-Z43t0arXaY4Ch1mV2u03N-7G651cqcGjaw6IO-Bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w3NBP_OqD7W25X9_reH9hCYKcvvWX1NRbzKnu7jwbdg&oe=6A0DCD59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK8jD5PBCfAQ7kNvwGiSs1l&_nc_oc=Adqm1vscPBYyio_7-_KSwCV7SzteFLnog15Tk7mcihVbvZOlGH-D-McK-AqMZENgmec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mkUs12bPKBgfB5w1OuHTGBsLuhnmvk95YbvPVOHi0Yg&oe=6A0DAFA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFij9chP-2AQ7kNvwHlpP85&_nc_oc=AdqgHFT9xq-7wW6NmA_gHMAkjDv-NVPH0N04zfOpDyqdlTFL-Mf7C-99ka_u0rb9kXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_6wFiw9FddCl0BwUcpgiexMnCMDWhadYfTVWQfXgFyw&oe=6A0DD136"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
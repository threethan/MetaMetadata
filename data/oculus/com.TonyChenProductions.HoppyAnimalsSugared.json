8HEZEhq4V8Q7kNvwEX8dcr&_nc_oc=Adrj6PqLMVr1nPtjtxbrn_R0hCp9PN4eOkTBNRKWhkU51dZ_t3SZiITeHQdoatIaINk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0IOofAUG_CDwhhHVm2AjtzCR3iusZtf15SKhdk20GQQ&oe=6AE9E77B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaJ1zklWq2MQ7kNvwGjh-cq&_nc_oc=AdpzvIx6VlZPxxB4fIkI2dE_bHad7kiyWOZMGgx9cfXfYHlH7UPbAOGXT5icGnqQ6YA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk9SnkMZWskXpYeeTu47SsOO2CNfKW3niW79qfeJO7AQ&oe=6AE9E882"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6-dfFaje7MQ7kNvwE3J6US&_nc_oc=AdosOkUf44tXGu-zXiQu_jThQ6tUAyGI22O8qCUIeHL1oG0oPz63UNxxlHFX6c2lykY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShSSr1opJRXI-HTo3mK_EbLIf6zwvdKl7-Gznu9_CtOA&oe=6AE9F7D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrBhIFf7ywQQ7kNvwEi0B5r&_nc_oc=AdrGbvkp4JCl_iNhzrCyuEYmBl_Kkzug3hRQgVvd1nGlJkEJi8sFUt5z_x-yci1G0oA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc9D8nl0Re5hE5C9qHGF4_uqsVDeXwsz0I7_lx5zS97g&oe=6AEA1265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKXspysfUbEQ7kNvwE66rAj&_nc_oc=AdruI274VTZRQkyA7MIl6mVbpamanwus8A9q1c9lkwsL7SFue07JL8P252DSrKTFkB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfn-lyPlNiNQI4Kx3rCU0i_1Y9yLfPS7Ty_6GcKQj0zA&oe=6AE9FBB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
scMmPM-ZtMQ7kNvwGPKzTr&_nc_oc=AdrrnrKbrd8RlAZcmMmBuPH8nnpxXN4mSaJN3tD4ejWI2w6rrkwBo6ARDs0XdKCbZn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtePecvUVN9R-X2JBnTk6uV2QnebHIW-sxQYICaW57tQ&oe=6ABBC2FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN7EGEoLdJgQ7kNvwEBaRsL&_nc_oc=AdofORVjXXS0V5p_3tG_BRX_dOAXH3jktQVX1dw9rxu2268vVg9JLQS6CUadTQb25Vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_vuhXBH4mFiWjV1gmlRYXLNWtIMVroKQCmQ39MCIkYQ&oe=6ABBC402"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juWsgNPba1UQ7kNvwGEvV46&_nc_oc=AdoNnU0fgAPZ4xNTxjd9uEvDfXCXhpuldGinUcKdfr0ps_dQ09n1aYVwr_s5ew3wpkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeNqNuUZkeCeGuG7UrK0ONZ17qRp_E6FECDWOHmdBfiw&oe=6ABBD359"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hHQLry9wacQ7kNvwFpM_-H&_nc_oc=AdpnPtieg6rb6GyupCYDux105-I_IXZ6c_JFeiIHnNBTGABSziiHxNsOb5VlPrFOC_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIoi0AOIf_ReHStdnMP87Oh0NZdFhYuA3TQejK66vLrQ&oe=6ABBB5A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkMxAG71L6EQ7kNvwFZZQ9d&_nc_oc=AdpYbYnD12VaI4nIGE6cUd28xZfAT7_Pig-weY-PC5BhuupncapMUEObLiFUehCr58M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8YzEhIaEqaNu98bWJeJprP_vvE5YtSjcU6uAHzkVAJQ&oe=6ABBD736"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
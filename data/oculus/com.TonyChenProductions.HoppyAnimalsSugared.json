E8pxQB4mwiaIZ0KYO_1Z2F-nj4SE5vgEb2oFqSj0Vo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YJ2Wx6POu0QvU8MVAKecnXxc0iDKLiuAfVLSVMhkyhA&oe=6A0C605A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfOgRMbH6KkQ7kNvwFy4JEx&_nc_oc=Adq4gH00grBPRFARUj5dBtbAp65DPeE5EGof-xlsecx_nn9HEkvmyvms1OvEXn4-Shw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RFOq7P8U03oox7x73hQVM8HYSygffJH14GKBXDQ4uHQ&oe=6A0C7703"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj_bxiS0RmUQ7kNvwHMoi8I&_nc_oc=Adpkj1lrGgug01T7TVQ0dne_X3xYe8Ai0b1xbyChTo1NLazlh7JtV-HUgerM_lCLW0c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x27fgmkAXPx3-eqg-OCvDXOsJeAG-wFvzPS3y2d9sYA&oe=6A0C6E5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
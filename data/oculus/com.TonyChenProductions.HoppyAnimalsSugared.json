3eWPjTSJKb-4k1sd5LzaVQGxIAvAsqt5bRkwr3AjGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NStk2ekXBnI7pYGmredBLDwgabApRpa5q137wXZmT3Q&oe=69D25E5A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MftuGWsq_pEQ7kNvwG6USQB&_nc_oc=AdpLoY-zQBrzoAC69h2r1KgM-msfqnxo-q69t-rq_jDjQ9Ai27nEXVucKp6O6h5AKpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ydu5Roo_dJgYOAPm0EhbSWicXYhuX2Z2hWW2z8-jWWA&oe=69D27503"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDBVSOyhNcsQ7kNvwE-cGM9&_nc_oc=AdopI0MgKBqpn0IR2PZWrpkAZFCNVmZACMXUmQdWSepzrs781tMBTlk0h-7Su5Z8pqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Kb5Efy-8pww_hRjL2zRoBRzhPeKRvM6lh86ldwh3LWw&oe=69D26C5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
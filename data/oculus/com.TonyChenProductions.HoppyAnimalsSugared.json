OJ7-5uCQZoQ7kNvwGW8qIV&_nc_oc=AdpX9hr3mvBlFmh4S_mRxQJRR6Wz4ibLgMGZfq4RCh0I8QEHrvusY2OV6jmYCdlTBEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3oLMAY4fAU5q0yZPflb0AkldEACBrC_b4YtW_oRxlLQ&oe=6AF8A03B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE44quARe7MQ7kNvwHNf2UP&_nc_oc=Adpy8d7pVqzqqXJN1pPA1kxUuB02PYUjVs5Vc5cuZcgZ68HvxTF1SaHbdueCec5uOqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0TSxDa-6AvcozsZzSawo2LRnuFA_-fUB1JyxjjoQ2YA&oe=6AF8A142"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=macdlOou96MQ7kNvwEf28-k&_nc_oc=AdoBwBsaxijmQWP7ss7_IsNr1NbAlUXjdZi0SMpbfvyodQNZUSBkPAIuHCHU4gyBT-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAT0-gYx1oJg42IW0ozhxhkL8VBWhbl-F0NaTeX2Nwzg&oe=6AF87859"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SUhV763Yo4Q7kNvwFwu9Yi&_nc_oc=AdpK4GtVUeU-TttgJLyyyqoue0BHunYxp5eePq9Z0eTuV3hhl1vuRjytHI0jgEKciV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFPtUJ6By6wvvDbd00cuh5qcRk9XhFGEwh4Lka1FzZ_w&oe=6AF892E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzUUdndFno0Q7kNvwGO66iW&_nc_oc=AdohxHLy8wulbkbNrWwEui6DamlGYXZAZG6P5nsCSORWRII38AvTIM5RmAgHniSSFE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQbkDtbnIOvnqPl_vb0xv_4n8qbR97lGsNgdWP3B3mpQ&oe=6AF87C36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
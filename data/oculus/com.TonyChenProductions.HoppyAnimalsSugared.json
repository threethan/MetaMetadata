iDOQdLAhgJJU1byXQ5R2b5cSXYnFPPfVqepcbpwPDc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgpZ4wCYwozcfr9ePquEKcJ6gIgxHVJrr0pTH8FjptFQ&oe=6AC8E6DA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3QB0vAlZ18Q7kNvwGjgruG&_nc_oc=AdpYUWzI4vaExfxkniN3Aorgngmo90E_ordS61tVpuXQmF4whdVHFKH5sEsvZTd7r-Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMm0tlYDne3eVdGIKXbdEC7OFRQj8LGKOJk64mdLXudQ&oe=6AC8FD83"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y9O8g4NtP8Q7kNvwHNHOpd&_nc_oc=AdpQ8XMz-vmsrY34gtylIg3OprOarcz-9hiQCiA4bBVz9QtB2-L-Y9CJg48f5Rl2qvE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq136qLfZPpYj_ipKe6AGgfYKggbBhJrdEoZELfU_6vw&oe=6AC8F4DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
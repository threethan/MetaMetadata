a&_nc_ohc=arkrGCjvw3sQ7kNvwFVnDZb&_nc_oc=AdphnbBmgfANNb4NggSEhUA0JSOUKxDICbG6F3q59XKYgTlFowADhDfsm-6NAgkjE-E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSpL_uM_fs0rirv1YQrjPrIvHuTAtU8hAUfy3-h-P7iQ&oe=6A8D663B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zVyud0kY2oQ7kNvwHGJuZR&_nc_oc=AdqzWcbXgbeZGcMM7G7aK42M5IimCUQcjQ-uGEBaRaODg4E1dL5ht78KUY0YPgOCQEU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXwz3SsSYMfyocYh93fd9m4iai1zmomNO4MKRz1JoZxg&oe=6A8D6742"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnqa1S3ChLUQ7kNvwEbfzau&_nc_oc=Adq5bVP-hrgy0fwfX3uPQtPbHegyIJYNwCKqsKXgcRErrtCciBrSZyHvipUAYQ1nohI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7yVJPSzd9q1wm9c_LQiP1TPdo9vwijFR61a5EAcoLjA&oe=6A8D7699"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RARLl67sNCAQ7kNvwHaMW_6&_nc_oc=AdpKB-XS0lyYrnxRF198dyo5TkuHrovCe_3WERy_b4DGUsvv6ESJ8AteehHbmTatiJI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuiNDwz-k1xw6Dnhqft8DVkaE_-LBDsb-unsJU86MzdA&oe=6A8D9125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIptBgpvb0cQ7kNvwGflBke&_nc_oc=Adq0VXrlOu64Pp2lgsWvQKb8dr9KaD8xi2iY6g1iYdObEC_UbNBIUFjj8wgNxr601h8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4r98VprcHeYKusxO7BN-S4bC6LUCZT6ppit6bgRKUzg&oe=6A8D7A76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_conne
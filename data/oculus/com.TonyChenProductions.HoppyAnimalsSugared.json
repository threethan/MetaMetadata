_ss=8&oh=00_AfyF1pakzD6iCKELf0JGEUc3kKEo-luD1LgBR3MlR58OLA&oe=69BD465A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8NZMYCaMFoQ7kNvwH4nUXc&_nc_oc=AdmVsTHifbdm0k8VvInZTrpco2cXokwwp6OdRiX5nEV_WgmMVDPt9Kb-jlR9eVTiclc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAMOt0RM0gW4mT9qdp6-YqdVUNGF5Spp_nMzZzArmOhQ&oe=69BD5D03"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jVUAm9dbR8Q7kNvwFEqe_o&_nc_oc=Adnmm_TKQXqWM971zGs6klxWAeGqwaCEpkVftap7fNj0moqkyLWojShGyY7pAQHFRgg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-VMCzbOqIGiDbG-s9ok6j7xzeCblMKB5mN8JJ1yAwrw&oe=69BD545E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over)."}]}, "developer_name": "Tony Chen", "developer_privacy_policy_url": "https://tonychenproductions.weebly.com/privacy-policy--terms-of-service.html", "developer_terms_of_service_url": "https://tonychenproductions.weebly.com/privacy-policy--terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://tonychenproductions.weebly.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472916154481440"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "1320097829360589"}, {"status": "PUBLISHED", "id": "788950011666254"}, {"status": "PUBLISHED", "id": "1522431974615510"}, {"status": "PUBLISHED", "id": "1193780180983224"}, {"status": "PUBLISHED", "id": "1641318426048265"}]}, "baseline_offer": {"id": "1193780180983224"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1320097829360589"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3437992632928718", "version": "3.0"}, "id": "514780672327886", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {
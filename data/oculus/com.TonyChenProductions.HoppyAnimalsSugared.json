ykSARCz36YQ7kNvwF_6jsO&_nc_oc=Ado4UJDFEo3Kh0ikUItCW9OfumcQLYcgqAn1idAmXv6TUnwkyddb0pa4rfBnS1KjY98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WYGK8fsZcQMbTEpnBCddvJW8wh4-L2PvwlBdpDHZ3iA&oe=6A07257B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6c9oaQP6_wQ7kNvwEqgy9X&_nc_oc=AdpdnVFV23SwXqkk8d-5OkpgbbxfEzCOFa7PEU_PV0OSxPq0f50zU3WZJBg2tE0-YFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eXQAakBalG2YMdRJ6sIZofUSboH3zSWImuotFRVfttw&oe=6A072682"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsC6XsOQEScQ7kNvwGlBfhf&_nc_oc=AdqEs6uBWkbJFgc4O_3uA4e22XZ8ftuKUz4a19nakNdiBebOr40NMf6EQknKC-EqsJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60kKa-F6I3T3S8YZ_ah7psEkD4fYe9A4WcEIXRhN8u7w&oe=6A0735D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3SB5WMIhK0Q7kNvwEhAMdw&_nc_oc=Ado_TVsHrKGruhNr_2axDaY5UfbvVfuJrFAzbAmJqJ_k6w_ZIXCdKzHFxJ4KkE5vUyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KF9nQpifMBwq4sYHj7HFrsdNYoF8K2xHL1P39_b_c_Q&oe=6A071825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vkroE0R60sQ7kNvwETCiEf&_nc_oc=Adq2gdPrPbBcpLntsKa9AhRAPIQxWM7TY_soUL2ZJ3Vwor5TsM200WDbLDeQpv1Er50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aKD5X1JZQEKxpx2_ROgfD6v5TqE4IOZmToiQ8ikTY5A&oe=6A0739B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
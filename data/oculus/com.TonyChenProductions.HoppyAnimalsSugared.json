qUbUD626AYQ7kNvwEdBhXM&_nc_oc=Adp_72YZ_FbDPbQtaA1CBWJaaCWDM0X8ERaQVPzTP0pLz3WQyFkDX67YI1lINKhuzQk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOb9xJVEK5c-Vu9Fsgbr9Rene4d-M_ZI-y8vCSTgQXNA&oe=69C7DD7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_Iv_9h1sDEQ7kNvwGtewgu&_nc_oc=AdpSDKjgMs9Ve0DwzMCjq5l7ABPp3kelZIX3NT-eGBYsxGWTQ43Ii5lIrY6iUNXoJYA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfnMl183QC7SfVN68y3bo6ttAhRBRXAH-1DBUoxCjfvg&oe=69C7DE82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERxGSphk9OoQ7kNvwGBgrnr&_nc_oc=AdrGSjykCsJPPp7Osw-V42CBFvHRrXKYG_2wjXuVkyt4hZl09OzxbS897gfBbJuxgrs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzc2Eg6vuODC4iBZWP5t2Tx_CTJOdlWI92aRAC1Mwv5NA&oe=69C7B599"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwvwpcTzlskQ7kNvwF7j5he&_nc_oc=AdoTGdtjeIBGYWeaJvsP6JZxRaX702fXygQkPKUovaiViRM30BJRAS0ck6sWdgEk-7k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiPoXlH1Z0yttyXrpWodFdgHRI8be3Az8i3BxqsCj4VQ&oe=69C7D025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcqtDt3QSz4Q7kNvwE4aOjD&_nc_oc=Adr33sMoDlcb1kdeTK4dUtRpUZjlogF8ejOPhY_8bqoObridWO1i-BugGmw2pHXrZu4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKq-1ryyKgj5idc2pGNPOcdslFFBIuiFbe59yjQcUJDA&oe=69C7B976"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
7yuKLqKgQ4Q7kNvwHSYGxH&_nc_oc=AdqL4Ckc-kF64sR2IDsoHgBI2euTD93PJ5PcqDEtv4wI1pQpu0oaHX-rZKVn_EjMgb8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mo0kNH4SDklav8xYItEJKJIgeFdsYaKEjpvvxXCRFkg&oe=69E8D2FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqMEJ_1dcvwQ7kNvwHnokj_&_nc_oc=AdpQJJzPdC2_mWD5UAjKU89UbIDIqHW2ziOVw_izN1Ye8Z0A3QnVbxrNnbUIqECB8Rg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fIwuDKORHVLDGALEzLQ9SdVR98cmOrdMoeJa3Ct-7cg&oe=69E8D402"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xEdZ4xaPvYQ7kNvwGsd2jL&_nc_oc=Adpg-z0zA-qVhHg2pmhy7YkuLmTHy9gtHEwcry3kdlbwO8hYLCQsap50vQCTidvwk3M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30x6CZguBMZXbw4U0U6MY-XGjg-ZKHQWRU0htUtgBXFA&oe=69E8AB19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GanIuacddogQ7kNvwERVtu7&_nc_oc=Adr3anlF4fkwnsQgFXnDbG8boCJ1fNxKLa_YFnSy1V9TTWIasRxTuAVFhlw4nhRFPxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2izdZWGuY9q8NeDBQ_gVsx6SaZ8pmg1uTzz-F3xVkZWA&oe=69E8C5A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9NwOvJTh7IQ7kNvwH5lKVn&_nc_oc=AdrBRLImqQT880AWyAhTNNO1iRKNGbfa9l4wVGmF3e0Bo2mvuc0VLLQ5Qo90NQvXRr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jn6d_UBdN-VArcojF1XVCRWn9tXgHqyiTA6BioZeqxg&oe=69E8AEF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
eXGLZf3Thz6t2UDz95w0Dn0GifnfTqudAaXHwFrStBHCXsRHXspNrkQnlU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36hoQ3qSmpIkdm59raLDst1Xuzux3QQvPidL4dVMialA&oe=69F20D7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAKw0G7XD-0Q7kNvwFb-M-O&_nc_oc=AdqoPjtfq9u7TJsQrNm53lyT3GjO08aC4w48L_4o9b6iYKKf4iP9UxNPi9KoyMTTKck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tpiOOeg-1_TjB4xwgxBNHorWp1ZOBxXeocquZ1yBJsA&oe=69F20E82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwlQXemzPfsQ7kNvwGCDTdy&_nc_oc=AdrQ_ZPStYiP1lH2B2dtCccmPCcXN0tUxcl_I8w4Z0jVipPutQsJxViLD999LAZC2dQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2e3izocBN-dTikunlJavfrU1xgOImihkqFgWvrtgqfQw&oe=69F1E599"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVBcI20lNXEQ7kNvwHKjUux&_nc_oc=Adrlq_StWqaOeUtyapZJgbLXU1j2zqNJNGvDPvkzphZLDzZtxDupkO3IP6WRoo12tWA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2clSsal3RI6ZeWUEBnAA14Zf92AD_dDyyrMwMB2CteiA&oe=69F20025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwV233teLIkQ7kNvwHGiPAp&_nc_oc=AdrGSY2URBQ5dqwtmrB9fZtr1AMuKRtWt30IJDuLbCyerIwdsXcEIjqBC-tD1cua4S4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12CyCzRy4-qpzhPjF5Y4XzqH9Ejrx0enZiYc6nfwJIHg&oe=69F1E976"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
y3PxJuy8CgLm86N4KQscBhtrgsC7Fs1T91hHe4w07Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB8tQgCAUYvCFVEcbtVr6QVFZGS807O8zUmoZDxeNcDg&oe=6A9C13DA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd7BeaRyK9EQ7kNvwHd6ro9&_nc_oc=AdqpEhSiUojnkWmbmkGxHqJr3WN-RVkDynooax1I5lrRfD6BJmH6lpzgjZe6vdVxIl4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkpm0VX164RwfojEqkesGiyZrb2IZrIyh5LPq4ZrbLZA&oe=6A9C2A83"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_kCaGD0mnoQ7kNvwFG3aMP&_nc_oc=Adp7AzKEoSbcaye0sGfhu1eNGfCyG_JKqIywjmDEzNdOAss5Yr1zTz-G1YwFMh1M05s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVBXpM-Or2PrX8GfnGDmuXNvZjhI1cxlqqPFlXxm3J0w&oe=6A9C21DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
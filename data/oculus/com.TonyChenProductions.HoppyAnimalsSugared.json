J1c5S5Qm5wQ7kNvwFqjSuB&_nc_oc=Adp9MrtNEliczPsLuVjfMpM8TNnf0E52w4hTnrh9ZxxGnrsNanE-LBgJ8OLDAS0BsEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TarV2AKhWU6FOSX7TjdfpimCA5QBe2fNNEX-fpjFwBw&oe=69EE18FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re93dJj0NSUQ7kNvwHu-8Qs&_nc_oc=AdqyDvAvFWeQRu--FhwKBCpKX4TDTUzKdga1BtXh_Wr_hGOE0eYOsnQDzQxDpkWCxvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af041o1JDt2cgfBca-w1gIqJAzc5WI7Q21XOsb3-xItKAw&oe=69EE1A02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVioxdW6WuYQ7kNvwFj7MzD&_nc_oc=Adr8GBk1w5ogAP3p1-3NbDidEORYmCeL55BeopS3grC5cyHMTZnf1Dwtzgo2YQRgA6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E6cmioQQSnnN9K95Ar-Uwf-skQmg0h3ugiKAOh2T3ug&oe=69EE2959"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJQy5D4LULsQ7kNvwGyVRxd&_nc_oc=AdrDLnyilDiRrbdSV43HnfrADN9koSWt3xSfQeTHWrIs-_p9hMJIsRuLNUo_fUI9ylY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hpkbn52jVBfO0N0wX_wMHICo_xmZQ9ke9vcgRZwy_aQ&oe=69EE0BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdic7vTSZocQ7kNvwFYDxV2&_nc_oc=AdpIiMskWRnFXwsuEK4g6E_J68FjoOoazosL6tVo8vra69fI9Tcf6nBiZn1eEf60_SU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gA1IN90naSBA-ndh_la5QIA_XpX228dnwPi2hET_4aw&oe=69EDF4F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
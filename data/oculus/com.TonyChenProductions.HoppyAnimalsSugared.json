fbSL6hZQDtyOaM0ErNqwRUlgIngInKBxISKQ9u0cAU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CyPvZFi2JcRGh5TIzYV2ONfiV6ewqG1OeLwJivmbvsg&oe=6A0F035A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLQyys9t-CsQ7kNvwGJ-nsd&_nc_oc=AdqWXISMEYHNNRWM6Vom8MIiPS7XRbN1ikhh6XR1jzfOd8ad6ON_A2RATuklESRHgVw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tS58DOgiadjb2i8hLrFMnP7c9XPw4Kz4ySAQukHO5JA&oe=6A0F1A03"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4MFmVD83c4Q7kNvwFjrSpl&_nc_oc=Adrtc5R2EYr81sHutLHp0o-eiASSGsya6kSKHAAEJAAuEnYvHIcFrzph112p-5bZyu8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RU46CqwcrRx_gpkEosn79u2Urg5gtwYRb67RN9sJ_8w&oe=6A0F115E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
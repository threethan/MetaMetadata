iHjKOfykaoQ7kNvwHV10Pe&_nc_oc=AdowxhLbBfMcLtHcLlIAbXqqtf5pzzT2jAnvX3sGyVpcwbVfJLCgRunjtId_93WznQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KZCA6Jt7bMeZUA9QEo8CpG7YZRDYlgBbwcqVXmbFS7Q&oe=69D50C7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qztM-GbLJskQ7kNvwFz6Ml-&_nc_oc=AdoGK1BeKIRBl0OJttbs04N4eg5Rc4FOWre-Y9zGUp5BPWfMBUlNwl4b1WUCypetcSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Btz_zte4Gj71pGjNH0Mw1iv5gFjRinkKfnepeFYreOw&oe=69D50D82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhfAu_RTRHoQ7kNvwGB61G4&_nc_oc=AdpRuSZlRljLSaJkwhjQAAEYMwrlswix4y-3mOo2WBm483a_ms8cKsLco2CGGkcB0qE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TuzLRTurPGqh6ACCagG0s8mtYRJ6dXGFfQ4XPhJ7dvQ&oe=69D4E499"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gv34-qC1MgwQ7kNvwEkLXWY&_nc_oc=AdpS29FcmFiZXcgI08Idfo1uKEEv5ZCtr5Eyc4Sw8RQ22ccnKcY7pTm5MnJqSy5Vxqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dXMk5fjy_nr8_Y9-_nqamzHo6MxLjkFGaJX2Mu3ukUQ&oe=69D4FF25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8mUGlZU3GIQ7kNvwH_Q3mj&_nc_oc=AdpNYfSynzj3suU3qiGH_X5izMWT9HkWdZqIoEvFNu72o8s6yHONmouqfpqgUXmnI4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nKgOobhLcnM_bsB1kNFcdQXZfCZaeBGPBlSlyfMLdgw&oe=69D4E876"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
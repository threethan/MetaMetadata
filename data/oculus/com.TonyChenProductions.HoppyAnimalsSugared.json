LMFqbR9ppAQ7kNvwFL9nyR&_nc_oc=AdpluCNaOCxaFo7C3hnoLyx6ZQPt4KQnD6urQc53crQHc8nUpTjxaSGRR0U42zilAB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5ETlonW3DH7PbtGbjZ0D-ZflZvRCKMwUNDAkBPHh1xw&oe=6AF35A3B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNxHmMmQDUMQ7kNvwFCU3g8&_nc_oc=AdpJOVDmFyrpisGBjeQk_OCVHgUX0FES7pHsh2PJEizdHYQRYfrtMOicYBgJxIedX3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYCKM4R_ysjyn7i6iw2TUL4lMEtaauIs5E0AfBcH1tAQ&oe=6AF32302"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJDZgTzQkYcQ7kNvwHahyud&_nc_oc=AdpgCTirCMzQHVkya5adtixYzSslBeQer3IdEubM-9506PFu2MQ8trEY5axLDUmeFPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFnKHJSrvGJLHLi8YZkKo2Hx0rMGYFosW6pvEQKrq8AQ&oe=6AF33259"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=solK-Xiamq4Q7kNvwELOYv-&_nc_oc=AdpwORyBK1hdAPJ5CT1DeYTSamzcNgsIu_QLuN3nhsYnq3n5eMxFGcIRFvixs5b9S7c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCcI1Reg53_1tukiY8-IWHASAIlSgD2Yc5ZVWv9EqL5Q&oe=6AF34CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H74C-TokLcQ7kNvwEeMf5e&_nc_oc=Adqkf_dvm0xOwXaKCE9aOI5BshXmNiZN-Q4e0RCGpCS4DuLI8SX6U9AlHzXMR_nfqJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOTgXjW6uWLnzOGWf9ArMtwFrrlEufPyu4FHsbLYqEXw&oe=6AF33636"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
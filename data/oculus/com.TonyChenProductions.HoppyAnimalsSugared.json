je3s_GYJUsQ7kNvwH9I20y&_nc_oc=Adpk7HkB9l-3Luj9bdFTxb2yDo4iCiGLwRVT9CRlG_4yNNmR39-W3LclZard3aas4Rs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSuuI4OJQGA84rxwvoNs2JNddklPh0qqDg6AvNJ9S5Kw&oe=69C3E8FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq5XyrCC4LUQ7kNvwFtm0NC&_nc_oc=AdqyjJ4CXMz0q2IRv8bNCzH7K8CTCQhP7JtYgzt2b-utoqRRXm2sktp5sP3gSW-y8Jo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5erbZjGoBBn-5p20gnEyatNVWl6i78bHvxuQBr3FHKQ&oe=69C3EA02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaZcMEU7BMQQ7kNvwFBGHcU&_nc_oc=AdqEbOTsVhCP9X6ZdVtiqnIroZDflTytFHjCRBSV02tWIk6NXEHuQm6V7Q4rctHDrAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk1qe2aMno06mBmY0R6enxQGVfOhVRFz3yy_E6J5EINw&oe=69C3C119"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9iMS76CYngQ7kNvwETvyQC&_nc_oc=Adqt7B6ZQiXC0RNILep7j71SAibIjudx4pyzGXkAKCaEiaToP7Nb5g-STxvJcqPVdz4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQTz6xu_uzG20NGosiXgEOnon1DoTEF-np8DvStxkXuQ&oe=69C3DBA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI4XSb9fj-YQ7kNvwFLTtwg&_nc_oc=Ado8-lsknSLxBh91DusT-edFaigY3xCkFXHZJ0xeuqcsSMKa6XImijouCykXt3fyya4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwASz3NNbYHunwwyxYWSAjAvUWWLDfcMZ2CH6LXSTXpA&oe=69C3C4F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
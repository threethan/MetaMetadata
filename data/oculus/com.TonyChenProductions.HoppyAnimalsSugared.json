zZeMxIPe7gQ7kNvwEZXErg&_nc_oc=AdoXEVaaBb7jQXZzUl9vY2dQolz-AOxn1RCt8e_oip5_brrUsSVDEHtlmjoB8KCLbA4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TN-8VrJG5rt0_fWbaIz7nDHJ1wPbZHdq0oDFOMAb-zA&oe=6A1C3D7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8naZVzhC-EQ7kNvwEsh01t&_nc_oc=AdpCiToXmIzFG5vG3fOUzSyHpGbPIsJLZpzU4omHdg_gfUAZLhQuhrU_Eqljq_InhbU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GLfnFGv0o7kVqnoDzLJ1qC0wrL7yRufcX8m_iV_8fpA&oe=6A1C3E82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNf1gsfXLroQ7kNvwHrtzeR&_nc_oc=AdqbPwE83QcMTS3VjMTMguKvwkoyBly7mdR_LlP9SBmchk15Hu5NFV3Rg96x0PqQ2tU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qAgpMdlwjFcBjdE8D5_kiCPy8RQJ8bhszRojp_rvvHw&oe=6A1C4DD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgKwjGAWUCEQ7kNvwEzz9xl&_nc_oc=Adrxr1UI8YlJubGzI_ZCgWydaC2P2PZU-FdPwpDxMpKZU6NnUhcxHYz45ctZoYWz88w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-eGem0ttRvfGHOXm3kUUxNACQjPQ4yG4C62iVHMQs-g&oe=6A1C3025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP0VUhk6OnkQ7kNvwGedeVj&_nc_oc=Adq8HhFBdQ7x3YIquwu96JPJhQXYOxs8dBudP8QRdQo1hT9qa1F07el2-O_OnF3xwR4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J49481yXTdyyGMkcuuQZ21S7gCJznSRd6Z_O_N8vxjw&oe=6A1C51B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
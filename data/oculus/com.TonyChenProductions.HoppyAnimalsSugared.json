Z1rPLxsMFYQ7kNvwFVgCm7&_nc_oc=Adp1dl_92WYURAOFoW_x5yikb0wHLpvzzMaVvidGDl7uMrWPIpcTEJNKiSdikoNZ_dU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s82CUTz8w1niukzAW4gVfm4HhYbBDDY8hVt71Y3JQVg&oe=6A26C97B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA8FIIojT8oQ7kNvwFW_TkH&_nc_oc=AdpPvy6vSCLodrooFsv97t2vczx2Ie_O2cpS3g_LmtNbHztxUIv3u8w6jt6LTOdWM1c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CXwqkGWbTxquFSoXFIHgXGAi4ixJZyRc9ntKERUVjmg&oe=6A26CA82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl3pn8OOjO8Q7kNvwH_UTC0&_nc_oc=Adqr1jewbfRFnICEF_nYiIuxbL2gd8FR1x6y4Ukse_oksWkSPBEW_Tie_S8PcLVBNKY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90IjtSr5Lghh9uHdeP6E3xYKewvHmeEOG9dh90qbsOvA&oe=6A26D9D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAqJFYPsvdMQ7kNvwExNffS&_nc_oc=AdphjIEUqWRMp27L-jxndd9jSfH2KhumpbOoKpyU0gCWLneiV8GtfCEh9I_WAHo6UPc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1T1-kboQC1CUL9JTIXbMX-xVLIYU4OM6-9FCvJNJJ1w&oe=6A26BC25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LioRR0PqYs4Q7kNvwHHSLDU&_nc_oc=AdonNqhvkeklV1xnF9rpy4fRs304cgwbSn2mPjwkdMG1d01Lwwbc4eZyNqb3A5TLXE4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lG1NF2UpwZigPm4yPVOIxRfP0pNvFcruAMtLmXfU3Gg&oe=6A26DDB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
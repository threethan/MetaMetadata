Lq6tB-AVeoQ7kNvwEk50a6&_nc_oc=AdoOMlZ6QadQ9sUs_EWbz0-dsILxz5Hges1tWTqz8KMvKjgbVF5yMbFUMwEOjskPfQE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-kLBL6vLMRXo-ucwpFidAwzVghAvUtqaKL7YDQumEgQ&oe=6A6F4BFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYMb9GyWsU8Q7kNvwE_CGQM&_nc_oc=AdrO8Rx-OECSsh7c1K-lk1T54xYVsr7nW6PXj_FDuhx_ftMKfFfrEBgcjUdOFnlHzqY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASi3ue9DnArYbyFME7YwXVtwk4dENpzvw5dH2xSDk_tA&oe=6A6F4D02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKRKIhkV5GsQ7kNvwHDL-xW&_nc_oc=AdqC_C5ftj2gdAM8EVJaMA5ox9JXGa94QvQFHTEdTub3ZopGGlSXK8oCeCGCAq_wVzY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLz-WWQe1uiZ4CrxrTqvx6yxetznw5fXyACiHVjC1sHA&oe=6A6F2419"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVq7oziqPUsQ7kNvwFpLi3F&_nc_oc=AdqA6aHEtXRbYWLjSNlTahPlqhfwktt976mw4FJ9dYMN83MSVta7qGQx3ujD0Vxto4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBtMhON2HCSmUyVJtnsf8LgUVtb2aOOUop9NFBGnwVIw&oe=6A6F3EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PopoVAZxWqAQ7kNvwEd-jKP&_nc_oc=AdqQlCq2AVLT_PQx-LbEtlhmr1HIH-NZIHWxFMme4wUJdT8Vl_TJCeNIlwtO9EQWjgg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVXRtyx-rB7tM3gM2JXCdC27ufV0v_5cMxo2t9YocEQQ&oe=6A6F27F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
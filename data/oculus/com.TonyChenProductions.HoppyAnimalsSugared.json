h2KX0vTH1MQ7kNvwFQhiTy&_nc_oc=AdpL0CuY4UK5xWsvNx6rKX7ecJcJoISPA4J4SLCeE_D95deVAEshV02jvhOX5ZBFn2E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-_WTQ353uAiiM--GWldfxl-cH2Y8jOy7ZJ4Ov669oSw&oe=6A66117B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsxyEgp0vr4Q7kNvwGJnMR8&_nc_oc=Adoj_k_B_FQpPGrbuLPLngzcJEoMas5418X8QdjCnrEU1ljpwupcbGPz6EoO5TauDqM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6T11DKT164x2HOxYbAxZxnFocHF4yXWdA9A7O-s1lXA&oe=6A661282"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuTp5bGVtdEQ7kNvwHOwjrX&_nc_oc=AdpJK2hnR_norl99gR503AcfKM67expcXkuhlMKj68VE88Gw9aBgRHPrAHUt-OtURxE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIOCUWJf_FiYywpYP8CUghKnDzOsXKLSml8lkPFPG17Q&oe=6A65E999"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2EqviQT7BEQ7kNvwHHNVRt&_nc_oc=AdozMBKYEJT_HPiLnXP9Jqc6qAE2ukLfooWHj7Tx3-qT4rFwf1BwLch55OP4m6Qh7MA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2xFOxa5yq8yMPaYqFS1Po2_aMrPfYtljPmahqc54K_w&oe=6A660425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMtvvDHWEy0Q7kNvwFTDNyE&_nc_oc=Adq1klhHItEANC1VyMoOijqJgk1aqTvnxlJmvutcZfjyhtJw-2Uae-0Jhghx2x2y8X4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCYqFapnyC3rFy2MayLsidSSavu0B0A06pmljIy8Gq3w&oe=6A65ED76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
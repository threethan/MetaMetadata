Z1rPLxsMFYQ7kNvwFwbZlw&_nc_oc=AdqDJfUGA91dnqO21tv-sUCg6gE6C5XVRVXtSz4ARBrnQGWekfrNDo9JfP2qKRN5hs0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MaR_6mwcI7mG6oHNXLgN8lKmqljHb4rgRx2e6EjXoHw&oe=6A281AFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzORduZgkDMQ7kNvwFBTdCd&_nc_oc=AdqZdzeYetY_Q29NPWkz8kFbyth2lqFjV4KTnfdyXyhdW3PBxi497lUKpG4cV80RRrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fdi9fOAsdow9xJKH_aPHW4yHGB1emlhmjSaeQlk5n5w&oe=6A281C02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl3pn8OOjO8Q7kNvwE9zirF&_nc_oc=AdpOfg-feMQ6vGdw3Q3DSMRgerGyZIc_34oh1f9bk0ISQnZOec2vNfXjknSVCEmFWHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V4hFqExCr1BcMQWVDW_472-naU-NjMFxw61_0EGFnFg&oe=6A282B59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtUIJNmXaC4Q7kNvwFVIQ9o&_nc_oc=AdrEpX__VoN7e-it6uSzj7CKGt3EFk3rc8LWhru9aCgznFy7YQ7HBddZA9fMpdFl9WE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CtRMT0fLQp1QssBx99__bq_NS6EkXjIleogAK9S6hdg&oe=6A280DA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LioRR0PqYs4Q7kNvwGl6pRm&_nc_oc=Adqwt7Ovs8ItnrBPzeSOIli6HMz7eP5wM6qznpz077WFA79qIF63YKGUAWd0ldq200U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RUT9EPCpbpFrthoUwZy33dLWAJ5SN25A4dBnmvST09w&oe=6A282F36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
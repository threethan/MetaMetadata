0RTmDZYceI3rH88koF-DoWx7HxymxbVSJaMec6kTqE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdpPkHiIbgQdUXb4Hebt4yfRRgh7osxZqwRckr6gMyiQ&oe=6A8AF05A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVrxmqzl0BgQ7kNvwHAFnJV&_nc_oc=Adp7uI01dZ5ihRTyX7ok8RUW9a0MZSwMkppjqo9VpIijEibQjqrlClCJZ_Sqd9R-NlE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd6uQwAUFxBwAnUoEjH47TGClVKa-FxtckjKXiSB0gSQ&oe=6A8ACEC3"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qQlbR2H6KUQ7kNvwFUHPjZ&_nc_oc=Adp-zuhM0Drg23-GoZrX8Hrs4hAOg_Y8nKBkHZHnD2TUL1iHNkO9ke9ZEpaMUHoazIM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEshsu-ao2er8DqxeJAyATsgIXGtAdO8pBWqkjga_JoBA&oe=6A8AC61E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
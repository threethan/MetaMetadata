vEmIhC_XncQ7kNvwEIBM2i&_nc_oc=Adq5KqQ55t6ko6XXWTMm4iDcWkokuypSAPUlzzRniplmb2tkQF0vjvzggRx-rM3kz8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL6cxcz-mVG7lu09euQP4HzT2zUtxJdFWrabqC8oiZ4g&oe=6A636E7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsxyEgp0vr4Q7kNvwEJzeH2&_nc_oc=AdqwEoPRbZ_EQHuHects7wv-Cdy3xg731Rvgx6RjwCEa_hD7MRsjaZ_3BuqrjsEMDOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0P66e229rNkztSYeFz1br0LxbnAgZ6CohKGNgAZqeiQ&oe=6A636F82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7KH78X24H4Q7kNvwFRMQRG&_nc_oc=AdqDT54ABNRkGQGHgHMwcSDDbO0A-as5SY81TbGg2eiTjzhkM1drWGMw3NuYME0YmvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxSZw6AfJL19I9vHQFS6OW6b1ZEJnrMtwP1lv9tz4q1Q&oe=6A637ED9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2EqviQT7BEQ7kNvwES1tpq&_nc_oc=AdruyZhqAGXKBfCqbaL6K3feuy4BM0GWTeZWKlwcIgw8DK4Av0cSyWiVCsgDvS1cvd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRwEI5ALCdfMIvtRUJDm4vZ8YMUCNs5hQ7vyfB4yHctw&oe=6A636125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5qWhirLF9wQ7kNvwE4aMHy&_nc_oc=Adp3D_K4Smx1OhWnIALwKxPiMbAgF4xSnjyjKV72uHTEYBzcqfSM6qEhkB4GbXGljIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWHQ8fmtlgU05hqS_ce_orYOx6q3TSTYBIN3Md5X6HRw&oe=6A6382B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
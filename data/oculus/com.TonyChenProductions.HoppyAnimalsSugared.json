HPyS6N6ZKEQ7kNvwEJ3XtB&_nc_oc=AdrqVcCFQyrQR0h1Pq-g-cz0IZ5NWZeboQTH-giqhvSS65gozdCK-wpOkk3wUlgJrZk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRcCj_ezNZAguANOrxRQdkfKv8GLa8ARTniqIVO0CxFA&oe=6A5B857B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBf4ljzABJsQ7kNvwEh1a3-&_nc_oc=Adr7urXmZSUzUC-2qUX3rTp_NgsPJEnyprUxx9Ig8648vkosq7Pzyi-jKsn1VO9TjuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyI3NSgXTnowrkInfXcxf7kKTN2aJZ5KxYztawy8siLA&oe=6A5B8682"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5o2NvX5SOcQ7kNvwFmHgZz&_nc_oc=AdoRhQTWPuV0eFO21v9AJBXl164kUxw_0UYtPElADFXDvLNNqE1HulyxirNpbQyaZQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANbdyyZOnBNDOdcguitSfqSON-1pAJl_Jy3yVCFEOYzA&oe=6A5B5D99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijmcj2XtXR8Q7kNvwH6dZ6F&_nc_oc=AdpcIqKN5ojYHecGKD7BEp9nJ9uNd0fkOrTJclN73tBXf-ChJE9HWfjznS915ermY0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQwiVpxakgOVnVsA0fygVlY2UOQTkglE5M_U_VrUiQSg&oe=6A5B7825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTI-NlGZZ-gQ7kNvwG6yVJJ&_nc_oc=AdryB0Bo9bwJ5XTqBLDTlNA4hy20eY_LkDkvIpo4Y0o2gqXJklgyh0lQneDUnrsFd4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbb8b41o0ljuGdrI7lwoGSr_2vIJike40J9VsIHoBJWA&oe=6A5B6176"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
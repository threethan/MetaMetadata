3qzs3bR-BkQ7kNvwG6_jDT&_nc_oc=AdpqDaTzWVZtXyQzxchhlFcFP4cQgflRXC7k8Nt8OQmBgFfkG_8uNH7wBaltT7XlFTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af702tak4J0zNvkL7uf7zQwst3mcvvhOX4voOWtVY9XDBQ&oe=6A15A5FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr7yP1WM1ggQ7kNvwGO4ONd&_nc_oc=AdrHAUSVAcqW3WcXyMdYhs_rSiT9ggryP-fFIIX9xmmuzNq0uyD1988uNmjCXkpC_lQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B8rpalfZhDewkON7OvBrGtQ3GLRfTj-oWAhiORPBWfA&oe=6A15A702"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9axtPGCFLKAQ7kNvwEJOEFW&_nc_oc=AdqExlSylg6tXM9khSjGkOqIIVg8QYNYpYdpaGy6nmyvWLezyo3fQIlzMdoqegNr0y4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af667d_l_zItFGxEskU6b5UjmelLvjBa4hwRSDMz80reMA&oe=6A15B659"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMK9M1ihXScQ7kNvwH2mubP&_nc_oc=AdqgqDE7AozOsdbBB9RCQDTyXKsyaOMQQA7KsGPzlXjRIniYI52nYiyITMYkG199lt8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nXT5Qt2dEWb_oORa2N_0cw6p1q_XyMLSpX1HOsBoflQ&oe=6A1598A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjV72l6qch0Q7kNvwGY2B9v&_nc_oc=AdpoW6kXh9Jwy3Z4dsuzgBaaTnNeh-WcHd2fZ_rNndFEnhR9fZUZEJGiCxooIeM8MSY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L0zHxVI3k45tDzeHt8203l8t4Ie6X5nlBMcQuNrZdew&oe=6A15BA36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
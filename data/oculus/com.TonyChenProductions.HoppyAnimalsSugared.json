Me-OqscJzQQ7kNvwFn8Zcg&_nc_oc=AdqY5M5qk82RBCQ37Y-H3pwLjpIUwejhQFhjAjUfTfZRBjnPZbF3-0GJITPfv8m9kFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa7-PTVhoInBOeehOOPu35yW6LG_iG8xKjO6PARQ_-OQ&oe=6A539C7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TySDXzcIA30Q7kNvwGsP1Zy&_nc_oc=Adr_waPKTWvPCjBWz7lp2SCbHDDlWVDKgMSl4FOvVnZ3QiqC2h9ZW2v1M1JRLnrN8-c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlpAJ7UtiBVJin8WZvvEJGKt2_JlU3S6N8HdOwDY3RIA&oe=6A539D82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8V8m2tLeDZQQ7kNvwHKf800&_nc_oc=Ado-dmtLQZOHVFHsuFmWKeDRGbAXxAz1nKG3saUBimB7iFbBZuP9NMhQzJBzcNCUVQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8oGBML_9BlNttSdJtL4x1D1vCcvotDWB-rtX7XzUAGg&oe=6A53ACD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRGmHuMDTqcQ7kNvwFRw86o&_nc_oc=AdpLnp5E8kakYT4yuwIJ4W7C0Y2ejcV_hBV8fTOfdkN5fNNXV9M6y-YiW3d9r52nqiI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLt04BuHMzClCeL-wg8a_dF0TL9jPrRJNtGn_yQBYqbw&oe=6A538F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzV1BREuZ6oQ7kNvwH6Pubx&_nc_oc=AdpYxFePCQJDdGeK-tNBeVBh4gupMmM0I9gaTbZHoV1I-TvpP-Xd-bF1H2PYCELXPXY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArLNbzUq4yTwzy_nr4Om4nlIJ3auI6N7pVPLzg5pHuAA&oe=6A53B0B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
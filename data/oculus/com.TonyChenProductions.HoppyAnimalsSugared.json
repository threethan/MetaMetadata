0hu2GVNGdVJlrcXWhaJwvnyhY6Yn2bUzLcNTpLMaKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC01vqU6H3Ou1WIADPnINDVuwYwPe_ob7ggebo6NYgh2Q&oe=6A6DEF5A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22DqGDnwXWAQ7kNvwFJKON0&_nc_oc=AdritQcHn8G-_fVnDNnoMsjpFsOWKosj8D-SpVjd-fckgeVn-GZ5fEefKBAVkYFWP8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwi_urDcGlrORuTzZUedCPnYFuR8WLdkzu2rmRgBe0Lw&oe=6A6E0603"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if8Y2pomCFQQ7kNvwFyLQz_&_nc_oc=AdoaCZo1MVK1ySV7O8hOS-523Ii8W_BaFCEmf7qRNQ4hX9QhgArPUXFgiVJD3MPc0bQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNCe5bsLKDQ-atwV9o297C-vsZuYeEgJCoc-sIh9Mgmw&oe=6A6DFD5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
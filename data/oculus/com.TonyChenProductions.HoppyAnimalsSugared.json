p8P6KZeZQ4Q7kNvwG4XxJM&_nc_oc=AdoQ88pxvwC8FzMVrfbj4XA3wh6HagQlhzg__nG9mZzTUz-GxuJ-20k9CQrLZfnHYnQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H7JBU9jsZPJ3pNeyAQH_I1ydEYcPVWwE_YEVZ0aQrLQ&oe=6A3A8FFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4AOy948NvIQ7kNvwEW4W8Q&_nc_oc=AdpGGVx5w-BL1J5cApNSs5W34LiaCb5zFQgGY66AVp9iQSHC1zr0mz0fpJxdyvYMmUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WeoDVEhKNNtm5ka9kQQbBJLr1WrS661rv22R9UJu_nA&oe=6A3A9102"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs8mkEMTfHAQ7kNvwFwZByX&_nc_oc=AdoNJ1sKm4aFJW5RySXwmz7nao41o4CnQ-0irhs9Bk2AQtWbKWcfNQVjQ7p3kdcb65U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N8zhT9aspzNkfOnnG1bimPbm1luHypnob800I24zrLg&oe=6A3AA059"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciheGf8nx7YQ7kNvwHGz-g4&_nc_oc=AdqmkksO52bOtXzpWbrZIaSTNEdIyLZapspWoXySnDsNpbnpB28IvKVYOsb5ORlZeww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D-pecSvJ-M7PAWoMjmWTa1pRlGOo9TTyfnW51g4H7iw&oe=6A3ABAE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXnTX0Lq8c8Q7kNvwFiMWav&_nc_oc=Adpz3gljTqLGMJpKsYczyVUvOnq3HPYmIY6IHywuKhb3Q14dEWq7IC2UhNAu6FhPvcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2xq_-zl7wNFS49bUFfdrVSYuNmRCKeXAgoR8iZaAehw&oe=6A3AA436"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
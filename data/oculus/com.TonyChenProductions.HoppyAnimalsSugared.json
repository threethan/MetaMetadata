w46y7I2XpoQ7kNvwEywSUx&_nc_oc=AdpPiaZ0vbS7SxUnnxJ3Yfo-HN-atDmAhzeqws4zDxgVmker7qjcMOza3FNdB3hl7Vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjvT2anPsraEuEMwl7GZVO6Z9SeO7KOQfhp45jUgxLuw&oe=6A4D04FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3YhF9hwa4cQ7kNvwECoq-J&_nc_oc=AdrbEmdBjoOUgr8XAJUakvW8NSy1ArVv7wanAW6wpiz6uWudahkMxtkrbyAvDP5NCPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGCGsZ6fppJmVNuxQKDQEgVv9xUQLE4Ivt7I79e4efbQ&oe=6A4D0602"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDqeQtUbMZYQ7kNvwEWQAka&_nc_oc=AdrxcCHrztOV9s5OV0-e39RU5pcVJtMknpwDZYeSN5cmKvtwzqD_x8blsMKFCac6sfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ2a6h8fSRNMt--sXLrAPLwF7vJQoaDtYtGaKEExUjiQ&oe=6A4D1559"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEvbf_dd1bwQ7kNvwFe1H6R&_nc_oc=Adoaq1rcnRNVkwt5FCvIUoQcxGMgaYYByQsca8Stu_C8gYmT_tG-4-ND9Vb0eqZ7z9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrhxRSjtDF9QbIB2yI6KdBxBLz5N7vSyMNyGQKrdhk7g&oe=6A4CF7A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpnQne5bZBIQ7kNvwFxtiTI&_nc_oc=AdpqvgKpObPg1-jpIYRHDD5odPT666akYGtY-Hi99f9yfxn6WSy8nOCdAeUix3YkWQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3VZjKxpMVfUVAWM8zhgP806NhGxwDJnx21SDgtlwXNg&oe=6A4D1936"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
ruT_Er840gQ7kNvwHEzqfm&_nc_oc=Adq8sN4c5IJBeDBvlgOyLr8Zujax5sneqmkpehwlQEp7Nsh8MSXjf4xNsbvTairFDw4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b6DYDqGcChuQ-yWHH416O0KIaVhwWzxImC4ibWMybEg&oe=69FDEAFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oB7ZVykXjTUQ7kNvwE3DmRV&_nc_oc=AdrsVBMdDGPxSGMVls5m_2trNM13B6DNmJDG_COk97fBKVA8pN8R41nfCiitBnV8oKA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IaH3OjiS4PsaA5-SAPcZ86kOEi2wMsMt2pNSGDpQ2sw&oe=69FDEC02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85E5jD0Fr3wQ7kNvwF1bx0Q&_nc_oc=AdpWJgK8V4zPgdFjD1JVzEZBkHThLs8qN-jM1Q75w82FHpPpzStk4Qeetg6o-6wuylQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52zsRilgSG5uok_XMdmeo11Zc5OS_pWyvynyDXP4YWGA&oe=69FDFB59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydJkAf3yge8Q7kNvwEljeCe&_nc_oc=Adr5XJsx5gNqSPAhkKHWlD9GiB_F4B0lEdy7_ALqsY3OvFcu1wvBCmh2Tm2sLOGRMNA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vaR4ILkDYAE4xc6asiXwIX-9i8pOH5rjCWZqflugOng&oe=69FDDDA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUs23lRdbI4Q7kNvwFrrQXP&_nc_oc=Adqe1hKs6MPsmq7-DxQ13UekIAbaQ3pX8k18PbjVA_sJ8hypN_ijZfCIwzMtgqnlLVQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p5G_CWZYeWpg7BWsttTZLXXRaUEoO3Qpf8-R6PYtEsw&oe=69FDFF36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
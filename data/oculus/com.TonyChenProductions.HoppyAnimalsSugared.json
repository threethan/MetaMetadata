J1c5S5Qm5wQ7kNvwG5IlGo&_nc_oc=AdrATMufwR840jaTdOPGYQFIKx16ZMDA-8tzraCvWkCEXn4tDp6_pAtBaETEIrYI3jM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2C4wsKoFAkB29PtKoshlaiEIwSLRW6hjqXszQGsKin4Q&oe=69EF6A7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re93dJj0NSUQ7kNvwH31GcR&_nc_oc=AdoT-SQM0t3235H0DeOwrKAn5pJQXQW07twiUhhhd-WwLHmavPUUFNvWN8LJoHUOyVE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RNgd-vkm6AEVNArHeL5a3if3vouZEewZnVL3zZebRZA&oe=69EF6B82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVioxdW6WuYQ7kNvwEaUyxh&_nc_oc=AdpAyQnxyMTM3euSPDqhk-9OEiRq1YcNkwZ2B1wbz356dKWOL6erixZBj2P4AfJq2WA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fePLVYomMKFjGN01TQMeIOwqJjbmR7gfYP2XLOYFbYg&oe=69EF7AD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJQy5D4LULsQ7kNvwFTp9eB&_nc_oc=AdrxLJMjZ_jY5loMt1bUZtsgmP9FqMEmWXlaRIahvi55PAj6uDESK45sOBW8ZBG4z5g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1W11Zecv6inwRQVhDnIraPQfYl28N81Bsit3wxBtVs2Q&oe=69EF5D25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdic7vTSZocQ7kNvwFOhqZ4&_nc_oc=Adqtn2LLuQgRLUekJKhpBoVAEoLTOcvYjMT_fEjHg8fBuDoTttIIwoDAughC6Dmp0t0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Lrjy7lwsZYXQaiRoUoOVtPcPP6EEQQNaCQSqkSbFg4g&oe=69EF7EB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
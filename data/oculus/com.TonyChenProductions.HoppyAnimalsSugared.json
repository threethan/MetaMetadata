BqHsxuKAh8Q7kNvwEm5cXS&_nc_oc=AdoFgSr3xb_EJR6r5HNVm-4ZS0qEKgQmIwmOdIaNsgYIKMI2NqCl11-yD64YqRcS8zs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NoHNQ0uF5YRtDh00ZlQqr3WWwXX3rabx2egDN8Eq0nw&oe=6A1302FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjHpRd9Cl2EQ7kNvwGGE3pM&_nc_oc=AdoL8BWvfJ_wtxGanJGf7dao5kJxkFfQ-ogbCEciiK57KZ7mv1oyU6FAUSRRPJt998w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D17LOEujtGlcCsd2L-1wXvDt5SKxKfS77zLyOXS_1lg&oe=6A130402"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1PO3PirECIQ7kNvwGbZX3r&_nc_oc=Adp0i0oQhzLiG3vw-xRdQy5I_8I6QfwlGsT2pGfSdMDVS-rt_BNg1bqcChoSxIUo1xI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73DzeOgzPmB7IZlsVu1kDCB156kxWjZcAqbrrbSGCKRA&oe=6A131359"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SFdSzD_E_MQ7kNvwEel7IM&_nc_oc=AdqE7rFUTiyppxLkx7M55C2qMfUwIluchf4Kme2KGI4dcY9_VC5oSgET_cHJnSfJYIY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77dSeea-aXhIGoAcZ19AZ5ONxtFyIlZRcFO0Cq4NjW2w&oe=6A12F5A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t40YgoOckugQ7kNvwEGV2Vt&_nc_oc=AdpBVvBiGbPgwyl0xpUg5wGOs_a7IydqnxUVIEEYjcFt8EktwsVrh9GJw3br7ErWdo0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RX92R8rpUKpTEEOZtXBOr0M3Y12kY2Y7Ezpw7N411GQ&oe=6A131736"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
UthLGTJjoQQ7kNvwGYnBga&_nc_oc=AdrkgwidkUx-Sc_f8i5RFX20GsFtFINRNNBdeY3Zfjud-IwBVXKHJHJVVgfL_lG845o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xQ5NmafNltc2Yjnj90qqRoutIJn3_EmUqP28M7S7q2Q&oe=6A451BFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5QKa46AtAkQ7kNvwGwDRxI&_nc_oc=AdoueATUdEctaS8u2TXIdG-7ktDMht4fXUks3owS37mRkU7tlZHGenbh5J3pV_uZY-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hPX004OzWfbdMTWTd2M0CNAtcgw_4QFRdcROCsLzLxA&oe=6A451D02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CHv25DblUcQ7kNvwGvjag5&_nc_oc=AdobWCW20DYF8Kvbsu7EsL4l5Og1JVTccSqGdy85vP2fEI5nUY13SomD_iKVqMLe5bQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89bUaKZGX9s9D2fkH0xA3Xf7dooCqjkW2loExOEK6ngg&oe=6A452C59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSXiAIBZEZcQ7kNvwEFBxDQ&_nc_oc=AdpYBxXKtqmzAEgPgwPpjubR6afQGYTsSPoTTcQAL_rLH71QtRZTa64bT4b4Z6ko4nQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xpa3-Z9N4SG9Dg5YonTSoKUWMDvYGya-EdyrGKR_pXw&oe=6A450EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9b1eKiX2LoQ7kNvwEVe6-1&_nc_oc=AdpTDglc0nGz83bEzRK4YyhKCsKKG9FdNl2rgPtNNce0wg4CGWrRSJ8iAvewZdRcT_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wE04tu-UNSYxukJ0rUXItB0-eDmxFb-aWwBNMvmJkAQ&oe=6A453036"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
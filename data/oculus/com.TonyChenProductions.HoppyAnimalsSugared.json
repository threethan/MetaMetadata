7yuKLqKgQ4Q7kNvwEkFbiv&_nc_oc=AdqOF26ln64xhaqy6j-Zmm3o-UnhqHIXqZCzcGAs957wUAfNd1eGcMQzbIOWZWvMVwg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AGhB5Bx9au8Q4a-jnKo5K65GJeYaCn9IDdca1Faq9tg&oe=69E7817B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pUqFxmQbosQ7kNvwFoa4Jg&_nc_oc=AdoGPQJZPA5xVxLRWBLic_U6ABSGfAmuEuWtLL-eI3m7AF44jwySxJNtSB61UznTIAo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hmdSTQ_iVkugWh1DNqDLy-tDsruhqpAvSN_nfL7RYCg&oe=69E78282"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xEdZ4xaPvYQ7kNvwFZthVf&_nc_oc=AdpaPIdYenD7CZP2PxKU19rPPgdpXXB4Y97umXCazjZotKhtdaESEpa9FsEHrhJOX1w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bEI-GKAzPjAxGqnl_FuiyC2tjtxdxngU50hPp3AF3MA&oe=69E75999"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzmrKAwiW4gQ7kNvwHkb1ns&_nc_oc=Adq1tAcLcR-fJ7dOdIKpWhpZwJOOnSofpm1HhMJms4NTZ8c2PUN1irKwEsdAMol32U0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YirreESer3GLhFEsGqb0ECc3TH_rHw3TV_jo7qfClHQ&oe=69E77425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9NwOvJTh7IQ7kNvwG2dzH4&_nc_oc=Adogs-O4fjj0czr4SHgx53i0SD3LzBHCrpmsO5QeUYc04fD81G9shqtuReFnq9yZMS4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K2aPqT9z1PHw_sJoW1O4q4uE8LPzXVjdi95oaFa_cfQ&oe=69E75D76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
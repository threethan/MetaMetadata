=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afux1OsVzL_qtR__891keU2_bxByj6xlwRAsy03WRjNjmA&oe=699EFEFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6zBZ98fqo4Q7kNvwFvcF_9&_nc_oc=Adk97Dy_xdAUYIHUIpkHajsr1qaJtQTzNKpbo4Z9HjXOq7CZm0oofw1-54WrgrwaCh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afshez4l4oysADt4Ldtt5bE0Xke1TXqZov6Y7e4CxOABPw&oe=699F0002"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWKtXkgaXiwQ7kNvwHhUTsb&_nc_oc=AdnRaPCNsR47z7NirOVKbC9NEHZ1_W0lc6fjkor0pP1TGVIZjdAQyHbr9TPqlOpo228&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvlCp3DzEFvSD0nbZIWNmjr3QcqD_Mrm4kPtAqYkbOtsg&oe=699ED719"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_pJu55AJREQ7kNvwFquTcP&_nc_oc=AdkZGP0IkdcKPFQLZzgSllJ0DE1hYpULz8WwB0AJEhjOlaN4SkYJen28AXmgkYRrda0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftUdHwQ-9xi7TcTGx2Pz_MkoIF1-mEb2EeeNrpTX6iTxg&oe=699EF1A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAXbWHPUqbsQ7kNvwFfTony&_nc_oc=AdnJ4xp8aMECxGnj6Y2gbBnSlrPP3VRbiKijIVKXamz6nDM6Az-OTqUXVN2o_KqPHu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvMkuF5MrkNU9iyjcAnreSnepVq0v6KjrF3-iela_RVJA&oe=699EDAF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
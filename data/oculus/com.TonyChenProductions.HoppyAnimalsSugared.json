=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFwmFx9hPAOlDDzMCUx0iTC7hELd8webBNPopHOQlV9A&oe=69A6E7FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkkWiaBU8-4Q7kNvwEZ-UcL&_nc_oc=AdmYEvkaVmO0WR7bp9XpLuFp1OgVoLHl6nNR6W3BmpXd2DLU73HIILBjjGdsj5Goeh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3yRP34vdUlqgS3cR7Fh2TpMhhirjWoo44RqZgqC32mg&oe=69A6E902"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw4bCmcExOEQ7kNvwHQeeHh&_nc_oc=AdmiXmBiRbVobbpkE0pGJ3y3SKcZYKbWTqRWLNFbPLfiVKuofZ2dLUilwar_ehYA3Jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfhICuIl_Q_DsgXHvPb_Q10eSwEY5FAjXvZjFpfa4mSQ&oe=69A6C019"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZUMRXvz2aYQ7kNvwEgCWAY&_nc_oc=AdkkktP_JMegHuTdCgBJRcESKd9WbTVB9lEHKkYn6a8C3MMV7BmrUnZVJ5LXb9zJ0pQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftehXwMN4ENHDAdWep2tXvAsWlOKH7eaK8cllTlb7ib3w&oe=69A6DAA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FOJgdP7_lMQ7kNvwEfQ_uo&_nc_oc=AdnQRbAZqyOQO92qwezSu38KBquXZyaBe-21c6Vj89jH3yc_17GACEZAwiU384AwZco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftD16Nv93uZYlgdQ2EaraOTg22D4vRN9Z2NUWiobawAZg&oe=69A6C3F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
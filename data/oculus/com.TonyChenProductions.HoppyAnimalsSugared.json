0yKnjntQTsQ7kNvwHPwbuy&_nc_oc=AdptmyoO723hQz0x2V48v5pnz18Oagy3Uwn01-Vi2MPlCmFHnv5Wi63jliP8PCSdAIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3eMe6b_jzAeH8KQpN38BeTL5AYopqdUpXJW5jiG2YHg&oe=69CD237B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-M3cxBWnEkQ7kNvwH-HK8g&_nc_oc=AdqP5OownghpXGb2enU11k6T5czpOa4SQ1wN5b0J41mnGNSXSEp0JOHaZs6hbOw5LHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjqdB_ogsvlMH-3zPQva5MIhjLAnVVkp8L9CBBnfkSbg&oe=69CD2482"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLYxbgvYUlwQ7kNvwEX6LVF&_nc_oc=AdoMxai9oxEEM21L9f6zYrCSUO2cI8ViLEJxNm9OqJ-xlX5D0rjo4mZlMQr5AT005O4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrNa0Eh-WVTN8eAaG_B4csMOQyeqPROh-O4uRe6-rK0g&oe=69CCFB99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0aoGRa5t_IQ7kNvwFDYnNa&_nc_oc=AdoabKLJL6PE_1DiQ4gXO_G4bA7prnCsYujR5c9AoyL8o19f2O3TU91sBUl4Ht96tlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwdp5ZyXlCqLb3Buj8ZP031upG0tPiKcvtvV0QfwDFS9Q&oe=69CD1625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9zo956Y1nQQ7kNvwFUKwhK&_nc_oc=AdoRxV_2NwUBARbRf95ptATebGIKVhVTHDk0dVNcZTwnwBGUn5Lwqy1oh8u7DtQHLYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQBpGbnfF7cdUe-_ArELqjJ1abywvzA5CW4dMByR2aBA&oe=69CCFF76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
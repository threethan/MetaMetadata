8y9nqgS2yUQ7kNvwGPEHcA&_nc_oc=AdpTKt2YwyJXzX9oZHTfKRNZVO4GMN29Kk54RGOdUbZZA8VrpoMc2PzMXv41gNb05QM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FgaOrIvDoNN8i9lpwtlNGGLOQei1ln6_Vh8YylBMRSA&oe=6A296C7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzORduZgkDMQ7kNvwEsRSgX&_nc_oc=AdrwSJ-ZlZPaxU6J3gEeS79Z5wzhhjEpAx56K6gjwDuYBg_4QkNdT7Ie9ZtABYXsSqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Za1Q-dxN-rSQuHbNNM9oNNlwIPYvIbX0KNdmqPJ9JFg&oe=6A296D82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgJFxmEC-TsQ7kNvwGOfl2j&_nc_oc=AdoCQk-jCG8C-ztndRVw0zcvTa4j7DamANyZyDY9SMcpXD003YA1Ld9eL4hipOYFBSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VxC4M_CuW7JLB_2NyyuTxonBP1-DEMUkk8jmENLvs7w&oe=6A297CD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtUIJNmXaC4Q7kNvwGiuIG4&_nc_oc=AdosDOMldcjHupSekSq3tKsuvC8akbTjeACwSlgm-LpiJMVOz7h15TW372fROsifGJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AvrBNSta_mTs5OfX_ThBqwOAkeceJN5q4ZBnzTvC2CA&oe=6A295F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk1sJ5rKAbIQ7kNvwEaBLmg&_nc_oc=AdpY8Okut5zM5DPaBYrs4MAoEYHGb9RXgUe9PQfxEktWWaIV-sVkA2IwmrCsxInZ4dE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WdTTQDcAqaiO_KzWNeIp21AcyvUsf7rQS6aH5XsyKyw&oe=6A2980B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
i2p--pkjcXiosl3cYwbxcGrey_fKJ6E6JIiv25BaYrrkbFa98ocW1yK4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-lLNZtKYhgc3YDFEpBF7ESar6pxkP1Tnh6fTtM1VIdg&oe=6A36905A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHj36zJzZbMQ7kNvwF_BFMd&_nc_oc=AdpIdlkvruD_8pOR_V-K3iJd9upVTBffQ0CuVot4DU1CyFVylDnN9REkYFRMaFHE5WE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__4gYv1FkqGGXQaahTwjBY--TCb2efngYDfRTccpHuVg&oe=6A36A703"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8l5o76KBv4Q7kNvwEOYzOf&_nc_oc=AdqdoiIsu6ZvLNX9P1GjMs78mNPGQFPiFL8LugCFIaLG2UKdeXUo4baT2T9jl_hisM8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aR0l0Aj7YxFRK8_C-MZIUIhtqju9rOooVew4Tr4eX8A&oe=6A369E5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from t
6gTYyEb0i0h6oUhH5UxWuyb4Bzt9yXJ9vZYGS1saqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z8vMRIqYgDNSueO0usHg-kM5Nag2XvcO6u8ZHkrVdHQ&oe=6A198F5A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3UgQBSIHnIQ7kNvwH-cRka&_nc_oc=Adqa9jcUKVs19CGNYEtauf0CGFFizPlAqHWcb1aXhtj2r-EkuANWQGiv1dLkaUDwQhA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rk-vWCI2zTqwXyvKN97Kw4K3oXDPbBa1gKv4Ft6rHEA&oe=6A19A603"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zqmx0sQgd7gQ7kNvwEEgfR5&_nc_oc=Adole51pwmfwaJxOLtBQEpGySoeeVY3emQOiuDYYfv65hllYNcyWInPdhEi-0y-oiD0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r3dM6wnx7QbKKZZzk9TDu1nZMSKynOv_yplwEu7_z7Q&oe=6A199D5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
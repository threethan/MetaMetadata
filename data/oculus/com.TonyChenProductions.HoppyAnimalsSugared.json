vR4UJ0_c28Q7kNvwFmjHiL&_nc_oc=AdoDHrARGuw1niRO5k3Rsl2WSHclMwdHjGqlAcp_ThmbTNoOlo3twzrcAGNHHKBX5p4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPICgLBTVh2NyUbUKQFbHcpQDle6aOOInSIbL5NRpt-Sg&oe=6AE0ACFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkQjPrXggGkQ7kNvwHDT6iz&_nc_oc=AdoOuYmZNXvPIPWAx6UHsRXk2qqNdNQ6yaChpJjL8MakdOoJ3jod-NpGCY5ERHLWnn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjuHFN4vqff6NvvH6ejd3P05IZ4ZwXNmmFnSOfAXw60g&oe=6AE0AE02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2m_yb_xlwwQ7kNvwGFoeRs&_nc_oc=AdqBrTIqVPL9LdqcWV8PBsEzAi9MJ_2CSIRySs96haD_geT4Ray2pw3cVAxqPB4sS1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH8Sh_GqJ4q29QiyfUDqyZ7ithbJS7FWsKUWeXrAbSdA&oe=6AE0BD59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMs_dEUnPJ8Q7kNvwFamVhf&_nc_oc=AdohN8MIdwsIL9GxWRPmYJWO6mzFHtww5dlvSMaIZhWZX4vAlhsFe5oPF54tdnlR3Zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7FKZqwCreCE12va-i4TVuJRtrESXDqh2EtWGGL68e4w&oe=6AE09FA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG2ftPSGKmUQ7kNvwEF0Z4N&_nc_oc=Ado-2eaG2GKeYFzHT2OvlshxWU_XGjRXMge3kMoKLvYbl7k5rbILOX3UOonEhdxWC1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXos8P6Iu82VEyjT-YiTFZQeAvuVWm05JEIpC4Z6USnQ&oe=6AE0C136"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
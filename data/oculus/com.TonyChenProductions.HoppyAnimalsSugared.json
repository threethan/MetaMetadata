zaYus1cqlsQ7kNvwH1NmSx&_nc_oc=Adrwb5g4-NqfJy4oFwXs5_XmNBNwUGlce2WNvn45FDF17RHCA5KAhiis0aJZWfLRH9I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdXKKm3v9giyMc33f8GkPjP0Qb_gPHtBVJ83NeEm-FFQ&oe=6AD0DAFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbtw7DwHll8Q7kNvwEdBITb&_nc_oc=AdrMw4bnzc_2TXilNalRCffGI81HhnJoHyB85_zUCLEn_cIVCjK6I1FslzoTcnCltVY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrXU9YCKCjbUUkRL3asa72OnkgWwym1QD9kW5DGNltig&oe=6AD0DC02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq4lzcHaRBcQ7kNvwFSbFAB&_nc_oc=AdoPMddDGLYptBU7nD9XRxxUol-NJ6dZJIjBNHxLyQo0Rmr9m3xIZIHGA7e1--eszDk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8nsqcM-gh8iaQja2sjjhVInFMkI_-8o-t9cnIr1jQew&oe=6AD0EB59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxUXK4b18Y8Q7kNvwENzAUQ&_nc_oc=AdpFMm3cP05_7zglLTNBLZMY13swD1TmSkIjZWJvkSsADTIl85lUB2OmbG_9E-hjZsc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZTsx793YhurxWad4IBJ0ESoZ8LLLdOw3GdaYKKYeU8A&oe=6AD105E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrzGDdK-i2wQ7kNvwG943Er&_nc_oc=Adps9YwSCFW_Tv6lXCC1jwn7hrTuoc6PP30UohAAPutRdrfri8jmsHrQ5pl4seXSFZ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpxig22aZA4KWUr4ggOfo_MEq6sAxU6v0t_ZFS33aPvg&oe=6AD0EF36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
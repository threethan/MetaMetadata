h4_prphigEQ7kNvwHl2-_x&_nc_oc=AdpE_YdsVZXhVMzenNLNU3uVutZ3oghfRaGabDDJqAO3tzdF5rSLK-gs9ggCVQqphVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jW5q6fVpUuyNSWv0cjB1tXvWdiUlFZdOm6vJ7VEuM1Q&oe=69E4DE7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pUqFxmQbosQ7kNvwFkaV4U&_nc_oc=Adrs453TcyXovQdT67QA4vuONKLBkuXcFQSeHpNRMX6jHPdlpU5juBJ3kfIp2w7afgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qglxQiEolT_5o5RM2dmmS10d0leffSh1Wzv7Y6ga-hQ&oe=69E4DF82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7lJXwVExE4Q7kNvwGx5W_C&_nc_oc=AdpLF4Nj3p2prs2ODmNY8tbAyPj6wBZdRSdsvgd-l2bdIowBrFan4KS5Nq1Vk8DDhog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s3S8JPpdPxLdObJJxKlTVJdzuKHOvQflfbZTNyeZEhw&oe=69E4EED9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzmrKAwiW4gQ7kNvwG6cbc0&_nc_oc=AdrSM0k3gL69Mayo_39M0vz5yf-ubIB2GXWgN5P3UuCBNXTLpECdUOnuuV0N1cHK_Wg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38g82k_Hfg6NbuoxvawdFuwolg59Vd7vSC0VvoDQZSCA&oe=69E4D125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyo1GItPgOMQ7kNvwHmkHe2&_nc_oc=AdrNfU5M_RD0zEIFs_bkU_bxn9MIw6Z1cbCXvhGWqthHqdY7oV3YPniRyigwVz0rCmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16k7y_sjlKV7uP3xtdMwHSJm0Ju0AUNLuyZK5J11H7Qw&oe=69E4BA76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
Z_mQxOqQhcQ7kNvwGQFz6d&_nc_oc=AdrBG6SsV2-gw2obJjTv44r4Mv0wxpiGgkkPlfXyDYEmK6JG0ldFhDgl6ygLjh0ku7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRj8zv2FLnLp19qERkmypBi8ATgrXOJDm6k19l9fLYRw&oe=6ACCE67B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szkS4yqokygQ7kNvwHpp8yU&_nc_oc=AdoJamdGm3Qy0WmmPbAL9zRZTEC4mMiM1JCDJFRdn3ZInv04xn-MKLO5ywqP3OJDrXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJr3xPHQ-xKnI8DOVviXHvIBqN_YdoM4sMBUeY2YkTWA&oe=6ACCE782"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHXvnAq7PQ8Q7kNvwEGqd49&_nc_oc=AdqEmn4uf53dmWVC5tJECxS1M4e4tiKEd_W-sByRL5XoyvhvURv_4M2hiiBCfxkbRsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFO1m6p7odeCud7e0vq77ofYcKijJ3OVMgN4ZUmOFSgA&oe=6ACCF6D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEAe3EnQvX0Q7kNvwHUQCjE&_nc_oc=AdoyeiJznIhmoD4xDX7yh4Se3BhfIAY1OesY_PdsKgyvJvK90uCTl_BMzDKhw_N_0pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORYNrgDTUwGOJP6Knx1MyLgCM36Z5wPq7NWoIR4BeLSA&oe=6ACD1165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huSXLh7GgEEQ7kNvwGfkgOD&_nc_oc=Adpu1b5qqvIGEWsEN4GMrh6Sp33CPq_jOOaHj9J4wSahP55t42GHoXRi03Qba3j0wH0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR7rsWT8tvIwwcQ75Rlb-UKil5lCmOFAxVIf-XhGIKYg&oe=6ACCFAB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
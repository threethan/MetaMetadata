2dM47pXJZEQ7kNvwH7hjF4&_nc_oc=AdrdVnr_wnoTRLTE4l2sy9zJFwc-KgjlNg8s3IprL7LlHrsVeDCtyIJ7rs8CxvN-LE0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKefivxIg1QIYQmmUQFYkT6OK-JJap4zLpAQayhovMJg&oe=6A9D707B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlFvjvIQt_QQ7kNvwF2kXv8&_nc_oc=Adrsg3y3ba78Z5Bfml6Su6ikJwlx-2B5BFg4nRjZ9WuIgklUdWFgWC9IKShDMDUEV34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImBwmINm1fyfui-5PPwVZqvaEHAEhOT3R9XGUro7ZQ7w&oe=6A9D7182"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qv0tf7g3Y8Q7kNvwHlzhuc&_nc_oc=Adq1Rcy8_I1xw01BOkTGVTgd01mKTqxnLz5zmK1iCHtlr4KivTiQmjHW9n-K_8FZPaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBogQ16Q_F5zJuMJEv8mWpwXh7s8p4WDhmfuzND5mSRg&oe=6A9D80D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7vq0h9ss_IQ7kNvwHL4J3s&_nc_oc=AdqKBDfY4ATFWwvlwz3QpzaI1mBi4M_58Z0OIOS-qFOfCRakn_h6xPlI2ZFmoK-bx3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsnbxcVywHd8hj9Y3NFIQwz1aKae5molLZUHQCIXzX9w&oe=6A9D6325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmBN4CCqgXIQ7kNvwEfEACP&_nc_oc=AdrbNX-GLzsSqLVHL7-UAL1qUPwXFb1jKRiE-p1XpTV1SnJ3Jd5hb9vSQhZJfnB1oDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMJzCMKsa1sO-RGd1Kkdb6m6-_EO6xWV4vr3qWlnjlVg&oe=6A9D84B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
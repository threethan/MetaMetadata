nqXQXZcizKXlEfDvIVo9XRgefJ58Mj8hpBdBL1MfGIDxuaE1MQvEs7LksWGp5LJNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftpo4z2m05FSyvRm4Pj407dEbF0bUNo6C2abV45SHo9rQ&oe=69A8397B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkkWiaBU8-4Q7kNvwH1inQX&_nc_oc=Adlu5LvY8RclaAfIsUAySiEmqdRf09OWXuGtZhlszfwzJf0Q0dn8pYqQAPQ3SDQdwZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfugMwKSO-J6Em3XO91mPBd-Cc08fCRyvdb5QdG5azJQTg&oe=69A83A82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw4bCmcExOEQ7kNvwF0bYYN&_nc_oc=AdluNgSsAACkUjqjhwgjdXo48wvpvRwmn5p9Tv4WoeMVwGlMKT6ljZ9JjrQJwjbQU_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft8_CJOFryz9VaKqJWTE3SXGGIVCgYYD4Ix9DPEnrdC-A&oe=69A81199"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZUMRXvz2aYQ7kNvwHe_aMU&_nc_oc=AdkGvXS5_Hwxg2kf_Y9dQm0iVUE1G_1CwIbpMPARkDtfN4_zzPxHoRc1L1IkEiy_vL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftTt8ULk8iKQgmdAG6G8JdTDiuvmPZkdGnd4mIV8dYYxQ&oe=69A82C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FOJgdP7_lMQ7kNvwEZkpQa&_nc_oc=Adn2H8lkxfpyoKC4E0_NYC37JE2CBxCvesgposk1rxD-qupEclRNZhe7fnPEPUIJ7FM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfucQ3xC9vw7cWqZr4WsEiVPfZRfEPGvvsG05aZOgt1cWA&oe=69A81576"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
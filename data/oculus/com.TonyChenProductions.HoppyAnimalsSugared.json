kHQsZcR73j2VInygzdlImLvFQhnfzF4Ws9uIwW2L3WBUGo6JqsRd4-A19n606vuN4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYEu3ic798FenDzHI0yh3L2bJE48Xz1uL43dXughgKEg&oe=69BD517B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGEcWE43dGUQ7kNvwFypBxG&_nc_oc=AdnJmSMUtgkJSurJ7iBS791erc3AgwDG460pf_UxvTPBiukC1mEwK2rCiDSTKfTkOII&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyprKrsJpTD3zurmspsdt-06qaH8MxTYl6CSQTteDP9qw&oe=69BD5282"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUJIyoV7JhIQ7kNvwHRI83h&_nc_oc=Adlg0IQ8VmcpwYczTghJVv4J0Mw7H70ZFnh_SwsZgyWlOgMrmE9ZjFl0S2c5li3okmc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbDwAz1eT3tGp69Xp-R31Ul7QhtxcVYMwmMbivQOkp9w&oe=69BD2999"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N4A_Oz82D0Q7kNvwHvqgXt&_nc_oc=AdkMY2scwYA4Hq4Bc_nYsvvAw0rOFQmw4lsvQDJceoMGkBB-ST4ze-xjeh5-3WNqBPk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEoF22CVC7XvKxI31lpzHQkY_EWKkOWFNJfwOmIcC1Gw&oe=69BD4425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFZCBsKZOrkQ7kNvwEGKX18&_nc_oc=AdleBlV0-3ccCkkgFSFzYUUKUg_T0O66LEeiR4LKTfT6JO1dSVleupiJgtZcmxiQtII&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAWL_zUyCzPrtYiHWK4Pm7-UfH8d5U5gjb_o5Ka3joNw&oe=69BD2D76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
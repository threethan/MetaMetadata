jE_7Zs1pgoQ7kNvwF-viR9&_nc_oc=AdrkNGw8P9N4kNZlnyQ2Y8OIkD7W5U_dZuZ-662wwd71jSQMh7shadAiztBWJ-lVsLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfMxhWVBKwOZTwy1bHlTud25F_L6TCNhJkdwTX5IZtiA&oe=6AF07EFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiFhtzczPNsQ7kNvwFzqV6R&_nc_oc=Ado0nuPDpPVF39petJGoAKArzghkGC-0XXh1jDPblo1IShwotnmUDJgWRsajqXdknL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWtSzqXcKQHwsyGZUVrkh-biC13rlUaon00aIcRIZ4Og&oe=6AF08002"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs363-pmE98Q7kNvwF7ub4w&_nc_oc=AdqyBOHx2CO60MDZn5QwmRcZMH08nULL6F82-ykoyA_MDwh_aticDpXy7hguqElRNeY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-dkRtzjsXCJcDGbiWyM8q9xIOYrgcpLGo8sVmyW088Q&oe=6AF08F59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipMA_pVj1A4Q7kNvwF0BcWc&_nc_oc=AdqxlxyX3dUijjzJUgoy1TR1vrguquId_bvHeoOdjbr82SlFZ2PArf2-6i2aSI6c6GU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK09A0Xb83U2fmwbmvvKz3AAn4_N5s3P_K_miKnTFZ2g&oe=6AF0A9E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cP73VRHuAIQ7kNvwGMmvy6&_nc_oc=Adqp8hCSOjHGQSHorBSIhKKkvKaiy0EMdRlNV0wtuQpC2DffnwoiWBVeqgz8JnurJ5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2R4i4y1GrZThfiwGUbPoEeQYewwTeVHp63HWP57-Ekw&oe=6AF09336"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
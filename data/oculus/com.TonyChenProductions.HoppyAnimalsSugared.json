829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5_63dmiAacQ7kNvwHoK1mL&_nc_oc=AdnWhwUkLEe8wO-WFIPBPc8jf6-CU0m8zHMioJUkhJ6p-94x7cpfREyoXR4NpcIjx8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuZRjXTAueTHxq9LWXtknEeJYPXR7Ux6dRr5iimjRt4nw&oe=699C6783"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmbAEU7XhPgQ7kNvwFksTgN&_nc_oc=AdkYqX4A58FK8wx7lrowZKJKFUKbvi-WxM6VTqWbhBm78hQeFiN5wupeJxkbLp0orv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvnRYz1crQ3k_DbXEH2_CxR9q-qG7DaO60CyO8RL027Kg&oe=699C5EDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over)."}]}, "developer_name": "Tony Chen", "developer_privacy_policy_url": "https://tonychenproductions.weebly.com/privacy-policy-
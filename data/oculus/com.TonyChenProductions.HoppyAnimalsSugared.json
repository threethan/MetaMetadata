vkFHWDMUY4Q7kNvwHdti9Z&_nc_oc=Adpq-4pBn66yKpxshE562I9ELFnbDrTlnxGG4iSxAvfhD8HAH6R5oBu7h7VtY0JTgtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iH5GMkBCtq4GuAavNDrs9em48qewXbnl63wg-idVQRw&oe=6A37ECFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4AOy948NvIQ7kNvwFCKKU8&_nc_oc=Ado-aq0ZxwGo0pSCZXBGbB8ObbU1HZN_IWn4us-sY8asxb47NOHdVKyJRiyU-m9k_98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xX6tuzc4RDdwiSK-yYzAYyQpLD5CixqeemjxdaAlmFQ&oe=6A37EE02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHQvVNi-ODwQ7kNvwFkNXXF&_nc_oc=AdoiRHv8LoDNUkb94lmoirs_sRZp59-Oif-wDf26YgYCYBLoEUHCLCjJ_ZAEuhQIDC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vf7UCOEfxR7YgW0lCetqX-7JdlXXDsry9E7eTHt-gMg&oe=6A37FD59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciheGf8nx7YQ7kNvwH0q7d3&_nc_oc=AdrFllhjDeeMLoaimVa4LPSvpNHiDylSUYdq7GSfCtt7LeCk5raIpqeS64uHj_Tj5PY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9As1MT4bQ2e-ZHhjISR6Okeg8ivIbxjcBoJDGZpKd0NQ&oe=6A37DFA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAjTRzjrNB4Q7kNvwHRZd9Z&_nc_oc=Adr_l0azx9BvxUrU7af2ZVgs9fM8HQ857Ks3j6XA3HRCnSQYDx9Kxik4T1Yhb5L1TaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-deW_JlrmxsMhD8LjG-3dWPUShzc_5wrgAEA6ozDESNQ&oe=6A380136"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
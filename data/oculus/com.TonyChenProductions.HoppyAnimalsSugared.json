jJ38uukVN2u2935cI8x-pFXDw5ky65cozFnvYi5iyA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGl0H0V7lZ501PY-L9FHB9aksCRnKBySRNtFe-AECo2g&oe=6A81B5DA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2A3MQswveYQ7kNvwEvM9Ex&_nc_oc=AdrjDBvltQoWxo8DYYXdpR8CbnTv263RuGYGk4n4rd1lZiwyMgGlA9yfqpWBsOyLieo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLCfax--EnNzbVF4t0SLVqDrByBAWupxEX5MVZ5VCTnw&oe=6A819443"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiqpqfY3VV0Q7kNvwFlAdN8&_nc_oc=Adqw4D34t19FVi_EF0lqq6CJUV9aE2PYXOdV_n62EACoV5EdoKAT0QXbOfOBb4g-6D4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa6JXYBrfGok8fEmgXl-f9idhGPY27rz-79tY5O-FOOQ&oe=6A81C3DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
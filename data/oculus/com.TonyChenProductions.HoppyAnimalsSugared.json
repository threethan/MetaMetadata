qiDa4UG0QcQ7kNvwEvWS-g&_nc_oc=AdohJ2hiW9BS0Y8mbvq6JOoyYFiwpnMHmQwcgr611qX4HehqkM4n1OKwYxNKOfT5YBk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtIpv476a_yVcgWHF-uZpbtZEpDOZ2S0S7lD1wRq9MCg&oe=6AD3B63B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkAbkKUjarcQ7kNvwEqFPap&_nc_oc=AdrDaFD15-7rNrVo9iSrMvR4v8FGwsQBG-AkASkhj5coU_iIebEQ0EyHX5_8HNQKx0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPSQEF4NFiLhSlwAC8Lwgyxi0WoOdLO1TLUpHzOpZWcg&oe=6AD3B742"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqXxJCcjJg0Q7kNvwE20FUx&_nc_oc=Adp4QsvjqA9NuX2h6LOdQel9Abql_5PzVjvKgflMjT1hlIZiEiJ27Vhca3GJP-YYvE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPerBMeEM_35UHuM0WnAXV7QXE6b_2DdN4DTctWQ8I9xw&oe=6AD38E59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Icq-X0-X_NQQ7kNvwE3UhDw&_nc_oc=AdqZ2bgXXN4hbCY8Wdi1O8ftdo0O09F7BHBV2s_b9RdTZpucfKfy5iDbMEJ76SX9l2E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyvOfyrJQ3iVBItq8hIp4EsMBVnOtLHuCmMlN-68u8Ug&oe=6AD3A8E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM3NYGf9HyMQ7kNvwFIofZ1&_nc_oc=AdqPBs00DsUEMlS-a53nU-biMWVM1VXmxfZ-O2aHMv0SkGKEVsfrsmObrmyMIS8JVUM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxf8ZSRmehZLxbtPZ0eUVkE3Aa3crnSiiC829ZqIGg2w&oe=6AD39236"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
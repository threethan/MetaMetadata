=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUOfn_TLh2f4Fhl8eiGoko5BeCP-5lS5ZKmrAWSk9JGw&oe=6999B8FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awV2kRSbSrYQ7kNvwHv3hFw&_nc_oc=AdnLe_3tL4q_TnyeWi45X5WZFQWKhYQABXj4fGYhwpOOxqVCOSga6e8EXb8XqOnTi80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgrO0Cylk2Rynnqr4FMp00t5jZwxcKhgrAl9CDo982FA&oe=6999BA02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKOftiAWG4cQ7kNvwEJ-6qi&_nc_oc=AdkfZD6NM74bQOzmjjTH37j0f1An6v2S2Qu7cOWjnwHCBNEXQ23UyuAYeBpwMnm6kgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswKDAZQ4UAaWDf1drRxb_5Ov5iYyquJFxCfwdhcQe9jw&oe=69999119"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCN2EN8PF58Q7kNvwGRQnQe&_nc_oc=AdmBRChf3o1aA91bSTtnKKfKX7sLnBZmRryr_h8zP0SwctNk2zF8Ly5HYoROynFy77o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1v4-e6rsNY6enJp6nOeZLOERCU8dSYKAgiV5YouPiRA&oe=6999ABA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIrsvpI-NrAQ7kNvwHkorYS&_nc_oc=AdnQ4f-VcVtj-Ks9Asvbq_eVSnfjsNoqGTQJx6BsNu-4LOolxGbKI5l1M36eHqVsK40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLgZgnGtKfRTSC11rTlAp7XG8km6t_cr1KcDxShA-S-w&oe=699994F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
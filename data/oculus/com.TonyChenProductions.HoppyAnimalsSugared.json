YtfrdbqkrMQ7kNvwEWGqjJ&_nc_oc=AdrMXK_KU4jAWhliyEd4eROvlS-_DganOH4Klz09WAGwciSO16tKNJ4HOmKY9Mo53n8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBVuALssNoGKAFxPTauxAvfVag3t00xQ0g36DM_nsTfg&oe=6AA2B67B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dr3XEDMUBoQ7kNvwEkpirH&_nc_oc=Adq62SeVCGbF9Xf-D-d2-3Tq-a3_9Ks_SL1H4xIyCtc5FJ95g9wKYB4Gg-_5urZU7B4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwESrvuWQsQ2kheHrlZPJljFnMaWEiU2PqC-6q6gBKFw&oe=6AA2B782"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY4d_9qjekIQ7kNvwE0606H&_nc_oc=AdqTDbEIrU-6wlToBKbKoX6WFC1J7jHU_9ZkhFsQGqJBmzBr5mu6CPGwKokMZaVGqRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtOUzUSIBEJ8cLz3OJ9FwzFUm_FgSWsyZJp9qkmUR_wA&oe=6AA2C6D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abOIAdgeOgAQ7kNvwFTK2gt&_nc_oc=AdoslBUz50J_irc60gZb40mS5o51r1UKVTt3M4gtuy6JyqktZo0wQ8COJ6EmqGcCKF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu_WTxNBITIv7izmPQoecRgkPwCseKffaIbWSV2_GU9Q&oe=6AA2A925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz_DtMttXyAQ7kNvwH2_jmj&_nc_oc=Adout_u3CqD4tv6ivaqwlRgzh5S5ZIxZvhNYdjFT67z_kjU1iTRetb1fh2eIKnGn3bU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc6XS0Nuw_ZOGYhlOC4SL5M9ogh9eBG7KmUW_KaSAMeA&oe=6AA2CAB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
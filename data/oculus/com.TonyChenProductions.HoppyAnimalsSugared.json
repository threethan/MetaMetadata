HmrwJi6D0wQ7kNvwFii6l4&_nc_oc=AdrfMCL4_aUWW7BJ7QZqavP9_4X-wFRKx7xIMzsWibh5Tp8_8Sr4HxYBWVY5l1lyLvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-4YXxW0UvlE1f6ScwTlnVN4CWogWILVS_-Lv8O-DxPQ&oe=6A92AC3B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqKQ0L_4fl8Q7kNvwHkwUMo&_nc_oc=AdpEa2Pio1Fkd3wuQV13UsgsB8S8UxWhvtKkjFw5Qp7iBxlktmsGHiOE-oQJaDT2Nss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7YlTlqD2sawCeTK4ARV3TVZugGNPCsQVQGJF19hTL8w&oe=6A92AD42"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXRkYMIcZI8Q7kNvwFpOsag&_nc_oc=AdqGllw4jmYRPS97RklViuQOWSDgbn6ccGBbIeYx0DL6OKggRqCVETA4tXbYVgIQNTY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm2V0MmuGb9qnNZvZC8JwHNajzjLV5TZBnogOklgnAEA&oe=6A92BC99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QXARSFzFWkQ7kNvwG6coT3&_nc_oc=Adq2-aVQzjVHFtWXfis4UjE9tVgG4q5xFpgohvsqt0aA-Iazn-Jf1dBgjW1ypuLPDwo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJOPbn1YfpQKTxCBzx4f6Ln7kzn8ngWq9PN5HMH1kNUw&oe=6A92D725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZzS1nMNGd8Q7kNvwFwxUpT&_nc_oc=Adr3f1Gvrf-LCvnOIC1I__7Xp9FtLPnztZwH6Jd5qrJPlN7BjVJflCxPdooCm07H5r8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFTZKtztEnUAf6nD0gWt-6imnh7DFX9afAqYc7fYCURg&oe=6A92C076"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
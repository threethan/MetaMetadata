ykSARCz36YQ7kNvwEKHgNH&_nc_oc=Adp1SWCDhJ0MgSSlktbdIXor9I6x-uWs81Ng9e238Gnub5HQeFTUI4A72dLgyZXeuU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oKugbajVlocKXqTGh7Xb-irw9jkxoo0YUQuCVbY6mTQ&oe=6A05D3FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6c9oaQP6_wQ7kNvwHAQbPI&_nc_oc=AdpSIif4k7xaWQAc5Kw626hpYiJNZDkawia1z5dxYX9ttQnUSiXhC4hrdjLcJdeSzJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EcFxBs3Vu5c4vO0P5zjRBS-kAC3775Z-lsFw1ou0ITw&oe=6A05D502"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsC6XsOQEScQ7kNvwHga16h&_nc_oc=AdozCmazyQ48-C11b5_AkHNb3GK1bzFAO9pXymE8UwPkNa6_sDn3_39uhgbnwekp4b8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kY8P6aIY0FI3jSMJnYeQbHG0AJOBeEcwEhyxWwWZtKw&oe=6A05E459"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3SB5WMIhK0Q7kNvwF1ptdf&_nc_oc=AdqO5QYEtdXiWmrrEXohrkacOJqQdbl4J9vkior2zqVsEnpRekIrX8PDwfLfdGgptxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dpn2aOqdIC2LcWrIrrsoE1ONe9iBrACxB2AvY-XjX5Q&oe=6A05C6A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vkroE0R60sQ7kNvwGZAnT4&_nc_oc=Adoh6bS0Qa_tWSl2lHJzkkWvZgWasNlVvnNPej7HOkJlGZR2EZb5kh1nHFFyZ045Hmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m2mitx0ma-83DXxbjuGo75iLBYgSp2_E3QDXFHfTMhA&oe=6A05E836"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
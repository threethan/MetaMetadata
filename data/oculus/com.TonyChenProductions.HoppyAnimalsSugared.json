jE_7Zs1pgoQ7kNvwEF9g89&_nc_oc=AdonM8JeP-tjCmVtFPs_YKnLBkQOwXUGdT7I4lNXMHWmN8WKafldOnOTwZxk3R-ZUMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ6n42V1iMXzreQbJH0vbcnxzuu1luQkP_uNVVoIigoQ&oe=6AEF65BB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiFhtzczPNsQ7kNvwEUVwmU&_nc_oc=AdoMViRLY3UrPsAusJKj4tyme6toRnaUsBtzxbSaaitqEDDazUz0GQxXXvS3LPCPWS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRunHy0Izje0rIdwkfnuN6KxeN4LKWcuW496G2FnLYZ9Q&oe=6AEF66C2"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs363-pmE98Q7kNvwFCdzWV&_nc_oc=AdrtSoglXAFnhno8vpMpMWFtsWq87mNpMnLUAitCNXv97QPaC9WEwosyKQQXgKoNvvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBQOGHYxTmmTgNHCmwLCycAy5_urs4oGAvtDUZ1ufRRQ&oe=6AEF3DD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipMA_pVj1A4Q7kNvwGBzQsh&_nc_oc=AdrYHKZ8PKs6JSHYNVkfVy1jqPmHvKst5pEIdJ0MkFaZWVGAj5LWo7KJwLeVsGJp0do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPLpxCw5ax-Q-kOlqMNBiKEFryQQRZBHw7Z94KQ5U0MQ&oe=6AEF5865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cP73VRHuAIQ7kNvwFRVqU-&_nc_oc=AdpA0VlIRLxp3YpVMkrcpiNPt348FP1j2-7A2XTzX9CSuQB6uiB938oRaTtOnMC9P94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7MuwyLuRsbBBkAKLpUwJ9Z22JMPj-5KRJQICFoY8AkQ&oe=6AEF41B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
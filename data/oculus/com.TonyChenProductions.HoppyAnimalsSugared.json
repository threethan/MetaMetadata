rtXKk066VUQ7kNvwEdEs9y&_nc_oc=Adp3RUhzIIpSRn-sAkCQ6Y6BxfXqp0sfclU7FcYYwd1oApA3c6KkKSrTd3_eawwyTu0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxriusCto8KSvPIZcvY6y-2x8B-Jbt_wLoySjKuXXfONg&oe=69CFC67B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-M3cxBWnEkQ7kNvwFSwzEb&_nc_oc=AdpcevBDF3CntFSxJubs9xc8Q_Hio2mSeAtDjP2otVwHh_cEQAsm2OY_DaQt-AVDk6k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4eTvatMBUWzf7Zhv7AS4UAr2N6-lGSAyyPvSqPiQzOQ&oe=69CFC782"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmjgJg0OjR0Q7kNvwHcYAp8&_nc_oc=AdrpeEsI-Fp73UBOFQ61B_dstxuKV3_YZM2GRvL8GSyA5NOcziubfUqCvHJi8ZLFK_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDnL94kuZLCfdyV-8M6F3GdTquDaDlmV7phPZgP67D-w&oe=69CF9E99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0aoGRa5t_IQ7kNvwGDTf2z&_nc_oc=AdoGw8M6xusEd-tvtWDb_8PTOSwm-P7nK--TwDcdtd7fkACrwQCVMjSsTzyD7CDDbV0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3Y9kI_5NmYRWVtH5ekZIrODADkqkeW0C179uqtmyL_A&oe=69CFB925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbRf2Cyqwp0Q7kNvwHrXS22&_nc_oc=AdozcbR18xx6jcet1MNBDct6jBtZrfV5IZt2bztoU4e1891QF1DfY1eg7purvkxv3mw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw55rvnGF-WQphrZ8gZChUS33ab_TXUTWiIg6FRlv6-sQ&oe=69CFA276"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
2WQ38i5UCUQ7kNvwEoEec5&_nc_oc=AdqyCJ7EVtUpCLuQeFEw2SM4r8j9Hg4mhIgAvci__w6981hKzVPrC9DV_H5UU3b_WMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lDuFmnHqkXwwTWBP968CW1l1kgl2Zw-4h4QtrnzIigQ&oe=69DCF57B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAXREuexY18Q7kNvwG4DU9I&_nc_oc=Ado1w8J24Ro7IfgDYLb8ajFb0o5HQdFRqCbq5RZkzFvaQUj-eLxIhhVywgnbXIuiPqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24VhsoKSLm4wtPhcKY6ixxMLKvU8sGZKuzfb974--_ug&oe=69DCF682"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHF_85o3dLoQ7kNvwGAdBzv&_nc_oc=Adoz6lKD3cwJGbSaTYGroQgRCc5JjNxgll6Bxawr27cOP9WI-7JRNOvR7jKd8Ey5B70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c7zc8PHC704RhrXnqlsUkJ8PNonTu5TzQZWxQFpXv7g&oe=69DCCD99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CslHQave3McQ7kNvwEYJgrg&_nc_oc=Adq9qGkrYKndel3qyc-vau65_VNzw3yMpqz7y7QHgDCrP_iJc4bx6PP6Fnvhw55e0Do&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29OEnuJuzYQpubpC_8UjqMKsU5irjvEstL_q0verAqGg&oe=69DCE825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoVcXiNd8U4Q7kNvwG8pEiS&_nc_oc=AdoBep03E9AlYJagQimJRa3wsigJTh8Ii6NKxSYuU1sw8hT3daSjspvHuo4TMunmvm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bvTtyFSzgvy5jFgBdrb3Wuycm1Qcz1YXyyCoPD0Xguw&oe=69DCD176"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
zZeMxIPe7gQ7kNvwEewmYN&_nc_oc=AdoRpUc09KJRxwi6NJa9uvAOH0tRfnc91-zo1icT4bYezrIR7u0vCXSMl8ha5N8rhfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af667izBHDWl1Ji9cqQjOCrlUk19w-6-rxNftl2lH8T0zQ&oe=6A199A7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhQ-lCEUxp0Q7kNvwH4VbmZ&_nc_oc=AdojEPsbOIbIcK1Yie9j5MY7mRSllfN38-nxZJy1QSAaye4UmFbkDyHOUYs2EuvNx1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YXR2m1GTUD5O4FlOHGevonar6ArkP8dqp2XATsY67Hg&oe=6A199B82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNf1gsfXLroQ7kNvwET0vuQ&_nc_oc=AdqwW-ujipkNhyt8OjEpSJZ-Du--tMnVeazLkhIC4Me_vopy-7DiOCQ_gL1ntzPqcJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77g_9MPO4y6QyZDOSJkNIlTBNVO5kS6IcSarAInienhA&oe=6A19AAD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6GUkH7Lle8Q7kNvwGck2Cg&_nc_oc=AdoQEsPlhjHw-_L6vkJZ8IYhXlxyyYxoezB0LX-H3Qv6O3jZQMuajoeJBenV93Jz26Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aI704o9Oo_mW-Y5GLmaDwUQmGVvCIuSvB25tXaarymA&oe=6A198D25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP0VUhk6OnkQ7kNvwEnXr5-&_nc_oc=Adp8v9pEohzbu4qQwJdK34Od8b-aJUQPXr0OEGIaTW_nA0k3yp5hx8CIjhpSSfzxgSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T3xzWvgLCR9AlA2mwRdijXs70ZvDTPwEM5sgip8M7iA&oe=6A19AEB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
Fh7aTqB2KkQ7kNvwHrI-XA&_nc_oc=AdqiWlF4Xl26agTN4ok94HW0P9PWmno9ZAuyOpV7-8BoXcQtO9rrgtzZyX5c7I4tvPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQPSTjJSrK1a50tSTwTciWtlW-7-43sESUuOTXsnRjUw&oe=6AAA9F7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyiXQsNrGxMQ7kNvwGPC9B-&_nc_oc=AdqF4yU9bAwqPg01fYmi2gQe8wb4rVocnHu6-754Y6H2GBtx41hczt9faJwK7LBsf1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY9-rTMPLnUaAf42aHlbtuI3fvhoWA3f1xhh1lkawDYw&oe=6AAAA082"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTmOH_zzEaAQ7kNvwFqGggZ&_nc_oc=AdpltU4xHlFBxKRWntTP2hFSP2QVZUirda7JTFZxOHN9HtzauPR5TrXL7ln-HH7dTlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxtVFCeLufTDMYJE5CMMhVuvEcahjpYtB4A97JkkTdMg&oe=6AAAAFD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaJakQ4AgJYQ7kNvwGuBuKU&_nc_oc=AdpFOSyOJzxmhYeVRitnpkcnupjYNhUnqnl5TLqb9LMbEFRDGwWQHKvTD8354VqB4K4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5Il4nJTwbEkS4733kW2jDnPIkX75rLNcFggwWcnebHw&oe=6AAA9225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_W2oQgthqkYQ7kNvwGRtIh2&_nc_oc=Adp35JsjkiyiQpElKugLkV-SmMIVX-N01fkqL96IJN9hqh1JFqky0VY6Qym3XjYVx_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtA2l0hnHME0LTa295_SxQNYpqs2k1HTj4ieynIFAV_w&oe=6AAAB3B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
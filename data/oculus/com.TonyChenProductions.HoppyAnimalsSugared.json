hc=LTsSiUuMUXwQ7kNvwHQMbDq&_nc_oc=Ado0GaGATvmqOgO7kl_KA83ocptE_tWIllZZyf1YhfCazXIsnIMBqCoTh6zLGIk0y-Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk_xI3wwunUSWUc5XFoTJMIonlQpEyZ55kAj1PdEHM4g&oe=6A7DCC7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuofUdlCEtcQ7kNvwGquJua&_nc_oc=AdqEYI05nkHC0eGJzpFOQkKCav7PFlRtKxhIaVhBp8rQA3flY3bkTKuhZW_AcoVYapU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFGOu7_yvUZMLXzFJpjoUTNdmw9JqyBh2F8tbpzEBb6A&oe=6A7DCD82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwigwj5uRxgQ7kNvwEJC5UP&_nc_oc=AdrcKDe7HJk_sxbbQdC4t0zemnbDgSAQL-fW_pklL12Hf-8-JWqUepHMPDM5R0rGG1g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWg3MZv_FfYUkM96zMOZdOydhDiYjvX-uU1pHQGvZdWA&oe=6A7DA499"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRd8L7QQbkgQ7kNvwH6y99X&_nc_oc=AdpGi0zG1XSBwQhxeK0TnkCVsSMEMtbeYgO2aUQYT1NSOX0aCLjf1UrtsNq7wd2VhGA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-N6ZmX4_npHPFEKGgL2x-BP3_GBDfYo-FWKzmCMQ6Cw&oe=6A7DBF25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I14SwhoRtYQ7kNvwGAcRV8&_nc_oc=Adr_2VWW1CEFfVCS_r9dlZcy8VJvJukO7t9RIZkCK9qWQCPytUix7BxXvOjFugGEt6g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5QjwRSS8dwlSoE5TUcLAj9rG4VpzS7TzTT9lJv_Cg5A&oe=6A7DA876"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT
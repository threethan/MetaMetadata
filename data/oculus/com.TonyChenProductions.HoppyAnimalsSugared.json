gjnz06iwmu2tDias6RUtxBBfxkQ1hjnjrZbMDy8-PM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkU8xExpvJu1S8R9hSUbqGknQEylPmrbZFNU4tbLLVtg&oe=6A9EB6DA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd7BeaRyK9EQ7kNvwHuLbsG&_nc_oc=Adq0gcUGQ3LUFFwz9hn6H2uGQLYQxJUSjAyZGbJ1Z3UY78pCkfCWb7zJR-otA7LjTcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv9FwCllHe5YpMptP21VD1ln6Uz-uYD5xTI5CQsgqrGQ&oe=6A9ECD83"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8JYOjO6xcYQ7kNvwEoa_3P&_nc_oc=AdqDuJaftmJhF6SQbO5klQJpMZ5dEuADBNGHtlJL68ruXkhlSb-6UQpDQenZ9w500Zo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlh-XxqyUvVJ8FJTCALlCprNJn2tc4aASLyAUPUj60Sg&oe=6A9EC4DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
mlRlcQjVi0ILg-YnKuMIdkEoJ0XW--pT7nV0FVGoEgavBVhFtKEeT-6Ix9WPsAM90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHh5TCW03ekh-lSvRVm3Q39zJNC5e1cjy3Mzg787QW8w&oe=69B2C57B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSiqzrX7Ee0Q7kNvwGXLmqz&_nc_oc=AdmlDUGVRqnIDe0D4oZD7HyAr760C8KhmedOnwGB6y_8nm1MJbTpif5YJQeQuHd1hZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwez8NqFALuRGiK5i2tiKpEQbjV_6mOhHLbLUgoLejo5Q&oe=69B2C682"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF8pA-V_Mo0Q7kNvwHL77S_&_nc_oc=AdkqkbMhnx1nF5EiLgRnTvrqyrejtYgKuhfenyzbWsQxQ4r_wCtdZs_qRVyeqkLV6xQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNIrz4WC0T14nXxt7c_l8dp0-zINGcGvXLls2Rirm8Vw&oe=69B29D99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt2zDcD3cK0Q7kNvwGxXhze&_nc_oc=Adkm_vq6mpkYgv1UqsMW55ZX_w4L2xrH04UfNxVq3egP7yj935wrxbGAq4otJI3TcDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5ck6-pGAcAF9tePZ62gzMSyt0fXEE_oO6PdZ3FKi-LQ&oe=69B2B825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mnBjA6QMAEQ7kNvwGp8PiL&_nc_oc=AdkvjT-ttYH1JWqo5_m0hyaEMUiSA-dpF0G6u-aPgyN100PZX0njbhZ20eSC1fDdlFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTYT1JEWK-2W6apedwW2LlN93ogdYu7vHfFkoVoD1wHQ&oe=69B2A176"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
RBCp4qbpqMQ7kNvwF_Nh_U&_nc_oc=AdqdEr9EaMxIuo7CJm9R6yj1_JgELfhRVWEGkMa05td9nrWihW87bt1FilcDEFEoXjk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEyxEejcZbdCN2bc67c5c2pGV7s09y67cOAx_T94E7rw&oe=6A88203B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftWIVjux1FQQ7kNvwHxjCLt&_nc_oc=Adq0XDQBRTQgpWSiwW8D_1AanUezaNitW-cB85HGnW5i4jZJEJ3TIyfw6Rg97mRZ2g0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrAQaqg_HEWI5crTNic1GAc98YurpnWOrHvrcWyvIssg&oe=6A882142"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvAc3khoKtkQ7kNvwEEmlU_&_nc_oc=Adoj341pYe-nA4Ej8rP1EEZDydDVxJG4vRNOrCs99wYt8d6unWumf8Yskfx7KK9J954&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGooBq7Sj8RpatYyhhSiPCm5XUGfxO3_pm0ZkSHsx667Q&oe=6A883099"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2em_bHg8JrgQ7kNvwHTtQbl&_nc_oc=AdoH8kilyNh7vA1NTkuOS3YELhLnUzzakJJbrNYBZ8n0M1nC99LEc82R1IL2b5KbPLQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt7_otOJq9IQ-HzCV-V5Ika_zZ_gbKrqwcOUv5sFyPyw&oe=6A884B25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKQuwGCcA9oQ7kNvwGE5Stb&_nc_oc=AdoYSKnJQv-2sIWyFCAU9DjtvrW2y3xdvAtg7RYS4vF4xVHp_8NN7-8cUZjPWd0SRYc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs5-X3F7w7qObwM3b5ShFqlEV6T75laBrb2Z4hBNKACg&oe=6A883476"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
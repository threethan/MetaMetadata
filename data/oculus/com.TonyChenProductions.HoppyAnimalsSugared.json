zZeMxIPe7gQ7kNvwEXpLxr&_nc_oc=Ado_FNsb8T0bm581Akr5Kz1kQWgXwRh8v01p0o9sOdo-DLu74_tXbCS3pfrb22wxYFg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SZUVx5GF3MZl6-IGMTocOxET-kaNQKDYRAmhlAwvr-A&oe=6A1AEBFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhQ-lCEUxp0Q7kNvwEqcw5X&_nc_oc=AdqGP46iMUAxW8H9mblbMICrlyr_KL7Tl_4bnVYyJp19CcFDoqlYHxVlis9897A9YGY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bejh8R4H2-cvBTYVkCtseOvwGQxqoRCJVpjr02qa9Hw&oe=6A1AED02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNf1gsfXLroQ7kNvwGB9GtL&_nc_oc=AdpIIZ_ZbAslC58khjhY60H1zKEs-8ACfARAZ5AQs0047NEiIEA5OJD3etgR3R9_arg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uBTq8GWA5mCKG_8uYvjEV-TtwMl-8tFtASbwxinXdZw&oe=6A1AFC59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6GUkH7Lle8Q7kNvwGuvZJp&_nc_oc=AdoZYecI8yPzlDfpm_MY2mPXV__7MS09pVzD-CTLu-Vedc3MbU7e6qj-cVVHnPRK5dU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ugGg1kNLVhGDykkXN9CfJu6lJd-KqCaYZT7pZeDNbyA&oe=6A1ADEA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP0VUhk6OnkQ7kNvwFKY2C8&_nc_oc=AdqBzfAQ6yZHOOB_9ROtoqShF2ZMqyY2C980xtRGSbXh2a9NEphn49oKDr5-285N82Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42xTtjcQx9Y0axGtwB3X9QTFcBEAzHiLWhHDrucS2MZQ&oe=6A1B0036"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
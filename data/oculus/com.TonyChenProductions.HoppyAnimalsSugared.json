YtfrdbqkrMQ7kNvwEOtSlW&_nc_oc=AdqDgmNEodIBfYv_-UB4otAsgNkeYzMO7f1QbiPc791KjdKb73rb3ObcOIo5eCdjeUE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhCa4OJObtBzsiE6FhzqICK5OY1ipKOH9UxbIowwcuTw&oe=6AA164FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDW-YCbxhDsQ7kNvwEAlkn-&_nc_oc=AdpfKv1FAvUpfFqSjObNyZC1CiWTcb8aEQRC_CCxptINLuutZfjmLRqmk45SbVtKK-E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIfj6nsHdD831kpYNNl08J6el7mEMqPJnPIBnx4jHDZg&oe=6AA16602"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY4d_9qjekIQ7kNvwG6Rcqg&_nc_oc=AdrGqZCLPvokeh10BxE4Z88axPhHALZCpuvA7LjcGrrB--BTgCig5fJJujWNzv3FCWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUdb22Y_7G1mjFxIaNw9oJiS4kICeOFgwubwSxB4HJvw&oe=6AA17559"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKuszh54EUkQ7kNvwHVAg9o&_nc_oc=AdqfCubfyrpHv9sPK4_E7Rqdotva5qU6AO2R75FNrpaEoGFiMTDeYz3yuh9SKMBv3Hs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW0chHgt5feSI1NosI65eGEqfYO1SKqR5ZM7rBJkh9bg&oe=6AA157A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz_DtMttXyAQ7kNvwF6SY5G&_nc_oc=AdrUar3m4CHyIS10qV6J1-3dYX2edBRVXhqQscQbE2hSytkzxHfwHNRFrFQbWTJplmA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFhsqut9z2WoWUNR6z0a0THVOgfmQRQHx1sru4lzFkeg&oe=6AA17936"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
5mCvVocupwQ7kNvwHbDRT2&_nc_oc=AdqKPICqc7NeOELFV1GvOBMO30L9jFzEuKHMFVMdC-yPOTv8FkLwfgLgaUxKrQD4EaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71kgyxCeqn4bqd9Moi8t0TgsGJippoO05uZIvk070uuw&oe=6A1D8EFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8naZVzhC-EQ7kNvwFcholx&_nc_oc=AdqVG3jW4UmZUtZRsK0wyE99sN8AMEHdPfOC2LrMGgjMOtCkvvooxk-HnFFKYQ2RLRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zV_k24QKKPGO5ZOOMwHXhQ9-srUmkB9U3KzOHcJKokw&oe=6A1D9002"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIi-WhAfpgQQ7kNvwG91VMK&_nc_oc=AdrNPHYkbo7cXdaHIXDUcyObCL5ABBWjYgWLAZM2w0JJf69dZF2i3eF-21PtjvyDR1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fr_rVrbUB28aUh_ccgdDF7nLpo6kJDqT_f2cTiFVEQw&oe=6A1D9F59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgKwjGAWUCEQ7kNvwGmeCUS&_nc_oc=AdqP8wyrlxg8LgEJUNnbdeg_sMcK2Id_t0OfgUbf6ayDts4YlVV7f-b_jrUwyX25zC4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OvBQRLDkc3gNbizzcY-RRrOz8H9-5oY4gdUFUXhM9OA&oe=6A1D81A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0-vF83BCSIQ7kNvwHCKOuv&_nc_oc=AdqPo4oqutc7LmZPRYxCw6PipYn8zPYsc560Im3dOgEiHlBzVtJRztuldXo8fP65ubA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QIPXFWiJ7FUr5VwIRiUAMEn0RYEEv2VBvIJB5QlP1nw&oe=6A1DA336"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
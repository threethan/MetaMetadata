jyQ2ByTQe5NDV_5B-HkSrWpQBD89_36lNU8SiJcZeQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVSXbBXx4yS95tsXhrD2I06bIujU6xdihOWXnZINiOiw&oe=6AA159DA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBLb3UPIeD0Q7kNvwHTUGX0&_nc_oc=AdpVGsJrOwIGLVUn2_aVsV7QDxFS3XrTDF0VQIfbCPm-VvsY-MW0TeL-D6f8qKD0qdA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZo0_4iDGPv0DdAXJeiPZnqJPIyfMKDkpPRUfsh3i-CA&oe=6AA17083"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqAQXJthGhYQ7kNvwEzXp0X&_nc_oc=Adr7gzs38XVNj3Iy7VoHj2Qpz4dDOREu1NT4CvB8ZsSmIROyRCIuHWyiwPD7tiTEvZ8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPQkLvFkD77mQUeMK2CeFaQq74bwZgH7Y2gHwBZWYmsQ&oe=6AA167DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
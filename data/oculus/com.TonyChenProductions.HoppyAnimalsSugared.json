0yKnjntQTsQ7kNvwHM_aeF&_nc_oc=AdqCjYb5HkQ74pHaUhEljTsn36twchhIXZq1VxuolC_mqfXO8-6xablU61mjC2Vgdnc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEE1i_HXH2yNwwNKS3hVJPL1NgFhZGQmvAPDffFFyxmg&oe=69CBD1FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixkGcnLKVjkQ7kNvwGkuVS7&_nc_oc=AdqOfP9sxnhNcgMZrMxk6m-MqiyVYBNB6Iqt7abpTROb_e0ZId1MfL-o6ucf6GXqYWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5CdfXk9w8UDtgBuiTq9NrOpcAwxsw7iVKDDe6BU53fQ&oe=69CBD302"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLYxbgvYUlwQ7kNvwF5sV3t&_nc_oc=AdpLU-SEoIIcaX4z57tDg83pR4RGgij3hJkg50rLSbC8qAjovKV8BKa406ZA9z-9dmk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzP2heNrPkA_t5-J8z3UAWNOOqg6Yt8E9rE8_dFt5Yu0g&oe=69CBAA19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh22ziC7R0UQ7kNvwH1zdqJ&_nc_oc=AdoSFchvn3kMiXx71mAEc0OoMRtIpwzhScC5Ew00-ykMN66okUeEyfVCPqsUDmLhTAQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwznE11Dd5CdmCJRRW89Rn2xrZB0jR1RCpBm9WbNFQclQ&oe=69CBC4A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9zo956Y1nQQ7kNvwFg25On&_nc_oc=Adong6SPVti5nUAJChqvCkXwuKHB0g7qLbwZbjILhrdDGn2sGrft_cP0_7KBcGI5bIQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzca51iNPzpGczYkHdADRG19MKyJz41X8VxTHauCvRfsQ&oe=69CBADF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
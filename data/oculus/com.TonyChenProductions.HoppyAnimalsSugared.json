=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft6CxRGSobzIYNBF5J74VEO4ZrNjiguKOizFfp8QypIGw&oe=69A5967B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkkWiaBU8-4Q7kNvwFFmD6j&_nc_oc=AdnaA3E5UWaRgnZ9-jmTIOR0Uwi13BrxmtlKfPp1KuZ1KLaC0vvlxW4HArMGqWekSTE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsJ2uYptkTUrM920EPnTcKC_b926I80iIQksbizWZinFw&oe=69A59782"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXimPMos7EkQ7kNvwHep40S&_nc_oc=Admw6COAKeU1NKDA46dE8zdX646VawFwwQrVuCUTlYEcoIV4JXx7ngEOYBHbOQ8qas8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsIAFdlTi_RZF5t70Q-6RnrkVPyR3hfZlFHrXyebktrSw&oe=69A56E99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZUMRXvz2aYQ7kNvwGs-aKO&_nc_oc=AdmvyfDm752kr78fBo6znkmAVbdH7yfhIH4q_yAXkxz7obBVbzoC80EqYgBniHhurgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs1Uu1F0KI_4HidL4W-la4Z7teqeJ8iutdTJJSoUVrPGQ&oe=69A58925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FovIMTKXNR8Q7kNvwFKDtFZ&_nc_oc=AdnF-o1GTMc-8oN3oD4ECfsjXBanWXf92k3lDE4X7eR1rmovpL9CJUT8A4OAtg18H5U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuvUEeEOWYXlPhSBsokhQDkYsQ6v7_nEQ6nuhg97hFtbg&oe=69A57276"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
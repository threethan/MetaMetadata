rwH8kDekp3rMtL7BstFAiwTVhSsyjM1j48xgBmRe-U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlTgGGZdAbzMsXzv2uooVUhOEOP2u62z3a3RHYgR2Uvw&oe=6A66065A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8bCvg76CEoQ7kNvwHmLtxR&_nc_oc=AdpAXDHmbQyFkp2chHtqXWcZDknnOqhx-Ds1qTGJFXwNc-y2xmdQGUOTjyoQ-OmdmkA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPaeoyu8Bsuf57updamNH0eP5b8XvTQ5V2zoCO5DAKIw&oe=6A661D03"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcAdPtDlw4YQ7kNvwEfyTjs&_nc_oc=Adom54USD22U8lYQQryGYGzthjlE0_C_cfoe1Ff6XLJWk1Pe7UACwZsAxstSALTUiY8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGIPDLU22AUXz0o3saImFyHcfvZGiLkDLy39S7yiMmmA&oe=6A66145E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
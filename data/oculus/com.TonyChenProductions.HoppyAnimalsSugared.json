f5wUkvNCp0Q7kNvwFko7ZB&_nc_oc=Adr0OAzNnTJNczc72umZ2g3iyCIDNMp1mqATO1dGAHM3umZxiVzoSaKFwd4brRzUaqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B3flpYPu-MRHVOeJYHdkRGzm6ctJGMsCwznkAey-R6g&oe=6A04827B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6c9oaQP6_wQ7kNvwFFXwPe&_nc_oc=AdpsA0yYZQFMly2Dwr_rPl5Orm1mFsDiiMP8eGdeiaXs-ZJ8JKNhMeDybJXjkRswZRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r31ERJW3xJDAQM0Y4OZYgdOyg3VIBNrioL2iBpvSi8A&oe=6A048382"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iIM0MQCCCkQ7kNvwEQaZ3O&_nc_oc=AdoRtJ0Lq1TgNmokzX9YSiuZNUAkeCVGLtJ9OvzwlR-qMWxiym1XcYpsVTiKcFwC-wk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76eYiC5CBTRbvBqgIFCvaiP88VrElkxlI68SPae5Pz2Q&oe=6A0492D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3SB5WMIhK0Q7kNvwEs-SoM&_nc_oc=AdptMXnHiBJmq9EW7nFmg237a0PYPa0gxU64CFj4CEaAlXRwCAX4qjQc1ktA0GIrKXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49Czervj5xufj3JU4MSaZf0exKYqFO4yqmLok7pRZlbg&oe=6A047525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP7pLe4ZtMgQ7kNvwGZWJat&_nc_oc=Adqx7j6j2pB8Gpv_weOVLj0wV2iwi_hdPQtKLIJlE5TgaUmEztOw2-vlHec4sg5jNDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VFbQz1kk5BibTsLerMqIFcURIbSvpHqXpgBd5tiLCvA&oe=6A0496B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
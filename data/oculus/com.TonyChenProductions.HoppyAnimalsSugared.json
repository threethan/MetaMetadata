y7B_Dc3Wv6SUUiRbYC7j8vhBiAWGNmn5UzUiDmVsAE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IxLoKJqOljBEJPVJji2u4KP7UeJV4Uz_1cA96Nf6o9Q&oe=6A09BD5A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfOgRMbH6KkQ7kNvwFzQQjE&_nc_oc=AdpzhzKpyjpSHav9boG1wBSAyUuC0zNVRCQ0B0chPmrAqVS52xJMCkz7K6CVNenjbYk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CilLHbHLriP7TNZTeaab4lPqJiptOGS_nl51DPdqX4g&oe=6A09D403"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyksArRTLSkQ7kNvwHOZPCx&_nc_oc=AdrNtUoUF32r9fhhIQcg63zLQD3DO453R22Xi-4iwlzi4zqUwZnH0kjHv-MvkhaJSbE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47eoKpRyK2Ad1_lWoomrTuNBOyiFKvPmiy8vglDXNHjg&oe=6A09CB5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
EPFPDi0BV4Q7kNvwG_LcZZ&_nc_oc=AdpMEaSzDdNgAiPXXhOb6UUHlxX831wALP4HB4VGTPHv-IywfC1hZNftM9VqtxkYPg8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ozpohe4lCH76DEkZocj-3OyKtQt_kSY3lFNyzGO2Nog&oe=6A09C87B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofLQZD4AEisQ7kNvwEMZG4G&_nc_oc=Ado47cAZEUIh2BzYT2V-Y6TMyA_nQRHfvGWjtdFJ20Hd9sTaRvhao7P6CVGlmDofQlU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73cQezDb0NeoX6vJPTjL0TOsGp54N32QeL0Ml8ux8wXw&oe=6A09C982"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prCS49kwxLcQ7kNvwHJbF_N&_nc_oc=AdqH-QM7NdxOjLv_Wa2qd5dtlQvvMS3JEk23yqKyduwP0FgVt35yw1MBwVw636moRVg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h0PFdmIq1ZRrKh6uX3hi4UZzowsJmciqztLSYtx9-bg&oe=6A09D8D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyzvRItcfREQ7kNvwEVLBF4&_nc_oc=AdqyiH6ViEPwoLQBCvcVR_hFIpzRy3ztTSIJvmz7P6lLuPxn6yGhZhXAuwdpYuAaHrQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J5p16a_VWxal_5On6Vw1DllY4egb2pqDBM3wFfL_hYw&oe=6A09BB25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyqfQXCV1cQQ7kNvwE2phYw&_nc_oc=Adr9jVYYNaRWflSiTwk65MTjMJZQyjSx4xMUSeWKrFKp4GBaRC9m5g9HpH4g63N8BvY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ISWhlCp0rXxz4FaDLTG0hFoC6zYjCFY-HiANb9_i4HA&oe=6A09DCB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
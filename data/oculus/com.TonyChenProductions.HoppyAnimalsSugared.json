f5wUkvNCp0Q7kNvwExekXU&_nc_oc=Adr_jQkmB8JOWg0iqw_qxB6bsK-XDnQDV2pYMcXJjwnwMqluirkg81MfgpwtQB-U-GY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rUgihK9S7xTEAFsFm6YX328IQLktXEVP29RlNLNJARA&oe=6A01DF7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7rkREwBHdYQ7kNvwFFq1ad&_nc_oc=Adpf1abNSs67jF2DUdZq7NBSjk4OLIhtyiG7M9UneIkdORJOi2ieOWdJzGSpYzIdJTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rzGZzjD1Pmtfvq9NesjB6v6ZHKrkJmB1CTz7mLPmRDg&oe=6A01E082"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iIM0MQCCCkQ7kNvwH2NwwC&_nc_oc=Ado08UM9DSoDzHk9egx_tWHLrrAEbXjyXgFSY2m61oIbwE0vx_KVaZWTkdenHh7wezo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RYu-Kcyx56ZC8d-JO9Rt1Rt66agBJL7s9p3cuHO7ZvQ&oe=6A01EFD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbRULX9ZS6AQ7kNvwEGJRQz&_nc_oc=AdpGO-Q1PEHD3Obl1xQjzxHPoFr62KRRIAWiZR7VC5iSbomC72x0jN0_KROcI-cN-gs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gT4ga8YlUSuXZCo4C3LVPHWDlaUgv2DTGdhlntpZFlw&oe=6A01D225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP7pLe4ZtMgQ7kNvwGGJlx8&_nc_oc=AdrZ_HIauRRJwHunWcOZdhLsHpZkVsFeg0e5E4T_xQPjG6QJSGBhZWk7RJ2KPhUQsWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h2rTMSI6p60rNelVGBNSgojCtUGOcIPoBk7OmhUJaEQ&oe=6A01F3B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
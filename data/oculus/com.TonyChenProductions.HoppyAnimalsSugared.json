FmWSjy4BzQQ7kNvwEyKMJQ&_nc_oc=Ado6SqfeOJOJDN9Egx_r6wvILHzHNTRQ_qtdrQPC96dbP-DQXvE6YWJ4ZVezJY_hNPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIIADPtzNeihywN6bJdRcPIjEdPdLxNrFxUu1QchzGcw&oe=6A79D7FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCIwjF6qi-cQ7kNvwHMtqdE&_nc_oc=AdqK7JsNkQ-XacecDiTo0Gqa0C7BxoVtJSlwEM7BqHchiRkK4h6bDRHex37WbYjiKOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOsv3uuGmyXwlEEceF1bdG3Kw4gUm78sQr-pqhSdyO2g&oe=6A79D902"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gxaa9bNB8UQ7kNvwHZwofk&_nc_oc=AdqF5WkU99mt0X9f4s_EhtKnklx1TzbuhEsVygSB8cBMRlZZDNhzJT4tuvxrPJEpnyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5pLnzJcfuuum1QB_KKzKUPWlHHeAeWAqZqPAnhTPSAg&oe=6A79B019"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRPV6ERd9E0Q7kNvwGFlMD5&_nc_oc=Adrnvwsko2Z2SYK3WxOjZM3NgTJL9U-1EUbNPSfQDtR7zs_-t8dIxmSG2966qckbAGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjUQiuQU2mOIDd6ZJvCTMdO6ocsDKY8x3C0fEnUgVKqw&oe=6A79CAA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZo7xGb3X1cQ7kNvwGsmDXz&_nc_oc=Adpyt83DD9kD8yCypreFjfZEO-EWJp1sozzkLzmSmABzzdqRm4pkRcaPoDkfqbcfWW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWw9zTz25raUtzsuC4zYPhqOfwLm3eBIfqanGvFZyCGw&oe=6A79B3F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
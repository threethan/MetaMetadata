GBRMmwjgdkQ7kNvwEMtD8o&_nc_oc=Adpzm4yB4IdOpHzZXOzDJJ1iOtQIgzjyseZx6Ml_lS5lisK0qR4Pa1DnVICQz2MlECk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NINQSUvpGzXZOMZ4eaUS7N3G-t84MNtv8_KtcFcVJqQ&oe=6A0F0E7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpU17zBTucUQ7kNvwGvFdgF&_nc_oc=Ado4ApaodUAUUgzALJMz3Fv8T-XrbkrSZ9MkbO5gRGDJe0af2-FMUAmA7UiZqNEEZG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i8tfUQL3MSSwX2zg_TfAkkVFGptVA1cO6bWKbjLG_XA&oe=6A0F0F82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPxj5kbW9C4Q7kNvwHOaQ27&_nc_oc=AdoPau_JYxqKOV6IGwk1gloHyh-rgq6fOoBPBzQSV-BVSxJDO0TzThyHiqJSPHKeONM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47DxzdUUI9FSM9Pa-AYAl4c7tyMgZykZxOE2q8Yr6_iw&oe=6A0F1ED9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK8jD5PBCfAQ7kNvwHTGTEI&_nc_oc=AdrQC2BnTd9TIhsCxHiMCIBkJvZKLYrXltOwIYQaIFjF9b9xvriNBEYjKLImXefihbA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70dDMauwQd7uLFFYonK2PansaRoj4i4LrCJRz7FhV6Ow&oe=6A0F0125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFij9chP-2AQ7kNvwHnfUVv&_nc_oc=Adq2lfWtw_TMeykbpAIp-zKc6I1SgWNUUKLbQ3e4q-eI3bC3mPdN8yCpb1_c5L2Vz14&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ayo4AAhmPJcnb1wZ9NcQdE-6U3pRZBSszuAxUzY4BgA&oe=6A0F22B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
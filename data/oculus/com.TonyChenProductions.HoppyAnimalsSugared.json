=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7hf02xE4xRZQ_TRJPrBi0sHAZRF-3LDObUdG6y010OA&oe=69A2F37B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMUQyGLVYV8Q7kNvwH-GqB3&_nc_oc=AdmfP9JZVP-wX6GUgdoLDSH6FnUmlA2Ib61Hf1zVZxlh9dgKT_R7NruCcMFE-lENaFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuAYclqPVEddwpFKfDdytqKoN5H7RHyMQvzg3YlrmEEKg&oe=69A2F482"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXimPMos7EkQ7kNvwEo5RsM&_nc_oc=AdmspPjtFwMopMwMeuRBHtz0Yhl0ROjJJO82X4Tuu3D4H6_W_c2ew7GCDFGAYOpLQMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYnVcs5MVyiTRULbXqx8_5wknwHHh5fQdvW5PKcAXOZw&oe=69A2CB99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h3QVWO-6_IQ7kNvwEFZX3c&_nc_oc=Adm-Q1gZm4JDscaweZOaYm2wZ-Ulrd6YVeWFpBzyckxc4OesSPP_8E-hQiUEa8RrxSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5EY63H9WSKgUpLRjih1iPonpCXBDUr1FPikSu1VI9cA&oe=69A2E625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FovIMTKXNR8Q7kNvwGHMJpB&_nc_oc=Adk2JuID8HOrzzxXTd2aPvOVK0B4buTMl680UqvSlx-krsZSz-C_ve4u89mOVnj-l6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurLcDdLrBgj_O4VulYRKZQETwwGG3RjBMrvAYLAjCtow&oe=69A2CF76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
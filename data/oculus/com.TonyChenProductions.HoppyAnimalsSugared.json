cGpDutYIakQ7kNvwHrX8m-&_nc_oc=AdoYQIDuKfDEXZDmXedfESGCxGB4K_BVBms9oMOgCulaOmCdkLHBoLEcVveX8JrjJT4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrJqrR8v2POAnzJfxdQmOyM4XCZsiWM075MxrdKeob8Q&oe=6A9ACD7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlFvjvIQt_QQ7kNvwEf1mBt&_nc_oc=Adrv4nQK-2b6Fa1UlUflnDsAs1Fsn5Gt3ams6hZMXCAEq3i7krF9XHdbIf_5DScAIzs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_J-Vl6QNb9DuiMwtSTYJosx6zubX9lw3jR3jsgNkEoQ&oe=6A9ACE82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebm7_crbTdMQ7kNvwHHbWqO&_nc_oc=Adq-b3yH8GQ2t7ZVWA5eqFvifbCss9MTXcZKecsU047ilCDOmQ9jv4qCbDa3bCatAAs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZP0Uh7qvKNjFGDw-HMn7K55RFSgSHjhFaWgX9Zfx8-A&oe=6A9ADDD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7vq0h9ss_IQ7kNvwENkUGN&_nc_oc=Adqt2oWGlHYc3izqExnqse7ETAOglhm23APwKHiTlRtpiFOaQUE6PeLga4SdDL8YYFc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZaCKWyPCf-XsCklO6C4igic5bsX-h63qJBDnqeEAGtA&oe=6A9AC025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxF4Ky3iQy8Q7kNvwFTafIP&_nc_oc=Adrdjyl1TFtOUntZUmNdDyUI5RQVFZYVHRryhET5iXpvb_VuNEQ9W4UjMRTFTY-qV5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJcqIuHjJ0-Ztt5LdtCHN5RxhKFUFzLokTuyGPlUUZZQ&oe=6A9AE1B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
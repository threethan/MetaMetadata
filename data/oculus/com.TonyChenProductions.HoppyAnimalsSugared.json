2WQ38i5UCUQ7kNvwEljXVc&_nc_oc=Adr5PvjFb7lDiOc4tVuihZDHzphejS8K0I06688mlUPCE-a3d5y2irlBju6ADsRp4_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bk5W5hjqInbakxU-s98YmRgU95x6qnOqT_aXg-0-AfQ&oe=69DA527B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ww_HxyCmZYQ7kNvwGkQ_Lj&_nc_oc=AdpQ5a9sPiS8lU2rQS_QEzMfByh2N7dObD61bE1GmmYAwlipSQRratTieMfGX-ObUbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n4Z8-1TGldpGSWI1EBpFuh28rqHbQL_8cjjfTyDaAGw&oe=69DA5382"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHF_85o3dLoQ7kNvwEkZkhb&_nc_oc=Ado03pEkLCp0C13p9kncsEtAMvkMsg4czTgzuVxtd8XRqkTzCbtCxbETRCKQOEhOf9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Csnw2XOEUPx6BYquARqz-4l4Ynov3Wz-J071UKljdbQ&oe=69DA2A99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbgYEFBRXL4Q7kNvwGAwrx9&_nc_oc=AdqCx8Z-bIH0xXeFvrk_w5OSds3uNjY4zWpsWfGQNezpO--BOl2zFHxks7-4kijms4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nkdnRL_M3SiWcBL11bH5EzHc09DHHCrXR5B2AyQbcIg&oe=69DA4525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoVcXiNd8U4Q7kNvwFasjnm&_nc_oc=AdpzieR-ZwwQYSvTK8luR0bDfHcK_5vg-yD5PFQlxgUkh1YWyFC_n-S6Y6nJSy_V_jA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xxpLAEi1fY8BFvB8TeKpa65BHR66qiX24jjLbMAAFeQ&oe=69DA2E76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
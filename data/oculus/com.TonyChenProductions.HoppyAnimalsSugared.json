m9-8lyxoVwHB00kZu76xK1lauC2ZOtQBtbbHpQow2LYnNi0gJgR6vfRJQzP7eqAAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvx95hipVKMYe_KwNIZIgVstzJJCmDgRiG9yKKS-fHRjA&oe=69A98AFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p0OyihoqeoQ7kNvwFEJutm&_nc_oc=Adlv8zFDUMLz94K0qYXapMhlbiY-YP8EJmdLsn5LQ6N3Goy0z-z_KlGX4rpFofDQgqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8UZgXnADXxn6O3yX8_WIposHuvPYX8prhl56HPvqmMQ&oe=69A98C02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw4bCmcExOEQ7kNvwFtR9oD&_nc_oc=Adkw8CtaemX7xDiupMQMcbE6A7LiwywT_CUhWuF63KqU0a3PvQOPAeSL3K6u4cUXCfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftvpHwKVXaikewwWXUCRqE8GXinbMdGmDjtddB_6Af8TQ&oe=69A96319"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRVMtCItx4QQ7kNvwG8XS7-&_nc_oc=AdkVnTzCg2FIQ9bEsl-QW5WnYsZ3bxcv5LmXcdG0Da0Kwql1NyMYFqgFN1UNr32o5nw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu32b7Wl77Bd7AmZVhKaMI5c_N8HAid_nSo3V1HrnUUMA&oe=69A97DA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FOJgdP7_lMQ7kNvwGdK7cJ&_nc_oc=AdnPxn3IUnvrulX4azghGRNlXKemNuvQv89FK2AykY_CTXchq-YLUQER2GhJMcwR9bs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft0W0gBG6ke4YA4Wv3Rr17C9D1FMsbSci35R_O7iGgywA&oe=69A966F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
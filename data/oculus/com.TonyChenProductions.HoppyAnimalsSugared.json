Vqfq0kEtQoQ7kNvwGbg_Yh&_nc_oc=AdqNIodB79j9kfb9M9gD4U0_js0iuIRaGxmvRszroptBwK3SKKrtIzO7KVqA5VXWfdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObwYEpsHNE5l2oQynFcnE4eRAK21x255Xyf9rOe02U3A&oe=6AE4A17B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A988cXNLGiIQ7kNvwEDibXv&_nc_oc=AdrPIqXUIxDvRtVH2v_XUZIH8h0jPJXD7Yy1MN1co2UZhdreRn4LWNW4xIPxjeoCB1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiZtBbff8RbmR8SKA7CDRikXPAVaOLoKCj5eAyeQDeWw&oe=6AE4A282"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jf_4X82lFYQ7kNvwEyrWGg&_nc_oc=Ado1vNj_Vk0JibLQnTOGNCq5mP3LNmSNDv6g0zfMmPqflnF4YHR9P2gnYG5HaBs4LUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDtv8n9VTfFuWbrldglp8G2qBTxOUqgGptrpxWNLPvJQ&oe=6AE4B1D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzdJmWxVtJkQ7kNvwEVrqMq&_nc_oc=AdpS3XaUm4K-BIu_3qlzCCLRlPwGom12PzcxKt4mzK5bt4lLC2OUNi_We8HI3DMeMHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8oUPvg3Zw8zYn901QsGGLi6uGNBi46d9OjsuhmZBcSA&oe=6AE49425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3E59VMnqrMQ7kNvwF2h8Jt&_nc_oc=AdrAr5_yL6Cb6bPOpMdeMvA2zpuaZW9k8NLmZyevJ6xoEPmpxjnZpGi4jvG6T-RJMys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFhnsgXpvUXxGSeek1O-_3xfqJ_i2yPL-OU6Dt9nFKTA&oe=6AE4B5B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
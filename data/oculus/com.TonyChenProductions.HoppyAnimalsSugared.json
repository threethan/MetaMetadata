p8P6KZeZQ4Q7kNvwGUcogr&_nc_oc=AdrGq-g8_mVtRIg4NGEiW2AonxbJVB4het6mxQHZBmH2EVDLOg63dBsWs_skfpyuuJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S0zfMaxa3kx_jyOLZoOdgPthhjPkKtA22i7wsM10Ytw&oe=6A3BE17B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlRdhAYTmXsQ7kNvwGVggtD&_nc_oc=AdqloKBqbE4n7t_KwRMOlT5XDSP4ffQGTnlYFVCsSVDwGFz2T9OhbaltNmXXOyjldKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yMurWy5j7pStM5tYtA8FEbqXfZCa0PSLgRdZaHF-_2A&oe=6A3BE282"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs8mkEMTfHAQ7kNvwEKXkqC&_nc_oc=Adqy4vzu_aXrSbSARFtAE4RW8yU1p0chZ8A-Ju-ysH0RHSjWqdogz8JkQiIKNpiJKgc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SODh7mGDwDQcR4qnbb6DmDVcmKULnk9xOndX8vwU3IA&oe=6A3BF1D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICEbdsEpwm8Q7kNvwHSlxct&_nc_oc=AdpCK0xM3jSHs0ub0eowAA_uQOnvNc8QqTM2lT-Gc4l0BPGjq9g9MHKknrani8eWFlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q4tAGeU20ELNyX6QZ0buQpL8MPYrqf44NBosyU58i_w&oe=6A3BD425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXnTX0Lq8c8Q7kNvwG0oI_o&_nc_oc=AdrsX1o2iaW5baQCjebxzSzyttdniTz3jd2mNV58PnLDnkqzb_Z-Hm-sJqSM4Zmlo6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2AeWFpQ5sGDObbYqJftdPuU2e4Inc0WttxYNP8eSg8g&oe=6A3BF5B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
HmrwJi6D0wQ7kNvwGpjuWR&_nc_oc=Adp696595UgknxnniYSGtzQ3Nx8foY0-EOk9gbR7aalhQ16mg7B24yBp2m8Aez6EoOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGS6c_vuagArXXcS5GZ-EFH29IAUzjmQOaVXwwF3GDhw&oe=6A90093B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bj4JDIa9SMQ7kNvwEMxGjD&_nc_oc=AdpNzg3us4lOjRTA5MrcXZYh8-3Pg3uz5m3s_ki19lRR4_6q6EkEgbEDA7UrGLo2JnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNBTMkwoaqQU8ckXqJKXi1VwBo6A7FAfMBs4icPeLBEQ&oe=6A900A42"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXRkYMIcZI8Q7kNvwG5M_za&_nc_oc=Adr46hBmvcnZ97LkvRPLjW4TRdiA4ol-6AHVPKW5bxXnTKJQcuYKXiI-TWx3dWODJuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoe9bryOXSkBtYpwh1p12hM_B4pyDSls_Z_r3UwjPl3w&oe=6A901999"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnvWqWixfO4Q7kNvwHFRi2V&_nc_oc=AdoBtSzfXQpRiXUUPstD4ROc3h8xk7IkiPWhpHptxnG36V2hzCGn5HyC4aiHnZOMRmk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWcDhF3zcj4loEmAVani3ZutAgUokNPCyiWDiztTo_mA&oe=6A903425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZzS1nMNGd8Q7kNvwHuQeb7&_nc_oc=AdrMQtZU9ynhvinE_FQur8af38LekP1vz3Hnt4xEi9YNZ9HLgBjx60-PMNEYr-kblk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRTeMIbrvFLPU8ZfCL_t2Q0eiWzhJlaOBd67lreMyidg&oe=6A901D76"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
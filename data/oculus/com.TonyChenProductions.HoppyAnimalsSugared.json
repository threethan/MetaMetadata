uYdRixS5I4-ufu25PWUYgT6MOieh-Vp5PufTO4Cc5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsHg5GmVwxNRJI_RnBDRqY4y8EIObq4s9Vf1pH-SVq_A&oe=6A70925A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZW59Ri0sosQ7kNvwHRHtnK&_nc_oc=Adry4ry1xZW02AH7ikrYVTHR8IV5dULFBK5tydwgQNfECpRG9yOGuQgGitSOpoHh9ZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf_yG-VRrtDm9kfoCI1Z_EW9II08M54Qm0D46Hw5RrKA&oe=6A70A903"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if8Y2pomCFQQ7kNvwG2si7t&_nc_oc=AdoQrrO-YLWiRpbv7aqgA3Gc2oSwUEBJBnv4cqDw-z-8DWMtMwECm3zDNalZ0ksY1ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqBxt3jiqKlvVOvMsrcMlHBZ72pluMkXuyC-44rvMa4g&oe=6A70A05E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
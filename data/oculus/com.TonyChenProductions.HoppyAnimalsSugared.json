9oVyqNhPVNeoWEe3aALo5B4xtWJwk8LPWVN3xfRS9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FW8lDME9CWlhbm-91xYTgKPhKWxpaI_9bPJCAd4QhvQ&oe=6A3FCADA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9R4N-DHVyoQ7kNvwGfPfWM&_nc_oc=AdqNqcC2PZPMAhKz0PZTTj-lhI-5X1j15FI9GiGq38s7Lrqtv07xuCDT1Y9IHyRvhbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9amYyWMoBqSFu1zryoqeKM6Q2uC1BVo9Fi97xKQwxMQw&oe=6A3FE183"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1xTuo4EdbMQ7kNvwGdvXy7&_nc_oc=Adq1cRnddIFM0bxGTyAVApS_CJzkx2vvOwMkGa8o_nxqEDeuYUonEpkULaBpTfAKVi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YzZMcL_WjL75X4M88dpigxZg-4sZ3qBOEhOt-IK2Mqw&oe=6A3FD8DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
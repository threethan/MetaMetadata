984mA8clLgQ7kNvwGGKstW&_nc_oc=Ado7cTKVFBecagRrkGohzd6EkQsrdAg0Unny7t4qSISqWJRSmt1VcQleC68ms5orQdk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ekZ6sJhrTt5XNcjqRCLkLgc2PbaqtLFhFMVXqMZhgvw&oe=69F601FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S-ei00FKiAQ7kNvwH72R60&_nc_oc=Ado6ayz_RmQCyGT7aDCqsuQR-Y4Q_8XpJeQNh2LyCnjjqzKuYg2EYsiwvrDbZbUN94U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NcntRHtFI9b_ITKtwGpyeHEy2HTp-vXsCsFSCdEhs4Q&oe=69F60302"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vehf-v7OI0AQ7kNvwELADaK&_nc_oc=Adp04IW_MYi-M5nuhyLzUz9sUYMoIFHM3c79921RRdqnLDBhDG6_mY5xdq4Uao8bamk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ev95V_8lcGebeQsvvxuTRNkzRzGoiwAEUvJntHi9Wxg&oe=69F61259"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMAQctbI5rwQ7kNvwGub7qL&_nc_oc=Adrfs-XrT49dJTTMZ-9EFOHCYwdUpqbvI7TJfpn1d9VYjzYh8-wBW_I3NZZ3C_u1KLk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yNJVzHXlS3gybE4tl9gSNWW0swkUzr7pCEaR2D3R3mA&oe=69F5F4A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjJZg0CZr_MQ7kNvwGp-zVW&_nc_oc=Adpg64kDRgFMMj2HjNkvoHNA0IluedKTLsPxftvlGnBqGtWPENdFAfTXSyxdwawsC7E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Dp1YjJFnpONuzLlbVXGZvXkAaZUp5wjHwUrALvqn5rA&oe=69F61636"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
3qzs3bR-BkQ7kNvwFBjihI&_nc_oc=AdqVX80-oB0vPDvPKBo8yBC41U6Jax3cBQjOWPXdw_bc2zodi4-TTlqFQ_7_FSx2a8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zz83Yy0s_MFW_2HzzLK1g9DcQi-vy7ubTMt3qxwqVrA&oe=6A16F77B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr7yP1WM1ggQ7kNvwFTdSVH&_nc_oc=AdornudftP1LMHYl9bwX0SZBEftLFbNJwMyec9GZLcCElqPEXRHul7hqk8zxYINSfDc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TZLO27Hg1QyEulJ4dZnCOvz1eypwGoq3xyUiR61G_iQ&oe=6A16F882"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9axtPGCFLKAQ7kNvwFb1tX2&_nc_oc=AdqOGW7Az8zoaULjNc_opORVCjuPfvhAFxZ0Fa_cRBhQdgpRJXM1BdEYiHTW3SP4IBI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wGb6AEeof3amkU7G77q3uiyG0hEU4PmFuA709FRHv0g&oe=6A1707D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMK9M1ihXScQ7kNvwEvd32Y&_nc_oc=AdqWx4Z_BG5bfwTR7NVCJk3wX2SVPMZveVfvD7EcyrQz89xK1hLd3BFZn2Cwqu1WvRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af634mj2UrEoHWeAC7zNy8SnbcHmcTP0lWeY8NWlR7Zkew&oe=6A16EA25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjV72l6qch0Q7kNvwF0KcS5&_nc_oc=Ado_BxkVcNiS4kJN2CLOrSXnZhiM2fAj58NdYniDyM-_R382VormaIfQ581ICFT7gX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zFO4uX08ekYq8NgUZaSsQtdlDMk2HlUJYOrkZKvBK0Q&oe=6A170BB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
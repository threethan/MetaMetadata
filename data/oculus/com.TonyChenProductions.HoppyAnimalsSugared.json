lF3IkO1a3IQ7kNvwFH2LFk&_nc_oc=AdrHQxyF2FGTEWICaaJvKFxPVAiXiAq6rZZdx5FWzj3WLE2ZSGz8VH4VBVB--vNJMy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkbWdfgSj0q4Ro4Jw3cq_P-EXK1tHDDVJygZR9mAcG7g&oe=6A5E287B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBf4ljzABJsQ7kNvwEpP1p1&_nc_oc=AdqWSHfSLPn8KInb2XJz1oR2tM29R5N4Df9NNY7905D54vIRNwl6-eDF8waEQlb-ppA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUgBYtA5J5oepjRtxAz8qk5sOAW1tw_qqrNQtNsp0VtA&oe=6A5E2982"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV2IULU7dpkQ7kNvwGh9FcP&_nc_oc=AdrmGY9hX6_yQIeh294OZQcf_dvz1CFVIpUBQeX2Z4mjrAfbw6UZsj65RbXotZDEK1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC55-illzLdCDgdLeAv0JLa02jXnR1I_lmJWDyyp2JsPQ&oe=6A5E38D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijmcj2XtXR8Q7kNvwFm1eOy&_nc_oc=AdpfqPdSa56D9qmP5MHmlMLioryiSYInOyYrkEsmRRBT9Zlnpio6c9SJBiWxz9hOYr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjClDGasttAYYlN8-K2XjOCkiNRJ6Cvs851P61oSQ-Vg&oe=6A5E1B25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5OQzhYuAkEQ7kNvwFvJzR-&_nc_oc=Adp_7BjomsYjN5xLu4C6JmsuqcO__ximaR04EXXfRnEOfStrWRUxv6yAJIfaPWJOWA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwCvJJLBNqkY8pylLDgSSaGMuxKab8iLOVCEtUhyQNGg&oe=6A5E0476"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
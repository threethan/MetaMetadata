h4_prphigEQ7kNvwF0QECi&_nc_oc=Adoi6ewU6_ncwWjplHv8CJ7M_qvSqGCpdQmvE1_dDP0b2jKQz_sMuQmIM3MwPI4fCgk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15MlrNLc6Rn7g69h4JINfgHwh-QMzrt_0o-1ZIkuv1ZQ&oe=69E23B7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b3fMi536-oQ7kNvwGg4tQf&_nc_oc=AdomqGrLFuaP8zA717MMl9I-j6aSExg_yro7eh2FGucICTu3vMd3hc11UM4g2Sa4lt8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39l8zkSvYq6uLqF_H08nh4Y8tTHSSfUSl0K1tc2JskuA&oe=69E23C82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7lJXwVExE4Q7kNvwFVv4fW&_nc_oc=AdoRPsHOPU4J5VliU3to76e02h_X_d7ZeCA5LUE6gCWZZinHOzZk0DbFEFAc_FqWgPM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T72A75ZsjtdDDWT9YbG_AJ13IBe7l5Gkyr7De4StYTg&oe=69E24BD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O79xBFkX1YMQ7kNvwG412dg&_nc_oc=AdphCTPbNW7OQYesaQeqaLMzQxxuHDgOdcdFVVF3fy-X8oEYN2XW7jIl6pX7ayxr1Is&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X1xjFzRkiq1KpUeno-sLbxP7K184OMqjH5g36M6L2cQ&oe=69E22E25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyo1GItPgOMQ7kNvwGlxLEU&_nc_oc=AdoeMjd4QrohFzSrxuQMu12CSeEmy4VxJcEJdC0SRSIRM3qZj4yXZ4oyy8BPi4zdflc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FwkJ28SXncRk3b9QG2l43x4XNylkhkKk0Yx-k_j339w&oe=69E24FB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
q53tVoX8T8Q7kNvwFDCgCJ&_nc_oc=Adr5AWu-hAJBdiM1ocLIE2vBDUA_82vk6z69XEJO8Qxx-NyvaREN_61nN-e6aEDMN-g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW8ghLjVlCW-7ZjkzRsnubwdEqihFCifBBpZswTXvu8g&oe=6AC8F1FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSLjxCBF-mgQ7kNvwGiLxeI&_nc_oc=AdomXT_DU86RLsSNO-jV-h9LCApDxKjWv82nF3DEXJBINpIDRKY2f0VTzYZMh39ycOw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP111KxWoURP9XXx5XCyoIFLNIgr8wiH2VlFrvatS05sA&oe=6AC8F302"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jz8ozh0zPQQ7kNvwHzVZ2Y&_nc_oc=AdpsQIEfWU2IK65WO-A5HKe_6RbAiswy-Jo_sbsU_1UK4kdD3R93NUri_n3i9PXwO-Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7urOyYQcKcI6aW_BCAYQEBjJnP89yZsonEVDyeOyn-w&oe=6AC90259"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbhGgTZa1IgQ7kNvwEw85Xt&_nc_oc=Adp11HyGldaywJQ0AC9FQN4Eh_RHGE6m9T1a8V9XlQh8nxHRM--ODvjvgOEJZJpp1MQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEEKmQDIw-CpCCmogG8IJY9F6aosL8jVpb3IPJuLKE1g&oe=6AC8E4A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZS7EYjDREsQ7kNvwG68vNG&_nc_oc=Ado5Xz4WnPLEZyhRwkkgEe6DSP8_lY-gkGGICkVNTWV9R9Ysi-uMRk40WoNAv-_qL_E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVbIz4uQbx_gi-jPj8VZSR5u6Uk7N1tP3lG8hJ3xMxLQ&oe=6AC90636"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
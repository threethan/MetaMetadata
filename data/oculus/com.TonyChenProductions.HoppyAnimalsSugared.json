Z_mQxOqQhcQ7kNvwE9hSHa&_nc_oc=Adrf5kRhr319d3dAMq_qCGdGdqr4_YHxkC4tdAbiiZZvZw6XTcyC84zn1_GaScfoIpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPufGouWLHat793aaf62a5YzHfuxI-82D59AubYtrjIHg&oe=6ACE37FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbtw7DwHll8Q7kNvwGDsMcG&_nc_oc=AdpKmSX_zJdJnDMTO9ZCWcUOHcJQEBXgTazmTk-bostWfzXaKFOhI0hv8hm9F9LwtRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZf6K8kp2NW1WPqPPePcpKRpAPKrRNP1DybtrqK6R-vA&oe=6ACE3902"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHXvnAq7PQ8Q7kNvwGbyk65&_nc_oc=AdptP55jTEuNRvHlwhM5c3GVxMJ2LMsvP6pX9czaE7D9s9yIKBvpWeQAxKDNAaadz8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOINvkv2jvMEs1oXU99JiA27-DIzpj9UepBMeCkECx18w&oe=6ACE4859"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxUXK4b18Y8Q7kNvwHu8yw4&_nc_oc=Adpr4XnPWrQSaYzdIbCiJ-kwC_ceOvOoFm7l8FISzvzluO09wlDzb0ATbQaH9GP3_qM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy2wpB-v205TCIGxrqbd9MZvwShk15kt0a_2tZFDGjog&oe=6ACE62E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huSXLh7GgEEQ7kNvwHawjvg&_nc_oc=AdpPdpkvBAgKjz_L6BcCfEaPDfaViErdjj3gpHX-Kjrd0OGB0aLN-SemrUCJrErPzoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_NOpzfkHZlc7spHUeG2mnx6kTljpIi-zmESQpwYPSOQ&oe=6ACE4C36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
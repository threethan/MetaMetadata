=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afui3EpP91R89wEbkPKxeie7GSQUyroOaIOJaC2HFjBLOQ&oe=699C5BFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awV2kRSbSrYQ7kNvwHF0nCU&_nc_oc=AdlNluHpeNkLzHMluMUrupSMXieU41rkUjIy-h7wG9B0X5AU6nsgzvabNNFj3y0-0sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBqZqxVsis3so35x_0PkCh5t8rAfgKTnp2GOJK3FfWIA&oe=699C5D02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C57P3MT-PZUQ7kNvwGV7Evi&_nc_oc=AdkeWRKj0W9h-hJ3ePo8F0iEPkI6u_eh6HGb42sWMFqnnb2r8V1raIvLvY99RFgXOg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftSNT4ArkGMYPZ4TB34zwFmYdhFYBT4xuH15o1YxsSqKQ&oe=699C3419"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCN2EN8PF58Q7kNvwHgMEpJ&_nc_oc=Adm34WMXKEN8aTpQ5scRGUid2ZuUCtAyRMHVfcySvNVVOo78k9kTnrpgQqkkum8kxh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKPkF3DRCeJdjyJsas9yujwTax2Jtzv4eLz-qUp-98EA&oe=699C4EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY5DTrGQit0Q7kNvwFx1W-Y&_nc_oc=Adm9tYh_DFFDqLK2JXUplsiNwUpinm-tE1XSx32ebbioW7YENhVsNzprRQ4AsTN7w5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuFVpYgFKb82ISE7f9L2Oso3XsC0qDUWdXhgue8utHvDw&oe=699C37F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
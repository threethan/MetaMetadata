_i3Gi7u36UQ7kNvwGMBCcN&_nc_oc=AdoKJ16ErJFYMPspIsNEzE0wvUefvFoZu9lbnq6Z-5T_gXtOIQBB1cHux9gyx2_XlQc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj3fdod2FnH_llRrx5eCG7n8E5XG2Uhnwe1EWvzOuBSg&oe=6A71EEFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYMb9GyWsU8Q7kNvwER5ZVk&_nc_oc=AdrobkJWxnUKm8NH3pVqjZrDQQGMaYTZWpW1TphfsrSEjHWDRqueV6U3R8OztiJJ-Tc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8rFcLZYZpJIK5cGGHCCHzI0bGXHUzL3uC_lypJlVBzA&oe=6A71F002"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq3uN2MmVdoQ7kNvwFJgYdG&_nc_oc=Adr3dNRhs80doiMvDjO3ZvPEjJBWD_5c4JNeL7qbWLEg1VKmXren-d1Xbb8hrR3uuvY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwVnZ3xogSnkGJBm8hJHq49q7TwXo-1ol-kRLgjzNxgg&oe=6A71FF59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVq7oziqPUsQ7kNvwF350K0&_nc_oc=AdrDmZa_y0_ZLc1o6_qiaDB-kW4Iu3BPgdQtI1Vncx3b73uAi9nCDQWlvy9EBFtSP1A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWpS-zYWLUlnnRMjArq8sruWG1IKMb7h6amd7P6chPRg&oe=6A71E1A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqnZASNTsdQQ7kNvwEtJ3Ra&_nc_oc=AdoqvmxyH2F4wpOXNc2BZnESNbGkuzWxDYjmY3TuXCtzlnhtt5pYmiFiFwwwJBldNl4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaTXBf8uh0fgmGc1uhynP-3OxVDc3LN9eOjM77i34bUg&oe=6A720336"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
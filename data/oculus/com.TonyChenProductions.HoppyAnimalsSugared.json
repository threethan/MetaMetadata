scMmPM-ZtMQ7kNvwEpr5Jf&_nc_oc=AdouU-WZo5_EHawwwfEfBCA0waAAkv46wLQg0uoQTAZHx1iUUQCfHZho5cpOYT9GdZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-0R2wQ8zXW5bExp505uwBQRM7ErMjzJ-wFuEut-OBAw&oe=6ABD147B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN7EGEoLdJgQ7kNvwEdG-iD&_nc_oc=Adr_9srE5VBEAhZBEaBSvm_TF8Y3yVMzOsKWn-FSepn4vuKFjqt6h4pv_BoqfmMtiD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxM_4qKi8tRmNVrHPlcPna2TCQ3OqFTzr8JbYQd7cssQ&oe=6ABD1582"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juWsgNPba1UQ7kNvwEpYmwd&_nc_oc=AdoA60iSV0Uzdb3oAjK2JSR2hhumjR18gOcApg_teyNOdm8kIF2ClfGSgx2H69-8w00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1JqTI2IO2DWuG-Qrv3iAKIv2ZWMk_tgNZAymBe9z_9g&oe=6ABD24D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hHQLry9wacQ7kNvwHuUwdl&_nc_oc=Adob3dr0C9UgGlu-vL7o0eJ7Vqa0xkIKDh4oektT_ijyjdNWV8tOBubhe_dERfHF8-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3H8JPU4hrzZJGPFwC-Vmz2CrQsuC_1aOXbvE0jPMVXQ&oe=6ABD0725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkMxAG71L6EQ7kNvwG9a4uP&_nc_oc=AdpeMJZOTqfKr22QpjOW3RiGXK81XImuMMrdRFgE0mm_zCVcqjPQRvaQ4oZ40If2vi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfod7Nu1rDIJX91uJArZbDkJdDuskyBT4oRoJMs2FwRg&oe=6ABD28B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
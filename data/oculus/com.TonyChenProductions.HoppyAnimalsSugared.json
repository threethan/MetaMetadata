CWtkaClSwAQ7kNvwF3ESG6&_nc_oc=Adr6WhLQC_ikOlaInV7XrE3jjRaZiIwcFPECLhfy9wvOhyeEkgyzlCE1YljIxUjUvnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VvJUE09NXJdSD15vg8y6QqC7uO4LEhMGFUPJoJZkg4Q&oe=69F9F67B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mpohq-Ql3IQ7kNvwGC5Q7J&_nc_oc=Adrf-EQ68UPmyNO27wWUSBKsLAPZYkasRK0MQer2sKA5ztW9vgEtkTmg4t_DtbK6s80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mhLkq4A6yGYf6Lgv5Q3OQhwisxlBkBjguCB9unP5d8Q&oe=69F9F782"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6kbJIWYz_QQ7kNvwHskEJt&_nc_oc=AdonrbV3cOk6-mR-0t6BoB4GEmXncEWoWVKud3109-q4jhVyM4HDe0i-zapUkV6hK4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_MQW28jSRp9T_GSJgvAsvvd3WnoCpTFJJl4M_-3vAxw&oe=69FA06D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnYfMp51EyYQ7kNvwGrkJVF&_nc_oc=Ado1qXZCBFOC2iweXbIkAXrTC2839h5qjJqTugwrDwfDGQPZ_b-xT3bW0G0-1X1wKoc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o07bL2AeflPUspw0VOm724aCUUtqehQPq7zTr9u6dGA&oe=69F9E925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV01myBna_IQ7kNvwF1jqPW&_nc_oc=AdoCYvK9rZUXBuvzMLK8I5wWBZk-LbSEWmDUHO_vxKmEJCnC8O8GIN1zfZK0pVcZkFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gF-OyKVvvUQVZ02slqXNZTgnWOs4aOXPchlhm_w6aQA&oe=69FA0AB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
je3s_GYJUsQ7kNvwGCbzeE&_nc_oc=AdoDpRiIVli29q6ZJqwHUso-el0LCsciXj-lfCjM98-LW5JeWgR084-e_EG5JXq1iOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxL-azzXnRJoDVXBE8fdFtU0nX36BL1G5Uz1kPJaAD3OQ&oe=69C2977B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq5XyrCC4LUQ7kNvwEp9ZUt&_nc_oc=Adr0Qn4cD1_VD8xbVtnWcbPIIsFlzyS6zGi6pBT3Eca6lxAJgyKgzLmDEVge09hL1Bs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyM7AF5sqNWlMAOATrC1F61Ifmhu8QpSwYlALuxYYYgBg&oe=69C29882"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaZcMEU7BMQQ7kNvwEiG-xJ&_nc_oc=AdpBpVeXVB0Eh_aOABymo1avPx3IX3HmNt0hto14caJ76RxA-WDcHMIxl-EwBSfJW6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCXHcf4PsAM9foIryyxdInMoI18DUXharFHCYmKmMUWA&oe=69C26F99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9iMS76CYngQ7kNvwEqHo6D&_nc_oc=AdpNQEqaViPxkcSOl8Kb2iTLRXy5tJQy1gZR_EBiaK5tOYpkgFp2jvBaJzBGqM9ka5s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRsaJ-L9O02wNkKMwvKCDOgZeJNxuvLxNq0DTzxXQdCA&oe=69C28A25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI4XSb9fj-YQ7kNvwHwgU20&_nc_oc=AdqRshdJh_h22y5-Z6H5qHtfns0wO054fYeAJE2LaxnPjexwblEfLz-xmEQcL5E1_78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyrv1HMN-wMUtEIRIezN2g6LWt7OUmb0pGYLJe8lb7KbA&oe=69C27376"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
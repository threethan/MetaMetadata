=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJJIiqVpFO7dkJqPbPXOFqPpjDQuuVfE4RUztIJH4HCw&oe=69A444FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMUQyGLVYV8Q7kNvwFflybJ&_nc_oc=AdkIgnEBqY2ZowuKib9f8R1L3J96jGl6TYREmYII8juquYebiknhnpmo9jQx4jfx8oU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftAPmdI8H6TTWzI8iLaA4gTKrKPL3svIZbzWDsso0GS5w&oe=69A44602"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXimPMos7EkQ7kNvwE7qVFa&_nc_oc=AdnXEeLxFBeDRRT1PyrEQ1wUwpr25hPXKm2fJjIp6EqCwAXUjp8sTpBsw-K5KnQUrRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfspRdmtr93mnYkyrMGSt0Jf-BmUtsqe4Jw37ZXZ8PJn7A&oe=69A41D19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h3QVWO-6_IQ7kNvwEtVNsV&_nc_oc=AdlLDfwOkNl2Dyy26OC0f6JRKw992RwjCTyFENXBA-1Cjjad82KTpeF7Rrwm8F4tQRI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvxfrBvIx6chYIHhXeydyVvPMXsvb4_rRnz2HUHLqnLQg&oe=69A437A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FovIMTKXNR8Q7kNvwHpo4RE&_nc_oc=AdmPnCziyF7YvEfBuZmXDXzDJg9Zgymr3kMajffmZcDcMO8fZYQhASnJrlDiU4f7OG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsJYATTsffMkyAclhyabnVnJwceY10H_TpdcS_fl14Iiw&oe=69A420F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
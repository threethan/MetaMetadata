3qzs3bR-BkQ7kNvwGy-PiZ&_nc_oc=Ado8-cLcmECgFNi6-S9PuMO_ZPPzJFoqicbdOM44flF7t8u5g-ZMBgyQ4LOfy8sarGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D_Kx_jOwZUgznO4_64h93xIsaRmXDHopPCtuPJmtd2w&oe=6A1848FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhQ-lCEUxp0Q7kNvwESE8Ps&_nc_oc=Adq1sneCPbwabg4BMj1bGRFO6C3jCRxEDCab5F1cKGwsHaLIe6qY521k1AyvxtEbkmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GTwYY26soYfDHfx-DTMhBiEbT0PCVR-Goe4aXL9g32Q&oe=6A184A02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9axtPGCFLKAQ7kNvwE-uN4X&_nc_oc=AdraLt_U2nJtkO8t0CXxSCV5LPn0IaZFP6K7GDx8TBrMm3VSww-C5iT2wdv9NhRUKqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68PmMU85FfZhYnuUMxN67R6e_6nJ8Ovwfm6wlM4wp7gQ&oe=6A185959"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6GUkH7Lle8Q7kNvwG0GIEr&_nc_oc=AdozdWO1hTR1lkSMRGfBq9xtc3_B_9vWVw4AG9OzkNjfeuXkrGkrp_go1cUld1oeYfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZbQfLfVrxqG6yU1tysNxjp1yNzC2kdhFESe-BCfHXYg&oe=6A183BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjV72l6qch0Q7kNvwHpxjFs&_nc_oc=Adp1l68LDTxVdHThy0-AkL32fBH15pl-LXn0pmMvq4qatco28w-l4YxpkXgOkgsRQ6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y8o8AHzGtLiw5MEl_Dptg7eY9r-XlghxY_ci6CyvjpQ&oe=6A185D36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
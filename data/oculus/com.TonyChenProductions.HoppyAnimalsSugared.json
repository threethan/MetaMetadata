YWJZo-1tf1SgcflcryolGEiWrZSK8cNhc6EL2qf8gE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQkKcNRptGRSXZnnsLHErEQd_rCyWl5ixUI-A7y6cK9g&oe=6ACBC21A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR9EyroyHLUQ7kNvwEiK6lW&_nc_oc=AdpCietOCNNSSVAjZzVCVd6uUqAwTX53aRg2j9wzMy6blxCF2eJziJZiJorAbXt6kos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiaikoXbk5yech3D9V3PmnW8YpGuHL9cUQngWh9jN2zQ&oe=6ACBA083"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y9O8g4NtP8Q7kNvwHDSTGt&_nc_oc=AdrLv_lz-hX9AZ1v5-eSJNERnx5ubEnj9tEiZxbZAWEN_YgEMkgywQPyFV9-9tAuk8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBtHh5fNX3L5yTF60xg9hGhg0xpbybFkX5CdC0mN5pjw&oe=6ACB97DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
Vqfq0kEtQoQ7kNvwGaZqla&_nc_oc=AdopjdQTYTE_WsuygLh0qiHlXkBxH7npcZXRmrEEa9eQPpDVutJ2gT2nng9VegfejlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ-hp5ZkGN4ZsU3xOXXvoi0CjaJLTYT1JxbOG75KQZ_A&oe=6AE5F2FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zx69-4aDa_4Q7kNvwGjL_CI&_nc_oc=AdocI3h-4jmUVVL_XXC5CxsHbML1tT_hBWTXKwKdA2Zf90EfPKw8EkYPtff1k-IAZeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrHWZkpS-ZLrqSkH8lOHFEjovYabb6Dhx_5fSclzJ37g&oe=6AE5F402"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jf_4X82lFYQ7kNvwGm9IF9&_nc_oc=AdpRF2vj0-wPDOSIbrNzi5k3hpP63zkwYTAuX6eeUluOzH35IoQ9skYKAplMQ_tN1Mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiKLO_hObXxKj8HnSJI8oLOw69Dq_P4l-60w66lUZshg&oe=6AE60359"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OfcFaPnApgQ7kNvwGw35rQ&_nc_oc=Adqo4JH32-q--fQ-djqHwu6ZnjOd7bFMgpx_9FjdxYDvt_GdshgoAimzRz3sCR4WwHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFfevHTzxQFsGRs4FFPR_ekA8T-1d-Wz8OKoGK7SGUhA&oe=6AE5E5A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3E59VMnqrMQ7kNvwE7C1KD&_nc_oc=AdqSNbWEV_lI-C3RBOj4HkR-ZQBseM4z_Gt-zRE9RGf6t0VUMh3lYwGuWwoL7_vXcEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnm2aQSBw2QmfxLcCeAn5AbzCSgQjyMCADFQpqHXSJ0w&oe=6AE60736"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
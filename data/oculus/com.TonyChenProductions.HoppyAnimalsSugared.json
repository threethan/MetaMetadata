36ev1fjHnYQ7kNvwHU4mHK&_nc_oc=Adp8RiDvUGypzibkXjOJi6T7tkvT8j5cQI1ghVYAagZ_VVoc3QhaHnKaH8TACrtrSUY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9dIJ2PZv9Y2afufeEnejd28G51HlwmulfoWhEVOy4BQ&oe=6A81C0FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3em1vnKSBnwQ7kNvwGeHX6z&_nc_oc=AdplNReqSu49rzgXXBnylGBQXKxjOjIDs7GpFHylJfmFs2puZQMKYZ2yyCGOzudbgNg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJD3Z3UtBW_-KxEfJJ2SgvOmKbsUqX9gtppvgZIuB2-w&oe=6A81C202"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VboIB4CdkwQ7kNvwHYkT2H&_nc_oc=AdpUUHLyj5S4cc63HThIAYTwQIrzmpICELW4wZA2DhNP0IBc5MTVeyZioq42JmVLiCs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXsfHJzCkWZMAXf4_00OFCFxYpb2SukaYd4ybJ2aiVsw&oe=6A819919"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1vObldcE2YQ7kNvwGCOV4U&_nc_oc=AdpMpmdojoOqP_7ulUBo8ixp2qFNtVj8fQebv_G6IpoP58JPKw2_absrKnHTaxa-dPU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExQRevVOxqnyoUwM8Hc5XlkrT1MzADskwwQBSLUjaWIA&oe=6A81B3A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-Fmop4UON8Q7kNvwEBPdn4&_nc_oc=Adr4bWgW0DWUoWbxSV9G4tHYsWDZpt9uaadPYvfIcG9R20okOJ8heSyerR1Xudkchl4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBwi4FFUdqgHGefCQuG93UlwCUttpV-FwTez5TH7AaVg&oe=6A819CF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
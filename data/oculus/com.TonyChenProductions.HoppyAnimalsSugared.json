9ebe67GzucQ7kNvwG4BS3N&_nc_oc=AdpZcM3bWgrkJ8JQE0maJOD75-kmrWRbRBkUG-M7A_MvqVVydnAQoXxKpAe7dMIwZds&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KVwPBu8C69GgRilgVKpgeWdhL2Tph2-HM0fJvr8QoPA&oe=6A32A6FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKnnjA-o2JYQ7kNvwEnATo3&_nc_oc=Adqyzut26wxw4sF0HRMweWp6WvEAggsSB9o4TcQip5_TeKRpQzqBL7CthLdY-F07C1k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HkEaMJ7zVKVCdioBZWninxXyjb94Gr5mWSqm6I8j49w&oe=6A32A802"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwFk2SKU31sQ7kNvwGNi40H&_nc_oc=Adqp8x0jinXzYjjWH98z99xZLrfjFIkeGud5o5oA_55dR9uEMy181Q-FCh02rp_ZfpI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mNfrmo9SqNYQZfCBR0pE40YR7lAyy48PGmcw8MfcR4g&oe=6A32B759"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq8em7G57_wQ7kNvwHMZC0P&_nc_oc=AdrFwGsCuBpHEKIl15EPH_KiRdFBuXzIn6A15mIkZzEOx1hJosFSV-pnthEpURPmQks&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AmhhPrZ7oANezGYvuCqF5TBE7Tph6V2wFS7kzeJotug&oe=6A3299A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnUrC-v5-iUQ7kNvwGqCeV6&_nc_oc=AdolfaKDfUa5-RwhjhRhX6hNLLWbjFMWVQS8OgIlRoNSPZjyA3fofztQeNGeyfqc8bI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_4WxmGo2id7rQZoDGA_rE6HV0jrLuPSxdVKzoi4y5CA&oe=6A32BB36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
cGpDutYIakQ7kNvwHxVLis&_nc_oc=Adq1y4xtH-IGB8wy01nfAX7JJ0rJSYdjwhtOYoJUOshelxy9wh96i2CHN4MRw6GJTt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz2o0QQV9BTwrHAg301yB_jpbxEZPM-d142L-KAYXK3g&oe=6A9862BB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCAbjZlTM0wQ7kNvwG0WadU&_nc_oc=Adrn4_jEL2VC5CuR6MA81y7T9Pjqu745qZtWddFLm8HPWsx7mXbHKjZgvPtzeA3FD7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZU9gAwhRRqrDAu5j7VlEzXtiknyQi_mmm1ksGVm1OAw&oe=6A9863C2"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebm7_crbTdMQ7kNvwFltLHL&_nc_oc=Adqgvp-mhszBgaMrDafjRdlRvHdK7TcWpYXVYwCcThEy4yDudskC6uiwP56aGLL1UM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjKgFBM1ExILIkQP9W9AnuBy5uk3ewU2bWejvGOFW9NQ&oe=6A983AD9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P6tjcD0gvgQ7kNvwF3LvTD&_nc_oc=AdpbaiYTW2S_kg9mCAFDzpt2hpnHbytq8_BnoB6QoCjYgRTAZb2Pze2cX46Lpv3srjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-MduuAC1o5hO5cQ2-fmlh5A75X7kGc-1bqMIupD9jcw&oe=6A985565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxF4Ky3iQy8Q7kNvwHPWVB_&_nc_oc=AdpVIW6VZDCxtL5f57jtekcwyVvuts6D7FS3CjUihZ9BfbXkudr17H0bEhMCTP5Rr_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKauJ99WsYCIPWBFH2G_0OjBJVT6v8kxpvkF_aUcGKpVA&oe=6A983EB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
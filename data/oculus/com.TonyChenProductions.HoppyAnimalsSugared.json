2sK7PfabYQQ7kNvwGK54wd&_nc_oc=Ado5lnEpRNIaatNmLtibfv1fN9mbb10iLYD6HtgUJC6ROt6uIxvEckOGJK3tkWcFNKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4tYN0HW5HgaiwDj7YRkxqWt3zwx7j8K7sTjZ05v383A&oe=6A75E37B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALfeeixBLdwQ7kNvwGvH0xN&_nc_oc=AdqjWpB7NJLv1K0uyedCfzWHwyxLnXjJK6JKxuiNO_UDI4pTuTHx1FbR8yyD1d_8Rfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSkBUEGbvdfT0_F2F7gemVtGeMPoSa0PRFD7PUmi57wg&oe=6A75E482"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Da77M0w45MQ7kNvwHkKgjz&_nc_oc=AdpJlOnLnHE_oi-SVJF4cetcunOwAg3Mv0nPg7IufuQ4s6SLAXzLosT5ELib0p0lR7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1UWbIs3Qft9Ywx2Gns7eZiIlQmUtCSXGB0a5C3ZAXHg&oe=6A75F3D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe32UKYNFdoQ7kNvwFQY69K&_nc_oc=AdoLM0pDwv7qwJCMdDoeFQQjtWfCxkQ_8yhT1CeUGn-ndd3ekK0CMXnoDQBMfA65h1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhkkdOoN5Szn0P5__QcMTjBNQF5TR_SQKOSr8IbA523Q&oe=6A75D625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niim2Uiq2JcQ7kNvwGUEYx3&_nc_oc=AdqV0Ul1i388mF5DCalIRH8oVPMEHcoXAsgv5tORlRan8hfHkpYf_0NV2z1dcaNJwOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBEvY-NXLEwOz6-Ejc-d1Vry37Vpb31a4LrSX8GiHhxw&oe=6A75F7B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
ruT_Er840gQ7kNvwHjsEG4&_nc_oc=Adppxp44K3rdBNEPDHkdBnreC56u0osML_YG4mcGIJPhCqiAJZfGuVqKzsCyTa_yJ84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pzPkgv_ATMNDJ8yQMXkixMx6_dw1Mnaya0ma6TtbVMg&oe=6A008DFB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7rkREwBHdYQ7kNvwHIhAgG&_nc_oc=Adq2WXVGxTdhFivowq8gWkMPnpiVRi4928jwEmCBLj60Naexef1Dd1K1lhWolob0wlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44J1pAEg53RxVinzxzGNl3_kpDNcREOiRDj3kp9-KfuQ&oe=6A008F02"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85E5jD0Fr3wQ7kNvwFQ0WkY&_nc_oc=Adr2VBlf7c4QMdBRiAyO_WaIwMrvaQ0GaJ85N8gsRUqrxNn3zIwW8sMr1jpeOV_RfWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-8alDLo_ZgiB-N2ZGtG1PoKHAjabvp9PpWFnZ0NbK0g&oe=6A009E59"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbRULX9ZS6AQ7kNvwFkW71s&_nc_oc=AdoerwGFI4UB51nI0_Mdy2r9X8Hbz12fqLH-kGwMlGTNXiaqwX1h0Xvd99sNmkafXr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IYHEAVaSsTVWXvxeVqmO_hRugdoU2BZMZ5et8h0VUVQ&oe=6A0080A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUs23lRdbI4Q7kNvwFUjKgj&_nc_oc=Ado3RckelI9BWpxmBYeIObGXsjo99V1bzf2VsbRTzuSHWF6IMZzzvz1Z_D7koaekPJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pV-tzY3_3MJJtLy6wxjQ2t3vpencb9h2tLKChgdbcxA&oe=6A00A236"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
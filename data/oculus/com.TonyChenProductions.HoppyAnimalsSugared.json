HSLf_fidzsQ7kNvwEm2oZd&_nc_oc=AdowM0hxzTih66G0Yf6jQu8iMsPLH9EIsAuFsPWYfkzB9rLKE4cmZEQwJmbqUHGHaK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fGK4nP2ClpXNTnC3n2t8oKnvRV69c4Fb3CdwHk05b3w&oe=6A3FD5FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKKwpQagz_YQ7kNvwHfldv9&_nc_oc=AdrRGA3NdbHPDMkKy7QkRLRREjR44dSWeVqQDpv0_uLqEII5_knDnpcyeHQKakXloV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yv7LdW3S1NeUyWIwkyJQr4Z1fVm22sfnCuVjMxz4bGw&oe=6A3FD702"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oP1HHfz39UQ7kNvwGo-QJv&_nc_oc=AdreBX4cUuMgD0baCogEgnUm40w8iNZs01eus6lI4y3FMbIwZtCGeA38iPuTFwl9odk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TIglfRe2Q-Mnsxwzaez99ImroOfksCgJTCmmEC2aaRw&oe=6A3FE659"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXpDBBuQTXEQ7kNvwElbEyv&_nc_oc=AdrHH5cWxR5-c7QO-ZmGngo-3JkThEMByhpFZvuyVRmIn-Bl9aK_hoPga_lg6Nh5_TU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dd0DsvTY_Jzj_CVBrAwmwY6-ly01kzD8uv91fkIVgGQ&oe=6A3FC8A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6skA7OzYakQ7kNvwGLkxKh&_nc_oc=Adq-iEFVkDNYwCstGHogpPURZ7IXPkObCthgeSqBPx9QRIjHdaVxan0I1t03Mv-0du8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mHSIMXM3zHzg2QifPseh8gPeXqaB3fWBcBHMWZqMGTw&oe=6A3FEA36"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
chLpv4IUbEQ7kNvwFn9ANo&_nc_oc=AdpKF3RoQRWWi5P8zuShMERyt7_Fr1s9RPo9bhLMTEv4Jb7u9bmICYDDEFHMjHSdG58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9Uc0s1Z_bm8Tdb7KyQKo6nKih9wL4RX8rEGswm-C5RQ&oe=6A5790FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJNTAmSaQAoQ7kNvwFtsmB1&_nc_oc=Adpwo4ULSQKKdGSDPJIFjc2zAjR_2c-d2XRALcYiMRhQ9Sl8LHYBAa9gQJajrzXUDaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGaX2VAmT1dfVq2gEtQrnAVfp6YASYlMmEHnWgDBRHng&oe=6A579202"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShK88vRn-REQ7kNvwEL5z_U&_nc_oc=AdpnNdieZK069biZuqYSXijzuUCyrErj7UJGsvkSKJ2bhJUE7UdkUqd_Ak68XbJPTMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpg9GQfm8j48Hn0VN7n3-31SAAfdM4c12eIcDx5jT_gw&oe=6A57A159"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB7mc3qwtdMQ7kNvwGq5rIY&_nc_oc=AdrfH_gjun-bzhK5RR3Kh7uO7qG3Nk3NbvY9vKTwF8xb2Dy3NZCdibJKq6g5mXjFrwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAvZbPYPSHyAV2eIpQ_24epluKc4tLywN4VtqHhCKpvw&oe=6A5783A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jqll2GOTPIQ7kNvwHNeE6r&_nc_oc=Ado3pyhtLkQquYtoIxhAs7fWO72k6SJwiiwYPp1X1fO1PJ6sKZ5TdIsA3qP8jIWRnfw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa_TC1fkKoqszfLIuvPCgn-nr3QS6vtZ8gbJfzQSzZBw&oe=6A576CF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
HSLf_fidzsQ7kNvwF_0MyX&_nc_oc=AdqeZtj-J_JKdPCN1BM2pq9DLSpySKM19Cz9ZUw6wf0J2zZREa1LmQokTkPPBJcPTDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i7-P9hl33yRxU4pfRPvSbgj6o5xc0e58skjCEuKJ_mw&oe=6A3E847B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlRdhAYTmXsQ7kNvwHJq45w&_nc_oc=AdqyTNJ4Ab3Sn1DmZabSBFYXfUoNPLfrFp_3q7TfyayL8NnaOeyEyV_xGGu3h9M4hGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gXkOgEa-Bhsmhe6A4xXAVIGBcUXJ6iKVaViCM5pQ13A&oe=6A3E8582"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oP1HHfz39UQ7kNvwEb3alH&_nc_oc=AdphHwD8HfuhcTBd5AQ-CM_Z0C_phgt0O0frpHAvSywRi1CSm6jmiohn1-EtloVRuCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FjvsuZt9ln92NYfTKrtrrKTpL6gPGaB43p4fBS-cdpA&oe=6A3E94D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICEbdsEpwm8Q7kNvwFmyR7R&_nc_oc=AdqxmvJ6Dsk5oQ97GPxyD4J3UL6uLuFnGwKHOXStQgmAtYsAz_HWyD-gktlMqUBhJ5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89Ep6DyCow71t3QPKq30qPXaRvj9mtCtDhzxTeV9gugQ&oe=6A3EAF65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6skA7OzYakQ7kNvwHxG77C&_nc_oc=AdqHCtcKzHVx20e5YPNddHziY8nOhcGUGtBaQdR7WOYgg1m088OO3UZElW_RaaXMrWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mJlre0X6iq5ttsl_UCRQenO6sEMV3s3k5EfX0nW-7rw&oe=6A3E98B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
BqHsxuKAh8Q7kNvwHILKnr&_nc_oc=AdrvwwPE28H0XdsEBmDmM7nUJDRQ0yGk0ehQ6t8NSnJmXQ7GZWqAnNeQ2gRp_fUrHGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y5fTTtHlAbq9MqCSxXSXq_M-QQIfsX0dSUwYu_o6_cQ&oe=6A14547B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr7yP1WM1ggQ7kNvwFOqSMg&_nc_oc=AdqKnRQHaOYJ1Vm9eruwC5zxA3gHdR4GuW7FqNkJtE93KBDdeHNZUltbU4VkDmhhJo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z-6-KqlLHtkyVvctw8O_0GmnTKVXlGY5XaAjSziuRmg&oe=6A145582"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1PO3PirECIQ7kNvwHnIrb8&_nc_oc=AdqFbMLuR3Nal8WyCEeOozePCwXq87KKapXAsDRdD5SYxSj1hLEEeX2uvt4ICcHSHts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-v4ILIgixIc7kFHwm95XaZTegeHnswRJmUUWbC_1xAg&oe=6A1464D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMK9M1ihXScQ7kNvwHfR45K&_nc_oc=Adruk8_jb1lN2B-U2Y89LWJsaqW-A1Ck9nstqXjgYbEjXjMM6NgpWJOOIALLRj5A9PM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af448FHbm1NOCC8VUEb9ZTo1DR-cqoBznalRmHBkOzUmNA&oe=6A144725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t40YgoOckugQ7kNvwHAc1kD&_nc_oc=AdquMAqTwSK4ifhHaUaUEEYWdfzrSiuBCwD1lUXnaEjgTgCCQP1NK4b7irT3AZdoZQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ChwnUlTgLJD6ErFxfiLCj2CMVtYmu3rGEH2MClOkIWg&oe=6A1468B6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
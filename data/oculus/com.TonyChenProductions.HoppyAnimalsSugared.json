Me-OqscJzQQ7kNvwFSiTkr&_nc_oc=AdqHSmkcM9Hsu7y-kb91Aik1EF2V9pbz6_oIxHsfeCG7fJu1xSXMkIGvmowobICNTAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9GDm4Wh2TmB2n4QzDk_IhsMJ_n1y5Gr8m9zPNGPFN3w&oe=6A50F97B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX-Z0d_b6p4Q7kNvwHJLa4G&_nc_oc=Adp9PBb-vTV4MvQ0zqESeAWUhXm4vFiORoyQ1ahmjVWnAlISLNEvpTGdGOw5jUECS7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrCn2vOJObfKhVmVjjJVqg-a_mZhL-TRjtfj-NkHRCvw&oe=6A50FA82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8V8m2tLeDZQQ7kNvwGiSogH&_nc_oc=AdrM0e0uWApoqdjNQS_ILm-JXft34RyIhvmzPEVJ7leYSWhNNtlyu8AUHO7gIy2oO2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtEs2UbjxCqV5QotQ47uzC0qWxs9UTZvuSi7i1EAwCoA&oe=6A5109D9"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRLrt3TVPk0Q7kNvwFdKqbT&_nc_oc=AdrwE-gtSEzmbEPBxxfS7KoPlU1GEZdiDCqaQtd8SyFT0Rlg0rD_QpJRtFol2tAq3mY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLZDYV9ZmNKpIwoh8Vfe88goIy-aeeXm92f1GSTSwobw&oe=6A50EC25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzV1BREuZ6oQ7kNvwE_73Gz&_nc_oc=Adr2I-_cy_vEk0GawnL7xNEeglfk3K4klp5N1XWj_jthDnB3yA-C3KexIZmV8emAo0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6Ex4UqcSHo2CMY-97QvX2qfUbCs5VvT8wqYb2yCrh4A&oe=6A510DB6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
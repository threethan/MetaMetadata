rtXKk066VUQ7kNvwHnZn_x&_nc_oc=AdqSXc8mjzY_O2ibFLER4fbj8JXrqfqxdPh02vMwlVZDPAFS3Jd2Uymij2kWZ6TZm1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwW3JUp9MyrLKfMwgzRE9HbuKIdGCVnSvkVCaXWmi0WDA&oe=69D117FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N-6wSqs4ZgQ7kNvwE_82o5&_nc_oc=AdoSrqUAcL-vrTsHm5egEGo78ddcrMCOiomOUIsKlt0VGcHvZZLzMwxxa1dFTz3rVFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw14qV2YxODbdnaW4K3sMMCaMIqASBxsv2sjOMBZh5fmA&oe=69D11902"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmjgJg0OjR0Q7kNvwF-D1ou&_nc_oc=AdqOL2dxKS3K9sgGQzNJ6M9UhCXCdJwEAwjY9YAQj0TK5iJOesjagVpRgtBVF2UXexo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzk7j77VhD8SX9AjrulrFBqtlq7xY7GIU-e13M3GA9WFA&oe=69D0F019"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It29J-5mC6cQ7kNvwFEMHiJ&_nc_oc=Ado6MsyV5WQ6kLdjmCZd-EOC8V_tOW2IyHsSrhrqE_ae_Da7oZIRq1zqagP9774FWGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxL2wKPDVL1xbn0fQmXKrSFqNIWal4KriihM2M7oNwYcw&oe=69D10AA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbRf2Cyqwp0Q7kNvwE1AITN&_nc_oc=AdoPSSvCjWpqv7GGRnwQctLKfO_SsrXQbUZEUbP6sHe6uu9T2gRplq06TLk0jm7X6O0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-qHRUtZ6E3OZncaVgN0loUeHHeETEQoi6WN3AYVoKOA&oe=69D0F3F6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
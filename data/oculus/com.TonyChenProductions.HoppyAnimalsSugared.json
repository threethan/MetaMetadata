fRhNA5OXnocSh9TG0992GzhhmLxzSWoy-X5wb0j2os&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBHxq2z0CsF8OfwevKCHcPZWcJE4WmwNtXuiobRyR_Sg&oe=6AD3AB1A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFp3fOdRvc8Q7kNvwG1WDzB&_nc_oc=AdoGQVXvDLw0CDLEHc7_2M-JHaDI41LcpfeOX8sgaponCktsiRX2TaKyaXcbKaEiNEQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9QodlqU41L2KQpHEji2Aym8me8MUFuLOeipwpSPdqIA&oe=6AD38983"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXiJpKzmMU0Q7kNvwHyHQyj&_nc_oc=AdrxwfkBi8UIYhTCfuW2XuEB_i7m4D7LqS2erOFCpN_hwCc_AvrrltjpQoRtW4KcDNg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4aUkG641NesnCjXLmB5GnqKeR2zxtpzeps8jWtxVCRA&oe=6AD3B91E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
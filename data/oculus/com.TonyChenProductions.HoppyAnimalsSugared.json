Z_mQxOqQhcQ7kNvwFNgEKX&_nc_oc=AdrW4-NubHQZL4ix7_8NUolCNo6y5dgLR2drNgratMv-migkGrvol5eEG2hChgUF_Ow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMywUr3RmhvSgOaZU8Qh6JRo4LI_lnlkkc2HeE29TqE7Q&oe=6ACB94FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szkS4yqokygQ7kNvwEWzUxe&_nc_oc=Adplfj1yyOC_Sa7ai9WMcZV-8y-JyTsYQPmIXXzpxxGKFvX2zl9GYVcwyeJRRej9NPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAvIIOqe-VCJeMm-4cMR_6vlo6l604jgZATpQ5Q1pZMw&oe=6ACB9602"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHXvnAq7PQ8Q7kNvwFPx9q0&_nc_oc=AdqDwMnp7zYWPcv6UYl8-H7ScmW-dzo3xOGjaS7AUYte41ispJgFuB9tdcYfygP9ICg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIx_0DR04Ovy38Cv9SDI0WzkBC2H-lw72mZ-Ev_6AxQg&oe=6ACBA559"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEAe3EnQvX0Q7kNvwG_5WEj&_nc_oc=AdpeIpNJuNU24SYKLmTNbO9k4T1uR77IFs3B5WOm1imOTZkeYjUo6GH6jpLEE5m3NCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_qFBXieVRH8dyooxZM-s-YVkcpvcHaUgXsFm8PoHVrw&oe=6ACBBFE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huSXLh7GgEEQ7kNvwGOlp2c&_nc_oc=Adrh333IKOOtkW1TR2u7BSD7ou63Vell8lftmYIa8-k_cUzr6mIpR3Kxw_W-DlpYJIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1gcVC5iNG1M9_MCSiIGseykFtugEMtOZDyesxSZSdaA&oe=6ACBA936"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
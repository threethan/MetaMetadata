h2KX0vTH1MQ7kNvwHhKofQ&_nc_oc=AdpP_eFXnx4_yR2PEKSjV9FTvpROUWGd8_eYoxAMgnXwK34YXvGEhla7KIzVjBwZXHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEUYnlpUo9lIQF_e_Y2gguaDSIIh-wngH1HFkGnBdGHg&oe=6A6762FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sFUY4-ZPesQ7kNvwH__Ggl&_nc_oc=AdooXp3axvvEFPg5-f8X6Bcpje-21OIcY7wBxmW4E6CiH2sZj3OROYAPQJQ97UfOUAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg4ip77OLu5Ll1GUI3FQ803nUi1aj0KiIUdNg-tu7wqg&oe=6A676402"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuTp5bGVtdEQ7kNvwFshCOl&_nc_oc=AdrCip4b2YcYtlPJi7LzbjqjYGCpZjxIGc6IJbZso3MZZ8-6Ikfk2RzEypAuRhRb0vE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC33PsqJimzBrbp4MbL5yS8EB3qnBUwDnovxKaq9okBBw&oe=6A677359"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3SzKIrH6JQQ7kNvwG3Rmvt&_nc_oc=AdofCeyrXqadWN9THVKhnvO1JIAFAJdwEk2zQrSGzwtP9S7EJX4xjo0xjgaM7UKb908&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFTKu2S1Z2JGbMgeUq3FzJbLLy8m9a0KqDwjREO_CCKQ&oe=6A6755A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMtvvDHWEy0Q7kNvwHeElXk&_nc_oc=AdriTGEFAyvZIwd5mv8Kv99-Ieijz2-AstQGUirNwuNJm5TRa3CLCm5S9zcwHI1Wx4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoIlWgnYsH6H_YDukfUgERIbQiEiXzgZZUO0mE2pdoLQ&oe=6A677736"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
h8btwHOFj-a9oU7LCXgBexR8OT719EiwnKnc3TX0DA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zf36qfpx_oxtbLCWHpPg8ywG9txpeqbU8P_jbb_1DNQ&oe=69D5015A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MftuGWsq_pEQ7kNvwHKHaMn&_nc_oc=Adpk1K89Dy1XbupSfQPaJ4BmacM2BPmrPfc2NlFB8-zrVLVoyeTWWGvTDtZOxamFink&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e1gP2ViXSJv0Qto5WWswSij1bxRohSVsp8hE6djEgzw&oe=69D51803"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b-Po1OpWC0Q7kNvwEQ2tFy&_nc_oc=AdoCxIlgjjb3xXLcrHvDZAmah7aXLa17KpRjRaZCkiILchIXjA4OTQeEtSPDx27DgT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CtSljUYyUTd91wo44L3Gj036DshcWS2F1ym6UTI20eA&oe=69D50F5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
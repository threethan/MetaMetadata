=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftPTiCuSwu_Zqp-jnBZnP75NhT_d7eTqoiA07FCDzu_8Q&oe=6998677B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEsTuvj-_yUQ7kNvwEgMjJk&_nc_oc=AdlmLQzy1Hf5pjAvWMy9oDXeIDZuspQt7N7phq_W-imooo6n7cXprBpvnodt5K1C4oQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuDKsZCuqJ4vUqdm9gHjz5qhmL3MU1PR5wIa3Wi_5Z5Dw&oe=69986882"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKOftiAWG4cQ7kNvwESDLxq&_nc_oc=AdkoEKgyPuNggQs3udZ9Sq5xve8G1_B16AZHQ9pAjAVmyZg5XmgJ-hMO34rGpTSdG8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuE28Io_LjbjbISspw-sA1pWw7E-9YB8CQ00UGZmF-sxQ&oe=69983F99"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKsHqnPKbrMQ7kNvwFshQt5&_nc_oc=AdnqfXOsoWA3gJbWjI6pscrNLXEYruR8rw0fHkmDT3_IdqPKd5N81bRnCn1rULObxFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft60TbHkedenVB0s_RIfNB8T4VmFY4JmdUlOE2KEaVjhA&oe=69985A25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIrsvpI-NrAQ7kNvwFfQE2Z&_nc_oc=AdmFqEq--Wvi8b_nyphpykPapNpMnRZE9dEojnIH6t-eJpEPFFg-Bv0FHYR_6JySxdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfskG_pfA96k1_CdjBoEVPWePfJKdI7iH6384LyONpgdHQ&oe=69984376"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
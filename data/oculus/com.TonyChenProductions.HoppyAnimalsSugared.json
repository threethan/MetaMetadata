xr5BVJ9B0YQ7kNvwHb497y&_nc_oc=AdpA2EIJDbleQlW2lM8fZuevHBQCAD1ixTqKmUntcfWT2Npjuv0pLWrfsAeMQDYlM2M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNI6QKEd7wkG8ZdctQ3QtMZEU6fkQklYK-fF6NepftPQ&oe=6A4A61FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QGKDID-tBkQ7kNvwG5IF5W&_nc_oc=AdreeUvbJehCdukqE58BOktgQxeSaziyp00XognR188YTMAT2XhXTRUtoYzJ3ug9L1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD80otRH-Rnb86CSnqXmC-i9u8axWuqvLWE574BM5Ho3Q&oe=6A4A6302"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdFRlymJpxAQ7kNvwH8FM6v&_nc_oc=Adr3dhhGGAYVPRlxxTWHs-VUNS_dtFD09fQTfLz6a83NSiDZb8gfB37UsA9R9G1s0EU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEcu-VFZkwz-MQy71A4tCwbp65nTZxnVL9fiZP2tupbw&oe=6A4A7259"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-HYpKAMVFYQ7kNvwFrZyjv&_nc_oc=AdpQbNn0YPvVoPXZ_K1Jfa_0UhNqv2T2-OQqtFgMlusdl1mKPFNYPHTpo_NL93S3tgY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwu21duuTxYM4hrx52ZfXov4pWlxa2aJbzZGpUCBojjg&oe=6A4A54A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yacd5CUuyL0Q7kNvwEcW_wG&_nc_oc=Adp3VC5PVOdJ0QXLTSW3cnh_yeZrRTrazSjd3iwbvEClRE_sez5YGfMdVD74L01BZ3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhOSrbd8gD8jH-HMS2Rf-_WGnfhFo46dbPNxoc_GWpfg&oe=6A4A7636"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
NxAyPTpo5zuOrx_4SMb_Y3vuDTJEYO2kwaZfdc1S1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCitdnYgksNwgZULhRlCqYV_duI0DEog2hvaVmN_zp1rQ&oe=6A6211DA"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyAOpvpdU2EQ7kNvwF3t_Ij&_nc_oc=Adovclrg1sE3FeT5t7r1V6XbiIktHs68pSxvBvvyioR1CuHpWr85NBAua71_TJjytog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Q-Wp1pZlOTMGc_tpMRZ40uM_2i-KXD-Nm1uxt__Yow&oe=6A622883"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VkPbPyqPfsQ7kNvwF-r4fZ&_nc_oc=Adr4zdn9oUusK9lywgcL6D1X3FZlSM_aPSKvnWPCz6lWr_B-1c9YDglglbO9YNJ9GsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkbEbPV8yYObSb-I8vNauE0lfLFDbltZoOVKopodZMsA&oe=6A621FDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
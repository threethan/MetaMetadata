t4OJnYHCbD5I9WyjiSbTwxtB3OE1MRV5aJw8uhUAQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMNVI6PPBxBpeS0ffVCNDaiR-YMgUNBMC3MK58QVKxhg&oe=6A5E1D5A"}, {"file_name": "migrated_image.png", "id": "528595694527658", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974690_585304771888829_1788145140460683264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGA3sU8UjHgQ7kNvwEiV-kZ&_nc_oc=Adp5uE-ZdD5bIOXn_CCG3T_jSD-mfAQrmhnYxA1htBzyM9ycCTIntlJPwESaUppR7b0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiZZxrsA1pEB35HleE5jJ2Ob58eO7Gy3GPOQLvUVHxYg&oe=6A5E3403"}, {"file_name": "migrated_image.png", "id": "201896287755749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974690_2137435572947402_7965272821892907008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G3Z-eNbkrQQ7kNvwFpGp9Y&_nc_oc=Adp1CVQpQJfWrGX-pmCI59pUFjNXcW8atxmda_UYETBpogyq6iTs5O-UfeuIMTi0cQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAQSJXwB_9r812wQxdSMaprRGqdXJe0VHEhdvcv8qcDA&oe=6A5E2B5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Platformer", "Candy", "Animal"], "long_description": "Designed from the ground up for Gear VR and Oculus Go, and suitable for the whole family, Hoppy Animals is a third person game set in a remarkably stunning and explorable 3D candy world. Characters can run, jump, attack and talk (voiced over).\n\nYou will stroll by plants made of lollipops, pudding, and ice cream cones, run on ground made of cookies, cake, and croissants, and hop on structures made of bread, chocolate, and slices of pie.\n\n- Control with touchpad, gamepad, or Gear VR/Oculus Go Controller\n- The mood is delight, happiness, and wonder\n- Characters can move freely in 3D\n- Comfortable gameplay (VR dizziness minimized)\n\nThis game will make you very glad that you own a Gear VR or Oculus Go!", "short_description": "Designed from the ground up f
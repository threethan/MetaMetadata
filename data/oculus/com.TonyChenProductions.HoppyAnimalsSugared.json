c=Admvqr6b_gCncit0ZZM5gnM8lVrlBuGFYn3hlBlYUnQELNxU2Hcw60jEGHjDgckU2MI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHwVPwbBOqOAk3d8s0903X0qs-XAA9mvX-5wPTq_9A5g&oe=69AADC7B"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p0OyihoqeoQ7kNvwFZ8PeV&_nc_oc=AdmsxiZizv0miUGil5grW1IFwg8K5H1Hlyc_ntAoYAdoxR6yasgt2dEByunIo_xmnSI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7eNj7PWYtDCKS2JmtlvLhXgqiiZ6OOegEUR407fbBjg&oe=69AADD82"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLaRRGNsQggQ7kNvwFwRRvV&_nc_oc=Adni5Qaa4oxml0hqz9NwFk2vVpqGv2qcfYn9d9GSdw4ZZqLuKnXeZzz5v-zV026T9IA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfweZ2k1dBD6qUdowM7e6azK0liDTVxUMwry7rZbRlpdmw&oe=69AAB499"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRVMtCItx4QQ7kNvwF17PwH&_nc_oc=Admx-rk40pbZRyYZL0UiFU1xiILsQ36ewUEK0PCxz3yghQxw_8uisnAeZq2zL-cn5M8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7CSJwmbpZSAMs6cSWRwM8UORjmIWAoxrN826T5vL0ug&oe=69AACF25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMrtL_UxomIQ7kNvwHHtyt1&_nc_oc=AdlzqVYF8rWtDHKv5dyYnwlmcvhfawtCe081LYvesxI4uXvSDdncU2YFQSGrK7OHTLg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6_b5Ju1B1ol7CN_AX_Y9jA8C8yI3LtymqzEIbggItBQ&oe=69AAB876"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics
nBh1JZjA4w7Z1E8oeluBFW-oc81birxJkeQrZDO0fuYh2Ht0pouMBP-ubFUeTxZFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOksHwjFNedpxEVzA6g9qM1mNZGVuQv_7IN9n7RFuVBQ&oe=69BEA2FB"}, {"file_name": "migrated_image.png", "id": "543400016287158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974816_1042268835965465_808530831877341184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGEcWE43dGUQ7kNvwHow7uC&_nc_oc=AdlXizTGBnoHvHBmD0_3OvXx2VLdoVRf9o390JmYG7liaSbKRNFDZ4ooL8WvMf4xbak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMeCBzgmXi9Hf2ZQg3Pu9iSgcLuNdaPr_COvQMdH-Y7A&oe=69BEA402"}, {"file_name": "migrated_image.png", "id": "301302760842839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982595_2229026830703198_7191365649828937728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c37ZtpslzkQ7kNvwHUKoik&_nc_oc=AdlX63tjpTmrO2ygUPuKLTeiFAyNa6Q5VmYpxzGBZZ7JUgqNYbUbiebB0qB3GwD4rPQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXtWw0QcPmMgNRgUFbpr8AipY3pb14gflMgcrlMIso4Q&oe=69BE7B19"}, {"file_name": "migrated_image.png", "id": "195178495233514", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_379098659512202_2039537869877411840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N4A_Oz82D0Q7kNvwGb3rkT&_nc_oc=AdnvCd77HuqiB0_whPCZSJiOL9_JFfP1I4UaU0uSq8WAIcqXizroFm6-PCELxrMGjto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyF6NrCZ0EeVYnQUQUkjDxix2taSCkWHD5p5ie5fCBxoA&oe=69BE95A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube cover trimmed 2560x1440.png", "id": "1588393144651699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286674_1588393147985032_8464614538505281207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2s_U47OrCIQ7kNvwGlaO-n&_nc_oc=AdkDFvMqDAXSH0ud5721AsLST47ACRkC9NqiBrxH5QU6ht0N1rKUEOIkb_yF-u2_5GQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxxf0jj6XRbAkdONc8s7BiwhqCf2Uxh8dXWMRZIsZ4Xsg&oe=69BE7EF6"}, "display_name": "Hoppy Animals", "keywords": ["Hoppy", "Animals", "Hopping", "Animal"], "long_description": "\"It's a very interesting game. There is not a lot of these in VR.\" - GoBros\n\nHoppy Animals is a third-person action-adventure 3D platformer game.\n\nSet in an imaginative, cartoonish candy world and nightmare world, a dog, a cat and a mouse will test their abilities against various obstacles, including scimitar-wielding, firearm-slinging undead pirates!\n\n- Designed specifically for Gear VR and Oculus Go\n- Over 40 levels of gameplay\n- Family-friendly\n- Visually beautiful\n- Adorable orchestral soundtrack\n- Multi-cast voice acting\n- Almost like participating in an animated movie\n- Comfortable gameplay (VR dizziness minimized, standing or swivel chair not required)\n- Supports Oculus Go and Gear VR controllers\n- Supports bluetooth gamepad\n\nImmerse in a beautiful fairy tale of talking animals, pirates and candies. You will visit a candy town, ride in a giant butterfly ship, and brave a cartoonish haunted house. This game is sheer eye candy, literally, and it just makes you feel good!", "short_description": "Control a dog, a cat and a mouse in this action-adventure 3D platformer game. Immerse in a beautiful fairy tale of talking animals, pirates and candies."}]}, "developer_name": "Truthveyor Studio", "developer_privacy_policy_url": "http://truthveyor.weebly.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.truthveyor.com/privacy-policy-terms-of-service.html", "publisher_name": "Tony Chen Productions", "support_website_url": null, "website_url": "https://www.truthveyor.com/hoppy-animals.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": n
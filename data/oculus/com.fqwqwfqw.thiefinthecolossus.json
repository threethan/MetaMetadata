ziM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzryIMBJ_FuMq3l5FSo_4cNC4M8JqpFnlmJavVKtC_Rqg&oe=69AD7A0C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Iq9vjI0E8YQ7kNvwHmJAxQ&_nc_oc=AdntUPJCimSrtOGTbvz_50ksqqG6BqY7q6r6c_htg2xcFYu_ujyLWxT9O8rJ_1se724&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk0S2Yvah6_0ozkUqbw6eOc__f-kqo0JL-8syXPW4kow&oe=69AD7F62"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty7a3mWCyKMQ7kNvwHY4ks8&_nc_oc=AdmZ2Gfdp4N0yXBaH9cW5J4xQYuKMUbia90Kz9zIoSWiitwdChTofVxXRHxoerPDnI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkNJkdQT_QMgPo2rDiECq0-IV_qfcssCYdVgk0-_ZBTg&oe=69AD71A9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pupev26AVKoQ7kNvwF7MopC&_nc_oc=Admg1Z9N4ZhAsoGfQtMFste_2gCnkcGovbR_2h98bcoszI6N_xxDdLHEwf4Ce1vRVEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHdRzebDKH0mmayEcyEgn2JCGrEGtL0eXIZI5DM-EI_g&oe=69AD65B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtCR49XxZcUQ7kNvwEq20S1&_nc_oc=AdmXwChk4ozJ_REvRKr81LrTuYfdZb1m-tbFSC0o7Uuf8mOHr0v7TXzLU8qHJZWZ3NI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyvRwGBR88TaPSf3m5JC4Qszr8zJKQx8YqEh4uF2XCWw&oe=69AD52E9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce